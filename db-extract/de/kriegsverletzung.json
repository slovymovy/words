                "senses": [
                    {
                        "sense_id": "42a5c0d0-678f-3ea2-9c56-b773ea3c247d",
                        "entry_id": "f449d123-9bd8-39aa-a502-3e547a985a5d",
                        "glosses": [
                            "im Krieg zugezogene Verletzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31baa09d-2f53-4ef0-b84b-e6100321bbbd",
                                "sense_id": "42a5c0d0-678f-3ea2-9c56-b773ea3c247d",
                                "text": "„Trepanationen dienten vor allem der Behandlung von Kriegsverletzungen, […].“"
                            },
                            {
                                "example_id": "9689d137-3324-47ed-906c-af4d34a8fe58",
                                "sense_id": "42a5c0d0-678f-3ea2-9c56-b773ea3c247d",
                                "text": "„Vielleicht ist das bloß eine alte Kriegsverletzung.“"
                            },
                            {
                                "example_id": "a891cafe-5adb-44f8-b76e-34fa38c00925",
                                "sense_id": "42a5c0d0-678f-3ea2-9c56-b773ea3c247d",
                                "text": "„Nach dem Tod von Prinz Eugen, der schließlich an einer Lungenentzündung und nicht an einer Kriegsverletzung starb, wurden seine riesige bibliothekarische Sammlung sowie sein gesamter Besitz – unter anderem bestehend aus mehreren Palästen, viel Geld, zahlreichen Kunstwerken, Ländereien und einem gigantischen Zoo mit unzähligen Tieren – seiner Nichte Anna Viktoria vermacht; er hatte nämlich vergessen, ein Testament zu schreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
