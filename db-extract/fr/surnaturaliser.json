                "senses": [
                    {
                        "sense_id": "392fc82b-3151-3149-925f-6aa9be27219b",
                        "entry_id": "c9a09e06-8814-3291-b6b8-74e042fcbdf6",
                        "glosses": [
                            "Donner un caractère surnaturel à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45bc7c68-1b06-43dc-a2a4-86a64b94feb1",
                                "sense_id": "392fc82b-3151-3149-925f-6aa9be27219b",
                                "text": "Ce besoin de transfigurer… est le même que celui qui tend, dans l’ordre poétique, je ne dis pas à surfaire, mais à surnaturaliser les génies."
                            },
                            {
                                "example_id": "c64be9b1-6105-44d4-9bfc-800755fe4f42",
                                "sense_id": "392fc82b-3151-3149-925f-6aa9be27219b",
                                "text": "Ces dialogues tout intérieurs, qui ne purent d'ailleurs convenir au cinéma, sont ceux de l'angoisse d'un homme qui va bientôt mourir, qui le sait et qui tente de surnaturaliser cette angoisse humaine en exprimant ce qui dans la Sainte Agonie donne son sens à l'agonie de l'homme."
                            }
                        ]
                    }
                ],
