                "senses": [
                    {
                        "sense_id": "af71ad9f-4c8c-3ed3-987f-68248a2b3077",
                        "entry_id": "04d193f5-c7b6-360f-80b5-aece17e2d123",
                        "glosses": [
                            "potrawa z mięsa, warzyw lub ryby w galarecie – z żelatyny lub na bazie wywaru z kości; zob. też auszpik w Encyklopedii staropolskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c4779c3-757e-4c61-8810-46f9cacda7c7",
                                "sense_id": "af71ad9f-4c8c-3ed3-987f-68248a2b3077",
                                "text": "Na przyjęciu podano indyka w auszpiku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cddcae04-088f-4771-915a-6bdb8c09637e",
                        "source_entry_id": "04d193f5-c7b6-360f-80b5-aece17e2d123",
                        "source_sense_id": "af71ad9f-4c8c-3ed3-987f-68248a2b3077",
                        "target_lang_word": "aspic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20f69d40-5afc-3fb3-8deb-b5468f1980ce",
                                        "entry_id": "aef7d144-1922-3e69-b04a-824902edbb6c",
                                        "glosses": [
                                            "A meat or fish jelly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b2c9473-d52e-4b36-b90a-c3982f4ea56e",
                                                "sense_id": "20f69d40-5afc-3fb3-8deb-b5468f1980ce",
                                                "text": "“Put a little aspic in the mould, so as to cover the bottom ···“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc813e3f-cfed-3386-8c21-c6577728d8ea",
                                        "entry_id": "aef7d144-1922-3e69-b04a-824902edbb6c",
                                        "glosses": [
                                            "A dish in which ingredients are set into a gelatine, jelly-like substance made from a meat stock or consommé."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de5c70d8-c86d-4645-b46c-1452ac53ea23",
                                                "sense_id": "fc813e3f-cfed-3386-8c21-c6577728d8ea",
                                                "text": "\"I don't know what you mean, Mr. Wynand,\" whispered Keating. His eyes fixed upon the tomato aspic on his salad plate; it was soft and shivering; it made him sick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eb8f976-f3bd-3f1d-b28c-1f201c8aa6e5",
                                        "entry_id": "aef7d144-1922-3e69-b04a-824902edbb6c",
                                        "glosses": [
                                            "An asp, a small venomous snake of Egypt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6680dd0-9f49-49d4-8fba-152a69472702",
                                                "sense_id": "6eb8f976-f3bd-3f1d-b28c-1f201c8aa6e5",
                                                "text": "This is an aspic's trail: and these fig-leaves / Have slime upon them, such as the aspic leaves."
                                            },
                                            {
                                                "example_id": "23251643-9e5d-4b84-8bd4-3d43bd6ea2e4",
                                                "sense_id": "6eb8f976-f3bd-3f1d-b28c-1f201c8aa6e5",
                                                "text": "(With that she tore her robe apart, and half / The polished argent of her breast to sight / Laid bare. Thereto she pointed with a laugh, / Showing the aspic's bite. )"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4595e74-810c-3ade-85bb-23a377d83cea",
                                        "entry_id": "aef7d144-1922-3e69-b04a-824902edbb6c",
                                        "glosses": [
                                            "A light cannon firing a two-pound ball."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "aspic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "460588d9-e761-3687-b49a-2fcfec7da1d6",
                                        "entry_id": "7cb9ac62-26ba-34f8-a2b0-9435afe13a43",
                                        "glosses": [
                                            "Aspish; relating to an asp, a small venomous snake of Egypt."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92e96746-c252-47a6-a16d-69f80aa0b140",
                                                "sense_id": "460588d9-e761-3687-b49a-2fcfec7da1d6",
                                                "text": "Timeless mother, / How is it that your aspic nipples / For once vent honey?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dd701cd-f37c-41d4-bf47-2288ca3e08b2",
                        "source_entry_id": "04d193f5-c7b6-360f-80b5-aece17e2d123",
                        "source_sense_id": "af71ad9f-4c8c-3ed3-987f-68248a2b3077",
                        "target_lang_word": "aspic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e70c77fb-49c6-34cf-8ddc-980995f78d33",
                                        "entry_id": "11e0e464-4b04-3245-9093-492f9a19898d",
                                        "glosses": [
                                            "Serpent, proche du naja ou du cobra, répandu dans toute l’Afrique et très venimeux, l’aspic de Cléopâtre ou cobra égyptien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebda8746-0dfb-4886-ba29-02f67b8587db",
                                                "sense_id": "e70c77fb-49c6-34cf-8ddc-980995f78d33",
                                                "text": "Confier ma vie à ce type équivaut à me faire mordre le mollet par un aspic…"
                                            },
                                            {
                                                "example_id": "0cd09a43-c386-432d-88b4-f67884231600",
                                                "sense_id": "e70c77fb-49c6-34cf-8ddc-980995f78d33",
                                                "text": "La reine Cléopâtre s’est fait mordre par un aspic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                        "entry_id": "11e0e464-4b04-3245-9093-492f9a19898d",
                                        "glosses": [
                                            "Vipère d’Europe de l'ouest, la vipère aspic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2109f116-d9f4-4c9d-8a33-cc9ad70624e8",
                                                "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                                "text": "L'aspic d'or qu'elle avait détaché de son bras sifflait en glissant sous les voûtes."
                                            },
                                            {
                                                "example_id": "5c1e6c65-ae78-4461-a5b4-467ae55cf796",
                                                "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                                "text": "Cela ne mène, peut-être, pas à grand-chose mais il est en tout cas certain que, si je dis « Cléopâtre », je pense tout d’abord à l’aspic caché dans un panier de figues (comme la plupart des gens, j’ai horreur des serpents), ensuite aux lions par lesquels elle faisait dévorer ses amants."
                                            },
                                            {
                                                "example_id": "72fd68d5-5277-4cdd-bf97-5db71757142b",
                                                "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                                "text": "L’aspic a un corps massif et un museau retroussé."
                                            },
                                            {
                                                "example_id": "5edce18b-f1b2-414f-b156-1d34b7bce5e6",
                                                "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                                "text": "Il fut mordu par un aspic."
                                            },
                                            {
                                                "example_id": "f9a1ba02-c107-49e4-94ac-48096d604825",
                                                "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                                "text": "Ils te porteront sur les mains, De peur que ton pied ne heurte contre une pierre.Tu marcheras sur le lion et sur l'aspic"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b28fc35-d023-3521-a626-106f533d105e",
                                        "entry_id": "11e0e464-4b04-3245-9093-492f9a19898d",
                                        "glosses": [
                                            "Personne très médisante. Grâce à leur venin, ces serpents ont toujours symbolisé la calomnie. L’aspic des voleurs n’est que la vipère des honnêtes gens."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2170e829-0cdb-4e50-bdb1-84cb6c10482c",
                                                "sense_id": "0b28fc35-d023-3521-a626-106f533d105e",
                                                "text": "Un aspic, une langue d’aspic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0230789c-0fc4-3cc1-8f04-1541ce0b34cd",
                                        "entry_id": "11e0e464-4b04-3245-9093-492f9a19898d",
                                        "glosses": [
                                            "Entrée froide moulée utilisant de la gelée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "021d7a38-4926-40cf-99d0-f0c58313a0da",
                                                "sense_id": "0230789c-0fc4-3cc1-8f04-1541ce0b34cd",
                                                "text": "Œufs en gelée, cornets, aspics et barquettes, ballottines, galantines, pâtés, chauds-froids, daubes, terrines, confits, tourtes, tartes, frangipanes : toutes ces dames avaient rempli avec zèle leurs devoirs sociaux."
                                            },
                                            {
                                                "example_id": "dda046c4-781e-497c-80d6-c6a244da743d",
                                                "sense_id": "0230789c-0fc4-3cc1-8f04-1541ce0b34cd",
                                                "text": "Nicolas se remit à sa tâche, qui consistait en le démoulage d'aspics de filets de sole, contisés de lames de truffes, destinés à garnir le hors-d'oeuvre de poisson."
                                            },
                                            {
                                                "example_id": "0951af49-64ed-4215-adc2-2a8da1a5bdeb",
                                                "sense_id": "0230789c-0fc4-3cc1-8f04-1541ce0b34cd",
                                                "text": "J’ai dégusté dans les Cévennes, un aspic de cailles aux châtaignes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4436bc9d-d9bb-3916-8156-01962406243e",
                                        "entry_id": "11e0e464-4b04-3245-9093-492f9a19898d",
                                        "glosses": [
                                            "Un avare."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare",
