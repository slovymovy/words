                        "glosses": [
                            "Able to be cast. In particular:",
                            "Capable of or suitable for being assigned a role in a play, film, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "859fdc7e-8173-4a5b-aeac-8ec421fe4207",
                                "sense_id": "24261544-bdd7-38a0-ae1d-a3a1b70541b3",
                                "text": "I always assumed that I'd be more castable as I got older. I'm a character actress and a comedian —not some pretty little ingénue. I figured I'd grow[…]"
                            },
                            {
                                "example_id": "43c2a734-42d3-4292-945c-116e529af6bb",
                                "sense_id": "24261544-bdd7-38a0-ae1d-a3a1b70541b3",
                                "text": "Most importantly, agents want to know you are castable. The easiest way to show them that, obviously, is to get cast in stuff. You might have a long and impressive resume from your acting school or community theater back home[…]"
                            }
                        ]
                    },
                    {
