                        "sense_id": "fe4193e1-0a52-3e73-bd86-4aa9898b8f99",
                        "entry_id": "b89b04ce-c547-3971-8930-8b19606f1f72",
                        "glosses": [
                            "Gebäude oder Gebäudeteil, in dem Vorräte gelagert werden"
                        ],
                        "tags": [
                            "Lagerwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "ba35b400-c0be-4d11-95ba-2be2472f49ea",
                                "sense_id": "fe4193e1-0a52-3e73-bd86-4aa9898b8f99",
                                "text": "„Schon im 12. Jahrhundert gab es auf dem dortigen Areal ein Vorratshaus des Klosters Georgenthal; um das Jahr 1557 wurde ein Freiwäldlerstall erwähnt.“"
                            },
                            {
                                "example_id": "104bf119-0b7a-49c7-94a7-bcf12d53c04d",
                                "sense_id": "fe4193e1-0a52-3e73-bd86-4aa9898b8f99",
                                "text": "„Der Geräteschuppen und das Vorratshaus, die Backstube und der Holzstall schlossen sich rechtwinklig als zwei niedrigere Flügel an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
