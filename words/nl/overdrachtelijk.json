{
    "word_family": [
        "overdracht",
        "overdragen",
        "overdraagbaar"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c2495831-0ca4-3034-a74b-ea6e2298a2f7",
                    "sense_definition": "Figuurlijk, in oneigenlijke zin; niet letterlijk bedoeld.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De letterlijke en <w>overdrachtelijke</w> betekenis van het woord lopen hier erg uiteen.",
                            "target_lang_translations": {
                                "en": "The literal and <w>figurative</w> meanings of the word differ greatly here."
                            }
                        },
                        {
                            "text": "In <w>overdrachtelijke</w> zin bedoelde hij dat we bergen werk moesten verzetten.",
                            "target_lang_translations": {
                                "en": "In a <w>figurative</w> sense, he meant that we had to move mountains of work."
                            }
                        }
                    ],
                    "synonyms": [
                        "figuurlijk",
                        "metaforisch"
                    ],
                    "antonyms": [
                        "letterlijk"
                    ],
                    "common_phrases": [
                        "overdrachtelijke betekenis",
                        "overdrachtelijke zin"
                    ],
                    "target_lang_definitions": {
                        "en": "Figurative, in an improper sense; not meant literally."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "figurative",
                                "target_lang_sense_clarification": "not literal; metaphorical"
                            },
                            {
                                "target_lang_word": "metaphorical",
                                "target_lang_sense_clarification": "relating to or using metaphor"
                            },
                            {
                                "target_lang_word": "figuratively",
                                "target_lang_sense_clarification": "used in a figurative sense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f821c450-68ce-396e-a064-d2c3e2b701c7",
                    "sense_definition": "Bij uitbreiding, wanneer er een ruimere interpretatie dan gebruikelijk aan wordt gegeven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We kunnen deze term in een <w>overdrachtelijke</w> betekenis ook toepassen op de digitale wereld.",
                            "target_lang_translations": {
                                "en": "We can also apply this term in a <w>figurative</w> sense to the digital world."
                            }
                        },
                        {
                            "text": "Het begrip 'familie' wordt hier in een zeer <w>overdrachtelijke</w> zin gebruikt.",
                            "target_lang_translations": {
                                "en": "The concept of 'family' is used here in a very <w>broad</w> sense."
                            }
                        }
                    ],
                    "synonyms": [
                        "oneigenlijk"
                    ],
                    "common_phrases": [
                        "overdrachtelijke zin"
                    ],
                    "target_lang_definitions": {
                        "en": "By extension, when a broader interpretation than usual is given to something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "figurative",
                                "target_lang_sense_clarification": "extended or broader meaning"
                            },
                            {
                                "target_lang_word": "metaphorical",
                                "target_lang_sense_clarification": "applied in a broader, non-literal context"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c5c12ee-6320-3566-ab9a-a6ad974a382a",
                    "sense_definition": "Met betrekking tot de overdracht van een handeling op een lijdend voorwerp; transitief.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sommige werkwoorden hebben een <w>overdrachtelijke</w> functie in de zin.",
                            "target_lang_translations": {
                                "en": "Some verbs have a <w>transitive</w> function in the sentence."
                            }
                        },
                        {
                            "text": "Dit werkwoord wordt hier in een <w>overdrachtelijke</w> constructie gebruikt.",
                            "target_lang_translations": {
                                "en": "This verb is used here in a <w>transitive</w> construction."
                            }
                        }
                    ],
                    "synonyms": [
                        "transitief",
                        "overgankelijk"
                    ],
                    "antonyms": [
                        "intransitief",
                        "onovergankelijk"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical grammatical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to the transfer of an action to a direct object; transitive."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "transitive",
                                "target_lang_sense_clarification": "grammatical term for verbs taking a direct object"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}