                                        "entry_id": "a7e4297a-c2b0-371b-b476-33dd5894e276",
                                        "glosses": [
                                            "As a result or consequence of something; subsequently."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde5d261-5852-4c1e-aeb1-98ccea7ea6ac",
                                                "sense_id": "60a147e1-e5d4-3bc1-9ae0-3e4c3994824c",
                                                "text": "He didn't wake up early. Consequently, he was late to work."
                                            },
                                            {
                                                "example_id": "5999f517-6b1d-494a-983d-826c4e1bb49a",
                                                "sense_id": "60a147e1-e5d4-3bc1-9ae0-3e4c3994824c",
                                                "text": "He Suſpends on theſe Reaſons, that Thomas Rue had granted a general Diſcharge to Adam Muſhet, who was his Conjunct, and correus debendi, after the alleadged Service, which Diſcharged Muſhet, and conſequently Houstoun his Partner."
                                            },
                                            {
                                                "example_id": "6d4594b5-1496-4937-b404-bf2a3fee43d7",
                                                "sense_id": "60a147e1-e5d4-3bc1-9ae0-3e4c3994824c",
                                                "text": "While algebraical reasoning is most frequently analytical, arithmetical reasoning is generally synthetical, and, consequently, more difficult to understand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4bf89f-9308-3f63-bdd9-8542ff7b5d6a",
                                        "entry_id": "a7e4297a-c2b0-371b-b476-33dd5894e276",
                                        "glosses": [
                                            "subsequently, following after in time or sequence."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete",
                                            "sequence"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
