                "senses": [
                    {
                        "sense_id": "39d2a394-07ec-39a8-bd67-215403b0c601",
                        "entry_id": "9a467088-d66a-3a04-bad1-89960dd36bad",
                        "glosses": [
                            "wyszukana uprzejmość w stosunku do kogoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a5fa3d-fb82-4c67-b3da-4db971ff50ce",
                                "sense_id": "39d2a394-07ec-39a8-bd67-215403b0c601",
                                "text": "Przed domem Cesi Dmuchawiec zatrzymał się i pożegnał swoją uczennicę z sympatią i galanterią"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5925b067-8c4a-30f8-88a0-e098df040b68",
                        "entry_id": "9a467088-d66a-3a04-bad1-89960dd36bad",
                        "glosses": [
                            "drobne dodatki do ubrań"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbd6b23f-d257-40ea-8ecd-c1d88250b7ef",
                                "sense_id": "5925b067-8c4a-30f8-88a0-e098df040b68",
                                "text": "Dział galanterii znajduje się na piątym piętrze."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "65527155-0589-337e-b75a-7c3ef76e2352",
                        "entry_id": "9a467088-d66a-3a04-bad1-89960dd36bad",
                        "glosses": [
                            "drobne wyroby, np. cukiernicze, dekoracyjne"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73dba6a3-6677-4f3a-88f9-42ae430915cd",
                        "source_entry_id": "9a467088-d66a-3a04-bad1-89960dd36bad",
                        "source_sense_id": "5925b067-8c4a-30f8-88a0-e098df040b68",
                        "target_lang_word": "Galanteriewaren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galanteriewaren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23fbc043-2a2f-3393-ac17-8892fe1bf582",
                                        "entry_id": "3a7feac4-04f6-31cc-a8a3-75d5f2966645",
                                        "glosses": [
                                            "modische Gebrauchsgegenstände"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b436020c-5336-455c-ac71-986c82727c31",
                                                "sense_id": "23fbc043-2a2f-3393-ac17-8892fe1bf582",
                                                "text": "„Mr. Si Yap besitzt in der Live Fox Street einen Laden für Galanteriewaren.“"
                                            },
                                            {
                                                "example_id": "f7a3fea4-4d36-4d6f-a63e-0d54cfef52bf",
                                                "sense_id": "23fbc043-2a2f-3393-ac17-8892fe1bf582",
                                                "text": "„Bestochene Gendarmerieposten erblindeten schlichtweg zu vereinbarten Stunden, und dann fuhren direkt vor ihrer Nase und unter ihrem stillen Patronat ganze Wagenkolonnen durchs Gettotor, beladen mit Lebensmitteln, teuren Getränken, den luxuriösesten Leckerbissen, Tabak direkt aus Griechenland oder französischen Galanteriewaren und Kosmetika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0908b8ca-f5bc-4ad3-878b-6a2e5c167568",
                        "source_entry_id": "9a467088-d66a-3a04-bad1-89960dd36bad",
                        "source_sense_id": "39d2a394-07ec-39a8-bd67-215403b0c601",
                        "target_lang_word": "Galanterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galanterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                        "entry_id": "d55c646b-f9fa-3abb-a826-c561b73a5094",
                                        "glosses": [
                                            "ausgesprochen höfliches, zuvorkommendes Verhalten gegenüber Frauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c0b80e-3a3a-43b1-8326-419ab2202b70",
                                                "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                                "text": "„Es wäre nun vielleicht an der Zeit, daß Sie sich die Folgen Ihrer Galanterie gegen diese Dame klarmachen.“"
                                            },
                                            {
                                                "example_id": "1cbba07e-409f-4b00-bb54-31f62fb159af",
                                                "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                                "text": "„Ein solcher Ton der Galanterie herrschte in Granada, als ich die ersten Schritte in der Gesellschaft tat; doch ich verfiel nicht dieser Mode.“"
                                            },
                                            {
                                                "example_id": "4261c0a7-7cb5-4d62-bf5d-4a9e83b29ded",
                                                "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                                "text": "„Er tat ausgesprochen höflich und gebärdete sich wie im Caféhaus, glich ihre flach intonierte Schroffheit durch gestelzte Galanterie aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54799d23-6a27-3312-99dc-a69975434c7b",
                                        "entry_id": "d55c646b-f9fa-3abb-a826-c561b73a5094",
                                        "glosses": [
                                            "schmeichelndes, verbindliches Kompliment gegenüber Frauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef32b20-06a4-40c0-9964-41e6e7847fd8",
                                                "sense_id": "54799d23-6a27-3312-99dc-a69975434c7b",
                                                "text": "„Statt mir Handschuhe zu kaufen, beschloß ich, mich zu rächen, indem ich ihr aus dem Weg ging und sie der abgeschmackten Galanterie Sanzonios überließ, der angefaulte Zähne, eine blonde Perücke, eine unreine Haut und einen übelriechenden Atem hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
