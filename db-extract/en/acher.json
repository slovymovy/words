                        "examples": [
                            {
                                "example_id": "449b0761-c705-49d5-b2d4-319034bff65c",
                                "sense_id": "be2bc69e-2de2-3ef6-953a-43a5cb6e43cd",
                                "text": "It[em]: A nother medow near unto Sea conteining abowt two achers and half."
                            },
                            {
                                "example_id": "43aaeb8a-ae46-41cd-9ce6-41620e25e715",
                                "sense_id": "be2bc69e-2de2-3ef6-953a-43a5cb6e43cd",
                                "text": "I Mary Littlefejld […] Authorize & Impoure my well beloued brother Fran: Littlefejld Senjoʳ to dispose of my right & Title in yᵗ Land of one Thousand Achers more or lesse lijng at Kenebunke, & belonging to the Towne of Cape Porpus […]"
                            },
                            {
                                "example_id": "53cfbfc0-296b-476e-b30e-aa975faeec48",
                                "sense_id": "be2bc69e-2de2-3ef6-953a-43a5cb6e43cd",
                                "text": "This Saffron which I here prescribe is planted only for its vertue and profit, which it returneth to the Planter thereof, as in Cambridgeshire and Saffronwalden, where they plant many achers thereof."
                            }
                        ]
                    }
