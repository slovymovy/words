                "translations": [
                    {
                        "translation_id": "93239766-767d-48d8-8106-189c09f64d15",
                        "source_entry_id": "e24afbfa-a215-35bb-b4ee-9f10fbfaaaa1",
                        "source_sense_id": "0423f03c-a1ff-38f1-8af6-92bc751a800b",
