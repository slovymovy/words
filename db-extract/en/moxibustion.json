                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a15ffc2c-5975-4cfc-bc70-222175b3f470",
                        "entry_id": "05c5d4aa-8860-38b1-ac7b-db2a0b9aa513",
                        "tags": [
                            "plural"
                        ],
                        "form": "moxibustions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6c510ed-6484-397e-9c33-c6350009760d",
                        "entry_id": "05c5d4aa-8860-38b1-ac7b-db2a0b9aa513",
                        "glosses": [
                            "The burning of moxa against the skin to treat pain or illness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "56f482a2-3533-4ffc-bd5b-7885ec20d48b",
                                "sense_id": "d6c510ed-6484-397e-9c33-c6350009760d",
                                "text": "Traditional Chinese medicine includes herbal remedy, diet therapy, use of animal secretion and organs, acupuncture, massage, moxibustion (the application of a burning moxa plant to skin), and other folk methods."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "888baaed-4e11-4e1c-8c3a-fc624b32c91e",
                        "source_entry_id": "05c5d4aa-8860-38b1-ac7b-db2a0b9aa513",
                        "source_sense_id": "d6c510ed-6484-397e-9c33-c6350009760d",
                        "source_sense_description": "burning of moxa against skin",
                        "target_lang_word": "moxibustion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moxibustion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                                        "entry_id": "aeba1e79-0476-3b30-820d-e02279727234",
                                        "glosses": [
                                            "Médecine traditionnelle asiatique, basée sur la stimulation de points d’acupuncture par du moxa."
                                        ],
                                        "tags": [
                                            "Médecine non conventionnelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65777313-3eab-4c9d-b724-c220ec01b1f3",
                                                "sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                                                "text": "Xiluan frotta aussi mon corps à la médecine traditionnelle, à la pharmacopée végétale et minérale, à la moxibustion comme à l’acupuncture."
                                            },
                                            {
                                                "example_id": "5337fe9a-cb1a-43d8-becd-66813dd0dbaa",
                                                "sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                                                "text": "Il se peut que la moxibustion ait été d’abord utilisée en Chine pour soulager les douleurs rhumatismales aux articulations et à d’autres fins analgésiques."
                                            },
                                            {
                                                "example_id": "e5702bb4-0b35-4f60-a240-d2dbc5588ce1",
                                                "sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                                                "text": "Si de terribles maladies frappent votre village, si des enfants passent de vie à trépas sans raison apparente, les remèdes traditionnels - saignées, cataplasmes, moxibustions - resteront sans effet pour la bonne raison qu’ils ne s’attaquent pas à la raison réelle des catastrophes : une règle a été enfreinte et un génie malveillant s’est introduit dans les lieux."
                                            },
                                            {
                                                "example_id": "1bdfe701-b60e-45eb-a048-25528f376960",
                                                "sense_id": "a28d5630-7a85-3ff4-8803-04b5ee1ecafc",
                                                "text": "Une salle axée sur la pharmacopée, l’acupuncture et la moxibustion aborde également les techniques de traitement, telles que le massage et les pratiques énergétiques (qi gong, tai-chi, yoga)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3819cb0f-e9af-4950-961f-76ed7c8f85f3",
                        "source_entry_id": "05c5d4aa-8860-38b1-ac7b-db2a0b9aa513",
                        "source_sense_id": "d6c510ed-6484-397e-9c33-c6350009760d",
                        "source_sense_description": "burning of moxa against skin",
                        "target_lang_word": "Moxibustion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moxibustion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74504caa-c983-3490-85cc-cfe302275e6f",
                                        "entry_id": "526e5493-adae-3c96-81ea-7b54f209f9f7",
                                        "glosses": [
                                            "ostasiatische Heilmethode, bei der durch lokales Einbrennen von Moxa in genau definierte Hautstellen die Abwehrkräfte des Körpers gestärkt werden"
                                        ],
                                        "tags": [
                                            "Naturheilkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e20e3277-ad42-4682-96a3-eefea4c1e6e6",
                                                "sense_id": "74504caa-c983-3490-85cc-cfe302275e6f",
                                                "text": "„Zur Wiederherstellung der Gesundheit setzten die altchinesischen Ärzte Akupunktur, Moxibustion, Massage und Arzneien pflanzlicher, tierlicher und mineralischer Herkunft ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
