        "fr-extract.jsonl": [
            {
                "entry_id": "d9f736aa-bfa6-314b-b833-0706b4aa45e7",
                "word": "Ardenne",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "76b3646c-8795-4785-9d71-3e2698f9a2f9",
                        "entry_id": "d9f736aa-bfa6-314b-b833-0706b4aa45e7",
                        "tags": [
                            "plural"
                        ],
                        "form": "Ardennes"
                    },
                    {
                        "form_id": "0ce7e030-8a70-48dd-a6f9-1b466599e248",
                        "entry_id": "d9f736aa-bfa6-314b-b833-0706b4aa45e7",
                        "tags": [],
                        "form": "Ardennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f748c429-e727-3691-aacf-b2d161db0817",
                        "entry_id": "d9f736aa-bfa6-314b-b833-0706b4aa45e7",
                        "glosses": [
                            "Massif montagneux et forestier à cheval sur la Belgique, la France et le Luxembourg."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84da8e6f-617c-424d-9ace-89158a7e0718",
                                "sense_id": "f748c429-e727-3691-aacf-b2d161db0817",
                                "text": "Il se munit de l'arbalète de bon bois des Ardennes, d'une trousse de trente flèches, d'une dague longue, mais non d'une épée à deux mains, qui est épée d'archer."
                            },
                            {
                                "example_id": "7828bc75-53fa-46de-840d-e9b49e3176e5",
                                "sense_id": "f748c429-e727-3691-aacf-b2d161db0817",
                                "text": "L’Ardenne est presque entièrement couverte de bois, sauf dans quelques vallées étroites et quelques espaces situés près des villages et laissés à l’agriculture."
                            },
                            {
                                "example_id": "2bcd24ed-1e88-4297-ab2d-a27d2f26a7e4",
                                "sense_id": "f748c429-e727-3691-aacf-b2d161db0817",
                                "text": "Aussi sombre que la Champagne sèche est claire, l’Ardenne lui a été rattachée politiquement, mais son terrain primaire ne s'accorde pas avec les couches tertiaires de notre province."
                            },
                            {
                                "example_id": "66c1cb52-525d-47a9-8338-2604cc9b4704",
                                "sense_id": "f748c429-e727-3691-aacf-b2d161db0817",
                                "text": "[…]: sur toute l’Ardenne, le temps s’était levé. Le ciel était bleu éblouissant, la neige étincelait au soleil."
                            },
                            {
                                "example_id": "37c22127-e2f7-4bcb-a323-01d2eadadeff",
                                "sense_id": "f748c429-e727-3691-aacf-b2d161db0817",
                                "text": "La limite entre le francique ripuaire et le roman (futur wallon, dialecte français) s'est établie sur le barrage naturel de la grande forêt d’Ardenne, qui isolait les deux groupes."
                            },
                            {
                                "example_id": "ce4a5ab6-7b47-4488-a746-2f2e8b0bf786",
                                "sense_id": "f748c429-e727-3691-aacf-b2d161db0817",
                                "text": "Trait d’union entre l’Ardenne et la Gaume, le Pays de la Semois a pour « capitale » Florenville."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5258389-cd60-472b-b139-d67a8e69ee50",
                        "source_entry_id": "d9f736aa-bfa6-314b-b833-0706b4aa45e7",
                        "source_sense_id": "f748c429-e727-3691-aacf-b2d161db0817",
                        "target_lang_word": "Ardennen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ardennen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe8e865d-823a-33cf-940c-7847f73f2d1e",
                                        "entry_id": "7562aa21-52d0-3430-be91-46621917c205",
                                        "glosses": [
                                            "belgisches, luxemburgisches und französisches Mittelgebirge; ein Teil des Rheinischen Schiefergebirges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bb6295d-48e0-4e50-9f6a-3f25451de5a6",
                                                "sense_id": "fe8e865d-823a-33cf-940c-7847f73f2d1e",
                                                "text": "Die Ardennen haben eine mittlere Höhe von 550 m, während ihre höchsten Berge 650 m kaum übersteigen."
                                            },
                                            {
                                                "example_id": "02f21f69-c38f-42fc-9b85-78a428ceb4b4",
                                                "sense_id": "fe8e865d-823a-33cf-940c-7847f73f2d1e",
                                                "text": "„Eine letzte deutsche Offensive in den Ardennen war im Dezember nach wenigen Tagen gescheitert.“"
                                            },
                                            {
                                                "example_id": "9c1ae717-5f87-4686-9b62-5c9703dbfb92",
                                                "sense_id": "fe8e865d-823a-33cf-940c-7847f73f2d1e",
                                                "text": "„Am 16. Dezember trat die Wehrmacht in den Ardennen zum Gegenangriff an.“"
                                            },
                                            {
                                                "example_id": "f35bb182-72b6-42ae-8b8d-a4c2516d54f5",
                                                "sense_id": "fe8e865d-823a-33cf-940c-7847f73f2d1e",
                                                "text": "„Tags darauf kamen wir bei Einbruch der Nacht in Lüttich an; ich legte Madame d'Urfé nahe, einen Tag dort zu bleiben, weil ich Pferde beschaffen wollte, um durch die Ardennen nach Luxemburg zu fahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b0492fa-fab5-4e33-8d35-65f0a3cac650",
