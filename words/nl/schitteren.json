{
    "word_family": [
        "schittering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eaec54d2-7b63-33bd-9def-e55f06e5f3f9",
                    "sense_definition": "Een helder of flikkerend licht uitstralen of weerkaatsen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sterren <w>schitteren</w> helder aan de donkere hemel.",
                            "target_lang_translations": {
                                "de": "Die Sterne <w>funkeln</w> hell am dunklen Himmel."
                            }
                        },
                        {
                            "text": "De diamant in haar ring <w>schitterde</w> prachtig in het felle zonlicht.",
                            "target_lang_translations": {
                                "de": "Der Diamant in ihrem Ring <w>glänzte</w> wunderschön im grellen Sonnenlicht."
                            }
                        }
                    ],
                    "synonyms": [
                        "blinken"
                    ],
                    "common_phrases": [
                        "schitteren in de zon"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein helles oder flackerndes Licht ausstrahlen oder reflektieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "glänzen",
                                "target_lang_sense_clarification": "Licht reflektieren, schimmern"
                            },
                            {
                                "target_lang_word": "strahlen",
                                "target_lang_sense_clarification": "helles Licht aussenden"
                            },
                            {
                                "target_lang_word": "funkeln",
                                "target_lang_sense_clarification": "in kurzen Lichtblitzen glänzen, wie Sterne oder Diamanten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02d36542-ee3d-310a-88bb-dcb3d4a57184",
                    "sense_definition": "Uitblinken in een bepaalde activiteit of bijzonder opvallen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge actrice <w>schitterde</w> in haar nieuwe rol op het toneel.",
                            "target_lang_translations": {
                                "de": "Die junge Schauspielerin <w>brillierte</w> in ihrer neuen Rolle auf der Bühne."
                            }
                        },
                        {
                            "text": "De directeur <w>schitterde</w> door afwezigheid tijdens de belangrijke vergadering.",
                            "target_lang_translations": {
                                "de": "Der Direktor <w>glänzte</w> während der wichtigen Besprechung durch Abwesenheit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "schitteren door afwezigheid"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich bei einer Tätigkeit hervortun, brillieren oder besonders auffallen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "glänzen",
                                "target_lang_sense_clarification": "eine hervorragende Leistung erbringen oder auffallen"
                            },
                            {
                                "target_lang_word": "brillieren",
                                "target_lang_sense_clarification": "durch herausragendes Können auffallen"
                            },
                            {
                                "target_lang_word": "hervorstechen",
                                "target_lang_sense_clarification": "aus der Masse herausragen, auffallen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}