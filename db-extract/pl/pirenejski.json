                "translations": [
                    {
                        "translation_id": "3e334073-5f9a-4781-9cbf-4f3dd1432d5d",
                        "source_entry_id": "8304c75e-b2cf-38e5-bf5c-603bfd5e8b31",
                        "source_sense_id": "a2746616-983a-3d1d-ad9c-dcba8c3830e1",
                        "target_lang_word": "Pyrenean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pyrenean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19989d80-4d92-3bfd-b695-7d47524ec229",
                                        "entry_id": "8f2102a0-b164-3a1d-8dd7-36933c90a620",
                                        "glosses": [
                                            "Of or pertaining to the Pyrenees, a range of mountains separating France and Spain"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d581b4-22ba-41cf-9e29-fe8374fbcfa5",
                                                "sense_id": "19989d80-4d92-3bfd-b695-7d47524ec229",
                                                "text": "Pierre held his berret ^([sic]) in his hand, and the boldness of the Pyrenean hunter was strangely overcome in the absence of all apparent danger: he really knew not what he did or what he said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pyrenean",
                                "target_lang_code": "en",
                                "target_senses": [
