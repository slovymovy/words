                "forms": [
                    {
                        "form_id": "0389db88-c09e-4772-b55c-9d07bce418e9",
                        "entry_id": "a127e41c-92db-3354-893d-cc831a7eaf22",
                        "tags": [
                            "plural"
                        ],
                        "form": "dégonflards"
                    },
                    {
                        "form_id": "94be58e6-c832-44f5-b733-55621a8580e6",
                        "entry_id": "a127e41c-92db-3354-893d-cc831a7eaf22",
                        "tags": [
                            "feminine"
                        ],
                        "form": "dégonflarde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3d19220-a4df-30dd-a3e5-f1b711004124",
                        "entry_id": "a127e41c-92db-3354-893d-cc831a7eaf22",
                        "glosses": [
                            "Insulte ou péjoratif pour désigner quelqu’un qui se dégonfle, qui n'ose pas faire ce qu'il avait pourtant décidé ou promis."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3212cf80-8ee4-46f1-8322-1e2843cde9e9",
                                "sense_id": "a3d19220-a4df-30dd-a3e5-f1b711004124",
                                "text": "Elle m'a traité de poule mouillée et de dégonflard, elle avait raison !"
                            },
                            {
                                "example_id": "d0fe3eea-8c64-4b67-ad77-e91a9d7a05ee",
                                "sense_id": "a3d19220-a4df-30dd-a3e5-f1b711004124",
                                "text": "Ah ! les vaches, les dégonflards. Où sont les Daladier et les Reynaud pendant que nous brûlons nos canons ?"
                            },
                            {
                                "example_id": "9ed1c3e8-e48c-4553-9ed1-94d3ae8969a1",
                                "sense_id": "a3d19220-a4df-30dd-a3e5-f1b711004124",
                                "text": "C’est bien ce que je pensais, t’es un dégonflard comme ton père, poursuit le père Lelièvre sans hausser le ton."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4875b1a-65fb-4548-8597-a85c9cbfe92c",
                        "source_entry_id": "a127e41c-92db-3354-893d-cc831a7eaf22",
                        "source_sense_id": "a3d19220-a4df-30dd-a3e5-f1b711004124",
                        "target_lang_word": "Angsthase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angsthase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05251aef-4bd6-305c-adaa-a5e9cb05b427",
                                        "entry_id": "c3d529fe-4b16-3ee8-b596-4cc33f53520c",
                                        "glosses": [
                                            "jemand, der sich oft ängstigt oder feige ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05b24d12-5250-43de-8b65-76506a16a261",
                                                "sense_id": "05251aef-4bd6-305c-adaa-a5e9cb05b427",
                                                "text": "Kommst du jetzt mit in die Höhle oder bist du ein Angsthase?"
                                            },
                                            {
                                                "example_id": "74421a17-4221-4cf4-9698-1f59689f4022",
                                                "sense_id": "05251aef-4bd6-305c-adaa-a5e9cb05b427",
                                                "text": "„Die größten Angsthasen versteckten sich hinter der Theke.“"
                                            },
                                            {
                                                "example_id": "9f5824b4-50d9-4a60-ad59-0ede54770ede",
                                                "sense_id": "05251aef-4bd6-305c-adaa-a5e9cb05b427",
                                                "text": "„Manche fachfremde Pädagogen, sagt Bernd Richter, sind im Fach Chemie sogar bekennende Angsthasen.“"
                                            },
                                            {
                                                "example_id": "680cad93-571a-4773-ba94-5af6c1391230",
                                                "sense_id": "05251aef-4bd6-305c-adaa-a5e9cb05b427",
                                                "text": "„Nun stehen diese Angsthasen kurz davor, in Europa die Führung zu übernehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0008b67-1ac9-4b1e-a866-3229e055c614",
                        "source_entry_id": "a127e41c-92db-3354-893d-cc831a7eaf22",
                        "source_sense_id": "a3d19220-a4df-30dd-a3e5-f1b711004124",
                        "target_lang_word": "Feigling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feigling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                        "entry_id": "68d08fb9-82ee-3a71-b31a-97dbe7378338",
                                        "glosses": [
                                            "furchtsame, ängstliche, risikoscheue Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef2bf05-5c64-4b48-9be2-42eab284e81d",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "Sei kein solcher Feigling und sag deinem Chef endlich mal richtig die Meinung!"
                                            },
                                            {
                                                "example_id": "80b97be5-baa2-4700-9ea8-f667b9670c3b",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Wer eine Familie mit fünf Töchtern gründet, kann kein Feigling sein.“"
                                            },
                                            {
                                                "example_id": "8dcd235e-67cb-432f-ad58-cf295d7da7d0",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Anstatt seinen Leuten zu Hilfe zu kommen, drehte sich dieser jämmerliche Feigling plötzlich um und gab Fersengeld.“"
                                            },
                                            {
                                                "example_id": "3b0e40a9-db73-4956-a505-614ed72cb053",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Nun schämten sich die Moskowiter wohl, dass sie als Feiglinge bezeichnet wurden, und schämten sich, dass sie wegfuhren, fuhren aber trotzdem weg, weil sie wussten, dass es sein musste.“"
                                            },
                                            {
                                                "example_id": "9e39e1ca-6039-4809-8fbb-6bfd8778ba3c",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "(„Soll ich da mal rüberbalancieren?“) – „Tu doch, mach doch, Feigling!“ – (Mögliche Antwort:) „Lieber ein Feigling sein, als einem Doofen ein’n Gefallen tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cdbaf92-9217-4613-9611-81d420c12039",
                        "source_entry_id": "a127e41c-92db-3354-893d-cc831a7eaf22",
                        "source_sense_id": "a3d19220-a4df-30dd-a3e5-f1b711004124",
                        "target_lang_word": "Versager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                        "entry_id": "6ff6b2ea-a8df-3829-8aba-e2202e690271",
                                        "glosses": [
                                            "Person, die sehr häufig nicht das Erwartete erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584ae27c-3968-4de3-8004-e363bc9f0ccd",
                                                "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                                "text": "Schon wieder nichts verkauft! Du bist echt ein Versager!"
                                            },
                                            {
                                                "example_id": "0100c27d-2fe6-40eb-87aa-8b343f916e00",
                                                "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                                "text": "„Doch nicht nur Gabi, auch Mutter hat in mir den typischen Versager gesehen.“"
                                            },
                                            {
                                                "example_id": "6a23b684-1ff2-4dcf-9552-f868ec9ad433",
                                                "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                                "text": "Männer mit Erektionsstörungen fühlen sich schnell als Versager."
                                            },
                                            {
                                                "example_id": "4547057b-48cc-45ab-be4b-e06f97c7a5a0",
                                                "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                                "text": "„Mein Vater hatte mir gesagt, ich würde immer ein Versager sein.“"
                                            },
                                            {
                                                "example_id": "e80e7a5a-3a97-4b40-9813-9becdbe4e997",
                                                "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                                "text": "„Mugabe zeigte immer großes Geschick bei Machtkämpfen und als Propagandist, während er als Wirtschaftspolitiker ein Versager war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a39a279b-718f-363f-8c54-78bd26d9b536",
                                        "entry_id": "6ff6b2ea-a8df-3829-8aba-e2202e690271",
                                        "glosses": [
                                            "etwas, das nicht den Anforderungen entspricht und/oder den erhofften Erfolg hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cb2d559-6dc9-4eb3-81f2-8a93dad77dc1",
                                                "sense_id": "a39a279b-718f-363f-8c54-78bd26d9b536",
                                                "text": "Sein neuerster Roman ist ein Versager."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "34200a56-2c14-3717-8662-9e93380d5938",
                                        "entry_id": "6ff6b2ea-a8df-3829-8aba-e2202e690271",
                                        "glosses": [
                                            "plötzliches, meist kurzes Aussetzen oder Versagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5550b069-21a4-4d7b-9786-8baeeb2775c2",
                                                "sense_id": "34200a56-2c14-3717-8662-9e93380d5938",
                                                "text": "Die Eiskunstläuferin hatte einige Versager in der Kür."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7377413-1f60-44c6-a1ca-9392619fc5de",
                        "source_entry_id": "a127e41c-92db-3354-893d-cc831a7eaf22",
                        "source_sense_id": "a3d19220-a4df-30dd-a3e5-f1b711004124",
                        "target_lang_word": "Waschlappen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waschlappen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7923665-427e-3df6-a531-aff8d6bfb277",
                                        "entry_id": "85507dab-b930-3030-83cb-eaa9d06190db",
                                        "glosses": [
                                            "Tuch zum feuchten Reinigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2023b628-df33-45a3-95a4-e86531079c61",
                                                "sense_id": "f7923665-427e-3df6-a531-aff8d6bfb277",
                                                "text": "Zum Aufwischen von Lacken sollte der Waschlappen auch schon feucht sein."
                                            },
                                            {
                                                "example_id": "a65807a9-8c6a-4389-aad9-00f42f312140",
                                                "sense_id": "f7923665-427e-3df6-a531-aff8d6bfb277",
                                                "text": "„Es langt nur zum Zähneputzen und für eine Katzenwäsche mit dem Waschlappen.“"
                                            },
                                            {
                                                "example_id": "4c124985-f6c5-45fc-9777-01d23970a41a",
                                                "sense_id": "f7923665-427e-3df6-a531-aff8d6bfb277",
                                                "text": "„Er geht mit dem Waschlappen immer wieder darüber.“"
                                            },
                                            {
                                                "example_id": "337a027e-938e-4401-8e63-7df3eac631f1",
                                                "sense_id": "f7923665-427e-3df6-a531-aff8d6bfb277",
                                                "text": "„Da ist ihr Waschlappen in Form eines Handschuhs.“"
                                            },
                                            {
                                                "example_id": "856c638e-1ed3-4fea-a161-a171f8d6d0fc",
                                                "sense_id": "f7923665-427e-3df6-a531-aff8d6bfb277",
                                                "text": "„Tom brachte einen feuchten Waschlappen aus dem Badezimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "67513def-3ed4-3bf2-9687-505ca0da6d62",
                                        "entry_id": "85507dab-b930-3030-83cb-eaa9d06190db",
                                        "glosses": [
                                            "Feigling, Schwächling; jemand, der nichts wagt oder zu schwach ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c17c2e5-03cb-4d12-a9f9-f6a8a48b5921",
                                                "sense_id": "67513def-3ed4-3bf2-9687-505ca0da6d62",
                                                "text": "Du bist ein Waschlappen, wenn du dich nicht einmal vom Beckenrand ins Wasser zu springen traust."
                                            },
                                            {
                                                "example_id": "33851d6b-794e-4acf-85a5-c20fdf902d7b",
                                                "sense_id": "67513def-3ed4-3bf2-9687-505ca0da6d62",
                                                "text": "„Das Ergebnis ist ein Waschlappen, ein moderner Werther.“"
                                            },
                                            {
                                                "example_id": "4919b56e-87e8-4c94-8a2b-a6c3f71c5053",
                                                "sense_id": "67513def-3ed4-3bf2-9687-505ca0da6d62",
                                                "text": "„Wenn sie heute die Büffel schafften, blieben nur noch die Nashörner, dann hätte der Waschlappen sein gefährliches Spielchen abgehakt, und die Lage könnte sich entspannen.“"
                                            },
                                            {
                                                "example_id": "c4147d0f-4cff-4e2c-83ad-7046e1f6b1fb",
                                                "sense_id": "67513def-3ed4-3bf2-9687-505ca0da6d62",
                                                "text": "„Ein Dasein als Waschlappen durfte nicht sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
