                        "glosses": [
                            "Maladie de l’oreille due à la présence dans le conduit auditif d’un champignon particulièrement du genre Aspergillus ou Candida."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36a31725-64f3-448c-847e-ca8685ac62dd",
                                "sense_id": "057a3bbd-b2fb-3112-81f8-3bcce4b91eee",
                                "text": "L’otomycose est une pathologie fréquente en ORL. Elle est le plus souvent bénigne mais peut s’avérer grave lorsqu’elle devient invasive."
                            },
                            {
                                "example_id": "0d4e97f2-6ab9-4a82-9820-07521a5d16c0",
                                "sense_id": "057a3bbd-b2fb-3112-81f8-3bcce4b91eee",
                                "text": "L’otomycose aussi appelée « otite du baigneur » est une infection fongique de l'oreille qui affecte principalement le conduit auditif."
                            }
                        ]
                    }
