                                    },
                                    {
                                        "sense_id": "1a0a45e9-7ddd-39c6-b73d-8c2d8f1de224",
                                        "entry_id": "f0785208-d1e3-35ae-b5d6-302cc4321804",
                                        "glosses": [
                                            "Ancienne capitale, située actuellement en Tunisie."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29355154-db29-40d6-bb4d-e13a2516eb2d",
                                                "sense_id": "1a0a45e9-7ddd-39c6-b73d-8c2d8f1de224",
                                                "text": "Le succès de l’haruspicine ne se limitait pas à la religion officielle. Une foule d’haruspices privés proposait ses consultations au public moyennant finance : dans la Carthage du IVᵉ siècle apr. J.-C., le futur saint Augustin, alors étudiant, y eut encore recours."
                                            },
                                            {
                                                "example_id": "fcb61567-03e9-40aa-9ad0-b16b56a9b860",
                                                "sense_id": "1a0a45e9-7ddd-39c6-b73d-8c2d8f1de224",
                                                "text": "carthaginois"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16ea993e-40cc-4d78-9623-ac62dabfab43",
                        "source_entry_id": "db664f17-6e26-3b26-8af9-e8c8eb03954b",
                        "source_sense_description": "ancient city in North Africa",
                        "target_lang_word": "Karthago",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karthago",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14896675-d478-34cd-9f69-2a011cfaf25b",
                                        "entry_id": "1912794e-e63c-3ba1-850e-c2dfd3c50676",
                                        "glosses": [
                                            "im Nordosten Tunesiens gelegene antike, phönizische Küstenstadt, die seit 1979 zum UNESCO-Welterbe gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1596bd9c-b02f-40d6-9273-3d0bd7da7c1d",
                                                "sense_id": "14896675-d478-34cd-9f69-2a011cfaf25b",
                                                "text": "Karthago war der große Rivale Roms."
                                            },
                                            {
                                                "example_id": "c7bdcbc7-329d-44c8-8599-7b017b4883da",
                                                "sense_id": "14896675-d478-34cd-9f69-2a011cfaf25b",
                                                "text": "„Der bedeutendste christliche Seelenforscher, dessen Lehren fast ein Jahrtausend hindurch doktrinären Charakter erhalten sollen, ist der Afrikaner AURELIUS AUGUSTINUS. Als Lehrer der Rhetorik erst in Karthago, dann in Rom und Mailand, kennt er die Wirkung ideologisch untermauerter Vorstellungen auf die Massen.“"
                                            },
                                            {
                                                "example_id": "e667b9ba-dbaf-424e-baba-4f01262220a5",
                                                "sense_id": "14896675-d478-34cd-9f69-2a011cfaf25b",
                                                "text": "„Karthago war – in antiken Dimensionen – eine Weltstadt und eine Großmacht. Dies haben die Menschen der Antike nie vergessen. Rund 100 Jahre nach dem Untergang der Stadt schrieb Cicero: ‚Ohne klare politische Grundsätze hätte Karthago nicht etwa 600 Jahre lang eine so gewaltige Machtstellung besessen.‘“"
                                            },
                                            {
                                                "example_id": "6b99c5c0-318e-40a2-ae6f-d49025dffeee",
                                                "sense_id": "14896675-d478-34cd-9f69-2a011cfaf25b",
                                                "text": "„Der byzantinische Feldherr Belisar, unterwegs von Byzanz nach Karthago, das er den Vandalen entreißen sollte, nahm das stimmenreiche Mädchen mit.“"
                                            },
                                            {
                                                "example_id": "47255d04-afa9-45eb-a74a-8cf3adf419a7",
                                                "sense_id": "14896675-d478-34cd-9f69-2a011cfaf25b",
                                                "text": "„Die verbleibenden Tage in Libyen nutzen wir intensivst. Wir besuchen Leptis Magna und Sabratha, beides ursprünglich punische Handelsstädte, die mit dem Fall Karthagos ins Römische Reich eingegliedert wurden.“"
                                            },
                                            {
                                                "example_id": "312a18f6-1fde-4db5-b464-e3bc26c81c1b",
                                                "sense_id": "14896675-d478-34cd-9f69-2a011cfaf25b",
                                                "text": "„Das Meer war Karthagos Element und die Flotte seine Lebensader.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad266738-77f0-385a-9bce-77ecc9cf5e32",
                                        "entry_id": "1912794e-e63c-3ba1-850e-c2dfd3c50676",
                                        "glosses": [
                                            "der um die Ruinen der unter [1] beschriebenen antiken Stadt entstandene und nach dieser benannte Vorort von Tunis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0ed141f-fdd8-4e7c-8e71-02be93c9fabf",
                                                "sense_id": "ad266738-77f0-385a-9bce-77ecc9cf5e32",
                                                "text": "„Heute ist Karthago ein Villenvorort von Tunis, der stark durchsetzt ist von punischen und römischen Ruinen.“"
                                            },
                                            {
                                                "example_id": "f4977dd6-046d-477a-be6d-3e1f01fa7cd5",
                                                "sense_id": "ad266738-77f0-385a-9bce-77ecc9cf5e32",
                                                "text": "„Das heutige Karthago ist der wohl schönste Vorort von Tunis mit palmen- und eukalyptusgesäumten Alleen, Villen und Gärten voll roter Hibiskusblüten und lila Bougainvilleen.“"
                                            },
                                            {
                                                "example_id": "2d23e709-f6c1-4619-857b-e5adaa399baa",
                                                "sense_id": "ad266738-77f0-385a-9bce-77ecc9cf5e32",
                                                "text": "„Eindeutig war der Fall bei der Belagerung des Palastes Ben Alis im Vorort Karthago: Augenzeugen und die Armee berichteten übereinstimmend, dass sich die Leibgarde auf dem Hügel verschanzt hatte und wild um sich schoss.“"
                                            },
                                            {
                                                "example_id": "1197278a-820b-4e3c-94de-5341f7bbe771",
                                                "sense_id": "ad266738-77f0-385a-9bce-77ecc9cf5e32",
                                                "text": "„Drei Stunden ist Ahmed am letzten Sonntag im weiss getünchten Pausenhof der Primarschule von Karthago in der Schlange gestanden – bei 26 Grad im Schatten, ohne ein Fläschchen Wasser, ohne Zeitung, MP3-Player oder iPad – und hat einfach ruhig gewartet.“"
                                            },
                                            {
                                                "example_id": "ef0a2ae1-7e8f-4a17-ac88-7a75d2578b3a",
                                                "sense_id": "ad266738-77f0-385a-9bce-77ecc9cf5e32",
                                                "text": "„Rund um den Präsidentenpalast in Karthago, einem Vorort von Tunis, wird stundenlang geschossen: Die Armee setzt die Präsidialgarde außer Gefecht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
