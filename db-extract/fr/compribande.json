                        "examples": [
                            {
                                "example_id": "d9d44fd9-6f95-42e3-9d3a-b5165dc38285",
                                "sense_id": "2ccda82a-be55-306b-9dbd-2f2ecf682933",
                                "text": "La compribande fenêtre est une évolution technique permettant d’obtenir une étanchéité à l’air et à l’eau."
                            },
                            {
                                "example_id": "8e1ed0c4-ed5b-41b8-93c3-ff127bad27ac",
                                "sense_id": "2ccda82a-be55-306b-9dbd-2f2ecf682933",
                                "text": "Compribande pour le remplissage des feuillures et des transitions lors du vitrage de fenêtres, de portes et de vitrages fixes."
                            },
                            {
                                "example_id": "e8f14b7d-0218-49d8-88eb-1f6107a95e4f",
                                "sense_id": "2ccda82a-be55-306b-9dbd-2f2ecf682933",
                                "text": "Pour isoler au maximum vos menuiseries et les calfeutrer entre le cadre de vos fenêtres et la maçonnerie, nous utilisons un compribande résistant aux intempéries et UV avec un coefficient acoustique de 44 Décibels"
