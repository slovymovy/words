                "senses": [
                    {
                        "sense_id": "640356fd-835e-3049-ad62-7e3118783b16",
                        "entry_id": "4c7a7576-5054-36ea-a6b0-a1e1ffc151e8",
                        "glosses": [
                            "das gegenseitige Erfassen zweier Personen mit den Augen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "180836b2-152c-42dc-b62c-75effe6035af",
                                "sense_id": "640356fd-835e-3049-ad62-7e3118783b16",
                                "text": "„Interessanterweise halten Menschen intensiver Blickkontakt, wenn sie jemandem zuhören, als wenn sie selbst sprechen.“"
                            },
                            {
                                "example_id": "b9f1ea22-8700-43ec-a0b6-b161ca9ddaff",
                                "sense_id": "640356fd-835e-3049-ad62-7e3118783b16",
                                "text": "„Er suchte Blickkontakt mit den zwei Dutzend Studiogästen, um sich offensichtlich eine Bestätigung von dort abzuholen.“"
                            },
                            {
                                "example_id": "36efd1f3-e5ec-4f19-b170-d11e88f9eaf0",
                                "sense_id": "640356fd-835e-3049-ad62-7e3118783b16",
                                "text": "„Dabei lächelte sie ihn an und nahm ersten Blickkontakt auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cac71f4-4c83-40fc-a1d3-76ab9c4581d6",
                        "source_entry_id": "4c7a7576-5054-36ea-a6b0-a1e1ffc151e8",
                        "source_sense_id": "640356fd-835e-3049-ad62-7e3118783b16",
                        "source_sense_description": "das gegenseitige Erfassen zweier Personen mit den Augen",
                        "target_lang_word": "eye contact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eye contact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94fec50a-815f-3149-a006-543becf0fde9",
                                        "entry_id": "4b4bf951-046e-37eb-8215-bd1ec515dfee",
                                        "glosses": [
                                            "The condition or action of looking at another human or animal in the eye."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b331190-c2f7-4441-8c43-0dc215702551",
                                                "sense_id": "94fec50a-815f-3149-a006-543becf0fde9",
                                                "text": "If you make the animal angry, walk slowly backwards and avoid making eye contact."
                                            },
                                            {
                                                "example_id": "85b6f135-d1d0-4301-b318-a9552d7a375b",
                                                "sense_id": "94fec50a-815f-3149-a006-543becf0fde9",
                                                "text": "to make eye contact with someone"
                                            },
                                            {
                                                "example_id": "d81619b1-b462-4791-bb72-e914a46910f3",
                                                "sense_id": "94fec50a-815f-3149-a006-543becf0fde9",
                                                "text": "Even the blithely unselfconscious Homer is more than a little freaked out by West’s private reverie, and encourages his spawn to move slowly away without making eye contact with the crazy man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d75bcdd7-b71e-4bd1-a5bc-e2e12579b161",
                        "source_entry_id": "4c7a7576-5054-36ea-a6b0-a1e1ffc151e8",
                        "source_sense_id": "640356fd-835e-3049-ad62-7e3118783b16",
