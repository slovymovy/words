                "senses": [
                    {
                        "sense_id": "bf824c35-01e0-369d-8ff9-e0bbc08d150f",
                        "entry_id": "d2c71356-b79c-312f-86cb-e47ff5f08561",
                        "glosses": [
                            "Partikel, die das Element des Satzes, dem sie zugeordnet sind, besonders hervorhebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19e456b5-5b5d-45cf-ae13-f2ee46c81602",
                                "sense_id": "bf824c35-01e0-369d-8ff9-e0bbc08d150f",
                                "text": "In dem Satz „Als Begleitperson war nur der Klassenlehrer dabei.“ ist „nur“ eine Fokuspartikel, die die Wortgruppe „der Klassenlehrer“ hervorhebt."
                            },
                            {
                                "example_id": "05df1a25-50fc-47b2-aa05-59618d0b083a",
                                "sense_id": "bf824c35-01e0-369d-8ff9-e0bbc08d150f",
                                "text": "„Fokuspartikeln bilden zusammen mit ihrem Bezugselement das Zentrum einer Aussage, also den Teil des Satzes mit dem höchsten Mitteilungswert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
