                                        "glosses": [
                                            "primata de porte médio da família Cebidae (Cebus capucinus) nativo das florestas da América Central e extremo noroeste da América do Sul (espécie de macaco do Novo Mundo), vive em grupos de vinte indivíduos na média, atingindo mais de dez lustros de idade"
                                        ],
