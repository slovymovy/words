                "senses": [
                    {
                        "sense_id": "adbbe1a0-00f1-3b9c-aeaf-12da38e386e4",
                        "entry_id": "8a26c879-71ff-3728-8970-7f09a47e7dfa",
                        "glosses": [
                            "Diagnosegerät zur Bestimmung der Abbildungsfehler des menschlichen Auges"
                        ],
                        "tags": [
                            "Ophthalmiatrik"
                        ],
                        "examples": [
                            {
                                "example_id": "538f1d05-e4c3-45fd-88b7-47bc2a67a50f",
                                "sense_id": "adbbe1a0-00f1-3b9c-aeaf-12da38e386e4",
                                "text": "Die Wellenfrontfehler werden mithilfe von Aberrometern (Wellenfrontanalysegeräte) gemessen."
                            },
                            {
                                "example_id": "d9bab002-4064-43ea-bbbc-a932ab146add",
                                "sense_id": "adbbe1a0-00f1-3b9c-aeaf-12da38e386e4",
                                "text": "Die gängigsten Aberrometer arbeiten mit dem Hartmann-Shack-Sensor, einige auch nach dem Tscherning-Prinzip oder dem ray tracing-Prinzip."
                            },
                            {
                                "example_id": "9cfd43cc-235b-47a9-bf51-e02c0026aad1",
                                "sense_id": "adbbe1a0-00f1-3b9c-aeaf-12da38e386e4",
                                "text": "Das konventionelle Aberrometer hingegen misst die akkumulierte Gesamtaberration entlang eines Strahles, kann aber nicht den Ort des Entstehens der Aberration (Hornhaut, Linse) ermitteln."
                            },
                            {
                                "example_id": "a836a6cf-ad67-469a-aacd-1449150a2e27",
                                "sense_id": "adbbe1a0-00f1-3b9c-aeaf-12da38e386e4",
                                "text": "Für die meisten refraktiven Chirurgen stellen Aberrometer das Instrument zur Erhebung der Eingangsdaten zur wellenfrontgeführten Behandlung dar."
                            },
                            {
                                "example_id": "a8d6b3d0-c821-416c-8c44-f23116a0c679",
                                "sense_id": "adbbe1a0-00f1-3b9c-aeaf-12da38e386e4",
                                "text": "Daher gehört das Aberrometer meist zur Grundausstattung der Laserplattform."
                            },
                            {
                                "example_id": "159ffb9e-1ff3-4a5d-a20e-b0504ec4940a",
                                "sense_id": "adbbe1a0-00f1-3b9c-aeaf-12da38e386e4",
                                "text": "Die kompakte Kombination aus Topograph und Aberrometer wird bei Verkleinerung der Komponenten zunehmend an Bedeutung gewinnen, da so zeitsparende Messungen möglich sind."
                            },
                            {
                                "example_id": "37b6d92e-153c-48a7-894d-89200dc13dd0",
                                "sense_id": "adbbe1a0-00f1-3b9c-aeaf-12da38e386e4",
                                "text": "\"Ich vergleiche den Unterschied zwischen der alten Brillenglasbestimmung und der neu entwickelten Diagnose mit dem Aberrometer immer mit einem Anzug von der Stange und einem Maßanzug\", sagt Michael Knorz vom Universitätsklinikum Mannheim."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
