                        "glosses": [
                            "Personne qui fait métier de maquiller, au théâtre, au cinéma, dans un institut de beauté, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a4828e-2d9a-4d6e-b66d-850cab6a28d4",
                                "sense_id": "435be366-0293-3f9c-addd-abfbde3b411e",
                                "text": "Samira invita la coiffeuse et le maquilleur qui attendaient dans le couloir à entrer."
                            }
                        ]
