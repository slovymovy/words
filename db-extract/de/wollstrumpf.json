                ],
                "senses": [
                    {
                        "sense_id": "75d972e9-dc19-382f-8af2-b94441fe9ae5",
                        "entry_id": "e6890a90-c9c0-307f-b55a-baaa40515af3",
                        "glosses": [
                            "Strumpf aus Wolle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "864b728c-5907-412c-ad70-1f96eb8d9104",
                                "sense_id": "75d972e9-dc19-382f-8af2-b94441fe9ae5",
                                "text": "„Bei ihrer ersten Zusammenkunft mit Major Dincklage trug Käthe, was sie immer trug: einen schwarzen Sweater mit dreieckigem Ausschnitt, einen engen dunkelbraunen Rock, dünne graue Wollstrümpfe, ziemlich feste Schuhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8a202b4-3888-4c6e-944a-5cffec05406d",
                        "source_entry_id": "e6890a90-c9c0-307f-b55a-baaa40515af3",
                        "source_sense_id": "75d972e9-dc19-382f-8af2-b94441fe9ae5",
                        "source_sense_description": "Strumpf aus Wolle",
                        "target_lang_word": "bas de laine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bas de laine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bf09b64-f34f-382f-84e9-5a9438b4e4bb",
                                        "entry_id": "4ebda7b2-23dc-393c-918a-ecbb3bcab8f2",
                                        "glosses": [
                                            "Bas dans lequel on plaçait l’argent lorsque l’on voulait éviter de se le faire voler."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3303723a-6abb-43d7-9f23-03da0139b5a5",
                                                "sense_id": "5bf09b64-f34f-382f-84e9-5a9438b4e4bb",
                                                "text": "Il faut prendre conscience du passage, en quelques décennies, de la lampe à pétrole au rayon laser, du fiacre aux satellites, du boulier des comptables russes à l’ordinateur, des économies dans des bas de laine aux assurances modernes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0748dc-3c97-340c-98d9-7281cc424f09",
                                        "entry_id": "4ebda7b2-23dc-393c-918a-ecbb3bcab8f2",
                                        "glosses": [
                                            "Endroit sécuritaire et connu de la seule personne y ayant déposé l’argent (ou le bien)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb4f4dc5-1ccf-45a8-a94d-8fde913807ca",
                                                "sense_id": "0a0748dc-3c97-340c-98d9-7281cc424f09",
                                                "text": "Sûr que quand je calencherai, vous s’rez trop occupés à chercher mon bas de laine pour pleurer vot’pauv’mère !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43fc8b04-c99b-37c4-9e9d-ae442508d154",
                                        "entry_id": "4ebda7b2-23dc-393c-918a-ecbb3bcab8f2",
                                        "glosses": [
                                            "Réserve d’argent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e2d4376-dca4-44ea-80be-fc8dc6b64e23",
                                                "sense_id": "43fc8b04-c99b-37c4-9e9d-ae442508d154",
                                                "text": "Ses trois épouses successives, douces comme des agnelles, avaient chacune élevé trois familles obéissantes et respectables. Toutes trois lui avaient également apporté quelque chose dans leur bas de laine."
                                            },
                                            {
                                                "example_id": "affcf2fa-e21f-4e6c-bd85-09c3ac779f35",
                                                "sense_id": "43fc8b04-c99b-37c4-9e9d-ae442508d154",
                                                "text": "Elle avait l’impression d’être à la tête d’une vraie fortune, à l’époque. Mais aujourd’hui, la somme est devenue un petit bas de laine."
                                            },
                                            {
                                                "example_id": "8cfcc90a-8595-4ee3-adec-e51589d1bcca",
                                                "sense_id": "43fc8b04-c99b-37c4-9e9d-ae442508d154",
                                                "text": "Durant le confinement, les Français ont réduit leurs dépenses et ont gonflé leur bas de laine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
