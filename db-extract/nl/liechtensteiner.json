                "translations": [
                    {
                        "translation_id": "df6e26e1-434e-431e-9923-2f7d010ffb86",
                        "source_entry_id": "f60bcd6d-8c46-3680-8874-9930f7ed4a50",
                        "source_sense_id": "59037af8-3727-3fd7-b24c-6e2325a93c11",
                        "source_sense_description": "jemand aus Liechtenstein",
                        "target_lang_word": "Liechtensteiner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liechtensteiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a17f550d-9b99-3c81-814c-0a4abc5ff96f",
                                        "entry_id": "6ce47187-6326-3e30-b5e6-3489ec49bbf5",
                                        "glosses": [
                                            "Staatsbürger von Liechtenstein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa6caeca-4965-4a0d-9609-b4ba432e7820",
                                                "sense_id": "a17f550d-9b99-3c81-814c-0a4abc5ff96f",
                                                "text": "„Die klar überlegenen Liechtensteiner bezwangen den FC Winterthur 3:0.“"
                                            },
                                            {
                                                "example_id": "f6ea35f7-8165-4773-ace1-5be81c6f0cca",
                                                "sense_id": "a17f550d-9b99-3c81-814c-0a4abc5ff96f",
                                                "text": "„Das «Liechtensteiner Vaterland» hat eine Strassenumfrage durchgeführt, um einige Vorlieben herauszufinden, die der Liechtensteiner an Weihnachten pflegt.“"
                                            },
                                            {
                                                "example_id": "24bde6a1-fde2-4cbf-8366-24e5157cd0e9",
                                                "sense_id": "a17f550d-9b99-3c81-814c-0a4abc5ff96f",
                                                "text": "„Feuerwerk, feines Essen, Party und Glücksbringer gehören in Liechtenstein zur traditionellen Silvesterfeier. Eine Strassenumfrage zeigt, dass die meisten Liechtensteinerinnen und Liechtensteiner eine gemütliche Runde unter Freunden oder in der Familie vorziehen.“"
                                            },
                                            {
                                                "example_id": "2908be7d-19d6-4482-93a6-dc7d95bae92d",
                                                "sense_id": "a17f550d-9b99-3c81-814c-0a4abc5ff96f",
                                                "text": "Es ist äußerst selten, dass man in Norddeutschland einem waschechten Liechtensteiner begegnet."
                                            },
                                            {
                                                "example_id": "d7e06931-4bb3-48d3-a6f1-aa7969640ca8",
                                                "sense_id": "a17f550d-9b99-3c81-814c-0a4abc5ff96f",
                                                "text": "„Der bosnische Ref verblüffte mit etlichen strittigen Entscheiden und zeigte damals u. a. dem Liechtensteiner Martin Büchel zu Unrecht Rot […].“"
                                            },
                                            {
                                                "example_id": "d834cd30-9717-4b51-8ed0-0d578162971c",
                                                "sense_id": "a17f550d-9b99-3c81-814c-0a4abc5ff96f",
                                                "text": "„Nach Auskunft des Amtes für Statistik könne davon ausgegangen werden, dass mindestens 3300 Liechtensteiner im Ausland lebten, erklärte Quaderer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Liechtensteiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f38df427-b8cd-3ae3-bfa4-e58ee183e4b1",
                                        "entry_id": "7f1491f0-3f44-39e1-9e24-ad434b99369e",
                                        "glosses": [
                                            "für Liechtenstein charakteristisch, aus Liechtenstein stammend, zu Liechtenstein gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2831feaa-d73b-4291-84d5-274937e45c8d",
                                                "sense_id": "f38df427-b8cd-3ae3-bfa4-e58ee183e4b1",
                                                "text": "Meinhard ist ein Liechtensteiner Bauer."
                                            },
                                            {
                                                "example_id": "a1c5b6ce-8396-4c84-9da0-3cec83c3c905",
                                                "sense_id": "f38df427-b8cd-3ae3-bfa4-e58ee183e4b1",
                                                "text": "„Mit dem Kauf der BHF-Bank durch die Liechtensteiner LGT werden die Karten im Geschäft mit vermögenden Kunden neu gemischt.“"
                                            },
                                            {
                                                "example_id": "b40968b7-7b78-4084-9f99-ec507c2b49cf",
                                                "sense_id": "f38df427-b8cd-3ae3-bfa4-e58ee183e4b1",
                                                "text": "„Der gebeutelte Liechtensteiner Treuhandsektor will sein Image mit einer Plakatkampagne im Inland verbessern. Darin wird die Bedeutung der Branche für die Liechtensteiner Wirtschaft herausgestrichen.“"
                                            },
                                            {
                                                "example_id": "5af997ea-5c63-4e44-a84d-78619ae55c7e",
                                                "sense_id": "f38df427-b8cd-3ae3-bfa4-e58ee183e4b1",
                                                "text": "„Die Bundesliga, die TSG 1899 Hoffenheim, hat gerufen, doch der FC Basel lässt das 17-jährige Liechtensteiner Talent und fünffachen Nationalspieler Sandro Wieser nicht ziehen.“"
                                            },
                                            {
                                                "example_id": "6291f008-659d-4526-9182-eee5d8bb69d4",
                                                "sense_id": "f38df427-b8cd-3ae3-bfa4-e58ee183e4b1",
                                                "text": "„Am 8. November wurde der Liechtensteiner Schauspielerin Sarah Viktoria Frick der «Nestroy» in Wien verliehen.“"
                                            },
                                            {
                                                "example_id": "d73e9f4e-e075-49d8-8879-07bf7e4faf52",
                                                "sense_id": "f38df427-b8cd-3ae3-bfa4-e58ee183e4b1",
                                                "text": "„Seit Zumwinkel mit seinen Schwarzgeldern aufflog, ist das Interesse an Liechtensteiner Familienstiftungen stark rückläufig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
