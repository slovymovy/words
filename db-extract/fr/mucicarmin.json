                "senses": [
                    {
                        "sense_id": "b3d2378d-8296-3fdf-9ffc-6de4c736aafe",
                        "entry_id": "9e41d756-3ac4-3d3e-b850-9ffb28c10f2a",
                        "glosses": [
                            "Colorant composé d’un gramme de carmin, de deux grammes de chlorure d’aluminium dissous dans 100 ml d’éthanol à 50°, il se fixe sur certains polysaccharides et sur la mucine, il est utilisé en histologie, et pour certains diagnostics médicaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f4fab8-e0fd-4894-b3e7-e1050eaa6faa",
                                "sense_id": "b3d2378d-8296-3fdf-9ffc-6de4c736aafe",
                                "text": "Le mucicarmin n’est donc pas un colorant spécifique de la mucine , à moins d’admettre au sein de ces masses colloïdes la présence d’une substance voisine de la mucine."
                            },
                            {
                                "example_id": "0654761e-3a5d-45b9-a852-16b8ebea290c",
                                "sense_id": "b3d2378d-8296-3fdf-9ffc-6de4c736aafe",
                                "text": "D’autres colorations histochimiques permettent plus spécifiquement d’identifier certains champignons : les colorations par le bleu Alcian et par le mucicarmin permettent de bien visualiser la capsule des cryptococcoques."
                            }
                        ]
                    }
                ],
