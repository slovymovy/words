                        "source_sense_id": "62118208-2b13-3e46-ae18-a55ff31095fe",
                        "source_sense_description": "Verkettung von Zeichenketten oder Datenstrukturen",
                        "target_lang_word": "concatenation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
