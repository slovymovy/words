    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2a582688-f83c-3718-9f5c-39c55dfe3ee2",
                "word": "cuboctahedron",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5e829e3d-0942-4ae2-80b1-ee1be17e365f",
                        "entry_id": "2a582688-f83c-3718-9f5c-39c55dfe3ee2",
                        "tags": [
                            "plural"
                        ],
                        "form": "cuboctahedrons"
                    },
                    {
                        "form_id": "d258737c-7891-45b7-9568-2dc2c6c9e14a",
                        "entry_id": "2a582688-f83c-3718-9f5c-39c55dfe3ee2",
                        "tags": [
                            "plural"
                        ],
                        "form": "cuboctahedra"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb41fd34-2190-370d-9c14-331dc52e71d3",
                        "entry_id": "2a582688-f83c-3718-9f5c-39c55dfe3ee2",
                        "glosses": [
                            "An Archimedean solid that has fourteen faces (eight triangular and six square) and is both isogonal and isotoxal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8d4439a-00be-4011-a92f-e577edb7ddae",
                                "sense_id": "fb41fd34-2190-370d-9c14-331dc52e71d3",
                                "text": "There are just two polyhedra that will fulfill these conditions: the cuboctahedron and the icosidodecahedron (Diagram 3.3)."
                            },
                            {
                                "example_id": "fb4f712f-016f-4566-94a2-458d3acdd7a4",
                                "sense_id": "fb41fd34-2190-370d-9c14-331dc52e71d3",
                                "text": "In the case of perfect, symmetric L1₀ cuboctahedra, two of the (001)-surfaces have to be terminated completely with either iron or platinum."
                            },
                            {
                                "example_id": "1d347dd3-8550-4926-b3a6-829d08ae4994",
                                "sense_id": "fb41fd34-2190-370d-9c14-331dc52e71d3",
                                "text": "Octahedra are also needed to make the packing of square-sharing cuboctahedra space filling (Fig. 2.4(c))."
                            },
                            {
                                "example_id": "e97b883f-00f7-4499-baae-5bb7b4a42dfe",
                                "sense_id": "fb41fd34-2190-370d-9c14-331dc52e71d3",
                                "text": "2015, Ke Jiang, Antoliy O. Pinchuk, Chapter Two: Noble Metal Nanomaterials: Synthetic Routes, Fundamental Properties, and Promising Applications, Robert E. Camley, Robert L. Stamps (editors), Solid State Physics, Volume 66, Elsevier, page 151,\nYang and coworkers have prepared Pt cuboctahedrons and cubes by reducing K₂PtCl₄ with H₂ generated in situ from the hydrolysis of NaBH₄ in the presence of tetradecyltrimethylammonium bromide as a surfactant [157,158]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5e61bc7-675b-4d61-93c1-7d86d75d311f",
                        "source_entry_id": "2a582688-f83c-3718-9f5c-39c55dfe3ee2",
                        "source_sense_id": "fb41fd34-2190-370d-9c14-331dc52e71d3",
                        "source_sense_description": "polyhedron with 8 triangular and 6 square faces",
                        "target_lang_word": "cuboctaèdre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuboctaèdre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4434ed9-76d1-3abf-a32f-7e3cb77873f3",
                                        "entry_id": "e658e188-6655-3fde-8bbd-e06b72844480",
                                        "glosses": [
                                            "Tétradécaèdre intersection d’un cube et d’un octaèdre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa70d432-ba0d-4564-b813-9f6195e6fb6b",
                                                "sense_id": "b4434ed9-76d1-3abf-a32f-7e3cb77873f3",
                                                "text": "La sulfamide forme des cristaux volumineux qui fournissent le seul exemple connu d’hémiédrie, avec des faces parallèles dans un cuboctaèdre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4ad1fa5-4d54-44ca-8f27-e4f0031f1db6",
                        "source_entry_id": "2a582688-f83c-3718-9f5c-39c55dfe3ee2",
