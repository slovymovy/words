                                "target_senses": [
                                    {
                                        "sense_id": "f70ae754-f0a7-363e-a3cd-2f98a4c78f96",
                                        "entry_id": "a8080813-e7fc-316d-8a8e-0daa1e176bf9",
                                        "glosses": [
                                            "Someone who classifies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73acb8bd-fe00-4a86-8858-7788465b725d",
                                                "sense_id": "f70ae754-f0a7-363e-a3cd-2f98a4c78f96",
                                                "text": "He was a model of anal defensiveness: fastidious in his dress and appearance, a collector and putter of things in order, a classifier and labeler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f758da9b-12ba-3d01-b50e-3e701fc0426d",
                                        "entry_id": "a8080813-e7fc-316d-8a8e-0daa1e176bf9",
                                        "glosses": [
                                            "A word or morpheme used in some languages (such as CJKV languages and American Sign Language), in certain contexts (such as counting), to indicate the semantic class to which something belongs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f531e67-780c-3655-a6f7-14e325baa714",
                                        "entry_id": "a8080813-e7fc-316d-8a8e-0daa1e176bf9",
                                        "glosses": [
                                            "A machine that separates particles or objects of different size or density."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2db4b171-4b98-3f09-8808-cc58ff623a94",
                                        "entry_id": "a8080813-e7fc-316d-8a8e-0daa1e176bf9",
                                        "glosses": [
                                            "A program or algorithm that classifies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49c68780-9eaa-3c14-85f9-950bffce8072",
                                        "entry_id": "a8080813-e7fc-316d-8a8e-0daa1e176bf9",
                                        "glosses": [
                                            "A metaclass used to group other entities having common features."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd32159c-a937-4f8c-bd37-bc43c7259c4e",
                                                "sense_id": "49c68780-9eaa-3c14-85f9-950bffce8072",
                                                "text": "A classifier can have several types of extra information attached to it via a UML mechanism called adornments."
                                            },
                                            {
                                                "example_id": "15166dd5-653f-42e5-b0ed-11bd21a29ea2",
                                                "sense_id": "49c68780-9eaa-3c14-85f9-950bffce8072",
                                                "text": "The owner scope of a feature specifies whether the feature appears in each instance of the classifier or whether there is just a single instance of the feature for all instances of the classifier."
                                            },
                                            {
                                                "example_id": "3f0abaf6-9ee6-4881-bf23-36a3d847c5d6",
                                                "sense_id": "49c68780-9eaa-3c14-85f9-950bffce8072",
                                                "text": "The figure also shows that instances can be associated with a classifier Behavior, which represents the behavior that active objects start executing when created."
                                            }
                                        ]
                                    }
                                ]
                            }
