                "senses": [
                    {
                        "sense_id": "a1e9c2ed-5cd0-3581-88ec-911e0ce7e61c",
                        "entry_id": "a8e8f770-2461-3347-a2d7-c5a70f8b7f29",
                        "glosses": [
                            "Tisch, der in einem Esszimmer steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0781936-9bd3-4f50-84c0-6582af916325",
                                "sense_id": "a1e9c2ed-5cd0-3581-88ec-911e0ce7e61c",
                                "text": "„Wir drei sitzen um den Esszimmertisch herum, Adam und Fertility und ich, und füllen diese Umschläge.“"
                            },
                            {
                                "example_id": "569ccb16-7bc3-4247-8232-b0c0fef9df14",
                                "sense_id": "a1e9c2ed-5cd0-3581-88ec-911e0ce7e61c",
                                "text": "„Meistens gab es dann gefüllten Truthahn, und wir saßen um den großen Esszimmertisch.“"
                            },
                            {
                                "example_id": "b39b362d-a712-45a8-9dae-da5e31bf7c3b",
                                "sense_id": "a1e9c2ed-5cd0-3581-88ec-911e0ce7e61c",
                                "text": "„Meine Papiere und Unterlagen auf dem Esszimmertisch sind alle mit Steinen bedeckt.“"
                            },
                            {
                                "example_id": "23157065-9a0a-4b95-8de3-5784c2fc012f",
                                "sense_id": "a1e9c2ed-5cd0-3581-88ec-911e0ce7e61c",
                                "text": "„Sie bot ihr einen Platz am Esszimmertisch an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
