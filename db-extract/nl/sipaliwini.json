                "senses": [
                    {
                        "sense_id": "a1bdf053-d632-3f5d-9a16-23db11279bf3",
                        "entry_id": "a26f9ca8-516e-3382-9b7f-1de0f004865a",
                        "glosses": [
                            "rivier in het zuiden van Suriname, die uitmondt in de Coeroenierivier"
                        ],
                        "tags": [
                            "toponiem: rivier"
                        ],
                        "examples": [
                            {
                                "example_id": "2c01c74f-2d7f-48a3-b225-dde501060cf9",
                                "sense_id": "a1bdf053-d632-3f5d-9a16-23db11279bf3",
                                "text": "De Wajana wonen in het zuidoosten langs de Lawa- en Tapanahony-rivieren, de Trio in het zuiden langs de Tapanahony en de Sipaliwini en de Akurio wonen voornamelijk in een van de Trio-dorpen."
                            }
                        ]
                    },
                    {
                        "sense_id": "048b5239-dfe3-3d44-8852-17760e143b99",
                        "entry_id": "a26f9ca8-516e-3382-9b7f-1de0f004865a",
                        "glosses": [
                            "plaats in het uiterste zuiden van Suriname, gelegen aan de gelijknamige rivier"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "7be59a03-b467-4d9a-857a-dd8650d18a24",
                                "sense_id": "048b5239-dfe3-3d44-8852-17760e143b99",
                                "text": "Dit terrein zou liggen naast een gouvernementsterrein tussen Sipaliwini en Palimeu."
                            }
                        ]
                    },
                    {
                        "sense_id": "28b1ba12-4837-3ce1-b1f8-b534aff61aee",
                        "entry_id": "a26f9ca8-516e-3382-9b7f-1de0f004865a",
                        "glosses": [
                            "vliegveld in het uiterste zuiden van Suriname, gelegen bij de gelijknamige plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a269a35b-893e-4514-b062-f443311cca8f",
                                "sense_id": "28b1ba12-4837-3ce1-b1f8-b534aff61aee",
                                "text": "Van het industriële tijdperk naar het primitieve is, in Suriname een vliegtochtje van het vliegveld Zorg en Hoop naar Sipaliwini."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfabd0b3-308e-33d6-8e30-467498c888ca",
                        "entry_id": "a26f9ca8-516e-3382-9b7f-1de0f004865a",
                        "glosses": [
                            "district dat bestaat uit het beboste zuidelijk deel van Suriname en zeker driekwart van het land omvat"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "3404add6-b143-462d-b331-903670cbfd81",
                                "sense_id": "dfabd0b3-308e-33d6-8e30-467498c888ca",
                                "text": "Buiten de hoofdstad zijn ze vooral werkzaam in gebieden waar veel mensen bij elkaar wonen. Dat is het geval in alle andere districten met uitzondering van Sipaliwini, het grote zuidelijke district van het land. Het is dan ook niet verwonderlijk dat Chinese Surinamers door hun vele werkzaamheden een vaste en vertrouwde verschijning vormen in het dagelijks verkeer."
                            }
                        ]
                    }
