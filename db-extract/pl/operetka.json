                "senses": [
                    {
                        "sense_id": "5972e82a-0a73-3555-8dc1-225dbc3c4aac",
                        "entry_id": "6fb397c2-de49-3b49-be02-a390eb76d37e",
                        "glosses": [
                            "operetta (theatrical work)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "c96453c7-5ec0-45f8-b9d2-ac9c2570938c",
                                "sense_id": "5972e82a-0a73-3555-8dc1-225dbc3c4aac",
                                "text": "opera i operetka",
                                "translation": "opera and operetta",
                                "english": "opera and operetta"
                            },
                            {
                                "example_id": "4b80b977-84fe-4ae9-9a4d-f4ee929de3e2",
                                "sense_id": "5972e82a-0a73-3555-8dc1-225dbc3c4aac",
                                "text": "rola w operetce",
                                "translation": "role in an operetta",
                                "english": "role in an operetta"
                            },
                            {
                                "example_id": "549a2dcc-78e8-49b5-a276-cd932290ed0a",
                                "sense_id": "5972e82a-0a73-3555-8dc1-225dbc3c4aac",
                                "text": "W niemieckiej wersji operetki Straussa jako główni soliści występować będą m.in. Anna Walczak, Jolanta Gzella, Andrzej Kalinin, Maciej Markowski.",
                                "translation": "The German version of the Strauss' operetta will feature Anna Walczak, Jolanta Gzella, Andrzej Kalinin, Maciej Markowski, among others, as the main soloists.",
                                "english": "The German version of the Strauss' operetta will feature Anna Walczak, Jolanta Gzella, Andrzej Kalinin, Maciej Markowski, among others, as the main soloists."
                            },
                            {
                                "example_id": "eaee9cb3-db4f-48a8-9ed2-06eef49e5e04",
                                "sense_id": "5972e82a-0a73-3555-8dc1-225dbc3c4aac",
                                "text": "Okazało się jednak, że autorem hymnu podanego przez Horoszkiewicza jest Ignacy Tański, mieszkający stale w Puławach, do którego tekstu Lessel pisał operetkę.",
                                "translation": "It turned out however, that the author of the hymn given by Horoszkiewicz was Ignacy Tański, who lived permanently in Puławy, and to whose text Lessel wrote the operetta.",
                                "english": "It turned out however, that the author of the hymn given by Horoszkiewicz was Ignacy Tański, who lived permanently in Puławy, and to whose text Lessel wrote the operetta."
                            },
                            {
                                "example_id": "9da875e5-8f75-49d4-8c22-c506736eeb67",
                                "sense_id": "5972e82a-0a73-3555-8dc1-225dbc3c4aac",
                                "text": "Twórcy przedstawienia zgodnie zapowiadali, że będzie ono kompromisem pomiędzy oczekiwaniami młodzieży, którą przyciągnąć można tylko kolorowym widowiskiem, i starszej publiczności, która tęskni za klasycznymi operetkami.",
                                "translation": "The creators of the show unanimously announced, that it would be a compromise between the expectations of young people, who can only be attracted by a colourful spectacle, and the older audience, that yearns for classic operettas.",
                                "english": "The creators of the show unanimously announced, that it would be a compromise between the expectations of young people, who can only be attracted by a colourful spectacle, and the older audience, that yearns for classic operettas."
                            }
                        ]
                    },
                    {
                        "sense_id": "af3a13b6-3347-3f1a-9e49-68bded2f9998",
                        "entry_id": "6fb397c2-de49-3b49-be02-a390eb76d37e",
                        "glosses": [
                            "operetta house (building)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "d88ff5bc-ce09-416f-94e6-ac4938f6811e",
                                "sense_id": "af3a13b6-3347-3f1a-9e49-68bded2f9998",
                                "text": "kasa operetki",
                                "translation": "ticket office of an operetta house",
                                "english": "ticket office of an operetta house"
                            },
                            {
                                "example_id": "a5b6803a-4011-415c-b28f-e6c53ef8fc35",
                                "sense_id": "af3a13b6-3347-3f1a-9e49-68bded2f9998",
                                "text": "scena operetki",
                                "translation": "stage of an operetta house",
                                "english": "stage of an operetta house"
                            },
                            {
                                "example_id": "098f3b50-7104-4fab-8f85-6638e4e803c9",
                                "sense_id": "af3a13b6-3347-3f1a-9e49-68bded2f9998",
                                "text": "Operetka, znajdująca się zawsze w pobliżu placu Teatralnego, otrzymała na początku wieku dwudziestego gmach dość okazały, wybudowany przez bogacza warszawskiego i wydzierżawiony dyrekcji teatrów rządowych.",
                                "translation": "The operetta house, always located near Theatre Square, was given a rather grand building at the beginning of the twentieth century, built by a wealthy Warsaw man and leased to the government theatre management.",
                                "english": "The operetta house, always located near Theatre Square, was given a rather grand building at the beginning of the twentieth century, built by a wealthy Warsaw man and leased to the government theatre management."
                            },
                            {
                                "example_id": "69c1f896-757a-4280-bd89-82ce9995f4fc",
                                "sense_id": "af3a13b6-3347-3f1a-9e49-68bded2f9998",
                                "text": "Młody człowiek półleżał na ławie, rozwaliwszy przed sobą nogi obute w pantofle z niklowymi klamrami, na wysokich obcasach, jakie widuje się na scenie operetki w kostiumowym wodewilu.",
                                "translation": "The young man was half-lying on a bench, sprawled out in front of him with his feet clad in slippers with nickel buckles, the kind of high heels, that you see on the stage of an operetta house in costumed vaudeville.",
                                "english": "The young man was half-lying on a bench, sprawled out in front of him with his feet clad in slippers with nickel buckles, the kind of high heels, that you see on the stage of an operetta house in costumed vaudeville."
                            },
                            {
                                "example_id": "e25c503c-fa22-4bba-bf90-e6df1ed0b43b",
                                "sense_id": "af3a13b6-3347-3f1a-9e49-68bded2f9998",
                                "text": "Bilety można kupić w kasie operetki codziennie w godzinach od 9 do 18.",
                                "translation": "Tickets can be purchased at the ticket office of the operetta house daily from 0900 to 1800.",
                                "english": "Tickets can be purchased at the ticket office of the operetta house daily from 0900 to 1800."
                            }
                        ]
                    }
