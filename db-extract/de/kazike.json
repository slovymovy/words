                "senses": [
                    {
                        "sense_id": "b333be77-1014-3ccf-8edb-659f2075f963",
                        "entry_id": "19d28840-a2b4-32c5-84ec-0d11adbd3ac9",
                        "glosses": [
                            "Anführer einer Stammesgemeinde, Vorsteher eines Ortes bei den mittel- oder südamerikanischen Indianern (Indios)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5847b5f5-b1e3-44ad-8fad-1618a627eeed",
                                "sense_id": "b333be77-1014-3ccf-8edb-659f2075f963",
                                "text": "„Wir brachten zweihundertzwanzig Skalpe heim, und man wählte mich auf dem Schlachtfeld zum Kaziken.“"
                            },
                            {
                                "example_id": "9fa296b9-44bc-4649-877b-689c0067b1b7",
                                "sense_id": "b333be77-1014-3ccf-8edb-659f2075f963",
                                "text": "„Weil Norte Energia die Geschenke vor allem an die Dorfchefs, die Kaziken verteilte, gründeten immer mehr Parakanã neue Dörfer, deren Kaziken sie werden konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6c1a1e9-4b06-445b-9ff0-26aee41a7f58",
                        "source_entry_id": "19d28840-a2b4-32c5-84ec-0d11adbd3ac9",
                        "source_sense_id": "b333be77-1014-3ccf-8edb-659f2075f963",
                        "target_lang_word": "cacique",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cacique",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55a1adae-c422-3d14-8e67-3bcab065e631",
                                        "entry_id": "e6daae44-859f-34a1-bc4f-aadf121a8e72",
                                        "glosses": [
                                            "A tribal chief in the Spanish West Indies."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37af688b-2fa4-4d1c-bccb-34b2beb02044",
                                                "sense_id": "55a1adae-c422-3d14-8e67-3bcab065e631",
                                                "text": "Mexico has loved a strong leader since before Moctezuma. Indigenous tribes were ruled by caciques, or chieftans^([sic]), and in some rural communities caciques are still unchallenged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe73423e-ac9d-37fa-99e8-1a051de6cb8a",
                                        "entry_id": "e6daae44-859f-34a1-bc4f-aadf121a8e72",
                                        "glosses": [
                                            "A local political leader in Latin America, Spain, or the Philippines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "983cfdcd-10b2-3a2b-ad20-51bf323c8491",
                                        "entry_id": "e6daae44-859f-34a1-bc4f-aadf121a8e72",
                                        "glosses": [
                                            "Any of a number of tropical birds from Central America and South America in the genera Cacicus, Cassiculus, and Amblycercus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b9182c8-16ea-4bf4-85fc-ee3b9968da75",
                        "source_entry_id": "19d28840-a2b4-32c5-84ec-0d11adbd3ac9",
                        "source_sense_id": "b333be77-1014-3ccf-8edb-659f2075f963",
                        "target_lang_word": "cacique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cacique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e1cc5f8-7aa3-36af-b270-ad18d76878d6",
                                        "entry_id": "048087e9-c2cc-34ef-a463-83d3974a2fd6",
                                        "glosses": [
                                            "Terme utilisé par les colons espagnols pour se référer aux dirigeants autochtones en Amérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "123ca097-9102-448d-998a-0a8b89f09b74",
                                                "sense_id": "6e1cc5f8-7aa3-36af-b270-ad18d76878d6",
                                                "text": "Soto continua sa marche à travers des champs de millet, sur une étendue de deux lieues, où il découvrit quelques cabanes éparses. Arrivé à un ruisseau profond, bordé d'arbres, et derrière lequel les Indiens s'étaient retranchés, il combattit, força le passage et marcha encore deux lieues, jusqu'à une ville des Apalaches, qui était composée de cinquante maisons, et dont le cacique, nommé Canaſi, s’était s’était enfuit avec ses vassaux."
                                            },
                                            {
                                                "example_id": "2d3328b6-926b-4016-bff1-1a79b3ecd013",
                                                "sense_id": "6e1cc5f8-7aa3-36af-b270-ad18d76878d6",
                                                "text": "Le cacique Raoni et Marishöri Najashi ont présenté leurs engagements en matière de préservation des modes de vie des peuples indigènes et de protection de l’environnement, notamment des forêts tropicales."
                                            },
                                            {
                                                "example_id": "23f14d3b-e34c-4db1-a9cf-5508fe3ddba1",
                                                "sense_id": "6e1cc5f8-7aa3-36af-b270-ad18d76878d6",
                                                "text": "Le corps du cacique, originaire du village de Cocalinho, a été retrouvé dimanche au petit matin, sous le pont du fleuve Zutiwa …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21036d46-53f4-3ff3-b94b-a74c6cfc2b25",
                                        "entry_id": "048087e9-c2cc-34ef-a463-83d3974a2fd6",
                                        "glosses": [
                                            "Personne détenant une fonction importante."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "198ac279-2b3c-4d65-b60a-2370dd979193",
                                                "sense_id": "21036d46-53f4-3ff3-b94b-a74c6cfc2b25",
                                                "text": "On le voyait aux mines soucieuses et confites des caciques, des établis, des importants, ceux qui avaient fait la loi dans ce métier depuis vingt ans ou plus."
                                            },
                                            {
                                                "example_id": "3a7f3e97-fa13-41d6-a3bb-d07d82ccd2c6",
                                                "sense_id": "21036d46-53f4-3ff3-b94b-a74c6cfc2b25",
                                                "text": "Car, attention, interdire le cumul des mandats sans inciter les citoyens à s'engager reviendrait à remplacer à l'Assemblée nationale des élus de terrain par les caciques des partis."
                                            },
                                            {
                                                "example_id": "2f1e2520-e96e-4e22-a453-8e645a44b54b",
                                                "sense_id": "21036d46-53f4-3ff3-b94b-a74c6cfc2b25",
                                                "text": "Ce n’est pas la prestation de François Fillon lors de sa conférence de presse qui a convaincu les caciques de la droite et du centre de faire bloc autour de lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ddd4685-5d4e-3dd9-bbab-44468ac73091",
                                        "entry_id": "048087e9-c2cc-34ef-a463-83d3974a2fd6",
                                        "glosses": [
                                            "Élève reçu premier au concours de l’École normale supérieure de la rue d’Ulm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66fa7f27-e3d1-4d63-93a0-205511df0c70",
                                                "sense_id": "3ddd4685-5d4e-3dd9-bbab-44468ac73091",
                                                "text": "Le cacique des Lettres se voyait décerner une mention spéciale l'appelant à représenter sa promotion."
                                            },
                                            {
                                                "example_id": "1bc4017f-b8fa-45ca-be23-098756b27625",
                                                "sense_id": "3ddd4685-5d4e-3dd9-bbab-44468ac73091",
                                                "text": "Maurice GENEVOIX"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
