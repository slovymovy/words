                        "source_sense_id": "d6c9b99a-d92e-340c-8e92-bbac448046b9",
                        "source_sense_description": "eten gemaakt van graanvlokken, zuivel, fruit en noten",
                        "target_lang_word": "céréale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "céréale",
