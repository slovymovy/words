                "senses": [
                    {
                        "sense_id": "93fc7a2d-52b3-3d6e-8d47-ed8ca296a54e",
                        "entry_id": "7c6cc374-e829-3fa9-8991-986cda5f1828",
                        "glosses": [
                            "Qui a reçu une ou des médailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bba4e744-94b1-42d6-b5a0-942dedd86b31",
                                "sense_id": "93fc7a2d-52b3-3d6e-8d47-ed8ca296a54e",
                                "text": "Un artiste médaillé."
                            },
                            {
                                "example_id": "2054584a-93f2-4a27-9e57-960fea751907",
                                "sense_id": "93fc7a2d-52b3-3d6e-8d47-ed8ca296a54e",
                                "text": "On y retrouve, par l’accident de l’histoire, ce qui peut le mieux incarner l’uniforme du nouveau siècle : non le torse affreusement médaillé des dictateurs du tiers monde, mais cette simplicité qui veut incarner la proximité et ramener la fonction du chef à celle du chef de famille, du civil qui, aux grandes heures de sa nation, prend les armes après les outils de l’ouvrier aux mains sales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c929b746-bd77-483b-b13d-18d55b6d87b6",
                        "source_entry_id": "7c6cc374-e829-3fa9-8991-986cda5f1828",
                        "source_sense_id": "93fc7a2d-52b3-3d6e-8d47-ed8ca296a54e",
                        "target_lang_word": "medalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medalist",
