                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karzinom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3f64b29-ba23-396c-8b34-5952b49e7506",
                                        "entry_id": "adc83dbf-4565-3537-b378-b79c841795fb",
                                        "glosses": [
                                            "Krebserkrankung, die vom Epithel ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4e0c3f1-77d5-4d51-867b-31bb722dc6f2",
                                                "sense_id": "d3f64b29-ba23-396c-8b34-5952b49e7506",
                                                "text": "Viele Studien geben eine etwa 70-prozentige Koinzidenz von Gallensteinen und einem Karzinom an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bf46855-6fcc-4961-b154-d662e9ac1190",
                        "source_entry_id": "5edc8b75-dd4e-3c54-ab21-ef126baafafb",
                        "source_sense_id": "278e44b7-ad02-3459-9f3f-68ee5b8aac4a",
                        "target_lang_word": "Krebs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krebs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "421b55d4-cad1-34de-bef0-8a56c2c40913",
                                        "entry_id": "96778dde-6749-3ca5-a3a9-85015b04dd54",
                                        "glosses": [
                                            "ein Tier des Stamms Krebstiere (Crustacea), umgangssprachlich meist nur ein Tier der Klasse Höhere Krebse (Malacostraca)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43938b47-3c4a-4730-8b3a-48d89131cdae",
                                                "sense_id": "421b55d4-cad1-34de-bef0-8a56c2c40913",
                                                "text": "Manche Krebse laufen seitwärts."
                                            },
                                            {
                                                "example_id": "b91d2daf-d6b8-409b-9719-70b30bee1c1e",
                                                "sense_id": "421b55d4-cad1-34de-bef0-8a56c2c40913",
                                                "text": "„Wir brauchten wenigstens noch einen Krebs, damit jeder von uns einen essen konnte - obwohl ich mir nicht sicher war, ob ich das überhaupt wollte.“"
                                            },
                                            {
                                                "example_id": "b028d081-ddf4-4556-8d0b-8882026df879",
                                                "sense_id": "421b55d4-cad1-34de-bef0-8a56c2c40913",
                                                "text": "„Es dauerte eine Weile, bis ich herausfand, dass im Teich selbst, aber auch im Zu- und Ablauf, Krebse lebten.“"
                                            },
                                            {
                                                "example_id": "ddaa3227-a0a3-4dea-b3d2-3ae00ff8f68c",
                                                "sense_id": "421b55d4-cad1-34de-bef0-8a56c2c40913",
                                                "text": "„Wir suchten dann auch eine Weile nach solchen Krebsen und drehten alle möglichen Steine um, weil sich Krebse gern unter Steinen verstecken, wir fanden aber keine Krebse.“"
                                            },
                                            {
                                                "example_id": "4a8dda32-a2eb-4610-9902-ad7e8c93aadb",
                                                "sense_id": "421b55d4-cad1-34de-bef0-8a56c2c40913",
                                                "text": "„Die Sonne schien, und Milena lachte wieder, wenn eine Welle sie umriss, ein Krebs über ihren Fuß lief oder sie eine Muschel fand, die sie unbedingt unserer Tante zeigen wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7cfc4af1-6d31-3638-86ec-b6092ad06bea",
                                        "entry_id": "96778dde-6749-3ca5-a3a9-85015b04dd54",
                                        "glosses": [
                                            "eine bösartige Tumorerkrankung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a3d68f-937e-4b2b-aa61-e948cd6d19af",
                                                "sense_id": "7cfc4af1-6d31-3638-86ec-b6092ad06bea",
                                                "text": "Starke UV-Strahlen können zu Krebs führen."
                                            },
                                            {
                                                "example_id": "d13dba58-08a6-4b1a-9010-aad409a2f918",
                                                "sense_id": "7cfc4af1-6d31-3638-86ec-b6092ad06bea",
                                                "text": "„Dem Glasbläser waren die Lungen von Krebs befallen, während Franziska Kanten, immer gelber, die Farbe schwer Leberleidender angenommen hatte.“"
                                            },
                                            {
                                                "example_id": "54cebf36-aa8c-47c0-8104-5bb1dc802d6d",
                                                "sense_id": "7cfc4af1-6d31-3638-86ec-b6092ad06bea",
                                                "text": "„Die Instabilität brauchte nur mit dem vorhersehbaren Tod eines geliebten alten Großvaters in das heimelige kubanische Familienleben einzubrechen, um eine rasche Folge von Katastrophen auszulösen, deren Höhepunkt jetzt ihr Krebs ist.“"
                                            },
                                            {
                                                "example_id": "e309cfae-66c6-4b42-a109-d13ef6453168",
                                                "sense_id": "7cfc4af1-6d31-3638-86ec-b6092ad06bea",
                                                "text": "„Von einem Vater, dessen Frau an Krebs gestorben war und der als Tagelöhner mehrere Söhne versorgen musste, sprach sie öfter.“"
                                            },
                                            {
                                                "example_id": "d647405c-9dbd-42dd-9992-623035e02495",
                                                "sense_id": "7cfc4af1-6d31-3638-86ec-b6092ad06bea",
                                                "text": "„1991, etwa um die Zeit, als seinem Bruder die von Krebs befallene Prostata entfernt wurde, was zu Impotenz und ständiger Inkontinenz führte, unterzog er sich unverzüglich einer Prostatauntersuchung.“"
                                            }
