                ],
                "senses": [
                    {
                        "sense_id": "3bcc09d3-d346-36c5-86ee-41a013c5c5d0",
                        "entry_id": "142cd196-caf8-3ff1-aef0-09ce85f33cfc",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87ec5bab-ea7a-48c2-8e3b-ac1678b910fb",
                                "sense_id": "3bcc09d3-d346-36c5-86ee-41a013c5c5d0",
                                "text": "Frau Schießle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "409ac84b-176c-4410-8159-1445b3697dda",
                                "sense_id": "3bcc09d3-d346-36c5-86ee-41a013c5c5d0",
                                "text": "Herr Schießle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "58531c43-fbd0-4566-bf2a-82377666c200",
                                "sense_id": "3bcc09d3-d346-36c5-86ee-41a013c5c5d0",
                                "text": "Die Schießles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8ebc6a4e-a8b8-4e92-80ea-74f855b44d44",
                                "sense_id": "3bcc09d3-d346-36c5-86ee-41a013c5c5d0",
                                "text": "Der Schießle trägt nie die Pullover, die die Schießle ihm strickt."
                            },
                            {
                                "example_id": "f2fc76da-f151-4458-88f8-8f1f351a0086",
                                "sense_id": "3bcc09d3-d346-36c5-86ee-41a013c5c5d0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schießle kommt, geht der Herr Schießle.“"
                            },
                            {
                                "example_id": "c689bca3-a23c-46da-856a-3a11e73322d6",
                                "sense_id": "3bcc09d3-d346-36c5-86ee-41a013c5c5d0",
                                "text": "Schießle kommt und geht."
                            },
                            {
                                "example_id": "35e78c33-d01e-4c9e-ba99-d942c98f4160",
                                "sense_id": "3bcc09d3-d346-36c5-86ee-41a013c5c5d0",
                                "text": "Schießles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
