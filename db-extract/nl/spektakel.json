                    {
                        "translation_id": "f29fda65-10e2-44f2-adef-c48e681eea54",
                        "source_entry_id": "8601107d-ab49-38f5-8896-c7c66cde79af",
                        "source_sense_id": "54c17bbe-94e0-3c02-b904-2c37ce36317b",
                        "source_sense_description": "opzienbarend schouwspel",
                        "target_lang_word": "spectacle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spectacle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b31db81b-c7ae-3393-a6ff-074cf076f326",
                                        "entry_id": "999faf5d-9d14-339a-8bab-2cc851570e5c",
                                        "glosses": [
                                            "An exciting or extraordinary scene, exhibition, performance etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cec61c92-d8d9-4e5b-b0fa-4c48f6aacafc",
                                                "sense_id": "b31db81b-c7ae-3393-a6ff-074cf076f326",
                                                "text": "The horse race was a thrilling spectacle."
                                            },
                                            {
                                                "example_id": "3856c91b-8c8f-49b5-adc5-623990aec7bf",
                                                "sense_id": "b31db81b-c7ae-3393-a6ff-074cf076f326",
                                                "text": "VVith ſcoffes and ſcornes, and contumelious taunts, / In open Market-place produc't they me, / To be a publique ſpectacle to all: / Here, ſayd they, is the Terror of the French, / The Scar-Crovv that affrights our Children ſo."
                                            },
                                            {
                                                "example_id": "4d5daa03-94bd-4496-a26c-409204307170",
                                                "sense_id": "b31db81b-c7ae-3393-a6ff-074cf076f326",
                                                "text": "22 March 2012, Scott Tobias, AV Club The Hunger Gameshttp://www.avclub.com/articles/the-hunger-games,71293/\nIn movie terms, it suggests Paul Verhoeven in Robocop/Starship Troopers mode, an R-rated bloodbath where the grim spectacle of children murdering each other on television is bread-and-circuses for the age of reality TV, enforced by a totalitarian regime to keep the masses at bay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "882e6923-d9d5-3283-92e6-94a36f52c68e",
                                        "entry_id": "999faf5d-9d14-339a-8bab-2cc851570e5c",
                                        "glosses": [
                                            "An embarrassing or unedifying scene or situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4217baac-8d4a-4fa7-9055-70fe11e1d4d6",
                                                "sense_id": "882e6923-d9d5-3283-92e6-94a36f52c68e",
                                                "text": "He made a spectacle out of himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce3a5fdf-f9f6-32f4-8e15-cfee3a011f1c",
                                        "entry_id": "999faf5d-9d14-339a-8bab-2cc851570e5c",
                                        "glosses": [
                                            "Attributive form of spectacles."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd2e7085-3f2b-4ee6-8225-33ec5eea083b",
                                                "sense_id": "ce3a5fdf-f9f6-32f4-8e15-cfee3a011f1c",
                                                "text": "Some very interesting relics of Adam and Eve were shown us, that were brought from America; such as a fine-tooth comb, made of thorns, a part of a pair of leather spectacle frames, without glasses, a boot jack made of ebony, and a set of pawpaws of props, with the backs filled with a hard substance, resembling lava."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53360c74-f97b-3ee3-b059-b93c82d3ab69",
                                        "entry_id": "999faf5d-9d14-339a-8bab-2cc851570e5c",
                                        "glosses": [
                                            "The brille of a snake."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d25d8f84-387f-3cb0-8798-62c1d451d5bc",
                                        "entry_id": "999faf5d-9d14-339a-8bab-2cc851570e5c",
                                        "glosses": [
                                            "A frame with different coloured lenses on a semaphore signal through which light from a lamp shines at night, often a part of the signal arm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
