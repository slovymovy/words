                "senses": [
                    {
                        "sense_id": "89df2a27-109c-3c6d-9968-f4cdef401ec4",
                        "entry_id": "9199201d-0b5e-3b58-b0d3-b03d17dda7e5",
                        "glosses": [
                            "Amener à une doctrine conciliaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "746fdade-8367-4111-8af4-003f1d762554",
                                "sense_id": "89df2a27-109c-3c6d-9968-f4cdef401ec4",
                                "text": "Autrement dit, ce qui pousse Rome à mésestimer la «doctrine» et à chercher à «conciliariser» à tout prix la Fraternité SPX, c'est sa propre croyance en sa propre doctrine conciliaire."
                            },
                            {
                                "example_id": "13bf3eeb-4719-4146-b330-6b15ae094875",
                                "sense_id": "89df2a27-109c-3c6d-9968-f4cdef401ec4",
                                "text": "En d'autres temps, on aurait sans doute profité des graves dysfonctionnements de cet Institut pour le « normaliser » ou le « conciliariser »."
                            },
                            {
                                "example_id": "c066be50-1495-4472-a8d7-66d02d55a139",
                                "sense_id": "89df2a27-109c-3c6d-9968-f4cdef401ec4",
                                "text": "Ne nous méprenons pas, restons fidèles au combat de la Tradition, et laissons les conciliaires \"conciliariser\"!"
                            }
                        ]
                    }
                ],
