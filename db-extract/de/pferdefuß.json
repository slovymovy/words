                "senses": [
                    {
                        "sense_id": "2bc11c88-ade3-3b65-b445-dc10db57e582",
                        "entry_id": "cd577c2a-ddf7-37b5-80fe-a0ccf3ffaf21",
                        "glosses": [
                            "Fuß eines Pferdes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe1d2da8-b544-4442-972a-9f68d1d0f050",
                                "sense_id": "2bc11c88-ade3-3b65-b445-dc10db57e582",
                                "text": "Pferdefüße sind meist mit Hufeisen beschlagen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5ca7de7c-4beb-30ce-be72-70d7623fe504",
                        "entry_id": "cd577c2a-ddf7-37b5-80fe-a0ccf3ffaf21",
                        "glosses": [
                            "negative Begleiterscheinung; unangenehme Bedingung, die in Kauf genommen werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b664e3-1a28-46b4-818d-ad0ea024862e",
                                "sense_id": "5ca7de7c-4beb-30ce-be72-70d7623fe504",
                                "text": "Das klingt zu schön um wahr zu sein. Die Sache hat doch bestimmt einen Pferdefuß!"
                            },
                            {
                                "example_id": "b35d0222-cbd9-4c16-87ad-bc8b4a8b567c",
                                "sense_id": "5ca7de7c-4beb-30ce-be72-70d7623fe504",
                                "text": "„Duftwolke dachte sich geschwind ein anderes, wie sie meinte, besseres Mittel aus, um dem fatalen Pferdefuß seine Gefährlichkeit zu nehmen: einen kleinen Schwindel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0a83c31d-cf22-3e99-89c8-d116372b2f9a",
                        "entry_id": "cd577c2a-ddf7-37b5-80fe-a0ccf3ffaf21",
                        "glosses": [
                            "anatomische Fehlbildung des menschlichen Fußes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f578eb0-61ae-487b-99af-8fdca14914b3",
                                "sense_id": "0a83c31d-cf22-3e99-89c8-d116372b2f9a",
                                "text": "Ein Pferdefuß kann angeboren oder erworben sein."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
