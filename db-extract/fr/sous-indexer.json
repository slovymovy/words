                "senses": [
                    {
                        "sense_id": "55d13029-c186-35aa-8878-46766d4d0f28",
                        "entry_id": "0894c936-685b-3866-aa56-0ecedbf04086",
                        "glosses": [
                            "Indexer mais en utilisant une valeur inférieure à la valeur de l’index choisi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31dedc53-3858-4a93-8dc5-c0717a7daf68",
                                "sense_id": "55d13029-c186-35aa-8878-46766d4d0f28",
                                "text": "Les syndicats ont en effet répondu positivement à la proposition formulée il y a un mois par le patronat de geler pendant trois ans les pensions ou de les sous-indexer par rapport à l'inflation pendant cinq ans."
                            },
                            {
                                "example_id": "de64ec03-0778-426b-84bb-033eb5e44bef",
                                "sense_id": "55d13029-c186-35aa-8878-46766d4d0f28",
                                "text": "L'autre solution serait de sous-indexer les pensions (inflation moins un point par exemple)."
                            }
                        ]
                    }
                ],
