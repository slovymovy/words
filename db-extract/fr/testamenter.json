                "senses": [
                    {
                        "sense_id": "2fe90e51-ba3a-3642-9008-a75c4e626f3c",
                        "entry_id": "8b0a6ad1-fda7-3e16-b7f4-5938c01e4043",
                        "glosses": [
                            "Tester, écrire un testament."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6b2e3efd-7df9-4b68-ae98-73ff074cfe2d",
                                "sense_id": "2fe90e51-ba3a-3642-9008-a75c4e626f3c",
                                "text": "Je n'aurais pas grand chose à testamenter."
                            },
                            {
                                "example_id": "f62b8fa8-91f5-43ae-9810-d750b604378e",
                                "sense_id": "2fe90e51-ba3a-3642-9008-a75c4e626f3c",
                                "text": "Sans avoir, en mourant, égard à ma prière,\nIl a testamenté tout d'une autre manière."
                            },
                            {
                                "example_id": "3b803317-4f7d-4fa1-b8f7-06130008513b",
                                "sense_id": "2fe90e51-ba3a-3642-9008-a75c4e626f3c",
                                "text": "— Eh bien ! oui, je me marierai ! J’ai encore un peu de bien, va ! et ça n’est pas toi qui en hériteras, car je testamenterai en faveur de mon homme."
                            }
                        ]
                    }
