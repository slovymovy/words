                "senses": [
                    {
                        "sense_id": "4b3c9ec5-098f-3884-b4c9-b7794f6b17ce",
                        "entry_id": "a46f3cc1-799a-3c9a-b7cb-5f48d1c054bb",
                        "glosses": [
                            "innerer Bereich eines Wagens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c104aa64-cb96-4743-9c7c-3e0dac2266ab",
                                "sense_id": "4b3c9ec5-098f-3884-b4c9-b7794f6b17ce",
                                "text": "„Treecastle hob den Stengel auf und schleuderte ihn ins Wageninnere hinein.“"
                            },
                            {
                                "example_id": "b4aa25d7-6395-448d-88d0-ad517946b47b",
                                "sense_id": "4b3c9ec5-098f-3884-b4c9-b7794f6b17ce",
                                "text": "„Schlüssellos geht es auch ins Wageninnere, eine anständige Sitzposition ist mit der Zweiwegeverstellung des Lenkrads schnell gefunden, und auf Tastendruck springt der aufgeladene Vierzylinder munter an.“"
                            },
                            {
                                "example_id": "a907522f-3a78-4792-816c-2728293a548e",
                                "sense_id": "4b3c9ec5-098f-3884-b4c9-b7794f6b17ce",
                                "text": "„Eine crashsichere Box im Wageninneren hat den Aufprall registriert.“"
                            },
                            {
                                "example_id": "30921cd0-1c00-4914-a8dd-58bf21e45e0b",
                                "sense_id": "4b3c9ec5-098f-3884-b4c9-b7794f6b17ce",
                                "text": "„Der Wagen schaukelte auf seiner weichen Federung, als fände im Wageninnern ein erbitterter Kampf statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
