                        "glosses": [
                            "Famille botanique qui regroupe des plantes monocotylédones du type des orchidées."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a513440a-bb2f-463d-8dd7-4bf8e5864b34",
                                "sense_id": "944a99ba-a165-34e7-b52e-75232dd1855f",
                                "text": "Immanquables, des plantes protégées telles que le sabot de Vénus de la famille des Orchidacées, le chardon bleu des Alpes, mais aussi l'emblème de la Savoie, l’edelweiss, minuscule en haute montagne qui peut atteindre des proportions plus importantes en plaine."
                            },
                            {
                                "example_id": "41661f8f-69b8-4dbd-b961-118115114728",
                                "sense_id": "944a99ba-a165-34e7-b52e-75232dd1855f",
                                "text": "Ophrys apifera, connue en Europe sous le nom d’orchidée abeille, est une plante vivace herbacée de la famille des Orchidacées."
                            }
                        ]
