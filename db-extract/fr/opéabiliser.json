                "senses": [
                    {
                        "sense_id": "9ef5385f-561a-3b20-a189-132367280f65",
                        "entry_id": "8d2ef1f8-bd8c-3053-b6e9-a82435b92ceb",
                        "glosses": [
                            "Donner un caractère opéable à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497490f1-c3b4-4926-a603-a84fad8ed243",
                                "sense_id": "9ef5385f-561a-3b20-a189-132367280f65",
                                "text": "Quel sera le destin de ces collaborations tripartites, et son impact sur CELLECTIS, principalement sa capacité à pousser en propre, ou se faire « opéabiliser » ?"
                            },
                            {
                                "example_id": "5d0b8df5-c8e4-4a81-af31-92ee90a33557",
                                "sense_id": "9ef5385f-561a-3b20-a189-132367280f65",
                                "text": "La question est caduque car après tout si l’on regarde derrière nous pour ces fusions lorsque la France fût ^([sic : fut]) active (Pernod Ricard - Allied Domecq, Renault - Nissan, EDF - Edison, etc… ^([sic : etc.])) les cotations boursières attestent plutôt du positif de ces dernières. Y compris pour les « passives opéabilisées » !"
                            },
                            {
                                "example_id": "ad0e04e6-f313-4192-b044-13d0b56c19b9",
                                "sense_id": "9ef5385f-561a-3b20-a189-132367280f65",
                                "text": "il me semble que ça opéabilise ici…"
                            }
                        ]
                    }
