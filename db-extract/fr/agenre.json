            {
                "entry_id": "b26d2fdc-c8a8-35d3-9231-f604edf9b238",
                "word": "agenre",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b41c21a2-60ba-4dfc-8d5e-94c89ce07a62",
                        "entry_id": "b26d2fdc-c8a8-35d3-9231-f604edf9b238",
