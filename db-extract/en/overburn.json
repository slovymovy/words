                        "sense_id": "8b498fe2-bd79-3813-a4a3-efe63b28de77",
                        "entry_id": "f0c2c574-d39b-3167-a1d3-1397ff994805",
                        "glosses": [
                            "An excessive burning."
                        ],
                        "tags": [
                            "rare",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "05135f5a-ff27-4b0c-b829-04b928f52d43",
                                "sense_id": "8b498fe2-bd79-3813-a4a3-efe63b28de77",
                                "text": "The furnace with the hickory wood was at a great heat and in danger of an overburn."
                            },
                            {
                                "example_id": "a13b5087-46f3-4819-92d1-3c26e8564fb5",
                                "sense_id": "8b498fe2-bd79-3813-a4a3-efe63b28de77",
                                "text": "But this is not possible in our ordinary commercial kiln, nor would it be practicable to try it, for the reason that the reduction taking place in the top of the kiln would be so great that the alkalis and other fluxes present in the clay would enter into combination with the ferrous oxide and result in what we term melted brick or an overburn."
                            },
                            {
                                "example_id": "2c489d86-5d8c-4c51-a632-fed447dd7d6a",
                                "sense_id": "8b498fe2-bd79-3813-a4a3-efe63b28de77",
                                "text": "A 1.2-sec overburn of LM ascent propulsion system caused by incorrect manual switching sequence prevented automatic shutdown of engine and resulted in insertion velocity 32 fps greater than planned, placing LM in orbit with 71.4-mi (114.9-km) apolune and 10.6-mi (17.1-km) perilune."
                            }
                        ]
                    }
                ],
