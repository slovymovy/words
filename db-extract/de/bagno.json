                        "glosses": [
                            "Kerker für Schwerverbrecher in Italien und in Frankreich, in dem die Insassen Zwangsarbeiten verrichten mussten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ec15f29-79b5-44d1-8ce0-b14e5ed37cc4",
                                "sense_id": "30d3c895-a9ff-31e2-bb35-ebfb1d20c0e8",
                                "text": "Er saß unschuldig im Bagno."
                            },
                            {
                                "example_id": "a7f96208-09bc-44e0-92bb-5e501eb39d89",
                                "sense_id": "30d3c895-a9ff-31e2-bb35-ebfb1d20c0e8",
                                "text": "Das italienische Bagno ist in etwa mit dem deutschen Zuchthaus zu vergleichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
