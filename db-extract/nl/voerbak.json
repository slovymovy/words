                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60f8fa8a-e69f-3afd-89af-d5c510e577b1",
                                        "entry_id": "b005b19d-9c53-32cf-b033-0ee0dbea7936",
                                        "glosses": [
                                            "A long, narrow depression between waves or ridges; the low portion of a wave cycle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3308c98b-2fd2-49fb-bbde-1174b582bb70",
                                                "sense_id": "60f8fa8a-e69f-3afd-89af-d5c510e577b1",
                                                "text": "The buoy bobbed between the crests and troughs of the waves moving across the bay."
                                            },
                                            {
                                                "example_id": "ed965f0c-1adf-4521-b05b-db612a590464",
                                                "sense_id": "60f8fa8a-e69f-3afd-89af-d5c510e577b1",
                                                "text": "The neurologist pointed to a troubling trough in the pattern of his brain-waves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41f3ec2f-c193-3fbb-a143-7e8a3e277b40",
