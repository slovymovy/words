                                        "sense_id": "54ecd558-7ab3-3480-a1f8-c8606650bc76",
                                        "entry_id": "2725d4c6-98a9-3e54-9c40-d04c48477c42",
                                        "glosses": [
                                            "In actual use or existence, regardless of official or legal status."
                                        ],
                                        "tags": [
                                            "modal",
