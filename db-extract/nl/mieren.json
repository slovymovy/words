                        "examples": []
                    },
                    {
                        "sense_id": "0b31b56a-9720-365c-bda6-0316af67dc6c",
                        "entry_id": "ca287416-1934-3776-9315-960258b5f9b4",
                        "glosses": [
                            "Formicidae een familie van kolonievormende sociale insecten, die behoren tot de orde vliesvleugeligen (Hymenoptera). Mieren hebben zich kunnen aanpassen aan zeer verschillende leefomgevingen en komen wereldwijd voor. Ze zijn een van de meest dominante levensvormen op de bodem. Veel mierensoorten bouwen hun nest in de bodem of in holle bomen, andere soorten spinnen bladeren aan elkaar om een nest te maken, en weer andere leven in spleten tussen rotsen"
                        ],
                        "tags": [
                            "meervoudsvorm als officiële benaming",
                            "vliesvleugeligen"
                        ],
                        "examples": [
                            {
                                "example_id": "0dcdb395-2494-457c-a686-43bbf757592f",
                                "sense_id": "0b31b56a-9720-365c-bda6-0316af67dc6c",
                                "text": "Overal waar je keek zag je leven in de woestijn. Duikende vogels, mieren, hagedissen en het onophoudelijke gezang van de krekels."
                            }
                        ]
                    }
                ],
