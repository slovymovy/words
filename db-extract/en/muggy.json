                    },
                    {
                        "form_id": "2a522488-ceee-455c-9c79-7a5f3f7e74ef",
                        "entry_id": "48d82e8c-1082-3cd4-a807-31d362ac06d4",
                        "tags": [
                            "superlative"
                        ],
                        "form": "muggiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5050432-d604-3f98-b18c-1f1de9221cfe",
                        "entry_id": "48d82e8c-1082-3cd4-a807-31d362ac06d4",
                        "glosses": [
                            "Humid, or hot and humid."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "cc32d51d-5c91-489b-9275-aafbd51cb609",
                                "sense_id": "a5050432-d604-3f98-b18c-1f1de9221cfe",
                                "text": "The next was a very unpropitious morning for a journey—muggy, damp, and drizzly."
                            },
                            {
                                "example_id": "afc05830-7b3e-4eca-8bc6-1c2350b58675",
                                "sense_id": "a5050432-d604-3f98-b18c-1f1de9221cfe",
                                "text": "What struck me as the most curious thing about this wonderful river was: how did the air keep fresh? It was muggy and thick, no doubt, but still not sufficiently so to render it bad or even remarkably unpleasant."
                            },
                            {
                                "example_id": "e42eb1d1-f9d0-4f91-a067-7067ab57f683",
                                "sense_id": "a5050432-d604-3f98-b18c-1f1de9221cfe",
                                "text": "The evening, though sunless, had been warm and muggy for the season, and Tess had come out with her milking-hood only, naked-armed and jacketless; certainly not dressed for a drive."
                            },
                            {
                                "example_id": "8f282448-3ef9-4b39-aa6d-cf08ebab21f1",
                                "sense_id": "a5050432-d604-3f98-b18c-1f1de9221cfe",
                                "text": "Muggy heat—temperature in the 90s and high humidity—greeted early arrivals for the 72-hole, three-day test, rated the hardest and most important in the sport."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f22073a-bdf1-347a-8c2c-825c72509705",
                        "entry_id": "48d82e8c-1082-3cd4-a807-31d362ac06d4",
                        "glosses": [
                            "Wet or mouldy."
                        ],
                        "tags": [
