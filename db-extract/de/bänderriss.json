                        "examples": [
                            {
                                "example_id": "970f7792-c2d2-4ad4-954f-f0954915268d",
                                "sense_id": "18687038-4cd5-3bee-b392-9a9c535674c2",
                                "text": "Mit so einem Bänderriss wirst du monatelang nicht Basketball spielen können."
                            },
                            {
                                "example_id": "1dfc20f2-4555-4771-b2c8-010a73226d11",
                                "sense_id": "18687038-4cd5-3bee-b392-9a9c535674c2",
                                "text": "Die Behandlung meines Bänderrisses wird mich noch für einige Zeit außer Gefecht setzen."
                            },
                            {
                                "example_id": "eb17f7e9-1539-4622-a5fc-3e766057113e",
                                "sense_id": "18687038-4cd5-3bee-b392-9a9c535674c2",
                                "text": "Mit Bänderrissen kenne ich mich aus."
                            },
                            {
                                "example_id": "b03afd28-1fe3-4024-bbe2-e726ce629be0",
                                "sense_id": "18687038-4cd5-3bee-b392-9a9c535674c2",
                                "text": "Der Arzt hat bereits etliche Bänderrisse behandelt."
                            }
                        ],
