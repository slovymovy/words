                    {
                        "sense_id": "9ec5036e-49a1-33d8-85e6-bf27d2f089af",
                        "entry_id": "6a42bf6a-b4e3-3310-8333-315e56ac7ad4",
                        "glosses": [
                            "doel bij een wedstrijd",
                            "constructie bestaand uit drie paaltjes met twee dwarshoutjes, die door de ploeg in het veld moet worden omgegooid om een slagman uit te schakelen"
                        ],
                        "tags": [
                            "cricket"
                        ],
                        "examples": [
                            {
                                "example_id": "0a4a7a8a-a338-4b83-8ac1-f89be6f7a987",
                                "sense_id": "9ec5036e-49a1-33d8-85e6-bf27d2f089af",
                                "text": "Om hem in bedwang te houden mikten de Engelse bowlers de bal op het lichaam van de batsman, in plaats van op het wicket."
                            }
                        ]
                    },
                    {
                        "sense_id": "8581f9f4-605f-355e-93ec-7e1e8401cc23",
                        "entry_id": "6a42bf6a-b4e3-3310-8333-315e56ac7ad4",
                        "glosses": [
                            "doel bij een wedstrijd",
                            "uitschakeling van een slagman (ook als gevolg van een vangbal)"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "280f69cd-0de8-4aa1-af69-2b19831c0002",
                                "sense_id": "8581f9f4-605f-355e-93ec-7e1e8401cc23",
                                "text": "De mentale kracht binnen zijn ploeg werd gisteren het best geïllustreerd door fastbowler Mitchell Starc, die al op de vijfde bal van de finale afrekende met het grootste Nieuw-Zeelandse gevaar, aanvoerder Brendon McCullum. Met zijn wicket stonden de Kiwi’s al op achterstand voordat de toeschouwers goed en wel zaten."
                            }
                        ]
                    },
                    {
                        "sense_id": "2502f05f-db84-3520-bf99-c1024ac867cb",
                        "entry_id": "6a42bf6a-b4e3-3310-8333-315e56ac7ad4",
                        "glosses": [
                            "doel bij een wedstrijd",
                            "rechthoek van 20 bij 3 meter waar de wickets staan, in het midden van een cricketveld"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a6079c7c-02fc-4b5c-b3c7-442e43c9c0f0",
                                "sense_id": "2502f05f-db84-3520-bf99-c1024ac867cb",
                                "text": "De gele bladblazer werkt de losse stukken gedroogd gras weg, de kwast met witte verf brengt de lijnen weer terug aan het oppervlak. Het wicket is klaar voor de volgende innings."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe5b9830-e572-4082-8b92-101703068fe6",
                        "source_entry_id": "6a42bf6a-b4e3-3310-8333-315e56ac7ad4",
