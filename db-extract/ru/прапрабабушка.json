                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43ab980d-1e82-417f-b67d-7a57c7bd6cc4",
                        "source_entry_id": "823a4b9f-8dee-3981-96e0-e40a38482b19",
                        "source_sense_id": "11f0abff-ab33-3237-8f6a-f1fcbaeab41c",
                        "target_lang_word": "trisaïeule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trisaïeule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57932f51-5371-36a3-84b0-dce34b3f993f",
                                        "entry_id": "3179f7ec-9ad9-380e-be3f-cfa825e23297",
                                        "glosses": [
                                            "Mère du bisaïeul ou de la bisaïeule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f4ea523-057e-4c72-931d-c5c31022511a",
                                                "sense_id": "57932f51-5371-36a3-84b0-dce34b3f993f",
                                                "text": "Dès l’instant qu’ils ont mis leur cœur aux pieds d’une beauté, il ne leur est plus permis de danser qu’avec des trisaïeules. La conversation des femmes de cinquante ans, et d’une laideur constatée, leur est seule accordée."
                                            },
                                            {
                                                "example_id": "a4fbadfc-3c00-4796-ae37-9351467fc0d8",
                                                "sense_id": "57932f51-5371-36a3-84b0-dce34b3f993f",
                                                "text": "C’est en souvenir d’un mien chat, nommé Ronron, qui fut le compagnon de mes jeunes années, que j’ai promis aux minets d’Algueville de transmettre à la postérité l’histoire de leur trisaïeule, Minou-Minette première du nom."
                                            },
                                            {
                                                "example_id": "d9eb6b9e-f4a3-4b52-8855-9be514a1d928",
                                                "sense_id": "57932f51-5371-36a3-84b0-dce34b3f993f",
                                                "text": "Lorsque Charles lui fut amené, la gardienne l’installa tout de suite, devant la petite table, en face de sa trisaïeule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69809138-60b9-4222-9cff-4c76ea52b78f",
                        "source_entry_id": "823a4b9f-8dee-3981-96e0-e40a38482b19",
                        "source_sense_id": "11f0abff-ab33-3237-8f6a-f1fcbaeab41c",
                        "target_lang_word": "arrière-arrière-grand-mère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrière-arrière-grand-mère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfac12fc-07d2-3514-be90-909274675f6f",
                                        "entry_id": "8c8b2959-70a0-3f6d-9c35-9163330dbc5a",
                                        "glosses": [
                                            "Mère de l’un des arrière-grands-parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b01df138-1e3d-48a5-9e1e-dc9b7248c439",
                                                "sense_id": "dfac12fc-07d2-3514-be90-909274675f6f",
                                                "text": "— Au cours de la réception qui fait suite à la remise des Palmes, raconte le jeune homme, mon arrière-arrière-grand-mère va faire une très mauvaise rencontre."
                                            },
                                            {
                                                "example_id": "343b7f88-bce2-4a30-9400-389a0a08e051",
                                                "sense_id": "dfac12fc-07d2-3514-be90-909274675f6f",
                                                "text": "Jusqu'à la Première Guerre mondiale, la plupart de nos grands-mères – les arrière-arrière-grands-mères de notre petit-enfant – nourrissent leurs bébés, c'est-à-dire nos mères et nos pères, au sein, comme cela s'est fait depuis des millions d'années."
                                            },
                                            {
                                                "example_id": "790daed1-35b6-4da5-9ddf-fc8a664ae723",
                                                "sense_id": "dfac12fc-07d2-3514-be90-909274675f6f",
                                                "text": "Par ailleurs, l'une de ses arrière-arrière-grand-mères étant née à La Nouvelle-Orléans dans une famille d’origine martiniquaise. John Lewis a aussi un peu de sang français..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
