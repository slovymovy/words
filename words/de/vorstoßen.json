                        "ins Halbfinale vorstoßen"
                    ]
                },
                {
                    "sense_id": "51ef610a-9789-3d00-996e-8415d2851b23",
                    "sense_definition": "jemandem oder einer Sache einen Stoß versetzen, sodass die Person oder der Gegenstand nach vorne geschoben wird",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dem dichten Gedränge vor der Bühne hat ihn plötzlich jemand mit beiden Händen <w>vorgestoßen</w>."
                        },
                        {
                            "text": "Als Freiwillige für die schwierige Aufgabe gesucht wurden, hat er seinen zögernden Kollegen einfach <w>vorgestoßen</w>."
                        }
                    ],
                    "synonyms": [
