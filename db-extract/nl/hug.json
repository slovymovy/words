                        "glosses": [
                            "omarming die wat langer duurt, als een veelgebruikte manier om genegenheid te tonen en/of troost te bieden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61d5c8c7-b113-46b4-922c-121ef2e17952",
                                "sense_id": "e6a000a9-cb15-3322-8f28-7bcbf44124ac",
                                "text": "Met waterverf schilderde ik het gelige landschap waar ik de afgelopen dagen doorheen was gekomen. Bij het afscheid kreeg ik van iedereen een warme hug en ook nog twee water-kwasten."
                            },
                            {
                                "example_id": "c672ef3e-e027-4e38-9c39-5b9a0ce476c3",
                                "sense_id": "e6a000a9-cb15-3322-8f28-7bcbf44124ac",
                                "text": "Voordeeltje Oranjeloos-WK; Stefan de Vrij heeft tijd voor hug: Vier jaar nadat hij met Oranje brons won op het WK, reikte Stefan de Vrij vanmiddag in Ouderkerk aan den IJssel een paar honderd medailles uit op zijn eigen toernooi. ,,Een hele eer.’’"
                            }
                        ]
                    }
