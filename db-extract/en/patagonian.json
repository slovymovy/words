                                        "examples": [
                                            {
                                                "example_id": "e7aa6556-8878-4e0b-bf77-be19b194b329",
                                                "sense_id": "0a674123-d1f7-32d8-aae6-663ac025124a",
                                                "text": "En 1959, Cesare Maestri et Toni Egger partent à l'assaut du Cerro Torre, flèche patagonienne, symbole de l'inaccessible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1ccb967-a8f8-4368-8313-11ef7e18a06f",
                        "source_entry_id": "8e7c362e-a21b-32a8-99e0-a89437a5acc4",
                        "source_sense_id": "a95cf757-ee3b-3754-87fe-511f346049cb",
                        "source_sense_description": "of or pertaining to Patagonia",
                        "target_lang_word": "patagon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patagon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb9f5a5d-a0e8-30e3-995a-c6a1e00ec830",
                                        "entry_id": "0d8e6d0c-c4ed-3595-8198-11c621c51bd0",
                                        "glosses": [
                                            "Relatif à la Patagonie ou aux Patagons, ses habitants réels ou supposés. Souvent plaisant, en raison du caractère mythique attribué aux Patagons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "983cf30d-5345-4923-8705-d69701530e29",
                                                "sense_id": "bb9f5a5d-a0e8-30e3-995a-c6a1e00ec830",
                                                "text": "Cependant, lorsque ma mère me vendit dix écus patagons sur la côte de Guinée"
                                            },
                                            {
                                                "example_id": "ebe19800-a981-4c43-b323-76064dcbf425",
                                                "sense_id": "bb9f5a5d-a0e8-30e3-995a-c6a1e00ec830",
                                                "text": "J’ai eu une fois quatre paquets de cigares pour un éventail patagon..."
                                            },
                                            {
                                                "example_id": "4589de36-0aa9-483d-8aa3-72c58e91c4e7",
                                                "sense_id": "bb9f5a5d-a0e8-30e3-995a-c6a1e00ec830",
                                                "text": "Ma sévérité amusait énormément son esprit patagon."
                                            },
                                            {
                                                "example_id": "3f3d912f-1266-441a-b900-a3a841822f49",
                                                "sense_id": "bb9f5a5d-a0e8-30e3-995a-c6a1e00ec830",
                                                "text": "C’est un épanouissement joyeux de cette espèce, la sensation éprouvée en revenant à un état mental que nous avons dépassé par la croissance, que j’éprouvais dans la solitude patagone."
                                            },
                                            {
                                                "example_id": "c70ccf6a-13ff-4f6c-a317-d3f02565fd29",
                                                "sense_id": "bb9f5a5d-a0e8-30e3-995a-c6a1e00ec830",
                                                "text": "Je venais de voir un lièvre patagon, animal magique, et la Patagonie tout entière me transperçait soudain le cœur de la certitude de notre commune présence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "patagon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3165808-bfce-30dd-8f43-03080339290c",
                                        "entry_id": "4cf84248-dd8f-39aa-924c-71d285ea13b6",
                                        "glosses": [
                                            "Jargon."
                                        ],
                                        "tags": [
                                            "Par plaisanterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80199870-d507-4d3b-8cbd-d5d82bf28166",
                                                "sense_id": "b3165808-bfce-30dd-8f43-03080339290c",
                                                "text": "[La Tison] avertit les policiers de la Sûreté Générale, qui lui payaient chichement des petits rapports en patagon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "patagon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82df2e96-6af3-3f00-9c96-4eccbdcdc452",
                                        "entry_id": "454611d6-6805-3814-abf2-fe614678268c",
                                        "glosses": [
                                            "Variante de patacon."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9578e79-bf6b-4c07-856d-7a3135292d67",
                                                "sense_id": "82df2e96-6af3-3f00-9c96-4eccbdcdc452",
                                                "text": "Declarant et promettant que celuy qui rapportera et prouvera l’Autheur dudit Escrit, ou celui qui l’aura le premier publié ou distribué, recevera promptement cent patagons. Faict ce 7. de May 1655."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
