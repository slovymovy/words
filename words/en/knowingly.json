{
    "word_family": [
        "know",
        "knowing",
        "knowledge",
        "knowledgeable",
        "unknowing",
        "unknowingly"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d7bc48fa-18ec-3a21-9617-038bcdd6ea9a",
                    "sense_definition": "In a deliberate manner with full awareness or knowledge of what one is doing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She insisted that she had not <w>knowingly</w> broken any company rules.",
                            "target_lang_translations": {
                                "ru": "Она настаивала, что не нарушала никаких правил компании <w>сознательно</w>."
                            }
                        },
                        {
                            "text": "No doctor would <w>knowingly</w> prescribe medication that could cause such severe harm.",
                            "target_lang_translations": {
                                "ru": "Ни один врач не стал бы <w>заведомо</w> выписывать лекарство, способное причинить столь серьезный вред."
                            }
                        }
                    ],
                    "synonyms": [
                        "consciously"
                    ],
                    "antonyms": [
                        "unknowingly",
                        "unawarely",
                        "unconsciously"
                    ],
                    "common_phrases": [
                        "knowingly violate",
                        "never knowingly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осознанно, с полным пониманием своих действий или намерений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сознательно",
                                "target_lang_sense_clarification": "с ясным намерением и пониманием"
                            },
                            {
                                "target_lang_word": "заведомо",
                                "target_lang_sense_clarification": "заранее зная о последствиях или фактах"
                            },
                            {
                                "target_lang_word": "умышленно",
                                "target_lang_sense_clarification": "с определенным умыслом, намеренно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5359215c-7e44-3d11-b742-a287bc5d7f26",
                    "sense_definition": "In a way that suggests one has secret or private knowledge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked across the dinner table and smiled <w>knowingly</w> at her sister.",
                            "target_lang_translations": {
                                "ru": "Она посмотрела через обеденный стол и <w>понимающе</w> улыбнулась сестре."
                            }
                        },
                        {
                            "text": "He nodded <w>knowingly</w> when the detective mentioned the missing money.",
                            "target_lang_translations": {
                                "ru": "Он <w>многозначительно</w> кивнул, когда детектив упомянул о пропавших деньгах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "smile knowingly",
                        "look knowingly",
                        "wink knowingly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Так, будто человеку известна какая-то тайна или скрытая информация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимающе",
                                "target_lang_sense_clarification": "с видом осведомленности или скрытого понимания"
                            },
                            {
                                "target_lang_word": "многозначительно",
                                "target_lang_sense_clarification": "намекая на осведомленность о чем-то тайном"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}