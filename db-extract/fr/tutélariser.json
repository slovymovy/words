                "senses": [
                    {
                        "sense_id": "47f2238b-7063-3077-a84b-d2cf6cb8551c",
                        "entry_id": "c29167d6-8735-37f2-adee-b2298c291a5e",
                        "glosses": [
                            "Donner un caractère tutélaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a67f123-6a5f-48bc-a0a3-d85b70442535",
                                "sense_id": "47f2238b-7063-3077-a84b-d2cf6cb8551c",
                                "text": "Les revendications « d'exception » appuyées sur la défense de la marque, et les pratiques qui en découlent, témoignent d'une réelle volonté de tutélariser les réseaux commerciaux et d'en sélectionner la clientèle « haut de gamme », en fonction des seuls critères financiers."
                            },
                            {
                                "example_id": "40d1246f-b47f-4844-97d0-5a4c12e2c395",
                                "sense_id": "47f2238b-7063-3077-a84b-d2cf6cb8551c",
                                "text": "Le groupe humain n'a le droit d'exister que dirigé, pris en main, « tutélarisé »."
                            },
                            {
                                "example_id": "3088ab0e-327d-4f09-9ef1-439c63d5a9af",
                                "sense_id": "47f2238b-7063-3077-a84b-d2cf6cb8551c",
                                "text": "La \"réalité est tutélarisée\" par cette représentation, à son contact les autres images se fondent les unes dans les autres pour ne former qu'un flux en circulation entre les trois écrans."
                            }
                        ]
                    }
                ],
