                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63050e83-c011-45c6-af62-04df1a78e012",
                                "sense_id": "97823c12-60f4-35c4-9003-e33179c64e9f",
                                "text": "„Über viele Jahre pflegte ich Beziehungen und Kontakte, um das Verhältnis Israels zur internationalen Umgebung, den Staaten der Welt und den Diasporagemeinden zu erleichtern.“"
                            },
                            {
                                "example_id": "ebfabde2-b0b9-4ab8-8349-9533cb7bdd1d",
                                "sense_id": "97823c12-60f4-35c4-9003-e33179c64e9f",
                                "text": "„Jetzt wurde, insbesondere in den jüdischen Diasporagemeinden, wieder die Frage des Wiederaufbaus des Tempels virulent, an der sich kontroverse Diskussionen auch darüber entzündeten, wie denn ein solcher vonstattengehen sollte.“"
                            }
                        ],
