{
    "word_family": [
        "phrasing",
        "phraseology",
        "rephrase",
        "paraphrase",
        "phrasal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00709d67-d247-365c-81b5-f77b93f30d2a",
                    "sense_definition": "A short written or spoken expression.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a polite <w>phrase</w> to greet the guests at the party.",
                            "target_lang_translations": {
                                "ru": "Она использовала вежливую <w>фразу</w>, чтобы поприветствовать гостей на вечеринке.",
                                "zh": "她在聚会上用了一句客气的<w>短语</w>来问候客人。"
                            }
                        },
                        {
                            "text": "I do not understand the meaning of this common <w>phrase</w>.",
                            "target_lang_translations": {
                                "ru": "Я не понимаю значения этого расхожего <w>выражения</w>.",
                                "zh": "我不明白这个常用<w>短语</w>的意思。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expression",
                        "saying",
                        "term"
                    ],
                    "common_phrases": [
                        "catch phrase",
                        "set phrase",
                        "key phrase",
                        "common phrase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое письменное или устное выражение.",
                        "zh": "简短的口头或书面表达。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фраза",
                                "target_lang_sense_clarification": "законченное высказывание"
                            },
                            {
                                "target_lang_word": "выражение",
                                "target_lang_sense_clarification": "устойчивое сочетание слов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "短语",
                                "target_lang_sense_clarification": "语言表达单位"
                            },
                            {
                                "target_lang_word": "措辞",
                                "target_lang_sense_clarification": "表达方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1faf258-a1fb-33b9-be95-ad467cd3a630",
                    "sense_definition": "A group of words that functions as a single unit in the syntax of a sentence, such as a noun phrase or verb phrase.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this sentence, the noun <w>phrase</w> acts as the subject.",
                            "target_lang_translations": {
                                "ru": "В этом предложении именное <w>словосочетание</w> выступает в роли подлежащего.",
                                "zh": "在这个句子里，名词<w>短语</w>充当主语。"
                            }
                        },
                        {
                            "text": "Students learned how to identify a prepositional <w>phrase</w> in the text.",
                            "target_lang_translations": {
                                "ru": "Студенты учились находить предложный <w>оборот</w> в тексте.",
                                "zh": "学生们学习了如何识别文中的介词<w>短语</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "noun phrase",
                        "verb phrase",
                        "prepositional phrase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа слов, функционирующая как единое целое в синтаксисе предложения, например, именная группа или глагольная группа.",
                        "zh": "在句子语法中作为一个整体发挥作用的一组词，例如名词短语或动词短语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "словосочетание",
                                "target_lang_sense_clarification": "грамматическая конструкция"
                            },
                            {
                                "target_lang_word": "оборот",
                                "target_lang_sense_clarification": "синтаксическая единица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "短语",
                                "target_lang_sense_clarification": "语法结构"
                            },
                            {
                                "target_lang_word": "词组",
                                "target_lang_sense_clarification": "语法单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9c7b2e1-438a-3f9a-8a70-e33436ebccad",
                    "sense_definition": "A small section of music in a larger piece, often forming a distinct melodic idea.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist played the opening <w>phrase</w> with great emotion and skill.",
                            "target_lang_translations": {
                                "ru": "Пианист сыграл вступительную <w>фразу</w> с большим чувством и мастерством.",
                                "zh": "钢琴家充满感情且技巧娴熟地演奏了开头的<w>乐句</w>。"
                            }
                        },
                        {
                            "text": "This musical <w>phrase</w> repeats several times throughout the song.",
                            "target_lang_translations": {
                                "ru": "Эта музыкальная <w>фраза</w> повторяется в песне несколько раз.",
                                "zh": "这个<w>乐句</w>在整首歌中重复了好几次。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "musical phrase",
                        "melodic phrase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой отрывок музыкального произведения, часто образующий отчетливую мелодическую идею.",
                        "zh": "音乐作品中的一小段，通常构成一个独特的旋律意念。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фраза",
                                "target_lang_sense_clarification": "музыкальный фрагмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乐句",
                                "target_lang_sense_clarification": "音乐片段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19d014a1-29b0-322c-bdd6-935666afdf2d",
                    "sense_definition": "A short individual motion forming part of a choreographed dance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancers practiced the difficult <w>phrase</w> until they moved in perfect unison.",
                            "target_lang_translations": {
                                "ru": "Танцоры репетировали сложную <w>связку</w>, пока не стали двигаться в полном унисоне.",
                                "zh": "舞者们练习了那个高难度的<w>舞句</w>，直到动作完全整齐划一。"
                            }
                        },
                        {
                            "text": "Each movement <w>phrase</w> was designed to express a specific emotion.",
                            "target_lang_translations": {
                                "ru": "Каждая танцевальная <w>фраза</w> была задумана для выражения определенной эмоции.",
                                "zh": "每一个动作<w>舞句</w>的设计都是为了表达特定的情感。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое отдельное движение, являющееся частью хореографического танца.",
                        "zh": "编舞中作为舞蹈一部分的短小独立动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фраза",
                                "target_lang_sense_clarification": "элемент танца"
                            },
                            {
                                "target_lang_word": "связка",
                                "target_lang_sense_clarification": "танцевальная комбинация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舞句",
                                "target_lang_sense_clarification": "舞蹈动作组合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11ba758a-7027-3f73-b7a6-6e018adfe0c4",
                    "sense_definition": "A mode or form of speech; diction or style of expression.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet wrote in a <w>phrase</w> that recalled the language of ancient times.",
                            "target_lang_translations": {
                                "ru": "Поэт писал <w>слогом</w>, напоминающим язык древних времен.",
                                "zh": "诗人所用的<w>文体</w>让人联想到古代的语言。"
                            }
                        },
                        {
                            "text": "His peculiar <w>phrase</w> made it difficult for modern readers to understand him.",
                            "target_lang_translations": {
                                "ru": "Его своеобразная <w>манера речи</w> затрудняла понимание современными читателями.",
                                "zh": "他独特的<w>措辞风格</w>让现代读者很难理解他。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Манера или форма речи; дикция или стиль выражения.",
                        "zh": "一种说话的方式或形式；表达的风格或文体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слог",
                                "target_lang_sense_clarification": "стиль изложения"
                            },
                            {
                                "target_lang_word": "манера речи",
                                "target_lang_sense_clarification": "способ выражения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "文体",
                                "target_lang_sense_clarification": "表达风格"
                            },
                            {
                                "target_lang_word": "措辞风格",
                                "target_lang_sense_clarification": "说话方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "49579857-1c84-3f7b-8955-4f7f17da9b45",
                    "sense_definition": "To express an action, thought, or idea by means of particular words.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not know how to <w>phrase</w> his request without sounding rude.",
                            "target_lang_translations": {
                                "ru": "Он не знал, как <w>сформулировать</w> свою просьбу, чтобы не показаться грубым.",
                                "zh": "他不知道该如何<w>措辞</w>才能让自己的请求听起来不那么粗鲁。"
                            }
                        },
                        {
                            "text": "The contract was <w>phrased</w> in very complex legal language.",
                            "target_lang_translations": {
                                "ru": "Контракт был <w>составлен</w> очень сложным юридическим языком.",
                                "zh": "这份合同的<w>措辞</w>使用了非常复杂的法律术语。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "phrase a question",
                        "phrase it differently",
                        "carefully phrased"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать действие, мысль или идею с помощью определенных слов.",
                        "zh": "用特定的词语来表达动作、思想或观点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формулировать",
                                "target_lang_sense_clarification": "облекать в слова"
                            },
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "передавать смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "措辞",
                                "target_lang_sense_clarification": "表达方式"
                            },
                            {
                                "target_lang_word": "表达",
                                "target_lang_sense_clarification": "传达意思"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f0c8574-ac21-301c-89dd-9a7692f7a014",
                    "sense_definition": "To perform a musical passage with a particular style or grouping of notes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A good singer knows how to <w>phrase</w> the lyrics to convey the right feeling.",
                            "target_lang_translations": {
                                "ru": "Хороший певец знает, как <w>фразировать</w> текст, чтобы передать нужное чувство.",
                                "zh": "优秀的歌手懂得如何<w>分句</w>演唱歌词，以传达出恰当的情感。"
                            }
                        },
                        {
                            "text": "The conductor taught the orchestra how to <w>phrase</w> the melody smoothly.",
                            "target_lang_translations": {
                                "ru": "Дирижер учил оркестр плавно <w>фразировать</w> мелодию.",
                                "zh": "指挥教导乐团如何平滑地<w>分句</w>演奏旋律。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять музыкальный отрывок в определенном стиле или с определенной группировкой нот.",
                        "zh": "以特定的风格或音符组合来演奏音乐片段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фразировать",
                                "target_lang_sense_clarification": "музыкальное исполнение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分句",
                                "target_lang_sense_clarification": "音乐处理"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}