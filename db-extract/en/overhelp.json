                        "glosses": [
                            "To supply with too much help."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f95752b-c655-46bb-82b2-a34c67330018",
                                "sense_id": "9459aedb-b0ce-3963-a866-01537d927b3c",
                                "text": "Modify homework and independent projects to the child's instructional or independent level, so that parents are not forced to overhelp the child."
                            },
                            {
                                "example_id": "33c150f7-54c1-4e57-86c8-a3dcd9f7195b",
                                "sense_id": "9459aedb-b0ce-3963-a866-01537d927b3c",
                                "text": "Gilbert and Silvera (1996) found that overhelping can be used to spoil another person's identity by causing onlookers to attribute the other's success to the help."
                            }
                        ]
                    }
