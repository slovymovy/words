                "senses": [
                    {
                        "sense_id": "ff81d394-4329-30cd-8439-a4264e5a9101",
                        "entry_id": "c262e095-1fcb-33e4-8285-bdc15e918c88",
                        "glosses": [
                            "муз. небольшая канцона; короткая вокальная пьеса на несколько голосов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80511308-8a98-451b-b93b-5676611d44c8",
                                "sense_id": "ff81d394-4329-30cd-8439-a4264e5a9101",
                                "text": "Васючок пел вполголоса, под аккомпанемент Женни Рейтер, итальянские народные канцонетты и рубинштейновские восточные песни."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3b63ee2-8c64-43b8-8288-2bd99d3c115e",
                        "source_entry_id": "c262e095-1fcb-33e4-8285-bdc15e918c88",
                        "source_sense_id": "ff81d394-4329-30cd-8439-a4264e5a9101",
                        "target_lang_word": "canzonet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canzonet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "907876a7-ea21-30a9-ae1d-d43e514ceebe",
                                        "entry_id": "e597672c-f58b-3fb1-b81b-84f41ec22dc0",
                                        "glosses": [
                                            "A short song, now especially one which is light and breezy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b52f58-b013-4881-bcc9-281b11cb77ae",
                                                "sense_id": "907876a7-ea21-30a9-ae1d-d43e514ceebe",
                                                "text": "Besides what I have said of one of their warlike songs, I have another amorous canzonet, which beginneth in this sence […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca76a6ea-e78f-4062-a7f7-9ff5d97e4d6e",
                        "source_entry_id": "c262e095-1fcb-33e4-8285-bdc15e918c88",
                        "source_sense_id": "ff81d394-4329-30cd-8439-a4264e5a9101",
                        "target_lang_word": "canzonetta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canzonetta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1933ebae-08fa-39dc-8b7f-75cacf959e94",
                                        "entry_id": "7332b802-a8df-32c5-832a-d24039dad4eb",
                                        "glosses": [
                                            "A style of popular Italian secular vocal composition which originated around 1560, or a piece composed in this style"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b3826f4-bab2-4d53-a4e4-bfe75dd62e7d",
                                                "sense_id": "1933ebae-08fa-39dc-8b7f-75cacf959e94",
                                                "text": "In the canzonetta, Mr. McDuffie summoned a subtle glow, which was well matched by flute and clarinet soloists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89721f5c-6c35-49b4-bf62-57be1161d878",
