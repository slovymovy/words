                        ],
                        "examples": [
                            {
                                "example_id": "9fb248d2-c044-41a6-97a5-13b54f6a2e6d",
                                "sense_id": "0414de48-240a-35a8-80c0-a8cd5000261c",
                                "text": "aufs Altenteil gehen",
                                "translation": "to retire",
                                "english": "to retire"
                            },
                            {
                                "example_id": "a0284ca6-0a5e-40de-b53d-e15cd26177cd",
                                "sense_id": "0414de48-240a-35a8-80c0-a8cd5000261c",
                                "text": "aufs Altenteil schicken/schieben",
                                "translation": "to incite someone to retire or leave (early)",
                                "english": "to incite someone to retire or leave (early)"
                            },
                            {
                                "example_id": "42d5ec3c-6754-47df-9411-c03912b48025",
                                "sense_id": "0414de48-240a-35a8-80c0-a8cd5000261c",
                                "text": "Hinzu kommt, dass es, sobald die Boomer aufs Altenteil gehen, Leerstellen geben wird im wirtschaftlichen, dienstleistungsbezogenen, bildenden, produzierenden Gefüge, die nicht so einfach zu schließen sind, weil schlicht die Leute fehlen."
                            }
                        ]
                    }
