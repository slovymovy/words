                ],
                "senses": [
                    {
                        "sense_id": "54f58b68-931f-3c66-a7d0-06380866792d",
                        "entry_id": "01fe8019-f4ec-3346-a5c6-351b1ea381d8",
                        "glosses": [
                            "okrągły budynek"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bcd46a1c-27ed-4d4e-9779-f10d7613bdc6",
                                "sense_id": "54f58b68-931f-3c66-a7d0-06380866792d",
                                "text": "Jeszcze na przełomie lat osiemdziesiątych i dziewięćdziesiątych ubiegłego wieku okrąglak służył jako miejsce stacjonowania nieczynnych parowozów, tendrów oraz jako warsztat, w którym szkolono przyszłych mechaników kolejowych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "dcda41da-41f6-3390-9d8e-9d1dd93af09b",
                        "entry_id": "01fe8019-f4ec-3346-a5c6-351b1ea381d8",
                        "glosses": [
                            "okrągły kloc drewna, o średnicy kliku, kilkunastu centymetrów, zwykle okorowany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f673c6-8f0f-4068-a520-c93fc61beea1",
                                "sense_id": "dcda41da-41f6-3390-9d8e-9d1dd93af09b",
                                "text": "Legar środkowy tworzy okrąglak nie okorowany o długości 276 cm i średnicy 11 cm, znajdujący się w odległości 25 cm od legara południowego"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8273858a-f2dd-45af-bcdd-37563e20ccb3",
                        "source_entry_id": "01fe8019-f4ec-3346-a5c6-351b1ea381d8",
                        "source_sense_id": "dcda41da-41f6-3390-9d8e-9d1dd93af09b",
                        "target_lang_word": "rondin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rondin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9109f32-1aa5-3aa1-bc5d-7463b0c882ee",
                                        "entry_id": "9564e94b-450c-3b3a-b0f7-cd78f1728d08",
                                        "glosses": [
                                            "Morceau de bois de chauffage, qui est rond, par opposition à celui qui est fendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d3b3ed9-6131-465d-9185-a451cec4281c",
                                                "sense_id": "a9109f32-1aa5-3aa1-bc5d-7463b0c882ee",
                                                "text": "Les arbres, tiges et branches que l'on convertit en bois de feu sont découpés, partie en bûches de rondin ou de quartier, partie en rames destinées à entrer dans les fagots."
                                            },
                                            {
                                                "example_id": "87236f73-5b63-4355-beb6-cc698290473c",
                                                "sense_id": "a9109f32-1aa5-3aa1-bc5d-7463b0c882ee",
                                                "text": "Des stères à brûler, des fagots de rondins, des bourrées de coupilles, des tas d'ételles et des « carottes » d'épicéas s'y empilent."
                                            },
                                            {
                                                "example_id": "772bf216-c07f-4b79-8a04-b83e9ef34ff1",
                                                "sense_id": "a9109f32-1aa5-3aa1-bc5d-7463b0c882ee",
                                                "text": "Sur la route, ce furent les premières chaussées modernes construites par Trésauguet, en France, et par Mac-Adam, en Angleterre vers 1760, qui firent rechercher des procédés un peu moins primitifs que le sabot qu'on intercalait entre la roue et le sol, la chaîne d'enrayage et le rondin qui embarraient la jante près d'un rai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b99cd649-718b-3695-be8f-b2cf3f99284a",
                                        "entry_id": "9564e94b-450c-3b3a-b0f7-cd78f1728d08",
                                        "glosses": [
                                            "Morceau de bois de construction rond et long."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1b7cbcb-9e45-4c6b-a242-88767dfdced8",
                                                "sense_id": "b99cd649-718b-3695-be8f-b2cf3f99284a",
                                                "text": "… des enfants mal nourris à la bouillie de seigle, qui vivaient dans une isba en rondin calfeutrée de mousse,…."
                                            },
                                            {
                                                "example_id": "b22ffb97-5b45-4d57-a2ed-177c07bfae3a",
                                                "sense_id": "b99cd649-718b-3695-be8f-b2cf3f99284a",
                                                "text": "Lors d’une promenade dans la commune de Novalaise (Savoie), un couple s’asseoit ^([sic]) sur une rambarde en rondin, située le long d’une route mais surplombant le lit d’un fossé. Sous leur poids, la rambarde cède et les promeneurs chutent dans le fossé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6500c8e5-3520-3d14-bf17-f814c689f2cf",
                                        "entry_id": "9564e94b-450c-3b3a-b0f7-cd78f1728d08",
                                        "glosses": [
                                            "Cylindre de bois pour arrondir les feuilles de plomb dont on veut faire des tuyaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5b2e646-70b7-3172-9c3f-33f3a0d89304",
                                        "entry_id": "9564e94b-450c-3b3a-b0f7-cd78f1728d08",
                                        "glosses": [
                                            "Gros bâton."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f92428-849e-492d-b5c7-2af76392943f",
                                                "sense_id": "b5b2e646-70b7-3172-9c3f-33f3a0d89304",
                                                "text": "Frapper quelqu’un à coups de rondin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d24b97-8e27-3ddc-9342-92eb5408468b",
                                        "entry_id": "9564e94b-450c-3b3a-b0f7-cd78f1728d08",
                                        "glosses": [
                                            "Veston court, aux pans arrondis, porté notamment par les sommeliers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb280c21-922d-4a67-83e8-f128a65494be",
                                                "sense_id": "08d24b97-8e27-3ddc-9342-92eb5408468b",
                                                "text": "Il manquait la goutte. On vendit des morceaux de composition, des tranches de copie à des bouche-trou de Stanislas et de Rollin qui avaient des faux cols droits, des rondins de drap fin, et de l’argent dans leurs goussets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6072690-e37c-3346-8c43-43b8ce07649f",
                                        "entry_id": "9564e94b-450c-3b3a-b0f7-cd78f1728d08",
                                        "glosses": [
                                            "Sein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61e3bc44-2bda-4428-b83b-0b509f571df6",
                                                "sense_id": "e6072690-e37c-3346-8c43-43b8ce07649f",
                                                "text": "... Dis, Môm’, maint’nant y faut m’ montrer / tes beaux petits rondins bombés... / Donne... ah ! ben vrai, c’qu’y sont gentils ! / (c’est pas ces gros tétons d’ borgeoise / qui dégoulin’nt jusqu’au nombril !) / Ben dis donc ! Moi j’veux les p’loter; / euss ont deux bell’s petit’s framboises / qui donn’nt envie d’ les boulotter !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
