                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>rocking</w> that new outfit with so much confidence.",
                            "target_lang_translations": {
