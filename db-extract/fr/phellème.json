                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eb1c070-40c6-40cb-adbf-f225d15d4492",
                                "sense_id": "2aa1a117-a324-3e98-8cd5-1928f49982b2",
                                "text": "Le suber (ou phellème, ou plus communément liège) est un tissu végétal localisé à la périphérie d'une tige (ou tronc) ou d'une racine."
                            },
                            {
                                "example_id": "8cd156f4-63b5-4140-bd28-253333b8a7ec",
                                "sense_id": "2aa1a117-a324-3e98-8cd5-1928f49982b2",
                                "text": "Le liège, suber ou phellème, est un tissu végétal qui enveloppe la plupart des plantes vasculaires, mais l’épaisseur de celui du chêne-liège est unique, si on met à part un arbre d’origine d’Asie extrême-orientale (Chine, Japon, Corée) joliment surnommé « arbre au liège de l’Amour » (du fleuve Amour), mais dont l’industrie n’a que faire."
                            }
                        ]
                    }
