                "senses": [
                    {
                        "sense_id": "5986b1e9-34eb-379a-bd3a-a3de31d2e10c",
                        "entry_id": "337edfef-4735-317d-8878-57a5966d2b82",
                        "glosses": [
                            "Celle qui crible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f42ef40e-3ea0-42af-a882-b53b8dbd50e1",
                                "sense_id": "5986b1e9-34eb-379a-bd3a-a3de31d2e10c",
                                "text": "Une bonne cribleuse passe facilement un mètre cube de matière par jour, et c’est à elle de penser à la classification, à faire varier les secousses etc."
                            },
                            {
                                "example_id": "9099a80d-816d-4bcd-b624-ae613e8dee8c",
                                "sense_id": "5986b1e9-34eb-379a-bd3a-a3de31d2e10c",
                                "text": "… à droite et à gauche de ces dernières, les cribleuses, montées sur des gradins, armées de la pelle et du râteau, ramassaient les pierres, poussaient le charbon propre, qui tombait ensuite par des entonnoirs dans les wagons de la voie ferrée, établie sous le hangar."
                            },
                            {
                                "example_id": "fcfd22e9-2f89-40d3-a2a8-a33a5b9767fb",
                                "sense_id": "5986b1e9-34eb-379a-bd3a-a3de31d2e10c",
                                "text": "… la cribleuse tient le tamis avancé parce qu’elle le peut (grâce à son agenouillement stable) et parce qu’elle le doit (elle surveille ainsi le résultat, les grains qui tombent, entre son corps et le tamis)."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd6a9ae1-52a5-3680-8a3d-4a1340d412be",
                        "entry_id": "337edfef-4735-317d-8878-57a5966d2b82",
                        "glosses": [
                            "Machine servant à cribler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49383092-bc97-430e-808f-e7168451e5c8",
                                "sense_id": "fd6a9ae1-52a5-3680-8a3d-4a1340d412be",
                                "text": "Au volant de son tracteur, Dominique Edon passe au crible les quelque 6 km de plage de sable fin pour en extraire les déchets ménagers enfouis pendant la journée. Ce qui représente, quand même, « entre 200 et 300 kg de détritus par jour ». Pour les collecter, son tracteur tire une cribleuse, machine sophistiquée qui vient creuser le sable sec sur 20 cm de profondeur."
                            }
                        ]
                    }
