                "senses": [
                    {
                        "sense_id": "0a24399a-0476-3124-a15c-1172836cde48",
                        "entry_id": "da239ea8-d0ee-3a8a-87a8-d427ede5d5e9",
                        "glosses": [
                            "podmiot w transakcji faktoringowej, który sprzedaje swoje nieprzeterminowane wierzytelności innemu podmiotowi (faktorowi) i otrzymujący od niego także inne usługi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "642130a4-8ded-4844-b22a-6a1f2e98341a",
                                "sense_id": "0a24399a-0476-3124-a15c-1172836cde48",
                                "text": "Zgodnie z definicją zawartą w tym akcie faktoring jest umową między faktorantem i faktorem, na podstawie której faktorant przenosi na faktora własność wierzytelności wynikających z umowy sprzedaży dóbr (produktów, towarów, usług) klientom."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
