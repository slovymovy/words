                                                "sense_id": "d436fa9d-28e2-35e0-806a-dd924c52e86e",
                                                "text": "Der Abfluss wurde immer schwächer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ab24f0d-1898-393a-b927-bb6e91ed81cc",
                                        "entry_id": "de30973c-e10d-39df-91b7-4322b11c8fd3",
                                        "glosses": [
                                            "Einrichtung, Vorrichtung, die eine Ableitung von Flüssigkeiten aus Behältern zulässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e5d874b-61b9-49e2-b2bc-4ead4b5d006f",
                                                "sense_id": "2ab24f0d-1898-393a-b927-bb6e91ed81cc",
                                                "text": "Der Abfluss befindet sich unterhalb des Beckens."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4ad3603a-e893-372a-9638-28fe35515a6d",
                                        "entry_id": "de30973c-e10d-39df-91b7-4322b11c8fd3",
                                        "glosses": [
                                            "ein Teil des Niederschlages im Wasserkreislauf, der oberirdisch und unterirdisch in Ozeane und abflusslose Becken abfließt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5426046a-f391-4401-8bd6-99d7c4c279b5",
                                                "sense_id": "4ad3603a-e893-372a-9638-28fe35515a6d",
                                                "text": "Der oberirdische Abfluss beträgt 25%."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20472c18-6c5c-4d9a-a598-ca25aa5fe484",
                        "source_entry_id": "360c1657-ed0e-3e45-b906-465215d98795",
                        "source_sense_description": "eau rejetée hors de quelque lieu",
                        "target_lang_word": "effluent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effluent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd1656b-8c24-3b58-9af4-1bd23f54aabe",
                                        "entry_id": "ce537a41-8074-3c1a-ac95-230f62365ff3",
                                        "glosses": [
                                            "Flowing out; outflowing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2adf9c0-ae35-469f-ada4-58caa0a9dd89",
                                                "sense_id": "8bd1656b-8c24-3b58-9af4-1bd23f54aabe",
                                                "text": "But while the effluent beams of the sun, and their quickening power in the natural sphere, furnish a good illustration of my idea of the Holy Spirit, I may, perhaps, illustrate the idea still better by a reference to human thoughts and affections […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "effluent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4508617c-1406-33f8-9f5a-e1105b805346",
                                        "entry_id": "4546188c-3770-3b99-9d85-eb9f4ad2eb7b",
                                        "glosses": [
                                            "A stream that flows out, such as from a lake or reservoir; an outflow; effluence."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "634db988-4286-4cdf-a1b5-416f4f13e97a",
                                                "sense_id": "4508617c-1406-33f8-9f5a-e1105b805346",
                                                "text": "The landscape was dotted with reservoirs and many many effluent streams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecc4b98e-e533-331c-afd6-6ce4a126da66",
                                        "entry_id": "4546188c-3770-3b99-9d85-eb9f4ad2eb7b",
                                        "glosses": [
                                            "Sewage or waste water discharged into a natural body of water."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d76d3c06-175f-4f72-b590-7ca3820fd0db",
                                                "sense_id": "ecc4b98e-e533-331c-afd6-6ce4a126da66",
                                                "text": "Residents have little control over the industrial effluent that pollutes their rivers."
                                            },
                                            {
                                                "example_id": "14783238-1a0c-407b-b0dd-813c423fc204",
                                                "sense_id": "ecc4b98e-e533-331c-afd6-6ce4a126da66",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains. Isolating a city’s effluent and shipping it away in underground sewers has probably saved more lives than any medical procedure except vaccination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "217e5cf1-a267-49db-8fa2-c734bb2e6c04",
                        "source_entry_id": "360c1657-ed0e-3e45-b906-465215d98795",
