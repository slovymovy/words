                        "sense_id": "b3cae037-3d5f-384f-bbc2-13b604e1ce62",
                        "entry_id": "53697545-0d95-3d05-a1e3-26f624d71fc3",
                        "glosses": [
                            "związany z Pasadeną, dotyczący Pasadeny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1767000f-05fe-4eac-80f2-441c0ffca0c9",
                                "sense_id": "b3cae037-3d5f-384f-bbc2-13b604e1ce62",
                                "text": "Jako że za polowanie na demony nie dostawałam nawet symbolicznego dolara, parę razy w tygodniu pracowałam w jednym z pasadeńskich pubów"
                            },
                            {
                                "example_id": "568a5c5d-9654-438e-b527-07a0e0c2669c",
                                "sense_id": "b3cae037-3d5f-384f-bbc2-13b604e1ce62",
                                "text": "Musieliśmy zadowolić się klasą ekonomiczną, gdzie było niewiele więcej miejsca niż w pasadeńskim autobusie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
