                    "sense_definition": "A river in England that flows into the Thames.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The River <w>Leach</w> winds through the beautiful Gloucestershire countryside.",
                            "target_lang_translations": {
                                "ru": "Река <w>Лич</w> петляет по живописным сельским пейзажам Глостершира."
