                        "source_sense_id": "3338ac0c-916b-3691-9403-30f663cb3ebd",
                        "target_lang_word": "Schülerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schülerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc08f074-6762-3160-b92e-a4b68dab507c",
                                        "entry_id": "62400b8c-2bd7-3b1b-b56d-07e83b773bab",
                                        "glosses": [
                                            "weiblicher Schüler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e514c57-5610-4e87-8eb4-8e8732d859e9",
                                                "sense_id": "dc08f074-6762-3160-b92e-a4b68dab507c",
                                                "text": "Als Schülerin hat sie viel Musik gemacht."
                                            },
                                            {
                                                "example_id": "210826db-a06e-4a93-8ca0-d1f5fcc52d84",
                                                "sense_id": "dc08f074-6762-3160-b92e-a4b68dab507c",
                                                "text": "„Schon als Schülerin hatte ich einen Terminkalender und Stress.“"
                                            },
                                            {
                                                "example_id": "1ad22c44-a82f-4bef-b350-1e31348f2b55",
                                                "sense_id": "dc08f074-6762-3160-b92e-a4b68dab507c",
                                                "text": "„Schülerinnen, Lyzeistinnen, gehen dort Arm in Arm auf und ab, die Gymnasiasten fehlen nicht, und auch ältere Mädchen sind da, Mädchen von zwanzig, einundzwanzig Jahren.“"
                                            },
                                            {
                                                "example_id": "c5817cab-d537-4b37-86fd-730baa08d83e",
                                                "sense_id": "dc08f074-6762-3160-b92e-a4b68dab507c",
                                                "text": "„Mama sagte, daß sie als Schülerin immer zugesehen habe, einen Platz ganz hinten zu kriegen.“"
                                            },
                                            {
                                                "example_id": "55b1f765-136a-411e-af7f-9373a91d9d81",
                                                "sense_id": "dc08f074-6762-3160-b92e-a4b68dab507c",
                                                "text": "„Als Schülerin hörte ich die Birkenstocks über das Pflaster auf dem Platz vor dem Straßburger Münster trappeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5db16fad-18b0-3548-81fb-cdb1d06f5025",
                                        "entry_id": "62400b8c-2bd7-3b1b-b56d-07e83b773bab",
                                        "glosses": [
                                            "weiblicher Anhänger eines bestimmten Lehrers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ac3a6a-1aca-4ba9-8ffa-f1fb04439f35",
                                                "sense_id": "5db16fad-18b0-3548-81fb-cdb1d06f5025",
                                                "text": "Sie war eine Schülerin von Rodin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
