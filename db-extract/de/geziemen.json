                        "source_sense_id": "89148987-54d7-34ad-afd4-c7e8193c1416",
                        "source_sense_description": "den Sitten, den Regeln des Anstands entsprechen",
                        "target_lang_word": "befit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
