                "senses": [
                    {
                        "sense_id": "c043bc69-feb0-391f-b29c-82f058207824",
                        "entry_id": "3c2f8221-cff1-3b5f-a9b8-0df73a1769e8",
                        "glosses": [
                            "Tourment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c773940c-7190-44d9-ab23-3b816878cdcc",
                                "sense_id": "c043bc69-feb0-391f-b29c-82f058207824",
                                "text": "etwas macht, bereitet jm viel, genug, wenig Kopfzerbrechen : quelque chose provoque chez quelqu’un beaucoup, suffisamment, un peu de tourment."
                            },
                            {
                                "example_id": "49ea7fa4-b65e-45f8-b7cd-e25b04440174",
                                "sense_id": "c043bc69-feb0-391f-b29c-82f058207824",
                                "text": "etwas erfordert, verursacht Kopfzerbrechen.",
                                "translation": "Quelque chose nécessite, engendre du tourment."
                            },
                            {
                                "example_id": "02fea1d9-760f-4e38-8a3f-31b5c62c2d7b",
                                "sense_id": "c043bc69-feb0-391f-b29c-82f058207824",
                                "text": "er machte sich (datif) darüber nicht viel Kopfzerbrechen.",
                                "translation": "Il ne s’inquiète pas beaucoup (litt. : il ne se fait à ce sujet pas beaucoup de tourments)."
                            }
                        ]
