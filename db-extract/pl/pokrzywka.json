                        "entry_id": "04af01ab-1d93-3b31-a778-9dec8812ae32",
                        "glosses": [
                            "zmiany na skórze w postaci swędzących bąbli, będące objawem uczulenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2496770-9364-4f17-9cfa-5fdd588ee36a",
                                "sense_id": "ca38e0d9-1331-39c8-af73-9264f11c8fd7",
                                "text": "Po zjedzeniu pomidorów zawsze wyskakuje mi pokrzywka."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "14819837-59a3-374f-8b1b-6caba554b9bd",
                        "entry_id": "04af01ab-1d93-3b31-a778-9dec8812ae32",
                        "glosses": [
                            "zabawa dziecięca polegająca na mocnym uchwycie oburącz czyjejś ręki i przekręceniu zaciśniętych dłoni w przeciwnych kierunkach, wywołując uczucie pieczenia"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
