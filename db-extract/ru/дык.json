                            },
                            {
                                "example_id": "439dd415-e77d-4180-9357-9c1ae12d53c4",
                                "sense_id": "41b537dc-cd2e-39ed-b472-23156ef63fc1",
                                "text": "Дык я и не спо́рю",
                                "translation": "Yeah, well, I'm not arguing",
