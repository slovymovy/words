                                "target_lang_word": "dreist",
                                "target_lang_sense_clarification": "unverfroren, ohne Scheu und Zurückhaltung"
                            },
                            {
                                "target_lang_word": "respektlos",
                                "target_lang_sense_clarification": "missachtet Autorität und Regeln"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "insolente",
                                "target_lang_sense_clarification": "desafiante ante profesores o superiores"
                            },
                            {
                                "target_lang_word": "descarado",
                                "target_lang_sense_clarification": "atrevido, sin pudor al hablar"
                            },
                            {
                                "target_lang_word": "irrespetuoso",
                                "target_lang_sense_clarification": "falta de respeto a autoridades"
                            }
