                        "examples": [
                            {
                                "example_id": "9d3cfc0f-26a0-4e78-82b5-05c87d16a30c",
                                "sense_id": "e2504eb6-2139-337d-acd5-aebe1078eea9",
                                "text": "La Grande Barrière s'étend sur plus de 345.000 km2 et constitue le plus vaste ensemble coralien réputé pour son exceptionnelle biodiversité marine. (archive)"
                            },
                            {
                                "example_id": "325672c2-dce9-422f-9ef4-2a743df5f25b",
                                "sense_id": "e2504eb6-2139-337d-acd5-aebe1078eea9",
                                "text": "L'étage moyen comprend une épaisseur considérable de grès quartzeux , séparés par des lits minces de marnes sans fossiles ; quelques intercalations de calcaires s'y rencontrent avec des fossiles coraliens."
                            },
                            {
                                "example_id": "cd05cbc9-aeb1-45f3-8ae3-2d4a02cf1ba6",
                                "sense_id": "e2504eb6-2139-337d-acd5-aebe1078eea9",
                                "text": "Le groupe coralien, ainsi que l’indique son nom, est rempli de polypiers d’une structure saccharoïde ou qui sont passés à l’état siliceux"
                            }
                        ]
