{
    "word_family": [
        "schikken",
        "schikking",
        "inschikkend",
        "inschikkelijkheid"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd5eff9f-f69b-33e4-af7a-4fd7eb7b88f4",
                    "sense_definition": "opschuiven om meer ruimte te maken voor anderen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ruimte maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als we allemaal een beetje <w>inschikken</w>, past die extra stoel ook nog aan de tafel.",
                            "target_lang_translations": {
                                "en": "If we all <w>move over</w> a bit, that extra chair will also fit at the table."
                            }
                        },
                        {
                            "text": "Kunnen jullie wat <w>inschikken</w> op de bank zodat opa ook kan zitten?",
                            "target_lang_translations": {
                                "en": "Can you guys <w>scoot over</w> a bit on the couch so grandpa can sit down too?"
                            }
                        }
                    ],
                    "synonyms": [
                        "opschuiven",
                        "bijschuiven"
                    ],
                    "antonyms": [
                        "uitbreiden"
                    ],
                    "common_phrases": [
                        "een beetje inschikken",
                        "wat inschikken"
                    ],
                    "target_lang_definitions": {
                        "en": "to move over or shift to make more room for others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move over",
                                "target_lang_sense_clarification": "to make space for someone else"
                            },
                            {
                                "target_lang_word": "scoot over",
                                "target_lang_sense_clarification": "informal way to make room"
                            },
                            {
                                "target_lang_word": "make room",
                                "target_lang_sense_clarification": "to create space by shifting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75122c0a-db88-30cc-b27e-1e689a27c26b",
                    "sense_definition": "toegeven aan de wensen van anderen of je aanpassen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "toegeven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In een goede relatie moet je soms een beetje <w>inschikken</w> om de vrede te bewaren.",
                            "target_lang_translations": {
                                "en": "In a good relationship, you sometimes have to <w>give in</w> a little to keep the peace."
                            }
                        },
                        {
                            "text": "Hij wilde niet <w>inschikken</w> en hield koppig vast aan zijn eigen plan.",
                            "target_lang_translations": {
                                "en": "He didn't want to <w>compromise</w> and stubbornly stuck to his own plan."
                            }
                        }
                    ],
                    "synonyms": [
                        "toegeven",
                        "schikken",
                        "aanpassen"
                    ],
                    "antonyms": [
                        "volharden",
                        "doorzetten"
                    ],
                    "common_phrases": [
                        "moeten inschikken"
                    ],
                    "target_lang_definitions": {
                        "en": "to yield to the wishes of others or to adapt oneself"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give in",
                                "target_lang_sense_clarification": "to yield to someone's wishes"
                            },
                            {
                                "target_lang_word": "accommodate",
                                "target_lang_sense_clarification": "to adapt to someone's needs"
                            },
                            {
                                "target_lang_word": "compromise",
                                "target_lang_sense_clarification": "to adjust one's position for agreement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}