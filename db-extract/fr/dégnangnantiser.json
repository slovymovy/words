                "senses": [
                    {
                        "sense_id": "14f41c40-5c1d-3e4e-8776-d1f8f9f0f97e",
                        "entry_id": "5d3978df-ad0c-3107-b97a-19531fc2a8de",
                        "glosses": [
                            "Faire perdre son caractère gnangnan à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f6b539-074d-4530-ad44-87c3110801b0",
                                "sense_id": "14f41c40-5c1d-3e4e-8776-d1f8f9f0f97e",
                                "text": "Mais autant l'original se servait de la parodie pour dégnangnantiser, dédisneyiser le dessin animé; autant la suite est un tour de manège."
                            },
                            {
                                "example_id": "9dfe28aa-2078-4a38-b2f5-56d0cb753687",
                                "sense_id": "14f41c40-5c1d-3e4e-8776-d1f8f9f0f97e",
                                "text": "A propos, le gilet de cuir est très fort pour dégnangnantiser vite fait n'importe quel imprimé fleu-fleurs."
                            },
                            {
                                "example_id": "79e115e0-0759-4aed-a9df-1492d3c348cc",
                                "sense_id": "14f41c40-5c1d-3e4e-8776-d1f8f9f0f97e",
                                "text": "Et pour dégnangnantiser, j'ai utiliser le Gosh – Holographic en base."
                            },
                            {
                                "example_id": "17d233e8-5f68-4afa-90d3-812773ef5b4e",
                                "sense_id": "14f41c40-5c1d-3e4e-8776-d1f8f9f0f97e",
                                "text": "J'ai l'impression que le sexe est un moyen de \"dégnangnantiser\" les histoires, alors qu'on pourrait très bien y arriver par d'autres moyens, avec de meilleurs dialogues, de meilleures intrigues."
                            }
                        ]
                    }
                ],
