    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e297bbb-ba81-340f-97d5-a4696c7776bc",
                    "sense_definition": "A water-borne vessel generally larger than a boat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large <w>ship</w> sailed across the Atlantic Ocean for two weeks.",
                            "target_lang_translations": {
                                "ru": "Большой <w>корабль</w> шел через Атлантический океан в течение двух недель."
                            }
                        },
                        {
                            "text": "We watched the <w>ship</w> leave the harbor as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как <w>судно</w> выходит из гавани на закате."
                            }
                        }
                    ],
                    "synonyms": [
                        "vessel",
                        "craft"
                    ],
                    "common_phrases": [
                        "cruise ship",
                        "cargo ship",
                        "board a ship",
                        "sink a ship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Водное судно, обычно большего размера, чем лодка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корабль",
                                "target_lang_sense_clarification": "крупное морское или военно-морское судно"
                            },
                            {
                                "target_lang_word": "судно",
                                "target_lang_sense_clarification": "общее название для плавсредств"
                            },
                            {
                                "target_lang_word": "пароход",
                                "target_lang_sense_clarification": "судно с паровым двигателем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d37108f-5159-305a-9bfe-dd2a4aed4e5f",
                    "sense_definition": "A vessel which travels through any medium other than across land, such as an airship or spaceship.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The astronauts boarded the <w>ship</w> to begin their long journey to Mars.",
                            "target_lang_translations": {
                                "ru": "Астронавты поднялись на борт <w>корабля</w>, чтобы начать свое долгое путешествие к Марсу."
                            }
                        },
                        {
                            "text": "In the movie, a giant alien <w>ship</w> hovered over the city.",
                            "target_lang_translations": {
                                "ru": "В фильме гигантский инопланетный <w>корабль</w> завис над городом."
                            }
                        }
                    ],
                    "synonyms": [
                        "spacecraft",
                        "vessel"
                    ],
                    "common_phrases": [
                        "alien ship",
                        "mother ship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство для перемещения в любой среде, кроме суши, например, воздушное или космическое судно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корабль",
                                "target_lang_sense_clarification": "летательный аппарат большой мощности"
                            },
                            {
                                "target_lang_word": "судно",
                                "target_lang_sense_clarification": "транспортное средство в воздухе или космосе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "040268a3-381d-34bb-a1bd-b89931b72a49",
                    "sense_definition": "A sailing vessel with three or more square-rigged masts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum features a full-scale replica of an eighteenth-century square-rigged <w>ship</w>.",
                            "target_lang_translations": {
                                "ru": "В музее представлена полномасштабная реплика <w>корабля</w> восемнадцатого века с прямым парусным вооружением."
                            }
                        },
                        {
                            "text": "It takes a highly skilled crew to manage the sails on such a massive <w>ship</w>.",
                            "target_lang_translations": {
                                "ru": "Для управления парусами на таком массивном <w>корабле</w> требуется высококвалифицированная команда."
                            }
                        }
                    ],
                    "synonyms": [
                        "sailing vessel",
                        "tall ship"
                    ],
                    "common_phrases": [
                        "sailing ship"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Парусное судно с тремя или более мачтами с прямым парусным вооружением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корабль",
                                "target_lang_sense_clarification": "парусное судно"
                            },
                            {
                                "target_lang_word": "парусник",
                                "target_lang_sense_clarification": "судно, использующее силу ветра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f63ea83a-ed7e-33ad-9111-58fa9ac79ed7",
                    "sense_definition": "A fictional romantic relationship between two characters, especially one explored in fan fiction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fandom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their favorite <w>ship</w> finally became canon in the latest episode of the series.",
                            "target_lang_translations": {
                                "ru": "Их любимый <w>пейринг</w> наконец-то стал каноном в последней серии сериала."
                            }
                        },
                        {
                            "text": "The fans wrote thousands of stories about their preferred romantic <w>ship</w>.",
                            "target_lang_translations": {
                                "ru": "Фанаты написали тысячи историй о своем любимом романтическом <w>шипе</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pairing"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet and fandom culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымышленная романтическая связь между двумя персонажами, часто описываемая в фанфиках."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пейринг",
                                "target_lang_sense_clarification": "пара персонажей в фандоме"
                            },
                            {
                                "target_lang_word": "шип",
                                "target_lang_sense_clarification": "сокращение от шиппинг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d3b51c7-bedd-3878-8a73-74677cb8decb",
                    "sense_definition": "To send a parcel or container to a recipient by any means of transport.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company will <w>ship</w> your order within twenty-four hours of purchase.",
                            "target_lang_translations": {
                                "ru": "Компания <w>отправит</w> ваш заказ в течение двадцати четырех часов после покупки."
                            }
                        },
                        {
                            "text": "It is often cheaper to <w>ship</w> freight by railroad than by truck.",
                            "target_lang_translations": {
                                "ru": "Часто дешевле <w>перевозить</w> грузы по железной дороге, чем на грузовиках."
                            }
                        }
                    ],
                    "synonyms": [
                        "send",
                        "dispatch",
                        "deliver"
                    ],
                    "antonyms": [
                        "receive"
                    ],
                    "common_phrases": [
                        "ship freight",
                        "ready to ship",
                        "ship overseas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить посылку или контейнер получателю любым видом транспорта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отправить",
                                "target_lang_sense_clarification": "послать груз или посылку"
                            },
                            {
                                "target_lang_word": "доставить",
                                "target_lang_sense_clarification": "перевезти до места назначения"
                            },
                            {
                                "target_lang_word": "отгрузить",
                                "target_lang_sense_clarification": "передать товар для транспортировки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8258504-93ec-33ef-a3f7-a832dfb1078b",
                    "sense_definition": "To release a product, not necessarily physical, to vendors or customers; to launch.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software developers worked late to ensure the new version would <w>ship</w> on time.",
                            "target_lang_translations": {
                                "ru": "Разработчики ПО работали допоздна, чтобы убедиться, что новая версия <w>выйдет</w> вовремя."
                            }
                        },
                        {
                            "text": "Our next issue <w>ships</w> early next year to all our subscribers.",
                            "target_lang_translations": {
                                "ru": "Наш следующий номер <w>будет разослан</w> всем подписчикам в начале следующего года."
                            }
                        }
                    ],
                    "synonyms": [
                        "release",
                        "launch"
                    ],
                    "common_phrases": [
                        "ship a product",
                        "ship on time"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in business or tech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпустить продукт (не обязательно физический) продавцам или клиентам; запустить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпустить",
                                "target_lang_sense_clarification": "сделать продукт доступным"
                            },
                            {
                                "target_lang_word": "релизнуть",
                                "target_lang_sense_clarification": "сленг в IT и бизнесе"
                            },
                            {
                                "target_lang_word": "запустить",
                                "target_lang_sense_clarification": "начать продажи или использование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85bedbb4-d854-3fe9-8eb8-ae4918a5bbc4",
                    "sense_definition": "To take in or take on water over the sides of a vessel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nautical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat began to <w>ship</w> water during the violent storm.",
                            "target_lang_translations": {
                                "ru": "Во время сильного шторма маленькая лодка начала <w>зачерпывать</w> воду."
                            }
                        },
                        {
                            "text": "We were <w>shipping</w> so much water I was sure we would capsize.",
                            "target_lang_translations": {
                                "ru": "Мы <w>набирали</w> так много воды, что я был уверен — мы перевернемся."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ship water"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зачерпывать воду через борт судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачерпнуть",
                                "target_lang_sense_clarification": "принять воду через борт"
                            },
                            {
                                "target_lang_word": "набрать",
                                "target_lang_sense_clarification": "о воде, попадающей внутрь судна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "603c83bc-4f2f-312e-b4a0-06e6d607c22c",
                    "sense_definition": "To support or approve of a fictional romantic relationship between two characters.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fandom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many fans <w>ship</w> the two lead characters even though they are just friends.",
                            "target_lang_translations": {
                                "ru": "Многие фанаты <w>шипперят</w> двух главных героев, хотя они просто друзья."
                            }
                        },
                        {
                            "text": "I <w>ship</w> Peggy and Angie in the latest television series.",
                            "target_lang_translations": {
                                "ru": "Я <w>шипперю</w> Пегги и Энджи в этом новом сериале."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet and fandom culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать или одобрять вымышленные романтические отношения между двумя персонажами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шипперить",
                                "target_lang_sense_clarification": "фантазировать об отношениях персонажей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}