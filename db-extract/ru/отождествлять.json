                    {
                        "form_id": "7b7ca425-62b1-47af-9f13-b7c3e55a42e3",
                        "entry_id": "71d0c8fe-93f2-3f23-bd04-d27a6d4c4bf5",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "отождествля́вши"
                    },
                    {
                        "form_id": "637561d1-a630-4ecc-91f0-767dac60a357",
                        "entry_id": "71d0c8fe-93f2-3f23-bd04-d27a6d4c4bf5",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… отождествля́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1267698d-92c4-3db1-9f45-cf881ea8d48b",
                        "entry_id": "71d0c8fe-93f2-3f23-bd04-d27a6d4c4bf5",
                        "glosses": [
                            "признавать какие-либо явления одинаковыми, тождественными, не имеющими никаких отличий; уподоблять чему-либо, находить сходство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2934634-2be3-491e-beed-e5bb47c502f2",
                                "sense_id": "1267698d-92c4-3db1-9f45-cf881ea8d48b",
                                "text": "Если ребёнку читают ту сказку, где выступает добрый, неустрашимый, благородный герой, который сражается со злыми врагами, ребёнок непременно отождествляет с этим героем себя."
                            },
                            {
                                "example_id": "85a54dc4-6064-4410-98ae-ef5c12cfe31a",
                                "sense_id": "1267698d-92c4-3db1-9f45-cf881ea8d48b",
                                "text": "В философии распространена склонность совершенно отождествлять разум со способностью познания в её высших обнаружениях."
                            },
                            {
                                "example_id": "344f59b0-d98c-45d5-937b-8a1ba2d121ea",
                                "sense_id": "1267698d-92c4-3db1-9f45-cf881ea8d48b",
                                "text": "Сутью тождества до такой степени оказывается различие, что если я захочу отождествлять одно и то же с ним же самим, то оно, раньше пребывавшее в спокойном тождестве с собой, от отождествления станет другим себе. «Смысл вещи есть, таким образом, сама же вещь, но только взятая в тождестве сама с собой. А поскольку отождествлять можно только то, что различно, то смысл вещи есть сама же вещь, но взятая в то же самое время и в различии с самой собой»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d230972-97dd-4fc0-88c4-9f0d9f72bcf6",
                        "source_entry_id": "71d0c8fe-93f2-3f23-bd04-d27a6d4c4bf5",
                        "source_sense_id": "1267698d-92c4-3db1-9f45-cf881ea8d48b",
                        "target_lang_word": "apparenter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparenter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f98b0f5d-4d96-393b-81de-00dce62081f9",
                                        "entry_id": "96703da1-1360-33dc-9a75-3e9baa3d1eba",
                                        "glosses": [
                                            "Rendre parent par alliance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63bd580-0e09-4886-9c7a-7122eec70998",
                                                "sense_id": "f98b0f5d-4d96-393b-81de-00dce62081f9",
                                                "text": "Tâchez de bien apparenter votre fille."
                                            },
                                            {
                                                "example_id": "42e948e1-5b99-4637-914e-12046ca8742f",
                                                "sense_id": "f98b0f5d-4d96-393b-81de-00dce62081f9",
                                                "text": "Ce mariage l’a mal apparenté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45476d62-290b-35f2-85f0-5aefa15c6d4e",
                                        "entry_id": "96703da1-1360-33dc-9a75-3e9baa3d1eba",
                                        "glosses": [
                                            "Se rendre parent par alliance."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b5738c7-161f-44da-9da9-f1f0998e4ba4",
                                                "sense_id": "45476d62-290b-35f2-85f0-5aefa15c6d4e",
                                                "text": "S’apparenter à la noblesse, à la bourgeoisie."
                                            },
                                            {
                                                "example_id": "6ee41618-e758-4a63-94c0-65f62e48e677",
                                                "sense_id": "45476d62-290b-35f2-85f0-5aefa15c6d4e",
                                                "text": "Elle s’est bien apparentée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c68e211-9068-3534-9cae-fcc5a2fc1cfe",
                                        "entry_id": "96703da1-1360-33dc-9a75-3e9baa3d1eba",
                                        "glosses": [
                                            "Avoir des rapports d’analogie, de ressemblance, pour deux choses qui vont ensemble."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9af4976-7808-4036-a213-d545032087e6",
                                                "sense_id": "1c68e211-9068-3534-9cae-fcc5a2fc1cfe",
                                                "text": "L'usage voulait, pour certaines correspondances véhiculant des informations confidentielles, que l'on cryptât celles-ci en recourant à des lettres ou à des chiffres qui s'apparentaient à des signes cabalistiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7dd0176-6b3a-4c36-a2cd-63bdf64f9e3b",
                        "source_entry_id": "71d0c8fe-93f2-3f23-bd04-d27a6d4c4bf5",
                        "source_sense_id": "1267698d-92c4-3db1-9f45-cf881ea8d48b",
                        "target_lang_word": "assimiler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assimiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7bc7f7e-8d56-32b0-b9db-eb5c9317d1b8",
                                        "entry_id": "db22d8b0-f688-3302-8a80-8232522de1b9",
                                        "glosses": [
                                            "Rendre semblable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93733cb6-c653-4edf-83ef-2237b7e4b604",
                                                "sense_id": "d7bc7f7e-8d56-32b0-b9db-eb5c9317d1b8",
                                                "text": "Ces penchants honteux assimilent l’homme à la brute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a3aed4e-9286-399a-b165-72b95b0dc39d",
                                        "entry_id": "db22d8b0-f688-3302-8a80-8232522de1b9",
                                        "glosses": [
                                            "Présenter comme semblables deux ou plusieurs personnes, ou deux ou plusieurs choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711636a1-2f1a-4864-8246-2421f61777b5",
                                                "sense_id": "5a3aed4e-9286-399a-b165-72b95b0dc39d",
                                                "text": "De plus, on assimile volontiers les femmes adultères aux prostituées et la pratique de la fornication, prostibulaire ou adultère, suppose le mensonge ou la clandestinité, comme l'ont si bien illustré les fabliaux, qui insistent sur les mensonges de l'épouse volage."
                                            },
                                            {
                                                "example_id": "4f292d5f-a66e-43fa-a319-a5d5be06f83b",
                                                "sense_id": "5a3aed4e-9286-399a-b165-72b95b0dc39d",
                                                "text": "Remarquons d’entrée de jeu qu'il faut méconnaître le père de la théorie de la relativité pour imaginer qu'il ait pu assimiler l'astrologie à une « science »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32b3221a-838d-3ee7-98a4-7772647d2cae",
                                        "entry_id": "db22d8b0-f688-3302-8a80-8232522de1b9",
                                        "glosses": [
                                            "Absorber les aliments lors de la digestion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93c9fcbb-598b-39b0-9f37-751ede8b6743",
                                        "entry_id": "db22d8b0-f688-3302-8a80-8232522de1b9",
                                        "glosses": [
                                            "Incorporer du savoir, des connaissances dans l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30725688-6879-4383-8b70-2b18e18c115e",
                                                "sense_id": "93c9fcbb-598b-39b0-9f37-751ede8b6743",
                                                "text": "Nous nous attachons à diffuser des sommes de connaissances que les élèves les moins préparés ne pourront de toute façon assimilier après des heures de cours hebdomadaires."
                                            },
                                            {
                                                "example_id": "75dce7cf-deea-4395-86f7-d8720fc927ab",
                                                "sense_id": "93c9fcbb-598b-39b0-9f37-751ede8b6743",
                                                "text": "Or, elles ne disposaient ni l’une ni l’autre d’équipes de R&D dans le domaine, capables d’assimiler les informations produites et de les exploiter […]."
                                            },
                                            {
                                                "example_id": "6e31ec2d-ca96-4f50-b786-7c10ea2eee65",
                                                "sense_id": "93c9fcbb-598b-39b0-9f37-751ede8b6743",
                                                "text": "Dans les sociétés où la nourriture est pimentée, l’enfant, sans être jamais forcé, assimile lentement les comportements des adultes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b80d900b-6009-3241-9ea4-27a8b84ab592",
                                        "entry_id": "db22d8b0-f688-3302-8a80-8232522de1b9",
                                        "glosses": [
                                            "Incorporer quelqu'un, une minorité à un groupe social, lui faire prendre les caractères de celui-ci"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd7508bb-bcf5-3c16-ae72-750a25efa329",
                                        "entry_id": "db22d8b0-f688-3302-8a80-8232522de1b9",
                                        "glosses": [
                                            "Devenir semblable."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bbf23ab-7a6c-4d83-94f6-d72f04d281f5",
                                                "sense_id": "dd7508bb-bcf5-3c16-ae72-750a25efa329",
                                                "text": "Mais leurs enfants, nés en France, ne se sont pas pour rien assimilés à nous. La grande similitude qu'ils ont premièrement avec nous se manifeste par l'adoption de nos mœurs malthusiennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bc4f49e-5ebd-37d8-b8b1-441bd2aea786",
                                        "entry_id": "db22d8b0-f688-3302-8a80-8232522de1b9",
                                        "glosses": [
                                            "Exercer sa faculté d’assimilation, en parlant des corps vivants."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "832ccbca-31db-4e40-a9d9-fa0c623a1efe",
                                                "sense_id": "9bc4f49e-5ebd-37d8-b8b1-441bd2aea786",
                                                "text": "Les corps vivants croissent et s’entretiennent en s’assimilant des substances étrangères, en les assimilant à leur propre substance."
                                            },
                                            {
                                                "example_id": "7bca9f14-67fe-4e75-9d25-77a87323a655",
                                                "sense_id": "9bc4f49e-5ebd-37d8-b8b1-441bd2aea786",
                                                "text": "Les particules matérielles qui s’assimilent à la propre substance d’un animal, d’un végétal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
