            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b3cc546-5337-3595-8b34-051aa651b4b4",
                    "sense_definition": "Attaquer une ville ou une position militaire en larguant des bombes ou en tirant avec de l'artillerie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attaque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'aviation ennemie a commencé à <w>bombarder</w> la ville dès les premières heures de l'aube."
                        },
                        {
                            "text": "Les troupes ont décidé de <w>bombarder</w> les positions fortifiées pour forcer les soldats à battre en retraite."
                        }
                    ],
                    "synonyms": [
                        "pilonner"
                    ],
                    "common_phrases": [
                        "bombarder une ville",
                        "bombarder des positions"
                    ]
                },
                {
                    "sense_id": "1fc1162e-96ae-39ab-9735-2ca653594501",
                    "sense_definition": "Accabler ou presser continuellement quelqu'un de demandes, de messages ou de questions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sollicitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes n'ont pas tardé à le <w>bombarder</w> de questions dès son arrivée devant le tribunal."
                        },
                        {
                            "text": "Depuis ce matin, les clients <w>bombardent</w> le standard téléphonique d'appels urgents."
                        }
                    ],
                    "common_phrases": [
                        "bombarder de questions",
                        "bombarder de messages"
                    ]
                },
                {
                    "sense_id": "2d006a31-46c0-3783-94f4-db8963d41a5f",
                    "sense_definition": "Lancer des projectiles de manière répétée contre quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attaque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les manifestants en colère se sont mis à <w>bombarder</w> le bâtiment officiel avec des pierres."
                        },
                        {
                            "text": "Pendant l'hiver, les enfants s'amusaient à <w>bombarder</w> les passants avec des boules de neige."
                        }
                    ],
                    "common_phrases": [
