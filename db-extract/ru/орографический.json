                        "cross_references": [
                            {
                                "target_word": "orographisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5732878-6dbd-3706-9ee1-9aba70939900",
                                        "entry_id": "5898b1b8-29ee-3165-8adc-2413ade079ca",
                                        "glosses": [
                                            "die Orographie, das Geländerelief betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c7c2f8b-c83f-41d8-b7c6-246bd53fe0b0",
                                                "sense_id": "b5732878-6dbd-3706-9ee1-9aba70939900",
                                                "text": "„Die orographische Struktur des Mondes kann man sehr deutlich nach Gebirgsketten, Einzelbergen, Ringgebirgen und Rillen unterscheiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
