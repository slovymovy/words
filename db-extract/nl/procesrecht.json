                        "source_sense_id": "dd31d9f4-feb8-325e-844f-55cf44a05c46",
                        "target_lang_word": "Verfahrensrecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verfahrensrecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd52acd-8bfe-3332-85fc-ae4f1ea8e8e0",
                                        "entry_id": "a2bdfb0c-10a8-3d8b-900b-aa8689235ccc",
                                        "glosses": [
                                            "Gesamtheit der rechtlichen Vorschriften, die den Ablauf von gerichtlichen und auch außergerichtlichen Verfahren regeln"
                                        ],
                                        "tags": [
                                            "Rechtswesen",
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb698b67-bb88-48bd-8885-2e7985bc060a",
                                                "sense_id": "fcd52acd-8bfe-3332-85fc-ae4f1ea8e8e0",
                                                "text": "„Einigen Änderungen im Strafrecht und Verfahrensrecht hat der Senat bereits zugestimmt, z. B. der Einschränkung der U-Haft und der Verwendung von Handschellen nur in Ausnahmefällen.“"
                                            },
                                            {
                                                "example_id": "e9d4c268-85c7-4bec-8d3e-2fbe0c1936b2",
                                                "sense_id": "fcd52acd-8bfe-3332-85fc-ae4f1ea8e8e0",
                                                "text": "„Im Jahr 2021 überzeugt er die Politik, das Verfahrensrecht wird tatsächlich geändert.“"
                                            },
                                            {
                                                "example_id": "d96c902b-c1c8-455f-bf25-789b223ad0c8",
                                                "sense_id": "fcd52acd-8bfe-3332-85fc-ae4f1ea8e8e0",
                                                "text": "„Aufgrund von Änderungen des Verfahrensrechts im Bundesfernstraßengesetz ist die Auslage ausschließlich im Internet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5190a0ab-e675-3dd5-8395-59022299afac",
                                        "entry_id": "a2bdfb0c-10a8-3d8b-900b-aa8689235ccc",
                                        "glosses": [
                                            "Recht, das jemand während einer Gerichtsverhandlung genießt"
                                        ],
                                        "tags": [
                                            "plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c7237b-94f5-418d-88c4-8b350123c971",
                                                "sense_id": "5190a0ab-e675-3dd5-8395-59022299afac",
                                                "text": "„Was ihn besonders störe, sei die fristlose Kündigung, bei der nicht einmal die minimalen Verfahrensrechte eingehalten worden seien.“"
                                            },
                                            {
                                                "example_id": "841e1077-53eb-4d22-aae6-1beb8509226f",
                                                "sense_id": "5190a0ab-e675-3dd5-8395-59022299afac",
                                                "text": "„Für Landesjustizministerin Gentges blieben die Verfahrensrechte der Abzuschiebenden auch nach Abschaffung des Paragrafen 62d weiter gewahrt.“"
                                            },
                                            {
                                                "example_id": "624f9eaf-0b63-49fe-bf16-186bca8841c0",
                                                "sense_id": "5190a0ab-e675-3dd5-8395-59022299afac",
                                                "text": "„Die Richter gaben dem Antrag von Ryanair nun statt – allerdings nur in Bezug auf eine Verletzung der Verfahrensrechte im Rahmen des erforderlichen Prüfverfahrens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
