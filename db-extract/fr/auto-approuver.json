                "senses": [
                    {
                        "sense_id": "ecbc573e-28f6-300d-bd1f-c34ff833615a",
                        "entry_id": "4a4a29cb-5879-34dc-a7c4-954d530c2a16",
                        "glosses": [
                            "Approuver soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6301c25c-77ff-4c25-b5a1-6deaf6da305e",
                                "sense_id": "ecbc573e-28f6-300d-bd1f-c34ff833615a",
                                "text": "Ajout d'une permission pour auto-approuver les propositions de téléchargement"
                            },
                            {
                                "example_id": "cf5d1210-35ca-4824-99b5-5062a9d7455e",
                                "sense_id": "ecbc573e-28f6-300d-bd1f-c34ff833615a",
                                "text": "La \"cérémonie des fêtes de l'existence\" ne s'arrête jamais du fait de la connaissance qui demeure une manière qu'a la vie de s'auto-approuver."
                            },
                            {
                                "example_id": "156f89dc-5ee5-4892-9a4c-a62143f7bd56",
                                "sense_id": "ecbc573e-28f6-300d-bd1f-c34ff833615a",
                                "text": "Planquée derrière tes multiples pseudos pour comploter, insulter et t'auto-approuver, tu es de plus en plus pathétique."
                            }
                        ]
                    }
