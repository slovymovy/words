                                            {
                                                "example_id": "039be605-666e-420b-a795-1ec79635bbfa",
                                                "sense_id": "112d3227-ffde-352b-932e-1a9ad57e7f29",
                                                "text": "Oh, the believing is hard to be doing, because that was so incredible! We met so many celebrities in midair! And the part with the narwhale was so illegal."
                                            }
                                        ]
                                    }
                                ]
