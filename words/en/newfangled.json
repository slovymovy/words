                    "frequency": "Low",
                    "semantic_group_id": "novelty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to use the <w>newfangled</w> software because he preferred the simple tools he had used for years."
                        },
                        {
                            "text": "The kitchen is full of <w>newfangled</w> gadgets that nobody actually knows how to operate properly."
                        }
                    ],
                    "synonyms": [
