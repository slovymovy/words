                                        "sense_id": "a048a2eb-34aa-3bf1-9cd5-f93cb713e53f",
                                        "entry_id": "454ec70d-bf3d-3c3d-83d2-d255e112fb63",
                                        "glosses": [
                                            "che ha una visione chiara"
