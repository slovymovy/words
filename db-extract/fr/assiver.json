                ],
                "senses": [
                    {
                        "sense_id": "f533fb8f-45f0-339f-b1fc-f35a8952dcdd",
                        "entry_id": "09b53f78-c358-364d-829f-0530827a8843",
                        "glosses": [
                            "Donner à manger à un enfant en portant les aliments à sa bouche à l’aide d’une cuillère ou d’une fourchette."
                        ],
                        "tags": [
                            "Ardèche"
                        ],
                        "examples": [
                            {
                                "example_id": "61523614-38b5-4889-a80f-5e29c0ea6ab8",
                                "sense_id": "f533fb8f-45f0-339f-b1fc-f35a8952dcdd",
                                "text": "J’avais pourtant « sept ans et un couteau », comme le disait la vieille Philomène, l’âge de raison, donc de me servir d’une lame sans me couper, et aussi de me nourrir, de « m’assiver » seule, sans l’aide de personne."
                            },
                            {
                                "example_id": "a032102f-d041-4e47-8a42-cf340fdb9784",
                                "sense_id": "f533fb8f-45f0-339f-b1fc-f35a8952dcdd",
                                "text": "L'oncle se tuait au travail ou avait quelquefois la responsabilité du troupeau. La tante se chargeait souvent des enfants « qu'elle bressait, endormait, assivait, petassait, élevait... Elle s'occupait aussi de la cuisine, des chèvres […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "3aeb723e-2594-3b0d-a405-70e609cf0bef",
                        "entry_id": "09b53f78-c358-364d-829f-0530827a8843",
                        "glosses": [
                            "Nourrir des oiseaux en les élevant à la brochette."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
