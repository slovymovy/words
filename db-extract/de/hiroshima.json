                    {
                        "translation_id": "a84ddfa3-1078-4e62-a65f-726f8cb7bf40",
                        "source_entry_id": "0f815880-9fb7-3cb4-ae27-7c32869dfaf7",
                        "source_sense_id": "37f75061-59f8-3a58-a0b3-c8866c905d87",
                        "source_sense_description": "Hafenstadt auf der japanischen Insel Honshu (Honshū)",
                        "target_lang_word": "Hiroshima",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hiroshima",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15634342-b575-3c1f-9e9d-9dc94506adcb",
                                        "entry_id": "2b4719d2-d681-3b10-9243-ea0d9f60f51d",
                                        "glosses": [
                                            "A prefecture in southwestern Honshu, Japan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fba04584-0cfe-3495-b9eb-cc0b4e33a18b",
                                        "entry_id": "2b4719d2-d681-3b10-9243-ea0d9f60f51d",
                                        "glosses": [
                                            "The capital city of Hiroshima Prefecture, Japan; the target of the first atomic bomb dropped in warfare on August 6, 1945."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b025f9-0aa7-41f2-bc01-5879acf44ebd",
                                                "sense_id": "fba04584-0cfe-3495-b9eb-cc0b4e33a18b",
                                                "text": "A short time ago, an American airplane dropped one bomb on Hiroshima and destroyed its usefulness to the enemy."
                                            },
                                            {
                                                "example_id": "a17c0918-c6ce-45f6-b4da-ad80a46ab412",
                                                "sense_id": "fba04584-0cfe-3495-b9eb-cc0b4e33a18b",
                                                "text": "This slab is where the atomic bombs that were dropped on Hiroshima and Nagasaki 75 years ago were put together. It’s the assembly point for the dawning of the atomic age."
                                            },
                                            {
                                                "example_id": "37137d53-b7a3-4d05-ad6c-64942833fcc3",
                                                "sense_id": "fba04584-0cfe-3495-b9eb-cc0b4e33a18b",
                                                "text": "Kishida told the executives, including those from Micron Technology Inc (MU), Intel Corp (INTC) and Taiwan Semiconductor Manufacturing Co (TSM) (TSMC), that stabilizing supply chains would be a topic of discussion at the G7 talks in the western city of Hiroshima."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ef88abb-46d5-382a-9541-a6ad6dff7036",
                                        "entry_id": "2b4719d2-d681-3b10-9243-ea0d9f60f51d",
                                        "glosses": [
                                            "The 1945 atomic bombing of the city."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4989d1f-f279-4bb2-bb6a-be1f2130bad2",
                                                "sense_id": "1ef88abb-46d5-382a-9541-a6ad6dff7036",
                                                "text": "VINCENT: Tens of thousands killed before sundown; nobody's killed people that fast since Hiroshima and Nagasaki."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hiroshima",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2620c3e-2a36-3b32-88b7-864871e49e99",
                                        "entry_id": "0b88a160-2b88-317b-8a60-5f1452799c29",
                                        "glosses": [
                                            "A catastrophe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e97f6766-c96d-4819-a755-78684f261187",
                                                "sense_id": "a2620c3e-2a36-3b32-88b7-864871e49e99",
                                                "text": "Stuxnet is the Hiroshima of cyber-war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4811357-00b0-479a-b198-b9dfac788d49",
                        "source_entry_id": "0f815880-9fb7-3cb4-ae27-7c32869dfaf7",
                        "source_sense_id": "37f75061-59f8-3a58-a0b3-c8866c905d87",
                        "source_sense_description": "Hafenstadt auf der japanischen Insel Honshu (Honshū)",
                        "target_lang_word": "Hiroshima",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hiroshima",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9baffb24-85dc-377d-aacf-ab867bc4ce15",
                                        "entry_id": "698a58f0-f45c-31f7-8d21-ac5bffd3b087",
                                        "glosses": [
                                            "Ville du Japon avec une population de plus d’un million d'habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "838cbc27-de12-4b8c-a134-a745e87c5122",
                                                "sense_id": "9baffb24-85dc-377d-aacf-ab867bc4ce15",
                                                "text": "Originaire de Hiroshima, enseignant en lycée, linguiste à l’origine puis lancé dans les études chinoises, ce spécialiste du christianisme antique et lui-même chrétien, estime que plusieurs éléments matériels ou culturels japonais relèvent du nestorianisme et donc, possiblement, du judaïsme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2daaf0e-9866-30a3-8b8a-155aafda1b2e",
                                        "entry_id": "698a58f0-f45c-31f7-8d21-ac5bffd3b087",
                                        "glosses": [
                                            "Premier bombardement nucléaire au monde qui anéantit cette ville, le 6 août 1945."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce151d52-78bc-4253-aa90-46d7722b1bda",
                                                "sense_id": "f2daaf0e-9866-30a3-8b8a-155aafda1b2e",
                                                "text": "L'attentat qui s'est produit le 18 septembre 1931 à Moukden, une ville de Mandchourie, est l'un de ces événements oubliés qui ont pourtant changé le monde. En pratique, il fut insignifiant. Mais ses prolongements ont eu des répercussions jusqu'à Hiroshima et Nagasaki les 6 et 9 août 1945."
                                            },
                                            {
                                                "example_id": "9886decc-044e-46ad-9089-ac9046ae3e65",
                                                "sense_id": "f2daaf0e-9866-30a3-8b8a-155aafda1b2e",
                                                "text": "L’[OMS] négligera d’examiner les conséquences d’Hiroshima et Nagasaki et des retombées des essais atomiques, ainsi que les effets sanitaires de l’industrie atomique, tant sous le mandat de Brock Chisholm qu’après, jusqu’au scandale mondial que soulèveront les retombées du premier tir d’une bombe H – nom de code Bravo (puissance 15 Mt, le 1ᵉʳ mars 1954) – de la série Castle dans l’atoll de Bikini des îles Marshall, au cœur du Pacifique – on y reviendra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14777a79-9bab-3215-a99f-d92cb3e11af1",
                                        "entry_id": "698a58f0-f45c-31f7-8d21-ac5bffd3b087",
                                        "glosses": [
                                            "Catastrophe historique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1793548-e1f8-41f2-8c25-ab68f14f7c29",
                                                "sense_id": "14777a79-9bab-3215-a99f-d92cb3e11af1",
                                                "text": "Dolly est le Hiroshima de la biologie ! Hiroshima, c’est ce moment où s’impose l’idée que nous avons le moyen de détruire notre propre espèce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22db8138-86c7-3a35-99e0-4744007dbbae",
                                        "entry_id": "698a58f0-f45c-31f7-8d21-ac5bffd3b087",
                                        "glosses": [
                                            "Préfecture du Japon, dont la capitale est la précédente."
                                        ],
                                        "tags": [
                                            "Beaucoup moins courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f489c75-e3e9-4b19-8b5d-d18088a4c51b",
                                                "sense_id": "22db8138-86c7-3a35-99e0-4744007dbbae",
                                                "text": "Plus de 60 % des agriculteurs ont plus de soixante-cinq ans (dans certaines préfectures comme Hiroshima ou Yamaguchi, ce taux monte à 75 %) ; au niveau national, l’âge moyen des agriculteurs atteint soixante-sept ans (quarante-neuf en France)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05c811c-76cd-3d61-8ed1-7f8bfa3eb6e3",
                                        "entry_id": "698a58f0-f45c-31f7-8d21-ac5bffd3b087",
                                        "glosses": [
                                            "Préfecture japonaise ayant cette ville pour capitale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
