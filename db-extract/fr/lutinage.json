                "senses": [
                    {
                        "sense_id": "cc13b4ea-6b5c-372d-837e-d1e9fb77028f",
                        "entry_id": "f28207b4-d088-3e9c-9779-846b571c3069",
                        "glosses": [
                            "Action de lutiner, d’exciter par des taquineries galantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7487117-b083-4feb-a82d-f71905ac08d4",
                                "sense_id": "cc13b4ea-6b5c-372d-837e-d1e9fb77028f",
                                "text": "Quand Tartuffe se livre à ses jeux de scène de concupiscence à l’égard d’Elmire, l’effet comique est décuplé par le fait qu’Orgon, sous la table, commente de ses grimaces les tentatives de lutinage de sa femme."
                            },
                            {
                                "example_id": "c4c8633b-3b4f-46f3-923d-0c48b04c652a",
                                "sense_id": "cc13b4ea-6b5c-372d-837e-d1e9fb77028f",
                                "text": "Promenades, rapprochements, baisers, poursuites, lutinage, deviennent autorisés, voire presque obligatoires."
                            }
                        ]
                    },
                    {
                        "sense_id": "61b65912-6e3c-39c9-8a82-4cd872777595",
                        "entry_id": "f28207b4-d088-3e9c-9779-846b571c3069",
                        "glosses": [
                            "Action de pourchasser sexuellement une personne ne faisant pas partie des intimes, avec une familiarité excessive et inconvenante sous le couvert de la frivolité."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "03cc51f2-17d0-4f9d-b582-1d571b6c367c",
                                "sense_id": "61b65912-6e3c-39c9-8a82-4cd872777595",
                                "text": "On sait que des leaders politiques célèbres furent souvent accusés de comportements sexuels adultères ou d’attouchements inappropriés relevant plus du lutinage que du stupre."
                            },
                            {
                                "example_id": "d7312019-ff89-4f1f-bd7c-75e2d05026a2",
                                "sense_id": "61b65912-6e3c-39c9-8a82-4cd872777595",
                                "text": "Leurs bas instincts prenaient de l’envol, des allures de lutinage."
                            }
                        ]
                    }
                ],
