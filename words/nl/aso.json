{
    "word_family": [
        "asociaal",
        "asocialiteit"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2cdecb6a-914d-3cd8-9763-df349fdb2b28",
                    "sense_definition": "asociaal, onbeschoft of geen rekening houdend met anderen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "asociaal_gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vind het echt <w>aso</w> dat hij zijn auto zomaar op de stoep parkeert.",
                            "target_lang_translations": {
                                "en": "I think it is really <w>rude</w> that he just parks his car on the sidewalk."
                            }
                        },
                        {
                            "text": "Zulk <w>aso</w> gedrag wordt in deze buurt absoluut niet getolereerd.",
                            "target_lang_translations": {
                                "en": "Such <w>antisocial</w> behavior is absolutely not tolerated in this neighborhood."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aso gedrag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "asocial, rude, or showing no consideration for others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "asocial",
                                "target_lang_sense_clarification": "behaving in a way that is uncaring or harmful to society"
                            },
                            {
                                "target_lang_word": "antisocial",
                                "target_lang_sense_clarification": "contrary to the laws and customs of society, rude"
                            },
                            {
                                "target_lang_word": "rude",
                                "target_lang_sense_clarification": "not polite, offensive"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2acc296a-cc2b-3e03-be54-9313cce0bb74",
                    "sense_definition": "een asociaal, onbeschoft of maatschappelijk onaangepast persoon",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "asociaal_persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>aso</w> gooide zijn afval gewoon op straat zonder om te kijken.",
                            "target_lang_translations": {
                                "en": "That <w>jerk</w> just threw his trash on the street without looking back."
                            }
                        },
                        {
                            "text": "De politie neemt eindelijk actie tegen de <w>aso's</w> in het verkeer.",
                            "target_lang_translations": {
                                "en": "The police are finally taking action against the <w>road hogs</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tokkie"
                    ],
                    "common_phrases": [
                        "aso in het verkeer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en licht pejoratief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an asocial, rude, or socially maladjusted person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jerk",
                                "target_lang_sense_clarification": "a contemptible or obnoxious person"
                            },
                            {
                                "target_lang_word": "chav",
                                "target_lang_sense_clarification": "a young person of a social class characterized by coarse or brash behavior (UK)"
                            },
                            {
                                "target_lang_word": "asocial person",
                                "target_lang_sense_clarification": "someone who behaves in an antisocial or rude manner"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}