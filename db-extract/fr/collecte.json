                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6f05588-b51e-4c82-a861-9a92330b8d00",
                                "sense_id": "a6021a0c-182a-30d4-a127-1878fb5dce13",
                                "text": "La collecte a produit tant."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bff2acc-61ef-38af-949a-c6c5b818b860",
                        "entry_id": "6b3dbbde-6de7-3910-aba5-221b5cf83195",
                        "glosses": [
                            "Recensement."
