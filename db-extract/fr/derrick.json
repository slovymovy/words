                "entry_id": "93cc0cc9-37c2-3330-8a7a-d76c9bdbade2",
                "word": "derrick",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b3904877-354e-49ec-a125-b121a5cd4130",
                        "entry_id": "93cc0cc9-37c2-3330-8a7a-d76c9bdbade2",
                        "tags": [
                            "plural"
                        ],
                        "form": "derricks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b121dec-4e33-3a44-a32b-40aef7105b18",
                        "entry_id": "93cc0cc9-37c2-3330-8a7a-d76c9bdbade2",
                        "glosses": [
                            "Engin de manutention généralement fixe, formé d'un mât vertical qui soutient par câble une flèche articulée au bas du mât, et servant à soulever des charges tout autour du mât."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "88dd676b-307b-31bd-89a9-79ad81a93b30",
                        "entry_id": "93cc0cc9-37c2-3330-8a7a-d76c9bdbade2",
                        "glosses": [
                            "Tour métallique soutenant le dispositif de forage d'un puits de pétrole."
                        ],
                        "tags": [
                            "Industrie pétrolière"
                        ],
                        "examples": [
                            {
                                "example_id": "96a15835-1b4d-4752-b197-f47b21aade76",
                                "sense_id": "88dd676b-307b-31bd-89a9-79ad81a93b30",
                                "text": "Des clauses particulières permettent de couvrir les accidents proprement pétroliers, comme le « blow-out », et ceux des installations spécialement destinées au forage, comme le derrick."
                            }
                        ]
                    },
                    {
                        "sense_id": "9459bba6-825b-3268-aaf8-c080f1d4df66",
                        "entry_id": "93cc0cc9-37c2-3330-8a7a-d76c9bdbade2",
                        "glosses": [
                            "Meuble représentant la tour du même nom dans les armoiries. C’est un meuble assez rarement utilisé en héraldique."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "659f904e-9de9-4097-a763-576947bec712",
                                "sense_id": "9459bba6-825b-3268-aaf8-c080f1d4df66",
                                "text": "Écartelé, au premier d’or aux de vaches de gueules clarinées d’azur passant l’une sur l’autre, au deuxième d’argent au deux chaînes de sable posées en chevron renversé, accompagnées en chef d’une croisette pattée de gueules et d’azur, au troisième d’or au chêne de sinople, au quatrième de pourpre au derrick de sable, la base enflammée d’or, accompagnée en chef à senestre d’une cornue brochante d’argent, qui est de la commune de Pardies des Pyrénées-Atlantiques → voir illustration « armoiries avec un derrick »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f908ded-d2f2-4661-b605-9a1ee3872d2e",
                        "source_entry_id": "93cc0cc9-37c2-3330-8a7a-d76c9bdbade2",
                        "source_sense_description": "Technique : Engin de manutention",
                        "target_lang_word": "derrick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derrick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "945c627a-bee8-3af7-90b4-e4f4f177b612",
                                        "entry_id": "c26097ba-8199-370a-81b8-97e19837a077",
                                        "glosses": [
                                            "A device that is used for lifting and moving large objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ed4a18-4917-405b-b54b-32fc8241c9ef",
                                                "sense_id": "945c627a-bee8-3af7-90b4-e4f4f177b612",
                                                "text": "They count their ships full tale— / Their corn and oil and wine, / Derrick and loom and bale, / And rampart’s gun-flecked line; / City by City they hail: / “Hast aught to match with mine?”"
                                            },
                                            {
                                                "example_id": "71feae7a-a764-4275-9250-b8450a1796fe",
                                                "sense_id": "945c627a-bee8-3af7-90b4-e4f4f177b612",
                                                "text": "At some places it is possible to load or discharge a vessel without any expenditure on docks or wharves, by dealing with the cargo by hand, or by the ships derricks, or by means of floating discharging appliances while the vessel it moored to buoys in a tideway. […] At low tide it may be impracticable to use a ship's derricks [at a berth]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a060411-9ea3-312c-863a-f6302763116a",
                                        "entry_id": "c26097ba-8199-370a-81b8-97e19837a077",
                                        "glosses": [
                                            "A framework that is constructed over a mine or oil well for the purpose of boring or lowering pipes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bc6269a-0ce1-3c4f-8c91-1cc5718af65c",
                                        "entry_id": "c26097ba-8199-370a-81b8-97e19837a077",
                                        "glosses": [
                                            "An executioner responsible for hanging convicts; a hangman."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "derrick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc5845eb-224e-3fca-82a0-23b4a7ed6206",
                                        "entry_id": "0daeded4-855b-30f1-b0e3-73827b6fb0a7",
                                        "glosses": [
                                            "To hoist with, or as if with, a derrick."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbfa5112-1546-3f3b-9a4c-b97b4f69f899",
                                        "entry_id": "0daeded4-855b-30f1-b0e3-73827b6fb0a7",
                                        "glosses": [
                                            "To remove (a pitcher)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48f74456-4914-4f61-a96d-fc9b2a442e5e",
                                                "sense_id": "cbfa5112-1546-3f3b-9a4c-b97b4f69f899",
                                                "text": "Stinky, who had batted a bit over .200 with scant power (two home runs in 66 games in 1933), was being derricked by Navin."
                                            },
                                            {
                                                "example_id": "d1f361c0-706e-445f-8685-9f4568943ebd",
                                                "sense_id": "cbfa5112-1546-3f3b-9a4c-b97b4f69f899",
                                                "text": "As a rule, when the twirler is derricked, it is because the members of the opposition are beginning to take undue familiarity with his offerings. But this is not always the reason."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
