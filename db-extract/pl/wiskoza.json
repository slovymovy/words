                                                "example_id": "e98c97b1-ca2e-446d-92a6-52f9dca91206",
                                                "sense_id": "a907eb29-be94-31c5-910b-3382c5ee71ed",
                                                "text": "Here stood A cave,…unreached by rayons of the Sun."
