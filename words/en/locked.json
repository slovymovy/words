                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень пьяный (сленг).",
                        "zh": "喝得烂醉（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяный",
                                "target_lang_sense_clarification": "сильно"
                            },
                            {
                                "target_lang_word": "бухой",
                                "target_lang_sense_clarification": "грубый сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大醉的",
                                "target_lang_sense_clarification": "非常醉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "617f573e-3b1f-3ace-aa96-c3350af5182c",
                    "sense_definition": "Styled into dreadlocks; wearing dreadlocks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has beautiful <w>locked</w> hair that reaches all the way to her waist.",
                            "target_lang_translations": {
                                "ru": "У нее красивые <w>заплетенные в дреды</w> волосы, которые доходят ей до пояса.",
                                "zh": "她留着漂亮的<w>脏辫</w>，头发一直垂到腰间。"
                            }
                        },
                        {
                            "text": "He keeps his hair <w>locked</w> and maintains the style carefully.",
                            "target_lang_translations": {
                                "ru": "Он носит волосы <w>заплетенными в дреды</w> и тщательно следит за прической.",
                                "zh": "他一直<w>留着脏辫</w>，并精心打理这种发型。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loc'd",
                        "dreadlocked"
                    ],
                    "common_phrases": [
                        "locked hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уложенный в дреды; имеющий прическу из дредов.",
                        "zh": "梳成脏辫的；留着脏辫的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заплетенный в дреды",
                                "target_lang_sense_clarification": "о волосах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "留脏辫的",
                                "target_lang_sense_clarification": "发型"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1bb98c3-28de-3fcd-b8b7-87c79273283b",
                    "sense_definition": "Simple past and past participle of <w>lock</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>locked</w> the front door before she went to bed.",
                            "target_lang_translations": {
                                "ru": "Она <w>заперла</w> входную дверь перед тем, как лечь спать.",
                                "zh": "她睡觉前把前门<w>锁上</w>了。"
                            }
                        },
                        {
                            "text": "Have you <w>locked</w> the car securely?",
                            "target_lang_translations": {
                                "ru": "Ты надежно <w>запер</w> машину?",
                                "zh": "你把车<w>锁好</w>了吗？"
                            }
                        }
                    ],
