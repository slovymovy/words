                "senses": [
                    {
                        "sense_id": "c61a757b-19e7-37d3-a2fd-1fafe8cd8a67",
                        "entry_id": "8eb71508-bcdb-35b1-8c43-e5147e9691e9",
                        "glosses": [
                            "Mehrsprachigkeit (einzelner Personen oder Personengruppen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69ce9798-4f16-45e2-8353-939ee8071ad0",
                                "sense_id": "c61a757b-19e7-37d3-a2fd-1fafe8cd8a67",
                                "text": "Multilingualismus ist die Fähigkeit, sich für Zwecke der Kommunikation mehrerer verschiedener Sprachen bedienen zu können."
                            },
                            {
                                "example_id": "85447dbe-53ec-4d56-ba3b-baf1f3a3cd29",
                                "sense_id": "c61a757b-19e7-37d3-a2fd-1fafe8cd8a67",
                                "text": "„Ein stabiler Multilingualismus wäre wünschenswert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef315f4d-9f75-43fd-94f9-76be4cb0d9bc",
                        "source_entry_id": "8eb71508-bcdb-35b1-8c43-e5147e9691e9",
                        "source_sense_id": "c61a757b-19e7-37d3-a2fd-1fafe8cd8a67",
                        "source_sense_description": "Linguistik: Mehrsprachigkeit (einzelner Personen oder Personengruppen)",
                        "target_lang_word": "multilingualism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multilingualism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd192474-ae08-3ed2-99b1-dc3dcc65fda9",
                                        "entry_id": "ff433e35-e7a4-3d7d-94bd-7db3531ce5b8",
                                        "glosses": [
                                            "The condition of being multilingual; the ability to speak multiple languages."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d32a5448-0128-45f4-8999-2f00a71895ab",
                                                "sense_id": "cd192474-ae08-3ed2-99b1-dc3dcc65fda9",
                                                "text": "This is, perhaps, where writing centers and composition studies are implicated most obviously into the conversation of language ideology, translingualism, and multilingualism."
                                            },
                                            {
                                                "example_id": "ad082855-989b-4099-b77d-ff0d2e990806",
                                                "sense_id": "cd192474-ae08-3ed2-99b1-dc3dcc65fda9",
                                                "text": "Spielberg showed us, a nation historically obsessed with the idea of domination, that respect is a courageous choice and that multilingualism is our true color. It is who we are."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95d50528-ca14-46fa-8d2b-50ef45057c0e",
                        "source_entry_id": "8eb71508-bcdb-35b1-8c43-e5147e9691e9",
                        "source_sense_id": "c61a757b-19e7-37d3-a2fd-1fafe8cd8a67",
                        "source_sense_description": "Linguistik: Mehrsprachigkeit (einzelner Personen oder Personengruppen)",
                        "target_lang_word": "multilinguisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multilinguisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eee3f897-e09b-368f-9c40-7c64aab14ca0",
                                        "entry_id": "60d6b66c-2e89-38f8-9e36-bea656276a07",
                                        "glosses": [
                                            "Plurilinguisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d11dfc-a322-443d-98fc-64a2a0cfbd13",
                                                "sense_id": "eee3f897-e09b-368f-9c40-7c64aab14ca0",
                                                "text": "Ainsi, cette diversité des aspects, mentionnés au sujet de ces principales langues utilisées au Luxembourg, contribue à la représentation sociale du multilinguisme."
                                            }
                                        ]
