                {
                    "sense_id": "cf10683d-1502-3b76-8cd8-cb7ee523be5e",
                    "sense_definition": "zo onzinnig of slecht dat het bespottelijk is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bespottelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is <w>lachwekkend</w> dat hij denkt dit probleem zonder hulp op te lossen.",
                            "target_lang_translations": {
                                "en": "It is <w>ridiculous</w> that he thinks he can solve this problem without help.",
                                "de": "Es ist <w>lächerlich</w>, dass er glaubt, dieses Problem ohne Hilfe lösen zu können."
                            }
                        },
                        {
                            "text": "Zijn excuses voor het te laat komen waren werkelijk <w>lachwekkend</w>.",
                            "target_lang_translations": {
                                "en": "His excuses for being late were truly <w>laughable</w>.",
                                "de": "Seine Ausreden für das Zuspätkommen waren wirklich <w>lachhaft</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "belachelijk",
                        "bespottelijk"
                    ],
                    "antonyms": [
                        "indrukwekkend",
                        "geloofwaardig"
                    ],
                    "common_phrases": [
                        "werkelijk lachwekkend",
                        "lachwekkend voorstel"
                    ],
                    "target_lang_definitions": {
                        "en": "so nonsensical or bad that it is ridiculous or pathetic",
                        "de": "so unsinnig oder schlecht, dass es lächerlich ist"
                    },
                    "translations": {
