                "senses": [
                    {
                        "sense_id": "71aab147-56e3-3da7-a559-9b527a052f9b",
                        "entry_id": "e2b6aa83-85e0-3d99-9da5-5bac764e9b8d",
                        "glosses": [
                            "explosive ordnance disposal specialist"
                        ],
                        "tags": [
                            "animate"
                        ],
                        "examples": [
                            {
                                "example_id": "3c9ae2b9-eaed-41eb-aa79-d71bf0bc9315",
                                "sense_id": "71aab147-56e3-3da7-a559-9b527a052f9b",
                                "text": "Как правило, взрывные механизмы имеют часовой механизм. Для поисковиков самым главным является слух.",
                                "translation": "Generally, explosive devices have a clock mechanism. For EOD specialists the most important thing is good hearing.",
                                "english": "Generally, explosive devices have a clock mechanism. For EOD specialists the most important thing is good hearing."
                            }
                        ]
                    },
                    {
                        "sense_id": "abf24407-ce01-3c5d-88cd-b02dea4b2269",
                        "entry_id": "e2b6aa83-85e0-3d99-9da5-5bac764e9b8d",
                        "glosses": [
                            "mining geologist"
                        ],
                        "tags": [
                            "animate"
                        ],
                        "examples": [
                            {
                                "example_id": "42bbc1fb-d122-49b2-b54e-011476db9a2f",
                                "sense_id": "abf24407-ce01-3c5d-88cd-b02dea4b2269",
                                "text": "Впоследствии его полусъеденные останки были обнаружены группой поисковиков, производивших разведку полезных ископаемых в этом районе.",
                                "translation": "His half-eaten remains were subsequently uncovered by a group of geologists who were prospecting for minerals in the area.",
                                "english": "His half-eaten remains were subsequently uncovered by a group of geologists who were prospecting for minerals in the area."
                            }
                        ]
