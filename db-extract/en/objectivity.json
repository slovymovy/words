                                "target_senses": [
                                    {
                                        "sense_id": "632aec8a-44df-369b-aa30-309714d4ce0b",
                                        "entry_id": "ceea65e3-d31a-3859-92da-275f34d131a0",
                                        "glosses": [
                                            "op feiten gericht en gebaseerd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffabe27a-5e79-41b8-98e2-03368ea8efe2",
                                                "sense_id": "632aec8a-44df-369b-aa30-309714d4ce0b",
                                                "text": "De journalist probeerde de objectiviteit niet te verliezen toen hij verslag deed van de aanval op zijn stad."
                                            },
                                            {
                                                "example_id": "50d37723-3e0f-4af2-b679-280bf24fae64",
                                                "sense_id": "632aec8a-44df-369b-aa30-309714d4ce0b",
                                                "text": "Een rechter die op de een of andere manier bij de zaak is betrokken mag niet rechtspreken in die zaak, omdat dan zijn objectiviteit in twijfel getrokken kan worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22fbee2f-21eb-41e2-b550-49a3b4a71cee",
                        "source_entry_id": "9c342d15-449c-3de6-b427-572aefa552f5",
                        "source_sense_description": "The state of being objective",
                        "target_lang_word": "zakelijkheid",
