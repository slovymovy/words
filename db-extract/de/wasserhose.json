                "senses": [
                    {
                        "sense_id": "eb322df5-ffb4-34f1-a207-22cae6946785",
                        "entry_id": "f7a62bc5-4fc9-30ea-9281-535640535bbc",
                        "glosses": [
                            "Tornado (Windhose) auf dem Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9abb208-32bf-43e3-ab33-ea546ce8d9e7",
                                "sense_id": "eb322df5-ffb4-34f1-a207-22cae6946785",
                                "text": "Hast du diese Wasserhose gesehen?"
                            },
                            {
                                "example_id": "c4f9ac36-c393-4c00-8ece-57b0db80bbd2",
                                "sense_id": "eb322df5-ffb4-34f1-a207-22cae6946785",
                                "text": "„Einer dieser Lösungsvorschläge meinte, das Schiff sei von einer Wasserhose heimgesucht worden.“"
                            },
                            {
                                "example_id": "f9d38845-c5ed-4538-a431-2587fbcbdd29",
                                "sense_id": "eb322df5-ffb4-34f1-a207-22cae6946785",
                                "text": "„Im nächsten Moment stürzten die Siedler ans Fenster und sahen, wie die Brigg in einer Wasserhose in die Höhe schoß, herunterbrach und innerhalb von 10 sec mit Mann und Maus in den Fluten versank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49874a68-caef-4d11-8eb1-e43cb7fecd1e",
                        "source_entry_id": "f7a62bc5-4fc9-30ea-9281-535640535bbc",
                        "source_sense_id": "eb322df5-ffb4-34f1-a207-22cae6946785",
                        "source_sense_description": "Tornado (Windhose) auf dem Wasser",
                        "target_lang_word": "waterspout",
