                "senses": [
                    {
                        "sense_id": "b332ba5b-0bf0-359c-8af0-065b4e331bd7",
                        "entry_id": "cfc0de7d-33f0-37b6-a971-d0f7ecca3d75",
                        "glosses": [
                            "Anhängerin des Wiccatums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5c6a261-e53b-4a1e-8958-11aebce8b07d",
                                "sense_id": "b332ba5b-0bf0-359c-8af0-065b4e331bd7",
                                "text": "„Dies empfehle ich, wenn Sie Wiccanerin/Wiccaner werden wollen.“"
                            },
                            {
                                "example_id": "67af1fc5-10ec-4dc5-88ca-18c38ea62158",
                                "sense_id": "b332ba5b-0bf0-359c-8af0-065b4e331bd7",
                                "text": "„Ich bin keine Wiccanerin, falls Sie das meinen, aber ich habe Freunde, die es sind.“"
                            },
                            {
                                "example_id": "75a128c4-b991-4ee2-82a6-396c0ebd8af7",
                                "sense_id": "b332ba5b-0bf0-359c-8af0-065b4e331bd7",
                                "text": "„Hexen sollten Wiccanerinnen respektieren, auch wenn wir diese ganze Sache mit der Göttinnenanbetung nie so ganz begriffen haben.“"
                            },
                            {
                                "example_id": "da7983a0-aca0-46fa-844c-b244df605b54",
                                "sense_id": "b332ba5b-0bf0-359c-8af0-065b4e331bd7",
                                "text": "„In der Nacht zuvor waren sie zu dem Farmhaus gefahren, das den beiden Wiccanerinnen gehörte.“"
                            },
                            {
                                "example_id": "ca4f6051-a74c-47cd-981d-25d484c2d81b",
                                "sense_id": "b332ba5b-0bf0-359c-8af0-065b4e331bd7",
                                "text": "„Meine Schwester ist Wiccanerin, wie sie in den Nachrichten gesagt haben, und hilft ehrenamtlich im Gefängnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
