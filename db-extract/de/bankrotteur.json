                                        "entry_id": "f5a24737-73f7-3b22-86a3-8a8fc8631c0d",
                                        "glosses": [
                                            "In a condition of bankruptcy; unable to pay outstanding debts or meet financial obligations; specifically, having been legally declared insolvent."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b4103fc-8d85-4ea3-8acf-15308b98c7cb",
                                                "sense_id": "f55ec56d-a2d8-39eb-90a4-2663901b89b8",
                                                "text": "a bankrupt merchant"
                                            },
                                            {
                                                "example_id": "9523b7b3-eb8d-441d-833f-7f5c8e063035",
                                                "sense_id": "f55ec56d-a2d8-39eb-90a4-2663901b89b8",
                                                "text": "\"How did you go bankrupt?\" Bill asked. \"Two ways,\" Mike said. \"Gradually and then suddenly.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4aaea6c-0a58-3d02-a1cf-b485fd87b0e9",
                                        "entry_id": "f5a24737-73f7-3b22-86a3-8a8fc8631c0d",
                                        "glosses": [
                                            "Destitute of, or wholly lacking a good quality, value, etc. one should possess or once possessed."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a730022-e62e-4de9-b73a-c921ccfea12b",
                                                "sense_id": "d4aaea6c-0a58-3d02-a1cf-b485fd87b0e9",
                                                "text": "a morally bankrupt politician"
                                            },
                                            {
                                                "example_id": "4cee4930-db13-4814-823e-1a2c55518d19",
                                                "sense_id": "d4aaea6c-0a58-3d02-a1cf-b485fd87b0e9",
                                                "text": "O Julia! I am bankrupt in gratitude! but the time is ſo preſſing, it calls on you for ſo haſty a reſolution."
                                            }
                                        ]
                                    }
                                ]
                            },
