                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69c341b1-4788-4d9d-b450-744fe93b0ee2",
                                "sense_id": "0d0cf552-5f5b-377e-8fa3-3aafca26bd3d",
                                "text": "„Ein einfacher Raketeneinschlag hätte niemals eine solche Erschütterung bei einer Station dieser Größenordnung hervorgerufen.“"
                            },
                            {
                                "example_id": "40b4b64b-228e-4a52-9c22-acbe90e33e30",
                                "sense_id": "0d0cf552-5f5b-377e-8fa3-3aafca26bd3d",
                                "text": "„Dreißig Sekunden nach dem ersten Raketeneinschlag stürzte ihr Nachfolger hinab, und diesmal gab es keine Steinmauer mehr, die am Vorwärtskommen hätte hindern können.“"
                            },
                            {
                                "example_id": "ff41c3e2-a627-48af-85e9-f5ff00728c76",
                                "sense_id": "0d0cf552-5f5b-377e-8fa3-3aafca26bd3d",
                                "text": "„Auch hier hatte der Raketeneinschlag für Verwüstung gesorgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
