                                        "glosses": [
                                            "Petite ouverture située au sommet du limaçon de l'oreille interne, et établissant une communication entre les deux rampes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce13b9eb-4ee7-4766-b672-21b131d85d08",
                                                "sense_id": "f02a4bc2-2b88-3244-8f9f-e5b68e7c4189",
                                                "text": "Là, par un petit orifice, l’hélicotrème, il se continue dans la rampe tympanique."
                                            }
                                        ]
