                "senses": [
                    {
                        "sense_id": "69663d27-21bc-3ce0-9840-1776448dee89",
                        "entry_id": "46fbdce3-7c69-3efa-a64a-8b7b57ce96f9",
                        "glosses": [
                            "Tank, der zum Tauchen geflutet und zum Auftauchen entleert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "192a8451-0755-4c86-9c6b-73b5799ad0da",
                                "sense_id": "69663d27-21bc-3ce0-9840-1776448dee89",
                                "text": "„Beim Auftauchen werden die Tauchtanks durch Preßluft angeblasen.“"
                            },
                            {
                                "example_id": "2bccfdc2-41c3-4707-a9ad-d75ebffded87",
                                "sense_id": "69663d27-21bc-3ce0-9840-1776448dee89",
                                "text": "„Ich höre, wie die Luft, die dem Boot Auftrieb gegeben hat, mit zischenden, donnernden Geräuschen vor dem von unten in die Tauchtanks einströmenden Wasser entweicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
