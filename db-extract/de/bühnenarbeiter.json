                "senses": [
                    {
                        "sense_id": "541858b8-8a7b-3bfb-ad0b-a6189f6b36af",
                        "entry_id": "08b325ff-518a-3455-8668-c56fc3e0cd07",
                        "glosses": [
                            "jemand, der in einer Oper, einem Theater oder dergleichen an der Bühne arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f95f8820-0255-4dd0-b359-12a0096af67d",
                                "sense_id": "541858b8-8a7b-3bfb-ad0b-a6189f6b36af",
                                "text": "„Ich kannte einen Bühnenarbeiter, der einmal von einem Berliner beim Militär betrogen worden war und seitdem jeden Berliner und jede Berlinerin wie persönliche Feinde behandelte.“"
                            },
                            {
                                "example_id": "3abaa9be-2fb9-4cc3-b801-de13aa6d319a",
                                "sense_id": "541858b8-8a7b-3bfb-ad0b-a6189f6b36af",
                                "text": "„Er beschlagnahmte das unbenutzte Dach eines alten Bürogebäudes und richtete es mit Hilfe einiger Bühnenarbeiter und Theatertechniker – indem er einiges Material verwendete, das er, wahrscheinlich nach der Methode eines Zauberkünstlers, selbst beschaffen mußte – zu mehreren Zimmern her, die als ziemlich angenehme Büros zu benutzen waren.“"
                            },
                            {
                                "example_id": "d0ac8ff6-a52f-46eb-a9c1-1808dac538d4",
                                "sense_id": "541858b8-8a7b-3bfb-ad0b-a6189f6b36af",
                                "text": "„Hamann schleicht nach Hause, tritt beinahe auf der Stelle, als müßten die Straßenkulissen von Bühnenarbeitern geschoben werden, damit er vorankommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
