                        "glosses": [
                            "de kleur zeegroen hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0185a7f-fe30-455a-b31f-57dd63266ebe",
                                "sense_id": "421606ff-d29e-3c8e-b032-1c891a75bf67",
                                "text": "Hij rijdt in een zeegroene auto."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9046a0b8-c815-4e5d-9480-a5d281864ad5",
                        "source_entry_id": "b86cfda2-7dcd-3c7c-9d0d-5bc3eab806f8",
                        "source_sense_id": "421606ff-d29e-3c8e-b032-1c891a75bf67",
                        "source_sense_description": "blauwachtig groen, kleur van de zee",
                        "target_lang_word": "meergrün",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meergrün",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47bfc7e9-f220-31d2-9847-a9dc4300a125",
                                        "entry_id": "36a18fb4-fcdc-33aa-b41d-2e045b926fce",
                                        "glosses": [
                                            "in einem Grünton, der an das Meer erinnert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebbd8cca-20c7-4314-b11a-677e8ff5eaa0",
                                                "sense_id": "47bfc7e9-f220-31d2-9847-a9dc4300a125",
                                                "text": "„So blieb von der uralten Stadt Ib nichts übrig außer jenem meergrünen Götzenbild aus Stein, das nach dem Bilde des Bokrug, der Wasserechse, gefertigt war.“"
                                            },
                                            {
                                                "example_id": "e560a7e4-0e9b-4e4c-a9a8-8f936441c15a",
                                                "sense_id": "47bfc7e9-f220-31d2-9847-a9dc4300a125",
                                                "text": "„Ich benötigte eine Auskunftsperson, die schon lange hier lebte und die mich über die Einstellung der Mirocawer zu ihrer meergrünen Illuminationszeit erhellen konnte.“"
                                            },
                                            {
                                                "example_id": "6e7db945-195a-4a34-b513-73b2e0a2f9dc",
                                                "sense_id": "47bfc7e9-f220-31d2-9847-a9dc4300a125",
                                                "text": "„Sie trugen weiße Laborkittel und meergrüne OP-Overalls und verschränkten die Hände auf dem Rücken.“"
                                            },
                                            {
                                                "example_id": "4c10600d-f7bd-4cdb-ab70-e569b4299353",
                                                "sense_id": "47bfc7e9-f220-31d2-9847-a9dc4300a125",
                                                "text": "„Sie ritten an der Kirche vorüber; vom Alter schon meergrüne spanische Glocken hingen an einer Stange zwischen niedrigen Lehmdolmen.“"
                                            },
                                            {
                                                "example_id": "4d0b9bbc-0dd8-48cf-af72-d9d9cc1c49be",
                                                "sense_id": "47bfc7e9-f220-31d2-9847-a9dc4300a125",
                                                "text": "„Fahren Sie langsam und halten Sie Ausschau nach einem schrecklichen Unfall auf der linken Fahrspur, an dem zwei Fahrzeuge beteiligt sind. Das vordere ist ein meergrüner 74er Plymouth Road Runner mit Vierzylinder-Vergaser-Siebenliter-Graugussblock-V8-Motor.“"
                                            },
                                            {
                                                "example_id": "5f839444-5cdf-43f9-a690-f568abdd27e9",
                                                "sense_id": "47bfc7e9-f220-31d2-9847-a9dc4300a125",
                                                "text": "„Sie trug eine Jeans und eine meergrüne Bluse in der Farbe ihrer Augen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
