                "senses": [
                    {
                        "sense_id": "570e1ef9-6dd1-36b4-b37f-b6ddfeb24ecc",
                        "entry_id": "194e933b-9cf5-3f72-ac37-c942e3bf359e",
                        "glosses": [
                            "Faire en sorte de ne plus avoir entendu ce qu’on a entendu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b15a7cb-d3aa-4f15-bc6e-005839593ac6",
                                "sense_id": "570e1ef9-6dd1-36b4-b37f-b6ddfeb24ecc",
                                "text": "Mais comment savoir ce que c’était et comment désentendre ce que j’avais entendu ?"
                            },
                            {
                                "example_id": "e243d9bd-aebe-4dae-9f87-2f179f30a4f5",
                                "sense_id": "570e1ef9-6dd1-36b4-b37f-b6ddfeb24ecc",
                                "text": "Il n’est pas au pouvoir d’Anna et d’Henrik de désentendre les mots terribles qu’ils ont échangés."
                            },
                            {
                                "example_id": "ccbf6a59-f4f1-477a-9316-3a6af7738106",
                                "sense_id": "570e1ef9-6dd1-36b4-b37f-b6ddfeb24ecc",
                                "text": "Ce qui est triste à mes yeux c’est que vous ne pouvez pas \"désentendre\" les choses, et vous n’avez qu’une seule première impression."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6e71511-53bf-3f5d-8d55-07c3572851e8",
                        "entry_id": "194e933b-9cf5-3f72-ac37-c942e3bf359e",
                        "glosses": [
                            "Ignorer ou feindre de ne pas avoir entendu une information."
                        ],
                        "tags": [],
                        "examples": [
