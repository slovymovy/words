                "senses": [
                    {
                        "sense_id": "2ee33248-b185-3bf5-95f9-32566b7520e4",
                        "entry_id": "ac17476d-5762-3fcd-9e05-443e6a7c2fa8",
                        "glosses": [
                            "to be drained of, to shed a lot of (blood, tears, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77bc6db6-8ceb-4282-b45e-f176048816c2",
                                "sense_id": "2ee33248-b185-3bf5-95f9-32566b7520e4",
                                "text": "изойти́ кро́вью",
                                "translation": "to become weak through loss of blood",
                                "english": "to become weak through loss of blood"
                            },
                            {
                                "example_id": "00c2a3b5-d935-46e0-9ac8-f235b2b99a76",
                                "sense_id": "2ee33248-b185-3bf5-95f9-32566b7520e4",
                                "text": "изойти́ слеза́ми",
                                "translation": "to cry one's heart out",
                                "english": "to cry one's heart out"
                            }
                        ]
                    },
                    {
                        "sense_id": "44a5709b-6e3b-368d-aa7c-69c42d6a22d1",
                        "entry_id": "ac17476d-5762-3fcd-9e05-443e6a7c2fa8",
                        "glosses": [
                            "to expire, to come to an end"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "44e415dc-1699-4ac3-b785-0b5b44a24477",
                                "sense_id": "44a5709b-6e3b-368d-aa7c-69c42d6a22d1",
                                "text": "Всё ча́янное помире́ние с ни́ми изошло́.",
                                "translation": "All the hoped-for reconciliation with them came to an end.",
                                "english": "All the hoped-for reconciliation with them came to an end."
                            }
                        ]
                    }
