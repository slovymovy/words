                                "target_senses": [
                                    {
                                        "sense_id": "9e0c0cb4-05da-3f60-8164-26ddb0f4ce1f",
                                        "entry_id": "9129b0f6-42ee-3538-8ddb-e02a312c1125",
                                        "glosses": [
                                            "Regretful or apologetic for one's actions."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afca543f-37e0-4bc5-8501-d82968a4a599",
                                                "sense_id": "9e0c0cb4-05da-3f60-8164-26ddb0f4ce1f",
                                                "text": "I am sorry I stepped on your toes. It was an accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1d58d7d-4088-30aa-a4b9-12eecc196792",
                                        "entry_id": "9129b0f6-42ee-3538-8ddb-e02a312c1125",
                                        "glosses": [
                                            "Grieved or saddened, especially by the loss of something or someone."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "958b11ee-434a-4fca-be29-09931cd6d8e2",
                                                "sense_id": "d1d58d7d-4088-30aa-a4b9-12eecc196792",
                                                "text": "I feel sorry for you, about your exam results."
                                            },
                                            {
                                                "example_id": "63c58e92-38c0-43ae-9a43-7439fac414f7",
                                                "sense_id": "d1d58d7d-4088-30aa-a4b9-12eecc196792",
                                                "text": "The President was sorry to hear that the Ambassador was leaving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb1a9f5d-9d08-3254-8032-df106a8197e1",
                                        "entry_id": "9129b0f6-42ee-3538-8ddb-e02a312c1125",
                                        "glosses": [
                                            "Poor, pitifully sad or regrettable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2efdd7c2-8263-4632-91f4-cbd35bfdba15",
                                                "sense_id": "bb1a9f5d-9d08-3254-8032-df106a8197e1",
                                                "text": "The storm left his garden in a sorry state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ed21f2b-e9c2-34f3-849f-5ea408c4918d",
                                        "entry_id": "9129b0f6-42ee-3538-8ddb-e02a312c1125",
                                        "glosses": [
                                            "Pathetic; contemptibly inadequate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277a5a6c-e8c7-44c0-8c9a-9a2760ec103d",
                                                "sense_id": "1ed21f2b-e9c2-34f3-849f-5ea408c4918d",
                                                "text": "Bob is a sorry excuse for a football player."
                                            },
                                            {
                                                "example_id": "29f9d417-27ec-4d92-881a-399a7cb29073",
                                                "sense_id": "1ed21f2b-e9c2-34f3-849f-5ea408c4918d",
                                                "text": "The sorry experience did little to suggest that Musk knows how to run a social media platform or that DeSantis is capable of governing a global superpower armed with nuclear weapons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sorry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1579098e-c6b7-37eb-b459-04bf0dcefdbc",
                                        "entry_id": "185f59f9-5c41-38ab-91f1-3350a186662f",
                                        "glosses": [
                                            "Expresses regret, remorse, or sorrow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f3d6cb8-13a6-4bcf-9538-2c5a9df02137",
                                                "sense_id": "1579098e-c6b7-37eb-b459-04bf0dcefdbc",
                                                "text": "Sorry! I didn't see that you were on the phone."
                                            },
                                            {
                                                "example_id": "24b76aff-c9ee-4fec-96e6-ea7a4a2309cf",
                                                "sense_id": "1579098e-c6b7-37eb-b459-04bf0dcefdbc",
                                                "text": "Sorry about yesterday. — No worries."
                                            },
                                            {
                                                "example_id": "4c0617e5-dad7-4556-95f3-82c17ba57bf7",
                                                "sense_id": "1579098e-c6b7-37eb-b459-04bf0dcefdbc",
                                                "text": "Sorry I’m so late."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b769f8d0-fe6e-3e1f-907b-5536bd1c1136",
                                        "entry_id": "185f59f9-5c41-38ab-91f1-3350a186662f",
                                        "glosses": [
                                            "Said as a request to excuse one's unintentional behaviors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fb6eed-2288-4bfa-9acb-1391db60c915",
                                                "sense_id": "b769f8d0-fe6e-3e1f-907b-5536bd1c1136",
                                                "text": "Oops! Sorry!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db84c1af-53fd-35d4-b546-e7523271f1bf",
                                        "entry_id": "185f59f9-5c41-38ab-91f1-3350a186662f",
                                        "glosses": [
                                            "Said as a request to pass somebody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674c565c-e585-489d-8ecc-e1ab381da445",
                                                "sense_id": "db84c1af-53fd-35d4-b546-e7523271f1bf",
                                                "text": "Sorry! Coming through!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "925001ce-c8ea-32ae-adf1-63edc469557f",
                                        "entry_id": "185f59f9-5c41-38ab-91f1-3350a186662f",
                                        "glosses": [
                                            "Used as a request for someone to repeat something not heard or understood clearly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84c334d6-1cb7-4570-9668-5e365bc924f9",
                                                "sense_id": "925001ce-c8ea-32ae-adf1-63edc469557f",
                                                "text": "Sorry? What was that? The phone cut out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "213d74e8-eb53-3ca5-918b-732295275558",
                                        "entry_id": "185f59f9-5c41-38ab-91f1-3350a186662f",
                                        "glosses": [
                                            "Used to correct oneself in speech."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7bd39a2-2b21-429a-ba51-e34c391bb50f",
                                                "sense_id": "213d74e8-eb53-3ca5-918b-732295275558",
                                                "text": "There are four—sorry, five—local branches of the store."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "426fef70-7969-3ead-a829-13220e4994de",
                                        "entry_id": "185f59f9-5c41-38ab-91f1-3350a186662f",
                                        "glosses": [
                                            "Used as a hedge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f52bad26-f0c4-4fde-9614-ba0bfe51f9be",
                                                "sense_id": "426fef70-7969-3ead-a829-13220e4994de",
                                                "text": "Sorry, but I don't care what you think."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sorry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcda927c-b1d5-3ddf-87fd-a2eaf0bef434",
                                        "entry_id": "0aa14e84-44b1-3b45-8d17-5a324131f47a",
                                        "glosses": [
                                            "The act of saying sorry; an apology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6ecbd18-b830-4d1d-a851-6231653da9a2",
                                                "sense_id": "dcda927c-b1d5-3ddf-87fd-a2eaf0bef434",
                                                "text": "The British would do it standing stock still, Latinos would dance their sorries, and Canadians would find a way to apologize on ice."
                                            },
                                            {
                                                "example_id": "162a67db-91b2-447c-b49a-221ae28366ae",
                                                "sense_id": "dcda927c-b1d5-3ddf-87fd-a2eaf0bef434",
                                                "text": "So learn how to tailor your sorries to the sexes. Women tend to want an acknowledgment of what they're going through..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sorry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e16802b9-b552-3290-9ee1-9c43547db410",
                                        "entry_id": "1896390d-b140-3a81-a50a-c47149ff1689",
                                        "glosses": [
                                            "To feel sorry (for someone)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc56eb9-a6a7-4516-bc92-31e0e0724cfb",
                                                "sense_id": "e16802b9-b552-3290-9ee1-9c43547db410",
                                                "text": "Jus' that once I sorried for her. Souls cross the skies o' time, Abbess'd say, like clouds crossin' skies o' the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
