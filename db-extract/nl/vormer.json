                                    },
                                    {
                                        "sense_id": "c1e87cdd-bc89-3a9c-9241-c785ffefccdb",
                                        "entry_id": "77c301d8-bab6-363e-a0b7-80adf9c86e9e",
                                        "glosses": [
                                            "Synonym of mould (“loose, friable soil”); also, dust."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87f027a4-669a-4c24-b970-6664c80bb19e",
                                                "sense_id": "c1e87cdd-bc89-3a9c-9241-c785ffefccdb",
                                                "text": "[B]y the ſenſe of our ayrie bodies we haue a more refined faculty of forſeeing, than men poſſibly can haue, that are chained to ſuch heauie earthlie moulder; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moulder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed43f505-d50f-3282-a221-0870b54ee777",
                                        "entry_id": "3fa787df-e6d2-3ea3-ad24-bf96345341bc",
                                        "glosses": [
                                            "Synonym of mould (“a natural substance in the form of a furry or woolly growth of tiny fungi that appears when organic material lies for a long time exposed to (usually warm and moist) air”)"
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "184baa50-8fcf-45a9-b35b-a3f2df27f26f",
                                                "sense_id": "ed43f505-d50f-3282-a221-0870b54ee777",
                                                "text": "[G]reat danger is to be apprehended to the health of the crews, and damage to the provisions and stores on board, from the damp state in which such ships must be in, for a long time after being taken out of the water. Houses, built with stone or mortar, saturated with salt-water, will continue damp for years; and, without almost constant fires, furniture, linen, silks, &c. &c. will be continually damaging, from moulder, rust, and mildew."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
