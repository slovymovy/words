                        "entry_id": "b6b127ec-6af0-33da-8265-8c20433824df",
                        "glosses": [
                            "Se dit d’un matériau, ou de la frontière d’un système thermodynamique, perméable à la chaleur si celle-ci est transmise par rayonnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3de79f1-9356-4723-a533-328e28e1811b",
                                "sense_id": "d544ff8d-001b-30e7-9e3f-dc16a4fb180d",
                                "text": "La quantité de chaleur qui traverse un écran diathermane décroit quand l’épaisseur augmente : mais l’absorption n’est pas proportionnelle à l’épaisseur."
                            }
                        ]
                    }
                ],
