                "senses": [
                    {
                        "sense_id": "ac52d9c4-ffe5-3883-811a-da16731cbca4",
                        "entry_id": "4685fb5d-f11a-3cde-b72d-c166fbf757f0",
                        "glosses": [
                            "ehemaliger Quästor"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7753cb50-28ac-4792-b221-628c6e9fbbff",
                                "sense_id": "ac52d9c4-ffe5-3883-811a-da16731cbca4",
                                "text": "„Das andere Herrschaftsorgan war der Senat. Vom Jahr 80 v.Chr. an setzte er sich aus allen ehemaligen Magistraten vom Quästorier (gewesener Quästor) aufwärts zusammen und umfasste etwa 600 Mitglieder.“"
                            },
                            {
                                "example_id": "33f1aef6-4667-4998-8af0-b42138ae9667",
                                "sense_id": "ac52d9c4-ffe5-3883-811a-da16731cbca4",
                                "text": "„An dem Grundsatze aber, daß die Quästorier ein Anrecht auf Aufnahme in den Senat hätten, rüttelten sie so wenig wie ihre Nachfolger.“"
                            },
                            {
                                "example_id": "8db309e2-b87b-4963-84b2-32984eb3533f",
                                "sense_id": "ac52d9c4-ffe5-3883-811a-da16731cbca4",
                                "text": "„Daß jüngere Legaten immerhin Quästorier waren, ist in zahlreichen Fällen entweder direkt bezeugt oder aus dem geringen zeitlichen Abstand ersichtlich, in dem der Legation höhere Ämter folgten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
