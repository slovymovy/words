                    {
                        "translation_id": "74d5f4c0-f6f7-4627-8a09-9239b880c243",
                        "source_entry_id": "6225ff61-fa32-3626-b60b-4e02ab9bffb3",
                        "source_sense_id": "f4f25242-1fee-3b00-81b7-0e55f764d2c0",
                        "target_lang_word": "addressee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "addressee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bde7662c-ecb6-38d9-b9ef-3f50d4683dfd",
                                        "entry_id": "9eb544c8-d0e7-379a-a30e-4b62354d29c3",
                                        "glosses": [
                                            "The person or organization to which something, such as a letter or message, is addressed or sent, for whom the item is intended."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e30689cd-ac61-3d7a-846a-576f22fd189f",
                                        "entry_id": "9eb544c8-d0e7-379a-a30e-4b62354d29c3",
                                        "glosses": [
                                            "A person or entity to whom discourse is directed, or the words referring to such an entity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1afc6a-14fe-4305-964b-3c0124e2d1c7",
                                                "sense_id": "e30689cd-ac61-3d7a-846a-576f22fd189f",
                                                "text": "Person is a grammatical property which is overtly manifested in so-called Personal Pronouns: forms which include the speaker (I/we) are said to be ‘first personʼ Pronouns; forms which include the addressee (you) and not the speaker are said to be ‘second personʼ Pronouns; while forms which exclude both speaker and addressee (he/she/it/they) are ‘third personʼ Pronouns."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b17a490-484a-4e68-882b-3fad68af1ab0",
                        "source_entry_id": "6225ff61-fa32-3626-b60b-4e02ab9bffb3",
                        "source_sense_id": "f4f25242-1fee-3b00-81b7-0e55f764d2c0",
                        "target_lang_word": "Empfänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empfänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                        "entry_id": "57c9d099-d87e-3969-9945-0afed7766f35",
                                        "glosses": [
                                            "Person, die etwas empfängt, bekommt, erhält, entgegennimmt; jemand, der etwas in Empfang nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f34f6999-3493-49cc-896f-71d36a69d963",
                                                "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                                "text": "Der Empfänger des Briefes muss für den unfrankierten Brief Strafporto zahlen."
                                            },
                                            {
                                                "example_id": "5b5839da-4df0-4d5e-a859-dbfa6ac7b91f",
                                                "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                                "text": "„Es ist undenkbar, daß sich in einem solchen Augenblick der Empfänger einer Wohltat nicht ebenfalls entschlossen fühlt, alles in seinen Kräften Stehende zu tun, um den zu beglücken, der so bereitwillig zu seinem Glück beigetragen hat.“"
                                            },
                                            {
                                                "example_id": "c7c3af37-6467-4c01-96a9-7ba64ff5b5da",
                                                "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                                "text": "„Empfänger seiner Mitteilung ist Johannes Kagelmacher, Bauer aus Guderitz auf Rügen, bei dem er in seiner Zeit als Drogenabhängiger oft untergekrochen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "315ca416-df38-316b-9097-4780aaa4a42b",
                                        "entry_id": "57c9d099-d87e-3969-9945-0afed7766f35",
                                        "glosses": [
                                            "Gerät, das Signale empfängt"
                                        ],
                                        "tags": [
                                            "Funktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69cf1cef-c31c-4f53-ba67-0fe0a089d52b",
                                                "sense_id": "315ca416-df38-316b-9097-4780aaa4a42b",
                                                "text": "Der Empfänger ist defekt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
