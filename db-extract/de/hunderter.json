                                                "sense_id": "c03ee5b8-9968-390a-931d-f989e41e78ab",
                                                "text": "Tetřev sáhl opatrně do náprsní kapsy, vyňal odtud odřenou honáckou tobolku, rozložil ji a Tetřevka spatřila na dlani mužově — čtyry stovky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72d57703-0d00-3f92-976b-e999e25a7935",
                                        "entry_id": "3f34d251-28a7-39e0-a990-632419a7ded2",
                                        "glosses": [
                                            "množství odpovídající 100 kusů nebo jednotek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb71d506-980b-4ca4-8cf8-a5900a877257",
                                                "sense_id": "72d57703-0d00-3f92-976b-e999e25a7935",
                                                "text": "balení po stovkách",
                                                "translation": "po sto kusech"
                                            },
                                            {
                                                "example_id": "acec2a59-9248-439b-9386-25a34cbd41bf",
                                                "sense_id": "72d57703-0d00-3f92-976b-e999e25a7935",
                                                "text": "dožít se stovky",
                                                "translation": "100 let"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "856ff23a-7fc0-3854-814c-507771560010",
                                        "entry_id": "3f34d251-28a7-39e0-a990-632419a7ded2",
                                        "glosses": [
                                            "rychlost 100 km/h"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d57b399b-9cdd-4329-ba37-3ee14e3b72c9",
                                                "sense_id": "856ff23a-7fc0-3854-814c-507771560010",
                                                "text": "Jede postarší blondýna autem a zastaví ji policajt: „Paní, vy jste překročila stovku...“ Blondýnka namítá: „Ale neblázněte, tak staře vypadám jen v tom klobouku.“"
                                            },
                                            {
                                                "example_id": "9ff4c8c5-f438-4c02-a80e-a9fa30785601",
                                                "sense_id": "856ff23a-7fc0-3854-814c-507771560010",
                                                "text": "Mimo obec jel stovkou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a6c34be-ff22-3569-9359-932d7751eff5",
                                        "entry_id": "3f34d251-28a7-39e0-a990-632419a7ded2",
                                        "glosses": [
