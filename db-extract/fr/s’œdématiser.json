                "senses": [
                    {
                        "sense_id": "2cc97b24-737c-36b3-a85a-68e0c361eafe",
                        "entry_id": "715a598e-e16c-3e78-bfd3-524f68ed826d",
                        "glosses": [
                            "Prendre un caractère œdémateux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7e5ed11-f1ab-48c0-a56c-e2da8e08333f",
                                "sense_id": "2cc97b24-737c-36b3-a85a-68e0c361eafe",
                                "text": "L’oppression faisait des progrès ; il survint de l’enflure aux extrémités inférieures, et les mains commençaient aussi à s’œdématiser."
                            },
                            {
                                "example_id": "c9b52eef-ca00-4dd0-80e3-b72ce9e3b107",
                                "sense_id": "2cc97b24-737c-36b3-a85a-68e0c361eafe",
                                "text": "Aussi voit-on presque toujours les membres couverts de varices s’œdématiser d’abord, puis s’infiltrer, et enfin s’atrophier sans indice d’affection autre que le trouble de leur circulation."
                            }
                        ]
                    }
