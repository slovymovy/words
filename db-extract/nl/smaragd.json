                "senses": [
                    {
                        "sense_id": "be0bf7ce-9381-3d7c-b7d2-caeaf65a3a62",
                        "entry_id": "fd1438c0-dad1-3671-9119-3fbba5b6d3c3",
                        "glosses": [
                            "een variëteit van beril die geldt als de edelste steen uit de berylgroep met chemische formule Be3Al2(SiO3)6,"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "661119b5-c897-3525-bc58-62f78969521d",
                        "entry_id": "fd1438c0-dad1-3671-9119-3fbba5b6d3c3",
                        "glosses": [
                            "een edelsteen bestaande uit het mineraal [1]"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "b0456470-0b8c-4a6f-9879-cef01a0e13f5",
                                "sense_id": "661119b5-c897-3525-bc58-62f78969521d",
                                "text": "Het was een halsketting met afwisselend grote smaragden en kleine sterrenformaties van briljanten, allemaal fonkelend alsof ze nieuw waren, hoewel het sieraad uit de vroege negentiende eeuw moest komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d30d9d20-8df4-41c5-9b93-254fcf85adbd",
                        "source_entry_id": "fd1438c0-dad1-3671-9119-3fbba5b6d3c3",
                        "target_lang_word": "Smaragd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Smaragd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9735e0ee-72ac-3867-bf2d-b63fcfe65a3e",
                                        "entry_id": "e05cf500-e762-3131-889d-8651c63c6972",
                                        "glosses": [
                                            "wertvoller, grüner Edelstein, eine Varietät des Minerals Beryll"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2c8c5a0-93e4-4b5f-9881-ddfeeaca6481",
                                                "sense_id": "9735e0ee-72ac-3867-bf2d-b63fcfe65a3e",
                                                "text": "„In die Hand gab ihm der Zepterverwahrer den über mannslangen goldnen Herrscherstab, der oben die Weltkugel aus einem einzigen Smaragd und darauf das Goldkreuz trug.“"
                                            },
                                            {
                                                "example_id": "6a4ad61e-645d-4706-b04e-adfe896ae8a7",
                                                "sense_id": "9735e0ee-72ac-3867-bf2d-b63fcfe65a3e",
                                                "text": "„Denn wenn der Smaragd durch seine herrliche Farbe dem Gesicht wohltut, ja sogar einige Heilkraft an diesem edlen Sinn ausübt, so wirkt die menschliche Schönheit noch mit weit größerer Gewalt auf den äußern und innern Sinn.“"
                                            },
                                            {
                                                "example_id": "4f0461e2-ff26-44d2-b8a3-5cd505475b7c",
                                                "sense_id": "9735e0ee-72ac-3867-bf2d-b63fcfe65a3e",
                                                "text": "„Ich habe einen Smaragd. Er ist der schönste Smaragd der ganzen Welt. Den willst du haben, nicht wahr? Verlang' ihn von mir, ich will ihn dir geben, den schönsten Smaragd.“"
                                            },
                                            {
                                                "example_id": "1c6a607d-d02b-466e-83ee-cc6b5e971fe2",
                                                "sense_id": "9735e0ee-72ac-3867-bf2d-b63fcfe65a3e",
                                                "text": "„Sein Großvater, ein enthusiastischer Zionist, habe wunderbare Gedichte über Jerusalem geschrieben, wo die Engel an jeder Straßenecke warten, die Straßen mit Gold gepflastert seien und Smaragde den Himmel schlucken würden, erzählt Oz.“"
                                            },
                                            {
                                                "example_id": "4ff4fecd-4a1b-4c8b-bc3b-183586adfbe0",
                                                "sense_id": "9735e0ee-72ac-3867-bf2d-b63fcfe65a3e",
                                                "text": "„Metallicfarben Bronze, Silber und Gold und auch Smaragd, Saphir und Bernstein schmeicheln an düsteren Winterabenden und glänzen im Scheinwerferlicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d96ed4e6-4787-38de-9b75-2a3b8ff59ec2",
                                        "entry_id": "e05cf500-e762-3131-889d-8651c63c6972",
                                        "glosses": [
                                            "die bearbeitete Version (Schmuckstein) des Edelsteins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75ece2e-937e-461f-99d1-6d8ad73c3052",
                                                "sense_id": "d96ed4e6-4787-38de-9b75-2a3b8ff59ec2",
                                                "text": "In meinem Ring sind zwei Smaragde eingefasst."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "881289d4-843d-4d61-8fb6-c8ec2903649a",
                        "source_entry_id": "fd1438c0-dad1-3671-9119-3fbba5b6d3c3",
                        "target_lang_word": "emerald",
