                "senses": [
                    {
                        "sense_id": "29b319c9-87a7-34cb-af96-5eb68b063e61",
                        "entry_id": "8bb28009-a900-3524-9132-50c4e468a57a",
                        "glosses": [
                            "(meist männliche) Person, die an Gewässern, in dem Leute schwimmen oder baden, dafür sorgt, dass niemand ertrinkt oder sonst zu Schaden kommt"
                        ],
                        "tags": [
                            "Berufsbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "8a3d5427-778c-45fb-9ddd-fcdfaddc71fb",
                                "sense_id": "29b319c9-87a7-34cb-af96-5eb68b063e61",
                                "text": "Der Rettungsschwimmer eilte ins Wasser und konnte das ertrinkende Kind noch rechtzeitig an Land ziehen."
                            },
                            {
                                "example_id": "85792985-6ef2-443d-a0fb-d823f9d7c1f7",
                                "sense_id": "29b319c9-87a7-34cb-af96-5eb68b063e61",
                                "text": "„Bei einem Badeunglück vor Sylt sind eine Urlauberin und ein Rettungsschwimmer ums Leben gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
