                "senses": [
                    {
                        "sense_id": "97988e45-dced-3496-8e5e-245ea29274e0",
                        "entry_id": "0c474619-a4e3-36cf-926a-a2b132b9977b",
                        "glosses": [
                            "Erzeugung energiereicher organischer Stoffe aus energiearmen anorganischen Stoffen unter Nutzung von in Pigmenten absorbiertem Licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "181ecd71-71e9-400d-9fe1-074710a0f32c",
                                "sense_id": "97988e45-dced-3496-8e5e-245ea29274e0",
                                "text": "Die Fotosynthese ist der wichtigste Stoffwechselprozess von Pflanzen."
                            },
                            {
                                "example_id": "e65236e2-834d-4ec0-802b-45bc8e2e88dd",
                                "sense_id": "97988e45-dced-3496-8e5e-245ea29274e0",
                                "text": "„Die Folge war eine Orgie der Fotosynthese: Büsche, Sträucher und Bäume konnten nun ungehindert wuchern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc185ce4-fca7-4751-996b-8764418bb03b",
                        "source_entry_id": "0c474619-a4e3-36cf-926a-a2b132b9977b",
                        "source_sense_id": "97988e45-dced-3496-8e5e-245ea29274e0",
                        "target_lang_word": "photosynthesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photosynthesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a7238b0-6e52-3691-b3c9-7e366e6a3a18",
                                        "entry_id": "ce9dd8df-e6e9-3862-8d7d-f56d9857f7db",
                                        "glosses": [
                                            "Any process by which plants and other photoautotrophs convert light energy into chemical energy.",
                                            "Principally, oxygenic photosynthesis, any process by which plants and algae convert water and carbon dioxide into carbohydrates and waste oxygen using solar energy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d28234c-e4ad-4a8c-afa9-a805770e1a23",
                                                "sense_id": "1a7238b0-6e52-3691-b3c9-7e366e6a3a18",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis: the ability to convert water and carbon dioxide into carbohydrates and waste oxygen using solar energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "477bdefd-b3b9-3a8f-a108-dfaa90f8b80d",
                                        "entry_id": "ce9dd8df-e6e9-3862-8d7d-f56d9857f7db",
                                        "glosses": [
                                            "Any process by which plants and other photoautotrophs convert light energy into chemical energy.",
                                            "Also, nonoxygenic photosynthesis, used by purple and green bacteria, heliobacteria, and acidobacteria."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1186fdfe-34dc-49ba-ae64-7cef6f86bc7d",
                        "source_entry_id": "0c474619-a4e3-36cf-926a-a2b132b9977b",
                        "source_sense_id": "97988e45-dced-3496-8e5e-245ea29274e0",
                        "target_lang_word": "photosynthèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photosynthèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05f6451b-89ad-3404-853f-6c85d9395367",
                                        "entry_id": "065d81bd-2299-383d-a918-0c6289409a51",
                                        "glosses": [
                                            "Processus biochimique par lequel les organismes photosynthétiques eucaryotes transforment l’énergie lumineuse en énergie chimique en produisant des glucides à partir de dioxyde de carbone et d’eau, grâce notamment à la chlorophylle."
                                        ],
                                        "tags": [
                                            "Biologie fonctionnelle",
                                            "Biologie végétale",
                                            "Physiologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc3535d3-2329-4540-b691-255a2d8b0f26",
                                                "sense_id": "05f6451b-89ad-3404-853f-6c85d9395367",
                                                "text": "Cela fait des milliards d’années, bien avant l’apparition du nectar et de la notion de papille, que la photosynthèse transforme la lumière du Soleil en glucose."
                                            },
                                            {
                                                "example_id": "f2dd35df-356b-455a-86f4-cf1cf16ee142",
                                                "sense_id": "05f6451b-89ad-3404-853f-6c85d9395367",
                                                "text": "Les tubes fluorescents sont adaptés à l’étude de la photosynthèse en phytotron ; leur faible température de surface permet de les placer à proximité des plantes. Elles peuvent être utilisées en serre pour des éclairages photopériodiques."
                                            },
                                            {
                                                "example_id": "69a216ff-54b6-4a7d-8d65-2ce0ed2ca593",
                                                "sense_id": "05f6451b-89ad-3404-853f-6c85d9395367",
                                                "text": "Ces minuscules algues peuvent se décolorer par perte - réversible ou non - de leur chlorophylle. Sous l’influence de l’obscurité ou de mauvaises conditions de nutrition, elles cessent d’effectuer la photosynthèse et adoptent un mode de vie typiquement animal : elles se nourrissent d’aliments organiques solides ou liquides"
                                            },
                                            {
                                                "example_id": "e6b20051-0515-4019-b3e6-9c3b988e1135",
                                                "sense_id": "05f6451b-89ad-3404-853f-6c85d9395367",
                                                "text": "La photosynthèse s’arrête évidemment à cause du manque de lumière et de l’environnement glacial et les herbes se détériorent graduellement durant l’hiver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
