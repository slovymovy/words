                                "ru": "<w>Вокруг</w> сада стоит высокий забор.",
                                "pl": "<w>Wokół</w> ogrodu stoi wysoki płot.",
                                "de": "Es steht ein hoher Zaun <w>rund um</w> den Garten.",
                                "fr": "Il y a une haute clôture <w>autour du</w> jardin.",
                                "it": "C'è un'alta recinzione <w>attorno al</w> giardino.",
                                "cs": "Kolem zahrady stojí vysoký <w>plot</w>.",
                                "tr": "Bahçenin <w>etrafında</w> yüksek bir çit var.",
                                "es": "Hay una valla alta <w>alrededor del</w> jardín.",
                                "zh": "花园<w>围绕</w>着一道高高的栅栏。"
                            }
                        },
                        {
                            "text": "De kinderen zaten <w>rondom</w> het kampvuur liedjes te zingen.",
                            "target_lang_translations": {
                                "en": "The children sat <w>around</w> the campfire singing songs.",
                                "ru": "Дети сидели <w>вокруг</w> костра и пели песни.",
                                "pl": "Dzieci siedziały <w>dookoła</w> ogniska i śpiewały piosenki.",
                                "de": "Die Kinder saßen <w>um</w> das Lagerfeuer <w>herum</w> und sangen Lieder.",
                                "fr": "Les enfants étaient assis <w>autour du</w> feu de camp pour chanter des chansons.",
                                "it": "I bambini sedevano <w>intorno al</w> falò cantando canzoni.",
                                "cs": "Děti seděly <w>kolem</w> táboráku a zpívaly písničky.",
                                "tr": "Çocuklar kamp ateşinin <w>etrafında</w> oturup şarkı söylüyorlardı.",
                                "es": "Los niños estaban sentados <w>en torno a</w> la hoguera cantando canciones.",
                                "zh": "孩子们坐在篝火<w>周围</w>唱歌。"
                            }
                        }
