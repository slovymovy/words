                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6b4c8b30-4b28-3802-a603-36ac22191cc6",
                        "entry_id": "f8045e98-3b41-3d66-b3e8-31ae911783da",
                        "glosses": [
                            "Qui a une peur maladive du feu, des incendies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5469eeba-5eb9-4f69-81dc-57145cc1d5c8",
                                "sense_id": "6b4c8b30-4b28-3802-a603-36ac22191cc6",
                                "text": "Dans ce métier-là, certes, mieux vaut être pyromane que pyrophobe."
                            },
                            {
                                "example_id": "4880753f-366f-4c17-8878-f454d479dacd",
                                "sense_id": "6b4c8b30-4b28-3802-a603-36ac22191cc6",
                                "text": "Charles Sébastien, traumatisé par la macabre besogne, avait vu, peu après, sa raison sombrer dans un délire pyrophobe."
                            }
                        ]
                    }
                ],
