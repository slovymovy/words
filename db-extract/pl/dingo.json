                    {
                        "translation_id": "6d46eb78-2a0b-4e46-93a2-dac6be2d99d1",
                        "source_entry_id": "8080befd-41a0-31c1-a98e-2975b370ed79",
                        "source_sense_id": "65a32730-c167-3d34-97ea-dcfee5e14bce",
                        "target_lang_word": "dingo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dingo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3552bf69-c6d9-3ff9-a187-497d633e6340",
                                        "entry_id": "4032dee5-ca57-33fe-99df-c97407734c94",
                                        "glosses": [
                                            "Fou."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31840d39-acc4-4242-b19a-f2bdb7a3d3f3",
                                                "sense_id": "3552bf69-c6d9-3ff9-a187-497d633e6340",
                                                "text": "… Françoise, empruntant cette expression au vocabulaire de sa fille, disait que j’étais dingo."
                                            },
                                            {
                                                "example_id": "15dffd68-e21c-42cb-9850-2087c075cb6a",
                                                "sense_id": "3552bf69-c6d9-3ff9-a187-497d633e6340",
                                                "text": "J’étais terrifié à l’idée d’être retombé une fois de plus sur un gang de dingos."
                                            },
                                            {
                                                "example_id": "8b9a23a7-1659-4204-8749-93cedff4a1bd",
                                                "sense_id": "3552bf69-c6d9-3ff9-a187-497d633e6340",
                                                "text": "[…] les études suscitaient la méfiance, la crainte que par une sanction obscure, un retournement punitif pour avoir voulu monter trop haut, elles rendent dingo."
                                            },
                                            {
                                                "example_id": "18f7acbd-fa77-4664-a2f5-07c65867d4b2",
                                                "sense_id": "3552bf69-c6d9-3ff9-a187-497d633e6340",
                                                "text": "« Je suis un peu dingote comme ma mère, hyperactive (comme son père ?), je sais pas me reposer… Je crois que ce que j’aime avant tout, c’est rentrer chez moi heureuse d’avoir rendu les gens heureux. »"
                                            },
                                            {
                                                "example_id": "d346948f-a204-4e4c-beb5-6d1cf54032a8",
                                                "sense_id": "3552bf69-c6d9-3ff9-a187-497d633e6340",
                                                "text": "Quand qu’l’animal à plumes bigla son dab dépoter dans l’poulailler avec une massue à assommer un rhino, elle se mit à zigzaguer dans l’enclos complètement dingote, arquebusée, carbonisée de trouille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99f06394-7c9d-3f72-96e2-4c9fe0c49b8f",
                                        "entry_id": "4032dee5-ca57-33fe-99df-c97407734c94",
                                        "glosses": [
                                            "Entiché, épris, en parlant de quelqu’un ou de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "add359cb-25f9-41f7-8eaa-370bf080f5a7",
                                                "sense_id": "99f06394-7c9d-3f72-96e2-4c9fe0c49b8f",
                                                "text": "Il m’est entré dans la peau, j’en suis dingo […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dingo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8250584b-c663-3203-9dea-d3dd4b933931",
                                        "entry_id": "815ad329-3bdc-38e8-ab22-f199e2b70da6",
                                        "glosses": [
                                            "Canidé australien ressemblant à un grand renard, de nom scientifique Canis lupus dingo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d4fba71-a650-44a7-a920-1b2fdc4b9795",
                                                "sense_id": "8250584b-c663-3203-9dea-d3dd4b933931",
                                                "text": "[…] puis les voyageurs, les uns dans le chariot, les autres sous la tente, ne tardèrent pas à s’endormir, malgré les hurlements lamentables des « dingos, » qui sont les chacals de l’Australie."
                                            },
                                            {
                                                "example_id": "d2ecf2be-e394-465d-bef4-e72e22d8cab4",
                                                "sense_id": "8250584b-c663-3203-9dea-d3dd4b933931",
                                                "text": "De temps à autre, des dingos venaient flairer le fumet qui s'échappait des cuissons. Effrayés par le feu, ils se tenaient heureusement en retrait. Les hommes leur jetèrent leurs restes avant de la chasser."
                                            },
                                            {
                                                "example_id": "b2a25166-63b8-4985-84a5-ad49a9e868e5",
                                                "sense_id": "8250584b-c663-3203-9dea-d3dd4b933931",
                                                "text": "Deux touristes ont reçu des amendes salées pour avoir pris des photos près de plusieurs chiens sauvages, appelés dingos, en Australie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dingo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd78e960-3c43-334c-a44b-776e08dc293b",
                                        "entry_id": "e785c2fd-6035-35f9-8132-65e55a0c5799",
                                        "glosses": [
                                            "Dément, fou."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c088415-6014-40e4-8709-b325674b28d3",
                                                "sense_id": "fd78e960-3c43-334c-a44b-776e08dc293b",
                                                "text": "Ce déplorable dingo racontait sa vie. Il avait eu pour mère une démente qui se faisait appeler Madame Satan, […]."
                                            },
                                            {
                                                "example_id": "f1c4bb1a-ed7f-436a-9b43-adf8a41d18c6",
                                                "sense_id": "fd78e960-3c43-334c-a44b-776e08dc293b",
                                                "text": "Pardonnez-moi belle Dingote\nExcusez-moi noble Dingo"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
