{
    "word_family": [
        "occupancy",
        "occupation",
        "occupational",
        "occupy",
        "reoccupy",
        "preoccupy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0f8dce73-11bb-3eb8-9ba1-b5b7c54d6281",
                    "sense_definition": "A person who resides in or occupies a building, room, or space.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inhabitant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The previous <w>occupants</w> of the apartment left several pieces of furniture behind.",
                            "target_lang_translations": {
                                "ru": "Предыдущие <w>жильцы</w> квартиры оставили после себя несколько предметов мебели."
                            }
                        },
                        {
                            "text": "Firefighters checked every room to make sure no <w>occupants</w> were trapped inside.",
                            "target_lang_translations": {
                                "ru": "Пожарные проверили каждую комнату, чтобы убедиться, что внутри не остались заблокированы <w>люди</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "occupier"
                    ],
                    "common_phrases": [
                        "sole occupant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который проживает в здании, комнате или занимает определённое помещение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жилец",
                                "target_lang_sense_clarification": "человек, проживающий в квартире или доме"
                            },
                            {
                                "target_lang_word": "обитатель",
                                "target_lang_sense_clarification": "тот, кто занимает помещение или пространство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09d97165-3001-31eb-a367-a61d6f9e2265",
                    "sense_definition": "A person sitting or traveling in a car or other vehicle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All <w>occupants</w> of the vehicle were wearing their seatbelts during the crash.",
                            "target_lang_translations": {
                                "ru": "Все <w>пассажиры и водитель</w> автомобиля были пристёгнуты ремнями безопасности во время аварии."
                            }
                        },
                        {
                            "text": "Emergency services treated the car's <w>occupants</w> for minor injuries at the scene.",
                            "target_lang_translations": {
                                "ru": "Экстренные службы оказали помощь <w>находившимся в машине</w> в связи с незначительными травмами прямо на месте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vehicle occupants"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, находящийся или едущий в автомобиле либо другом транспортном средстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пассажир",
                                "target_lang_sense_clarification": "лицо, находящееся в транспортном средстве"
                            },
                            {
                                "target_lang_word": "находящийся в автомобиле",
                                "target_lang_sense_clarification": "водитель или пассажир в салоне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1879284d-d5f4-39c4-b95a-07e7ff3b998d",
                    "sense_definition": "The legal owner or tenant who has possession of a property.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landlord sent an eviction notice to the current <w>occupant</w> of the house.",
                            "target_lang_translations": {
                                "ru": "Арендодатель направил уведомление о выселении нынешнему <w>жильцу</w> дома."
                            }
                        },
                        {
                            "text": "Each <w>occupant</w> must sign the rental agreement before receiving the keys.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>съёмщик</w> должен подписать договор аренды до получения ключей."
                            }
                        }
                    ],
                    "synonyms": [
                        "occupier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Законный владелец или арендатор, фактически занимающий недвижимость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квартирант",
                                "target_lang_sense_clarification": "арендатор жилья"
                            },
                            {
                                "target_lang_word": "съёмщик",
                                "target_lang_sense_clarification": "наниматель жилого помещения"
                            },
                            {
                                "target_lang_word": "жилец",
                                "target_lang_sense_clarification": "законный житель или арендатор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0317ddbd-61b3-3698-b1df-0dcb57ee1ec3",
                    "sense_definition": "A person who holds an official position or public office.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest <w>occupant</w> of the post faced significant political challenges.",
                            "target_lang_translations": {
                                "ru": "Последний <w>обладатель этой должности</w> столкнулся с серьёзными политическими трудностями."
                            }
                        },
                        {
                            "text": "She had high praise for the previous <w>occupant</w> of the Oval Office.",
                            "target_lang_translations": {
                                "ru": "Она высоко отзывалась о предыдущем <w>хозяине</w> Овального кабинета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "current occupant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, занимающее официальный пост или государственную должность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обладатель должности",
                                "target_lang_sense_clarification": "человек, занимающий пост"
                            },
                            {
                                "target_lang_word": "занимающий пост",
                                "target_lang_sense_clarification": "должностное лицо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}