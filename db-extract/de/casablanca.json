                "senses": [
                    {
                        "sense_id": "32839ed5-730b-30e5-9dc4-94470a819842",
                        "entry_id": "62e66e0e-00c3-31b0-9d21-81f3c3aaf8fc",
                        "glosses": [
                            "Großstadt in Marokko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e13d1c6-82af-414f-a340-a0b79f7ba553",
                                "sense_id": "32839ed5-730b-30e5-9dc4-94470a819842",
                                "text": "„Er war 1952 in Casablanca geboren worden, zwei Jahre bevor seine Familie nach Israel ging.“"
                            },
                            {
                                "example_id": "c5a950af-89b1-4db8-b97b-c662fcde9658",
                                "sense_id": "32839ed5-730b-30e5-9dc4-94470a819842",
                                "text": "„Viele von ihnen waren orientalische Juden, deren Familien aus Bagdad, Casablanca oder Beirut stammten.“"
                            },
                            {
                                "example_id": "617ad230-9334-4d20-a01f-0e090432a51c",
                                "sense_id": "32839ed5-730b-30e5-9dc4-94470a819842",
                                "text": "„Doch durch seinen Tod schien er ihm plötzlich näher zu rücken, und Knafo trauerte um ihn, denn damals in Casablanca hatte Max häufig mit ihm über sein Studium gesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "deab590e-1aef-4d25-98fd-452790327628",
