                                        "entry_id": "a3e5f2d0-acc0-3423-8a9d-462fedcca665",
                                        "glosses": [
                                            "Following in time; coming or being after something else at any time, indefinitely."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb3f2c4f-9a0e-411d-8b66-3014e085fc5e",
                                                "sense_id": "3646d4b8-5590-3125-b2b9-5ea1206b08d4",
                                                "text": "Growth was dampened by a softening of the global economy in 2001, but picked up in the subsequent years due to strong growth in China."
                                            },
                                            {
                                                "example_id": "6a0bf911-9927-4605-9902-44d1700d86df",
                                                "sense_id": "3646d4b8-5590-3125-b2b9-5ea1206b08d4",
                                                "text": "In a thread called “Calm Before the Storm”, and in subsequent posts, Q established his legend as a government insider with top security clearance who knew the truth about a secret struggle for power involving Donald Trump, the “deep state”, Robert Mueller, the Clintons, pedophile rings, and other stuff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ae9f34-6de0-34d6-943f-a7754d075109",
                                        "entry_id": "a3e5f2d0-acc0-3423-8a9d-462fedcca665",
                                        "glosses": [
                                            "Following in order of place; succeeding."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19186d36-d6da-3b42-bdf1-be3d135c8d32",
                                        "entry_id": "a3e5f2d0-acc0-3423-8a9d-462fedcca665",
                                        "glosses": [
                                            "Following a line in the earth that is more easily eroded."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44edd923-d331-4a63-870a-b3ef40c97572",
                                                "sense_id": "19186d36-d6da-3b42-bdf1-be3d135c8d32",
                                                "text": "The peculiar position of the subsequent Derwent, close to the sea, suggests some glacial interference with normal adjustments, and calls for special explanation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subsequent",
