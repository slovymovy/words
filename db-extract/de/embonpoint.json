                ],
                "senses": [
                    {
                        "sense_id": "b5935706-6b9a-3d8e-9af4-70a1cfdc7013",
                        "entry_id": "5f7f973c-8864-3f87-8c20-60a9c3741149",
                        "glosses": [
                            "korpulentes, fülliges körperliches Erscheinungsbild"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "1eee07b8-60c7-409c-855c-b864bcbdc741",
                                "sense_id": "b5935706-6b9a-3d8e-9af4-70a1cfdc7013",
                                "text": "„Die Verheiratung seiner Tochter Imagina an den ältesten der hoffnungsvollen Söhne des Grafen, an den frischen, blonden, etwas zum Embonpoint neigenden Grafen August war eine geschäftliche Sache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0c82471f-abb0-37f6-ace3-6bfa0294278a",
                        "entry_id": "5f7f973c-8864-3f87-8c20-60a9c3741149",
                        "glosses": [
                            "stattlicher, hervorstehender Bauch"
                        ],
                        "tags": [
                            "humorous",
                            "literary",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "43b23189-a22d-4765-b494-9c6dea7b2f0b",
                                "sense_id": "0c82471f-abb0-37f6-ace3-6bfa0294278a",
                                "text": "„Wenn er sich jetzt auf seinem Stuhl zurücklehnt und die Hände über dem Embonpoint faltet, dann strahlt er eine bukolische Ruhe aus.“"
                            },
                            {
                                "example_id": "1aab405e-1f2e-4cf9-bb00-7802e19d480b",
                                "sense_id": "0c82471f-abb0-37f6-ace3-6bfa0294278a",
                                "text": "„Hoffmann hat in Aquarellfarben ein Doppelporträt von Hitzig und seiner jungen Frau gemalt: trotz des Embonpoint verraten beide Profile Feinheit und Güte.“"
                            },
                            {
                                "example_id": "04a247a2-19a6-4082-99fd-178bd7685b09",
                                "sense_id": "0c82471f-abb0-37f6-ace3-6bfa0294278a",
                                "text": "„Ein schwarzer Vollbart umrahmte sein Gesicht, das ebensoviel Behagen wie Sarkasmus ausdrückte, während ihm der in der Taille knapp anschließende Rock von niederländischem Tuche sein Embonpoint zusammenschnürte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e332ea6-846d-4c85-91f5-fc5859364b23",
                        "source_entry_id": "5f7f973c-8864-3f87-8c20-60a9c3741149",
                        "source_sense_id": "b5935706-6b9a-3d8e-9af4-70a1cfdc7013",
                        "source_sense_description": "veraltet: korpulentes, fülliges körperliches Erscheinungsbild",
                        "target_lang_word": "embonpoint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embonpoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e75e8132-6e80-37db-8530-c2c9afcdf8b1",
                                        "entry_id": "569f160d-da47-38b1-bc4a-f654cca863f2",
                                        "glosses": [
                                            "Plumpness, stoutness, especially when voluptuous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a596493-c5d9-463d-9453-cdcdf25c3c5d",
                                                "sense_id": "e75e8132-6e80-37db-8530-c2c9afcdf8b1",
                                                "text": "She was slightly inclined to embonpoint."
                                            },
                                            {
                                                "example_id": "93e6d1e9-8afb-4581-b725-4e68cfb9ce46",
                                                "sense_id": "e75e8132-6e80-37db-8530-c2c9afcdf8b1",
                                                "text": "The beautiful woman threw off her sabletrimmed wrap, displaying her queenly shoulders and heaving embonpoint."
                                            },
                                            {
                                                "example_id": "529b2fe0-b94e-4e8f-bcba-702e75f05cc1",
                                                "sense_id": "e75e8132-6e80-37db-8530-c2c9afcdf8b1",
                                                "text": "The patient's physicians had always allowed him to indulge a gargantuan appetite, countering his intake and regulating his embonpoint by a heroic diet of purges and enemas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "embonpoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "115ba10c-6741-30c9-9b40-4f90af51c93e",
                                        "entry_id": "62ef90dd-f3fd-38b7-8948-5945e309d426",
                                        "glosses": [
                                            "Plump, chubby, buxom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e27937c1-5cd7-4ec2-916e-af38d683b62c",
                                                "sense_id": "115ba10c-6741-30c9-9b40-4f90af51c93e",
                                                "text": "\"Though it is six years since I have seen you,\" exclaimed Anne, \"you are not the least altered; instead of that, you are handsomer than ever; your being rather more embonpoint suits you, and your complexion is brilliant to a degree.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea558127-bf56-4e7c-b641-e9eef5389a60",
                        "source_entry_id": "5f7f973c-8864-3f87-8c20-60a9c3741149",
                        "source_sense_id": "b5935706-6b9a-3d8e-9af4-70a1cfdc7013",
                        "source_sense_description": "veraltet: korpulentes, fülliges körperliches Erscheinungsbild",
                        "target_lang_word": "embonpoint",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embonpoint",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                        "entry_id": "289a8632-a9f9-3fcb-b813-158b940e9911",
                                        "glosses": [
                                            "État d’une personne un peu grasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e03c3c21-4e1b-4dc9-90b2-30bafc1cf073",
                                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                                "text": "C'était une grande femme qui avec moins d’embonpoint eût eu la taille belle, et une beauté romaine que bien des gens préféraient à celle de sa sœur."
                                            },
                                            {
                                                "example_id": "0f050f93-beeb-4a16-b406-c7e3688a84b6",
                                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                                "text": "Quoique La Brière fût alors mince, il appartient à ce genre de tempéraments qui, formés tard, prennent à trente ans un embonpoint inattendu."
                                            },
                                            {
                                                "example_id": "dff59e70-66cc-4f18-be14-af3ce4670e9c",
                                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                                "text": "C’était à cette époque une femme de cinquante-deux à cinquante-trois ans à peu près, qui conservait, grâce à son embonpoint plein de fraîcheur, les traits de sa première beauté."
                                            },
                                            {
                                                "example_id": "ea6cfd3a-11bc-45f8-9d5c-25e897b18096",
                                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                                "text": "Bakounine était d’une colossale stature, encore que son embonpoint fût évidemment dû à sa maladie."
                                            },
                                            {
                                                "example_id": "1d2be1e6-0bb4-4462-b7b5-a94f30d6dca9",
                                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                                "text": "Madame Toussaint était une grosse femme que l’embonpoint envahissait, malgré tout, malgré le tracas et le jeûne."
                                            },
                                            {
                                                "example_id": "3a0534ea-c4bc-44d4-bf18-80cd91c28401",
                                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                                "text": "Elhamy, de son côté, changeait. Il prenait de l'embonpoint; ses traits s'empâtaient quelque peu."
                                            },
                                            {
                                                "example_id": "8a873578-f311-4754-9de2-67729e024680",
                                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                                "text": "— La Verse ou le versage des blés, et de beaucoup de plantes céréales, est un accident occasionné, ou par de grands vents, des orages, de fortes pluies, ou par le trop d’embonpoint que prennent les plantes dans les temps chauds et humides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "306cc33a-4f35-3048-a937-9eb9b48036c7",
                                        "entry_id": "289a8632-a9f9-3fcb-b813-158b940e9911",
                                        "glosses": [
                                            "État d’une chose un peu grasse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07b23c64-0898-4e80-9220-04c1b910e43e",
                                                "sense_id": "306cc33a-4f35-3048-a937-9eb9b48036c7",
                                                "text": "Sauf que depuis plusieurs années, les voitures ont pris de l'embonpoint, et pas seulement les SUV, mais tous les modèles: en moyenne, elles ont gagné 20 cm et sont 20% plus larges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
