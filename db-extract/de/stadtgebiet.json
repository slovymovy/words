                ],
                "senses": [
                    {
                        "sense_id": "afd2afc6-bae8-3f82-88ed-bfd38a1c060a",
                        "entry_id": "988ee040-8d22-38cf-a413-8bb115653cd3",
                        "glosses": [
                            "(Hoheits)gebiet einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "238d572c-17d5-4327-a66a-6e3aa3261cb1",
                                "sense_id": "afd2afc6-bae8-3f82-88ed-bfd38a1c060a",
                                "text": "Die Stromversorgung im gesamten Stadtgebiet ist unterbrochen."
                            },
                            {
                                "example_id": "26fdeb97-2f31-43e8-9a59-9adf1524951c",
                                "sense_id": "afd2afc6-bae8-3f82-88ed-bfd38a1c060a",
                                "text": "„Im Januar 2013 nahmen Fahnder einen 32-Jährigen fest, der im Potsdamer Stadtgebiet 32 Einbrüche begangen haben soll — vor allem in Praxen und Büros.“"
                            },
                            {
                                "example_id": "ef9a7296-ba80-4ca0-aeed-301b504f6af0",
                                "sense_id": "afd2afc6-bae8-3f82-88ed-bfd38a1c060a",
                                "text": "„Eine solche Maulkorbpflicht ist gesetzlich bereits vorgeschrieben, gilt aber nicht einfach im gesamten Stadtgebiet.“"
                            },
                            {
                                "example_id": "c7ccaae3-89a3-4912-8fd1-2ea76793e7ef",
                                "sense_id": "afd2afc6-bae8-3f82-88ed-bfd38a1c060a",
                                "text": "„Am Abend des 19. Juni 1957 gab es im Stadtgebiet von New York Alarm für 277 Mitarbeiter des FBI.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
