                    {
                        "translation_id": "400f857e-d842-4bcd-9ec0-ed4b62afb723",
                        "source_entry_id": "a3020a4f-c594-3183-b5f3-48380f737c76",
                        "source_sense_description": "county of England",
                        "target_lang_word": "Cornouailles",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cornouailles",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6288fe71-b2e1-36ae-ac75-25f00d6fae65",
                                        "entry_id": "5dc868a0-e705-3d8b-8f61-bfa13336e05e",
                                        "glosses": [
                                            "Comté et autorité unitaire d’Angleterre situé dans la région d’Angleterre du Sud-Ouest, dont le chef-lieu est Truro."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63f8e814-5ab2-4bdf-945b-454a07d31320",
                                                "sense_id": "6288fe71-b2e1-36ae-ac75-25f00d6fae65",
                                                "text": "Je croyais le roi plus favorable au duc d’Albany qu’au duc de Cornouailles."
                                            },
                                            {
                                                "example_id": "a1c0df8a-668e-4ec2-9010-3c870446d6f8",
                                                "sense_id": "6288fe71-b2e1-36ae-ac75-25f00d6fae65",
                                                "text": "Elles sont confuses et mêlées de légendes ; plusieurs de ces dernières avancent que Joseph d’Arimathée, possédant des mines d’étain en Cornouailles (les Cassitérides des phéniciens), était venu s’installer à Glastonbury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5153560-bbd3-49b1-9a69-266eb7c4db28",
                        "source_entry_id": "a3020a4f-c594-3183-b5f3-48380f737c76",
                        "source_sense_description": "county of England",
                        "target_lang_word": "Cornwall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cornwall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9052dd42-1259-38e0-b8d6-daed9af76342",
                                        "entry_id": "723fda8a-560d-3b40-9db1-e79a44c748a6",
                                        "glosses": [
                                            "Graf- und Landschaft im äußersten Südwesten von Großbritannien, die eine Halbinsel bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "293bc267-c29a-402a-9fe0-397ae6283167",
                                                "sense_id": "9052dd42-1259-38e0-b8d6-daed9af76342",
                                                "text": "Wichtige Städte von Cornwall sind Bodmin, Falmouth, Penzance und Truro."
                                            },
                                            {
                                                "example_id": "5625043e-6d6d-4403-b38f-2bd47ec6ae2f",
                                                "sense_id": "9052dd42-1259-38e0-b8d6-daed9af76342",
                                                "text": "Der südlichste Punkt von England heißt Lizard Point und liegt in Cornwall."
                                            },
                                            {
                                                "example_id": "a275be99-1635-47ba-b7df-26fe2a1ea39a",
                                                "sense_id": "9052dd42-1259-38e0-b8d6-daed9af76342",
                                                "text": "Zu Cornwall gehören auch die Scillyinseln."
                                            },
                                            {
                                                "example_id": "031c6837-0cef-40dc-a5e2-fa5152d5283c",
                                                "sense_id": "9052dd42-1259-38e0-b8d6-daed9af76342",
                                                "text": "„In einem Kraftwerk an der Küste des englischen Cornwall treibt die von den Gezeiten verursachte Meeresströmung Unterwasserrotoren an.“"
                                            },
                                            {
                                                "example_id": "4103bd62-8d35-4bee-bcc0-b6ce0f653888",
                                                "sense_id": "9052dd42-1259-38e0-b8d6-daed9af76342",
                                                "text": "„In Cornwall und Devon, in Wales, Mittelengland und Schottland überwiegen Mittelgebirge, die im Ben Nevis der schottischen Grampian Mountains gipfeln (1343 m).“"
                                            },
                                            {
                                                "example_id": "1778e75c-0330-4dd8-9042-cfb54fab320b",
                                                "sense_id": "9052dd42-1259-38e0-b8d6-daed9af76342",
                                                "text": "„Von zentraler Bedeutung für die Handelsbeziehungen mit den Kulturen des Mittelmeerraums waren von jeher die Zinnvorkommen in Cornwall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
