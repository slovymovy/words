                        "glosses": [
                            "Toute petite chaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c796ffa7-f698-4b17-9672-3542345b046d",
                                "sense_id": "46cb7130-a90f-311a-ad0f-fa30746f4821",
                                "text": "Un groupe d’enfants y jouait à la dînette dans un petit coin aménagé en cuisine, en mini-cuisine plus exactement, avec mini-gazinière, mini-réfrigérateur, mini-table et mini-chaises ; d’autres assemblaient des cubes de plastique de toutes les couleurs ; certains dessinaient sagement, assis à leur pupitre."
                            },
                            {
                                "example_id": "55e0c8ca-a2de-4a3a-982a-2c266f56c51d",
                                "sense_id": "46cb7130-a90f-311a-ad0f-fa30746f4821",
                                "text": "Ils étaient déjà assis puisque c’était la classe dans laquelle ils avaient eu cours toute la matinée, sur des mini-chaises, derrière des mini-tables."
                            },
                            {
                                "example_id": "517cfcba-a7ad-4a07-a66c-58a2c61d23b0",
                                "sense_id": "46cb7130-a90f-311a-ad0f-fa30746f4821",
                                "text": "Très rapidement, les mini-chaises sont prises d’assaut."
                            }
                        ]
                    }
