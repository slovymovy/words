                "senses": [
                    {
                        "sense_id": "5b219e06-1727-3dd3-b131-692925fb20ae",
                        "entry_id": "9b28534b-82bc-31ba-b88d-f1dc12fe7f7d",
                        "glosses": [
                            "спец. быть подверженным колебательному процессу; периодически проходить цикл изменения состояния, свойств; колебаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a65c20a9-e60a-4e61-9c60-82257f621e02",
                                "sense_id": "5b219e06-1727-3dd3-b131-692925fb20ae",
                                "text": "Более того, 8-10 % всех активных (не только часовых) генов осциллируют в суточном ритме."
                            }
                        ]
                    }
                ],
