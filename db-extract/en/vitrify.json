                    },
                    {
                        "translation_id": "c5a201e0-d68b-49d0-a116-d82514781ffb",
                        "source_entry_id": "8319cff9-56c7-3758-9aeb-2e9c5dcce582",
                        "source_sense_description": "to be made into glass",
                        "target_lang_word": "vitrifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vitrifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52d4c19c-5796-344c-b7ff-e32b9219b6b0",
                                        "entry_id": "e1432c6a-38f4-370c-a483-9a292983ae49",
                                        "glosses": [
                                            "Fondre une substance de manière qu’elle se transforme en verre ou qu’elle prenne l’éclat, la transparence, la dureté du verre."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c2b1163-ab34-4bad-ae01-e52442cc6808",
                                                "sense_id": "52d4c19c-5796-344c-b7ff-e32b9219b6b0",
                                                "text": "Le feu vitrifie le sable mêlé à l’alcali."
                                            },
                                            {
                                                "example_id": "e3d7479b-399b-4d8d-8330-0a61672554bb",
                                                "sense_id": "52d4c19c-5796-344c-b7ff-e32b9219b6b0",
                                                "text": "Cette matière se vitrifie promptement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6454f8d-8f37-3035-bf81-95665dfbeadc",
                                        "entry_id": "e1432c6a-38f4-370c-a483-9a292983ae49",
                                        "glosses": [
                                            "Rendre dur et inaltérable comme le verre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e444ad0f-bb03-44e4-8cbc-60d6265b7d84",
                                                "sense_id": "c6454f8d-8f37-3035-bf81-95665dfbeadc",
                                                "text": "Je n'en ai gardé souvenir de rien de précis [de ces quelques jours passés avec Pierre Louis], mais bien seulement d'une extraordinaire ferveur, d'une joie, d'une frénésie qui m'éveillait dès l'aube, éternisait chaque instant de chaque heure, vitrifiait ou volatilisait tout ce qui s'approchait de mon cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7862aaa6-b816-39f7-876e-af6a90df70df",
                                        "entry_id": "e1432c6a-38f4-370c-a483-9a292983ae49",
                                        "glosses": [
                                            "Anéantir totalement un territoire par l’usage d’armes puissantes, généralement nucléaires."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad4cb68b-f09c-4546-b06d-c353c548d7fb",
                                                "sense_id": "7862aaa6-b816-39f7-876e-af6a90df70df",
                                                "text": "Enfin, son arme nucléaire et ses sous-marins lui permettent de vitrifier le territoire de n’importe quel ennemi, quelle que soit sa taille."
                                            },
                                            {
                                                "example_id": "71ceb584-0dee-40f6-bed8-5ad196b5ccb3",
                                                "sense_id": "7862aaa6-b816-39f7-876e-af6a90df70df",
                                                "text": "Il ne s’agit donc plus d’arrêter la prolifération — comme avec l’Iran — mais d’empêcher l’utilisation de ces charmantes machines à vitrifier la planète."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
