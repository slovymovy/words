        "pl-extract.jsonl": [
            {
                "entry_id": "4c6be7dd-d552-34ed-9470-537a5fcae771",
                "word": "ustawowy",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "30a93727-479a-31c1-a53f-323664c58c4e",
                        "entry_id": "4c6be7dd-d552-34ed-9470-537a5fcae771",
                        "glosses": [
                            "uregulowany ustawą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "104d0ab3-4736-41fe-b069-4ee98d87f14c",
                                "sense_id": "30a93727-479a-31c1-a53f-323664c58c4e",
                                "text": "Ustawę o zmianie Konstytucji uchwala Sejm większością co najmniej ⅔ głosów w obecności co najmniej połowy ustawowej liczby posłów oraz Senat bezwzględną większością głosów w obecności co najmniej połowy ustawowej liczby senatorów."
                            },
                            {
                                "example_id": "f227795c-20ac-4d60-a6d7-4c03f4ea5caa",
                                "sense_id": "30a93727-479a-31c1-a53f-323664c58c4e",
                                "text": "W wyniku porozumień Okrągłego Stołu w lipcu 1989 wprowadzono ustawową indeksację płac równoważącą inflację."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "21bb6c35-3b08-351a-8079-058eb08e4c66",
                        "entry_id": "4c6be7dd-d552-34ed-9470-537a5fcae771",
                        "glosses": [
                            "dotyczący ustaw, związany z ustawą"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9a8df05-faf1-43d5-9355-b83263a0e5de",
                        "source_entry_id": "4c6be7dd-d552-34ed-9470-537a5fcae771",
                        "source_sense_id": "30a93727-479a-31c1-a53f-323664c58c4e",
                        "target_lang_word": "legal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d25b04c4-1e30-37ed-991a-7acffb79dad7",
                                        "entry_id": "34bbc012-d56a-39d8-985b-1abaecddc97e",
                                        "glosses": [
                                            "Relating to the law or to lawyers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9310b9b-ce0f-4d00-a191-79297f1ec97c",
                                                "sense_id": "d25b04c4-1e30-37ed-991a-7acffb79dad7",
                                                "text": "According to this saga of intellectual-property misanthropy, these creatures [patent trolls] roam the business world, buying up patents and then using them to demand extravagant payouts from companies they accuse of infringing them. Often, their victims pay up rather than face the costs of a legal battle."
                                            },
                                            {
                                                "example_id": "103e5817-e6af-4db7-a89a-43b5a423c90f",
                                                "sense_id": "d25b04c4-1e30-37ed-991a-7acffb79dad7",
                                                "text": "legal profession"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d31867d-b766-33bd-a5bc-0a1c08637be8",
                                        "entry_id": "34bbc012-d56a-39d8-985b-1abaecddc97e",
                                        "glosses": [
                                            "Having its basis in the law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3874f243-34a4-4a9b-b317-ca098282938c",
                                                "sense_id": "7d31867d-b766-33bd-a5bc-0a1c08637be8",
                                                "text": "legal precedent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84e847b-1fc3-3ea1-8555-3fe5cc724efe",
                                        "entry_id": "34bbc012-d56a-39d8-985b-1abaecddc97e",
                                        "glosses": [
                                            "Being established, permitted, required or prescribed by law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9093ab8c-4031-41e6-ba40-63ad042c401c",
                                                "sense_id": "e84e847b-1fc3-3ea1-8555-3fe5cc724efe",
                                                "text": "After 50 years, legal segregation is a distant memory, and race in America is not the unbridgeable chasm it once was. The country has a black president. The sort of comity that King evoked, in which the descendants of slaves and of slave owners “sit down together at the table of brotherhood”, can be found in many places, including the Deep South. The rate of marriage between blacks and whites is rising."
                                            },
                                            {
                                                "example_id": "90171367-e22e-416f-9c2f-64f5a9ddde80",
                                                "sense_id": "e84e847b-1fc3-3ea1-8555-3fe5cc724efe",
                                                "text": "legal motion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a886d746-39f1-3aa6-9c2b-afdadd46a3d9",
                                        "entry_id": "34bbc012-d56a-39d8-985b-1abaecddc97e",
                                        "glosses": [
                                            "Following the rules or syntax of a system, such as a game or a programming language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6d49694-073f-4e3d-8338-3f65ef398fc1",
                                                "sense_id": "a886d746-39f1-3aa6-9c2b-afdadd46a3d9",
                                                "text": "If you have no legal move, but are not in check the game is a draw."
                                            },
                                            {
                                                "example_id": "5b05d581-f9cd-481b-86cb-ae11afe0b51e",
                                                "sense_id": "a886d746-39f1-3aa6-9c2b-afdadd46a3d9",
                                                "text": "Programming languages are designed so that each legal program has exactly one meaning"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "802bfffc-361f-3e51-a32c-ac42ece214d2",
                                        "entry_id": "34bbc012-d56a-39d8-985b-1abaecddc97e",
                                        "glosses": [
                                            "Above the age of consent or the legal drinking age."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3275c5-d068-4cee-9526-b10091c05bc9",
                                                "sense_id": "802bfffc-361f-3e51-a32c-ac42ece214d2",
                                                "text": "\"Is she even legal? Shame on you, diddlin' a girl too young to buy beer. You being a church deacon and all.\" If looks could kill, Dale would be dead."
                                            },
                                            {
                                                "example_id": "4a9d276e-d1fa-445a-a6e4-dc9debb5b0c4",
                                                "sense_id": "802bfffc-361f-3e51-a32c-ac42ece214d2",
                                                "text": "\"Is she even legal? She looks like a minor.\" Elias whispers back, \"Of course. I checked her passport. She's 20. What do you take me for? Be nice. I like her.\" I immediately smile at the girl behind Elias,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f674826e-8254-3056-8c39-e7f67ad68765",
                                        "entry_id": "34bbc012-d56a-39d8-985b-1abaecddc97e",
                                        "glosses": [
                                            "Permitting the use and/or sale of cannabis; in which cannabis is lawful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3ef6c2a-a6fd-4abd-9dd2-0264cc32e681",
                                                "sense_id": "f674826e-8254-3056-8c39-e7f67ad68765",
                                                "text": "Whether you're interested in opening a retail marijuana store in a legal state or if you're interested in investing in someone or a company, which is operating in a legal state, there are[…]"
                                            },
                                            {
                                                "example_id": "cb017160-a65f-494a-93e1-10283dab370c",
                                                "sense_id": "f674826e-8254-3056-8c39-e7f67ad68765",
                                                "text": "[Because] marijuana is still a federally illegal drug, using the drug in a child's presence, even in a legal state, could thus be construed as child abuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "131fe5e1-292d-3cf5-a021-f98062e0fca0",
                                        "entry_id": "34bbc012-d56a-39d8-985b-1abaecddc97e",
