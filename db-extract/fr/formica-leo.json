                        "examples": [
                            {
                                "example_id": "7dc459b5-5008-4dfc-ba38-5c6a447c670a",
                                "sense_id": "825f3e84-d3d8-3bb3-b580-6c8c1a4ca76c",
                                "text": "Une œuvre long-temps élaborée, pareille au cornet de sable au fond duquel se tient le formica-leo."
                            },
                            {
                                "example_id": "e6fadcb9-1a91-4a25-958e-61171ae13c45",
                                "sense_id": "825f3e84-d3d8-3bb3-b580-6c8c1a4ca76c",
                                "text": "Un mariage, qui avait été une folie d’inclination, l’avait jetée dans ce « trou de formica-leo »."
                            },
                            {
                                "example_id": "1f7b57f8-ec58-4f09-8c2d-845a369b02fb",
                                "sense_id": "825f3e84-d3d8-3bb3-b580-6c8c1a4ca76c",
                                "text": "Le hasard rapprocha en nous deux natures essentiellement objectives, je veux dire aussi dégagées qu’il est possible de l’étroit tourbillon qui fait de la plupart des consciences un petit gouffre égoïste comme le trou conique du formica-leo."
                            }
                        ]
                    }
