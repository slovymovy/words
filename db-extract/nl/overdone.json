                            {
                                "example_id": "49c8e27e-255d-49b8-bacf-9a2961a52864",
                                "sense_id": "4384999a-ff4b-3d47-9510-ada4e50f4bc6",
                                "text": "Private Banker André Sirks van Theodoor Gilissen noemde de koersreactie vrijdagmiddag wat 'overdone'. Ze kopen maar 2 procent van het aandelenkapitaal in."
                            },
                            {
                                "example_id": "ff11896f-a4e3-4f68-a365-9d49a12afdbf",
                                "sense_id": "4384999a-ff4b-3d47-9510-ada4e50f4bc6",
                                "text": "De bewonerscommissie van O-kwadraat kreeg meteen een aantal boze reacties. En dan niet alleen van fietsers die moeten omrijden, maar ook uit eigen kring. „Deze oplossing is een beetje overdone”, zegt bewoner Piet de Bekker."
                            },
                            {
                                "example_id": "9e48dffe-3ac7-4fd8-820f-b4c2b7ad7c1a",
                                "sense_id": "4384999a-ff4b-3d47-9510-ada4e50f4bc6",
                                "text": "En Jessica de Bruijn richt zich persoonlijk tot de acteur: ,,Je doet Beau echt goed na, zelfs niet overdone, klopt gewoon precies in de TV kantine.” Ook Q-music-dj Domien Verschuuren is enthousiast: ,,Maarten Heijmans als Beau en Elise Schaap als Nikkie. Wow, haha”, twittert hij met een applaus-emoji erachteraan."
                            }
                        ]
