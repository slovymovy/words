                    "sense_id": "a82ad943-8ed3-3972-b586-8ddc4ee5726b",
                    "sense_definition": "Een bepaalde afstand overbruggen door te reizen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moesten een lange weg <w>afleggen</w> om bij het vakantiehuisje te komen.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>преодолеть</w> долгий путь, чтобы добраться до летнего домика.",
                                "en": "We had to <w>travel</w> a long way to get to the holiday cottage.",
                                "fr": "Nous avons dû <w>parcourir</w> une longue distance pour arriver au chalet de vacances."
                            }
                        },
                        {
                            "text": "De wielrenner heeft de etappe in een recordtijd <w>afgelegd</w>.",
                            "target_lang_translations": {
                                "ru": "Велогонщик <w>преодолел</w> этап за рекордное время.",
                                "en": "The cyclist <w>covered</w> the stage in record time.",
                                "fr": "Le cycliste a <w>effectué</w> l'étape en un temps record."
                            }
                        }
                    ],
                    "synonyms": [
                        "overbruggen",
                        "volbrengen"
                    ],
                    "common_phrases": [
                        "een afstand afleggen",
                        "de weg afleggen",
                        "een route afleggen"
                    ],
                    "target_lang_definitions": {
