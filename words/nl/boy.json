                            "comment": "Koloniaal taalgebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指旧殖民地时期的）男性仆人或男佣。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "男仆",
