        "fr-extract.jsonl": [
            {
                "entry_id": "7ec1e5bd-a2fd-3f9a-93d0-472734652ed3",
                "word": "zazou",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1296b871-7bba-42d9-bf7d-2cdb05d3f50e",
                        "entry_id": "7ec1e5bd-a2fd-3f9a-93d0-472734652ed3",
                        "tags": [
                            "plural"
                        ],
                        "form": "zazous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19be9212-0ca4-3afa-a166-12537c1187aa",
                        "entry_id": "7ec1e5bd-a2fd-3f9a-93d0-472734652ed3",
                        "glosses": [
                            "Appellation donnée à des jeunes gens qui ont créé un courant de mode en France dans les années 1930. Ils étaient reconnaissables à leurs vêtements anglais ou américains, et affichaient leur amour du swing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4ab8ea3-c9d2-44e5-931b-fed9bcf120fb",
                                "sense_id": "19be9212-0ca4-3afa-a166-12537c1187aa",
                                "text": "Avoir vingt ans, vivre à l’époque la plus grandiose de l’histoire humaine, et faire le zazou physiquement et moralement… Quelle décrépitude et quelle déchéance !"
                            },
                            {
                                "example_id": "5c2c8d9f-64d9-49ca-96a5-66b4e0b0862f",
                                "sense_id": "19be9212-0ca4-3afa-a166-12537c1187aa",
                                "text": "L’orchestre municipal jouait Tino Rossi sur la place et les jeunes filles en herbe se laissaient volontiers brouter par les vacheries des zazous de la ville."
                            },
                            {
                                "example_id": "742d6adf-708b-41e3-9c32-7429e5b81d33",
                                "sense_id": "19be9212-0ca4-3afa-a166-12537c1187aa",
                                "text": "— Chef de file du mouvement zazou, Charles Trenet n’adhérera pas pour autant à la révolution be-bop qui déferle à la Libération."
                            },
                            {
                                "example_id": "ea54dc00-84a0-4e3c-a17d-f5f07cc041e5",
                                "sense_id": "19be9212-0ca4-3afa-a166-12537c1187aa",
                                "text": "L'autobus arrive\nUn zazou à chapeau monte\nUn heurt il y a\nPlus tard devant Saint-Lazare\nIl est question d'un bouton"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
