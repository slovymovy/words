                        "sense_id": "f439fa62-57fe-3a3c-85aa-e74e1db34886",
                        "entry_id": "7dcd1bf9-86e7-385e-86e3-6c9668a834e4",
                        "glosses": [
                            "The act of producing nonsense; the nonsense so produced."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "eb2ba536-f355-4a23-a2c9-85777374f585",
                                "sense_id": "f439fa62-57fe-3a3c-85aa-e74e1db34886",
                                "text": "\"Only a simple suffumigation,\" said the Baronet, \"accompanied by availing ourselves of the suitable planetary hour.\"\n\"Simple suffumigation? simple nonsensification—planetary hour? planetary fiddlestick!\""
                            },
                            {
                                "example_id": "1554fe0e-7d75-49ed-9fa1-3effa1523bfc",
                                "sense_id": "f439fa62-57fe-3a3c-85aa-e74e1db34886",
                                "text": "\"Nonsensification\": Senseless associations are concocted as a strategy of confusion, especially by compulsives."
                            },
                            {
                                "example_id": "08b1a8b3-5ba6-42a1-938d-6d0b4fbddd39",
                                "sense_id": "f439fa62-57fe-3a3c-85aa-e74e1db34886",
                                "text": "Simon Weil considered \"nonsensification\" to be characteristic of fascist regimes."
                            },
                            {
                                "example_id": "b280057b-797c-412c-bbac-37c45b9b3199",
                                "sense_id": "f439fa62-57fe-3a3c-85aa-e74e1db34886",
                                "text": "The Child's Conception of Space (Piaget & Inhelder, 1956) represents a tremendous mental effort to describe the metaphysical contents of Space, the marvelous monads, without really communicating it to anyone. . . . This book is an extraordinary example of nonsensification."
                            }
                        ]
                    }
