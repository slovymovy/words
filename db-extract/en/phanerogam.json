    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "74321daa-8636-3cb1-8c5a-6e30ddd800b0",
                "word": "phanerogam",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7fc4aeff-6835-475a-8fdf-0eb16051620b",
                        "entry_id": "74321daa-8636-3cb1-8c5a-6e30ddd800b0",
                        "tags": [
                            "plural"
                        ],
                        "form": "phanerogams"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "019eef83-1ff1-3c4f-a49a-d81491ca97c6",
                        "entry_id": "74321daa-8636-3cb1-8c5a-6e30ddd800b0",
                        "glosses": [
                            "Any plant that produces seeds (rather than spores)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c39f974-7699-4ec3-8eb3-204d1d4b7829",
                                "sense_id": "019eef83-1ff1-3c4f-a49a-d81491ca97c6",
                                "text": "Among phanerogams (seed plants), only two orders of gymnosperms, the Cycadales and the Ginkgoales, have ciliated motile sperm cells; all others (higher gymnosperms and angiosperms) have nonmotile sperm cells or sperm nuclei."
                            },
                            {
                                "example_id": "e9524c2e-8a32-4555-807f-bcf999444ac2",
                                "sense_id": "019eef83-1ff1-3c4f-a49a-d81491ca97c6",
                                "text": "The stomach contents of the Selerikanka horse contained 116 taxa: 96 phanerogams, 20 cryptogams. Among the phanerogams were 12 tree species, 14 species of shrubs and dwarf-shrubs, as well as 72 species of herbs and very small dwarf-shrubs."
                            },
                            {
                                "example_id": "2c26b904-3ed5-4977-a0d3-e7f7ee7f4b84",
                                "sense_id": "019eef83-1ff1-3c4f-a49a-d81491ca97c6",
                                "text": "Generally speaking, the ranges of most cryptogams are geographically broader than those of phanerogams, and many more species are widely disjunct over the world."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c47cc24b-d5fe-4b72-bfdb-9a1b45f42d88",
                        "source_entry_id": "74321daa-8636-3cb1-8c5a-6e30ddd800b0",
                        "source_sense_id": "019eef83-1ff1-3c4f-a49a-d81491ca97c6",
                        "source_sense_description": "plant that produces seeds",
                        "target_lang_word": "zaadplant",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zaadplant",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4d6d5e8a-5496-3b9e-8742-74973df773fc",
                                        "entry_id": "5c00ebbd-4817-3d5d-84eb-dde1970159ec",
                                        "glosses": [
                                            "benaming voor vaatplanten uit de Spermatophyta die zich voortplanten met zaden die ontstaan uit bevruchte zaadknoppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceac6952-3cd2-47c3-b1f2-55bec72ff1a0",
                                                "sense_id": "4d6d5e8a-5496-3b9e-8742-74973df773fc",
                                                "text": "Het is de oudste zaadplant ter wereld, een levend fossiel met een geschiedenis van meer dan 160 miljoen jaar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc85f5d3-14c6-300c-8558-00a11bbc086a",
                                        "entry_id": "5c00ebbd-4817-3d5d-84eb-dde1970159ec",
                                        "glosses": [
                                            "plant gekweekt om zaadjes te winnen die als zaaigoed gebruikt kunnen worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afa27e4b-31c3-4608-ba6b-58b4e97aa864",
                                                "sense_id": "cc85f5d3-14c6-300c-8558-00a11bbc086a",
                                                "text": "⧖ Wanneer de droge zaadplant ritselt in den najaarswind, denkt er geen een aan den bloesem, die er eenmaal over geurde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac04c915-9daa-401f-a7d7-d50b9dae59f0",
                        "source_entry_id": "74321daa-8636-3cb1-8c5a-6e30ddd800b0",
                        "source_sense_id": "019eef83-1ff1-3c4f-a49a-d81491ca97c6",
                        "source_sense_description": "plant that produces seeds",
                        "target_lang_word": "phanérogame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phanérogame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd574c4f-78c3-376f-8489-ca8180ea1ab3",
                                        "entry_id": "d2a62130-cc5f-3050-bab5-30ca3725c6c7",
                                        "glosses": [
                                            "Qualifie les plantes dont les organes de reproduction sont apparents, se reproduisant par fleurs et par graines, telles que les angiospermes et les gymnospermes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17c68143-ca75-4260-8cb1-54c598d54240",
                                                "sense_id": "dd574c4f-78c3-376f-8489-ca8180ea1ab3",
                                                "text": "En 1873, le bryologue Renaud publiait, en collaboration avec D. Laloy, un excellent Catalogue des plantes phanérogames et des Mousses observées jusqu’à cette époque dans le département de la Haute-Saône […]"
                                            },
                                            {
                                                "example_id": "f1467b74-86dc-4ef9-a4d8-eef073695a30",
                                                "sense_id": "dd574c4f-78c3-376f-8489-ca8180ea1ab3",
                                                "text": "D'autres enfin, notamment l’acide 2-4-dichlorophénoxyacétique, l’acide 2-méthyl-4-chlorophénoxyacétique, etc., provoquent une intoxication sélective de certaines Phanérogames ; à dose convenable, elles détruisent la plupart des Dicotylédones, mais ne troublent pas le développement de nombreuses Monocotylédones, en particulier, elles n'agissent guère sur les Graminées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phanérogame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7dc4a8-68ba-3a89-9ffb-5b74c49c28a8",
                                        "entry_id": "2f093d6e-fcae-3182-af68-2e95f8d3757d",
                                        "glosses": [
                                            "Plante se reproduisant par fleurs et par graines, telles qu’un angiosperme ou un gymnosperme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83aa9534-7ba3-40c6-9e17-577abdd0a617",
                                                "sense_id": "4d7dc4a8-68ba-3a89-9ffb-5b74c49c28a8",
                                                "text": "On a comparé ces anomalies à la duplicature des fleurs chez les Phanérogames, et le Dʳ Maxwell Masters, rédacteur du Gardener’s Chronicle, considère les partitions anormales des fougères comme des sortes de superfétations organiques, un perfectionnement de la plante."
                                            },
                                            {
                                                "example_id": "131b74a7-b5ec-4b3e-aa44-624458042115",
                                                "sense_id": "4d7dc4a8-68ba-3a89-9ffb-5b74c49c28a8",
                                                "text": "La classe des phanérogames est plus nombreuse que celle des cryptogames."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
