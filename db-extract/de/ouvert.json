                                        "sense_id": "4d7fecc7-a114-336f-8e5b-1d3565635822",
                                        "entry_id": "43924013-813a-332b-ae3a-97320dd4c4cf",
                                        "glosses": [
                                            "Qualifie un conflit déclaré."
