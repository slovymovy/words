                "senses": [
                    {
                        "sense_id": "b64d1383-e781-350d-bd19-814579f065ba",
                        "entry_id": "f238dbe5-1933-3192-bf87-2ff442570554",
                        "glosses": [
                            "behorende bij de ouders van een kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8dcee98-826c-4073-950a-3bb42a043ff0",
                                "sense_id": "b64d1383-e781-350d-bd19-814579f065ba",
                                "text": "Een minderjarig kind valt nog onder het ouderlijk gezag."
                            },
                            {
                                "example_id": "e74a12d8-0f46-44cc-acbf-6ce1b3b8e299",
                                "sense_id": "b64d1383-e781-350d-bd19-814579f065ba",
                                "text": "De kinderen gingen na het overlijden van de ouders niet in het ouderlijk huis wonen."
                            },
                            {
                                "example_id": "13b7abf8-2809-4033-929b-3a7298f1daa0",
                                "sense_id": "b64d1383-e781-350d-bd19-814579f065ba",
                                "text": "'Dat is mijn ouderlijk huis."
                            },
                            {
                                "example_id": "ee3448f2-dd57-42d4-924d-ed3d28630075",
                                "sense_id": "b64d1383-e781-350d-bd19-814579f065ba",
                                "text": "Honderdvijftig jaar aan ouderlijk advies legde me bij dat vooroordeel geen strobreed in de weg, van Sigmund Freud tot Siblings Without Rivalry."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
