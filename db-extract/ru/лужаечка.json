                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e1c273-3697-4933-880a-fd602e42eed0",
                                "sense_id": "88ac6bd8-2651-320f-9173-e7521725ac23",
                                "text": "У меня, вишь, хозяин, на родине сплошь лужаечки, дитю споткнуться не обо что, и речка тихая, опрятная, в ра-иитничке течет."
                            }
                        ]
                    }
                ],
                "translations": [
