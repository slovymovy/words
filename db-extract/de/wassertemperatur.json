                    {
                        "form_id": "37ee774c-c037-400b-ae93-2ea9114713f7",
                        "entry_id": "089ebc7e-e533-304e-bb92-55bdc27fd52d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wassertemperaturen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                        "entry_id": "089ebc7e-e533-304e-bb92-55bdc27fd52d",
                        "glosses": [
                            "Temperatur des Wassers"
                        ],
                        "tags": [
                            "Ozeanographie"
                        ],
                        "examples": [
                            {
                                "example_id": "88e63a56-2754-46e5-b2a7-9834fa584d9a",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Seit etwa drei Monaten sind die Wassertemperaturen im Nordatlantik extrem hoch.“"
                            },
                            {
                                "example_id": "db6fb2e5-e87c-4e81-94b1-e3107bc92662",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Die insgesamt warmen Wassertemperaturen im Nordatlantik könnten tendenziell zu einem heißeren Sommer in Mitteleuropa führen bis hinein in den August.“"
                            },
                            {
                                "example_id": "c90ffd5d-a20c-47f6-b53d-0dd21acf6c9f",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "[Ertrinken:] „Die physiologische Antwort auf den Kontakt mit kaltem Wasser tritt bereits ab 20 °C Wassertemperatur auf, bedrohlicher ist der Bereich unter 15 °C Wassertemperatur.“"
                            },
                            {
                                "example_id": "7df1afa5-cb43-4984-9142-0a70950e1611",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Erst wenn die Wassertemperatur auch in größeren Tiefen unter den Gefrierpunkt absinkt, kann Meerwasser gefrieren.“"
                            },
                            {
                                "example_id": "bb65e35f-2ea5-4e72-b2e9-810ac62f32fd",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Auch im zentralen Mittelmeer liegt die Wassertemperatur mit 27 bis 30 Grad deutlich höher als normal.“"
                            },
                            {
                                "example_id": "e8592bc8-df9e-4ca1-8ada-bd29ff7d3f12",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Ein spannendes Detail: In der Tiefe beträgt die Wassertemperatur konstant etwa 4 Grad.“"
                            },
                            {
                                "example_id": "351d3a7d-3df3-40d1-87b3-b02c627dde8c",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Während die Wassertemperatur beispielsweise in Biel am Nachmittag nur knapp über 16 Grad klettert, kann man am anderen Ende des Sees in Le Landeron schon bei angenehmen 19 Grad im See baden.“"
                            },
                            {
                                "example_id": "0dc81c04-fa05-4bd8-be49-d9b4ba236eb5",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Die Wassertemperatur beeinflusst alle chemischen und biologischen Prozesse im Gewässer.“"
                            },
                            {
                                "example_id": "92d539a7-eb72-47b6-909f-1c3635cbdfc8",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Um Energie zu sparen, haben viele Schwimmbäder in Rheinland-Pfalz die Wassertemperatur im vergangenen Jahr gesenkt.“"
                            },
                            {
                                "example_id": "d4e6a129-ed00-436d-a679-5dd560207e4d",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Der Hamburger Schwimmbadbetreiber Bäderland will die Wassertemperatur vorerst an allen Standorten beibehalten. Um Energie zu sparen war die Temperatur Ende vergangenen Jahres um ein Grad gesenkt worden.“"
                            },
                            {
                                "example_id": "12fef844-87c0-4a0c-8e80-dbb16fa5835f",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Bei Temperaturen von mehr als 60 Grad werden Legionellen abgetötet. In Zeiten hoher Heiz- und Wasserkosten reduzieren jedoch viele Verbraucherinnen und Verbraucher und öffentliche Einrichtungen die Wassertemperatur und den Wasserverbrauch. Dadurch entstehen oft optimale Lebensbedingungen für Legionellen.“"
                            },
                            {
                                "example_id": "f6be5f00-e8b4-4da5-a74b-804742f81da7",
                                "sense_id": "b3b47f25-873f-3348-a79d-124bb15e4055",
                                "text": "„Der elektrische Widerstand R ist wegen des geringen Anteils an dissoziierten H+- und an OH--Ionen in reinem Wasser groß und die elektrische Leitfähigkeit k=1/R gering. Letztere liegt bei reinem Wasser je nach Wassertemperatur zwischen 1,6·10-6 und 20·10-6 S/m.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
