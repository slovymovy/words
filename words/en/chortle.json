{
    "word_family": [
        "chortling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a0bbfeb-754a-3606-baeb-00631b41899e",
                    "sense_definition": "A joyful, somewhat muffled laugh, similar to a snorting chuckle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "laughter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He frequently interrupted himself with <w>chortles</w> while he told us his favorite joke.",
                            "target_lang_translations": {
                                "pl": "Często przerywał sobie <w>rechotem</w>, opowiadając nam swój ulubiony dowcip."
                            }
                        },
                        {
                            "text": "A soft <w>chortle</w> escaped her lips when she saw the puppy playing.",
                            "target_lang_translations": {
                                "pl": "Cichy <w>chichot</w> wyrwał się z jej ust, gdy zobaczyła bawiącego się szczeniaka."
                            }
                        }
                    ],
                    "synonyms": [
                        "chuckle"
                    ],
                    "target_lang_definitions": {
                        "pl": "Radosny, nieco stłumiony śmiech, przypominający chrapliwe chichotanie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "chichot",
                                "target_lang_sense_clarification": "cichy, stłumiony śmiech"
                            },
                            {
                                "target_lang_word": "rechot",
                                "target_lang_sense_clarification": "głośny, chrapliwy śmiech"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe09f806-737b-3a97-94ff-063d8726d116",
                    "sense_definition": "A vocalization made by certain birds that sounds like a laugh.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird let out a strange <w>chortle</w> from the high branches of the tree.",
                            "target_lang_translations": {
                                "pl": "Ptak wydał z siebie dziwny <w>rechot</w> z wysokich gałęzi drzewa."
                            }
                        },
                        {
                            "text": "We heard the distinct <w>chortles</w> of the magpies in the early morning.",
                            "target_lang_translations": {
                                "pl": "Wczesnym rankiem słyszeliśmy wyraźne <w>rechoty</w> srok."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dźwięk wydawany przez niektóre ptaki, przypominający śmiech."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rechot",
                                "target_lang_sense_clarification": "dźwięk przypominający śmiech wydawany przez zwierzęta"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85ba673a-ab4f-348b-87f8-3038713f0773",
                    "sense_definition": "To laugh in a joyful, muffled, or snorting way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "laughter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old fellow <w>chortled</w> as he recalled his youthful adventures.",
                            "target_lang_translations": {
                                "pl": "Staruszek <w>rechotał</w>, wspominając swoje młodzieńcze przygody."
                            }
                        },
                        {
                            "text": "He <w>chortled</w> with joy after hearing the wonderful news.",
                            "target_lang_translations": {
                                "pl": "<w>Zachichotał</w> z radości po usłyszeniu wspaniałych wieści."
                            }
                        }
                    ],
                    "synonyms": [
                        "chuckle"
                    ],
                    "target_lang_definitions": {
                        "pl": "Śmiać się w radosny, stłumiony lub chrapliwy sposób."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rechotać",
                                "target_lang_sense_clarification": "śmiać się chrapliwie"
                            },
                            {
                                "target_lang_word": "chichotać",
                                "target_lang_sense_clarification": "śmiać się cicho i wesoło"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}