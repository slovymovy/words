                                "target_senses": [
                                    {
                                        "sense_id": "65c66372-e8e0-306f-9ce8-954950555b50",
                                        "entry_id": "4090c8d1-69aa-3a9f-8a1e-01db6adeafab",
                                        "glosses": [
                                            "A reverential kiss on the footwear of the pope or other revered figure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae6de03a-e1c4-405f-946b-f169ac6e17c4",
                                                "sense_id": "65c66372-e8e0-306f-9ce8-954950555b50",
                                                "text": "A foot kiss leaves no shred of doubt about the pecking order."
                                            },
                                            {
                                                "example_id": "e51055b8-3bea-4bf4-bc7b-817bef4847e7",
                                                "sense_id": "65c66372-e8e0-306f-9ce8-954950555b50",
                                                "text": "At the formal introduction, that is when the bride and bridegroom were brought together, K. did not offer her husband a foot kiss, and oh, what a murmur did that not produce amongst the family, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
