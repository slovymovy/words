            "pos": "noun",
            "senses": [
                {
                    "sense_id": "658c638d-4f2a-384c-8e72-23ecec54d97b",
                    "sense_definition": "Sentiment de sérénité, de paix intérieure et de bonheur complet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bien_etre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue promenade en forêt, elle éprouvait une immense <w>plénitude</w>."
                        },
                        {
                            "text": "Ce lieu calme procure un profond sentiment de <w>plénitude</w> à tous les visiteurs."
                        }
                    ],
                    "synonyms": [
                        "sérénité",
                        "épanouissement",
                        "béatitude"
                    ],
                    "antonyms": [
                        "vide",
                        "angoisse"
                    ],
                    "common_phrases": [
                        "sentiment de plénitude",
                        "état de plénitude"
                    ]
                },
                {
                    "sense_id": "a77ddead-a464-3ae6-aa1b-27242d6b29e3",
                    "sense_definition": "Caractère d'une chose qui est totale, entière, au plus haut degré de sa force ou de son étendue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "completude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'athlète a retrouvé la <w>plénitude</w> de ses moyens physiques après plusieurs mois d'entraînement."
                        },
                        {
                            "text": "Le juge exerce sa fonction dans la <w>plénitude</w> de ses prérogatives officielles."
                        }
                    ],
                    "synonyms": [
                        "intégralité",
                        "totalité",
                        "complétude"
                    ],
                    "antonyms": [
                        "insuffisance",
                        "défaillance"
                    ],
                    "common_phrases": [
                        "plénitude de ses moyens",
                        "plénitude de ses facultés"
                    ]
                },
                {
                    "sense_id": "2ec8008a-3acd-3bfc-b45b-e1a82cf3cc98",
                    "sense_definition": "État physique de ce qui est plein ou qui a des formes pleines et généreuses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>plénitude</w> des formes de cette sculpture rappelle l'art classique de l'Antiquité."
                        },
                        {
                            "text": "Un repas trop copieux provoque parfois une désagréable sensation de <w>plénitude</w> gastrique."
                        }
                    ],
                    "synonyms": [
                        "rondeur",
                        "réplétion"
                    ],
                    "antonyms": [
                        "vacuité",
                        "creux"
                    ],
                    "common_phrases": [
                        "plénitude de l'estomac"
                    ]
                },
                {
                    "sense_id": "be8cfb0d-a29f-38b5-bb4d-0d35dde86e36",
                    "sense_definition": "Totalité et intensité des sentiments qui remplissent le cœur d'une personne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle lui a fait cet aveu dans la <w>plénitude</w> de son cœur."
                        },
                        {
                            "text": "C'est dans la <w>plénitude</w> de son affection qu'il a choisi de soutenir ses amis."
                        }
                    ],
                    "synonyms": [
                        "intensité",
                        "ardeur"
                    ],
                    "antonyms": [
                        "indifférence"
                    ],
                    "common_phrases": [
                        "plénitude de son cœur"
                    ]
                }
            ]
        }
    ]
