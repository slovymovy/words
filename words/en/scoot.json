                            },
                            {
                                "target_lang_word": "rychlý posun",
                                "target_lang_sense_clarification": "rychlý malý posun"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kayma",
                                "target_lang_sense_clarification": "kısa süreli yer değiştirme hareketi"
                            },
                            {
                                "target_lang_word": "yana çekilme",
                                "target_lang_sense_clarification": "yer açmak için yapılan ani hareket"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcab7a8f-4930-3e02-ad68-13c6a1fb1373",
                    "sense_definition": "A scooter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He parked his <w>scoot</w> near the entrance of the building.",
