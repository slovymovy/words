                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d5cc02-7583-45d5-868e-6d7cff197c78",
                                "sense_id": "766e33f7-cd83-33c1-a6e4-ace12c4ecfa4",
                                "text": "Elles sont travaillées par les femmes chinoises […]. Elles sont ensuite redévidées, ce qui augmente la main-d'œuvre et le prix."
                            },
                            {
                                "example_id": "ad2cf557-3e34-4112-ac9f-6c712dcad5c7",
                                "sense_id": "766e33f7-cd83-33c1-a6e4-ace12c4ecfa4",
                                "text": "— C’est une vérité ; je vous parcours, je vous dévide, je vous redévide ; je passe par mille endroits tristes, fâcheux, d’autres doux et sensibles"
                            }
                        ]
                    }
