                    }
                ],
                "translations": [
                    {
                        "translation_id": "015f659c-c2bf-47c3-8869-a292acadff28",
                        "source_entry_id": "c3d0877c-b568-3d6d-b132-2d5c65cfc68b",
                        "target_lang_word": "Bettpfanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettpfanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc3c3aaa-39b7-39ff-a482-d837db31265b",
                                        "entry_id": "69157a5e-100c-34c3-80a4-ebcba612ef17",
                                        "glosses": [
                                            "Behältnis für die Ausscheidung von Kot und Urin im Liegen, das vor allem in Krankenhäusern eingesetzt wird"
                                        ],
                                        "tags": [
                                            "Pflege"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "743b1964-a66b-475e-9209-3ab17798d316",
                                                "sense_id": "cc3c3aaa-39b7-39ff-a482-d837db31265b",
                                                "text": "„Einmal fand ich eine Bettpfanne aus Edelstahl, ein anderes Mal eine Chirurgenschere (für die Bettpfanne hatte ich keine Verwendung, aber die Schere war in der Küche verdammt praktisch).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e6954bb-7ade-3ab7-9698-9d8d2af194f6",
                                        "entry_id": "69157a5e-100c-34c3-80a4-ebcba612ef17",
                                        "glosses": [
                                            "mit glühenden Holzkohlen bestücktes Behältnis zum Wärmen einer Schlafstätte"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f457041f-f666-421d-b030-abc33650794d",
                                                "sense_id": "1e6954bb-7ade-3ab7-9698-9d8d2af194f6",
                                                "text": "„Auch Vorläufer unserer heutigen Wärmflasche, Zinn- oder Kupferbehälter gefüllt heißem Wasser, waren im Einsatz. Am wirkungsvollsten erwies sich aber die Benutzung der Bettpfanne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa642811-1648-4c47-934a-f74a34c6ddf0",
                        "source_entry_id": "c3d0877c-b568-3d6d-b132-2d5c65cfc68b",
                        "target_lang_word": "warming pan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warming pan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a876db2-c80c-35c2-a630-07794cf7f73c",
                                        "entry_id": "5a64e2dd-516b-3e36-8984-038abd9195e9",
                                        "glosses": [
                                            "A covered metal pan attached to a long handle, holding live coals and used to warm a bed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa1caf5-7295-4818-8b3a-1372eb209560",
                                                "sense_id": "6a876db2-c80c-35c2-a630-07794cf7f73c",
                                                "text": "Good Bardolfe / Put thy noſe betweene the ſheetes, and do the office of a warming pan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c304228-0893-3779-8952-8abbf024b87a",
                                        "entry_id": "5a64e2dd-516b-3e36-8984-038abd9195e9",
                                        "glosses": [
                                            "A person put into a situation to hold it until another person can take over."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67b0589b-438c-4d4e-bd58-3690656baea4",
                                                "sense_id": "7c304228-0893-3779-8952-8abbf024b87a",
                                                "text": "[…] who speedily installed his Son […] into the office of Collector of Taxes, as a warming-pan, or locum tenens, till his Father-in-Law's twelvemonths of mock-heroic dignity had expired—or he should think proper to resume the Collectorship."
                                            },
                                            {
                                                "example_id": "96f88027-e2f5-422e-b510-8d6a92ef9714",
                                                "sense_id": "7c304228-0893-3779-8952-8abbf024b87a",
                                                "text": "We used to call him in my parliamentary time W. P. Adams, in consequence of his being Warming Pan for a young fellow who was in his minority."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
