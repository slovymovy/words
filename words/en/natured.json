    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "56cffa5a-0001-317f-b14d-734749b83b63",
                    "sense_definition": "Having a particular type of personality or temperament.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a very kind-<w>natured</w> person who always helps others.",
                            "target_lang_translations": {
                                "pl": "Jest osobą o bardzo <w>dobrym usposobieniu</w>, która zawsze pomaga innym."
                            }
                        },
                        {
                            "text": "The dog is sweet-<w>natured</w> and loves to play with children.",
                            "target_lang_translations": {
                                "pl": "Ten pies ma <w>łagodne usposobienie</w> i uwielbia bawić się z dziećmi."
                            }
                        }
                    ],
                    "synonyms": [
                        "tempered",
                        "dispositioned"
                    ],
                    "common_phrases": [
                        "good-natured",
                        "sweet-natured",
                        "ill-natured"
                    ],
                    "target_lang_definitions": {
                        "pl": "Posiadający określony typ osobowości lub usposobienia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "o usposobieniu",
                                "target_lang_sense_clarification": "używane w połączeniach, np. o dobrym usposobieniu"
                            },
                            {
                                "target_lang_word": "o charakterze",
                                "target_lang_sense_clarification": "określające cechę osobowości"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d24ffd1e-f941-3f13-ac25-d5910e29aaa4",
                    "sense_definition": "Simple past and past participle of <w>nature</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammatical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landscape was <w>natured</w> by centuries of careful cultivation.",
                            "target_lang_translations": {
                                "pl": "Krajobraz został <w>ukształtowany</w> przez wieki starannej uprawy."
                            }
                        },
                        {
                            "text": "He <w>natured</w> the garden until it looked perfect.",
                            "target_lang_translations": {
                                "pl": "Zadbał o naturę ogrodu, aż wyglądał idealnie, <w>kształtując</w> go według własnego zamysłu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb nature."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów czasu przeszłego czasownika 'nature' (kształtować naturę czegoś)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ukształtowany",
                                "target_lang_sense_clarification": "w kontekście wpływu na naturę lub charakter czegoś"
                            },
                            {
                                "target_lang_word": "uformowany",
                                "target_lang_sense_clarification": "w kontekście nadawania kształtu lub charakteru"
                            }
                        ]
                    }
                }
            ]
        }
    ]
