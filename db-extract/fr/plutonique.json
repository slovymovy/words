                        "sense_id": "b7b27394-cbf8-308a-8278-bbc5841e4ca1",
                        "entry_id": "fd964d13-e8be-3981-bb75-86480cb5546d",
                        "glosses": [
                            "Se dit des terrains qui ont été produits par les feux souterrains, magmatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b475b8-b5d7-4a35-a868-1e603b931cd8",
                                "sense_id": "b7b27394-cbf8-308a-8278-bbc5841e4ca1",
                                "text": "Force plutonique, force de chaleur qui s'exerce dans l'intérieur du globe terrestre."
                            },
                            {
                                "example_id": "4e2044df-c581-4c98-972a-9a57f183fb61",
                                "sense_id": "b7b27394-cbf8-308a-8278-bbc5841e4ca1",
                                "text": "Avec ses plateaux livrés à la culture, ses luxuriants pâturages, ses vallées capricieusement dessinées, ses cimes sourcilleuses, la Transylvanie, zébrée par les ramifications d’origine plutonique des Carpathes, est sillonnée de nombreux cours d’eaux."
                            }
                        ]
                    },
