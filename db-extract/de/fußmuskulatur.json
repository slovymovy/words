                "senses": [
                    {
                        "sense_id": "72eb5e50-0cd6-359c-94e6-ef0c2dbd5dc1",
                        "entry_id": "d5d31643-e2fc-311e-95c3-7eba998bb56e",
                        "glosses": [
                            "Gesamtheit der Muskeln im Fuß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09654c15-46df-41bf-9cfc-17caf004b724",
                                "sense_id": "72eb5e50-0cd6-359c-94e6-ef0c2dbd5dc1",
                                "text": "„Ein regelmäßiges Kräftigungstraining der intrinsischen Fußmuskulatur wirkt prophylaktisch.“"
                            },
                            {
                                "example_id": "39b26a9a-7309-425a-b6e1-78f447e651fa",
                                "sense_id": "72eb5e50-0cd6-359c-94e6-ef0c2dbd5dc1",
                                "text": "„An sich ist es das Beste, Babys und Kinder möglichst viel barfuß laufen zu lassen, um die Fußmuskulatur zu stärken.“"
                            },
                            {
                                "example_id": "66b8eb53-d35e-44bb-9138-37395bc3513d",
                                "sense_id": "72eb5e50-0cd6-359c-94e6-ef0c2dbd5dc1",
                                "text": "„Seilspringen ist eine weitere effektive Übung, um die Fußmuskulatur zu trainieren, da Sie hierbei ständig auf den Fußballen landen und abdrücken.“"
                            },
                            {
                                "example_id": "8099738d-d0ae-44a5-b954-af5e7cbe5202",
                                "sense_id": "72eb5e50-0cd6-359c-94e6-ef0c2dbd5dc1",
                                "text": "„Mit den kleinen Gummibällen kann man besonders die Verspannungen an Hand- und Fußmuskulatur lösen.“"
                            },
                            {
                                "example_id": "d1c5c898-a522-4850-bbca-8184e1e7234e",
                                "sense_id": "72eb5e50-0cd6-359c-94e6-ef0c2dbd5dc1",
                                "text": "„Barfußlaufen auf unebenen, sandigen oder profilreichen Böden stärkt die Fußmuskulatur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
