                "senses": [
                    {
                        "sense_id": "55080ab3-3904-3208-8289-69e47e351321",
                        "entry_id": "ff187506-a4ff-383f-ac15-16f03199ae91",
                        "glosses": [
                            "Nagelbohrer bestehen aus einem am Ende spiralförmig geformten Stahldraht, der oben entweder einen angenieteten Holzknebel oder eine aus dem Draht gebogene Schlaufe als Handgriff besitzt. Er dient vor allem zum Vorbohren von Löchern für Nägel im Holz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf4cbde4-4f75-43df-904f-ae33bf98a48b",
                                "sense_id": "55080ab3-3904-3208-8289-69e47e351321",
                                "text": "Die Handlichkeit des Nagelbohrers macht ihn zum beliebten Handbohrer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7c766c6-6d5e-4279-be16-349e600377d5",
                        "source_entry_id": "ff187506-a4ff-383f-ac15-16f03199ae91",
                        "source_sense_id": "55080ab3-3904-3208-8289-69e47e351321",
                        "target_lang_word": "gimlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gimlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80c1a6d9-5087-3941-bd82-16a39fc82091",
                                        "entry_id": "6c6365d7-5d49-3c62-912e-5679c676d329",
                                        "glosses": [
                                            "A small screw-tipped tool for boring holes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee9fdfb-fdf3-48d0-bbd1-cf77d736cdd4",
                                                "sense_id": "80c1a6d9-5087-3941-bd82-16a39fc82091",
                                                "text": "The box was close on every side, with a little door for me to go in and out, and a few gimlet holes to let in air."
                                            },
                                            {
                                                "example_id": "7642f41f-938f-43f2-ada3-cbb98d6381a2",
                                                "sense_id": "80c1a6d9-5087-3941-bd82-16a39fc82091",
                                                "text": "I would find by the edge of that water / The collar-bone of a hare / Worn thin by the lapping of water, / And pierce it through with a gimlet and stare [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa513b25-29df-37ba-9f38-55f4c733b128",
                                        "entry_id": "6c6365d7-5d49-3c62-912e-5679c676d329",
                                        "glosses": [
                                            "A cocktail, usually made with gin and lime juice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42454364-8520-415f-b5fc-79f767734fa3",
                                                "sense_id": "aa513b25-29df-37ba-9f38-55f4c733b128",
                                                "text": "We sat in a corner of the bar at Victor's and drank gimlets. “They don't know how to make them here,” he said. “What they call a gimlet is just some lime or lemon juice and gin with a dash of sugar and bitters. A real gimlet is half gin and half Rose's Lime Juice and nothing else. It beats martinis hollow.”"
                                            },
                                            {
                                                "example_id": "bbb62374-65d3-484d-9f37-42a8f34eb35d",
                                                "sense_id": "aa513b25-29df-37ba-9f38-55f4c733b128",
                                                "text": "Yeah, a piece of advice — once you’re back in circulation, don’t keep topping off a lady’s vodka gimlet when she’s not looking."
                                            },
                                            {
                                                "example_id": "6a462c2b-60a4-425b-938e-5c532e28e84d",
                                                "sense_id": "aa513b25-29df-37ba-9f38-55f4c733b128",
                                                "text": "By seven, dinner was under way, and a bottle of vodka gimlets and one of martinis were in the freezer, chilling."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gimlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "070e930f-8a11-3951-a9b0-2d29845af36d",
                                        "entry_id": "1ba96864-a279-3104-8ecb-af93b031e9b2",
                                        "glosses": [
                                            "To pierce or bore holes (as if using a gimlet)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7864208d-f589-4aad-9ea0-db1b34ac9984",
                                                "sense_id": "070e930f-8a11-3951-a9b0-2d29845af36d",
                                                "text": "Then there was an awful silence. The lady gimleted us again one by one with her blue eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "670c21cc-b5c7-3057-8254-6acfb25b5cdb",
                                        "entry_id": "1ba96864-a279-3104-8ecb-af93b031e9b2",
                                        "glosses": [
                                            "To turn round (an anchor) as if turning a gimlet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d8fe355-494d-47c5-9039-96db9932bac1",
                        "source_entry_id": "ff187506-a4ff-383f-ac15-16f03199ae91",
                        "source_sense_id": "55080ab3-3904-3208-8289-69e47e351321",
                        "target_lang_word": "vrille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vrille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "730cba5c-31e1-3056-8e46-4298dd20650f",
                                        "entry_id": "bfa299ec-4a66-3fe4-8da0-319e315734e7",
                                        "glosses": [
                                            "Pousse filiforme, en spirale avec laquelle la vigne et d’autres plantes grimpantes s’attachent aux corps qui sont près d’elles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd8dfb26-06bd-430d-886d-365e17e814e1",
                                                "sense_id": "730cba5c-31e1-3056-8e46-4298dd20650f",
                                                "text": "On nous a, en effet, envoyé pour la détermination une liane caoutchoutifère congolaise pouvant atteindre une quinzaine de mètres de hauteur et dont les tiges, privées de vrilles, sont volubiles."
                                            },
                                            {
                                                "example_id": "6f4e88a9-52c7-403e-94f9-7c560d7e5995",
                                                "sense_id": "730cba5c-31e1-3056-8e46-4298dd20650f",
                                                "text": "Pendant son sommeil, les cornes de la vigne, ces vrilles cassantes et tenaces, dont l’acidité d’oseille fraîche irrite et désaltère, les vrilles de la vigne poussèrent si dru, cette nuit-là, que le rossignol s’éveilla ligoté, les pattes empêtrées de liens fourchus, les ailes impuissantes…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a9d3a94-398f-3e82-92d0-0b53772f3e3b",
                                        "entry_id": "bfa299ec-4a66-3fe4-8da0-319e315734e7",
                                        "glosses": [
                                            "Outil de fer terminé par une mèche hélicoïdale, qui sert à faire des trous dans le bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed2e0d36-8836-46c0-bac4-3dbd0c7a3be7",
                                                "sense_id": "2a9d3a94-398f-3e82-92d0-0b53772f3e3b",
                                                "text": "Percer un trou dans une planche avec la vrille."
                                            },
                                            {
                                                "example_id": "ab4399df-37cb-4aff-82fa-92a1acb43e7d",
                                                "sense_id": "2a9d3a94-398f-3e82-92d0-0b53772f3e3b",
                                                "text": "Il y avait une ruse de chatte au fond de ses yeux noirs, étroits, pareils à des trous de vrille."
                                            },
                                            {
                                                "example_id": "34254dfe-2e1e-4a9b-9d3c-1f63e35f4bac",
                                                "sense_id": "2a9d3a94-398f-3e82-92d0-0b53772f3e3b",
                                                "text": "— Vous avez bien une vrille, une grosse vrille ?… Donnez-moi une vrille !\nVivement, Martine descendit à sa cuisine et rapporta l’outil demandé.\n— Comme ça, voyez-vous, nous ne ferons pas de bruit, reprit la vieille dame en se mettant à la besogne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd3689ad-12a1-38f9-a35b-27cb8bcc349b",
                                        "entry_id": "bfa299ec-4a66-3fe4-8da0-319e315734e7",
                                        "glosses": [
                                            "Fraise de dentiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11906419-e338-4179-a559-a61bfb964d9e",
                                                "sense_id": "bd3689ad-12a1-38f9-a35b-27cb8bcc349b",
                                                "text": "Autrefois, chez le dentiste, j’adoptais une tactique. Tandis qu’il perçait ma dent avec sa vrille, je portais ma pensée ailleurs. Je m’absorbais dans la contemplation des volets de la maison d’en face. Mais la douleur m’interpellait : « Occupe-toi de moi ! Moi seule existe ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c6b012-1eb6-3ad5-aacb-1d638676dcc8",
                                        "entry_id": "bfa299ec-4a66-3fe4-8da0-319e315734e7",
                                        "glosses": [
                                            "Pénétration aiguë."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e0fbef3-5409-440e-9aa8-a7d7a5895b71",
                                                "sense_id": "81c6b012-1eb6-3ad5-aacb-1d638676dcc8",
                                                "text": "La vrille de son regard perçant me mettait mal à l’aise."
                                            },
                                            {
                                                "example_id": "719ac707-3b7e-4754-bd56-d44bc3d88e27",
                                                "sense_id": "81c6b012-1eb6-3ad5-aacb-1d638676dcc8",
                                                "text": "C’est qu’elle a des yeux qui vous entrent au cœur comme des vrilles."
                                            },
                                            {
                                                "example_id": "2495daf2-9dec-46be-9f34-f9f59fb40971",
                                                "sense_id": "81c6b012-1eb6-3ad5-aacb-1d638676dcc8",
                                                "text": "Le jour de la foire, il avait fait connaissance d’une gamine de dix-sept ans, une pauvre fille quelconque, qui avait une drôle de petite figure et un regard en vrille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76557a4b-884e-31b4-b592-bab75fd4b969",
                                        "entry_id": "bfa299ec-4a66-3fe4-8da0-319e315734e7",
                                        "glosses": [
                                            "Mouvement, déplacement hélicoïdal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df9718c3-9a44-49c8-9fba-c3f3feaf3391",
                                                "sense_id": "76557a4b-884e-31b4-b592-bab75fd4b969",
                                                "text": "L’avion fait une vrille dans le ciel."
                                            },
                                            {
                                                "example_id": "ecba4093-1fb2-4f8e-ba04-725cc59db1e1",
                                                "sense_id": "76557a4b-884e-31b4-b592-bab75fd4b969",
                                                "text": "Une vrille avant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b62aad27-d6bf-3e64-af6b-1999bca19fee",
                                        "entry_id": "bfa299ec-4a66-3fe4-8da0-319e315734e7",
                                        "glosses": [
                                            "Lesbienne."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "126e9a87-5397-4aa6-a1fa-a7ac4112b743",
                                                "sense_id": "b62aad27-d6bf-3e64-af6b-1999bca19fee",
                                                "text": "Une vrille, à mon avis, est une femme qui n’a envie de creuser que les autres femmes."
                                            }
                                        ]
                                    }
                                ]
                            },
