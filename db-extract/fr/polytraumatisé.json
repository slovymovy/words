                        "glosses": [
                            "Qui a subi des traumatismes multiples."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a45912-dce4-451f-abcb-50c19d0ca36b",
                                "sense_id": "9267f05e-b9e6-3e1c-b317-4b4a4fd0062f",
                                "text": "C’est lui qui m’a permis de me redresser et de remarcher après qu’un chauffard m’a renversée à bicyclette quand j’avais 19 ans et laissée polytraumatisée, en miettes, quasi-amnésique, sur la chaussée."
                            }
                        ]
                    }
                ],
