                ],
                "senses": [
                    {
                        "sense_id": "9bbae0c5-439d-3a78-91e1-214eaf19ef9d",
                        "entry_id": "d22636c1-14ad-35fb-a7ca-e6090736210b",
                        "glosses": [
                            "Regierung in einem zentralistischen Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7acf67d-a1db-498f-9605-dc2ba1181a8a",
                                "sense_id": "9bbae0c5-439d-3a78-91e1-214eaf19ef9d",
                                "text": "„Der Kampf der unterschiedlichen Clans um die Vorherrschaft in Somalia zeigt sich nicht zuletzt in den Konflikten zwischen der Zentralregierung und den unterschiedlichen regionalen Einheiten.“"
                            },
                            {
                                "example_id": "7d0bb5e6-d9c0-4963-a9a9-f0a56c194463",
                                "sense_id": "9bbae0c5-439d-3a78-91e1-214eaf19ef9d",
                                "text": "„Einerseits erkennt er, dass Äthiopien inmitten der Kolonialmächte nur mit einer starken Zentralregierung und einer Wirtschaft, die auf den Weltmarkt ausgerichtet ist, überleben kann.“"
                            },
                            {
                                "example_id": "6c414a0f-2742-41c5-9869-59c00e773f4a",
                                "sense_id": "9bbae0c5-439d-3a78-91e1-214eaf19ef9d",
                                "text": "„Die Aufständischen warfen der Zentralregierung vor, den Löwenanteil für sich zu behalten.“"
                            },
                            {
                                "example_id": "45fe5302-baf6-4804-9897-767bb0d65c7d",
                                "sense_id": "9bbae0c5-439d-3a78-91e1-214eaf19ef9d",
                                "text": "„In der Zwischenzeit hatte die Zentralregierung im Kongo mit Präsident Lumumba an der Spitze beschlossen, Süd-Kasai in die Schranken zu weisen.“"
                            },
                            {
                                "example_id": "8f0d264b-04e5-45bc-ac31-1e579c38a405",
                                "sense_id": "9bbae0c5-439d-3a78-91e1-214eaf19ef9d",
                                "text": "„2010 wurden die Northern Areas in das Autonome Gebiet Gilgit-Baltistan umbenannt und erhielten eine größere Unabhängigkeit gegenüber der Zentralregierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
