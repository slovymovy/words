                "senses": [
                    {
                        "sense_id": "94941c90-ec82-3e7d-a6ec-bccf67611ed8",
                        "entry_id": "2c07c135-71fb-3d8f-af43-0af219679f1f",
                        "glosses": [
                            "platte structuur op een gebouw, vaartuig of gebied waarop een helikopter kan landen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f50b7b7-2154-45ee-9932-736284e09e6b",
                                "sense_id": "94941c90-ec82-3e7d-a6ec-bccf67611ed8",
                                "text": "Omdat Van der Most ook vaak gebruikmaakt van het helikopterplatform bij de Koperen Hoogte, ging het verhaal dat hij zelf in het toestel zat. Dat bleek niet te kloppen."
                            },
                            {
                                "example_id": "7279a09c-e6a9-4648-bf63-43e3bd8f1ceb",
                                "sense_id": "94941c90-ec82-3e7d-a6ec-bccf67611ed8",
                                "text": "De ceremonie werd gehouden op het helikopterplatform van het ziekenhuis in de havenplaats Msida. Militairen brachten de 24 lijkkisten binnen, 23 bruine voor volwassenen en één witte voor een tiener."
                            },
                            {
                                "example_id": "648eb1da-dbfa-4352-9293-3e1221eb7465",
                                "sense_id": "94941c90-ec82-3e7d-a6ec-bccf67611ed8",
                                "text": "Voor de spelen worden 7.500 militairen ingezet, ruim 13.000 particuliere beveiligers en duizenden agenten. Ook staan er gevechtsvliegtuigen op een vliegveld dichtbij de stad en ligt er een helikopterplatform in de rivier de Theems."
                            }
                        ]
                    }
