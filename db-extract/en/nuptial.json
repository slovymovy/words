                "translations": [
                    {
                        "translation_id": "4e88fc1e-ef7c-40a3-b31e-b385626178e0",
                        "source_entry_id": "3d8dee7f-4732-3009-be47-d80165a9e8ed",
                        "source_sense_description": "pertaining to wedding and marriage",
