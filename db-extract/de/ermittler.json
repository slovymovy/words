                "senses": [
                    {
                        "sense_id": "f7b76001-aaf4-31a5-823f-18220a217644",
                        "entry_id": "166b3173-b25f-3b34-bdea-0e7202a56416",
                        "glosses": [
                            "Person, die Ermittlungen/Nachforschungen durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e8f9353-fcf9-4db2-bdbb-8ef4d011e51a",
                                "sense_id": "f7b76001-aaf4-31a5-823f-18220a217644",
                                "text": "„Noch mehr Kopfzerbrechen aber bereitete den Ermittlern der Inhalt seiner Hosentasche: Dort fanden sie zwei beschriebene Papierzettel - die einzig möglichen Hinweise auf die mysteriösen Umstände dieses Todesfalls.“"
                            },
                            {
                                "example_id": "db417eb5-5ef1-4b34-a3eb-4e1e0c458546",
                                "sense_id": "f7b76001-aaf4-31a5-823f-18220a217644",
                                "text": "„Im Umgang mit Zeugen müssen die Ermittler besonders aufpassen.“"
                            },
                            {
                                "example_id": "29b16d74-954a-4eeb-8ab1-46a0979354a1",
                                "sense_id": "f7b76001-aaf4-31a5-823f-18220a217644",
                                "text": "„Internationale Ermittler haben nach Angaben von Europol eine Bande von Bücherdieben gefasst, die einen enormen finanziellen und einen unschätzbaren kulturellen Schaden angerichtet haben sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee1ecfba-5933-459a-8b73-a2ad28306bf6",
                        "source_entry_id": "166b3173-b25f-3b34-bdea-0e7202a56416",
                        "source_sense_id": "f7b76001-aaf4-31a5-823f-18220a217644",
                        "source_sense_description": "Person, die Ermittlungen/Nachforschungen durchführt",
                        "target_lang_word": "investigator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "investigator",
