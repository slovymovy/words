                "senses": [
                    {
                        "sense_id": "9eeb21a9-f0f3-34dd-a0c5-80eb4df4117a",
                        "entry_id": "24851eb2-7e0e-3a83-b05b-bfcf0a51d4f6",
                        "glosses": [
                            "Céder (ce qu’on avait acquis)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1899e1e9-d119-4f03-b436-34c05612ddab",
                                "sense_id": "9eeb21a9-f0f3-34dd-a0c5-80eb4df4117a",
                                "text": "Cette fois, tu peux y aller, le principe de la correspondance est suffisamment \"désacquis\" pour que vous ayez des choses à vous dire !"
                            },
                            {
                                "example_id": "fb382771-e31d-4288-83bd-c7e57f3a59a2",
                                "sense_id": "9eeb21a9-f0f3-34dd-a0c5-80eb4df4117a",
                                "text": "J’ignore comment ou pourquoi ces propriétés ont été acquises puis désacquises."
                            },
                            {
                                "example_id": "5e592ddd-7f96-41a3-bcbf-87f21d1e231c",
                                "sense_id": "9eeb21a9-f0f3-34dd-a0c5-80eb4df4117a",
                                "text": "Existe-t-il en français un terme spécifique à une bibliothèque pour \"désacquérir\" ou céder par exemple des livres à double?"
                            },
                            {
                                "example_id": "0983ff66-ee6f-4ac0-88f8-47c843e4171f",
                                "sense_id": "9eeb21a9-f0f3-34dd-a0c5-80eb4df4117a",
                                "text": "C'est ni quelque chose qu'on peut acquérir facilement ni quelque chose qu'on peut désacquérir facilement."
                            },
                            {
                                "example_id": "9d3d8e59-60cb-4f93-92ec-d1717680111f",
                                "sense_id": "9eeb21a9-f0f3-34dd-a0c5-80eb4df4117a",
                                "text": "Mon jeunot il est déjà acquis, j'vais le désacquérir pour que le love game dure plus longtemps."
                            }
                        ]
                    }
                ],
