                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Davos",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77753970-45ca-3041-affb-79566cee01c4",
                                        "entry_id": "bc44eef5-2412-3e55-a8f3-1dc4b04c3776",
                                        "glosses": [
                                            "A mountain resort and municipality in Grisons, Switzerland, host of the World Economic Forum."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8477b8ef-e00b-3fe8-8110-248941972a31",
                                        "entry_id": "bc44eef5-2412-3e55-a8f3-1dc4b04c3776",
                                        "glosses": [
                                            "An annual meeting of business leaders, major politicians, economists, and other celebrities hosted by the World Economic Forum in the town of Davos, Switzerland at the end of January."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001b209f-13da-4626-a08e-a236aa308cec",
                                                "sense_id": "8477b8ef-e00b-3fe8-8110-248941972a31",
                                                "text": "“Don’t help elect Trump, you egotistical billionaire a**hole,” the protester yelled. “Go back to getting ratioed on Twitter. Go back to Davos with the other billionaire elites who think they know how to run the world. That’s not what democracy is.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb84ba82-d044-4b78-917c-e43b2405df24",
                        "source_entry_id": "31ab28d8-cf8e-3bc8-9494-dcbb55169310",
                        "source_sense_id": "95ab4780-518f-3c66-93cb-0c4f9c17dad3",
                        "source_sense_description": "eine Gemeinde im schweizerischen Kanton Graubünden",
                        "target_lang_word": "Davos",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Davos",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66bf2cd2-f5f0-340a-86ba-2e3df4d49325",
                                        "entry_id": "9e602e92-ded3-35ca-9f74-70e953141bfb",
                                        "glosses": [
                                            "Ville du canton des Grisons en Suisse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a7f6cee-ddda-35b5-bebf-a4259dbbae41",
                                        "entry_id": "9e602e92-ded3-35ca-9f74-70e953141bfb",
                                        "glosses": [
                                            "Le Forum économique mondial."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb64d020-959b-48bf-b661-adac865dfb9e",
                                                "sense_id": "0a7f6cee-ddda-35b5-bebf-a4259dbbae41",
                                                "text": "« Greta Thunberg déclare à Davos 2020 : Nous avons huit ans pour sauver le climat », a publié le compte de l’événement, renvoyant vers son site. La militante a réagi, niant avoir tenu ces propos. « Je n’ai jamais dit quelque chose comme cela, et je ne le dirai jamais, a-t-elle lancé sur Twitter. Il n’est jamais trop tard pour en faire le plus possible … »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4be530f7-103c-3c0f-8d81-88821a432232",
                                        "entry_id": "9e602e92-ded3-35ca-9f74-70e953141bfb",
                                        "glosses": [
                                            "Le monde de la finance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee954894-4f11-4ef5-8085-34053b6fd3b6",
                                                "sense_id": "4be530f7-103c-3c0f-8d81-88821a432232",
                                                "text": "Le remplacisme global est au pouvoir et il procède selon un mode de gouvernement que j’ai appelé, par opposition à la démocratie directe, la « davocratie » directe – le gouvernement par Davos -, sans intermédiaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
