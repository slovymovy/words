                "senses": [
                    {
                        "sense_id": "4eb8796b-b275-3c48-a630-ee72cecc8303",
                        "entry_id": "8f653379-62ae-390d-8864-a9d17cceb4e5",
                        "glosses": [
                            "Angriff, bei dem bewaffnete Drohnen eingesetzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69219f9a-8af9-4068-af3a-e3a54b68c7cb",
                                "sense_id": "4eb8796b-b275-3c48-a630-ee72cecc8303",
                                "text": "„Im Nordwesten von Pakistan sind am Montag bei zwei US-Drohnenangriffen insgesamt mindestens acht mutmaßliche Aufständische getötet worden.“"
                            },
                            {
                                "example_id": "45bfd760-c743-4c9b-8fae-e4361cec4bda",
                                "sense_id": "4eb8796b-b275-3c48-a630-ee72cecc8303",
                                "text": "„Den USA zufolge wurde der IS-Vize Fadhil Ahmed al-Hajali bei einem Drohnenangriff im Irak getötet.“"
                            },
                            {
                                "example_id": "e448903b-4d47-44ee-96ce-1df83311f544",
                                "sense_id": "4eb8796b-b275-3c48-a630-ee72cecc8303",
                                "text": "„Nach dem Drohenangriff in Saudi-Arabien sind die Ölpreise so sprunghaft gestiegen wie seit Beginn des Golfkrieges 1991 nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
