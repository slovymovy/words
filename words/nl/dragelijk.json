    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "549d5e78-b78a-364d-a397-6bf48831004b",
                    "sense_definition": "Iets dat men kan verdragen of accepteren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tolerantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hitte in de stad was vandaag nog net <w>dragelijk</w> door de wind.",
                            "target_lang_translations": {
                                "en": "The heat in the city was just <w>bearable</w> today because of the wind."
                            }
                        },
                        {
                            "text": "De pijn na de operatie was voor de patiënt goed <w>dragelijk</w>.",
                            "target_lang_translations": {
                                "en": "The pain after the surgery was quite <w>bearable</w> for the patient."
                            }
                        }
                    ],
                    "synonyms": [
                        "tolerabel",
                        "tolereerbaar"
                    ],
                    "antonyms": [
                        "ondragelijk",
                        "intolerabel"
                    ],
                    "common_phrases": [
                        "nog dragelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that can be endured or accepted."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bearable",
                                "target_lang_sense_clarification": "Capable of being endured or tolerated."
                            },
                            {
                                "target_lang_word": "tolerable",
                                "target_lang_sense_clarification": "Able to be accepted or allowed, though not necessarily pleasant."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0334df7f-dd69-3c6a-8bb3-72c2b4ef4960",
                    "sense_definition": "Niet ideaal of leuk, maar wel acceptabel in een moeilijke situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tolerantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het verlies van de wedstrijd was met deze score nog <w>dragelijk</w> voor het team.",
                            "target_lang_translations": {
                                "en": "The loss of the match was still <w>acceptable</w> for the team with this score."
                            }
                        },
                        {
                            "text": "De steun van vrienden maakte het lange wachten voor haar <w>dragelijk</w>.",
                            "target_lang_translations": {
                                "en": "The support of friends made the long wait <w>bearable</w> for her."
                            }
                        }
                    ],
                    "synonyms": [
                        "tamelijk",
                        "redelijk",
                        "houdbaar",
                        "duldbaar"
                    ],
                    "antonyms": [
                        "ondragelijk"
                    ],
                    "common_phrases": [
                        "maakt het dragelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "Not ideal or pleasant, but acceptable in a difficult situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "acceptable",
                                "target_lang_sense_clarification": "Satisfactory or adequate in a challenging context."
                            },
                            {
                                "target_lang_word": "manageable",
                                "target_lang_sense_clarification": "Able to be dealt with or controlled."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}