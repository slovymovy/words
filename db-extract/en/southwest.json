                                        "entry_id": "4410fd55-a7d3-38c7-b313-fb674c33c519",
                                        "glosses": [
                                            "die Nebenhimmelsrichtung, die dem Nordosten gegenüber und zwischen Süden und Westen liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3657093-b2db-42ec-9e0b-8638af6921d7",
                                                "sense_id": "69313fa9-8d04-361d-8e97-f4894ffe1aad",
                                                "text": "Der Weg biegt nach Südwesten ab."
                                            },
                                            {
                                                "example_id": "c17c4f53-3a10-4bb2-a912-2ed85dd30c59",
                                                "sense_id": "69313fa9-8d04-361d-8e97-f4894ffe1aad",
                                                "text": "„Von Südwesten her zog ein Gewitter auf, Blitze zuckten, und der Donner ließ die Fensterscheiben zittern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0cc62ff0-abb4-3779-bea3-b44dba51184c",
                                        "entry_id": "4410fd55-a7d3-38c7-b313-fb674c33c519",
                                        "glosses": [
                                            "der von der Mitte aus in dieser Richtung liegende Teil eines Gebiets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a4bf76-ac20-4a86-98c0-1f9f66e4be98",
                                                "sense_id": "0cc62ff0-abb4-3779-bea3-b44dba51184c",
                                                "text": "Wer es sich leisten kann, zieht als Rentner in den Südwesten."
                                            },
                                            {
                                                "example_id": "d48c17aa-b928-4092-a208-b91c3a0e80b9",
                                                "sense_id": "0cc62ff0-abb4-3779-bea3-b44dba51184c",
                                                "text": "„Anfang der Neunzigerjahre entdeckten Anthropologen bei der Ausgrabung einer kleinen Siedlung der Hisatsinom am Cowboy Wash im Südwesten des US-Bundesstaates Colorado in einer der Kivas einen Haufen durcheinandergewürfelter menschlicher Knochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
