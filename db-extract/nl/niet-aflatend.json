                        "glosses": [
                            "alsmaar doorwerkend, voortdurend doorgaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02dfe901-221e-4ae9-9b57-c5675e3064ec",
                                "sense_id": "df115cfb-b688-3082-a86e-72320c438f91",
                                "text": "Volgens de regels van het politieke spel geef je je tegenstander een faire kans om zich tijdens verkiezingen te manifesteren en, mocht dat leiden tot zetels, om vervolgens in de politieke arena niet-aflatend duidelijk te maken dat je het niet eens bent met zijn/haar standpunten."
                            },
                            {
                                "example_id": "b2cc509c-cda9-4c88-85aa-e157286f0809",
                                "sense_id": "df115cfb-b688-3082-a86e-72320c438f91",
                                "text": "Hoewel die aandacht niet-aflatend is, en er soms zelfs twee verkopers om je heen dansen om te laten zien dat je die Sonia Rykiel-rok ook nog op een andere manier kunt dragen – „zo, hoger in de taille, met een blouse erin” – is het nooit opdringerig."
                            }
                        ]
                    }
