                ],
                "senses": [
                    {
                        "sense_id": "333efca4-f1d0-3f6e-b4e9-723868085b97",
                        "entry_id": "5a66fbe8-e898-3a17-bdeb-11ac3798e2c0",
                        "glosses": [
                            "разг. представитель деклассированного слоя общества, отчужденный от собственности, оторванный от производственной деятельности, утративший профессиональную квалификацию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c85889b-3d96-4fd4-987e-9c00bb3b2cab",
                                "sense_id": "333efca4-f1d0-3f6e-b4e9-723868085b97",
                                "text": "На самом же деле прочитанная мною запись в анкете не имела к моему деду никакого отношения, а была вынужденной мерой, поскольку происхождение от люмпена или пропойцы считалось самым благонадежным в эпоху диктатуры пролетариата."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d22ff913-4af8-4035-b69d-c5183f7674b5",
                        "source_entry_id": "5a66fbe8-e898-3a17-bdeb-11ac3798e2c0",
                        "source_sense_id": "333efca4-f1d0-3f6e-b4e9-723868085b97",
                        "target_lang_word": "lumpen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lumpen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a30f58c-8a90-3b1b-830a-3d9e751a19f1",
                                        "entry_id": "3d99c4ab-d857-3139-b846-233fd241209c",
                                        "glosses": [
                                            "Of or relating to social outcasts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc6254e7-ae39-4c61-8a91-e5dacf3c5833",
                                                "sense_id": "1a30f58c-8a90-3b1b-830a-3d9e751a19f1",
                                                "text": "A little lumpen novelita. [Story of orphaned teenagers turning to crime.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6903d023-32bd-3810-9b38-98209521bca8",
                                        "entry_id": "3d99c4ab-d857-3139-b846-233fd241209c",
                                        "glosses": [
                                            "Of or relating to the lumpenproletariat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "739d25cf-181d-3c71-bdb2-66e7bcb0eea3",
                                        "entry_id": "3d99c4ab-d857-3139-b846-233fd241209c",
                                        "glosses": [
                                            "Plebeian."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lumpen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f5b03c8-3735-361d-b921-c4a3e8e09a51",
                                        "entry_id": "7abc9484-efe6-339b-9747-9c54d4170531",
                                        "glosses": [
                                            "A member of the lumpenproletariat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lumpen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12cde870-b7c7-3708-ac10-e14f98322e88",
                                        "entry_id": "72370e67-f9e9-3a9e-b138-42cc032043f8",
                                        "glosses": [
                                            "Lump-like."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "218c4360-92ad-41d1-9efc-a8002a126c93",
                                                "sense_id": "12cde870-b7c7-3708-ac10-e14f98322e88",
                                                "text": "Using the last two as an example, there is a constant sense of contrast in the poem, in this case between the streamlined ship which will surge through the water and the mere lumpen shape of the clumsy iceberg."
                                            },
                                            {
                                                "example_id": "0200c27c-e9bf-44cb-9974-9685546ef5a1",
                                                "sense_id": "12cde870-b7c7-3708-ac10-e14f98322e88",
                                                "text": "[About prominent critics lambasting his film 2001:] New York was the only really hostile city. Perhaps there is a certain element of the lumpen literati that is so dogmatically atheist and materialist and Earth-bound that it finds the grandeur of space and the myriad mysteries of cosmic intelligence anathema."
                                            },
                                            {
                                                "example_id": "232a7082-f6b4-4d81-be63-ca3646c28244",
                                                "sense_id": "12cde870-b7c7-3708-ac10-e14f98322e88",
                                                "text": "This something, which is neither body nor machine but interior and alien to them both, pertains to the 'meat' in Gibson's world insofar as the 'meat' - that useless corporeal remainder discarded by the machine - retains an excess that cannot be reduced to the lumpen mass of fleshy existence."
                                            },
                                            {
                                                "example_id": "b1ab0589-68e7-4cb7-8f2d-4c4144667011",
                                                "sense_id": "12cde870-b7c7-3708-ac10-e14f98322e88",
                                                "text": "Billy and Dandy had draped a tarp over the body but the shape itself looked lumpen and grotesque."
                                            },
                                            {
                                                "example_id": "eeeeadf9-8f94-4704-babe-d6fd47e14710",
                                                "sense_id": "12cde870-b7c7-3708-ac10-e14f98322e88",
                                                "text": "a slaloming winger putting lumpen defenders on their backsides, or even a sneaky centre-forward, using his boundless energy to lead the press and force mistakes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lumpen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e27ec93d-5ccc-3fa0-8691-8fa9e0062b35",
                                        "entry_id": "25ae596b-1124-36a3-833d-ce4d80e1f1c0",
                                        "glosses": [
                                            "To make or become like lumps; make or become lumpy"
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ff567f9-42f7-4a6d-a566-f95131892324",
                                                "sense_id": "e27ec93d-5ccc-3fa0-8691-8fa9e0062b35",
                                                "text": "They had chicken soup with the matzo meal balls a little lumpened by hurry, challah, roast chicken, kasha, honey-cake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
