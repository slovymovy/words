                    {
                        "sense_id": "0a05ce7d-f8e0-3cd4-a44b-8a591c548431",
                        "entry_id": "20d15365-87a6-3aeb-86a9-266d40731e61",
                        "glosses": [
                            "bepaald soort zeevis die voorkomt in de kustwateren van de Noordzee, Zoarces viviparus"
                        ],
                        "tags": [
                            "straalvinnigen"
                        ],
                        "examples": [
                            {
                                "example_id": "842abe4e-b8bc-44a7-9cb0-73cd89f4d5dc",
                                "sense_id": "0a05ce7d-f8e0-3cd4-a44b-8a591c548431",
                                "text": "Het Amerikaanse bedrijf AquaBounty introduceerde DNA van de Chinookzalm en van de Amerikaanse puitaal in het genetisch materiaal van Atlantische zalm."
                            },
                            {
                                "example_id": "258dd679-d354-4dc1-a5c5-db00976420d6",
                                "sense_id": "0a05ce7d-f8e0-3cd4-a44b-8a591c548431",
                                "text": "\"Een puitaal\", suggereert Shin. Dat is opmerkelijk, want de puitaal die ik vang, is meestal niet groter dan 12 centimeter. Deze is zeker 30 centimeter en nogal dik. De kleine puitaal zet ik altijd terug, maar zo'n grote wil ik wel opeten. Ik pak mijn knuppeltje en geef drie tikken op zijn kop."
                            },
                            {
                                "example_id": "43865c90-6206-4ed3-ade5-62578de30150",
                                "sense_id": "0a05ce7d-f8e0-3cd4-a44b-8a591c548431",
                                "text": "Bij binnenkomst op het ecologisch onderzoeksinstituut in IJmuiden valt meteen het zeeaquarium op, waarin harders en een zeebaars rondzwemmen; in een hoek ligt een puitaal."
                            }
                        ]
                    }
