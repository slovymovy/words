{
    "word_family": [
        "schommel",
        "schommelstoel",
        "schommelpaard",
        "schommeling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f4895cbf-a6df-38c2-8b5a-c3707b08f81b",
                    "sense_definition": "op een schommel heen en weer bewegen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysieke beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen vinden het heerlijk om urenlang in de speeltuin te <w>schommelen</w>.",
                            "target_lang_translations": {
                                "en": "The children love to <w>swing</w> in the playground for hours."
                            }
                        },
                        {
                            "text": "De hele dag <w>schommelt</w> Jantje tot hij ervan duizelt.",
                            "target_lang_translations": {
                                "en": "Jantje <w>swings</w> all day long until he feels dizzy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in de speeltuin schommelen",
                        "heen en weer schommelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move back and forth on a swing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "to ride on a playground swing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28976ce7-6395-3377-a2d4-811d9636f457",
                    "sense_definition": "langzaam heen en weer of van de ene naar de andere kant bewegen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boot begon gevaarlijk te <w>schommelen</w> door de harde wind op het meer.",
                            "target_lang_translations": {
                                "en": "The boat began to <w>rock</w> dangerously due to the strong wind on the lake."
                            }
                        },
                        {
                            "text": "Zij zat rustig in haar stoel te <w>schommelen</w> terwijl ze een boek las.",
                            "target_lang_translations": {
                                "en": "She sat quietly <w>rocking</w> in her chair while reading a book."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gevaarlijk schommelen",
                        "rustig schommelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move slowly back and forth or from side to side"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rock",
                                "target_lang_sense_clarification": "to move gently back and forth, like in a chair"
                            },
                            {
                                "target_lang_word": "sway",
                                "target_lang_sense_clarification": "to move slowly from side to side"
                            },
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "to move back and forth from a fixed point"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c28d8772-b525-392a-8982-136b34fe786b",
                    "sense_definition": "voortdurend veranderen tussen bepaalde waarden of niveaus",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "variatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De temperatuur zal de komende week tussen de tien en vijftien graden <w>schommelen</w>.",
                            "target_lang_translations": {
                                "en": "The temperature will <w>fluctuate</w> between ten and fifteen degrees over the coming week."
                            }
                        },
                        {
                            "text": "Door de nieuwe golf van aanslagen ging de olieprijs weer aan het <w>schommelen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the new wave of attacks, the oil price started to <w>fluctuate</w> again."
                            }
                        }
                    ],
                    "synonyms": [
                        "fluctueren"
                    ],
                    "common_phrases": [
                        "tussen waarden schommelen",
                        "aan het schommelen gaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to constantly change between certain values or levels"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fluctuate",
                                "target_lang_sense_clarification": "to rise and fall irregularly in number or amount"
                            },
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "to change significantly between two extremes"
                            },
                            {
                                "target_lang_word": "vary",
                                "target_lang_sense_clarification": "to change or be different"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}