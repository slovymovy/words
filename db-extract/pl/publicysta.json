                "senses": [
                    {
                        "sense_id": "8661b2d3-2864-3e0d-b105-8113a70cbefd",
                        "entry_id": "396efac0-1309-3410-9b45-4e12d267d585",
                        "glosses": [
                            "autor artykułów, felietonów i reportaży ogłaszanych w prasie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c222cb7-236a-41de-92a3-5d5451f87854",
                                "sense_id": "8661b2d3-2864-3e0d-b105-8113a70cbefd",
                                "text": "A pisarz i publicysta niemiecki Gottfried Kinkel napisał wprost: „Zmartwychwstanie Polski – siłą Niemiec\""
                            },
                            {
                                "example_id": "4e89e90b-aa72-4587-86aa-363b06bd205a",
                                "sense_id": "8661b2d3-2864-3e0d-b105-8113a70cbefd",
                                "text": "Dwuletni epizod z życia dziedzica tronu moskiewskiego, a następnie władcy Cesarstwa Rosyjskiego, uznawanego powszechnie u schyłku XIX wieku za najpotężniejsze mocarstwo światowe, wzbudzał zainteresowanie historyków i publicystów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "989aa69d-a458-4319-9c65-1a1374b2bfd4",
                        "source_entry_id": "396efac0-1309-3410-9b45-4e12d267d585",
