                    {
                        "sense_id": "a335086c-31a6-39a9-a8d8-b67abca6d6e0",
                        "entry_id": "d1cfb7b7-1085-326a-96ad-124fc7f01f7b",
                        "glosses": [
                            "Qui est en transhumance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99dcd256-8358-4c85-98ea-655ada1088b8",
                                "sense_id": "a335086c-31a6-39a9-a8d8-b67abca6d6e0",
                                "text": "Les troupeaux transhumants appartiennent tantôt à de riches propriétaires ou capitalistes, tantôt à de petits cultivateurs de Provence, qui les confient à un bayle ou berger chef qui, à ses risques et périls, conduit les troupeaux, loue les pâturages, etc., en un mot se charge de l'estivage moyennant une redevance."
                            },
                            {
                                "example_id": "58bbf9a6-6a55-486c-b13d-fea98e20cb19",
                                "sense_id": "a335086c-31a6-39a9-a8d8-b67abca6d6e0",
                                "text": "Les moutons transhumants portent, attachés leur laine, de nombreuses graines de la plaine vers la montagne et surtout de la montagne vers la plaine ; […]."
                            }
                        ]
                    }
