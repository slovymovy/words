                        "form": "den Wochenmarkt"
                    },
                    {
                        "form_id": "51eff184-ae77-4387-91f9-d3f5c7a35745",
                        "entry_id": "0279f0c6-7d5e-3d03-8230-4107d35f575b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wochenmärkte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88cb9436-1286-33e2-a97e-b2198ed5e784",
                        "entry_id": "0279f0c6-7d5e-3d03-8230-4107d35f575b",
                        "glosses": [
                            "wöchentlich stattfindender Markt, auf dem von regionalen Anbietern vor allem frische Lebensmittel angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cfc65d9-62b3-47be-89f1-c911e27ce3d9",
                                "sense_id": "88cb9436-1286-33e2-a97e-b2198ed5e784",
                                "text": "„Auf den Wochenmärkten der Stadt arbeitete er als Gemüseverkäufer.“"
                            },
                            {
                                "example_id": "6c168a24-d93d-4883-aa4b-2a0ea6696114",
                                "sense_id": "88cb9436-1286-33e2-a97e-b2198ed5e784",
                                "text": "„Die beiden hatten auf dem Wochenmarkt in Faranah ihren Fang verkauft und die Vorräte aufgefrischt.“"
                            },
                            {
                                "example_id": "3c061b84-3a79-4d3a-b060-2fd697c9da32",
                                "sense_id": "88cb9436-1286-33e2-a97e-b2198ed5e784",
                                "text": "„Der Wochenmarkt ist fast noch schlimmer, weil dort keine Preisschilder an den Waren sind.“"
                            },
                            {
                                "example_id": "0888470d-6d6f-48b3-a293-50d4e69a49a6",
                                "sense_id": "88cb9436-1286-33e2-a97e-b2198ed5e784",
                                "text": "„Mit der kleinen Witwenrente und dem Verkauf auf dem Wochenmarkt kommt sie jetzt gerade so über die Runden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a1f674e-c4f1-45b4-ae2a-681c3d6ac04e",
                        "source_entry_id": "0279f0c6-7d5e-3d03-8230-4107d35f575b",
                        "source_sense_id": "88cb9436-1286-33e2-a97e-b2198ed5e784",
                        "target_lang_word": "weekly market",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "efc5c9bd-6771-48e6-b166-60e06dbe60a9",
                        "source_entry_id": "0279f0c6-7d5e-3d03-8230-4107d35f575b",
                        "source_sense_id": "88cb9436-1286-33e2-a97e-b2198ed5e784",
                        "target_lang_word": "marché",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "365b6627-8990-3703-b6f1-54f61fdce1af",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Lieu public où s’achètent et se vendent les denrées, les marchandises, les objets d’usage courant. → voir marché-gare et place du marché"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3ecacd0-89f9-40ec-8c01-6a75931c3bf9",
                                                "sense_id": "365b6627-8990-3703-b6f1-54f61fdce1af",
                                                "text": "On n’entend plus que les cris des volailles et des porcs saignés ; les cheminées fument, tout Ramscapelle s’emplit de la joyeuse animation d’un marché oriental."
                                            },
                                            {
                                                "example_id": "c4e59a9d-b8e1-47f9-af9e-38e0bce7e3d3",
                                                "sense_id": "365b6627-8990-3703-b6f1-54f61fdce1af",
                                                "text": "Les charrettes et les chars étaient là dès potron-minet, voire dès la veille, car le marché était clappé dès prime ; il durait jusqu’à midi."
                                            },
                                            {
                                                "example_id": "b63d50f5-7392-46d5-8c5d-38125e3f9dad",
                                                "sense_id": "365b6627-8990-3703-b6f1-54f61fdce1af",
                                                "text": "Une petite phrase de Goscinny chante en lui, lui revient de l’époque où il lisait les épisodes du « Petit Nicolas » dans le journal Pilote : « Un marché, c’est comme une cour d’école qui sentirait bon. »"
                                            },
                                            {
                                                "example_id": "d6f64e6d-0674-4fca-95d9-2f6cef608669",
                                                "sense_id": "365b6627-8990-3703-b6f1-54f61fdce1af",
                                                "text": "Il reste le marché, d’un enjouement légèrement surjoué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "736cf3fc-374f-34c3-9380-d87d566bef14",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Place où l’on vend des marchandises particulières. → voir marché d’esclaves, marché aux fleurs, marché aux épices, marché aux poissons et marché aux puces"
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a872c14-e8df-478e-87f9-1ffc5ed96991",
                                                "sense_id": "736cf3fc-374f-34c3-9380-d87d566bef14",
                                                "text": "Varron n’évoque-t-il pas Éphèse comme le marché où on pourra trouver sans aucune difficulté un esclave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a1e12b4-2843-350e-b4a9-df760bced1d5",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Ville, pays où l’activité commerciale est importante."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "471313f7-b87d-4a5d-ab91-bb8d0974be92",
                                                "sense_id": "9a1e12b4-2843-350e-b4a9-df760bced1d5",
                                                "text": "Venise fut, au Moyen-Âge, le marché des épices de l’Occident."
                                            },
                                            {
                                                "example_id": "a6887a38-f893-4037-961b-685f1feb20ba",
                                                "sense_id": "9a1e12b4-2843-350e-b4a9-df760bced1d5",
                                                "text": "Dans l’Antiquité, l’île de Délos, dans les Cyclades, constituait à lépoque romaine un important marché d’esclaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c49a73e7-e615-39da-9a30-357b0b81176e",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Bâtiment abritant les emplacements dédiés. → voir marché couvert, supermarché et hypermarché"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c1ad0c0-4a01-4898-a373-db0c5f65bfcd",
                                                "sense_id": "c49a73e7-e615-39da-9a30-357b0b81176e",
                                                "text": "Le marché construit sur les mêmes terrains et d’après les plans de M. Molinos, architecte, a été inauguré […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1d919ea-9d67-3278-abf6-f4c856cedff3",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Lieu d’échange social. → voir économie de marché"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afb96f2f-93e1-44ed-9541-cd995d062436",
                                                "sense_id": "e1d919ea-9d67-3278-abf6-f4c856cedff3",
                                                "text": "Entre les deux camps se trouve le souk avec tous les éléments d’un marché indigène : marchands, conteurs d'histoires, jongleurs, charmeurs de serpents, danseuses, etc."
                                            },
                                            {
                                                "example_id": "91a2758a-f2b7-477e-8e33-eb85c226814f",
                                                "sense_id": "e1d919ea-9d67-3278-abf6-f4c856cedff3",
                                                "text": "Le marché, comme forme urbaine et institution sociale et économique, exprimerait ainsi un système urbain disparu mais qui continuerait à informer de nombreuses pratiques […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1906ff66-8cbb-3c50-87e9-2b7790765ebf",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Ce qu’on y achète. → voir faire son marché"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40900e52-4142-39ef-946d-3006d0dcd5f3",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Transaction entre un vendeur et un acheteur. → voir faire un marché et à bon marché"
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b380312e-5e43-4a48-b165-b5b10beb8318",
                                                "sense_id": "40900e52-4142-39ef-946d-3006d0dcd5f3",
                                                "text": "une fois conclu, le marché ne peut (plus) être suspendu ou déclaré dépourvu d’effets par l’instance de recours, quelle qu’elle soit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f8e5193-0e1d-363e-9f6a-bad079263b7b",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Espace où se font ces transactions. → voir marché immobilier, marché financier, marché d’actions, marché de gros, marché de détail, marché de l’emploi et …"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a596c68-3361-40cc-9c40-30bdc91f4c30",
                                                "sense_id": "4f8e5193-0e1d-363e-9f6a-bad079263b7b",
                                                "text": "On achetait des avenues, des tours, des hôtels, des avions… Ensuite on restaurait le tout à grand frais, et on remettait l’ensemble sur le marché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5335f2b5-6a4c-3ee2-9624-acd56fdc3271",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Valeur de référence pour une transaction. → voir cours du marché et marché conclu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4621dbf-9cf9-42e2-974d-6bb02d811028",
                                                "sense_id": "5335f2b5-6a4c-3ee2-9624-acd56fdc3271",
                                                "text": "Un pareil marché implique nécessairement deux opérations opposées l’une à l’autre et appliquées à la même valeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec7aa80f-b9a4-358c-987c-fb26d996c300",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Lieu où l’on fixe ces valeurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10559d74-1521-499b-a2cd-e34f48dd9861",
                                                "sense_id": "ec7aa80f-b9a4-358c-987c-fb26d996c300",
                                                "text": "Le marché de Paris; réglementation, fonctionnement, opérations, liquidation Oscar Bloch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9977aa8f-d89b-36ed-ad8e-aec5f5c58a6f",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Tendance pour l’évolution de cette valeur. → voir marché baissier et marché haussier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713b6c60-c756-495d-915f-093329f0bfee",
                                                "sense_id": "9977aa8f-d89b-36ed-ad8e-aec5f5c58a6f",
                                                "text": "Il peut y avoir des pressions pour combiner des lots, ce qui mène à la création d’un marché à la hausse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc4736ea-7fc4-30a9-bdc8-03edd8ba0a33",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Espace où on applique cette valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8af2467-f820-4907-aa0c-0a4ab3a29911",
                                                "sense_id": "cc4736ea-7fc4-30a9-bdc8-03edd8ba0a33",
                                                "text": "L’importance des politiques de prix et d’interventions sur les marchés agricoles est au cœur du débat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f37d7959-aff4-3989-ba20-0eb14a506f54",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "État de l’offre et de la demande. → voir marché du travail"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9127f91d-b015-4441-816c-77960b2afc01",
                                                "sense_id": "f37d7959-aff4-3989-ba20-0eb14a506f54",
                                                "text": "La théerie Sinagar, de Java, a préparé des tablettes de thé à destination du marché russe ; cette fabrication est maintenant abandonnée à Java."
                                            },
                                            {
                                                "example_id": "328a865d-2911-4fd5-995b-cfaa45e6a69c",
                                                "sense_id": "f37d7959-aff4-3989-ba20-0eb14a506f54",
                                                "text": "Les caractéristiques des principaux produits aphicides existant actuellement sur le marché sont les suivantes : La Nicotine […]."
                                            },
                                            {
                                                "example_id": "a776111b-591f-4868-9865-258d8adf74c1",
                                                "sense_id": "f37d7959-aff4-3989-ba20-0eb14a506f54",
                                                "text": "Face à la menace japonaise pesant sur le marché des fraises dentaires en Europe, la Commission de Bruxelles prend l'initiative de réunir les Ministres, les Ambassadeurs et les Experts pour convenir d’une Directive."
                                            },
                                            {
                                                "example_id": "6a20a377-a815-4a09-9a6d-14adbfa046d4",
                                                "sense_id": "f37d7959-aff4-3989-ba20-0eb14a506f54",
                                                "text": "Une forte concurrence existe sur le marché non seulement avec des entreprises occidentales mais aussi chinoises […]"
                                            },
                                            {
                                                "example_id": "0dd23250-e1a1-490d-814e-0512ac4642b3",
                                                "sense_id": "f37d7959-aff4-3989-ba20-0eb14a506f54",
                                                "text": "Tout marché fonctionne selon le principe universel de l’offre et de la demande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db9ad56-8d39-3d4c-8b25-2ae147c072e9",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Convention verbale ou écrite, renfermant les conditions d’une vente ou d’un échange. → voir faire un marché, marché commun et …"
                                        ],
                                        "tags": [
                                            "Économie politique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4354f8c-3ea4-4ed9-95c4-6823caa31f8e",
                                                "sense_id": "6db9ad56-8d39-3d4c-8b25-2ae147c072e9",
                                                "text": "Voilà le marché en vertu duquel, s’il y a hausse, le spéculateur est sûr de toucher la différence de bénéfices […]"
                                            },
                                            {
                                                "example_id": "d6eafbac-c0f7-42ab-b4f6-4b08b8031a77",
                                                "sense_id": "6db9ad56-8d39-3d4c-8b25-2ae147c072e9",
                                                "text": "Voici donc le marché que leur propose Charles le Simple : il leur confie la défense de Rouen d'Évreux et de Lisieux …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de0c83ec-aabd-361f-9c40-c83c34db4dcd",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Accord réglementant l’accès à un type de vente. → voir marché de l’or, marché public et autorisation de mise sur le marché"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6bada39-4274-472a-b201-29b2daea48b8",
                                                "sense_id": "de0c83ec-aabd-361f-9c40-c83c34db4dcd",
                                                "text": "Contrairement à la révision des prix qui est le rajustement de ceux-ci après un certain temps d’exécution du marché, l’actualisation est, en effet, une nouvelle réévaluation des prix […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "143be50d-0ffb-37dc-b1e2-e874622d3780",
                                        "entry_id": "c3b3d643-3e80-3f44-8e62-46c6d078abdb",
                                        "glosses": [
                                            "Réunion des industriels, producteurs, marchands, spéculateurs où se décident les prix d’un produit ou d’une denrée, où s’en établit le cours."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "296fc980-8b56-42f0-a92a-a14ddca03905",
                                                "sense_id": "143be50d-0ffb-37dc-b1e2-e874622d3780",
                                                "text": "Nos adversaires, les betteraviculteurs, simulent, d’un autre côté, de craindre de voir jeter sur le marché, déjà bondé d’alcool d’industrie, 5 à 600.000 hectolitres d’alcool de vin, et parfois même plus, et redoutent, de ce chef, de voir s’ajouter à la crise viticole celle des alcools, par la concurrence à bas prix qu’ils viendraient leur faire; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e46e24b-ad0a-3726-8efb-a385a94251c2",
                                        "entry_id": "7b28eb30-d5a7-3f56-b05d-a18cae070207",
                                        "glosses": [
                                            "Participe passé masculin singulier de marcher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be1b43e4-5699-48c6-a404-4b968b1c8fdc",
                                                "sense_id": "3e46e24b-ad0a-3726-8efb-a385a94251c2",
                                                "text": "Le feuillage de quelques arbustes froissés retentit dans le silence, comme le murmure d’une onde agitée ; mais quoiqu’ils prêtassent l’oreille pour saisir quelques nouveaux sons, la terre resta silencieuse et garda le secret des pas de l’inconnue, si toutefois elle avait marché."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
