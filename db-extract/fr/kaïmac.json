                        "entry_id": "c93fed43-1fe1-3502-9810-b13542b3fa00",
                        "glosses": [
                            "Crème caillée tirée du lait de buffle, aliment des Balkans, de Turquie, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8966db49-8772-4290-934a-74ef114095e1",
                                "sense_id": "63163aa9-c3b5-3eab-9611-d937b3cf00d9",
                                "text": "La sienne [femme] eut une envie ou plutôt une rage\nDe tâter d’un certain laitage\nQu’on nomme en turc du kaïmac."
                            },
                            {
                                "example_id": "602d8168-c0ec-4e2e-b810-8d7a1741c02e",
                                "sense_id": "63163aa9-c3b5-3eab-9611-d937b3cf00d9",
                                "text": "Du kaïmac piqué d’écorces de cédrat confit."
                            }
                        ]
                    }
