                        "examples": [
                            {
                                "example_id": "7977946b-4d60-4e53-8009-5d6e6af98e1d",
                                "sense_id": "6d7c7d06-81d3-3d9e-aa83-64321c9b2b64",
                                "text": "Meer dan twintig huizen bezochten we, maar dat droomhuis zat er niet tussen. Te hokkig, aan een te drukke weg, te weinig daglicht, te weinig tuin, te dicht op andere huizen, te weinig parkeerplek in de straat… De reden om een huis niet te kopen was steeds terug te voeren op één ding: ruimte."
                            }
