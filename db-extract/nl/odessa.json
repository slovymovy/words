                                        "entry_id": "510a169e-59cb-36f2-ae84-58cf70088e04",
                                        "glosses": [
                                            "drittgrößte, am Schwarzen Meer gelegene Stadt der Ukraine sowie Hauptort und Verwaltungssitz der Oblast Odessa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c174647c-2619-4bbe-a4dc-624e1f2c8aad",
                                                "sense_id": "e0270f40-11d4-374f-a83c-72a27b9899c8",
                                                "text": "Odessa ist eine Hafenstadt am Schwarzen Meer."
                                            },
                                            {
                                                "example_id": "2c132ece-eb47-40c4-96af-31be329d4df3",
                                                "sense_id": "e0270f40-11d4-374f-a83c-72a27b9899c8",
                                                "text": "„Die Gouvernanten unterhielten sich darüber, wo das Leben billiger sei, in Moskau oder in Odessa.“"
                                            },
                                            {
                                                "example_id": "0ee231e6-9bb3-4ce8-98cb-87ef292ac018",
                                                "sense_id": "e0270f40-11d4-374f-a83c-72a27b9899c8",
                                                "text": "„In Odessa beschloss im Februar 1918 ein Kongress ukrainischer Rabbiner die cherem (die jüdische Entsprechung zur Exkommunikation) gegenüber der Sowjetmacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
