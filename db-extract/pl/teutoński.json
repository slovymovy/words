                                        "sense_id": "f5e95082-ff00-35b3-bc1e-482eb210794c",
                                        "entry_id": "2689608c-17a9-3919-a98f-2719c54b4ba2",
                                        "glosses": [
                                            "An ancient Germanic, or modern German, individual."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
