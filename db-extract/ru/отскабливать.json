                "translations": [
                    {
                        "translation_id": "7db24999-9969-4471-a985-1b3285987209",
                        "source_entry_id": "9d014ea0-65f0-34ca-843a-f9a1f77a9f7a",
                        "source_sense_id": "5df59f15-ef8a-3a4b-b313-9548ce726df4",
                        "target_lang_word": "abschaben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abschaben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63aa92d7-bb23-3bd6-93ee-09b6089e3ddf",
                                        "entry_id": "6da7392f-e03b-3ef3-babd-b9e97501071a",
                                        "glosses": [
                                            "durch Schaben entfernen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76bc6579-62f2-4c10-bbe4-9bf57ccd94c0",
                                                "sense_id": "63aa92d7-bb23-3bd6-93ee-09b6089e3ddf",
                                                "text": "Für eine effektive Beseitigung der Honigflecken aus Teppichen ist es wichtig, einen Großteil der Verunreinigung mit einem Löffel oder Messer abzuschaben."
                                            },
                                            {
                                                "example_id": "68811e9a-10ea-4161-84d5-c08508438a3c",
                                                "sense_id": "63aa92d7-bb23-3bd6-93ee-09b6089e3ddf",
                                                "text": "Ruhig und still ließ er diese Scherze über sich ergehen; er verschlang große Bissen Brot, während er den Hühnerknochen abschabte mit der Sorgfalt eines Menschen, der den Wert eines Stückchens Fleisch zu schätzen weiß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f8aa6f6-468f-3ca3-b110-cea61e4524e3",
                                        "entry_id": "6da7392f-e03b-3ef3-babd-b9e97501071a",
                                        "glosses": [
                                            "durch Schaben etwas frei machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f066ff2-856a-42da-8f4f-6f15e3c1e6cd",
                                                "sense_id": "0f8aa6f6-468f-3ca3-b110-cea61e4524e3",
                                                "text": "Das Bärtlein hat er sich abgeschabt und das Kinn mit einem Schönpflästerlein belegt; ein neues, blaues Bändlein ist in den Zopf geflochten und auch eine kleine Gerte darein getan, dass er steifer in die Luft stehe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dc6f3e23-1bce-356f-8a98-0ecdcad2f30b",
                                        "entry_id": "6da7392f-e03b-3ef3-babd-b9e97501071a",
                                        "glosses": [
                                            "durch Gebrauch abwetzen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccabaec6-b991-455b-9ee1-ea5656e1b760",
                                                "sense_id": "dc6f3e23-1bce-356f-8a98-0ecdcad2f30b",
                                                "text": "Der großen Hitze zum Trotz stack er im langen, mit Pelz stark besetzten Ueberrocke, dessen Tuch sehr abgeschabt und verwettert aussah."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3b3a45c-8727-4a76-ac45-ab7738c681a3",
                        "source_entry_id": "9d014ea0-65f0-34ca-843a-f9a1f77a9f7a",
                        "source_sense_id": "5df59f15-ef8a-3a4b-b313-9548ce726df4",
                        "target_lang_word": "gratter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gratter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dba004ea-4d10-3438-a891-7ceb5ed63707",
                                        "entry_id": "51235623-c876-353e-963d-1a0b1d08d080",
                                        "glosses": [
                                            "Racler pour nettoyer, pour effacer ou pour polir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "330a7d0e-4ad8-4bb8-8164-7e5d0a74538b",
                                                "sense_id": "dba004ea-4d10-3438-a891-7ceb5ed63707",
                                                "text": "Mais Minouche tirait déjà un casier puis deux d’un vieux meuble de musée qu’elle avait découvert au marché aux puces et qu’elle avait, elle-même, gratté et reverni."
                                            },
                                            {
                                                "example_id": "849b2bf2-4bec-480b-82f7-2699114f671b",
                                                "sense_id": "dba004ea-4d10-3438-a891-7ceb5ed63707",
                                                "text": "Gratter un parchemin un papier pour enlever l’écriture."
                                            },
                                            {
                                                "example_id": "90efb3a3-351d-4beb-964c-b55329938022",
                                                "sense_id": "dba004ea-4d10-3438-a891-7ceb5ed63707",
                                                "text": "Ce mot a été gratté."
                                            },
                                            {
                                                "example_id": "666021c5-7c04-4b7e-a64f-825cbe97b54a",
                                                "sense_id": "dba004ea-4d10-3438-a891-7ceb5ed63707",
                                                "text": "Grattez plus fort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6ad2fbe-82b5-3ffa-8823-08c688d7f8d6",
                                        "entry_id": "51235623-c876-353e-963d-1a0b1d08d080",
                                        "glosses": [
                                            "Remuer avec ses ongles."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "817eb0eb-408a-4235-9990-953dcc8468e0",
                                                "sense_id": "b6ad2fbe-82b5-3ffa-8823-08c688d7f8d6",
                                                "text": "Un mandoliniste grattait son instrument comme dans un café de province où les habitués sont demeurés de mœurs paisibles."
                                            },
                                            {
                                                "example_id": "2d333826-1f63-4910-9057-56592570512b",
                                                "sense_id": "b6ad2fbe-82b5-3ffa-8823-08c688d7f8d6",
                                                "text": "Ses petits-enfants soufflottaient sur le divan ; elle grattait doucement la plante de leurs pieds roses pour améliorer les ris de leurs rêves enfantins."
                                            },
                                            {
                                                "example_id": "80947496-1369-4f95-8810-8bb28cb627b7",
                                                "sense_id": "b6ad2fbe-82b5-3ffa-8823-08c688d7f8d6",
                                                "text": "— J'en pense qu'une fille qui habite Le Faouët peut très bien faire ses courses à Gourin, si elle travaille quelque part entre les deux communes, voire même à Gourin, répliqua le retraité de sa grosse voix, en grattant sa barbe poivre et sel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6bf1f39-bf58-3a7a-a4d4-0ce693d64227",
                                        "entry_id": "51235623-c876-353e-963d-1a0b1d08d080",
                                        "glosses": [
                                            "Doubler, dépasser quelqu’un ou quelque chose."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82f1db3d-42f0-4d1c-96f4-e9fe7f3ed0c1",
                                                "sense_id": "d6bf1f39-bf58-3a7a-a4d4-0ce693d64227",
                                                "text": "Il m’a gratté au démarrage avec sa nouvelle voiture."
                                            },
                                            {
                                                "example_id": "71cb4561-b001-4c68-961d-cc1da3bf6e6b",
                                                "sense_id": "d6bf1f39-bf58-3a7a-a4d4-0ce693d64227",
                                                "text": "Plusieurs caravanes en profitent pour nous dépasser, d’où exaspération d’Alain. Après quoi, il prend la tête et traverse le glacier à une vitesse uniformément accélérée afin de « gratter » lesdites caravanes."
                                            },
                                            {
                                                "example_id": "17c4c414-cf2c-4410-8c00-e9134dd4b815",
                                                "sense_id": "d6bf1f39-bf58-3a7a-a4d4-0ce693d64227",
                                                "text": "Et c’est le moment, tout ce remue-ménage ça va faire de la place pour les gens qui veulent démarrer. Un comble serait de se faire gratter par les affectés spéciaux, planqués et serre-fesses ; vivement la classe, la classe !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a4543c-d4d6-3fb6-9c22-9c00564fab43",
                                        "entry_id": "51235623-c876-353e-963d-1a0b1d08d080",
                                        "glosses": [
                                            "Récupérer ; obtenir."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ac45e90-6403-4d46-a4c4-90056b084725",
                                                "sense_id": "16a4543c-d4d6-3fb6-9c22-9c00564fab43",
                                                "text": "Des gens ne viennent à certaines conférences que pour gratter des cadeaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4208b077-7e4b-3ec3-ab05-3fb1a68d715d",
                                        "entry_id": "51235623-c876-353e-963d-1a0b1d08d080",
                                        "glosses": [
                                            "(Vendée, Bretagne, Normandie, Île-de-France) Tricher à l’aide de gratte lors d’un examen."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b830c2ec-4528-38d9-93af-801339427ec7",
                                        "entry_id": "51235623-c876-353e-963d-1a0b1d08d080",
                                        "glosses": [
                                            "Travailler."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82a4e7f2-bacd-4ec2-854c-3d6fc0bf046e",
                                                "sense_id": "b830c2ec-4528-38d9-93af-801339427ec7",
                                                "text": "Comme il avait une poule dans la même boite où que j’grattais, il m’obligeait à partir avec elle le soir en y tenant le bras […]."
                                            },
                                            {
                                                "example_id": "cebbf849-ae49-475a-a734-377a7a79fcb3",
                                                "sense_id": "b830c2ec-4528-38d9-93af-801339427ec7",
                                                "text": "Il penche la tête, ça lui donne un air faux jeton, mais c'est la bonne pâte, il assure la tortore, c'est le seul qui gratte. Il dit qu'il est caissier. Si on le cuisine un peu, on apprend qu'il fabrique des caisses en bois dans une usine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2b64d8d-8abc-3504-8125-d894e13b6700",
                                        "entry_id": "51235623-c876-353e-963d-1a0b1d08d080",
                                        "glosses": [
                                            "Creuser ou approfondir sa recherche ou son enquête."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "676c2402-9374-4d79-8da6-363dbe54fe28",
                                                "sense_id": "b2b64d8d-8abc-3504-8125-d894e13b6700",
                                                "text": "Y a des gens, au début, ' sont sympas. Mais après, quand on gratte, on voit qu'ils sont pas sympas."
                                            },
                                            {
                                                "example_id": "ef16775c-db32-4538-a228-6460d7b40311",
                                                "sense_id": "b2b64d8d-8abc-3504-8125-d894e13b6700",
                                                "text": "Je repensais à ses paroles dans le bar, comme quoi il allait falloir gratter profond. Leveaux pris en flag chez le maire pendant son kidnapping... Et quand on gratte profond, Fowler, ça saigne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27f7e026-4eec-3d9e-a0be-2cba9d2ddb58",
                                        "entry_id": "51235623-c876-353e-963d-1a0b1d08d080",
                                        "glosses": [
                                            "Passer les ongles ou quelque chose de semblable, un peu fortement et à plusieurs reprises, sur quelque endroit du corps."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e9ecacf-a430-48e3-8b5d-d0b39ce4f572",
                                                "sense_id": "27f7e026-4eec-3d9e-a0be-2cba9d2ddb58",
                                                "text": "Il se gratte le front qu’un prurit tenace ne cesse de taquiner, et où fleurissent des taches rougeâtres."
                                            },
                                            {
                                                "example_id": "53666cd4-0766-4964-b4d9-7bbcb74aa6ff",
                                                "sense_id": "27f7e026-4eec-3d9e-a0be-2cba9d2ddb58",
                                                "text": "Un cheval qui se gratte contre la muraille."
                                            },
                                            {
                                                "example_id": "87191e7f-d16c-4a26-a123-8db12a14a115",
                                                "sense_id": "27f7e026-4eec-3d9e-a0be-2cba9d2ddb58",
                                                "text": "Deux ânes qui se grattent l’un contre l’autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
