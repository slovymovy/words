            {
                "entry_id": "2588e15f-4083-3fe0-a517-dedb19ba491c",
                "word": "Walkman",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d019496a-a22b-319f-b72e-f83c8d8d8be3",
                        "entry_id": "2588e15f-4083-3fe0-a517-dedb19ba491c",
                        "glosses": [
                            "A Sony portable personal compact cassette player product line."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ef6707-5e01-4f09-b56d-f127fa9fea96",
                                "sense_id": "d019496a-a22b-319f-b72e-f83c8d8d8be3",
                                "text": "He places the Walkman in the case alongside a Panasonic wallet-size cordless portable finding Easa-phone (he used to own the NEC 9000 Porta portable) and pulls out today’s newspaper."
                            }
                        ]
                    },
                    {
                        "sense_id": "e99d594d-e665-3b05-acc3-b8c82290ba30",
                        "entry_id": "2588e15f-4083-3fe0-a517-dedb19ba491c",
                        "glosses": [
                            "A Sony brand for personal portable audio media players."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a6f123-241b-41f3-944b-490b48bda8a7",
                                "sense_id": "e99d594d-e665-3b05-acc3-b8c82290ba30",
                                "text": "Outside the toilets school parties from France and Germany stood in stiff groups photographing themselves. They talked loudly without removing their Walkmans. Their headsets sizzled and tished."
                            }
                        ]
                    },
                    {
                        "sense_id": "861f2a24-6064-3dac-9b95-fd3524f78eae",
                        "entry_id": "2588e15f-4083-3fe0-a517-dedb19ba491c",
                        "glosses": [
                            "A street urchin."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "428b3086-801a-3956-935b-c711886995cc",
                "word": "walkman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "74483c57-7f3d-4039-8277-0b82dd2c37ab",
                        "entry_id": "428b3086-801a-3956-935b-c711886995cc",
                        "tags": [
                            "plural"
                        ],
                        "form": "walkmans"
                    },
                    {
                        "form_id": "3045f1ee-ddd2-4e63-bf3b-391480c1a0ec",
                        "entry_id": "428b3086-801a-3956-935b-c711886995cc",
                        "tags": [
                            "plural",
                            "uncommon"
                        ],
                        "form": "walkmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1892015b-1542-34a3-bb40-643a8215be7c",
                        "entry_id": "428b3086-801a-3956-935b-c711886995cc",
                        "glosses": [
                            "A portable personal audio cassette player with headphones."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6d3b6f8d-c6e2-4f54-8fc8-5b238993ee3f",
                                "sense_id": "1892015b-1542-34a3-bb40-643a8215be7c",
                                "text": "Because I can't stand looking at that inexplicable Walkman anymore. You're carrying around a brick playing a cassette tape. We're not savages—so I'm gonna put a thousand songs in your pocket."
                            }
                        ]
                    },
                    {
                        "sense_id": "f686598c-600c-3b82-945f-67b0ab1cfb4f",
                        "entry_id": "428b3086-801a-3956-935b-c711886995cc",
                        "glosses": [
                            "Pigs' ears, chopped, shaved, marinated, skewered, then grilled, sold as street food."
                        ],
                        "tags": [
                            "Philippines",
                            "informal",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab784161-bc83-41ff-9a73-98c2b3779e0d",
                        "source_entry_id": "428b3086-801a-3956-935b-c711886995cc",
                        "source_sense_description": "personal cassette player",
                        "target_lang_word": "walkman",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "walkman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "38e49c90-3895-3773-9d6b-4de5c87290b0",
                                        "entry_id": "ab29d871-40ec-36fe-95d3-29e3c20b2589",
                                        "glosses": [
                                            "een draagbare radio en/of cd-speler met koptelefoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10112f2-b2cb-4cfa-886f-76f607d79bac",
                                                "sense_id": "38e49c90-3895-3773-9d6b-4de5c87290b0",
                                                "text": "Hij loopt de hele dag met zo'n walkman op."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0682ca2b-55a6-4ae9-b29b-338c0d61cea3",
                        "source_entry_id": "428b3086-801a-3956-935b-c711886995cc",
                        "source_sense_description": "personal cassette player",
                        "target_lang_word": "walkman",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "walkman",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e52c3e-1934-302e-b721-8483659b3851",
                                        "entry_id": "80fb5af7-b83b-3bf5-9b8f-2bb076d2b1c7",
                                        "glosses": [
                                            "Appareil de musique de petite taille diffusant dans un casque externe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7be7860e-bc2e-4787-b963-4023f4e910db",
                                                "sense_id": "b0e52c3e-1934-302e-b721-8483659b3851",
                                                "text": "Nous allions en «boum », ils sortent en «boîtes », nous lisions un bouquin, ils se tapent des cassettes... Nous aimions communier sous les auspices des Beatles, ils s’enferment dans l’autisme du walkman..."
                                            },
                                            {
                                                "example_id": "f535adea-69da-4176-ac97-b88b37e35718",
                                                "sense_id": "b0e52c3e-1934-302e-b721-8483659b3851",
                                                "text": "Chapuis, sur sa couche, avait la ressource d’écouter de la musique dans son walkman, je n’avais même pas un livre, je broyais du noir."
                                            },
                                            {
                                                "example_id": "a8794db8-ebd1-4579-bc97-aadff24e8a5c",
                                                "sense_id": "b0e52c3e-1934-302e-b721-8483659b3851",
                                                "text": "Le lendemain elle montra à Mariette son walkman, lui mit le casque sur les oreilles, la chanson de Bruce Springsteen Born to Run, la voix, les guitares, les basses, injectées directement comme un fluide..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "848e44d1-ecf5-345f-b6a9-de34d45bc53b",
                                        "entry_id": "80fb5af7-b83b-3bf5-9b8f-2bb076d2b1c7",
                                        "glosses": [
                                            "Baladeur lecteur et éventuellement enregistreur de cassettes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d66a87ee-788a-4659-8d4b-1538982897e9",
                                                "sense_id": "848e44d1-ecf5-345f-b6a9-de34d45bc53b",
                                                "text": "Pour cesser de penser à l’expression de mon père, quand il allait découvrir la planque et le lit vides, j’écoutais Foxy Brown dans mon walkman et chaque clope que je fumais avait un goût de nuit blanche."
                                            },
                                            {
                                                "example_id": "cedd0348-91f2-4029-8e81-a31843ea8a04",
                                                "sense_id": "848e44d1-ecf5-345f-b6a9-de34d45bc53b",
                                                "text": "« Tout un courant s’est développé depuis quinze-vingt ans, la “technostalgie”, une manière d’innover à partir des technologies du passé », explique l’experte, citant les walkmans Bluetooth, les applications qui permettent de filmer à la manière d’une VHS et autre machine à écrire USB."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c643306e-cd8e-4810-a3f9-346e2b788a91",
                        "source_entry_id": "428b3086-801a-3956-935b-c711886995cc",
                        "source_sense_description": "personal cassette player",
                        "target_lang_word": "baladeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baladeur",
