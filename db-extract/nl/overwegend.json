                                        "sense_id": "0452993e-2b90-3f78-82c2-7720246c07cf",
                                        "entry_id": "929c1196-cc79-34b3-a61d-7a8e719ba43c",
                                        "glosses": [
                                            "Of or relating to a chief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "677a1c03-2bda-4a56-b34a-e1274b7fb379",
                                                "sense_id": "0452993e-2b90-3f78-82c2-7720246c07cf",
                                                "text": "The maintenance of a perpetual fire came to be associated with chiefly or royal dignity."
