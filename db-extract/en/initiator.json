                        "sense_id": "88e65ab9-0ded-3f86-9fc3-c9ba12e3bc08",
                        "entry_id": "6897fce4-bf96-3198-ab1e-e82a9da3687e",
                        "glosses": [
                            "A task (in a mainframe computer) that initiates multiple jobs."
