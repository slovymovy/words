                ],
                "senses": [
                    {
                        "sense_id": "5a80fa19-4de0-3f58-941c-df6f5f296463",
                        "entry_id": "7c4d788f-2d40-33f1-80de-d4b7163b696a",
                        "glosses": [
                            "Trasse eines als zusammenhängend empfundenen befahrbaren Verkehrswegs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ae5a51-ffed-48b3-9cfe-95a0a54d9654",
                                "sense_id": "5a80fa19-4de0-3f58-941c-df6f5f296463",
                                "text": "„In der jüngsten Sitzung unterbreitete Planer Frank Reimann einen ersten Trassenentwurf, der verschiedene Straßenverläufe möglich machen soll.“"
                            },
                            {
                                "example_id": "bbc9730e-dd7d-4856-94a9-ad6e36d5f4a6",
                                "sense_id": "5a80fa19-4de0-3f58-941c-df6f5f296463",
                                "text": "„Aufgrund der baulichen Veränderungen entsprechen die eingetragenen Baulinien zudem in weiten Teilen auch nicht mehr dem effektiven Strassenverlauf oder widersprechen den vorrangigen kommunalen Nutzungsplanungen.“"
                            },
                            {
                                "example_id": "b34a9b50-6b8a-4ff1-b29b-f282fa9b8b08",
                                "sense_id": "5a80fa19-4de0-3f58-941c-df6f5f296463",
                                "text": "„Für den gesamten Straßenverlauf ist die Bezeichnung Hafnersteig seit 1786 gebräuchlich.“"
                            },
                            {
                                "example_id": "ee4bff99-cd05-4d67-8e16-f33a454d5971",
                                "sense_id": "5a80fa19-4de0-3f58-941c-df6f5f296463",
                                "text": "„Der Straßenverlauf nimmt damit Bezug auf historische Gegebenheiten der Offenbacher Innenstadt: Auch die Ostseite des Platzes verlief früher leicht schräg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
