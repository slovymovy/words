                        "entry_id": "1ba0ad7d-3bdb-3bc1-b8a6-028c96752ab8",
                        "glosses": [
                            "To remove the regulations, or legal restrictions, from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e4733db6-84a1-4320-a599-cdd623e0b322",
                                "sense_id": "0ae584e8-183e-3f36-8f24-dd62d2d2531a",
                                "text": "Along with attacking “woke” investing, FGA has worked with legislators and elected officials to push for laws to deregulate child labor, stop Medicaid expansion and slash food stamps, among other initiatives."
                            }
                        ]
                    }
