                ],
                "senses": [
                    {
                        "sense_id": "05e468c1-5bcd-3867-9e72-d03936dc84bb",
                        "entry_id": "70ef708d-3df1-3ec6-b037-92123c529df1",
                        "glosses": [
                            "rechtlich geforderte Zusammenarbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d97ea32-9179-4de9-9b18-0b1c7606786e",
                                "sense_id": "05e468c1-5bcd-3867-9e72-d03936dc84bb",
                                "text": "„Allerdings existiert noch ein weiterer Stolperstein: Die Abgabenordnung manifestiert eine umfassende Mitwirkungspflicht des Steuerpflichtigen.“"
                            },
                            {
                                "example_id": "aa2823e5-2039-4c43-84d8-ce497363b609",
                                "sense_id": "05e468c1-5bcd-3867-9e72-d03936dc84bb",
                                "text": "„Grundsätzlich bezieht sich die Mitwirkungspflicht auf die gesamte Heilbehandlung, also auch auf die in diesem Rahmen verordnete Medikation.“"
                            },
                            {
                                "example_id": "ab1a4689-5e65-46f7-a8df-6345f2051d24",
                                "sense_id": "05e468c1-5bcd-3867-9e72-d03936dc84bb",
                                "text": "„Der Antragsteller wird auf die Wahrheits- und Mitwirkungspflicht im Asylverfahren hingewiesen.“"
                            },
                            {
                                "example_id": "86bf8b35-7b00-4056-8d52-673161076360",
                                "sense_id": "05e468c1-5bcd-3867-9e72-d03936dc84bb",
                                "text": "„Im Rahmen der Mitwirkungspflicht sind die zur Durchführung des Verfahrens unerlässlichen Angaben zu machen und Auskünfte zu erteilen sowie die dafür erforderlichen Urkunden, Unterlagen und Nachweise beizubringen.“"
                            },
                            {
                                "example_id": "588e1610-a194-450f-ac10-d15adc1ea622",
                                "sense_id": "05e468c1-5bcd-3867-9e72-d03936dc84bb",
                                "text": "„Die Mitwirkungspflicht der Gendarmerie bei der Überwachung von Veranstaltungen von überörtlicher Bedeutung umfasst ua die Aufrechterhaltung der öffentlichen Ruhe, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
