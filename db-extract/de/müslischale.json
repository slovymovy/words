                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387468e8-fe7f-4060-8364-9a59e3400f63",
                                "sense_id": "f9e0662a-8856-31df-98a1-70b1a4837ba3",
                                "text": "„Dann sammelt sie die Wespen in einer Müslischale und isst sie mit einem Löffel.“"
                            },
                            {
                                "example_id": "4f11e79b-2256-4fff-99c5-b43094561565",
                                "sense_id": "f9e0662a-8856-31df-98a1-70b1a4837ba3",
                                "text": "„Der Dome sieht aus dieser Entfernung wie ein Spielzeug aus, wie eine umgedrehte Müslischale, umringt von einem hauchdünnen Gespinst aus Türmen.“"
                            }
