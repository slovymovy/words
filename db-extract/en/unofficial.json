                        "cross_references": [
                            {
                                "target_word": "officieus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c7b63003-d21b-3bc5-810f-0dfa9736749b",
                                        "entry_id": "ee03ca17-79f1-3f02-89f8-73c3ab33350a",
                                        "glosses": [
                                            "niet-officieel, niet helemaal volgens de regels en vaak ook helemaal tegen de regels in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37b1afe2-b987-4556-af92-92d3f50ca6de",
                                                "sense_id": "c7b63003-d21b-3bc5-810f-0dfa9736749b",
                                                "text": "Hij begreep het ook wel: dit beschermen van eigen co's tegen Lenz was uiteraard een hoogst officieuze, om niet te zeggen clandestiene aangelegenheid, en zelfs Zuidema, met zijn vrijbuitersmanieren, moest om de schijn op te houden af en toe wel eens een co prijsgeven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43602ff3-a1ad-44b2-ad41-e1f20aa889ac",
                        "source_entry_id": "fb054a7a-aab8-3070-8fc0-7092604d1a2e",
                        "source_sense_description": "not official",
                        "target_lang_word": "officieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "officieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ed178e-b7fc-3a00-bae5-e5e49bb9576c",
                                        "entry_id": "cfcf95b4-20e2-31a3-9347-778ea6b4a29c",
                                        "glosses": [
                                            "Qui est prompt à rendre de bons offices, serviable."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da8c3f27-effe-4203-8de6-16e6d9074dce",
                                                "sense_id": "f9ed178e-b7fc-3a00-bae5-e5e49bb9576c",
                                                "text": "On a souvent plus d'envie de passer pour officieux, que de réüssir dans les offices ; et souvent, on aime mieux pouvoir dire à ses amis qu'on a bien fait pour eux, que de bien faire en effet."
                                            },
                                            {
                                                "example_id": "9dbeb8ed-6b30-4401-9d86-3093c4d3589b",
                                                "sense_id": "f9ed178e-b7fc-3a00-bae5-e5e49bb9576c",
                                                "text": "— Oui, Monsieur, oui, dit-elle, c’était une très-brave femme, bien propre, bien réveillée au travail, bonne ménagère, et très-bonne pour la vie.\n— Qu’entendez-vous par là ?\n— Bien officieuse à ses voisins, pas chétite comme sa sœur la grand’Gothe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9fdd644-63a2-3b18-8519-976b54f0cf44",
                                        "entry_id": "cfcf95b4-20e2-31a3-9347-778ea6b4a29c",
                                        "glosses": [
                                            "Qualifie un mensonge dit pour faire plaisir à quelqu’un, ou pour lui rendre service sans nuire à personne."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d6af2f9-296a-4611-84ef-baba704feafa",
                                                "sense_id": "a9fdd644-63a2-3b18-8519-976b54f0cf44",
                                                "text": "— J’ai vu rarement un si beau bal, disait monsieur de La Billardière, à qui un mensonge officieux ne coûtait rien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f38e79b-ef8a-3652-943f-cb0838b65114",
                                        "entry_id": "cfcf95b4-20e2-31a3-9347-778ea6b4a29c",
                                        "glosses": [
                                            "Qui n’est pas officiel mais qui en remplit les fonctions ; qui est donné à titre de complaisance, en parlant de renseignements de source autorisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7733abb9-fbaa-4285-aacc-c02b99fe8b13",
                                                "sense_id": "5f38e79b-ef8a-3652-943f-cb0838b65114",
                                                "text": "Tu admets, ô Prospêtès, que, par le verbe et par la plume, je fasse profession d'amoralité. Que je me décrive comme un être ayant rompu avec la morale officielle ou la morale officieuse."
                                            },
                                            {
                                                "example_id": "e5543d29-12d7-4ccd-a43e-d395400f4cc0",
                                                "sense_id": "5f38e79b-ef8a-3652-943f-cb0838b65114",
                                                "text": "Officiellement, le Vatican n’a plus d’« exorciste en chef » : le dernier en date, le célèbre père Gabriele Amorth, est décédé en septembre 2016. Depuis, le père Vincenzo Taraborelli, religieux carme et prêtre de cette église située à 200 mètres de la place Saint-Pierre, est pourtant considéré comme son successeur officieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "officieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0aa445-55e6-3e8d-a036-65120ea36581",
                                        "entry_id": "11b172c6-5520-3b0c-bcb4-235a8cc9dc41",
                                        "glosses": [
                                            "Personne prompte à rendre de bons offices, serviable."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf692297-de00-335e-a5c1-e3bef7938106",
                                        "entry_id": "11b172c6-5520-3b0c-bcb4-235a8cc9dc41",
                                        "glosses": [
                                            "Sous la Révolution française, domestique, valet, servante, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c115bad-97bf-4605-8dc5-6e5977322fcc",
                                                "sense_id": "bf692297-de00-335e-a5c1-e3bef7938106",
                                                "text": "— Interrogez ma servante.\n— Citoyen, il faut dire mon officieuse.\n— Eh bien mon officieuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59b9b224-204a-4e17-9d8c-000d87ba3c9a",
