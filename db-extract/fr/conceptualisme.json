                ],
                "senses": [
                    {
                        "sense_id": "c2efd6e2-4dcb-3f9a-9502-1a8802523700",
                        "entry_id": "c9d4a6da-4f13-379f-a8e6-f355057947b0",
                        "glosses": [
                            "Doctrine qui considère les idées générales comme le résultat d’une construction de l’esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad3a7e4d-484b-481e-82c5-9b1917042d40",
                                "sense_id": "c2efd6e2-4dcb-3f9a-9502-1a8802523700",
                                "text": "On ne peut plus résoudre le problème fondamental de la Scolastique, celui de l’accord de la raison et de la foi ; ou, si on tente de le résoudre en partant du conceptualisme ou du nominalisme, on sombre dans l’hérésie et l’on encourt les condamnations de l'Église […]"
                            },
                            {
                                "example_id": "c7824bb4-1ae6-45fe-b460-461c51dedf70",
                                "sense_id": "c2efd6e2-4dcb-3f9a-9502-1a8802523700",
                                "text": "Le conceptualisme d’Abélard.",
                                "translation": "Le conceptualisme de Kant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48f9c80b-20b7-4d96-8728-4f317431484b",
                        "source_entry_id": "c9d4a6da-4f13-379f-a8e6-f355057947b0",
                        "source_sense_id": "c2efd6e2-4dcb-3f9a-9502-1a8802523700",
                        "target_lang_word": "conceptualism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conceptualism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82893438-7958-33ba-aeac-ac1848f29f16",
                                        "entry_id": "8f7c6e28-901d-349b-88ec-1f2c22e6e4a9",
                                        "glosses": [
                                            "The art movement towards conceptual art."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0af1213d-df0c-3312-8edf-41ed527e199d",
                                        "entry_id": "8f7c6e28-901d-349b-88ec-1f2c22e6e4a9",
                                        "glosses": [
                                            "A theory, intermediate between realism and nominalism, that the mind has the power of forming for itself general conceptions of individual or single objects; the doctrine that universals have an existence in the mind apart from any concrete embodiment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1694aecb-dae1-4cfc-a11e-185381483ceb",
                                                "sense_id": "0af1213d-df0c-3312-8edf-41ed527e199d",
                                                "text": "We have thus returned, then, to that conceptualism of the middle age, which, concentrating truth within the human intelligence, makes the nature of things a phantom of intelligence projecting itself everywhere out of itself[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
