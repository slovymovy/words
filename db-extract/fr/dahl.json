                    {
                        "sense_id": "88370655-2934-340d-8163-0f012dc1a495",
                        "entry_id": "92ffa61e-a081-3d77-9ae5-084fe42115eb",
                        "glosses": [
                            "Ensemble de légumineuses, tels que le pois, la lentille et le haricot, dans la cuisine indienne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2b65d53e-8001-3e78-b6ac-985b734e425b",
                        "entry_id": "92ffa61e-a081-3d77-9ae5-084fe42115eb",
                        "glosses": [
                            "Mets d’origine indienne réalisé avec ces légumineuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328e16ee-5af5-4600-92ba-e39aac0a56fb",
                                "sense_id": "2b65d53e-8001-3e78-b6ac-985b734e425b",
                                "text": "Un tourbillon d’odeurs succulentes et relevées les assaillit : doigts de gombo, poulet, curry, dahl et aubergines dans une orgie de permutations. Ils entrèrent, accueillis par la voix grincheuse de Zachée qui proposait d’aller les chercher."
                            },
                            {
                                "example_id": "d3d1b9aa-ff07-44fd-98f3-d38a3fe7ed82",
                                "sense_id": "2b65d53e-8001-3e78-b6ac-985b734e425b",
                                "text": "Plat indien végétarien par excellence, le dahl de lentilles se suffit à lui tout seul mais il peut aussi être servi en accompagnement d’une viande ou d’un poisson."
                            }
                        ]
                    }
