                ],
                "senses": [
                    {
                        "sense_id": "3a4dd437-572b-338a-8c79-58a39d38c58a",
                        "entry_id": "2880a87b-681d-3a2c-9d85-08117a152001",
                        "glosses": [
                            "dowodzenie czego poparte rozumowymi argumentami; argumentacja"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13dfc8bf-13e1-4df7-872a-553dbc6b6093",
                                "sense_id": "3a4dd437-572b-338a-8c79-58a39d38c58a",
                                "text": "Wygłosił dłuższy wywód, skierowany przeciw sztuce abstrakcyjnej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9232d1ee-40ab-3163-8cec-c079877a8214",
                        "entry_id": "2880a87b-681d-3a2c-9d85-08117a152001",
                        "glosses": [
                            "wykrywanie początku, nawiązywanie do początku, źródła czego, dzieło lub dokument temu poświęcony"
                        ],
                        "tags": [
                            "also"
                        ],
                        "examples": [
                            {
                                "example_id": "2c78c7e3-8da0-46b4-9c95-022540599b34",
                                "sense_id": "9232d1ee-40ab-3163-8cec-c079877a8214",
                                "text": "Rękopisy najdawniejsze, jakie dotąd wykryć zdołaliśmy, rozpoczynają wywód piśmiennictwa polskiego, aż do pierwszej połowy XVII wieku."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "4b25c380-19e0-3279-aee0-e9dbec1b5a9d",
                        "entry_id": "2880a87b-681d-3a2c-9d85-08117a152001",
                        "glosses": [
                            "stwierdzenie szlacheckiego pochodzenia, dokument stwierdzający to pochodzenie; rodowód"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85dd0fdc-c357-406e-a876-370bad3c891f",
                                "sense_id": "4b25c380-19e0-3279-aee0-e9dbec1b5a9d",
                                "text": "Ten, któremu sądownie zarzucono nieprawne używanie szlachectwa, zawieszany był w prerogatywach stanu rycerskiego dopóty, dopóki nie uczynił wywodu."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "680776ae-a435-3c64-af06-eb30bf496106",
                        "entry_id": "2880a87b-681d-3a2c-9d85-08117a152001",
                        "glosses": [
                            "w Kościele katolickim: pobłogosławienie matki po urodzeniu dziecka, połączone z uroczystym wprowadzeniem jej do kościoła"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a56a0418-3a5e-4047-ad7a-0b2fa3e49b4c",
                                "sense_id": "680776ae-a435-3c64-af06-eb30bf496106",
                                "text": "Zobaczył idącą z dzieckiem na ręku (…) dookoła ołtarza, jak tego wymaga obrzęd wywodu."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "ae752246-e557-3945-9d7d-4c40822b6f26",
                        "entry_id": "2880a87b-681d-3a2c-9d85-08117a152001",
                        "glosses": [
                            "błogosławieństwo mężatki po ślubie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "ef1f709b-8700-396f-82fe-78a04345134b",
                        "entry_id": "2880a87b-681d-3a2c-9d85-08117a152001",
                        "glosses": [
                            "umotywowanie, uzasadnienie danego wniosku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c16e8284-ddaf-40df-b101-72ef5b63f954",
                                "sense_id": "ef1f709b-8700-396f-82fe-78a04345134b",
                                "text": "Wywód apelacji składa się w sądzie, który wydał wyrok bądź na piśmie, bądź ustnie do protokołu sekretarza sądowego."
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0922ced4-27fa-48ec-8d28-b2d81f3e5eb2",
                        "source_entry_id": "2880a87b-681d-3a2c-9d85-08117a152001",
