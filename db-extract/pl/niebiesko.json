                                "target_senses": [
                                    {
                                        "sense_id": "b87a0c72-ea59-3359-abd3-9bc5cf82eb2f",
                                        "entry_id": "4d8093b0-bf90-3e94-9dba-408af82cc10f",
                                        "glosses": [
                                            "eine bunte Farbe, im Spektrum eine relativ kurzwellige Farbe zwischen grün und violett; Grundfarbe vieler Farbmodelle, insbesondere eine der drei Grundfarben des digitalen RGB-Farbraums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5beb263-a196-4964-98dd-07010c355ba2",
                                                "sense_id": "b87a0c72-ea59-3359-abd3-9bc5cf82eb2f",
                                                "text": "Eine Frage die sich mir schon seit Jahren stellt. Wenn man sich im Web umsieht, sind ca. 90% der Designs immer und immer wieder blau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "834275ac-c223-35d4-9bfe-46dc6bd9f191",
                                        "entry_id": "4d8093b0-bf90-3e94-9dba-408af82cc10f",
                                        "glosses": [
                                            "betrunken"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab86dc57-4fa9-4b40-a522-49f64d64497c",
                                                "sense_id": "834275ac-c223-35d4-9bfe-46dc6bd9f191",
                                                "text": "Der Seemann ist schon wieder blau und passt damit in ein abgedroschenes Klischee."
                                            },
                                            {
                                                "example_id": "e74043b7-967d-41ca-9c92-fe0180996b35",
                                                "sense_id": "834275ac-c223-35d4-9bfe-46dc6bd9f191",
                                                "text": "„Ich bin der letzte Kunde, ich komm' nicht los vom Hahn.",
                                                "translation": "Ich bin der letzte Kunde und immer noch nicht blau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "80433960-a58b-35a7-96ee-fb78d4f4c462",
                                        "entry_id": "4d8093b0-bf90-3e94-9dba-408af82cc10f",
                                        "glosses": [
                                            "zyanotisch, bläuliche Färbung der Haut, wenn sie mit zu wenig sauerstoffreichem Blut versorgt wird"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bebad15f-8825-4a9a-b89f-aaa3fc712eec",
                                                "sense_id": "80433960-a58b-35a7-96ee-fb78d4f4c462",
                                                "text": "„Je enger die Ausstrombahn der rechten Herzkammer ist, desto stärker wird das Kind blau sein, da mehr sauerstoffarmes Blut von der rechten Herzkammer direkt in die Körper-hauptschlagader fließt (Rechts-Links-Shunt).“"
                                            },
                                            {
                                                "example_id": "3ce18476-602d-4571-81dd-56884b888c86",
                                                "sense_id": "80433960-a58b-35a7-96ee-fb78d4f4c462",
                                                "text": "„Zentrale und periphere Zyanose lassen sich klinisch durch kräftiges Reiben der Ohrläppchen unterscheiden. Bei der zentralen Zyanose bleibt das Ohrläppchen blau gefärbt, während sich das Ohrläppchen bei der peripheren Zyanose durch das Reiben (Hyperämie) wieder rötet.“"
                                            },
                                            {
                                                "example_id": "579047a1-7ee2-4459-ba11-c50cc04a747e",
                                                "sense_id": "80433960-a58b-35a7-96ee-fb78d4f4c462",
                                                "text": "„Blaue Lippen sind nicht nur ein Zeichen von Kälte und Frieren, sondern für einen Sauerstoffmangel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1cd3e218-6457-3bc7-a38c-c02da868c108",
                                        "entry_id": "4d8093b0-bf90-3e94-9dba-408af82cc10f",
                                        "glosses": [
                                            "indekliniertes Adjektiv, nur attributiv dem Substantiv nachgestellt: Zubereitungsart von Fisch"
                                        ],
