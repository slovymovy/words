                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c52f4521-b207-4acc-8b6a-02a0eb59759c",
                                "sense_id": "974e5c0b-11ac-386b-b73d-bc939d028842",
                                "text": "The skin of any Bulls Forehead, either for its toughness, or other cause, is the only part of the Hyde made use of by Horners, whereupon they shave their Hornes […]to fit them for Lamphorns"
                            },
                            {
                                "example_id": "79bbd360-4562-4f32-a2ca-d56fcc3c58b4",
                                "sense_id": "974e5c0b-11ac-386b-b73d-bc939d028842",
                                "text": "As also all patents for new inventions not put in practice within three years, likewise the several grants of incorporation to hatband makers, gutstring makers, spectacle makers, comb makers, tobacco-pipe makers, butchers, and horners."
                            }
                        ]
