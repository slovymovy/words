                ],
                "senses": [
                    {
                        "sense_id": "64ff3ad0-8cfe-3f47-b80f-68341f459252",
                        "entry_id": "f02c9f32-fcba-32b4-b2e9-2ec4e7004c00",
                        "glosses": [
                            "Offizier in den Seestreitkräften eines Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26da3a96-cb89-49a7-9f69-6cd83fae10e6",
                                "sense_id": "64ff3ad0-8cfe-3f47-b80f-68341f459252",
                                "text": "„Mit dem Fregattenkapitän Friedrich Jacobi übernimmt erstmals ein deutscher Marineoffizier das Kommando über einen multinationalen Verband innerhalb des westlichen Militärbündnisses NATO.“"
                            },
                            {
                                "example_id": "b5beabe7-6fbd-4e1d-a715-b3bd93efcf1c",
                                "sense_id": "64ff3ad0-8cfe-3f47-b80f-68341f459252",
                                "text": "„Ein Marineoffizier stand auf dem Sand und sah in mißtrauischem Erstaunen auf Ralph herab.“"
                            },
                            {
                                "example_id": "f910c8e4-8eb9-4150-a7c9-93642782b0f9",
                                "sense_id": "64ff3ad0-8cfe-3f47-b80f-68341f459252",
                                "text": "„Der verabschiedete Marineoffizier sprach sehr gerade heraus und schroff; das sah man ausser an dem Gesichtsausdruck seiner Zuhörer auch daran, dass mehrere Männer, die Pierre als besonders kaisertreu und still kannte, sich missbilligend zurückzogen oder aber widersprachen.“"
                            },
                            {
                                "example_id": "5699c2bd-ae86-4bc5-989b-d4817404f045",
                                "sense_id": "64ff3ad0-8cfe-3f47-b80f-68341f459252",
                                "text": "„Auch anschließend konnte sich der ehemalige Marineoffizier nicht beruhigen, und allen in der Weinstube war unbehaglich zumute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
