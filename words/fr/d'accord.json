    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "d2cc98cf-2962-3c89-8c11-7261768a6242",
                    "sense_definition": "Sert à exprimer son assentiment, son approbation ou son acceptation d'une proposition.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "assentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>D'accord</w>, nous pouvons commencer la réunion dès que tout le monde sera installé."
                        },
                        {
                            "text": "Je veux bien vous accompagner au marché ce matin, <w>d'accord</w>, mais revenons vite."
                        }
                    ],
                    "synonyms": [
                        "OK",
                        "entendu",
                        "ça marche"
                    ],
                    "common_phrases": [
                        "ah d'accord"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b332db1a-1229-3dc0-9993-eebb0bacf62e",
                    "sense_definition": "Qui partage la même opinion, le même avis ou la même volonté qu'une autre personne.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "accord_opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon collègue et moi sommes tout à fait <w>d'accord</w> sur cette proposition."
                        },
                        {
                            "text": "Après une longue discussion, ils ont enfin réussi à tomber <w>d'accord</w>."
                        }
                    ],
                    "common_phrases": [
                        "être d'accord",
                        "tomber d'accord"
                    ]
                },
                {
                    "sense_id": "87a10671-d4cd-3f33-ae45-1dabe4de4126",
                    "sense_definition": "Qui est conforme, compatible ou en harmonie avec quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "harmonie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses actes récents ne sont absolument pas <w>d'accord</w> avec les principes qu'il défend."
                        },
                        {
                            "text": "Cette nouvelle règle n'est guère <w>d'accord</w> avec les traditions de notre établissement."
                        }
                    ]
                }
            ]
        }
    ]
}