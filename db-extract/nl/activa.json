                    {
                        "translation_id": "fbdccd9f-60c2-4d09-aff7-7d6c8e88d9fe",
                        "source_entry_id": "e67590ed-f94e-3fde-89a4-4216a60fb422",
                        "source_sense_id": "0da5e1ce-f3f3-3741-ba5f-62611a1b150d",
                        "source_sense_description": "in geld uitgedrukte waarde van de bezittingen van een onderneming",
                        "target_lang_word": "actif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actif",
