                                "target_senses": [
                                    {
                                        "sense_id": "b2b25a65-4a94-3e9f-a539-0554cc88441d",
                                        "entry_id": "24b116e7-e900-3554-83df-fe72604869b1",
                                        "glosses": [
                                            "περίκλειστο κράτος της Ασίας με πρωτεύουσα τη Θίμφου, επίσημη γλώσσα τη τζόνγκα και νόμισμα το νγκούλτρουμ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a019087-816e-43b8-b531-0fe5db51fa1e",
                                                "sense_id": "b2b25a65-4a94-3e9f-a539-0554cc88441d",
                                                "text": "※ Σκαρφαλωμένο στα Ιμαλάια, ανάμεσα στο Θιβέτ και στην Ινδία, το Βασίλειο του Μπουτάν μπορεί να είναι μία από τις φτωχότερες και λιγότερο αναπτυγμένες χώρες στον κόσμο, βρίσκεται όμως πρώτο στη λίστα με τις πιο ευτυχισμένες χώρες στην Ασία και όγδοο στην παγκόσμια κατάταξη.",
                                                "translation": "Μπουτάν: Η φτωχή χώρα με τους ευτυχισμένους ανθρώπους, Το Βήμα, 6 Αυγούστου 2013"
                                            }
                                        ]
                                    }
                                ]
