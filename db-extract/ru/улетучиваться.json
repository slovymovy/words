                        "target_lang_word": "se dissiper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se dissiper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e815eb53-e14d-3664-8eb8-67c1a59598db",
                                        "entry_id": "a810be23-f364-3d62-8f14-4139e3b71a4b",
                                        "glosses": [
                                            "Disparaître peu à peu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84caa135-752a-4301-b6be-6d9178d828af",
                                                "sense_id": "e815eb53-e14d-3664-8eb8-67c1a59598db",
                                                "text": "Elle étendit la main à travers les nuages légers et la vapeur qui l’entouraient, et ce qui restait de brouillard acheva de se dissiper."
                                            },
                                            {
                                                "example_id": "b4f3dc6a-50f6-41b0-b7b2-921bebe344ef",
                                                "sense_id": "e815eb53-e14d-3664-8eb8-67c1a59598db",
                                                "text": "Cette zone forestière correspond à la région humide des nuages qui ceignent les flancs du pic pendant la majeure partie de l'année et qui se dissipent généralement le soir pour reparaître peu après le lever du soleil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
