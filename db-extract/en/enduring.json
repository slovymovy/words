                                        "entry_id": "2f7b5e43-ed36-3d93-b6b5-6a27b041d0c6",
                                        "glosses": [
                                            "lange anhaltend; auf Dauer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b79af1b-6180-4589-878a-bc02d25e4a9d",
                                                "sense_id": "24b29e45-a12d-391f-8c74-765b7eb6b743",
                                                "text": "Der UV-Kleber verbindet zwei Glasflächen dauerhaft miteinander."
                                            },
                                            {
                                                "example_id": "97e79f9a-c95b-4c11-91f9-22c95cd1cb6b",
                                                "sense_id": "24b29e45-a12d-391f-8c74-765b7eb6b743",
                                                "text": "Wer hat [schon] dauerhaft statistisches Normalgewicht?"
                                            },
                                            {
                                                "example_id": "18342d24-1438-4b61-8796-aed918cdce4c",
                                                "sense_id": "24b29e45-a12d-391f-8c74-765b7eb6b743",
                                                "text": "Die dauerhafteste Erinnerung an das Großereignis besitzt wohl die Kölner Pfarrei St. Agnes. In ihrem Kirchturm läutet die vom Papst geweihte Weltjugendtags-Glocke - zum Beispiel am Sonntagabend von 20.30 Uhr bis 20.45 Uhr."
                                            },
                                            {
                                                "example_id": "cf12bf6b-9b4b-477f-9041-135921feb81d",
                                                "sense_id": "24b29e45-a12d-391f-8c74-765b7eb6b743",
                                                "text": "„Die germanische Invasion veränderte dauerhaft die Machtstrukturen in Britannien.“"
                                            },
                                            {
                                                "example_id": "5f5df583-1a52-4bc7-a6e1-76d683a466e7",
                                                "sense_id": "24b29e45-a12d-391f-8c74-765b7eb6b743",
                                                "text": "„Durch KI-Werkzeuge wie ChatGPT ist genau dieses jedoch in Gefahr – und könnte Wikipedias Ruf dauerhaft beschädigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
