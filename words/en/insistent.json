{
    "word_family": [
        "insist",
        "insistence",
        "insistingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "30d223a1-ac68-3d5f-8dfb-7616b4396a94",
                    "sense_definition": "Persistent in demanding something or maintaining an opinion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>insistent</w> that we leave the party before it got too late.",
                            "target_lang_translations": {
                                "nl": "Ze was <w>aandringend</w> dat we het feest verlieten voordat het te laat werd."
                            }
                        },
                        {
                            "text": "Despite his <w>insistent</w> requests for a refund, the manager refused to help him.",
                            "target_lang_translations": {
                                "nl": "Ondanks zijn <w>aandringende</w> verzoeken om terugbetaling, weigerde de manager hem te helpen."
                            }
                        }
                    ],
                    "synonyms": [
                        "persistent",
                        "demanding",
                        "adamant"
                    ],
                    "antonyms": [
                        "yielding"
                    ],
                    "common_phrases": [
                        "insistent demand",
                        "insistent request"
                    ],
                    "target_lang_definitions": {
                        "nl": "Aanhoudend in het eisen van iets of het vasthouden aan een mening."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "aandringend",
                                "target_lang_sense_clarification": "iemand die herhaaldelijk verzoekt of eist"
                            },
                            {
                                "target_lang_word": "vastberaden",
                                "target_lang_sense_clarification": "iemand die voet bij stuk houdt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f3d5f76-e870-323d-993b-8f9538eb0107",
                    "sense_definition": "Demanding attention or notice; intense and impossible to ignore.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>insistent</w> ringing of the telephone finally woke everyone in the house.",
                            "target_lang_translations": {
                                "nl": "Het <w>onophoudelijke</w> rinkelen van de telefoon maakte eindelijk iedereen in huis wakker."
                            }
                        },
                        {
                            "text": "A cold and <w>insistent</w> wind blew through the cracks in the old wooden door.",
                            "target_lang_translations": {
                                "nl": "Een koude en <w>dringende</w> wind blies door de kieren van de oude houten deur."
                            }
                        }
                    ],
                    "synonyms": [
                        "urgent",
                        "pressing"
                    ],
                    "common_phrases": [
                        "insistent noise",
                        "insistent sound"
                    ],
                    "target_lang_definitions": {
                        "nl": "Aandacht vragend; intens en onmogelijk te negeren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "dringend",
                                "target_lang_sense_clarification": "iets dat onmiddellijke aandacht vereist"
                            },
                            {
                                "target_lang_word": "onophoudelijk",
                                "target_lang_sense_clarification": "iets dat niet stopt en daardoor opvalt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f728120-1375-399c-a40d-def7dfd6986d",
                    "sense_definition": "Resting or standing upon something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In old descriptions of buildings, each column is said to stand <w>insistent</w> on its base.",
                            "target_lang_translations": {
                                "nl": "In oude beschrijvingen van gebouwen staat dat elke zuil op haar voet <w>rust</w>."
                            }
                        },
                        {
                            "text": "The ancient statue stood <w>insistent</w> upon a broad stone plinth.",
                            "target_lang_translations": {
                                "nl": "Het oude beeld <w>rustte</w> op een brede stenen sokkel."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or technical."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Rustend of staand op iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "rustend",
                                "target_lang_sense_clarification": "gepositioneerd op een oppervlak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c171e3c-16f3-308f-ab1b-314492887bbd",
                    "sense_definition": "Having the hind toe positioned so that only the tip touches the ground.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this species the hind toe is <w>insistent</w>, touching the ground only at its tip.",
                            "target_lang_translations": {
                                "nl": "Bij deze soort is de achterteen <w>insistent</w>: hij raakt de grond alleen met zijn punt."
                            }
                        },
                        {
                            "text": "Unlike birds with incumbent toes, this species has an <w>insistent</w> hind toe.",
                            "target_lang_translations": {
                                "nl": "In tegenstelling tot vogels met rustende tenen, heeft deze soort een <w>insistente</w> achterteen."
                            }
                        }
                    ],
                    "antonyms": [
                        "incumbent"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used primarily in ornithology."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Met de achterteen zo geplaatst dat alleen de punt de grond raakt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "insistent",
                                "target_lang_sense_clarification": "ornithologische term voor een specifieke stand van de achterteen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}