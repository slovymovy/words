                        "glosses": [
                            "huis dat gelegen is op een perceel naast het eigen huis; het huis van de buren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "823c147f-eab8-48be-9a70-f36c6404fb14",
                                "sense_id": "6d53084e-0838-3c1a-b1af-db8a33fd45b7",
                                "text": "'Met Gote,' roept Dora hard, en ze wijst opnieuw naar het buurhuis."
                            },
                            {
                                "example_id": "52a5f022-aa2b-4d38-af4a-14a4b155e0d5",
                                "sense_id": "6d53084e-0838-3c1a-b1af-db8a33fd45b7",
                                "text": "Het vuur sloeg over naar een van de buurhuizen. Daar bleef de schade beperkt. Twee agenten en een van de bewoners zouden rook hebben ingeademd. De brandweer had het vuur snel onder controle."
                            },
                            {
                                "example_id": "f946c86e-c528-4066-875f-ecb756c40f32",
                                "sense_id": "6d53084e-0838-3c1a-b1af-db8a33fd45b7",
                                "text": "De brand begon in een bijgebouw achter een huis. Het vuur sloeg over naar een buurhuis."
                            }
                        ]
                    }
