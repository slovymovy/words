                {
                    "sense_id": "265b3047-0110-3226-8259-c2d9a909428a",
                    "sense_definition": "Een object dat is opgebouwd of geconstrueerd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "constructie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>bouwsel</w> in de tuin dient als een tijdelijke opslagplaats voor gereedschap.",
                            "target_lang_translations": {
                                "en": "The <w>structure</w> in the garden serves as a temporary storage place for tools."
                            }
                        },
                        {
                            "text": "Dit vreemde <w>bouwsel</w> is gemaakt van oude planken en metalen buizen.",
                            "target_lang_translations": {
                                "en": "This strange <w>contraption</w> is made of old planks and metal pipes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vreemd bouwsel",
                        "houten bouwsel"
                    ],
                    "target_lang_definitions": {
