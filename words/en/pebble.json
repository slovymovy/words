                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "leather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tanner used a special tool to <w>pebble</w> the hide for a textured finish.",
                            "target_lang_translations": {
                                "zh": "制革工使用特殊工具对兽皮进行<w>压纹</w>处理，以获得纹理效果。"
                            }
                        },
                        {
                            "text": "High-quality bags are often made from <w>pebbled</w> leather.",
                            "target_lang_translations": {
                                "zh": "高质量的包袋通常由<w>压纹</w>皮革制成。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使皮革表面呈现出细小圆润的凸起纹理。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "压纹",
                                "target_lang_sense_clarification": "皮革加工工艺。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b24d032-a69e-311e-90f8-95296b0e751b",
                    "sense_definition": "To place a pebble at a vertex of a graph according to specific rules.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this game, you must <w>pebble</w> the graph nodes to satisfy the condition.",
                            "target_lang_translations": {
                                "zh": "在这个游戏中，你必须在图的节点上<w>放置石子</w>以满足条件。"
                            }
                        },
                        {
                            "text": "The algorithm requires the player to <w>pebble</w> the vertices in a specific order.",
                            "target_lang_translations": {
                                "zh": "该算法要求玩家按特定顺序在顶点上<w>放置石子</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在图论中根据特定规则在顶点上放置小石子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放置石子",
                                "target_lang_sense_clarification": "图论算法术语。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
