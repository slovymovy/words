                            {
                                "example_id": "2c722763-5d23-45c9-bbf0-2d071349f19b",
                                "sense_id": "0d5edba4-54ad-324e-a656-5d42d82a8703",
                                "text": "„Eines Morgens saß er, traurige Fehlbesetzung zwischen gestriegelten Collegeschülern, im Ellis and Ernest am langen rosa Marmortresen, bestellte Kaffee und klappte die Zeitung auf.“"
                            },
                            {
                                "example_id": "3a9d398b-75dc-4d93-861f-a6ae10b662eb",
                                "sense_id": "0d5edba4-54ad-324e-a656-5d42d82a8703",
                                "text": "„Der Killerkoch stellt den Teller auf den Marmortresen der Snackbar und sagt: ›Wer will Nachschlag?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
