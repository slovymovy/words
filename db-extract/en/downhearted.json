    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6659bb92-dc21-3fe5-a046-9a45dead12c8",
                "word": "downhearted",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d23cdd5c-9bf1-352c-80ba-41bc7082f549",
                        "entry_id": "6659bb92-dc21-3fe5-a046-9a45dead12c8",
                        "glosses": [
                            "Sad, discouraged, in low spirits, unhappy, having no hope"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f18f5b1-18a2-4d23-8917-c9793179d99c",
                                "sense_id": "d23cdd5c-9bf1-352c-80ba-41bc7082f549",
                                "text": "Fans must not be downhearted even though we lost."
                            },
                            {
                                "example_id": "d4c71d16-5e94-43fb-a7d9-3d813badd13f",
                                "sense_id": "d23cdd5c-9bf1-352c-80ba-41bc7082f549",
                                "text": "We're going on strike for twelve percent / We're not downhearted yet / They're filming it all for a reality show / So twelve percent we'll get"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "149649f8-cc0c-4616-9d2a-06d8618048c8",
                        "source_entry_id": "6659bb92-dc21-3fe5-a046-9a45dead12c8",
                        "source_sense_id": "d23cdd5c-9bf1-352c-80ba-41bc7082f549",
                        "source_sense_description": "sad or discouraged",
                        "target_lang_word": "niedergeschlagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niedergeschlagen",
                                "target_lang_code": "de",
