                                        "entry_id": "9bba4e5d-497e-304a-a2a4-d685bf55669f",
                                        "glosses": [
                                            "Überfall, bei dem fremde bewegliche Sachen durch Gewalt oder Androhung derselben entwendet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1904cb89-9130-4a41-b1a7-9287d28ac78d",
                                                "sense_id": "9da8ac54-d002-3b5c-8856-f7cc3ec7fde9",
                                                "text": "„Bei einem der größten Raubüberfälle, die bisher in der Schweiz verübt wurden, erbeuten in Genf zwei Männer von einem Diamantenhändler Edelsteine im Wert von 250 000 Schweizer Franken (240 250 DM).“"
                                            },
                                            {
                                                "example_id": "3704449d-ec23-41db-9f59-0f2543ded53c",
                                                "sense_id": "9da8ac54-d002-3b5c-8856-f7cc3ec7fde9",
                                                "text": "„Ein deutscher Tourist wird in Florida bei einem Raubüberfall getötet.“"
                                            },
                                            {
                                                "example_id": "d2fcdebf-f734-4517-9399-1574b778cbb1",
                                                "sense_id": "9da8ac54-d002-3b5c-8856-f7cc3ec7fde9",
                                                "text": "„Bei einem Raubüberfall auf eine Aachener Bank werden insgesamt rund 600 000 DM erbeutet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
