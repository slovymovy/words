                    {
                        "translation_id": "566eb1c0-c4e5-4f2a-9951-61a69127680b",
                        "source_entry_id": "33f61c39-2646-3961-8c30-6b0524fcf120",
                        "source_sense_id": "372f939b-fb95-3235-b98e-adee097990a1",
                        "target_lang_word": "druidismo",
