                ],
                "senses": [
                    {
                        "sense_id": "927e53ad-7453-3ffc-bcd8-7af0e9c2333c",
                        "entry_id": "da847c84-44fe-3fd8-857f-dd26ff0b2fae",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f205b4f-35ce-4bae-917e-429fcbf37ee2",
                                "sense_id": "927e53ad-7453-3ffc-bcd8-7af0e9c2333c",
                                "text": "Frau Eggerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8048f548-be30-4b3d-be01-9351808a5969",
                                "sense_id": "927e53ad-7453-3ffc-bcd8-7af0e9c2333c",
                                "text": "Herr Eggerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9976ca6f-5bab-429f-a167-0e6133ae9751",
                                "sense_id": "927e53ad-7453-3ffc-bcd8-7af0e9c2333c",
                                "text": "Die Eggerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8f9c7e78-f218-466f-87b2-1096860d6770",
                                "sense_id": "927e53ad-7453-3ffc-bcd8-7af0e9c2333c",
                                "text": "Der Eggerle trägt nie die Pullover, die die Eggerle ihm strickt."
                            },
                            {
                                "example_id": "f0d5cc7f-8028-49db-8b89-8db8704a1eac",
                                "sense_id": "927e53ad-7453-3ffc-bcd8-7af0e9c2333c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eggerle kommt, geht der Herr Eggerle.“"
                            },
                            {
                                "example_id": "fb72fccf-6e37-42ec-81a2-ca3fa241e949",
                                "sense_id": "927e53ad-7453-3ffc-bcd8-7af0e9c2333c",
                                "text": "Eggerle kommt und geht."
                            },
                            {
                                "example_id": "4bdc1138-253a-479e-a24d-9cc9c50b787c",
                                "sense_id": "927e53ad-7453-3ffc-bcd8-7af0e9c2333c",
                                "text": "Eggerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
