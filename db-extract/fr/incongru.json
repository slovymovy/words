                    },
                    {
                        "form_id": "38bb414e-f070-4956-82fb-9d2adf34633e",
                        "entry_id": "7120923d-06b1-393c-9a7e-5c0fec982b52",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "incongrue"
                    },
                    {
                        "form_id": "4ecdbfbe-f1cc-49cf-9eb5-a7dc9286384d",
                        "entry_id": "7120923d-06b1-393c-9a7e-5c0fec982b52",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "incongrues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2593e1b8-deb7-3006-88d4-6555abc93378",
                        "entry_id": "7120923d-06b1-393c-9a7e-5c0fec982b52",
                        "glosses": [
                            "Qui n’est convenable ni aux personnes, ni aux circonstances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5195c0f9-57f3-4d19-9639-ef846c3c19dc",
                                "sense_id": "2593e1b8-deb7-3006-88d4-6555abc93378",
                                "text": "Vous ne vous fâcherez pas si je vous demande quelque chose d'incongru ?"
                            },
                            {
                                "example_id": "85292d1d-4c22-417d-868a-d3d4da565a0e",
                                "sense_id": "2593e1b8-deb7-3006-88d4-6555abc93378",
                                "text": "Confier sa vie n’est pas livrer son âme, et si j’aime Manuela comme une sœur, je ne peux partager avec elle ce qui tisse le peu de sens et d’émoi que mon existence incongrue dérobe à l’univers."
                            },
                            {
                                "example_id": "f8a5dee3-e583-4f9b-a184-da8062c2cc84",
                                "sense_id": "2593e1b8-deb7-3006-88d4-6555abc93378",
                                "text": "Je suis conscient qu’en ces jours de crise, toute expression d’admiration de l’esprit américain peut paraître incongrue."
                            },
                            {
                                "example_id": "5902fca5-30c8-40d4-96b5-8f060f17fdf6",
                                "sense_id": "2593e1b8-deb7-3006-88d4-6555abc93378",
                                "text": "Réponse incongrue."
                            },
                            {
                                "example_id": "79f59982-83eb-4da8-8fa2-5402b051f506",
                                "sense_id": "2593e1b8-deb7-3006-88d4-6555abc93378",
                                "text": "Démarche incongrue."
                            }
                        ]
                    },
                    {
                        "sense_id": "323cfc5d-2f1c-342b-b461-07c7246c817a",
                        "entry_id": "7120923d-06b1-393c-9a7e-5c0fec982b52",
                        "glosses": [
                            "Pour une personne, manquer de bienséance, de savoir-vivre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "26c5e50b-42b7-4852-85ee-bcc5e6290b73",
                                "sense_id": "323cfc5d-2f1c-342b-b461-07c7246c817a",
                                "text": "J’observai une mouche incongrue qui avait échappé aux désinfections périodiques"
                            },
                            {
                                "example_id": "88e72711-5754-44dc-8016-383080873a38",
                                "sense_id": "323cfc5d-2f1c-342b-b461-07c7246c817a",
                                "text": "Afin d’amuser la gal’rie\n Je crache des gauloiseries\n Des pleines bouches de mots crus\n Tout à fait incongrus"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e73cde1d-5972-4afb-9cfa-58c7118bd8c8",
                        "source_entry_id": "7120923d-06b1-393c-9a7e-5c0fec982b52",
                        "source_sense_description": "Qui ne convient pas",
                        "target_lang_word": "incongruous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incongruous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "625c0878-2667-306a-93a0-12904b3ed800",
                                        "entry_id": "10e01952-0e72-3283-af33-68692d829d38",
                                        "glosses": [
                                            "Not similar or congruent; not matching or fitting in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "724f6197-3885-46ec-bc08-f7dd52af9060",
                                                "sense_id": "625c0878-2667-306a-93a0-12904b3ed800",
                                                "text": "[P]erhaps he thought me, with my basket of summer fruit, and my lack of the dignity age confers, an incongruous figure in such a scene."
                                            },
                                            {
                                                "example_id": "a5651a90-2190-41ac-ab33-5316eec363ed",
                                                "sense_id": "625c0878-2667-306a-93a0-12904b3ed800",
                                                "text": "Ona was blue-eyed and fair, while Jurgis had great black eyes with beetling brows, and thick black hair that curled in waves about his ears—in short, they were one of those incongruous and impossible married couples with which Mother Nature so often wills to confound all prophets."
                                            },
                                            {
                                                "example_id": "8af30cfc-6dfc-4758-a230-f9af40f3e130",
                                                "sense_id": "625c0878-2667-306a-93a0-12904b3ed800",
                                                "text": "Ardent suns had likewise tanned his face till it was swarthy as a Spaniard's. The yellow mustache appeared incongruous in the midst of such swarthiness."
                                            },
                                            {
                                                "example_id": "4536210a-d0fe-4df5-bd87-f33c8553c9e2",
                                                "sense_id": "625c0878-2667-306a-93a0-12904b3ed800",
                                                "text": "A slightly incongruous note is struck by the National Westminster Bank beside the Vine [pub], a tiny dolls' house of a building, about the size of a garden shed, in herringbone-patterned brick."
                                            },
                                            {
                                                "example_id": "272844c6-68b6-45f1-bcc0-ecd630274cd3",
                                                "sense_id": "625c0878-2667-306a-93a0-12904b3ed800",
                                                "text": "For a few moments England toyed with the idea of making it a more difficult night than necessary. Scotland had scored a goal that seemed incongruous to the rest of their performance and, briefly, a fiercely partisan crowd sensed an improbable comeback."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e1f45dc-296f-3058-92d5-ae9b14dc5107",
                                        "entry_id": "10e01952-0e72-3283-af33-68692d829d38",
                                        "glosses": [
                                            "Of two numbers, with respect to a third, such that their difference can not be divided by it without a remainder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a370443b-d66e-43e7-b45f-a92116c26627",
                                                "sense_id": "1e1f45dc-296f-3058-92d5-ae9b14dc5107",
                                                "text": "20 and 25 are incongruous with respect to 4."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "265b98e0-6426-4436-98d6-f554798517a7",
                        "source_entry_id": "7120923d-06b1-393c-9a7e-5c0fec982b52",
