            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a0081dbf-5ed1-3725-8493-f482525dcbe1",
                    "sense_definition": "cecha kogoś lub czegoś polegająca na skłonności do działania podstępem, nieszczerości i chytrości",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "podstepnosc_ogolna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy w biurze obawiali się jego <w>podstępności</w>, ponieważ potrafił manipulować ludźmi dla własnych korzyści.",
                            "target_lang_translations": {
                                "ru": "Все в офисе опасались его <w>коварства</w>, так как он умел манипулировать людьми ради собственной выгоды."
                            }
                        },
                        {
                            "text": "Zaskoczyła nas niezwykła <w>podstępność</w> tego planu, przygotowanego w najmniejszych szczegółach.",
                            "target_lang_translations": {
                                "ru": "Нас удивило необычайное <w>коварство</w> этого плана, продуманного до мельчайших деталей."
                            }
                        }
                    ],
                    "synonyms": [
                        "chytrość",
                        "dwulicowość",
                        "fałszywość",
                        "przebiegłość",
                        "przewrotność",
                        "wykrętność"
                    ],
                    "antonyms": [
                        "prostolinijność",
                        "szczerość",
                        "uczciwość"
                    ],
                    "common_phrases": [
                        "wykazać się podstępnością"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство человека или его поступков, заключающееся в склонности действовать обманом, хитростью и неискренностью"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коварство",
                                "target_lang_sense_clarification": "о поведении человека, интригах, планах"
                            },
                            {
                                "target_lang_word": "лукавство",
                                "target_lang_sense_clarification": "хитрость, неискренность"
                            },
                            {
                                "target_lang_word": "вероломство",
                                "target_lang_sense_clarification": "предательское коварство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8881d082-278e-30e0-b71b-b7d31810160c",
                    "sense_definition": "cecha zjawiska, sytuacji lub choroby polegająca na utajonym, zwodniczym i niebezpiecznym charakterze",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "podstepnosc_ogolna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Główna <w>podstępność</w> tego schorzenia polega na tym, że przez długi czas nie daje żadnych widocznych objawów.",
                            "target_lang_translations": {
                                "ru": "Главное <w>коварство</w> этого заболевания заключается в том, что долгое время оно не даёт никаких видимых симптомов."
                            }
                        },
                        {
                            "text": "Lekarz wyjaśnił pacjentowi <w>podstępność</w> infekcji, która rozwijała się powoli bez gorączki.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил пациенту <w>коварство</w> инфекции, развивавшейся медленно и без температуры."
                            }
                        }
                    ],
                    "synonyms": [
                        "fałszywość",
                        "przewrotność"
                    ],
                    "common_phrases": [
                        "podstępność choroby"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство явления, ситуации или болезни, заключающееся в скрытом, обманчивом и опасном характере протекания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коварство",
                                "target_lang_sense_clarification": "о болезни, скрытой угрозе, опасности"
                            },
                            {
                                "target_lang_word": "обманчивость",
                                "target_lang_sense_clarification": "скрытый, ложный характер"
                            }
                        ]
                    }
                }
            ]
        }
    ]
