{
    "word_family": [
        "resurrection",
        "resurrector"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3c667f7-0228-3c61-942e-8748b580e1dd",
                    "sense_definition": "To bring a dead person or animal back to life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "literal_life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The powerful wizard used a spell to <w>resurrect</w> the fallen hero.",
                            "target_lang_translations": {
                                "ru": "Могущественный волшебник использовал заклинание, чтобы <w>воскресить</w> павшего героя.",
                                "de": "Der mächtige Zauberer nutzte einen Zauberspruch, um den gefallenen Helden <w>aufzuerwecken</w>."
                            }
                        },
                        {
                            "text": "Many ancient myths tell stories of gods who can <w>resurrect</w> the dead.",
                            "target_lang_translations": {
                                "ru": "Многие древние мифы рассказывают истории о богах, которые могут <w>воскрешать</w> мертвых.",
                                "de": "Viele alte Mythen erzählen Geschichten von Göttern, die die Toten <w>auferwecken</w> können."
                            }
                        }
                    ],
                    "synonyms": [
                        "revive"
                    ],
                    "common_phrases": [
                        "resurrect the dead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуть умершего человека или животное к жизни.",
                        "de": "Eine tote Person oder ein totes Tier wieder zum Leben erwecken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воскресить",
                                "target_lang_sense_clarification": "вернуть к жизни"
                            },
                            {
                                "target_lang_word": "воскрешать",
                                "target_lang_sense_clarification": "оживлять мертвых"
                            },
                            {
                                "target_lang_word": "оживить",
                                "target_lang_sense_clarification": "вернуть жизненные силы"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auferwecken",
                                "target_lang_sense_clarification": "von den Toten auferstehen lassen"
                            },
                            {
                                "target_lang_word": "wiederbeleben",
                                "target_lang_sense_clarification": "ins Leben zurückholen"
                            },
                            {
                                "target_lang_word": "wiedererwecken",
                                "target_lang_sense_clarification": "wieder lebendig machen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0962bf4c-6ede-3af1-a71c-2484a1fa593a",
                    "sense_definition": "To bring something such as a custom, idea, or plan back into use or existence after it has disappeared or been forgotten.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "figurative_restore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director hopes to <w>resurrect</w> his career with this new movie.",
                            "target_lang_translations": {
                                "ru": "Режиссер надеется <w>возродить</w> свою карьеру с помощью этого нового фильма.",
                                "de": "Der Regisseur hofft, seine Karriere mit diesem neuen Film <w>wiederzubeleben</w>."
                            }
                        },
                        {
                            "text": "Why <w>resurrect</w> the idea almost 25 years later?",
                            "target_lang_translations": {
                                "ru": "Зачем <w>воскрешать</w> эту идею спустя почти 25 лет?",
                                "de": "Warum die Idee fast 25 Jahre später <w>wiederbeleben</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "revive"
                    ],
                    "common_phrases": [
                        "resurrect a career",
                        "resurrect a plan",
                        "resurrect an idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуть к жизни или восстановить что-то (обычай, идею, план), что исчезло или было забыто.",
                        "de": "Etwas wie einen Brauch, eine Idee oder einen Plan wieder aufgreifen oder erneuern, nachdem es verschwunden oder vergessen war."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возродить",
                                "target_lang_sense_clarification": "восстановить"
                            },
                            {
                                "target_lang_word": "воскресить",
                                "target_lang_sense_clarification": "вернуть из забвения"
                            },
                            {
                                "target_lang_word": "реанимировать",
                                "target_lang_sense_clarification": "восстановить активность"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wiederbeleben",
                                "target_lang_sense_clarification": "Traditionen, Pläne oder Karrieren erneuern"
                            },
                            {
                                "target_lang_word": "neu auflegen",
                                "target_lang_sense_clarification": "einen Plan oder eine Idee wiederaufgreifen"
                            },
                            {
                                "target_lang_word": "wiederaufleben lassen",
                                "target_lang_sense_clarification": "etwas Altes wieder in Gebrauch bringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "562752a7-549c-312b-a60c-b9e22230930c",
                    "sense_definition": "To return to life after being dead.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "literal_life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the legend, the magical bird burns and then <w>resurrects</w> from its own ashes.",
                            "target_lang_translations": {
                                "ru": "Согласно легенде, волшебная птица сгорает, а затем <w>воскресает</w> из собственного пепла.",
                                "de": "In der Legende verbrennt der magische Vogel und <w>ersteht</w> dann aus seiner eigenen Asche <w>wieder auf</w>."
                            }
                        },
                        {
                            "text": "The villagers believed that the spirit would <w>resurrect</w> in a new form.",
                            "target_lang_translations": {
                                "ru": "Жители деревни верили, что дух <w>воскреснет</w> в новой форме.",
                                "de": "Die Dorfbewohner glaubten, dass der Geist in einer neuen Gestalt <w>auferstehen</w> würde."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуться к жизни после смерти.",
                        "de": "Nach dem Tod wieder lebendig werden; aus dem Tod zurückkehren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воскреснуть",
                                "target_lang_sense_clarification": "вернуться к жизни"
                            },
                            {
                                "target_lang_word": "воскресать",
                                "target_lang_sense_clarification": "восставать из мертвых"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auferstehen",
                                "target_lang_sense_clarification": "von den Toten zurückkehren"
                            },
                            {
                                "target_lang_word": "wiederauferstehen",
                                "target_lang_sense_clarification": "aus der Asche oder dem Tod neu entstehen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}