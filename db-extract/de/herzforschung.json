                "senses": [
                    {
                        "sense_id": "f3371262-f860-3453-af9f-0fa43d450f68",
                        "entry_id": "e819d38e-8827-3997-bd23-9316cefeee2a",
                        "glosses": [
                            "wissenschaftliche Forschung des menschlichen Herzens, insbesondere mit dem Ziel, neue Präventions-, Diagnose- und Behandlungsmethoden zu entwickeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acb9bd42-955d-448c-b1b2-c372206e36cb",
                                "sense_id": "f3371262-f860-3453-af9f-0fa43d450f68",
                                "text": "„Als medizinische Kapazität auf dem Gebiet der Herzforschung ist er in Fachkreisen unumstritten.“"
                            },
                            {
                                "example_id": "fa6cea68-3494-4b9f-9287-592bfefab712",
                                "sense_id": "f3371262-f860-3453-af9f-0fa43d450f68",
                                "text": "„In den letzten fünf Jahren, so berichtete Manning auf einer Versammlung des American College of Cardiology, der amerikanischen Akademie für Herzforschung, konnten 24 Herzen abgestürzter Piloten der kanadischen Luftwaffe untersucht werden.“"
                            },
                            {
                                "example_id": "0ac2f787-034e-4ffc-84d6-ec8b2daf40ac",
                                "sense_id": "f3371262-f860-3453-af9f-0fa43d450f68",
                                "text": "„Die Deutsche Stiftung für Herzforschung fördert mit rund 58000 Euro die Fortsetzung einer bereits 2015 gestarteten Studie am Universitätsklinikum Erlangen: Untersucht werden Heranwachsende, die im Kleinkindalter wegen eines Ventrikelseptumdefekts (VSD) am Herzen operiert wurden.“"
                            },
                            {
                                "example_id": "3d9b4827-4f85-4373-ba92-57af0ac242c0",
                                "sense_id": "f3371262-f860-3453-af9f-0fa43d450f68",
                                "text": "„Basis für das Modell sind komplexe Differentialgleichungen, wie sie auch in der Herzforschung verwendet werden.“"
                            },
                            {
                                "example_id": "65829a8a-af5b-48b9-b980-ec6adc0ace1c",
                                "sense_id": "f3371262-f860-3453-af9f-0fa43d450f68",
                                "text": "„Auf dem 20. Kardiologischen Symposium in der Theresienklinik Bad Krozingen wurden wieder aktuelle Themen der Herzforschung und Herzchirurgie diskutiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
