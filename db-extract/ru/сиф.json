                        "entry_id": "9e19ae37-c286-3d89-b0f2-b29dade3404d",
                        "glosses": [
                            "вогнутый узкий гребень подвижного бархана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db6871d9-3de9-42c9-9754-591b99044f67",
                                "sense_id": "c3a7c7e1-7d8e-34d5-8135-73add9f7f5d7",
                                "text": "При правильном же разгоне передние колеса, проломив сиф ― узкий гребень бархана ― и зависнув на мгновение в пустоте, обрушиваются вниз."
                            }
                        ]
                    }
