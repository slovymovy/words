                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129464fd-d64d-4f60-9ad1-d413680ce42a",
                                "sense_id": "3cd61e31-75e0-334f-b416-122622314731",
                                "text": "Zakonnica poprosiła o pomoc swojego spowiednika z zakonu redemtorystów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "dcb9bd0d-1f4b-39a8-bfb9-8446edb0dc5b",
                        "entry_id": "a3750246-ccaa-315e-9cd9-ab7595568725",
                        "glosses": [
                            "osoba, której ktoś się zwierza"
                        ],
                        "tags": [],
