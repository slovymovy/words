                ],
                "senses": [
                    {
                        "sense_id": "84b416cf-f474-30e0-b3e6-fdd96d933535",
                        "entry_id": "664df795-f360-31dc-a13e-3dec9741f5aa",
                        "glosses": [
                            "Stoff, der andere Stoffe oxidieren kann, und dabei selbst reduziert wird (das heißt Elektronen aufnimmt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77623c31-1e4e-463a-b5af-d7ec2f0238dc",
                                "sense_id": "84b416cf-f474-30e0-b3e6-fdd96d933535",
                                "text": "„Oxidationsmittel reagieren mit Reduktionsmitteln in einer Redoxreaktion, darauf beruht z.B. auch das maßanalytische Verfahren der Redoxtitration.“"
                            },
                            {
                                "example_id": "68acf5af-96c7-405d-b7b7-1bd95f184a56",
                                "sense_id": "84b416cf-f474-30e0-b3e6-fdd96d933535",
                                "text": "„Starke Oxidationsmittel wie Kaliumhydroxid-Kaliumnitrat- oder Natriumhydroxid-Natriumperoxid-Schmelzen oxidieren Ruthenium schnell.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eac12d0-2633-498c-9861-575fb398072f",
