                ],
                "senses": [
                    {
                        "sense_id": "48c4394f-10bc-39ba-aaaa-a9db4d4a05ca",
                        "entry_id": "3716c220-14ee-392c-bdf4-c0163bd175a7",
                        "glosses": [
                            "Mischung aus Hochdeutsch, Niederdeutsch und Dänisch, welche bei dem Versuch einiger plattdeutsch und dänisch sprechender Bürgerfrauen entstand, auf Hochdeutsch Konversation zu betreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "211e982a-d607-4cbe-9e8e-19b52eed56be",
                                "sense_id": "48c4394f-10bc-39ba-aaaa-a9db4d4a05ca",
                                "text": "Das Petuh-Tanten-Deutsche gibt es nur in Flensburg und Umgebung."
                            },
                            {
                                "example_id": "e2679eb8-a142-4cd4-85cd-f7f975609df1",
                                "sense_id": "48c4394f-10bc-39ba-aaaa-a9db4d4a05ca",
                                "text": "„Das in Flensburg gesprochene Petuh ist mit dem Dänischen verwandt. Es basiert zum Teil auf der dänischen Grammatik (Satzbau) und einer Reihe von Danismen, ist jedoch vom Wortschatz her eher dem Plattdeutschen ähnlich, weshalb es auch dort eingeordnet und häufig als Petuh-Tanten-Deutsch bezeichnet wird.“"
                            },
                            {
                                "example_id": "ad8234c9-52c1-423e-83df-50d817ae2a3f",
                                "sense_id": "48c4394f-10bc-39ba-aaaa-a9db4d4a05ca",
                                "text": "„Es wird spannend. Welcher der Kandidaten kann Fragen wie ‚Was versteht man unter Petuh-Tanten-Deutsch?‘ oder ‚Was ist ein Wasserpass?‘ richtig beantworten?“"
                            },
                            {
                                "example_id": "377b7ef7-8125-48b7-911d-b39fb1d0105c",
                                "sense_id": "48c4394f-10bc-39ba-aaaa-a9db4d4a05ca",
                                "text": "„Die Schauspielerin engagiert sich für den Erhalt der plattdeutschen Sprache und auch für das ‚Petuh-Tanten-Deutsch,‘ von dem die 84-Jährige am 9. März einige Kostproben geben wird.“"
                            },
                            {
                                "example_id": "0f4e5bb1-3c5b-4c66-ab30-191908948567",
                                "sense_id": "48c4394f-10bc-39ba-aaaa-a9db4d4a05ca",
                                "text": "„Das Petuh beruht teilweise auf dänischer Grammatik (Satzbau), einer Reihe Danismen, ist aber vom Wortschatz her dem Hoch- und Niederdeutschen sehr ähnlich, so dass es dort eingeordnet und auch als Petuh-Tanten-Deutsch bekannt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
