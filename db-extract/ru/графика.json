                "senses": [
                    {
                        "sense_id": "786c7938-a766-31fc-8620-6bd699361428",
                        "entry_id": "b30f3358-d92b-3035-96dd-25eae5442e86",
                        "glosses": [
                            "жанр изобразительного искусства, основанный на использовании линий и штрихов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2171bbf7-a58a-4534-a13c-0e2c5dcff69c",
                                "sense_id": "786c7938-a766-31fc-8620-6bd699361428",
                                "text": "Для поступления на художественный факультет надо сдать экзамены по живописи и графике."
                            }
                        ]
                    },
                    {
                        "sense_id": "17b81320-aceb-35be-9e43-55bd141a925a",
                        "entry_id": "b30f3358-d92b-3035-96dd-25eae5442e86",
                        "glosses": [
                            "совокупность средств какой-либо письменности; начертания букв, знаков"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fdd1abb-f3d5-4cfb-8477-b9e3e480da20",
                                "sense_id": "17b81320-aceb-35be-9e43-55bd141a925a",
                                "text": "Русский язык использует кириллическую графику, английский — латинскую."
                            }
                        ]
                    },
                    {
                        "sense_id": "c15482c2-a6b3-3e28-a421-1cf19cf2e954",
                        "entry_id": "b30f3358-d92b-3035-96dd-25eae5442e86",
                        "glosses": [
                            "техн. вообще любые изображения, выводимые на экран мониторов, принтеры и другие устройства такого рода, а также программные и аппаратные средства для работы с цифровым изображением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76a0f0cf-f586-4f4f-9998-5aec1e2dddad",
                                "sense_id": "c15482c2-a6b3-3e28-a421-1cf19cf2e954",
                                "text": "Компьютерная графика."
                            },
                            {
                                "example_id": "99702079-00c7-4510-a5ae-4790b96259da",
                                "sense_id": "c15482c2-a6b3-3e28-a421-1cf19cf2e954",
                                "text": "Трёхмерная графика."
                            }
                        ]
                    }
