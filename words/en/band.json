            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c799f987-8c2a-3aa7-b35b-3b41672c9ac0",
                    "sense_definition": "To join together as a group to achieve a common purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbors decided to <w>band</w> together to clean up the local park.",
                            "target_lang_translations": {
                                "ru": "Соседи решили <w>объединиться</w>, чтобы убрать местный парк.",
                                "zh": "邻居们决定<w>联合</w>起来清理当地的公园。"
                            }
                        },
                        {
                            "text": "We must <w>band</w> together if we want to defeat the enemy.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>сплотиться</w>, если хотим победить врага.",
                                "zh": "如果我们想打败敌人，就必须<w>团结</w>起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unite",
                        "group",
                        "join forces",
                        "team up"
                    ],
                    "antonyms": [
                        "disband",
                        "separate"
                    ],
                    "common_phrases": [
                        "band together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединяться в группу для достижения общей цели.",
                        "zh": "为了实现共同目标而联合起来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединя́ться",
                                "target_lang_sense_clarification": "в группу"
                            },
                            {
                                "target_lang_word": "сплоти́ться",
                                "target_lang_sense_clarification": "для совместных действий"
                            }
                        ],
                        "zh": [
