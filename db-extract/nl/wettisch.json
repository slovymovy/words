                        "entry_id": "6dc1cd98-5da1-3412-a0c4-077ddda0783f",
                        "glosses": [
                            "overdreven gericht op het strikt naleven van voorschriften met verwaarlozing van de bedoelingen daarachter"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9e8a10a0-1994-4599-a48c-5b1033f246b2",
                                "sense_id": "dd4930ab-3dd4-314c-9ad6-d0fe9e7c5f36",
                                "text": "De internationale rechtsorde staat voorop, maar komt het zo uit, dan gaat Nederland zijn eigen gang. Verdrag en wet dienen heel wettisch gerespecteerd, totdat discretie ons beter schikt."
                            }
                        ]
                    },
