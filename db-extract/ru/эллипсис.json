                            {
                                "target_word": "ellipse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "349f6e97-b0e5-3a07-8056-2d95057eefd4",
                                        "entry_id": "979bf6d6-7c41-33bb-b648-9fcea0baf585",
                                        "glosses": [
                                            "Suppression d’un élément de phrase sans changement de signification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb2a1847-aa88-47b4-891d-bbcd45079163",
                                                "sense_id": "349f6e97-b0e5-3a07-8056-2d95057eefd4",
                                                "text": "Ce sont les troncations de mot, produisant des fragments, qui peuvent être analysées comme de véritables ellipses lexicales, parfois doublées d’une rupture au niveau propositionnel entraînant une ellipse syntaxique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "528b3347-a44a-3b1b-bf85-6e63cf2451d3",
                                        "entry_id": "979bf6d6-7c41-33bb-b648-9fcea0baf585",
                                        "glosses": [
                                            "Points de suspension. Série de trois points ([…] ou …) signalant une énumération incomplète."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f3a590-91c6-49ab-8d9d-4077fbf50f29",
                                                "sense_id": "528b3347-a44a-3b1b-bf85-6e63cf2451d3",
                                                "text": "La formule etc. ne doit jamais être suivie d’une ellipse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50f437b3-f1f3-3e1a-8f74-f4403ab876bf",
                                        "entry_id": "979bf6d6-7c41-33bb-b648-9fcea0baf585",
                                        "glosses": [
                                            "Suppression d’actions entre deux séquences d’un film, qui n’altère pas la compréhension du récit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e64a9a48-2612-41a8-ab15-8d1440bad7e5",
                                                "sense_id": "50f437b3-f1f3-3e1a-8f74-f4403ab876bf",
                                                "text": "Toute la beauté du film tient en ce déchirant paradoxe tenu bientôt, en quelques ellipses élégantes, par le seul couple survivant du père et de sa fille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
