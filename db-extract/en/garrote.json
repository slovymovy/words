    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f30cb59d-c8c2-33ed-b1ae-e9b556a9e346",
                "word": "garrote",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9d7ca46a-5c1c-464a-b664-139176be9aba",
                        "entry_id": "f30cb59d-c8c2-33ed-b1ae-e9b556a9e346",
                        "tags": [
                            "plural"
                        ],
                        "form": "garrotes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ab687a0-e7ef-3504-8708-9205157e581e",
                        "entry_id": "f30cb59d-c8c2-33ed-b1ae-e9b556a9e346",
                        "glosses": [
                            "An iron collar formerly used in Spain to execute people by strangulation."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f501a783-220c-432c-a95a-6a01c07fedcc",
                                "sense_id": "5ab687a0-e7ef-3504-8708-9205157e581e",
                                "text": "[…] promising that, by so doing, the painful death to which he had been sentenced should be commuted for the milder form of the garrote,—a mode of punishment by strangulation, used for criminals in Spain."
                            },
                            {
                                "example_id": "feafa006-f559-42f7-b082-d183fa83acee",
                                "sense_id": "5ab687a0-e7ef-3504-8708-9205157e581e",
                                "text": "The prison, scaffold, garrote, handcuffs, iron necklace and leadballs do their work, / The named and unnamed heroes pass to other spheres,"
                            },
                            {
                                "example_id": "a72b0f5f-32c2-4315-90ea-a970e4bc915e",
                                "sense_id": "5ab687a0-e7ef-3504-8708-9205157e581e",
                                "text": "The Spanish had responded to the insurgency with characteristic brutality. They gave rebels the \"usual four shots in the back\" or the garrote—an iron collar tightened around the victim's neck with a screw until he was strangled to death."
                            }
                        ]
                    },
                    {
                        "sense_id": "7af4c06f-bfaa-3a06-804a-b150655bcb5f",
                        "entry_id": "f30cb59d-c8c2-33ed-b1ae-e9b556a9e346",
                        "glosses": [
                            "Something, especially a cord or wire, used for strangulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9a4f83-348f-46c0-b915-0045763ed03f",
                                "sense_id": "7af4c06f-bfaa-3a06-804a-b150655bcb5f",
                                "text": "The mob boss was known for having his enemies executed with a garrote of piano wire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "133e0026-b793-4b90-8108-93149b5da37f",
                        "source_entry_id": "f30cb59d-c8c2-33ed-b1ae-e9b556a9e346",
                        "source_sense_description": "iron collar used to execute by strangulation",
                        "target_lang_word": "wurgpaal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wurgpaal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2e4c82f2-f999-3729-8b62-a4767366d47a",
                                        "entry_id": "6d001b62-1387-3f19-931c-12946fb9f803",
                                        "glosses": [
                                            "een instrument voor de voltrekking van de doodstraf, waarbij de veroordeelde aan een paal vastgebonden wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce5691c7-57cd-4c15-b43d-77798c43a4c7",
                                                "sense_id": "2e4c82f2-f999-3729-8b62-a4767366d47a",
                                                "text": "De roman ”De schilder en het meisje” van Margriet de Moor speelt zich af op een prachtige lentedag. Het lijkt bijna onrechtvaardig dat er juist op deze dag iemand terechtgesteld zal worden. Elsje Christiaens is een jonge vrouw uit Denemarken. Ze woont nog maar kort in Amsterdam en is wegens moord op haar pensionhoudster veroordeeld tot de publieke wurgdood. Haar levensverhaal vlecht De Moor ineen met de vaak heftige en droevige herinneringen die Rembrandt bezighouden. Ze laat de beide verhaallijnen prachtig samenkomen in een ontmoeting: de schilder bezoekt het dode lichaam van Elsje aan de wurgpaal en legt haar vast op twee pentekeningen."
                                            },
                                            {
                                                "example_id": "c01fdff9-0896-4f68-8684-1f5d7cf2b45c",
                                                "sense_id": "2e4c82f2-f999-3729-8b62-a4767366d47a",
                                                "text": "Salvador (Manuel Huerga, 2006, Spanje). Biografische film over Salvador Puig Antich (1948-1974), een linkse student die in opstand kwam tegen het regime in Spanje en die een van de laatsten was die door generaal Franco’s geheime politie aan de garrote (wurgpaal) werd geëxecuteerd. De activist had de gewoonte om banken te beroven. Hoofdrol Daniel Brühl. Canvas, 20.40-22.50u."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
