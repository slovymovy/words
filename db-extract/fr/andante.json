            {
                "entry_id": "f28ce38a-b467-34a6-bee0-628cf680c056",
                "word": "andante",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5ad94ff3-2013-48b6-a47f-97ee90acf87b",
                        "entry_id": "f28ce38a-b467-34a6-bee0-628cf680c056",
                        "tags": [
