                "senses": [
                    {
                        "sense_id": "4464e2d7-f19c-3c60-85cf-bb24a91f46a9",
                        "entry_id": "1d35c791-9ec4-3c32-a310-925743ac8dda",
                        "glosses": [
                            "Aktivistin aus der Umweltschutzbewegung mit dem Ziel, durch Mittel des zivilen Ungehorsams Maßnahmen der deutschen und der österreichischen Bundesregierung gegen die Klimakrise zu erzwingen"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "caaf67c7-89de-4b67-99b6-ad090d18acfe",
                                "sense_id": "4464e2d7-f19c-3c60-85cf-bb24a91f46a9",
                                "text": "„Die 20-Jährige ist eine sogenannte Klimakleberin und Teil der Gruppe Letzte Generation.“"
                            },
                            {
                                "example_id": "798167c3-2d33-4b75-b2bf-f694e5a789e6",
                                "sense_id": "4464e2d7-f19c-3c60-85cf-bb24a91f46a9",
                                "text": "„Die 24jährige Emily Brocklebank erscheint zu ihrem Termin im Amtsgericht London-Westminster – die Haftstrafe der Klimakleberin wurde unmittelbar nach der Urteilsverkündung ausgesetzt.“"
                            },
                            {
                                "example_id": "a2bc695b-2196-49fd-b3f2-e9f5bc713734",
                                "sense_id": "4464e2d7-f19c-3c60-85cf-bb24a91f46a9",
                                "text": "„Eine 23-jährige Klimakleberin wurde entsprechend zur Synode der Evangelischen Kirche im November eingeladen und mit stehenden Ovationen gefeiert.“"
                            },
                            {
                                "example_id": "af101d95-e850-40ea-be77-f2eeedf30ecf",
                                "sense_id": "4464e2d7-f19c-3c60-85cf-bb24a91f46a9",
                                "text": "„Ist Meghan Markle eine Klimakleberin?“"
                            },
                            {
                                "example_id": "4c2a1521-39cc-4629-9e4a-c520b892a788",
                                "sense_id": "4464e2d7-f19c-3c60-85cf-bb24a91f46a9",
                                "text": "„Die Klimakleberin aus dem Kölner Stadtrat übergibt ihr Amt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
