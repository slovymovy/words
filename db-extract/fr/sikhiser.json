                        "glosses": [
                            "Donner un caractère sikh à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55b1942c-7dfd-4cc3-bd92-4a971f4e52d2",
                                "sense_id": "48278417-d0ab-33d6-9bdc-571862153d70",
                                "text": "Ils veulent \"sikhiser\" le Monde, alternative entre la néo-évangélisation du Saint-Siège et de l'Amérique de Bush et l'islamisation fondamentaliste, par les Fous de Dieu, de notre Terre mécréante."
                            },
                            {
                                "example_id": "8ebc786f-18ec-4957-9003-89ee710a0fc7",
                                "sense_id": "48278417-d0ab-33d6-9bdc-571862153d70",
                                "text": "Et d'ailleurs tous ces gens de religions minoritaires n'ont jamais voulu protestantiser, bouddhistiser, juiviser, sikhiser notre société."
                            }
                        ]
                    }
