                    {
                        "sense_id": "2be47b12-3f68-3f5f-bfab-8e0aa9516cfd",
                        "entry_id": "2d972110-4e8a-3288-874a-19aca3d4a053",
                        "glosses": [
                            "Fragaria, roślina o jadalnych, czerwonych owocach podobnych do truskawek, tylko mniejszych, rosnąca dziko, przeważnie w lasach, także uprawiana w ogrodach"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2561e928-7e2b-354b-9e6c-1188d2aff118",
                        "entry_id": "2d972110-4e8a-3288-874a-19aca3d4a053",
                        "glosses": [
                            "owoc poziomki (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7f1889-737f-4681-a021-d8a2ca70dbda",
                                "sense_id": "2561e928-7e2b-354b-9e6c-1188d2aff118",
                                "text": "Wiem, pamiętam, ty lubiłeś poziomki. / Pełną garścią wybierałeś z koszyka. / W tamtym lesie, gdzie gałęzie się plączą, / gdzie się drzewo z drugim drzewem dotyka."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
