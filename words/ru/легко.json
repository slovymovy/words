                {
                    "sense_id": "e9873629-928f-3fb0-96f8-83025bed7021",
                    "sense_definition": "Оценка ситуации или действия как не требующего больших усилий; нетрудно.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне <легко> говорить по-русски с моими друзьями.",
                            "target_lang_translations": {
                                "en": "It is <easy> for me to speak Russian with my friends.",
                                "zh": "我和朋友们说俄语觉得很<w>容易</w>。",
                                "nl": "Het is <w>makkelijk</w> voor mij om Russisch te spreken met mijn vrienden.",
                                "pl": "Mówienie po rosyjsku z moimi przyjaciółmi przychodzi mi <w>łatwo</w>.",
                                "de": "Es ist für mich <w>einfach</w>, mit meinen Freunden Russisch zu sprechen.",
                                "fr": "Il m'est <w>facile</w> de parler russe avec mes amis.",
                                "it": "Per me è <w>facile</w> parlare russo con i miei amici.",
                                "cs": "Mluvit rusky s mými přáteli je pro mě <w>snadné</w>.",
                                "tr": "Arkadaşlarımla Rusça konuşmak benim için <w>kolay</w>.",
                                "es": "Me resulta <w>fácil</w> hablar ruso con mis amigos."
                            }
                        },
                        {
                            "text": "Вам будет <легко> привыкнуть к новому расписанию.",
                            "target_lang_translations": {
                                "en": "It will be <easy> for you to get used to the new schedule.",
                                "zh": "你适应新的时间表会很<w>容易</w>。",
                                "nl": "Het zal <w>makkelijk</w> voor je zijn om aan het nieuwe rooster te wennen.",
                                "pl": "Będzie ci <w>łatwo</w> przyzwyczaić się do nowego harmonogramu.",
                                "de": "Es wird für Sie <w>einfach</w> sein, sich an den neuen Zeitplan zu gewöhnen.",
                                "fr": "Il vous sera <w>facile</w> de vous habituer au nouvel emploi du temps.",
                                "it": "Sarà <w>facile</w> per te abituarti al nuovo orario.",
                                "cs": "Bude pro vás <w>snadné</w> zvyknout si na nový rozvrh.",
                                "tr": "Yeni programa alışmanız <w>kolay</w> olacak.",
                                "es": "Le será <w>fácil</w> acostumbrarse al nuevo horario."
                            }
                        }
                    ],
                    "synonyms": [
                        "без труда",
                        "нетрудно",
                        "просто"
                    ],
                    "antonyms": [
                        "тру́дно",
                        "сло́жно",
                        "тяжело́"
                    ],
                    "common_phrases": [
                        "мне легко",
                        "это легко",
                        "будет легко"
                    ],
                    "target_lang_definitions": {
                        "en": "Assessment of a situation or action as not requiring much effort; not difficult.",
                        "zh": "评价某种情况或行为不需要花费很大力气；不难。",
                        "nl": "Beoordeling van een situatie of actie als niet veel inspanning vereisend; niet moeilijk.",
                        "pl": "Ocena sytuacji lub działania jako niewymagającego dużego wysiłku; nietrudne.",
                        "de": "Einschätzung einer Situation oder Handlung als nicht schwierig; erfordert keinen großen Aufwand.",
                        "fr": "Évaluation d'une situation ou d'une action qui ne nécessite pas beaucoup d'efforts ; pas difficile.",
                        "it": "Valutazione di una situazione o azione che non richiede molto sforzo; non difficile.",
                        "cs": "Hodnocení situace nebo činnosti jako nenáročné; není to těžké.",
                        "tr": "Bir durumun veya eylemin çok çaba gerektirmediğinin değerlendirilmesi; zor değil.",
                        "es": "Evaluación de una situación o acción que no requiere mucho esfuerzo; no es difícil."
                    },
