                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61421643-8ee7-4328-a4fe-bb0b60abb1e5",
                                "sense_id": "37d86caa-cf33-3b92-813d-4c1f65c9451f",
                                "text": "Pour retrouver la hauteur de chute initiale (2m50), il a fallu désalluvionner de 1m le canal de fuite, soutenir le chemin communal qui le longeait, renforcer les murs du moulin pour fixer la structure qui supporterait les turbines."
                            },
                            {
                                "example_id": "66fdf37b-45d2-43ed-aac3-65facb8152cc",
                                "sense_id": "37d86caa-cf33-3b92-813d-4c1f65c9451f",
                                "text": "En Angleterre, où la terre ne se désalluvionne pas, on a dû faire des prairies et appliquer les engrais."
                            }
                        ]
                    }
