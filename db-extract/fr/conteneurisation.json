                                        "entry_id": "ee458f52-06b3-3e34-9ee8-e66d40fa7c71",
                                        "glosses": [
                                            "Software virtualization at the level of the operating system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b99cd0ae-2dbc-4c0f-b10f-d0da45a39c84",
                                                "sense_id": "4a467dd8-309d-3663-b166-0e677d81e085",
                                                "text": "These cloud deployments become simple due to well-defined and matured cloud technologies such as containerization, virtual infrastructure, orchestration, CI/CD, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
