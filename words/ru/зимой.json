                    "sense_id": "64585794-2c2a-38df-82ff-c69415dd219d",
                    "sense_definition": "В зимнее время, в период между осенью и весной.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В России <w>зимой</w> часто идёт снег.",
                            "target_lang_translations": {
                                "en": "It often snows <w>in winter</w> in Russia.",
                                "nl": "In Rusland sneeuwt het vaak <w>in de winter</w>.",
                                "pl": "W Rosji <w>zimą</w> często pada śnieg.",
                                "de": "In Russland schneit es oft <w>im Winter</w>.",
                                "fr": "En Russie, il neige souvent <w>en hiver</w>.",
                                "it": "In Russia <w>d'inverno</w> nevica spesso.",
                                "cs": "V Rusku <w>v zimě</w> často sněží.",
                                "tr": "Rusya'da <w>kışın</w> sık sık kar yağar.",
                                "es": "En Rusia, <w>en invierno</w> suele nevar.",
                                "zh": "在俄罗斯，<w>冬天</w>经常下雪。"
                            }
                        },
                        {
                            "text": "Мы планируем поехать в горы этой <w>зимой</w>.",
                            "target_lang_translations": {
                                "en": "We plan to go to the mountains this <w>winter</w>.",
                                "nl": "We zijn van plan om deze <w>winter</w> naar de bergen te gaan.",
                                "pl": "Planujemy pojechać w góry tej <w>zimy</w>.",
                                "de": "Wir planen, <w>diesen Winter</w> in die Berge zu fahren.",
                                "fr": "Nous prévoyons d'aller à la montagne <w>cet hiver</w>.",
                                "it": "Abbiamo in programma di andare in montagna quest'<w>inverno</w>.",
                                "cs": "Plánujeme jet na hory <w>tuto zimu</w>.",
                                "tr": "Bu <w>kış</w> dağlara gitmeyi planlıyoruz.",
                                "es": "Planeamos ir a las montañas <w>este invierno</w>.",
                                "zh": "我们计划今年<w>冬天</w>去山上。"
                            }
                        }
                    ],
