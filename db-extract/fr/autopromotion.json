                    },
                    {
                        "sense_id": "09a8fc93-a5fd-3c37-b443-966a4af5572f",
                        "entry_id": "0e3a30b5-3d3a-3079-9fc7-b993bcf3e518",
                        "glosses": [
                            "Regroupement de particuliers pour assurer la promotion immobilière d’un projet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f00915a8-9ccf-468f-a2a9-fa3ebf157a61",
                                "sense_id": "09a8fc93-a5fd-3c37-b443-966a4af5572f",
                                "text": "Le concept d’autopromotion est simple : des particuliers se regroupent afin de concevoir, de financer et de réaliser ensemble un projet immobilier."
                            },
                            {
                                "example_id": "7646df01-4c14-435a-8687-b10aa72a2b27",
                                "sense_id": "09a8fc93-a5fd-3c37-b443-966a4af5572f",
                                "text": "L’autopromotion apparaît comme une solution citoyenne de démocratisation de l’accès au logement."
                            }
                        ]
                    }
                ],
