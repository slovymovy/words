                "senses": [
                    {
                        "sense_id": "730dcb7a-1f53-3310-b030-34d7e1c4f52a",
                        "entry_id": "bd92b830-5078-312a-a10c-97e180b8212b",
                        "glosses": [
                            "Vorschlag, dass und/oder wie bei einem bestimmten Problem geholfen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2db732db-b27c-4241-a4b5-8796e59ecb35",
                                "sense_id": "730dcb7a-1f53-3310-b030-34d7e1c4f52a",
                                "text": "„Und bis zu diesem Zeitpunkt hatte er auch ihre Hilfsangebote abgelehnt – obwohl gerade Schizophrenie als sehr gut behandelbar gilt.“"
                            },
                            {
                                "example_id": "dd48a9ba-ac1c-4584-aff3-6228b9db7125",
                                "sense_id": "730dcb7a-1f53-3310-b030-34d7e1c4f52a",
                                "text": "„Dabei sieht Hackenberg das autonome Fahren vornehmlich als Hilfsangebot, um den Fahrer vor folgenreichen Fehlern zu schützen.“"
                            },
                            {
                                "example_id": "5e4a1aec-d400-4f45-ae63-7b7fa4850f34",
                                "sense_id": "730dcb7a-1f53-3310-b030-34d7e1c4f52a",
                                "text": "„Nachdem ich mehrere Hilfsangebote ausgeschlagen hatte, erhielt ich Dr. Heizers Adresse und ging fort, auf der Suche nach seinem Wohnsitz.“"
                            },
                            {
                                "example_id": "a1407db9-2475-4f6b-9ef5-604995042ac3",
                                "sense_id": "730dcb7a-1f53-3310-b030-34d7e1c4f52a",
                                "text": "„Sehr erfreut über dieses Hilfsangebot hatte Thomas sich intensiv um seine finanzielle Basis für das geplante Unternehmen bemüht; und das nach Almuths endgültiger Zusage verstärkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
