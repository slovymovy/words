                "senses": [
                    {
                        "sense_id": "49691343-5a2c-34b5-b37e-209fb55108a0",
                        "entry_id": "b2889e33-7f51-319f-8991-137654f0c486",
                        "glosses": [
                            "gewölbte Felsformation"
