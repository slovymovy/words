                "senses": [
                    {
                        "sense_id": "5d52b089-6d59-3437-b45a-6b19ad108c75",
                        "entry_id": "c775b873-362e-340a-8413-36b1802676af",
                        "glosses": [
                            "Partie nord de la région autonome du Guangxi en Chine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04ecaf10-028f-4045-aaaa-a1cdce80a312",
                                "sense_id": "5d52b089-6d59-3437-b45a-6b19ad108c75",
                                "text": "Les héritages sont principalement répartis en centre-ville, avec des zones de regroupement de grands héritages tels que la zone de Guibei à Hanyang, l’usine sidérurgique de Hanyang, et des bâtiments particuliers tels que la gare de Gazhimen à Hankou, ou le bâtiment de bureaux de la première filature de Wuchang."
                            },
                            {
                                "example_id": "131788e0-aa03-4609-b201-fa87adb9c9e0",
                                "sense_id": "5d52b089-6d59-3437-b45a-6b19ad108c75",
                                "text": "À Wuhan, en dehors de l’ancienne zone portuaire en rive du fleuve transformée en parc public, l’ancienne entreprise industrielle de Guibei, en rive sud de la rivière Han (Hanyang) a été réaménagée et consacrée aux activités artistiques (Zao Art Zone), et un groupe d’usines de Hankou réaménagé en logements, bureaux et loisirs (Huayuandao)."
                            },
                            {
                                "example_id": "15226089-a8cb-4703-be28-fa7d668dfdba",
                                "sense_id": "5d52b089-6d59-3437-b45a-6b19ad108c75",
                                "text": "Guilin est au centre de la Zone Économique du Guibei (« Gui » désignant la province du Guangxi et « Bei » le nord)."
                            }
                        ]
                    }
