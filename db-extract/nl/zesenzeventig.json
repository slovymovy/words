                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc020e2-3707-48b0-a418-bff2196ae909",
                                "sense_id": "00e67bea-ed94-3867-a0f3-c6e05b530e37",
                                "text": "De zesenzeventig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
