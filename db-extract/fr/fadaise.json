        "fr-extract.jsonl": [
            {
                "entry_id": "b373d0d4-2261-34c8-9b6a-321d57495f57",
                "word": "fadaise",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b75c2ee-116b-4992-aa85-cd93eeb33412",
                        "entry_id": "b373d0d4-2261-34c8-9b6a-321d57495f57",
                        "tags": [
                            "plural"
                        ],
                        "form": "fadaises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9adaa706-396c-3a06-9761-790568f1cb75",
                        "entry_id": "b373d0d4-2261-34c8-9b6a-321d57495f57",
                        "glosses": [
                            "Propos qui n’a aucun intérêt, aucune saveur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecbf98c6-ee23-4c15-a9d0-55261f0f5da4",
                                "sense_id": "9adaa706-396c-3a06-9761-790568f1cb75",
                                "text": "Il n'est rien de plus inepte qu'un séminariste ; rien de moins propre à être un jour ce que l'on veut qu'il soit, un pasteur éclairé : ces jeunes gens n'ont la tète remplie que de fadaises mystiques."
                            },
                            {
                                "example_id": "3d55995e-3506-4747-8eeb-81bfe2442754",
                                "sense_id": "9adaa706-396c-3a06-9761-790568f1cb75",
                                "text": "Cette gentillesse qui abrégeait les formes et supprimait les fadaises ridicules que tout garçon se croit tenu de débiter à la belle fille dont il essaie de faire sa maîtresse, m'avait séduit."
                            },
                            {
                                "example_id": "e3a30114-b3a9-4c80-9310-97c975afaf84",
                                "sense_id": "9adaa706-396c-3a06-9761-790568f1cb75",
                                "text": "Et encore bien d’autres bénignités et fadaises que je lui débitais."
                            },
                            {
                                "example_id": "dac4dfda-ac9a-4eb4-9322-f612a3ddae39",
                                "sense_id": "9adaa706-396c-3a06-9761-790568f1cb75",
                                "text": "Mais comment ces détestables fadaises ont-elles pu s’accréditer?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85b450e8-0417-4b44-bece-383814fd6afc",
                        "source_entry_id": "b373d0d4-2261-34c8-9b6a-321d57495f57",
                        "source_sense_id": "9adaa706-396c-3a06-9761-790568f1cb75",
                        "source_sense_description": "Propos qui n’a aucun intérêt, aucune saveur",
                        "target_lang_word": "twaddle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twaddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                        "entry_id": "29704ed7-2ab5-36ea-b81a-037408cd321b",
                                        "glosses": [
                                            "Empty or silly idle talk or writing; nonsense, rubbish."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04c6d97c-9ef2-4685-aad9-136266240963",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "You're talking a load of twaddle. Get your facts straight, man!"
                                            },
                                            {
                                                "example_id": "ca87bb01-20fb-41b1-8a3e-77539214a92c",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "\"What ineffable twaddle!\" I cried, slapping the magazine down on the table; \"I never read such rubbish in my life.\""
                                            },
                                            {
                                                "example_id": "e6dd98eb-0953-479f-9298-ae517b816273",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "I would rather be rude than to listen to twaddle from a man I’ve known."
                                            },
                                            {
                                                "example_id": "f834bbe0-13d3-489d-bef1-0d2aba51677f",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "It was her other self who had written that letter. It not only bored, it rather disgusted her real self. \"Flippant and silly,\" said her real self. Yet she knew that she'd send it and she'd always write that kind of twaddle to Nan Pym."
                                            },
                                            {
                                                "example_id": "12949f06-1ab1-4bc4-87c1-99fcf75c6a8c",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "I improvised for three or four minutes, speaking complete twaddle in character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ca7b9f-92b1-38c8-bfbc-df1bbe47b3aa",
                                        "entry_id": "29704ed7-2ab5-36ea-b81a-037408cd321b",
                                        "glosses": [
                                            "One who twaddles; a twaddler."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "twaddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "342e586c-4a0f-3ca2-9c86-2f0601a1275f",
                                        "entry_id": "8b75e73d-354c-3d2b-b86b-71cae2344415",
                                        "glosses": [
                                            "To talk or write nonsense; to prattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ff4a32-5ae8-425a-bfef-b30f4fed617e",
                                                "sense_id": "342e586c-4a0f-3ca2-9c86-2f0601a1275f",
                                                "text": "To Edward […] he was terrible, nerve-inflaming, poisonously asphyxiating. He sat rocking himself in the late Mr. Churchill's swing chair, smoking and twaddling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
