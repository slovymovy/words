                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d5b073a-0122-4ee0-97fe-0463cf5ec520",
                        "source_entry_id": "ac949f26-d7e3-3cf2-bf55-9ba424e9dcd5",
                        "source_sense_id": "c8b4882d-50d0-3f3f-ac60-193296702256",
                        "target_lang_word": "naissance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naissance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "886cc398-fcb5-33b8-bbfb-02727738ae97",
                                        "entry_id": "bf8e2bd7-cecc-3680-afbd-470d4a7e183f",
                                        "glosses": [
                                            "Venue d’un être à la vie."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdb0500c-909b-49b3-b4b9-c7975b1dcaaf",
                                                "sense_id": "886cc398-fcb5-33b8-bbfb-02727738ae97",
                                                "text": "On avait bien enregistré trois décès, occasionnés par l’influenza, mais les naissances compensaient les décès."
                                            },
                                            {
                                                "example_id": "c97da33d-4460-4f89-aa51-9aae68329c7c",
                                                "sense_id": "886cc398-fcb5-33b8-bbfb-02727738ae97",
                                                "text": "Le système de raréfaction des naissances est ici tellement ancré dans les esprits, qu’il finit par être jugé comme le signe d’une vie raisonnable."
                                            },
                                            {
                                                "example_id": "b88794f0-3255-4b2f-ab4c-90d08bbe72c2",
                                                "sense_id": "886cc398-fcb5-33b8-bbfb-02727738ae97",
                                                "text": "Quoi qu’il en fût, ma naissance fut pénible. Je déchirai ma mère si cruellement que le contact de son mari lui devint un supplice."
                                            },
                                            {
                                                "example_id": "4b68258b-6c26-43d4-a2ce-11349d11f806",
                                                "sense_id": "886cc398-fcb5-33b8-bbfb-02727738ae97",
                                                "text": "J’ai demandé une autorisation qui me permît de prendre le nom de ma mère, une femme excellente et respectable dont le souvenir, car je l’ai perdue trop tôt, vaut mieux que celui de mon père, à qui je dois seulement l’accident de ma naissance."
                                            },
                                            {
                                                "example_id": "a0941b02-a23a-40ff-92e0-88ada8d38d2b",
                                                "sense_id": "886cc398-fcb5-33b8-bbfb-02727738ae97",
                                                "text": "Trois paramètres principaux ont une influence sur le système de retraites, l’évolution de la démographie (naissances, décès, immigration), les conditions économiques (productivité des actifs et chômage) et la place occupée par la fonction publique dans la masse des traitements et salaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8097c20b-08fe-3e27-9fb0-8dbdbe6707c7",
                                        "entry_id": "bf8e2bd7-cecc-3680-afbd-470d4a7e183f",
                                        "glosses": [
                                            "Origine ; extraction."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b704f1e1-25b9-4e45-992b-90a5ab4c5e66",
                                                "sense_id": "8097c20b-08fe-3e27-9fb0-8dbdbe6707c7",
                                                "text": "Être de grande, d’illustre naissance."
                                            },
                                            {
                                                "example_id": "7a353073-af77-427a-b6e1-5c233043283b",
                                                "sense_id": "8097c20b-08fe-3e27-9fb0-8dbdbe6707c7",
                                                "text": "Naissance illégitime."
                                            },
                                            {
                                                "example_id": "808545d3-7978-4ff5-aae3-1ba9945297f5",
                                                "sense_id": "8097c20b-08fe-3e27-9fb0-8dbdbe6707c7",
                                                "text": "— Mais, ma chère, un inconnu ! un homme sans naissance, un ouvrier peut-être ! dit-il d’un air suppliant à sa belle moitié."
                                            },
                                            {
                                                "example_id": "580163ab-3ed0-4855-ac35-ade57a5b89af",
                                                "sense_id": "8097c20b-08fe-3e27-9fb0-8dbdbe6707c7",
                                                "text": "Eh bien ! se dit-il enfin avec les yeux éteints d’un homme mécontent de soi, puisque ma naissance me donne le droit de profiter de ces abus, il serait d’une insigne duperie à moi de n’en pas prendre ma part ; mais il ne faut point m’aviser de les maudire en public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fd96416-0b2b-3025-805f-7049d2f227d2",
                                        "entry_id": "bf8e2bd7-cecc-3680-afbd-470d4a7e183f",
                                        "glosses": [
                                            "Noblesse."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb2d4a07-b76f-40d7-a3b3-8b42022ee1b0",
                                                "sense_id": "6fd96416-0b2b-3025-805f-7049d2f227d2",
                                                "text": "Trois jours auparavant, à la même heure, il était heureux et fier, faisant les honneurs du château de Godesberg à la chevalerie la plus noble des environs, et maintenant, […] il se trouvait […] mêlé parmi une troupe d’hommes braves et loyaux sans doute, mais sans naissance et sans avenir."
                                            },
                                            {
                                                "example_id": "50d93855-84bb-44cc-ac84-5cf8d497c49a",
                                                "sense_id": "6fd96416-0b2b-3025-805f-7049d2f227d2",
                                                "text": "– Il y a dans ce pays, cinq ou six petites filles à marier, avec un million dans leur tablier : c'est de l'argent gagné dans la manufacture..., mais gagné honnêtement. Croyez-vous que ces filles sans naissance ne seraient pas fort heureuses que vous acceptassiez leurs écus ? Vous leur feriez encore beaucoup d'honneur ; vous y mettriez du vôtre, mon neveu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eceb106f-9bb5-3c4a-8ce3-43135ab316cf",
                                        "entry_id": "bf8e2bd7-cecc-3680-afbd-470d4a7e183f",
                                        "glosses": [
                                            "Commencement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bd617c0-064d-4a47-a724-46bb49d676f0",
                                                "sense_id": "eceb106f-9bb5-3c4a-8ce3-43135ab316cf",
                                                "text": "Et si le cyclone descend jusqu’à la terre, se forment des tornades, quelle que soit la façon dont leur naissance a lieu selon le mouvement du vent ; s’il descend jusqu’à la mer, ce sont des tourbillons qui se constituent."
                                            },
                                            {
                                                "example_id": "538bf110-1b53-4d1f-86cb-cb663520d1e0",
                                                "sense_id": "eceb106f-9bb5-3c4a-8ce3-43135ab316cf",
                                                "text": "Le XVᵉ siècle apparaît affolé, dès sa naissance. Il semble que la démence de Charles VI se propage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5185ab5a-6c7b-3b0a-a79b-4465826e35a1",
                                        "entry_id": "bf8e2bd7-cecc-3680-afbd-470d4a7e183f",
                                        "glosses": [
                                            "Point, endroit où apparaît pour la première fois une chose qui se prolonge ensuite dans une certaine direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76dd07ac-2050-4548-a370-fc9ad788da7e",
                                                "sense_id": "5185ab5a-6c7b-3b0a-a79b-4465826e35a1",
                                                "text": "Parfois, Douce essuyait son visage d’un revers de la main, ou replaçait une mèche rebelle sur son front. Par l’emmanchure de son corsage, Gabriel entrevoyait alors la naissance de ses seins, et son désir se faisait plus fort. Incontrôlable."
                                            },
                                            {
                                                "example_id": "ea898ce6-c6d7-4e9a-987d-56cd52b65a07",
                                                "sense_id": "5185ab5a-6c7b-3b0a-a79b-4465826e35a1",
                                                "text": "Ce fleuve, à sa naissance, reçoit plusieurs ruisseaux qui le grossissent."
                                            },
                                            {
                                                "example_id": "bbbb1aae-0c27-42bf-b829-f8e9aa050c5d",
                                                "sense_id": "5185ab5a-6c7b-3b0a-a79b-4465826e35a1",
                                                "text": "La naissance d’une tige, d’un rameau."
                                            },
                                            {
                                                "example_id": "e918f8c6-1f03-4469-8565-ccc16aa4f460",
                                                "sense_id": "5185ab5a-6c7b-3b0a-a79b-4465826e35a1",
                                                "text": "Couper une branche à sa naissance."
                                            },
                                            {
                                                "example_id": "fa68bf4d-06aa-43c7-8cb6-20d1a237dd96",
                                                "sense_id": "5185ab5a-6c7b-3b0a-a79b-4465826e35a1",
                                                "text": "La naissance de l’épaule, du mollet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15b4a4d0-aa9d-3af2-a6ca-798fd9eb4c0f",
                                        "entry_id": "bf8e2bd7-cecc-3680-afbd-470d4a7e183f",
                                        "glosses": [
                                            "Commencement, là où prend appui un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e09a550-44df-4639-9ad7-7250db007f8b",
                                                "sense_id": "15b4a4d0-aa9d-3af2-a6ca-798fd9eb4c0f",
                                                "text": "La naissance d’une colonne, le commencement du fût."
                                            },
                                            {
                                                "example_id": "33698ccc-f19e-4d9d-a803-14a8580ea538",
                                                "sense_id": "15b4a4d0-aa9d-3af2-a6ca-798fd9eb4c0f",
                                                "text": "La naissance d’une voûte, le commencement de sa courbure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fdff727-92f1-43a7-8876-13681362924f",
                        "source_entry_id": "ac949f26-d7e3-3cf2-bf55-9ba424e9dcd5",
                        "source_sense_id": "c8b4882d-50d0-3f3f-ac60-193296702256",
