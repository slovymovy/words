                        "entry_id": "99f469e7-3528-38f8-a8fa-b1f2e1b93563",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Großzügigkeit"
                    },
                    {
                        "form_id": "4f629d1a-1c03-4c99-8f70-5768c7a0ca04",
                        "entry_id": "99f469e7-3528-38f8-a8fa-b1f2e1b93563",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Großzügigkeit"
                    },
                    {
                        "form_id": "629958e5-9b99-4ff3-8cb5-ae6513e6537e",
                        "entry_id": "99f469e7-3528-38f8-a8fa-b1f2e1b93563",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Großzügigkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea6bd9d1-d4f9-3bb5-951e-dd80cab7818c",
                        "entry_id": "99f469e7-3528-38f8-a8fa-b1f2e1b93563",
                        "glosses": [
                            "das freiwillige Geben über das normale Maß hinaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "289706ad-a640-4eb9-9e17-29dc975824ab",
                                "sense_id": "ea6bd9d1-d4f9-3bb5-951e-dd80cab7818c",
                                "text": "Durch die Großzügigkeit mehrerer Privatleute konnte der Spielplatz wieder instand gesetzt werden."
                            },
                            {
                                "example_id": "6559d48d-43ea-4ee5-a8d2-497e0ff2b4dd",
                                "sense_id": "ea6bd9d1-d4f9-3bb5-951e-dd80cab7818c",
                                "text": "„Für diese Großzügigkeit bedankten sich die Einwohner von Hindenburg mit ihrer Stimme bei der oberschlesischen Volksabstimmung 1921.“"
                            },
                            {
                                "example_id": "0299ad5f-e14d-4f36-8e30-fb9769879d53",
                                "sense_id": "ea6bd9d1-d4f9-3bb5-951e-dd80cab7818c",
                                "text": "„So verteilte sie ihre Gunst an die verschiedenen Verehrer je nach deren Noblesse und Großzügigkeit.“"
                            },
                            {
                                "example_id": "ec001c8f-3d73-4896-b976-b5ac86a3e218",
                                "sense_id": "ea6bd9d1-d4f9-3bb5-951e-dd80cab7818c",
                                "text": "„Rom gab sich erst unbestechlich, reagierte dann aber großzügig auf gewisse Großzügigkeiten und erhöhte den Gnadenwert des Wittenberger Heiltums sogar auf hundert Jahre pro Reliquie.“"
                            },
                            {
                                "example_id": "2724fcbf-fc9e-4a93-a1e8-d036fce10397",
                                "sense_id": "ea6bd9d1-d4f9-3bb5-951e-dd80cab7818c",
                                "text": "„Er war rasch der beliebteste Mann von Paris geworden, und Sylvia vermutete, dass es mit seiner Großzügigkeit und dem wachen, oft boshaften Witz zusammenhing, der so gar nicht zu seinem hübschen, jungenhaften Gesicht zu passen schien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a991c735-af38-3278-ad9f-9e674d135392",
                        "entry_id": "99f469e7-3528-38f8-a8fa-b1f2e1b93563",
                        "glosses": [
                            "Weite in der Architektur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b88812a-4c08-4645-8338-7b270300b254",
                                "sense_id": "a991c735-af38-3278-ad9f-9e674d135392",
                                "text": "Das Haus besticht durch seine Großzügigkeit in Hinblick auf die Raumaufteilung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0ae9b1d-f299-4bb4-aa2b-0cbe77addd03",
                        "source_entry_id": "99f469e7-3528-38f8-a8fa-b1f2e1b93563",
                        "source_sense_id": "ea6bd9d1-d4f9-3bb5-951e-dd80cab7818c",
                        "source_sense_description": "das freiwillige Geben über das normale Maß hinaus",
                        "target_lang_word": "generosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4b44aa2-35e8-3f15-a8db-a7d1ba8299fb",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "The trait of being willing to donate money, resources, or time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "124d1a34-6d02-42f6-8061-edfb97559151",
                                                "sense_id": "f4b44aa2-35e8-3f15-a8db-a7d1ba8299fb",
                                                "text": "We have mentioned generosity as an outstanding virtue required in Sioux life."
                                            },
                                            {
                                                "example_id": "af3b519b-1b30-40e4-86d2-9349caa59d6a",
                                                "sense_id": "f4b44aa2-35e8-3f15-a8db-a7d1ba8299fb",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4c39d05-8817-3a5f-8502-01456a0da097",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "A generous act."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff657602-ade2-48ac-ac63-7f6624dfa1ee",
                                                "sense_id": "f4c39d05-8817-3a5f-8502-01456a0da097",
                                                "text": "May the generosities of the founders of these halls, be rewarded by the fair and holy characters which shall be here formed[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6596a999-1ebb-3e79-8a1d-c8c2147ede36",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "The trait of being abundant, more than adequate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "094aa45d-7608-3f25-8e90-21f61d857e91",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "Good breeding; nobility of stock."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "977fd8d9-fa53-4d79-8af1-4e5b5f2b7193",
                        "source_entry_id": "99f469e7-3528-38f8-a8fa-b1f2e1b93563",
                        "source_sense_id": "ea6bd9d1-d4f9-3bb5-951e-dd80cab7818c",
                        "source_sense_description": "das freiwillige Geben über das normale Maß hinaus",
                        "target_lang_word": "générosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "générosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7cb7ba-ac98-3b4a-a295-e3f94d604b0f",
                                        "entry_id": "d78f48d2-77ee-30c1-b6f4-e87a6c2fe2b7",
                                        "glosses": [
                                            "Disposition à donner plus qu’on n’est tenu de donner et à recevoir moins qu’on pourrait réclamer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55357a90-c84a-4d20-9712-edc93494e5b5",
                                                "sense_id": "2e7cb7ba-ac98-3b4a-a295-e3f94d604b0f",
                                                "text": "Sa générosité n'est pas faiblesse ; son obligeance ne dépasse pas les obligations normales et naturelles ; aucune arrière-pensée en son comportement."
                                            },
                                            {
                                                "example_id": "0001200f-2370-4aba-8a1c-c0ad8411e80b",
                                                "sense_id": "2e7cb7ba-ac98-3b4a-a295-e3f94d604b0f",
                                                "text": "À son hypocrite travail d’approche, n’avaient répondu que des demi-promesses et de menues privautés, en échange de gestes de générosité financière d’importance croissante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "009b63e1-f16e-31f4-aeba-e119b727c559",
                                        "entry_id": "d78f48d2-77ee-30c1-b6f4-e87a6c2fe2b7",
                                        "glosses": [
                                            "Noblesse, élévation de sentiments."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f9cff8a-7411-4cd4-b351-3847735b02cc",
                                                "sense_id": "009b63e1-f16e-31f4-aeba-e119b727c559",
                                                "text": "Au début de son pontificat, il s'était, il est vrai, montré bienveillant, moins par générosité naturelle, que dans le dessein de favoriser la conversion des juifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38ca1a12-783b-302d-bbf5-83b26c3cf181",
                                        "entry_id": "d78f48d2-77ee-30c1-b6f4-e87a6c2fe2b7",
                                        "glosses": [
                                            "Actes de générosité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41f912c-f0ef-4b2c-a511-98de696afa6a",
                                                "sense_id": "38ca1a12-783b-302d-bbf5-83b26c3cf181",
                                                "text": "Faire des générosités."
                                            }
                                        ]
                                    }
                                ]
                            }
