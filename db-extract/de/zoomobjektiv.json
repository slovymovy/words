                ],
                "senses": [
                    {
                        "sense_id": "94365612-5ff2-3741-a01a-74a3b602b1b8",
                        "entry_id": "6210a22f-4f58-3021-a652-6a1b8b4118da",
                        "glosses": [
                            "Objektiv, dessen Brennweite stufenlos verändert werden kann"
                        ],
                        "tags": [
                            "Fotografie",
                            "Optik"
                        ],
                        "examples": [
                            {
                                "example_id": "b3aaf9e7-2aeb-4064-98c9-f106a9dd1965",
                                "sense_id": "94365612-5ff2-3741-a01a-74a3b602b1b8",
                                "text": "„Nikon hat weiters auch die neue Coolpix P330 vorgestellt, die über ein 24-120mm (Kleinbild-Äquivalent) Zoomobjektiv mit einer Offenblende von F/1.8 in Weitwinkelstellung verfügt.“"
                            },
                            {
                                "example_id": "18adeef9-ae43-4054-873a-338a21a4f6e8",
                                "sense_id": "94365612-5ff2-3741-a01a-74a3b602b1b8",
                                "text": "„Mit einem Zoomobjektiv ausgerüstet, sind die beiden Bridge-Kameras aber schon schwieriger in der Manteltasche zu verstauen. Bei der E-P2 etwa ragt das Zoomobjektiv in geschlossenem Zustand über 4,5 cm aus dem Gehäuse heraus.“"
                            },
                            {
                                "example_id": "cb785562-6276-405c-ad78-75ba94cd9b9c",
                                "sense_id": "94365612-5ff2-3741-a01a-74a3b602b1b8",
                                "text": "„Zoomobjektive mit ihrer variablen Brennweite sind praktisch, weil sie vom Weitwinkel fürs Panorama bis zum leichten Tele für Porträts zahlreiche Aufnahmesituationen abdecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
