                                        "glosses": [
                                            "ein Folger des Sozinianismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ad9678-7cd1-49d9-b4ba-083df1e29dbe",
                                                "sense_id": "f4110d9b-b4c7-376b-b32e-e8bc1fc2b008",
                                                "text": "Ein Sozinianer betont die rationale Argumentation und die moralische Qualität des Christentums."
                                            },
                                            {
                                                "example_id": "01b669dd-3487-4869-9a7f-b19293b8d537",
                                                "sense_id": "f4110d9b-b4c7-376b-b32e-e8bc1fc2b008",
                                                "text": "Als Ruar 1643 seinen Wohnsitz dorthin verlegen mußte, gingen viele Danziger Sozinianer zu seinen Predigten in Straszyn."
                                            },
                                            {
                                                "example_id": "8b7c7d02-7788-4b9e-b277-bf4902698d21",
                                                "sense_id": "f4110d9b-b4c7-376b-b32e-e8bc1fc2b008",
                                                "text": "\"Das Edikt, welches die Vertreibung der Sozinianer (Arianer) gebot, war die Krönung eines langjährigen Kampfes..\""
                                            },
                                            {
                                                "example_id": "29583056-c380-4c39-a118-e1f509d7a4d2",
                                                "sense_id": "f4110d9b-b4c7-376b-b32e-e8bc1fc2b008",
                                                "text": "\"Leibniz verteidigt hier den Standpunkt der Sozinianer…\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
