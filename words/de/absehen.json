{
    "word_family": [
        "absehbar",
        "unabsehbar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30f5c8f2-5ad6-3a56-87ec-0065b1d40b3d",
                    "sense_definition": "eine zukünftige Entwicklung oder Folge im Voraus erkennen oder abschätzen",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "voraussehen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand konnte damals die schweren Folgen der globalen Krise <w>absehen</w>."
                        },
                        {
                            "text": "Es lässt sich noch nicht <w>absehen</w>, wann das Projekt abgeschlossen sein wird."
                        }
                    ],
                    "common_phrases": [
                        "die Folgen absehen",
                        "ein Ende absehen"
                    ],
                    "synonyms": [
                        "vorhersehen"
                    ]
                },
                {
                    "sense_id": "da770f27-5744-312e-ae6a-6dc0dfa1470e",
                    "sense_definition": "darauf verzichten, eine geplante oder mögliche Handlung auszuführen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unterlassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Gericht entschied sich dafür, in diesem Fall von einer Strafe <w>abzusehen</w>."
                        },
                        {
                            "text": "Wegen des schlechten Wetters <w>sahen</w> die Wanderer von dem gefährlichen Aufstieg <w>ab</w>."
                        }
                    ],
                    "synonyms": [
                        "verzichten",
                        "sich enthalten"
                    ],
                    "common_phrases": [
                        "von einer Strafe absehen",
                        "von weiteren Schritten absehen"
                    ]
                },
                {
                    "sense_id": "e74fb6da-38c1-3f5d-b04f-e8e0c659301b",
                    "sense_definition": "etwas Bestimmtes anstreben oder eine Person bzw. Sache gezielt ins Visier nehmen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abzielen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Dieb hatte es vor allem auf teuren Schmuck und Bargeld <w>abgesehen</w>."
                        },
                        {
                            "text": "Warum hast du es eigentlich so auffällig auf meinen Arbeitsplatz <w>abgesehen</w>?"
                        }
                    ],
                    "common_phrases": [
                        "es auf jemanden absehen",
                        "es auf etwas absehen"
                    ]
                },
                {
                    "sense_id": "0c3d4314-6d8b-377f-a080-cbf6c9d12062",
                    "sense_definition": "einen bestimmten Umstand bei einer Überlegung oder Beurteilung unberücksichtigt lassen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ausblenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn man von den hohen Kosten einmal <w>absieht</w>, bietet das Angebot viele Vorteile."
                        },
                        {
                            "text": "Wir wollen für einen Moment ganz davon <w>absehen</w>, wer den Streit begonnen hat."
                        }
                    ],
                    "common_phrases": [
                        "einmal davon abgesehen",
                        "von Ausnahmen abgesehen"
                    ]
                },
                {
                    "sense_id": "e71076e1-d837-35bf-af79-8ae38185951d",
                    "sense_definition": "durch aufmerksames Beobachten von jemandem lernen oder an den Reaktionen ablesen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beobachten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Lehrlinge konnten dem erfahrenen Meister viele praktische Handgriffe <w>absehen</w>."
                        },
                        {
                            "text": "Die Mutter konnte ihren Kindern jeden geheimen Wunsch direkt an den Augen <w>absehen</w>."
                        }
                    ],
                    "synonyms": [
                        "ablesen",
                        "abschauen"
                    ],
                    "common_phrases": [
                        "an den Augen absehen",
                        "einen Handgriff absehen"
                    ]
                }
            ]
        }
    ]
}