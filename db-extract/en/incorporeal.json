                "word": "incorporeal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7052e022-71eb-4295-b83a-02ef47c8d328",
                        "entry_id": "c6b42b3f-9dcb-3171-81f9-431c3a6d01b0",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more incorporeal"
                    },
                    {
                        "form_id": "11c3ee7a-825d-44bf-821a-82b43d41c1c3",
                        "entry_id": "c6b42b3f-9dcb-3171-81f9-431c3a6d01b0",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most incorporeal"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a251745-1c16-3015-9f03-cf69a5ff664f",
                        "entry_id": "c6b42b3f-9dcb-3171-81f9-431c3a6d01b0",
                        "glosses": [
                            "Having no material form or physical substance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b1ce51f-ecad-42f7-b806-90194ac2903a",
                                "sense_id": "6a251745-1c16-3015-9f03-cf69a5ff664f",
                                "text": "Thus incorporeal spirits to smaller forms / Reduced their shapes immense."
                            },
                            {
                                "example_id": "a2f76e0c-a850-41c2-80aa-9e276b1156f8",
                                "sense_id": "6a251745-1c16-3015-9f03-cf69a5ff664f",
                                "text": "Sense and perception must necessarily proceed from some incorporeal substance within us."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7ddaeef-9351-3bec-980d-2c84827d4082",
                        "entry_id": "c6b42b3f-9dcb-3171-81f9-431c3a6d01b0",
                        "glosses": [
                            "Relating to an asset that does not have a material form; such as a patent."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09119b87-3922-4121-a152-f6021ed5294f",
                        "source_entry_id": "c6b42b3f-9dcb-3171-81f9-431c3a6d01b0",
                        "source_sense_description": "having no material form or physical substance",
                        "target_lang_word": "incorporel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incorporel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9be9ef2-7f48-3ccd-b7ff-b6829f29d84b",
                                        "entry_id": "9bf0057d-b748-3fa8-ac32-69911e33bb1f",
                                        "glosses": [
                                            "Qui n’a pas de corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5554ea30-8bd3-4bf2-8f68-bb7c90fa5015",
                                                "sense_id": "a9be9ef2-7f48-3ccd-b7ff-b6829f29d84b",
                                                "text": "Dieu est incorporel."
                                            },
                                            {
                                                "example_id": "d4b16f84-4dc6-493e-a3dc-45f9380ba6ed",
                                                "sense_id": "a9be9ef2-7f48-3ccd-b7ff-b6829f29d84b",
                                                "text": "Ou, plutôt, celui-ci s’est fantomisé, est devenu impalpable, immatériel, incorporel, comme les ombres qu’Ulysse rencontrait aux Enfers."
                                            },
                                            {
                                                "example_id": "bb4c2976-3c9c-41b3-a718-8cf23f032a39",
                                                "sense_id": "a9be9ef2-7f48-3ccd-b7ff-b6829f29d84b",
                                                "text": "Il n’y a plus rien ici de grand ni de petit, de liquide ni de solide,\nDe corporel ni d’incorporel ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec5fb1c1-0c43-38c7-8b9d-44c3a1c74652",
                                        "entry_id": "9bf0057d-b748-3fa8-ac32-69911e33bb1f",
                                        "glosses": [
                                            "Choses qui ne tombent pas sous nos sens et qui n’ont qu’une existence morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05260793-6d5f-4410-8cfc-593eb729b99a",
                                                "sense_id": "ec5fb1c1-0c43-38c7-8b9d-44c3a1c74652",
                                                "text": "Tous les droits sont incorporels."
                                            },
                                            {
                                                "example_id": "179f9f7d-5c19-484e-8382-534642115d48",
                                                "sense_id": "ec5fb1c1-0c43-38c7-8b9d-44c3a1c74652",
                                                "text": "Entre les choses corporelles et les choses incorporelles, le critère de séparation est d’ordre naturel. Les unes tombent sous les sens, sont matérielles : un bijou, une maison ; les autres échappent à la perception, sont idéelles : un monopole d’exploitation, une part d’associé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b26b7b46-0fef-3450-8cc9-0251d738ca5d",
                                        "entry_id": "9bf0057d-b748-3fa8-ac32-69911e33bb1f",
                                        "glosses": [
                                            "Immatériel, en parlant des immobilisations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d55c2629-75d2-4b59-990b-cb7c155cc46e",
                                                "sense_id": "b26b7b46-0fef-3450-8cc9-0251d738ca5d",
                                                "text": "Actif incorporel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
