                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cbb28aa-467e-4d0b-8aba-ce0f9cd93627",
                                                "sense_id": "c9b046b2-5fb1-3cee-8c78-248a9d9b23ed",
                                                "text": "Гражданский брак."
                                            },
                                            {
                                                "example_id": "275db6d7-1ffd-4cd5-8965-c6731977f402",
                                                "sense_id": "c9b046b2-5fb1-3cee-8c78-248a9d9b23ed",
                                                "text": "Гражданский шрифт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f644c9-9be4-3b6e-aa88-e11efbf5c250",
                                        "entry_id": "fc0b18df-c5ff-3501-b5b7-fc5323f90ed0",
                                        "glosses": [
                                            "субстантивир. то же, что гражданская война"
                                        ],
                                        "tags": [
                                            "только ф. жен. рода"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15eb72be-5a3c-456e-8b88-2a83b91445cc",
                                                "sense_id": "a4f644c9-9be4-3b6e-aa88-e11efbf5c250",
                                                "text": "Ещё дед наш Иван, сгинувший в гражданскую, покашивал в этих местах, оттого и выгрев именуется Ивановым, в честь первого в ту пору косаря."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5959818-4cbc-3493-a3b3-dcd8c8e5b8da",
                                        "entry_id": "fc0b18df-c5ff-3501-b5b7-fc5323f90ed0",
                                        "glosses": [
                                            "субстантивир. гражданская одежда в отличие от военной униформы"
                                        ],
                                        "tags": [
                                            "только ф. ср. рода"
                                        ],
                                        "examples": [
                                            {
