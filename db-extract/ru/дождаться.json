                "senses": [
                    {
                        "sense_id": "fb6edbb0-283e-343b-973f-dd2077d201cc",
                        "entry_id": "3c8e96a9-3447-378d-a18a-145ab0a16725",
                        "glosses": [
                            "to wait until, to (manage to) wait for a long time"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ac83161-1e12-4de3-a63f-8cd4b0663d9c",
                                "sense_id": "fb6edbb0-283e-343b-973f-dd2077d201cc",
                                "text": "дожда́ться конца́ спекта́кля",
                                "translation": "to wait until the end of the show",
                                "english": "to wait until the end of the show"
                            },
                            {
                                "example_id": "8bd6d071-cf00-4736-ba10-6f373bf553e6",
                                "sense_id": "fb6edbb0-283e-343b-973f-dd2077d201cc",
                                "text": "дожда́ться врача́",
                                "translation": "to wait till the doctor comes",
                                "english": "to wait till the doctor comes"
                            },
                            {
                                "example_id": "74f97717-7619-4710-ab53-e66bbadfd448",
                                "sense_id": "fb6edbb0-283e-343b-973f-dd2077d201cc",
                                "text": "Я не могла́ дожда́ться его́ прие́зда.",
                                "translation": "I couldn't wait for his arrival. (female speaker)",
                                "english": "I couldn't wait for his arrival. (female speaker)"
                            }
                        ]
                    },
                    {
                        "sense_id": "5b7b3560-cd0b-32c0-be7e-c58a60af5bd4",
                        "entry_id": "3c8e96a9-3447-378d-a18a-145ab0a16725",
                        "glosses": [
                            "to end (by)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d05b1c54-d89a-4ad1-8ce0-da1dd3580c83",
                                "sense_id": "5b7b3560-cd0b-32c0-be7e-c58a60af5bd4",
                                "text": "Он дожда́лся того́, что его́ уво́лили.",
                                "translation": "He has ended by being sacked.",
                                "english": "He has ended by being sacked."
                            },
                            {
                                "example_id": "886d3320-2b5b-4faa-bc41-fe2282d46710",
                                "sense_id": "5b7b3560-cd0b-32c0-be7e-c58a60af5bd4",
                                "text": "Ты у меня́ дождёшься!",
                                "translation": "Just you wait!",
                                "english": "Just you wait!"
                            },
                            {
                                "example_id": "37776917-881e-4ca6-a7b8-6ad9be055604",
                                "sense_id": "5b7b3560-cd0b-32c0-be7e-c58a60af5bd4",
                                "text": "Я наконец-то дождался ответа!",
                                "translation": "I have finally received the/an answer!",
                                "english": "I have finally received the/an answer!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
