    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca948ffd-a777-32fe-b18c-bb5e51a04929",
                    "sense_definition": "Détacher, séparer ou enlever avec force ou violence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent violent a failli <w>arracher</w> la toiture de la vieille grange pendant la tempête."
                        },
                        {
                            "text": "Le dentiste a dû lui <w>arracher</w> une dent cariée qui lui faisait très mal."
                        }
                    ],
                    "synonyms": [
                        "déraciner",
                        "détacher",
                        "enlever",
                        "ôter"
                    ],
                    "antonyms": [
                        "attacher",
                        "fixer",
                        "planter"
                    ],
                    "common_phrases": [
                        "arracher une dent",
                        "arracher les mauvaises herbes"
                    ]
                },
                {
                    "sense_id": "42abe94b-24da-3e4d-9983-84c36b51d04d",
                    "sense_definition": "Obtenir avec beaucoup de peine ou d'insistance de quelqu'un qui résiste.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obtention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe a réussi à <w>arracher</w> une victoire inespérée dans les dernières minutes du match."
                        },
                        {
                            "text": "Après des heures de discussion, les négociateurs ont enfin <w>arraché</w> un accord favorable."
                        }
                    ],
                    "synonyms": [
                        "extorquer",
                        "obtenir",
                        "soutirer"
                    ],
                    "common_phrases": [
                        "arracher la victoire",
                        "arracher un accord"
                    ]
                },
                {
                    "sense_id": "cbbe3c49-76ad-321b-a572-12a865ffb24a",
                    "sense_definition": "Soustraire ou préserver quelqu'un d'un danger ou d'un sort funeste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sauvetage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les médecins ont lutté toute la nuit pour <w>arracher</w> le jeune blessé à la mort."
                        },
                        {
                            "text": "Ce brave pompier est parvenu à <w>arracher</w> deux enfants aux flammes destructrices de l'immeuble."
                        }
                    ],
                    "synonyms": [
                        "sauver",
                        "soustraire"
                    ],
                    "common_phrases": [
                        "arracher à la mort",
                        "arracher au danger"
                    ]
                },
                {
                    "sense_id": "fff3bcb5-3642-38cf-b8be-97a44d8bc871",
                    "sense_definition": "Provoquer malgré soi une vive réaction émotionnelle ou physique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction_emotive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette triste nouvelle a <w>arraché</w> des larmes à toute la famille réunie dans le salon."
                        },
                        {
                            "text": "Sa plaisanterie inattendue a finalement <w>arraché</w> un sourire timide à son ami découragé."
                        }
                    ],
                    "synonyms": [
                        "tirer"
                    ],
                    "common_phrases": [
                        "arracher des larmes",
                        "arracher un sourire"
                    ]
                },
                {
                    "sense_id": "3249040d-049e-3d5b-92aa-24ec2dcf46a9",
                    "sense_definition": "Se disputer avec ardeur une personne ou une chose très recherchée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "convoitise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les clients s'<w>arrachent</w> les derniers billets de ce concert très populaire dès la matinée."
                        },
                        {
                            "text": "Depuis le succès critique de son film, tous les plus grands producteurs s'<w>arrachent</w> cette actrice."
                        }
                    ],
                    "common_phrases": [
                        "s'arracher les billets"
                    ]
                },
                {
                    "sense_id": "dfc5e073-173a-3284-918d-3ce656379be9",
                    "sense_definition": "Quitter rapidement un endroit ou s'en aller précipitamment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "depart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se fait très tard et nous ferions mieux de nous <w>arracher</w> avant le dernier métro."
                        },
                        {
                            "text": "Dès que l'alerte a retenti dans la rue, les intrus ont préféré s'<w>arracher</w> sans attendre."
                        }
                    ],
                    "common_phrases": [
                        "s'arracher d'ici"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "langage familier et argotique"
                        }
                    ]
                }
            ]
        }
    ]
