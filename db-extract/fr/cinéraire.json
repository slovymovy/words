            {
                "entry_id": "ae067405-b674-3f41-b736-dd6fd204bdf3",
                "word": "cinéraire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ca5eb12c-7ce7-4a67-a988-d6bdab362360",
                        "entry_id": "ae067405-b674-3f41-b736-dd6fd204bdf3",
                        "tags": [
                            "plural"
                        ],
                        "form": "cinéraires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ee0fb8e-fcf0-3180-8bc4-1d6b558fb0e3",
                        "entry_id": "ae067405-b674-3f41-b736-dd6fd204bdf3",
                        "glosses": [
                            "Plante de jardin, de la famille des Astéracées ou Composées, dont le dessous des feuilles a la couleur de la cendre, variante de cinéraire maritime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26fe8c22-1e5f-4fcb-9b52-80a0363892ef",
                                "sense_id": "4ee0fb8e-fcf0-3180-8bc4-1d6b558fb0e3",
                                "text": "Il y a dans les nuages ce soir des violets et des bleus bien beaux, … un bleu surtout plus floral qu’aérien, un bleu de cinéraire, qui surprend dans le ciel."
                            },
                            {
                                "example_id": "63461371-cd88-48b4-8c30-9541e333f94a",
                                "sense_id": "4ee0fb8e-fcf0-3180-8bc4-1d6b558fb0e3",
                                "text": "C’était une maison discrète en granite brun des Maures posée en haut d’une volée de marches mangées de cinéraires, qui descendaient jusqu’à la mer."
                            },
                            {
                                "example_id": "5d7a45db-f615-4592-a9dc-3c9374fe8495",
                                "sense_id": "4ee0fb8e-fcf0-3180-8bc4-1d6b558fb0e3",
                                "text": "D’une jatte emplie de cinéraires bleues émanait, sur le mur jaune, un reflet bleu, une sorte de mirage d’azur."
                            }
                        ]
                    }
                ],
