                "senses": [
                    {
                        "sense_id": "f1a55c8e-6212-3083-a74f-a52914f3484b",
                        "entry_id": "dd64b00c-6a52-39c9-84a0-e777e632bffd",
                        "glosses": [
                            "Rendre stupide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "193fe97a-0fae-4f25-9524-ed5ddd7b7a25",
                                "sense_id": "f1a55c8e-6212-3083-a74f-a52914f3484b",
                                "text": "L’ennui, le chagrin qu’ils contractent, ne doivent-ils pas s’opposer au développement de leur physique et de leurs facultés intellectuelles, et les stupidifier, pour ainsi dire ?"
                            },
                            {
                                "example_id": "5a7cf91b-b20d-4029-9a56-7bb95057d69c",
                                "sense_id": "f1a55c8e-6212-3083-a74f-a52914f3484b",
                                "text": "Qu’il est difficile, mon louable et cher ami, de ne pas se laisser stupidifier par l’exercice d’une spécialité !"
                            }
                        ]
                    }
