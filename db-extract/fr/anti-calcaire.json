                        "entry_id": "c46be0f5-8af1-3112-a5ed-4a0c0435bf18",
                        "glosses": [
                            "Substance qui lutte contre le calcaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31eea12e-3112-406f-9395-d84583148fa3",
                                "sense_id": "80ef14e9-d16e-35cf-a45d-64507b64648a",
                                "text": "Entières, elles peuvent être utilisées comme anti-calcaire, concassées elles peuvent servir de compost et réduites en poudre, elles peuvent être intégrées dans un masque de beauté ou dans l’alimentation des poules."
                            },
                            {
                                "example_id": "b8accef3-13e1-4590-9f5e-c5aa3fbb6b2d",
                                "sense_id": "80ef14e9-d16e-35cf-a45d-64507b64648a",
                                "text": "On doit utiliser de l’eau propre, sans excès de calcaire malgré les anti-calcaires incorporés aux spécialités commerciales."
                            },
                            {
                                "example_id": "dddf7865-0496-43e3-ad18-5339c8f2ba1c",
                                "sense_id": "80ef14e9-d16e-35cf-a45d-64507b64648a",
                                "text": "Il est possible d’opter pour un anti-calcaire avec une composition plus « clean », mais les étiquettes des produits ménagers sont généralement peu bavardes."
                            }
                        ]
                    }
