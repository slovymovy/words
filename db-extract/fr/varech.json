                                        "examples": [
                                            {
                                                "example_id": "7ee28f41-d9fb-4c21-b547-2d8d81ef0047",
                                                "sense_id": "634586de-312c-3a90-9c09-07742ca5d152",
                                                "text": "Nor did the croakers have long to wait. The second night after the drowning of the mate the little yacht was suddenly wracked from stem to stern. About one o’clock in the morning there was a terrific impact that threw the slumbering guests and crew from berth and bunk. A mighty shudder ran through the frail craft; she lay far over to starboard; the engines stopped."
                                            }
                                        ]
                                    },
