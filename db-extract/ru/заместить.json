                ],
                "translations": [
                    {
                        "translation_id": "2c967b86-ac1d-41a9-96fe-81838931b1b7",
                        "source_entry_id": "d16f619d-79b6-3485-b170-531a7d1f3750",
                        "target_lang_word": "remplacer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remplacer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78959e49-75fe-3664-b1ab-2138da6e0d00",
                                        "entry_id": "e983f8e7-d6d8-3bd7-aa95-2dac89c1b68d",
                                        "glosses": [
                                            "Succéder à quelqu’un dans une place, dans un emploi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "199dd1b3-db79-4ead-86a4-8e2e24575297",
                                                "sense_id": "78959e49-75fe-3664-b1ab-2138da6e0d00",
                                                "text": "Il était le gendre de l’imprimeur Plantin qu’il remplaça à Anvers avant de diriger, à partir de 1585, une imprimerie à Leyde."
                                            },
                                            {
                                                "example_id": "b4886755-70ee-4721-8ecc-885ce74ac2f9",
                                                "sense_id": "78959e49-75fe-3664-b1ab-2138da6e0d00",
                                                "text": "(Par inversion des époques) — Il est en effet incontestable qu'à une époque, le détroit de Behring qui sépare aujourd'hui l’Asie de l’Amérique était remplacé par un territoire qui reliait les deux continents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a9b24e9-8a2d-3edc-9823-c6636cd9e1aa",
                                        "entry_id": "e983f8e7-d6d8-3bd7-aa95-2dac89c1b68d",
                                        "glosses": [
                                            "Remplir de façon provisoire le rôle, les devoirs, les fonctions de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "476191c2-d9fc-468f-a166-da48d571a900",
                                                "sense_id": "2a9b24e9-8a2d-3edc-9823-c6636cd9e1aa",
                                                "text": "En ce moment, Montcornet devait résoudre une difficulté qui lui sembla plus pressante, il lui fallait un alter ego qui le remplaçât à la mairie pendant le temps de son séjour à Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2b001f-ba25-3495-8e82-bc35447d4f99",
                                        "entry_id": "e983f8e7-d6d8-3bd7-aa95-2dac89c1b68d",
                                        "glosses": [
                                            "Faire à la place de quelqu’un le temps de service militaire imposé par la loi."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a202bf6f-274b-4fee-ac89-8b90e96b0899",
                                                "sense_id": "ab2b001f-ba25-3495-8e82-bc35447d4f99",
                                                "text": "Il s’est fait remplacer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2be7d7b2-4258-311f-9e26-a3560afdfad1",
                                        "entry_id": "e983f8e7-d6d8-3bd7-aa95-2dac89c1b68d",
                                        "glosses": [
                                            "Tenir lieu d’une personne, d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d764b7-0b9f-431c-89ec-cc4fc291a4f2",
                                                "sense_id": "2be7d7b2-4258-311f-9e26-a3560afdfad1",
                                                "text": "Nous nous élevons rapidement et ne tardons pas à quitter la zone des cultures tropicales et subtropicales des terres basses. Les plantations de bananes, de canne à sucre, de tabac, de patates, les nopaleries et la vigne sont remplacées par des champs de céréales, de légumineuses et de pommes de terre ; […]."
                                            },
                                            {
                                                "example_id": "0b17ce76-5841-4848-bda0-ee0eae2b69f4",
                                                "sense_id": "2be7d7b2-4258-311f-9e26-a3560afdfad1",
                                                "text": "Dans les mellahs, le moqadem des quartiers de la vie musulmane était remplacé par le cheikh el yhoud qui en assurait la police sous l'autorité du gouverneur de la ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "458ed44b-91e3-337c-899b-8223bc8f9f78",
                                        "entry_id": "e983f8e7-d6d8-3bd7-aa95-2dac89c1b68d",
                                        "glosses": [
                                            "Donner pour successeur ; mettre à sa place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98fe37ee-f071-47cb-91ab-8e2b88889edd",
                                                "sense_id": "458ed44b-91e3-337c-899b-8223bc8f9f78",
                                                "text": "Il va de soi que le même mécanicien et les mêmes chauffeurs ne pourraient faire un service de onze jours. On les remplace donc, comme il convient, de six heures en six heures."
                                            },
                                            {
                                                "example_id": "b3829803-537e-4326-be89-e39c78f404eb",
                                                "sense_id": "458ed44b-91e3-337c-899b-8223bc8f9f78",
                                                "text": "On l’a remplacé par son fils."
                                            },
                                            {
                                                "example_id": "ad03c186-4ed3-48c3-9a9d-837f27836b09",
                                                "sense_id": "458ed44b-91e3-337c-899b-8223bc8f9f78",
                                                "text": "S’il venait à manquer, il ne serait pas facile à remplacer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7164a1c-e927-3d37-85cf-4560133a96d2",
                                        "entry_id": "e983f8e7-d6d8-3bd7-aa95-2dac89c1b68d",
                                        "glosses": [
                                            "Mettre une chose à la place d’une autre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c615072-2115-403e-9334-45d37166859b",
                                                "sense_id": "f7164a1c-e927-3d37-85cf-4560133a96d2",
                                                "text": "L’examen peut être complété par une séquence privilégiant le signal des liquides stationnaires en vue d’obtenir une uro-IRM qui remplace la classique urographie intraveineuse à la recherche d’une dilatation du système urinaire."
                                            },
                                            {
                                                "example_id": "6ed5f37a-1c8a-456d-b0b0-76495fd47ce4",
                                                "sense_id": "f7164a1c-e927-3d37-85cf-4560133a96d2",
                                                "text": "Les sergents de ville combattent aux avant-postes et les conseils de guerre ont remplacé la Cour d'assises."
                                            },
                                            {
                                                "example_id": "f21f54d0-d93c-4659-abac-cbe1b18dee5b",
                                                "sense_id": "f7164a1c-e927-3d37-85cf-4560133a96d2",
                                                "text": "Un nouveau beaupré, en pin d'Orégon lui aussi, remplace celui qui fut brisé dans un ouragan."
                                            },
                                            {
                                                "example_id": "d17b14ce-b6a9-48ae-9487-e15553763180",
                                                "sense_id": "f7164a1c-e927-3d37-85cf-4560133a96d2",
                                                "text": "L'élevage des vers à soie « ne paie plus ». Voilà pourquoi, aujourd'hui, dans le Gard, on arrache les mûriers : on les remplace imprudemment par des vignes…"
                                            },
                                            {
                                                "example_id": "4614a674-bc7c-4f6b-9c0e-33881cd55791",
                                                "sense_id": "f7164a1c-e927-3d37-85cf-4560133a96d2",
                                                "text": "Reprenons ici l’exemple de l’atrazine, appliquée pour le désherbage des voies de chemin de fer en Suisse. Après avoir été détectée dans les nappes phréatiques, l’atrazine a été remplacée par le diuron."
                                            },
                                            {
                                                "example_id": "3a142aac-acde-4d93-9b98-fcde5ebafe14",
                                                "sense_id": "f7164a1c-e927-3d37-85cf-4560133a96d2",
                                                "text": "La Révolution abolit la peine du pilori que, quelques années plus tard, le Code pénal remplaça par celle de l’exposition. Elle-même fut abolie en 1848."
                                            },
                                            {
                                                "example_id": "2486d246-f754-496f-a571-7155e9e09c85",
                                                "sense_id": "f7164a1c-e927-3d37-85cf-4560133a96d2",
                                                "text": "Les anciens impôts basés sur le Koran sont supprimés et remplacés par des contributions nouvelles qui seront recueillies par des fonctionnaires spéciaux, au lieu de l'être par les caïds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69381129-c2ab-3d9c-af92-c593cb0d44c1",
                                        "entry_id": "e983f8e7-d6d8-3bd7-aa95-2dac89c1b68d",
                                        "glosses": [
                                            "Mettre quelque chose de neuf à la place de quelque chose qui a été usé, détruit ou perdu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82b523f0-d32d-4e84-91c0-e70656313b25",
                                                "sense_id": "69381129-c2ab-3d9c-af92-c593cb0d44c1",
                                                "text": "Il faut remplacer les rideaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d15c151-96fa-34ba-90e9-adfe60eda13f",
                                        "entry_id": "e983f8e7-d6d8-3bd7-aa95-2dac89c1b68d",
                                        "glosses": [
                                            "Prendre la place l’un de l’autre, successivement ou alternativement."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
