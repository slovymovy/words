                                "sense_id": "1fa5119f-f80b-3f86-8f92-75391a34c7a1",
                                "text": "Whichever you pick, be content with it."
                            }
                        ]
                    },
                    {
                        "sense_id": "905d8d31-a7e0-3563-ac65-f2eb16374084",
                        "entry_id": "28c4a12a-7f7e-3270-a117-bc548c52b869",
                        "glosses": [
                            "Any or either one(s) that; the one(s) that."
