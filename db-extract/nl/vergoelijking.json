                    },
                    {
                        "translation_id": "060045e8-0eb2-4972-83d3-0ce46e5e303e",
                        "source_entry_id": "c29cfa6f-771b-396a-b0b9-4bd3d7506549",
                        "source_sense_id": "6646fc25-939e-3195-aceb-c0e317f28c13",
                        "source_sense_description": "het zaken die verkeerd zijn zo beschrijven dat ze goed lijken; het recht praten wat krom is",
                        "target_lang_word": "excuse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffa45657-30fc-3e99-b786-37f984600435",
                                        "entry_id": "a21c562e-c651-3136-b3ab-d9847d6aa4db",
                                        "glosses": [
                                            "To forgive; to pardon; to overlook."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef3ebfc-e1bd-4313-9061-ccbe76c2d41b",
                                                "sense_id": "ffa45657-30fc-3e99-b786-37f984600435",
                                                "text": "I excused him his transgressions."
                                            },
                                            {
                                                "example_id": "10a5e355-91f3-4b00-9217-8b47d1b61d79",
                                                "sense_id": "ffa45657-30fc-3e99-b786-37f984600435",
                                                "text": "Yet his Nature / In that’s no Changeling, and I muſt excuſe / What cannot be amended."
                                            },
                                            {
                                                "example_id": "34ed92f5-51da-4626-a366-f36c45ef40bd",
                                                "sense_id": "ffa45657-30fc-3e99-b786-37f984600435",
                                                "text": "If they say that he did sin in doing this, then they must at the same time acknowledge that a man's persuasion that a thing is a duty will not excuse him from guilt in practising it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f15bce4d-7acb-3b7a-abd4-6c5ff2aa3612",
                                        "entry_id": "a21c562e-c651-3136-b3ab-d9847d6aa4db",
                                        "glosses": [
                                            "To allow to leave, or release from any obligation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7f94b5f-fb95-4108-8499-10b9eb6ff9cb",
                                                "sense_id": "f15bce4d-7acb-3b7a-abd4-6c5ff2aa3612",
                                                "text": "May I be excused from the table?"
                                            },
                                            {
                                                "example_id": "67d9bffd-f2dd-48a8-ab0d-d1b12cd0fc75",
                                                "sense_id": "f15bce4d-7acb-3b7a-abd4-6c5ff2aa3612",
                                                "text": "I excused myself from the proceedings to think over what I'd heard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e68139f1-7130-3352-b728-15efd6a89ca2",
                                        "entry_id": "a21c562e-c651-3136-b3ab-d9847d6aa4db",
                                        "glosses": [
                                            "To provide an excuse for; to justify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecd72d4e-0dda-4d6e-b251-f269353d7058",
                                                "sense_id": "e68139f1-7130-3352-b728-15efd6a89ca2",
                                                "text": "You know he shouldn't have done it, so don't try to excuse his behavior!"
                                            },
                                            {
                                                "example_id": "442305b3-59f1-4bc5-8c6d-b5acd3cd5d2f",
                                                "sense_id": "e68139f1-7130-3352-b728-15efd6a89ca2",
                                                "text": "They cannot be excusyd\nBy reason nor by law; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc001097-dd69-3a1c-a300-59cc0756ed8e",
                                        "entry_id": "a21c562e-c651-3136-b3ab-d9847d6aa4db",
                                        "glosses": [
                                            "To relieve of an imputation by apology or defense; to make apology for as not seriously evil; to ask pardon or indulgence for."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a87837c-3333-4642-8f67-89b9c75a6456",
                                                "sense_id": "cc001097-dd69-3a1c-a300-59cc0756ed8e",
                                                "text": "Agayne / thynke ye that we excuſe oure ſelves? we ſpeake in Chriſt in the ſight of God. But we do all thyngꝭ dearly beloved for youre edifyinge."
                                            },
                                            {
                                                "example_id": "2329b032-1107-4937-bcb9-fbe89b46f1f2",
                                                "sense_id": "cc001097-dd69-3a1c-a300-59cc0756ed8e",
                                                "text": "It were more meet that thou didst accuse thy self, and excusedst thy Brother."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "excuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "198aa228-6d68-324a-ab6f-2eefb39d1552",
                                        "entry_id": "939dfd27-8528-363a-9a79-7a1ad9cb8144",
                                        "glosses": [
                                            "An explanation designed to avoid or alleviate guilt or negative judgment; a plea offered in extenuation of a fault."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6e7f85a-b257-4d59-ac20-37dea234dca2",
                                                "sense_id": "198aa228-6d68-324a-ab6f-2eefb39d1552",
                                                "text": "Tell me why you were late – and I don't want to hear any excuses!"
                                            },
                                            {
                                                "example_id": "00230262-3021-47c9-8ff4-f4ff35d5c500",
                                                "sense_id": "198aa228-6d68-324a-ab6f-2eefb39d1552",
                                                "text": "I had to make an excuse for being late to the meeting."
                                            },
                                            {
                                                "example_id": "5881b1db-5d09-4972-92e1-999d8311d402",
                                                "sense_id": "198aa228-6d68-324a-ab6f-2eefb39d1552",
                                                "text": "And they all atonce begane to make excuſe. The fyrſt ſayd vnto him: I have bought a ferme / and I muſt nedes goo and ſe it / I praye the have me excuſed."
                                            },
                                            {
                                                "example_id": "b520fe8f-106b-4f3a-9fb0-a2cdb3cee77a",
                                                "sense_id": "198aa228-6d68-324a-ab6f-2eefb39d1552",
                                                "text": "You can kiss a hundred boys in bars\nShoot another shot, try to stop the feeling\nYou can say it's just the way you are\nMake a new excuse, another stupid reason"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58df8e56-b255-3d13-8c23-a1fe8c224429",
                                        "entry_id": "939dfd27-8528-363a-9a79-7a1ad9cb8144",
                                        "glosses": [
                                            "A defense to a criminal or civil charge wherein the accused party admits to doing acts for which legal consequences would normally be appropriate, but asserts that special circumstances relieve that party of culpability for having done those acts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8dbec4e-0deb-3597-897c-cb858f0df3a9",
                                        "entry_id": "939dfd27-8528-363a-9a79-7a1ad9cb8144",
                                        "glosses": [
                                            "An example of something that is substandard or of inferior quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c08ffd2d-8eb5-46de-b15f-15c450e686e2",
                                                "sense_id": "c8dbec4e-0deb-3597-897c-cb858f0df3a9",
                                                "text": "That thing is a poor excuse for a gingerbread man. Hasn't anyone taught you how to bake?"
                                            },
                                            {
                                                "example_id": "9bac0c11-d023-46b8-a398-e9674361fa5f",
                                                "sense_id": "c8dbec4e-0deb-3597-897c-cb858f0df3a9",
                                                "text": "He's a sorry excuse for a doctor."
                                            },
                                            {
                                                "example_id": "4bf0804d-c885-4680-9da5-0f0b5e9d1f6f",
                                                "sense_id": "c8dbec4e-0deb-3597-897c-cb858f0df3a9",
                                                "text": "What a fucking lame excuse for a man."
                                            },
                                            {
                                                "example_id": "e707c0cd-26dc-479c-a648-f606087ce2a4",
                                                "sense_id": "c8dbec4e-0deb-3597-897c-cb858f0df3a9",
                                                "text": "Seydlitz correctly identifies the larger shell splashes as coming from the two \"large light cruisers\" at the rear, and takes aim. Moments later, Courageous sheers out of line, smoke and steam venting through a massive hole in her side, the shells having blasted right through whatever excuse for armor was present and detonated amidst the boiler rooms. She is doomed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
