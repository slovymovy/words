                ],
                "senses": [
                    {
                        "sense_id": "38bfb2ce-df3d-339c-9f80-6beb7990f160",
                        "entry_id": "6415318b-e5a8-3e79-b486-feb77067077a",
                        "glosses": [
                            "Schwanzflosse eines Wals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b871e65-c3c8-4dd0-b117-87ff7cb6b0ff",
                                "sense_id": "38bfb2ce-df3d-339c-9f80-6beb7990f160",
                                "text": "„Selbst wenn man wie ich der Meinung ist, man könnte diese Tiere auch gern einfach in Ruhe lassen, ist der Anblick eines Wales, der an seiner Schwanzflosse, der Fluke, langsam an Land gezogen wird, überwältigend.“"
                            },
                            {
                                "example_id": "eba0f477-63e4-4f35-b9ac-438ac816be19",
                                "sense_id": "38bfb2ce-df3d-339c-9f80-6beb7990f160",
                                "text": "„Dem kleinen Wal riss die Nabelschnur, bevor die Fluke sich entfalten und festigen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
