                ],
                "senses": [
                    {
                        "sense_id": "ecf1fae1-a0e3-352a-a84f-fdd382cc4ec5",
                        "entry_id": "fcdef823-d97d-397d-9e96-5120357b99bb",
                        "glosses": [
                            "Person, die anderen Wissen vermittelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6993cd7f-db18-4db1-9c24-3f0e2c835b32",
                                "sense_id": "ecf1fae1-a0e3-352a-a84f-fdd382cc4ec5",
                                "text": "„Beim Gespräch über die dienstliche Beurteilung ist es wichtig, dass die Schulleitung die Berufsbiografie der Lehrperson kennt und diese in das Gespräch einbezieht.“"
                            },
                            {
                                "example_id": "682549d9-a2cf-452a-97f0-2d804d4c6fd0",
                                "sense_id": "ecf1fae1-a0e3-352a-a84f-fdd382cc4ec5",
                                "text": "„Die Lehrpersonen müssen genau wissen, wo stehen die Kinder, und dann brauchen sie Materialen, mit denen sie die Kinder erreichen können, die einen ganz spezifischen Förderbedarf haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c96010f-6a76-4570-a9be-6b6ed28383da",
                        "source_entry_id": "fcdef823-d97d-397d-9e96-5120357b99bb",
                        "source_sense_id": "ecf1fae1-a0e3-352a-a84f-fdd382cc4ec5",
                        "source_sense_description": "Person, die anderen Wissen vermittelt",
                        "target_lang_word": "enseignant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enseignant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cedd76bf-a2f7-3fd2-85f5-6d759291dd49",
                                        "entry_id": "8bcca08e-4707-3e5a-9468-8cd97899320a",
                                        "glosses": [
                                            "Celui qui est chargé d’enseigner aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e24aa6-849d-407e-b2ab-5eb7273ff1d0",
                                                "sense_id": "cedd76bf-a2f7-3fd2-85f5-6d759291dd49",
                                                "text": "Après avoir occupé un poste d’enseignant pendant huit ans, il postula pour devenir directeur."
                                            },
                                            {
                                                "example_id": "14fc85a5-67e5-4970-900a-0a494b4aadc8",
                                                "sense_id": "cedd76bf-a2f7-3fd2-85f5-6d759291dd49",
                                                "text": "Par malheur, l’enseignant remplacé a recours à de l’argent scolaire pour récompenser ses élèves, alors que vous avez de la peine à respecter votre budget."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enseignant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c4e8c29-3475-31af-a4d3-f396203dc6bb",
                                        "entry_id": "8e4e0ad2-3e1f-3217-97c4-bcda1c9d3424",
                                        "glosses": [
                                            "Qui contient un enseignement, une leçon."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7be7edd8-dd5f-4454-b53f-2d398948f6a5",
                                                "sense_id": "2c4e8c29-3475-31af-a4d3-f396203dc6bb",
                                                "text": "Après quoi, je me suis longuement penché sur le Bottin Mondain. Une lecture des plus enseignantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d0e9cd5-c83f-3a19-9fe1-8237b44b965e",
                                        "entry_id": "8e4e0ad2-3e1f-3217-97c4-bcda1c9d3424",
                                        "glosses": [
                                            "Relatif aux enseignants."
                                        ],
