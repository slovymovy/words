                "senses": [
                    {
                        "sense_id": "e3b68f43-e904-30c3-b8dd-0a290fbabc82",
                        "entry_id": "93ea310e-a76d-3bde-92bb-86e5c99b2646",
                        "glosses": [
                            "(oft staatliche) Einrichtung, oder zum Beispiel auch der Fachbereich einer Universität, dessen Aufgabe es ist, mit Themen wie Immunologie, Bakteriologie, Epidemiologie und Gesundheitsfragen zu arbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d60040d-45fc-491c-8a51-f7b4bac5252d",
                                "sense_id": "e3b68f43-e904-30c3-b8dd-0a290fbabc82",
                                "text": "„Pläne und Initiativen der Rockefeller Stiftung, ein nationales Hygieneinstitut in Paris einzurichten, konkretisieren sich im Jahr 1940, dem Beginn des Vichy-Regimes.“"
                            },
                            {
                                "example_id": "f81806ea-67a8-4654-92a7-4f1ff45c6648",
                                "sense_id": "e3b68f43-e904-30c3-b8dd-0a290fbabc82",
                                "text": "„Obwohl von staatlicher wie von ärztlicher Seite schon seit längerer Zeit die Errichtung eines eigenen Hygieneinstituts gefordert worden war, war dies von seiten der Universität immer wieder abgelehnt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
