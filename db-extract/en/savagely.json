                                                "example_id": "eba2a722-cb43-4e38-8c1c-042861c6755f",
                                                "sense_id": "db5e7796-e821-3613-a978-8527377a3ff9",
                                                "text": "Zwischen den beiden kam es zu einem wilden Kampf."
