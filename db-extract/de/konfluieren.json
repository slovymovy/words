                "senses": [
                    {
                        "sense_id": "ffc4c14a-3f65-32b3-a0d9-d2b4d9fff006",
                        "entry_id": "3ff1801c-8b48-3805-8885-ebf5e94878ba",
                        "glosses": [
                            "in eins zusammenfließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7c77dea-e2a4-4c1b-900f-38a4ee76a427",
                                "sense_id": "ffc4c14a-3f65-32b3-a0d9-d2b4d9fff006",
                                "text": "„Diese unsere Definition von Religion konfluiert mit einer, die wir Albert Einstein verdanken“."
                            },
                            {
                                "example_id": "dfc59fc6-d9a5-436b-9ca8-bd611b53dae9",
                                "sense_id": "ffc4c14a-3f65-32b3-a0d9-d2b4d9fff006",
                                "text": "Später wird das Exanthem dunkler und konfluiert (Flecken fließen allmählich zu größeren dunklen, roten Flächen zusammen)."
                            },
                            {
                                "example_id": "1dd10acf-ac6e-4be5-9244-16f029cd0a3a",
                                "sense_id": "ffc4c14a-3f65-32b3-a0d9-d2b4d9fff006",
                                "text": "„Die Verdauungssäfte werden in einem Gangsystem gesammelt, das weit verzweigt beginnt und dessen kleine Gänge im Verlauf durch das Organ zum immer größeren konfluieren, die schließlich in der Mitte des Pankreas zum Ductus pancreaticus (Wirsungianus) zusammenfließen. Dieser konfluiert wiederum im oder kurz hinter dem Caput mit dem Ductus choledochus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
