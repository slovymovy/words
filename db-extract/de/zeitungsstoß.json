                "senses": [
                    {
                        "sense_id": "e63dc18f-47a9-372c-b395-5977962027d8",
                        "entry_id": "c80d554d-3e15-303b-afdc-28402b50d5a0",
                        "glosses": [
                            "Stapel von Zeitungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9670ab02-ef9f-4abd-8fc5-d663ec77ce88",
                                "sense_id": "e63dc18f-47a9-372c-b395-5977962027d8",
                                "text": "„Ich blätterte den Zeitungsstoß durch.“"
                            },
                            {
                                "example_id": "8b46d48e-774d-435c-ac3a-6c5204e58611",
                                "sense_id": "e63dc18f-47a9-372c-b395-5977962027d8",
                                "text": "„‚Los jetzt!‘ befahl er dann. Er hieb einem kleinen Jungen, der sich nach seinem Zeitungsstoß auf dem Boden gebückt hatte, auf den Allerwertesten.“"
                            },
                            {
                                "example_id": "f5fc0df3-9238-4a70-acfe-a5792d78f840",
                                "sense_id": "e63dc18f-47a9-372c-b395-5977962027d8",
                                "text": "„Da meckert Helferich: ‚Würde schön aussehen! Eine Zeitung für den Fürsten Schwarzenstein, was, he? Oder zur Gewinnung des Ballettkorps? Da, schauen Sie, dieser Berg ist täglich durchzulaufen!‘ Dabei weist er, nicht ohne Behagen, auf den ungeheuren Zeitungsstoß.“"
                            },
                            {
                                "example_id": "1d40ecb9-d283-43ee-9437-36c7d7f9918e",
                                "sense_id": "e63dc18f-47a9-372c-b395-5977962027d8",
                                "text": "„‚Gleich werden wir's haben,‘ sagte der Kanari, indem er in dem Zeitungsstoß zu blättern anfing, ‚zuerst ist etwas über einen Kasseneinbrecher gestanden, der am Nordende des Schwarzensees vom Gendarmeriepostenführer und seinen Leuten gefaßt worden ist.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
