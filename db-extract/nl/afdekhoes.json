                        "sense_id": "8d4afeb7-3039-355c-8c0f-d0f9ff652bf1",
                        "entry_id": "7b0b2558-9c90-337c-b53b-baac732d4401",
                        "glosses": [
                            "een lap stof die het een voorwerp van boven afsluit ter bescherming, met name de hoes die je over een auto kunt leggen als bescherming tegen de weersinvloeden of tegen vuil in een garage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231e45fd-4256-4aee-a6c1-cf15a8e1ad60",
                                "sense_id": "8d4afeb7-3039-355c-8c0f-d0f9ff652bf1",
                                "text": "In de bagageruimte heeft Honda een klein compartiment gemaakt waarin de afdekhoes opgeborgen kan worden als deze niet wordt gebruikt."
                            },
                            {
                                "example_id": "b00d3613-682b-4ef2-817c-2d9684176e3b",
                                "sense_id": "8d4afeb7-3039-355c-8c0f-d0f9ff652bf1",
                                "text": "Ieder exemplaar wordt afgeleverd met een bijpassende afdekhoes en een koffietafelboek waarin foto's van het productieproces zijn afgedrukt. Ieder boek hoort bij een auto, omdat in het boek het VIN-nummer van de auto is afgebeeld."
                            },
                            {
                                "example_id": "92a8f1a0-bde7-456c-9b13-24302847bc73",
                                "sense_id": "8d4afeb7-3039-355c-8c0f-d0f9ff652bf1",
                                "text": "Zoals de allerduurste Ferrari’s en Bentley’s onder een afdekhoes in een klimaat-gecontroleerde garage stil blijven staan, zo slijten de meest exclusieve knuffelbeesten van het Duitse merk Steiff hun leven in vitrinekasten, onbereikbaar voor kinderhanden."
                            }
                        ]
