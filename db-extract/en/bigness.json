    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e65b1a97-7fd6-38d7-80d4-1c751bf45584",
                "word": "bigness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a321aec9-5f46-4f62-af23-d56796aad199",
                        "entry_id": "e65b1a97-7fd6-38d7-80d4-1c751bf45584",
                        "tags": [
                            "plural"
                        ],
                        "form": "bignesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e625229f-2c89-30a2-bb20-43c87ff73956",
                        "entry_id": "e65b1a97-7fd6-38d7-80d4-1c751bf45584",
                        "glosses": [
                            "Size."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1f88ed69-acd8-4fc7-8ed8-1563fae09c75",
                                "sense_id": "e625229f-2c89-30a2-bb20-43c87ff73956",
                                "text": "His [a hart's] head when it commeth firſt out, hath a ruſſet pyll vpon it, the which is called Veluet,[…]. When his head is growne out to the full bigneſſe, then he rubbeth of that pyll, and that is called fraying of his head."
                            },
                            {
                                "example_id": "6f1a63dd-a0f2-4a0f-b2e7-34923534ad07",
                                "sense_id": "e625229f-2c89-30a2-bb20-43c87ff73956",
                                "text": "Mine old lord, whiles he liv'd, was so precise, / That he would take exceptions at my buttons, / And, being like pins' heads, blame me for the bigness; / Which made me curate-like in mine attire,"
                            },
                            {
                                "example_id": "a9cb4103-7d6e-4f58-abd0-6d40b95ac7a9",
                                "sense_id": "e625229f-2c89-30a2-bb20-43c87ff73956",
                                "text": "And, fast by, hanging in a golden chain, / This pendent World, in bigness as a star / Of smallest magnitude close by the moon."
                            },
                            {
                                "example_id": "5d83133b-a46a-4a81-a7dc-c7ae3c47a72d",
                                "sense_id": "e625229f-2c89-30a2-bb20-43c87ff73956",
                                "text": "He that vvould diſcern the rudimentall ſtroak of a plant, may behold it in the Originall of Duckvveed, at the bigneſſe of a pins point, from convenient vvater in glaſſes, vvherein a vvatchfull eye may alſo diſcover the puncticular Originals of Perivvincles and Gnats."
                            },
                            {
                                "example_id": "b9bb830e-a44f-4056-9e1c-3ed75bb90103",
                                "sense_id": "e625229f-2c89-30a2-bb20-43c87ff73956",
                                "text": "Do not several sorts of Rays make Vibrations of several bignesses, which according to their bignesses excite Sensations of several Colours, much after the manner that the Vibrations of the Air, according to their several bignesses excite Sensations of several Sounds?"
                            },
                            {
                                "example_id": "6c56a009-19b3-4bea-a185-6bd88710f80b",
                                "sense_id": "e625229f-2c89-30a2-bb20-43c87ff73956",
                                "text": "Eighty Poles, each of one Foot high, were erected for this purpoſe, and very ſtrong Cords of the bigneſs of Packthread were faſtned by Hooks to many Bandages, which the Workmen had girt round my Neck, my Hands, my Body, and my Legs."
                            },
                            {
                                "example_id": "84b41c62-7277-468b-9657-a73410a7c5b5",
                                "sense_id": "e625229f-2c89-30a2-bb20-43c87ff73956",
                                "text": "Among the ornaments […] was a small mirror, about the bigness of a lady's hand glass, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "98d153ac-6190-35d9-a4fe-56c4dc898721",
                        "entry_id": "e65b1a97-7fd6-38d7-80d4-1c751bf45584",
                        "glosses": [
                            "The characteristic of being big."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "aee0a276-d652-4928-9fa6-330a89332429",
                                "sense_id": "98d153ac-6190-35d9-a4fe-56c4dc898721",
                                "text": "It was big—and Babbitt respected bigness in anything; in mountains, jewels, muscles, wealth, or words."
                            },
                            {
                                "example_id": "384807ba-504f-49ca-886d-79ede6cc9c59",
                                "sense_id": "98d153ac-6190-35d9-a4fe-56c4dc898721",
                                "text": "They liked what they liked—would tolerate no innovations. My change in thought and expression had angered them into fierce denouncement. To expose a thing deeper than its skin surface was to them an indecency. They ridiculed my striving for bigness, depth."
                            }
                        ]
                    }
