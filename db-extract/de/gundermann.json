                                                "example_id": "cc4c7569-093f-4c7d-b2bd-1f70589516fe",
                                                "sense_id": "0b2d4532-a990-37ac-8bc2-5ea47fc3db1d",
                                                "text": "La saveur du lierre terrestre est aigre et un peu amère, son odeur est aromatique."
