{
    "word_family": [
        "quaky",
        "quakingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9302ee7-1b47-3e98-b931-6a7fd66edeb0",
                    "sense_definition": "To tremble or shake physically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tremble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt the ground <w>quaking</w> beneath my feet.",
                            "target_lang_translations": {
                                "cs": "Cítil jsem, jak se země pod mýma nohama <w>třese</w>."
                            }
                        },
                        {
                            "text": "The mountains <w>quake</w> at his presence.",
                            "target_lang_translations": {
                                "cs": "Hory se <w>otřásají</w> v jeho přítomnosti."
                            }
                        }
                    ],
                    "synonyms": [
                        "tremble",
                        "shake",
                        "shiver"
                    ],
                    "common_phrases": [
                        "earth quakes"
                    ],
                    "target_lang_definitions": {
                        "cs": "Fyzicky se třást nebo chvět."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "třást se",
                                "target_lang_sense_clarification": "obecné vyjádření fyzického chvění"
                            },
                            {
                                "target_lang_word": "chvět se",
                                "target_lang_sense_clarification": "vyjadřuje jemnější nebo intenzivní chvění"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dfa2b97-62ac-3a57-8555-7cfb411cdb9a",
                    "sense_definition": "To be in a state of intense fear or shock that causes one to tremble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tremble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stood there <w>quaking</w> in the grasp of a great fear.",
                            "target_lang_translations": {
                                "cs": "Stála tam a <w>třásla se</w> v sevření velkého strachu."
                            }
                        },
                        {
                            "text": "The soldiers <w>quaked</w> at the thought of the coming battle.",
                            "target_lang_translations": {
                                "cs": "Vojáci se <w>třásli</w> při pomyšlení na nadcházející bitvu."
                            }
                        }
                    ],
                    "synonyms": [
                        "tremble",
                        "shudder"
                    ],
                    "common_phrases": [
                        "quake with fear"
                    ],
                    "target_lang_definitions": {
                        "cs": "Být ve stavu intenzivního strachu nebo šoku, který způsobuje třes."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "klepat se",
                                "target_lang_sense_clarification": "třást se strachem nebo zimou"
                            },
                            {
                                "target_lang_word": "třást se strachy",
                                "target_lang_sense_clarification": "idiomatické vyjádření silného strachu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64246f2a-46d1-3f95-be4c-3d5449831dcf",
                    "sense_definition": "A sudden, violent shaking of the ground.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "California is often hit by a major <w>quake</w>.",
                            "target_lang_translations": {
                                "cs": "Kalifornie je často zasažena silným <w>zemětřesením</w>."
                            }
                        },
                        {
                            "text": "The city was destroyed by a massive <w>quake</w>.",
                            "target_lang_translations": {
                                "cs": "Město bylo zničeno masivním <w>zemětřesením</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "earthquake",
                        "tremor"
                    ],
                    "common_phrases": [
                        "major quake",
                        "minor quake"
                    ],
                    "target_lang_definitions": {
                        "cs": "Náhlé, prudké otřesy zemského povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zemětřesení",
                                "target_lang_sense_clarification": "přirozený geologický jev"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f08865d-cdf4-36f2-b442-3bbf42bfdc43",
                    "sense_definition": "A physical act of trembling or shaking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We felt a <w>quake</w> in the apartment every time the train passed.",
                            "target_lang_translations": {
                                "cs": "Pokaždé, když projížděl vlak, jsme v bytě cítili <w>otřes</w>."
                            }
                        },
                        {
                            "text": "The <w>quake</w> of the building made everyone nervous.",
                            "target_lang_translations": {
                                "cs": "<w>Otřesy</w> budovy znervóznily všechny přítomné."
                            }
                        }
                    ],
                    "synonyms": [
                        "tremor",
                        "shaking",
                        "vibration"
                    ],
                    "target_lang_definitions": {
                        "cs": "Fyzický akt třesení nebo vibrace."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otřes",
                                "target_lang_sense_clarification": "náhlý pohyb nebo vibrace"
                            },
                            {
                                "target_lang_word": "vibrace",
                                "target_lang_sense_clarification": "opakované drobné chvění"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a15c0a30-d5fb-3d6a-8437-4badf4aab691",
                    "sense_definition": "A sudden, devastating event that causes widespread disruption.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company struggled to recover from the economic <w>quake</w>.",
                            "target_lang_translations": {
                                "cs": "Společnost se snažila vzpamatovat z ekonomického <w>otřesu</w>."
                            }
                        },
                        {
                            "text": "The political <w>quake</w> changed the country forever.",
                            "target_lang_translations": {
                                "cs": "Politický <w>převrat</w> navždy změnil zemi."
                            }
                        }
                    ],
                    "synonyms": [
                        "upheaval",
                        "shock"
                    ],
                    "common_phrases": [
                        "political quake"
                    ],
                    "target_lang_definitions": {
                        "cs": "Náhlá, ničivá událost způsobující rozsáhlý rozvrat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otřes",
                                "target_lang_sense_clarification": "přenesený význam pro šokující událost"
                            },
                            {
                                "target_lang_word": "převrat",
                                "target_lang_sense_clarification": "zásadní změna v systému"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f7e3e411-c1aa-359e-82c6-ac358761e7e8",
                    "sense_definition": "The 99th chapter of the Qur'an.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The <w>Quake</w> is a short sura in the Qur'an.",
                            "target_lang_translations": {
                                "cs": "<w>Az-Zalzala</w> je krátká súra v Koránu."
                            }
                        },
                        {
                            "text": "Scholars often study the meaning of the <w>Quake</w>.",
                            "target_lang_translations": {
                                "cs": "Učenci často studují význam súry <w>Az-Zalzala</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "99. súra Koránu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Az-Zalzala",
                                "target_lang_sense_clarification": "tradiční název súry v češtině"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}