                    {
                        "translation_id": "24f30704-96dc-4876-b7b1-ec4662aabbd2",
                        "source_entry_id": "c3c2c37e-3c41-3e7d-b753-3040d1891ad7",
                        "source_sense_id": "48bc771a-38eb-3dc0-a84c-1f33e5e849b9",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Anwohner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anwohner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e5d7c98-9f74-33c7-9fa3-eedbd2386aa8",
                                        "entry_id": "295a582c-6a33-39ed-b10b-d4ca61e1c081",
                                        "glosses": [
                                            "jemand, der unmittelbar neben etwas wohnt, dessen Grundstück an etwas angrenzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "110d5bd0-52f7-4270-a795-2407b67bf3e8",
                                                "sense_id": "7e5d7c98-9f74-33c7-9fa3-eedbd2386aa8",
                                                "text": "Es haben sich bereits mehrere Anwohner darüber beschwert, dass die Kirchenglocken jeden Sonntag um sieben Uhr morgens läuten."
                                            },
                                            {
                                                "example_id": "5e104ae1-1e74-4a38-baa5-9b34493229e6",
                                                "sense_id": "7e5d7c98-9f74-33c7-9fa3-eedbd2386aa8",
                                                "text": "„Ein leiser Asphaltbelag, ein ordentlicher Gehweg, eine Beleuchtung des Nachts: Davon profitieren Anwohner in Seitenstraßen mehr als fremde Autofahrer, die mal vorbeifahren.“"
                                            },
                                            {
                                                "example_id": "28a0f622-2e0d-4d91-9df9-ee464b2786b5",
                                                "sense_id": "7e5d7c98-9f74-33c7-9fa3-eedbd2386aa8",
                                                "text": "„Wir wissen zu wohl, daß in jenen Zeiten viele Schlösser der süßen Quelle glichen, welche die Umgegend befruchtet, den müden Wanderer erquickt, der Magnet ist, welcher die Anwohner zieht, nicht um sie zu verzehren, sondern um sie zu laben. Klöster und Schlösser waren sehr oft in jener Zeit, was jetzt noch die Oasen sind in den afrikanischen Wüsten.“"
                                            },
                                            {
                                                "example_id": "86fc5047-4695-4f5a-a5dd-17a1561056fc",
                                                "sense_id": "7e5d7c98-9f74-33c7-9fa3-eedbd2386aa8",
                                                "text": "„Viele Samstage gehen drauf, wenn der 57-Jährige und seine Mitarbeiter mit Anwohnern über Geschosshöhen diskutieren und über Nistplätze für Mauersegler oder den Anteil von Sozialwohnungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63339fc8-f8d4-4e2e-a9b8-73c3c9d6cb88",
                        "source_entry_id": "c3c2c37e-3c41-3e7d-b753-3040d1891ad7",
