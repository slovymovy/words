                ],
                "senses": [
                    {
                        "sense_id": "853cfc24-2c51-371d-9589-8989a811ed98",
                        "entry_id": "82b5aee5-3878-3e5a-a0bb-909da3829a25",
                        "glosses": [
                            "(abgezogenes) Fell eines Schakals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c18a623a-730a-4d6b-930e-6ba727d4facb",
                                "sense_id": "853cfc24-2c51-371d-9589-8989a811ed98",
                                "text": "„Eine Delegation aus Betschuanaland bringt Leoparden- und Schakalfelle, ‚und ich gab ihnen Ausgaben des Neuen Testaments und hübsch gerahmte Photographien von mir‘.“"
                            },
                            {
                                "example_id": "4ff0e307-5a5d-4992-a7bc-01758bb4130c",
                                "sense_id": "853cfc24-2c51-371d-9589-8989a811ed98",
                                "text": "„Er trägt eine Kappe aus Schakalfell und Glasperlenschmuck in der Farbordnung von Mandelas königlichem Clan.“"
                            },
                            {
                                "example_id": "fb59c1bd-224b-418e-96c2-ab1bc4531993",
                                "sense_id": "853cfc24-2c51-371d-9589-8989a811ed98",
                                "text": "„Das Schakalfell auf den Biß eines tollen Hundes gelegt, behebt die Wasserscheu.“"
                            },
                            {
                                "example_id": "d4895a80-a320-409a-8750-09bc70e180a8",
                                "sense_id": "853cfc24-2c51-371d-9589-8989a811ed98",
                                "text": "„Flugs wurde jedem Dorfe aufgetragen, bei 20 Rupien Strafe binnen drei Wochen je ein Schakalfell und eine Schakalgalle abzuliefern.“"
                            },
                            {
                                "example_id": "206c512c-536a-4dd5-b939-75d5b7af878d",
                                "sense_id": "853cfc24-2c51-371d-9589-8989a811ed98",
                                "text": "„Jeder der Knaben führte ebenfalls ein großes, halbmondförmiges Pulverhorn mit einer Kugeltasche und über den Sattel eines jeden war der Ueberwurf oder Karoß geschnallt, welcher sich von dem ihres Vaters nur dadurch unterschied, daß der seine von dem selteneren Leopardenfelle, dagegen die ihrigen von gewöhnlicher Art, der eine von Antilopen- und der andere von Schakalfell gefertigt waren. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
