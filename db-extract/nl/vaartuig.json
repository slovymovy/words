                    {
                        "translation_id": "d4100e22-2ab3-4789-ba28-4f3ae4f9dcd3",
                        "source_entry_id": "eb7bff0c-36cc-3cde-b0b7-2980432069fc",
                        "source_sense_id": "d2fbceaa-5544-3a20-ade1-1763de836a8d",
                        "source_sense_description": "vervoermiddel op water",
                        "target_lang_word": "embarcation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embarcation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                        "entry_id": "6e1ab70c-378e-3c5f-96f2-5efd8d659e30",
                                        "glosses": [
                                            "Bateau de petite taille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559018c9-7b30-4c1b-8def-f9e7dc5c72d5",
                                                "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                                "text": "Des matelots tiraient, l’épaule courbée, des embarcations sur le quai."
                                            },
                                            {
                                                "example_id": "05d2c7cf-6de0-4e60-93be-3b552b764db1",
                                                "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                                "text": "[…]; et l’on voyait déjà quelques embarcations filer doucement sur l’eau que battaient les grands avirons, pareils à des vols de goélands lents et bas. On était au plus fort de la pêche du maquereau."
                                            },
                                            {
                                                "example_id": "f92abeed-4de9-4b32-a3da-b027ebab0499",
                                                "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                                "text": "La capture des baleinoptères par des procédés modernes a remplacé la tuerie périodique des bandes de marsouins rabattus par les embarcations au fond des baies."
                                            },
                                            {
                                                "example_id": "fd374f0d-29d8-41e7-83ef-261b6410283f",
                                                "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                                "text": "L’énorme rouf construit sur l’embarcation et son gréement, démontraient l’inexpérience totale que son propriétaire avait des choses de la mer."
                                            },
                                            {
                                                "example_id": "a324daf1-1fd8-4f1a-9010-08394cdf26fb",
                                                "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                                "text": "Ordre fut donné au charpentier Mac Nap de procéder à la construction d’une vaste embarcation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a3e6a5a-78ef-3580-8606-733eed297487",
                                        "entry_id": "6e1ab70c-378e-3c5f-96f2-5efd8d659e30",
                                        "glosses": [
                                            "Bateau de petite taille équipant un navire, qui permet notamment de faire la navette jusqu’à terre ou de sauver les personnes à bord en cas de naufrage."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53834ea3-a9bb-4800-9ee1-6b77ff8a9c61",
                                                "sense_id": "9a3e6a5a-78ef-3580-8606-733eed297487",
                                                "text": "L’équipage parvint à se sauver dans les embarcations du bâtiment, et une partie gagna un navire américain qui était alors à l’ancre dans la baie de Myanboor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfbd8c8e-8506-3c85-94b0-44636937e6cc",
                                        "entry_id": "6e1ab70c-378e-3c5f-96f2-5efd8d659e30",
                                        "glosses": [
                                            "Embarquement."
                                        ],
                                        "tags": [],
                                        "note": "Cet emploi est communément jugé abusif. Il est cependant compris par le locuteur francophone (embarquer & -ation : « action d’embarquer »). référence nécessaire (résoudre le problème",
                                        "examples": [
                                            {
                                                "example_id": "e8e4b65b-e7f9-4f5a-8ebb-a7d39ac7a9b8",
                                                "sense_id": "dfbd8c8e-8506-3c85-94b0-44636937e6cc",
                                                "text": "Un dégrad se trouve au bord d'un cours d’eau et permet l’embarcation des passagers d'une pirogue. Aujourd'hui, par extension, le mot « dégrad » s'applique à tous les ports fluviaux de Guyane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
