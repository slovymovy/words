{
    "word_family": [
        "imaginer",
        "imaginaire",
        "imaginatif",
        "imaginable",
        "inimaginable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41a795df-668c-364d-9812-ef7d2610f891",
                    "sense_definition": "Faculté d'imaginer, de se représenter mentalement des personnes, des choses ou des situations.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "faculte_mentale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce paysage grandiose frappe immédiatement l'<w>imagination</w> des voyageurs qui visitent la région."
                        },
                        {
                            "text": "Dans son esprit, il pouvait visualiser la scène avec une grande précision grâce à son <w>imagination</w>."
                        }
                    ],
                    "common_phrases": [
                        "frapper l'imagination",
                        "dans l'imagination"
                    ]
                },
                {
                    "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                    "sense_definition": "Faculté d'inventer, de concevoir et de créer des œuvres artistiques ou des idées originales.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "faculte_mentale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur possède une <w>imagination</w> fertile qui lui permet d'écrire des récits captivants."
                        },
                        {
                            "text": "Les enfants font preuve de beaucoup d'<w>imagination</w> lorsqu'ils inventent de nouveaux jeux."
                        }
                    ],
                    "synonyms": [
                        "créativité",
                        "inventivité"
                    ],
                    "common_phrases": [
                        "imagination fertile",
                        "imagination créatrice",
                        "avoir de l'imagination",
                        "manque d'imagination"
                    ]
                },
                {
                    "sense_id": "6d5456c4-1711-33a5-9bce-f0bd18394c7c",
                    "sense_definition": "Croyance ou idée fausse, sans aucun fondement dans la réalité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas pour ces bruits nocturnes, ce n'est que de la pure <w>imagination</w>."
                        },
                        {
                            "text": "Ce complot que tu redoutes tant n'est en fait que le fruit de ton <w>imagination</w>."
                        }
                    ],
                    "synonyms": [
                        "illusion",
                        "chimère"
                    ],
                    "antonyms": [
                        "réalité"
                    ],
                    "common_phrases": [
                        "pure imagination",
                        "fruit de l'imagination"
                    ]
                },
                {
                    "sense_id": "4fde267e-675a-3529-aaf2-4feca40f9ee7",
                    "sense_definition": "Production de l'esprit, conception inventive ou création originale dans les arts ou les lettres.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette sculpture monumentale est l'une des plus remarquables <w>imaginations</w> de cet artiste de la Renaissance."
                        },
                        {
                            "text": "Le guide nous a présenté les riches <w>imaginations</w> architecturales qui décorent le château médiéval."
                        }
                    ],
                    "synonyms": [
                        "création",
                        "invention"
                    ]
                },
                {
                    "sense_id": "521b19cf-6aff-3466-b203-9b426fa558b4",
                    "sense_definition": "Fantaisie bizarre, idée extravagante ou caprice de l'esprit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est laissé égarer par de folles <w>imaginations</w> qui ne reposent sur aucun fait tangible."
                        },
                        {
                            "text": "Ses collègues refusent de suivre ses projets farfelus, nés d'une <w>imagination</w> trop agitée."
                        }
                    ],
                    "synonyms": [
                        "extravagance",
                        "fantaisie"
                    ],
                    "common_phrases": [
                        "folle imagination"
                    ]
                }
            ]
        }
    ]
}