                    "frequency": "High",
                    "semantic_group_id": "film_untertitel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich schaue fremdsprachige Filme am liebsten im Original mit deutschen <w>Untertiteln</w>."
