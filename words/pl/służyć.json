    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44f85860-a0fe-3b47-9fd7-84becc8fb443",
                    "sense_definition": "Być przeznaczonym do wykonywania określonej funkcji lub czynności; mieć zastosowanie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "utility_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten klucz <w>służy</w> do otwierania tylnej bramy.",
                            "target_lang_translations": {
                                "ru": "Этот ключ <w>служит</w> для открывания задних ворот.",
                                "en": "This key <w>is used</w> to open the back gate."
                            }
                        },
                        {
                            "text": "Nie wiem, do czego <w>służy</w> to skomplikowane urządzenie.",
                            "target_lang_translations": {
                                "ru": "Я не знаю, для чего <w>служит</w> это сложное устройство.",
                                "en": "I don't know what this complicated device <w>is used for</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "służyć do celów",
                        "służyć do zabawy",
                        "czemu to służy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначаться для выполнения определенной функции или действия; использоваться.",
                        "en": "To be intended for a specific purpose or function; to be used for."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служить",
                                "target_lang_sense_clarification": "быть предназначенным для чего-либо"
                            },
                            {
                                "target_lang_word": "использоваться",
                                "target_lang_sense_clarification": "применяться"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "serve",
                                "target_lang_sense_clarification": "to function or be used for"
                            },
                            {
                                "target_lang_word": "be used for",
                                "target_lang_sense_clarification": "purpose or function"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15321ba1-f0c1-377d-b82e-7fa4e9db9c2d",
                    "sense_definition": "O przedmiotach: być użytecznym dla kogoś, działać sprawnie i być wykorzystywanym przez pewien czas.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "utility_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój stary samochód <w>służył</w> mi bezawaryjnie przez dziesięć lat.",
                            "target_lang_translations": {
                                "ru": "Моя старая машина безотказно <w>служила</w> мне десять лет.",
                                "en": "My old car <w>served</w> me reliably for ten years."
                            }
                        },
                        {
                            "text": "Mam nadzieję, że ten płaszcz będzie ci długo <w>służył</w>.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, это пальто будет долго тебе <w>служить</w>.",
                                "en": "I hope this coat will <w>last</w> you a long time."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wiernie służyć",
                        "długo służyć",
                        "dobrze służyć"
                    ],
                    "target_lang_definitions": {
                        "ru": "О предметах: быть полезным, исправно работать и использоваться в течение определенного времени.",
                        "en": "Of objects: to be useful to someone, function properly, and remain in use over a period of time."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служить",
                                "target_lang_sense_clarification": "исправно работать (о вещах)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "serve",
                                "target_lang_sense_clarification": "of an object, to remain useful over time"
                            },
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "to remain in functional use"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a4a58a1-8bf6-39c0-a4f6-f63c3e25943b",
                    "sense_definition": "Pełnić służbę wojskową; być żołnierzem.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "service_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój dziadek <w>służył</w> w marynarce wojennej podczas wojny.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка <w>служил</w> на флоте во время войны.",
                                "en": "My grandfather <w>served</w> in the navy during the war."
                            }
                        },
                        {
                            "text": "Wielu młodych ludzi nie chce już <w>służyć</w> w armii.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди больше не хотят <w>служить</w> в армии.",
                                "en": "Many young people no longer want to <w>serve</w> in the army."
                            }
                        }
                    ],
                    "synonyms": [
                        "odbywać służbę"
                    ],
                    "common_phrases": [
                        "służyć w wojsku",
                        "służyć w armii",
                        "służyć ojczyźnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить военную службу; быть солдатом.",
                        "en": "To perform military service; to be a soldier or member of the armed forces."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служить",
                                "target_lang_sense_clarification": "в армии или на флоте"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "serve",
                                "target_lang_sense_clarification": "in the military"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fd27326-ac20-306f-bbc4-94ccabb9ea3f",
                    "sense_definition": "Wpływać pozytywnie na czyjeś zdrowie, samopoczucie lub wygląd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effect_health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Górskie powietrze bardzo mi <w>służy</w>, czuję się tu świetnie.",
                            "target_lang_translations": {
                                "ru": "Горный воздух мне очень <w>идет на пользу</w>, я чувствую себя здесь отлично.",
                                "en": "The mountain air really <w>agrees with</w> me; I feel great here."
                            }
                        },
                        {
                            "text": "Widzę, że nowa dieta ci <w>służy</w>, bo wyglądasz kwitnąco.",
                            "target_lang_translations": {
                                "ru": "Я вижу, что новая диета тебе <w>идет на пользу</w>, так как ты выглядишь цветущей.",
                                "en": "I can see the new diet <w>suits</w> you, because you look radiant."
                            }
                        }
                    ],
                    "antonyms": [
                        "szkodzić"
                    ],
                    "common_phrases": [
                        "zdrowie służy",
                        "klimat służy",
                        "jedzenie służy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положительно влиять на чье-то здоровье, самочувствие или внешний вид.",
                        "en": "To have a positive effect on someone's health, wellbeing, or appearance."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти на пользу",
                                "target_lang_sense_clarification": "благотворно влиять"
                            },
                            {
                                "target_lang_word": "подходить",
                                "target_lang_sense_clarification": "быть полезным для здоровья"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "agree with",
                                "target_lang_sense_clarification": "suit one's health or constitution"
                            },
                            {
                                "target_lang_word": "suit",
                                "target_lang_sense_clarification": "be good for someone's wellbeing or appearance"
                            },
                            {
                                "target_lang_word": "do good",
                                "target_lang_sense_clarification": "have a beneficial effect on"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4e3d59d-4a8f-31dd-92fe-623b9f9aa614",
                    "sense_definition": "Być gotowym do pomocy; oferować komuś swoje wsparcie lub radę.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "service_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz sąsiad zawsze chętnie <w>służy</w> dobrą radą w sprawach ogrodnictwa.",
                            "target_lang_translations": {
                                "ru": "Наш сосед всегда охотно <w>помогает</w> добрым советом в вопросах садоводства.",
                                "en": "Our neighbour is always happy to <w>offer</w> good gardening advice."
                            }
                        },
                        {
                            "text": "Recepcjonista <w>służy</w> pomocą wszystkim gościom hotelowym.",
                            "target_lang_translations": {
                                "ru": "Администратор <w>готов помочь</w> всем гостям отеля.",
                                "en": "The receptionist <w>provides</w> assistance to all hotel guests."
                            }
                        }
                    ],
                    "common_phrases": [
                        "służyć radą",
                        "służyć pomocą",
                        "czym mogę służyć"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть готовым помочь; предлагать кому-то свою поддержку или совет.",
                        "en": "To be ready to help; to offer assistance, advice, or support."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помогать",
                                "target_lang_sense_clarification": "оказывать поддержку"
                            },
                            {
                                "target_lang_word": "быть к услугам",
                                "target_lang_sense_clarification": "предлагать помощь"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "offer",
                                "target_lang_sense_clarification": "to offer help or advice"
                            },
                            {
                                "target_lang_word": "provide",
                                "target_lang_sense_clarification": "to provide assistance or support"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19620dc2-d799-33cf-9721-d391af5f4803",
                    "sense_definition": "Pełnić rolę kogoś lub czegoś; zastępować coś innego.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "utility_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta rozkładana sofa w nocy <w>służy</w> nam za łóżko.",
                            "target_lang_translations": {
                                "ru": "Этот раскладной диван по ночам <w>служит</w> нам кроватью.",
                                "en": "At night, this sofa bed <w>serves as</w> our bed."
                            }
                        },
                        {
                            "text": "Jego bohaterska postawa powinna <w>służyć</w> za wzór dla młodzieży.",
                            "target_lang_translations": {
                                "ru": "Его героическое поведение должно <w>служить</w> примером для молодежи.",
                                "en": "His heroic attitude should <w>serve as</w> a model for youth."
                            }
                        }
                    ],
                    "common_phrases": [
                        "służyć za przykład",
                        "służyć za dowód",
                        "służyć za wzór"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять роль кого-то или чего-то; заменять собой что-то другое.",
                        "en": "To fulfill the role of someone or something; to act as or substitute for something else."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служить",
                                "target_lang_sense_clarification": "выступать в качестве чего-либо"
                            },
                            {
                                "target_lang_word": "являться",
                                "target_lang_sense_clarification": "быть чем-либо"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "serve as",
                                "target_lang_sense_clarification": "to function as or substitute for"
                            },
                            {
                                "target_lang_word": "act as",
                                "target_lang_sense_clarification": "to perform the role of"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c0c24f3-8554-3b3c-b63e-e06271a0d3d3",
                    "sense_definition": "O psie: stać na tylnych łapach, zwykle prosząc o jedzenie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój pies potrafi <w>służyć</w>, gdy widzi w mojej ręce smakołyk.",
                            "target_lang_translations": {
                                "ru": "Моя собака умеет <w>служить</w>, когда видит у меня в руке лакомство.",
                                "en": "My dog knows how to <w>beg</w> when he sees a treat in my hand."
                            }
                        },
                        {
                            "text": "Dzieci uczyły małego szczeniaka <w>służyć</w> na komendę.",
                            "target_lang_translations": {
                                "ru": "Дети учили маленького щенка <w>служить</w> по команде.",
                                "en": "The children were teaching the little puppy to <w>sit up</w> on command."
                            }
                        }
                    ],
                    "synonyms": [
                        "prosić"
                    ],
                    "common_phrases": [
                        "pies służy",
                        "nauczyć psa służyć"
                    ],
                    "target_lang_definitions": {
                        "ru": "О собаке: стоять на задних лапах, обычно выпрашивая еду.",
                        "en": "Of a dog: to sit up or stand on its hind legs, typically begging for food."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служить",
                                "target_lang_sense_clarification": "стоять на задних лапах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "beg",
                                "target_lang_sense_clarification": "of a dog, sitting on hind legs"
                            },
                            {
                                "target_lang_word": "sit up",
                                "target_lang_sense_clarification": "of a dog, on hind legs to ask for food"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da69a8b6-1a38-3033-b5b8-cee003d60402",
                    "sense_definition": "Pracować jako pomoc domowa lub sługa; wykonywać polecenia pana.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "service_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych czasach chłopi musieli wiernie <w>służyć</w> swojemu panu.",
                            "target_lang_translations": {
                                "ru": "В давние времена крестьяне должны были верно <w>служить</w> своему господину.",
                                "en": "In ancient times, peasants had to faithfully <w>serve</w> their lord."
                            }
                        },
                        {
                            "text": "Ta kobieta <w>służyła</w> u bogatej rodziny przez ponad dwadzieścia lat.",
                            "target_lang_translations": {
                                "ru": "Эта женщина <w>служила</w> у богатой семьи более двадцати лет.",
                                "en": "This woman <w>served</w> with a wealthy family for over twenty years."
                            }
                        }
                    ],
                    "common_phrases": [
                        "służyć u pana",
                        "wiernie służyć"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "współcześnie rzadziej używane w kontekście pracy zarobkowej, częściej w kontekście historycznym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать в качестве домашней прислуги или слуги; выполнять приказания господина.",
                        "en": "To work as a domestic servant; to carry out duties for a master."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служить",
                                "target_lang_sense_clarification": "быть слугой"
                            },
                            {
                                "target_lang_word": "прислуживать",
                                "target_lang_sense_clarification": "выполнять обязанности слуги"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "serve",
                                "target_lang_sense_clarification": "to work as a servant"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}