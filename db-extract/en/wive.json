                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf83e6d9-32fc-4f95-819a-1698f4060695",
                        "source_entry_id": "21840fa5-4eb2-3e3a-8431-cbbeb95a0b7e",
                        "source_sense_description": "to marry (a woman)",
                        "target_lang_word": "heiraten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heiraten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f731ba6a-e504-3c70-aa8e-4fed57eac05e",
                                        "entry_id": "86967298-d83c-37a9-8f02-66e3ba0b878f",
                                        "glosses": [
                                            "den Bund der Ehe eingehen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83fccc22-8797-4c62-8847-9cfa96873214",
                                                "sense_id": "f731ba6a-e504-3c70-aa8e-4fed57eac05e",
                                                "text": "„Sie mussten heiraten, sie ist schwanger.“"
                                            },
                                            {
                                                "example_id": "d215f920-6288-4a60-9fb1-123ddf5dfb8f",
                                                "sense_id": "f731ba6a-e504-3c70-aa8e-4fed57eac05e",
                                                "text": "Geheiratet hat Vestre erst mit 57."
                                            },
                                            {
                                                "example_id": "6edafab9-1e07-409c-85b1-874f7741d6d3",
                                                "sense_id": "f731ba6a-e504-3c70-aa8e-4fed57eac05e",
                                                "text": "Die Eltern, welche zu dieser Zunft gehören, geben einen bestimmten Platz vor einer Kirchtüre ihren Söhnen oder Töchtern zur Aussteuer mit, wenn sie heiraten. (Johann Kaspar Riesbeck, Briefe eines reisenden Franzosen über Deutschland, Köln, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "2b29d47b-c2fa-428e-a9f5-ffafd506751f",
                                                "sense_id": "f731ba6a-e504-3c70-aa8e-4fed57eac05e",
                                                "text": "„Als ich heiratete, merkte ich, dass die Familie meiner Frau viel komplizierter gestrickt war als meine.“"
                                            },
                                            {
                                                "example_id": "4f2b0d1a-eec1-4392-bb40-7dc401fb76cf",
                                                "sense_id": "f731ba6a-e504-3c70-aa8e-4fed57eac05e",
                                                "text": "Die High Society ist außer Rand und Band: Es wird wieder geheiratet! In allerhöchsten Kreisen. Die Braut ist Pippa Middleton, die Schwester der britischen Prinzgemahlin Catherine, genannt Kate."
                                            },
                                            {
                                                "example_id": "f4d60c8f-8529-4b13-93d4-1e53f6321c23",
                                                "sense_id": "f731ba6a-e504-3c70-aa8e-4fed57eac05e",
                                                "text": "Stefan und Eva haben in den 80ern geheiratet. In ihrem Freundeskreis war Heirat total verpönt. Sie waren die ersten, die es wieder wagten, sich zu trauen."
                                            },
                                            {
                                                "example_id": "9d323909-e314-49fc-b779-2d3fd75271be",
                                                "sense_id": "f731ba6a-e504-3c70-aa8e-4fed57eac05e",
                                                "text": "„Geheiratet haben die beiden 1989, kurz nach dem Tiananmen-Massaker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9e2be60-4391-382b-b106-37cb61fcd7f7",
                                        "entry_id": "86967298-d83c-37a9-8f02-66e3ba0b878f",
                                        "glosses": [
                                            "jemanden zum Ehepartner nehmen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4fd5eef-5bf5-40ee-9c36-b053532c04ce",
                                                "sense_id": "a9e2be60-4391-382b-b106-37cb61fcd7f7",
                                                "text": "„Ich werde ihn nicht heiraten!“"
                                            },
                                            {
                                                "example_id": "729dbe66-d248-4e4d-9988-d1da67d07b73",
                                                "sense_id": "a9e2be60-4391-382b-b106-37cb61fcd7f7",
                                                "text": "Levy war 1976, nach dem Kunststudium, im Alter von 27 Jahren nach Israel eingewandert und hatte den Psychologen Itamar Levy geheiratet."
                                            },
                                            {
                                                "example_id": "d9b320e7-070a-472e-a61e-9df8d5a4dd25",
                                                "sense_id": "a9e2be60-4391-382b-b106-37cb61fcd7f7",
                                                "text": "Wer eine Frau vergewaltigt, sie dann aber heiratet, kann in einigen arabischen Ländern mit Straflosigkeit rechnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4de63896-4566-3a93-a6e6-dc837ccdd820",
                                        "entry_id": "86967298-d83c-37a9-8f02-66e3ba0b878f",
                                        "glosses": [
                                            "infolge der Ehe wegziehen an einen anderen Ort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9435934-adc2-4085-acdc-aa0666bf21f7",
                                                "sense_id": "4de63896-4566-3a93-a6e6-dc837ccdd820",
                                                "text": "Sie hat letztes Jahr John kennengelernt und nach Toronto geheiratet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b35605e-f745-4095-8848-2ef08569a1ac",
                        "source_entry_id": "21840fa5-4eb2-3e3a-8431-cbbeb95a0b7e",
