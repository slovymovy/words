                ],
                "senses": [
                    {
                        "sense_id": "ff5186d9-cdcd-397f-aed6-ffa10a2dde8d",
                        "entry_id": "fba2ce89-70bc-31ce-a17e-3b2cfe0962b0",
                        "glosses": [
                            "ranghohe spanische Adelige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4f38235-ddda-478a-99a8-ee6642834345",
                                "sense_id": "ff5186d9-cdcd-397f-aed6-ffa10a2dde8d",
                                "text": "„Don Alonso, Grand von Kastilien, hat eine Tochter, Isaura, diese ist sehr verzogen oder ungezogen, sie ist hochmüthig, zanksüchtig, eigensinnig, auffahrend, kurz, sie ist nicht mehr und nicht minder verzogen als gewöhnlich junge Grandinnen sind, sie mögen nun Grandinnen von Kastilien oder Grandinnen von Schottenfelde sein […]“"
                            },
                            {
                                "example_id": "f8d202c1-4e0d-4270-9d27-d5dd4060832d",
                                "sense_id": "ff5186d9-cdcd-397f-aed6-ffa10a2dde8d",
                                "text": "„Die jetzige Königin noch als Prinzessin hat sich manche Kränkung von den Grandinnen müssen gefallen lassen […]“"
                            },
                            {
                                "example_id": "9788c487-004a-4da7-8e1a-8798644a9eae",
                                "sense_id": "ff5186d9-cdcd-397f-aed6-ffa10a2dde8d",
                                "text": "„Bei der Königin haben die Grandinnen ein Sammetkissen, ihre ältesten Schwiegertöchter ein Kissen von Damast oder Atlas zum Sitzen, alle Andern stehen, oder setzen sich auf den Boden, der überall mit Matten und Teppichen bedeckt ist.“"
                            },
                            {
                                "example_id": "b656a3b8-e125-48d5-bf56-268d7a55091d",
                                "sense_id": "ff5186d9-cdcd-397f-aed6-ffa10a2dde8d",
                                "text": "„Dabei ist sie doch eine so vornehme Dame, in Wahrheit eine Grandin der Ersten Reihe.“"
                            },
                            {
                                "example_id": "bd482cc9-2931-41c7-bd8e-9c9e3ad98909",
                                "sense_id": "ff5186d9-cdcd-397f-aed6-ffa10a2dde8d",
                                "text": "„Die Besorgung und die Kosten des Festes übernimmt gewöhnlich eine Person von hohem Adel, ein Grande oder eine Grandin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d66c2659-d1cf-3e58-bd8d-4714af288526",
                        "entry_id": "fba2ce89-70bc-31ce-a17e-3b2cfe0962b0",
                        "glosses": [
                            "hochstehende Vertreterin einer Gruppe oder einer Organisation"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "77fb3a02-f447-475d-b3ea-3977759f9c01",
                                "sense_id": "d66c2659-d1cf-3e58-bd8d-4714af288526",
                                "text": "„Das Lied, zu dem die Granden und die Grandinnen in die bummvolle Oberwarter Messehalle einzogen, heißt ‚Brücken zum Mond‘.“"
                            },
                            {
                                "example_id": "f73a7ad4-770c-429a-8ed5-ee2b990cf9a2",
                                "sense_id": "d66c2659-d1cf-3e58-bd8d-4714af288526",
                                "text": "„Mit viel Vergnügen ahmt er zum Beispiel die fistelnde Stimme des Bertolt Brecht nach, den Riemann am BE noch leibhaftig erlebt hat, kann wunderbar von Helene Weigel und anderen Grandinnen und Granden dieses berühmten Theaters berichten.“"
                            },
                            {
                                "example_id": "4f17f4ff-6779-48c2-9ad4-a0b52bef9ae4",
                                "sense_id": "d66c2659-d1cf-3e58-bd8d-4714af288526",
                                "text": "„Auch alte Grandinnen und Granden wie Anna-Rita Dutly, Bruno Lüscher oder Carlo Parolari folgten der Einladung.“"
                            },
                            {
                                "example_id": "f5c5abc1-2f1e-49e0-9ce5-bd321a22d77b",
                                "sense_id": "d66c2659-d1cf-3e58-bd8d-4714af288526",
                                "text": "„Die Grandinnen und Granden der Intendantengruppe des Deutschen Bühnenvereins konsultierten auf einer Tagung in dieser Angelegenheit die Schriftstellerin Sibylle Berg.“"
                            },
                            {
                                "example_id": "526567cf-9766-49ef-bad2-9ed11b307a4c",
                                "sense_id": "d66c2659-d1cf-3e58-bd8d-4714af288526",
                                "text": "„So finden sich von Monet bis Picasso, von Warhol bis zu Richter, von Kokoschka bis Lassnig alle Granden und Grandinnen seit der Klassischen Moderne.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
