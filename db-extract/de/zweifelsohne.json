        "fr-extract.jsonl": [
            {
                "entry_id": "0c813318-ebf3-35f0-9956-39e1dcd838b9",
                "word": "zweifelsohne",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1072ecff-bc8e-3b28-b763-fe8dbb2a3840",
                        "entry_id": "0c813318-ebf3-35f0-9956-39e1dcd838b9",
                        "glosses": [
                            "Sans doute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb01decc-e724-4308-b082-be318a9fb08d",
                                "sense_id": "1072ecff-bc8e-3b28-b763-fe8dbb2a3840",
                                "text": "Es stimmt zweifelsohne, dass viele globale Krisen, von Klima über Pandemien und Verschuldung bis hin zu Russlands Krieg gegen die Ukraine, ohne China schwer erfolgreich anzugehen sind.",
                                "translation": "Il est sans doute vrai que de nombreuses crises mondiales, du climat aux pandémies, de l’endettement à la guerre de la Russie contre l'Ukraine, sont difficiles à traiter avec succès sans la Chine."
                            },
                            {
                                "example_id": "81075d97-3452-4071-98dc-30beb96270c4",
                                "sense_id": "1072ecff-bc8e-3b28-b763-fe8dbb2a3840",
                                "text": "Die vier Kinder, welche der Frau gehörten, schienen alle im gleichen Alter zu stehen, ein seltsamer Umstand, der den Major überraschte. Die Alte hatte noch ein fünftes fast an ihrem Rocke hängen, das schwach, bleich und kränklich war und zweifelsohne der größten Sorgfalt bedurfte; demgemäß war es der Liebling, der Benjamin.",
                                "translation": "Les quatre enfants, qui appartenaient à cette femme, paraissaient avoir tous le même âge, circonstance bizarre qui frappa le commandant. La vieille en avait un cinquième presque pendu à son jupon, et qui, faible, pâle, maladif, réclamait sans doute les plus grands soins ; partant il était le bien-aimé, le Benjamin."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "9b3a96d1-5f2c-354d-a5d9-720f45ac27cb",
                "word": "zweifelsohne",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "32f506d2-1a83-357a-841f-f8371ff6a310",
                        "entry_id": "9b3a96d1-5f2c-354d-a5d9-720f45ac27cb",
                        "glosses": [
                            "ganz sicher, mit Bestimmtheit, ohne Zweifel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c87de22b-3583-4cba-b6ef-d41671e07d1c",
                                "sense_id": "32f506d2-1a83-357a-841f-f8371ff6a310",
                                "text": "Das neue italienische Restaurant wird hier zweifelsohne großen Erfolg haben."
                            },
                            {
                                "example_id": "33a4e982-7d5f-4ef7-9ccc-a5d44ef64bbb",
                                "sense_id": "32f506d2-1a83-357a-841f-f8371ff6a310",
                                "text": "Zweifelsohne wird ein Motorschaden die Folge sein, wenn jetzt keine Reparatur des Wagens stattfindet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b7133cc-42c2-44ed-b7a9-352f68217f20",
                        "source_entry_id": "9b3a96d1-5f2c-354d-a5d9-720f45ac27cb",
                        "source_sense_id": "32f506d2-1a83-357a-841f-f8371ff6a310",
                        "source_sense_description": "ganz sicher, mit Bestimmtheit, ohne Zweifel",
                        "target_lang_word": "undoubtedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undoubtedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                        "entry_id": "c765d208-4c5e-32dd-9549-1f8c430d2e6c",
                                        "glosses": [
                                            "Without doubt; definitely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14f2397-0f7b-4e01-bea5-73e800d079a6",
                                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                                "text": "The cane was undoubtedly of foreign make, for it had a solid silver ferrule at one end, which was not English hall–marked."
                                            },
                                            {
                                                "example_id": "1ce691d9-5a8c-4522-89d8-2374aeee8b87",
                                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                                "text": "He declared that these drastic steps would undoubtedly inconvenience a good many people, but the alternative was bankruptcy of the Ulster Transport Authority and the breakdown of public transport services."
                                            },
                                            {
                                                "example_id": "67475126-f87b-45d9-b8cc-5c05c8488998",
                                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                                "text": "“It’s been a long process and I’ve come close to giving up along the way, but this is undoubtedly the craziest archaeological excavation I’ve yet been part of,” Bloch said in the news release."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "609bc7db-2825-4aed-bd89-c66b86ae33b3",
                        "source_entry_id": "9b3a96d1-5f2c-354d-a5d9-720f45ac27cb",
                        "source_sense_id": "32f506d2-1a83-357a-841f-f8371ff6a310",
                        "source_sense_description": "ganz sicher, mit Bestimmtheit, ohne Zweifel",
                        "target_lang_word": "unquestionably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unquestionably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5199160b-6c25-312c-9e42-1f6cb02d7c8f",
                                        "entry_id": "a6b4e592-3b0a-3398-b1f7-bdbc408b48eb",
                                        "glosses": [
                                            "Without question; beyond doubt; indubitably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a2fbed-b66e-4e7b-9218-aca46d21edda",
                                                "sense_id": "5199160b-6c25-312c-9e42-1f6cb02d7c8f",
                                                "text": "It is a strange fact, but it is unquestionably true that almost any English intellectual would feel more ashamed of standing to attention during “God save the King” than of stealing from a poor box."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51157978-20c1-3f89-83db-4040ccaaff34",
                                        "entry_id": "a6b4e592-3b0a-3398-b1f7-bdbc408b48eb",
                                        "glosses": [
                                            "OK, right-on"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "698c6861-4d6c-4ccf-8ebb-b6424042f0c1",
                        "source_entry_id": "9b3a96d1-5f2c-354d-a5d9-720f45ac27cb",
                        "source_sense_id": "32f506d2-1a83-357a-841f-f8371ff6a310",
                        "source_sense_description": "ganz sicher, mit Bestimmtheit, ohne Zweifel",
                        "target_lang_word": "sans aucun doute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans aucun doute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cc1930a-a644-3cd3-b62d-eab299fd639b",
                                        "entry_id": "7a8e2231-a7a1-3399-b46d-952e9a4e0cdd",
                                        "glosses": [
                                            "Avec certitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bd9342d-b534-41cb-b18c-5366f0088878",
                                                "sense_id": "9cc1930a-a644-3cd3-b62d-eab299fd639b",
                                                "text": "C’est là, sans aucun doute, que près de cinquante navires anglais, danois et hollandais furent écrasés par les glaces en 1777."
                                            },
                                            {
                                                "example_id": "bf8edd0e-74ef-4d99-8fbe-1d547479f20c",
                                                "sense_id": "9cc1930a-a644-3cd3-b62d-eab299fd639b",
                                                "text": "Le plus ennuyeux pour les agriculteurs fut sans aucun doute le défaut d’essence et de ficelle pour les lieuses. On voyait ressortir les anciens matériels mis au rebut comme les javeleuses et les batteuses à tripot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3607da99-d330-41d6-9754-65ca61c64277",
                        "source_entry_id": "9b3a96d1-5f2c-354d-a5d9-720f45ac27cb",
                        "source_sense_id": "32f506d2-1a83-357a-841f-f8371ff6a310",
                        "source_sense_description": "ganz sicher, mit Bestimmtheit, ohne Zweifel",
                        "target_lang_word": "sans nul doute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans nul doute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24717cec-0249-3b25-9a59-44045172a2be",
                                        "entry_id": "d3efe178-b9eb-3325-aa6a-efda72e24713",
                                        "glosses": [
                                            "Avec certitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "861b8da7-10b1-417d-9bcb-d82b7e5ee902",
                                                "sense_id": "24717cec-0249-3b25-9a59-44045172a2be",
                                                "text": "Pour avoir quelque chance de tracer un tableau fidèle de la généalogie des Vers, il faudrait d'abord laisser de côté toutes les formes parasites, qui, sans nul doute, ont été produites par la dégénération de formes libres, plus élevées."
                                            },
                                            {
                                                "example_id": "07ab6f2a-f6ca-4f82-9876-1a84e4597f1f",
                                                "sense_id": "24717cec-0249-3b25-9a59-44045172a2be",
                                                "text": "Ce qui impliquait qu'il avait, sans nul doute comme je l'avais déjà pensé, une double vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cae1a11-d6eb-49c8-a6a5-1c5f2f44aee3",
                        "source_entry_id": "9b3a96d1-5f2c-354d-a5d9-720f45ac27cb",
                        "source_sense_id": "32f506d2-1a83-357a-841f-f8371ff6a310",
                        "source_sense_description": "ganz sicher, mit Bestimmtheit, ohne Zweifel",
                        "target_lang_word": "sans doute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans doute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc5d02d1-339b-3bd1-91e0-7d6ec0679bd8",
                                        "entry_id": "6d9bc456-caf3-3571-8926-60bc21328e5d",
                                        "glosses": [
                                            "Selon toutes les apparences ; probablement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcd9ecc8-295c-4b79-91fc-94a6e0ce2d54",
                                                "sense_id": "cc5d02d1-339b-3bd1-91e0-7d6ec0679bd8",
                                                "text": "[…], le chien s’était mis à rôder dans les environs, fouillant avidement les tas d’ordures, sans doute pour y déterrer un os ou quelque régal de ce genre."
                                            },
                                            {
                                                "example_id": "1e6383e5-535e-4163-a5b5-0ba9e45f1f74",
                                                "sense_id": "cc5d02d1-339b-3bd1-91e0-7d6ec0679bd8",
                                                "text": "Je me rendis avec les chefs militaires aux tentes de Si Saïd, où on nous servit une collation de dattes et de lait de chamelle, une vieille tradition nomade sans doute."
                                            },
                                            {
                                                "example_id": "5fef5551-4825-411f-9295-45688cec9d70",
                                                "sense_id": "cc5d02d1-339b-3bd1-91e0-7d6ec0679bd8",
                                                "text": "À l’encontre des autres routes d’Europe, celles du Royaume Uni n’avaient jamais été soumises à aucun essai organisé de redressement et d’aplanissement, et c’est à cela sans doute qu’il faut attribuer leur caractère pittoresque."
                                            },
                                            {
                                                "example_id": "5fd6b681-3d54-44e8-a0f8-d17718822a6a",
                                                "sense_id": "cc5d02d1-339b-3bd1-91e0-7d6ec0679bd8",
                                                "text": "Sous le porche, un boueux attendait l’arrivée de la voiture en songeant que, par un temps pareil, elle ne viendrait sans doute pas."
                                            },
                                            {
                                                "example_id": "ecce229d-e352-45a0-be0c-4ee8b8347718",
                                                "sense_id": "cc5d02d1-339b-3bd1-91e0-7d6ec0679bd8",
                                                "text": "Lo.... installait maintenant sur le sol une planche noire, suintante d’humidité, souillée et gluante des vomissures laissées sans doute par d’autres « clients »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "436e980c-5d19-3014-ae12-5036e3a202da",
                                        "entry_id": "6d9bc456-caf3-3571-8926-60bc21328e5d",
                                        "glosses": [
                                            "Assurément ; certes."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2517b02e-2aca-48cf-9740-1765763d38b6",
                                                "sense_id": "436e980c-5d19-3014-ae12-5036e3a202da",
                                                "text": "Sans doute, presque tout demeure à faire pour passer d’une symptomatique à une véritable étiologie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1bf3197-bb6b-4c7f-ab0b-59994f3fb273",
                        "source_entry_id": "9b3a96d1-5f2c-354d-a5d9-720f45ac27cb",
