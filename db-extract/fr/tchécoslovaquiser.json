                "senses": [
                    {
                        "sense_id": "6886c067-06e0-3c8b-9c1b-a513b69ab52d",
                        "entry_id": "dd801ecf-560a-3083-81bf-85d8d20cfdff",
                        "glosses": [
                            "Donner un caractère tchécoslovaque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d250eb5f-e51e-4e80-8f42-d1a4514932ae",
                                "sense_id": "6886c067-06e0-3c8b-9c1b-a513b69ab52d",
                                "text": "Les vrais pays dont la culture et la langue sont potentiellement menacées sont les petits, comme la Slovaquie, dont le pays a été \"Hongrisé\" durant des siècles et \"Tchécoslovaquisé\" (comprendre tchéquisé) pendant 75 ans."
                            },
                            {
                                "example_id": "b75cf7c6-d30c-4de2-a045-0573488c85a5",
                                "sense_id": "6886c067-06e0-3c8b-9c1b-a513b69ab52d",
                                "text": "L’administration va se « tchécoslovaquiser » d’autant plus vite que les nouvelles minorités ne sont pas fiables : leur nombre va y diminuer ;"
                            },
                            {
                                "example_id": "fdec663e-e0b6-4707-b6a5-57aa7e48d558",
                                "sense_id": "6886c067-06e0-3c8b-9c1b-a513b69ab52d",
                                "text": "Sinon, du côté sensuel (avec Simone pile au-dessus de ma petite culotte), je n'avais pas eu à me tchécoslovaquiser."
                            }
                        ]
                    }
                ],
