                        "form": "посошка́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3b8f1fc-f637-3be8-bf96-84da130ff3c7",
                        "entry_id": "d6bfc8c8-d404-33c7-96ee-418aca021dee",
                        "glosses": [
                            "уменьш. к посох"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85c4a193-2194-4446-872e-f67cab1e19fe",
                                "sense_id": "e3b8f1fc-f637-3be8-bf96-84da130ff3c7",
                                "text": "Пешком ходить мне в привычку. Взяв посошок, отправился я вперёд к почтовому стану."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bf669d2-dbcf-351f-914d-1601ccbbb2c0",
                        "entry_id": "d6bfc8c8-d404-33c7-96ee-418aca021dee",
                        "glosses": [
                            "перен., разг. последняя рюмка спиртного, выпиваемая перед уходом, на дорогу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf68728-0de1-434c-8790-8ed30abcda7b",
                                "sense_id": "7bf669d2-dbcf-351f-914d-1601ccbbb2c0",
                                "text": "— Посошок, однако, на дорожку позвольте взять, — прибавил он, наливая и выпивая рюмку водки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaa1fae8-3dfa-4e24-bfe5-2cd4ee4479d2",
                        "source_entry_id": "d6bfc8c8-d404-33c7-96ee-418aca021dee",
                        "source_sense_description": "посох",
                        "target_lang_word": "Absacker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absacker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23188764-6c9e-3a9f-ba8c-4e11feb819c2",
                                        "entry_id": "e58ac15d-bca5-3b82-8b06-975976ba151a",
                                        "glosses": [
                                            "letztes Glas eines alkoholischen Getränks, das im Anschluss an ein Beisammensein (oder vor dem Schlafengehen) zu sich genommen wird"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a507eaa-9000-443f-a483-53d1d95e2bf5",
                                                "sense_id": "23188764-6c9e-3a9f-ba8c-4e11feb819c2",
                                                "text": "Ich brachte Björn nach der Party nach Hause und wir tranken noch einen Absacker."
                                            },
                                            {
                                                "example_id": "6a7a432e-1bec-4ec3-b080-0405bde0bbba",
                                                "sense_id": "23188764-6c9e-3a9f-ba8c-4e11feb819c2",
                                                "text": "„Magst du noch einen Absacker mit mir trinken?“"
                                            },
                                            {
                                                "example_id": "c56686b2-974d-423f-b0f8-e3bd039233ad",
                                                "sense_id": "23188764-6c9e-3a9f-ba8c-4e11feb819c2",
                                                "text": "Sie gehen auf einen Absacker in eine Bar."
                                            },
                                            {
                                                "example_id": "0c2d84c3-78b1-416b-9f50-1025f5e1f0b4",
                                                "sense_id": "23188764-6c9e-3a9f-ba8c-4e11feb819c2",
                                                "text": "„Es war Abend, und Geschäftsleute aus England und Deutschland ließen hier bei einem Absacker eine Tagung ausklingen.“"
                                            },
                                            {
                                                "example_id": "37aa5a23-b416-4afe-a627-1a1fdd1ee325",
                                                "sense_id": "23188764-6c9e-3a9f-ba8c-4e11feb819c2",
                                                "text": "„Nach seinem auffallenden Auftritt in der Bar hat ihm der Keeper später beim Absacker etwas von dubiosen Geschäften erzählt.“"
                                            },
                                            {
                                                "example_id": "81953f86-7a13-4011-9f84-1abcc62714da",
                                                "sense_id": "23188764-6c9e-3a9f-ba8c-4e11feb819c2",
                                                "text": "„In der Hotellobby schlägt Vicky einen Absacker auf der Dachterrasse vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4ca9862-b846-3f8e-b258-acdd177516c2",
                                        "entry_id": "e58ac15d-bca5-3b82-8b06-975976ba151a",
                                        "glosses": [
                                            "Schnaps, der nach dem Essen getrunken wird"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd11a83d-aeb9-4341-bb68-d20f8481c825",
                                                "sense_id": "e4ca9862-b846-3f8e-b258-acdd177516c2",
                                                "text": "An Heiligabend bekam Onkel Willi von Oma ein ganz edles Tröpfchen als Absacker."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
