                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9178131f-a29b-438a-9fe7-e9de9a099351",
                                "sense_id": "c2efb751-ee7d-304b-8798-63f5f4fb000d",
                                "text": "„Ein paar Umdrehungen schneller, strebten wir unserem Wohnschiff zu.“"
                            },
                            {
                                "example_id": "0dbd07cd-6374-40d5-b13d-c0567cc38f8b",
                                "sense_id": "c2efb751-ee7d-304b-8798-63f5f4fb000d",
                                "text": "„Das Urlauberschiff war Wohnschiff für über tausend uniform gekleidete Turner und Turnerinnen, unter ihnen Maiden vom Arbeitsdienst, die Nationalmannschaft der Reckturner, aber auch alte Herren, die immer noch am Barren turnten, sowie Gymnastikgruppen der Gemeinschaft »Glaube und Schönheit« und viele auf stadionweites Massenturnen gedrillte Kinder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
