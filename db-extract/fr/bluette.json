        "fr-extract.jsonl": [
            {
                "entry_id": "5f3f0b71-301e-304d-affb-d783bfcecbbc",
                "word": "bluette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d25a10f0-e32d-4fc9-85bd-32d8459bbd46",
                        "entry_id": "5f3f0b71-301e-304d-affb-d783bfcecbbc",
                        "tags": [
                            "plural"
                        ],
                        "form": "bluettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "306abea1-e34a-3357-b66a-54740de9a401",
                        "entry_id": "5f3f0b71-301e-304d-affb-d783bfcecbbc",
                        "glosses": [
                            "Faible étincelle."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "89f8b72b-f358-4932-a36e-f4435c0cd186",
                                "sense_id": "306abea1-e34a-3357-b66a-54740de9a401",
                                "text": "C'est proprement la bluette que vous voyez, pâle et faible, luire, et s'évanouir presque aussitôt, sans produire ordinairement d'autre effet, sans laisser aucune trace sensible d'elle-même, lorsque vous cherchez du feu sous la cendre pour le rallumer; […]."
                            },
                            {
                                "example_id": "a983e86b-4c7a-4272-b5e2-57fd78b91ff7",
                                "sense_id": "306abea1-e34a-3357-b66a-54740de9a401",
                                "text": "Et le grillon s’était endormi, dès que la dernière bluette avait éteint sa dernière lueur dans la cendre de la cheminée."
                            },
                            {
                                "example_id": "edc948ed-b02f-430e-8e13-54cd4407b5d2",
                                "sense_id": "306abea1-e34a-3357-b66a-54740de9a401",
                                "text": "Le froid avait repris, un froid sec qui faisait pétiller et crépiter les bûches enflammées avec de capricieuses étincelles et des bluettes qui tombaient sur le plancher où les écrasait une botte indolente."
                            }
                        ]
                    },
                    {
                        "sense_id": "81fd74bf-690a-3cf8-92fb-c03a4bc389fc",
                        "entry_id": "5f3f0b71-301e-304d-affb-d783bfcecbbc",
                        "glosses": [
                            "Trait d’esprit plus brillant que juste."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "db3adeca-9d70-4fd5-883a-f6492cf366e6",
                                "sense_id": "81fd74bf-690a-3cf8-92fb-c03a4bc389fc",
                                "text": "Nous avons des Pièces modernes qui n'empruntent point leur mérite des bluettes d'esprit, mais de la justesse de l’intrigue & de la vérité des caractères , qui forment un vrai comique digne de Molière."
                            }
                        ]
                    },
                    {
                        "sense_id": "befa8160-0b5f-3d52-8a4a-de00c08e6e65",
                        "entry_id": "5f3f0b71-301e-304d-affb-d783bfcecbbc",
                        "glosses": [
                            "Petit ouvrage ; ouvrage sans prétention ; badinage d’esprit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fd858acf-e6cf-45c1-98dd-b115851690f9",
                                "sense_id": "befa8160-0b5f-3d52-8a4a-de00c08e6e65",
                                "text": "Cette comédie n'est qu'une bluette ; mais elle est très-agréable, & a eu du succès; le but moral en est bon, & plus d'une bourgeoise pourroit profiter de la leçon qu'elle renferme."
                            },
                            {
                                "example_id": "9184545d-8ff9-4f8a-91a8-3bb70720efd3",
                                "sense_id": "befa8160-0b5f-3d52-8a4a-de00c08e6e65",
                                "text": "L'histoire remontait à plusieurs années, mais tous continuaient de me brocarder à propos de bluettes que j'avais écrites avant de la rencontrer."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b8d88ff-49db-313c-bfe9-fb20e3237da9",
                        "entry_id": "5f3f0b71-301e-304d-affb-d783bfcecbbc",
                        "glosses": [
                            "Sentiment amoureux sans durée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b03135ce-9eff-4ee1-a595-02d58846b890",
                                "sense_id": "9b8d88ff-49db-313c-bfe9-fb20e3237da9",
                                "text": "Ne faites pas attention à toutes ces bluettes et toutes ces vapeurs."
                            },
                            {
                                "example_id": "19f42261-0b9b-493e-8677-cb0cc39fbea3",
                                "sense_id": "9b8d88ff-49db-313c-bfe9-fb20e3237da9",
                                "text": "Ces bluettes avaient-elles compté pour des clous ? A vingt ans — nous qui avions encore moins à l'époque — l'amour est niais, dit-on."
                            },
                            {
                                "example_id": "1b9da27d-67e7-429f-a9bb-39b125dc5a11",
                                "sense_id": "9b8d88ff-49db-313c-bfe9-fb20e3237da9",
                                "text": "C'était une bluette du jeune temps. Une amourette bien innocente que la nôtre. Voilà le maximum de l'étreinte pédérastique auquel nous sommes parvenus :\n Un piano pour l'accompagnement.\n Un violoncelle.\n Et le susurrement d'un violon."
                            }
                        ]
                    },
                    {
                        "sense_id": "875335ac-1ff7-3613-8195-560fbc4446d0",
                        "entry_id": "5f3f0b71-301e-304d-affb-d783bfcecbbc",
                        "glosses": [
                            "Chanson légère qui fait rêver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "956001b9-aca3-465e-a304-d984f865e62b",
                                "sense_id": "875335ac-1ff7-3613-8195-560fbc4446d0",
                                "text": "Je crus reconnaître Over the Rainbow, la chanson qu'interprétait Judy Gardland dans Le Magicien d'Oz. Jusqu'alors, je ne m'étais jamais vraiment penché sur cette bluette qui parlait d'espoir, de renaissance, d'amour, d'un certain idéal auquel on aspire tous au sortir de l'adolescence."
                            },
                            {
                                "example_id": "92e66068-cc5b-4e39-af61-a74f6734b080",
                                "sense_id": "875335ac-1ff7-3613-8195-560fbc4446d0",
                                "text": "Sous le cerisier le plus proche, Rinri me chanta des bluettes. Je ris, il prit la mouche :\n— Je pense ce que je chante."
                            }
                        ]
                    }
                ],
