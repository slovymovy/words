                "senses": [
                    {
                        "sense_id": "90dbb49a-2d26-341d-93b2-f8a52822d099",
                        "entry_id": "bc89de26-0c29-330e-aa9c-45bb46982d22",
                        "glosses": [
                            "aus Leder bestehende Hose; aus Leder gefertigte Hose"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76db6f1e-3e4f-4531-b8f3-0ff834c0b082",
                                "sense_id": "90dbb49a-2d26-341d-93b2-f8a52822d099",
                                "text": "Lederhosen sind sehr strapazierfähig."
                            },
                            {
                                "example_id": "22e36a93-a83f-4118-aa3c-e790c3a4d396",
                                "sense_id": "90dbb49a-2d26-341d-93b2-f8a52822d099",
                                "text": "„Zieht den Bayern die Lederhosen aus, Lederhosen aus - zieht den Bayern die Lederhosen aus, Lederhosen aus - …“ (hämischer Sprechgesang gegnerischer Fans in deutschen Stadien, wenn die Profi-Mannschaft des Fußballvereins FC Bayern München ein Spiel verliert)"
                            },
                            {
                                "example_id": "b700e1f3-4685-4607-9169-cca82978aaec",
                                "sense_id": "90dbb49a-2d26-341d-93b2-f8a52822d099",
                                "text": "„Ich sollte was dazu sagen, und ich sagte, daß ich meine Lederhose nicht leiden mochte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
