                ],
                "senses": [
                    {
                        "sense_id": "716d7920-4320-3b9f-bd04-40f4bf73b1d8",
                        "entry_id": "e49d45c2-e390-3007-8ab2-bcd2230da9fc",
                        "glosses": [
                            "an eine Pyramide erinnernd, wie eine Pyramide aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "993b4bf3-019f-4924-8c53-3139bc76ead1",
                                "sense_id": "716d7920-4320-3b9f-bd04-40f4bf73b1d8",
                                "text": "„Es war eine riesige Krabbe, und anstelle eines Kopfes hatte es viele pyramidenartig angeordnete Ringe oder Knoten aus einer dicken, zähen Fleischmasse, bedeckt mit Fühlern.“"
                            },
                            {
                                "example_id": "bd7d2fa2-03cf-471a-9b36-b9f27127122f",
                                "sense_id": "716d7920-4320-3b9f-bd04-40f4bf73b1d8",
                                "text": "„Einmal schien es ihm für einen Moment, als nehme er weit entfernt mitten im Wald ein seltsames graues, pyramidenartiges Gebilde wahr, da verschwand es auch schon wieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
