                            "participle",
                            "active",
                            "past"
                        ],
                        "form": "прижа́вшийся"
                    },
                    {
                        "form_id": "0da78dce-3ff6-41a6-8f9c-58fe56fdf0ee",
                        "entry_id": "321029dc-76d3-37c7-a8cf-e6f4d9595706",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "прижа́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e41a1f1-30cf-3ab8-b14f-a660c00babb9",
                        "entry_id": "321029dc-76d3-37c7-a8cf-e6f4d9595706",
                        "glosses": [
                            "тесно, плотно прислониться к кому-либо или к чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee322e22-f20a-4ce8-b08c-5fa9b7483aef",
                                "sense_id": "9e41a1f1-30cf-3ab8-b14f-a660c00babb9",
                                "text": "И щека её прижалась к моей, и я почувствовал на лице моём её пламенное дыхание."
                            },
                            {
                                "example_id": "5eee0dac-f72f-48e6-a900-a073ad10f430",
                                "sense_id": "9e41a1f1-30cf-3ab8-b14f-a660c00babb9",
                                "text": "Торвальдсен снял шляпу, стал на колени у тела Кипренского и прижался лбом к его свисавшей с постели руке."
                            },
                            {
                                "example_id": "87c07083-a3c3-4a7e-bd14-2667ef2397f4",
                                "sense_id": "9e41a1f1-30cf-3ab8-b14f-a660c00babb9",
                                "text": "Солдаты спали на земле на ёлочном лапнике, тесно прижавшись друг к другу."
                            },
                            {
                                "example_id": "18612749-5c34-44ed-b48e-bc5e9f14d08c",
                                "sense_id": "9e41a1f1-30cf-3ab8-b14f-a660c00babb9",
                                "text": "Под ветром бурьян в степи весь полёг, прижавшись к земле, еле шевеля иссохшими пальчиками."
                            },
                            {
                                "example_id": "81c1a99d-ceee-4186-be71-41f7970b8047",
                                "sense_id": "9e41a1f1-30cf-3ab8-b14f-a660c00babb9",
                                "text": "Я прижался к стенке и независимо сунул руку в карман."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d69341d-4d11-4d2b-b31d-e78cfe17e13c",
                        "source_entry_id": "321029dc-76d3-37c7-a8cf-e6f4d9595706",
                        "source_sense_id": "9e41a1f1-30cf-3ab8-b14f-a660c00babb9",
