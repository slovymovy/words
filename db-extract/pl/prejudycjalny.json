                    },
                    {
                        "translation_id": "588781b1-c2aa-4a34-9f0d-e8d33af708e3",
                        "source_entry_id": "c1ecd27f-63fb-3045-bb02-bd4bb102b736",
                        "source_sense_id": "7efd00fd-f11d-36f3-adf8-1cb4c50e5dd9",
                        "target_lang_word": "präjudiziell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "präjudiziell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15df00e5-6e88-3cec-9b5f-0d5a692ef341",
                                        "entry_id": "877cfd8c-776a-3ac3-94e0-5df21e2783c5",
                                        "glosses": [
                                            "als Gerichtsentscheidung dienend, die für künftige, gleichartige Fälle richtungsweisend ist"
                                        ],
                                        "tags": [
                                            "Rechtswissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc5da0dc-b7ab-4536-906f-3887895063bd",
                                                "sense_id": "15df00e5-6e88-3cec-9b5f-0d5a692ef341",
                                                "text": "„Sie ist daher notwendige Vorfrage und damit präjudiziell für jede Klage, mit der die übergeleitete Forderung geltend gemacht wird.“"
                                            },
                                            {
                                                "example_id": "01542a5f-14b4-4ed7-bcf3-3886e87f6760",
                                                "sense_id": "15df00e5-6e88-3cec-9b5f-0d5a692ef341",
                                                "text": "„In diesem Fall ist die frühere rechtskräftige Feststellung für das spätere Urteil entscheidungserheblich (präjudiziell) und ungeprüft zu übernehmen.“"
                                            },
                                            {
                                                "example_id": "7727009b-3f3e-4574-98d9-483f35a22f45",
                                                "sense_id": "15df00e5-6e88-3cec-9b5f-0d5a692ef341",
                                                "text": "„Das Bestehen der vertraglichen Unterlassungsverpflichtung ist präjudiziell für die Schadensersatzpflicht wegen Verletzung der vertraglichen Unterlassungspflicht.“"
                                            },
                                            {
                                                "example_id": "40285bb8-bb4e-423c-a3e8-ba9e7fff2eaf",
                                                "sense_id": "15df00e5-6e88-3cec-9b5f-0d5a692ef341",
                                                "text": "„Üblicherweise entscheiden Gerichte stärker kasuistisch, also präjudiziell und weniger abstraktgenerell als das Bundesverfassungsgericht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6b71227-7b2a-357f-babd-84afe5476c4a",
                                        "entry_id": "877cfd8c-776a-3ac3-94e0-5df21e2783c5",
                                        "glosses": [
                                            "für die Beurteilung späterer Fälle oder Entscheidungen von Bedeutung"
                                        ],
