                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "71e00f17-c6a6-4a59-866c-9bc2248d08ae",
                        "source_entry_id": "a62f0192-b059-3b74-b83e-64acb82cdb4f",
                        "source_sense_id": "5ae2c159-7b36-387b-bfa2-46f7ae53eca8",
                        "source_sense_description": "(meist hölzerner) Löffel mit einem langen Stiel, mit dem Speisen bei der Zubereitung umgerührt werden",
                        "target_lang_word": "wooden spoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wooden spoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "780911a2-2c69-3c73-825c-7174711db375",
                                        "entry_id": "9c8a31aa-d466-3fee-bc34-4fcec195f579",
                                        "glosses": [
                                            "A spoon made from wood, commonly used in food preparation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c6a9679-e01d-3788-9795-b1bb2a7e62b3",
                                        "entry_id": "9c8a31aa-d466-3fee-bc34-4fcec195f579",
                                        "glosses": [
                                            "An ironic prize for finishing last in a competition."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d44fd61c-943f-4c7c-b944-ec0a4ec00161",
                                                "sense_id": "6c6a9679-e01d-3788-9795-b1bb2a7e62b3",
                                                "text": "Earnestly bent upon fulfilling the weighty, nay solemn, responsibilities of his office at all hazard, even at the risk of so far neglecting his parliamentary duties as to appear upon the division-list less frequently than any of his colleagues, Sir John Pakington wore the wooden spoon at the whitebait dinner, though with an air of waggery — almost as a decoration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487a742e-c957-38e2-861a-77a17e3d74ec",
                                        "entry_id": "9c8a31aa-d466-3fee-bc34-4fcec195f579",
                                        "glosses": [
                                            "The last junior optime who takes a university degree."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e749943-7a7d-4e12-b0a6-73d198c593ec",
                                                "sense_id": "487a742e-c957-38e2-861a-77a17e3d74ec",
                                                "text": "We submit that a wooden spoon of our day would not be justified in calling Galileo and Napier blockheads because they never heard of the differential calculus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be55e4f8-08e2-3a8b-b5ba-5a1b5d5cc7c8",
                                        "entry_id": "9c8a31aa-d466-3fee-bc34-4fcec195f579",
                                        "glosses": [
                                            "The lowest appointee of the junior year; sometimes, one especially popular in his class, without reference to scholarship. Formerly, it was a custom for classmates to present to this person a wooden spoon with formal ceremonies."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
