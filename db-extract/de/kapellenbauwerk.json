                "senses": [
                    {
                        "sense_id": "a4e16587-65d2-3bc2-bbb2-7561b3a1a888",
                        "entry_id": "5b72338e-2906-36ba-9e45-3c4c8fcbb00a",
                        "glosses": [
                            "von Menschen gebautes, ortsfestes Gotteshaus, das durch seine architektonische Gestaltung ein größerer, bedeutender Kapellenbau ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a20f6c03-d0c8-490d-9049-2b1b2c24b98a",
                                "sense_id": "a4e16587-65d2-3bc2-bbb2-7561b3a1a888",
                                "text": "Auch die kleine Waldkapelle ist ein Kapellenbauwerk, das gebaut werden muss."
                            },
                            {
                                "example_id": "91dabe40-7cda-46e7-9f1a-f0f182f35879",
                                "sense_id": "a4e16587-65d2-3bc2-bbb2-7561b3a1a888",
                                "text": "„Das schützende Kapellenbauwerk wurde 1756 vom Steinmetz Anton Obermayer errichtet.“"
                            },
                            {
                                "example_id": "e9d0d633-5356-46cc-ba5f-4870cdcacb1e",
                                "sense_id": "a4e16587-65d2-3bc2-bbb2-7561b3a1a888",
                                "text": "„Während der schon gegründete Verein \"Kapelle Schindelberg\" das rund sieben Ar große Terrain in Erbpacht übernimmt, wollen dessen Vorsitzender Albert Günther und die weiteren Mitglieder das Kapellenbauwerk mit Unterstützung örtlicher Handwerker bis zum Herbst ausschließlich in Eigenleistung erstellen.“"
                            },
                            {
                                "example_id": "1243d744-d331-471c-aa17-ffc545eae25d",
                                "sense_id": "a4e16587-65d2-3bc2-bbb2-7561b3a1a888",
                                "text": "„Ein anmutiges, lichtes, sehr harmonisches und äußert gelungenes neugotisches Kapellenbauwerk steht hier unmittelbar vor dem Betrachter.“"
                            },
                            {
                                "example_id": "a875836a-bebe-4afa-b732-12bf69fcb8dc",
                                "sense_id": "a4e16587-65d2-3bc2-bbb2-7561b3a1a888",
                                "text": "Die Sixtinische Kapelle in Dresden ist ein Kapellenbauwerk, das einer Papstkapelle gleichkommt und herausragend ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
