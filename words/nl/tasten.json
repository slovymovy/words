{
    "word_family": [
        "tast",
        "tastbaar",
        "tasting",
        "tastzin",
        "betasten",
        "aantasten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ff1edec-a101-3247-ac05-e9ae4aff8265",
                    "sense_definition": "waarnemen door aanraking, meestal met een of beide handen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysiek_voelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het donker <w>tastte</w> hij naar de lichtknop op de muur.",
                            "target_lang_translations": {
                                "en": "In the dark, he <w>groped</w> for the light switch on the wall."
                            }
                        },
                        {
                            "text": "Zij <w>tastte</w> voorzichtig in haar tas om haar sleutels te vinden.",
                            "target_lang_translations": {
                                "en": "She <w>felt</w> carefully in her bag to find her keys."
                            }
                        }
                    ],
                    "synonyms": [
                        "voelen",
                        "betasten"
                    ],
                    "common_phrases": [
                        "naar iets tasten"
                    ],
                    "target_lang_definitions": {
                        "en": "to perceive by touch, usually with one or both hands"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grope",
                                "target_lang_sense_clarification": "searching for something with the hands in the dark"
                            },
                            {
                                "target_lang_word": "feel",
                                "target_lang_sense_clarification": "using the sense of touch to find or identify something"
                            },
                            {
                                "target_lang_word": "fumble",
                                "target_lang_sense_clarification": "searching clumsily with the hands"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c98e2b92-c311-38a7-8870-ce0935c33b19",
                    "sense_definition": "in onzekerheid naar iets zoeken of proberen te begrijpen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onzekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie <w>tast</w> nog volledig in het duister over het motief.",
                            "target_lang_translations": {
                                "en": "The police are still completely <w>in the dark</w> about the motive."
                            }
                        },
                        {
                            "text": "Zonder duidelijke instructies <w>tasten</w> de werknemers in het duister.",
                            "target_lang_translations": {
                                "en": "Without clear instructions, the employees are <w>groping</w> in the dark."
                            }
                        }
                    ],
                    "synonyms": [
                        "zoeken"
                    ],
                    "common_phrases": [
                        "in het duister tasten"
                    ],
                    "target_lang_definitions": {
                        "en": "to search for something or try to understand it while in a state of uncertainty"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be in the dark",
                                "target_lang_sense_clarification": "to have no idea or information about a situation"
                            },
                            {
                                "target_lang_word": "grope",
                                "target_lang_sense_clarification": "to search uncertainly for a solution or meaning"
                            },
                            {
                                "target_lang_word": "fumble",
                                "target_lang_sense_clarification": "to act or search in an awkward or uncertain way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad418dfa-9c5c-3896-98e6-f0431ab74a14",
                    "sense_definition": "op een negatieve manier beïnvloeden of schade toebrengen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "beinvloeden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze nieuwe maatregelen <w>tasten</w> de privacy van de burgers aan.",
                            "target_lang_translations": {
                                "en": "These new measures <w>infringe on</w> the privacy of the citizens."
                            }
                        },
                        {
                            "text": "De zure regen <w>tast</w> de gezondheid van de bossen aan.",
                            "target_lang_translations": {
                                "en": "Acid rain <w>damages</w> the health of the forests."
                            }
                        }
                    ],
                    "synonyms": [
                        "aantasten",
                        "beschadigen",
                        "raken"
                    ],
                    "antonyms": [
                        "versterken"
                    ],
                    "common_phrases": [
                        "de privacy tasten"
                    ],
                    "target_lang_definitions": {
                        "en": "to influence in a negative way or to cause damage"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "affect",
                                "target_lang_sense_clarification": "to have a negative impact on something"
                            },
                            {
                                "target_lang_word": "damage",
                                "target_lang_sense_clarification": "to cause physical or abstract harm"
                            },
                            {
                                "target_lang_word": "infringe on",
                                "target_lang_sense_clarification": "to limit or undermine rights or privacy"
                            },
                            {
                                "target_lang_word": "corrode",
                                "target_lang_sense_clarification": "to slowly destroy or weaken something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33c259df-a3c5-3688-a358-8a5c9d741b1a",
                    "sense_definition": "iets bemerken of bespeuren zonder het rechtstreeks waar te nemen",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intuïtie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kon de spanning in de kamer bijna voelen en <w>tasten</w>.",
                            "target_lang_translations": {
                                "en": "You could almost feel and <w>sense</w> the tension in the room."
                            }
                        },
                        {
                            "text": "Hij kon een leugen voelen en <w>tasten</w> nog voordat er gesproken werd.",
                            "target_lang_translations": {
                                "en": "He could feel and <w>perceive</w> a lie even before a word was spoken."
                            }
                        }
                    ],
                    "synonyms": [
                        "bespeuren",
                        "bemerken"
                    ],
                    "common_phrases": [
                        "voelen en tasten"
                    ],
                    "target_lang_definitions": {
                        "en": "to notice or sense something without perceiving it directly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sense",
                                "target_lang_sense_clarification": "to feel or perceive something intuitively"
                            },
                            {
                                "target_lang_word": "feel",
                                "target_lang_sense_clarification": "to have a vague mental impression of an atmosphere"
                            },
                            {
                                "target_lang_word": "perceive",
                                "target_lang_sense_clarification": "to become aware of something through intuition"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}