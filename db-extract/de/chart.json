                                    }
                                ]
                            },
                            {
                                "target_word": "chart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abe9c81b-d03b-34b1-bedb-9420a8ccd7c9",
                                        "entry_id": "d9427602-d16d-35b5-ad2a-db22be66e422",
                                        "glosses": [
                                            "To draw a chart or map of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "042099b9-5ba6-4251-bf46-79e74eb73c03",
                                                "sense_id": "abe9c81b-d03b-34b1-bedb-9420a8ccd7c9",
                                                "text": "chart the seas"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f914089a-dff8-360c-be8f-88b935a8838e",
                                        "entry_id": "d9427602-d16d-35b5-ad2a-db22be66e422",
                                        "glosses": [
                                            "To draw or figure out (a route or plan)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "464b84e1-c3ad-4598-b319-0ef9dfc015a8",
                                                "sense_id": "f914089a-dff8-360c-be8f-88b935a8838e",
                                                "text": "Let's chart how we're going to get from here to there."
                                            },
                                            {
                                                "example_id": "95bc42bf-3173-4c53-bb04-e6f566236c0e",
                                                "sense_id": "f914089a-dff8-360c-be8f-88b935a8838e",
                                                "text": "We are on a course for disaster without having charted it."
                                            },
                                            {
                                                "example_id": "d0e5c6c1-a599-414b-b660-4807500cb704",
                                                "sense_id": "f914089a-dff8-360c-be8f-88b935a8838e",
                                                "text": "The men in \"Homo,\" (and even perhaps Haynes himself) are not looking for acceptance or validation, but a way to chart their own notions of self-determination in a world that makes little sense and offers even less comfort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52f12717-90fb-36d1-8c82-e87934000d14",
                                        "entry_id": "d9427602-d16d-35b5-ad2a-db22be66e422",
                                        "glosses": [
                                            "To record systematically."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d347466b-2f1a-3061-a3f9-42fe102930f6",
                                        "entry_id": "d9427602-d16d-35b5-ad2a-db22be66e422",
                                        "glosses": [
                                            "To record systematically.",
                                            "To enter (medical information) into a medical record."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e479511-ea45-4a28-8246-a20de743312c",
                                                "sense_id": "d347466b-2f1a-3061-a3f9-42fe102930f6",
                                                "text": "Did you chart the urine output yet?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4c5a646-1208-3c5f-b880-1b711c5b8b81",
                                        "entry_id": "d9427602-d16d-35b5-ad2a-db22be66e422",
                                        "glosses": [
                                            "To appear on a hit-recording chart."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "560eb2d3-c9fd-4c92-b159-4fdf5658c043",
                                                "sense_id": "c4c5a646-1208-3c5f-b880-1b711c5b8b81",
                                                "text": "The song has charted for 15 weeks!"
                                            },
                                            {
                                                "example_id": "4d5df93c-b6c0-4e6f-b5ed-7e1de22fbd8e",
                                                "sense_id": "c4c5a646-1208-3c5f-b880-1b711c5b8b81",
                                                "text": "The band first charted in 1994."
                                            }
