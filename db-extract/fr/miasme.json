                                    },
                                    {
                                        "sense_id": "f8a8e47a-e176-36d6-972c-7a10892d103b",
                                        "entry_id": "43723d6e-cf95-3638-abf7-73e938376154",
                                        "glosses": [
                                            "A noxious atmosphere or influence, an ominous environment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
