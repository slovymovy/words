                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7c56ff93-7393-4210-b397-10c015852808",
                        "entry_id": "88489ac0-b3cf-3b3f-b7ec-6c6109c78e1a",
