                                "example_id": "3c663888-ad13-419d-b7ae-e3dbd0332752",
                                "sense_id": "24cd3536-07f5-3454-97e7-eb57ee63d79b",
                                "text": "Les Centres d’Accueil de Demandeurs d’Asile (CADA) offrent aux demandeurs d’asile un lieu d’accueil pour toute la durée de l’étude de leur dossier de demande de statut de réfugié."
                            }
                        ]
                    }
