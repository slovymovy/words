                "senses": [
                    {
                        "sense_id": "05e08696-2618-3dff-8f1b-b0ec4cd91eab",
                        "entry_id": "9f9fd139-0354-35d7-acaa-db65fab4fe52",
                        "glosses": [
                            "Of the colour of ink, especially black ink; dark."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c6ccec2-b56c-4557-b500-c722b5335ba8",
                                "sense_id": "05e08696-2618-3dff-8f1b-b0ec4cd91eab",
                                "text": "One black and gusty night, when the moon was down and the inky clouds swept fiercely overhead through the starless void; when the cruel wind raged and tore, and the sleety rain came swirlingly, drivingly down […]"
                            },
                            {
                                "example_id": "99a9aba7-57c9-451b-84dc-e52ea36c38a4",
                                "sense_id": "05e08696-2618-3dff-8f1b-b0ec4cd91eab",
                                "text": "Tenderly she bore him back through the inky jungle to where the tribe lay, and for many days and nights she sat guard beside him, bringing him food and water, and brushing the flies and other insects from his cruel wounds."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0047564-b3d1-3e0c-8d8b-21e67460133f",
                        "entry_id": "9f9fd139-0354-35d7-acaa-db65fab4fe52",
                        "glosses": [
                            "Spattered or stained with ink."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4eedaf9c-1ed9-3991-a236-77ac2566b1bd",
                        "entry_id": "9f9fd139-0354-35d7-acaa-db65fab4fe52",
                        "glosses": [
                            "Dark-skinned; black."
                        ],
                        "tags": [
                            "literary",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c1419275-1a53-459e-b6a8-8adaaccfb1cc",
                                "sense_id": "4eedaf9c-1ed9-3991-a236-77ac2566b1bd",
                                "text": "The gloved and jewelled bards who sing / Of Pippa, Maud, and Guinevere, / Have hardly done the 'handsome thing' / For you, my inky Cytherea."
                            }
                        ]
                    }
                ],
                "translations": [
