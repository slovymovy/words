                "senses": [
                    {
                        "sense_id": "b29f15ea-f831-32e4-ba7d-f4e4699f2aed",
                        "entry_id": "34952e92-6095-3b8f-9944-d27bcf1df533",
                        "glosses": [
                            "Kraftwerk zur Energieerzeugung durch Kernfusion (Verschmelzung von Atomkernen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0230237d-0823-4ba4-a205-cd6909ed77ec",
                                "sense_id": "b29f15ea-f831-32e4-ba7d-f4e4699f2aed",
                                "text": "„Und erst ab 2050 würden dann die ersten kommerziellen Fusionskraftwerke ans Netz gehen.“"
                            },
                            {
                                "example_id": "28047d2c-f612-4e1c-a9d6-f3d2a2abf9a8",
                                "sense_id": "b29f15ea-f831-32e4-ba7d-f4e4699f2aed",
                                "text": "Einige reden von der „Fusionskonstante“ und spotten damit darüber, dass schon seit Jahrzehnten für jeweils in 30—40 Jahren, immer von der Gegenwart an gerechnet, die technische Machbarkeit von Fusionskraftwerken versprochen wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
