                "senses": [
                    {
                        "sense_id": "28aa6b3f-e8a8-3cff-84e0-7b37ab5d046b",
                        "entry_id": "7f0f7ea9-ff5f-3ced-b1b5-9561f0b2c3d1",
                        "glosses": [
                            "Oberfläche, die dazu dient, dass etwas oder jemand darauf arbeiten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "434067c3-113b-4817-9348-43e95004cf24",
                                "sense_id": "28aa6b3f-e8a8-3cff-84e0-7b37ab5d046b",
                                "text": "„Bergkristalle könnten als chemische Arbeitsoberfläche gedient haben, die die Bildung großer Moleküle ermöglichte.“"
                            },
                            {
                                "example_id": "a4c9767c-c377-4043-b0b7-df506902b08b",
                                "sense_id": "28aa6b3f-e8a8-3cff-84e0-7b37ab5d046b",
                                "text": "„Facebook, die von allen Kindern dieser Erde geteilte Arbeitsoberfläche, meinte, durch die gleiche Form – das weiße f auf blauem Untergrund – nun endlich das Problem der mangelnden Empathie zu lösen.“"
                            },
                            {
                                "example_id": "497edef2-e32d-4bf4-9111-20734683177d",
                                "sense_id": "28aa6b3f-e8a8-3cff-84e0-7b37ab5d046b",
                                "text": "„[…] Die Verkäuferin zeigt auf den Marmorboden: 15.000 Dollar. Die Granit-Arbeitsoberfläche: 1300 Dollar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
