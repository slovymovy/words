                                                "text": "a pointless sword"
                                            },
                                            {
                                                "example_id": "bf49642f-8bd3-409d-9560-799631080868",
                                                "sense_id": "3842e9c3-5022-3c8a-af3b-7a1c4df7fb19",
                                                "text": "a pointless knife"
