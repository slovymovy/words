{
    "word_family": [
        "defeat",
        "defeated",
        "defeater"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "553ac83d-a165-39a0-8a44-832748c5ba3e",
                    "sense_definition": "The tendency to accept defeat or failure easily without trying to succeed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>defeatism</w> made it difficult for the rest of the team to stay motivated.",
                            "target_lang_translations": {
                                "zh": "他一贯的<w>失败主义</w>情绪让团队里的其他人很难保持动力。"
                            }
                        },
                        {
                            "text": "We must overcome this sense of <w>defeatism</w> if we want to achieve our goals this year.",
                            "target_lang_translations": {
                                "zh": "如果我们想在今年实现目标，就必须克服这种<w>失败主义</w>心态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pessimism",
                        "hopelessness",
                        "resignation"
                    ],
                    "antonyms": [
                        "optimism",
                        "determination"
                    ],
                    "target_lang_definitions": {
                        "zh": "指轻易接受失败或挫折，不愿努力争取成功的消极心态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "失败主义",
                                "target_lang_sense_clarification": "指在困难面前丧失信心、轻易放弃的消极思想。"
                            },
                            {
                                "target_lang_word": "消极心态",
                                "target_lang_sense_clarification": "指对事物发展持悲观、不抱希望的态度。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}