                                                "sense_id": "17112eaa-26b9-3803-b726-63535e4d17df",
                                                "text": "Where the waves wish-wash, and the foghorn blows, And the blowfish nibble at your toes - oes - oes, The blowfish nibble at your toes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a302c865-95d3-3b5b-a99b-95730084487e",
                                        "entry_id": "16418926-897a-3b76-abbc-dcf8c355eeb5",
                                        "glosses": [
                                            "A delicacy popular in Japan, consisting of the fish served raw as sushi or perhaps fried. It may, if improperly prepared, contain considerably deadly levels of neurotoxins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "633f33b8-1709-4958-8560-9c3ae80b40e4",
                                                "sense_id": "a302c865-95d3-3b5b-a99b-95730084487e",
                                                "text": "Fugu, the blowfish or globefish, offers taste, health and adventure in every bite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
