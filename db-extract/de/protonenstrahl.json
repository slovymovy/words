                "senses": [
                    {
                        "sense_id": "83aa1e0b-c7f0-3397-b772-eaf8dc21ee50",
                        "entry_id": "461416ca-4fe4-3087-b5b6-51b83b13ab02",
                        "glosses": [
                            "Kette sich hintereinander bewegender positiv geladener Teilchen (Protonen), zum Beispiel in der Strahlentherapie eingesetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09164c39-1752-42e0-884b-ea2e050774e5",
                                "sense_id": "83aa1e0b-c7f0-3397-b772-eaf8dc21ee50",
                                "text": "„Der Protonenstrahl wurde durch einen Analysiermagneten gereinigt und durch zwei Nickelfolien derartig aufgefächert, daß eine homogene Probenausleuchtung erzielt wurde. Den Aufbau der verwendeten Bestrahlungskammer zeigt Abb. 1.“"
                            },
                            {
                                "example_id": "e6560221-6e8e-4f8a-906e-42d99bd395a9",
                                "sense_id": "83aa1e0b-c7f0-3397-b772-eaf8dc21ee50",
                                "text": "„Die Absorptionseigenschaften der Protonenstrahlen ermöglichen Dosierungsgenauigkeiten von deutlich unter einem Millimeter sowohl in axialer als auch in lateraler Ausbreitungsrichtung [1,2].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
