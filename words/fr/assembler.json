                {
                    "sense_id": "76c6e45d-97d5-35e3-b422-0ccbd5022711",
                    "sense_definition": "Mettre ensemble des personnes ou des objets au même endroit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regroupement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a fait <w>assembler</w> tous les employés dans la grande salle de conférence.",
                            "target_lang_translations": {
                                "en": "The director had all the employees <w>assembled</w> in the large conference room.",
                                "ru": "Директор велел <w>собрать</w> всех сотрудников в большом конференц-зале.",
                                "de": "Der Direktor ließ alle Mitarbeiter im großen Konferenzsaal <w>versammeln</w>.",
                                "es": "El director hizo <w>reunir</w> a todos los empleados en la gran sala de conferencias.",
                                "zh": "经理让所有员工在大会议室<w>集合</w>。"
                            }
                        },
                        {
                            "text": "Elle a pris le temps d'<w>assembler</w> tous les documents nécessaires pour son dossier.",
                            "target_lang_translations": {
                                "en": "She took the time to <w>assemble</w> all the documents needed for her file.",
                                "ru": "Она нашла время, чтобы <w>собрать</w> все необходимые документы для своего дела.",
                                "de": "Sie nahm sich die Zeit, alle für ihre Akte nötigen Unterlagen <w>zusammenzutragen</w>.",
                                "es": "Ella se tomó el tiempo de <w>reunir</w> todos los documentos necesarios para su expediente.",
                                "zh": "她抽出时间，<w>收集</w>齐了她的档案所需的全部文件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "réunir",
                        "unir"
                    ],
                    "common_phrases": [
                        "assembler des documents",
                        "assembler des troupes"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring people or objects together in one place.",
                        "ru": "Собирать людей или предметы в одном месте.",
                        "de": "Personen oder Gegenstände an einem Ort zusammenbringen.",
                        "es": "Reunir personas u objetos en un mismo lugar.",
                        "zh": "把人或物品集中到同一个地方。"
                    },
