                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de brug <w>splitst</w> de weg zich in een noordelijke en zuidelijke route.",
                            "target_lang_translations": {
                                "ru": "После моста дорога <w>разделяется</w> на северный и южный маршруты.",
                                "en": "After the bridge, the road <w>splits</w> into a northern and a southern route.",
                                "pl": "Za mostem droga <w>rozdziela się</w> na trasę północną i południową.",
                                "de": "Nach der Brücke <w>teilt</w> sich der Weg in eine nördliche und eine südliche Route.",
                                "fr": "Après le pont, la route <w>se divise</w> en un itinéraire nord et un itinéraire sud.",
                                "it": "Dopo il ponte la strada si <w>divide</w> in un percorso a nord e uno a sud.",
                                "cs": "Za mostem se cesta <w>rozdvojuje</w> na severní a jižní trasu.",
                                "tr": "Köprüden sonra yol, kuzey ve güney rotası olarak ikiye <w>ayrılıyor</w>.",
                                "es": "Después del puente, la carretera se <w>bifurca</w> en una ruta hacia el norte y otra hacia el sur."
                            }
                        },
                        {
                            "text": "Hier <w>splitsen</w> onze wegen, maar we zien elkaar volgende week weer.",
                            "target_lang_translations": {
                                "ru": "Здесь наши пути <w>расходятся</w>, но мы увидимся снова на следующей неделе.",
                                "en": "Here our paths <w>part</w>, but we will see each other again next week.",
                                "pl": "Tutaj nasze drogi się <w>rozchodzą</w>, ale zobaczymy się ponownie w przyszłym tygodniu.",
                                "de": "Hier <w>trennen</w> sich unsere Wege, aber wir sehen uns nächste Woche wieder.",
                                "fr": "Ici, nos chemins <w>se séparent</w>, mais nous nous reverrons la semaine prochaine.",
                                "it": "Qui le nostre strade si <w>separano</w>, ma ci rivedremo la prossima settimana.",
                                "cs": "Zde se naše cesty <w>rozcházejí</w>, ale příští týden se zase uvidíme.",
                                "tr": "Burada yollarımız <w>ayrılıyor</w>, ama haftaya tekrar görüşürüz.",
                                "es": "Aquí se <w>separan</w> nuestros caminos, pero nos volveremos a ver la próxima semana."
                            }
                        }
