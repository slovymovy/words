    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "10b2e812-8b6b-351b-9585-4e1e981a9aaa",
                "word": "crupper",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3ebcba9b-e530-4c92-ac94-9ec0f9ad177c",
                        "entry_id": "10b2e812-8b6b-351b-9585-4e1e981a9aaa",
                        "tags": [
                            "plural"
                        ],
                        "form": "cruppers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5860d4d6-4d88-38fc-bb66-487ed704ae89",
                        "entry_id": "10b2e812-8b6b-351b-9585-4e1e981a9aaa",
                        "glosses": [
                            "A strap, looped under a horse's tail, used to stop a saddle from slipping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a4c5616-13ff-4aae-a1de-c4cfdea85b46",
                                "sense_id": "5860d4d6-4d88-38fc-bb66-487ed704ae89",
                                "text": "Our knight did bear no less a pack / Of his own buttocks on his back: / Which now had almost got the upper- / Hand of his head, for want of crupper."
                            },
                            {
                                "example_id": "dd80f8d0-3bf8-4c9d-965b-1ad406f6c7c3",
                                "sense_id": "5860d4d6-4d88-38fc-bb66-487ed704ae89",
                                "text": "he eſpied a mule's crupper, which hung to the ceiling of the room; this he took down, and tendering it to Don Quixote, went on, ſaying..."
                            },
                            {
                                "example_id": "33432d0d-e8a5-4299-a966-781cfc9346b0",
                                "sense_id": "5860d4d6-4d88-38fc-bb66-487ed704ae89",
                                "text": "Captain went out in the cab all the morning. Harry came in after school to feed me and give me water. In the afternoon I was put into the cab. Jerry took as much pains to see if the collar and bridle fitted comfortably, as if he had been John Manly over again. When the crupper was let out a hole or two, it all fitted well. There was no bearing rein—no curb—nothing but a plain ring snaffle. What a blessing that was!"
                            },
                            {
                                "example_id": "70d84787-a2d4-4356-9e7c-90240f163f4e",
                                "sense_id": "5860d4d6-4d88-38fc-bb66-487ed704ae89",
                                "text": "I sought among the mules one with a mild expression of generosity and gentleness in its eyes, and found it in a white mule with a crupper adorned with arabesques."
                            }
                        ]
                    },
                    {
                        "sense_id": "824a73fa-128e-3584-9ca9-0ca9e8549287",
                        "entry_id": "10b2e812-8b6b-351b-9585-4e1e981a9aaa",
                        "glosses": [
                            "The buttocks or rump, especially of a horse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a4095673-0a4d-3c06-9394-5783643375a5",
                        "entry_id": "10b2e812-8b6b-351b-9585-4e1e981a9aaa",
                        "glosses": [
                            "A piece of armour covering the hindquarters/buttocks of a horse."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
