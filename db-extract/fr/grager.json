                "senses": [
                    {
                        "sense_id": "36218866-a8ee-38a1-9389-94ba1393d2b6",
                        "entry_id": "8b5c38c6-9824-3330-bc28-e24c1a565a21",
                        "glosses": [
                            "Râper avec la grage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6788e1f-1d6a-47da-938f-307796234c8c",
                                "sense_id": "36218866-a8ee-38a1-9389-94ba1393d2b6",
                                "text": "Café gragé, café passé à la grage."
                            },
                            {
                                "example_id": "43d53512-9482-4656-874f-aad60aa1aac4",
                                "sense_id": "36218866-a8ee-38a1-9389-94ba1393d2b6",
                                "text": "Bordeaux : cafés, il a été vendu : 800 sacs guayra gragé de fr. 125 à 130 ; 1050 sacs dito non gragé de fr. 115 à 120."
                            },
                            {
                                "example_id": "a34312ec-05ab-4ea4-b851-4b74d60299a2",
                                "sense_id": "36218866-a8ee-38a1-9389-94ba1393d2b6",
                                "text": "Toutes les opérations […] ne se pratiquent que la nuit, pour les deux raisons suivantes : d’abord grager (râper) serait trop fatigant pendant la grande chaleur du jour, et ensuite cela détournerait les travailleurs d’occupations plus importantes."
                            }
                        ]
                    }
