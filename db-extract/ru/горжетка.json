                                                "example_id": "d0006524-c5dd-4118-b258-761156524832",
                                                "sense_id": "b917f0ee-6960-351a-aedc-f57df36bf386",
                                                "text": "It also has a neckpiece bearing a low-relief representation of the necklace of the chivalric Order of the Golden Fleece, to which only the most powerful of European rulers belonged."
                                            }
                                        ]
