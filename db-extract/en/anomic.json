                                        "entry_id": "a21d1e6c-ef59-39f0-90ca-06426ede6fa0",
                                        "glosses": [
                                            "Qui n’est pas organisé, qui ne respecte pas les règles sociales, qui est relatif à l’anomie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b2d9db-0466-4905-b412-a865e9171f60",
                                                "sense_id": "4bcabcc3-f2b3-3c90-a30f-b00224852263",
                                                "text": "Toute la sociabilité dans ces quartiers est sous l'emprise du stigmate et jugée déficiente et anomique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb88d7e3-64ab-4ae7-9bbc-8827c9e7db2c",
                        "source_entry_id": "baafeab7-f5a7-37ad-9a95-a423f05cc386",
                        "source_sense_id": "ee35bd45-ccb2-3fb5-9c17-41eab5ca6ef4",
                        "source_sense_description": "socially disorganized, disoriented or alienated",
                        "target_lang_word": "anomisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anomisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2382f48b-b2de-329f-869b-049b0296ab89",
                                        "entry_id": "6b47ea9e-4a9e-37ca-9a89-1c9e28ec1fdf",
                                        "glosses": [
                                            "im Zustand der Anomie befindlich (gesellschaftlich desorganisiert, desorientiert oder entfremdet)"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8203d362-fe94-44cf-9808-a4c7b4960bc1",
                                                "sense_id": "2382f48b-b2de-329f-869b-049b0296ab89",
                                                "text": "Im anomischen Zustand gelten nicht mehr die Regeln sozialen Handelns (vorgegeben durch Sitten, Gebräuche, Vorschriften etc)."
                                            },
                                            {
                                                "example_id": "e48e3793-2a29-4880-88cc-c7ea6ff40f47",
                                                "sense_id": "2382f48b-b2de-329f-869b-049b0296ab89",
                                                "text": "Die Regeln werden im anomischen Staat nicht mehr wie üblich befolgt."
                                            },
                                            {
                                                "example_id": "989bdde2-e1ad-4e72-b9ff-4933e7f641b5",
                                                "sense_id": "2382f48b-b2de-329f-869b-049b0296ab89",
                                                "text": "Merton schlägt vor, einen Zustand anomisch zu nennen, wenn einerseits bestimmte Werte und Normen in einem System durchgesetzt werden sollen, die dafür erforderlichen Mittel aber schlicht nicht gegeben sind."
                                            },
                                            {
                                                "example_id": "ff685bd6-750e-4564-b7aa-24623402d2d2",
                                                "sense_id": "2382f48b-b2de-329f-869b-049b0296ab89",
                                                "text": "Je anomischer jemand ist, desto negativer sind im Schnitt seine Einstellungen zu ausländischen Personen."
                                            },
                                            {
                                                "example_id": "17a5262a-c7c6-4f9a-af54-31059fdfa600",
                                                "sense_id": "2382f48b-b2de-329f-869b-049b0296ab89",
                                                "text": "Die Flut von Gesetzes- und Verordnungsänderungen trägt mit gleicher Gewissheit dazu bei, dass die Bürger anomisch handeln. Und die Gesetzgeber, welche die Durch- und Einführbarkeit von verhaltensändernden Impulsen nicht berücksichtigen, handeln strukturell anomisch: sie fördern die Verwirrung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
