                        "sense_id": "383c06e0-0541-3fbe-aa29-29b121e9ad23",
                        "entry_id": "4c6fba09-758c-3224-8109-9705620c86cc",
                        "glosses": [
                            "Absence d’orgasme, le désir sexuel étant conservé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14e0223e-f1e2-44cd-8ec1-3936daabe7fd",
                                "sense_id": "383c06e0-0541-3fbe-aa29-29b121e9ad23",
                                "text": "Mais certaines femmes sont atteintes d’anorgasmie. Ce trouble correspond à l’absence ou à l’insuffisance d’orgasme au cours de l’acte sexuel."
                            },
                            {
                                "example_id": "8211bd0d-80a1-45d8-a14f-07a55bf4f51c",
                                "sense_id": "383c06e0-0541-3fbe-aa29-29b121e9ad23",
                                "text": "La cause d’une anorgasmie peut être physiologique, comme elle peut être psychologique ou comportementale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "431e620d-f1f8-4dfe-b46a-1fc7c121f754",
                        "source_entry_id": "4c6fba09-758c-3224-8109-9705620c86cc",
                        "source_sense_id": "383c06e0-0541-3fbe-aa29-29b121e9ad23",
                        "target_lang_word": "anorgasmia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
