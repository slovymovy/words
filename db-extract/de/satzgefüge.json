                ],
                "senses": [
                    {
                        "sense_id": "e7628e39-f592-3045-9abb-df479fdb842e",
                        "entry_id": "7ab98d52-96ae-3a2a-87ed-d0d031ba1613",
                        "glosses": [
                            "Begriff für einen komplexen Satz, der aus einem Hauptsatz und mindestens einem Nebensatz besteht; er kann auch mehrere Nebensätze enthalten."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ea24c2-51ba-4ba9-904d-30064fc3b3e3",
                                "sense_id": "e7628e39-f592-3045-9abb-df479fdb842e",
                                "text": "Der Satz \"Er kommt, obwohl er nur wenig Zeit hat\" ist ein Beispiel für ein Satzgefüge."
                            },
                            {
                                "example_id": "1c101a27-24a0-4475-af00-a3c3fabc0b9a",
                                "sense_id": "e7628e39-f592-3045-9abb-df479fdb842e",
                                "text": "„Während man bei Satzverbindungen die miteinander verbundenen Sätze als gleichrangig betrachtet, postuliert man bei den Satzgefügen eine Hierarchie zwischen den Sätzen, von denen sie gebildet werden, und unterscheidet zwischen übergeordnetem Satz - dem sogenannten Hauptsatz - und untergeordnetem Satz - dem sogenannten Nebensatz.“"
                            },
                            {
                                "example_id": "e4c75017-5467-47c4-ad65-5041b16a3a89",
                                "sense_id": "e7628e39-f592-3045-9abb-df479fdb842e",
                                "text": "„Es gibt noch ein zweites Satzzeichen, um ein Satzgefüge durchsichtig zu machen: die Parenthese (Schaltzeichen), das heißt Gedankenstriche vor und hinter einer Einschaltung.“"
                            },
                            {
                                "example_id": "145441ef-80a9-47f1-8995-470a172dbdd9",
                                "sense_id": "e7628e39-f592-3045-9abb-df479fdb842e",
                                "text": "„Die logische Modifizierung der Inhalte im Satzgefüge wird mehr oder weniger von einigen wenigen Konjunktionen geleistet; dabei spielen Relativ- und daß-Sätze die weitaus größte Rolle.“"
                            },
                            {
                                "example_id": "f0a3d1ca-fd2e-46a9-811e-4a67308d294e",
                                "sense_id": "e7628e39-f592-3045-9abb-df479fdb842e",
                                "text": "„Der sogenannte Schachtelsatz, also ein Satzgefüge aus einem Hauptsatz und mehreren ineinander »verkeilten« Nebensätzen, findet sich meist nur noch in (im Übrigen schlechten) Wissenschaftstexten und in der Verwaltungssprache.“"
                            },
                            {
                                "example_id": "f490f26e-90f0-4da4-8ee4-350033db345c",
                                "sense_id": "e7628e39-f592-3045-9abb-df479fdb842e",
                                "text": "„So kann es zu komplizierten Satzgefügen kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
