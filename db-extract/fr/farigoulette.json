                        "examples": [
                            {
                                "example_id": "1deacd10-f6f8-458f-8804-4def5e6bd424",
                                "sense_id": "2c8b4d5e-b49e-306c-b6b2-006468da9178",
                                "text": "L’ail sauvage même, et les œillets de sable, et les farigoulettes."
                            },
                            {
                                "example_id": "fd045135-c292-4d9f-8edb-4d8a3ab6d1f0",
                                "sense_id": "2c8b4d5e-b49e-306c-b6b2-006468da9178",
                                "text": "Comme il longeait la lisière du bosquet, une troupe de coureurs en jaillit. Elle était portée par deux larges ailes de poussière. Elle s’essaima dans une farigoulette vers un lointain portique bleu."
                            },
                            {
                                "example_id": "a3f78e30-5bbc-4112-bf88-1f4aba333a98",
                                "sense_id": "2c8b4d5e-b49e-306c-b6b2-006468da9178",
                                "text": "À sa bouillabaisse, Maxime Pastézan conviait les majors, l’enseigne, le nouveau capitaine de ville, et le marchand de farigoulette."
                            }
                        ]
                    }
