                        "ru": [
                            {
                                "target_lang_word": "индиец",
                                "target_lang_sense_clarification": "мужской род, житель Индии"
                            },
                            {
                                "target_lang_word": "индианка",
                                "target_lang_sense_clarification": "женский род, жительница Индии"
                            },
