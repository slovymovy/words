                ],
                "senses": [
                    {
                        "sense_id": "b9197147-506c-304b-8fcd-e321d7f2fe72",
                        "entry_id": "917322af-31e6-34c7-8fad-581bcffb2ab2",
                        "glosses": [
                            "Qui a lieu avant une élection, une campagne électorale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d5477cc-e856-4430-b393-2e3fee707d30",
                                "sense_id": "b9197147-506c-304b-8fcd-e321d7f2fe72",
                                "text": "En cette année préélectorale (ce n’est qu’en décembre que Hollande a décidé de ne pas se représenter), le gouvernement a ouvert les vannes de la dépense publique."
                            },
                            {
                                "example_id": "acc907b7-04f4-45a1-8e13-3d1066d21625",
                                "sense_id": "b9197147-506c-304b-8fcd-e321d7f2fe72",
                                "text": "En cet été préélectoral, j’ose me permettre une série de conseils amicaux à tous les partis politiques."
                            },
                            {
                                "example_id": "0aa1261b-771e-41c4-8341-936d3e05155a",
                                "sense_id": "b9197147-506c-304b-8fcd-e321d7f2fe72",
                                "text": "Les manœuvres préélectorales de redécoupage des circonscriptions sont les premières étapes de la fraude électorale."
                            },
                            {
                                "example_id": "d5715457-03ef-4195-b315-a08653109ae3",
                                "sense_id": "b9197147-506c-304b-8fcd-e321d7f2fe72",
                                "text": "Demain, j'ai un rendez-vous avec la commission du parti chargée de façonner la liste préélectorale des candidats pour le caucus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fef8b0d1-0753-4e62-8621-bb615cf55a90",
                        "source_entry_id": "917322af-31e6-34c7-8fad-581bcffb2ab2",
                        "source_sense_id": "b9197147-506c-304b-8fcd-e321d7f2fe72",
