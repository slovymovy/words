                                                "sense_id": "e873edad-8824-3549-8e31-82f147e404ce",
                                                "text": "Als je een polymeer aan een te hoge temparatuur blootstelt, zal het ontbinden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "298c1cd9-2cfa-326a-8d3a-833f8e7d331e",
                                        "entry_id": "a82e9fc8-1f24-39ee-a787-a12022389f62",
