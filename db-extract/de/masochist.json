                            {
                                "example_id": "29a40ba9-e5e4-4891-8a4b-43aafd55eb3f",
                                "sense_id": "c111e3a1-73fb-3949-be8f-fac772eab4ad",
                                "text": "Den Job kann man freiwillig nur annehmen, wenn man insgeheim ein Masochist ist."
