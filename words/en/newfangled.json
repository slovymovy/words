                },
                {
                    "sense_id": "96b1c3ad-94bc-34f0-864e-81f9e7457615",
                    "sense_definition": "Having a strong preference for new things or novelty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "novelty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is quite <w>newfangled</w> in her tastes, always seeking out the latest trends before anyone else."
                        },
                        {
