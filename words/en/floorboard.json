    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b024a60a-84d7-3bd4-8f49-d77279d083fd",
                    "sense_definition": "Any of the long wooden planks laid across joists to form a floor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flooring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A loose <w>floorboard</w> in the upstairs hallway creaked loudly every time someone walked across it.",
                            "target_lang_translations": {
                                "ru": "Качающаяся <w>половица</w> в коридоре на верхнем этаже громко скрипела каждый раз, когда по ней кто-нибудь проходил."
                            }
                        },
                        {
                            "text": "During the home renovation, they pulled up the old carpet to reveal original oak <w>floorboards</w> underneath.",
                            "target_lang_translations": {
                                "ru": "Во время ремонта дома они сняли старый ковер и обнаружили под ним оригинальные дубовые <w>половые доски</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "creaky floorboard",
                        "wooden floorboard",
                        "under the floorboards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная деревянная доска, уложенная на балки для создания пола."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "половица",
                                "target_lang_sense_clarification": "доска деревянного пола"
                            },
                            {
                                "target_lang_word": "половая доска",
                                "target_lang_sense_clarification": "доска для настила пола"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfa57164-c895-3287-a56c-dff91f5c725d",
                    "sense_definition": "The floor of an automobile or other vehicle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_interior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My sunglasses fell off the dashboard and landed directly onto the car's passenger <w>floorboard</w>.",
                            "target_lang_translations": {
                                "ru": "Мои солнечные очки упали с приборной панели прямо на <w>пол</w> машины с пассажирской стороны."
                            }
                        },
                        {
                            "text": "He placed the heavy grocery bags carefully on the rear <w>floorboard</w> so they wouldn't spill.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно поставил тяжелые пакеты с продуктами на <w>пол</w> сзади, чтобы ничего не рассыпалось."
                            }
                        }
                    ],
                    "common_phrases": [
                        "passenger floorboard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пол или днище салона автомобиля или другого транспортного средства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пол",
                                "target_lang_sense_clarification": "в салоне автомобиля"
                            },
                            {
                                "target_lang_word": "днище",
                                "target_lang_sense_clarification": "пол салона автомобиля"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aed59d3e-985e-3fa9-8fa1-411e86c9ed7e",
                    "sense_definition": "To press the accelerator pedal completely down to drive at maximum speed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "driving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As soon as he merged onto the empty highway, he <w>floorboarded</w> the gas pedal.",
                            "target_lang_translations": {
                                "ru": "Как только он выехал на пустое шоссе, он <w>вдавил педаль газа в пол</w>."
                            }
                        },
                        {
                            "text": "Panicked by the pursuing vehicle, the driver <w>floorboarded</w> and sped away into the night.",
                            "target_lang_translations": {
                                "ru": "В панике от преследовавшей машины водитель <w>нажал газ до упора</w> и умчался в темноту."
                            }
                        }
                    ],
                    "synonyms": [
                        "floor"
                    ],
                    "common_phrases": [
                        "floorboard the pedal"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal driving term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выжать педаль газа до упора, чтобы ехать с максимальной скоростью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдавить педаль газа в пол",
                                "target_lang_sense_clarification": "нажать газ до упора"
                            },
                            {
                                "target_lang_word": "газануть до упора",
                                "target_lang_sense_clarification": "разг., выжать газ на максимум"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}