{
    "word_family": [
        "угореть",
        "угорать",
        "угарный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ee1e9f8-e66b-3fa2-b647-1c0ca83357c4",
                    "sense_definition": "Ядовитый удушливый газ, образующийся при неполном сгорании топлива; угарный газ.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gas_smoke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он слишком рано закрыл печную заслонку, и в доме стал скапливаться опасный <w>угар</w>.",
                            "target_lang_translations": {
                                "de": "Er schloss die Ofenklappe zu früh, und im Haus begann sich gefährliches <w>Kohlenmonoxid</w> anzusammeln."
                            }
                        },
                        {
                            "text": "В старой деревенской бане чувствовался едкий <w>угар</w>, от которого слезились глаза.",
                            "target_lang_translations": {
                                "de": "In der alten Dorfbanja roch es nach beißendem <w>Schwelgas</w>, von dem die Augen tränten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "печной угар"
                    ],
                    "target_lang_definitions": {
                        "de": "Giftiges, erstickendes Gas, das bei unvollständiger Verbrennung entsteht; Kohlenmonoxid."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kohlenmonoxid",
                                "target_lang_sense_clarification": "chemisch, giftiges Gas"
                            },
                            {
                                "target_lang_word": "Kohlenoxid",
                                "target_lang_sense_clarification": "giftiges Gas"
                            },
                            {
                                "target_lang_word": "Schwelgas",
                                "target_lang_sense_clarification": "Erstickungsgas bei Bränden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2fd558b-23e3-3a96-88f3-ae93e41bac9d",
                    "sense_definition": "Тяжёлое состояние, головная боль или помрачение сознания, вызванные отравлением угарным газом.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После ночи в плохо протопленной избе у него начался сильный <w>угар</w> с головокружением.",
                            "target_lang_translations": {
                                "de": "Nach einer Nacht in der schlecht geheizten Hütte litt er an einer schweren <w>Kohlenmonoxidvergiftung</w> mit Schwindelgefühl."
                            }
                        },
                        {
                            "text": "Пострадавшего от <w>угара</w> человека нужно немедленно вынести на свежий воздух.",
                            "target_lang_translations": {
                                "de": "Eine Person mit einer <w>Rauchgasvergiftung</w> muss sofort an die frische Luft gebracht werden."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Schwerer Zustand, Kopfschmerzen oder Benommenheit infolge einer Kohlenmonoxidvergiftung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kohlenmonoxidvergiftung",
                                "target_lang_sense_clarification": "Vergiftungszustand"
                            },
                            {
                                "target_lang_word": "Rauchvergiftung",
                                "target_lang_sense_clarification": "durch Rauch- und Gasinhalation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd307490-98d0-3f80-a058-d369fdd6bd6a",
                    "sense_definition": "Крайнее возбуждение, опьянение какими-либо чувствами или страстями, лишающее способности здраво рассуждать.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "craze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В патриотическом <w>угаре</w> толпа совершенно перестала замечать очевидные ошибки руководства.",
                            "target_lang_translations": {
                                "de": "Im patriotischen <w>Taumel</w> bemerkte die Menge die offensichtlichen Fehler der Führung überhaupt nicht mehr."
                            }
                        },
                        {
                            "text": "В шумном праздничном <w>угаре</w> гости веселились до самого утра.",
                            "target_lang_translations": {
                                "de": "Im lauten <w>Festrausch</w> feierten die Gäste bis zum frühen Morgen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "пьяный угар",
                        "в патриотическом угаре"
                    ],
                    "target_lang_definitions": {
                        "de": "Extremer Erregungs- oder Rauschzustand von Gefühlen oder Leidenschaften, der klares Denken verhindert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Rausch",
                                "target_lang_sense_clarification": "emotional oder berauschend"
                            },
                            {
                                "target_lang_word": "Taumel",
                                "target_lang_sense_clarification": "Zustand der Erregung"
                            },
                            {
                                "target_lang_word": "Wahn",
                                "target_lang_sense_clarification": "blindes Schwelgen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aea12be-ed45-3233-bcaf-12d5d37404c4",
                    "sense_definition": "Что-либо очень смешное, уморительное или безумно весёлое.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчерашняя комедия была просто полный <w>угар</w>, мы смеялись весь вечер.",
                            "target_lang_translations": {
                                "de": "Die Komödie gestern war einfach ein absoluter <w>Brüller</w>, wir haben den ganzen Abend gelacht."
                            }
                        },
                        {
                            "text": "Он рассказал такую забавную историю, что в компании начался настоящий <w>угар</w>.",
                            "target_lang_translations": {
                                "de": "Er erzählte eine so lustige Geschichte, dass in der Runde eine wahre <w>Mordsgaudi</w> losbrach."
                            }
                        }
                    ],
                    "common_phrases": [
                        "полный угар"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "молодёжный сленг"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas extrem Lustiges, Urkomisches oder herrlich Verrücktes (Jugendsprache)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Brüller",
                                "target_lang_sense_clarification": "umgangssprachlich für extrem lustige Sache"
                            },
                            {
                                "target_lang_word": "Mordsgaudi",
                                "target_lang_sense_clarification": "Riesenspaß"
                            },
                            {
                                "target_lang_word": "Hammer",
                                "target_lang_sense_clarification": "umgangssprachlich: total verrückt/witzig"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7214300b-d7c0-3c74-b6bb-103b84f69cee",
                    "sense_definition": "Удушливый дым и чад, возникающие в процессе горения и мешающие дышать.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gas_smoke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Комната быстро наполнилась тяжёлым березовым <w>угаром</w> от плохо разгоревшихся дров.",
                            "target_lang_translations": {
                                "de": "Das Zimmer füllte sich rasch mit schwerem Birken<w>qualm</w> von dem schlecht brennenden Holz."
                            }
                        },
                        {
                            "text": "Сквозь густой <w>угар</w> пожарные с трудом пробирались к выходу из горящего здания.",
                            "target_lang_translations": {
                                "de": "Durch den dichten <w>Qualm</w> bahnten sich die Feuerwehrleute mühsam den Weg zum Ausgang des brennenden Gebäudes."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Erstickender Qualm und beißender Rauch, die beim Verbrennungsprozess die Atmung behindern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Qualm",
                                "target_lang_sense_clarification": "dicker, erstickender Rauch"
                            },
                            {
                                "target_lang_word": "Schwelbrandrauch",
                                "target_lang_sense_clarification": "beißender Rauch"
                            },
                            {
                                "target_lang_word": "Dunst",
                                "target_lang_sense_clarification": "stickige Luft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a8d45a4-8e30-3d4c-ab0e-f0f4c342bbb3",
                    "sense_definition": "Потеря массы или объёма материала при плавке, нагревании, сгорании или механической обработке.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При переплавке чугуна технологи обязательно учитывают естественный <w>угар</w> металла.",
                            "target_lang_translations": {
                                "de": "Beim Umschmelzen von Gusseisen berücksichtigen Technologen stets den natürlichen <w>Abbrand</w> des Metalls."
                            }
                        },
                        {
                            "text": "Высокий <w>угар</w> моторного масла указывает на сильный износ деталей двигателя.",
                            "target_lang_translations": {
                                "de": "Ein hoher <w>Ölverbrauch</w> weist auf einen starken Verschleiß der Motorteile hin."
                            }
                        }
                    ],
                    "common_phrases": [
                        "угар металла",
                        "угар масла"
                    ],
                    "target_lang_definitions": {
                        "de": "Massen- oder Volumenverlust von Material beim Schmelzen, Erhitzen, Verbrennen oder Bearbeiten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Abbrand",
                                "target_lang_sense_clarification": "Verlust von Metall oder Material durch Hitze"
                            },
                            {
                                "target_lang_word": "Schwund",
                                "target_lang_sense_clarification": "Material- oder Masseverlust"
                            },
                            {
                                "target_lang_word": "Ölverbrauch",
                                "target_lang_sense_clarification": "bezogen auf Motoröl"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6429cb0e-64db-3706-9807-3ffa796a4e3f",
                    "sense_definition": "Отходы сырья, остающиеся в процессе обработки волокнистых материалов (хлопка, шерсти и т. п.).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На текстильной фабрике собирают волокнистый <w>угар</w> для дальнейшей переработки.",
                            "target_lang_translations": {
                                "de": "In der Textilfabrik sammelt man faserigen <w>Spinnabfall</w> für die Weiterverarbeitung."
                            }
                        },
                        {
                            "text": "Шерстяные <w>угары</w> накапливались в специальных ёмкостях под прядильными станками.",
                            "target_lang_translations": {
                                "de": "Wollene <w>Abfallfasern</w> sammelten sich in speziellen Behältern unter den Spinnmaschinen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Fasermaterialabfälle bei der Verarbeitung von Baumwolle, Wolle usw."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Spinnabfall",
                                "target_lang_sense_clarification": "Abfall bei der Faserverarbeitung"
                            },
                            {
                                "target_lang_word": "Kämmlinge",
                                "target_lang_sense_clarification": "Textilabfälle, kurze Fasern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f53c7a5-a588-3df4-a404-6f59b83e060e",
                    "sense_definition": "Беспокойный, отчаянный человек; сорванец, кутила или буян.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодой гусар был известен в полку как дерзкий <w>угар</w> и любитель шумных попоек.",
                            "target_lang_translations": {
                                "de": "Der junge Husar war im Regiment als verwegener <w>Draufgänger</w> und Liebhaber lauter Zechgelage bekannt."
                            }
                        },
                        {
                            "text": "Среди местной молодёжи этот парень слыл настоящим <w>угаром</w> и заводилой драк.",
                            "target_lang_translations": {
                                "de": "Unter den einheimischen Jugendlichen galt der Kerl als echter <w>Tollkopf</w> und Rädelsführer bei Prügeleien."
                            }
                        }
                    ],
                    "synonyms": [
                        "сорванец",
                        "кутила",
                        "буян"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Unruhiger, verwegener Mensch; Draufgänger, Zecher oder Raufbold."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Draufgänger",
                                "target_lang_sense_clarification": "waghalsiger Mensch"
                            },
                            {
                                "target_lang_word": "Tollkopf",
                                "target_lang_sense_clarification": "wilder, ungestümer Mensch"
                            },
                            {
                                "target_lang_word": "Wüstling",
                                "target_lang_sense_clarification": "Zecher, Krawallmacher"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e9cddf0-076f-3323-8ae9-f8292f25e382",
                    "sense_definition": "Тошнота и дурнота от морской качки.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Едва корабль вышел в открытое море, как матроса с непривычки свалил сильный <w>угар</w>.",
                            "target_lang_translations": {
                                "de": "Kaum war das Schiff auf offene See hinausgefahren, überkam den Matrosen aus Ungewohnheit eine schwere <w>Seekrankheit</w>."
                            }
                        },
                        {
                            "text": "Старый рыбак посмеивался над пассажирами, страдавшими от внезапного <w>угара</w> во время волнения.",
                            "target_lang_translations": {
                                "de": "Der alte Fischer belächelte die Passagiere, die bei Seegang unter plötzlicher <w>Übelkeit</w> litten."
                            }
                        }
                    ],
                    "synonyms": [
                        "морская болезнь"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее региональное"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "диалектное"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Übelkeit und Schwindelgefühl infolge von Schiffsbewegungen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Seekrankheit",
                                "target_lang_sense_clarification": "Übelkeit durch Wellengang"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}