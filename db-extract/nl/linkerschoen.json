                    {
                        "sense_id": "4e7a8d92-0215-37b1-afda-3a2fade6bc18",
                        "entry_id": "0f1e28b3-2f82-37f5-9796-798eb5756004",
                        "glosses": [
                            "schoeisel voor de linkervoet"
                        ],
                        "tags": [
                            "schoeisel"
                        ],
                        "examples": [
                            {
                                "example_id": "9d3dd768-d6d9-431a-a6f2-b1cf38e9d5b7",
                                "sense_id": "4e7a8d92-0215-37b1-afda-3a2fade6bc18",
                                "text": "Een linkerschoen, een rode sok, een sjaaltje, de verpakking van een of andere ontbijtmix, parfum, een mondharmonica, afstandsbedieningen en een nummer van de TV Guide van december 1992."
                            },
                            {
                                "example_id": "c66110e5-0f5a-4d37-a0ff-c472f0a6fcc1",
                                "sense_id": "4e7a8d92-0215-37b1-afda-3a2fade6bc18",
                                "text": "Wat maakt de goal van Dennis Bergkamp tegen Newcastle United zo speciaal? Waarschijnlijk vooral de manier waarop hij de bal meeneemt. Met de punt van zijn linkerschoen tikt Bergkamp de bal naar rechts, waarna hij zelf naar links draait, om tegenstander Nikos Dabizas heen. Het is een actie waarvan je je afvraagt: hoe kom je erop?"
                            }
                        ]
                    }
