                    {
                        "sense_id": "fce488d7-524d-398f-a2f7-4b0636473fcc",
                        "entry_id": "41b46173-cc1a-315c-b0ee-8ed262b6a730",
                        "glosses": [
                            "Prénom féminin d’origine bulgare ou russe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c411d9e-7816-4f70-a934-6638c2b95820",
                                "sense_id": "fce488d7-524d-398f-a2f7-4b0636473fcc",
                                "text": "Margarit i Margarita\n(Margarit et Margarita)\nQ.R. Bulgare, de Nikolaï Volev.\nCe film commence par une critique particulièrement vive, mais à la fois drôle et grave, du système scolaire bulgare dont les personnages de Margarit et Margarita vont choisir de s’exclure."
                            },
                            {
                                "example_id": "4358d1f6-58f1-4624-9503-549ecf76bee7",
                                "sense_id": "fce488d7-524d-398f-a2f7-4b0636473fcc",
                                "text": "Le virage vers les audiences africaines est beaucoup plus visible chez Sputnik, également visée par des sanctions en France et dans l’UE, et qui partage la même rédactrice en chef — Margarita Simonian — que le réseau RT."
                            }
                        ]
                    }
                ],
