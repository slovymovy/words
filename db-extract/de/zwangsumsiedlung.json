                "senses": [
                    {
                        "sense_id": "46efa68c-6c2f-3785-8d61-5a443884399a",
                        "entry_id": "f9030da0-2f7e-3eea-8ac5-302bde90fff9",
                        "glosses": [
                            "erzwungener Wechsel des Wohnortes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbd7df83-8795-403b-8a59-8b0bf2af7629",
                                "sense_id": "46efa68c-6c2f-3785-8d61-5a443884399a",
                                "text": "„Im Spätherbst 1947 verebbte die große Welle der Zwangsumsiedlung.“"
                            },
                            {
                                "example_id": "cfdf7dbe-beac-4029-aea3-94891acde84f",
                                "sense_id": "46efa68c-6c2f-3785-8d61-5a443884399a",
                                "text": "„Auch nach dem Ende der Aussiedlung blieb noch immer etwa ein Drittel der neu zusammengesetzten Bevölkerung in den bisher deutsch besiedelten Gebieten für einige Zeit von einer Zwangsumsiedlung innerhalb der Staatsgrenzen bedroht.“"
                            },
                            {
                                "example_id": "548738c5-72c2-45aa-a008-01671b82ba56",
                                "sense_id": "46efa68c-6c2f-3785-8d61-5a443884399a",
                                "text": "„Dies führte zu Konzentrationslagern, Zwangsumsiedlungen und Mauerbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
