                    },
                    {
                        "translation_id": "a59853f1-0905-4927-a768-60337092b82b",
                        "source_entry_id": "ab730bc7-bbd5-3386-9237-b3405eaceb4d",
                        "source_sense_id": "8394f9e0-5a4b-3d08-8920-6db0886867e9",
                        "target_lang_word": "Pithecanthropus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pithecanthropus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff6c78af-e75a-3b38-aa7f-6ee50eacf133",
                                        "entry_id": "154aeda0-4f16-3135-9a9a-43527399622d",
                                        "glosses": [
                                            "ein nicht mehr gebräuchlicher Gattungsname für die Homo-Erectus-Funde von Java (Java-Mensch)"
                                        ],
                                        "tags": [
                                            "Anthropologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb27ba7-01b9-488d-b3c3-d66f59ce61ba",
                                                "sense_id": "ff6c78af-e75a-3b38-aa7f-6ee50eacf133",
                                                "text": "Die Gattung Pithecanthropus war ursprünglich von Ernst Haeckel als hypothetische Übergangsform zwischen den Menschenaffen und dem Menschen postuliert worden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1e1a0d6-902a-474b-96e6-2328ada8cce6",
                        "source_entry_id": "ab730bc7-bbd5-3386-9237-b3405eaceb4d",
                        "source_sense_id": "8394f9e0-5a4b-3d08-8920-6db0886867e9",
                        "target_lang_word": "Affenmensch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Affenmensch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c798d78-3e4c-36c2-8492-c49f10ece545",
                                        "entry_id": "5a510f4f-cef9-3ae1-9496-83441d7a85f3",
                                        "glosses": [
                                            "umgangssprachliche Bezeichnung für ausgestorbene Vertreter der Frühmenschen (Homini), im Umfeld des Australopithecus, die sowohl Merkmale moderner Menschen wie auch Merkmale der Menschenaffen aufweisen"
                                        ],
                                        "tags": [
                                            "Anthropologie",
                                            "Paläontologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30695c39-613d-433b-84d4-7a548410a1f1",
                                                "sense_id": "5c798d78-3e4c-36c2-8492-c49f10ece545",
                                                "text": "Die früher als Java- oder Affenmensch (Pithecanthropus) bezeichneten Hominiden werden heute systematisch in den Formenkreis des Homo erectus gestellt."
                                            },
                                            {
                                                "example_id": "92aaa012-e280-4473-887e-7c6021420c82",
                                                "sense_id": "5c798d78-3e4c-36c2-8492-c49f10ece545",
                                                "text": "„Die von Ernst Haeckel postulierte Übergangsform zwischen den Menschenaffen und dem Menschen benannte dieser selbst mit ‚Pithecanthropus alalus‘, der noch nicht sprachbegabte Affenmensch.“"
                                            },
                                            {
                                                "example_id": "8d4968e2-509b-48b0-a6a1-7733edee88cd",
                                                "sense_id": "5c798d78-3e4c-36c2-8492-c49f10ece545",
                                                "text": "„Den hypothetischen Urmenschen nannte Haeckel ‚Homo primigenius oder Pithecanthropus primigenius‘, wobei er einen gleitenden Übergang von hypothetischen ‚Affenmenschen (Pithecanthropi)‘ zu sprachlosen ‚Urmenschen (Alali)‘ vermutete.“"
                                            },
                                            {
                                                "example_id": "cea1621b-a070-4b1d-9363-b8e45bc8bda3",
                                                "sense_id": "5c798d78-3e4c-36c2-8492-c49f10ece545",
                                                "text": "„Rund zwanzig Individuen der Spezies Homo sapiens quieken erschreckt. Die Helden des Dramas, Exemplare des frühen Affenmenschen Australopithecus, sind vor etwa drei Millionen Jahren von der Weltbühne verschwunden. Und doch – sie bewegen sich: Roboter, in eine Tarnhaut aus Silikon und Menschenhaar gehüllt, übernehmen ihre Rolle in einem ‚einzigartigen Schauspiel zur Menschheitsgeschichte‘, zu dem der Kölner Zoo noch bis zum 20. Oktober lädt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
