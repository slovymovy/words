                "senses": [
                    {
                        "sense_id": "a6475919-7219-371a-9e0a-986dc76e9e31",
                        "entry_id": "80cacbd3-11b9-3ff7-9932-93a506db2ec2",
                        "glosses": [
                            "Stärkung, meist darauf bezogen, dass jemand dafür sorgt, dass etwas stark und widerstandsfähig wird/bleibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ef688d5-4fc0-4224-9685-ddfd856b52b6",
                                "sense_id": "a6475919-7219-371a-9e0a-986dc76e9e31",
                                "text": "Wir streben mit der Behandlung eine allmähliche körperliche und psychische Kräftigung an."
                            },
                            {
                                "example_id": "b7c1d121-e79e-4565-96d1-1935ede6cd2c",
                                "sense_id": "a6475919-7219-371a-9e0a-986dc76e9e31",
                                "text": "Hier finden Sie gezielte Übungen zur Kräftigung und Dehnung der Muskulatur."
                            },
                            {
                                "example_id": "76c149ec-1748-41d3-9578-c843cf5ff14a",
                                "sense_id": "a6475919-7219-371a-9e0a-986dc76e9e31",
                                "text": "Diese staatlichen Aktivitäten trugen massiv zur Kräftigung der nationalistischen Bewegung bei."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
