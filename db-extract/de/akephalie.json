                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c2dd5d5-351b-4abd-a2c8-8b059ea34a9f",
                                "sense_id": "0e5b1614-d443-34f6-808f-0f5aafd62a84",
                                "text": "„Wirkliche Akephalie kommt nicht vor, es fehlt den A. nur das Gehirn, und sie heißen daher besser Anenkephalen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
