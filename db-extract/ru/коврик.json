                                            "Ellipsis of rughead."
                                        ],
                                        "tags": [
                                            "US",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "ethnic",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e13d9bc4-9d8a-4e9b-8ee2-85b842280cd7",
                                                "sense_id": "f83fa187-36f0-3059-abd2-c1cf059ded64",
                                                "text": "We're the motherfuckers be fightin' when the rugs [black prisoners] start wasting people around here."
                                            }
                                        ]
                                    }
                                ]
                            },
