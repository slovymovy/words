                                        "entry_id": "bd1b662c-778a-3b85-a40c-612670754d8e",
                                        "glosses": [
                                            "A state of nervousness about performing some action in front of a group of people, on or off of a stage; nerves; a lack of self-assurance before an audience."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c143add-a5ce-414f-a0fc-8b66c88c0301",
                                                "sense_id": "df7d681f-38ca-3963-bb27-692423397aac",
                                                "text": "I did some guest-speaking at the middle school last year, and I experienced some stage fright before and during my first presentation."
                                            },
                                            {
                                                "example_id": "9e6a5b4a-9bf0-40b7-b4e3-26ad7a8cfd5b",
                                                "sense_id": "df7d681f-38ca-3963-bb27-692423397aac",
                                                "text": "I got stage fright while doing a dance show for my school last year."
                                            },
                                            {
                                                "example_id": "d81690a9-deec-4bdb-b2d0-6ff0d9231384",
                                                "sense_id": "df7d681f-38ca-3963-bb27-692423397aac",
                                                "text": "It is a very good training, and ofttimes will cure one of camera-fright, which is the silent sister to stage-fright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2b039fc-1e22-3cf2-9cd8-33f7345235b5",
