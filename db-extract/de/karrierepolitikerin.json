                ],
                "senses": [
                    {
                        "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                        "entry_id": "8babc286-c75c-3605-9cc0-1302455566ae",
                        "glosses": [
                            "Frau, die (beruflich) in der Politik tätig ist und unbedingt und schnell in wichtigen Ämtern/Positionen sitzen will"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28b2a491-5261-4bf1-9846-88539cd74d5f",
                                "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                                "text": "„Die 1971 in Hamburg in einer eingewanderten türkischen Schneiderfamilie geborene Karrierepolitikerin ist die erste Frau mit einem sogenannten Migrationshintergrund, die in Deutschland ein Ministeramt übernimmt.“"
                            },
                            {
                                "example_id": "c3c1ac12-adba-46d6-affb-dc3a5444d335",
                                "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                                "text": "„Die Karrierepolitikerin,“ […]„, muss nun nicht damit rechnen, die zwei Monate in einer Gefängniszelle zu verbringen. Es besteht die Möglichkeit, die Strafe im Hausarrest mit einer elektronischen Fußfessel zu verbüßen.“"
                            },
                            {
                                "example_id": "150979a9-70b5-4a90-9134-78c9ec8c1b79",
                                "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                                "text": "„Winter ist eine Karrierepolitikerin. Sie hat sich nicht in die Branche verirrt, sie hat sich Schritt für Schritt vorgearbeitet.“"
                            },
                            {
                                "example_id": "e291a7c9-8634-45da-ba15-7589c4f1d2be",
                                "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                                "text": "„Warum verlor die Karrierepolitikerin Clinton gegen einen lachhaften Politnovizen, wo sich doch alle, bis auf den letzten sogenannten Experten, so siegesgewiss gegeben hatten?“"
                            },
                            {
                                "example_id": "083ad308-3566-461d-a103-0f2cf0b41e39",
                                "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                                "text": "[Angela Merkel:] „Ist sie eine Austeritätsideologin oder nur eine Karrierepolitikerin mit angelsächsischem Pragmatismus?“"
                            },
                            {
                                "example_id": "4b71e3fa-ab96-4768-a161-302f17ed020b",
                                "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                                "text": "„Auf dem Foto wirkte sie nachdenklich und melancholisch, das ganze Gegenteil der knallharten Karrierepolitikerin, als die sie sich später erwiesen hatte.“"
                            },
                            {
                                "example_id": "bfa9b538-e48a-44d2-8bbc-1ce7c458b91e",
                                "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                                "text": "[Andrea Nahles:] „Aber dann drehte sich Nahles um und stellte fest: Keiner steht hinter ihr. Die Karrierepolitikerin schaltete schnell und nutzte die erstbeste Gelegenheit, aus der Sache auszusteigen.“"
                            },
                            {
                                "example_id": "c60abbae-e78e-4431-8f1e-1e9e0891d280",
                                "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                                "text": "„Doch sowohl Professoren als auch Kunstkenner bezweifelten, dass die Karrierepolitikerin und studierte Psychologin den Anforderungen genügen konnte.“"
                            },
                            {
                                "example_id": "ddf643a0-d659-4caa-9ee4-59d5986c41f5",
                                "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                                "text": "„Powell wirke authentisch, glaubwürdig, finden viele - vor allem verglichen mit der Karrierepolitikerin Condoleezza Rice oder Kriegstechnokraten vom Schlage eines Paul Wolfowitz.“"
                            },
                            {
                                "example_id": "df9dbbf6-bffa-4ba8-b4eb-b5a607f5f90b",
                                "sense_id": "9878b555-27e9-3867-8a00-6314ea5ba64b",
                                "text": "„Für Bayerns Justizministerin Mathilde Berghofer-Weichner, 61, war die Universität nie ein Platz für Mußestunden. Lediglich sechs Semester ließ sich die Karrierepolitikerin für ihr Jurastudium Zeit, dann ging sie ins Examen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
