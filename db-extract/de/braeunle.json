                "senses": [
                    {
                        "sense_id": "a9c0293b-6632-38af-adf4-4ac641ff5f92",
                        "entry_id": "f1aaffb1-08a7-37c7-84c7-cd0681ed8dc1",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63026c4d-a5d1-44b3-9e95-46d8aecce167",
                                "sense_id": "a9c0293b-6632-38af-adf4-4ac641ff5f92",
                                "text": "Frau Braeunle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cd2116a1-9cb8-49fe-ad7d-55af812acf07",
                                "sense_id": "a9c0293b-6632-38af-adf4-4ac641ff5f92",
                                "text": "Herr Braeunle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7bd4822b-4bba-4d3e-8677-f5f342e52562",
                                "sense_id": "a9c0293b-6632-38af-adf4-4ac641ff5f92",
                                "text": "Die Braeunles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "35d4842c-be0f-4775-b743-0964c303e231",
                                "sense_id": "a9c0293b-6632-38af-adf4-4ac641ff5f92",
                                "text": "Der Braeunle trägt nie die Schals, die die Braeunle ihm strickt."
                            },
                            {
                                "example_id": "5b02b0df-7815-4860-946f-81f1c6313817",
                                "sense_id": "a9c0293b-6632-38af-adf4-4ac641ff5f92",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Braeunle kommt, geht der Herr Braeunle.“"
                            },
                            {
                                "example_id": "524504f4-d907-403b-a85e-99782968ab87",
                                "sense_id": "a9c0293b-6632-38af-adf4-4ac641ff5f92",
                                "text": "Braeunle kommt und geht."
                            },
                            {
                                "example_id": "74f31608-1ec1-469d-9c9c-0280fb52c756",
                                "sense_id": "a9c0293b-6632-38af-adf4-4ac641ff5f92",
                                "text": "Braeunles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
