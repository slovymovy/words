                "senses": [
                    {
                        "sense_id": "fb89acfa-5ad1-31b2-ae2a-1dfaea5f701a",
                        "entry_id": "71e4d0f6-31ad-38f2-86c7-3aa39233ee9c",
                        "glosses": [
                            "halbrundes bis spitz zulaufendes (die Strömung begünstigendes) Teil, welches angeströmt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7a86ddc-c4d0-4b4f-b48d-133bf784eadd",
                                "sense_id": "fb89acfa-5ad1-31b2-ae2a-1dfaea5f701a",
                                "text": "„Die Schalldämpferkulissen sind mit Anströmkalotten zu versehen.“"
                            },
                            {
                                "example_id": "fd5edc39-ec62-4984-9917-6e37c4ee0615",
                                "sense_id": "fb89acfa-5ad1-31b2-ae2a-1dfaea5f701a",
                                "text": "„Bei noch höheren schalltechnischen Anforderungen kommen Kulissenschalldämpfer mit Anströmkalotten zum Einsatz.“"
                            },
                            {
                                "example_id": "6c658778-da5a-479f-a1e2-3c57a643469a",
                                "sense_id": "fb89acfa-5ad1-31b2-ae2a-1dfaea5f701a",
                                "text": "„Die Konstruktion ist als diagonaler Kubus ausgeführt. Für die Revision drehbar gelagert. Ausgestattet mit Anströmkalotte, Ölsammelwanne mit Anschlussstutzen und Revisionstüre.“"
                            },
                            {
                                "example_id": "ecc56fb1-3f83-4543-b58c-80d44973292f",
                                "sense_id": "fb89acfa-5ad1-31b2-ae2a-1dfaea5f701a",
                                "text": "„Eine demontierbare Anströmkalotte bietet Schutz gegen Ablagerungen.“"
                            },
                            {
                                "example_id": "dd9a7593-9bf0-4c5a-be7f-9e076d2b3213",
                                "sense_id": "fb89acfa-5ad1-31b2-ae2a-1dfaea5f701a",
                                "text": "„Gehäuseaußenmantel und Anströmkalotte strömungstechnisch optimiert und aufeinander abgestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
