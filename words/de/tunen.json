                    "frequency": "VeryLow",
                    "semantic_group_id": "optimieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Prominente lassen ihren Körper vor wichtigen Auftritten beim Schönheitschirurgen <w>tunen</w>."
                        },
                        {
                            "text": "Sie entschied sich dafür, ihre Nase und Lippen beim Arzt <w>tunen</w> zu lassen."
                        }
                    ],
                    "common_phrases": [
