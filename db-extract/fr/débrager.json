                "senses": [
                    {
                        "sense_id": "15964891-eeee-3573-b2c0-2a45aed08491",
                        "entry_id": "dde29e58-53d0-3c41-96c0-8dd173f02835",
                        "glosses": [
                            "Se démener."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "b6b8277c-13e5-4e1d-935b-e0deb71870bf",
                                "sense_id": "15964891-eeee-3573-b2c0-2a45aed08491",
                                "text": "Je prends mes précautions pour ne pas embarquer un cofion ou un égarouillé, autrement je pourrais me retrouver à l'eau et là faut se débrager."
                            },
                            {
                                "example_id": "6e66f2cd-adfb-4e64-a4ac-45d8ee3b08e0",
                                "sense_id": "15964891-eeee-3573-b2c0-2a45aed08491",
                                "text": "Sérieux, on se débrage le système logique de notre lobe frontal et on rit de bon coeur avec Napoléon et sa gang d'hurluberlus..."
                            },
                            {
                                "example_id": "497c603d-3433-4b5b-850e-8789b3724a0c",
                                "sense_id": "15964891-eeee-3573-b2c0-2a45aed08491",
                                "text": "J’étais là à courir comme un fou dans la salle, à me débrager dans le vif de la douleur qui avait même pas le pouvoir de s’exprimer dans sa langue d’origine."
                            }
                        ]
                    }
