                "senses": [
                    {
                        "sense_id": "91daed91-9242-301d-a64b-53d8783781e3",
                        "entry_id": "1977cd9f-9558-3d9d-b7d9-87c03840fb64",
                        "glosses": [
                            "The immature young of a marsupial, notably a junior kangaroo, but also a young wallaby, koala, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e511f798-1da8-454e-a1cb-f6ca70c4a43f",
                                "sense_id": "91daed91-9242-301d-a64b-53d8783781e3",
                                "text": "As soon as a joey is born, it crawls into its mother's pouch. The joey grows in the pouch."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c6d65a4-03f0-3229-a457-081c6b918ecf",
                        "entry_id": "1977cd9f-9558-3d9d-b7d9-87c03840fb64",
                        "glosses": [
                            "A young child."
                        ],
                        "tags": [
                            "Australia",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "df590e68-d71e-3592-9967-1fc013bd932d",
                        "entry_id": "1977cd9f-9558-3d9d-b7d9-87c03840fb64",
                        "glosses": [
                            "Ellipsis of joey word."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "57690e91-bb02-45a0-bc9b-3ebb878c72fe",
                                "sense_id": "df590e68-d71e-3592-9967-1fc013bd932d",
                                "text": "Among the kangaroo words that yield the most joviality and joy are those that conceal multiple joeys."
                            },
                            {
                                "example_id": "910c2f0a-ca1e-42a3-8174-93e18e4a364b",
                                "sense_id": "df590e68-d71e-3592-9967-1fc013bd932d",
                                "text": "Sometimes a kangaroo word has more than one joey."
                            }
                        ]
                    },
                    {
                        "sense_id": "049990f5-eaed-367d-b153-8bec7e27a44b",
                        "entry_id": "1977cd9f-9558-3d9d-b7d9-87c03840fb64",
                        "glosses": [
                            "A parcel smuggled in to an inmate."
                        ],
                        "tags": [
