                                "example_id": "56c945fd-1eee-42ea-8fbd-eb80da45d4fe",
                                "sense_id": "8d56facd-42a1-346e-9b38-9508411c07e1",
                                "text": "Ça nous rend ultrafiers, à Marseille."
                            },
                            {
                                "example_id": "834f7377-aed0-40d5-baf9-67c5a4a9f460",
                                "sense_id": "8d56facd-42a1-346e-9b38-9508411c07e1",
                                "text": "J’en suis ultrafier, se réjouit Jérôme Clauss."
                            }
                        ]
