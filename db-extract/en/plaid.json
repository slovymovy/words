            {
                "entry_id": "0bb82f7b-0fe5-3c0d-866b-7a5dd040e4ea",
                "word": "plaid",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "093e7872-47ae-4be3-8005-75cca07be645",
                        "entry_id": "0bb82f7b-0fe5-3c0d-866b-7a5dd040e4ea",
                        "tags": [
