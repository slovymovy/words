{
    "word_family": [
        "вечность",
        "вечно",
        "вековать"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "99defef8-8408-3b33-872a-078a5da9bcd7",
                    "sense_definition": "Бесконечный по времени, не имеющий ни начала, ни конца.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Философы часто размышляют о <w>вечном</w> вопросе смысла жизни.",
                            "target_lang_translations": {
                                "en": "Philosophers often reflect on the <w>eternal</w> question of the meaning of life."
                            }
                        },
                        {
                            "text": "Звезды кажутся нам символом <w>вечного</w> движения вселенной.",
                            "target_lang_translations": {
                                "en": "The stars seem to us a symbol of the <w>eternal</w> movement of the universe."
                            }
                        }
                    ],
                    "synonyms": [
                        "бесконечный"
                    ],
                    "antonyms": [
                        "временный",
                        "преходящий"
                    ],
                    "common_phrases": [
                        "вечный вопрос",
                        "вечный покой"
                    ],
                    "target_lang_definitions": {
                        "en": "Infinite in time, having neither beginning nor end."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eternal",
                                "target_lang_sense_clarification": "Lasting forever; unending."
                            },
                            {
                                "target_lang_word": "everlasting",
                                "target_lang_sense_clarification": "Enduring forever; endless."
                            },
                            {
                                "target_lang_word": "timeless",
                                "target_lang_sense_clarification": "Existing outside of time; eternal."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e36d00ff-0134-3909-b3ee-543dda527f69",
                    "sense_definition": "Непреходящий, не ограниченный сроками, длящийся очень долго или всю жизнь.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они заключили <w>вечный</w> союз дружбы между своими семьями.",
                            "target_lang_translations": {
                                "en": "They formed an <w>everlasting</w> bond of friendship between their families."
                            }
                        },
                        {
                            "text": "Этот памятник стал <w>вечным</w> напоминанием о тех событиях.",
                            "target_lang_translations": {
                                "en": "This monument became an <w>everlasting</w> reminder of those events."
                            }
                        }
                    ],
                    "synonyms": [
                        "бессрочный"
                    ],
                    "antonyms": [
                        "временный"
                    ],
                    "common_phrases": [
                        "вечный огонь",
                        "вечный двигатель"
                    ],
                    "target_lang_definitions": {
                        "en": "Enduring, not limited by time, lasting for a very long time or a lifetime."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "perpetual",
                                "target_lang_sense_clarification": "Lasting for an indefinitely long time."
                            },
                            {
                                "target_lang_word": "everlasting",
                                "target_lang_sense_clarification": "Continuing for a long period."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f5a9687-5d2a-3816-98c3-49cbb2bfad6e",
                    "sense_definition": "Постоянный, неизменный, всегда присутствующий.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него есть <w>вечная</w> привычка опаздывать на все встречи.",
                            "target_lang_translations": {
                                "en": "He has a <w>perpetual</w> habit of being late for all meetings."
                            }
                        },
                        {
                            "text": "В этом городе <w>вечная</w> суета и шум машин.",
                            "target_lang_translations": {
                                "en": "In this city, there is <w>perpetual</w> hustle and the noise of cars."
                            }
                        }
                    ],
                    "synonyms": [
                        "постоянный",
                        "неизменный"
                    ],
                    "antonyms": [
                        "переменчивый"
                    ],
                    "common_phrases": [
                        "вечный спор",
                        "вечный недосып"
                    ],
                    "target_lang_definitions": {
                        "en": "Constant, unchanging, always present."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "perpetual",
                                "target_lang_sense_clarification": "Continuing; uninterrupted; often used for tiresome things."
                            },
                            {
                                "target_lang_word": "constant",
                                "target_lang_sense_clarification": "Occurring continuously over a period of time."
                            },
                            {
                                "target_lang_word": "perennial",
                                "target_lang_sense_clarification": "Recurring again and again; persistent."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}