                "senses": [
                    {
                        "sense_id": "3d1f6017-0a4f-3365-b11c-a5f1d72dcc71",
                        "entry_id": "2b0b4673-7223-3769-8050-9734f93a8727",
                        "glosses": [
                            "To plunder; to pillage; take spoil from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "78c045ae-fe39-40e9-8d90-34742d8685d2",
                                "sense_id": "3d1f6017-0a4f-3365-b11c-a5f1d72dcc71",
                                "text": "[T]here vvas brought unto him an horſe named Babylonius, vvhich happening to be ſore vexed vvith a ſuddaine gripe or vvring in his belly, fell dovvne, and vvhiles hee vvas not able to endure the paine, vvallovveth along, and happeneth to beſprent his capariſon and ornaments richly garniſhed vvith gold and precious ſtones. At vvhich ſtrange ſight he tooke great joy, and cryed out, vvith the applauſe of thoſe next about him, That Babylon vvas fallen, and lay along on the ground diſpoyled of all her ornaments."
                            },
                            {
                                "example_id": "44770219-3adf-4f46-b887-2016406e8977",
                                "sense_id": "3d1f6017-0a4f-3365-b11c-a5f1d72dcc71",
                                "text": "a law which restored to them an immense domain of which they had been despoiled"
                            },
                            {
                                "example_id": "684cdd2f-eee6-4edd-8cf4-0c594636f53f",
                                "sense_id": "3d1f6017-0a4f-3365-b11c-a5f1d72dcc71",
                                "text": "Ripton was familiar with the rod, a monster much despoiled of his terrors by intimacy."
                            },
                            {
                                "example_id": "9051fddc-8945-4588-8a08-1a385da00ee7",
                                "sense_id": "3d1f6017-0a4f-3365-b11c-a5f1d72dcc71",
                                "text": ". Nevertheless, like everything else worth while, however sacred and precious and well-guarded, they have always been subject to attack, mostly by despoiling gainseekers, -- mischief-makers of every degree from Satan to supervisors, lumbermen, cattlemen, farmers, etc., eagerly trying to make everything dollarable, often thinly disguised in smiling philanthropy, calling pocket-filling plunder \"Utilization of beneficent natural resources, that man and beast may be fed and the dear Nation grow great.\""
                            },
                            {
                                "example_id": "705d4244-808b-4e26-b1dd-f3affc0784b3",
                                "sense_id": "3d1f6017-0a4f-3365-b11c-a5f1d72dcc71",
                                "text": "They've come to witness the Beginning. The rebirth of Paradise, despoiled by mankind."
                            },
                            {
                                "example_id": "42c857bf-6cfa-4e8d-baf7-01e0e6907879",
                                "sense_id": "3d1f6017-0a4f-3365-b11c-a5f1d72dcc71",
                                "text": "To dreamers in the West, Tibet is a Shangri-La despoiled by Chinese ruthlessness and rapacity."
                            }
                        ]
                    },
                    {
                        "sense_id": "a85e0a11-f317-3d60-b61c-ec5e5a2d795b",
                        "entry_id": "2b0b4673-7223-3769-8050-9734f93a8727",
                        "glosses": [
                            "To violently strip (someone), with indirect object of their possessions etc.; to rob."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7abd058a-e5ab-4f62-895d-bfa151ec83e1",
                                "sense_id": "a85e0a11-f317-3d60-b61c-ec5e5a2d795b",
                                "text": "The Earl of March, following the plain path which his father had trodden out, despoiled Henry the father, and Edward the son, both of their lives and kingdom."
                            },
                            {
                                "example_id": "e5aa53b5-0d9f-4c02-b13a-f300cdebd2b8",
                                "sense_id": "a85e0a11-f317-3d60-b61c-ec5e5a2d795b",
                                "text": "To intercept thy way, or send thee back / Despoiled of innocence, of faith, of bliss."
                            },
                            {
                                "example_id": "33d931d5-cb0f-438a-99b1-d75cc1f7ef7a",
                                "sense_id": "a85e0a11-f317-3d60-b61c-ec5e5a2d795b",
                                "text": "A law which restored to them an immense domain of which they had been despoiled."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d7b1fca-20a1-3ead-b514-627cce981a32",
                        "entry_id": "2b0b4673-7223-3769-8050-9734f93a8727",
                        "glosses": [
                            "To strip (someone) of their clothes; to undress."
                        ],
                        "tags": [
                            "obsolete",
                            "reflexive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "35d906cf-00e3-4ea2-bddc-0754968a0fbe",
                                "sense_id": "3d7b1fca-20a1-3ead-b514-627cce981a32",
                                "text": "So syr Persants doughter dyd as her fader bad her / and soo she wente vnto syr Beaumayns bed / & pryuely she dispoylled her / & leid her doune by hym / & thenne he awoke & sawe her & asked her what she was"
                            }
                        ]
                    }
