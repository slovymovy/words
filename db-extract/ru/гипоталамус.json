                    {
                        "translation_id": "5946f8c2-3330-4c92-88d8-7007fcd6dfcf",
                        "source_entry_id": "6757dcdc-405d-3cc8-810b-3c3bb366d95a",
                        "source_sense_id": "87d7239d-3857-3fd5-8185-911a35543d1a",
                        "target_lang_word": "Hypothalamus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hypothalamus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                        "entry_id": "670944db-33a0-333b-b6ae-462e31e4c64a",
                                        "glosses": [
                                            "Teil des Zwischenhirns zur Steuerung der vegetativen Funktionen des Körpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd494726-8356-4833-b67b-68b7fc927b9a",
                                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                                "text": "„Bislang gingen Forscher davon aus, dass eine spezialisierte Gehirnregion im so genannten Hypothalamus je nach Tageszeit bestimmte Gene ein- oder ausschaltet.“"
                                            },
                                            {
                                                "example_id": "a610f6d5-fd16-4030-9a65-1f1068635028",
                                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                                "text": "„Verspielte Katzen verwandelten sie von einem Augenblick zum andern durch Stimulierung ihres lateralen Hypothalamus in wilde Tiger und dann ebenso plötzlich wieder in schnurrende Kätzchen.“"
                                            },
                                            {
                                                "example_id": "0090e9ec-c9f1-4bb5-b76d-db4af28704d7",
                                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                                "text": "„Sie legten den Tieren Elektroden an den Hypothalamus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "917fa82c-d5a0-4310-ad87-25aa4832fdc4",
                        "source_entry_id": "6757dcdc-405d-3cc8-810b-3c3bb366d95a",
                        "source_sense_id": "87d7239d-3857-3fd5-8185-911a35543d1a",
                        "target_lang_word": "hypothalamus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypothalamus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ddb4b11f-04d8-3f74-9004-964564d60bfc",
                                        "entry_id": "0c308e6e-ce0b-3f81-83d6-a79a485b99a7",
                                        "glosses": [
                                            "deel van de hersenen dat een directe verbinding heeft met het hormonale systeem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8cff5df-8c59-4efe-b434-4bc8a2dc3153",
                                                "sense_id": "ddb4b11f-04d8-3f74-9004-964564d60bfc",
                                                "text": "De onderzoekers hebben acht muizen met in totaal tien foetussen ongeveer halverwege de zwangerschap 24 uur lang geen eten gegeven. Dat stadium van de zwangerschap is kritiek voor de ontwikkeling van de hypothalamus, die het autonome zenuwstelsel aanstuurt."
                                            },
                                            {
                                                "example_id": "39af7b4f-aa6f-42d6-b238-f6e13bb8333f",
                                                "sense_id": "ddb4b11f-04d8-3f74-9004-964564d60bfc",
                                                "text": "Als het orgasme plaatsvindt, piekt de activiteit in de hersenen. Dat gebeurt in de zogenaamde hypothalamus, wat een chemische 'explosie' veroorzaakt. Na het orgasme neemt de activiteit meteen af."
                                            },
                                            {
                                                "example_id": "4702e8db-0e17-471c-b0a7-5a8db26f1b09",
                                                "sense_id": "ddb4b11f-04d8-3f74-9004-964564d60bfc",
                                                "text": "Ook stimuleert alcohol de hypothalamus. Dit is een deel van de hersenen dat je slaapritme, lichaamstemperatuur en honger regelt. Wanneer de hypothalamus wordt gestimuleerd, krijgen we honger op momenten dat we helemaal geen honger hebben."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
