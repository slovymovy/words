{
    "word_family": [
        "infestation",
        "infestant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31ef6cbd-2c87-3015-ab17-fd19cb649d05",
                    "sense_definition": "To inhabit a place in unpleasantly large numbers; to plague, harass.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many types of insects <w>infest</w> the basement during the humid summer months.",
                            "target_lang_translations": {
                                "ru": "Многие виды насекомых <w>кишат</w> в подвале в течение влажных летних месяцев."
                            }
                        },
                        {
                            "text": "Do not <w>infest</w> your mind with worries about things you cannot change.",
                            "target_lang_translations": {
                                "ru": "Не <w>терзайте</w> свой разум беспокойством о вещах, которые вы не можете изменить."
                            }
                        }
                    ],
                    "synonyms": [
                        "plague"
                    ],
                    "common_phrases": [
                        "infest the home",
                        "infest the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заполнять собой какое-либо место в неприятно большом количестве; досаждать, мучить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кишеть",
                                "target_lang_sense_clarification": "о большом количестве вредителей или насекомых в помещении"
                            },
                            {
                                "target_lang_word": "наводнять",
                                "target_lang_sense_clarification": "о массовом появлении чего-либо нежелательного"
                            },
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "о навязчивых мыслях или беспокойстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e3c572c-19d9-3ad9-8ba5-b4713e679f49",
                    "sense_definition": "To invade a host plant or animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certain types of beetles <w>infest</w> the leaves of the oak tree every spring.",
                            "target_lang_translations": {
                                "ru": "Определенные виды жуков <w>поражают</w> листья дуба каждую весну."
                            }
                        },
                        {
                            "text": "Parasites often <w>infest</w> the skin of animals living in poor conditions.",
                            "target_lang_translations": {
                                "ru": "Паразиты часто <w>поражают</w> кожу животных, живущих в плохих условиях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "infest host plants"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поражать растение или животное (о паразитах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поражать",
                                "target_lang_sense_clarification": "о воздействии паразитов на организм"
                            },
                            {
                                "target_lang_word": "заражать",
                                "target_lang_sense_clarification": "о проникновении паразитов в ткани"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f68d7042-e9e1-31bf-83e5-130c24f36a47",
                    "sense_definition": "Mischievous; hurtful; harassing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight fought with a <w>infest</w> spirit against his many enemies.",
                            "target_lang_translations": {
                                "ru": "Рыцарь сражался с <w>враждебным</w> духом против своих многочисленных врагов."
                            }
                        },
                        {
                            "text": "He launched an <w>infest</w> attack that left his opponent completely defenseless.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>злобную</w> атаку, которая оставила его противника совершенно беззащитным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Враждебный, злобный, причиняющий вред (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враждебный",
                                "target_lang_sense_clarification": "выражающий неприязнь"
                            },
                            {
                                "target_lang_word": "злобный",
                                "target_lang_sense_clarification": "исполненный злобы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d719ecc-65f4-30b6-8cbe-26119e794a14",
                    "sense_definition": "Hostility.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>infest</w> of the crowd caught the guards by surprise.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>враждебность</w> толпы застала стражников врасплох."
                            }
                        },
                        {
                            "text": "His words were filled with a deep <w>infest</w> toward his former allies.",
                            "target_lang_translations": {
                                "ru": "Его слова были наполнены глубокой <w>неприязнью</w> к бывшим союзникам."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Враждебность, неприязнь (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враждебность",
                                "target_lang_sense_clarification": "состояние неприязни"
                            },
                            {
                                "target_lang_word": "неприязнь",
                                "target_lang_sense_clarification": "чувство недоброжелательности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}