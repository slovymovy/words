                                            {
                                                "example_id": "4c819592-3216-43e4-93d9-d35a484e1c65",
                                                "sense_id": "ee1cc326-8f9a-3baa-904f-87fd230d5a28",
                                                "text": "„Man ist nicht zu betrunken, solange man auf dem Boden liegen kann, ohne sich festzuhalten.“ - Finnisches Sprichwort"
                                            },
                                            {
                                                "example_id": "6e239cff-339a-456b-ae11-88ee59e7b7bf",
                                                "sense_id": "ee1cc326-8f9a-3baa-904f-87fd230d5a28",
                                                "text": "Heike ist jedes Wochenende betrunken."
                                            },
                                            {
                                                "example_id": "8ef9a862-a562-4523-bd0a-d316b5266f11",
                                                "sense_id": "ee1cc326-8f9a-3baa-904f-87fd230d5a28",
                                                "text": "„Als er zwei Mal mit seiner Pistole betrunken herumgeballert hatte, drohte seine Frau, ihn auf der Stelle zu verlassen.“"
                                            },
                                            {
                                                "example_id": "ea14d875-c76e-4ef4-b6e3-0e4506dbde35",
                                                "sense_id": "ee1cc326-8f9a-3baa-904f-87fd230d5a28",
                                                "text": "„In einer Ecke zankten sich zwei betrunkene Frauen mittleren Alters um einen noch älteren und betrunkeneren Kerl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
