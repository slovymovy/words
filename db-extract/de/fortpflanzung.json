                                "target_senses": [
                                    {
                                        "sense_id": "ccd2a9be-cf33-36f7-b4f4-f7617ef449d5",
                                        "entry_id": "19145655-2a1d-39a4-850e-f76eaf19220b",
                                        "glosses": [
                                            "The act of reproducing new individuals biologically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d0ad7b-44e8-4115-bb4c-e3b621614b9c",
                                                "sense_id": "ccd2a9be-cf33-36f7-b4f4-f7617ef449d5",
                                                "text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00f4bd42-a2ef-38d3-95ed-121fd097e566",
                                        "entry_id": "19145655-2a1d-39a4-850e-f76eaf19220b",
                                        "glosses": [
                                            "The act of making copies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae883699-3fb8-464c-932b-2c025835ada0",
                                                "sense_id": "00f4bd42-a2ef-38d3-95ed-121fd097e566",
                                                "text": "Unauthorized reproduction of this article is prohibited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d4af2a3-2fc3-399f-b7d4-c141ddcda236",
                                        "entry_id": "19145655-2a1d-39a4-850e-f76eaf19220b",
                                        "glosses": [
                                            "A copy of something, as in a piece of art; a duplicate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "812f2049-a191-4ff7-acdf-eac7d76fd67e",
                                                "sense_id": "5d4af2a3-2fc3-399f-b7d4-c141ddcda236",
                                                "text": "Jim was proud of the Rembrandt reproduction he owned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe2b41f-7e79-3d27-a270-963ce4e04ef0",
                                        "entry_id": "19145655-2a1d-39a4-850e-f76eaf19220b",
                                        "glosses": [
                                            "A method for reproducing a bug or problem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca9ae5a8-3e56-40ea-add1-922400c65da9",
                                                "sense_id": "bfe2b41f-7e79-3d27-a270-963ce4e04ef0",
                                                "text": "Could you file a bug at on the issue tracker with a minimum reproduction so that we can investigate?"
                                            }
                                        ]
