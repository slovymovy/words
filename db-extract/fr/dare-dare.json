                                            {
                                                "example_id": "bdbd8a34-8459-4b1e-993b-2a0bbcadbeea",
                                                "sense_id": "2266983e-db49-3b76-9ab2-43b075fc6208",
                                                "text": "Ja, das haben wir mal eben so auf die Schnelle gesagt."
                                            },
                                            {
                                                "example_id": "a1f0c4e6-75a6-4e7a-abd4-617df090affc",
                                                "sense_id": "2266983e-db49-3b76-9ab2-43b075fc6208",
                                                "text": "Diese Frage wird Ihnen wohl auf die Schnelle keiner beantworten können."
                                            },
                                            {
                                                "example_id": "b6d7da5d-c4e0-42bc-800c-e792802fef5a",
                                                "sense_id": "2266983e-db49-3b76-9ab2-43b075fc6208",
                                                "text": "„Was einem alles auf die Schnelle auffiel: Hanns trug einen eleganten Mantel.“"
                                            },
                                            {
                                                "example_id": "ee6d26bc-7e86-4fb6-8bb8-3c649da9d1c1",
                                                "sense_id": "2266983e-db49-3b76-9ab2-43b075fc6208",
                                                "text": "„Ein großer Kobaltlieferant ließe sich mitten im Hochlauf der Elektromobilität auf die Schnelle kaum ersetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
