                                        "entry_id": "04d8c69c-3b39-317c-83f8-291a2b1124bf",
                                        "glosses": [
                                            "Zustand/Verfassung einer Frau, die Witwe ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa9e774f-fc88-4d21-9a1a-93c879a1c39d",
                                                "sense_id": "74b73f88-bd55-3d9d-b57b-f738c4c6daee",
                                                "text": "„Denn Mrs. Wetzel genoß zu guten Rufes unter den Männern von Hebron, als daß man sie schutzlos der Untüchtigkeit ihrer eigenen Landsleute und der Trübsal dauernder Witwenschaft hätte überlassen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
