                                        "glosses": [
                                            "člověk, který natáčí a zveřejňuje na serveru YouTube videa, ve kterých často i sám účinkuje"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c07c56fa-52fe-4de0-baf1-de9f8bbca079",
                                                "sense_id": "ab65ff3b-c68d-3307-9a8b-14355fe14e90",
                                                "text": "Aby se v Česku youtubeři uživili, musí dělat různé product placementy a spolupráce, což jsme nechtěli."
                                            },
                                            {
                                                "example_id": "2ad334a9-5b07-42b7-9b13-acfe75953887",
                                                "sense_id": "ab65ff3b-c68d-3307-9a8b-14355fe14e90",
                                                "text": "Dvaadvacetiletého youtubera policie stíhá za to, že celkem ve čtrnácti případech nahrál na internet videa s tematikou drog."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
