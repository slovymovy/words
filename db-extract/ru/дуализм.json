                                    {
                                        "sense_id": "02d85885-906d-34d5-9608-ab7e8b22b5d7",
                                        "entry_id": "2c582da9-4ddd-3280-a98a-c80351334309",
                                        "glosses": [
                                            "das Bestehen von zwei Elementen Gut und Böse, nebeneinander oder einander gegenüber"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d219f305-38a5-4dc5-9b07-95f598acdf79",
                                                "sense_id": "02d85885-906d-34d5-9608-ab7e8b22b5d7",
                                                "text": "So wenig es der positivistischen oder irgendeiner anderen Theorie möglich ist, den Dualismus von Erfahrung und Idee, von Tatsachen und Einfällen zum Verschwinden zu bringen, […], so wenig erscheint es möglich, den Dualismus von Sein und Sollen, von Wert und Wirklichkeit, aus der Welt zu schaffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a1f00148-930f-321f-a677-ae9f6a9f8f12",
                                        "entry_id": "2c582da9-4ddd-3280-a98a-c80351334309",
                                        "glosses": [
                                            "die Annahme, dass alles auf nur zwei ursprüngliche, nicht auseinander herzuleitende Prinzipien gegründet sei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ca31b9-baad-4317-be05-ad02cc17ed74",
                                                "sense_id": "a1f00148-930f-321f-a677-ae9f6a9f8f12",
                                                "text": "Der Dualismus ist eine Weltanschauung und Betrachtungsweise."
                                            },
                                            {
                                                "example_id": "f8fcfa7f-7818-4293-bdba-4a784e893621",
                                                "sense_id": "a1f00148-930f-321f-a677-ae9f6a9f8f12",
                                                "text": "Die Philosophie vom Dualismus finden wir vor allem beim persischen Reformer und Religionsstifter Zarathustra."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
