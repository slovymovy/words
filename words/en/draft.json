                                "target_lang_word": "идти в потоке",
                                "target_lang_sense_clarification": "за лидером"
                            },
                            {
                                "target_lang_word": "слипстримить",
                                "target_lang_sense_clarification": "в гонках"
                            }
                        ]
                    }
                }
            ]
        },
