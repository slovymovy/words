                                "target_senses": [
                                    {
                                        "sense_id": "579956d1-a6d3-3f2a-97c5-4080edafa372",
                                        "entry_id": "b9ec83d6-0e92-3a73-9f96-397bbd80e753",
                                        "glosses": [
                                            "hard wasachtig grijs product gevonden in de maag van potvissen dat bestaat uit verteerde rugschilden van reuzeninktvissen die het hoofdvoedsel van de potvis vormen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78751d5e-a1df-4b57-8815-e46692742296",
                                                "sense_id": "579956d1-a6d3-3f2a-97c5-4080edafa372",
                                                "text": "Haar korte haren kriebelden in zijn hals, ze rook naar amber, hij hield haar tegen zich aan, probeerde haar te zoenen, kuste mis."
                                            },
                                            {
                                                "example_id": "12211f9c-7770-4789-bc3a-b23f1f8b5332",
                                                "sense_id": "579956d1-a6d3-3f2a-97c5-4080edafa372",
                                                "text": "De walvis, met name de potvis, bracht de wereld decennialang olie, amber en baleinen – en een klassiek geworden en nog steeds herdrukt boek over de strijd van een kapitein (Ahab) tegen een witte potvis (Moby Dick), tegen God en tegen zichzelf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd58edcd-986c-3b9f-befc-c27298f860e1",
                                        "entry_id": "b9ec83d6-0e92-3a73-9f96-397bbd80e753",
                                        "glosses": [
                                            "fossiel hars van bomen met geel-oranje kleur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e37c901f-b373-47dc-ba78-3e4855b70c29",
                                                "sense_id": "bd58edcd-986c-3b9f-befc-c27298f860e1",
                                                "text": "Op het lijf van een in amber versteende schimmelmug van 45 miljoen jaar oud werden in 2017 stuifmeelkorrels van orchideeën aangetroffen."
                                            },
                                            {
                                                "example_id": "2e47e908-e677-4bfe-9a82-c4152e5b9ca9",
                                                "sense_id": "bd58edcd-986c-3b9f-befc-c27298f860e1",
                                                "text": "Zelfs al zou dat de wereldvoorraad van amber en goud aanvullen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "631e9613-7b45-347d-a065-bec697b15439",
                                        "entry_id": "b9ec83d6-0e92-3a73-9f96-397bbd80e753",
                                        "glosses": [
                                            "kleur tussen geel en oranje in"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ebfa45-c70f-4dbc-b55e-5424e3d77950",
                                                "sense_id": "631e9613-7b45-347d-a065-bec697b15439",
                                                "text": "Heeft u die ook in het amber?"
                                            },
                                            {
                                                "example_id": "6d041c92-9e8d-49d6-9999-f4f25be0a0aa",
                                                "sense_id": "631e9613-7b45-347d-a065-bec697b15439",
                                                "text": "De amber gekleurde markeringslichten en reflectoren moet je altijd aan de zijkant van het voertuig bevestigen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
