                        "examples": [
                            {
                                "example_id": "c5d90535-7ee7-4c39-b683-e5686180ee9d",
                                "sense_id": "60d7f85c-545c-37cf-958e-8f05191c0ccb",
                                "text": "On trouva vite une explication, c'étais un phénomène de nanification insulaire !"
                            },
                            {
                                "example_id": "2159882d-6839-4378-945c-ac5ef61284ea",
                                "sense_id": "60d7f85c-545c-37cf-958e-8f05191c0ccb",
                                "text": "La nanification insulaire désigne un phénomène affectant certaines espèces animales isolées dans des îles, dont la taille s'est réduite au fil des générations."
                            },
                            {
                                "example_id": "7d8f3ae2-4ccf-4bac-878a-2b16c8f06ba6",
                                "sense_id": "60d7f85c-545c-37cf-958e-8f05191c0ccb",
                                "text": "Nombre d'aquariophiles s'inspirent en effet de l'art japonais du bonsaï, une technique de nanification des végétaux elle-même héritée, comme les suiseki, de la civilisation chinoise."
                            }
                        ]
                    }
