                "senses": [
                    {
                        "sense_id": "97d60ac6-63c3-301f-8840-0626375890f1",
                        "entry_id": "8c7041d4-e099-3b69-9416-aad338c9b164",
                        "glosses": [
                            "Amtsbezeichnung eines Polizeibeamten im gehobenen Dienst der deutschen Polizei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "218c1ac4-f920-41e1-ad15-ade5645741eb",
                                "sense_id": "97d60ac6-63c3-301f-8840-0626375890f1",
                                "text": "In Deutschland ist ein Polizeikommissar ein Beamter."
                            },
                            {
                                "example_id": "0249f340-4604-4362-b3c9-7671d68d5e08",
                                "sense_id": "97d60ac6-63c3-301f-8840-0626375890f1",
                                "text": "„Doch schon am nächsten Abend geben zwei belgische Polizeikommissare den Befehl, die Körper wieder auszugraben und fortzuschaffen.“"
                            },
                            {
                                "example_id": "bfc8be08-d15e-4344-b110-d68ee48f63d4",
                                "sense_id": "97d60ac6-63c3-301f-8840-0626375890f1",
                                "text": "„Seine Zeit als Polizeikommissar von Siglufjörđur war bisher ruhig verlaufen, Gott sei Dank war er vor Derartigem verschont geblieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
