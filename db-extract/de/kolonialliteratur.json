                "senses": [
                    {
                        "sense_id": "5b7ca108-dce3-3e34-a673-bbea4c4d1501",
                        "entry_id": "c9916d0b-95eb-3045-bdc0-9c15586da3a8",
                        "glosses": [
                            "Sammelbegriff für Druckwerke, deren Inhalt die Darstellung von Verhältnissen/Vorgängen in auswärtigen Gebieten eines Staates ohne eigene politische und wirtschaftliche Macht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d596bde-ac26-480b-a286-562441816ec7",
                                "sense_id": "5b7ca108-dce3-3e34-a673-bbea4c4d1501",
                                "text": "„In der Abenteuer- und Kolonialliteratur erscheinen die afrikanischen Landschaften als ein vom Zauber der Unberührtheit aufgeladener, verlockender Raum der Leere.“"
                            },
                            {
                                "example_id": "0a4222dc-fea2-47f2-83be-47c855a26ac7",
                                "sense_id": "5b7ca108-dce3-3e34-a673-bbea4c4d1501",
                                "text": "„Einen wirklichen Aufschwung in der Produktion von Kolonialliteratur erlebt Deutschland also erst in der Zeit des kolonialen Revisionismus, das heißt zwischen 1919 und 1945.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
