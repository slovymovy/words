                "senses": [
                    {
                        "sense_id": "ff81b16c-0780-3777-8659-8567baad6479",
                        "entry_id": "8da41f0d-f268-3976-9bc1-82b5d10a610c",
                        "glosses": [
                            "Zisterne, in die das Wasser durch Sandfilter hineinläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "300e0d8d-9bed-497f-8b20-fdab089df67a",
                                "sense_id": "ff81b16c-0780-3777-8659-8567baad6479",
                                "text": "„Einige Meter östlich liegt ein Rundbau, dessen Funktion anfangs Rätsel aufgab.Untersuchungen ergaben, dass es sich um eine, in Mitteldeutschland seltene Filterzisterne mit etwa 12 Meter tiefer Schöpfröhre handelt.“"
                            },
                            {
                                "example_id": "3a898a40-c704-4c79-8002-239a6ff3c60e",
                                "sense_id": "ff81b16c-0780-3777-8659-8567baad6479",
                                "text": "„Die Filterzisterne im Gelände des Arnstädter Walpurgisklosters zählt übrigens zu den größten, bisher bekannten mittelalterlichen Wasseraufbereitungsanlagen dieser Art in Europa.“"
                            },
                            {
                                "example_id": "8e026622-03e6-4e37-9d53-b76f41c167f1",
                                "sense_id": "ff81b16c-0780-3777-8659-8567baad6479",
                                "text": "„In der Station werden unter anderem Würfelnattern und Mauereidechsen gezeigt, aber auch auf die Geschichte des Kurorts mit einem Gradierwerkmodell und einer Filterzisterne hingewiesen.“"
                            },
                            {
                                "example_id": "187d7e43-ea9b-4afd-bc67-f9471c966130",
                                "sense_id": "ff81b16c-0780-3777-8659-8567baad6479",
                                "text": "„Auf einem Gelände in der Bäckerstraße sei eine alte Filterzisterne entdeckt worden, die ebenfalls im Zusammenhang mit der Burg gestanden haben müsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
