{
    "word_family": [
        "dril",
        "driller"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "778e81c8-6655-3f24-9c7b-20b33dd4fc42",
                    "sense_definition": "Iemand door middel van herhaalde, strikte oefeningen iets aanleren, vaak in een militaire context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "training",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sergeant <w>drilde</w> de nieuwe rekruten tot ze de commando's perfect uitvoerden.",
                            "target_lang_translations": {
                                "fr": "Le sergent a <w>dressé</w> les nouvelles recrues jusqu'à ce qu'elles exécutent les ordres parfaitement."
                            }
                        },
                        {
                            "text": "De leraar <w>drilde</w> de leerlingen op hun woordjes totdat iedereen ze uit het hoofd kende.",
                            "target_lang_translations": {
                                "fr": "Le professeur a fait <w>répéter</w> les élèves jusqu'à ce que tout le monde connaisse les mots par cœur."
                            }
                        }
                    ],
                    "synonyms": [
                        "africhten",
                        "trainen"
                    ],
                    "common_phrases": [
                        "leerlingen drillen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Enseigner quelque chose à quelqu'un par des exercices répétés et stricts, souvent dans un contexte militaire."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "dresser",
                                "target_lang_sense_clarification": "pour un entraînement intensif et discipliné"
                            },
                            {
                                "target_lang_word": "faire répéter",
                                "target_lang_sense_clarification": "pour l'apprentissage par cœur"
                            },
                            {
                                "target_lang_word": "entraîner",
                                "target_lang_sense_clarification": "pour une préparation rigoureuse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dc97f17-ec0a-3446-9524-9fad9ca200d4",
                    "sense_definition": "Het trillen of schudden van een voorwerp.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trillen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De pudding bleef nog lang na <w>drillen</w> nadat de schaal op tafel werd gezet.",
                            "target_lang_translations": {
                                "fr": "Le pudding a continué à <w>trembler</w> longtemps après que le plat a été posé sur la table."
                            }
                        },
                        {
                            "text": "Door de zware machine begon de hele vloer te <w>drillen</w>.",
                            "target_lang_translations": {
                                "fr": "À cause de la lourde machine, tout le sol a commencé à <w>vibrer</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "trillen",
                        "schudden"
                    ],
                    "target_lang_definitions": {
                        "fr": "Le fait pour un objet de vibrer ou de trembler."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "trembler",
                                "target_lang_sense_clarification": "mouvement oscillatoire d'un objet"
                            },
                            {
                                "target_lang_word": "vibrer",
                                "target_lang_sense_clarification": "oscillation rapide"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3af083b9-1c0a-3b7b-b1e0-075aef462d9c",
                    "sense_definition": "Het maken van een gat met een boor.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakman moet een gat in de muur <w>drillen</w> om de plank op te hangen.",
                            "target_lang_translations": {
                                "fr": "L'artisan doit <w>percer</w> un trou dans le mur pour accrocher l'étagère."
                            }
                        },
                        {
                            "text": "Hij is de hele ochtend bezig geweest om gaten te <w>drillen</w> in het beton.",
                            "target_lang_translations": {
                                "fr": "Il a passé toute la matinée à <w>percer</w> des trous dans le béton."
                            }
                        }
                    ],
                    "synonyms": [
                        "boren"
                    ],
                    "common_phrases": [
                        "gaten drillen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Faire un trou à l'aide d'une perceuse."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "percer",
                                "target_lang_sense_clarification": "action de faire un trou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ef6848f-cc6e-35ef-a6a6-e5d72d7c2675",
                    "sense_definition": "Op een dwingende of overheersende manier de baas spelen over anderen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "training",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De manager probeert zijn team te <w>drillen</w> met onredelijke eisen.",
                            "target_lang_translations": {
                                "fr": "Le manager essaie de <w>commander</w> son équipe avec des exigences déraisonnables."
                            }
                        },
                        {
                            "text": "Hij laat zich niet zomaar door zijn collega's <w>drillen</w>.",
                            "target_lang_translations": {
                                "fr": "Il ne se laisse pas <w>dominer</w> par ses collègues."
                            }
                        }
                    ],
                    "synonyms": [
                        "domineren",
                        "commanderen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Commander ou diriger les autres de manière autoritaire ou dominatrice."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "commander",
                                "target_lang_sense_clarification": "donner des ordres de façon autoritaire"
                            },
                            {
                                "target_lang_word": "dominer",
                                "target_lang_sense_clarification": "exercer une influence écrasante"
                            }
                        ]
                    }
                }
            ]
        },
