                    {
                        "sense_id": "725989fb-b21c-3955-977e-c31bc844f8fe",
                        "entry_id": "02da875c-3453-38f0-80ae-55fa109f729d",
                        "glosses": [
                            "Vorgang, bei dem eine Mücke durch die Haut Blut saugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3166eb5d-5ebd-4762-a12e-cb66773303e1",
                                "sense_id": "725989fb-b21c-3955-977e-c31bc844f8fe",
                                "text": "Den Mückenstich selbst spürt man kaum, da der Rüssel, mit dem sie stechen, sehr dünn ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a3cb3095-8ec0-3927-81e7-82a664a6a05b",
                        "entry_id": "02da875c-3453-38f0-80ae-55fa109f729d",
                        "glosses": [
                            "juckende Stelle auf der Haut, die bei [1] zurückbleibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb89b4eb-3bda-40d9-bf84-f1de49d36e00",
                                "sense_id": "a3cb3095-8ec0-3927-81e7-82a664a6a05b",
                                "text": "Der Mückenstich juckt sehr heftig."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ba55455-ce89-45d5-acdb-f7acca3e4991",
                        "source_entry_id": "02da875c-3453-38f0-80ae-55fa109f729d",
                        "source_sense_id": "a3cb3095-8ec0-3927-81e7-82a664a6a05b",
                        "target_lang_word": "mosquito bite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mosquito bite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29d292cf-0e83-3a49-b142-5c04ce157b00",
                                        "entry_id": "ca4f0e67-ac1b-3a66-a35a-2da7ebfb43ea",
                                        "glosses": [
                                            "A small breast of a woman."
                                        ],
                                        "tags": [
                                            "plural-normally",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50201080-db5e-4a25-b881-37f605a7d8be",
                                                "sense_id": "29d292cf-0e83-3a49-b142-5c04ce157b00",
                                                "text": "Well, Adam didn't seem to have a problem with the size of her breasts. Paige had found that if a guy was thrown by her mosquito bites, he'd do one of two things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef4b1d4d-3e4c-3cd4-9973-58d3714a5216",
                                        "entry_id": "ca4f0e67-ac1b-3a66-a35a-2da7ebfb43ea",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see mosquito, bite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf2a5793-fa4b-497e-aa78-dec8b4ce1264",
                                                "sense_id": "ef4b1d4d-3e4c-3cd4-9973-58d3714a5216",
                                                "text": "Half your bones are busted, your body is swollen like one huge mosquito bite, and you're nearly starved to death. Believe me, Champ, you're not okay."
                                            },
                                            {
                                                "example_id": "fb67d39d-540f-4736-b9a8-405619f659c1",
                                                "sense_id": "ef4b1d4d-3e4c-3cd4-9973-58d3714a5216",
                                                "text": "From there, the cycle may be initiated once again when the sporozoites are released into the blood stream during a mosquito bite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
