                                                "sense_id": "52b22707-6ebf-3130-8b63-aecd4f7d02ae",
                                                "text": "I was on my seat and she stood opposite."
                                            },
                                            {
                                                "example_id": "eb67e0a0-90bb-439b-b77f-1e24a960fb11",
