                        "form": "antipapes"
                    },
                    {
                        "form_id": "2f6772a4-545e-4ca9-9607-2e7fd4012032",
                        "entry_id": "d096a084-b39b-3c71-bafd-7ab7bfae464a",
                        "tags": [],
                        "form": "anti-pape"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fdb63fa-cc95-3a35-8a70-7092f9170932",
                        "entry_id": "d096a084-b39b-3c71-bafd-7ab7bfae464a",
                        "glosses": [
                            "Prétendant non reconnu par l'Église catholique romaine au titre de pape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc31dca5-063a-4940-944d-3bc8c657a0e8",
                                "sense_id": "4fdb63fa-cc95-3a35-8a70-7092f9170932",
                                "text": "D'après les frères de Sainte-Marthe, un moine de l'ordre de Saint-Benoit aurait occupé, en 1421, le siège de Bethléem. Il s'agit ici ([…]), soit d'un prélat in partibus de Bethléem de Judée, soit d'un évêque espagnol de la création de l’antipape Benoit XIII."
                            },
                            {
                                "example_id": "3616f44d-cf04-45af-b584-5b59069697d6",
                                "sense_id": "4fdb63fa-cc95-3a35-8a70-7092f9170932",
                                "text": "Il ne cède ni devant lʼantipape dʼAvignon, ni devant le concile de Pise (1409), mais accepte finalement sa destitution par le concile de Constance au profit de Martin V."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ffd7286-4516-4647-89a6-1a37e54f105c",
                        "source_entry_id": "d096a084-b39b-3c71-bafd-7ab7bfae464a",
                        "source_sense_id": "4fdb63fa-cc95-3a35-8a70-7092f9170932",
                        "target_lang_word": "Gegenpapst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenpapst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb95d11f-9ca2-3c63-b11d-b2dbbce7849e",
                                        "entry_id": "d085b23b-a6d8-3691-92b9-bcf563737303",
                                        "glosses": [
                                            "Papst, der zu Lebzeiten eines bereits kanonisch gewählten (und nicht zurückgetretenen) Papstes aufgestellt wurde"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bb4466b-d274-4144-80d8-4d618bd24daa",
                                                "sense_id": "eb95d11f-9ca2-3c63-b11d-b2dbbce7849e",
                                                "text": "Im ersten Jahrtausend nach Christi gab es die meisten Gegenpäpste. Heute gibt es so etwas nicht mehr."
                                            },
                                            {
                                                "example_id": "df626e5d-2053-43a2-a23e-cef99a45cab2",
                                                "sense_id": "eb95d11f-9ca2-3c63-b11d-b2dbbce7849e",
                                                "text": "„Während der Kaiser von ihm zugewandten Kardinälen einen Gegenpapst nach dem anderen einsetzen ließ, feuerte Alexander das geistliche Strafregister von Kirchenbann und Exkommunikation auf Barbarossa und seine Gefolgsleute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21e4c85e-f7f9-4a6f-898a-6f49516d4940",
                        "source_entry_id": "d096a084-b39b-3c71-bafd-7ab7bfae464a",
                        "source_sense_id": "4fdb63fa-cc95-3a35-8a70-7092f9170932",
                        "target_lang_word": "antipope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antipope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e03e6d7-4a8e-3a7b-8c28-7c270f6dea84",
                                        "entry_id": "23571206-66f1-3e9c-a763-d41fbc1aaa2e",
                                        "glosses": [
                                            "A person who claims or claimed to be the pope, usually as the result of a disputed election or deposition, but is not considered by the Roman Catholic Church to be the real pope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2faf8377-6c32-4139-95c3-7801c6aa40e6",
                                                "sense_id": "9e03e6d7-4a8e-3a7b-8c28-7c270f6dea84",
                                                "text": "Meanwhile support for the ‘puppet’ antipope Nicholas V, deprived of his protector and by now excommunicated along with his emperor, rapidly withered away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c662571-52be-429f-9307-d152bd5c19a1",
                        "source_entry_id": "d096a084-b39b-3c71-bafd-7ab7bfae464a",
                        "source_sense_id": "4fdb63fa-cc95-3a35-8a70-7092f9170932",
                        "target_lang_word": "antipapa",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antipapa",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "468d2e69-bd72-3118-9ba7-fa18a6b8bb4a",
                                        "entry_id": "54a67b0d-1917-30b3-9e0e-d66ce63b3728",
                                        "glosses": [
                                            "Varón que usurpa –o intenta usurpar– las funciones de Papa de la Iglesia católica apostólica romana legítimamente elegido."
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa0f4ce8-fa66-4da8-b0c9-8bd0f9e8df1e",
                                                "sense_id": "468d2e69-bd72-3118-9ba7-fa18a6b8bb4a",
                                                "text": "Del extraño caso de Hipólito de Roma, antipapa y santo, en el día de su festividad. El de San Hipólito es un caso especial dentro de la vida de la Iglesia, pues como bien se dice en el título de este artículo, se trata de un extravagante personaje que siendo antipapa como fue, subió sin embargo a los altares, algo posible gracias a su muerte martirial acompañada de la reconciliación previa"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "antipapa",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab5dac6-67ca-3069-b266-65a76e9871d5",
                                        "entry_id": "fdd763fe-acef-38be-916c-119e5e28a742",
                                        "glosses": [
                                            "Persona que se opone a un Papa en particular o a las funciones y consecuencias que implican su papado o a la institución que este dignatario representa: la Iglesia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef1be8e-576c-4dd4-bebf-7fb587b7c492",
                                                "sense_id": "2ab5dac6-67ca-3069-b266-65a76e9871d5",
                                                "text": "La Delegación del Gobierno en Madrid ha prohibido el recorrido de la manifestación \"antipapa\" convocada para el 17 de agosto, que pretendía pasar por comenzar en Tirso de Molina y acabar en Sol, así como otros dos itinerarios alternativos, pero, en cambio, ha propuesto que la marcha transcurra por el barrio de Lavapiés, sugerencia que será rechazada por los organizadores de la marcha, según ha podido saber este medio"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
