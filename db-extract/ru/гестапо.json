                    },
                    {
                        "translation_id": "7fccf712-7010-47c5-ba4c-ccac68060701",
                        "source_entry_id": "a6c0c8da-bed8-3ddb-b97b-28bdeeefd613",
                        "source_sense_id": "092069cf-1d74-3dd8-ac1a-5f20ba6e0416",
                        "target_lang_word": "盖世太保",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3d294153-616d-48e8-9fc3-e73da1299348",
                        "source_entry_id": "a6c0c8da-bed8-3ddb-b97b-28bdeeefd613",
                        "source_sense_id": "092069cf-1d74-3dd8-ac1a-5f20ba6e0416",
                        "target_lang_word": "Gestapo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gestapo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                        "entry_id": "c63c7bcf-a22f-3ecb-98fc-c9cba8e43b65",
                                        "glosses": [
                                            "Polizeibehörde zur Zeit des Nationalsozialismus, deren Aufgabenbereich besonders die Aufdeckung von politischen Straftaten und die Verfolgung von Regimegegnern umfasste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1e9e060-cdf6-4197-b732-dc7b2b817ad3",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "„Mohr hatte schon die Freilassung Sophie Scholls angeordnet, da fand die Gestapo in der Wohnung ihres Bruders erdrückende Beweise.“"
                                            },
                                            {
                                                "example_id": "d0834653-4722-46c6-9231-ec67f859de46",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "„Kapitan Klos sollte dem Publikum die intellektuelle Überlegenheit eines polnischen Spions über die deutsche SS oder die Gestapo zeigen, was bei Zuschauern unter zwölf auch gelang.“"
                                            },
                                            {
                                                "example_id": "c9b5ecc6-f252-497d-a5ef-d36ab70a0df8",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "„In Berlin gab es damals in dieser Hinsicht, trotz Gestapo, noch alles, was das Herz begehrte.“"
                                            },
                                            {
                                                "example_id": "c8af4dac-5627-4d0f-8476-3100b7170e45",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "„Man konnte nicht vorsichtig genug sein in diesen Zeiten, wo jeder der Spion des andern war, die Gestapo ihre Hand über alle hielt, das KZ Sachsenhausen immer größer wurde und das Fallbeil in der Plötze alle Tage Arbeit hatte.“"
                                            },
                                            {
                                                "example_id": "b13c83e6-f66a-46c7-8b81-ca41f9d69627",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "„Zwei Jahre wird die Familie von der Gestapo drangsaliert, 1943 schließlich der Vater verhaftet.“"
                                            },
                                            {
                                                "example_id": "d4a02d18-ac8c-4b42-8264-94644d401854",
                                                "sense_id": "ed3b5be8-33c7-347c-a759-5b14f6ac528e",
                                                "text": "[Dietrich Bonhoeffer:] „Zurück in Deutschland, leitete er von 1935 an das Predigerseminar der oppositionellen Bekennenden Kirche im pommerschen Finkenwalde, bis es 1937 von der Geheimen Staatspolizei (Gestapo) geschlossen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb56d555-01af-4bc3-bebd-047916c6c3ab",
                        "source_entry_id": "a6c0c8da-bed8-3ddb-b97b-28bdeeefd613",
                        "source_sense_id": "092069cf-1d74-3dd8-ac1a-5f20ba6e0416",
                        "target_lang_word": "Geheime Staatspolizei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geheime Staatspolizei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd2de22-983b-3957-8c27-3b08e210176a",
                                        "entry_id": "ccca4fde-5e29-3bf7-a760-8a3d1adfbba4",
                                        "glosses": [
                                            "Polizeibehörde zur Zeit des Nationalsozialismus, deren Aufgabenbereich besonders die Aufdeckung von politischen Straftaten und die Verfolgung von Regimegegnern umfasste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d889ab43-362f-4fff-a96d-8e8b1f190565",
                                                "sense_id": "bfd2de22-983b-3957-8c27-3b08e210176a",
                                                "text": "„Als der Sarg geöffnet war und die Überreste des sächsischen Herzogs darauf hindeuteten, dass Heinrich der Löwe relativ klein gewesen war und schwarze Haare gehabt hatte, sei der oberste Chef der Geheimen Staatspolizei wütend aus der Kirche gestampft.“"
                                            },
                                            {
                                                "example_id": "1351cfcb-74cd-4b67-ac91-8ea41c21ab24",
                                                "sense_id": "bfd2de22-983b-3957-8c27-3b08e210176a",
                                                "text": "„Der Sitz der Geheimen Staatspolizei, Leitstelle Hamburg, befand sich im Stadthaus, Ecke Neuer Wall.“"
                                            },
                                            {
                                                "example_id": "8e38ead5-b93d-4e78-bbc2-0d068d8ef1f7",
                                                "sense_id": "bfd2de22-983b-3957-8c27-3b08e210176a",
                                                "text": "„Dunkle Gerüchte umgaben den Ort schon in den Zeiten der deutschen Gewalt; hier regierte die Geheime Staatspolizei und drangsalierte die Verfemten, die Feinde des Reiches – oder im Prinzip jeden, der an Führer und Endsieg nicht glauben mochte.“"
                                            },
                                            {
                                                "example_id": "c22b6e5c-4075-4b84-a57d-625a3e411e3d",
                                                "sense_id": "bfd2de22-983b-3957-8c27-3b08e210176a",
                                                "text": "[Dietrich Bonhoeffer:] „Zurück in Deutschland, leitete er von 1935 an das Predigerseminar der oppositionellen Bekennenden Kirche im pommerschen Finkenwalde, bis es 1937 von der Geheimen Staatspolizei (Gestapo) geschlossen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
