                        "sense_id": "6d511cb0-7633-3d64-809e-826b2c1fd479",
                        "entry_id": "8a85f984-8246-3490-bc7b-b266b91ebd2e",
                        "glosses": [
                            "plaats waar voetgangers veilig een weg kunnen overgaan en waar het verkeer voor hen moeten stoppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb798deb-16b2-4aa6-92bb-6133cd26f548",
                                "sense_id": "6d511cb0-7633-3d64-809e-826b2c1fd479",
                                "text": "De Titus Brandsmaschool in Hengelo heeft woensdagmorgen haar 'vernieuwde' oversteekplaats geopend. Hiermee wil de school duidelijk maken wie er nou voorrang heeft op wie."
                            }
                        ]
                    },
                    {
                        "sense_id": "db9f7d5c-22c8-340c-9f98-b9f02c28f589",
                        "entry_id": "8a85f984-8246-3490-bc7b-b266b91ebd2e",
                        "glosses": [
                            "plaats waar anderen dan voetgangers veilig een weg kunnen overgaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05cf788c-d4ae-47cc-8f0d-f7d55c76d62f",
                                "sense_id": "db9f7d5c-22c8-340c-9f98-b9f02c28f589",
                                "text": "Fietsers daarentegen hebben geen voorrang op een oversteekplaats voor fietsers. Erg duidelijk staat dat niet in de wegcode. ‘Fietsers mogen zich slechts voorzichtig op de oversteekplaats begeven met inachtneming van de naderende voertuigen.’ Maar er zit een addertje onder het gras: fietsers hebben wel voorrang wanneer ze de baan oversteken op een doorlopend fietspad. Hopelijk kent u dus het verschil tussen een fietspad en een oversteekplaats voor fietsers"
                            }
                        ]
                    }
                ],
