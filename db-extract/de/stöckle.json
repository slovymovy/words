                ],
                "senses": [
                    {
                        "sense_id": "06a2e457-e1a7-33ff-aa12-6744534cfded",
                        "entry_id": "e2c29e92-2205-3c97-bde1-be1d8e000492",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15b5ccd0-6388-4260-a271-ae80bfaf063e",
                                "sense_id": "06a2e457-e1a7-33ff-aa12-6744534cfded",
                                "text": "Frau Stöckle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1f1c39af-99d7-4d83-9f64-6608fd179512",
                                "sense_id": "06a2e457-e1a7-33ff-aa12-6744534cfded",
                                "text": "Herr Stöckle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0e79bf37-463a-4357-91d0-aeba5e001189",
                                "sense_id": "06a2e457-e1a7-33ff-aa12-6744534cfded",
                                "text": "Die Stöckles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7e4ea3fa-a327-44ab-ada4-470e319f4977",
                                "sense_id": "06a2e457-e1a7-33ff-aa12-6744534cfded",
                                "text": "Der Stöckle trägt nie die Schals, die die Stöckle ihm strickt."
                            },
                            {
                                "example_id": "8d6ecfbc-ae4c-4112-b165-812c77749b91",
                                "sense_id": "06a2e457-e1a7-33ff-aa12-6744534cfded",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stöckle kommt, geht der Herr Stöckle.“"
                            },
                            {
                                "example_id": "9fbd356d-7571-4706-a8fc-870145c2bcf5",
                                "sense_id": "06a2e457-e1a7-33ff-aa12-6744534cfded",
                                "text": "Stöckle kommt und geht."
                            },
                            {
                                "example_id": "4eb51bfd-1d94-4d13-9081-7359a2c5201c",
                                "sense_id": "06a2e457-e1a7-33ff-aa12-6744534cfded",
                                "text": "Stöckles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
