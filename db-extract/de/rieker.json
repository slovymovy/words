                ],
                "senses": [
                    {
                        "sense_id": "222a55c2-8728-3f68-afa1-652482da47f9",
                        "entry_id": "0325bdfc-5cb3-3fb5-a6b2-322a4eae734b",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7008424-9e52-4233-8b18-6578baffc745",
                                "sense_id": "222a55c2-8728-3f68-afa1-652482da47f9",
                                "text": "Frau Rieker ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f3b66127-bf39-4c17-bcfa-c5c8d807ddef",
                                "sense_id": "222a55c2-8728-3f68-afa1-652482da47f9",
                                "text": "Herr Rieker wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5ac3d144-f18c-4808-b57d-98e53c12cbcb",
                                "sense_id": "222a55c2-8728-3f68-afa1-652482da47f9",
                                "text": "Die Riekers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8efb273d-ee27-4d8e-8bc5-9fd355a4ba77",
                                "sense_id": "222a55c2-8728-3f68-afa1-652482da47f9",
                                "text": "Der Rieker trägt nie die Schals, die die Rieker ihm strickt."
                            },
                            {
                                "example_id": "1e6fba51-d4ef-460b-ac5a-9b22feb32dcf",
                                "sense_id": "222a55c2-8728-3f68-afa1-652482da47f9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rieker kommt, geht der Herr Rieker.“"
                            },
                            {
                                "example_id": "5953c6a5-5fef-4a10-8a96-bc9b9d5fec35",
                                "sense_id": "222a55c2-8728-3f68-afa1-652482da47f9",
                                "text": "Rieker kommt und geht."
                            },
                            {
                                "example_id": "721524db-b13a-464a-a997-99e99f46f60a",
                                "sense_id": "222a55c2-8728-3f68-afa1-652482da47f9",
                                "text": "Riekers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
