                    "sense_definition": "Zeer helder van licht of kleur, soms pijnlijk voor de ogen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>felle</w> zonlicht scheen recht in mijn gezicht toen ik naar buiten liep.",
                            "target_lang_translations": {
                                "en": "The <w>bright</w> sunlight shone straight into my face when I walked outside.",
                                "ru": "<w>Яркий</w> солнечный свет светил мне прямо в лицо, когда я вышел на улицу.",
                                "pl": "<w>Ostre</w> światło słoneczne świeciło mi prosto w twarz, kiedy wyszedłem na zewnątrz.",
                                "de": "Das <w>grelle</w> Sonnenlicht schien mir direkt ins Gesicht, als ich nach draußen ging.",
                                "fr": "La <w>vive</w> lumière du soleil brillait droit dans mon visage quand je suis sorti dehors.",
                                "it": "La luce <w>intensa</w> del sole mi colpiva dritto in faccia quando sono uscito.",
                                "cs": "<w>Ostré</w> sluneční světlo mi svítilo přímo do obličeje, když jsem vyšel ven.",
                                "tr": "Dışarı çıktığımda <w>parlak</w> güneş ışığı doğrudan yüzüme vurdu.",
                                "es": "La <w>brillante</w> luz del sol me dio de lleno en la cara cuando salí."
                            }
                        },
                        {
                            "text": "Zij draagt graag kleding met <w>felle</w> kleuren om op te vallen.",
                            "target_lang_translations": {
                                "en": "She likes wearing clothes with <w>bright</w> colors to stand out.",
                                "ru": "Она любит носить одежду <w>ярких</w> цветов, чтобы выделяться.",
                                "pl": "Ona chętnie nosi ubrania w <w>jaskrawych</w> kolorach, aby się wyróżniać.",
                                "de": "Sie trägt gerne Kleidung mit <w>knalligen</w> Farben, um aufzufallen.",
                                "fr": "Elle aime porter des vêtements aux couleurs <w>vives</w> pour se faire remarquer.",
                                "it": "Le piace indossare vestiti dai colori <w>accesi</w> per farsi notare.",
                                "cs": "Ráda nosí oblečení s <w>výraznými</w> barvami, aby vynikla.",
                                "tr": "Dikkat çekmek için <w>canlı</w> renkli kıyafetler giymeyi sever.",
                                "es": "A ella le gusta llevar ropa de colores <w>vivos</w> para llamar la atención."
                            }
                        }
