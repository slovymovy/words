                "senses": [
                    {
                        "sense_id": "b85fe9e7-4757-3117-b2a6-47ddd582eb80",
                        "entry_id": "0d0cf444-5ef3-31fd-8fcc-ce5f2ea1a4cd",
                        "glosses": [
                            "Cuisiner sans cuisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "117e8ca3-2001-408f-831c-65aaea9719dc",
                                "sense_id": "b85fe9e7-4757-3117-b2a6-47ddd582eb80",
                                "text": "Les aliments cuisinés – crusinés pardon – par cette nouvelle vague de chefs servent donc à faire passer le message aux sceptiques."
                            },
                            {
                                "example_id": "999e7a89-6eb6-46e7-b537-bf80cf2f2897",
                                "sense_id": "b85fe9e7-4757-3117-b2a6-47ddd582eb80",
                                "text": "La cuisine crue est très ludique, n’hésitez pas à crusiner avec vos enfants. Il y a beaucoup de matières qui rappellent la pâte à modeler, on peut s’amuser avec des emporte-pièces."
                            },
                            {
                                "example_id": "d93e01a2-cf59-415c-ac76-f80bf80edb42",
                                "sense_id": "b85fe9e7-4757-3117-b2a6-47ddd582eb80",
                                "text": "« Crusiner » (cuisiner sans cuisson) exige l’utilisation de produits de substitution, de techniques nouvelles et une constante inventivité."
                            }
                        ]
                    }
                ],
