                "senses": [
                    {
                        "sense_id": "519eccaa-9882-3c08-874b-380f33f376b7",
                        "entry_id": "a27ab4c0-bdc9-3c8b-b99b-4fc4323bfdbb",
                        "glosses": [
                            "Pferd, das zum Tragen von Lasten, Transportgut genutzt wird, abgerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0df33761-4f66-4cf7-b271-8fca13262b9d",
                                "sense_id": "519eccaa-9882-3c08-874b-380f33f376b7",
                                "text": "„Das Pferd ist nicht zu allen Diensten gleich gut verwendbar, sondern immer nur für einen Dienst; es wird sich entweder als Reitpferd, Zugpferd oder Tragpferd eignen.“"
                            },
                            {
                                "example_id": "7401fa1f-fcb3-408d-bb74-f76d31d05b40",
                                "sense_id": "519eccaa-9882-3c08-874b-380f33f376b7",
                                "text": "„Der Schwarze führt dazu das Tragpferd am Zügel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
