    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0a9e677f-f81e-358b-a3bb-d5087cf615d6",
                "word": "decerebrate",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ade66e94-a3cb-3a27-bbd1-8a7001277c2a",
                        "entry_id": "0a9e677f-f81e-358b-a3bb-d5087cf615d6",
                        "glosses": [
                            "Having the cerebrum removed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "50ec46de-e3f2-4d7e-90e3-8b01d6ac8ca3",
                                "sense_id": "ade66e94-a3cb-3a27-bbd1-8a7001277c2a",
                                "text": "In this respect the decerebrate condition offers some resemblance to the cataleptic state."
                            },
                            {
                                "example_id": "849d0a67-d402-4805-802e-dba540730f7c",
                                "sense_id": "ade66e94-a3cb-3a27-bbd1-8a7001277c2a",
                                "text": "Take for instance the startling example of the experiments of Wever and Bray, when tones were led into the external meatus of the ear of a decerebrate cat and then greatly amplified electrical currents were tapped from the eighth cranial or auditory nerve."
                            },
                            {
                                "example_id": "013fab30-eddb-4f73-97ea-691233c71967",
                                "sense_id": "ade66e94-a3cb-3a27-bbd1-8a7001277c2a",
                                "text": "All brain tissue rostral to the diencephalon was removed, making the preparation a decerebrate one."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
