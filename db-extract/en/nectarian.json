                        "glosses": [
                            "Of or like nectar; wonderfully delicious."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "596cf8a1-6739-4f09-b3fb-f75738553869",
                                "sense_id": "7b05b9d3-8800-3e25-b25f-a9c89744c925",
                                "text": "Sometimes the memory of her peaceful life at Florence obtruded itself upon her, and more than that, her charitable occupations when she attended the sick in that city, and whence, as from a rough-hewn chalice containing nectarian drink, she had quaffed happiness."
                            },
                            {
                                "example_id": "9d080072-0b32-47eb-a803-ab143bd25428",
                                "sense_id": "7b05b9d3-8800-3e25-b25f-a9c89744c925",
                                "text": "Peter accordingly, seated, near the door, with a tumbler of the nectarian stimulant steaming beside him, proceeded with marvellous courage, considering they had no light but the uncertain glare of the fire, to relate with minute particularity his awful adventure."
                            }
                        ]
                    }
