                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78e5e28d-cbc2-3da7-b942-5909021330ea",
                                        "entry_id": "294224af-d06b-3b8b-9c22-913a951c57c2",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de méfaire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d259fc26-e75f-48a5-92c5-cbc1e0f36b42",
                                                "sense_id": "78e5e28d-cbc2-3da7-b942-5909021330ea",
                                                "text": "Les rois de France l’ont bien compris quand ils ont couvert de leur protection ces officiers de justice, se protégeant ainsi eux-mêmes, car rien n’a jamais été plus profond et plus vrai que cette parole du moyen âge : « Qui méfait un sergent, il méfait un roi. »"
                                            }
                                        ]
