                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa46deca-013a-3988-8b81-b8420f3ba7e6",
                        "entry_id": "197ec1e8-1c1f-352c-be6a-702e44d89e45",
                        "glosses": [
                            "jemand, der sich aufspielt; jemand, der sich selbst für wichtiger hält, als er ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "642a221c-7cd2-43b6-9b8e-eaace3346e2f",
                                "sense_id": "aa46deca-013a-3988-8b81-b8420f3ba7e6",
                                "text": "Er ist nichts weiter als ein aufgeblasener Wichtigtuer. Ignoriere ihn einfach."
                            },
                            {
                                "example_id": "61ab3f1e-b402-4144-9e68-7683b6b723f4",
                                "sense_id": "aa46deca-013a-3988-8b81-b8420f3ba7e6",
                                "text": "„Afrika reizte mich, weil es immer noch so leer ist, so unvollendet wirkt, voller Möglichkeiten, weswegen es Wichtigtuer und Analysten anzieht, Voyeure und Hobby-Philanthropen.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6027082f-c02d-4213-ac5c-03aaa9662cfb",
                        "source_entry_id": "197ec1e8-1c1f-352c-be6a-702e44d89e45",
                        "source_sense_id": "aa46deca-013a-3988-8b81-b8420f3ba7e6",
                        "source_sense_description": "jemand, der sich aufspielt; jemand, der sich selbst für wichtiger hält, als er ist",
                        "target_lang_word": "busybody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "busybody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fe50dbf-8075-3be9-80ae-5eb81e834d43",
                                        "entry_id": "ab638e59-0986-3993-a683-dc584b244916",
                                        "glosses": [
                                            "Someone who interferes with others; one who is nosy, intrusive or meddlesome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec2a17ed-176a-45f0-9e91-1b5ad5e324da",
                                                "sense_id": "3fe50dbf-8075-3be9-80ae-5eb81e834d43",
                                                "text": "Se that none of you ſuffre as a murtherer / or as a thefe / or an evyll doar / or as a buſybody in wother mens matters."
                                            },
                                            {
                                                "example_id": "2033a916-bfd5-4fcc-8489-ab04308d4b0d",
                                                "sense_id": "3fe50dbf-8075-3be9-80ae-5eb81e834d43",
                                                "text": "Candidly speaking, I thought her a little busy-body; but her father, blind like other parents, seemed perfectly content to let her wait on him, and even wonderfully soothed by her offices."
                                            },
                                            {
                                                "example_id": "346e2047-350a-4657-82e6-7c7add7d7b1d",
                                                "sense_id": "3fe50dbf-8075-3be9-80ae-5eb81e834d43",
                                                "text": "But I couldn’t—and I can’t tell you, either, what it’s meant to me these two years to believe you were going to marry him, and be told every week by some busybody that your engagement was on the point of being announced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "206e7978-a131-31bb-8f6a-b9fc64c198a5",
                                        "entry_id": "ab638e59-0986-3993-a683-dc584b244916",
                                        "glosses": [
                                            "A device consisting of three mirrors that, when attached to the wall of a house, allows an occupant to see who is at the front door without a direct line of sight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "busybody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d86ae6f7-c444-3ee1-89ca-99917c7fef10",
                                        "entry_id": "9397c234-9583-3b82-b1a7-8f55042ed896",
