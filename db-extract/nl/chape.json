                                    },
                                    {
                                        "sense_id": "36935e0b-5fbc-36f3-b60d-b6f68f39190a",
                                        "entry_id": "bf1e0afe-0cff-3430-8799-ee25c3cf5160",
                                        "glosses": [
                                            "Pièce formée par deux triangles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e16df47-e7d2-4bd6-a61f-db8bf548fa9e",
                                                "sense_id": "36935e0b-5fbc-36f3-b60d-b6f68f39190a",
                                                "text": "La chape est un vêtement de deux triangles rectangles, formés par les bords de l’écu et par deux lignes menées du milieu du chef à chacun des angles de la pointe."
                                            }
                                        ]
