                    {
                        "form_id": "389a88f8-709a-4162-a345-e977685a80c4",
                        "entry_id": "20a17603-1f19-316d-b76e-351bb558c140",
                        "tags": [],
                        "form": "duffel-coat"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6afdb311-1eb0-308e-a44b-bb8f4fb9b5e5",
                        "entry_id": "20a17603-1f19-316d-b76e-351bb558c140",
                        "glosses": [
                            "Manteau long à capuche, qui se reconnaît à ses attaches, faites en petits cônes incurvés de bois tenus par un lien de cuir, qui se rentre sur l’autre partie dans une petite boucle de cuir."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "55d5ed13-9483-465a-8b86-d1d7d2e8bc2c",
                                "sense_id": "6afdb311-1eb0-308e-a44b-bb8f4fb9b5e5",
                                "text": "Édouard boutonna son duffle-coat et traversa."
                            },
                            {
                                "example_id": "44548b10-0fc6-48ef-b2e6-004c3f15f578",
                                "sense_id": "6afdb311-1eb0-308e-a44b-bb8f4fb9b5e5",
                                "text": "Sabine Pallières est la mère d’un crétin en duffle-coat vert sapin qui, après ses deux khâgnes et Sciences-Po, ira probablement diffuser la médiocrité de ses petites pensées dans un cabinet ministériel de droite."
                            },
                            {
                                "example_id": "ed5df603-a59d-43cb-9ae1-fdcaf62babb3",
                                "sense_id": "6afdb311-1eb0-308e-a44b-bb8f4fb9b5e5",
                                "text": "Le duffle-coat possède lui aussi une histoire très marquée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13e08d0e-b85d-40ec-bfbc-43a83fa1627c",
                        "source_entry_id": "20a17603-1f19-316d-b76e-351bb558c140",
                        "source_sense_id": "6afdb311-1eb0-308e-a44b-bb8f4fb9b5e5",
                        "target_lang_word": "Dufflecoat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dufflecoat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fab38ca-95ab-3689-b344-190a38b423f7",
                                        "entry_id": "8042c9cb-d6fc-33ad-aa0e-aa67607d563a",
                                        "glosses": [
                                            "dreiviertellanger Mantel aus schwerem Wollstoff mit Kapuze und Knebelverschlüssen aus Horn oder Holz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ecae0c7-11eb-4993-bf40-c8f66fc60a65",
                                                "sense_id": "4fab38ca-95ab-3689-b344-190a38b423f7",
                                                "text": "„Die paar Sachen waren bald im Schrank, der neue Dufflecoat am Türhaken, und er lag auf der enggemusterten wollenen Bettdecke und dachte nach.“"
                                            },
                                            {
                                                "example_id": "3c928555-8876-4abd-917d-a37f5de7e792",
                                                "sense_id": "4fab38ca-95ab-3689-b344-190a38b423f7",
                                                "text": "„Marcell rollte seinen Mantel zusammen und warf ihn hinten ins Auto, einen Dufflecoat wie der Commissar im Dritten Mann, wer trägt denn noch so was!“"
                                            },
                                            {
                                                "example_id": "978b37f9-8f25-4507-926a-d4e24bb77d9c",
                                                "sense_id": "4fab38ca-95ab-3689-b344-190a38b423f7",
                                                "text": "„So war in Florenz etwa der Dufflecoat (mit Kapuze und Knebelverschluss) ein häufiger Gast in den Kollektionen, ebenso der etwas kompliziertere Pea Coat (Marine-Zweireiher) und Paletot (knielanger Sakkomantel).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21ba9a1c-b808-4493-a4ff-1c597893e685",
                        "source_entry_id": "20a17603-1f19-316d-b76e-351bb558c140",
