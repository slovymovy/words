                    {
                        "sense_id": "f8eedbe6-bbfd-39bc-ba61-924ef70822eb",
                        "entry_id": "7afaa388-da01-36e4-93ff-dc66d8bfc1f5",
                        "glosses": [
                            "En référence au gouvernement fédéral canadien, de par l’unique feuille d’érable qui apparaît sur le drapeau du pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf9dff3d-08c9-410f-b33b-f58a6b9093e2",
                                "sense_id": "f8eedbe6-bbfd-39bc-ba61-924ef70822eb",
                                "text": "Le précédent gouvernement Couillard ayant été reconnu pour sa mollesse devant ce même mur unifolié, les libéraux habitent un refuge de verre d’où ils peuvent difficilement lancer des pierres !"
                            },
                            {
                                "example_id": "6c206687-a067-4ecb-be60-7e1f4c517bdb",
                                "sense_id": "f8eedbe6-bbfd-39bc-ba61-924ef70822eb",
                                "text": "Parmi les autres représentants de l’unifolié en lice, Adam Hadwin est celui qui a le plus progressé avec un pointage 66 (-5) en cette deuxième journée."
                            }
                        ]
                    }
                ],
