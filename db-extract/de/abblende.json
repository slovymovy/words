                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56f73073-ec7d-425b-86c1-a2e99d20532f",
                                                "sense_id": "52f2781a-1d07-3ded-bf0c-168d94a1d556",
                                                "text": "Down fell the duke, his joints dissolved asunder."
                                            },
