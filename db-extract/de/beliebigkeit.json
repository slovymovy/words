                ],
                "senses": [
                    {
                        "sense_id": "ced5a0b0-211e-3b17-963b-5b9292bc428e",
                        "entry_id": "85e09377-9ff9-3c91-a4e4-8b1c54d5a9b6",
                        "glosses": [
                            "deutscher Ausdruck für Arbitrarität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade92c83-7a18-4aa7-8c93-19d9881cd296",
                                "sense_id": "ced5a0b0-211e-3b17-963b-5b9292bc428e",
                                "text": "Beliebigkeit liegt oft im Verhältnis zwischen der Form und der Bedeutung eines sprachlichen Zeichens vor."
                            },
                            {
                                "example_id": "ee2df617-0e52-467f-b424-8cd56678eab7",
                                "sense_id": "ced5a0b0-211e-3b17-963b-5b9292bc428e",
                                "text": "Mit Beliebigkeit ist gemeint, dass zwischen der Form und der Bedeutung eines Zeichens kein Abbildverhältnis besteht. Die Lautform von „Stuhl“ z.B. bildet nicht die Bedeutung dieses Wortes ab."
                            },
                            {
                                "example_id": "86129c6e-6a5c-424f-af24-57cd908b397b",
                                "sense_id": "ced5a0b0-211e-3b17-963b-5b9292bc428e",
                                "text": "„Eine der Voraussetzungen dafür ist die Beliebigkeit der Verbindung von Zeichenaußenseite und Zeicheninhaltsseite…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "31c47608-192d-376c-8b97-629e957db14f",
                        "entry_id": "85e09377-9ff9-3c91-a4e4-8b1c54d5a9b6",
                        "glosses": [
                            "Unentschiedenheit, Wankelmut, Ziellosigkeit im Hinblick auf verschiedene Möglichkeiten"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "10070e2b-ea3c-422d-937f-5c73f13d6ab5",
                                "sense_id": "31c47608-192d-376c-8b97-629e957db14f",
                                "text": "„Fischer hat die Grünen in die Beliebigkeit geführt, in der sie heute sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
