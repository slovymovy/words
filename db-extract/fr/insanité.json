                                "target_senses": [
                                    {
                                        "sense_id": "270df12a-ba6c-3315-95bd-f12440ae0f9d",
                                        "entry_id": "29d504cf-e519-3f28-9e23-9fd46d9e273a",
                                        "glosses": [
                                            "bewusste/scherzhafte Äußerung von Unsinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
