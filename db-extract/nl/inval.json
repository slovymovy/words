                    {
                        "sense_id": "703b7345-bf05-35ec-a5ad-8ae97b411da4",
                        "entry_id": "9eadb8a5-db20-37b2-ad77-cd9c3a262b4b",
                        "glosses": [
                            "het plotseling met een leger- of politiemacht binnendringen in een gebouw of gebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c97804f3-c31e-4dda-98a3-f8cbd07aeba9",
                                "sense_id": "703b7345-bf05-35ec-a5ad-8ae97b411da4",
                                "text": "De politie heeft een inval gepleegd in dat pand en vond er een metamfetaminefabriekje."
                            },
                            {
                                "example_id": "93505e20-a12b-457d-ae83-d03487bcf8d1",
                                "sense_id": "703b7345-bf05-35ec-a5ad-8ae97b411da4",
                                "text": "Westerse landen hebben de afgelopen maanden meer dan 330 miljard dollar aan bezittingen van rijke Russen en de Russische centrale bank bevroren. Dat is omgerekend zo'n 314 miljard euro. Reden hiervan is de de Russische inval in Oekraïne."
                            },
                            {
                                "example_id": "e483a420-a100-4bb7-b44d-2060ce029abd",
                                "sense_id": "703b7345-bf05-35ec-a5ad-8ae97b411da4",
                                "text": "Bij de inval werd een vuurwapen gevonden. Mogelijk is dat het wapen waarmee de moorden zijn gepleegd. Tussen 21 december en 2 januari werden drie oudere mannen doodgeschoten. Het gaat om mannen van 63, 58 en 81 jaar."
                            }
                        ]
                    },
