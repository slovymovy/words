                        "target_lang_word": "konzentriert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konzentriert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "955ac6c8-17d2-3be4-a504-e85431d16aa7",
                                        "entry_id": "d01c6029-23b4-3d0b-ba74-d23d6fe8b439",
                                        "glosses": [
                                            "geistig auf eine Sache fokussiert und dabei sehr wach sein, sich nicht von etwas ablenken lassen, sich von einer Sache einnehmen lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b0397ad-7eeb-46da-a19d-dd831645ab3a",
                                                "sense_id": "955ac6c8-17d2-3be4-a504-e85431d16aa7",
                                                "text": "Er arbeitete konzentriert an seinem Bericht."
                                            },
                                            {
                                                "example_id": "33977843-3d6e-45e6-9668-8369d6bbbb9f",
                                                "sense_id": "955ac6c8-17d2-3be4-a504-e85431d16aa7",
                                                "text": "Beim Autofahren sollte man nicht telefonieren, da ist man zu sehr abgelenkt und nicht konzentriert bei der Sache."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ea9a39d-85c7-3171-9739-b046f41144f7",
                                        "entry_id": "d01c6029-23b4-3d0b-ba74-d23d6fe8b439",
                                        "glosses": [
                                            "an einem Ort zusammengeballt, verdichtet, auf Weniges beschränkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce893370-1238-470f-b333-7ced317b0df4",
                                                "sense_id": "2ea9a39d-85c7-3171-9739-b046f41144f7",
                                                "text": "Die neuen Häuser wurden am Stadtrand konzentriert, man wollte der Zersiedelung und einem großen Flächenverbrauch entgegenwirken."
                                            },
                                            {
                                                "example_id": "6b1112f9-8d1e-4b09-b355-3bcf2fed07ea",
                                                "sense_id": "2ea9a39d-85c7-3171-9739-b046f41144f7",
                                                "text": "Eine gänzlich neue Sparte, um die der junge Porst im März 1960 schließlich sein Versandgeschäft erweiterte, erhöhte zwar ebenfalls die Umsatzziffern, brachte aber nicht den erhofften Gewinn: Der Porst-Wert-Dienst (PWD) für schöneres Leben offerierte den in der Nürnberger Kartei verewigten Amateurphotographen \"ein leicht übersehbares, konzentriertes Angebot einiger weniger hochwertiger Gebrauchsgüter\" wie Kühlschränke, Waschmaschinen, Radio- und Phonogeräte, Polster- und Kleinmöbel, Schreibmaschinen oder Uhren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8a5a9596-bd28-3daf-aade-b1a98f8162cf",
                                        "entry_id": "d01c6029-23b4-3d0b-ba74-d23d6fe8b439",
                                        "glosses": [
                                            "(chemisch) verdichtet, eingedampft, eingedickt, eine hohe Konzentration habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecfbc644-4a6f-4aff-a8e2-9e03a1ff04ec",
                                                "sense_id": "8a5a9596-bd28-3daf-aade-b1a98f8162cf",
                                                "text": "Eine konzentrierte Lösung von Ammoniumhydroxid wirkt ätzend."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
