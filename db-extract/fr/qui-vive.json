                    {
                        "sense_id": "b9547df3-1dbc-317e-88d6-dbac3893b37d",
                        "entry_id": "aaa1760e-144a-323c-b51d-367b71280c6f",
                        "glosses": [
                            "Variante orthographique de qui vive."
                        ],
                        "tags": [
