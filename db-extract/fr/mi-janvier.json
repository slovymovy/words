                        "sense_id": "f3197fb3-70d1-3f60-9c1e-128e4685669a",
                        "entry_id": "bcc0cb98-0cb3-3d1b-980b-405cf825f25d",
                        "glosses": [
                            "Au quinzième jour du mois de janvier, ou aux environs de cette journée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50eae730-e760-4ea3-9444-46e8ab4c6e95",
                                "sense_id": "f3197fb3-70d1-3f60-9c1e-128e4685669a",
                                "text": "Selon le quotidien régional, ils auraient envoyé un message mi-janvier aux parents de jeunes filles du collège Frison-Roche de La Broque, que fréquentait Lina jusqu’en juin 2023."
                            },
                            {
                                "example_id": "adb2609d-2dcf-4cba-9669-456f49be9f09",
                                "sense_id": "f3197fb3-70d1-3f60-9c1e-128e4685669a",
                                "text": "Mi-janvier, le PGHM avait appelé les alpinistes à la prudence, après avoir récupéré un skieur emporté par une avalanche dans un contexte différent."
                            }
                        ]
                    }
