                        "glosses": [
                            "Antrag auf Genehmigung zum Abbauen eines Rohstoffvorkommens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26588b59-7234-4223-9f1b-6123bede3b47",
                                "sense_id": "4497e02b-244a-3b4e-b5ee-dc24df2b016b",
                                "text": "„Der Umweltdezernent kann als einer der zentralen Akteure angesehen werden, weil er für die Entscheidung über den Abbauantrag zuständig war.“"
                            },
                            {
                                "example_id": "67529180-25db-480c-99ad-b4e49dc98a89",
                                "sense_id": "4497e02b-244a-3b4e-b5ee-dc24df2b016b",
                                "text": "„Der LSK [Landschaftsschutzverein Kottenforst] hatte in Erfahrung gebracht, dass die vier Kiesunternehmen, die in Weilerswist-Nord, Sonnenhof bei Bornheim, Witterschlick-Süd und Flerzheim-Nord Kies abbauen wollen, Abbauanträge beim Bergamt Arnsberg gestellt haben.“"
                            }
                        ],
