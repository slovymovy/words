                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "931b0193-0793-3e64-8913-245887fa313f",
                        "entry_id": "9e86d6e7-b827-3ff5-a55a-a5b793c479cd",
                        "glosses": [
                            "Moi-même. Note d’usage : Utilisé avec le nous de majesté ou le nous de modestie du singulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ce37295-deed-43c8-ac04-bbd2d7d06a40",
                                "sense_id": "931b0193-0793-3e64-8913-245887fa313f",
                                "text": "Quand nous l’aurons vaincu en nous-même et dans nos amis, nous aurons acquis la force et le droit de l’attaquer dans l’ennemi, ou pour mieux dire, d’aider le malheureux à s’en débarrasser."
                            },
                            {
                                "example_id": "f706f99c-309a-4921-8022-ddb947a9e6bb",
                                "sense_id": "931b0193-0793-3e64-8913-245887fa313f",
                                "text": "Dans le métavers, à quoi ressemblerons-nous ? À une version cartoonesque de nous-même prévoit Mark Zuckerberg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88d2ae7e-ec60-43e3-8301-289ea793e0e1",
                        "source_entry_id": "9e86d6e7-b827-3ff5-a55a-a5b793c479cd",
                        "source_sense_id": "931b0193-0793-3e64-8913-245887fa313f",
                        "target_lang_word": "ourself",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
