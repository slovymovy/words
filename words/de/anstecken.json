                    "sense_id": "a94a69d6-7a88-3879-a47c-5b6959d18f0a",
                    "sense_definition": "Von Krankheitserregern befallen werden und dadurch selbst erkranken; sich eine Infektion zuziehen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "infection",
                    "name_type": "no",
                    "examples": [
                        {
