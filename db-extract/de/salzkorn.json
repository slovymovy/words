                "senses": [
                    {
                        "sense_id": "e665bc6a-4558-38e0-8203-a55edbd3d4d5",
                        "entry_id": "4de6b9e6-98ec-366b-90de-ac68a850f429",
                        "glosses": [
                            "kleines, festes Teilchen Salz; kleiner Salzkristall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e62a26e-0a48-4987-86d7-94f4191df3a6",
                                "sense_id": "e665bc6a-4558-38e0-8203-a55edbd3d4d5",
                                "text": "„An der Hand einer Farbenskala kann man sich über den ungefähren Jodgehalt eines Jodsalzes augenblicklich orientieren. Mit dieser Reaktion ist es nach Eggenberger möglich, unter günstigen Umständen in einem Salzkorne noch ein γ Jod dem Auge sichtbar zu machen.“"
                            },
                            {
                                "example_id": "39f19061-9eda-447a-811e-46021bd12bc4",
                                "sense_id": "e665bc6a-4558-38e0-8203-a55edbd3d4d5",
                                "text": "„Am 6. April 1930 erreichte er den Strand bei Dandi in Gujarat und machte sich durch das Auflesen eines Salzkorns strafbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
