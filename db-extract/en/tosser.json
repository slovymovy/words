                "translations": [
                    {
                        "translation_id": "48051323-95b1-452f-8f9c-3456a04bf655",
                        "source_entry_id": "c4325682-27c8-3c04-b563-17d9779f52b8",
                        "source_sense_id": "6f183e12-2766-3679-8fc1-778971474806",
                        "source_sense_description": "vulgär, britisch: Wichser, Idiot, Vollidiot",
                        "target_lang_word": "Wichser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wichser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c66cbfc7-38d8-33da-b4be-7e213fd36dd6",
                                        "entry_id": "404bf327-c1a6-3bcb-bb35-1d8509b162bd",
                                        "glosses": [
                                            "männliche Person, welche masturbiert"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a21c2890-427b-41e0-a756-9b4e035393a7",
                                                "sense_id": "c66cbfc7-38d8-33da-b4be-7e213fd36dd6",
                                                "text": "Er ist ein Wichser."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a6552fac-3e54-3436-afac-c02d2309ccab",
                                        "entry_id": "404bf327-c1a6-3bcb-bb35-1d8509b162bd",
                                        "glosses": [
                                            "männliche Person"
                                        ],
                                        "tags": [
                                            "beleidigend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32bdaa3e-8f23-4878-bf56-310737a0d7c4",
                                                "sense_id": "a6552fac-3e54-3436-afac-c02d2309ccab",
                                                "text": "„Nennt ein Mitarbeiter seinen Chef einen ‚Wichser,‘ darf er trotzdem nicht ohne weiteres rausgeworfen werden. Das geht aus einem am Dienstag bekanntgewordenen Urteil des Landesarbeitsgerichts (LAG) Rheinland-Pfalz hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "45f80cac-2099-3a57-af3c-1aac703024f9",
                                        "entry_id": "404bf327-c1a6-3bcb-bb35-1d8509b162bd",
                                        "glosses": [
                                            "Person, die Leder mit Wichse versieht, einfettet"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5de1e1f9-e8fa-4122-9962-6f8867617c32",
                        "source_entry_id": "c4325682-27c8-3c04-b563-17d9779f52b8",
                        "source_sense_id": "6f183e12-2766-3679-8fc1-778971474806",
                        "source_sense_description": "vulgär, britisch: Wichser, Idiot, Vollidiot",
                        "target_lang_word": "Idiot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Idiot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                        "entry_id": "92619ca5-9602-3bbf-a589-6af92f40b52f",
                                        "glosses": [
                                            "ein vermeintlich dummer, wenig intelligenter, unwissender Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2da56600-cf6a-46e8-92f6-f5a930b1c196",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "„Du wärst wirklich ein Idiot, wenn du so einen dummen Fehler machen würdest.“"
                                            },
                                            {
                                                "example_id": "36c7a8a1-c633-4d2c-8705-112610d4e4c1",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "Und ich Idiot bezahle noch die erste Rate."
                                            },
                                            {
                                                "example_id": "9cd817d6-befb-43e8-942a-e8ea03dbb436",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "Das weiß doch jeder Idiot, dass man damit nicht durchkommt."
                                            },
                                            {
                                                "example_id": "919a730a-e3b0-49d5-ac2e-7bcf911b8696",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "Kein Idiot käme auf die Idee, mit einer Kerze da hinein zu gehen."
                                            },
                                            {
                                                "example_id": "2b06fab6-63b6-4962-a033-92b6d63effea",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "„Nach seiner Theorie bestanden alle Völker der Welt aus lauten, ungebildeten und ahnungslosen Idioten.“"
                                            },
                                            {
                                                "example_id": "5129665b-ddd8-4ce4-9a1e-177bb8b607e5",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "„Sie nennen einen »Außenseiter«, der nicht stiehlt, einen Dummkopf, einen Idioten, einen Dussel und einen Einfaltspinsel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf7f3768-353d-3e38-af42-49b87302a2b5",
                                        "entry_id": "92619ca5-9602-3bbf-a589-6af92f40b52f",
                                        "glosses": [
                                            "ein an Idiotie leidenden Mensch"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2416351-7339-49f5-80d9-db421bfbccf2",
                                                "sense_id": "cf7f3768-353d-3e38-af42-49b87302a2b5",
                                                "text": "1897 fand eine Konferenz der Vorsteher evangelischer Idioten- und Epileptischenanstalten statt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c2b9dc3-faa7-48f6-b9c6-bc63cfc4be1c",
                        "source_entry_id": "c4325682-27c8-3c04-b563-17d9779f52b8",
                        "source_sense_id": "6f183e12-2766-3679-8fc1-778971474806",
                        "source_sense_description": "vulgär, britisch: Wichser, Idiot, Vollidiot",
                        "target_lang_word": "Vollidiot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vollidiot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8ce91ec-c487-3b61-bfb2-a62a80dafaa7",
                                        "entry_id": "740974ab-67fc-3f8e-b274-f2db1c6310c6",
                                        "glosses": [
                                            "sehr dumme Person"
                                        ],
                                        "tags": [
                                            "beleidigend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a1855d2-4a0c-40e8-a224-5ace280ef7fe",
                                                "sense_id": "c8ce91ec-c487-3b61-bfb2-a62a80dafaa7",
                                                "text": "Der Vollidiot hat wieder alles versemmelt."
                                            },
                                            {
                                                "example_id": "779ad776-3471-4162-a0e5-3bc8a62bb20b",
                                                "sense_id": "c8ce91ec-c487-3b61-bfb2-a62a80dafaa7",
                                                "text": "„Ich zählte die Vollidioten, die mir begegneten.“"
                                            },
                                            {
                                                "example_id": "140726f3-d212-4e24-8db5-1241fcb70d83",
                                                "sense_id": "c8ce91ec-c487-3b61-bfb2-a62a80dafaa7",
                                                "text": "„Jetzt hatte sich irgendein abenteuerlustiger Vollidiot selbst verschuldet eine Krankheit zugezogen und zahlte dafür den Preis.“"
