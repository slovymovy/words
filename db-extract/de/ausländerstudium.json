                ],
                "senses": [
                    {
                        "sense_id": "efb19289-13cc-3dcf-9e3f-15815dd97f6a",
                        "entry_id": "fc88d007-6a34-356e-a05b-e6267b8417bf",
                        "glosses": [
                            "Bezeichnung für das Studium eines Ausländers in einem fremden Land, aus Sicht des Studienlandes"
                        ],
                        "tags": [
                            "Hochschulpolitik"
                        ],
                        "examples": [
                            {
                                "example_id": "a7ea6852-023b-4e94-83ba-28d792eaf22d",
                                "sense_id": "efb19289-13cc-3dcf-9e3f-15815dd97f6a",
                                "text": "„Geringes Ausländerstudium gefährdet Wissenschaftsstandort Deutschland […] Das schwindende Interesse von Ausländern an einem Studium in Deutschland alarmiert die deutsche Wirtschaft.“"
                            },
                            {
                                "example_id": "fa4afe08-be4e-41c4-ba4e-64751f911f4d",
                                "sense_id": "efb19289-13cc-3dcf-9e3f-15815dd97f6a",
                                "text": "\"Wir wollen ein Ausländerstudium von ausreichend vorqualifizierten Bewerbern anstatt eines zweiten Bildungswegs, der nur entwicklungspolitisch motiviert ist\", bekräftigte Volker Ronge für die nordrhein-westfälischen Rektoren an Rhein und Ruhr vor dem Landtag."
                            },
                            {
                                "example_id": "cc221263-52f1-4f8d-a9fe-08abf8050c8c",
                                "sense_id": "efb19289-13cc-3dcf-9e3f-15815dd97f6a",
                                "text": "„Ich konnte in meiner langjährigen Tätigkeit im Ausländerstudium ein faszinierendes Kaleidoskop menschlicher und freundschaftlicher Begegnungen mit ausländischen Studierenden aus vielen Ländern erleben.“"
                            },
                            {
                                "example_id": "543d2a4c-1e48-4fe4-8fea-6fcad545f794",
                                "sense_id": "efb19289-13cc-3dcf-9e3f-15815dd97f6a",
                                "text": "„Es herrscht eine Konzeptlosigkeit im Ausländerstudium, die durch Aktionismus und kurzfristiges Denken aller Beteiligten geprägt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
