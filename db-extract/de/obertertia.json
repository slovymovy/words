                ],
                "senses": [
                    {
                        "sense_id": "9db4c06c-031d-304e-ae3a-83ec9c1b15cb",
                        "entry_id": "5214e16b-7768-35ba-9d90-3303590de66a",
                        "glosses": [
                            "fünfte Klasse am Gymnasium, insgesamt Klasse 9"
                        ],
                        "tags": [
                            "Germany",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "8da1a1a6-2768-4158-9d30-db78c81691fa",
                                "sense_id": "9db4c06c-031d-304e-ae3a-83ec9c1b15cb",
                                "text": "„In der Obertertia wäre einer, den sollte ich mal fragen, der könnte ein Lied singen.“"
                            },
                            {
                                "example_id": "d493903c-3a1d-4126-b167-8f8b66f1c9df",
                                "sense_id": "9db4c06c-031d-304e-ae3a-83ec9c1b15cb",
                                "text": "„Mit dem Ende der Obertertia im Sommer 1949 änderte sich sein Leben mit einem Schlag.“"
                            },
                            {
                                "example_id": "c165924a-ff64-4aab-94ca-61e35e0cf7ee",
                                "sense_id": "9db4c06c-031d-304e-ae3a-83ec9c1b15cb",
                                "text": "„Die Obertertia tobte.“"
                            },
                            {
                                "example_id": "b94f48de-1449-4f03-abe7-6b6ab11132ef",
                                "sense_id": "9db4c06c-031d-304e-ae3a-83ec9c1b15cb",
                                "text": "„Von der Sexta bis zur Obertertia tummelten sich die Johanneer in den Pausen auf dem Außenhof, während der Innenhof mit der nackten Bronzestatue, dem Schatten einer riesigen Kastanie und der gelassenen Würde des breiten Portals den Schülern der Oberstufe, zwischen Untersekunda und Oberprima, vorbehalten war.“"
                            },
                            {
                                "example_id": "a54746f7-c12e-4977-94fc-d6f49fe6e607",
                                "sense_id": "9db4c06c-031d-304e-ae3a-83ec9c1b15cb",
                                "text": "„Am nächsten Tag, mit der Versetzung von der Obertertia in die Obersekunda, wurden sie getrennt - die Untersekunda fiel damals, 1938, auf allerhöchste Anordnung aus, weil damit ein Jahr für die vormilitärische Organisation des Arbeitsdienstes gewonnen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
