                    },
                    {
                        "form_id": "202ed7cb-259e-470c-9cfd-8f8f952c76da",
                        "entry_id": "6cff51b6-0608-3700-9dda-c9ec5fce9fcb",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "angoissantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2bde8372-25d6-3638-901c-3209daeaabd6",
                        "entry_id": "6cff51b6-0608-3700-9dda-c9ec5fce9fcb",
                        "glosses": [
                            "Qui cause de l’angoisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df416e9-d4ab-44db-aefc-cc5b7c3bce52",
                                "sense_id": "2bde8372-25d6-3638-901c-3209daeaabd6",
                                "text": "Les Lettres à l'Étrangère, […] malgré cette jactance énorme, qui le fait se gonfler jusqu'à la bouffonnerie, sont le plus émouvant, le plus angoissant martyrologe qui se puisse imaginer d'une vie d'artiste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6b015c5-6b16-4bd0-bcfb-e0aa49196cfe",
                        "source_entry_id": "6cff51b6-0608-3700-9dda-c9ec5fce9fcb",
                        "source_sense_id": "2bde8372-25d6-3638-901c-3209daeaabd6",
                        "source_sense_description": "Qui cause de l'angoisse.",
                        "target_lang_word": "scary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bfd6210-fb0f-3bb4-93e4-4334068e581b",
                                        "entry_id": "3d34f4a2-a911-3ad7-9d1e-79ed215aa270",
                                        "glosses": [
                                            "Causing fear or anxiety"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f394f504-c9ef-4bda-9dcf-755cbc8f62d5",
                                                "sense_id": "1bfd6210-fb0f-3bb4-93e4-4334068e581b",
                                                "text": "The tiger's jaws were scary."
                                            },
                                            {
                                                "example_id": "356eea1b-7924-48c0-955d-f5382f8e48cc",
                                                "sense_id": "1bfd6210-fb0f-3bb4-93e4-4334068e581b",
                                                "text": "She was hiding behind her pillow during the scary parts of the film."
                                            },
                                            {
                                                "example_id": "a7a16ff2-f0fb-4d0c-9db4-fef00a6b9f77",
                                                "sense_id": "1bfd6210-fb0f-3bb4-93e4-4334068e581b",
                                                "text": "He watched Conjuring but it was too scary for him."
                                            },
                                            {
                                                "example_id": "a6601530-5da3-47d2-94d3-493682af7c8d",
                                                "sense_id": "1bfd6210-fb0f-3bb4-93e4-4334068e581b",
                                                "text": "Well, we swarmed along down the river road, just carrying on like wildcats; and to make it more scary the sky was darking up, and the lightning beginning to wink and flitter, and the wind to shiver amongst the leaves."
                                            },
                                            {
                                                "example_id": "9c7a4c3d-4afa-4c80-b7fd-6fae312a97d5",
                                                "sense_id": "1bfd6210-fb0f-3bb4-93e4-4334068e581b",
                                                "text": "“[…] How scary it is to know that everyone I love depends on me! I’m afraid I’ll do something wrong.”"
                                            },
                                            {
                                                "example_id": "7920c434-3def-4d88-946a-98c43146b6ec",
                                                "sense_id": "1bfd6210-fb0f-3bb4-93e4-4334068e581b",
                                                "text": "Age notwithstanding, none of these men seem interested in sailing to Byzantium anyway: Justine’s got them all on the last stage to someplace wilder and scarier, where Yeats’s “monuments of unaging intellect” are thoroughly beside the point."
                                            },
                                            {
                                                "example_id": "168702fc-1f9d-4206-9c58-e4aec7fa3b41",
                                                "sense_id": "1bfd6210-fb0f-3bb4-93e4-4334068e581b",
                                                "text": "The biggest, scariest, scarriest man in the room said, “It's about time, Jones.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e112b00-3221-3ef0-a717-89c16e86cece",
                                        "entry_id": "3d34f4a2-a911-3ad7-9d1e-79ed215aa270",
                                        "glosses": [
                                            "Uncannily striking or surprising."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27e3ce6d-ed71-4558-b93f-a8fdf918fe83",
                                                "sense_id": "6e112b00-3221-3ef0-a717-89c16e86cece",
                                                "text": "Linda changed her hair, and it’s scary how much she looks like her mother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76d19256-2968-351f-bb3c-6256af2ca393",
                                        "entry_id": "3d34f4a2-a911-3ad7-9d1e-79ed215aa270",
                                        "glosses": [
                                            "Subject to sudden alarm; easily frightened."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96adbcf1-9b17-4d55-ae12-c23e2edc9d47",
                                                "sense_id": "76d19256-2968-351f-bb3c-6256af2ca393",
                                                "text": "“Whist! whist!” said Natty, in a low voice, on hearing a slight sound made by Elizabeth, in bending over the side of the canoe, in eager curiosity; “’tis a sceary animal, and it’s a far stroke for a spear. […]”"
                                            },
                                            {
                                                "example_id": "c6570ac1-d4c2-4485-9efa-59c671f47c9e",
                                                "sense_id": "76d19256-2968-351f-bb3c-6256af2ca393",
                                                "text": "“She’s cursed,” said the skipper; “speak her fair:\nI’m scary always to see her shake\nHer wicked head, with its wild gray hair,\nAnd nose like a hawk, and eyes like a snake.”"
                                            },
                                            {
                                                "example_id": "e2653427-2d21-4305-bc29-28a10740cf5c",
                                                "sense_id": "76d19256-2968-351f-bb3c-6256af2ca393",
                                                "text": "And let us say to these interests that, until the Buy-It-Made-In-Texas movement co-operates with the farmers, we are going to be a little scary of the snare."
                                            },
                                            {
                                                "example_id": "02324211-e955-481a-a5de-47324083f7eb",
                                                "sense_id": "76d19256-2968-351f-bb3c-6256af2ca393",
                                                "text": "The two brothers stood over the dead rat […].\n“Please, Bigger, take ’im out,” Vera begged.\n“Aw, don’t be so scary,” Buddy said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "026de732-ce9d-3326-afc3-b88bd100dad4",
                                        "entry_id": "17f97eea-d9bf-3c79-8ff4-ff107fafd457",
                                        "glosses": [
                                            "To a scary extent; scarily."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7366aba3-5ce0-42d4-a470-fa80d1eebe1c",
                                                "sense_id": "026de732-ce9d-3326-afc3-b88bd100dad4",
                                                "text": "[T]he main reason I don't want to give her a GA is she's so scary fat!"
                                            },
                                            {
                                                "example_id": "e5c36415-d1ab-4ab6-a5cf-0f57f271a0a9",
                                                "sense_id": "026de732-ce9d-3326-afc3-b88bd100dad4",
                                                "text": "At 199 centimetres and a hundred kilos going up, he was scary big and he found work as a bouncer and enforcer[.]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e955b311-2649-3717-9291-1c54ef307d55",
                                        "entry_id": "c3e8cb21-d80b-3c33-beac-115cebfc1303",
                                        "glosses": [
                                            "Barren land having only a thin coat of grass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
