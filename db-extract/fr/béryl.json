        "fr-extract.jsonl": [
            {
                "entry_id": "425cd883-a853-313d-b4cc-243261d81e34",
                "word": "Béryl",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2a257e28-fee9-3796-a42b-ffbee5dfcfaa",
                        "entry_id": "425cd883-a853-313d-b4cc-243261d81e34",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60fcb09-77e1-4b96-b194-42ec67a8ecca",
                                "sense_id": "2a257e28-fee9-3796-a42b-ffbee5dfcfaa",
                                "text": "Aux championnats d’Europe en petit bassin les nageuses françaises Charlotte Bonnet et Béryl Gastaldello ont pris l’or et l’argent, jeudi en Roumanie."
                            },
                            {
                                "example_id": "9015c33c-4706-486c-8a37-b9fa079a5d6c",
                                "sense_id": "2a257e28-fee9-3796-a42b-ffbee5dfcfaa",
                                "text": "Cette famille a trois générations : la vieille madame Fairfield qui a deux filles : Linda, qui a épousé M. Stanley Burnell, et Béryl, qui n’est pas mariée ; les Burnell ont trois petites filles, Isabel, Lottie et Kézia."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8a3f63a1-702f-3478-a655-50aa48ae1b75",
                "word": "béryl",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0635b40e-5d67-41db-b59f-73226751dbaf",
