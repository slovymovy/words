                        "source_entry_id": "07b394df-f2e3-317c-a8ad-e5164e85b16d",
                        "source_sense_id": "df920ea2-091c-326e-99d9-733ed93642eb",
                        "source_sense_description": "Qui n’est pas compatible.",
