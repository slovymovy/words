{
    "word_family": [
        "degrade",
        "degradation",
        "degrader"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "62f09302-0c8a-3ce5-beca-57dcc39ef7c3",
                    "sense_definition": "Causing a person to feel a loss of self-respect or dignity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humiliation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Retrieving my dropped possessions from the mud was a <w>degrading</w> experience.",
                            "target_lang_translations": {
                                "nl": "Het ophalen van mijn gevallen bezittingen uit de modder was een <w>vernederende</w> ervaring.",
                                "ru": "Доставать упавшие вещи из грязи было <w>унизительным</w> опытом."
                            }
                        },
                        {
                            "text": "She felt that the constant criticism from her boss was deeply <w>degrading</w>.",
                            "target_lang_translations": {
                                "nl": "Ze vond de constante kritiek van haar baas diep <w>vernederend</w>.",
                                "ru": "Она чувствовала, что постоянная критика начальника была глубоко <w>унизительной</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "humiliating",
                        "demeaning",
                        "shameful"
                    ],
                    "antonyms": [
                        "dignifying"
                    ],
                    "common_phrases": [
                        "degrading experience"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets dat ervoor zorgt dat iemand zijn zelfrespect of waardigheid verliest.",
                        "ru": "Заставляющий человека чувствовать потерю самоуважения или собственного достоинства."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vernederend",
                                "target_lang_sense_clarification": "Iets dat je eer aantast of je een minderwaardig gevoel geeft."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "унизительный",
                                "target_lang_sense_clarification": "оскорбляющий достоинство или самолюбие"
                            },
                            {
                                "target_lang_word": "унижающий",
                                "target_lang_sense_clarification": "принижающий чьё-либо достоинство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36f55a99-43a0-3084-a9ba-55b334f365f3",
                    "sense_definition": "The act or process of lowering the status or quality of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>degrading</w> of the environment by industrial waste is a major concern.",
                            "target_lang_translations": {
                                "nl": "De voortdurende <w>achteruitgang</w> van het milieu door industrieel afval is een grote zorg.",
                                "ru": "Постоянная <w>деградация</w> окружающей среды промышленными отходами вызывает серьезное беспокойство."
                            }
                        },
                        {
                            "text": "He spoke about the <w>degrading</w> of professional standards within the organization.",
                            "target_lang_translations": {
                                "nl": "Hij sprak over de <w>degradatie</w> van professionele standaarden binnen de organisatie.",
                                "ru": "Он говорил о <w>падении</w> профессиональных стандартов внутри организации."
                            }
                        }
                    ],
                    "synonyms": [
                        "deterioration",
                        "debasement"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het proces van het verlagen van de status, kwaliteit of waarde van iets.",
                        "ru": "Действие или процесс ухудшения качества, статуса или ценности чего-либо."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "achteruitgang",
                                "target_lang_sense_clarification": "Het proces waarbij de kwaliteit van iets vermindert."
                            },
                            {
                                "target_lang_word": "degradatie",
                                "target_lang_sense_clarification": "Het proces van kwaliteitsverlies of verlaging in rang."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "деградация",
                                "target_lang_sense_clarification": "постепенное ухудшение или упадок"
                            },
                            {
                                "target_lang_word": "ухудшение",
                                "target_lang_sense_clarification": "снижение качества чего-либо"
                            },
                            {
                                "target_lang_word": "разрушение",
                                "target_lang_sense_clarification": "процесс распада или нарушения структуры"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6169fd60-3417-349f-8f95-7965f0664105",
                    "sense_definition": "Present participle and gerund of <w>degrade</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemicals are <w>degrading</w> the quality of the water supply.",
                            "target_lang_translations": {
                                "nl": "De chemicaliën zijn de kwaliteit van de watervoorziening aan het <w>aantasten</w>.",
                                "ru": "Химикаты <w>ухудшают</w> качество водопроводной воды."
                            }
                        },
                        {
                            "text": "He is <w>degrading</w> his own reputation by lying to his colleagues.",
                            "target_lang_translations": {
                                "nl": "Hij is zijn eigen reputatie aan het <w>verslechteren</w> door tegen zijn collega's te liegen.",
                                "ru": "Он <w>подрывает</w> собственную репутацию, обманывая коллег."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het proces waarbij iets in kwaliteit afneemt of verslechtert.",
                        "ru": "Форма настоящего времени или причастие глагола degrade: ухудшать качество, приводить в упадок или разрушаться."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "aantasten",
                                "target_lang_sense_clarification": "Iets beschadigen of de kwaliteit ervan verminderen."
                            },
                            {
                                "target_lang_word": "verslechteren",
                                "target_lang_sense_clarification": "Minder goed maken of worden."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ухудшающий",
                                "target_lang_sense_clarification": "снижающий качество или свойства"
                            },
                            {
                                "target_lang_word": "разрушающий",
                                "target_lang_sense_clarification": "приводящий к распаду или повреждению"
                            },
                            {
                                "target_lang_word": "унижающий",
                                "target_lang_sense_clarification": "умаляющий чье-либо достоинство или статус"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}