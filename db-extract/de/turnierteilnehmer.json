                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f84086e4-4958-4c69-9472-78194bbdd2ea",
                                "sense_id": "b014fcb7-298d-3955-90d9-35bcf5d234b0",
                                "text": "Die Turnierteilnehmer versammelten sich in der Eingangshalle."
                            },
                            {
                                "example_id": "421bab2f-32e7-4a16-80a5-13dbc4ecc9b8",
                                "sense_id": "b014fcb7-298d-3955-90d9-35bcf5d234b0",
                                "text": "„Beim 2. Gourmet Major im Golfclub Dellach wurden die Turnierteilnehmer von sechs Köchen kulinarisch verwöhnt.“"
                            },
                            {
                                "example_id": "5f1155c6-6600-4103-bcd5-5833861dc62b",
                                "sense_id": "b014fcb7-298d-3955-90d9-35bcf5d234b0",
                                "text": "„Es liegt in der Natur der Sache, dass alle Turnierteilnehmer enttäuscht sind – ausser die Sieger.“"
                            }
                        ],
