                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7e6d26a-1484-3a44-a24e-a6d906840eaa",
                        "entry_id": "d43f2fe5-a784-345d-a42f-b4f73108916a",
                        "glosses": [
                            "Étoffe de coton croisée pelucheuse sur une face, utilisée en bonneterie et en chemiserie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b127a42f-41f0-47e5-b94f-8600cc2affaf",
                                "sense_id": "a7e6d26a-1484-3a44-a24e-a6d906840eaa",
                                "text": "Doublure de finette."
                            },
                            {
                                "example_id": "e97fe42a-85b8-4109-a873-191e43f8fc7e",
                                "sense_id": "a7e6d26a-1484-3a44-a24e-a6d906840eaa",
                                "text": "Chemise de nuit en finette."
                            },
                            {
                                "example_id": "1403cc99-c898-468d-8313-796d8d5a9506",
                                "sense_id": "a7e6d26a-1484-3a44-a24e-a6d906840eaa",
                                "text": "Il riait en boutonnant son gilet de finette et sa grosse capote verte."
                            },
                            {
                                "example_id": "37cce274-e811-441b-b48c-7f73731a0b43",
                                "sense_id": "a7e6d26a-1484-3a44-a24e-a6d906840eaa",
                                "text": "Un dimanche, Honoré s’avisa que son plus jeune frère, âgé de neuf ans, envoyait souvent rouler ses billes auprès du baquet ; il surprit sous les paupières à demi fermées un regard attentif qui cherchait à s’insinuer sous le jupon de finette de sa mère."
                            },
                            {
                                "example_id": "d41aab90-7e4c-47d7-9511-440674298364",
                                "sense_id": "a7e6d26a-1484-3a44-a24e-a6d906840eaa",
                                "text": "Les laines, les flanelles, les bonnets, les divers tricots de corps appelés par lui « finettes », tenaient dans la vie du Nain Jaune une place aussi considérable que ses livres.",
                                "translation": "— (Pascal Jardin, Le Nain jaune, éditions Julliard, 1978, page 60)"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b00620a-e0d0-3e4a-a97f-b2f437b5d459",
                        "entry_id": "d43f2fe5-a784-345d-a42f-b4f73108916a",
                        "glosses": [
                            "Pointe fine, sans tête, de 3 cm de longueur, utilisé par les charpentiers pour des assemblages provisoires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e750e03-290e-4b1c-b1e1-b30935aa2fdb",
                                "sense_id": "9b00620a-e0d0-3e4a-a97f-b2f437b5d459",
                                "text": "Ce cloueur PMP171 pour finettes sans tête va rejoindre votre matériel et outillage."
                            }
                        ]
                    },
