        "fr-extract.jsonl": [
            {
                "entry_id": "5bd399aa-d7ea-3867-a0cd-ba828b903551",
                "word": "saignée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b430a22d-aed1-4958-8ce1-579281e6bebe",
                        "entry_id": "5bd399aa-d7ea-3867-a0cd-ba828b903551",
                        "tags": [
                            "plural"
                        ],
                        "form": "saignées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ea0606f-4754-3aa2-990b-16fced2cf5ed",
                        "entry_id": "5bd399aa-d7ea-3867-a0cd-ba828b903551",
                        "glosses": [
                            "Ouverture d’une veine pour tirer du sang."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "7d608d15-4867-4225-a7a1-aa558746b9d6",
                                "sense_id": "9ea0606f-4754-3aa2-990b-16fced2cf5ed",
                                "text": "Freind, en parlant de Petrus Salimis, rapporte plusieurs exemples où, par l’intermittence du pouls, ce médecin prédisait certaines syncopes, dont il prévenait les paroxysmes par la saignée et par d'autres remèdes […]."
                            },
                            {
                                "example_id": "0955a800-055c-46cd-8956-a2dddf26a554",
                                "sense_id": "9ea0606f-4754-3aa2-990b-16fced2cf5ed",
                                "text": "— Vous essayez une saignée sur un homme qui va mourir dans deux heures. Sur quoi les sots pourront dire que la saignée l’a tué."
                            },
                            {
                                "example_id": "aabce7d9-8a79-4514-9337-d925a2002e9b",
                                "sense_id": "9ea0606f-4754-3aa2-990b-16fced2cf5ed",
                                "text": "Lorsqu’un fellah est malade, il s’administre des remèdes de cheval. Très dur à lui-même, il supporte le mal d’une façon superbe. La saignée joue un grand rôle chez les Arabes : on en voit se taillader eux-mêmes gaillardement les bras et les jambes à coups de couteau."
                            },
                            {
                                "example_id": "6066c88c-29fc-4f78-b8aa-a8ff17b2d76f",
                                "sense_id": "9ea0606f-4754-3aa2-990b-16fced2cf5ed",
                                "text": "Une saignée! C'est un terme ancien désignant un prélèvement sanguin pratiqué sur un malade afin d'améliorer son état."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd80b3a7-12ef-3111-8f75-b2233de5646a",
                        "entry_id": "5bd399aa-d7ea-3867-a0cd-ba828b903551",
                        "glosses": [
                            "Sang qu’on tire par l’ouverture d’une veine."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "947a92b9-a7d3-4ca1-94c0-f0af1c241fd3",
                                "sense_id": "dd80b3a7-12ef-3111-8f75-b2233de5646a",
                                "text": "Ils ont agrippé Fontaine, et ils l’ont conduit sur l’échafaud. Là, ils l’ont couché de force sous la lunette. Il s’est débattu comme un porc avant la saignée, et il a chialé comme un gosse."
                            },
                            {
                                "example_id": "e3bbdb58-e806-429c-b1f6-b0d43332bb23",
                                "sense_id": "dd80b3a7-12ef-3111-8f75-b2233de5646a",
                                "text": "Grande, abondante saignée."
                            },
                            {
                                "example_id": "527ad871-3279-4469-9bba-d6215000fbe3",
                                "sense_id": "dd80b3a7-12ef-3111-8f75-b2233de5646a",
                                "text": "Une saignée copieuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "59ba201c-8247-3e5d-b2b0-f266582d9697",
                        "entry_id": "5bd399aa-d7ea-3867-a0cd-ba828b903551",
                        "glosses": [
                            "Se dit quand on a tiré de quelqu’un beaucoup d’argent, quand on a exigé de lui une somme considérable."
                        ],
                        "tags": [
                            "figuratively",
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "6487a8fd-0da4-4aec-ae2f-9f079c8d9c55",
                                "sense_id": "59ba201c-8247-3e5d-b2b0-f266582d9697",
                                "text": "C’est une grande, une rude saignée qu’on lui a faite, qu’on a faite à sa bourse."
                            }
                        ]
                    },
                    {
                        "sense_id": "497dc408-d3e9-3926-9888-55c153adc600",
                        "entry_id": "5bd399aa-d7ea-3867-a0cd-ba828b903551",
                        "glosses": [
                            "Partie interne de la jointure du bras et de l’avant-bras, qui est l’endroit où l’on tire le plus souvent du sang."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "e476322e-4212-409a-a30d-32f56776b22e",
                                "sense_id": "497dc408-d3e9-3926-9888-55c153adc600",
                                "text": "Je le vis mettre son arme à la saignée de son bras."
                            },
                            {
                                "example_id": "8c73a027-3be4-4110-b7f3-c97946a2e828",
                                "sense_id": "497dc408-d3e9-3926-9888-55c153adc600",
                                "text": "[…] il avait envie de s’embrasser la saignée du bras."
                            },
                            {
                                "example_id": "e29b2d1d-dadc-4504-86d2-0e481f6c41e4",
                                "sense_id": "497dc408-d3e9-3926-9888-55c153adc600",
                                "text": "En effet Pierre, dont les enjambées font trembler la maison pendant ses soliloques, s’arrête, se détend, pose ses lèvres à la saignée du poignet de sa femme comme on boit l’eau thermale à l’endroit où la source est la plus chaude."
                            },
                            {
                                "example_id": "9d305638-c39b-438f-991f-bab58cc04e68",
                                "sense_id": "497dc408-d3e9-3926-9888-55c153adc600",
                                "text": "Son bras nu, à la saignée pâle, marquée d’une veine bleue, pendait jusqu’à terre, la main ouverte."
                            }
                        ]
                    },
                    {
                        "sense_id": "021e1c1b-7d2b-3e12-88c7-00719adeb0bd",
                        "entry_id": "5bd399aa-d7ea-3867-a0cd-ba828b903551",
                        "glosses": [
                            "Pertes d’hommes faites durant une guerre."
                        ],
                        "tags": [
                            "figuratively",
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "16190154-affa-4f01-b27e-b21495c8dbe0",
                                "sense_id": "021e1c1b-7d2b-3e12-88c7-00719adeb0bd",
                                "text": "La douloureuse saignée subie par la France au cours de la Grande Guerre."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d5dbf88-93b2-3770-97b7-0ae7cdfa8257",
                        "entry_id": "5bd399aa-d7ea-3867-a0cd-ba828b903551",
                        "glosses": [
                            "Rigole que l’on fait pour tirer de l’eau de quelque endroit."
                        ],
                        "tags": [
                            "analogy",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "309f08f1-9712-4c7c-8184-b345e461dfbf",
                                "sense_id": "9d5dbf88-93b2-3770-97b7-0ae7cdfa8257",
                                "text": "Il est d'ailleurs impossible de compter pendant les sécheresses sur la totalité du produit alimentaire parce que les riverains de la Bar profitant de ce qu'elle n'est pas considérée comme rivière navigable en amont de la prise d'eau y font de nombreuses saignées pour l'irrigation de leurs prairies ; […]."
                            },
                            {
                                "example_id": "34d828b9-4135-4002-ab2d-5e719b233827",
                                "sense_id": "9d5dbf88-93b2-3770-97b7-0ae7cdfa8257",
                                "text": "Le Guadalaviar, traversé par cinq beaux ponts de pierre, et bordé d’une superbe promenade, passe à côté de la ville, presque sous les remparts. Les nombreuses saignées qu’on pratique à sa veine pour l’arrosement rendent les trois quarts de l’année ses cinq ponts un objet de luxe et d’ornement."
                            },
                            {
                                "example_id": "b425e7ec-00b4-4056-9734-739ac0532ee5",
                                "sense_id": "9d5dbf88-93b2-3770-97b7-0ae7cdfa8257",
                                "text": "[…], les bêtes levèrent leur mufle humide et, dociles à l’invite de leur jeune gardien, gravirent le coteau pour reprendre, par la saignée pratiquée dans le petit bois qui délimitait en haut leur pâture, le chemin de terre bordé de haies vives aboutissant au village."
                            }
                        ]
                    },
                    {
                        "sense_id": "b91589c4-1adc-3401-a915-ecf7c1da5eb6",
                        "entry_id": "5bd399aa-d7ea-3867-a0cd-ba828b903551",
                        "glosses": [
                            "Entaille profonde de faible épaisseur, par exemple dans un mur."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "ae2935ad-0e77-48b1-873e-ff311e8a62ed",
                                "sense_id": "b91589c4-1adc-3401-a915-ecf7c1da5eb6",
                                "text": "Faire une saignée dans une cloison pour faire passer des câbles électriques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6050be25-7aa9-48b6-8f93-95398085c631",
                        "source_entry_id": "5bd399aa-d7ea-3867-a0cd-ba828b903551",
                        "source_sense_description": "Ouverture d’une veine pour tirer du sang.",
                        "target_lang_word": "Aderlass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aderlass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03287503-81d8-3783-aa4b-4bc57f7bc6b6",
                                        "entry_id": "107d2bf0-86ea-3ad1-848b-8af481a0f047",
                                        "glosses": [
                                            "Absaugenlassen von Blut durch Blutegel, früher auch Ablaufenlassen von Blut"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8a723c6-42fb-40a0-a12d-74fd224a38de",
                                                "sense_id": "03287503-81d8-3783-aa4b-4bc57f7bc6b6",
                                                "text": "Der König wurde durch allzu häufigen Aderlass derart geschwächt, dass er seinen Krankheiten erlag."
                                            },
                                            {
                                                "example_id": "83c482b6-9eb6-4ad7-a135-3ec91c87f012",
                                                "sense_id": "03287503-81d8-3783-aa4b-4bc57f7bc6b6",
                                                "text": "„Da er keine andere Behandlungsmethode kannte, fuhr er mit dem Aderlass fort und verabreichte Einläufe, die den Körper purgieren sollten.“"
                                            },
                                            {
                                                "example_id": "5f8bb73e-aedb-4f62-bd60-12a50523d717",
                                                "sense_id": "03287503-81d8-3783-aa4b-4bc57f7bc6b6",
                                                "text": "„Der Regimentsarzt kam und fand einen Aderlass notwendig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "343fd925-c085-323c-9ec5-da767f4a3928",
                                        "entry_id": "107d2bf0-86ea-3ad1-848b-8af481a0f047",
                                        "glosses": [
                                            "bedeutender Substanzverlust"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1bdd263-e70b-4026-8824-603561f32819",
                                                "sense_id": "343fd925-c085-323c-9ec5-da767f4a3928",
                                                "text": "Mathematik und Naturwissenschaft an deutschen Hochschulen haben den Aderlass durch Vertreibung der jüdischen Forscher ab 1933 niemals überwunden, und damit verlor die deutsche Sprache auch ihren Weltrang in diesen Fächern."
                                            },
                                            {
                                                "example_id": "b224c6e7-8a39-4331-9070-09580c8f2abb",
                                                "sense_id": "343fd925-c085-323c-9ec5-da767f4a3928",
                                                "text": "„Indessen ging der Vormarsch der Roten Armee nicht so glatt wie erwartet, und der Preis für das Vorankommen war hoch, der Aderlass gewaltig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
