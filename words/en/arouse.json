{
    "word_family": [
        "arousal",
        "arousable",
        "unaroused"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03d8faae-92b7-33ff-b4a5-999eafada23d",
                    "sense_definition": "To stimulate or induce a particular feeling, emotion, or response.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "stimulate_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mysterious letter was enough to <w>arouse</w> her curiosity about her family's past.",
                            "target_lang_translations": {
                                "ru": "Таинственного письма было достаточно, чтобы <w>пробудить</w> её любопытство к прошлому своей семьи.",
                                "nl": "De mysterieuze brief was genoeg om haar nieuwsgierigheid naar het verleden van haar familie te <w>opwekken</w>."
                            }
                        },
                        {
                            "text": "His strange behavior began to <w>arouse</w> suspicion among his closest colleagues at the office.",
                            "target_lang_translations": {
                                "ru": "Его странное поведение начало <w>вызывать</w> подозрения у его ближайших коллег по офису.",
                                "nl": "Zijn vreemde gedrag begon argwaan te <w>opwekken</w> bij zijn naaste collega's op kantoor."
                            }
                        }
                    ],
                    "synonyms": [
                        "stimulate",
                        "awaken",
                        "excite",
                        "kindle",
                        "provoke"
                    ],
                    "antonyms": [
                        "quell",
                        "stifle",
                        "suppress"
                    ],
                    "common_phrases": [
                        "arouse suspicion",
                        "arouse curiosity",
                        "arouse interest",
                        "arouse anger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стимулировать или вызывать определенное чувство, эмоцию или реакцию.",
                        "nl": "Het stimuleren of teweegbrengen van een bepaald gevoel, emotie of reactie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "становиться причиной появления чувства или реакции"
                            },
                            {
                                "target_lang_word": "пробуждать",
                                "target_lang_sense_clarification": "способствовать возникновению интереса или чувств"
                            },
                            {
                                "target_lang_word": "возбуждать",
                                "target_lang_sense_clarification": "порождать мысли или эмоции"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "opwekken",
                                "target_lang_sense_clarification": "het doen ontstaan van een gevoel of reactie"
                            },
                            {
                                "target_lang_word": "aanwakkeren",
                                "target_lang_sense_clarification": "het versterken of stimuleren van een emotie of interesse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff08e762-d70c-3e9f-b3a7-5e1932a90040",
                    "sense_definition": "To cause someone to feel sexual desire or excitement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sexual_stimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The romantic atmosphere of the candlelit dinner was intended to <w>arouse</w> his partner.",
                            "target_lang_translations": {
                                "ru": "Романтическая атмосфера ужина при свечах была призвана <w>возбудить</w> его партнёршу.",
                                "nl": "De romantische sfeer van het diner bij kaarslicht was bedoeld om zijn partner te <w>opwinden</w>."
                            }
                        },
                        {
                            "text": "He found that certain scents had the power to <w>arouse</w> him deeply.",
                            "target_lang_translations": {
                                "ru": "Он обнаружил, что определённые запахи способны глубоко его <w>возбуждать</w>.",
                                "nl": "Hij ontdekte dat bepaalde geuren de kracht hadden om hem diep te <w>opwinden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "turn on",
                        "excite",
                        "stimulate"
                    ],
                    "common_phrases": [
                        "sexually arouse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо сексуальное желание или возбуждение.",
                        "nl": "Iemand een seksueel verlangen of opwinding laten voelen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возбуждать",
                                "target_lang_sense_clarification": "вызывать половое влечение"
                            },
                            {
                                "target_lang_word": "сексуально возбуждать",
                                "target_lang_sense_clarification": "вызывать физическое влечение"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "opwinden",
                                "target_lang_sense_clarification": "erotisch prikkelen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ec6f3c8-c2f8-3ddd-ba1d-b9fb6d93c454",
                    "sense_definition": "To wake someone from sleep or a state of inactivity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wake_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud thunderclap was enough to <w>arouse</w> him from a very deep sleep.",
                            "target_lang_translations": {
                                "ru": "Громкого раската грома было достаточно, чтобы <w>пробудить</w> его от очень глубокого сна.",
                                "nl": "De harde donderslag was genoeg om hem uit een zeer diepe slaap te <w>wekken</w>."
                            }
                        },
                        {
                            "text": "It was difficult to <w>arouse</w> the patient after the heavy sedation had worn off.",
                            "target_lang_translations": {
                                "ru": "Было трудно <w>привести в чувство</w> пациента после того, как действие сильных седативных средств закончилось.",
                                "nl": "Het was moeilijk om de patiënt te <w>wekken</w> nadat de sterke verdoving was uitgewerkt."
                            }
                        }
                    ],
                    "synonyms": [
                        "wake",
                        "awaken",
                        "rouse",
                        "waken"
                    ],
                    "antonyms": [
                        "lull"
                    ],
                    "common_phrases": [
                        "arouse from sleep"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often literary or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разбудить кого-либо или вывести из состояния бездействия.",
                        "nl": "Iemand uit zijn slaap halen of uit een toestand van inactiviteit brengen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробуждать",
                                "target_lang_sense_clarification": "прерывать чей-либо сон (книжн.)"
                            },
                            {
                                "target_lang_word": "разбудить",
                                "target_lang_sense_clarification": "заставить проснуться"
                            },
                            {
                                "target_lang_word": "выводить",
                                "target_lang_sense_clarification": "из состояния сна или апатии"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "wekken",
                                "target_lang_sense_clarification": "iemand uit de slaap halen"
                            },
                            {
                                "target_lang_word": "uit zijn slaap halen",
                                "target_lang_sense_clarification": "iemand wakker maken"
                            }
                        ]
                    }
                }
            ]
        }
