                        "glosses": [
                            "Relatif aux marabouts, religieux musulmans, ou au maraboutisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "203cbf49-09c2-4778-8231-28a0d62d12c9",
                                "sense_id": "dbcc22cf-741b-32ee-825f-b6ed2a096f98",
                                "text": "La nommée Aziza-bent-Mohamed, femme d’origine maraboutique."
                            },
                            {
                                "example_id": "94f58868-ea11-493c-b9f2-a8fe6e6e35bc",
                                "sense_id": "dbcc22cf-741b-32ee-825f-b6ed2a096f98",
                                "text": "Le système colonial alimente les chefferies et réactive les vieilles confréries maraboutiques."
                            },
                            {
                                "example_id": "bdf30689-1bd9-4fc2-b945-d5c3e2ac9b4b",
                                "sense_id": "dbcc22cf-741b-32ee-825f-b6ed2a096f98",
                                "text": "Dans chaque dechra on trouve une à deux familles maraboutiques. Les mrabtin font remonter leur généalogie au prophète Mohamed par l'intermédiaire de sa fille Fatima et de son gendre Ali."
                            },
                            {
                                "example_id": "7376bf9e-3ede-422b-9bfc-457147cf9612",
                                "sense_id": "dbcc22cf-741b-32ee-825f-b6ed2a096f98",
                                "text": "Taos, en connaisseuse, remarque le symbole qu’arborait la voyante sur son menton… C’est une merabta, se dit Taos, c’est-à-dire qu’elle était de descendance sainte ou maraboutique."
                            }
