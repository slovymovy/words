                        ],
                        "examples": [
                            {
                                "example_id": "a1b40fa1-c307-44e6-937a-f42bad14ae30",
                                "sense_id": "82ebfc92-dd2b-3741-a020-c90e3ec7d3ef",
                                "text": "Tak czy inaczej – znów jest pan posiadaczem tej cholernej willi"
                            },
                            {
                                "example_id": "f55293c9-53ba-4c83-b80b-1430c5a4596e",
                                "sense_id": "82ebfc92-dd2b-3741-a020-c90e3ec7d3ef",
                                "text": "Nie chciała się bawić tą cholerną lalką i mama obiecała jej suknię na bal karnawałowy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "27933ebd-bd55-307e-913d-1a1906999f57",
