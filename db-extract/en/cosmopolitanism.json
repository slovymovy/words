{
    "word": "cosmopolitanism",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4a471713-ea04-3247-a519-0ab1ac2119f8",
                "word": "cosmopolitanism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3cbb642a-6176-4a0c-8f8c-bcef87c2d2f8",
                        "entry_id": "4a471713-ea04-3247-a519-0ab1ac2119f8",
                        "tags": [
                            "plural"
                        ],
                        "form": "cosmopolitanisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea9cc41c-dfc3-3974-bdf5-269bfec547b5",
                        "entry_id": "4a471713-ea04-3247-a519-0ab1ac2119f8",
                        "glosses": [
                            "The idea that all of humanity belongs to a single moral community."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "82f790e8-88ba-4c68-878c-bf531c13728c",
                                "sense_id": "ea9cc41c-dfc3-3974-bdf5-269bfec547b5",
                                "text": "The philosophy of cosmopolitanism underlies theories of global citizenship. Cosmopolitanism is the ability to balance a local and global identity. A cosmopolitan individual engages meaningfully with different cultures and feels at home in the world."
                            },
                            {
                                "example_id": "77c1bcfe-3c53-41fd-a97e-4bd261ec4e1a",
                                "sense_id": "ea9cc41c-dfc3-3974-bdf5-269bfec547b5",
                                "text": "To present the world anthropologies project (WA), this article explores the existence of three kinds of anthropological cosmopolitanisms and cosmopolitics: imperial, liberal, and radical."
                            }
                        ]
                    },
                    {
                        "sense_id": "a88b5e7d-7b88-30df-81d4-5353d3471e73",
                        "entry_id": "4a471713-ea04-3247-a519-0ab1ac2119f8",
                        "glosses": [
                            "The quality of being cosmopolitan."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de27fc72-177c-4eb2-b051-5eb20ec0a192",
                        "source_entry_id": "4a471713-ea04-3247-a519-0ab1ac2119f8",
