                                "example_id": "20a2d12e-129e-46ee-8788-dbf2efac3361",
                                "sense_id": "634e09e6-770d-30c9-91cf-00b83c05a7c2",
                                "text": "„Insgesamt acht Jahre hat er von der ersten Idee bis zur Patentfreigabe benötigt.“"
                            }
