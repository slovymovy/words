                                                "sense_id": "9fb81ed1-0b9d-396f-98eb-e44bbbebff8f",
                                                "text": "That kid is spoilt rotten."
                                            },
                                            {
                                                "example_id": "0e6ccabb-2a80-4bca-91c3-ba3f58296277",
                                                "sense_id": "9fb81ed1-0b9d-396f-98eb-e44bbbebff8f",
                                                "text": "The girls fancy him something rotten."
                                            },
                                            {
                                                "example_id": "8f37838a-4fee-4e3e-96a3-54b5f832f9eb",
                                                "sense_id": "9fb81ed1-0b9d-396f-98eb-e44bbbebff8f",
                                                "text": "\"It's old man Challenger's show and we are here by his good will, so it would be rotten bad form if we didn't follow his instructions to the letter.\""
                                            },
                                            {
                                                "example_id": "50e516bc-b4e9-4daa-8a63-b62e949e890a",
                                                "sense_id": "9fb81ed1-0b9d-396f-98eb-e44bbbebff8f",
                                                "text": "\"You're not only crazy,\" Oscar said bitterly, \"you're rotten jealous. You can go to hell.\" He stomped away."
                                            }
                                        ]
                                    }
                                ]
