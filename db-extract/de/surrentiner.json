                "senses": [
                    {
                        "sense_id": "4729632b-b5e9-3c08-b30d-925c0fa366fb",
                        "entry_id": "81b21044-aca5-3a4a-a90b-e8945a22783c",
                        "glosses": [
                            "Wein, der im Italien der römischen Antike (in der Gegend der heutigen Stadt Sorrent, Kampanien) angebaut und produziert wurde"
                        ],
                        "tags": [
                            "römische Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "34f8620e-12d0-41ad-a28d-1d12eb4459d1",
                                "sense_id": "4729632b-b5e9-3c08-b30d-925c0fa366fb",
                                "text": "„Die große Region an der malerischen Westküste rund um Neapel war bereits im antiken Rom für feine Weine hoch geschätzt. Namen wie Massiker, Surrentiner und vor allem Falerner tauchen in der antiken Literatur immer wieder auf und wurden in den höchsten Tönen gepriesen.“"
                            },
                            {
                                "example_id": "e82c4901-c649-48ab-ac5f-b3a517fe51b6",
                                "sense_id": "4729632b-b5e9-3c08-b30d-925c0fa366fb",
                                "text": "„Die Römer erkannten bald den Einfluss des Weinbaugebiets und des Weinjahrgangs. Falerner und Surrentiner waren nach 15 bis 20 Jahren Lagerung sehr geschätzt, wie sich bei Ausgrabungen in Pompeji zeigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
