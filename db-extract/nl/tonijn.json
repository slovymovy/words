                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "104857fb-f88e-30e4-b317-a35d5e243267",
                                        "entry_id": "bb53b60c-77b1-32b9-a44a-7bd880dad83a",
                                        "glosses": [
                                            "Grand poisson bleu argenté de la famille des scombridés, au corps allongé et hydrodynamique, très bon nageur, vivant en banc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8066885-4e75-4e40-87e9-69467c39a152",
                                                "sense_id": "104857fb-f88e-30e4-b317-a35d5e243267",
                                                "text": "Maquereaux, bonites, thazards, wahoos et thons sont tous membres de la famille des scombridés."
                                            },
                                            {
                                                "example_id": "686c0fa7-0839-4cb3-ba5c-0e845edc701c",
                                                "sense_id": "104857fb-f88e-30e4-b317-a35d5e243267",
                                                "text": "Les sardiniers et les pêcheurs de thon de Douarnenez, de Concarneau et d’Audierne, eux, sont les véritables prolétaires de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07c286da-b492-302a-8878-fdaef851c40b",
                                        "entry_id": "bb53b60c-77b1-32b9-a44a-7bd880dad83a",
                                        "glosses": [
                                            "Chair de ce poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be311a1c-8f35-432b-a300-a90a958086c5",
                                                "sense_id": "07c286da-b492-302a-8878-fdaef851c40b",
                                                "text": "C'est aussi lui qui avait exigé qu'il y ait au centre de la boutique un beau stand réfrigéré, avec du thon frais à la coupe et des produits fins comme des tartares de thon, des carpaccios de thon et des recettes exotiques comme le thon teriyaki, ou le mi-cuit aux graines de sésame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f95f787c-2c0e-3086-9fba-d3262e1e2f7a",
                                        "entry_id": "bb53b60c-77b1-32b9-a44a-7bd880dad83a",
                                        "glosses": [
                                            "Personne laide."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "offensive"
                                        ],
                                        "note": "Dans ce sens, il est souvent employé à l'encontre des femmes ou des filles",
                                        "examples": [
                                            {
                                                "example_id": "b8441e3e-e0a6-4e14-bfc4-4289af345a36",
                                                "sense_id": "f95f787c-2c0e-3086-9fba-d3262e1e2f7a",
                                                "text": "Quand je suis partie, il discutait avec un thon, mais un thon... Si c'était un homme, elle aurait pu être le sosie de Quasimodo..."
                                            },
                                            {
                                                "example_id": "ea404c8c-06bb-40ce-ab5f-233502864cd9",
                                                "sense_id": "f95f787c-2c0e-3086-9fba-d3262e1e2f7a",
                                                "text": "Il était avec un cageot je ne te raconte pas. Une nana immonde. Même coincé sur une île déserte avec un thon pareil, je préférerais me taper une chèvre!"
                                            },
                                            {
                                                "example_id": "3c586495-b773-4d85-80a6-0072c3b55600",
                                                "sense_id": "f95f787c-2c0e-3086-9fba-d3262e1e2f7a",
                                                "text": "Plus sérieusement, moi, voilà, je suis pas difficile non plus et je traîne pas trop avec des thons non plus, mais elles sont toutes en couple, elles ont des gosses, ou alors c'est une ex."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
