                "senses": [
                    {
                        "sense_id": "0a36931a-ede4-3f0e-8854-e19b78fb687c",
                        "entry_id": "5837c6db-1dd3-3e6a-b50c-4c8162348d0f",
                        "glosses": [
                            "A very small South American deer of the genus Pudu (in some classifications divided to Pudu and Pudella), native to the Andes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24c7be6e-f6e7-4ff2-a9e2-f91ace884895",
                                "sense_id": "0a36931a-ede4-3f0e-8854-e19b78fb687c",
                                "text": "Whereas the southern pudu is more uniformly dark chestnut-brown, the northern form is light but has a very dark (aggressive) face in both sexes."
                            },
                            {
                                "example_id": "9c69e2c5-a26b-44fe-8e64-8b87b3c8132c",
                                "sense_id": "0a36931a-ede4-3f0e-8854-e19b78fb687c",
                                "text": "In the undergrowth, native pudú deer scutter, lower than knee-height and wary of visitors; even shyer are the tall, elegant huemul deer, threatened almost to extinction and now only to be found high up the mountainsides."
                            },
                            {
                                "example_id": "8c63b826-af2e-4584-bfdc-d0961679b45a",
                                "sense_id": "0a36931a-ede4-3f0e-8854-e19b78fb687c",
                                "text": "Although protected by law, pudus are hunted locally for their hide and meat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
