                                    {
                                        "sense_id": "50da4d02-fb7b-3be8-b166-d1d5bd1120f2",
                                        "entry_id": "d58f7f0e-f78f-3fbc-aa8f-77c49b3a32aa",
                                        "glosses": [
                                            "voire Relatif à un homme citadin qui soigne particulièrement son apparence."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23610dca-f8de-4f1b-b7d5-0b1fb404e715",
                                                "sense_id": "50da4d02-fb7b-3be8-b166-d1d5bd1120f2",
                                                "text": "Vous me direz que Paris n’est pas le Texas, que ce n’est pas la capitale mondiale de la virilité, et que pour chaque Alain Delon ou chaque Jean-Paul Belmondo que tu croises dans la rue, il y a 20 Fabrice Lucchini, reste qu’il y a une différence entre un métrosexuel et un gars qui porte une robe et des talons hauts!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e9759c3-2f1e-36d9-91c7-409b5f2d240c",
                                        "entry_id": "d58f7f0e-f78f-3fbc-aa8f-77c49b3a32aa",
                                        "glosses": [
                                            "voire Relatif à un homme hétérosexuel qui est considéré, sociologiquement, comme ayant des attributs communs aux homosexuels."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "métrosexuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92f78405-f4c6-3321-ace3-24678bda5a89",
                                        "entry_id": "66de9832-7012-3f32-9cb0-1c4bc57de959",
                                        "glosses": [
                                            "voire Homme citadin ayant un sens développé de l’esthétique, qui dépense énormément de temps et d’argent dans son apparence et son style de vie."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e8962f-abe1-4c64-ab80-768c32b05c50",
                                                "sense_id": "92f78405-f4c6-3321-ace3-24678bda5a89",
                                                "text": "C’est un vrai métrosexuel : il fait du body-building, ses pectoraux sont parfaits. […] Il ne mange de la viande rouge qu’une fois par semaine. […] Il est très in, en fait. Je veux dire qu’il présente bien. Les parfums sont son obsession, et c’est un fait : il sent toujours bon."
                                            },
                                            {
                                                "example_id": "231788ef-790e-4519-917f-decc0c7989a0",
                                                "sense_id": "92f78405-f4c6-3321-ace3-24678bda5a89",
                                                "text": "Le métrosexuel serait donc simplement un homme « évolué » qui ne s’encombre pas du bagage culturel machiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "891fd3f3-da72-30cd-b753-13b644eede76",
                                        "entry_id": "66de9832-7012-3f32-9cb0-1c4bc57de959",
                                        "glosses": [
                                            "voire Homme hétérosexuel qui est considéré, sociologiquement, comme ayant des attributs communs aux homosexuels."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63e51c26-b7c0-4dbf-b969-d5c1b022d62e",
                                                "sense_id": "891fd3f3-da72-30cd-b753-13b644eede76",
                                                "text": "Si on devait définir l’homme métrosexuel à partir de l’agrégat de clichés qui tourne autour du terme, on dirait qu’il s’agit d’un homme homosexuel passif, qui passe plus de temps dans la salle d’un bain qu’une femme (vous imaginez la honte !), s’épile, se coiffe, prend soin de sa peau, prend soin de ses mains… Tout comme une femme donc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
