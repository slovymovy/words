                            "166913db-9e1b-3564-aae0-7ead8e6322b2"
                        ],
                        "linkage_type": "synonyms",
                        "word": "sedert"
                    }
                ]
            },
            {
                "entry_id": "97e276a2-ce06-36d6-a00a-71e27a129ad2",
                "word": "sinds",
                "pos": "prep",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f375ef3-29c3-37fe-9301-ad99aa9ba77b",
                        "entry_id": "97e276a2-ce06-36d6-a00a-71e27a129ad2",
                        "glosses": [
                            "vanaf het moment van"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70573eb-3668-4185-adb6-e109b34d59e9",
                                "sense_id": "4f375ef3-29c3-37fe-9301-ad99aa9ba77b",
                                "text": "Hij is sinds vorige week in Rome."
                            },
                            {
                                "example_id": "499133d6-52be-415e-b19a-90097b1a5eab",
                                "sense_id": "4f375ef3-29c3-37fe-9301-ad99aa9ba77b",
                                "text": "‘Sinds de hotsprings heb ik je niet meer gezien.’ Met stralende ogen vertelde hij wat ik daar allemaal gemist had: een leuke groep meiden, een kampvuurtje en tot diep in de nacht in het warme water."
                            },
                            {
                                "example_id": "cfa2fb53-0552-42fb-8d7e-62b560eeac12",
                                "sense_id": "4f375ef3-29c3-37fe-9301-ad99aa9ba77b",
                                "text": "Den Haag is de eerste stad in Nederland die zo'n verbod invoerde. Sinds 1 januari zijn er geen fossiele reclames in bushokjes of op straat meer te zien. Het gaat bijvoorbeeld om reclames voor vliegreizen en cruisevakanties. De reisbranche was het niet eens met het verbod en spande een kort geding aan, schrijft Omroep West."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9adfcd6-f830-44ae-b82d-66b248fc2813",
                        "source_entry_id": "97e276a2-ce06-36d6-a00a-71e27a129ad2",
                        "source_sense_id": "4f375ef3-29c3-37fe-9301-ad99aa9ba77b",
                        "source_sense_description": "sedert, vanaf het moment dat",
                        "target_lang_word": "since",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "since",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d03f70b-f5bd-34cb-9047-96802e568c61",
                                        "entry_id": "a0168417-fe5c-3e68-b8f0-8f9aefa29add",
                                        "glosses": [
                                            "From a specified time in the past."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9daf040b-2439-46bc-a121-e2188866bbe9",
                                                "sense_id": "7d03f70b-f5bd-34cb-9047-96802e568c61",
                                                "text": "I met him last year, but haven't seen him since."
                                            },
                                            {
                                                "example_id": "0e9fe88e-2745-4bf1-a0e5-796df20cbdb0",
                                                "sense_id": "7d03f70b-f5bd-34cb-9047-96802e568c61",
                                                "text": "A short/long time since"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "since",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d06ddb8c-53c4-363a-ad1b-c43c4d488413",
                                        "entry_id": "822830e2-b17e-372d-b0a5-aa093e7015e2",
                                        "glosses": [
                                            "From: referring to a period of time ending in the present and defining it by the point in time at which it started, or the period in which its starting point occurred.",
                                            "Continuously during that period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3421fb05-a72a-4100-a796-d49425a89f40",
                                                "sense_id": "d06ddb8c-53c4-363a-ad1b-c43c4d488413",
                                                "text": "I'd known her only since the previous year, so from/since the moment we got married we’ve quarrelled."
                                            },
                                            {
                                                "example_id": "38d636b3-87d7-42d6-a697-b97ae5e42558",
                                                "sense_id": "d06ddb8c-53c4-363a-ad1b-c43c4d488413",
                                                "text": "I'd been working since six o’clock, and I was getting tired."
                                            },
                                            {
                                                "example_id": "74a482d5-0731-4dae-9542-817d0810da85",
                                                "sense_id": "d06ddb8c-53c4-363a-ad1b-c43c4d488413",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia."
                                            },
                                            {
                                                "example_id": "b3c178a8-185c-4c86-89bc-2ce738ae570c",
                                                "sense_id": "d06ddb8c-53c4-363a-ad1b-c43c4d488413",
                                                "text": "Since the 1980s, computers have had increasing roles in all aspects of human life—including an involvement in criminal acts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e3194da-93fd-33ea-9a50-1d4fb80b7c7a",
                                        "entry_id": "822830e2-b17e-372d-b0a5-aa093e7015e2",
                                        "glosses": [
                                            "From: referring to a period of time ending in the present and defining it by the point in time at which it started, or the period in which its starting point occurred.",
                                            "At certain points during that period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebf7bf94-61de-4fa3-bd53-036e20887ef2",
                                                "sense_id": "6e3194da-93fd-33ea-9a50-1d4fb80b7c7a",
                                                "text": "\"Mujtahidd\" has attracted almost 300,000 followers since the end of last year, when he began posting scandalous claims about the Saudi elite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "since",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a45cbb9a-76a6-3806-8534-ffa7ff60d72c",
                                        "entry_id": "90d24c01-a5fe-388b-9e8b-5fca5b28fa09",
                                        "glosses": [
                                            "From the time that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed34963d-206c-4554-9883-36c05b7eb60e",
                                                "sense_id": "a45cbb9a-76a6-3806-8534-ffa7ff60d72c",
                                                "text": "I have loved you since I first met you."
                                            },
                                            {
                                                "example_id": "e9b770f1-cf13-4de8-8f5e-51688b921b62",
                                                "sense_id": "a45cbb9a-76a6-3806-8534-ffa7ff60d72c",
                                                "text": "I've known her since I've lived in her street, but I've not seen her out of the house since her husband died."
                                            },
                                            {
                                                "example_id": "fa12c1af-2ca3-4334-9aab-3eb2bc852f96",
                                                "sense_id": "a45cbb9a-76a6-3806-8534-ffa7ff60d72c",
                                                "text": "He had one hand on the bounce bottle—and he'd never let go of that since he got back to the table—but he had a handkerchief in the other and was swabbing his deadlights with it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "330dc66f-3dcf-32e3-aba6-41d6e917a6bd",
                                        "entry_id": "90d24c01-a5fe-388b-9e8b-5fca5b28fa09",
                                        "glosses": [
                                            "Because."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c5cb614-20c1-4c6f-bf01-14b17e6889dd",
                                                "sense_id": "330dc66f-3dcf-32e3-aba6-41d6e917a6bd",
                                                "text": "Since you didn't call, we left without you."
                                            },
                                            {
                                                "example_id": "177433fb-fc95-4cf6-911a-7047255d9f63",
                                                "sense_id": "330dc66f-3dcf-32e3-aba6-41d6e917a6bd",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen.[…]The second note, the high alarum, not so familiar and always important since it indicates the paramount sin in Man's private calendar, took most of them by surprise although they had been well prepared."
                                            },
                                            {
                                                "example_id": "8be93c41-ef86-4480-b915-eba8177c8658",
                                                "sense_id": "330dc66f-3dcf-32e3-aba6-41d6e917a6bd",
                                                "text": "Since disbursement is the last step in the process of creating a mortgage instrument, the disbursement date may lag the transaction date by a considerable period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05822368-b24a-3035-85cb-9b66f29fe526",
                                        "entry_id": "90d24c01-a5fe-388b-9e8b-5fca5b28fa09",
                                        "glosses": [
                                            "When or that."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d66c4fc1-4d06-4e20-87a4-98c19b38a964",
                                                "sense_id": "05822368-b24a-3035-85cb-9b66f29fe526",
                                                "text": "O ſir Iohn, doe you remember ſince wee lay all night in the Winde-mill, in S Georges field."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9649d9f-78e5-45fe-9564-f60fbb95c3a4",
                        "source_entry_id": "97e276a2-ce06-36d6-a00a-71e27a129ad2",
                        "source_sense_id": "4f375ef3-29c3-37fe-9301-ad99aa9ba77b",
                        "source_sense_description": "sedert, vanaf het moment dat",
                        "target_lang_word": "depuis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "depuis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e45cbc58-79ec-3c74-874e-27646e72c56b",
                                        "entry_id": "4ea42552-4d47-3232-b92b-c8cb60e39433",
                                        "glosses": [
                                            "À partir de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9045b639-cbac-4f06-add8-a08d71e56c39",
                                                "sense_id": "e45cbc58-79ec-3c74-874e-27646e72c56b",
                                                "text": "Les savants s’occupèrent de tout dans une paix profonde, depuis la végétation anormale d’un ognon de jacinthe jusqu’aux courants électriques."
                                            },
                                            {
                                                "example_id": "9344820a-2bd9-4985-b703-59ea674f7c65",
                                                "sense_id": "e45cbc58-79ec-3c74-874e-27646e72c56b",
                                                "text": "[…], il ne parvint que jusqu'à l'Oued El-Abid, au Tedla, où il succomba subitement à une maladie qui le minait sournoisement depuis longtemps."
                                            },
                                            {
                                                "example_id": "a166a987-8e2e-4573-a312-655a872c4369",
                                                "sense_id": "e45cbc58-79ec-3c74-874e-27646e72c56b",
                                                "text": "Il y avait aussi à la base un prototype qui était arrivé depuis peu de temps, c'était le dernier-né de la société Avions Marcel Dassault. L’Ouragan MD 450 le premier avion à réaction de fabrication française, […]."
                                            },
                                            {
                                                "example_id": "e2fc67d5-7c30-4c0a-b240-ea95d6f4e610",
                                                "sense_id": "e45cbc58-79ec-3c74-874e-27646e72c56b",
                                                "text": "Quand vont-ils enfin faire quelque chose? Depuis le temps qu'on demande des ralentisseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03055921-fa11-31c4-a3cf-22aad46598fc",
                                        "entry_id": "4ea42552-4d47-3232-b92b-c8cb60e39433",
                                        "glosses": [
                                            "Peut aussi indiquer un rapport de lieu ou de rang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd34e0d0-f1b6-4d83-88ec-72fd113c4ec8",
                                                "sense_id": "03055921-fa11-31c4-a3cf-22aad46598fc",
                                                "text": "La communication a été émise depuis une cabine téléphonique située au lieu-dit La Commodité, sur la RN 7 à Solterre dans le Loiret."
                                            },
                                            {
                                                "example_id": "8a758996-2ba4-4dda-a285-2586f37ee56f",
                                                "sense_id": "03055921-fa11-31c4-a3cf-22aad46598fc",
                                                "text": "Les lésions de la fièvre typhoïde intéressent l’appareil lymphatique, depuis le tissu lymphoïde intestinal (follicules clos et plaques de Peyer) jusqu’aux ganglions mésentériques et à la rate."
                                            },
                                            {
                                                "example_id": "ed6ef9cb-b141-458a-96d3-0548f47f085f",
                                                "sense_id": "03055921-fa11-31c4-a3cf-22aad46598fc",
                                                "text": "Victor prit son téléphone, shoota quelques objets, son canapé, sa psyché, son tapis de course et, depuis son balcon en saillie, il immortalisa la ville repoussant la lumière qui l’orangeait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6471166-23d5-3a73-8b47-e7b176f7decf",
                                        "entry_id": "4ea42552-4d47-3232-b92b-c8cb60e39433",
                                        "glosses": [
                                            "(suivi de l'infinitif passé)"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75aa3b60-c894-4565-a706-4048ad7a8303",
                                                "sense_id": "d6471166-23d5-3a73-8b47-e7b176f7decf",
                                                "text": "Depuis vous avoir écrit, c.-à-d. il y a quelque six mois, j'ai été fort occupé ou fort triste ou fort débauché de telle sorte que je n'ai pas eu le courage d'écrire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "depuis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2f195b-b133-3333-955a-1de11837098a",
                                        "entry_id": "2e1051b1-04f1-315e-a36b-84e8c08a4150",
                                        "glosses": [
                                            "À partir de tel temps."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06c5ba64-729d-4483-8bd0-85ce7aa47b65",
                                                "sense_id": "5e2f195b-b133-3333-955a-1de11837098a",
                                                "text": "Ça remonte au déluge et depuis elle a eu trois maris, mais ils ont formé un couple hyper-glamour pendant des années."
                                            },
                                            {
                                                "example_id": "8d282b20-66df-403b-ba68-ab2b3418268b",
                                                "sense_id": "5e2f195b-b133-3333-955a-1de11837098a",
                                                "text": "Depuis, je n’en ai plus entendu parler."
                                            },
                                            {
                                                "example_id": "cdd9a909-d145-4bca-8840-309d1b51ada0",
                                                "sense_id": "5e2f195b-b133-3333-955a-1de11837098a",
                                                "text": "Tous les auteurs qui ont écrit depuis."
                                            },
                                            {
                                                "example_id": "e4449129-7f41-4b52-8699-cb4c26141a00",
                                                "sense_id": "5e2f195b-b133-3333-955a-1de11837098a",
                                                "text": "Qu’est-il arrivé depuis ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "815a3e98-0726-41a8-b927-d7cde0828d02",
                        "source_entry_id": "97e276a2-ce06-36d6-a00a-71e27a129ad2",
