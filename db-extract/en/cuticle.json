                            {
                                "example_id": "2a98010d-6850-42cb-8d2f-792508d1c80c",
                                "sense_id": "4f2eb891-e0e7-363a-b2c8-98ec5a9da8a3",
                                "text": "By that time she has pushed back his cuticles, cleaned his nails and painted them with clear polish."
