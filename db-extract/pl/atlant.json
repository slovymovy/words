                        "entry_id": "6d9c9d28-f65d-3f01-9876-7693013c8eac",
                        "glosses": [
                            "posąg atletycznego mężczyzny jako podpora architektoniczna, np. balkonu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d3897ce-93ba-49e0-8049-5808b54f8e90",
                                "sense_id": "c1010c5d-8691-3b41-80c3-4519d07e4a9e",
                                "text": "Ozdobny balkon podtrzymywały posągi atletycznych mężczyzn, zwane atlasami lub atlantami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
