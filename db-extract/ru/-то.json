                                "sense_id": "eb0e239d-3d71-39f9-8a85-06343513ee21",
                                "text": "Ты-то!",
                                "translation": "Éh, toi !"
                            },
                            {
                                "example_id": "6dc186fb-98fd-4763-89b6-23529cc3c46b",
                                "sense_id": "eb0e239d-3d71-39f9-8a85-06343513ee21",
