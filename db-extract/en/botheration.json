    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b73aa50c-3b6a-38af-949d-9d0879ab66bf",
                "word": "botheration",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "911f5b01-3ced-312f-bcb1-5983a43be5ee",
                        "entry_id": "b73aa50c-3b6a-38af-949d-9d0879ab66bf",
                        "glosses": [
                            "A mild expression of annoyance or exasperation: bother!"
                        ],
                        "tags": [
                            "dated",
                            "humorous",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "b0bf7104-5ccc-46ec-a268-566e9fe7fba5",
                                "sense_id": "911f5b01-3ced-312f-bcb1-5983a43be5ee",
                                "text": "\"Botheration ! Who cares ? Why don't you ask if [our ancestors] carried pocket-books ?\""
                            },
                            {
                                "example_id": "02a194bd-e6e6-4e61-9930-2b2f53b3279b",
                                "sense_id": "911f5b01-3ced-312f-bcb1-5983a43be5ee",
                                "text": "Botheration! How she had crumpled her skirt, kneeling in that idiotic way."
                            },
                            {
                                "example_id": "258afe60-9b72-407d-8f26-d59821ccd1be",
                                "sense_id": "911f5b01-3ced-312f-bcb1-5983a43be5ee",
                                "text": "\"Blast and botheration!\" exclaimed Digory. \"What's gone wrong now? [...]\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3b16d5b6-14a8-3e78-a73f-0c3bfde1e473",
                "word": "botheration",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2053f2cd-36e1-4e29-ab44-a1cd1c19d101",
                        "entry_id": "3b16d5b6-14a8-3e78-a73f-0c3bfde1e473",
                        "tags": [
                            "plural"
