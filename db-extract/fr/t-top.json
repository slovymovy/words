                        "entry_id": "9470d8d8-75fe-3334-a629-15a20fd5c4ff",
                        "glosses": [
                            "Sorte de toit semi-rigide servant à abriter le cockpit d'un bateau de plaisance découvert."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "2808798c-91e8-423d-b4dd-d4c3d5533892",
                                "sense_id": "8feec2b3-e005-3a44-91a6-833780cdc3cd",
                                "text": "Avec son T-top en carbone, son pavois de cockpit tribord basculant et ses trois hors-bord installés sur son tableau arrière, le navire amiral de la gamme Key Largo du chantier italien Sessa Marine ne passe pas inaperçu."
                            }
                        ]
                    }
