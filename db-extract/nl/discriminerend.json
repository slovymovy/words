                "senses": [
                    {
                        "sense_id": "023048f3-f0f8-381e-a684-c157aa33453a",
                        "entry_id": "46b6c534-e139-3362-9452-a9fcc82b99f6",
                        "glosses": [
                            "onderscheid makend op basis van bijvoorbeeld ras, sekse of geloof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18d6f696-1d3d-4e3b-b709-90d3af43b10a",
                                "sense_id": "023048f3-f0f8-381e-a684-c157aa33453a",
                                "text": "De provinciale tak van de Democratische Partij in Verona bestempelde het besluit van de gemeente en schoolkantine in een verklaring vandaag als een ‘discriminerende keuze'. Met ,,het straffen en vernederen van een kind’’ toont de partij van de burgemeester zijn ,,inhumane gezicht’’. ,,Als er gezinnen in nood zijn moet de gemeente hen helpen en geen vergeldingsmaatregelen nemen tegen een minderjarige.’’"
                            },
                            {
                                "example_id": "d8ae6b9a-4cad-44bc-ac1a-10ddf1e5bd53",
                                "sense_id": "023048f3-f0f8-381e-a684-c157aa33453a",
                                "text": "YouTube gaat video's verwijderen waarin de Holocaust wordt ontkend en andere ‘goed gedocumenteerde gewelddadige gebeurtenissen’. Het videoplatform krijgt al langer kritiek dat het te weinig doet tegen haatzaaiende en discriminerende beelden."
                            },
                            {
                                "example_id": "c0b5842d-b508-419c-9336-38d27ae9b77e",
                                "sense_id": "023048f3-f0f8-381e-a684-c157aa33453a",
                                "text": "Met een genadeloze afrekening van een racistische tweet heeft KPN vandaag de harten van duizenden Twitteraars veroverd. Het webcareteam van het telecommunicatiebedrijf was niet gediend van een discriminerende opmerking van een van haar volgers en besloot haar publiekelijk aan te pakken."
                            }
                        ]
                    }
