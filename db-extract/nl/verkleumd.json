                                "example_id": "65049675-8bc3-49f3-899a-f0532d59aea5",
                                "sense_id": "9765db73-d27b-307c-bcdc-346dd998ebf6",
                                "text": "Ik besloot mijn schone kousen aan te trekken. Ik had honger en was verkleumd, maar ik zou onder het wachten tenminste warme voeten hebben."
                            }
                        ]
                    }
