                "senses": [
                    {
                        "sense_id": "935980f8-7f3a-358e-9b7a-92efbc7b9b21",
                        "entry_id": "307edc8c-0b55-36e8-8f95-3a8032dd93e4",
                        "glosses": [
                            "Droit accordé aux seigneurs de succéder dans certaines circonstances à leurs mainmortables, la succession elle-même."
                        ],
                        "tags": [
                            "Ancien droit"
                        ],
                        "examples": [
                            {
                                "example_id": "d629cdbf-9f9c-4f88-93d5-0986200efd32",
                                "sense_id": "935980f8-7f3a-358e-9b7a-92efbc7b9b21",
                                "text": "Je ne veux ni main morte, ni échute dans ce petit coin de terre que j’habite ; je ne veux être ni serf ni avoir des serfs."
                            },
                            {
                                "example_id": "86097a05-374d-4483-adb2-9a602869014c",
                                "sense_id": "935980f8-7f3a-358e-9b7a-92efbc7b9b21",
                                "text": "Qu'ainsi il est évident que cet arrêt a jugé que le seigneur de Lille-sous-Montréal avait le droit d’échute; qu'il l'a jugé implicitement, en décidant que ce seigneur avait le droit de taille à volonté; et qu'il l'a jugé formellement, en confirmant les sentences qui avaient adjugé diverses échutes audit seigneur; […]."
                            },
                            {
                                "example_id": "e8f4d44a-d641-4aff-ac65-dd1470670326",
                                "sense_id": "935980f8-7f3a-358e-9b7a-92efbc7b9b21",
                                "text": "Le 23 novembre suivant, Pierre-Philippe-André Mingaud, marquis de la Hage, usufruitier de la terre de l’Isle-sous-Montréal, obtint une sentence qui l'envoya, à titre d’échûte main-mortable, en possession de tous les biens qu'avait laissés ce particulier."
                            }
                        ]
                    },
                    {
                        "sense_id": "222e0b0e-36b2-35df-bf76-e869a305423c",
                        "entry_id": "307edc8c-0b55-36e8-8f95-3a8032dd93e4",
                        "glosses": [
                            "Commission qui échoit au commissaire-priseur."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "7cf8f7be-17ea-4515-bbae-708de66d301a",
                                "sense_id": "222e0b0e-36b2-35df-bf76-e869a305423c",
                                "text": "L'acheteur paie une échute de 20% en sus du prix d'adjudication de chaque lot, plus TVA 8% sur cette échute."
                            }
                        ]
                    }
