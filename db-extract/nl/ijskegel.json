                "senses": [
                    {
                        "sense_id": "d630adef-737c-300a-abb5-ae730b99c5a9",
                        "entry_id": "1220c869-6cb9-395d-892f-b081024d53ef",
                        "glosses": [
                            "kegelvormige hoeveelheid ijs die ontstaat doordat water, meestal van smeltende sneeuw of ijs, dat over een rand druipt geleidelijk weer bevriest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57053da3-7889-4f8a-97d9-820b0e65ad61",
                                "sense_id": "d630adef-737c-300a-abb5-ae730b99c5a9",
                                "text": "Tijdens de wintermaanden zijn ijskegels aan de buitenkant van daken taboe in Dendermonde, terwijl het in Antwerpen verboden is voertuigen op de openbare weg te doen vertragen."
                            },
                            {
                                "example_id": "e9c3643d-376b-42f1-a498-546fdf0ff76d",
                                "sense_id": "d630adef-737c-300a-abb5-ae730b99c5a9",
                                "text": "Penitentes worden ze genoemd, de rijen puntige ijskegels die zich vormen op grote hoogten in de droge Andes. Die naam verwijst naar de boetelingen met witte gewaden en puntmutsen die tijdens de Spaanse Goede Week in processies lopen."
                            },
                            {
                                "example_id": "99f46f5d-2082-4e03-b6ba-6800a8beedf2",
                                "sense_id": "d630adef-737c-300a-abb5-ae730b99c5a9",
                                "text": "Maar uitgerekend toen ik dat dacht, begon het te vriezen. En wat bleek? Heel Nederland was op slag een docusoap geworden. In de wazige regie van weermannen, ijsmeesters, rayonhoofden, Beerenburgstokers en Friese notabelen. Ik hoorde alleen nog lamento's over de rottige oostenwind die het warme klotsende water opstuwde. Maar na anderhalve bevroren parkeerplaats juichte het volk: de tocht der tochten komt er aan. Actualiteitenprogramma's dachten niet langer in normen en waarden, maar in ijskegels. Bush met zijn duivelse inborst kon de pot op. Waar was Evert van Benthem? Er kwam geen einde aan de ver-LPF-ing van de Elfstedentocht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86d7ef52-5d2b-42a4-890e-7cb11709d2fd",
                        "source_entry_id": "1220c869-6cb9-395d-892f-b081024d53ef",
                        "source_sense_id": "d630adef-737c-300a-abb5-ae730b99c5a9",
