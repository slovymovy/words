                    {
                        "translation_id": "5f2f4acc-7ea4-47a5-b43b-ff401a03951a",
                        "source_entry_id": "77232ea7-f5c1-339f-9daf-aef73097b14e",
                        "target_lang_word": "Huflattich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Huflattich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                        "entry_id": "2622eed1-99d3-3f19-9c5e-94017dd67913",
                                        "glosses": [
                                            "eine Pflanze aus der Familie der Korbblütler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba5dc79-8472-4d99-8a73-3cabcd173acb",
                                                "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                                "text": "Der Huflattich ist ein Frühblüher."
                                            },
                                            {
                                                "example_id": "8fe31144-2c82-47cc-ad09-273566cd286b",
                                                "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                                "text": "Aus Huflattich werden Medikamente gegen Husten und Bronchialkatarrh hergestellt."
                                            },
                                            {
                                                "example_id": "cc043918-275f-46d1-813c-16b529e7ab41",
                                                "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                                "text": "Und gleich da, am Lehmhang zu ihren Füßen, blüht sonnengelb der erste Huflattich, bohrt sich die Brennnessel, schon als junger Trieb erstaunlich dunkelgrün und borstig, aus der Erdkrume."
                                            },
                                            {
                                                "example_id": "03977b11-635e-4b54-930b-8309b2f906e7",
                                                "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                                "text": "Durch einen Urwald aus Huflattich geht es die Lammer entlang."
                                            },
                                            {
                                                "example_id": "9651985c-3592-47f0-828d-9556db757972",
                                                "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                                "text": "Einigen Naturfreunden in den USA steigt jedoch bei mancher Wildblume die Zornesröte ins Gesicht; wenn sie statt auf Trillium und Co. auf Dandelion (Löwenzahn) oder Coltsfoot (Huflattich) stoßen, die in ihren Bestimmungsbüchern als „Alien“ bezeichnet sind. Als Fremdling."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff64fc8c-9060-439d-a827-116b2d719039",
                        "source_entry_id": "77232ea7-f5c1-339f-9daf-aef73097b14e",
                        "target_lang_word": "klein hoefblad",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klein hoefblad",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7e631813-f8e2-3acd-b00b-6fccc9671991",
                                        "entry_id": "50208121-6db7-3509-b46e-1c0dc89b2936",
                                        "glosses": [
                                            "Tussilago farfara een 10- 30 cm hoge vaste plant, behorend tot de composietenfamilie (Asteraceae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71e38992-001e-4a1a-80fa-8cd1d4904b93",
                                                "sense_id": "7e631813-f8e2-3acd-b00b-6fccc9671991",
                                                "text": "De gemiddelde temperatuur vanaf half december liep op tot bijna 8 graden Celsius. Die gemiddelden zijn volgens Natuurbericht.nl normaal voor de eerste helft van april. De natuur heeft daar op gereageerd. Zo staan speenkruid, scherpe boterbloem, gele kornoelje, maarts viooltje en klein hoefblad al in bloei, net als een enkele hazelaar. Ook zijn al narcissen gesignaleerd. Verder zijn al bruine kikkers en kleine watersalamanders gemeld."
                                            },
                                            {
                                                "example_id": "de0f01b3-9f3e-4d9a-8694-43b2f456e952",
                                                "sense_id": "7e631813-f8e2-3acd-b00b-6fccc9671991",
                                                "text": "Vorig jaar rond deze tijd stonden de bosanemonen, de maarts viooltjes en het klein hoefblad al volop in bloei. Ook werden door het hele land al vlinders gesignaleerd. Nu zitten we op nog maar drie procent van het aantal vlindermeldingen van vorig jaar rond deze tijd."
                                            },
                                            {
                                                "example_id": "c8963386-4abe-45b1-95d6-3ef1a20bf63d",
                                                "sense_id": "7e631813-f8e2-3acd-b00b-6fccc9671991",
                                                "text": "Het bos werd wat minder dicht, en op de open plekken kwam tussen het dode gras en de dode bladeren klein hoefblad omhoog, met zijn lieve gele bloempjes die oplichtten in de sombere middagduisternis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
