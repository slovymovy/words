                {
                    "sense_id": "c2d2c2b6-36be-378c-801b-0a8be99c653e",
                    "sense_definition": "Gebiedende wijs van <w>onderscheiden</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Onderscheid</w> de hoofdzaken van de bijzaken om efficiënt te werken.",
                            "target_lang_translations": {
                                "en": "<w>Distinguish</w> the main issues from the side issues to work efficiently.",
                                "ru": "<w>Отделяй</w> главное от второстепенного, чтобы работать эффективно.",
                                "fr": "<w>Distingue</w> l'essentiel de l'accessoire pour travailler efficacement."
                            }
                        },
                        {
                            "text": "<w>Onderscheid</w> je van de rest door origineel te zijn.",
                            "target_lang_translations": {
                                "en": "<w>Distinguish</w> yourself from the rest by being original.",
                                "ru": "<w>Выделяйся</w> на фоне остальных, будучи оригинальным.",
                                "fr": "<w>Démarque-toi</w> des autres en étant original."
