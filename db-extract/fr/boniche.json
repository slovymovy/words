                        "examples": [
                            {
                                "example_id": "b9b3fa4e-bf0a-49d5-a53d-32ec0742f854",
                                "sense_id": "c14ef2a1-b2bf-397d-8a1a-0d5574841d47",
                                "text": "Elle a fait la boniche pendant quinze ans.",
                                "translation": "Ze is vijftien jaar dienstmeid geweest."
                            },
                            {
                                "example_id": "5b9ad2a3-9efd-4585-9897-f03b9da77108",
                                "sense_id": "c14ef2a1-b2bf-397d-8a1a-0d5574841d47",
                                "text": "J'suis pas ta boniche!",
                                "translation": "Ik ben je sloofje niet!"
                            }
                        ]
                    }
