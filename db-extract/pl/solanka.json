                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "780c816c-3382-3d2c-ae0e-5203bcaf68ac",
                        "entry_id": "499ac653-a738-324b-92b3-57b817e8f0ff",
                        "glosses": [
                            "roztwór soli używany do konserwacji żywności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b28a26a5-4c66-46ea-be37-39bc824a06f0",
                                "sense_id": "780c816c-3382-3d2c-ae0e-5203bcaf68ac",
                                "text": "Sam przygotowujesz solankę peklowniczą dla swojej rzeźni?"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "d5af61e1-b443-32ff-b3fc-795011551615",
