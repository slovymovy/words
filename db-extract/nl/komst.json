        "nl-extract.jsonl": [
            {
                "entry_id": "4058da9d-ed9d-375e-957a-8b25fe40a395",
                "word": "komst",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8d87f710-a3f2-484c-b03a-713feea49f0f",
                        "entry_id": "4058da9d-ed9d-375e-957a-8b25fe40a395",
                        "tags": [
                            "plural"
                        ],
                        "form": "komsten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b13de88-1ddc-3824-8c0c-075e339780a3",
                        "entry_id": "4058da9d-ed9d-375e-957a-8b25fe40a395",
                        "glosses": [
                            "het feit dat iemand of iets komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2949736-d330-4dbb-a5f7-7d99bc9d797a",
                                "sense_id": "6b13de88-1ddc-3824-8c0c-075e339780a3",
                                "text": "De komst van de computer heeft tot grote veranderingen in ons leven geleid."
                            },
                            {
                                "example_id": "9c475ce5-edeb-4b58-b03a-15467d76f6be",
                                "sense_id": "6b13de88-1ddc-3824-8c0c-075e339780a3",
                                "text": "Giorgos duikt meteen het enige restaurant in dat dit dorp telt, om onze komst alvast aan te kondigen."
                            }
                        ]
                    },
                    {
                        "sense_id": "4212c9b0-cef3-3bec-ba3b-06c00e6264bb",
                        "entry_id": "4058da9d-ed9d-375e-957a-8b25fe40a395",
                        "glosses": [
                            "het geboren worden van iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d598a917-1ffb-4ded-afb5-95af03c8b6df",
                                "sense_id": "4212c9b0-cef3-3bec-ba3b-06c00e6264bb",
                                "text": "Terwijl mijn zoon in mijn binnenste begon aan een duizelingwekkende ontwikkeling van klompje cellen naar prehistorisch weekdier naar foetus, begon ik me af te vragen wat zijn aanstaande komst precies betekende."
                            },
                            {
                                "example_id": "2448c4c3-1838-4c71-81e4-d1aa7cc7a937",
                                "sense_id": "4212c9b0-cef3-3bec-ba3b-06c00e6264bb",
                                "text": "Maar ook dat we, met de komst van de tweede, onze eerste niet alleen iets zouden geven, maar haar ook iets zouden afnemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77567e5d-6fb0-40f1-81bb-8d7d312e9880",
                        "source_entry_id": "4058da9d-ed9d-375e-957a-8b25fe40a395",
                        "target_lang_word": "Ankunft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ankunft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a068caa-2cc7-3cbb-9e64-c1c7fe535331",
                                        "entry_id": "968bfa20-4f59-3abc-93dc-8451dec1bb33",
                                        "glosses": [
                                            "das Eintreffen an einem bestimmten Ziel; das Ankommen"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4be21c17-655a-4f69-84d4-fe0da99df232",
                                                "sense_id": "1a068caa-2cc7-3cbb-9e64-c1c7fe535331",
                                                "text": "Bei der Ankunft am Flughafen Berlin-Tegel standen mehrere Busse bereit, um die Passagiere an das Gebäude zu transportieren."
                                            },
                                            {
                                                "example_id": "e6725467-4969-4f3c-8b64-2769c357b182",
                                                "sense_id": "1a068caa-2cc7-3cbb-9e64-c1c7fe535331",
                                                "text": "„Meine Mission wird mit unserer Ankunft in Frankreich nicht abgeschlossen sein.“"
                                            },
                                            {
                                                "example_id": "a86df666-9a92-47f7-b277-22fa2257ab7a",
                                                "sense_id": "1a068caa-2cc7-3cbb-9e64-c1c7fe535331",
                                                "text": "„Die Hornsignale kündigten die Ankunft des Postreiters von Weitem an und gaben dem nächsten Stafettenreiter Bescheid, der die Sendungen transportieren sollte.“"
                                            },
                                            {
                                                "example_id": "46ddd64b-4a6c-4257-87a9-29e027278a87",
                                                "sense_id": "1a068caa-2cc7-3cbb-9e64-c1c7fe535331",
                                                "text": "„Im Jahr meiner Ankunft in Deutschland war ich siebenundzwanzig Jahre alt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b4c240d-fdae-4901-9748-ae98322f3ea9",
                        "source_entry_id": "4058da9d-ed9d-375e-957a-8b25fe40a395",
                        "target_lang_word": "arrival",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrival",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77b31af8-f140-303e-873b-1e0468fba7fd",
                                        "entry_id": "49a5953a-11e9-3d82-abd0-0f638d890149",
                                        "glosses": [
                                            "The act of arriving (reaching a certain place)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b64ef68-1a5c-4e32-a425-c910604b73a0",
                                                "sense_id": "77b31af8-f140-303e-873b-1e0468fba7fd",
                                                "text": "The early arrival of the bride created a stir."
                                            },
                                            {
                                                "example_id": "67fecc41-c7e9-479d-ae6f-2c156f508528",
                                                "sense_id": "77b31af8-f140-303e-873b-1e0468fba7fd",
                                                "text": "And wander we to see thy honest son,\nWho will of thy arrival be full joyous."
                                            },
                                            {
                                                "example_id": "5a6d743d-3480-4553-983b-b805b6c979a1",
                                                "sense_id": "77b31af8-f140-303e-873b-1e0468fba7fd",
                                                "text": "the unavoidable irregularity in the arrivals of coal ships"
                                            },
                                            {
                                                "example_id": "0e432098-6ee0-46a1-8674-e424a614316e",
                                                "sense_id": "77b31af8-f140-303e-873b-1e0468fba7fd",
                                                "text": "We made an odd party before the arrival of the Ten, particularly when the Celebrity dropped in for lunch or dinner."
                                            },
                                            {
                                                "example_id": "cea1d5c1-fb72-4eb6-9e4f-f8847e3ba628",
                                                "sense_id": "77b31af8-f140-303e-873b-1e0468fba7fd",
                                                "text": "The most rapid and most seductive transition in all human nature is that which attends the palliation of a ravenous appetite.[…]Can those harmless but refined fellow-diners be the selfish cads whose gluttony and personal appearance so raised your contemptuous wrath on your arrival?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec5eb94d-aef2-31e4-9720-79e19931544e",
                                        "entry_id": "49a5953a-11e9-3d82-abd0-0f638d890149",
                                        "glosses": [
                                            "The fact of reaching a particular point in time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6cb35fe-33ec-4efe-be3a-1dd8ce182b31",
                                                "sense_id": "ec5eb94d-aef2-31e4-9720-79e19931544e",
                                                "text": "He celebrated the arrival of payday with a shopping spree."
                                            },
                                            {
                                                "example_id": "767d7c4a-e2f5-4953-8d0f-c01b1f7b04bb",
                                                "sense_id": "ec5eb94d-aef2-31e4-9720-79e19931544e",
                                                "text": "O gentlemen, the time of life is short!\nTo spend that shortness basely were too long,\nIf life did ride upon a dial’s point,\nStill ending at the arrival of an hour."
                                            },
                                            {
                                                "example_id": "a84def1b-c175-4673-aa77-7eb706e609c1",
                                                "sense_id": "ec5eb94d-aef2-31e4-9720-79e19931544e",
                                                "text": "I now fell into a regular routine of apprenticeship-life, which was varied […] by no more remarkable circumstance than the arrival of my birthday and my paying another visit to Miss Havisham."
                                            },
                                            {
                                                "example_id": "be64925b-959d-4a72-8f5d-48537b4b3975",
                                                "sense_id": "ec5eb94d-aef2-31e4-9720-79e19931544e",
                                                "text": "It was a place […] where to count on the arrival of tomorrow was an indulgence, and every service in the house, from the milkman to the electricity, was paid for on a strictly daily basis so as not to spend money on utilities or goods that would be wasted should God turn up in all his holy vengeance the very next day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ff27292-c43d-380a-a9ae-e02f86bf8814",
                                        "entry_id": "49a5953a-11e9-3d82-abd0-0f638d890149",
                                        "glosses": [
                                            "The fact of beginning to occur; the initial phase of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81320849-bff8-411a-9d69-a65261d245fa",
                                                "sense_id": "2ff27292-c43d-380a-a9ae-e02f86bf8814",
                                                "text": "The arrival of puberty can be especially challenging for transgender youth."
                                            },
                                            {
                                                "example_id": "aa27fbf4-fffa-4b6e-a2f8-a3feb407aa2d",
                                                "sense_id": "2ff27292-c43d-380a-a9ae-e02f86bf8814",
                                                "text": "a raw scraping in the back of his throat, which announced the arrival of a bad cold"
                                            },
                                            {
                                                "example_id": "7f78df05-bbaf-4a42-81ee-7ecc0ee122f5",
                                                "sense_id": "2ff27292-c43d-380a-a9ae-e02f86bf8814",
                                                "text": "Streetlamps started to flicker tentatively—yellow buds, intimating the arrival of the full glow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a79a3ef-f199-3e80-98c8-34f3903d8d96",
                                        "entry_id": "49a5953a-11e9-3d82-abd0-0f638d890149",
                                        "glosses": [
                                            "The attainment of an objective, especially as a result of effort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce1466df-5c03-4044-9098-b99c0b3ecbb2",
                                                "sense_id": "6a79a3ef-f199-3e80-98c8-34f3903d8d96",
                                                "text": "The arrival of the railway made the local tourist industry viable."
                                            },
                                            {
                                                "example_id": "0d56c2b6-b86e-4a35-b42c-ce25b018fa52",
                                                "sense_id": "6a79a3ef-f199-3e80-98c8-34f3903d8d96",
                                                "text": "All the admirals had grown up in sail, and many of them viewed the arrival of steam with undisguised dislike […]"
                                            },
                                            {
                                                "example_id": "a9158913-b426-4556-a3a7-fb4647abd004",
                                                "sense_id": "6a79a3ef-f199-3e80-98c8-34f3903d8d96",
                                                "text": "[T]he rapid arrival of electric light to Indian villages is long overdue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aba1751d-e8d6-3456-b162-78b61f3012ab",
                                        "entry_id": "49a5953a-11e9-3d82-abd0-0f638d890149",
                                        "glosses": [
                                            "A person who has arrived; a thing that has arrived."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bf9e376-d124-4c99-8913-3bdeaff6db66",
                                                "sense_id": "aba1751d-e8d6-3456-b162-78b61f3012ab",
                                                "text": "There has been a significant growth in illegal arrivals."
                                            },
                                            {
                                                "example_id": "3d15c266-37df-4d99-af87-7d231782144e",
                                                "sense_id": "aba1751d-e8d6-3456-b162-78b61f3012ab",
                                                "text": "1823, Lord Byron, Don Juan, London: John Hunt, Canto 11, stanza 68, p. 137,\nSaloon, room, hall o’erflow beyond their brink,\nAnd long the latest of arrivals halts,\n’Midst royal dukes and dames condemned to climb,\nAnd gain an inch of staircase at a time."
                                            },
                                            {
                                                "example_id": "bce3cc9a-7d17-4881-9a3e-8cb743561500",
                                                "sense_id": "aba1751d-e8d6-3456-b162-78b61f3012ab",
                                                "text": "The abbot and his monks were assembled in the great hall, observing with childish wonder and faith the performances of a new magician, a fresh arrival."
                                            },
                                            {
                                                "example_id": "fee3865a-bf33-4032-80d3-db793ee8d3b3",
                                                "sense_id": "aba1751d-e8d6-3456-b162-78b61f3012ab",
                                                "text": "a raw apple […] that looked so fresh and shining that it might even have been an early arrival of the new season’s crop"
                                            },
                                            {
                                                "example_id": "0e69f046-df06-4b76-bc41-9f7f1cc0619c",
                                                "sense_id": "aba1751d-e8d6-3456-b162-78b61f3012ab",
                                                "text": "[…] the whole bar was a fierce collective roar, and he edged and smiled politely through it like a sober late arrival at a wild party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
