{
    "word_family": [
        "charité",
        "charitablement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "404f2736-496b-3c5a-922c-dcdf1823eba9",
                    "sense_definition": "Qui fait preuve de bienveillance, de compassion et de générosité envers son prochain, notamment les personnes démunies.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "generosite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette femme <w>charitable</w> consacre tous ses week-ends à aider les sans-abri."
                        },
                        {
                            "text": "Si une âme <w>charitable</w> pouvait m'aider, je pourrais enfin réparer mon vélo."
                        }
                    ],
                    "synonyms": [
                        "chariteux"
                    ],
                    "common_phrases": [
                        "une âme charitable"
                    ]
                },
                {
                    "sense_id": "15cd96ce-f5b4-3201-b4c8-711878c28fd4",
                    "sense_definition": "Qui est inspiré par le souci d'aider autrui ou qui vise à soulager la misère.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "generosite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les bénéfices de ce concert seront reversés à une œuvre <w>charitable</w> locale."
                        },
                        {
                            "text": "Son geste <w>charitable</w> a permis à plusieurs familles de se nourrir dignement."
                        }
                    ],
                    "common_phrases": [
                        "une œuvre charitable"
                    ]
                },
                {
                    "sense_id": "68bb240c-fb20-3c9b-ac02-4517d7fcedd7",
                    "sense_definition": "Qui fait preuve d'indulgence, de clémence et de tolérance envers autrui.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "indulgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a porté un regard <w>charitable</w> sur cette copie imparfaite mais sincère."
                        },
                        {
                            "text": "Soyez <w>charitable</w> avec lui, il commence tout juste dans ce métier difficile."
                        }
                    ],
                    "common_phrases": [
                        "un regard charitable"
                    ]
                }
            ]
        }
    ]
}