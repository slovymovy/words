                    {
                        "sense_id": "90af993d-5f46-3740-ae2c-a911d899c57a",
                        "entry_id": "21631025-fd1f-3c2d-8b98-913fef9c5b7f",
                        "glosses": [
                            "PME, entreprise petite ou moyenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f96e548d-5555-47ba-86d1-e2fa73d1a3cf",
                                "sense_id": "90af993d-5f46-3740-ae2c-a911d899c57a",
                                "text": "Am 24. Januar 2024 brachte die Kommission ein Maßnahmenpaket auf den Weg, mit dem europäische Start-up-Unternehmen und KMU bei der Entwicklung einer vertrauenswürdigen künstlichen Intelligenz unterstützt werden sollen.",
                                "translation": "Le 24 janvier 2024, la Commission a lancé un train de mesures destiné à aider les start-up et les PME européennes à développer une IA digne de confiance."
                            }
                        ]
                    }
                ],
