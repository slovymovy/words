                "translations": [
                    {
                        "translation_id": "e1af4994-cdfb-4b00-b29a-219f0dbc3c6d",
                        "source_entry_id": "fa4d4b7a-4222-3ff9-834e-d3734435872f",
                        "source_sense_id": "3849ccee-e261-388c-bc68-c3a4353e4cc4",
                        "source_sense_description": "Medizin: Schädigung des Gehirns durch Schlag oder Stoß",
                        "target_lang_word": "concussion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concussion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e10319bb-a222-3a64-a9ff-cdc1beb417b4",
                                        "entry_id": "8b662826-99c6-3300-aa03-22b98c1dfd2a",
                                        "glosses": [
                                            "A violent collision or shock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb2c806-4593-4b44-ace5-d5378354b800",
                                                "sense_id": "e10319bb-a222-3a64-a9ff-cdc1beb417b4",
                                                "text": "It is believed that great ringing of bells, in populous cities, hath dissipated pestilent air; which may be from the concussion of the air."
                                            },
                                            {
                                                "example_id": "912746a9-ce44-448f-9a69-8decb1f5957e",
                                                "sense_id": "e10319bb-a222-3a64-a9ff-cdc1beb417b4",
                                                "text": "[Water vapour bubbles] hit againſt the ſides of the more eminent and Mountainous Places, of the Globe, and by this Concuſſion are condenſed, and thus become heavier than the Air they ſvvom in, and ſo gleet dovvn the rocky Caverns of theſe Mountains, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce951b23-4139-3c63-b84b-c2b1ab90cdc8",
                                        "entry_id": "8b662826-99c6-3300-aa03-22b98c1dfd2a",
                                        "glosses": [
                                            "An injury to part of the body, most especially the brain, caused by a violent blow, followed by loss of function."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e77d3825-b70d-3ebb-93fb-05eca6264e0a",
                                        "entry_id": "8b662826-99c6-3300-aa03-22b98c1dfd2a",
                                        "glosses": [
                                            "The unlawful forcing of another by threats of violence to yield up something of value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e8f8ca4-087b-45d3-a64f-a2266e39ecc8",
                                                "sense_id": "e77d3825-b70d-3ebb-93fb-05eca6264e0a",
                                                "text": "Then Concussion, Rapine, Pillories, / Their Catalogue of Accusations fill."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aae1d2d7-9535-4285-9d7a-c7cbc394e529",
                        "source_entry_id": "fa4d4b7a-4222-3ff9-834e-d3734435872f",
                        "source_sense_id": "3849ccee-e261-388c-bc68-c3a4353e4cc4",
                        "source_sense_description": "Medizin: Schädigung des Gehirns durch Schlag oder Stoß",
                        "target_lang_word": "commotion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commotion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2a2758b-8720-358f-ac06-e50230802b3e",
                                        "entry_id": "b03f3839-6ec7-3632-af5c-5b54f5eaf74e",
                                        "glosses": [
                                            "Secousse violente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fe48439-8d31-4f95-acf5-8c7d4865e6bb",
                                                "sense_id": "b2a2758b-8720-358f-ac06-e50230802b3e",
                                                "text": "— Quelque méprisés et déchus qu’ils fussent ordinairement, les Anglo-Saxons, par leur force numérique, devenaient nécessairement formidables dans les commotions civiles qui menaçaient l’État, …."
                                            },
                                            {
                                                "example_id": "1e6d4739-bc66-45d3-9508-13e0c542192c",
                                                "sense_id": "b2a2758b-8720-358f-ac06-e50230802b3e",
                                                "text": "Or, quand les yeux de cette femme rencontrèrent les yeux clairs et luisants de cet homme, elle éprouva dans l'âme un frisson semblable à la commotion qui nous saisit à l'aspect d'un reptile ou lorsque nous touchons à une bouteille de Leyde."
                                            },
                                            {
                                                "example_id": "a884bab5-cca3-4267-af7b-1b57bf71c1e1",
                                                "sense_id": "b2a2758b-8720-358f-ac06-e50230802b3e",
                                                "text": "D’ailleurs, les plus sceptiques d’entre eux reçoivent une violente commotion de joie chaque fois qu’un marquis ou un comte veut bien les honorer d’un léger salut."
                                            },
                                            {
                                                "example_id": "85111871-f009-4253-bc5c-420ed2a79355",
                                                "sense_id": "b2a2758b-8720-358f-ac06-e50230802b3e",
                                                "text": "J’ai cru que le train allait être jeté hors des rails par la commotion de l’air."
                                            },
                                            {
                                                "example_id": "0767408f-bee9-43fe-a486-6c1de6d0610e",
                                                "sense_id": "b2a2758b-8720-358f-ac06-e50230802b3e",
                                                "text": "Eloignée de la compétition en raison de commotions cérébrales à répétition, la troisième ligne aux 67 sélections a fait le deuil de la Coupe du monde 2025, commencée le 22 août en Angleterre, pour laquelle elle a dû déclarer forfait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e6decf-a5eb-3538-a576-fa792b9ad08f",
                                        "entry_id": "b03f3839-6ec7-3632-af5c-5b54f5eaf74e",
                                        "glosses": [
                                            "Violent ébranlement des centres nerveux, causé par une chute ou par quelque coup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1be39bb2-d401-4096-8a1c-7c34e12a2913",
                                                "sense_id": "d5e6decf-a5eb-3538-a576-fa792b9ad08f",
                                                "text": "Ces fins-là sont violentes et affreuses. C’est une commotion cérébrale."
                                            },
                                            {
                                                "example_id": "29e7569d-5744-4fab-a39e-173973723b2a",
                                                "sense_id": "d5e6decf-a5eb-3538-a576-fa792b9ad08f",
                                                "text": "Elle ne parle pas. Peut-être la commotion lui a-t-elle ôté l'usage de la parole ?"
                                            },
                                            {
                                                "example_id": "b6472aaf-b61f-4e72-9ca7-30ccfd3ef256",
                                                "sense_id": "d5e6decf-a5eb-3538-a576-fa792b9ad08f",
                                                "text": "Une commotion cérébrale n’est pas un ongle cassé, c’est un traumatisme crânien, une collision entre le cerveau et la boîte crânienne."
                                            },
                                            {
                                                "example_id": "b139dae6-bb59-49b2-ad06-19364502024a",
                                                "sense_id": "d5e6decf-a5eb-3538-a576-fa792b9ad08f",
                                                "text": "Il y avait à craindre que ce coup, que cette chute n’eût fait commotion au cerveau. - Il tomba de fort haut, ce qui lui causa une commotion générale dans tout le corps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c5c1f76-1a3c-346c-acb8-66176a0d441b",
                                        "entry_id": "b03f3839-6ec7-3632-af5c-5b54f5eaf74e",
                                        "glosses": [
                                            "Secousse plus ou moins violente que l’on éprouve par une décharge électrique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
