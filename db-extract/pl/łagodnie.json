                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mildly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ac7b343-5f73-3415-b6c9-8c782ce9c4a0",
                                        "entry_id": "2c414ab1-ea82-3185-9af6-8f7c0d488e23",
                                        "glosses": [
                                            "In a mild manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5934aa19-9464-4412-8473-45053e3bb889",
                                                "sense_id": "9ac7b343-5f73-3415-b6c9-8c782ce9c4a0",
                                                "text": "Long before you see the lean, handsome heads peering mildly over the half-doors of the loose boxes, you know that East Ilsley's business is training racehorses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70166a4c-6666-3845-aae9-50d1bf5efbe3",
                                        "entry_id": "2c414ab1-ea82-3185-9af6-8f7c0d488e23",
                                        "glosses": [
                                            "To a mild degree; slightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a92a70f8-749b-4ed0-b882-325971280456",
                                                "sense_id": "70166a4c-6666-3845-aae9-50d1bf5efbe3",
                                                "text": "a mildly amusing joke"
                                            },
                                            {
                                                "example_id": "f69b9366-1b5e-4e99-8dc8-ed5daa423b8c",
                                                "sense_id": "70166a4c-6666-3845-aae9-50d1bf5efbe3",
                                                "text": "The aroma is mildly sweet and lagery with pleasant hops; very pale gold color; the taste is clean and fresh, mildly malty, with a touch of hops in both the middle and finish; a remarkably thin body and lots of carbonation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a189df5-65b4-48bd-99f3-73e161aa53b0",
                        "source_entry_id": "0869eb67-dc29-380d-81e2-904712cb324e",
                        "source_sense_id": "4a4075a7-0fa4-3921-ba2d-f8c7f0011cc1",
                        "target_lang_word": "légèrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légèrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3414a6c8-c30f-312e-a86f-57b11aeaccaa",
                                        "entry_id": "47b16c2a-2a43-355f-b4e1-d743344b211f",
                                        "glosses": [
                                            "D’une manière légère, non pesante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9316b579-aa45-4963-8588-a6acc483d82c",
                                                "sense_id": "3414a6c8-c30f-312e-a86f-57b11aeaccaa",
                                                "text": "Il s’avance seul légèrement armé, couvert d’un casque d’acier garni d’or, ombragé de trois queues de cheval blanches comme la neige."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bbdc197-08ed-353e-a052-d78cfc65569a",
                                        "entry_id": "47b16c2a-2a43-355f-b4e1-d743344b211f",
                                        "glosses": [
                                            "Avec agilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a66f1dd-f730-4548-8008-fd276f4ffa44",
                                                "sense_id": "9bbdc197-08ed-353e-a052-d78cfc65569a",
                                                "text": "Marcher, courir légèrement."
                                            },
                                            {
                                                "example_id": "29036b30-ac57-4117-8cc3-3810d47de700",
                                                "sense_id": "9bbdc197-08ed-353e-a052-d78cfc65569a",
                                                "text": "Pour moi, je ne crois pas que sans enchantement On puisse aller plus loin et plus légèrement."
                                            },
                                            {
                                                "example_id": "521e23b1-9c7f-44d5-aea8-880b2fc2c4fa",
                                                "sense_id": "9bbdc197-08ed-353e-a052-d78cfc65569a",
                                                "text": "Est-il rien qui aille plus vite ni qui s’écoule, s’échappe et vole plus légèrement que le temps passé parmi les délices ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "199553fb-c0ed-39dc-855f-f9a7a90a47f6",
                                        "entry_id": "47b16c2a-2a43-355f-b4e1-d743344b211f",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02d0c356-45e5-42bc-9fe0-83636eed4179",
                                                "sense_id": "199553fb-c0ed-39dc-855f-f9a7a90a47f6",
                                                "text": "Vous passez légèrement sur des endroits difficiles."
                                            },
                                            {
                                                "example_id": "eaa23752-5556-4d32-be86-a339f5bae12e",
                                                "sense_id": "199553fb-c0ed-39dc-855f-f9a7a90a47f6",
                                                "text": "Pour sortir du monde plus légèrement, il [le chrétien] s’est déjà déchargé lui-même d’une partie de son corps, comme d’un empêchement importun à l’ame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d85aec45-9a65-3197-aba8-010de1851d9d",
                                        "entry_id": "47b16c2a-2a43-355f-b4e1-d743344b211f",
                                        "glosses": [
                                            "Se met quelquefois sur les partitions pour indiquer, dans certains passages, un mouvement analogue à celui de l’allegro vivace et joué de la pointe de l’archet, ou sans forcer le souffle si ce sont des instruments à vent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e47e445-db4c-3ec3-a80e-5df2f86c7195",
                                        "entry_id": "47b16c2a-2a43-355f-b4e1-d743344b211f",
                                        "glosses": [
                                            "D’une façon peu copieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e16aa24-2405-469d-88f6-b4a88d4af5c3",
                                                "sense_id": "0e47e445-db4c-3ec3-a80e-5df2f86c7195",
                                                "text": "Mangez légèrement."
                                            },
                                            {
                                                "example_id": "f46ddffb-7e57-49c9-94a5-10f7e906b2d3",
                                                "sense_id": "0e47e445-db4c-3ec3-a80e-5df2f86c7195",
                                                "text": "Vous avez soupé hier si légèrement que vous serez malade, si vous ne prenez rien ce matin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceaa1f52-e77b-3ae0-a891-aed4a8f60b38",
                                        "entry_id": "47b16c2a-2a43-355f-b4e1-d743344b211f",
                                        "glosses": [
                                            "D’une façon peu considérable, peu grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e097e2a-9f30-4ed7-ad60-a54d8210d164",
                                                "sense_id": "ceaa1f52-e77b-3ae0-a891-aed4a8f60b38",
                                                "text": "Nous nous plaignons quelquefois légèrement de nos amis, pour justifier par avance notre légèreté."
                                            },
                                            {
                                                "example_id": "f5959bcc-e914-4b37-b313-87bcf5197123",
                                                "sense_id": "ceaa1f52-e77b-3ae0-a891-aed4a8f60b38",
                                                "text": "Il [le Saint-Esprit] ne descend pas sur la terre pour passer légèrement sur les cœurs ; il vient établir sa demeure dans la sainte société des fidèles."
                                            },
                                            {
                                                "example_id": "f1e62edb-b7a3-4782-be08-d7d9614f8c1b",
                                                "sense_id": "ceaa1f52-e77b-3ae0-a891-aed4a8f60b38",
                                                "text": "Les grâces […] ne feront plus alors que vous émouvoir légèrement."
                                            },
                                            {
                                                "example_id": "2bc790a8-4141-4b10-95f5-9c0c771e04d0",
                                                "sense_id": "ceaa1f52-e77b-3ae0-a891-aed4a8f60b38",
                                                "text": "Je ne connais que légèrement Helvétius ; mais je ne puis m’empêcher d’être indigné de la barbarie avec laquelle on le traite."
                                            },
                                            {
                                                "example_id": "5536acc9-ba4c-4047-b2bf-7e72acf94f97",
                                                "sense_id": "ceaa1f52-e77b-3ae0-a891-aed4a8f60b38",
                                                "text": "Blessé légèrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "861557ac-1e8e-3f2c-bb78-dad190a5b1d3",
                                        "entry_id": "47b16c2a-2a43-355f-b4e1-d743344b211f",
                                        "glosses": [
                                            "Par antiphrase, légèrement est quelquefois pris aujourd'hui pour fortement, gravement, très fort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5276963-948e-4a9f-9399-438acf3112cc",
                                                "sense_id": "861557ac-1e8e-3f2c-bb78-dad190a5b1d3",
                                                "text": "Mais vous êtes en train de prier un dieu romain, vous vous foutez de ma gueule ? Je vous signale que vous êtes légèrement engagé dans une quête au nom du dieu unique !"
                                            },
                                            {
                                                "example_id": "38a54469-8aa3-4f29-a8d1-de0d038e48c9",
                                                "sense_id": "861557ac-1e8e-3f2c-bb78-dad190a5b1d3",
                                                "text": "Il dîne ici pour la première fois, et, comme vous le savez peut-être, on le dit légèrement pointilleux et moraliste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d733e62-2b2f-34a9-a4e5-961802a59b13",
                                        "entry_id": "47b16c2a-2a43-355f-b4e1-d743344b211f",
                                        "glosses": [
                                            "Avec délicatesse et agrément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd21cb9-d7c1-4b78-9aef-409932a1d701",
                                                "sense_id": "0d733e62-2b2f-34a9-a4e5-961802a59b13",
                                                "text": "Ce tableau est légèrement touché. Ce dessin est légèrement fait."
                                            },
                                            {
                                                "example_id": "3516cd62-1fa4-4bf5-8c84-c16b7aa2eccf",
                                                "sense_id": "0d733e62-2b2f-34a9-a4e5-961802a59b13",
                                                "text": "Le Vatican a réclamé une enquête au réseau social Instagram pour comprendre comment le compte officiel du pape François a pu «aimer» la photographie osée d'une Brésilienne très légèrement vêtue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "835643e7-4073-30b8-8228-f8baef1cec33",
                                        "entry_id": "47b16c2a-2a43-355f-b4e1-d743344b211f",
                                        "glosses": [
                                            "D’une façon inconsidérée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183c4cde-b92f-4bf1-83ca-ebb1f3a5df5e",
                                                "sense_id": "835643e7-4073-30b8-8228-f8baef1cec33",
                                                "text": "Croire légèrement."
                                            },
                                            {
                                                "example_id": "80dbc308-5056-4b6b-acc2-2e6c70630490",
                                                "sense_id": "835643e7-4073-30b8-8228-f8baef1cec33",
                                                "text": "Pour moi, quoique je susse les incommodités qui suivent nécessairement les siéges ^([sic]) qui se font en cette saison, j’arrêtai mon jugement ; je pensai que ceux qui avaient présidé à ce conseil avoient vu les mêmes choses que je voyois, et qu’ils en voyoient encore d’autres que je ne voyois pas ; qu’ils ne se seraient pas engagés légèrement au siége ^([sic]) d’une place sur laquelle toute la chrétienté avoit les yeux ; et dès que je fus assuré qu’elle étoit attaquée, je ne doutai quasi plus qu’elle ne dût être prise."
                                            },
                                            {
                                                "example_id": "14dec370-dbbc-4381-aa4f-db2fff2ea72a",
                                                "sense_id": "835643e7-4073-30b8-8228-f8baef1cec33",
                                                "text": "Vous en prenez [des alarmes] sans doute un peu légèrement."
                                            },
                                            {
                                                "example_id": "dada71ba-8e38-46aa-aa3e-9f478dd76e48",
                                                "sense_id": "835643e7-4073-30b8-8228-f8baef1cec33",
                                                "text": "Il vous dira ses ennuis ; il m’en a dit assez pour me faire voir qu’il a été trompé ; c’est dommage ; mais il ne faut pas se marier si légèrement."
                                            },
                                            {
                                                "example_id": "ec1b10c0-e6e1-4e7a-9604-505ca8d62142",
                                                "sense_id": "835643e7-4073-30b8-8228-f8baef1cec33",
                                                "text": "Si le roi n'avait pas révoqué la permission qu’il avait donnée trop légèrement."
                                            },
                                            {
                                                "example_id": "1e759214-e33b-498d-ac82-7445d343e552",
                                                "sense_id": "835643e7-4073-30b8-8228-f8baef1cec33",
                                                "text": "Quelques faits que j'ai trop légèrement affirmés sur la foi des premiers voyageurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28dd163e-ff65-3a4f-866d-ae0a961a9e66",
                                        "entry_id": "47b16c2a-2a43-355f-b4e1-d743344b211f",
                                        "glosses": [
                                            "Sans égards suffisants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31884015-c880-4a71-9568-bbfc61916d3a",
                                                "sense_id": "28dd163e-ff65-3a4f-866d-ae0a961a9e66",
                                                "text": "Et que, pour vos projets, il fallait sans scrupule Traiter légèrement un vieillard ridicule."
                                            },
                                            {
                                                "example_id": "ecfeba97-4290-47f7-850a-c22917d2e7ac",
                                                "sense_id": "28dd163e-ff65-3a4f-866d-ae0a961a9e66",
                                                "text": "Lorsque Saint-Évremond s’expliquait si légèrement sur Sénèque, il ne l’avait pas lu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1614f3ae-7ae7-456b-8c88-d804ebfcbb11",
                        "source_entry_id": "0869eb67-dc29-380d-81e2-904712cb324e",
                        "source_sense_id": "4a4075a7-0fa4-3921-ba2d-f8c7f0011cc1",
                        "target_lang_word": "mollement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mollement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f85653d-6c5a-32f8-be90-c8d6f100835a",
                                        "entry_id": "70b02a7a-aac2-383c-bfbe-0a8a5f732d56",
                                        "glosses": [
                                            "D’une manière molle."
                                        ],
                                        "tags": [
                                            "literally",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1755abb-3947-4f54-a812-f4a18d7c3b11",
                                                "sense_id": "3f85653d-6c5a-32f8-be90-c8d6f100835a",
                                                "text": "Être couché mollement, être étendu mollement. être couché dans un bon lit, être étendu de manière à reposer ses membres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5484077d-2165-37b3-82b2-c1ceaa7c6efe",
                                        "entry_id": "70b02a7a-aac2-383c-bfbe-0a8a5f732d56",
                                        "glosses": [
                                            "Avec un abandon gracieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21970976-9bb4-4837-85d1-6100292c296a",
                                                "sense_id": "5484077d-2165-37b3-82b2-c1ceaa7c6efe",
                                                "text": "Ses bras, à moitié endormis, mollement jetés hors de la bergère, achevaient d'exprimer une pensée de bonheur."
                                            },
                                            {
                                                "example_id": "7bf2e3ab-f986-4e72-83f6-71d780d9092c",
                                                "sense_id": "5484077d-2165-37b3-82b2-c1ceaa7c6efe",
                                                "text": "Quand Miette riait, renversant la tête en arrière et la penchant mollement sur son épaule droite, elle ressemblait à la Bacchante antique, avec sa gorge gonflée de gaieté sonore, ses joues arrondies comme celles d’un enfant, ses larges dents blanches, ses torsades de cheveux crépus que les éclats de sa joie agitaient sur sa nuque, ainsi qu’une couronne de pampres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76374d63-0e60-36f1-81bd-b10a3e8ad439",
                                        "entry_id": "70b02a7a-aac2-383c-bfbe-0a8a5f732d56",
                                        "glosses": [
                                            "Faiblement ; lâchement ; sans vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad84b8a-a2e0-41e8-be2c-bff461077362",
                                                "sense_id": "76374d63-0e60-36f1-81bd-b10a3e8ad439",
                                                "text": "Vers le soir, il entre dans un champ de blé, de blés hauts et mûrs, dont la brise balance mollement les beaux épis d’or."
                                            },
                                            {
                                                "example_id": "8a6b8fa2-979e-4cf7-baf6-26f55eb0d1c7",
                                                "sense_id": "76374d63-0e60-36f1-81bd-b10a3e8ad439",
                                                "text": "Les tribunaux frappèrent, tout d'abord, assez durement, les gentilles délinquantes qui s'obstinaient à porter […] le cirsac mollement cotonneux."
                                            },
                                            {
                                                "example_id": "31138fda-53a5-45e5-89f2-002ed0831864",
                                                "sense_id": "76374d63-0e60-36f1-81bd-b10a3e8ad439",
                                                "text": "Pourtant j’aurais voulu examiner le paysage, mollement éclairé par la lune, et crayonner quelques notes au passage."
                                            },
                                            {
                                                "example_id": "cf1d194d-b067-4adb-9585-5496cbf42ca9",
                                                "sense_id": "76374d63-0e60-36f1-81bd-b10a3e8ad439",
                                                "text": "[…]; cette bande qui s'étend sur les villages de Brotte, Ailloncourt, Éhuns, Citers, etc., est représentée par des collines ou des croupes mollement ondulées de 300 mètres d'altitude moyenne, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c4c8172-2980-3316-af33-6d1af6b229f4",
                                        "entry_id": "70b02a7a-aac2-383c-bfbe-0a8a5f732d56",
                                        "glosses": [
                                            "D’une manière molle et efféminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67dec09f-11a7-4671-9633-fe23f59c75d8",
                                                "sense_id": "7c4c8172-2980-3316-af33-6d1af6b229f4",
                                                "text": "Vivre mollement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
