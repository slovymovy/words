                                                "sense_id": "7a9ef81d-5aaf-3a66-ae2a-d2f55b88bd79",
                                                "text": "Der Sprecher gab sich mit der Absage keine besondere Mühe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96140ec9-fb90-3417-a65b-40bbdb6bca5c",
