                ],
                "senses": [
                    {
                        "sense_id": "278d0ccc-299e-30f7-be01-e6f67d77e765",
                        "entry_id": "faa7fe4d-40f6-3b83-b130-8532ae4406c7",
                        "glosses": [
                            "Briser et défoncer quelque chose."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "fc89cfa9-7e13-4ef4-8abb-e25ca5f227c5",
                                "sense_id": "278d0ccc-299e-30f7-be01-e6f67d77e765",
                                "text": "Je vais me cacher à l'arrière sans dire tout le monde que j'ai en tête, je claque la porte, la pétaque sur le bord d'une grande chire, envie de tout décâlicer, de balayer le bureau de la bosse d'un grand élan, de faire basculer l'étagère, que tous les livres en tombent, que la boîte de Guide de l'auto m'assomme jusqu'à la Grande Noirceur, qu'on en finisse une fois pour toutes."
                            },
                            {
                                "example_id": "3d4d1179-de42-47d0-958f-5f95f2159647",
                                "sense_id": "278d0ccc-299e-30f7-be01-e6f67d77e765",
                                "text": "T'as des charriots de vaisselle qui rentrent à la tonne parce que je faisais les fins de semaine, fallait aller torcher les toilettes (Ben oui le gars qui fait ta vaisselle fait aussi les toilettes, dégueulasse) et les produits nettoyant te décâlicent les mains."
                            },
                            {
                                "example_id": "1e35852f-dd5f-41fc-a7d3-0913cc6cf861",
                                "sense_id": "278d0ccc-299e-30f7-be01-e6f67d77e765",
                                "text": "SES CHEVEUX DANS UN DE SES VIEUX CLIP ME DÉCÂLICENT RAIDE."
                            }
                        ]
                    },
                    {
                        "sense_id": "f96279ce-2f62-3267-8389-bdd7dea74b3f",
                        "entry_id": "faa7fe4d-40f6-3b83-b130-8532ae4406c7",
                        "glosses": [
