                "translations": [
                    {
                        "translation_id": "f2f6f680-e6a9-416a-ab0a-949dc3201561",
                        "source_entry_id": "7661a1e9-755b-391c-a943-5e51ecc47079",
                        "source_sense_id": "cdca1398-69fc-3f2d-819e-ebad3f69ef7f",
                        "target_lang_word": "liman",
