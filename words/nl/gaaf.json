                },
                {
                    "sense_id": "8a40db68-16be-350c-98bc-08dc8440bac7",
                    "sense_definition": "Egaal en glad, zonder oneffenheden (vaak over de huid).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_smooth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft door goede verzorging een prachtige, <w>gave</w> huid.",
                            "target_lang_translations": {
                                "en": "Thanks to good care, she has beautiful, <w>flawless</w> skin.",
                                "ru": "Благодаря хорошему уходу у неё прекрасная, <w>чистая</w> кожа."
                            }
                        },
                        {
                            "text": "Het schilderij moet op een volkomen <w>gaaf</w> doek worden aangebracht.",
                            "target_lang_translations": {
                                "en": "The painting must be applied to a completely <w>pristine</w> canvas.",
                                "ru": "Картина должна быть нанесена на абсолютно <w>безупречный</w> холст."
                            }
                        }
