                },
                {
                    "sense_id": "6e98163d-50a6-3291-96a4-5ac8ab9401ad",
                    "sense_definition": "Introduire des munitions ou de la poudre dans une arme à feu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "armes",
                    "name_type": "no",
                    "examples": [
