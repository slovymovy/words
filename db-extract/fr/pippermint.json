                    {
                        "sense_id": "8daacd4c-294f-37d9-9fca-90d1121afaf5",
                        "entry_id": "d22ebc64-a088-3462-a6e9-57e3f5213394",
                        "glosses": [
                            "Menthe poivrée."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "dc5bde57-da54-41b3-a41f-ae721d711018",
                                "sense_id": "8daacd4c-294f-37d9-9fca-90d1121afaf5",
                                "text": "Le terme pippermint écrit en un seul mot était usité en France comme le nom commun de la menthe poivrée avant le dépôt de la marque ; d'autre part, le fait d'avoir seulement changé une lettre n'entraînant aucune altération phonétique."
                            }
                        ]
                    },
                    {
                        "sense_id": "468baf7c-12f6-334b-8e92-2ff17bb23f4d",
                        "entry_id": "d22ebc64-a088-3462-a6e9-57e3f5213394",
                        "glosses": [
                            "Produit à base d'extraits de cette menthe (liqueur, bonbons, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec19b712-105f-4b1f-a4de-b179a1b2e65d",
                                "sense_id": "468baf7c-12f6-334b-8e92-2ff17bb23f4d",
                                "text": "La dernière fois, j’ai eu un cancrelat qui est tombé dans mon pippermint."
                            },
                            {
                                "example_id": "5590d6ab-205a-42bf-b466-00530f787be6",
                                "sense_id": "468baf7c-12f6-334b-8e92-2ff17bb23f4d",
                                "text": "[…] la pharmacie. Elle semblait donner de plain-pied dans le café, et, avec ses bocaux colorés comme des bouteilles de pippermint ou de grenadine, n’en être qu’une dépendance."
                            },
                            {
                                "example_id": "f9130aa1-50ba-4c8e-a116-ccaef9daa6eb",
                                "sense_id": "468baf7c-12f6-334b-8e92-2ff17bb23f4d",
                                "text": "“J'ai jamais pu souffrir les bonbons mous.” … Il poussa un gloussement et se remit à mâchonner son pippermint."
                            }
                        ]
                    }
