                "senses": [
                    {
                        "sense_id": "4e08f480-9eaa-3f2c-9cb2-2a60f631d624",
                        "entry_id": "482183f4-8932-336d-a9bb-56cf1d41f167",
                        "glosses": [
                            "The size or shape of a person's body."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8f0de125-d0b1-3fef-b469-509dc6dfd187",
                        "entry_id": "482183f4-8932-336d-a9bb-56cf1d41f167",
                        "glosses": [
                            "The waist or bodice of a woman's dress."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8ff9ddca-c2f0-3efd-9724-48df8982424f",
                        "entry_id": "482183f4-8932-336d-a9bb-56cf1d41f167",
                        "glosses": [
                            "A small bouquet of flowers, originally worn attached to the bodice of a woman's dress."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88140a31-6054-4bb9-aab2-8c9137b09673",
                                "sense_id": "8ff9ddca-c2f0-3efd-9724-48df8982424f",
                                "text": "Brody (Damian Lewis): Will you go to the prom with me? / Carrie: Do I get a corsage?"
                            },
                            {
                                "example_id": "b5472b05-d4d1-404a-a46e-1ece86049681",
                                "sense_id": "8ff9ddca-c2f0-3efd-9724-48df8982424f",
                                "text": "Here, I got a corsage for you to give to Jenna. I don't know if kids still do corsages. I always got ones for Darius' girlfriends. This one is made with lilies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6204279-8b29-4ee9-a11d-ac4916590ca5",
                        "source_entry_id": "482183f4-8932-336d-a9bb-56cf1d41f167",
                        "source_sense_description": "bodice of a woman's dress",
                        "target_lang_word": "corsage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corsage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95613465-3dae-3f83-99da-832f34e5cafa",
                                        "entry_id": "2ba092ae-73d8-397d-92f9-3441f9c537de",
                                        "glosses": [
                                            "Buste, poitrail."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fd189c5-775f-4ec6-a72b-6f3c65f5cd3c",
                                                "sense_id": "95613465-3dae-3f83-99da-832f34e5cafa",
                                                "text": "On trouve aux Indes des éléphants de trois sortes (dit le P. Vincent Marie) les blancs qui sont les plus grands, les plus doux, les plus paisibles, sont estimés et adorés par plusieurs nations comme des dieux ; les roux tels que ceux de Ceylan, quoiqu'ils soient les plus petits de corsage, sont les plus valeureux, les plus forts, les plus nerveux, les meilleurs pour la guerre […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbcac6d5-f15f-333d-bc33-1b50cf6b1662",
                                        "entry_id": "2ba092ae-73d8-397d-92f9-3441f9c537de",
                                        "glosses": [
                                            "Partie de certains vêtements de femme qui embrasse le buste."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c75a199-9da7-4c20-8ea4-83d728231143",
                                                "sense_id": "bbcac6d5-f15f-333d-bc33-1b50cf6b1662",
                                                "text": "Seulement, quelque modeste que fût son corsage, il ne cachait pas entièrement l’élégance de sa taille."
                                            },
                                            {
                                                "example_id": "81f5239d-01b3-4b05-b876-0a329b6547e3",
                                                "sense_id": "bbcac6d5-f15f-333d-bc33-1b50cf6b1662",
                                                "text": "Et elle glissa dans son corsage, tout raide de broderies et de diamants, cette lettre qui sortait du pourpoint du jeune homme."
                                            },
                                            {
                                                "example_id": "26549003-1e90-4223-8451-2e388a3de9bb",
                                                "sense_id": "bbcac6d5-f15f-333d-bc33-1b50cf6b1662",
                                                "text": "La robe — velours violet avec ruché au corsage et au bas de la jupe — qu’elle avait choisie lui semblait au contraire convenir parfaitement pour la circonstance."
                                            },
                                            {
                                                "example_id": "3740d6ca-0a3d-4c19-97c3-d357e39c5782",
                                                "sense_id": "bbcac6d5-f15f-333d-bc33-1b50cf6b1662",
                                                "text": "Le corsage de la pauvre fille était si plat qu’il n’admettait pas les ressources coloniales de ce que les modistes appellent des fichus menteurs."
                                            },
                                            {
                                                "example_id": "7f792895-51cb-40ac-b709-f5b67f981150",
                                                "sense_id": "bbcac6d5-f15f-333d-bc33-1b50cf6b1662",
                                                "text": "Les femmes portent une jupe en vadmel, ou grossière étoffe de laine noire, et un corsage de même étoffe, ouvert au milieu pour laisser voir une chemise brodée."
                                            },
                                            {
                                                "example_id": "e501226d-cd62-4806-907c-f17030f4a745",
                                                "sense_id": "bbcac6d5-f15f-333d-bc33-1b50cf6b1662",
                                                "text": "Ce qui venait de tomber sur le lit, en un mince lambeau soyeux, léger et lent, c’était le corsage qui la serrait doucement au cou, et fort à la taille…"
                                            },
                                            {
                                                "example_id": "af1b1e80-5103-47f3-b8a4-cfd82cc09c7d",
                                                "sense_id": "bbcac6d5-f15f-333d-bc33-1b50cf6b1662",
                                                "text": "Pour 1 500 yens on pouvait aussi acheter des faux soutiens-gorge de mousse pour gonfler son corsage à l'occidentale, et même des fausses fesses rembourrées en rilsan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
