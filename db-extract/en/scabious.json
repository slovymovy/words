                    {
                        "sense_id": "752a12af-3d37-3705-8e72-d63a4ec481e0",
                        "entry_id": "82abc67e-9d1f-3da3-bc0a-32aa75ecc76d",
                        "glosses": [
                            "Any of various herbaceous plants of the genus Scabiosa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aecf328d-40df-4f43-929f-5ec2910a2b65",
                                "sense_id": "752a12af-3d37-3705-8e72-d63a4ec481e0",
                                "text": "The grassy track, so gay with scabious and bedstraw, was snow-white at the bottom of its ruts."
                            }
                        ]
                    },
                    {
                        "sense_id": "178413d6-f8a6-313c-a92f-1c85310d40f0",
                        "entry_id": "82abc67e-9d1f-3da3-bc0a-32aa75ecc76d",
