                ],
                "senses": [
                    {
                        "sense_id": "5080b117-53f6-37d2-92cb-9b109bb5233a",
                        "entry_id": "0fccee8a-cb66-3216-98b3-dc77535c7bcc",
                        "glosses": [
                            "Donner un caractère olympique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f675645e-d66d-441f-98a7-c112c3eccaa2",
                                "sense_id": "5080b117-53f6-37d2-92cb-9b109bb5233a",
                                "text": "L’homme, pour lui, tend toujours à couronner, à nimber, à auréoler, à « olympiser », à hypostasier, à « majusculer » », pour mieux susciter le respect, un respect d’essence religieuse."
                            },
                            {
                                "example_id": "38c79525-52a4-4874-af44-08b659c18ce3",
                                "sense_id": "5080b117-53f6-37d2-92cb-9b109bb5233a",
                                "text": "Notre objectif n'est pas de présenter le plus petit commun dénominateur à toutes ces personnes, mais \" d'olympiser \" un projet qui possède une forte personnalité."
                            },
                            {
                                "example_id": "80feabaa-d756-4621-9748-06e149fd0241",
                                "sense_id": "5080b117-53f6-37d2-92cb-9b109bb5233a",
                                "text": "Si quelqu'un me demandait la recette pour s'« olympiser », je lui dirais : la première condition, c'est d'être joyeux. Pierre de Coubertin."
                            }
                        ]
                    }
