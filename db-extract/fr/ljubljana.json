                                "example_id": "55fd290f-d4b2-4bd5-825a-9f957fe8f033",
                                "sense_id": "c912e408-dd17-32ba-9a57-99761b39d488",
                                "text": "Les basketteuses françaises ont giflé, jeudi, le Monténégro en quart de finale de l’Eurobasket (89-46), à Ljubljana (Slovénie)."
                            }
                        ]
