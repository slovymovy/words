                "senses": [
                    {
                        "sense_id": "5363fa1a-7320-3a09-ac8d-ca688da8aa35",
                        "entry_id": "4bf70eb3-e325-33aa-bbcb-d4ac1464daa0",
                        "glosses": [
                            "romantic relationship, affair"
                        ],
                        "tags": [
                            "Austria",
                            "Bavaria",
                            "colloquial",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a2fb0f48-2312-463b-804a-ba9b7830a01f",
                                "sense_id": "5363fa1a-7320-3a09-ac8d-ca688da8aa35",
                                "text": "»Hast du jetzt in Bayern ein Gspusi? So sagt man doch dort?« »Kein Gspusi! Noch nicht! Aber was nicht ist, kann noch werden.« Eine Fernbeziehung Berlin – München passte überhaupt nicht zu ihrer Lebensplanung.",
                                "translation": "»Have you got a \"Gspusi\" in Bavaria now? That's how they say it there, right?« »No such thing! Not yet! But what is not, may yet be.« A long-distance relationship Berlin - Munich did not at all fit into her life planning.",
                                "english": "»Have you got a \"Gspusi\" in Bavaria now? That's how they say it there, right?« »No such thing! Not yet! But what is not, may yet be.« A long-distance relationship Berlin - Munich did not at all fit into her life planning."
                            }
                        ]
                    },
                    {
                        "sense_id": "b37778a5-01b8-3bc6-9719-2a7f946141c0",
                        "entry_id": "4bf70eb3-e325-33aa-bbcb-d4ac1464daa0",
                        "glosses": [
                            "lover"
                        ],
                        "tags": [
                            "Austria",
                            "Bavaria",
                            "colloquial",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "690b1ce5-6e26-4808-a5c3-fd55aab47cdc",
                                "sense_id": "b37778a5-01b8-3bc6-9719-2a7f946141c0",
                                "text": "Ob das Schloss ihr Eigentum war (was zumindest ihre abgabepflichtigen Untertanen sicherlich wussten) oder ob sie sich nur so hier herumtrieb: Sie war das Gspusi des Landesfürsten und damit basta.",
                                "translation": "If the castle was her property (her tax-paying subjects at least would have surely known) or if she just gadded around the place: She was the prince's lover and that is it.",
                                "english": "If the castle was her property (her tax-paying subjects at least would have surely known) or if she just gadded around the place: She was the prince's lover and that is it."
                            }
                        ]
                    }
                ],
