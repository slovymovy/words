                                                "example_id": "19e9ae77-3721-4891-860c-6aebd7486c31",
                                                "sense_id": "6023d70c-30a0-355a-a9b5-db202c90bdf9",
                                                "text": "In a printing machine, the combination of a kicker mechanism for displacing a newspaper […]"
                                            }
