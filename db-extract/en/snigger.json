                "senses": [
                    {
                        "sense_id": "b6dadb19-dbf6-3b1c-ab0c-55552277ef7d",
                        "entry_id": "6d7264f4-1d21-33a3-a79b-64058376e973",
                        "glosses": [
                            "Ricanement."
                        ],
                        "tags": [
                            "Royaume-Uni"
                        ],
                        "examples": [
                            {
                                "example_id": "ea1a2c7a-47a3-4b77-98fd-756c4ae4532a",
                                "sense_id": "b6dadb19-dbf6-3b1c-ab0c-55552277ef7d",
                                "text": "You don’t expect a man to never remember more than the first three lines of the first verse, and to keep on repeating these until it is time to begin the chorus. You don’t expect a man to break off in the middle of a line, and snigger, and say, it’s very funny, but he’s blest if he can think of the rest of it, and then try and make it up for himself, and, afterwards, suddenly recollect it, when he has got to an entirely different part of the song, and break off, without a word of warning, to go back and let you have it then and there."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
