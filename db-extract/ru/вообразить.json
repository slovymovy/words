                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ad12589-5fba-4597-85fc-01e043929b40",
                        "source_entry_id": "e3542027-1043-3b35-8d7c-15f355f109ba",
                        "source_sense_id": "f25fea9b-c338-3e3e-9b17-20d3d1a1fe0f",
                        "target_lang_word": "imagine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imagine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9e6682a-d6b6-3446-b105-edcb3d77fef2",
                                        "entry_id": "e4ad18a5-3788-38e6-b991-62857a4f2143",
                                        "glosses": [
                                            "To form a mental image of something; to envision or create something in one's mind."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08d5f4e2-f2bf-4af3-a397-efe5afb1a24f",
                                                "sense_id": "f9e6682a-d6b6-3446-b105-edcb3d77fef2",
                                                "text": "Try to imagine a pink elephant."
                                            },
                                            {
                                                "example_id": "a72e7e6e-1140-48ab-a062-2f56d69b5d4a",
                                                "sense_id": "f9e6682a-d6b6-3446-b105-edcb3d77fef2",
                                                "text": "Imagine yourself in a packed airport lounge."
                                            },
                                            {
                                                "example_id": "fcaf34b7-b90d-48f7-96fe-f05273c51e5a",
                                                "sense_id": "f9e6682a-d6b6-3446-b105-edcb3d77fef2",
                                                "text": "Imagine all the people / Livin' life in peace"
                                            },
                                            {
                                                "example_id": "ad2e000f-ea50-4b3f-a598-6e8fbb73b630",
                                                "sense_id": "f9e6682a-d6b6-3446-b105-edcb3d77fef2",
                                                "text": "Or in the night, imagining ſome feare, / How eaſie is a buſh ſuppos’d a Beare?"
                                            },
                                            {
                                                "example_id": "f7c4e502-777a-4d92-bc5c-a710c075381a",
                                                "sense_id": "f9e6682a-d6b6-3446-b105-edcb3d77fef2",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be8aa629-2d25-383e-8fdd-bc2940424898",
                                        "entry_id": "e4ad18a5-3788-38e6-b991-62857a4f2143",
                                        "glosses": [
                                            "To believe in something created by one's own mind, often something false."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "971eda87-7dd3-409a-b2ef-d85e1d558243",
                                                "sense_id": "be8aa629-2d25-383e-8fdd-bc2940424898",
                                                "text": "She imagined that the man wanted to kill her."
                                            },
                                            {
                                                "example_id": "f4e37b20-c202-41e6-b63b-26eaf4230c9f",
                                                "sense_id": "be8aa629-2d25-383e-8fdd-bc2940424898",
                                                "text": "There's nothing there; you're just imagining things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d146ca51-2f22-33f8-bcfd-e4a9e1749437",
                                        "entry_id": "e4ad18a5-3788-38e6-b991-62857a4f2143",
                                        "glosses": [
                                            "To assume; to suppose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f8e43c-26f2-4964-9629-5b6c92705842",
                                                "sense_id": "d146ca51-2f22-33f8-bcfd-e4a9e1749437",
                                                "text": "I imagine that he will need to rest after such a long flight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "535c389f-ed3b-3900-9454-cafe25145c44",
                                        "entry_id": "e4ad18a5-3788-38e6-b991-62857a4f2143",
                                        "glosses": [
                                            "To conjecture; to guess."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4539de02-359f-4216-b6b4-6156a04c0b6f",
                                                "sense_id": "535c389f-ed3b-3900-9454-cafe25145c44",
                                                "text": "I cannot even imagine what you are up to!"
                                            },
                                            {
                                                "example_id": "41985856-b75a-4a02-be89-36b31a0dc48f",
                                                "sense_id": "535c389f-ed3b-3900-9454-cafe25145c44",
                                                "text": "The board imagines the merger will increase profits by 25%"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "809051f1-329c-3642-a952-21828d40da1f",
                                        "entry_id": "e4ad18a5-3788-38e6-b991-62857a4f2143",
                                        "glosses": [
                                            "To use one's imagination."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f804907-4bb4-4dde-8d57-0cdbed7c3f5e",
                                                "sense_id": "809051f1-329c-3642-a952-21828d40da1f",
                                                "text": "Imagine that we were siblings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be7b9257-2304-3a92-9ad2-d2cb460c50fd",
                                        "entry_id": "e4ad18a5-3788-38e6-b991-62857a4f2143",
                                        "glosses": [
                                            "To contrive in purpose; to scheme; to devise."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52a64b03-dd5f-414c-a481-258d7b6ab58e",
                                                "sense_id": "be7b9257-2304-3a92-9ad2-d2cb460c50fd",
                                                "text": "How long wil ye imagine miſchiefe againſt a man?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebff1769-5f0c-36c1-8e15-81943f6e979d",
                                        "entry_id": "e4ad18a5-3788-38e6-b991-62857a4f2143",
                                        "glosses": [
                                            "Used to mock an idea by suggesting that it is ridiculous or ill thought through."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "sarcastic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7684808a-acb8-42cc-b9d9-f3a383cafb14",
                                                "sense_id": "ebff1769-5f0c-36c1-8e15-81943f6e979d",
                                                "text": "Imagine thinking that would work."
