                            }
                        },
                        {
                            "text": "There is a strange noise coming from the attic, so <w>hist</w> and listen closely.",
                            "target_lang_translations": {
                                "ru": "С чердака доносится странный шум, так что <w>чу</w>, слушай внимательно."
                            }
