                                "example_id": "46fc8d79-d642-4033-b286-bea934432dd9",
                                "sense_id": "ee5bb9ae-6b64-3964-8046-7c11695fc5ca",
                                "text": "Et puis y a ça, aussi : ils bichent d’être en smok, les gaziers. Ils s’autoéblouissent."
                            }
