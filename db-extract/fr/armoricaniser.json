                "senses": [
                    {
                        "sense_id": "1df2f9dc-3212-36b8-9ad7-b74b969ab622",
                        "entry_id": "ef0e2792-562a-3808-b6ba-54c6852f70c8",
                        "glosses": [
                            "Donner un caractère armoricain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ccfc3d-6b1f-420f-8847-c681c8ab5dc2",
                                "sense_id": "1df2f9dc-3212-36b8-9ad7-b74b969ab622",
                                "text": "Les rues de Milltown s'armoricanisent depuis l'ouverture en 1907 de l'usine Michelin."
                            },
                            {
                                "example_id": "9d70f15c-6144-4c2f-a144-58b5fe1a0424",
                                "sense_id": "1df2f9dc-3212-36b8-9ad7-b74b969ab622",
                                "text": "C'est son oncle d'Amérique, le homard à l'américaine, qui a été sauvagement « armoricanisé »."
                            },
                            {
                                "example_id": "bf286cc1-9e07-4372-bc30-7d3d4c931675",
                                "sense_id": "1df2f9dc-3212-36b8-9ad7-b74b969ab622",
                                "text": "Bon, Erwann, pour être \"armoricanisant à donf\", il faut en plus élever des cochons, boire du chouchen, porter des sabots et jouer du biniou."
                            }
                        ]
                    }
