                ],
                "senses": [
                    {
                        "sense_id": "29539608-035e-3fb7-9a13-b0ad11fe98ed",
                        "entry_id": "b2f4e8ae-68dd-307b-a8f6-595716e2e50b",
                        "glosses": [
                            "Attaché aux plaisirs des sens."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b5a45732-2e44-44c0-9b08-a086ad9c460e",
                                "sense_id": "29539608-035e-3fb7-9a13-b0ad11fe98ed",
                                "text": "Homme charnel."
                            },
                            {
                                "example_id": "23afda01-1e9e-46e5-9bfb-3cdf0ea99d53",
                                "sense_id": "29539608-035e-3fb7-9a13-b0ad11fe98ed",
                                "text": "Il était écrit sur sa face camuse qu’il serait un pécheur charnel et, vers le soir, les mauvaises joies luisent dans ses yeux verts."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1b5003c-0302-37c8-8e91-04d53779b044",
                        "entry_id": "b2f4e8ae-68dd-307b-a8f6-595716e2e50b",
                        "glosses": [
                            "Relatif à la chair."
                        ],
                        "tags": [],
                        "note": "Ne s’emploie guère en ce sens que dans un sens religieux, par opposition à ce qui a rapport à l’âme",
                        "examples": [
                            {
                                "example_id": "b9cdeae8-c690-432c-a8a1-c60e1c9831d2",
                                "sense_id": "c1b5003c-0302-37c8-8e91-04d53779b044",
                                "text": "Depuis le 24 janvier nous sommes en ramadan, neuvième mois de l’année lunaire mahométane, pendant lequel tout bon musulman s’abstient de manger, de boire, de fumer, bref, de toute jouissance charnelle, depuis l’aube jusqu’au coucher du soleil."
                            },
                            {
                                "example_id": "3b969ba2-b094-4156-808e-b431d17df425",
                                "sense_id": "c1b5003c-0302-37c8-8e91-04d53779b044",
                                "text": "Les biens charnels et périssables."
                            }
                        ]
                    },
                    {
                        "sense_id": "786fcf31-590f-3c78-a444-597a3e6df4ce",
                        "entry_id": "b2f4e8ae-68dd-307b-a8f6-595716e2e50b",
                        "glosses": [
                            "Qui est fait de chair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "520019c1-6c1f-4cf4-9d0a-7ed7b204d42a",
                                "sense_id": "786fcf31-590f-3c78-a444-597a3e6df4ce",
                                "text": "Ces docteurs confondent, par un grossier sophisme, un idéal qui, en tant que non changeant, peut par pure métaphore être qualifié de mort, avec les hommes, les êtres charnels qui embrassent cet idéal, lesquels, en cet embrassement, peuvent être si peu morts qu’ils se battront avec acharnement pour le défendre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df8d3b8e-7de4-4153-abf5-a6f6e2b56077",
                        "source_entry_id": "b2f4e8ae-68dd-307b-a8f6-595716e2e50b",
                        "source_sense_description": "Attaché aux plaisirs des sens.",
                        "target_lang_word": "körperlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "körperlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                        "entry_id": "296fe70d-b9a6-3b1c-94e0-aca695822268",
                                        "glosses": [
                                            "den menschlichen oder tierischen Körper betreffend, auf ihn bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee6b2b4-e17f-420a-90e5-8bdaaf34e957",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "„Beim Fliegen überlistet der Pilot mittels seines Verstandes die Natur, die ihn körperlich nicht zum Fliegen geschaffen hat.“"
                                            },
                                            {
                                                "example_id": "12bbbaef-8315-436c-881b-f672bae6d7c3",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "Stress bedeutet durch eine Bedrohung hervorgerufene psychische und körperliche Anpassungsreaktion."
                                            },
                                            {
                                                "example_id": "2a09c039-e4f5-45aa-9ce4-6ba4b9f9476e",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "Am Sonntag war er von Trauernden körperlich angegriffen worden."
                                            },
                                            {
                                                "example_id": "f45263cc-e2f8-489a-b9f7-a36ef1f45d7d",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "Die treiben sich durch gegenseitigen Konkurrenzkampf nach oben, am Ende schaffen es die körperlich und mental stärksten ins Nationalteam."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                        "entry_id": "296fe70d-b9a6-3b1c-94e0-aca695822268",
                                        "glosses": [
                                            "Objekte der materiellen Welt betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "915a7445-d429-4b8b-b6f5-c70221a24954",
                                                "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                                "text": "Dort geht es um ein Instrument von Arp Schnitger, von dessen Klangkörper es wie in Dresden keinerlei körperliche Spur mehr gibt."
                                            },
                                            {
                                                "example_id": "b2c357bb-0b81-48d5-95f5-0288b32f984c",
                                                "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                                "text": "Wenn wir denken, denken wir in der Realität der Masse, in Bezug auf die körperliche Manifestation, und die kleinsten Teilchen der Materie."
                                            },
                                            {
                                                "example_id": "6eefc12f-400c-45d8-9fa3-7e0c01bc3b8b",
                                                "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                                "text": "Was auf diesen Bildern erscheint, ist die stilisierte körperliche Oberfläche als dessen säkulares Legat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
