                "senses": [
                    {
                        "sense_id": "6462b5ef-6416-3e0e-95f9-0903fb1d9e20",
                        "entry_id": "b3362184-e3d2-3e9b-9df1-77578ec855b7",
                        "glosses": [
                            "Qualifie une alimentation ou un régime alimentaire sans sel ou pauvre en sel."
                        ],
                        "tags": [
                            "Nutrition"
                        ],
                        "examples": [
                            {
                                "example_id": "14c4580d-f5a2-4534-afaf-6ba064983cc0",
                                "sense_id": "6462b5ef-6416-3e0e-95f9-0903fb1d9e20",
                                "text": "Le régime hyposodé est essentiellement un régime lacto-fruitarien. Il doit venir interrompre, au moins une fois par semaine, le régime de base [des goutteux] qui ne saurait être toléré qu’à cette condition."
                            },
                            {
                                "example_id": "21c76275-e2af-4cbb-9955-12d2875d5767",
                                "sense_id": "6462b5ef-6416-3e0e-95f9-0903fb1d9e20",
                                "text": "Une alimentation est hyposodée quand elle est inférieure à 1,4 g par jour, modérément salée entre 1,4 g et 4 g, hypersodée au-delà de 4 g. Ces chiffres sont assez universels."
                            }
                        ]
                    }
