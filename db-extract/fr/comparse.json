                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbdbc254-238e-4400-85f1-e331a8a520ab",
                                                "sense_id": "5fe03906-fa8f-3e30-8c54-184bafdb8116",
                                                "text": "„Mit 1 600 000 Mark Lohnkosten, 200 000 Kostümen, 36 000 Komparsinnen und Komparsen brach diese Ufa-Produktion alle Rekorde und sprengte alle Budgets.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
