{
    "word_family": [
        "cautious",
        "cautiously",
        "precaution",
        "incautious",
        "precautionary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d99644cd-47ae-3e23-adc3-a167a2444b2d",
                    "sense_definition": "Care taken to avoid danger or mistakes; prudence in the face of risk.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "carefulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>caution</w> when walking alone in this dangerous neighborhood at night.",
                            "target_lang_translations": {
                                "ru": "Вам следует соблюдать <w>осторожность</w>, когда вы гуляете в одиночку по этому опасному району ночью.",
                                "tr": "Gece bu tehlikeli mahallede yalnız yürürken <w>dikkatli olmalısın</w>."
                            }
                        },
                        {
                            "text": "The driver decided to exercise great <w>caution</w> while navigating the icy mountain roads.",
                            "target_lang_translations": {
                                "ru": "Водитель решил проявить крайнюю <w>осторожность</w> при движении по обледенелым горным дорогам.",
                                "tr": "Sürücü, buzlu dağ yollarında ilerlerken <w>büyük tedbir</w> göstermeye karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "care",
                        "carefulness",
                        "prudence",
                        "wariness",
                        "heed"
                    ],
                    "antonyms": [
                        "incaution"
                    ],
                    "common_phrases": [
                        "exercise great caution",
                        "proceed with caution",
                        "act with caution",
                        "extreme caution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Меры, принимаемые во избежание опасности или ошибок; осмотрительность перед лицом риска.",
                        "tr": "Tehlike veya hatalardan kaçınmak için gösterilen dikkat; risk karşısında temkinli olma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осторожность",
                                "target_lang_sense_clarification": "внимательность и осмотрительность"
                            },
                            {
                                "target_lang_word": "осмотрительность",
                                "target_lang_sense_clarification": "продуманность действий"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dikkat",
                                "target_lang_sense_clarification": "özen ve tedbir"
                            },
                            {
                                "target_lang_word": "tedbir",
                                "target_lang_sense_clarification": "önlem ve dikkat"
                            },
                            {
                                "target_lang_word": "temkin",
                                "target_lang_sense_clarification": "temkinli ve ihtiyatlı davranma"
                            },
                            {
                                "target_lang_word": "ihtiyat",
                                "target_lang_sense_clarification": "sakınma ve önceden düşünme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5c1b051-a182-3e87-b7af-f873ae4e0321",
                    "sense_definition": "A formal warning given by the police to someone who has committed a minor crime but is not being prosecuted.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since it was his first offense, the teenager received a police <w>caution</w> instead of a fine.",
                            "target_lang_translations": {
                                "ru": "Поскольку это было его первое правонарушение, подросток получил полицейское <w>предупреждение</w> вместо штрафа.",
                                "tr": "İlk suçu olduğu için genç, para cezası yerine <w>polis uyarısı</w> aldı."
                            }
                        },
                        {
                            "text": "The officer decided to issue a <w>caution</w> after the shoplifter returned the stolen items.",
                            "target_lang_translations": {
                                "ru": "Офицер решил вынести <w>предостережение</w> после того, как магазинный вор вернул украденные вещи.",
                                "tr": "Memur, hırsız çalınan eşyaları iade ettikten sonra bir <w>ihtar</w> düzenlemeye karar verdi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "police caution",
                        "issue a caution",
                        "formal caution"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in UK legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное предупреждение, выносимое полицией лицу, совершившему незначительное преступление, без возбуждения уголовного дела.",
                        "tr": "Hafif bir suç işleyen ancak dava açılmayan birine polis tarafından verilen resmi uyarı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предупреждение",
                                "target_lang_sense_clarification": "официальное полицейское предостережение"
                            },
                            {
                                "target_lang_word": "предостережение",
                                "target_lang_sense_clarification": "формальное замечание правоохранительных органов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "resmi uyarı",
                                "target_lang_sense_clarification": "polis tarafından verilen ikaz"
                            },
                            {
                                "target_lang_word": "ihtar",
                                "target_lang_sense_clarification": "yasal uyarı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546f5ea1-2dbe-3617-959b-af711b858a3c",
                    "sense_definition": "A yellow card shown to a player by a referee as a warning for a foul.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defender received a <w>caution</w> for a late tackle during the second half.",
                            "target_lang_translations": {
                                "ru": "Защитник получил <w>предупреждение</w> за грубый подкат во втором тайме.",
                                "tr": "Defans oyuncusu ikinci yarıdaki gecikmeli müdahalesi nedeniyle bir <w>sarı kart</w> gördü."
                            }
                        },
                        {
                            "text": "After the referee showed him a <w>caution</w>, the player had to be more careful.",
                            "target_lang_translations": {
                                "ru": "После того как судья вынес ему <w>предупреждение</w>, игроку пришлось быть осторожнее.",
                                "tr": "Hakem kendisine bir <w>ihtar</w> gösterdikten sonra oyuncu daha dikkatli olmak zorunda kaldı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "receive a caution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Желтая карточка, предъявляемая игроку судьей в качестве предупреждения за нарушение правил.",
                        "tr": "Sporda hakem tarafından kural ihlali nedeniyle oyuncuya gösterilen sarı kart uyarısı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предупреждение",
                                "target_lang_sense_clarification": "желтая карточка в спорте"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sarı kart",
                                "target_lang_sense_clarification": "sporda ceza uyarısı"
                            },
                            {
                                "target_lang_word": "ihtar",
                                "target_lang_sense_clarification": "hakem uyarısı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47e1f62b-10c1-3c68-896d-3511e5b92c72",
                    "sense_definition": "A person who is unusual, amusing, or surprising in their behavior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That old man is a real <w>caution</w> with all his funny stories and strange hats.",
                            "target_lang_translations": {
                                "ru": "Этот старик — настоящий <w>чудак</w> со всеми его смешными историями и странными шляпами.",
                                "tr": "O yaşlı adam komik hikayeleri ve garip şapkalarıyla tam bir <w>alalem</w>."
                            }
                        },
                        {
                            "text": "You are a <w>caution</w> sometimes; I never know what you are going to say next.",
                            "target_lang_translations": {
                                "ru": "Ну ты и <w>кадр</w> иногда; никогда не знаешь, что ты скажешь в следующий момент.",
                                "tr": "Bazen <w>ilginç bir tipsin</w>; bir sonraki an ne söyleyeceğini asla bilemiyorum."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used to describe eccentric people"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с необычным, забавным или удивительным поведением.",
                        "tr": "Davranışları olağandışı, komik veya şaşırtıcı olan kimse."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудак",
                                "target_lang_sense_clarification": "необычный или забавный человек"
                            },
                            {
                                "target_lang_word": "кадр",
                                "target_lang_sense_clarification": "разговорное о странном человеке"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tiplere bak",
                                "target_lang_sense_clarification": "ilginç ve komik kişi"
                            },
                            {
                                "target_lang_word": "nevi şahsına münhasır kimse",
                                "target_lang_sense_clarification": "garip veya alışılmadık karakter"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b4343d02-dc1d-3048-8e2b-6107dc76f1ad",
                    "sense_definition": "To warn or advise someone to be careful about a potential danger or problem.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "warning_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor <w>cautioned</w> against taking the medication on an empty stomach.",
                            "target_lang_translations": {
                                "ru": "Врач <w>предостерег</w> от приема лекарства натощак.",
                                "tr": "Doktor, ilacın aç karnına alınmaması konusunda <w>uyardı</w>."
                            }
                        },
                        {
                            "text": "Experts <w>caution</w> that the economic recovery may take longer than expected.",
                            "target_lang_translations": {
                                "ru": "Эксперты <w>предупреждают</w>, что восстановление экономики может занять больше времени, чем ожидалось.",
                                "tr": "Uzmanlar, ekonomik toparlanmanın beklenenden daha uzun sürebileceği hususunda <w>ikaz ediyor</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "caution against",
                        "caution that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предупреждать или советовать кому-либо быть осторожным в отношении потенциальной опасности или проблемы.",
                        "tr": "Olası bir tehlike veya sorun hakkında birini dikkatli olması için uyarmak veya bilgilendirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предостерегать",
                                "target_lang_sense_clarification": "советовать быть осторожным"
                            },
                            {
                                "target_lang_word": "предупреждать",
                                "target_lang_sense_clarification": "сообщать о возможной опасности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uyarmak",
                                "target_lang_sense_clarification": "ikaz etmek"
                            },
                            {
                                "target_lang_word": "ikaz etmek",
                                "target_lang_sense_clarification": "dikkatli olmasını söylemek"
                            },
                            {
                                "target_lang_word": "tembihlemek",
                                "target_lang_sense_clarification": "özen göstermesini öğütlemek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1456902-2d89-3c7d-b615-c2703a442c8f",
                    "sense_definition": "To officially warn a player in a game by showing them a yellow card.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee had to <w>caution</w> the goalkeeper for wasting time during the goal kick.",
                            "target_lang_translations": {
                                "ru": "Судье пришлось <w>вынести предупреждение</w> вратарю за затягивание времени при ударе от ворот.",
                                "tr": "Hakem, kale vuruşu sırasında zaman kazandığı için kaleciye <w>sarı kart göstermek</w> zorunda kaldı."
                            }
                        },
                        {
                            "text": "He was <w>cautioned</w> for his aggressive behavior toward the opposing team.",
                            "target_lang_translations": {
                                "ru": "Он был <w>предупрежден</w> за агрессивное поведение по отношению к команде противника.",
                                "tr": "Rakip takıma karşı agresif davranışları nedeniyle <w>uyarıldı</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально вынести предупреждение игроку во время игры, предъявив желтую карточку.",
                        "tr": "Oyunda bir oyuncuya sarı kart göstererek resmi olarak uyarıda bulunmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выносить предупреждение",
                                "target_lang_sense_clarification": "показывать желтую карточку"
                            },
                            {
                                "target_lang_word": "предупреждать",
                                "target_lang_sense_clarification": "делать официальное замечание игроку"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sarı kart göstermek",
                                "target_lang_sense_clarification": "hakemin oyunda uyarması"
                            },
                            {
                                "target_lang_word": "ihtar vermek",
                                "target_lang_sense_clarification": "resmi spor uyarısı yapmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}