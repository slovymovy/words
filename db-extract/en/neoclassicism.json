                                            {
                                                "example_id": "7ff9bfab-1276-4032-b7ef-08ac6c9f57eb",
                                                "sense_id": "a7f8943a-6976-3bfb-9fe0-352a4732afb2",
                                                "text": "Het neoclassicisme kreeg door de opgravingen te Pompeii een enorme impuls."
                                            }
                                        ]
                                    }
                                ]
                            }
