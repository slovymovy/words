                "senses": [
                    {
                        "sense_id": "f2dfe084-b8d1-37bd-bfe4-d926b584967d",
                        "entry_id": "befffcce-40a6-324e-816b-026fca310d85",
                        "glosses": [
                            "Besen der Schornsteinfeger zum Kehren von Kaminen, der aus einem Griff und einer oder mehreren Scheiben sternförmig angeordneter Borsten besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0d758f8-0e62-442c-bd96-49271e155d8a",
                                "sense_id": "f2dfe084-b8d1-37bd-bfe4-d926b584967d",
                                "text": "Sigmund Gonsior, Schornsteinfegermeister und stellvertretetender Stadtbrandmeister, zeigte den Feuerwehrleuten den richtigen Umgang mit dem Kettenkehrgerät, Stoßbesen und der Fallgranate."
                            },
                            {
                                "example_id": "7c835a58-1b96-4517-9270-d7c96bcfbeb6",
                                "sense_id": "f2dfe084-b8d1-37bd-bfe4-d926b584967d",
                                "text": "Danach werden mit dem flexiblen Stoßbesen und der passenden Einlage das Ofenrohr (Verbindung vom Ofen zum Schornstein) sowie alle weiteren von der Öffnung aus erreichbaren Rauchgaszüge gereinigt."
                            },
                            {
                                "example_id": "620aac60-b3a2-4b90-9e7f-ca8b148eb0e4",
                                "sense_id": "f2dfe084-b8d1-37bd-bfe4-d926b584967d",
                                "text": "Dann lässt du einen Stoßbesen in das Abgasrohr hinab und entfernst so Laub, Vogelnester oder Rußablagerungen."
                            },
                            {
                                "example_id": "7b4b4403-6858-42c8-ba5b-c94c21361a15",
                                "sense_id": "f2dfe084-b8d1-37bd-bfe4-d926b584967d",
                                "text": "Für das Reinigen des Schornsteins und das Entfernen des Rußes haben wir Schornsteinfeger spezielle Geräte. Kehrgeräte, Stoßbesen und das Schultereisen helfen, den Schornstein von Verunreinigungen zu befreien und einen ungestörten Abzug der Abgase zu ermöglichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
