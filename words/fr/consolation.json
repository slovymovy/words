                    "frequency": "VeryLow",
                    "semantic_group_id": "boisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un copieux repas dominical, les convives appréciaient de boire une petite <w>consolation</w> bien méritée."
                        },
                        {
                            "text": "Le vieil homme commandait toujours un café noir avec une <w>consolation</w> au comptoir du café de campagne."
                        }
                    ],
