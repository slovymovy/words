                        "source_sense_id": "d283ae8b-a4cc-3e64-ac2c-9ef5d70b3cc8",
                        "target_lang_word": "gepflegt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gepflegt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa9d400e-8067-3809-af72-82e6926a53c5",
                                        "entry_id": "36733591-1495-3a6d-8876-5492517809e9",
                                        "glosses": [
                                            "in einem sehr guten Zustand infolge körperlicher Pflege (bei Personen) oder gutem Unterhalt/Instandhaltung (bei Dingen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d365a7-af50-4db2-b460-f5e2cda7bc1d",
                                                "sense_id": "aa9d400e-8067-3809-af72-82e6926a53c5",
                                                "text": "Aber auch für Liebhaber gepflegter Rasenflächen gibt es in Zeiten der Wassersparsamkeit einen Hoffnungsschimmer: […] eine sparsame unterirdische Tröpfchenbewässerung […]."
                                            },
                                            {
                                                "example_id": "e5966faf-233a-4d60-ac66-db7f39d88adc",
                                                "sense_id": "aa9d400e-8067-3809-af72-82e6926a53c5",
                                                "text": "Als Verkäufer muss man ein gepflegtes Äußeres haben!"
                                            },
                                            {
                                                "example_id": "3c76d92f-8559-455e-862a-c27d6d99d91f",
                                                "sense_id": "aa9d400e-8067-3809-af72-82e6926a53c5",
                                                "text": "\"Wir halten [unsere Gäste] an, mit gepflegter Kleidung zum Essen zu gehen […]"
                                            },
                                            {
                                                "example_id": "14f26280-77b3-49df-8ed3-a91d9f5b3c18",
                                                "sense_id": "aa9d400e-8067-3809-af72-82e6926a53c5",
                                                "text": "Frau: „Ich finde, es sieht gepflegter aus, wenn ein Mann glatt rasiert ist und außerdem ist es kuscheliger.“"
                                            },
                                            {
                                                "example_id": "104d6bef-6c36-4c8a-a780-4dcb84b50a84",
                                                "sense_id": "aa9d400e-8067-3809-af72-82e6926a53c5",
                                                "text": "Das Ortsbild [des Ortsteiles 'Kircher Bauerschaft' in Isernhagen/Niedersachsen] wird geprägt von einer Vielzahl gepflegter Fachwerkhäuser und Bauernhöfe sowie der auf der Anhöhe stehenden Sankt-Marien-Kirche."
                                            },
                                            {
                                                "example_id": "d598d4e7-5bb7-4d5c-bf7f-b146e66b69f3",
                                                "sense_id": "aa9d400e-8067-3809-af72-82e6926a53c5",
                                                "text": "Ich fahre durch Bruchmühle. Ein gepflegter, kleiner Ort rund 30 Kilometer östlich von Berlin mit ein paar alten Villen, guten Stellen zum Angeln, einem Sportplatz und einem Billigsupermarkt."
                                            },
                                            {
                                                "example_id": "29ed6c74-3cc0-4ab4-829f-97916ee25fbf",
                                                "sense_id": "aa9d400e-8067-3809-af72-82e6926a53c5",
                                                "text": "Auch die Eigentümer gut gepflegter Immobilien müssen bisweilen um Mieter buhlen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b2b2ac8-ad68-351c-898b-981b98b7a6a2",
                                        "entry_id": "36733591-1495-3a6d-8876-5492517809e9",
                                        "glosses": [
                                            "niveauvoll, anspruchsvoll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ec9f92-d28d-4a9f-9dce-aa0c541951eb",
                                                "sense_id": "3b2b2ac8-ad68-351c-898b-981b98b7a6a2",
                                                "text": "Am Abend ein gepflegtes Bier mit Freunden trinken, dass ist Genuss."
                                            },
                                            {
                                                "example_id": "a3b710a5-3e2c-416e-8777-3c006a2d29f9",
                                                "sense_id": "3b2b2ac8-ad68-351c-898b-981b98b7a6a2",
                                                "text": "Der Verein Deutsche Sprache […] will mit [dem Preis] des \"Sprachpanschers\" mehr Bewusstsein für eine gepflegte Ausdrucksweise schaffen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
