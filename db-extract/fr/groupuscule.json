                "forms": [
                    {
                        "form_id": "e87ef6e5-3015-4a7d-9405-ea2c64871a1d",
                        "entry_id": "ad6dc7c7-8b82-38a0-b136-64b876223b1b",
                        "tags": [
                            "plural"
                        ],
                        "form": "groupuscules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1900fa8-afde-3ff5-91e0-bf7744335f0d",
                        "entry_id": "ad6dc7c7-8b82-38a0-b136-64b876223b1b",
                        "glosses": [
                            "Très petit groupe politique."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "32650dd1-43fe-4d4a-b4f9-31b97054478a",
                                "sense_id": "d1900fa8-afde-3ff5-91e0-bf7744335f0d",
                                "text": "Il apparaît que le produit de ces listes de souscriptions n’est pas utilisé pour aider la lutte des antifascistes allemands, mais pour subventionner l’activité d’un groupuscule d’individus peu recommandables."
                            },
                            {
                                "example_id": "77e65093-9f06-49c2-89cb-381409966ff0",
                                "sense_id": "d1900fa8-afde-3ff5-91e0-bf7744335f0d",
                                "text": "Que les « branleurs » se rassurent, le jeune Philippot (36 ans, on l’oublie) n’est peut-être pas complètement parti, même s’il vient de créer son groupuscule, Les Patriotes, et a mis en fureur la Marine, qui juge ce choix « ringard »."
                            },
                            {
                                "example_id": "684d6f86-74ce-4e81-908b-f711c778d30b",
                                "sense_id": "d1900fa8-afde-3ff5-91e0-bf7744335f0d",
                                "text": "Les Hommen est le nom d’un groupuscule d’hommes hostile au projet d’extension du mariage civil aux personnes de même sexe en France, appelé « mariage pour tous » par ses défenseurs. Ce groupuscule est issu de la radicalisation d’une partie du mouvement d’opposition nommé lui-même La Manif Pour Tous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dd27646-aa89-4053-b3dd-51328e1736f1",
                        "source_entry_id": "ad6dc7c7-8b82-38a0-b136-64b876223b1b",
                        "source_sense_id": "d1900fa8-afde-3ff5-91e0-bf7744335f0d",
                        "source_sense_description": "petit groupe politique",
                        "target_lang_word": "Grüppchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grüppchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                        "entry_id": "f97ab8a1-70fc-3bda-ab6b-00528507eb8f",
                                        "glosses": [
                                            "kleine Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ca4b72-641e-4d60-aef1-9859a9535287",
                                                "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                                "text": "„Während sie sprach, sah Anat sich nach Pierre um, der lächelnd von einem Grüppchen zum anderen ging.“"
                                            },
                                            {
                                                "example_id": "43af4b90-e9de-4cbc-a56b-cf983294aa64",
                                                "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                                "text": "„Die Hinauseilenden gingen in Grüppchen, in Gespräche vertieft oder ganz für sich in die Schrift.“"
                                            },
                                            {
                                                "example_id": "4a5f5ab9-87d0-453e-8033-2ff4153469b3",
                                                "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                                "text": "„Als der Tanz verebbt, teilt Freddy die Touristen in Grüppchen von je vier Personen ein.“"
                                            },
                                            {
                                                "example_id": "4165b0dd-6a0c-4af6-8039-1e9b1e88ed85",
                                                "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                                "text": "„Die übrigen Anwesenden plauderten, in kleine Grüppchen zerstreut.“"
                                            },
                                            {
                                                "example_id": "dced19b9-d8fa-44ef-9418-05d3fd83930b",
                                                "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                                "text": "„Zweitens, zusammen mit der Handvoll Rallye-Damen und einigen verschleierten Tunesierinnen waren wir Frauen ein verschwindend kleines Grüppchen an Bord.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c8ddbe2-87fd-4ea0-a064-247ee15f0dcc",
                        "source_entry_id": "ad6dc7c7-8b82-38a0-b136-64b876223b1b",
                        "source_sense_id": "d1900fa8-afde-3ff5-91e0-bf7744335f0d",
                        "source_sense_description": "petit groupe politique",
                        "target_lang_word": "groupuscule",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
