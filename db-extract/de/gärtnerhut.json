                "senses": [
                    {
                        "sense_id": "3d74bf81-3064-31c9-aa58-2bd2057df45d",
                        "entry_id": "77117d9a-abf3-399b-9f7a-a4ceb9317a01",
                        "glosses": [
                            "Hut für Gärtner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfbd66ae-ffdb-4670-8855-08be148d7d93",
                                "sense_id": "3d74bf81-3064-31c9-aa58-2bd2057df45d",
                                "text": "„Nur hatte sie eine Kopfbedeckung aufgesetzt, einen strohgeflochtenen hellen Gärtnerhut mit einem bunten Band, dessen Enden lustig flatterten.“"
                            },
                            {
                                "example_id": "9428650e-4b25-4f69-9e71-8637ccd80eee",
                                "sense_id": "3d74bf81-3064-31c9-aa58-2bd2057df45d",
                                "text": "„Was ist das wohl für ein Heiliger, der da mit Spaten in der Hand und Gärtnerhut auf dem Kopf dargestellt wird?“"
                            },
                            {
                                "example_id": "48e263fc-6d74-4b3d-9e17-bf66525033c5",
                                "sense_id": "3d74bf81-3064-31c9-aa58-2bd2057df45d",
                                "text": "„Weiter erhielt er ein Schild mit der Aufschrift „Neuer Gärtner im Amt“, eine Gärtnerschürze, eine grüne Gießkanne, einen schmucken Gärtnerhut und die Entmachtungsurkunde, die er vorzulesen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
