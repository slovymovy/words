                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4a5b3b2-009d-4745-bcec-e077698ebf3b",
                                                "sense_id": "a715d894-9c4e-3cbf-a797-06c0e420cb2d",
                                                "text": "Avant toute chose, l’ASAAC doit permettre aux services et aux principaux industriels aéronautiques européens de réfléchir et d’aboutir à une idée commune de ce que doit être l’avionique de la prochaine génération."
                                            },
                                            {
                                                "example_id": "5adb6fab-70e4-4add-ae33-72a19d50fa27",
                                                "sense_id": "a715d894-9c4e-3cbf-a797-06c0e420cb2d",
                                                "text": "L’avionique et les systèmes de contrôle de vol seraient dérivés des F-15QA qataris et SG singapouriens et sa motorisation serait plus puissante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
