                        "source_entry_id": "97fce729-e78d-3993-8bfa-41790f3b64cf",
                        "source_sense_description": "at full speed",
                        "target_lang_word": "бы́стро",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
