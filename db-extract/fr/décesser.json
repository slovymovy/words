                "senses": [
                    {
                        "sense_id": "8b12ac00-6194-3bf2-8d12-18f79f7df295",
                        "entry_id": "1727df0b-6edb-39fc-b386-3793c8fcce19",
                        "glosses": [
                            "Cesser."
                        ],
                        "tags": [
                            "colloquial",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "352cf202-6078-445d-8781-44e3475bd24c",
                                "sense_id": "8b12ac00-6194-3bf2-8d12-18f79f7df295",
                                "text": "Depuis une demi-heure je me trempais jusqu’aux os d’une radée qui ne décessait pas, quand j’entends le bruit d’une espagnolette."
                            },
                            {
                                "example_id": "c8f4b28f-4c1a-4045-9ad1-59402d652193",
                                "sense_id": "8b12ac00-6194-3bf2-8d12-18f79f7df295",
                                "text": "J’ai jamais décessé de la briquer comme du vivant de Madame."
                            },
                            {
                                "example_id": "9647901f-03cb-4645-85bd-2154b971f0da",
                                "sense_id": "8b12ac00-6194-3bf2-8d12-18f79f7df295",
                                "text": "Ce carillon est le plus parfait qui existe ; aussi tous les carillons de Flandre ont-ils, depuis long-tems, reconnu sa suprématie ; mais comme il est situé dans le centre des cafés et des estaminets, et qu’il ne décesse de faire entendre sa vigoureuse harmonie, les étrangers, qui ne peuvent le souffrir, jurent d’une façon bien diabolique contre tous les bourdons du monde."
                            },
                            {
                                "example_id": "eb70785a-222c-46e0-88ed-90d528139738",
                                "sense_id": "8b12ac00-6194-3bf2-8d12-18f79f7df295",
                                "text": "En moins de quelques minutes il parcourt ces différens états; il recommence, et ne décesse jusqu'à son coucher."
                            }
                        ]
                    }
                ],
