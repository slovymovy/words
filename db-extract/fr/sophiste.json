        "fr-extract.jsonl": [
            {
                "entry_id": "da79415d-dc31-340f-8573-d92e0d8edcd4",
                "word": "sophiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4fa135af-5e3e-4461-9af3-6fbf394ee339",
                        "entry_id": "da79415d-dc31-340f-8573-d92e0d8edcd4",
                        "tags": [
                            "plural"
                        ],
                        "form": "sophistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a1c98a7-4196-37b9-aae8-43082affe4a4",
                        "entry_id": "da79415d-dc31-340f-8573-d92e0d8edcd4",
                        "glosses": [
                            "Philosophe, rhéteur professionnel. Depuis Platon, nom donné aux professeurs et rhéteurs rémunérés, par opposition aux philosophes."
                        ],
                        "tags": [
                            "Ancient",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "72cf51d5-931b-415c-b359-903d5f88a346",
                                "sense_id": "4a1c98a7-4196-37b9-aae8-43082affe4a4",
                                "text": "Selon le sophiste grec présocratique Protagoras : « l'homme est la mesure de toute chose »."
                            },
                            {
                                "example_id": "9a542673-2dcf-4c6d-813c-0449fb963f1e",
                                "sense_id": "4a1c98a7-4196-37b9-aae8-43082affe4a4",
                                "text": "Les Sophistes ont risqué, au Vᵉ siècle, sans être autrement molestés, les plus graves impertinences, telle que celle-ci : la religion n'est qu'un mensonge utile."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0ec927d-38a2-3b6d-b82d-0a617763f421",
                        "entry_id": "da79415d-dc31-340f-8573-d92e0d8edcd4",
                        "glosses": [
                            "Celui qui use d’arguments captieux."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bf6f1a0c-f788-4192-a147-dbc5310cb36a",
                                "sense_id": "d0ec927d-38a2-3b6d-b82d-0a617763f421",
                                "text": "Des sophistes défendront cette thèse, mais elle est fausse."
                            },
                            {
                                "example_id": "238a469d-a5b6-445f-99a0-773e56273c4a",
                                "sense_id": "d0ec927d-38a2-3b6d-b82d-0a617763f421",
                                "text": "Mettons dans la même classe les dialecticiens et les sophistes, gens qui font plus de bruit que tous les chaudrons de Dodone, et dont le moins babillard pourrait tenir tête aux vingt plus bavardes commères qu'on puisse trouver sous le ciel."
                            },
                            {
                                "example_id": "ab2190f0-b5a1-45a6-95ae-a3258ee5f171",
                                "sense_id": "d0ec927d-38a2-3b6d-b82d-0a617763f421",
                                "text": "Alors, dans les prochains mois, nous allons entendre tous les sophistes du privé nous marteler le message que le bloc patrimonial est une chose mauvaise pour notre économie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22ea676e-b1a2-4263-a770-0597a5d663f8",
                        "source_entry_id": "da79415d-dc31-340f-8573-d92e0d8edcd4",
                        "target_lang_word": "Sophist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sophist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e8f65ee-9191-3ab3-8972-b27f47abbd46",
                                        "entry_id": "fe9b37e9-c088-38c2-bee2-7f61bb082d22",
                                        "glosses": [
                                            "ein Vertreter der Sophistik, einer Gruppe von griechischen Philosophen des 5. und 4. Jahrhunderts vor Christus, die als Wanderlehrer gegen Entgelt vor allem in Athen auftraten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58c8d318-d60a-43aa-86fb-47231b7b9a71",
                                                "sense_id": "2e8f65ee-9191-3ab3-8972-b27f47abbd46",
                                                "text": "„Da die Sophisten als einzelne Lehrer verschiedener Wissenschaften aufgetreten sind, kann man auch nicht von einer Schule im Sinne einer einheitlichen Lehrmeinung sprechen.“"
                                            },
                                            {
                                                "example_id": "10c76859-40a9-4e93-9581-8e984b06b3e9",
                                                "sense_id": "2e8f65ee-9191-3ab3-8972-b27f47abbd46",
                                                "text": "„In Athen verdienten die Sophisten ihren Lebensunterhalt damit, die Bürger der Stadt zu unterrichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d1c73d1-aa55-33d4-af9a-27533652ce58",
                                        "entry_id": "fe9b37e9-c088-38c2-bee2-7f61bb082d22",
                                        "glosses": [
                                            "eine Person, die sophistisch argumentiert"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "396d1885-1624-4e97-ae79-3f49f465ea26",
                        "source_entry_id": "da79415d-dc31-340f-8573-d92e0d8edcd4",
