{
    "word_family": [
        "prétention",
        "prétendant",
        "prétentieux",
        "prétentieusement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9085385-434b-3ad0-9ed7-68babae9ac05",
                    "sense_definition": "Affirmer ou soutenir quelque chose avec assurance, souvent sans preuve ou de manière contestable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>prétend</w> avoir terminé tout le travail avant midi, mais personne ne l'a vu."
                        },
                        {
                            "text": "Elle <w>prétendait</w> qu'elle ne connaissait rien à cette affaire compliquée."
                        }
                    ],
                    "synonyms": [
                        "affirmer",
                        "soutenir",
                        "assurer"
                    ],
                    "antonyms": [
                        "nier",
                        "démentir"
                    ],
                    "common_phrases": [
                        "prétendre le contraire",
                        "oser prétendre"
                    ]
                },
                {
                    "sense_id": "cfbaeaba-5f29-3a01-a6cf-48ac08f059a7",
                    "sense_definition": "Aspirer à quelque chose, revendiquer un titre, une fonction ou un avantage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aspiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec son expérience, elle peut légitimement <w>prétendre</w> à ce poste de direction."
                        },
                        {
                            "text": "Plusieurs candidats sérieux <w>prétendent</w> à la victoire lors de ce tournoi."
                        }
                    ],
                    "synonyms": [
                        "aspirer",
                        "briguer",
                        "viser"
                    ],
                    "antonyms": [
                        "renoncer"
                    ],
                    "common_phrases": [
                        "prétendre à un poste",
                        "pouvoir prétendre"
                    ]
                },
                {
                    "sense_id": "ec3c0126-9c1a-3263-b406-c67aa9e39507",
                    "sense_definition": "Vouloir fermement, avoir l'exigence ou l'intention déterminée d'obtenir quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "volonte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne vous permets pas ce ton et je <w>prétends</w> être respecté chez moi."
                        },
                        {
                            "text": "Le directeur <w>prétendait</w> imposer ces changements sans consulter les employés."
                        }
                    ],
                    "synonyms": [
                        "entendre",
                        "exiger",
                        "vouloir"
                    ],
                    "antonyms": [
                        "céder"
                    ],
                    "common_phrases": [
                        "prétendre imposer",
                        "prétendre commander"
                    ]
                },
                {
                    "sense_id": "51e18737-2a1f-3842-ad97-0600aa99fb54",
                    "sense_definition": "Demander ou réclamer quelque chose au titre d'un droit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "revendication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque héritier <w>prétend</w> une part égale dans cette succession difficile."
                        },
                        {
                            "text": "En vertu des anciens accords, leur groupe <w>prétend</w> la présidence de la commission."
                        }
                    ],
                    "synonyms": [
                        "réclamer",
                        "revendiquer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Dans cet emploi transitif direct"
                        }
                    ]
                },
                {
                    "sense_id": "245c0e5a-9eab-3f1e-acf9-9c799353bc9c",
                    "sense_definition": "Appliquer une tension mécanique préalable à un élément ou un matériau.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le technicien doit soigneusement <w>prétendre</w> les câbles avant la mise en service du pont."
                        },
                        {
                            "text": "Cette pièce risque de casser si vous ne la <w>prétendez</w> pas selon les instructions."
                        }
                    ]
                }
            ]
        }
    ]
}