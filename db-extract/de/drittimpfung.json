                        "entry_id": "13d68f36-7071-3492-b2b0-c569b364db90",
                        "glosses": [
                            "dritte Impfung, die auf zwei anfängliche Impfungen durchgeführt werden muss, um einen vollen Impfschutz zu erlangen/aufzufrischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e53716d-6015-4c28-b5e9-2235f830c733",
                                "sense_id": "7fe845b2-b905-347f-b86a-26e3b7dd4dcc",
                                "text": "„Es war nicht unmittelbar klar, welche wissenschaftlichen Erkenntnisse die Grundlage für die Entscheidung zur baldigen Drittimpfung waren.“"
                            },
                            {
                                "example_id": "d8a73554-b35c-41f4-8f91-a43bafb0d894",
                                "sense_id": "7fe845b2-b905-347f-b86a-26e3b7dd4dcc",
                                "text": "„Die Firmen dürften im Fall der Zulassung einer Drittimpfung auf hohe Einnahmen hoffen.“"
                            }
                        ],
