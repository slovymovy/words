                "senses": [
                    {
                        "sense_id": "2088e003-b328-3475-a97f-d2abe3898594",
                        "entry_id": "fbed01d7-935a-301a-8c94-d0a7b3b1440c",
                        "glosses": [
                            "Pipette en terre cuite (ou autre type de récipient avec un bec fin) rempli d'engobe coloré qui servait à faire des dessins simples sur les poteries avant cuisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6def6acb-21a2-4ff7-9d85-06bf9463efa0",
                                "sense_id": "2088e003-b328-3475-a97f-d2abe3898594",
                                "text": "Le « jaspage » s'obtenait par un barolet spécial précédemment décrit . L'ouvrier dispose d'autant de barolets que de couleurs. Il remplit chacun d'un engobe jaune, rouge, bleu, vert, noir, etc., un peu plus épais que l'engobe ordinaire."
                            },
                            {
                                "example_id": "0ffe9790-204a-4d35-8438-b41789cb65bf",
                                "sense_id": "2088e003-b328-3475-a97f-d2abe3898594",
                                "text": "La peinture est appliquée, comme à Heimberg, au moyen d'un barolet, espèce de petite tasse terminée par un tuyau de plume, d'où s'échappe la couleur liquide et que le peintre promène sur la surface des objets à décorer."
                            }
                        ]
                    }
                ],
