                ],
                "senses": [
                    {
                        "sense_id": "9bfb9710-de0a-3e95-a2f3-ca0499c634b0",
                        "entry_id": "13a79a1c-b970-3b2a-b5dc-cd8bf7d33a66",
                        "glosses": [
                            "Unwille; Zorn; Hohn; Grimm; unwirsche Ungeduld"
                        ],
                        "tags": [
                            "oberdeutsch",
                            "untergegangen"
                        ],
                        "examples": [
                            {
                                "example_id": "dda1ffaa-69da-4a99-be2d-c89e1c0998d9",
                                "sense_id": "9bfb9710-de0a-3e95-a2f3-ca0499c634b0",
                                "text": "„O wie dick und vil werden die menschen entzündet von den fuerpfeilen (des teufels) yn zorn, ynn unwürsche wider iren nechsten!“"
                            },
                            {
                                "example_id": "f91d413b-42e5-458e-afe2-36013f44618e",
                                "sense_id": "9bfb9710-de0a-3e95-a2f3-ca0499c634b0",
                                "text": "„Der Zorn ist denen Dienst-Leuthen verderblich; dan alle Unwirsche / oder Ungedult geräichet zu ihrer eigenen Pein;“"
                            },
                            {
                                "example_id": "23050e04-b1d5-4e36-9398-9bb7d1e8b884",
                                "sense_id": "9bfb9710-de0a-3e95-a2f3-ca0499c634b0",
                                "text": "„[…], und schmisse ald warff der Ammann Bodmer das Siegel mit Unwirsche auf den Tisch, stuhnd auf, und gienge darvon, und ließ das Siegel liegen; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
