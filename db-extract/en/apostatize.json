                        "cross_references": [
                            {
                                "target_word": "apostasier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "757407ce-9b98-38aa-9cc3-ed0fb44ae502",
                                        "entry_id": "7e2d5aa8-dbfd-33c6-89b1-7fa0aad06d03",
                                        "glosses": [
                                            "Faire acte d’apostasie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf2e09c-66f4-4af2-9925-ff8ad47472b7",
                                                "sense_id": "757407ce-9b98-38aa-9cc3-ed0fb44ae502",
                                                "text": "Cette condescendance ne le mit point à l'abri d'une persécution qui vouloit que les prêtres apostasiassent formellement."
                                            },
                                            {
                                                "example_id": "9bae7100-a14f-4d65-a15b-60c5aa3065f7",
                                                "sense_id": "757407ce-9b98-38aa-9cc3-ed0fb44ae502",
                                                "text": "Lindet et Massieu, évêques de l'Eure et de l'Oise, apostasièrent, se marièrent et votèrent la mort de Louis XVI. Gavernon et Huguet, évêques de la Haute-Vienne et de la Creuse, apostasièrent également et votèrent la mort du roi ; […]."
                                            },
                                            {
                                                "example_id": "bb251079-1a1c-4a19-91f6-5b0b3fc3d781",
                                                "sense_id": "757407ce-9b98-38aa-9cc3-ed0fb44ae502",
                                                "text": "Plusieurs, séduits par cette ruse, ont eu la faiblesse dʼapostasier."
                                            },
                                            {
                                                "example_id": "7bab62ff-5bd9-4284-aae1-42aa8b90458d",
                                                "sense_id": "757407ce-9b98-38aa-9cc3-ed0fb44ae502",
                                                "text": "« Silence » a pour trame la quête entreprise par deux prêtres jésuites au début des années 1640, pour retrouver le missionnaire portugais Cristavo Ferreira, grand évangélisateur de l'archipel qui aurait fini par apostasier sous la torture au point d'adopter le point de vue de ses oppresseurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
