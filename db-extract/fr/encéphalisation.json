                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encephalization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a83824f5-3ebf-3d38-8277-7703df7680ef",
                                        "entry_id": "c3baaf7a-3c2c-39f4-84cd-e269bc1e916f",
                                        "glosses": [
                                            "The amount of brain mass exceeding that related to an animal's total bodymass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96899b35-497c-4c10-9683-4ddc0c438869",
                                                "sense_id": "a83824f5-3ebf-3d38-8277-7703df7680ef",
                                                "text": "The answer to this will determine the encephalization quotients of the two types of early hominids, which is an important indicator of relative \"braininess,\" an issue that is now up for grabs."
                                            },
                                            {
                                                "example_id": "f4e3b964-4318-430a-9905-4137795e4130",
                                                "sense_id": "a83824f5-3ebf-3d38-8277-7703df7680ef",
                                                "text": "It is believed that the encephalization of early Homo was made possible by the consumption of energy- and nutrient-rich animal foods to \"pay\" for its metabolically expensive brain."
                                            },
                                            {
                                                "example_id": "35f52832-7ff6-4b72-964a-a7e7fd49b2a6",
                                                "sense_id": "a83824f5-3ebf-3d38-8277-7703df7680ef",
                                                "text": "The time spent in REM sleep is not correlated with learning ability across humans, nor is there a positive relation between REM sleep time or intensity and encephalization across species."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86509bb3-5092-4ef1-a968-df3ef360a2b9",
                        "source_entry_id": "1bc0fe89-cd98-33c2-96e3-7923e8d1e23b",
                        "source_sense_id": "ff3ec668-cfc9-39fb-b760-a5f50ca873f1",
