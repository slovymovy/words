            "senses": [
                {
                    "sense_id": "07208549-c97e-371f-bec4-9549b8807cf7",
                    "sense_definition": "A field where corn or other cereal crops are grown.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ran through the tall <w>cornfield</w> during the hot summer afternoon.",
                            "target_lang_translations": {
                                "ru": "Дети бегали по высокому <w>кукурузному полю</w> жарким летним днем."
                            }
                        },
                        {
                            "text": "We could see the golden <w>cornfield</w> stretching across the entire valley.",
                            "target_lang_translations": {
                                "ru": "Мы видели, как золотое <w>кукурузное поле</w> простирается через всю долину."
                            }
                        }
                    ],
                    "synonyms": [
                        "maize field"
                    ],
                    "common_phrases": [
                        "large cornfield",
                        "golden cornfield"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поле, на котором выращивают кукурузу или другие зерновые культуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кукурузное поле",
                                "target_lang_sense_clarification": "поле, засеянное кукурузой"
                            },
                            {
                                "target_lang_word": "нива",
                                "target_lang_sense_clarification": "поэтическое или устаревшее название хлебного поля"
                            }
