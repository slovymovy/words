                "senses": [
                    {
                        "sense_id": "7bf24f84-b6c3-301c-99f0-d1a7d7b5a563",
                        "entry_id": "5b3278ea-55a2-3502-b2af-4b8676e9ce25",
                        "glosses": [
                            "Zaper à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cd083e6-d2f1-4493-b50e-211825a6c04b",
                                "sense_id": "7bf24f84-b6c3-301c-99f0-d1a7d7b5a563",
                                "text": "Il est plus facile de zaper ou de rezaper une assiette ponctuellement, que d'avoir des bacs d'eau chaude, qui vont refroidir."
                            },
                            {
                                "example_id": "a1d5fb1d-fd82-4e4c-9f9c-b52820004f6e",
                                "sense_id": "7bf24f84-b6c3-301c-99f0-d1a7d7b5a563",
                                "text": "si ce n'est pas le cas alors c'est peut etre un ex comme un autre et tu n'as qu'à le rezaper pour un bout de temps histoire qu'il puisse te réoublier!"
                            },
                            {
                                "example_id": "83c7b1b6-b3a9-4c13-993f-bc06f70d05d0",
                                "sense_id": "7bf24f84-b6c3-301c-99f0-d1a7d7b5a563",
                                "text": "J'ai dû rezaper vers le mode Normal pour pouvoir passer la toute dernière mission qui est, il faut l'avouer, extrêmement difficile !"
                            }
                        ]
                    }
