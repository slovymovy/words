{
    "word_family": [
        "strenuously",
        "strenuousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a9c0b746-4702-3824-8214-667b1c43813e",
                    "sense_definition": "Requiring great physical or mental exertion; very demanding or laborious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor advised him to avoid <w>strenuous</w> exercise until his knee was fully healed.",
                            "target_lang_translations": {
                                "fr": "Le médecin lui a conseillé d'éviter tout exercice <w>intense</w> jusqu'à ce que son genou soit complètement guéri.",
                                "zh": "医生建议他在膝盖彻底痊愈之前避免进行<w>剧烈的</w>运动。"
                            }
                        },
                        {
                            "text": "After a <w>strenuous</w> climb up the steep mountain path, they finally reached the summit.",
                            "target_lang_translations": {
                                "fr": "Après une ascension <w>éprouvante</w> le long du sentier de montagne escarpé, ils ont finalement atteint le sommet.",
                                "zh": "经过沿着陡峭山路一段<w>费力的</w>攀登后，他们终于到达了山顶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vigorous"
                    ],
                    "antonyms": [
                        "effortless",
                        "easy"
                    ],
                    "common_phrases": [
                        "strenuous exercise",
                        "strenuous effort",
                        "strenuous activity"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui exige un grand effort physique ou mental ; très éprouvant ou difficile.",
                        "zh": "需要耗费大量体力或脑力的；繁重的、费劲的。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "éprouvant",
                                "target_lang_sense_clarification": "qui fatigue énormément, physiquement ou moralement"
                            },
                            {
                                "target_lang_word": "ardu",
                                "target_lang_sense_clarification": "difficile et demandant beaucoup d'efforts"
                            },
                            {
                                "target_lang_word": "éreintant",
                                "target_lang_sense_clarification": "qui épuise physiquement"
                            },
                            {
                                "target_lang_word": "intense",
                                "target_lang_sense_clarification": "pour un exercice ou une activité physique soutenue"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剧烈的",
                                "target_lang_sense_clarification": "常指运动或体力消耗大的活动"
                            },
                            {
                                "target_lang_word": "费力的",
                                "target_lang_sense_clarification": "指需要付出很多努力的"
                            },
                            {
                                "target_lang_word": "艰苦的",
                                "target_lang_sense_clarification": "指过程艰难、辛苦的"
                            },
                            {
                                "target_lang_word": "繁重的",
                                "target_lang_sense_clarification": "指任务或工作量大且费力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63e53f6b-aa22-354a-96cf-b533f812ce8f",
                    "sense_definition": "Showing or characterized by great energy, forcefulness, or determination.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government faced <w>strenuous</w> opposition from local communities over the new highway project.",
                            "target_lang_translations": {
                                "fr": "Le gouvernement a fait face à une <w>vive</w> opposition des communautés locales concernant le projet de nouvelle autoroute.",
                                "zh": "新高速公路项目遭到了当地社区对政府的<w>强烈</w>反对。"
                            }
                        },
                        {
                            "text": "She issued a <w>strenuous</w> denial regarding any involvement in the scandal.",
                            "target_lang_translations": {
                                "fr": "Elle a opposé un démenti <w>catégorique</w> quant à son implication dans le scandale.",
                                "zh": "她发表声明，<w>坚决</w>否认自己卷入了这桩丑闻。"
                            }
                        }
                    ],
                    "synonyms": [
                        "determined",
                        "energetic",
                        "resolute",
                        "zealous"
                    ],
                    "antonyms": [
                        "halfhearted",
                        "passive"
                    ],
                    "common_phrases": [
                        "strenuous opposition",
                        "strenuous objections",
                        "strenuous denial"
                    ],
                    "target_lang_definitions": {
                        "fr": "Marqué par une grande énergie, de la fermeté ou une vive détermination.",
                        "zh": "表现出充沛精力、强烈态度或坚定决心的；坚决的、激烈的。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "vigoureux",
                                "target_lang_sense_clarification": "marqué par la force et l'énergie"
                            },
                            {
                                "target_lang_word": "ferme",
                                "target_lang_sense_clarification": "résolu et sans hésitation"
                            },
                            {
                                "target_lang_word": "acharné",
                                "target_lang_sense_clarification": "qui fait preuve d'une opposition ou d'une ardeur opiniâtre"
                            },
                            {
                                "target_lang_word": "énergique",
                                "target_lang_sense_clarification": "qui agit avec force et décision"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强烈的",
                                "target_lang_sense_clarification": "多用于反对、抗议等态度"
                            },
                            {
                                "target_lang_word": "坚决的",
                                "target_lang_sense_clarification": "指态度坚定不移"
                            },
                            {
                                "target_lang_word": "极力的",
                                "target_lang_sense_clarification": "指用尽全力地否认或辩解"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}