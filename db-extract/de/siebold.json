                ],
                "senses": [
                    {
                        "sense_id": "7d9b7575-49d5-388a-a073-2b63b3f940b3",
                        "entry_id": "51ec8dbc-317d-3f95-9ad9-0c2278d13e21",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a82353a-72b4-46f1-ab2e-6695686c58ee",
                                "sense_id": "7d9b7575-49d5-388a-a073-2b63b3f940b3",
                                "text": "Frau Siebold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "50078b8b-f497-48f3-bd68-b589c41b7f46",
                                "sense_id": "7d9b7575-49d5-388a-a073-2b63b3f940b3",
                                "text": "Herr Siebold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "aecae871-5732-4379-bc7c-aa1ea8da4c7c",
                                "sense_id": "7d9b7575-49d5-388a-a073-2b63b3f940b3",
                                "text": "Die Siebolds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "becbde61-243f-4e7b-95b1-fbbcfceb167a",
                                "sense_id": "7d9b7575-49d5-388a-a073-2b63b3f940b3",
                                "text": "Der Siebold trägt nie die Schals, die die Siebold ihm strickt."
                            },
                            {
                                "example_id": "30a779e9-7b1f-4625-972b-453d3ae0786e",
                                "sense_id": "7d9b7575-49d5-388a-a073-2b63b3f940b3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Siebold kommt, geht der Herr Siebold.“"
                            },
                            {
                                "example_id": "6f33ded2-63d1-44ad-a36b-039625b47719",
                                "sense_id": "7d9b7575-49d5-388a-a073-2b63b3f940b3",
                                "text": "Siebold kommt und geht."
                            },
                            {
                                "example_id": "d0be79db-f804-4c02-9640-9c56706d4d41",
                                "sense_id": "7d9b7575-49d5-388a-a073-2b63b3f940b3",
                                "text": "Siebolds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
