                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hair_styling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она каждое утро красиво <w>укладывает</w> волосы с помощью фена.",
