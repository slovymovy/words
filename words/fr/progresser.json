                {
                    "sense_id": "7c2030fa-972c-3a9a-8047-a711dbc70124",
                    "sense_definition": "Avancer dans l'espace, se déplacer vers l'avant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les randonneurs continuent de <w>progresser</w> lentement le long du sentier escarpé.",
                            "target_lang_translations": {
                                "en": "The hikers keep <w>advancing</w> slowly along the steep trail.",
                                "ru": "Туристы продолжают медленно <w>продвигаться</w> вдоль крутой тропы.",
                                "de": "Die Wanderer <w>kommen</w> auf dem steilen Pfad weiterhin langsam <w>voran</w>.",
                                "es": "Los excursionistas siguen <w>avanzando</w> lentamente a lo largo del sendero escarpado.",
                                "zh": "徒步者们仍在沿着陡峭的小路慢慢<w>前进</w>。"
                            }
                        },
                        {
                            "text": "Malgré la tempête de neige, le groupe a réussi à <w>progresser</w> vers le refuge.",
                            "target_lang_translations": {
                                "en": "Despite the snowstorm, the group managed to <w>advance</w> towards the mountain hut.",
                                "ru": "Несмотря на снежную бурю, группа сумела <w>продвинуться</w> к горному приюту.",
                                "de": "Trotz des Schneesturms <w>kam</w> die Gruppe Richtung Berghütte <w>voran</w>.",
                                "es": "A pesar de la tormenta de nieve, el grupo logró <w>avanzar</w> hacia el refugio.",
                                "zh": "尽管遇到暴风雪，这支队伍还是设法向山间小屋<w>前进</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "avancer"
                    ],
                    "antonyms": [
                        "reculer"
                    ],
                    "common_phrases": [
                        "progresser lentement"
                    ],
                    "target_lang_definitions": {
                        "en": "To move forward through space, advancing along a route.",
                        "ru": "Двигаться вперёд в пространстве, продвигаться по маршруту.",
                        "de": "Sich räumlich nach vorn bewegen und auf einem Weg oder Gelände weiterkommen.",
                        "es": "Avanzar en el espacio, desplazándose hacia adelante por un trayecto.",
                        "zh": "在空间中向前移动，沿着路线继续行走。"
                    },
