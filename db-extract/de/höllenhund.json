                                    {
                                        "sense_id": "477cc231-d568-3e73-9a80-36faf6a26832",
                                        "entry_id": "3cf7d431-2c1d-38ad-ae69-d9385590151e",
                                        "glosses": [
                                            "A demonic dog of hell, typically of unnatural size, strength or speed, with black fur, glowing eyes, and ghostly or phantom characteristics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48d72651-b471-4172-b984-b3b209c0c648",
                                                "sense_id": "477cc231-d568-3e73-9a80-36faf6a26832",
                                                "text": "From forth the kennell of thy wombe hath crept / A Hell-hound that doth hunt vs all to death:"
                                            },
                                            {
                                                "example_id": "1bbed472-6cac-4479-872f-214f21dedd9e",
                                                "sense_id": "477cc231-d568-3e73-9a80-36faf6a26832",
                                                "text": "Barricading serves not: fly fast, ye Bodyguards; rabid Insurrection, like the hellhound Chase, uproaring at your heels!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f52b4271-bd80-39ce-a512-5f2989200760",
