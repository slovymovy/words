                        "cross_references": [
                            {
                                "target_word": "walging",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ba6d4b3b-c988-3f48-a9f7-0a45ba5c2be0",
                                        "entry_id": "a4d75233-21f8-3ca6-8fc0-48149817ab80",
                                        "glosses": [
                                            "een sterke weerzin die fysiek gevoeld wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4feefbc9-76a5-4ab2-a9da-2cbdd795be11",
                                                "sense_id": "ba6d4b3b-c988-3f48-a9f7-0a45ba5c2be0",
                                                "text": "Het feit dat de bankiers na de verwoestende financiële crisis van 2008 niet werden gestraft voor hun frauduleuze praktijken droeg in het Westen nog meer bij tot een walging van de politiek en de financiële elite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
