                "senses": [
                    {
                        "sense_id": "44aae2a4-4a6e-3c57-baaa-1ffb7ce9c3b6",
                        "entry_id": "7211a025-4239-37f3-a1cb-291b0280e8b8",
                        "glosses": [
                            "An abrupt, high-pitched sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d21d558-e8f6-4ec3-864a-937c173044bd",
                                "sense_id": "44aae2a4-4a6e-3c57-baaa-1ffb7ce9c3b6",
                                "text": "Just as they were in the roughest part of the mountains, there was a wild shriek of the whistle, a sudden scrunt of the air-brakes, and the train, with an abruptness that was just short of an accident, stopped."
                            },
                            {
                                "example_id": "b50ab171-bffc-48ea-9f3b-3df8e26af525",
                                "sense_id": "44aae2a4-4a6e-3c57-baaa-1ffb7ce9c3b6",
                                "text": "But Jess would not budge, and all of a sudden I sees a white flash in the dark, and hears a rattle of harness, and a scrunt in the shafts as Jess shook her head clear of the blow."
                            },
                            {
                                "example_id": "0e426c7c-3d21-4527-91c0-8cf972cb5617",
                                "sense_id": "44aae2a4-4a6e-3c57-baaa-1ffb7ce9c3b6",
                                "text": "They rose, and the scrunt of Janet's chair on the floor, when she pushed it behind her, sent a thrilling shiver through her body, so tense was her mood."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9ad63870-b906-34af-8a7c-41efd3ff1cb6",
