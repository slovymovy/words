                                        "examples": []
                                    },
                                    {
                                        "sense_id": "868ae6e1-3e9c-31ad-ba45-eeb50302e3ea",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "One who flies a kite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e399439-d672-4d70-b6cd-cc797fa2da9c",
                                                "sense_id": "868ae6e1-3e9c-31ad-ba45-eeb50302e3ea",
                                                "text": "Julia has become quite a good kite pilot. She has learned how to repeatedly buzz her father's head, coming within two feet, and not hitting him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa367097-5126-3461-8af8-c7a167cb0f9b",
