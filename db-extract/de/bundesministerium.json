                        "form": "das Bundesministerium"
                    },
                    {
                        "form_id": "11b8e1c0-7ec1-4dd7-95ad-286fcc0e7541",
                        "entry_id": "3f109aeb-790c-321a-be79-4fc2264234b4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bundesministerien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23f46710-75ce-3074-a56b-af8651f0f51d",
                        "entry_id": "3f109aeb-790c-321a-be79-4fc2264234b4",
                        "glosses": [
                            "oberste Behörde eines Bundesstaates unter der Leitung eines Ministers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8081dc3-6d8a-49b1-9fe3-9518d61cae11",
                                "sense_id": "23f46710-75ce-3074-a56b-af8651f0f51d",
                                "text": "„Die Gemeinsame Geschäftsordnung der Bundesministerien sieht zwar vor, dass Gesetzentwürfe »grundsätzlich« dem Redaktionsstab Rechtssprache zur Prüfung vorzulegen sind, doch Sanktionen für die Nichtbeachtung dieser Vorschrift gibt es nicht.“"
                            },
                            {
                                "example_id": "961759a3-9033-4d19-bbff-7ca2cec45927",
                                "sense_id": "23f46710-75ce-3074-a56b-af8651f0f51d",
                                "text": "„Er wird der bestbezahlte Sprecher aller Bundesministerien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8222c41-db7d-36d2-b3be-5c267a6b42e6",
                        "entry_id": "3f109aeb-790c-321a-be79-4fc2264234b4",
                        "glosses": [
                            "ein Gebäude in dem [1] seinen Sitz hat"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f2e71c4-b4c2-479c-9094-7ca047a5a298",
                        "source_entry_id": "3f109aeb-790c-321a-be79-4fc2264234b4",
                        "source_sense_id": "23f46710-75ce-3074-a56b-af8651f0f51d",
                        "source_sense_description": "oberste Behörde eines Bundesstaates unter der Leitung eines Ministers",
                        "target_lang_word": "ministère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ministère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2acdd4db-dcfc-327c-b1d4-775743a71b10",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Emploi ou charge qu’on exerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0467c75-dc92-4317-8722-348872e5fa41",
                                                "sense_id": "2acdd4db-dcfc-327c-b1d4-775743a71b10",
                                                "text": "Ces sortes d'affaires s'instruisent sans huissiers ni défenseurs. Le ministère de ceux-ci est déclaré n'être pas obligatoire, et le surcroît de frais qu'il eût occasionné être irrépétible."
                                            },
                                            {
                                                "example_id": "43d19ae9-58c9-416e-b254-f23e4befae73",
                                                "sense_id": "2acdd4db-dcfc-327c-b1d4-775743a71b10",
                                                "text": "Satisfaire aux obligations, remplir les devoirs de son ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88301569-c87d-3e4a-afae-e96b8555fc11",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Fonction d’un huissier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3a747b0-021f-44ab-a213-0c0085580f58",
                                                "sense_id": "88301569-c87d-3e4a-afae-e96b8555fc11",
                                                "text": "Opérer une saisie par ministère d’huissier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Fonctions dans l’Église, notamment d’un prêtre (sacerdoce)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b727188-3ac6-483b-a485-f3c6bf29eb74",
                                                "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                                "text": "Je fus un instant sur le point de céder, et de me servir de son ministère, non point pour lui dire ce qu'il attendait sans doute, un grand secret, mais afin de m'éprouver moi-même, et de savoir ce que ces secours religieux produiraient sur mon esprit."
                                            },
                                            {
                                                "example_id": "4e06afa6-a18d-44d6-9b3a-4c01a33bed3e",
                                                "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                                "text": "Jacques Monceau de Tournai avait étudié à Genève en 1566 et y avait exercé le ministère ; appelé au pastorat d’Anvers, il vint visiter Lille."
                                            },
                                            {
                                                "example_id": "e6a5025f-b44f-4910-9ba7-eb15b91147fe",
                                                "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                                "text": "Il faut rappeler qu’en 1972, Paul VI avait créé les ministères laïcs d’acolyte et de lecteur, fonctions relevant auparavant du sacrement de l’ordination, avec son motu proprio Ministeria quaedam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "674ae61d-3274-3607-9fdb-c4e19b5eecc4",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Entremise de quelqu’un dans une affaire, le service qu’on rend à une autre personne dans quelque emploi, dans quelque fonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "142c53e9-20b7-4ed3-99ed-daddd6df837e",
                                                "sense_id": "674ae61d-3274-3607-9fdb-c4e19b5eecc4",
                                                "text": "Il nous a offert, il nous a prêté son ministère. — Vous pouvez compter sur son ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1377ebb8-29ac-3c03-b17d-b40e7ad92c45",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Fonction des ministres chargés du soin des affaires publiques et dont l’ensemble constitue le gouvernement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Le département qu’ils administrent."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c8a76eb-3c2e-4763-9691-0a4764ec67a6",
                                                "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                                "text": "La première escarmouche se produit avec la discussion relative aux crédits nécessités par la création de deux ministères nouveaux : celui des Postes et Télégraphes et celui des Beaux-Arts."
                                            },
                                            {
                                                "example_id": "4ed1258a-2b39-4acf-9a68-3a9e8531065f",
                                                "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                                "text": "Ripont — […]. Commune entièrement détruite pendant la guerre de 1914-18. Son territoire est administré en 1919, par le \"ministère du blocus et des régions libérées\" puis par les Domaines."
                                            },
                                            {
                                                "example_id": "b431e478-b385-438f-b489-f2d42ecb8195",
                                                "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                                "text": "Il faudrait représenter Rabourdin habillé en boucher, mais bien ressemblant, chercher des analogies entre un bureau et une cuisine, lui mettre à la main un tranche-lard, peindre les principaux employés des ministères en volailles, les encager dans une immense souricière sur laquelle on écrirait : Exécutions administratives, et il serait censé leur couper le cou un à un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cbc0719-6378-3dc8-a6aa-490cb89073ff",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Temps pendant lequel la personne dont on parle a été ministre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31537d85-2f26-40b4-8ebd-c965a731e80d",
                                                "sense_id": "0cbc0719-6378-3dc8-a6aa-490cb89073ff",
                                                "text": "Il s’est fait de grandes choses pendant son ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caaa5222-a53f-3a1e-b13e-6e587ff805ed",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Ensemble des bureaux placés sous la direction d’un ministre et aussi le bâtiment où se trouvent ces services et la résidence du ministre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7d8459c-5632-4a00-b80b-5c4479631b43",
                                                "sense_id": "caaa5222-a53f-3a1e-b13e-6e587ff805ed",
                                                "text": "Les bureaux d’un ministère."
                                            },
                                            {
                                                "example_id": "f363e30c-d090-48f0-a5fe-2e040c05dfe2",
                                                "sense_id": "caaa5222-a53f-3a1e-b13e-6e587ff805ed",
                                                "text": "Aller au ministère."
                                            },
                                            {
                                                "example_id": "9b87d427-c315-477b-80cf-6bf409e21864",
                                                "sense_id": "caaa5222-a53f-3a1e-b13e-6e587ff805ed",
                                                "text": "Il passa devant le ministère de la Guerre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78eecd09-a323-3050-a4b9-5fca4e33edae",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Ensemble des ministres ; gouvernement."
                                        ],
                                        "tags": [
                                            "collectively",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03233a0b-9409-41f8-ac0f-b800f7e71606",
                                                "sense_id": "78eecd09-a323-3050-a4b9-5fca4e33edae",
                                                "text": "Dès le début du règne de Louis-Philippe, devait naître, à l’initiative de certains présidents du conseil, la question de confiance aux députés, soit à l'occasion de certains votes législatifs, soit au moment de la constitution du ministère."
                                            },
                                            {
                                                "example_id": "9648ae07-a4e0-4995-8513-006a9f1ca388",
                                                "sense_id": "78eecd09-a323-3050-a4b9-5fca4e33edae",
                                                "text": "Entrer dans le ministère. — La chute du ministère. — Former, remanier un ministère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6f7d8df-8ddf-47d8-a447-3e2dbc208dc5",
