                        "entry_id": "084864ee-d63a-39ca-9118-b2982e1376de",
                        "glosses": [
                            "in einem geschlossenen Raum ausgeübte Rückschlagsportart für zwei Spieler, bei der ein Ball gegen Wände gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d4b6f30-0fea-44e5-88cf-c71cbd5fe9b1",
                                "sense_id": "fe05e587-a540-3f5b-a6fb-01b75607957f",
                                "text": "„Am 26.03.2023 fand die deutsche Meisterschaft im Ricochet in Chemnitz statt.“"
                            },
                            {
                                "example_id": "6c851d13-73bd-4d38-8edf-c2bb7406d7f1",
                                "sense_id": "fe05e587-a540-3f5b-a6fb-01b75607957f",
                                "text": "„Squash ist wie Ricochet, American Handball oder Racquetball eines der wenigen Rückschlagspiele, bei dem die Gegner das Spielfeld gemeinsam benutzen und die Seitenwände in das Spiel einbezogen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
