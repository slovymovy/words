                {
                    "sense_id": "355d6147-0d34-3917-9429-31771866ed6f",
                    "sense_definition": "een zeer sombere of uitzichtloze situatie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil het <w>donker</w> niet meer in, mijn lief.",
                            "target_lang_translations": {
