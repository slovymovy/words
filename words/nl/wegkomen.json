{
    "word_family": [
        "komen",
        "wegkomst",
        "aankomen",
        "binnenkomen",
        "terugkomen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c53bcebf-7065-3b62-82c2-47bb8fdca271",
                    "sense_definition": "zich van een plaats verwijderen, vaak om een situatie te verlaten of te ontsnappen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verplaatsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kon nog maar net <w>wegkomen</w> voordat de politie arriveerde.",
                            "target_lang_translations": {
                                "en": "He was only just able to <w>get away</w> before the police arrived."
                            }
                        },
                        {
                            "text": "Maak dat je <w>wegkomt</w> uit dit gevaarlijke gebied!",
                            "target_lang_translations": {
                                "en": "Make sure you <w>get out</w> of this dangerous area!"
                            }
                        }
                    ],
                    "synonyms": [
                        "vertrekken",
                        "ontsnappen",
                        "ophoepelen",
                        "weggaan"
                    ],
                    "antonyms": [
                        "blijven",
                        "aankomen"
                    ],
                    "common_phrases": [
                        "maak dat je wegkomt",
                        "net kunnen wegkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move away from a place, often to leave a situation or to escape"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get away",
                                "target_lang_sense_clarification": "to leave or escape from a place"
                            },
                            {
                                "target_lang_word": "escape",
                                "target_lang_sense_clarification": "to succeed in getting away from a dangerous place"
                            },
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "to go away from a location"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efb97bba-9ccc-38f4-84a2-52db0106471d",
                    "sense_definition": "een straf of negatieve consequentie vermijden na een fout of misdaad",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consequentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je denkt misschien dat je slim bent, maar je <w>komt</w> er niet mee <w>weg</w>.",
                            "target_lang_translations": {
                                "en": "You might think you're smart, but you won't <w>get away</w> with it."
                            }
                        },
                        {
                            "text": "Hij is goed <w>weggekomen</w> met slechts een kleine boete voor die overtreding.",
                            "target_lang_translations": {
                                "en": "He <w>got off</w> easy with only a small fine for that violation."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontspringen",
                        "ontsnappen"
                    ],
                    "antonyms": [
                        "boeten",
                        "gestraft worden"
                    ],
                    "common_phrases": [
                        "er mee wegkomen",
                        "goed wegkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to avoid punishment or negative consequences after a mistake or crime"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get away with",
                                "target_lang_sense_clarification": "to escape punishment for a specific act"
                            },
                            {
                                "target_lang_word": "get off",
                                "target_lang_sense_clarification": "to escape or receive a very light punishment"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}