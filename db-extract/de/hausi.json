                        "form": "die Hausis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae9a2ad0-599f-3f94-b378-be9f4bf31e20",
                        "entry_id": "111198fa-c1e6-3f33-ae63-b6819faff003",
                        "glosses": [
                            "Person, die für die Instandhaltung eines Gebäudes (meist Schulgebäude) zuständig ist"
                        ],
                        "tags": [
                            "Schülersprache",
                            "Kurzwort"
                        ],
                        "examples": [
                            {
                                "example_id": "c0adb5a5-089b-43fb-a991-582526b8cf94",
                                "sense_id": "ae9a2ad0-599f-3f94-b378-be9f4bf31e20",
                                "text": "„Doch was hat der 65-Jährige in seiner Zeit als „Hausi“ alles erlebt?“"
                            },
                            {
                                "example_id": "7ff942d1-679b-4d5d-a476-daa97c659d6b",
                                "sense_id": "ae9a2ad0-599f-3f94-b378-be9f4bf31e20",
                                "text": "„Diese hatten die einzelnen Seiten kreativ gestaltet und geschrieben oder gemalt, für was sie ihrem „Hausi“ besonders danken und an was sie sich besonders erinnern.“"
                            },
                            {
                                "example_id": "c32905aa-6920-4dd0-828c-767d60f92894",
                                "sense_id": "ae9a2ad0-599f-3f94-b378-be9f4bf31e20",
                                "text": "„Die meisten Schüler nannten ihn einfach nur „Herbert“, für das Lehrerkollegium war er der „Hausi“.“"
                            },
                            {
                                "example_id": "b6742e3f-36e8-41cf-aedc-09cb12b8d875",
                                "sense_id": "ae9a2ad0-599f-3f94-b378-be9f4bf31e20",
                                "text": "„Ein „Hausi“ betreut zwei Schulen, an Grundschulen übernehmen „Hauswarte“ mit geringerer Stundenzahl.“"
                            },
                            {
                                "example_id": "87e3601c-c06b-47ac-963e-255ddef3fcf1",
                                "sense_id": "ae9a2ad0-599f-3f94-b378-be9f4bf31e20",
                                "text": "„Für den „Hausi“, der am liebsten einfach Dieter genannt wurde, gab es herzliche und lobende Worte zum Abschied.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
