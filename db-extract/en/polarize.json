                                            {
                                                "example_id": "460ebcbd-94d3-4b2d-8fb2-f73168d61f0d",
                                                "sense_id": "3fde3b81-5902-3bb7-8678-eb763641eaba",
                                                "text": "Bei ihnen sind zahllose Kristallnadeln von stark polarisierenden Stoffen parallel auf dünnen Folien angebracht. Solche Filter verhindern z.B. störende Reflexe in der Fotografie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5b9433b-af31-3a7f-80bf-857220d2cf72",
                                        "entry_id": "44be9fa7-6f71-34e1-ae41-a8e4abdef5d4",
                                        "glosses": [
