                        "source_entry_id": "23d9e8e6-8564-378e-a28b-3ed11bba5a1e",
                        "source_sense_description": "приверженец прогресса, прогрессизма, прогрессивизма",
                        "target_lang_word": "progressiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "progressiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e09cb5f-828a-3623-a7a6-885fa83be109",
                                        "entry_id": "ef70a364-297a-3b0d-8eed-8cb2ded89318",
                                        "glosses": [
                                            "En faveur du progrès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53593237-8eca-4140-ac3d-baebf4d54f1a",
                                                "sense_id": "4e09cb5f-828a-3623-a7a6-885fa83be109",
                                                "text": "Le Parti progressiste-conservateur du Canada (PC) était un parti politique conservateur canadien de centre-droite qui a existé de 1867 à 2003."
                                            },
                                            {
                                                "example_id": "71e61edd-536b-42de-9fe0-d3a362437924",
                                                "sense_id": "4e09cb5f-828a-3623-a7a6-885fa83be109",
                                                "text": "Du droit à un salaire minimum digne pour tous et toutes au droit à l’avortement et à la liberté des médias, le Parlement européen a adopté une série de positions progressistes ces deux dernières années."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "progressiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "662bb038-6bea-310f-af3b-8c1ca620a6c8",
                                        "entry_id": "8f2089ad-72fe-35cd-a3a4-0d93fe2a6247",
                                        "glosses": [
                                            "Partisan du progrès, d’une modification de la société par des réformes ou la révolution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27abca22-0e0e-46ca-a246-e859fd8a5c8e",
                                                "sense_id": "662bb038-6bea-310f-af3b-8c1ca620a6c8",
                                                "text": "Mais, ajoutent-ils, elle ne suffit plus pour assurer aux progressistes les instruments d'une riposte efficace à la reféodalisation du capitalisme."
                                            },
                                            {
                                                "example_id": "ed8a86e8-17ca-4b0b-808a-9773286995cc",
                                                "sense_id": "662bb038-6bea-310f-af3b-8c1ca620a6c8",
                                                "text": "Mais l’effondrement de l’empire soviétique et la déroute du socialisme ont plongé les progressistes dans un état de sidération. Entre les Noirs qui les repoussaient et le Goulag qui révélait le vrai visage du socialisme, les progressistes blancs se sont retrouvés en proie à un messianisme sans but"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22a936ed-5223-3226-9a44-d03617c000a5",
                                        "entry_id": "8f2089ad-72fe-35cd-a3a4-0d93fe2a6247",
                                        "glosses": [
                                            "Membre du Parti progressiste-conservateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e010487-b146-41a5-a091-50401bb9a77e",
                                                "sense_id": "22a936ed-5223-3226-9a44-d03617c000a5",
                                                "text": "Le premier ministre du Manitoba, John Brackeb, un progressiste, se présente comme chef du parti et remporte le scrutin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
