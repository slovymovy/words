                        "examples": [
                            {
                                "example_id": "61830948-6e6b-4ae6-b7d0-2d4291e5ee9f",
                                "sense_id": "0f3258c2-a64f-35df-bb04-f7aaabc78e28",
                                "text": "Трудно было найти лучший уголок для отдохновения."
                            },
                            {
                                "example_id": "82bca1cd-71f5-4025-9c9d-48f6ca34efab",
                                "sense_id": "0f3258c2-a64f-35df-bb04-f7aaabc78e28",
                                "text": "И в этот раз я отправился к привычному месту моего отдохновения, к этой берёзе."
                            }
                        ]
                    }
