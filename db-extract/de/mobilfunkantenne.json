                ],
                "senses": [
                    {
                        "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                        "entry_id": "250473bd-74a3-32d2-99f4-2ea145d2127d",
                        "glosses": [
                            "Geräte zum Empfang und Senden von Funkwellen von Handys und Smartphones"
                        ],
                        "tags": [
                            "Telekommunikation"
                        ],
                        "examples": [
                            {
                                "example_id": "f697e054-7712-44d1-9a5d-212c772b7243",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Fast ganz Deutschland ist mit einem Netz von Mobilfunkantennen bedeckt.“"
                            },
                            {
                                "example_id": "b9fc22b6-1cfe-4388-ac72-aa71d3435b84",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Wenn wir Nachrichten schicken oder telefonieren, dann schickt unser Handy ein Signal an die sogenannte Mobilfunkantenne.“"
                            },
                            {
                                "example_id": "368ee63c-ccb0-49c3-b760-0e16aeb3ba70",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Mobilfunkantennen werden auf geeigneten Gebäuden auf den Dächern derselben montiert.“"
                            },
                            {
                                "example_id": "384e5170-1d98-4576-805e-b61f029ae152",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Durch das Vermieten von Montageflächen für Mobilfunkantennen an geeigneten Bauwerken können Einnahmen erzielt werden.“"
                            },
                            {
                                "example_id": "d52114eb-60dc-4c28-b4c5-964d05e35400",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Wie auf Wassertürmen können auch auf Aussichtstürmen Mobilfunkantennen installiert werden.“"
                            },
                            {
                                "example_id": "bb6121eb-4fa9-4527-9fe9-3c2de0736779",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„In Industriegebieten und an Stellen, an denen geeignet hohe Dachstandorte nicht zur Verfügung stehen, können Mobilfunkantennen an vorhandenen Schornsteinen angebracht werden.“"
                            },
                            {
                                "example_id": "386598c7-dab8-4d5e-9245-a593b5f33331",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Bund und Länder wollen es zudem zulassen, dass Windenergieanlagen grundsätzlich auch mit Mobilfunkantennen versehen werden können.“"
                            },
                            {
                                "example_id": "4ad44fc3-c6cc-4c63-bbab-6fd3d3ca5381",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Mobilfunkantennen können auch an sehr ungewöhnlichen Standorten installiert werden. In den USA ist die Montage von Mobilfunkantennen an künstlichen Bäumen weit verbreitet.“"
                            },
                            {
                                "example_id": "3c676077-eb46-498c-b71d-e62e3a8e511d",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Manchmal müssen aber Mobilfunkantennen aus Gründen des Denkmalschutzes oder der Ästhetik verkleidet werden.“"
                            },
                            {
                                "example_id": "a9ada722-f343-4d6a-bdb9-59a9df3a4b9b",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Das Mobiltelefon kann das empfangene UMTS-Mobilfunksignal der nächsten Mobilfunkantenne über die Codierung (CDM) herausfiltern.“"
                            },
                            {
                                "example_id": "ebd478a3-fd20-4e02-a228-402d01afff7b",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Zwei Mobilfunkantennen strahlen leicht geneigt in ein Tal und kommunizieren mit Handys in der Umgebung.“"
                            },
                            {
                                "example_id": "e5d3d752-ea66-47b2-9b3a-962c3878c37d",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Mit seinem Kollegen kontrolliert er Mobilfunkantennen, bei denen es ein Problem gibt.“"
                            },
                            {
                                "example_id": "7b09527f-18b6-4891-9cf6-f11221d9629d",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„«Die höchste Strahlenbelastung kommt nicht von den Mobilfunkantennen, sondern vom eigenen Handy» sagt Gregor Dürrenberger von der Forschungsstiftung Mobilkommunikation.“"
                            },
                            {
                                "example_id": "d3b58524-a3ac-4c81-b387-9db3238c347d",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Die Bevölkerung in der Schweiz ist moderat von Strahlung belastet, die beispielsweise von Mobilfunkantennen, Handys und Stromleitungen ausgeht.“"
                            },
                            {
                                "example_id": "06dff15d-6f59-415b-8dc1-e558799a5c38",
                                "sense_id": "c025cc2e-be80-3d66-9277-6ab9618cc7ba",
                                "text": "„Die Behörden können so über einzelne Mobilfunkantennen Warn-SMS absetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
