                ],
                "senses": [
                    {
                        "sense_id": "20d871be-75d4-38fc-966e-c9de3b4305f1",
                        "entry_id": "ece133a5-c397-3d29-b123-5b4aac2a9dc0",
                        "glosses": [
                            "To extend, send or spread out from a center like radii."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43b51f29-759d-4aa5-9089-68ce75c641b6",
                                "sense_id": "20d871be-75d4-38fc-966e-c9de3b4305f1",
                                "text": "Crewe North Motive Power Depot is to be modernised completely. This includes the provision of a new coaling plant, ash handling plant, and two new locomotive sheds of the latest roundhouse type, each with 32 roads radiating from a 70-ft. dia. turntable."
                            },
                            {
                                "example_id": "174ba2e2-7f71-449d-b648-557a3dce68ca",
                                "sense_id": "20d871be-75d4-38fc-966e-c9de3b4305f1",
                                "text": "Oban is not a terminus; its routes radiate by sea, rail and road."
                            },
                            {
                                "example_id": "5a5e29ec-9175-4e81-9762-951b51cecf4f",
                                "sense_id": "20d871be-75d4-38fc-966e-c9de3b4305f1",
                                "text": "Doncaster is a rail hub in every sense. Passenger lines radiate in six directions, there are freight lines that bypass the station, extensive freight yards, a major works, and a rolling stock depot."
                            }
                        ]
                    },
                    {
                        "sense_id": "2adb681a-8d34-36f4-9214-5957adcfca87",
                        "entry_id": "ece133a5-c397-3d29-b123-5b4aac2a9dc0",
                        "glosses": [
                            "To emit rays or waves."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8a36e993-e416-493e-9ef0-e7c6c86bf2ad",
                                "sense_id": "2adb681a-8d34-36f4-9214-5957adcfca87",
                                "text": "The stove radiates heat."
                            }
                        ]
                    },
                    {
                        "sense_id": "ded47df2-7489-386e-91f4-40966b71b729",
                        "entry_id": "ece133a5-c397-3d29-b123-5b4aac2a9dc0",
                        "glosses": [
                            "To come out or proceed in rays or waves."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "530b847f-7c2d-4ae4-9295-fd5a1e5477b0",
                                "sense_id": "ded47df2-7489-386e-91f4-40966b71b729",
                                "text": "The heat radiates from a stove."
                            },
                            {
                                "example_id": "644fc610-f2ba-4a02-8d3c-66fa916cb79c",
                                "sense_id": "ded47df2-7489-386e-91f4-40966b71b729",
                                "text": "Light radiates from luminous bodies directly to our eyes."
                            },
                            {
                                "example_id": "e8f7aaa7-e3f3-4d43-b9fe-82f6eb7774dd",
                                "sense_id": "ded47df2-7489-386e-91f4-40966b71b729",
                                "text": "She raised her head, and carefully opened her eyes again, staring directly into the orange glow radiating through the thick glass."
                            }
                        ]
                    },
                    {
                        "sense_id": "65ab0936-eecf-3733-9d42-396dbe0f0ab9",
                        "entry_id": "ece133a5-c397-3d29-b123-5b4aac2a9dc0",
                        "glosses": [
                            "To illuminate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c2151422-5f5f-384a-ad34-cfd3264c9e7c",
                        "entry_id": "ece133a5-c397-3d29-b123-5b4aac2a9dc0",
                        "glosses": [
                            "To expose to ionizing radiation, such as by radiography."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a941b9c2-cf2f-3b4a-a2aa-e06c31a22573",
                        "entry_id": "ece133a5-c397-3d29-b123-5b4aac2a9dc0",
                        "glosses": [
                            "To manifest oneself in a glowing manner."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "36a5cb69-f47e-4c0f-b1cc-68b7f78c61bb",
                                "sense_id": "a941b9c2-cf2f-3b4a-a2aa-e06c31a22573",
                                "text": "Slim, sensual Richard Hell radiates a commanding coolness."
                            }
                        ]
                    },
                    {
                        "sense_id": "e65b4c18-9910-31b5-94ea-1c1bfcb325be",
                        "entry_id": "ece133a5-c397-3d29-b123-5b4aac2a9dc0",
                        "glosses": [
                            "To spread into new habitats, migrate."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2a1d6de7-1cf6-37f6-bff2-85d7bfb49c06",
                        "entry_id": "ece133a5-c397-3d29-b123-5b4aac2a9dc0",
                        "glosses": [
                            "To broadcast by radio."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5ca01bd8-2345-47a7-9f6b-329a9b2f3b05",
                                "sense_id": "2a1d6de7-1cf6-37f6-bff2-85d7bfb49c06",
                                "text": "Programmes marked thus will be radiated by Droitwich, but not by London and North National transmitters."
                            }
                        ]
                    }
