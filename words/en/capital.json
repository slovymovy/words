                            {
                                "target_lang_word": "отли́чно",
                                "target_lang_sense_clarification": "выражение одобрения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "harika",
                                "target_lang_sense_clarification": "beğeni ifadesi"
                            },
                            {
                                "target_lang_word": "şahane",
                                "target_lang_sense_clarification": "beğeni ifadesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "太好了",
                                "target_lang_sense_clarification": "感叹词"
                            },
                            {
