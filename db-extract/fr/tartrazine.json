                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "98fb101b-af55-3981-91bb-f9f6703df29d",
                        "entry_id": "f375a5dc-ce3f-3528-91cd-fea6167534bc",
                        "glosses": [
                            "Composé chimique de formule brute C₁₆H₉N₄Na₃O₉S₂, utilisé comme colorant alimentaire jaune, et aussi pour teinter la laine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f9488da-fe7b-4bb8-8e24-7839f3c65906",
                                "sense_id": "98fb101b-af55-3981-91bb-f9f6703df29d",
                                "text": "Du moins jusqu’à aujourd’hui : des chercheurs ont réussi à rendre transparente la peau de souris en les badigeonnant d’un simple colorant alimentaire, la tartrazine, couramment utilisé par l’industrie pour doter des sodas ou des chips d’une belle teinte rouge orangée."
                            }
                        ]
                    }
                ],
