                        "examples": [
                            {
                                "example_id": "3e37423c-320e-4311-b720-5de03d859bf5",
                                "sense_id": "9474ca4c-0c87-3c33-be3a-47d4156f72e2",
                                "text": "Чувствуя себя в их власти, Багратион решительно, обеими руками, взял блюдо и сердито, укоризненно посмотрел на графа, подносившего его."
                            },
                            {
                                "example_id": "63f5bb4c-2332-453d-b603-3caa4e89eb01",
                                "sense_id": "9474ca4c-0c87-3c33-be3a-47d4156f72e2",
                                "text": "Отец с серьёзной грустью укоризненно качал головой, не в состоянии понять, что делается в душе мальчика."
                            }
                        ]
                    }
