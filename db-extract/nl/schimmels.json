                    {
                        "translation_id": "5130d1ae-3439-4031-94b3-e29b8e165805",
                        "source_entry_id": "734453b1-8d8d-3236-824b-11f68d92a5d6",
                        "source_sense_id": "9c6f1dad-8f04-3ae9-a7e0-6de952ce3cc7",
                        "source_sense_description": "rijk binnen de eukaryoten, Fungi",
                        "target_lang_word": "Pilz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pilz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                        "entry_id": "dec5bbcb-d28f-3a28-8468-ce47a41d388c",
                                        "glosses": [
                                            "aus schlauchförmigen Fäden bestehender Organismus ohne Blattgrün (Reich Fungi); hat sowohl tierische als auch pflanzliche Eigenschaften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63093977-72e8-4475-ae1a-747e1c5d1fd8",
                                                "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                                "text": "„Seit unsere sich Welt zunehmend vernetzt, verbreiten sich auch vermehrt Pilze rund um den Globus.“"
                                            },
                                            {
                                                "example_id": "de40aff0-dce5-4a34-a267-c0d66e1d110e",
                                                "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                                "text": "Das größte Lebewesen der Welt ist ein Pilz."
                                            },
                                            {
                                                "example_id": "23f15fa2-1248-40ba-b948-d6ba34a5d6e5",
                                                "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                                "text": "„Pilze sind“ […] „heterotroph, das heißt, sie nutzen ebenso wie Tiere fremde Biomasse als Nahrungsquelle.“"
                                            },
                                            {
                                                "example_id": "be407a97-eb5a-4985-8539-c84c0b6d7bea",
                                                "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                                "text": "„Ohne Pilze würden sich tote Pflanzen, Pilzfruchtkörper und Tierkadaver häufen und die meisten Bäume hätten es schwer, an essentielle Nährstoffe zu kommen.“"
                                            },
                                            {
                                                "example_id": "0a43c10c-1862-4343-8610-7ea9f01e929f",
                                                "sense_id": "13f10859-3ee6-3be3-99be-8462c8437c57",
                                                "text": "„Einige Pilze können sich auch ungeschlechtlich fortpflanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aaaef406-7d2f-303c-a80b-d225cb056aa4",
                                        "entry_id": "dec5bbcb-d28f-3a28-8468-ce47a41d388c",
                                        "glosses": [
                                            "oberirdisch wachsendes Teil eines Pilzes^([1]) aus fleischigem Stiel und Hut"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0a152d-4be7-45d8-9b67-7bef82c92eb2",
                                                "sense_id": "aaaef406-7d2f-303c-a80b-d225cb056aa4",
                                                "text": "Wir sammeln Pilze."
                                            },
                                            {
                                                "example_id": "f79abfad-04f6-4101-986d-30c51ffb16ce",
                                                "sense_id": "aaaef406-7d2f-303c-a80b-d225cb056aa4",
                                                "text": "„Bald fand ich Himbeeren, Walderdbeeren und auch Pilze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f5539daa-e6ee-3f93-a12a-ea613b2546e6",
                                        "entry_id": "dec5bbcb-d28f-3a28-8468-ce47a41d388c",
                                        "glosses": [
                                            "halluzinogene Pilze"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8728dca8-fe71-4a18-b732-6a25c221527d",
                                                "sense_id": "f5539daa-e6ee-3f93-a12a-ea613b2546e6",
                                                "text": "„Pilze spielen in der Rauschgiftstatistik keine Rolle.“"
                                            },
                                            {
                                                "example_id": "65a02979-0f60-46b6-8dda-eec0b81d9491",
                                                "sense_id": "f5539daa-e6ee-3f93-a12a-ea613b2546e6",
                                                "text": "„Dort, wo bewußtseinserweiternde Pilze heimisch sind, läßt sich ihr Gebrauch nur schwer verbieten, und so werden auch in der westlichen Gesellschaft heimlich Pilzrituale abgehalten, bei denen oftmals schon mit dem gebotenen Respekt an den Pilz und seine Geister herangegangen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pilz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3e3be80-5e1b-30e3-80a4-1e9dd12557fc",
                                        "entry_id": "f4ab7405-e6dc-37db-8876-d01ea56f491e",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8dabe3-913e-41a1-9fa2-7fff846c5d75",
                                                "sense_id": "d3e3be80-5e1b-30e3-80a4-1e9dd12557fc",
                                                "text": "Morgen habe ich einen Termin bei meiner Zahnärztin Frau Dr. Pilz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "574fcd7d-828f-40dc-bb2b-3cc37555fc4c",
                        "source_entry_id": "734453b1-8d8d-3236-824b-11f68d92a5d6",
