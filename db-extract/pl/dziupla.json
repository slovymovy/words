                    {
                        "sense_id": "df7c2d30-625d-31c7-a1ad-6f0014b63b30",
                        "entry_id": "032b00b8-93f4-3be4-8a8a-b590cf426381",
                        "glosses": [
                            "otwór, pusta komora wewnątrz pnia lub gałęzi drzewa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15b83f2-2592-41b8-ada0-26c3af9eadf2",
                                "sense_id": "df7c2d30-625d-31c7-a1ad-6f0014b63b30",
                                "text": "U góry w dębie spróchniałym widać było dziuplę ogromną […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8e5cc95b-4c50-3e3c-90d4-3106e8a0eb37",
                        "entry_id": "032b00b8-93f4-3be4-8a8a-b590cf426381",
                        "glosses": [
                            "gniazdo ptaków, ssaków lub owadów znajdujące się w dziupli (1.1)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "a670f8df-2fe0-3113-87ad-2a76842aa4d5",
                        "entry_id": "032b00b8-93f4-3be4-8a8a-b590cf426381",
                        "glosses": [
                            "niewielkie, ciasne pomieszczenie"
                        ],
                        "tags": [
                            "colloquial",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "0e6cbb80-49ca-40bb-963c-7cbbe0b40442",
                                "sense_id": "a670f8df-2fe0-3113-87ad-2a76842aa4d5",
                                "text": "Ten jego niby gabinet to taka dziupla na końcu korytarza."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "cfe88fe8-f5d7-3f3e-8b0b-f3ddfea43b71",
                        "entry_id": "032b00b8-93f4-3be4-8a8a-b590cf426381",
                        "glosses": [
                            "miejsce, w którym dokonuje się demontażu skradzionych pojazdów w celu sprzedania ich w częściach"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "66dc7f8a-e260-463e-b1ec-bdaf86cbd525",
                                "sense_id": "cfe88fe8-f5d7-3f3e-8b0b-f3ddfea43b71",
                                "text": "Nie ma szans na odzyskanie tego samochodu; pewnie już dawno trafił do dziupli."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
