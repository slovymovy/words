                    {
                        "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                        "entry_id": "95efa20e-f2c8-3f60-abad-bd41ec4e7557",
                        "glosses": [
                            "apology (expression of regret)"
                        ],
                        "tags": [
                            "countable",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "7bddf1d2-d9c9-4d12-bb64-02ff60097f1c",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "Near-synonyms: jednanie, przejednanie, załagodzenie"
                            },
                            {
                                "example_id": "3762bf16-1d88-49c6-8096-bd05fb30765a",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "nie słuchać przeproszeń",
                                "translation": "to not listen to apologies",
                                "english": "to not listen to apologies"
                            },
                            {
                                "example_id": "40aa03da-8034-4a9d-8aab-f095420f8bff",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "nie zważać na przeproszenia",
                                "translation": "to not pay attention to apologies",
                                "english": "to not pay attention to apologies"
                            },
                            {
                                "example_id": "3d5a0f0e-5a3e-4dcb-9d1c-e22b730fc433",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "nakazać przeproszenie",
                                "translation": "to order/command an apology",
                                "english": "to order/command an apology"
                            },
                            {
                                "example_id": "ab71fa73-050e-45e9-87a7-3ee199ea534c",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "odmówić przeproszenia",
                                "translation": "to deny an apology",
                                "english": "to deny an apology"
                            },
                            {
                                "example_id": "fb668300-1b3f-4613-99ee-c7cfe4765a70",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "pisemne przeproszenie",
                                "translation": "written apology",
                                "english": "written apology"
                            },
                            {
                                "example_id": "c38e53b4-6cf0-4dfc-8b82-5ad297bbd615",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "publiczne przeproszenie",
                                "translation": "public apology",
                                "english": "public apology"
                            },
                            {
                                "example_id": "df4a9318-fec4-43d5-af4e-9e392ec3ac5b",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "żądać przeproszenia",
                                "translation": "to demand an apology",
                                "english": "to demand an apology"
                            },
                            {
                                "example_id": "2c7c300a-b6be-425d-8a89-e6a9ca3d1b49",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "Posypały się przeproszenia.",
                                "translation": "Apologies are abound.",
                                "english": "Apologies are abound."
                            },
                            {
                                "example_id": "a9a3d7dd-c188-4174-af4d-4404ccae7041",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "Ale iż byli pyszni, nie chcieli pisać z przeproszeniem do Ojca, który płakał po nich.",
                                "translation": "But because they were proud, they did not want to write with an apology to their Father, who was crying after them.",
                                "english": "But because they were proud, they did not want to write with an apology to their Father, who was crying after them."
                            },
                            {
                                "example_id": "af4f412f-9fda-45ce-8d93-0eb3c4f9a96f",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "Wobec tych awantur biesiadnych przyjemnie uderzają[,] jako objawy wyższej obyczajności towarzyskiej[,] przeproszenia, w których winowajcy proszą o przebaczenie osoby, obrażone przez nich podczas bankietu.",
                                "translation": "In the face of these banquet brawls, apologies, in which the offenders ask forgiveness from those they have offended during the banquet, strike one, as a sign of higher social decency.",
                                "english": "In the face of these banquet brawls, apologies, in which the offenders ask forgiveness from those they have offended during the banquet, strike one, as a sign of higher social decency."
                            },
                            {
                                "example_id": "32df933f-0f97-4792-a84e-339cb35e162d",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "Powiedz temu panu, że nie życzę sobie z nim rozmawiać i nie potrzebuję jego przeproszeń.",
                                "translation": "Tell that gentleman, that I do not wish to speak with him and do not require his apologies.",
                                "english": "Tell that gentleman, that I do not wish to speak with him and do not require his apologies."
                            },
                            {
                                "example_id": "6612dc73-18f4-4d5e-860c-308366bf8d06",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "— Przykro mi, że to… zdarzyło się tutaj, wszakże wśród ludzi honoru za policzek nie płaci się zwykłym przeproszeniem. Żądam satysfakcji z bronią w ręku.",
                                "translation": "— I am sorry, that this… happened here, but among people of honour a slap in the face is not paid for with a simple apology. I demand satisfaction with weapons in hand.",
                                "english": "— I am sorry, that this… happened here, but among people of honour a slap in the face is not paid for with a simple apology. I demand satisfaction with weapons in hand."
                            },
                            {
                                "example_id": "31b11c48-d265-4660-96a3-0765cd02bfa0",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "Udał, że nie dostrzegł jej pomieszania, ale począwszy od tej chwili kilka razy dziennie, ilekroć okoliczności usprawiedliwiały takie zbliżenie lub wykluczały możliwość pomówienia go o natarczywość i celowe uchybianie regułom zachowań, wykorzystywał swą fizyczną nieporadność, by mimochodem dotknąć jej ciała, i — mamrocząc za każdym razem grzecznościowe formuły przeproszeń — raz po raz wprawiał ją w ponowne zakłopotanie.",
                                "translation": "He pretended, that he did not notice her confusion, but from that moment on several times a day, whenever circumstances justified such closeness or ruled out the possibility of accusing him of insistence and deliberate violation of the rules of conduct, he used his physical clumsiness, to casually touch her body, and — muttering polite apologies each time — repeatedly embarrassed her again.",
                                "english": "He pretended, that he did not notice her confusion, but from that moment on several times a day, whenever circumstances justified such closeness or ruled out the possibility of accusing him of insistence and deliberate violation of the rules of conduct, he used his physical clumsiness, to casually touch her body, and — muttering polite apologies each time — repeatedly embarrassed her again."
                            },
                            {
                                "example_id": "c74891ef-d086-441b-ae13-9bf5f697dd28",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "Dawniej Dorota wiedziała, że wystarczy wybąkać przeproszenie, a matka stopnieje jak marcowy lód, że wystarczy jakiekolwiek tłumaczenie, żeby uwierzyła, dzisiejszego pancerza nie przebijesz żadnym sposobem.",
                                "translation": "Dorota knew in the past, that all she had to do was mumble an apology, and her mother would melt like March ice, that any explanation would suffice, for her to believe her, but today's armour cannot be pierced by any means.",
                                "english": "Dorota knew in the past, that all she had to do was mumble an apology, and her mother would melt like March ice, that any explanation would suffice, for her to believe her, but today's armour cannot be pierced by any means."
                            },
                            {
                                "example_id": "5ad42862-51ad-4d03-b8e9-7d78b0254433",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "Po paru godzinach rokowań niemiecki generał dowodzący wojskami na tamtym terenie przysłał oficjalne przeproszenie i prośbę o pozwolenie wycofania się.",
                                "translation": "After several hours of negotiations the German general commanding the troops in that area sent an official apology and a request for permission to withdraw.",
                                "english": "After several hours of negotiations the German general commanding the troops in that area sent an official apology and a request for permission to withdraw."
                            },
                            {
                                "example_id": "03e52ffe-d9b4-49f4-8a7f-39ed45e6a371",
                                "sense_id": "8d1fd6d1-e566-318d-845b-9725308df4a5",
                                "text": "W normalnych warunkach byłaby to sprawa sądowa, przeproszenia w gazetach codziennych i wyjaśnienia w czasopismach naukowych, przedmiot dyskusji i plotek na międzynarodowych zjazdach.",
                                "translation": "Under normal circumstances this would be a court case, with apologies in daily newspapers and explanations in scientific journals, the subject of discussion and gossips at international conferences.",
                                "english": "Under normal circumstances this would be a court case, with apologies in daily newspapers and explanations in scientific journals, the subject of discussion and gossips at international conferences."
                            }
                        ]
                    }
                ],
