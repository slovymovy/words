                                        "examples": [
                                            {
                                                "example_id": "0ab8fe53-54e3-4c50-8fe0-17b62f84242b",
                                                "sense_id": "fdedfa75-8489-3526-aeb2-b3d6b7def069",
                                                "text": "Rickert was the first woman (and second individual) to be awarded a Ph.D. in English letters and philology with that academic honor at the University of Chicago."
                                            }
