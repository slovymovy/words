                        "source_sense_id": "90d1485b-e441-3dc5-be50-4f2fc0dab1c4",
                        "source_sense_description": "een klier die speeksel produceert en naar de mondholte afscheidt",
                        "target_lang_word": "Speicheldrüse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speicheldrüse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55b82bc9-fbb3-3347-8bb2-c5c7580f5502",
                                        "entry_id": "93e7ed5a-ad56-3b5f-89b0-589b1172783a",
                                        "glosses": [
                                            "Drüse im Mund oder am Ohr, die Speichel bildet und absondert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d8cf10-b81a-494a-87f0-06ed53725f21",
                                                "sense_id": "55b82bc9-fbb3-3347-8bb2-c5c7580f5502",
                                                "text": "Die Speicheldrüsen sind für die Produktion von rund 90% des menschlichen Speichels verantwortlich. Es existierten drei Speicheldrüsenpaare."
                                            },
                                            {
                                                "example_id": "244589f9-e0f9-4765-8cbc-fe9451b36b45",
                                                "sense_id": "55b82bc9-fbb3-3347-8bb2-c5c7580f5502",
                                                "text": "„Sie spuckten den Kaugummi aber bald wieder aus, er strengte die Speicheldrüsen zu sehr an.“"
                                            },
                                            {
                                                "example_id": "8bbc6157-9a40-4575-8ec7-d59f1595c75d",
                                                "sense_id": "55b82bc9-fbb3-3347-8bb2-c5c7580f5502",
                                                "text": "„Sein Mitteilungsbedürfnis befeuchtete seine Kehle, aktivierte seine Speicheldrüsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
