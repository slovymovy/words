                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d7dd28-abfb-48e4-9695-8b57f060f0f2",
                                                "sense_id": "54a0e9e0-6100-3e70-8702-27be98cdf8cc",
                                                "text": "De ondernemer had het moeilijk door de collusie van zijn concurrenten."
                                            }
