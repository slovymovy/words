                ],
                "senses": [
                    {
                        "sense_id": "0f99f540-decd-375b-8c7b-4c50b219d928",
                        "entry_id": "dfb24623-8c73-3feb-a75f-516379fb9adc",
                        "glosses": [
                            "To establish again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e9679586-5644-40f3-9e99-06496d798470",
                                "sense_id": "0f99f540-decd-375b-8c7b-4c50b219d928",
                                "text": "Zionism is a religious and political movement that brought Jews to their ancient homeland and reestablished Israel as the central location for Jewish identity."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5066abf-9400-3ff4-81a2-75c66ce01ce9",
                        "entry_id": "dfb24623-8c73-3feb-a75f-516379fb9adc",
                        "glosses": [
                            "To restore to a previously operational state."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ab0bf60c-6620-4b34-93ff-870b9daef9b1",
                                "sense_id": "d5066abf-9400-3ff4-81a2-75c66ce01ce9",
                                "text": "NASA has reestablished contact with its interstellar spacecraft Voyager 2 after an incorrect command pointed the spacecraft away from Earth, cutting off data for about two weeks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bab53aa8-dbc1-4dc0-a47b-63649b5727cc",
                        "source_entry_id": "dfb24623-8c73-3feb-a75f-516379fb9adc",
                        "source_sense_description": "establish again",
                        "target_lang_word": "rétablir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétablir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "690f1d7c-14a8-34b9-a48b-d2edda293b97",
                                        "entry_id": "32a70f44-2d37-33cd-a3dc-d31352789c1b",
                                        "glosses": [
                                            "Remettre une personne ou une chose en son état antérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b0c172-62e4-4524-99e8-1cc62f707002",
                                                "sense_id": "690f1d7c-14a8-34b9-a48b-d2edda293b97",
                                                "text": "Rétablir un homme dans son emploi, dans tous ses droits."
                                            },
                                            {
                                                "example_id": "6e5cfc59-62b8-4778-952f-ef58443ff2c1",
                                                "sense_id": "690f1d7c-14a8-34b9-a48b-d2edda293b97",
                                                "text": "Le Concile de Trente a rétabli la discipline de l’Église."
                                            },
                                            {
                                                "example_id": "b56ea46c-43f1-46bd-83e3-07423c1d9af7",
                                                "sense_id": "690f1d7c-14a8-34b9-a48b-d2edda293b97",
                                                "text": "Rétablir un passage d’un auteur, Le restituer, le remettre dans l’état où il était avant d’avoir été altéré par les copistes."
                                            },
                                            {
                                                "example_id": "dffa6103-04d8-49d8-a6af-ecfa096bb9d0",
                                                "sense_id": "690f1d7c-14a8-34b9-a48b-d2edda293b97",
                                                "text": "Ce philologue a rétabli beaucoup de passages des auteurs anciens."
                                            },
                                            {
                                                "example_id": "d5a60fdb-a0b2-42d1-9856-7858500fccb2",
                                                "sense_id": "690f1d7c-14a8-34b9-a48b-d2edda293b97",
                                                "text": "Rétablir des faits, Les présenter sous leur jour véritable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec658cab-5794-398f-ad23-5905c32eaebf",
                                        "entry_id": "32a70f44-2d37-33cd-a3dc-d31352789c1b",
                                        "glosses": [
                                            "Remettre en vigueur ; faire exister de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66ac3c19-1b5b-4c3e-beb1-f32be2817979",
                                                "sense_id": "ec658cab-5794-398f-ad23-5905c32eaebf",
                                                "text": "L'Islande a son parti de Home Rulers qui veulent affranchir leur pays de la tutelle du Danemark et rétablir l'ancienne république islandaise."
                                            },
                                            {
                                                "example_id": "4d07e567-f65c-498f-bc51-b78b05d734e4",
                                                "sense_id": "ec658cab-5794-398f-ad23-5905c32eaebf",
                                                "text": "En 1096, le pape Urbain II vint à Carcassonne pour rétablir la paix entre Bernard Aton et les bourgeois qui s’étaient révoltés contre lui et il bénit l’église cathédrale (Saint-Nazaire),[…]."
                                            },
                                            {
                                                "example_id": "73ea83ac-16ba-45d2-9fe2-c75e7124061f",
                                                "sense_id": "ec658cab-5794-398f-ad23-5905c32eaebf",
                                                "text": "Admettre cette préséance, c’est léser l’esprit républicain, porter atteinte aux principes de 89, faire fi des sacrifices consentis par les révolutionnaires de 1830 à 1871, c’est accepter de voir rétablir les iniquités qu’ils ont combattues au prix de leur sang !"
                                            },
                                            {
                                                "example_id": "42664676-8ff8-41f2-8907-cb0c2fcd2ad8",
                                                "sense_id": "ec658cab-5794-398f-ad23-5905c32eaebf",
                                                "text": "[…]; les taxes impopulaires, abolies en juin 1908 en don de joyeux avènement, avaient été rétablies et considérablement renforcées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f048f967-72d9-3d60-8a75-3018d532bcb0",
                                        "entry_id": "32a70f44-2d37-33cd-a3dc-d31352789c1b",
                                        "glosses": [
                                            "Remettre en bon état ou en meilleur état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ae31077-d629-42dd-9752-b36f7bc45cab",
                                                "sense_id": "f048f967-72d9-3d60-8a75-3018d532bcb0",
                                                "text": "Il a rétabli ses forces. Il a bien rétabli ses affaires, son crédit, son commerce, sa réputation, son honneur."
                                            },
                                            {
                                                "example_id": "ac01993c-ad14-41bc-ae4d-ba11d621e2a6",
                                                "sense_id": "f048f967-72d9-3d60-8a75-3018d532bcb0",
                                                "text": "On rétablit le commerce par cette mesure. — Il est parvenu à se rétablir dans l’esprit de ses chefs. — La confiance commence à se rétablir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c731486b-c3ea-3c6c-b1dd-93ba92db8d0f",
                                        "entry_id": "32a70f44-2d37-33cd-a3dc-d31352789c1b",
                                        "glosses": [
                                            "Remettre dans une situation de stabilité."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79010762-2e5f-4ff6-8c81-d81791330637",
                                                "sense_id": "c731486b-c3ea-3c6c-b1dd-93ba92db8d0f",
                                                "text": "La deudeuche fit une embardée, partit brouter quelques mètres de sillon du champ labouré, se cabra, se rétablit en grognant de toute la puissance chevrotante de son moteur, reprit enfin sa danse sur le chemin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "581dad73-9b3a-3bd1-8be3-1ba8ce236990",
                                        "entry_id": "32a70f44-2d37-33cd-a3dc-d31352789c1b",
                                        "glosses": [
                                            "Recouvrer la santé."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc4a614c-6ab7-45df-8d59-10ba0c1d03ea",
                                                "sense_id": "581dad73-9b3a-3bd1-8be3-1ba8ce236990",
                                                "text": "Le vieux von Winterfeld entra bientôt dans le coma ; parmi les blessés, trois se rétablissaient assez rapidement, alors que l’état des autres empirait, par suite du manque de bonne nourriture."
                                            },
                                            {
                                                "example_id": "e50af0d9-bc72-4bfb-903a-06a8245941ab",
                                                "sense_id": "581dad73-9b3a-3bd1-8be3-1ba8ce236990",
                                                "text": "Il en arrivait à négliger Geneviève qui se rétablissait lentement des suites de son opération […]."
                                            },
                                            {
                                                "example_id": "e835387d-d19a-440d-a0cc-f88a7a952536",
                                                "sense_id": "581dad73-9b3a-3bd1-8be3-1ba8ce236990",
                                                "text": "Depuis ce moment, je fus traité avec un intérêt et des attentions infinis; j’eus cependant beaucoup de peine à me rétablir, et l’on dut me transporter à une annexe de l’hospice, dans l’intérieur de l'île, au quartier de Flic-en—Flac, pour y achever ma longue convalescence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
