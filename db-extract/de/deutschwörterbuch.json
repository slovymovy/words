                ],
                "senses": [
                    {
                        "sense_id": "ec10eead-d699-36c9-bee4-3937753d26e7",
                        "entry_id": "32bfc713-d1a3-3448-a996-64841f2ef165",
                        "glosses": [
                            "Nachschlagewerk für den Wortschatz der deutschen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32fda388-f660-4cb6-8bb6-2c700335ccfd",
                                "sense_id": "ec10eead-d699-36c9-bee4-3937753d26e7",
                                "text": "„Ich vergaß jedoch, meine deutschen Bücher mitzubringen, ein Deutschwörterbuch mitzubringen, aber ich komme auch so ziemlich gut zurecht.“"
                            },
                            {
                                "example_id": "51b211c7-a721-4a74-9c0e-c8ab4b3c7887",
                                "sense_id": "ec10eead-d699-36c9-bee4-3937753d26e7",
                                "text": "„Geben Sie drei Beispiele für die Polysemie der -ung-Derivate, indem Sie ihre lexikographische Bearbeitung in deutsch-tschechischen und einsprachigen Deutschwörterbüchern vergleichen.“"
                            },
                            {
                                "example_id": "11afc907-6b98-4878-9782-5efd0cc2869f",
                                "sense_id": "ec10eead-d699-36c9-bee4-3937753d26e7",
                                "text": "„Da meine Deutschnoten nach wie vor perfekt waren, wusste ich, dass ich meinen Antrag auf ein Praktikum mit Hilfe meines Deutschwörterbuchs formulieren konnte […].“"
                            },
                            {
                                "example_id": "f6f9d44f-ed32-4e44-807a-e545cbda595c",
                                "sense_id": "ec10eead-d699-36c9-bee4-3937753d26e7",
                                "text": "„Ich wäre jetzt in euren Buchladen gekommen und hätte nach einem Deutschwörterbuch gefragt.“"
                            },
                            {
                                "example_id": "693511c0-b26f-48ed-8098-eaaa6efaa6b8",
                                "sense_id": "ec10eead-d699-36c9-bee4-3937753d26e7",
                                "text": "„Als Stichwörter sind »Hybris« und »hybrid« weder im ersten bedeutenden Deutschwörterbuch (1793-1801) von Johann Christoph Adelung noch im 16-bändigen »Deutschen Wörterbuch« (1852 ff.) der Gebrüder Grimm indexiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
