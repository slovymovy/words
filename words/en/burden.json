                            "text": "In this ballad, the <w>burden</w> is repeated after every stanza.",
                            "target_lang_translations": {
                                "ru": "В этой балладе <w>рефрен</w> повторяется после каждой строфы.",
                                "zh": "在这首民谣中，<w>叠句</w>在每一节后都会重复。"
                            }
                        }
                    ],
                    "synonyms": [
                        "refrain",
                        "chorus"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "literary or musical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторяющаяся фраза, строка или тема в конце каждого куплета песни или стихотворения.",
                        "zh": "歌曲或诗歌中每节末尾反复出现的短语、诗行或主题。"
                    },
