                                "example_id": "d789b3b6-743c-4fec-ab48-c27d2e6d7e81",
                                "sense_id": "008aa49c-02a7-3ab2-af3d-84b80aa5204a",
                                "text": "En plus, il fallait, de temps en temps dé-protéiniser les lentilles avec un 2e produit."
                            },
                            {
                                "example_id": "a36ac67b-cc91-42cf-abc0-a2a75f174baf",
                                "sense_id": "008aa49c-02a7-3ab2-af3d-84b80aa5204a",
                                "text": "Elle consiste à désinfecter et dé-protéiniser les contenants, en supposant que le contenu est bactériologiquement stable"
