                        "source_entry_id": "1107e167-c401-3934-a77e-274bd779a5f3",
                        "source_sense_description": "not shod",
                        "target_lang_word": "barfuß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barfuß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67d440b7-5e87-3fd9-a0ed-e5f7ef969d26",
                                        "entry_id": "54f351d9-4c69-35b1-9764-0e19a3f2344c",
                                        "glosses": [
                                            "ohne Schuhe und Strümpfe, mit nackten Füßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e4806d9-7834-4699-95aa-4541b4b8cf98",
                                                "sense_id": "67d440b7-5e87-3fd9-a0ed-e5f7ef969d26",
                                                "text": "Barfuß laufen ist gesund."
                                            },
                                            {
                                                "example_id": "c64e32d5-672f-447d-9861-61c72eecd36c",
                                                "sense_id": "67d440b7-5e87-3fd9-a0ed-e5f7ef969d26",
                                                "text": "Die Kinder waren alle barfuß."
                                            },
                                            {
                                                "example_id": "6dcdbd1c-4499-4f1e-9ceb-94f6a1db1e27",
                                                "sense_id": "67d440b7-5e87-3fd9-a0ed-e5f7ef969d26",
                                                "text": "„Noch immer barfuß, beugte er sich weit aus dem Schlafzimmerfenster und sah Fabrizzio auf einem der Gartenstühle sitzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24a065f3-a0d6-4e55-b8cf-8920dee4701d",
                        "source_entry_id": "1107e167-c401-3934-a77e-274bd779a5f3",
                        "source_sense_description": "not shod",
                        "target_lang_word": "unbeschuht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbeschuht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17ff424c-05c0-31d7-8511-f34b9707aedf",
                                        "entry_id": "a752fc1a-3551-35ef-897f-0bb0665bf8b0",
                                        "glosses": [
                                            "kein Paar Schuhe tragend, ohne Schuhe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "621ea368-0b3d-4f97-bc31-134f6b515ebf",
                                                "sense_id": "17ff424c-05c0-31d7-8511-f34b9707aedf",
                                                "text": "„Dort hocken unbeschuhte Gäste unter orientalischen Bildern auf üppig gepolsterten Holzpodesten.“"
                                            },
                                            {
                                                "example_id": "11b6d9ef-fe61-446a-8212-f161fb970d24",
                                                "sense_id": "17ff424c-05c0-31d7-8511-f34b9707aedf",
                                                "text": "„So zog sie mit ihm auf schwerer Irrfahrt herum, schweifte unbeschuht und ohne Speise mit ihm durch die wilden Wälder; […].“"
                                            },
                                            {
                                                "example_id": "c4abb9d6-7e8e-4e25-979d-4b8a6a6b9476",
                                                "sense_id": "17ff424c-05c0-31d7-8511-f34b9707aedf",
                                                "text": "„Da hörte sie deutlich das »Trapp, trapp, trapp« unbeschuhter Füße aus dem anstoßenden Ankleidezimmer herauskommen und durch den Gang auf die Treppe zugehen.“"
                                            },
                                            {
                                                "example_id": "7314b58f-cd75-4222-8a7a-333c5c496020",
                                                "sense_id": "17ff424c-05c0-31d7-8511-f34b9707aedf",
                                                "text": "„Da näherte sich endlich ein langer Zug von Mönchen: beschuhte und unbeschuhte, weiße und schwarze, mit und ohne Bart, mit und ohne Kapuze – hinter ihnen der Scharfrichter, und endlich von Würdenträgern und Granden umgeben: vierzig Menschen, mit Tüchern ganz verdeckt, auf denen Flammen und Ungeheuer abgebildet waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
