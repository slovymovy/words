                "senses": [
                    {
                        "sense_id": "35e2a9a8-0ab5-3de8-90b5-52380b734e3f",
                        "entry_id": "64b8da64-8982-30e6-8f0c-523fb35dd5a3",
                        "glosses": [
                            "The action or process of rectifying."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "223e8707-1fd1-4663-9b5b-52d2871c6a29",
                                "sense_id": "35e2a9a8-0ab5-3de8-90b5-52380b734e3f",
                                "text": "[…] as after the rectification of his views, he was incapable of compromise with profounder shapes of error."
                            },
                            {
                                "example_id": "bdd046dc-dc00-4383-b6cf-9064dd29e440",
                                "sense_id": "35e2a9a8-0ab5-3de8-90b5-52380b734e3f",
                                "text": "the rectification of an error; the rectification of spirits"
                            },
                            {
                                "example_id": "68904168-1f1f-4af3-b04a-ce144e71a5df",
                                "sense_id": "35e2a9a8-0ab5-3de8-90b5-52380b734e3f",
                                "text": "Whereas delinquency correlates with treatment, psychotherapy, and correction, the category of the disorderly is more closely associated with a militaristic method of rectification."
                            }
                        ]
                    },
                    {
                        "sense_id": "4780c392-234d-3d50-bfb2-27100232b6c3",
