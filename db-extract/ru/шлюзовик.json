                    },
                    {
                        "translation_id": "59969400-23e3-4ceb-9ea1-c4b95a9e5149",
                        "source_entry_id": "41eb1245-933c-33e6-a4d8-b9eba408bded",
                        "source_sense_id": "970a3f24-cc50-3606-bd91-5440c0d79ba7",
                        "target_lang_word": "éclusier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclusier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8eece67b-1fb1-363d-a8c0-b85ad2cdf3ca",
                                        "entry_id": "7269827a-75a3-364b-94a9-e71464555724",
                                        "glosses": [
                                            "Relatif à une écluse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2432a25-1ec3-40cb-9f7d-a785466e754d",
                                                "sense_id": "8eece67b-1fb1-363d-a8c0-b85ad2cdf3ca",
                                                "text": "La dépense d’une maison éclusière ne doit pas excéder 2,500 à 3,000 francs : sur le canal du Centre, elle ne s’élève qu’à 2,000 fr.\nOn a l’habitude d’égaler le nombre des maisons éclusières à celui des écluses; cependant ces dernières sont souvent assez voisines pour qu’un seul éclusier puisse suffire à la manœuvre de plusieurs écluses."
                                            },
                                            {
                                                "example_id": "20995eb9-9e4d-4323-8bab-efc00066e30f",
                                                "sense_id": "8eece67b-1fb1-363d-a8c0-b85ad2cdf3ca",
                                                "text": "Et dans la solitude de sa maison éclusière perdue en pleine nature, il compose, s’interprète, s’enregistre et se diffuse à l’intention des bêtes de brousse et des hôtes de passage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éclusier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b476d45b-9ccd-3c4c-aac8-c4998527b4a4",
                                        "entry_id": "6025e1e3-5916-3bf1-82c9-b0e628d10ded",
                                        "glosses": [
                                            "Celui qui est chargé de manœuvrer une écluse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed068e5c-399e-40cb-9fa2-5d37132a475a",
                                                "sense_id": "b476d45b-9ccd-3c4c-aac8-c4998527b4a4",
                                                "text": "Comme un éclusier mesure le niveau de l’eau dans son bief, elle comparait les niveaux d’études."
                                            },
                                            {
                                                "example_id": "2fd7354b-c45e-4a3f-aa3c-fdf88a69321c",
                                                "sense_id": "b476d45b-9ccd-3c4c-aac8-c4998527b4a4",
                                                "text": "Pour une trentaine de sous, on achetait un lapin aux éclusiers et on le fricassait en chemin, sur un coupon garni de gazon et de pierres."
                                            },
                                            {
                                                "example_id": "dc0c916f-e25f-45f0-a79c-7db61539bf81",
                                                "sense_id": "b476d45b-9ccd-3c4c-aac8-c4998527b4a4",
                                                "text": "À la radio crachotante, on entend la voix de l’éclusier du port: « Monsieur, vous pouvez avancer doucement »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
