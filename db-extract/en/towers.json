                ],
                "senses": [
                    {
                        "sense_id": "8e937372-1441-36f5-a310-536c75875a05",
                        "entry_id": "d1893803-d939-3df4-82da-66397addf541",
                        "glosses": [
                            "A habitational surname."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a17fac0c-6cb5-3b23-bc53-8b63e9897862",
                        "entry_id": "d1893803-d939-3df4-82da-66397addf541",
                        "glosses": [
                            "[after a name, typically that of the speaker/writer or publication] the putative palatial address of the named person or corporate entity"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "f15dddec-5e75-48d3-a69e-a52b3854dcb8",
                                "sense_id": "a17fac0c-6cb5-3b23-bc53-8b63e9897862",
                                "text": "And aren't we all looking forward to the Signals episode on architecture featuring — well wouldn't you know it? — James Stirling, Richard Rogers and Norman Foster[...] Well, no, we're not exactly pencilling it in our diary here at Punch Towers. We are frankly getting rather tired of hearing about Messrs F, R and S."
                            },
                            {
                                "example_id": "ee559707-33c5-4663-adc5-7ea83bd55551",
                                "sense_id": "a17fac0c-6cb5-3b23-bc53-8b63e9897862",
                                "text": "There is currently serious work taking place on his [sc. Michael O'Leary's] 10,000sq ft Victorian mansion on Dublin's very smart Raglan Road."
                            },
                            {
                                "example_id": "5cf9339e-0813-4c04-b309-9f5f76df210c",
                                "sense_id": "a17fac0c-6cb5-3b23-bc53-8b63e9897862",
                                "text": "Harry had a flat in a small block in a pleasant tree-lined suburb about a mile from the hospital. ... He was waiting for her in his open doorway. 'Welcome to Harry Black Towers,' he said, bowing."
                            },
                            {
                                "example_id": "b1156fb8-bdfe-4ee5-96ea-94f7fcf02357",
                                "sense_id": "a17fac0c-6cb5-3b23-bc53-8b63e9897862",
                                "text": "Guardian Towers is being evacuated following a fire alarm... we’ll be back as soon as possible"
                            },
                            {
                                "example_id": "a8e4a5d9-04f8-464d-bbe8-d8d2fd6b842e",
                                "sense_id": "a17fac0c-6cb5-3b23-bc53-8b63e9897862",
                                "text": "Here at Smith Towers, we’ve been eating macadamia nuts since we stepped off the plane from Scotland"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7b98bd0-77f5-478a-b723-70894fb88129",
                        "source_entry_id": "d1893803-d939-3df4-82da-66397addf541",
                        "source_sense_description": "equivalent surnames",
                        "target_lang_word": "Tours",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tours",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85034cf6-d657-321c-81d2-2ec27f247e95",
                                        "entry_id": "d77fa521-7d01-3019-bb30-05552f0c77a0",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, situé dans le département d’Indre-et-Loire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f0db799-7214-4e10-a070-05f5135cfe16",
                                                "sense_id": "85034cf6-d657-321c-81d2-2ec27f247e95",
                                                "text": "En 1951, la ville de Tours poursuivait sa reconstruction, entreprise après l’incendie généré par un bombardement en juin 1940. C’est alors que fut découvert un temple construit au début du IIᵉ siècle de notre ère, dont les dimensions et la configuration architecturale en font, on le sait aujourd’hui, l’un des grands sanctuaires gallo-romains."
                                            },
                                            {
                                                "example_id": "3b565061-f824-492c-9673-bd4ec2333b89",
                                                "sense_id": "85034cf6-d657-321c-81d2-2ec27f247e95",
                                                "text": "Cependant le cheval noir ne cessait de piaffer et de s’agiter en hennissant ; son maître inquiet lui permit de partir au galop, et bientôt ils furent rendus dans la ville de Tours, que les clochers de Saint-Gatien annonçaient de loin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Tours",
