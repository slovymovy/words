                    "frequency": "Middle",
                    "semantic_group_id": "moral_critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a adopté un ton <w>moralisateur</w> qui a irrité tous les élèves de la classe."
