                                "sense_id": "6b586b0e-749e-3715-bfc4-fe818a9976cc",
                                "text": "Er erwachte beim ersten Hahnenschrei."
                            },
                            {
                                "example_id": "03a0e469-7bec-44a0-95a7-e486e474ad77",
                                "sense_id": "6b586b0e-749e-3715-bfc4-fe818a9976cc",
                                "text": "Der Hahnenschrei wird im Deutschen meist mit „kikeriki“ imitiert."
                            }
