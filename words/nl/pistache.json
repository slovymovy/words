                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pistache_vrucht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hou ervan om gezouten <w>pistaches</w> te eten als tussendoortje.",
                            "target_lang_translations": {
                                "en": "I love eating salted <w>pistachios</w> as a snack."
                            }
                        },
                        {
                            "text": "Zorg dat je de schaal van de <w>pistache</w> goed verwijdert voor het eten.",
                            "target_lang_translations": {
                                "en": "Make sure you remove the shell of the <w>pistachio</w> properly before eating."
                            }
                        }
                    ],
                    "synonyms": [
