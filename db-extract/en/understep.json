                                "sense_id": "dc69afae-2a47-3095-9529-e8a6ec1f2b52",
                                "text": "Escalator modernization including handrail speed monitors, Safe-T- Brakes, emergency stop relocation, understep lighting, reconditioning of steps and related improvements."
                            }
