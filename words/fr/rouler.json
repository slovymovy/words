                    "frequency": "Middle",
                    "semantic_group_id": "forme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à bien <w>rouler</w> le tapis avant de commencer les travaux de peinture."
                        },
                        {
                            "text": "Il <w>roule</w> soigneusement son sac de couchage pour le ranger dans son sac."
