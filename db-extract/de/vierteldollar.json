                "senses": [
                    {
                        "sense_id": "4695742a-5a80-3e29-973c-977c741ecb9a",
                        "entry_id": "207cb745-a0cc-3c7a-84bd-3bf81f777109",
                        "glosses": [
                            "ein Viertel eines Dollars"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f36c5b8-2ed9-4008-939e-7a09beecb78d",
                                "sense_id": "4695742a-5a80-3e29-973c-977c741ecb9a",
                                "text": "„Rant steigt ein und gibt mir einen Vierteldollar.“"
                            },
                            {
                                "example_id": "ca29b207-32da-417a-91c0-3a9435172113",
                                "sense_id": "4695742a-5a80-3e29-973c-977c741ecb9a",
                                "text": "„›Hat jemand einen Vierteldollar?‹ bellt Rife.“"
                            },
                            {
                                "example_id": "aa981039-2ce6-4c2d-92f3-9cd4e0a17a3f",
                                "sense_id": "4695742a-5a80-3e29-973c-977c741ecb9a",
                                "text": "„Haste vielleicht’n Vierteldollar für mich?“"
                            },
                            {
                                "example_id": "39e11b10-34a5-44df-9f49-89de6c5925da",
                                "sense_id": "4695742a-5a80-3e29-973c-977c741ecb9a",
                                "text": "„HARPER'S HALF-HOUR SERIES war eine Reihe mit kleinen Büchern - Essays, Poesie, Dramen und andere kurze Werke - zum Preis von einem Vierteldollar, wobei der Titel der Reihe vermutlich darauf anspielt, dass die Bücher jeweils in einer halben Stunde durchgelesen werden konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
