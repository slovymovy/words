            "senses": [
                {
                    "sense_id": "a62c82c8-fa22-3dcf-a34e-f71f88d4e58f",
                    "sense_definition": "Группа людей, объединённая для совместной работы или выполнения общего производственного задания.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На стройку приехала новая <w>бригада</w> рабочих.",
                            "target_lang_translations": {
                                "en": "A new <w>crew</w> of workers arrived at the construction site.",
                                "tr": "İnşaat alanına yeni bir işçi <w>ekibi</w> geldi."
                            }
                        },
                        {
                            "text": "<w>Бригада</w> скорой помощи быстро доставила пациента в больницу.",
                            "target_lang_translations": {
                                "en": "The ambulance <w>crew</w> quickly delivered the patient to the hospital.",
                                "tr": "Acil yardım <w>ekibi</w> hastayı hızla hastaneye ulaştırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "артель"
                    ],
                    "common_phrases": [
                        "строительная бригада",
                        "бригада врачей",
                        "бригада скорой помощи",
                        "рабочая бригада"
                    ],
                    "target_lang_definitions": {
                        "en": "A group of people organized to work together on a specific task.",
                        "tr": "Belirli bir görevi birlikte yapmak için organize olmuş insan grubu."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crew",
