                "senses": [
                    {
                        "sense_id": "d2bb3d69-a9f7-3bab-ae8e-e99b70dcafa8",
                        "entry_id": "b38ef0ca-612e-3378-beb6-3dd31ff67608",
                        "glosses": [
                            "Remettre son caleçon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f03200af-c768-4665-8a42-6dc559c68c9f",
                                "sense_id": "d2bb3d69-a9f7-3bab-ae8e-e99b70dcafa8",
                                "text": "Il se met debout, ventre et bas-ventre nus, se torche avec un bout de journal, regarde si les passants n’approchent pas, se torche une deuxième fois, inspecte son papier souillé, puis, hop ! recaleçonné, il franchit un muret et disparaît."
                            },
                            {
                                "example_id": "268cdf17-5e8e-4d44-9fbc-50b1d6f04094",
                                "sense_id": "d2bb3d69-a9f7-3bab-ae8e-e99b70dcafa8",
                                "text": "Il se torche avec un demi rouleau de PQ. S’offre une petite branlette vite faite bien faite en pensant à ses voisines. Se recaleçonne et se reculotte sans séchage de gland. Sort sans actionner la chasse d’eau."
                            }
                        ]
                    }
