                        "examples": [
                            {
                                "example_id": "76a3d5f4-d69d-4e69-ad08-403e0821fa8a",
                                "sense_id": "e0dbf4b7-2d18-301d-8db8-4dcf5ad1cb13",
                                "text": "Il existe toutefois des traitements contre le choléra, à base de sels réhydratants, qui s'avèrent efficaces s'ils sont bien suivis (mortalité inférieure à 1%)."
                            },
                            {
                                "example_id": "cfe5e1f3-9f14-499f-a6fc-b28fc8ebc9f3",
                                "sense_id": "e0dbf4b7-2d18-301d-8db8-4dcf5ad1cb13",
                                "text": "D'autres attendaient de recevoir de l'aide, emportant de petites boîtes renfermant des boissons réhydratantes, des barres de céréales et de l'eau."
                            }
                        ]
                    }
