                    {
                        "sense_id": "7e966747-26eb-3e65-88b7-f695b764d308",
                        "entry_id": "73394ac5-2bcd-3782-a12d-a698e585cc0b",
                        "glosses": [
                            "Qui a les traits caractéristiques du faune."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "7bc85dfb-fd68-4485-a767-f05f96f4bc14",
                                "sense_id": "7e966747-26eb-3e65-88b7-f695b764d308",
                                "text": "[…] il a les pommettes saillantes et le type faunesque, comme si le peintre eût voulu caractériser en lui le sauvage de l’Écriture."
                            },
                            {
                                "example_id": "46984cde-b96e-440d-a510-45fdba9b446f",
                                "sense_id": "7e966747-26eb-3e65-88b7-f695b764d308",
                                "text": "Quand la ferveur et l’excitation sont au comble, les garçons exécutant autour de la châsse leurs bonds presque faunesques, pareils à ceux qu’on fait autour du feu de la Saint-Jean, se jettent à la poursuite des filles, mimant un épisode de la légende de sainte Rolende."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7813b512-7608-4b89-881e-0e52615a856a",
                        "source_entry_id": "73394ac5-2bcd-3782-a12d-a698e585cc0b",
                        "source_sense_id": "7e966747-26eb-3e65-88b7-f695b764d308",
                        "target_lang_word": "faunlike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faunlike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "054972b9-425c-3674-a8ee-8b103a5dc25f",
                                        "entry_id": "be342be8-fc39-3983-9913-d56a4a2f0534",
                                        "glosses": [
                                            "Resembling or characteristic of a faun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a1dbc14-b8fc-4a69-b52c-1acac2ce4d46",
                                                "sense_id": "054972b9-425c-3674-a8ee-8b103a5dc25f",
                                                "text": "Little Sea grumbled in her sleep, while Desire, with wide-open, faunlike eyes, stared queerly at me."
                                            },
                                            {
                                                "example_id": "f4d5e2ed-e779-46a4-b5db-4b668b894644",
                                                "sense_id": "054972b9-425c-3674-a8ee-8b103a5dc25f",
                                                "text": "WASPy GWM, impractically educated, clever but uncynical, slender physique but good torso (otherwise mildly unprepossessing) — 30ish but the skinny beardless faun-like demeanor is initially deceptive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9a95d63-8e57-4acc-a922-1d4372b1d02a",
                        "source_entry_id": "73394ac5-2bcd-3782-a12d-a698e585cc0b",
