                                    {
                                        "sense_id": "8775d471-4ae9-36de-a3d1-f9e3466dbc2a",
                                        "entry_id": "59b38532-2fb2-3207-9655-5d8ba5ae57c7",
                                        "glosses": [
                                            "A conceptual space that groups classes, identifiers, etc. in order to avoid conflicts with items in unrelated code that carry the same names."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "namespace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7a8f669-816b-3cce-9d65-57c32959baad",
                                        "entry_id": "12403afd-d111-38ee-8a47-b094c2ac3291",
                                        "glosses": [
                                            "To categorize by placing into a namespace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b7347c-2ff8-4af9-972d-892af0f564e1",
                                                "sense_id": "f7a8f669-816b-3cce-9d65-57c32959baad",
                                                "text": "Something I haven't captured in this schema is that the GEDCOM spec also says the structure is extensible; arbitrary namespaced elements may be inserted […]"
                                            },
                                            {
                                                "example_id": "544e676a-3e91-477d-b314-a90287a37dc0",
                                                "sense_id": "f7a8f669-816b-3cce-9d65-57c32959baad",
                                                "text": "Although the excessive namespacing might seem like a hassle, there's always a really quick way to create a shortcut."
                                            },
                                            {
                                                "example_id": "e5e72a4d-8cc4-4920-875e-84bf1acdacdb",
                                                "sense_id": "f7a8f669-816b-3cce-9d65-57c32959baad",
                                                "text": "SOAP adheres to extensive namespacing and attribute specification tags."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "666969e8-9f90-4646-ad40-2ac929f410dd",
                        "source_entry_id": "4f26471e-5cdc-3a48-83c2-2bfff2d12994",
                        "source_sense_id": "85d3f176-bd9d-3562-a9b7-b38e950403ee",
