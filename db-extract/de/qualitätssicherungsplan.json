                "senses": [
                    {
                        "sense_id": "93759a5a-2365-3072-8033-2d7c4b1e8138",
                        "entry_id": "6a804557-333e-3bbb-92b6-a29922ce92ba",
                        "glosses": [
                            "detaillierter Maßnahmenkatalog, der sicherstellen soll, das eine angestrebte Güte (Qualität) gehalten werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b961aab8-0636-4d50-a1a4-196e53448a00",
                                "sense_id": "93759a5a-2365-3072-8033-2d7c4b1e8138",
                                "text": "„Die Qualitätsziele werden in einem zentralen Qualitätssicherungsplan dargelegt, der die Basis für eine Teststrategie bildet.“"
                            },
                            {
                                "example_id": "e599a04c-8e00-41e7-a84b-0806f048d98b",
                                "sense_id": "93759a5a-2365-3072-8033-2d7c4b1e8138",
                                "text": "„Der Qualitätssicherungsplan oder die Verfahrensanweisungen für die Endprüfungen müssen verlangen, daß alle festgelegten (Qualitäts-)Prüfungen einschließlich Eingangs- und Zwischenprüfungen ausgeführt worden sind und das die Ergebnisse die festgelegten Qualitätsanforderungen erfüllen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
