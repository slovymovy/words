                                                "sense_id": "5e8a05e2-536e-3301-9f28-6b0f184235b5",
                                                "text": "Nice dismount!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91aa7462-76c0-3bd9-9478-dd4033ad0c90",
                                        "entry_id": "c3c1980f-4f1b-3190-bf56-1cd115dff128",
                                        "glosses": [
                                            "The part of a routine in which the gymnast detaches from an apparatus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05cd5f29-8bbc-4a48-a639-b08aa33d196d",
                                                "sense_id": "91aa7462-76c0-3bd9-9478-dd4033ad0c90",
                                                "text": "It was a stylish routine, let down by a sloppy dismount."
                                            }
                                        ]
