                                        "sense_id": "b1687d55-1397-362e-b209-8c6cc3c6419f",
                                        "entry_id": "41ccc718-d1f7-3370-8c94-e959dc9b2fd4",
                                        "glosses": [
                                            "To make something, such as a dramatic work, more acceptable by removing potentially offensive material."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b13faef-e37e-4cb5-8a2f-2422884137c2",
                                                "sense_id": "b1687d55-1397-362e-b209-8c6cc3c6419f",
                                                "text": "Near-synonym: bowdlerize"
                                            },
                                            {
                                                "example_id": "79badb0a-05a2-4345-9fb9-947e3c6be379",
                                                "sense_id": "b1687d55-1397-362e-b209-8c6cc3c6419f",
                                                "text": "And yet for all that, the filmmakers were in fact trying to sanitize Mitchell’s novel."
                                            },
                                            {
                                                "example_id": "525a8d63-49cc-4cd9-a502-c987378d8388",
                                                "sense_id": "b1687d55-1397-362e-b209-8c6cc3c6419f",
                                                "text": "Both caricatures are appropriately mean, but if the show is going to continue using them, it needs to take care not to sanitize the real people, as it has done with dangerously incompetent and malicious figures in the past, such as George W Bush or Trump himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ffa8c17-423b-3995-b310-f3f3137f9ada",
                                        "entry_id": "41ccc718-d1f7-3370-8c94-e959dc9b2fd4",
                                        "glosses": [
                                            "To filter (text) to ensure it does not contain any characters that will cause problems for or be interpreted in an adverse way by the receiving system."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "875bb047-ab51-43e9-9f5c-ca8a89e360d3",
                                                "sense_id": "4ffa8c17-423b-3995-b310-f3f3137f9ada",
                                                "text": "Remember to sanitize your query parameters to avoid SQL injection exploits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fae6fca-e73b-3217-b80c-f9c2effc6358",
                                        "entry_id": "41ccc718-d1f7-3370-8c94-e959dc9b2fd4",
                                        "glosses": [
                                            "To remove sensitive or personal data from (a database or file)."
