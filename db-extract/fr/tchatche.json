                "senses": [
                    {
                        "sense_id": "45d5336f-e61a-3509-8b60-5fc6945c133b",
                        "entry_id": "7c532acb-619b-3961-8a3d-36a34c25cd77",
                        "glosses": [
                            "chat, lingo; volubility, gift of the gab"
                        ],
                        "tags": [
                            "feminine",
