                "senses": [
                    {
                        "sense_id": "fab36304-1c97-37f0-b8ba-294f256d4ed4",
                        "entry_id": "132a80bb-5379-3fa7-863f-584806b7ac59",
                        "glosses": [
                            "een vestiging van een deel van een bevolking, buiten het eigenlijke territorium van dat volk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf5df264-0df0-4f00-9946-0afedba2039b",
                                "sense_id": "fab36304-1c97-37f0-b8ba-294f256d4ed4",
                                "text": "Nederland heeft een groot aantal kolonies gehad."
                            }
                        ]
                    },
                    {
                        "sense_id": "0feb46a5-beb3-31e5-80b4-9eabdbefc7eb",
                        "entry_id": "132a80bb-5379-3fa7-863f-584806b7ac59",
                        "glosses": [
                            "een samenlevingsvorm van dieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d4104ad-026c-432b-a60d-5d80a64e1f61",
                                "sense_id": "0feb46a5-beb3-31e5-80b4-9eabdbefc7eb",
                                "text": "De kolonie bijen had onder de dakrand een bijenkorf aangelegd."
                            },
                            {
                                "example_id": "b07423b7-5a33-4ce9-9ba2-1f54faa285a2",
                                "sense_id": "0feb46a5-beb3-31e5-80b4-9eabdbefc7eb",
                                "text": "Het gaat goed met de flamingostand in het Zwillbrocker Venn. De kolonie van de van oorsprong subtropische grote waadvogels telt dit jaar tussen de 40 en 50 exemplaren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ca2624d-013f-44dc-950b-c2f536eee854",
                        "source_entry_id": "132a80bb-5379-3fa7-863f-584806b7ac59",
                        "source_sense_id": "fab36304-1c97-37f0-b8ba-294f256d4ed4",
                        "source_sense_description": "een vestiging van een deel van een bevolking, buiten het eigenlijke territorium van dat volk",
                        "target_lang_word": "colony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "204f3c1b-37dd-35d1-b9ab-0a6d0acc33be",
                                        "entry_id": "60dd21c8-d062-3909-a141-752833f940f5",
                                        "glosses": [
                                            "An area under the political control of another country and typically occupied by settlers (colonists) from it, or by their descendants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1475386-a7f7-412d-bdf9-efffd6c731b8",
                                                "sense_id": "204f3c1b-37dd-35d1-b9ab-0a6d0acc33be",
                                                "text": "Much of the eastern United States was formerly a British colony; other areas were French, Spanish, Dutch, or Swedish colonies."
                                            },
                                            {
                                                "example_id": "5472864a-68f3-4f14-b0e7-c9bef1d18c78",
                                                "sense_id": "204f3c1b-37dd-35d1-b9ab-0a6d0acc33be",
                                                "text": "Bermuda is a crown colony of Great Britain."
                                            },
                                            {
                                                "example_id": "e9f77817-ae37-4675-935f-96979b316e2b",
                                                "sense_id": "204f3c1b-37dd-35d1-b9ab-0a6d0acc33be",
                                                "text": "And be it further Enacted by the Authority aforeſaid, That in every Town in the Colony, where Bread is Baken for Sale, there ſhall be Choſen one Clerk of the Market, or more, as each Town ſhall find needful, at their Annual Election of Town Officers, who ſhall duly be Engaged, to the faithful performance of ſaid Office, as other Town Officers are ;[…]"
                                            },
                                            {
                                                "example_id": "d5d10c12-65e4-40ed-b26d-82ee7fe704fc",
                                                "sense_id": "204f3c1b-37dd-35d1-b9ab-0a6d0acc33be",
                                                "text": "[…] money problems and refusal to supply them with British coins were two big reasons why the thirteen colonies rebelled and declared their independence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "447cab40-cc76-3dc2-8ad3-e3d7acb84af2",
                                        "entry_id": "60dd21c8-d062-3909-a141-752833f940f5",
                                        "glosses": [
                                            "A group of people who settle such an area and maintain ties to their native country, and (later) their descendants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e5e5f60-1377-4126-8b6b-285f82862aba",
                                                "sense_id": "447cab40-cc76-3dc2-8ad3-e3d7acb84af2",
                                                "text": "The question of ecclesiastical jurisdiction had to be answered before the colony sailed for East Florida."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "322efdae-646f-33d9-8900-f7e404c30ced",
                                        "entry_id": "60dd21c8-d062-3909-a141-752833f940f5",
                                        "glosses": [
                                            "A group of people, of one nationality, ethnic group, or language, residing in a different country, city, or area; the area such people occupy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "211b2d2b-69fc-4824-ac87-9e17f11d3938",
                                                "sense_id": "322efdae-646f-33d9-8900-f7e404c30ced",
                                                "text": "a colony of British expats in Spain"
                                            },
                                            {
                                                "example_id": "ce50a511-a453-47ec-bbc9-3894b322383e",
                                                "sense_id": "322efdae-646f-33d9-8900-f7e404c30ced",
                                                "text": "The Amana Colonies in Iowa were settled by people from Germany."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ad95adb-6a65-31b2-9f3c-6b04aa7df00c",
                                        "entry_id": "60dd21c8-d062-3909-a141-752833f940f5",
                                        "glosses": [
                                            "A group of people with similar interests, occupations, or characteristics, living in a particular area; the area such people occupy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "631eff5a-0d80-47c9-87a4-aad5883f643f",
                                                "sense_id": "2ad95adb-6a65-31b2-9f3c-6b04aa7df00c",
                                                "text": "a nudist colony; the statue was put up right in the middle of the artist colony"
                                            },
                                            {
                                                "example_id": "fb0e6118-7ee7-443d-96d9-19b2bc5c77e8",
                                                "sense_id": "2ad95adb-6a65-31b2-9f3c-6b04aa7df00c",
                                                "text": "a leper colony on the outskirts of town; most buildings in the penal colony were made of concrete"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0235155e-d67a-3407-97c8-15ccb0ee2280",
                                        "entry_id": "60dd21c8-d062-3909-a141-752833f940f5",
                                        "glosses": [
                                            "A group of organisms of same or different species living together in close association."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aa81f24-dfe1-43b4-b1ee-eb388a2e64b9",
                                                "sense_id": "0235155e-d67a-3407-97c8-15ccb0ee2280",
                                                "text": "ant colony; coral colony"
                                            },
                                            {
                                                "example_id": "c4dac5f4-6268-4cf0-9bc0-b0e6440c5aa3",
                                                "sense_id": "0235155e-d67a-3407-97c8-15ccb0ee2280",
                                                "text": "a colony of specialized polyps and medusoids"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c9630a5-7e0c-3871-af97-4339beb05dae",
                                        "entry_id": "60dd21c8-d062-3909-a141-752833f940f5",
                                        "glosses": [
                                            "A group of bacteria, fungi or other cells cultured together, especially from a single cell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b63080-6e07-4f7e-adf8-e385fbd1f052",
                                                "sense_id": "8c9630a5-7e0c-3871-af97-4339beb05dae",
                                                "text": "colonies of stem cells"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d382453c-29ee-3f00-9712-99d55f22a99d",
                                        "entry_id": "60dd21c8-d062-3909-a141-752833f940f5",
                                        "glosses": [
                                            "An apartment complex or neighborhood."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8abf8282-eb86-4530-a445-1fa0ea92b87b",
                                                "sense_id": "d382453c-29ee-3f00-9712-99d55f22a99d",
                                                "text": "Our colony is quite small, but each apartment is large."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689a1802-c3a3-357f-a045-03df4e26cff3",
                                        "entry_id": "60dd21c8-d062-3909-a141-752833f940f5",
                                        "glosses": [
                                            "A local group of Beaver Scouts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01ede984-d1f8-3328-81d2-9d5bfe5174c4",
                                        "entry_id": "60dd21c8-d062-3909-a141-752833f940f5",
                                        "glosses": [
                                            "A potential new chapter of a fraternity or sorority awaiting official recognition from their headquarters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afe51a79-284b-4dd2-9aa3-ffe080c8c649",
                                                "sense_id": "01ede984-d1f8-3328-81d2-9d5bfe5174c4",
                                                "text": "That weekend in 2013, fraternity members from Baruch, a commuter school in Manhattan whose Pi Delta Psi colony was only about three years old, gathered in a large rental house in Tunkhannock Township, Pa. Early on a frigid morning, Mr. Deng followed the other pledges in putting on a blindfold and backpack."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "colony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "808a14c4-2e09-3fde-964e-2bcffbf1208d",
                                        "entry_id": "7022ea3c-13cb-351d-baa6-2141485dc697",
                                        "glosses": [
                                            "To colonize."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "420b3624-1d01-4d06-8760-7505152281f4",
                                                "sense_id": "808a14c4-2e09-3fde-964e-2bcffbf1208d",
                                                "text": "Such black Attendants Colonied thy Cell, / But for thy Preſence, Car’sbrook had been Hell."
                                            },
                                            {
                                                "example_id": "b5a6e68a-a791-4be1-a1d3-e089bb0027f7",
                                                "sense_id": "808a14c4-2e09-3fde-964e-2bcffbf1208d",
                                                "text": "The noble Island (which was colonied [translating habitavam] / Sometime by Tyrians) was not wanting here, / Who, on their Banners in thoſe days of yore / The famous Pillars of Alcides bore."
                                            },
                                            {
                                                "example_id": "e4e5d323-ade5-454e-b16c-0e77dc08a1f5",
                                                "sense_id": "808a14c4-2e09-3fde-964e-2bcffbf1208d",
                                                "text": "The emperor meant rather to ſignify, by the altar and ſacrifice, that the old religion was aboliſhed in this province, which he had colonied with new inhabitants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
