                                "sense_id": "c959497a-a761-39a6-99f6-f4fe93db21a3",
                                "text": "Ne fais pas ta mauviette.",
                                "translation": "Don't be such a wimp.",
                                "english": "Don't be such a wimp."
                            },
                            {
                                "example_id": "ee2b670b-f626-4722-b7a0-692d512930b0",
                                "sense_id": "c959497a-a761-39a6-99f6-f4fe93db21a3",
                                "text": "Tu te dégonfles encore, mauviette ?",
                                "translation": "You chicken out again, you coward?",
                                "english": "You chicken out again, you coward?"
