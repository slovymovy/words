        "fr-extract.jsonl": [
            {
                "entry_id": "3627a67d-461e-32f7-b6cb-63e3498c18f6",
                "word": "indiscrétion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f83cdae4-6e32-4485-bc44-c58f8c868a69",
                        "entry_id": "3627a67d-461e-32f7-b6cb-63e3498c18f6",
                        "tags": [
                            "plural"
                        ],
                        "form": "indiscrétions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1cab5b1a-2a75-31e1-8266-653ba1fe056b",
                        "entry_id": "3627a67d-461e-32f7-b6cb-63e3498c18f6",
                        "glosses": [
                            "Manque de discrétion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e4e26f-44e2-446f-a0f3-3baace07a3f5",
                                "sense_id": "1cab5b1a-2a75-31e1-8266-653ba1fe056b",
                                "text": "Il a beaucoup d’indiscrétion."
                            },
                            {
                                "example_id": "7c8cd129-d0fd-4f81-b7ab-ce030a832232",
                                "sense_id": "1cab5b1a-2a75-31e1-8266-653ba1fe056b",
                                "text": "Son indiscrétion le perdra."
                            },
                            {
                                "example_id": "9682b801-b1de-4e75-805b-23a12d3224a8",
                                "sense_id": "1cab5b1a-2a75-31e1-8266-653ba1fe056b",
                                "text": "Son indiscrétion fait qu’il ne mérite aucune confiance."
                            },
                            {
                                "example_id": "cc3ca1e0-c7e4-45be-b4b9-b9f89e6558c8",
                                "sense_id": "1cab5b1a-2a75-31e1-8266-653ba1fe056b",
                                "text": "Y aurait-il de l’indiscrétion à vous demander si vous allez sortir."
                            }
                        ]
                    },
                    {
                        "sense_id": "1eec2ded-55f5-3b8b-b990-337ef2c8cc1c",
                        "entry_id": "3627a67d-461e-32f7-b6cb-63e3498c18f6",
                        "glosses": [
                            "Action indiscrète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4396aec1-1a51-4eff-96d2-4aef05a95ae3",
                                "sense_id": "1eec2ded-55f5-3b8b-b990-337ef2c8cc1c",
                                "text": "Sans calculer la portée de son indiscrétion, la peine ou la joie qu’elle pouvait faire, elle se soulageait, elle disait tout ce qu’elle savait."
                            },
                            {
                                "example_id": "c577fa13-e604-4ef1-af8b-378a29957f8c",
                                "sense_id": "1eec2ded-55f5-3b8b-b990-337ef2c8cc1c",
                                "text": "Faire, commettre une indiscrétion, des indiscrétions."
                            },
                            {
                                "example_id": "eab00bae-49b9-435c-aa05-e765ac70e547",
                                "sense_id": "1eec2ded-55f5-3b8b-b990-337ef2c8cc1c",
                                "text": "– Je me trouve dans une situation délicate qui m’oblige, pour ne pas vous offenser gravement, à commettre une indiscrétion qui meurtrit ma conscience."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "768579ca-3281-405f-b68e-6b0dd54d0b01",
                        "source_entry_id": "3627a67d-461e-32f7-b6cb-63e3498c18f6",
