{
    "word_family": [
        "frissonnement",
        "frissonner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9d92081-95d3-369d-b1f1-2a928d372b9a",
                    "sense_definition": "Tremblement involontaire du corps provoqué par le froid ou par un état fébrile.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sensation_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'elle est sortie dans la neige, un violent <w>frisson</w> l'a saisie de la tête aux pieds."
                        },
                        {
                            "text": "Le médecin a pris sa température car il avait de la fièvre et des <w>frissons</w> constants."
                        }
                    ],
                    "synonyms": [
                        "tremblement",
                        "frémissement"
                    ],
                    "common_phrases": [
                        "avoir des frissons",
                        "frisson de fièvre"
                    ]
                },
                {
                    "sense_id": "30df79a2-3077-3c7d-a9f4-133e57acfef2",
                    "sense_definition": "Sensation soudaine et intense provoquée par une émotion forte comme la peur, l'angoisse ou l'horreur.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sensation_emotionnelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette terrible histoire racontée au coin du feu m'a donné des <w>frissons</w> toute la soirée."
                        },
                        {
                            "text": "Un <w>frisson</w> de peur a parcouru la foule quand les lumières se sont brusquement éteintes."
                        }
                    ],
                    "synonyms": [
                        "tressaillement",
                        "frémissement"
                    ],
                    "common_phrases": [
                        "donner des frissons",
                        "frisson de peur"
                    ]
                },
                {
                    "sense_id": "480a1c7c-d3c9-3812-9cbb-fae74b7cd3b4",
                    "sense_definition": "Émotion vive et agréable liée au plaisir, à l'excitation ou à l'admiration.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation_emotionnelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En entendant cette sublime mélodie de piano, elle a ressenti un doux <w>frisson</w> d'émotion."
                        },
                        {
                            "text": "Les spectateurs ont éprouvé un <w>frisson</w> de plaisir lorsque l'acteur est monté sur scène."
                        }
                    ],
                    "synonyms": [
                        "exaltation"
                    ],
                    "common_phrases": [
                        "frisson de plaisir"
                    ]
                },
                {
                    "sense_id": "6b96d094-b404-3f72-bb2e-a902969b76f3",
                    "sense_definition": "Léger tremblement ou ondulation perceptible à la surface d'une chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un léger <w>frisson</w> agitait les feuilles du grand chêne au coucher du soleil."
                        },
                        {
                            "text": "L'eau du lac était si calme qu'on n'y distinguait pas le moindre <w>frisson</w> de brise."
                        }
                    ],
                    "synonyms": [
                        "frémissement",
                        "ondulation"
                    ]
                }
            ]
        }
    ]
}