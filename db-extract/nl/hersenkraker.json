                        "examples": [
                            {
                                "example_id": "666c165f-87ab-460f-a66c-ed8d61cf10a9",
                                "sense_id": "572c8389-b12d-3e35-9fa6-bd96efd784f5",
                                "text": "Het is een echte hersenkraker: de code die om het pootje van een dode postduif zat. Codekrakers van de Britse inlichtingendienst zijn al weken aan het puzzelen en nog steeds hebben ze geen idee wat er op het briefje staat. Een paar weken geleden vond een 74-jarige man uit het Engelse Surrey een skelet van een postduif uit de Tweede Wereldoorlog. Aan één van de pootjes zat toen een kleine rode koker met een briefje erin."
                            },
                            {
                                "example_id": "15f0e012-b653-48c9-a0ab-4c8030c3a062",
                                "sense_id": "572c8389-b12d-3e35-9fa6-bd96efd784f5",
                                "text": "Met een persoonlijke record van 10,02 lijkt het lopen van een 'sub-10' nog slechts een kwestie van tijd. Het is voor Bouju alleen een hersenkraker hoe hij die luttele drie-honderdsten van een seconde van zijn eigen toptijd afsnoept."
                            }
                        ]
                    }
