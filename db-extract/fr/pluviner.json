                        ],
                        "examples": [
                            {
                                "example_id": "68868c6c-e3c8-40ec-8ae1-6acf9d3521ee",
                                "sense_id": "4c94dbdc-46ea-37e4-be5e-605b84572309",
                                "text": "Maintenant, il pluvinait et, le trottoir n’étant pas large, elles marchaient deux par deux, comme des pensionnaires, sur la pavé mouillé, la tête penchée, sans mot dire."
                            },
                            {
                                "example_id": "a2f63295-b728-43a4-b0f4-fbc10638c211",
                                "sense_id": "4c94dbdc-46ea-37e4-be5e-605b84572309",
                                "text": "Comme il avait commencé à pluviner à peu près au moment où Suzanne était arrivée, l'herbe, maintenant toute détrempée, ne se prêtait pas à cette opération."
                            }
                        ]
                    }
