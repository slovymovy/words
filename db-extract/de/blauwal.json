                ],
                "senses": [
                    {
                        "sense_id": "13b3d2b6-72f7-3717-b1b7-aba70212ecb9",
                        "entry_id": "fe1c25aa-ea44-37ef-af37-0fe884a1b8f8",
                        "glosses": [
                            "Meeressäugetier, der in den Ozeanen lebt; wissenschaftlich: Balaenoptera musculus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a51888-9f4e-4e3f-9fe8-18a7cceba10c",
                                "sense_id": "13b3d2b6-72f7-3717-b1b7-aba70212ecb9",
                                "text": "Der Blauwal wiegt um die 200 Tonnen."
                            },
                            {
                                "example_id": "d2c3c403-2c2a-4a7c-affa-19929d931469",
                                "sense_id": "13b3d2b6-72f7-3717-b1b7-aba70212ecb9",
                                "text": "„Schweinswale sind im Vergleich mit Pottwalen oder Blauwalen Zwerge.“"
                            },
                            {
                                "example_id": "c33e2a4c-0385-4b93-9d18-585f29d43751",
                                "sense_id": "13b3d2b6-72f7-3717-b1b7-aba70212ecb9",
                                "text": "„Ich habe noch nie einen lebendigen Blauwal gesehen, aber ich vermute, wer einen Blauwal gesehen hat, benimmt sich ähnlich seltsam wie Astronauten, die aus dem Weltraum zurückgekehrt sind.“"
                            },
                            {
                                "example_id": "e9cb0f90-3ed9-4fe1-8450-01c4ca53e7b0",
                                "sense_id": "13b3d2b6-72f7-3717-b1b7-aba70212ecb9",
                                "text": "„Bis 1958 wurden hier Finn-, Buckel- und Blauwale in industriellem Maßstab verarbeitet, danach war die Fabrik nur noch sporadisch in Betrieb.“"
                            },
                            {
                                "example_id": "dd30e135-f380-4c23-a3d9-2203f33e3393",
                                "sense_id": "13b3d2b6-72f7-3717-b1b7-aba70212ecb9",
                                "text": "„Allein in der Saison 1914 – 1915 wurden auf den Südlichen Shetlandinseln 1800 Blauwale an Land gezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f7b9f3f-b966-49a6-acb7-bcdddb561804",
