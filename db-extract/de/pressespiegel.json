                            {
                                "example_id": "0a1dbe91-bb7c-4c2d-bc91-433ab91d91c9",
                                "sense_id": "e624f70e-ab7b-34d2-a2b0-296a19baba93",
                                "text": "„Der Pressespiegel liefert einen Überblick der Presseresonanz zur Leibniz Universität, anderen Hochschulen der Region und Themen aus dem hochschulpolitischen Bereich.“"
                            },
