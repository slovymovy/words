                "senses": [
                    {
                        "sense_id": "5fadc918-c4c3-36e9-a5be-07adce044082",
                        "entry_id": "29e04a63-6bab-317e-ba42-eef52abcde63",
                        "glosses": [
                            "relativ dicke, oft ringförmige Wurst aus fein zerkleinertem Fleisch und Gewürzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b9ac172-e2fa-4d60-bd5d-7c81187a3643",
                                "sense_id": "5fadc918-c4c3-36e9-a5be-07adce044082",
                                "text": "„Auf einem Pappteller dampfen zwei riesige Fleischwürste.“"
                            },
                            {
                                "example_id": "a9da3067-3301-470e-842e-6af15c059ad3",
                                "sense_id": "5fadc918-c4c3-36e9-a5be-07adce044082",
                                "text": "„Zum Frühstück gab es Fleischwurst in dünnen Scheiben und es war die beste Fleischwurst meines Lebens, noch immer.“"
                            },
                            {
                                "example_id": "41233d35-4809-4a1f-9bb9-15c7dca0fc7b",
                                "sense_id": "5fadc918-c4c3-36e9-a5be-07adce044082",
                                "text": "„In der Kantine hat der Referendar Volz seiner Verlobten mal wieder seine Fleischwurst, der er die Haut bereits abgezogen hatte und die vorne besenft war, um elf Uhr vormittags ins Gesicht gestoßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
