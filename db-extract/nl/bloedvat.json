                                                "sense_id": "1031af50-334f-3096-8e7c-bfb4c8a92060",
                                                "text": "„[…] Serotonin ist eine Komponente des Serums, die den Tonus (Spannung) der Blutgefäße reguliert und zur Blutgerinnung beiträgt.“"
                                            },
                                            {
                                                "example_id": "361d9780-288e-494a-ab3d-6eab23bbe5c6",
                                                "sense_id": "1031af50-334f-3096-8e7c-bfb4c8a92060",
                                                "text": "„Da die großen Blutgefäße sich beim Schuß zusammengezogen haben, ist nicht mit Blutungen zu rechnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
