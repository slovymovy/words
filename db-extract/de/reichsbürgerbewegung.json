                "senses": [
                    {
                        "sense_id": "e621a2df-d953-3c35-8a99-821408ff9f81",
                        "entry_id": "3d8aeef9-5486-3cea-8ba6-ffc86342d6c9",
                        "glosses": [
                            "organisatorisch und ideologisch sehr heterogene Szene aus meist Einzelpersonen, seltener teilweise sektenartigen Klein- und Kleinstgruppen, die die Existenz der Bundesrepublik Deutschland als eines legitimen und souveränen Staats bestreiten und ihre Rechtsordnung ablehnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09371bd9-75a7-4a1b-bd6a-0330a8f075df",
                                "sense_id": "e621a2df-d953-3c35-8a99-821408ff9f81",
                                "text": "„In Köln ist ein per Haftbefehl gesuchter Angehöriger der sogenannten Reichsbürgerbewegung festgenommen worden.“"
                            },
                            {
                                "example_id": "be545bf7-35fa-4849-b755-efca73333bea",
                                "sense_id": "e621a2df-d953-3c35-8a99-821408ff9f81",
                                "text": "„Die Razzia bei mutmaßlichen Rechtsterroristen der Reichsbürgerbewegung hat eine Debatte über die Sicherheit des Bundestags ausgelöst.“"
                            },
                            {
                                "example_id": "9baa7b25-1b5d-4d36-bc92-b53533fe9fdc",
                                "sense_id": "e621a2df-d953-3c35-8a99-821408ff9f81",
                                "text": "„‚Nach den bisherigen Ermittlungen besteht der Verdacht, dass alle Beschuldigten dem rechtsextremen Spektrum und/oder der Reichsbürgerbewegung zuzurechnen sind‘, hieß es in der Antwort, die die Grünen am Sonntag veröffentlichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
