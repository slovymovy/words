                    "sense_id": "77ef9098-512f-3fba-908e-8ac6ce31c31d",
                    "sense_definition": "nog steeds ergens zijn waar anderen of iets anders niet meer aanwezig is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verblijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de rest van de groep naar huis ging, besloot hij nog even in het café <w>achter te blijven</w>.",
                            "target_lang_translations": {
                                "en": "When the rest of the group went home, he decided to <w>stay behind</w> in the cafe for a while."
                            }
                        },
                        {
                            "text": "Bij het filteren van de vloeistof bleef er een klein beetje goud op het filter <w>achter</w>.",
                            "target_lang_translations": {
                                "en": "When filtering the liquid, a small amount of gold <w>remained</w> on the filter."
                            }
                        }
                    ],
                    "synonyms": [
