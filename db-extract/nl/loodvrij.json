                                    {
                                        "sense_id": "e2d273dc-80f0-3b2b-859c-bfc6f900319f",
                                        "entry_id": "d1603f14-56da-35ca-aca7-0f50d782f126",
                                        "glosses": [
                                            "kein Blei enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e63978-f7e6-44d1-8da5-a85473157e3e",
                                                "sense_id": "e2d273dc-80f0-3b2b-859c-bfc6f900319f",
                                                "text": "Dieser Motor benötigt bleifreies Benzin."
                                            },
                                            {
                                                "example_id": "64c99b3f-9cb2-4166-af70-6424b7d40602",
                                                "sense_id": "e2d273dc-80f0-3b2b-859c-bfc6f900319f",
                                                "text": "„Die neun überprüften Produkte sind nahezu bleifrei.“"
                                            },
                                            {
                                                "example_id": "0af35c7d-9e4d-4b96-a396-74f65e2a3414",
                                                "sense_id": "e2d273dc-80f0-3b2b-859c-bfc6f900319f",
                                                "text": "„Wirklich bleifrei sei hier aber nur Reinzinn - auch Lebensmittelzinn genannt - warnen Verbraucherschützer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c3ad0ec-5c79-457b-b2a5-80c4e94f4fcd",
