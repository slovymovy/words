                    }
                ],
                "senses": [
                    {
                        "sense_id": "01e54799-04f4-33cf-b5d8-491c5c5a28f0",
                        "entry_id": "56f47258-7f0d-3b44-82e1-de206f3a23b2",
                        "glosses": [
                            "Tenu ensemble, joint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92fb0daf-57d7-4932-b641-d68c757c7569",
                                "sense_id": "01e54799-04f4-33cf-b5d8-491c5c5a28f0",
                                "text": "D'azur à deux clefs d'or adossées en pal, entretenues par le bas, aux anneaux losangés et pommetés, qui étaient de Cluny → voir illustration « clés entretenues »"
                            }
                        ]
                    },
                    {
                        "sense_id": "3b6bb21f-bb19-34a9-a36d-64b2c80fa0bc",
                        "entry_id": "56f47258-7f0d-3b44-82e1-de206f3a23b2",
                        "glosses": [
                            "Qui fait l’objet d'un entretien soigneux, maintenu en bon état."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13dfd218-1cb2-4e55-ac02-eb24151f8c05",
                                "sense_id": "3b6bb21f-bb19-34a9-a36d-64b2c80fa0bc",
                                "text": "A Pont-du-Château même, la plupart des maisons réparées et bien entretenues sont celles où logent ces ouvriers ; beaucoup d'autres se délabrent, tombent en ruine."
                            }
                        ]
                    },
                    {
                        "sense_id": "84350aec-65ed-382f-b4d1-31a3ee927f40",
                        "entry_id": "56f47258-7f0d-3b44-82e1-de206f3a23b2",
                        "glosses": [
                            "Constant, de même amplitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b96d82a1-784e-4a33-8827-c91b05f0410e",
                                "sense_id": "84350aec-65ed-382f-b4d1-31a3ee927f40",
                                "text": "Oscillations entretenues."
                            }
                        ]
                    },
                    {
                        "sense_id": "c63e6888-1ecc-3dd5-876e-9ba6276edcca",
                        "entry_id": "56f47258-7f0d-3b44-82e1-de206f3a23b2",
                        "glosses": [
                            "Dont les frais matériels d’existence sont assurés par un tiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b7f5bb-1580-47b8-9dfd-6625edd8cd72",
                                "sense_id": "c63e6888-1ecc-3dd5-876e-9ba6276edcca",
                                "text": "Un étudiant entretenu par ses parents."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1d1584b-c1e2-3634-9e2a-3a2b03dacc77",
                        "entry_id": "56f47258-7f0d-3b44-82e1-de206f3a23b2",
                        "glosses": [
                            "Dont les frais matériels d'existence sont assurés par un amant ou une amante."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "03dc61db-e462-4146-9b72-0a0dd531e82a",
                                "sense_id": "a1d1584b-c1e2-3634-9e2a-3a2b03dacc77",
                                "text": "Les femmes entretenues prévoient toujours qu'on les aimera, jamais qu'elles aimeront, sans quoi elles mettraient de l'argent de côté, et à trente ans elles pourraient se payer le luxe d'avoir un amant pour rien."
                            },
                            {
                                "example_id": "011a13a0-e35b-4082-9dbc-98b541cb56c4",
                                "sense_id": "a1d1584b-c1e2-3634-9e2a-3a2b03dacc77",
                                "text": "la femme entretenue — chatoyant amalgame d’éléments inconnus et diaboliques, serti, comme une apparition de Gustave Moreau, de fleurs vénéneuses entrelacées à des joyaux précieux — […]"
                            },
                            {
                                "example_id": "d1315f32-f7f3-4091-a645-88bb08f7c107",
                                "sense_id": "a1d1584b-c1e2-3634-9e2a-3a2b03dacc77",
                                "text": "Ni tout à fait maîtresse en titre ni tout à fait femme entretenue, la jeune baronne F. (elle a repris son appellation familiale à elle) tient dans la vie de ce grand homme d’affaires une place considérable, mais il ne lui déplaît pas qu’elle ait ses mois, et même ses saisons libres, escortée par quelques admirateurs, presque tous de longue date, et qui sont aussi du monde."
                            },
                            {
                                "example_id": "47be1c9c-8e16-4789-8f14-f64b12d822bc",
                                "sense_id": "a1d1584b-c1e2-3634-9e2a-3a2b03dacc77",
                                "text": "C'est un homme entretenu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f11587bc-30e7-4586-acd4-3f16bd80b1f8",
