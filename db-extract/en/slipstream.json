{
    "word": "slipstream",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "42e9cbbd-c04c-3c19-beb0-1748e08ef6e7",
                "word": "slipstream",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ebcdf4b7-2b01-463b-b04f-77d38e87521e",
                        "entry_id": "42e9cbbd-c04c-3c19-beb0-1748e08ef6e7",
                        "tags": [
                            "plural"
                        ],
                        "form": "slipstreams"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b51fe2bb-ea28-35a7-95e7-f2914e7571bd",
                        "entry_id": "42e9cbbd-c04c-3c19-beb0-1748e08ef6e7",
                        "glosses": [
                            "The low-pressure zone immediately following a rapidly moving object, caused by turbulence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "93e26796-5c5d-436a-bf45-0ffaef787d52",
                                "sense_id": "b51fe2bb-ea28-35a7-95e7-f2914e7571bd",
                                "text": "Monza was the seventh race in a row at which Leclerc had out-qualified Vettel. There were extenuating circumstances this time - Vettel did not have a slipstream on his first lap and the farcical end to qualifying prevented him doing another - but a clear pattern is emerging."
                            }
                        ]
                    },
                    {
                        "sense_id": "048597d2-1cff-3422-b1d8-3a2a5e852214",
                        "entry_id": "42e9cbbd-c04c-3c19-beb0-1748e08ef6e7",
                        "glosses": [
                            "A generated advantage which makes forward movement easier."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a50343dd-fd98-4f98-8aa5-98853feaba74",
                                "sense_id": "048597d2-1cff-3422-b1d8-3a2a5e852214",
                                "text": "The Republicans, who in fact quintessentially represent what I understand to be private and special interests of a narrow economic kind, have nevertheless managed, flying in the slipstream of Ronald Reagan's rhetoric, to look like the true guardians of the nation's public interest."
                            }
                        ]
                    },
                    {
                        "sense_id": "be019b34-9d6a-388b-9b8d-cb268b46f836",
                        "entry_id": "42e9cbbd-c04c-3c19-beb0-1748e08ef6e7",
                        "glosses": [
                            "The relative wind experienced as a result of movement through air."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "80895f43-23ce-3d2b-832f-a440d4afff42",
                        "entry_id": "42e9cbbd-c04c-3c19-beb0-1748e08ef6e7",
                        "glosses": [
                            "The airflow over a propeller-driven aircraft generated by the motion of its propeller(s)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8c7de2be-1c65-3bf7-9c39-1450d848e8ae",
                        "entry_id": "42e9cbbd-c04c-3c19-beb0-1748e08ef6e7",
                        "glosses": [
                            "A genre of fantastic or non-realistic fiction that crosses conventional genre boundaries."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0328edde-340b-4d09-842d-9c65c9e6e883",
                                "sense_id": "8c7de2be-1c65-3bf7-9c39-1450d848e8ae",
                                "text": "Slipstream is not simply a mixture of fantasy and realism, but something which lies between or even beyond the two."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf8e2eb3-ef25-4edf-869d-b655b01a3f83",
                        "source_entry_id": "42e9cbbd-c04c-3c19-beb0-1748e08ef6e7",
                        "source_sense_description": "the low pressure zone",
                        "target_lang_word": "zone d'aspiration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d110881c-6d12-4abe-a1ed-2f1ccf31028f",
                        "source_entry_id": "42e9cbbd-c04c-3c19-beb0-1748e08ef6e7",
                        "source_sense_description": "the low pressure zone",
                        "target_lang_word": "Sog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07cc0fb3-3008-3d18-a6e4-a7d867a7deb6",
                                        "entry_id": "f85119ee-520f-332a-8ed1-cbe2243f0825",
                                        "glosses": [
                                            "saugende oder ziehende Strömung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fd04e84-1f73-4345-a504-85426a145a52",
                                                "sense_id": "07cc0fb3-3008-3d18-a6e4-a7d867a7deb6",
                                                "text": "Er konnte nicht mehr an Land schwimmen, als er in den Sog der Schiffsschraube geriet."
                                            },
                                            {
                                                "example_id": "57fe8607-04c6-4825-a6cc-97a3eb8f0c89",
                                                "sense_id": "07cc0fb3-3008-3d18-a6e4-a7d867a7deb6",
                                                "text": "Ein Schiff legt sich in den Sog oder das Fahrwasser eines anderen Schiffes, wenn es dessen Spur nachfährt."
                                            },
                                            {
                                                "example_id": "99e2986f-572c-4e9f-92c0-5a33d24265b9",
                                                "sense_id": "07cc0fb3-3008-3d18-a6e4-a7d867a7deb6",
                                                "text": "„Wenn man auch tausendmal an ihnen vorbeigeht, so kann man doch schließlich ihrem Sog nicht widerstehen und wird ihr Opfer.“"
                                            },
                                            {
                                                "example_id": "c6c83ce9-1aec-40f7-94de-78a798b68bc3",
                                                "sense_id": "07cc0fb3-3008-3d18-a6e4-a7d867a7deb6",
                                                "text": "„Niemals würde ich mich in den Sog von Ideen ziehen lassen, die dem Terrorismus huldigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "282be3c4-de45-45ad-bd06-780ca22d9830",
                        "source_entry_id": "42e9cbbd-c04c-3c19-beb0-1748e08ef6e7",
                        "source_sense_description": "the low pressure zone",
                        "target_lang_word": "Windschatten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windschatten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56dc0413-7de2-3ae3-aa26-344b0b0a312a",
                                        "entry_id": "5a691890-278b-3c38-9f5b-ea4df8d82baa",
                                        "glosses": [
                                            "gegen Wind geschützte Stelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fcd3e3d-0ad9-4947-acef-bd10760c8276",
                                                "sense_id": "56dc0413-7de2-3ae3-aa26-344b0b0a312a",
                                                "text": "„Ich hockte mich in den Windschatten eines der Steinhaufen.“"
                                            },
                                            {
                                                "example_id": "ec2c8d3c-af05-4b81-8a2f-2d4eac6b0d5b",
                                                "sense_id": "56dc0413-7de2-3ae3-aa26-344b0b0a312a",
                                                "text": "„Der Sturm blies zum Glück immer noch aus Nordwesten, so daß die Öffnungen des Granithauses weitgehend im Windschatten lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "474f48e4-8baf-4113-8312-926568e7220e",
