                "entry_id": "0195ee9d-f52d-30c6-90bd-170b7dadcb2c",
                "word": "fantasist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "10f01460-d239-4dc7-bca2-416cef8319cb",
                        "entry_id": "0195ee9d-f52d-30c6-90bd-170b7dadcb2c",
