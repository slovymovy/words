        "fr-extract.jsonl": [
            {
                "entry_id": "b93264f9-7bd3-3b1a-96c1-19825cd02a1b",
                "word": "suavement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d9612772-633e-3d3e-ab80-b2e748f2212d",
                        "entry_id": "b93264f9-7bd3-3b1a-96c1-19825cd02a1b",
                        "glosses": [
                            "Avec douceur et subtilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fcce90b-daff-497c-b7d6-8434ea9a9ad5",
                                "sense_id": "d9612772-633e-3d3e-ab80-b2e748f2212d",
                                "text": "Ce sentiment s’insinua suavement dans son âme."
                            },
                            {
                                "example_id": "45613035-3dd4-41d4-83cb-5b9e7d08998d",
                                "sense_id": "d9612772-633e-3d3e-ab80-b2e748f2212d",
                                "text": "Jusqu'aux cravates, au petit nœud suavement bloqué par une épingle dans l'échancrure du col, jusqu'au feu d'un vrai diam’ et au cuir mat du bracelet-montre, on sentait ces messieurs soucieux de leur mise."
                            },
                            {
                                "example_id": "80454aa8-51b8-493e-9091-e1b5ff52538d",
                                "sense_id": "d9612772-633e-3d3e-ab80-b2e748f2212d",
                                "text": "Le dimanche, quand on célébrait la Cène à Mespech, il chantait les Psaumes de David, tenant sur ses genoux sa viole, dont il pinçait suavement les cordes."
                            },
                            {
                                "example_id": "b9064ad2-a664-442c-926a-7fb6d98c4cc4",
                                "sense_id": "d9612772-633e-3d3e-ab80-b2e748f2212d",
                                "text": "Son iPhone s'alluma : c'était lui. Elle sourit suavement et ne décrocha pas."
                            },
                            {
                                "example_id": "f71eee86-1170-4f0f-8ee8-4ed61dea2b92",
                                "sense_id": "d9612772-633e-3d3e-ab80-b2e748f2212d",
                                "text": "On ne peut dénier la réalité des transformations dans le dispositif de parentalité. Elles modifient les rapports de domination entre hommes et femmes, nommés suavement complémentarité par le Saint-Père."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9da732b6-655e-48ab-8574-8458bdbc1e7e",
                        "source_entry_id": "b93264f9-7bd3-3b1a-96c1-19825cd02a1b",
                        "source_sense_id": "d9612772-633e-3d3e-ab80-b2e748f2212d",
                        "target_lang_word": "suavely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suavely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cd92a9d-f91f-3a93-b98f-3ca57c6997ab",
                                        "entry_id": "5190bba4-b285-325a-9015-ddef0659dd06",
                                        "glosses": [
                                            "In a suave manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77ccadd-f581-4196-83e5-af70cceba790",
                                                "sense_id": "5cd92a9d-f91f-3a93-b98f-3ca57c6997ab",
                                                "text": "\"Your Highness's wish is my command,\" says Sir Joshua suavely, for he is intensely curious as to the contents of the document."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fada2205-487b-44c2-ab1b-e9f00cb65438",
                        "source_entry_id": "b93264f9-7bd3-3b1a-96c1-19825cd02a1b",
                        "source_sense_id": "d9612772-633e-3d3e-ab80-b2e748f2212d",
                        "target_lang_word": "sweetly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sweetly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8453497-d99d-3580-8f60-f97ba2fffa2f",
                                        "entry_id": "25441a3a-c789-3f5f-8179-78f8a88343d9",
                                        "glosses": [
                                            "With a sweet taste or aroma."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0677ee9e-3127-34a3-8ace-9d4d315fd7d7",
                                        "entry_id": "25441a3a-c789-3f5f-8179-78f8a88343d9",
                                        "glosses": [
                                            "In a sweet or pleasant manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ca52ae-1735-4262-ab6d-f9c26571689f",
                                                "sense_id": "0677ee9e-3127-34a3-8ace-9d4d315fd7d7",
                                                "text": "\"No, Auntie,\" said Hardman, sweetly, seriously."
                                            },
                                            {
                                                "example_id": "69b6ef63-b713-456e-b00a-14fd3ea4ef0d",
                                                "sense_id": "0677ee9e-3127-34a3-8ace-9d4d315fd7d7",
                                                "text": "\"Hey, Sis, do yah want a Hertz Donut?\" one of them sweetly said as the other one held out a donut bag. She reached for it. Her step-sister snatched the bag away and socked her hard in the arm instead.\n\"Hurts, Don't it?\" they chime, laughing at her pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea674bfc-6fb9-36ba-ba08-2c5496ff67fd",
                                        "entry_id": "25441a3a-c789-3f5f-8179-78f8a88343d9",
                                        "glosses": [
                                            "Nicely; finely; excellently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39bec685-8dba-49fd-8cde-a1b3c239415f",
                                                "sense_id": "ea674bfc-6fb9-36ba-ba08-2c5496ff67fd",
                                                "text": "Sitting in the seat with the engine off before that day, the gears slid in so sweetly, and double de-clutching was so easy, I had done it a million times."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be9a4fdc-d09c-422a-9428-d10353bf0dfb",
                        "source_entry_id": "b93264f9-7bd3-3b1a-96c1-19825cd02a1b",
                        "source_sense_id": "d9612772-633e-3d3e-ab80-b2e748f2212d",
                        "target_lang_word": "softly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "softly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "In a soft manner; gently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3cecd2f-b4e7-46cd-b4fe-3fecf102946e",
                                                "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                                "text": "The masseuse was rubbing my back too softly for my liking, so I asked her to go harder."
                                            },
                                            {
                                                "example_id": "c77e3ca9-df67-41ad-93d2-3796161f1332",
                                                "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                                "text": "He had married a lady well educated and softly nurtured, but not dowered with worldly wealth. […] They would give up ideas of gentle living, of soft raiment, and delicate feeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "Not loudly; nearly inaudibly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7ac6f1-5e92-45f1-8cec-77aae41d81c7",
                                                "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                                "text": "whisper softly in someone's ear"
                                            },
                                            {
                                                "example_id": "9c22bad6-7ccd-4f58-a02e-4ed377560ff8",
                                                "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                                "text": "play music softly"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "542c7fdf-2b24-3255-ab69-d5f75b7a5870",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "With subdued color; faded or misty with distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ac4721-97b8-44c6-830b-4a48acabc289",
                                                "sense_id": "542c7fdf-2b24-3255-ab69-d5f75b7a5870",
                                                "text": "And they sat very still, the two of them, and looked out over that great, beautiful desert—away to the home mesa that they could see, softly blue, in the distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
