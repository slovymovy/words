                    {
                        "sense_id": "dd0ca526-0814-3b1f-845e-be5836c0b13f",
                        "entry_id": "0998b734-a6d0-3bd2-9da6-98cd404dad63",
                        "glosses": [
                            "(einmalige) Bohrung in das Erdreich, um zu Erkenntnissen über den Untergrund zu gelangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21d37e40-b3f4-47df-93a2-f074bf47c126",
                                "sense_id": "dd0ca526-0814-3b1f-845e-be5836c0b13f",
                                "text": "„Im Jahre 1831 wurde zu Tübingen, am westlichen Abhange des Oesterbergs, ein Bohrversuch angestellt, welcher bis 269 würt. F. getrieben wurde, um für die dort neu errichtete Anatomie Quellwasser zu erhalten.“ (1833)"
                            },
                            {
                                "example_id": "63ab2487-2e53-4a98-ae15-770562d84653",
                                "sense_id": "dd0ca526-0814-3b1f-845e-be5836c0b13f",
                                "text": "„Dieses veranlaßte mehrere Bürger, die Sache selbst in die Hand zu nehmen und zwei Bohrversuche zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
