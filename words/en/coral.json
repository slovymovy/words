                {
                    "sense_id": "e1fe3ab0-3ccd-37b7-a218-38bb2e4eb663",
                    "sense_definition": "Having a pinkish-orange color.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunset painted the sky in <w>coral</w> and gold hues.",
                            "target_lang_translations": {
                                "ru": "Закат окрасил небо в <w>коралловые</w> и золотые оттенки.",
                                "zh": "晚霞把天空染成了<w>珊瑚色的</w>和金色的色调。"
                            }
                        },
                        {
                            "text": "She applied a <w>coral</w> lipstick that complemented her skin tone perfectly.",
                            "target_lang_translations": {
                                "ru": "Она нанесла <w>коралловую</w> помаду, которая идеально подходила к тону ее кожи.",
                                "zh": "她涂了一支<w>珊瑚色的</w>口红，非常衬她的肤色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "salmon",
                        "peach"
                    ],
                    "common_phrases": [
