                        "examples": [
                            {
                                "example_id": "52cc38a7-42a6-4939-9768-2aa583258d29",
                                "sense_id": "e6136f4c-524d-3023-bdbf-0be45b378eda",
                                "text": "The application was followed at once by terrible pain in the wound; furthermore, there appeared a dry and chappy tongue, intolerable thirst, colics, cramplike contractions of the legs and back, and a weak and irregular pulse."
