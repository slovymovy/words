                "senses": [
                    {
                        "sense_id": "9ab5fd67-bbfe-3478-a27d-32c4c6f44247",
                        "entry_id": "7d7bb8f7-4f1d-34a2-8deb-70a6c3518d0b",
                        "glosses": [
                            "wegetatywna tkanka niektórych organizmów niezróżnicowana na korzeń oraz pęd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca4cc0a6-5edc-4e99-be98-eec1be34396c",
                                "sense_id": "9ab5fd67-bbfe-3478-a27d-32c4c6f44247",
                                "text": "Jedynie w pewnym stopniu pomóc mogą sposoby tworzenia i rozgałęzienia plechy specyficzne dla krasnorostów, brunatnic i zielenic."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "36fc452a-5755-3e54-b5b3-e6a674d3aa99",
                        "entry_id": "7d7bb8f7-4f1d-34a2-8deb-70a6c3518d0b",
                        "glosses": [
                            "wygolone miejsce na głowie"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b906d608-977e-4f7c-9a7b-9c2a3d1f018d",
                                "sense_id": "36fc452a-5755-3e54-b5b3-e6a674d3aa99",
                                "text": "— Dać mu pokój! — zawołał, — gdyby plechy wygolonej nie miał na łbie, postąpiłbym z nim inaczej, ale się z biskupami zadzierać teraz nie chcę…"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
