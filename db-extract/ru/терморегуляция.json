                    {
                        "translation_id": "5f36cb6b-e796-4536-98ad-451cb807e5a6",
                        "source_entry_id": "3e10a1e3-3aac-3825-bef0-8378358d0a7d",
                        "source_sense_id": "1d4b7a30-ea28-3b22-9395-7111137ec90a",
                        "target_lang_word": "thermorégulation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermorégulation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ea6e1ee-c579-384f-b700-26fff67a9631",
                                        "entry_id": "6b407a76-a2b0-34a4-97a5-0e9d8895b461",
                                        "glosses": [
                                            "Mécanisme de régulation physiologique qui permet à un organisme de conserver une température constante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6326b83f-a0e5-46dc-ba6d-17e5fefb077e",
                                                "sense_id": "8ea6e1ee-c579-384f-b700-26fff67a9631",
                                                "text": "Lorsque la thermorégulation n’arrive pas à maintenir des conditions de température centrale « normales », on parle d'hypothermie lorsque la température centrale est inférieure à la température normale ou d'hyperthermie lorsque la température centrale est supérieure à la température normale."
                                            },
                                            {
                                                "example_id": "dd83338e-4f33-45f4-9347-2367faac4363",
                                                "sense_id": "8ea6e1ee-c579-384f-b700-26fff67a9631",
                                                "text": "De même de nombreuses espèces de plantes produisent de la chaleur et certaines, telles Philodendron selloum et le chou puant (Symplocarpus fœtidus), conservent une température constante pendant plusieurs heures, voir plusieurs jours, malgré les températures changeantes du milieu : ces plantes sont dotées d'un système de thermorégulation."
                                            },
                                            {
                                                "example_id": "2a89d7b1-2a14-482e-8e2f-db31cbba5e75",
                                                "sense_id": "8ea6e1ee-c579-384f-b700-26fff67a9631",
                                                "text": "D'autres analyses ont révélé des variations génétiques associées à la vie dans l'Arctique, comme la pilosité, la thermorégulation ou les dépôts de graisse, suggérant que les mammouths étaient poilus bien avant l'apparition de leur congénère laineux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
