                "senses": [
                    {
                        "sense_id": "3ae18f86-ea3f-3f55-bf51-65f9493c8921",
                        "entry_id": "b9b9da8b-fa1a-3b4f-abe4-73cbac401b2a",
                        "glosses": [
                            "Salat, der aus klein geschnittenem Fleisch, Mayonnaise, Gurken und Gewürzen hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2ea20bf-854f-4005-b79e-f22c308a24d4",
                                "sense_id": "3ae18f86-ea3f-3f55-bf51-65f9493c8921",
                                "text": "„Fleischsalat, der ungeöffnet von der Silvesterparty übrig blieb, konnten wir auf der soliden Basis vollkommen legaler Konservierungsmittel noch im späten September unbedenklich zu uns nehmen.“"
                            },
                            {
                                "example_id": "740f43b7-0185-45b2-a961-0676e8e08793",
                                "sense_id": "3ae18f86-ea3f-3f55-bf51-65f9493c8921",
                                "text": "Fleischwurst und Mayonnaise sind die Hauptzutaten des klassischen Fleischsalates."
                            },
                            {
                                "example_id": "18675c8d-5173-4ce3-a054-5de89219a47f",
                                "sense_id": "3ae18f86-ea3f-3f55-bf51-65f9493c8921",
                                "text": "„Es gab eine große Portion Fleischsalat und zwei Scheiben Graubrot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
