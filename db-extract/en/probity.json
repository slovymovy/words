                    },
                    {
                        "translation_id": "6a082f12-5d52-4296-8a78-5226a2893764",
                        "source_entry_id": "69fc911c-570e-3200-9cc9-da8e8a9ef69e",
                        "source_sense_id": "e207721c-f779-32d4-9d65-293174ce5bce",
