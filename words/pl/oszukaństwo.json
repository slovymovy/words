    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73447e71-d706-3f62-b176-bab38326c501",
                    "sense_definition": "Wprowadzenie kogoś w błąd dla uzyskania korzyści; nieuczciwe postępowanie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fraud_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To, co zrobili z naszymi pieniędzmi, to zwykłe <w>oszukaństwo</w>.",
                            "target_lang_translations": {
                                "ru": "То, что они сделали с нашими деньгами, — это обычное <w>мошенничество</w>."
                            }
                        },
                        {
                            "text": "Nie zamierzam brać udziału w tym <w>oszukaństwie</w>, nawet jeśli dobrze mi zapłacą.",
                            "target_lang_translations": {
                                "ru": "Я не собираюсь участвовать в этом <w>жульничестве</w>, даже если мне хорошо заплатят."
                            }
                        }
                    ],
                    "synonyms": [
                        "oszustwo",
                        "szachrajstwo",
                        "krętactwo"
                    ],
                    "antonyms": [
                        "uczciwość"
                    ],
                    "common_phrases": [
                        "zwykłe oszukaństwo",
                        "jawne oszukaństwo",
                        "małe oszukaństwo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Введение кого-либо в заблуждение ради выгоды; нечестный поступок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мошенничество",
                                "target_lang_sense_clarification": "преступление, хищение чужого имущества путем обмана"
                            },
                            {
                                "target_lang_word": "обман",
                                "target_lang_sense_clarification": "введение в заблуждение, ложь"
                            },
                            {
                                "target_lang_word": "жульничество",
                                "target_lang_sense_clarification": "плутовство, мелкое мошенничество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58c23ad3-98e9-3001-bc20-eee5620ae737",
                    "sense_definition": "Rzecz, sytuacja lub zjawisko, które jest nieprawdziwe, pozorne lub oparte na fałszu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fraud_sham",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Całe to ich idealne małżeństwo okazało się jednym wielkim <w>oszukaństwem</w>.",
                            "target_lang_translations": {
                                "ru": "Весь этот их идеальный брак оказался одним сплошным <w>обманом</w>."
                            }
                        },
                        {
                            "text": "Te wszystkie obietnice wyborcze to czyste <w>oszukaństwo</w>, nikt nie zamierza ich spełnić.",
                            "target_lang_translations": {
                                "ru": "Все эти предвыборные обещания — чистой воды <w>обман</w>, никто не собирается их выполнять."
                            }
                        }
                    ],
                    "synonyms": [
                        "kłamstwo"
                    ],
                    "antonyms": [
                        "rzeczywistość",
                        "fakt"
                    ],
                    "common_phrases": [
                        "wielkie oszukaństwo",
                        "oszukaństwo zmysłów"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто ненастоящее, мнимое или основанное на лжи; фикция."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фикция",
                                "target_lang_sense_clarification": "нечто мнимое, выдаваемое за действительное"
                            },
                            {
                                "target_lang_word": "обман",
                                "target_lang_sense_clarification": "иллюзия, то, что кажется, но не существует"
                            },
                            {
                                "target_lang_word": "фальшь",
                                "target_lang_sense_clarification": "подделка, неискренность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}