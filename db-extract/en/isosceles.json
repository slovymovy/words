    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1e295140-53cf-34ea-9875-3a00d8920781",
                "word": "isosceles",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c5279fd4-ddc6-3bf3-a101-2292fc63d26f",
                        "entry_id": "1e295140-53cf-34ea-9875-3a00d8920781",
                        "glosses": [
                            "Having (at least) two sides of equal length, used especially of a triangle or trapezoid."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "67dcd8b9-0610-4aae-be92-2fe21d657c69",
                                "sense_id": "c5279fd4-ddc6-3bf3-a101-2292fc63d26f",
                                "text": "Upon each exterior side draw an Isosceles Triangle of 480 Fathoms."
                            },
                            {
                                "example_id": "883b2e09-8eb9-4ea5-bcea-558880e8fdd4",
                                "sense_id": "c5279fd4-ddc6-3bf3-a101-2292fc63d26f",
                                "text": "A right double pyramid is isosceles when the extremities of the vertex-edge are at the same distance from the plane of the base."
                            },
                            {
                                "example_id": "0172bf9c-b7e7-41e0-8e57-d7ed941c6fb5",
                                "sense_id": "c5279fd4-ddc6-3bf3-a101-2292fc63d26f",
                                "text": "To prepare for the application of his method, Saccheri made use of a figure with which we are already acquainted. This is the isosceles quadrilateral with the two base angles right angles."
                            },
                            {
                                "example_id": "39d4d8fd-80e5-4492-8e6c-671686cf9147",
                                "sense_id": "c5279fd4-ddc6-3bf3-a101-2292fc63d26f",
                                "text": "The polygon advantageously is an isosceles trapezoid or rectangle with the pivotal connections between the deck or superstructure and four hulls respectively at its corners."
                            },
                            {
                                "example_id": "1e79de50-0ca8-4cb6-8335-84ea0225ee84",
                                "sense_id": "c5279fd4-ddc6-3bf3-a101-2292fc63d26f",
                                "text": "The flowers were stuck inside a flower pot that was shaped like an isosceles polygon with a rectangular \"edge.\""
                            }
                        ]
                    }
                ],
