                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea87afd7-0e69-401a-a465-6346669fed31",
                                "sense_id": "d1df6828-d7b7-3b27-b600-38c1b253e74a",
                                "text": "Omdat hij niet gewend was op mocassins te lopen, had hij op het schelpenpad wel wat last van zijn voeten."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d1e9f15-3d83-36cd-a3f5-da0f6f1c57f0",
                        "entry_id": "23ac8405-09c0-3fff-b8a9-7e7c9e7c2aac",
                        "glosses": [
                            "een leren lage schoen, zonder veters"
                        ],
