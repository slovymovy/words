                    "semantic_group_id": "acronym_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company installed a new <w>DID</w> system to allow direct calls to employees.",
                            "target_lang_translations": {
                                "ru": "Компания установила новую систему <w>прямого набора</w>, чтобы позволить звонить сотрудникам напрямую.",
                                "es": "La empresa instaló un nuevo sistema de <w>marcación directa entrante</w> para permitir llamadas directas a los empleados."
                            }
                        },
                        {
                            "text": "Using <w>DID</w> numbers can reduce the workload on the main switchboard operator.",
                            "target_lang_translations": {
                                "ru": "Использование номеров <w>прямого набора</w> может снизить нагрузку на главного оператора коммутатора.",
                                "es": "Usar números de <w>marcación directa</w> puede reducir la carga de trabajo del operador de la centralita principal."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"прямой входящий набор\" (в телефонии).",
                        "es": "Sigla en inglés de \"direct inward dialing\" (marcación directa entrante)."
                    },
                    "translations": {
