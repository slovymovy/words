            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0cc44db0-1d36-3616-9f8c-7f0e5ed8ba17",
                    "sense_definition": "The collection of words a person knows and uses.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lexicon_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My Russian <w>vocabulary</w> is very limited.",
                            "target_lang_translations": {
                                "ru": "Мой <w>словарный запас</w> в русском языке очень ограничен.",
                                "zh": "我的俄语<w>词汇量</w>非常有限。"
                            }
                        },
                        {
                            "text": "Reading books is a great way to expand your <w>vocabulary</w>.",
                            "target_lang_translations": {
                                "ru": "Чтение книг — отличный способ расширить свой <w>словарный запас</w>.",
                                "zh": "阅读书籍是扩大<w>词汇量</w>的好方法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lexicon"
                    ],
                    "common_phrases": [
                        "expand vocabulary",
                        "limited vocabulary",
                        "active vocabulary",
                        "improve vocabulary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность слов, которые знает и использует отдельный человек.",
                        "zh": "一个人所掌握并使用的词汇总量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "словарный запас",
                                "target_lang_sense_clarification": "запас слов, которыми владеет человек"
                            },
                            {
                                "target_lang_word": "лексикон",
                                "target_lang_sense_clarification": "индивидуальный набор слов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "词汇量",
                                "target_lang_sense_clarification": "个人掌握的词汇总数"
                            },
                            {
                                "target_lang_word": "词汇",
                                "target_lang_sense_clarification": "个人使用的词汇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1590ced2-0718-38d4-9140-0894ff0ecb2e",
                    "sense_definition": "A usually alphabetized and explained collection of words, often prepared for learning or specific to a book.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "list_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a useful <w>vocabulary</w> at the back of the textbook.",
                            "target_lang_translations": {
                                "ru": "В конце учебника есть полезный <w>словарь</w>.",
                                "zh": "教科书后面有一个很有用的<w>词汇表</w>。"
                            }
                        },
                        {
                            "text": "The teacher gave us a <w>vocabulary</w> to memorize for the exam.",
                            "target_lang_translations": {
                                "ru": "Учитель дал нам <w>список слов</w> для заучивания к экзамену.",
                                "zh": "老师给了我们一份考试要背的<w>生词表</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dictionary",
                        "glossary",
                        "wordlist"
                    ],
                    "common_phrases": [
                        "vocabulary list",
                        "vocabulary book"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список слов, обычно упорядоченный по алфавиту и снабженный пояснениями, часто для учебных целей.",
                        "zh": "通常按字母顺序排列并附有解释的词汇集合，常用于学习或特定书籍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "словарь",
