                                    {
                                        "sense_id": "4440d7ec-4f09-3923-b56d-5bf1262c2b82",
                                        "entry_id": "0b07efa5-8b1c-3583-880a-01a866b1d7cf",
                                        "glosses": [
                                            "A town in which the military is stationed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "576bfc18-5c21-4dd2-b734-2fc43c667cfc",
                                                "sense_id": "4440d7ec-4f09-3923-b56d-5bf1262c2b82",
                                                "text": "Hun-ch'un is essentially a garrison town, though there are a few dealers in seaweed, toadstools, and medicinal roots, large quantities of which are sent to Ninguta and Kirin, and thence to all parts of China."
                                            }
