                ],
                "senses": [
                    {
                        "sense_id": "1cbba23c-27d8-30cf-8b67-0c63100ec476",
                        "entry_id": "43bf0a57-3534-3519-8d2a-3c93e3404db6",
                        "glosses": [
                            "een gemotoriseerd voertuig op twee of drie wielen (met een cilinderinhoud groter dan 50 cc indien het een verbrandingsmotor betreft)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a6011a6-ded3-4819-9237-8fa6862d14ea",
                                "sense_id": "1cbba23c-27d8-30cf-8b67-0c63100ec476",
                                "text": "In Tain l'Hermitage wordt elk jaar zo'n file nagebootst met klassieke voertuigen. Vaak dragen chauffeurs en passagiers kleding uit de jaren vijftig en zestig, terwijl ze begeleid worden door gendarmes in originele uniformen, op klassieke motorfietsen. Van levensader tot nostalgisch themapark, een zwartkijker zou in de Nationale 7 een metafoor voor Frankrijk kunnen zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80a5444f-0f6c-496a-a6ae-a9a1ce78aad2",
                        "source_entry_id": "43bf0a57-3534-3519-8d2a-3c93e3404db6",
                        "source_sense_id": "1cbba23c-27d8-30cf-8b67-0c63100ec476",
                        "target_lang_word": "Motorrad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Motorrad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "782d42c9-d816-387f-a0b0-91cfbbaaef36",
                                        "entry_id": "510d7e44-7f7f-372b-bf30-e44af4f17092",
                                        "glosses": [
                                            "zweirädriges, einspuriges Fahrzeug mit Antriebsmotor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74cec6de-8da7-4baa-b6bd-9d1b4241beae",
                                                "sense_id": "782d42c9-d816-387f-a0b0-91cfbbaaef36",
                                                "text": "Das Motorrad stand mitten im Weg."
                                            },
                                            {
                                                "example_id": "fab983d6-6f19-4f4d-bab6-63a1b2a53e72",
                                                "sense_id": "782d42c9-d816-387f-a0b0-91cfbbaaef36",
                                                "text": "„Und während in den Fünfzigern Motorräder fast immer schwarz waren, so fällt die Herz-Kronen-Vespa schon dadurch auf, dass sie weiß ist.“"
                                            },
                                            {
                                                "example_id": "e164d7a6-9002-495c-9b18-7b0c4309fee6",
                                                "sense_id": "782d42c9-d816-387f-a0b0-91cfbbaaef36",
                                                "text": "„Siavasch schaute zu mir rüber und übersah dabei die vierköpfige Familie, die auf einem Motorrad auf die Kreuzung zusteuerte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdf79b7a-00bc-4a0b-b1a7-c8549d4b9a03",
                        "source_entry_id": "43bf0a57-3534-3519-8d2a-3c93e3404db6",
                        "source_sense_id": "1cbba23c-27d8-30cf-8b67-0c63100ec476",
                        "target_lang_word": "motorcycle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motorcycle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "909dfb2c-b535-3c90-9c61-44deac7c2321",
                                        "entry_id": "fd771cbc-a0aa-3292-ae23-e244fd87c508",
                                        "glosses": [
                                            "An open-seated motor vehicle with handlebars instead of a steering wheel, and having two (or sometimes three) wheels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ccff51-dec1-46a0-aa18-375e64215c7a",
                                                "sense_id": "909dfb2c-b535-3c90-9c61-44deac7c2321",
                                                "text": "Her big mission is to recover the precious Blue Star (a glowing rock in a box), which leads to a Western shoot-out, a space-age motorcycle gang, and an unamusing Darth Vader-esque villain."
                                            },
                                            {
                                                "example_id": "46acbbac-bc09-409c-832e-7300790dd444",
                                                "sense_id": "909dfb2c-b535-3c90-9c61-44deac7c2321",
                                                "text": "That last problem did intrude on Hazzard’s roamings, and when she refers to the living city it is with periodic references to thefts of cars and wallets, with a warning not to carry anything “snatchable” by the thieves on motorcycles who whiz through the streets."
                                            },
                                            {
                                                "example_id": "b293e0a2-f640-4a0b-aff5-de202aefd45b",
                                                "sense_id": "909dfb2c-b535-3c90-9c61-44deac7c2321",
                                                "text": "Vern rubbed her hands along the motorcycles, admiring their size and power, their silver and black sleekness."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "motorcycle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2880c684-9101-3883-9eed-01c3171a9641",
                                        "entry_id": "872565ad-1305-38c0-886d-6b11a1a9e44f",
                                        "glosses": [
                                            "To ride a motorcycle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6a23a94-8e61-40a2-9620-ea847afa9f75",
                        "source_entry_id": "43bf0a57-3534-3519-8d2a-3c93e3404db6",
                        "source_sense_id": "1cbba23c-27d8-30cf-8b67-0c63100ec476",
                        "target_lang_word": "moto",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8029c31-37e8-34d5-9a55-761d84672495",
                                        "entry_id": "0cbb4a07-37af-34cc-b922-0fa9c371ac11",
                                        "glosses": [
                                            "Véhicule motorisé à deux roues de puissance suffisante pour rouler sur les mêmes routes que les automobiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d48ba7a-8ada-4235-ac00-762f68ac5d05",
                                                "sense_id": "b8029c31-37e8-34d5-9a55-761d84672495",
                                                "text": "Les garçons sont plus fréquemment victimes des accidents de la route. Ils circulent plus à moto (donc sans les carrosseries protectrices de voitures) que les filles."
                                            },
                                            {
                                                "example_id": "d1028314-32ee-44f4-bebb-cc24a74c1007",
                                                "sense_id": "b8029c31-37e8-34d5-9a55-761d84672495",
                                                "text": "En général, le jeune coq habite une achélème, circule en moto (en 4x4 dans Urgence), porte tee-shirt, santiags et perfecto."
                                            },
                                            {
                                                "example_id": "afdf893c-a740-41b1-a299-14ff9df8803f",
                                                "sense_id": "b8029c31-37e8-34d5-9a55-761d84672495",
                                                "text": "La moto nᵒ 333, pilotée notamment par le Français Erwan Nigon a bénéficié, dans le final, des soucis techniques de ses deux rivales pour l’emporter."
                                            },
                                            {
                                                "example_id": "848aa83f-7c87-43fd-a950-52c3919ba410",
                                                "sense_id": "b8029c31-37e8-34d5-9a55-761d84672495",
                                                "text": "Deux motos sont entrées en collision."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
