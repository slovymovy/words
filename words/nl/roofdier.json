    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62583611-9b9c-37ad-9d41-a71f49bc7ac6",
                    "sense_definition": "Een dier dat op andere dieren jaagt en ze doodt om op te eten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "predatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leeuw is een gevaarlijk <w>roofdier</w> dat op de savanne leeft.",
                            "target_lang_translations": {
                                "en": "The lion is a dangerous <w>predator</w> that lives on the savannah."
                            }
                        },
                        {
                            "text": "Kleine vogels moeten altijd goed uitkijken voor een <w>roofdier</w> in de buurt.",
                            "target_lang_translations": {
                                "en": "Small birds must always watch out for a <w>predator</w> nearby."
                            }
                        }
                    ],
                    "synonyms": [
                        "vleeseter",
                        "carnivoor"
                    ],
                    "antonyms": [
                        "prooidier"
                    ],
                    "common_phrases": [
                        "gevaarlijk roofdier",
                        "natuurlijk roofdier"
                    ],
                    "target_lang_definitions": {
                        "en": "An animal that hunts and kills other animals for food."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "predator",
                                "target_lang_sense_clarification": "general biological term"
                            },
                            {
                                "target_lang_word": "beast of prey",
                                "target_lang_sense_clarification": "often used for larger carnivorous mammals"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6028107b-f260-3db8-841b-8265927c8208",
                    "sense_definition": "Een zoogdier dat behoort tot de biologische orde Carnivora.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niet elk <w>roofdier</w> uit de orde Carnivora eet uitsluitend vlees.",
                            "target_lang_translations": {
                                "en": "Not every <w>carnivoran</w> from the order Carnivora eats meat exclusively."
                            }
                        },
                        {
                            "text": "De beer is een bekend <w>roofdier</w> dat ook planten en bessen eet.",
                            "target_lang_translations": {
                                "en": "The bear is a well-known <w>carnivore</w> that also eats plants and berries."
                            }
                        }
                    ],
                    "synonyms": [
                        "carnivoor"
                    ],
                    "common_phrases": [
                        "orde der roofdieren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "wetenschappelijke context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A mammal belonging to the biological order Carnivora."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "carnivoran",
                                "target_lang_sense_clarification": "scientific term for members of the order Carnivora"
                            },
                            {
                                "target_lang_word": "carnivore",
                                "target_lang_sense_clarification": "member of the order Carnivora"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6058dcd-e384-3c40-bb82-8263435996be",
                    "sense_definition": "Een meedogenloos persoon die anderen misbruikt of uitbuit zonder medelijden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fraudeur gedroeg zich als een <w>roofdier</w> en beroofde arme mensen van hun spaargeld.",
                            "target_lang_translations": {
                                "en": "The fraudster behaved like a <w>predator</w> and robbed poor people of their savings."
                            }
                        },
                        {
                            "text": "In de zakenwereld wordt hij gezien als een <w>roofdier</w> dat over lijken gaat.",
                            "target_lang_translations": {
                                "en": "In the business world, he is seen as a <w>predator</w> who will stop at nothing."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich als een roofdier gedragen"
                    ],
                    "target_lang_definitions": {
                        "en": "A ruthless person who exploits or abuses others without mercy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "predator",
                                "target_lang_sense_clarification": "person who exploits others"
                            },
                            {
                                "target_lang_word": "beast of prey",
                                "target_lang_sense_clarification": "figurative use for a cruel person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
