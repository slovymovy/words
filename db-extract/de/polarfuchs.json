                        "glosses": [
                            "Fuchs, der im Winter weißes oder bläuliches Fell hat und der im Bereich der nördlichen Polargebiete verbreitet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "417ca811-5270-47c4-ab05-12963b8d9357",
                                "sense_id": "13e7ab99-1694-3835-9ea2-3fb6a7b85fc1",
                                "text": "„Am Abend gingen sie an Land, schlugen die Zelte auf und konnten noch in der Dämmerung zwei Polarfüchse erlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
