                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f18b11b5-d675-4527-948a-c398c6754c4c",
                        "source_entry_id": "cbd4f159-67c9-34e2-aedb-28cb02cc9481",
                        "source_sense_description": "chef, commandeur arabe",
                        "target_lang_word": "kaid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kaid",
