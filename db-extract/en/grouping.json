                    }
                ],
                "senses": [
                    {
                        "sense_id": "3318c6e6-7f35-3a46-9ab7-4ec1d4ec8aca",
                        "entry_id": "8163b1d4-f802-36e8-8509-62d612746a18",
                        "glosses": [
                            "A collection of things or people united as a group."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "aaa143f5-d64e-40c8-9ac5-152d3b9d6757",
                                "sense_id": "3318c6e6-7f35-3a46-9ab7-4ec1d4ec8aca",
                                "text": "In bony, ribby regions of the earth, where at the base of high broken cliffs masses of rock lie strewn in fantastic groupings upon the plain, you will often discover images as of the petrified forms of the Leviathan partly merged in grass, which of a windy day breaks against them in a surf of green surges."
                            }
                        ]
                    },
                    {
                        "sense_id": "574e3080-9eeb-3929-8bd8-fa9b2233a398",
                        "entry_id": "8163b1d4-f802-36e8-8509-62d612746a18",
                        "glosses": [
                            "Combining into groups."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "74b3bb62-7093-38f0-9b77-311bc850bff8",
                        "entry_id": "8163b1d4-f802-36e8-8509-62d612746a18",
                        "glosses": [
                            "Shot grouping."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44e04043-4f41-402d-941e-f17f2261f0f6",
                        "source_entry_id": "8163b1d4-f802-36e8-8509-62d612746a18",
                        "source_sense_description": "a collection of things or people",
                        "target_lang_word": "groepering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groepering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f461dcbf-fd8d-3a2d-b6ed-7e2b4162d4d9",
                                        "entry_id": "f8ee9cb9-22c6-39b3-8cc9-f1ebe3bddc77",
                                        "glosses": [
                                            "groep mensen met een gedeelde overtuiging of mening"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43308b85-667a-4321-9a21-407e92aa62e3",
                                                "sense_id": "f461dcbf-fd8d-3a2d-b6ed-7e2b4162d4d9",
                                                "text": "Tussen de verschillende gewapende groeperingen barstte de strijd los."
                                            },
                                            {
                                                "example_id": "c52d0f23-3446-4cde-ba43-bd7b7b69af8c",
                                                "sense_id": "f461dcbf-fd8d-3a2d-b6ed-7e2b4162d4d9",
                                                "text": "Hij behoort niet tot een politieke groepering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c975efc0-69ec-3262-b2e0-93a15a75d3c2",
                                        "entry_id": "f8ee9cb9-22c6-39b3-8cc9-f1ebe3bddc77",
                                        "glosses": [
                                            "het groeperen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a640beab-6db6-4727-bfae-24e27932f8de",
                                                "sense_id": "c975efc0-69ec-3262-b2e0-93a15a75d3c2",
                                                "text": "Hij gebruikt deze methode voor de groepering van de verschillende gegevens in een aantal klassen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b8334d0-0683-40fe-974e-429f28fc8f79",
                        "source_entry_id": "8163b1d4-f802-36e8-8509-62d612746a18",
                        "source_sense_description": "a collection of things or people",
                        "target_lang_word": "groupement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groupement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "742ced69-ac6a-3849-aab9-a8c0aedfcbdd",
                                        "entry_id": "9147526d-fe68-35bc-b6fd-17e1213675b1",
                                        "glosses": [
                                            "Action de grouper."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59bff5a5-dff8-45df-8258-21285ed311c2",
                                                "sense_id": "742ced69-ac6a-3849-aab9-a8c0aedfcbdd",
                                                "text": "Je me demandais avec inquiétude si elle [notre extrême gauche] tiendrait assez longtemps pour me permettre de réaliser le nouveau groupement de nos forces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84e89469-251b-3a20-9a0d-5608b04a6912",
                                        "entry_id": "9147526d-fe68-35bc-b6fd-17e1213675b1",
                                        "glosses": [
                                            "État de ce qui est groupé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62eb975-14a7-47f6-a550-7cf1ccc6dc52",
                                                "sense_id": "84e89469-251b-3a20-9a0d-5608b04a6912",
                                                "text": "S'il existe un groupement gallo-romain d'habitats à Montsort, à la fin de l'Antiquité, il est possible que Saint-Pierre soit un édifice christianisé, un fanum ou une autre construction de qualité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d432edb2-783c-33aa-9fff-c06ec9981119",
                                        "entry_id": "9147526d-fe68-35bc-b6fd-17e1213675b1",
                                        "glosses": [
                                            "Unité de végétation établie à partir de dénombrements floristiques sur un espace déterminé."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56928b3c-7461-4f9a-accc-f27ad34a5e85",
                                                "sense_id": "d432edb2-783c-33aa-9fff-c06ec9981119",
                                                "text": "La bruyère spongieuse à Erica Tetralix est souvent en continuité avec des petits îlots de l’association à Schœnus […] et l’on constate alors, à la marge des deux groupements un mélange de leurs éléments respectifs."
                                            },
                                            {
                                                "example_id": "40507c6b-a3f7-4d71-b62e-338cd131ab11",
                                                "sense_id": "d432edb2-783c-33aa-9fff-c06ec9981119",
                                                "text": "De tous les botanistes qui, de RENAUD à BONATI et à CARDOT, se sont occupés de la flore haut-saônoise, aucun n’orienta ses recherches vers l’étude des groupements ; tous se contentèrent d’établir des listes floristico-écologiques qu’ils complétaient d’année en année au fur et à mesure que se poursuivaient leurs investigations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edf2b873-cef1-317c-81a1-0fe47184b9ca",
                                        "entry_id": "9147526d-fe68-35bc-b6fd-17e1213675b1",
                                        "glosses": [
                                            "Société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a59525c3-0a8a-44d9-9def-c5966b93e7c1",
                                                "sense_id": "edf2b873-cef1-317c-81a1-0fe47184b9ca",
                                                "text": "Il faudra donc profiter de la dénationalisation pour « déconglomérer » ces groupements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54180c94-e1e8-3940-9b15-a7b50f6b9aad",
                                        "entry_id": "9147526d-fe68-35bc-b6fd-17e1213675b1",
                                        "glosses": [
                                            "(Stricto sensu) Ensemble d'atomes constituant une partie significative et identifiable d'une molécule, pouvant inclure un ou plusieurs groupes fonctionnels, et que l'on retrouve de manière récurrente comme élément structurel dans plusieurs composés chimiques analogues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c58c8cc2-1970-4f9d-be6f-3306c66b7505",
                                                "sense_id": "54180c94-e1e8-3940-9b15-a7b50f6b9aad",
                                                "text": "… Cependant, les groupements chimiques utilisés sont rarement intégrés par les enzymes … du groupement phosphodiester est substitué par, respectivement, un soufre et un …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "630c97fe-e20c-3df3-b366-f4ae0cdfd8d1",
                                        "entry_id": "9147526d-fe68-35bc-b6fd-17e1213675b1",
                                        "glosses": [
                                            "(Lato sensu) Groupe d’atomes chimiquement liés formant une portion identifiable d’une molécule ou d’une famille de molécules."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8453e349-f971-4f39-8cb9-def0281f36c8",
