                "senses": [
                    {
                        "sense_id": "807adc77-878f-33b1-9d35-ea153de61230",
                        "entry_id": "8efdaf6b-e531-3a20-b557-30548b6bd567",
                        "glosses": [
                            "образование плотного материала из рыхлого (шерсти, ваты) под нагрузкой"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8364e7e6-764e-341e-aa08-eb2797bb005c",
                        "entry_id": "8efdaf6b-e531-3a20-b557-30548b6bd567",
                        "glosses": [
                            "авиац. режим полёта, в котором из-за отрыва потока происходит резкое падение подъёмной силы и увеличение аэродинамического сопротивления крыла"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66876fd-aa6d-4c66-a5ec-4323f587333d",
                                "sense_id": "8364e7e6-764e-341e-aa08-eb2797bb005c",
                                "text": "Пилот не заметил падения скорости и допустил сваливание."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f253a2d6-dd33-4d5e-bcec-8e620026dff3",
                        "source_entry_id": "8efdaf6b-e531-3a20-b557-30548b6bd567",
                        "source_sense_description": "режим полёта",
                        "target_lang_word": "décrochage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décrochage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d52eceba-469a-3589-9c0b-7821b8de5100",
                                        "entry_id": "0e93b159-45f0-3499-bec6-de06eff3fc77",
                                        "glosses": [
                                            "Action de décrocher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c0ba715-d751-4722-901e-0b0774116a83",
                                                "sense_id": "d52eceba-469a-3589-9c0b-7821b8de5100",
                                                "text": "Le décrochage d’un tableau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94fc9689-f7d6-3eba-b884-9f49202375cd",
                                        "entry_id": "0e93b159-45f0-3499-bec6-de06eff3fc77",
                                        "glosses": [
                                            "Dans le monde de la peinture, cérémonie de clôture d’une exposition."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda10287-9263-488b-bbf2-2f6c5b1490a1",
                                                "sense_id": "94fc9689-f7d6-3eba-b884-9f49202375cd",
                                                "text": "Pourquoi est-ce qu’un morceau de musique pourrait être joué plusieurs fois, et de manière différente selon le chef d’orchestre, et une exposition serait condamnée à disparaître le jour de son décrochage ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca35b07a-460b-3a5d-aa93-820e540fcf28",
                                        "entry_id": "0e93b159-45f0-3499-bec6-de06eff3fc77",
                                        "glosses": [
                                            "Abandon, par un élève ou par un étudiant en difficulté, d’une formation ou d’une qualification avant son terme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dbeac1e-37fc-4f90-b784-6d50ecc95b28",
                                                "sense_id": "ca35b07a-460b-3a5d-aa93-820e540fcf28",
                                                "text": "Le décrochage scolaire est l’abandon prématuré des études scolaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b888c53-0b16-3bd6-96cc-6765eea9459a",
                                        "entry_id": "0e93b159-45f0-3499-bec6-de06eff3fc77",
                                        "glosses": [
                                            "Perte brusque de la portance de l’aile d’un avion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1d5e1be-6af9-4a6a-a740-d1d71429f868",
                                                "sense_id": "9b888c53-0b16-3bd6-96cc-6765eea9459a",
                                                "text": "Jusqu'à présent, et dès le début, les autorités égyptiennes, comme la plupart des experts, laissent entendre que la piste de l'attentat est la plus probable, en raison du \"décrochage\" spectaculaire de l'avion."
                                            },
                                            {
                                                "example_id": "5d24fd70-c5a4-444b-879f-3c8055dc1767",
                                                "sense_id": "9b888c53-0b16-3bd6-96cc-6765eea9459a",
                                                "text": "L’analyse des boîtes noires de l’appareil, repêchées un mois plus tard, a confirmé que les pilotes, désorientés par le givrage des sondes de vitesse Pitot, n’ont pu rattraper le décrochage de l’appareil, qui a eu lieu en moins de cinq minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d615d5-825c-3ada-9321-c68c83e2eb56",
                                        "entry_id": "0e93b159-45f0-3499-bec6-de06eff3fc77",
                                        "glosses": [
                                            "Brusque perte d’adhérence d’une automobile, notamment dans un virage, entraînant un tête-à-queue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "658f1752-4701-3f29-99e8-69b04f0f1f45",
                                        "entry_id": "0e93b159-45f0-3499-bec6-de06eff3fc77",
                                        "glosses": [
                                            "Passage de la transmission du niveau national au niveau local."
                                        ],
                                        "tags": [
                                            "Radio télévision"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aae7e5c0-2814-4938-a6d2-07138f1770c1",
                                                "sense_id": "658f1752-4701-3f29-99e8-69b04f0f1f45",
                                                "text": "Pour la publicité, les deux premières minutes sont nationales, puis c’est le décrochage de la pub locale pendant trente secondes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
