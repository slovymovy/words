                "translations": [
                    {
                        "translation_id": "4cf157f4-9583-4bfd-9bae-f3970a73486d",
                        "source_entry_id": "4441c582-d6fa-3351-b987-deed85169634",
                        "source_sense_id": "34d394a1-acb0-38c7-9ead-75d6c82ad555",
                        "target_lang_word": "Blütezeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blütezeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f314e2f-ed76-3a6d-8ea6-0ec4620f0bca",
                                        "entry_id": "f5bcacda-ac53-3877-893a-16271f59400f",
                                        "glosses": [
                                            "a) die Entwicklung einer einzelnen Blüte (Anthese), b) eines bestimmtes Pflanzenexemplares oder c) einer Pflanzenart in einem bestimmten Gebiet (Phänologie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fddbbfb-b01c-4e02-8c1c-f6cdd10c6920",
                                                "sense_id": "7f314e2f-ed76-3a6d-8ea6-0ec4620f0bca",
                                                "text": "„Die Blütezeit beginnt bei der Windbestäubung vor der Blattentwicklung […] und dauert von mehreren Wochen bis wenige Stunden, letzteres beispielsweise bei der „Königin der Nacht“.“ (Anthese)"
                                            },
                                            {
                                                "example_id": "a0ab9d92-696b-4269-b8c0-c71dc461ccf3",
                                                "sense_id": "7f314e2f-ed76-3a6d-8ea6-0ec4620f0bca",
                                                "text": "„Die Blütezeit der Art […] liegt im Frühling zwischen Ende April und Mitte Mai […].“ (Phänologie)"
                                            },
                                            {
                                                "example_id": "15af52b0-5248-4ec2-9b5d-eaf2f3e6f9a3",
                                                "sense_id": "7f314e2f-ed76-3a6d-8ea6-0ec4620f0bca",
                                                "text": "die Blütezeit einer einzelnen Blüten dauert von mehreren Wochen bis wenige Stunden beispielsweise bei der „Königin der Nacht“.“ (Anthese)"
                                            },
                                            {
                                                "example_id": "1a1adb05-ee72-40bc-865d-a1ac0927f2a8",
                                                "sense_id": "7f314e2f-ed76-3a6d-8ea6-0ec4620f0bca",
                                                "text": "„Aus einem mit Tausenden von Touristen voll gestopften Amphitheater, das sich Nachtclub nennt, wird eine einbalsamierte Polizeistaatversion jener heißen karibischen Shows gesendet, die in der Blütezeit des organisierten Verbrechens die Leute mit den großen Scheinen anlockten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e47a1fcd-083a-3fbb-963f-c781bdd07a90",
                                        "entry_id": "f5bcacda-ac53-3877-893a-16271f59400f",
                                        "glosses": [
                                            "die Zeit, in der ein bestimmtes kulturelles Konstrukt (ein handwerkliches, künstlerisches, politisches, wissenschaftliches oder ähnliches Konstrukt) besonders gut entwickelt ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd465e95-25c0-4bcf-8743-24f22d300493",
                                                "sense_id": "e47a1fcd-083a-3fbb-963f-c781bdd07a90",
                                                "text": "„Das Ende der Blütezeit der irischen Klosterkultur kam mit der Wikingerzeit, die mit dem Überfall auf das Kloster Lindisfarne im Jahre 793 begann.“"
                                            },
                                            {
                                                "example_id": "43170cac-3d8a-4610-9cf3-cb2a2e808ceb",
                                                "sense_id": "e47a1fcd-083a-3fbb-963f-c781bdd07a90",
                                                "text": "„Irgendwann aber akzeptiert der jüngere Sohn die Königswürde doch, die Intrigen am Hof ebben ab, und das Edo-Reich geht einer weiteren Blütezeit mit neuen Eroberungen entgegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
