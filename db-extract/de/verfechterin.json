                        "examples": [
                            {
                                "example_id": "49dd8a09-e271-42a3-b170-20b30688a7a9",
                                "sense_id": "bab27abe-a523-315e-b339-fbbc3664c785",
                                "text": "„Sie, die Kommunistin, die wortgewaltige Verfechterin des Materialismus, lief mit einem Schutzzauber durch die Gegend.“"
                            },
                            {
                                "example_id": "2db22f0d-b088-46a0-b48d-58ddf46010f0",
                                "sense_id": "bab27abe-a523-315e-b339-fbbc3664c785",
                                "text": "„Seine Mutter, eine entschiedene und spitzzüngige Verfechterin des Empirismus, mit der er sein Leben lang zusammengelebt hatte, war einen Monat zuvor gestorben.“"
                            }
                        ],
