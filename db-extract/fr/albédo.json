        "fr-extract.jsonl": [
            {
                "entry_id": "74ae1f23-4042-3aa8-a32d-df4e0b60c051",
                "word": "albédo",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1b9e81bb-10a5-4cfc-a76d-38703dfda1de",
                        "entry_id": "74ae1f23-4042-3aa8-a32d-df4e0b60c051",
                        "tags": [
                            "plural"
                        ],
                        "form": "albédos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36a031cf-fe51-34cf-a140-f7aa5ea35efc",
                        "entry_id": "74ae1f23-4042-3aa8-a32d-df4e0b60c051",
                        "glosses": [
                            "Grandeur caractérisant la proportion d’énergie lumineuse réfléchie ou diffusée par un corps éclairé."
                        ],
                        "tags": [
                            "Planétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "85842cbb-bb2f-40d3-92a8-3c304329fea8",
                                "sense_id": "36a031cf-fe51-34cf-a140-f7aa5ea35efc",
                                "text": "Ces surfaces sombres, dénuées du pouvoir réfléchissant de la glace et qu’on appelle l’albédo, absorbent les rayons du Soleil qui réchauffent l’océan. Plus il capte la chaleur, plus il fait fondre la glace et plus il retarde la reprise du gel à l’arrivée de l’hiver."
                            },
                            {
                                "example_id": "21a08d79-acd1-4619-ba6b-0d6a51c2e1ff",
                                "sense_id": "36a031cf-fe51-34cf-a140-f7aa5ea35efc",
                                "text": "L’albédo planétaire dépend à la fois de l’albédo des surfaces et de la présence de nuages."
                            },
                            {
                                "example_id": "f4a2e29f-2ed9-4ce0-b382-cf9fa5add358",
                                "sense_id": "36a031cf-fe51-34cf-a140-f7aa5ea35efc",
                                "text": "L’albédo moyen terrestre est de 0,3 toutes surfaces confondues."
                            }
                        ]
                    },
                    {
                        "sense_id": "33106983-88c9-3acf-9963-4b052d09e18f",
                        "entry_id": "74ae1f23-4042-3aa8-a32d-df4e0b60c051",
                        "glosses": [
                            "Mésocarpe de couleur blanche des agrumes. (Face interne de la peau des agrumes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5def168-ba5e-419b-9be6-9f94027b8033",
                                "sense_id": "33106983-88c9-3acf-9963-4b052d09e18f",
                                "text": "La peau et l’albédo sont épais, la pulpe est riche en pépins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5040495-7681-41cd-8ff0-a5da8e1af4e5",
                        "source_entry_id": "74ae1f23-4042-3aa8-a32d-df4e0b60c051",
                        "target_lang_word": "Albedo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Albedo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8efaa4c-8dcd-3930-bb00-3353afb78c4b",
                                        "entry_id": "6dea59a1-1848-3ee3-95cd-23664be17e90",
                                        "glosses": [
                                            "Rückstrahlungsvermögen eines nicht strahlenden Körpers (auch Himmelskörpers), einer Fläche"
                                        ],
                                        "tags": [
                                            "Astrophysik",
                                            "Geophysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad84f8e4-178c-4e82-8b9d-da5c5447bee7",
                                                "sense_id": "e8efaa4c-8dcd-3930-bb00-3353afb78c4b",
                                                "text": "„Die Albedo ist vor allem in der Meteorologie von Bedeutung, wo sie Aussagen darüber ermöglicht, wie stark sich Luft über verschiedenen Oberflächen erwärmt.“"
                                            },
                                            {
                                                "example_id": "193b32f2-802d-47d5-a335-24152426a006",
                                                "sense_id": "e8efaa4c-8dcd-3930-bb00-3353afb78c4b",
                                                "text": "„Enceladus geometrischer Albedo liegt bei fast 1,4 – während die meisten anderen Eismonde des äußeren Sonnensystems auf nicht mehr als 0,2 bis 0,4 kommen.“"
                                            },
                                            {
                                                "example_id": "f2d99d93-74d3-4d0f-b099-3b56a8a9b664",
                                                "sense_id": "e8efaa4c-8dcd-3930-bb00-3353afb78c4b",
                                                "text": "„Russpartikel und Feinstaub färben das Eis dunkler und lassen es schneller schmelzen. Denn das Rückstrahlvermögen, Albedo genannt, ist ausschlaggebend für die Gletscherschmelze. Je dunkler die Oberfläche der Gletscher, desto weniger können Sonnenstrahlen zurückgeworfen werden. Das Eis erwärmt sich stärker, es schmilzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a62e2dec-e2e3-4b1a-b0ed-9a848f300eed",
                        "source_entry_id": "74ae1f23-4042-3aa8-a32d-df4e0b60c051",
