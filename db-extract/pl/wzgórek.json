                "translations": [
                    {
                        "translation_id": "1148cdce-461a-4f27-b28e-4787045da091",
                        "source_entry_id": "32b58565-9484-3bdc-9183-02c90aa4a98c",
                        "source_sense_id": "23f24f38-4b86-3295-8620-b8db9947c004",
                        "target_lang_word": "monticule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monticule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                        "entry_id": "c1e8aed1-ac7a-3df8-bc0e-bcde546e090e",
                                        "glosses": [
                                            "Petite montagne ; simple élévation de terrain ; tertre ; butte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f19653e-b648-4c90-9ba5-7163c34ce083",
                                                "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                                "text": "Sur les pentes de quelques monticules, le sol fut absolument raviné et la croûte blanche mise à nu."
                                            },
                                            {
                                                "example_id": "144cb64d-8568-4df1-aa57-ad464d5815e2",
                                                "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                                "text": "…je grimpai sur la dune la plus élevée de la région ; autour de moi, de tous côtés, je ne vis que la houle grise des monticules de sable."
                                            },
                                            {
                                                "example_id": "bec16642-7375-4581-8ed9-e405f1416326",
                                                "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                                "text": "Sous l'influence des courants, des vents, et des variations de température, de formidables pressions se produisent ; le soulèvement et le chevauchement de la glace donnent naissance à des monticules ou « hummocks »."
                                            },
                                            {
                                                "example_id": "6051d171-ac45-482f-94ef-c275692588d0",
                                                "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                                "text": "L'aspect actuel d'un monument mégalithique se dressant sur un monticule a donné à Schumacher et Karge la fausse impression que les dolmens furent construits au-dessus des tumulus."
                                            },
                                            {
                                                "example_id": "55d3cc30-aa48-423a-99f9-2494545e1fc6",
                                                "sense_id": "6cf5e9bb-8c97-3dca-9b41-740fb9e2e989",
                                                "text": "Un solarigraphe Volochine occupait le sommet d'un monticule à 150 m à l'Est de la baraque. De ce point l'horizon était dégagé dans tous les secteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fd68a98-28ca-3a66-beb5-91992e3d9846",
                                        "entry_id": "c1e8aed1-ac7a-3df8-bc0e-bcde546e090e",
                                        "glosses": [
                                            "Petite élévation du terrain sur laquelle se place le lanceur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f62a182-5d53-4c25-9df4-d78b44fc28f9",
                                                "sense_id": "9fd68a98-28ca-3a66-beb5-91992e3d9846",
                                                "text": "Les Torontois ont laissé le partant Chase Anderson œuvrer au monticule pendant trois manches et deux tiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bb14c28-44af-4fb2-93d9-84007b398151",
                        "source_entry_id": "32b58565-9484-3bdc-9183-02c90aa4a98c",
                        "source_sense_id": "23f24f38-4b86-3295-8620-b8db9947c004",
                        "target_lang_word": "Hügel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hügel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e87d039-4791-3787-8d4d-d5e3380349e1",
                                        "entry_id": "a271f4c2-8a84-31e5-9367-c5a35b7072f7",
                                        "glosses": [
                                            "Erhebung auf der Erdoberfläche unter etwa 300 Meter Höhe, meist von gerundeter Form"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "803ad489-650d-4a99-86bc-6346ea13a51f",
                                                "sense_id": "0e87d039-4791-3787-8d4d-d5e3380349e1",
                                                "text": "„Über eine Grasfläche erreichten Pencroff und seine Kameraden einen etwa 100 m hohen Hügel und sahen sich von seinem Gipfel aus die Umgebung an.“"
                                            },
                                            {
                                                "example_id": "401c7bce-53aa-4b13-a78d-a69d36ae46a2",
                                                "sense_id": "0e87d039-4791-3787-8d4d-d5e3380349e1",
                                                "text": "Durch die vielen Hügel ist das Radfahren ganz schön anstrengend."
                                            },
                                            {
                                                "example_id": "5712a8b5-21f3-4d33-8616-735e97090e3f",
                                                "sense_id": "0e87d039-4791-3787-8d4d-d5e3380349e1",
                                                "text": "„Nördlich von Cividale, auf dem Hügel San Mauro, wurde Ende des 20. Jahrhunderts eine große langobardische Nekropole freigelegt.“"
                                            },
                                            {
                                                "example_id": "76a294f2-e223-4596-abf3-4bde8bfdcc91",
                                                "sense_id": "0e87d039-4791-3787-8d4d-d5e3380349e1",
                                                "text": "„Das Haus seiner Eltern lag auf einem Hügel am Waldrand.“"
                                            },
                                            {
                                                "example_id": "af774789-2c1d-4039-8033-a3feaf42b39e",
                                                "sense_id": "0e87d039-4791-3787-8d4d-d5e3380349e1",
                                                "text": "„Noch war die aufgehende Sonne hinter dem benachbarten Hügel verborgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1f22c80e-bcf2-3503-a006-956d7fa4b810",
                                        "entry_id": "a271f4c2-8a84-31e5-9367-c5a35b7072f7",
                                        "glosses": [
                                            "ein künstlich angelegter Erdhaufen, der sowohl von Menschen als auch von Tieren (Maulwurfhügel) angelegt sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7876c81a-4b97-4b85-b04d-8fef3a4a26fc",
                                                "sense_id": "1f22c80e-bcf2-3503-a006-956d7fa4b810",
                                                "text": "Der Hügel auf dem Grab war schon eingesunken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
