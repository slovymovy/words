                ],
                "senses": [
                    {
                        "sense_id": "c540bd67-2968-3d71-b63d-0a52fbab4e91",
                        "entry_id": "5a21a628-6e45-3e86-b05d-f504f0de8b2b",
                        "glosses": [
                            "Ablauf, ein Geschehen, bei dem Ionisation stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eebe2db7-192a-4202-b106-f799140023f1",
                                "sense_id": "c540bd67-2968-3d71-b63d-0a52fbab4e91",
                                "text": "„In dem nachfolgenden Ionisationsvorgang werden von den Atomen jeweils ein oder mehrere Elektronen abgetrennt.“"
                            },
                            {
                                "example_id": "fc680a6d-fa17-401c-82d8-2df6cf8cef20",
                                "sense_id": "c540bd67-2968-3d71-b63d-0a52fbab4e91",
                                "text": "„Röntgenstrahlung hat folgende Eigenschaften: Sie ist wie Alpha-, Beta-, Gamma- und Neutronenstrahlung ionisierend, da sie Ionisationsvorgänge (Herauslösen von Elektronen) an Atomen und Molekülen in von ihr durchdrungener Materie auslösen kann.“"
                            },
                            {
                                "example_id": "b89e3506-a993-4e1d-9506-88c5e93a9ad7",
                                "sense_id": "c540bd67-2968-3d71-b63d-0a52fbab4e91",
                                "text": "„Ionisiertes Wasser, also reduziertes Wasser, das durch einen Ionisationsvorgang von seinen sauren Bestandteilen getrennt wurde, hat viele positive Eigenschaften.“"
                            },
                            {
                                "example_id": "37d2d81e-b202-455d-bd1e-f56789351de1",
                                "sense_id": "c540bd67-2968-3d71-b63d-0a52fbab4e91",
                                "text": "„Der Prozess der Kernumwandlung wird in der Regel als Kernzerfall und die abgegebene Strahlung - wegen ihrer Eigenschaft, bei der Durchdringung von Stoffen an Atomen und Molekülen Ionisationsvorgänge auszulösen - als ionisierende Strahlung bezeichnet.“"
                            },
                            {
                                "example_id": "17949e9e-93aa-4dad-bc38-d686fae8c360",
                                "sense_id": "c540bd67-2968-3d71-b63d-0a52fbab4e91",
                                "text": "„In der theoretischen Betrachtung der Ionisationsvorgänge reicht es deshalb oftmals aus, nur die Einfachionisation einzubeziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
