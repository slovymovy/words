                                    {
                                        "sense_id": "c9ff972f-6abe-3d2a-a9f2-4216a0ca9fa2",
                                        "entry_id": "e17777cd-2cff-3deb-80a4-f3af255f0d22",
                                        "glosses": [
                                            "Progrès successif des fruits vers la maturité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1e956e5-5078-4b1d-a705-b9c750159ae0",
                                                "sense_id": "c9ff972f-6abe-3d2a-a9f2-4216a0ca9fa2",
                                                "text": "Ce temps est contraire à la maturation des fruits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69965b42-be03-3e81-9caa-1aeaba0af616",
                                        "entry_id": "e17777cd-2cff-3deb-80a4-f3af255f0d22",
                                        "glosses": [
                                            "Évolution, en parlant des tumeurs purulentes."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6d1481b-22f2-484f-926a-5d6b3ce93721",
                                                "sense_id": "69965b42-be03-3e81-9caa-1aeaba0af616",
                                                "text": "La maturation d’un abcès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1363863a-892e-3a9b-9fd5-008f8d074823",
                                        "entry_id": "e17777cd-2cff-3deb-80a4-f3af255f0d22",
                                        "glosses": [
                                            "Évolution, en parlant des produits de la pensée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6615a887-7504-4b0f-ad9c-fca5f8502489",
                                                "sense_id": "1363863a-892e-3a9b-9fd5-008f8d074823",
                                                "text": "Il sait que le temps, qui hâte la dissolution des empires vermoulus et du vieux monde, hâte aussi l’enfantement du monde nouveau et la maturation de ces grandes idées d’union, d’harmonie, de justice, d’amour qui germent dans le sein de l’humanité. Pendant que l’orage se déchaîne et renverse, il fonde; pendant que l’oppression fauche, il sème."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb4f2d6c-8b0a-4fb7-93e0-d35dec19b8fc",
                        "source_entry_id": "7580ebe9-28f0-3409-aeb7-c91c31ceebfe",
                        "source_sense_description": "process of becoming mature",
                        "target_lang_word": "Reifung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reifung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                        "entry_id": "a51492df-9718-3bfe-a73d-ae23c4c8c559",
                                        "glosses": [
                                            "die Erlangung der Reife; die Wandlung zur Reife"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96881e51-5353-4602-bf79-34a2e2f60d1a",
                                                "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                                "text": "Bei fast allen anderen Käsesorten bewirken Enzyme des Labs oder Milchsäurebakterien die Reifung."
                                            },
                                            {
                                                "example_id": "3ba430a3-d8ef-4b3d-b7c3-d05b9ea61b27",
                                                "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                                "text": "„Das Team um Amparo Acker-Palmer konnte die molekularen Komponenten identifizieren, die nach anfänglicher Signalgebung die Reifung dendritischer Dornen kontrollieren.“"
                                            },
                                            {
                                                "example_id": "ac665f8f-04b4-407c-9cae-3d54f4e4bb63",
                                                "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                                "text": "Reifung ist ein vom Gehirn zentral gesteuerter Entwicklungsprozeß, der sich in der Vervollkommnung einer Handlung (Aktion) oder Fähigkeit ohne jede Übung zeigt."
                                            },
                                            {
                                                "example_id": "5a1778c1-94f7-461e-b78d-3a1d46f6817a",
                                                "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                                "text": "Heute manipulieren Obsthändler regelmäßig die Reifung von Früchten, die auf Ethylen reagieren."
                                            },
                                            {
                                                "example_id": "7e64bbba-70cb-4369-8d22-475babbf454f",
                                                "sense_id": "940a686c-7dc4-3f16-9a8c-23fa47574f29",
                                                "text": "Die Funktion als Reproduktionsorgane bei der Bildung und Reifung der Gameten hängt von der Bildung und Ausschüttung von Releasing-Hormonen und von in der Hypophyse freigesetzten Steuerungshormonen ab, die ihrerseits die Bildung von Sexualhormonen in den Gonaden anregen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
