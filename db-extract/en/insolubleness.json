                        "examples": [
                            {
                                "example_id": "09bedc2b-bb0c-4f06-a984-96d2cf10539e",
                                "sense_id": "4a252f0f-7ff6-3b2c-bf16-4682c87aab7b",
                                "text": "But that vve may the more diſtinctly conſider this grand argument, […] it vvill be convenient to obſerve, that it does, at once, both propoſe a queſtion, and contain an objection, grounded upon the ſurmiſed inſolubleneſs of that queſtion."
                            },
                            {
                                "example_id": "b41b6bfb-9a82-4121-a36d-a96199379ec5",
                                "sense_id": "4a252f0f-7ff6-3b2c-bf16-4682c87aab7b",
                                "text": "All his occasional pangs of dubiousness as to the grand governing thing of all—the reality of the physical relationship—only recoiled back upon him with added tribute of both certainty and insolubleness."
                            }
                        ]
