                        "glosses": [
                            "Annuler l’effet d’un court-circuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c6dcc72-a9c9-43db-8c4c-130504a7efdc",
                                "sense_id": "945f2644-16bf-317a-94bd-91266e02ae41",
                                "text": "Il faut se déshabituer, c’est-à-dire « décourtcircuiter » l’arc réflexe situé dans le bulbe : sensation de faim → prise de tel ou tel aliment en telle ou telle quantité."
                            },
                            {
                                "example_id": "a22c9e4d-589a-4c9d-9cdf-d04f60a3ac63",
                                "sense_id": "945f2644-16bf-317a-94bd-91266e02ae41",
                                "text": "Si la présence de points chauds est constatée, une réparation s’avère nécessaire pour décourtcircuiter les tôles entre elles."
                            },
                            {
                                "example_id": "0243518f-dbe7-4673-84e5-87a0d91de2da",
                                "sense_id": "945f2644-16bf-317a-94bd-91266e02ae41",
                                "text": "Le montage est celui de la fig. 4 où l’on reconnaît les éléments des fig. 2 et 3, avec le relais 1 pour décourtcircuiter le contact V à l’origine du temps et le relais 2 pour ouvrir le 70."
                            }
                        ]
                    }
