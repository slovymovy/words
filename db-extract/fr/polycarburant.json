                        "glosses": [
                            "Qui peut utiliser différents types de carburant pour fonctionner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11339cc5-5bae-4234-a863-5a40cb8a2eba",
                                "sense_id": "5bd50028-461d-3173-909e-932a743a4655",
                                "text": "La consommation supplémentaire d’éthanol devrait venir de l’augmentation du parc de véhicules polycarburant, d’où une baisse du ratio prix de l’éthanol/prix de l’essence à la consommation induite par la hausse de prix des RIN."
                            },
                            {
                                "example_id": "c184f3ec-b407-40c5-bd57-11866d927eb8",
                                "sense_id": "5bd50028-461d-3173-909e-932a743a4655",
                                "text": "L’adoption précoce de l’éthanol à base de sucre au Brésil pour les véhicules polycarburant a conduit à une forte covariation des prix du sucre, de l’éthanol et du pétrole brut."
                            }
                        ]
