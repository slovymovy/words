                "senses": [
                    {
                        "sense_id": "6b52ad6b-958d-3c3c-b215-8fb493008006",
                        "entry_id": "58806eb8-385c-32bd-a625-e75e840c2bdb",
                        "glosses": [
                            "osoba kierująca przebiegiem liturgii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4691b1f4-c8fa-497b-8496-6468e216460a",
                                "sense_id": "6b52ad6b-958d-3c3c-b215-8fb493008006",
                                "text": "Kościelny powiedział ceremoniarzowi o ornatach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "38667a17-d9e3-37d3-be2f-b7659af03bb1",
                        "entry_id": "58806eb8-385c-32bd-a625-e75e840c2bdb",
                        "glosses": [
                            "urzędnik koordynujacy przebieg uroczystości i ceremonii dworskich, mistrz ceremonii"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c87edf69-2816-486f-b28e-ed3293273ffb",
                                "sense_id": "38667a17-d9e3-37d3-be2f-b7659af03bb1",
                                "text": "Król bezgranicznie ufał nadwornemu ceremoniarzowi i nigdy się na nim nie zawiódł."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "d0deb0a7-1e19-3f42-b13c-039085838019",
                        "entry_id": "58806eb8-385c-32bd-a625-e75e840c2bdb",
                        "glosses": [
                            "zasady regulujące obchodzenie uroczystości"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ab4f5cab-879c-4b20-877e-890b861d856d",
                                "sense_id": "d0deb0a7-1e19-3f42-b13c-039085838019",
                                "text": "Zgodnie z przyjętym ceremoniarzem gości witano przed wejściem."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c355648-1767-4fdf-927b-8c05de697012",
                        "source_entry_id": "58806eb8-385c-32bd-a625-e75e840c2bdb",
                        "source_sense_id": "d0deb0a7-1e19-3f42-b13c-039085838019",
                        "target_lang_word": "ceremonial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceremonial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                                        "entry_id": "65b12aa8-1cc2-3494-a84e-9a94b4795d6b",
                                        "glosses": [
                                            "Of, relating to, consisting of, or used in a ceremony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d967dbb-ea02-4455-8862-e7373fb96f1c",
                                                "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                                                "text": "What mockery will it be / To want the bridegroom when the priest attends / To speak the ceremonial rites of marriage!"
                                            },
                                            {
                                                "example_id": "13a116a7-311e-44ea-8764-cc3da1e075c0",
                                                "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                                                "text": "His merit introduced him to ſplendid tables and elegant acquaintance, but he did not find himſelf alvvays qualified to join in the converſation. He vvas diſtreſſed by civilities, vvhich he knevv not hovv to repay, and entangled in many ceremonial perplexities, from vvhich his books and diagrams could not extricate him."
                                            },
                                            {
                                                "example_id": "924dacf6-f151-433a-9727-8b8f6b481add",
                                                "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                                                "text": "[T]his change in ceremonial observances and outward show was trifling when compared to that in the objects of worship […]"
                                            },
                                            {
                                                "example_id": "93726348-8cc3-4c92-a61c-f41af4fe2e3e",
                                                "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                                                "text": "Philomena Guinea's black Cadillac eased through the tight, five o'clock traffic like a ceremonial car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b833df27-f39c-3c84-975f-f33f1e7afd8b",
                                        "entry_id": "65b12aa8-1cc2-3494-a84e-9a94b4795d6b",
                                        "glosses": [
                                            "Used only for the purpose of ceremony; symbolic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db3f5c58-c9aa-3b8d-b67b-59b8dd0df4f5",
                                        "entry_id": "65b12aa8-1cc2-3494-a84e-9a94b4795d6b",
                                        "glosses": [
                                            "Synonym of ceremonious (“of a person: fond of ceremony or ritual, or of observing strict etiquette or formality; punctilious”)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f240d986-f258-4c0b-b9b7-5bb1a3e1fbac",
                                                "sense_id": "db3f5c58-c9aa-3b8d-b67b-59b8dd0df4f5",
                                                "text": "Oh monstrous, superstitious puritan, / Of refin’d manners, yet ceremoniall man, […]"
                                            },
                                            {
                                                "example_id": "e90ba969-10d1-4645-a83e-5574e40f6398",
                                                "sense_id": "db3f5c58-c9aa-3b8d-b67b-59b8dd0df4f5",
                                                "text": "[W]ith dumb Pride, and a set formal Face, / He moves, in the dull Ceremonial track, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ceremonial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                                        "entry_id": "1d8d1125-bf10-349f-8df8-5112728d81ef",
                                        "glosses": [
                                            "A ceremony, or series of ceremonies, prescribed by ritual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08325c05-a0d7-4fac-b8a9-d5cd70ad6f01",
                                                "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                                                "text": "Curt’sies, and the usual Ceremonials between Women who are Strangers to each other being past, Sophia said, ‘I have not the Pleasure to know you, Madam.’"
                                            },
                                            {
                                                "example_id": "2b08abd9-f4d9-4058-b0fe-7a74e92788b9",
                                                "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                                                "text": "Public ceremonies, such as ordinations, the installation of magistrates, and all that could give majesty to the forms in which a new government manifested itself to the people, were, as a matter of policy, marked by a stately and well-conducted ceremonial, and a sombre, but yet a studied magnificence."
                                            },
                                            {
                                                "example_id": "2883db88-8343-4a8a-b501-a9e7a87b38fd",
                                                "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                                                "text": "There was little ceremonial to mark the opening of the completed railway beyond the fact that a decorated train left Paddington at 8 a.m. on the morning of June 30 a hundred years ago and, passing the beflagged ends of Box tunnel, arrived at Bristol at noon."
                                            },
                                            {
                                                "example_id": "d4cc418f-f810-46ab-a9b4-8de52ffa84fd",
                                                "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                                                "text": "I have been in favour of ceremonial and patterns all my life, and I have no desire to break the funeral pattern."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
