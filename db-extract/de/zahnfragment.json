                "senses": [
                    {
                        "sense_id": "9653b139-aa06-3f6b-8fd4-5f5eda05003d",
                        "entry_id": "27dccaa8-3064-3ec3-be55-c7efdd047c67",
                        "glosses": [
                            "Teilstück eines Zahnes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eecf07ba-e028-4cb8-9da6-867b7bc12df1",
                                "sense_id": "9653b139-aa06-3f6b-8fd4-5f5eda05003d",
                                "text": "„Obwohl nur Knochen- und Zahnfragmente der Urmenschen erhalten geblieben sind, bieten sich Möglichkeiten, ihre Lebensweise zu interpretieren und zu rekonstruieren.“"
                            },
                            {
                                "example_id": "f8c576df-99bc-4093-a9d7-01034e88c662",
                                "sense_id": "9653b139-aa06-3f6b-8fd4-5f5eda05003d",
                                "text": "So sind acht Zähne beziehungsweise Zahnfragmente – vom Backenzahn bis hin zu einem Schneidezahn – erhalten, zudem ein Stück des Gaumendachs, der unteren Nasenhöhle sowie eines Wangenknochens."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
