                    "frequency": "Low",
                    "semantic_group_id": "karakterisering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij droeg haar <w>doordeweekse</w> kleren naar het chique feestje.",
                            "target_lang_translations": {
                                "en": "She wore her <w>everyday</w> clothes to the fancy party.",
                                "pl": "Założyła swoje <w>codzienne</w> ubrania na eleganckie przyjęcie."
                            }
                        },
                        {
                            "text": "Het was een heel <w>doordeweeks</w> gesprek over het weer en de boodschappen.",
                            "target_lang_translations": {
