                "senses": [
                    {
                        "sense_id": "ecc01ffd-3548-3306-8e2d-7a2cd47ade73",
                        "entry_id": "0c68e5ab-3c77-393a-b9c6-b75587dc60be",
                        "glosses": [
                            "Donner un caractère décennal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e5f2180-2b21-4805-9784-a54db1e70192",
                                "sense_id": "ecc01ffd-3548-3306-8e2d-7a2cd47ade73",
                                "text": "Les données sur l’évolution de l’emploi en Allemagne et au Royaume-Uni, qui portent sur la période 2005-2010, ont été « décennalisées » afin de correspondre à l’évolution nette de l’emploi sur la période 2000-2010."
                            },
                            {
                                "example_id": "88aee760-5b5e-4d51-9db9-9e0d6ba4edc2",
                                "sense_id": "ecc01ffd-3548-3306-8e2d-7a2cd47ade73",
                                "text": "Il pense que cela se traduira par une hausse massive du chômage, et propose comme solution alternative de réduire le temps de travail, et d’annualiser, voire de décennaliser les heures."
                            }
                        ]
                    }
