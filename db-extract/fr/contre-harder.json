                        "sense_id": "6f2cef60-2de6-3a44-a86d-09d9f59bf0c7",
                        "entry_id": "c9abdbb9-df4d-3ebd-b2f4-2afbc891cadc",
                        "glosses": [
                            "Cesser d’imposer aux chiens d’être en harde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a25f53a9-dfdf-4f8b-8ba1-8e24e8f32a6e",
                                "sense_id": "6f2cef60-2de6-3a44-a86d-09d9f59bf0c7",
                                "text": "Lors qu’un relais a beaucoup de chemin à faire pour rejoindre la chasse, on ôte la harde et on repasse la contre-harde au col d’un des deux chiens couplés ; par ce moyen, ne se trouvant plus que deux à deux, ils avancent plus aisément ; cela s’appelle encore déharder, et passer la contre-harde au col du chien, c’est contre-harder."
                            },
                            {
                                "example_id": "b2537c0d-3722-43f8-b007-e3cfbdd61710",
                                "sense_id": "6f2cef60-2de6-3a44-a86d-09d9f59bf0c7",
                                "text": "Contre-harder les chiens, c’est l’action de retirer les couples de chiens du trait auquel ils sont attachés, pour les remettre en couples, comme ils étaient avant d’avoir été hardés."
                            },
                            {
                                "example_id": "d4db0f4e-517b-4611-8c52-9cf9ce4993b9",
                                "sense_id": "6f2cef60-2de6-3a44-a86d-09d9f59bf0c7",
                                "text": "On contre-harde des chiens en leur passant la contre-harde au cou."
                            }
                        ]
                    }
                ],
