                                                "sense_id": "659790c9-871d-3443-b88c-ad11bbc115e5",
                                                "text": "Die alten Griechen sind mit einer Polacke über das Mittelmeer gesegelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
