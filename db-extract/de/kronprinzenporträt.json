                "senses": [
                    {
                        "sense_id": "a58cbece-87a7-3527-94f7-20754deb5290",
                        "entry_id": "f8a12603-7cc7-36a1-9bb6-42021eb2c5d3",
                        "glosses": [
                            "Darstellung (zum Beispiel Gemälde, Fotografie oder Skulptur), die einen Kronprinzen zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d06ffa3-9f24-46d4-8ebe-3fda4683349d",
                                "sense_id": "a58cbece-87a7-3527-94f7-20754deb5290",
                                "text": "„Vergleiche mit anderen Kronprinzenporträts Friedrichs II., die in großer Zahl erhalten geblieben sind, ermöglichen die Datierung des Ludwigsburger Porträttypus in die zweite Hälfte der 1730er-Jahre.“"
                            },
                            {
                                "example_id": "3e1514d3-aa69-4712-9fa2-578b8495a7d7",
                                "sense_id": "a58cbece-87a7-3527-94f7-20754deb5290",
                                "text": "„Für das Palais Lichtenau in Potsdam bestellte Friedrich Wilhelm II. 1797 eine Marmorausführug des Kronprinzenporträts […].“"
                            },
                            {
                                "example_id": "b06dc13f-bf30-4962-9ed2-1664b76a722e",
                                "sense_id": "a58cbece-87a7-3527-94f7-20754deb5290",
                                "text": "„Ein aufs Jahr 176/77 datierter Altar gibt einen jungen Mann wieder, dessen Haarmode weitgehend mit dem Kronprinzenporträt des Commodus aus dem Jahr 177 n. Chr. übereinstimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
