                "senses": [
                    {
                        "sense_id": "c1d242b2-2ec4-34e1-8101-3479794a605f",
                        "entry_id": "7031f355-7345-3b5f-9aeb-495ae0a85a10",
                        "glosses": [
                            "спец. создавать анимацию, движущихся изображений неподвижных объектов (воображаемых или реальных)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1582a7b1-4e5b-4ba6-9547-636ca56a52b2",
                                "sense_id": "c1d242b2-2ec4-34e1-8101-3479794a605f",
                                "text": "Электронные технологии позволили это изображение анимировать."
                            },
                            {
                                "example_id": "fca30f23-7409-4826-9e19-c85d34dd4948",
                                "sense_id": "c1d242b2-2ec4-34e1-8101-3479794a605f",
                                "text": "Анимировать диск будет небезызвестный Муха (режиссер почти всех клипов группы)"
                            }
                        ]
                    },
                    {
                        "sense_id": "80230db7-26e8-3230-9fed-016aa868a1c9",
                        "entry_id": "7031f355-7345-3b5f-9aeb-495ae0a85a10",
                        "glosses": [
                            "устар. оживлять, организуя развлечения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "529fb16e-1f30-49e1-a2d0-d4f4e207e766",
                                "sense_id": "80230db7-26e8-3230-9fed-016aa868a1c9",
                                "text": "Пытались при прежнем директоре анимировать музей-заповедник ― свадьбы играли, в исторических костюмах фотографировались, в колокола звонили."
                            }
                        ]
                    }
