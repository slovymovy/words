                        "sense_id": "eb8bed35-7f29-3e9f-b758-d8cc40629de8",
                        "entry_id": "1da4b0ad-951e-300c-9f17-7b4678f28828",
                        "glosses": [
                            "\\\"24\\\", het getal tussen drieëntwintig en vijfentwintig, twintig plus vier",
                            "om een hoeveelheid aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d0ef8a9-41b0-4e90-adb2-a691797a3d39",
                                "sense_id": "eb8bed35-7f29-3e9f-b758-d8cc40629de8",
                                "text": "De totale kosten bedragen vierentwintig euro en zevenendertig cent."
                            },
                            {
                                "example_id": "77eefd85-a219-4a28-bfa0-4d8bb877f806",
                                "sense_id": "eb8bed35-7f29-3e9f-b758-d8cc40629de8",
                                "text": "Toen hij vroeg of ze zich toevalligerwijs een treinreis in Sôrmland van vierentwintig jaar geleden herinnerde dacht ze eerst dat hij een grapje maakte. Maar toen hij iets meer vertelde over die kernwapendiscussie werd ze plotseling enthousiast en zei dat ze die nooit was vergeten."
                            }
                        ]
                    },
                    {
                        "sense_id": "31249305-5f67-3942-baad-81f2183a9669",
                        "entry_id": "1da4b0ad-951e-300c-9f17-7b4678f28828",
                        "glosses": [
                            "\\\"24\\\", het getal tussen drieëntwintig en vijfentwintig, twintig plus vier",
                            "om een plaats in een volgorde aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe4a544c-4a29-4143-acca-6ba4de1ab7e5",
                                "sense_id": "31249305-5f67-3942-baad-81f2183a9669",
                                "text": "Het juiste antwoord op opgave vierentwintig is \"42\"."
                            }
                        ]
