                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8df9f31-4a87-49c4-ba78-231fb357919a",
                        "entry_id": "b0ab1139-7c56-3343-b504-c398a60129fb",
                        "tags": [
                            "plural"
                        ],
