                "senses": [
                    {
                        "sense_id": "00b95075-1fdd-3ca8-8d2c-8d173a598349",
                        "entry_id": "a9d8e6eb-23a5-3f61-96f3-b38495784a3d",
                        "glosses": [
                            "Steinaufbau zum Gesamtgefüge einer Mauer; Mauerwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe78e51-c36a-4b3e-9548-1bb80e4c8663",
                                "sense_id": "00b95075-1fdd-3ca8-8d2c-8d173a598349",
                                "text": "„Der unregelmäßige Mauerverbund entstand durch Drehungen der Steine und unterschiedlich kleine Öffnungen der Fassade.“"
                            },
                            {
                                "example_id": "c3169a7f-262d-432d-ab15-42026a66033a",
                                "sense_id": "00b95075-1fdd-3ca8-8d2c-8d173a598349",
                                "text": "„Als diese vor einiger Zeit erneuert wurden, hat man Steine aus dem Mauerverbund gelöst und an den Rückseiten tatsächlich Profile und Bruchstücke von Bauplastik vorgefunden.“"
                            },
                            {
                                "example_id": "b564ad1c-cece-4089-86e9-9c0fcad8bff9",
                                "sense_id": "00b95075-1fdd-3ca8-8d2c-8d173a598349",
                                "text": "„Hierzu zählen verschobene Mauersteine und Wandbereiche, sowie entsprechende Rissbildungen im Mauerverbund.“"
                            },
                            {
                                "example_id": "53297c83-e10c-46d4-b1fc-610507aa8e23",
                                "sense_id": "00b95075-1fdd-3ca8-8d2c-8d173a598349",
                                "text": "„Die ringförmig um den Hügel angelegten Mauerverbünde gehen im Wesentlichen auf die zweite Hälfte des 16. Jhs. zurück […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
