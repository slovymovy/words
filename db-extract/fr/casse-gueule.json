                                "target_senses": [
                                    {
                                        "sense_id": "9cf3ed98-3e79-3fe3-b818-012e3aeedb84",
                                        "entry_id": "42d2b377-1f8b-35f1-bbf1-872be0e4a27a",
                                        "glosses": [
                                            "Exhibiting treachery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14bff02a-5054-4091-b7b5-4a1bc8e0cb78",
                                                "sense_id": "9cf3ed98-3e79-3fe3-b818-012e3aeedb84",
                                                "text": "I see the wife misused by her husband, I see the treacherous seducer of young women, / I mark the ranklings of jealousy and unrequited love attempted to be hid […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32d7078-2940-3be0-a69a-5f9a1ff7cce5",
                                        "entry_id": "42d2b377-1f8b-35f1-bbf1-872be0e4a27a",
                                        "glosses": [
                                            "Deceitful; inclined to betray."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c01d855-ead5-3aa9-9cb5-fe2b57e498db",
                                        "entry_id": "42d2b377-1f8b-35f1-bbf1-872be0e4a27a",
                                        "glosses": [
                                            "Unreliable; dangerous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a46e4ff0-53cc-4afa-9c3b-67d98f4acbfb",
                                                "sense_id": "6c01d855-ead5-3aa9-9cb5-fe2b57e498db",
                                                "text": "a treacherous mountain trail"
                                            },
                                            {
                                                "example_id": "9753a164-d60b-49ad-aa95-00b326142e3c",
                                                "sense_id": "6c01d855-ead5-3aa9-9cb5-fe2b57e498db",
                                                "text": "[…] they stood in the region of perpetual snow, amidst the glittering, treacherous glaciers and crevasses, with vast slippery-pathed precipices yawning round."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "597773d1-759a-40d2-8053-f0130eec21e3",
                        "source_entry_id": "ee7777f0-1d94-3935-befc-9b2b034c7d0b",
                        "source_sense_id": "db8e3fdb-1882-3510-b23f-3dcca7cd36dc",
                        "target_lang_word": "karkołomny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "karkołomny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "10c7091d-0c82-3a60-8f78-91f4b2bde0a4",
                                        "entry_id": "d1dcba67-888f-3c61-9e00-cfd6d0f1539d",
                                        "glosses": [
                                            "taki, który grozi śmiercią, kalectwem, połamaniem karku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b129ef12-2482-4a9a-a618-49184d22647e",
                                                "sense_id": "10c7091d-0c82-3a60-8f78-91f4b2bde0a4",
                                                "text": "Ja potrafiłem w marcu rozpocząć sezon pływacki w gliniance przy starej cegielni, ktoś inny lubił spacerować po gzymsie na trzecim piętrze albo jeździł motorem usiłując zademonstrować karkołomne ewolucje"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "e4a68e18-2b1a-37ca-b95c-8db1d251466c",
                                        "entry_id": "d1dcba67-888f-3c61-9e00-cfd6d0f1539d",
                                        "glosses": [
                                            "daleko idący, oparty na kruchych przesłankach"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b9a9fbf-8fff-47d3-9876-ab276211522e",
                                                "sense_id": "e4a68e18-2b1a-37ca-b95c-8db1d251466c",
                                                "text": "…Artysta prowadzi dowcipną konferansjerkę, żonglując faktami z życia słynnych kompozytorów i dowodząc często karkołomnych hipotez"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "ba38d4bc-bf96-3d31-9184-839326bc2d46",
                                        "entry_id": "d1dcba67-888f-3c61-9e00-cfd6d0f1539d",
                                        "glosses": [
                                            "bardzo śmiały i niosący ryzyko niepowodzenia"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad07b234-a668-4419-89a2-5f0e6ef27603",
                                                "sense_id": "ba38d4bc-bf96-3d31-9184-839326bc2d46",
                                                "text": "Ubranie tego materiału w dialogi wydało mi się karkołomnym pomysłem"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "793d0697-8b44-3d98-afa0-de4389272ebb",
                                        "entry_id": "d1dcba67-888f-3c61-9e00-cfd6d0f1539d",
                                        "glosses": [
                                            "najeżony skrajnymi trudnościami i bardzo skomplikowany"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2e7d59b-0489-4f14-b783-4291a811a626",
                                                "sense_id": "793d0697-8b44-3d98-afa0-de4389272ebb",
                                                "text": "Cały ten pasztet został przerzucony na samorządy: karkołomne zadanie bez niezbędnych środków"
                                            },
                                            {
                                                "example_id": "80a52fe7-0c67-4f10-a775-c34c97e1ebc5",
                                                "sense_id": "793d0697-8b44-3d98-afa0-de4389272ebb",
                                                "text": "Następnie zaczęto odczytywać nazwiska w celu wydania kartek do głosowania […] Odczytywanie listy było tak karkołomne, że próbowały to robić trzy osoby"
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    }
                                ]
                            }
                        ]
                    }
