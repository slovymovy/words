                                "cs": "Jeho <w>přítelkyně</w> pracuje v bance.",
                                "tr": "Onun <w>kız arkadaşı</w> bir bankada çalışıyor.",
                                "es": "Su <w>novia</w> trabaja en un banco."
                            }
