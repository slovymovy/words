                "senses": [
                    {
                        "sense_id": "c63e236a-47f9-37c7-afd6-1db28ee21de9",
                        "entry_id": "60ef0319-b27d-3c7b-af8c-e0b34c68b803",
                        "glosses": [
                            "учение о методах улучшения внешности человека"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "034ada9d-2b02-406c-ad7b-3222a374d0cb",
                                "sense_id": "c63e236a-47f9-37c7-afd6-1db28ee21de9",
                                "text": "Курсы косметики."
                            }
                        ]
                    },
                    {
                        "sense_id": "9031d433-f3d6-3c16-9e23-1230c01619d3",
                        "entry_id": "60ef0319-b27d-3c7b-af8c-e0b34c68b803",
                        "glosses": [
                            "собир. вещества, служащие для улучшения внешности; в разговорной речи применяется в основном к декоративной косметике"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0774e0-d5f4-49a2-83a3-ad06cd2e9a31",
                                "sense_id": "9031d433-f3d6-3c16-9e23-1230c01619d3",
                                "text": "Пользоваться косметикой."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f663941-36af-37af-ba03-7c3a1a37719e",
                        "entry_id": "60ef0319-b27d-3c7b-af8c-e0b34c68b803",
                        "glosses": [
                            "разг. что-либо, служащее исключительно для красоты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eae806c2-bbc8-43ae-9aa7-0312d3a3c449",
                                "sense_id": "9f663941-36af-37af-ba03-7c3a1a37719e",
                                "text": "Все нововведения версии 3.0 оказались косметикой, к тому же потребляющей уйму памяти."
                            }
                        ]
                    },
                    {
                        "sense_id": "26248e0b-be55-3c57-8651-4ad06a405c5b",
                        "entry_id": "60ef0319-b27d-3c7b-af8c-e0b34c68b803",
                        "glosses": [
                            "разг. облицовка протеза из поролона, резины или иного материала, служащая для придания протезу внешнего облика сохранившейся конечности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb09eae-9fff-4d27-910d-8b24df23dbd5",
                                "sense_id": "26248e0b-be55-3c57-8651-4ad06a405c5b",
                                "text": "Косметика, закрывающая протез, идеально повторяет форму здоровой ноги."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf153397-58ab-43bb-a348-6bc64bfd9658",
                        "source_entry_id": "60ef0319-b27d-3c7b-af8c-e0b34c68b803",
                        "target_lang_word": "cosmetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29d3644c-9e5f-32ce-8a2e-1946e545c0c3",
                                        "entry_id": "1e45aee2-ab0d-3b2a-b1c7-09863ccaea49",
                                        "glosses": [
                                            "Imparting or improving beauty, particularly the beauty of the complexion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4917e3a-8017-44b4-ac64-0dd7af6e4094",
                                                "sense_id": "29d3644c-9e5f-32ce-8a2e-1946e545c0c3",
                                                "text": "a cosmetic preparation"
                                            },
                                            {
                                                "example_id": "ab05c1b7-05eb-4a7d-ab4f-d69526bb59c9",
                                                "sense_id": "29d3644c-9e5f-32ce-8a2e-1946e545c0c3",
                                                "text": "Firſt, rob'd in white, the nymph intent adores / With head uncover'd, the coſmetic pow'rs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10c27fb4-ee4a-3856-9ea6-262d3b3021b5",
                                        "entry_id": "1e45aee2-ab0d-3b2a-b1c7-09863ccaea49",
                                        "glosses": [
                                            "External or superficial; pertaining only to the surface or appearance of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f8c7b05-6843-4342-a074-c28e3bec952b",
                                                "sense_id": "10c27fb4-ee4a-3856-9ea6-262d3b3021b5",
                                                "text": "Fortunately, the damage to the house was mostly cosmetic and a bit of paint covered it nicely."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cosmetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7649925a-608e-3410-b72a-784b6f795f5a",
                                        "entry_id": "a844ff0a-6de5-3440-b869-4681c40a654d",
                                        "glosses": [
                                            "Any substances applied to enhance the external color or texture of the skin, e.g. lipstick, eyeshadow, eyeliner; makeup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05316ce3-fe5d-49a4-b60d-02d8d03816ff",
                                                "sense_id": "7649925a-608e-3410-b72a-784b6f795f5a",
                                                "text": "These endocrine disruptors are everywhere: plastics, shampoos, cosmetics, cushions, pesticides, canned foods and A.T.M. receipts. They often aren’t on labels and can be difficult to avoid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa4bab19-bc43-3497-916f-2f8a85e7017f",
                                        "entry_id": "a844ff0a-6de5-3440-b869-4681c40a654d",
                                        "glosses": [
                                            "A feature existing only on the surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47836ec4-bd99-354d-9be2-9f7013c7a5cc",
                                        "entry_id": "a844ff0a-6de5-3440-b869-4681c40a654d",
                                        "glosses": [
                                            "An intangible influence that improves the overall perception of some thing or situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32af74e1-0cd0-4e68-8c74-0a6f97753d88",
                                                "sense_id": "47836ec4-bd99-354d-9be2-9f7013c7a5cc",
                                                "text": "All depends upon circumstances—anger as much as any thing else. Interest is your only true cosmetic for smoothing the brow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
