                        "glosses": [
                            "Nacelle, cellule, d’un avion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cd8bc3c-b81b-49ef-8b19-d9c1a46f2897",
                                "sense_id": "261a2c75-9fd7-3425-a677-ebf39246a199",
                                "text": "Essayez de vous mettre au milieu de la carlingue, avait conseillé Ferdinand Graux."
                            },
                            {
                                "example_id": "426650b2-ae8f-429e-9990-d0c92a89dc28",
                                "sense_id": "261a2c75-9fd7-3425-a677-ebf39246a199",
                                "text": "...mais uniquement avec deux pneus dans la carlingue, pour nous servir de bouées, en cas de besoin."
                            }
                        ]
                    }
                ],
