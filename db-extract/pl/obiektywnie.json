                        "source_entry_id": "91e3ddc8-cb12-3df2-9015-b51b95eb1190",
                        "source_sense_id": "120d2805-48d8-39f8-817e-26d5e08c250f",
                        "target_lang_word": "objectivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objectivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1d2c2cb-e550-32d3-a3b2-2b5d2da70b68",
                                        "entry_id": "f8d781bc-61a2-3175-aad3-0523e8709775",
                                        "glosses": [
                                            "D’une manière objective, relativement aux objets extérieurs, abstraction faite de toute autre et même du sujet observant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26790a9a-09d5-4d8c-9d58-a373fe8b5bcd",
                                                "sense_id": "f1d2c2cb-e550-32d3-a3b2-2b5d2da70b68",
                                                "text": "Si je raisonne objectivement, je suis obligé de constater la concomitance évidente entre la persistance du sentiment religieux dans une grande partie de la population et la continuation d'une natalité qui, […], demeure malgré tout très belle."
                                            },
                                            {
                                                "example_id": "7ba198a0-2af0-4039-a673-e8ddd400fce1",
                                                "sense_id": "f1d2c2cb-e550-32d3-a3b2-2b5d2da70b68",
                                                "text": "Auxiliaires de la justice avons-nous dit, leur premier devoir est de remplir les missions qui leur sont confiées, objectivement et impartialement. Or, il est d’évidence et d’expérience que l'expert choisi par une partie a tendance à soutenir les intérêts de celle-ci, qui se hâterait d'ailleurs de l’abandonner pour s'adresser à un autre s'il cessait de lui être favorable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9527ad1-8eca-334c-bb2a-1af3f3e118b1",
                                        "entry_id": "f8d781bc-61a2-3175-aad3-0523e8709775",
                                        "glosses": [
                                            "D’une manière objective, par représentation, à l’aide d’une entité objective."
                                        ],
                                        "tags": [
                                            "Dans la philosophie scolastique et dans celle de Descartes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "334f7e1a-a46f-4c37-8472-0ae3e6ce9852",
                                                "sense_id": "f9527ad1-8eca-334c-bb2a-1af3f3e118b1",
                                                "text": "Pour imparfaite que soit cette façon d’être par laquelle une chose est objectivement ou par représentation dans l’entendement par son idée […]"
                                            },
                                            {
                                                "example_id": "029bdad6-e1ef-4f68-8bee-e9604cebfbae",
                                                "sense_id": "f9527ad1-8eca-334c-bb2a-1af3f3e118b1",
                                                "text": "Je parle de l’idée qui n'est jamais hors de l’entendement, et au respect de laquelle être objectivement ne signifie autre chose qu’être dans l’entendement en la manière que les objets ont coutume d’y être."
                                            },
                                            {
                                                "example_id": "6e4b09fb-965e-4f96-af04-c21da6484936",
                                                "sense_id": "f9527ad1-8eca-334c-bb2a-1af3f3e118b1",
                                                "text": "Tout ce qui est objectivement et par représentation dans les idées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
