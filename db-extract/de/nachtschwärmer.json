                "senses": [
                    {
                        "sense_id": "efd1fde9-5f6e-3e84-94a7-fa5460d270e5",
                        "entry_id": "0f701b87-828f-36c1-8537-a66145fc1b7e",
                        "glosses": [
                            "night owl, person awake at night, especially one who goes out, a nocturnal reveller"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e1b77813-3023-4825-ac44-461900c13846",
                                "sense_id": "efd1fde9-5f6e-3e84-94a7-fa5460d270e5",
                                "text": "Mit einem Male schoß aus der Höhe des Hauses, unter welchem die Gruppe stand, ein Strahl Wasser herunter und netzte die Köpfe und Kleider der Untenstehenden auf eine boshafte Weise. Es war Sitte in diesem Viertel der Altstadt, auf Nachtschwärmer, die Lärm verübten, Wasser hinunterzuleeren."
                            },
                            {
                                "example_id": "4f75d3af-43c6-4173-a6f5-f2d8c696d7b0",
                                "sense_id": "efd1fde9-5f6e-3e84-94a7-fa5460d270e5",
                                "text": "Auch für Nietzsche erwachten in dieser Zeit „alle Lieder der Liebenden“, die für die „Nachtschwärmer“ heute in Technoclubs laut werden, sehr laut."
                            }
                        ]
                    }
