                        "source_sense_id": "73509f6d-45df-3469-bd8e-2b74c5e52996",
                        "source_sense_description": "hoogmoedig, verwaand",
                        "target_lang_word": "hubris",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hubris",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d10cdc0-b88e-30a5-b678-58c2f8ddf2e9",
                                        "entry_id": "6fa0eab0-c843-3821-974c-67f1d05b792a",
                                        "glosses": [
                                            "Excessive pride, presumption, or arrogance (originally toward the gods)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe698461-d608-41e0-81c6-f48268e59900",
                                                "sense_id": "2d10cdc0-b88e-30a5-b678-58c2f8ddf2e9",
                                                "text": "Antitrust prosecutors target big companies that exude hubris."
                                            },
                                            {
                                                "example_id": "f2429aa1-269a-4809-b363-256c1e9c84cb",
                                                "sense_id": "2d10cdc0-b88e-30a5-b678-58c2f8ddf2e9",
                                                "text": "One would have thought that even Trump, despite all his hubris and egotism, would know better than to jump feet first into America’s most sensitive issue: racial division."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7055291-0540-4071-8eb6-01baa373ba73",
                        "source_entry_id": "2c2f32ed-b7c1-3b88-95b8-3160e1d71f2c",
                        "source_sense_id": "73509f6d-45df-3469-bd8e-2b74c5e52996",
                        "source_sense_description": "hoogmoedig, verwaand",
                        "target_lang_word": "haughty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haughty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "191d87a4-6020-3aff-abca-5b60bbcf50e2",
                                        "entry_id": "7c9f7672-d3fc-3ae1-b208-f086db048ca4",
                                        "glosses": [
                                            "Conveying in demeanour the assumption of superiority; disdainful, supercilious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54055006-397a-4d52-aed9-540ff5da4df9",
                                                "sense_id": "191d87a4-6020-3aff-abca-5b60bbcf50e2",
                                                "text": "How meek and shrunken did that haughty Tarmac become as it slunk by the wide circle of asphalt of the yellow sort, that was loosely strewn before the great iron gates of Lady Hall as a forerunner of the consideration that awaited the guests of Rupert, Earl of Kare, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1feb9a4f-fc37-42ad-afcd-fedbd29630f4",
                        "source_entry_id": "2c2f32ed-b7c1-3b88-95b8-3160e1d71f2c",
                        "source_sense_id": "73509f6d-45df-3469-bd8e-2b74c5e52996",
                        "source_sense_description": "hoogmoedig, verwaand",
                        "target_lang_word": "orgueilleux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgueilleux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b42fb05-5b40-30c0-9f7c-b36e5c29ba00",
                                        "entry_id": "32032768-6742-342b-b866-f13a64f1db64",
                                        "glosses": [
                                            "Qui a de l’orgueil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee18c0e-ee0b-44fa-b835-935467f588ba",
                                                "sense_id": "8b42fb05-5b40-30c0-9f7c-b36e5c29ba00",
                                                "text": "On la dévasta, comme, au siècle précédent, on avait bombardé d’immenses agglomérations barbares, et parce qu’elle était à la fois trop forte pour être occupée par le vainqueur et trop indisciplinée, trop orgueilleuse pour se rendre dans le but d’échapper à la destruction."
                                            },
                                            {
                                                "example_id": "b2ec124d-2a74-49f6-857e-cf501116a31b",
                                                "sense_id": "8b42fb05-5b40-30c0-9f7c-b36e5c29ba00",
                                                "text": "Il est insolent et orgueilleux. - Il est orgueilleux de ses succès."
                                            },
                                            {
                                                "example_id": "5db28399-f037-4460-b31e-f7a56badadfb",
                                                "sense_id": "8b42fb05-5b40-30c0-9f7c-b36e5c29ba00",
                                                "text": "— Un esprit orgueilleux. - Une beauté orgueilleuse. - L’orgueilleuse puissance des Romains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28b769b0-51b8-3a98-a2bb-a150dc53ccfa",
                                        "entry_id": "32032768-6742-342b-b866-f13a64f1db64",
                                        "glosses": [
                                            "Qualifie les choses que l’orgueil inspire ou dans lesquelles l’orgueil se montre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28199bc1-3152-4b4e-bc88-eda01103f9ac",
                                                "sense_id": "28b769b0-51b8-3a98-a2bb-a150dc53ccfa",
                                                "text": "Pour agir et penser comme je l’ai fait, il a fallu l’amour effréné du plaisir mêlé à une soif ardente de vengeance, et la conscience orgueilleuse de pouvoir la mettre à exécution."
                                            },
                                            {
                                                "example_id": "eb850aa7-7b2f-48b0-98a0-3315c130ac25",
                                                "sense_id": "28b769b0-51b8-3a98-a2bb-a150dc53ccfa",
                                                "text": "Elle ne devint catastrophe que dans sa troisième phase, quand soudain, au milieu d’un ciel serein, la foudre du krach bancaire de New-York frappa l’édifice orgueilleux de la prospérité du capital américain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f4f0bd0-437b-313f-810b-6af2acb20a38",
                                        "entry_id": "32032768-6742-342b-b866-f13a64f1db64",
                                        "glosses": [
                                            "Qui est beau, agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d20f9757-0844-4067-bc81-b44b27c67788",
                                                "sense_id": "1f4f0bd0-437b-313f-810b-6af2acb20a38",
                                                "text": "En même temps, il glissait sa large patte sous la jupe de la fille qui ne broncha point et tapotait délicatement une callipygie orgueilleuse et prévenante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "orgueilleux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af87d582-e7f2-37b6-8d82-646ba32fe1da",
                                        "entry_id": "4b6290ce-d01b-3980-b424-c88e10ab1642",
                                        "glosses": [
                                            "Personne ayant de l’orgueil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640b4bb3-8b1f-4bba-947f-7ba0a7edb89c",
                                                "sense_id": "af87d582-e7f2-37b6-8d82-646ba32fe1da",
                                                "text": "C’est un orgueilleux."
                                            },
                                            {
                                                "example_id": "4378b5e5-b099-4e14-920d-9588e4e8f022",
                                                "sense_id": "af87d582-e7f2-37b6-8d82-646ba32fe1da",
                                                "text": "Dieu se plaît à abaisser les orgueilleux."
                                            },
                                            {
                                                "example_id": "da25b52b-bf27-4fce-9f84-0f7aeafef50e",
                                                "sense_id": "af87d582-e7f2-37b6-8d82-646ba32fe1da",
                                                "text": "L’orgueilleux va ressentir le besoin de s’imposer, et pour cela, il devra éviter de se montrer ridicule : ce sera une question d’honneur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
