                "senses": [
                    {
                        "sense_id": "b2abd1a3-ce26-381d-ac11-983213fe0546",
                        "entry_id": "0f10b270-5c59-344d-bd11-65eb56e428a7",
                        "glosses": [
                            "Maschine, die durch Verbrennung Energie in Bewegung umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2d01d20-78d3-4af7-b5e8-3010574ac347",
                                "sense_id": "b2abd1a3-ce26-381d-ac11-983213fe0546",
                                "text": "Leistungsstarke Kettensägen werden durch einen Verbrennungsmotor angetrieben."
                            },
                            {
                                "example_id": "32fe6d6e-61a4-4b4b-97ba-fe4f1493b147",
                                "sense_id": "b2abd1a3-ce26-381d-ac11-983213fe0546",
                                "text": "Verbrennungsmotoren haben einen schlechten Wirkungsgrad."
                            },
                            {
                                "example_id": "ef84a67c-bf63-491e-adbd-72d6a80ed9d2",
                                "sense_id": "b2abd1a3-ce26-381d-ac11-983213fe0546",
                                "text": "„Ein wesentlicher Vorteil des Obusses gegenüber einer Umstellung auf Busse mit Verbrennungsmotor war - wie bei der Straßenbahn - die Energieversorgung aus der Verstromung heimischer Kohlevorkommen.“"
                            },
                            {
                                "example_id": "50cd2232-3b7b-4332-8847-d0950cb18f27",
                                "sense_id": "b2abd1a3-ce26-381d-ac11-983213fe0546",
                                "text": "„Öffentlich traut sich Merkel deshalb nicht, das Festhalten der Konzerne am Verbrennungsmotor zu kritisieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
