                "senses": [
                    {
                        "sense_id": "e62e633c-73a9-36ac-a6f9-dcf0428b4989",
                        "entry_id": "27ef4750-289b-332d-b33f-da3b28eb07dd",
                        "glosses": [
                            "с.-х. всходы, посевы озимых культур"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1694990-9a97-4692-9121-d4895b4c2098",
                                "sense_id": "e62e633c-73a9-36ac-a6f9-dcf0428b4989",
                                "text": "Туман висел над мокрым полем, и на каждой травинке озимей держались капельки."
                            },
                            {
                                "example_id": "455be6d1-f57f-4a2c-80d5-2201c68f14cf",
                                "sense_id": "e62e633c-73a9-36ac-a6f9-dcf0428b4989",
                                "text": "Черепичные крыши селений приветливо краснели среди яркой озими, безмятежное утро скрашивало пустоту домов и безобразие развалин."
                            }
                        ]
                    },
                    {
                        "sense_id": "122eaab6-1207-361e-b802-091eae29af2c",
                        "entry_id": "27ef4750-289b-332d-b33f-da3b28eb07dd",
                        "glosses": [
                            "с.-х. поле, занятое посевами озимых культур"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "553c7226-c5d7-414b-8347-3600d006b3b9",
                                "sense_id": "122eaab6-1207-361e-b802-091eae29af2c",
                                "text": "Иногда ток можно обнаружить на озими, всего в нескольких сотнях метров от жилья."
                            }
                        ]
                    }
                ],
