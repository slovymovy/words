                "senses": [
                    {
                        "sense_id": "e494cc10-943f-35ae-85f6-71944a8d6cb0",
                        "entry_id": "85ff3e2a-b68a-39a1-b57d-3d195182f274",
                        "glosses": [
                            "Guérir d’une carence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b823865e-5557-4511-b514-d6e25d015e91",
                                "sense_id": "e494cc10-943f-35ae-85f6-71944a8d6cb0",
                                "text": "Traitement d'un mois destiné à nous \"décarencer\" car l'alcool a bouffé ces vitamines, et à éviter d'éventuels désordres neurologiques."
                            },
                            {
                                "example_id": "330256aa-dc2b-4790-9470-571ef8de30e3",
                                "sense_id": "e494cc10-943f-35ae-85f6-71944a8d6cb0",
                                "text": "Qu'il faille construire pour attirer de nouveaux habitants, et pour « décarencer » la ville en bâtissant des logements sociaux, d'accord."
                            },
                            {
                                "example_id": "ed50f6fe-b0f5-4396-a808-74aedc5a2bd1",
                                "sense_id": "e494cc10-943f-35ae-85f6-71944a8d6cb0",
                                "text": "Logement social : 10,7 M€ pour décarencer Le Pecq"
                            }
                        ]
                    }
