                        "source_sense_id": "22a5e393-8b9a-30e6-a7c8-93acc3901502",
                        "source_sense_description": "zeer luid heel blij zijn",
                        "target_lang_word": "exuberant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exuberant",
