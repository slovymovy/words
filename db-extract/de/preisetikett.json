                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0c0a090-8cc9-403d-8df3-61ac41b1d970",
                                "sense_id": "1a7d971e-37d1-3b31-b315-7e0ff65d8e53",
                                "text": "„Unabdingbar ist in der Regel der Kassenbon oder auch das Preisetikett.“"
                            },
                            {
                                "example_id": "21438919-2981-4ead-a0bb-43c82005a7a5",
                                "sense_id": "1a7d971e-37d1-3b31-b315-7e0ff65d8e53",
                                "text": "„Eine teure Damenjacke auf der Rücksitzbank, an der noch das Preisetikett hing, hat einen Ladendieb auffliegen lassen.“"
                            },
                            {
                                "example_id": "d8a14489-2fbd-4903-bf24-d1cbe7be5c20",
                                "sense_id": "1a7d971e-37d1-3b31-b315-7e0ff65d8e53",
                                "text": "„Angeregt zur eigenen Senfproduktion wurden Monika Trautmann und ihr Mann Reinhard Fell vor einigen Jahren beim Blick auf das Preisetikett so mancher Senfgläser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
