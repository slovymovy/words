{
    "word_family": [
        "reticent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36beee59-3b8f-36d8-b5c1-d1db490d2cf1",
                    "sense_definition": "A feeling of hesitation or reluctance to do something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager noticed a clear <w>reticence</w> to accept the new project requirements.",
                            "target_lang_translations": {
                                "zh": "经理注意到大家对接受新项目要求表现出明显的<w>犹豫</w>。"
                            }
                        },
                        {
                            "text": "Despite his initial <w>reticence</w> to speak in public, he eventually gave a great speech.",
                            "target_lang_translations": {
                                "zh": "尽管他起初对公开演讲感到<w>不情愿</w>，但最终还是发表了一场精彩的演讲。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reluctance",
                        "hesitation",
                        "disinclination"
                    ],
                    "common_phrases": [
                        "show reticence"
                    ],
                    "target_lang_definitions": {
                        "zh": "在做某事时感到犹豫或不情愿。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "犹豫",
                                "target_lang_sense_clarification": "指在行动前的迟疑不决。"
                            },
                            {
                                "target_lang_word": "不情愿",
                                "target_lang_sense_clarification": "指对某事缺乏意愿或动力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                    "sense_definition": "The quality of being reserved and avoiding saying too much.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "reserve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her natural <w>reticence</w> made it difficult for colleagues to get to know her.",
                            "target_lang_translations": {
                                "zh": "她天生的<w>内敛</w>让同事们很难真正了解她。"
                            }
                        },
                        {
                            "text": "The politician maintained a careful <w>reticence</w> regarding his future plans.",
                            "target_lang_translations": {
                                "zh": "这位政治家对自己的未来计划保持着谨慎的<w>缄默</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reserve",
                        "quietness"
                    ],
                    "antonyms": [
                        "ostentation"
                    ],
                    "target_lang_definitions": {
                        "zh": "性格内敛、不愿多言的特质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "内敛",
                                "target_lang_sense_clarification": "指性格含蓄，不轻易表露。"
                            },
                            {
                                "target_lang_word": "缄默",
                                "target_lang_sense_clarification": "指保持沉默，不愿多说。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89304b02-a1d3-3f5d-8559-378e4a5a7c76",
                    "sense_definition": "A silent and reserved personality trait.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reserve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>reticence</w> was often mistaken for arrogance by those who did not know him.",
                            "target_lang_translations": {
                                "zh": "不了解他的人常把他的<w>寡言</w>误认为是傲慢。"
                            }
                        },
                        {
                            "text": "The author was known for a deep <w>reticence</w> that kept her private life hidden.",
                            "target_lang_translations": {
                                "zh": "这位作家以其深沉的<w>沉默寡言</w>而闻名，这使她的私生活不为人知。"
                            }
                        }
                    ],
                    "synonyms": [
                        "taciturnity",
                        "introversion"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种沉默寡言的性格特征。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "寡言",
                                "target_lang_sense_clarification": "指话语很少。"
                            },
                            {
                                "target_lang_word": "沉默寡言",
                                "target_lang_sense_clarification": "形容人性格沉静，不爱说话。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "048b3aed-0c5d-3652-b486-ac14ea466677",
                    "sense_definition": "Discretion or restraint in the use or disclosure of information.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reserve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reticence</w> of the witness prevented the police from solving the case quickly.",
                            "target_lang_translations": {
                                "zh": "证人的<w>谨慎</w>使得警方无法迅速破案。"
                            }
                        },
                        {
                            "text": "He practiced a professional <w>reticence</w> about the company's internal financial struggles.",
                            "target_lang_translations": {
                                "zh": "对于公司的内部财务困境，他表现出了职业性的<w>守口如瓶</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reservation",
                        "diffidence"
                    ],
                    "target_lang_definitions": {
                        "zh": "在披露信息时的谨慎或克制。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "谨慎",
                                "target_lang_sense_clarification": "指在处理信息时小心谨慎。"
                            },
                            {
                                "target_lang_word": "守口如瓶",
                                "target_lang_sense_clarification": "指严守秘密，不轻易透露。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da0b3ac2-b8c8-37dd-9450-44b1a157ba41",
                    "sense_definition": "The act of abruptly breaking off in speech.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet used <w>reticence</w> to create a dramatic pause in the middle of the stanza.",
                            "target_lang_translations": {
                                "zh": "诗人利用<w>中断</w>在诗节中间制造了一种戏剧性的停顿。"
                            }
                        },
                        {
                            "text": "His sudden <w>reticence</w> left the audience wondering what he had intended to say.",
                            "target_lang_translations": {
                                "zh": "他突然的<w>中断</w>让听众不禁猜测他原本想说什么。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aposiopesis"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in a literary or rhetorical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "说话时突然中断的修辞手法。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "中断",
                                "target_lang_sense_clarification": "指话语突然停止。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "faec8565-9bb2-3e5c-8be6-2d17d689344c",
                    "sense_definition": "To deliberately ignore or disregard something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian <w>reticenced</w> the controversial events in his final report.",
                            "target_lang_translations": {
                                "zh": "历史学家在最终报告中对那些有争议的事件选择了<w>避而不谈</w>。"
                            }
                        },
                        {
                            "text": "He chose to <w>reticence</w> the criticism rather than respond to it directly.",
                            "target_lang_translations": {
                                "zh": "他选择<w>忽略</w>这些批评，而不是直接回应。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pass over"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "故意忽略或不予理会。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "避而不谈",
                                "target_lang_sense_clarification": "指故意回避某个话题。"
                            },
                            {
                                "target_lang_word": "忽略",
                                "target_lang_sense_clarification": "指不予重视或处理。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}