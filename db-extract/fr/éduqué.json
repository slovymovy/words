                        "source_entry_id": "30f70f07-7d6f-3b2b-a183-a4f53f14ef8f",
                        "source_sense_id": "135ddff9-a42e-3b77-b2a6-28bca58bb284",
                        "target_lang_word": "образованный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "образованный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7c9e8582-e01e-328d-8abe-4f8fb4c3ae73",
                                        "entry_id": "137dc49e-f9f7-3d96-af66-88d3b34ceec8",
                                        "glosses": [
                                            "страд. прич. прош. вр. от образовать; полученный или созданный при каких-либо обстоятельствах"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "863f027e-8409-49c3-8a8e-a532ae254df4",
                                                "sense_id": "7c9e8582-e01e-328d-8abe-4f8fb4c3ae73",
                                                "text": "При археологическом обществе образована особая комиссия для изучения «старой Москвы»."
                                            },
                                            {
                                                "example_id": "aaa39c99-bf15-47d0-8090-db8bcaf0606c",
                                                "sense_id": "7c9e8582-e01e-328d-8abe-4f8fb4c3ae73",
                                                "text": "Скрытые полки, образованные взамен уничтоженных резервных, также не могли заменить их по недостатку крепких кадров и спайки в мирное время."
                                            },
                                            {
                                                "example_id": "54217b7a-327f-4211-b600-c42016573e05",
                                                "sense_id": "7c9e8582-e01e-328d-8abe-4f8fb4c3ae73",
                                                "text": "Каждое её волоконце ― фибрилла ― состоит из пучка молекул целлюлозы, а каждая молекула целлюлозы представляет собой цепочку, образованную из 100–200 остатков глюкозы."
                                            },
                                            {
                                                "example_id": "7a573f41-dbfa-4a22-90f2-9aabe00b018e",
                                                "sense_id": "7c9e8582-e01e-328d-8abe-4f8fb4c3ae73",
                                                "text": "Многие родовые имена были образованы из имён своих родоначальников."
                                            },
                                            {
                                                "example_id": "07498ef0-23dd-488b-b088-bb8137cbdb29",
                                                "sense_id": "7c9e8582-e01e-328d-8abe-4f8fb4c3ae73",
                                                "text": "Эти акционерные общества образованы как 100% дочерние компании РАО «ЕЭС России»."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "образованный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "59db090b-295d-3066-ad41-31f2fbd41be0",
                                        "entry_id": "9b52f35f-257f-32b8-9e27-063da759b01b",
                                        "glosses": [
                                            "получивший образование, просвещённый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b4fccea-1efd-4f7e-a262-c4bbc7bd4fc7",
                                                "sense_id": "59db090b-295d-3066-ad41-31f2fbd41be0",
                                                "text": "Образованных из них было только трое: Б-ский, М-кий и старик Ж-кий, бывший прежде где-то профессором математики, ― старик добрый, хороший, большой чудак и, несмотря на образование, кажется, крайне ограниченный человек."
                                            },
                                            {
                                                "example_id": "43d8a06d-64a1-4b59-b02a-3f682ddd7668",
                                                "sense_id": "59db090b-295d-3066-ad41-31f2fbd41be0",
                                                "text": "Нет, я очень рада: вот к нам гость, новый человек, образованный, из Петербурга…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bea2773-7c59-3c3a-8ba7-c8b08894a37e",
                                        "entry_id": "9b52f35f-257f-32b8-9e27-063da759b01b",
                                        "glosses": [
                                            "перен. находящийся на определённом уровне развития культуры (о государстве, обществе и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ebb8b51-011a-446c-9243-be98db3136d5",
                                                "sense_id": "1bea2773-7c59-3c3a-8ba7-c8b08894a37e",
                                                "text": "Бесспорно, наши образованные общества очень богаты. ― Почему же вокруг нас столько нищеты?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
