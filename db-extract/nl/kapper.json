                        "target_lang_word": "coiffeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coiffeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d1d919c-5c06-34c7-b221-92ecb820482f",
                                        "entry_id": "9875abea-8daa-3458-9279-11ee6d4a7090",
                                        "glosses": [
                                            "Personne dont le métier est de couper et coiffer les cheveux, et éventuellement la barbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3896f2a-4edc-4e0e-b9a2-bbf0df8bf63e",
                                                "sense_id": "8d1d919c-5c06-34c7-b221-92ecb820482f",
                                                "text": "Toilette du bataillon. Le barbier passe pour particulièrement francophile. Tout le monde va se raser chez lui. Chacun emporte son savon, son blaireau, son rasoir, et lui n’a guère qu’à regarder, mais enfin on se rase chez un coiffeur."
                                            },
                                            {
                                                "example_id": "6705f416-e9ab-468e-9bdc-eb1ab53f5d35",
                                                "sense_id": "8d1d919c-5c06-34c7-b221-92ecb820482f",
                                                "text": "Une très grande partie des ressources réunies par nos ménages du XXᵉ siècle passe en oripeaux inutiles, en colifichets, en fioles, en brimborions, en honoraires de coiffeurs, en cosmétiques."
                                            },
                                            {
                                                "example_id": "cfd40da5-f7a5-46ab-a738-cd1d71d8d704",
                                                "sense_id": "8d1d919c-5c06-34c7-b221-92ecb820482f",
                                                "text": "J’ai encore aujourd’hui du mal à considérer que les fleuristes et les coiffeurs ne sont pas des parasites, qui vivant de l’exploitation d’une nature qui appartient à tous, qui accomplissant avec force simagrées et produits odorants une tâche que j’effectue seule dans ma salle de bains avec une paire de ciseaux bien coupants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ab5f163-c3d8-3d96-b5fb-842303f5e49f",
                                        "entry_id": "9875abea-8daa-3458-9279-11ee6d4a7090",
                                        "glosses": [
                                            "Salon de coiffure."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ea668f6-6023-4e93-872f-319ddf3c4eb9",
                                                "sense_id": "2ab5f163-c3d8-3d96-b5fb-842303f5e49f",
                                                "text": "Du 10 au 19 juillet, création du plateau piétons devant le coiffeur Récré A Tif’s."
                                            },
                                            {
                                                "example_id": "f71a79f0-d7e8-43b3-937c-3747c230c19a",
                                                "sense_id": "2ab5f163-c3d8-3d96-b5fb-842303f5e49f",
                                                "text": "Une camionnette EDF bleue se stationne devant le coiffeur du début de la rue Colbert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae69e2e-8d2a-3636-b3a9-228265f9eb57",
                                        "entry_id": "9875abea-8daa-3458-9279-11ee6d4a7090",
                                        "glosses": [
                                            "Joueur qui est habituellement remplaçant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ed1ef7f-21a2-4557-8d2e-0db62f7ac750",
                                                "sense_id": "2ae69e2e-8d2a-3636-b3a9-228265f9eb57",
                                                "text": "Les coiffeurs avaient des tripes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
