                "senses": [
                    {
                        "sense_id": "aa606fc4-912c-3892-bd15-175c0153975d",
                        "entry_id": "5f1c37e5-08c1-348f-acac-d299782377c1",
                        "glosses": [
                            "Haltung/Handlung, jemandem oder etwas Ehre zu erweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0e7af8-e005-4752-b50e-475fb1cc6520",
                                "sense_id": "aa606fc4-912c-3892-bd15-175c0153975d",
                                "text": "„Mit Ehrerbietung gehen auch wir vorüber an diesen Buden mit Schriften und Papier.“"
                            },
                            {
                                "example_id": "e3eae6bd-5251-4132-9dcd-7b283febf040",
                                "sense_id": "aa606fc4-912c-3892-bd15-175c0153975d",
                                "text": "„Und als Hélène nach Pierres Abreise wieder in Petersburg auftauchte, wurde sie von allen, die sie kannten, nicht nur freudig, sondern auch mit einem Unterton von Ehrerbietung empfangen, der ihrem Unglück galt.“"
                            },
                            {
                                "example_id": "a0642713-003c-4ee3-83dc-a70d36664209",
                                "sense_id": "aa606fc4-912c-3892-bd15-175c0153975d",
                                "text": "„Der junge Häuptling bezeugte ihr seine Ehrerbietung auf eine bei dem stolzen Indianer nicht minder seltene Weise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
