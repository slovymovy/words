                ],
                "senses": [
                    {
                        "sense_id": "134f2c4e-eacc-3ff4-8661-f79a552bb128",
                        "entry_id": "f1125ae7-369f-3d2c-8e46-a74fe7334247",
                        "glosses": [
                            "(Chute de) pluie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54650ddc-5e17-4a6c-8aa2-b6ddaeb16e11",
                                "sense_id": "134f2c4e-eacc-3ff4-8661-f79a552bb128",
                                "text": "Zu diesem Ort führt eine einzige Straße, die nicht befestigt ist und nach Regenfällen schnell unpassierbar werden kann.",
                                "translation": "Une seule route mène à cet endroit. Elle n’est pas stabilisée et peut rapidement devenir impraticable après des pluies."
                            },
                            {
                                "example_id": "a16b40fa-fd03-4196-acb7-872dc75d8d61",
                                "sense_id": "134f2c4e-eacc-3ff4-8661-f79a552bb128",
                                "text": "Starke Regenfälle seit Ende März weichen die Böden vor allem im Osten und Süden der Ukraine auf. Selbst Kettenfahrzeuge haben es in einem solchen Terrain schwer.",
                                "translation": "Les fortes pluies tombées depuis la fin mars détrempent les sols, surtout dans l’est et le sud de l'Ukraine. Même les véhicules à chenilles ont du mal sur un tel terrain."
                            }
                        ]
                    }
                ],
