                    },
                    {
                        "sense_id": "ad99aa89-0099-362f-802f-903b0d7f176a",
                        "entry_id": "6150254e-4e1d-3de4-9844-ff7ce38d3afe",
                        "glosses": [
                            "Methode bei oder Verhalten gegenüber Patienten"
                        ],
                        "tags": [],
