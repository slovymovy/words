                        "examples": [
                            {
                                "example_id": "52fa004a-73d2-47f1-8f29-fdbfce98378b",
                                "sense_id": "2b4bc7ec-ec24-3751-83c5-5dbccf58ac45",
                                "text": "Der tiefste Niederschlag der relativen Surpluspopulation endlich bildet die Sphäre des Pauperismus. Sie besteht—wir sehn hier ab von Vagabunden, Verbrechern, Prostituirten, kurz dem eigentlichen Lumpenproletariat—aus drei Kategorieen: erstens, Arbeitsfähige.",
                                "translation": "The lowest sediment of the relative surplus population finally dwells in the sphere of pauperism. Exclusive of vagabonds, criminals, prostitutes, in a word, the ragged proletariat, this layer of society consists of three categories. First, those able to work.",
                                "english": "The lowest sediment of the relative surplus population finally dwells in the sphere of pauperism. Exclusive of vagabonds, criminals, prostitutes, in a word, the ragged proletariat, this layer of society consists of three categories. First, those able to work."
                            }
                        ]
                    }
