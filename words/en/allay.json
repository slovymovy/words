{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30acc7a9-a6d3-3398-80ff-47196d82942f",
                    "sense_definition": "To make quiet or put at rest; to pacify or appease; to quell; to calm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calm_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government tried to <w>allay</w> public fears about the new policy.",
                            "target_lang_translations": {
                                "de": "Die Regierung versuchte, die öffentlichen Ängste bezüglich der neuen Politik zu <w>beruhigen</w>."
                            }
                        },
                        {
                            "text": "He spoke softly to <w>allay</w> the <w>popular</w> <w>excitement</w> in the crowd.",
                            "target_lang_translations": {
                                "de": "Er sprach leise, um die allgemeine Aufregung in der Menge zu <w>beschwichtigen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "appease",
                        "compose",
                        "soothe",
                        "calm",
                        "quiet"
                    ],
                    "common_phrases": [
                        "allay popular excitement",
                        "allay the suspicions"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden oder etwas beruhigen, besänftigen oder Spannungen abbauen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beruhigen",
                                "target_lang_sense_clarification": "jemanden oder eine Situation in einen ruhigen Zustand versetzen"
                            },
                            {
                                "target_lang_word": "beschwichtigen",
                                "target_lang_sense_clarification": "aufgeregte Gemüter durch Worte oder Handlungen beruhigen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fe47256-c269-3b08-8185-4e235e5b6c1e",
                    "sense_definition": "To alleviate; to abate; to mitigate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reduce_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medicine helped to <w>allay</w> the pain after the surgery.",
                            "target_lang_translations": {
                                "de": "Das Medikament half, die Schmerzen nach der Operation zu <w>lindern</w>."
                            }
                        },
                        {
                            "text": "They took steps to <w>allay</w> the <w>severity</w> of the economic crisis.",
                            "target_lang_translations": {
                                "de": "Sie ergriffen Maßnahmen, um die Schwere der Wirtschaftskrise zu <w>dämpfen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "alleviate",
                        "abate"
                    ],
                    "common_phrases": [
                        "allay the severity"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas Unangenehmes wie Schmerz oder eine Krise mildern oder abschwächen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "lindern",
                                "target_lang_sense_clarification": "Schmerzen oder Leiden erträglicher machen"
                            },
                            {
                                "target_lang_word": "dämpfen",
                                "target_lang_sense_clarification": "die Intensität oder Wirkung von etwas abschwächen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cd7281b-2a42-36a4-b570-2e6b0221aa21",
                    "sense_definition": "To subside, abate, become peaceful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calm_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm began to <w>allay</w> as the sun rose over the horizon.",
                            "target_lang_translations": {
                                "de": "Der Sturm begann <w>nachzulassen</w>, als die Sonne über dem Horizont aufging."
                            }
                        },
                        {
                            "text": "After the long argument, the tension finally started to <w>allay</w>.",
                            "target_lang_translations": {
                                "de": "Nach dem langen Streit begann die Spannung endlich <w>nachzulassen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "abate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Nachlassen oder schwächer werden (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nachlassen",
                                "target_lang_sense_clarification": "in der Intensität abnehmen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f03d7c6-9764-3262-a642-3ee040ff13d5",
                    "sense_definition": "To mix metals with a baser metal; to alloy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mix_metals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goldsmith had to <w>allay</w> the gold with copper to make it harder.",
                            "target_lang_translations": {
                                "de": "Der Goldschmied musste das Gold mit Kupfer <w>legieren</w>, um es härter zu machen."
                            }
                        },
                        {
                            "text": "Ancient coins were often <w>allay</w>ed with cheaper metals to increase supply.",
                            "target_lang_translations": {
                                "de": "Antike Münzen wurden oft mit billigeren Metallen <w>legiert</w>, um das Angebot zu erhöhen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Metalle mit einem unedleren Metall vermischen (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "legieren",
                                "target_lang_sense_clarification": "Metalle zusammenschmelzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d14ac3f-1c9d-3e0e-9cf0-f8e0d4fb306d",
                    "sense_definition": "To make worse by the introduction of inferior elements.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mix_metals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The purity of the original manuscript was <w>allay</w>ed by later additions.",
                            "target_lang_translations": {
                                "de": "Die Reinheit des Originalmanuskripts wurde durch spätere Ergänzungen <w>verfälscht</w>."
                            }
                        },
                        {
                            "text": "His noble intentions were <w>allay</w>ed with selfish motives.",
                            "target_lang_translations": {
                                "de": "Seine edlen Absichten wurden durch eigennützige Motive <w>verfälscht</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Reinheit oder Qualität durch minderwertige Zusätze verschlechtern (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verfälschen",
                                "target_lang_sense_clarification": "den ursprünglichen Zustand durch Zusätze mindern"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f9c0333-a545-3f8a-9785-9d9558717438",
                    "sense_definition": "Alleviation; abatement; check.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>allay</w> of the storm brought relief to the villagers.",
                            "target_lang_translations": {
                                "de": "Die <w>Linderung</w> des Sturms brachte den Dorfbewohnern Erleichterung."
                            }
                        },
                        {
                            "text": "There was a sudden <w>allay</w> in the intensity of the noise.",
                            "target_lang_translations": {
                                "de": "Es gab eine plötzliche <w>Linderung</w> in der Intensität des Lärms."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Linderung oder Nachlassen (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Linderung",
                                "target_lang_sense_clarification": "das Abschwächen eines unangenehmen Zustands"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8398938a-0e7b-3bfc-a7bb-9bcef7502fd4",
                    "sense_definition": "An alloy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mix_metals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal was a strange <w>allay</w> of iron and lead.",
                            "target_lang_translations": {
                                "de": "Das Metall war eine seltsame <w>Legierung</w> aus Eisen und Blei."
                            }
                        },
                        {
                            "text": "This specific <w>allay</w> is known for its high resistance to heat.",
                            "target_lang_translations": {
                                "de": "Diese spezifische <w>Legierung</w> ist für ihre hohe Hitzebeständigkeit bekannt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This usage is obsolete."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Legierung (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Legierung",
                                "target_lang_sense_clarification": "Gemisch aus Metallen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}