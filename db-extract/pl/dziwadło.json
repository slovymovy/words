                        ]
                    },
                    {
                        "translation_id": "8533fefd-ff38-4f5f-b45b-d78c795a65e0",
                        "source_entry_id": "7f907772-c5e8-3066-91d6-2d4772a19482",
                        "source_sense_id": "3dd7682e-5537-3c5c-93eb-fd4b73494814",
                        "target_lang_word": "freak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ec975cd-64a5-3323-a236-7465dd6d0588",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "Someone or something that is markedly unusual or unpredictable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caf16c6f-94e7-41f7-852d-ce2f3149f2ee",
                                                "sense_id": "5ec975cd-64a5-3323-a236-7465dd6d0588",
                                                "text": "The two-headed calf was a freak."
                                            },
                                            {
                                                "example_id": "35d4c4e2-8820-44de-9642-e0ac2eae508b",
                                                "sense_id": "5ec975cd-64a5-3323-a236-7465dd6d0588",
                                                "text": "freak of nature, freak of the weather, freak of the imagination"
                                            },
                                            {
                                                "example_id": "7765e655-98ca-4f96-897d-436267cb685f",
                                                "sense_id": "5ec975cd-64a5-3323-a236-7465dd6d0588",
                                                "text": "[H]aving a dinner-party at his rooms to entertain some friends from London, nothing would satisfy Mr. Foker but painting Mr. Buck’s door vermilion, in which freak he was caught by the proctors …"
                                            },
                                            {
                                                "example_id": "9969415a-524b-449c-95eb-5efe2f4ae580",
                                                "sense_id": "5ec975cd-64a5-3323-a236-7465dd6d0588",
                                                "text": "And I may answer with another question. Why is a two-headed calf? And my own answer to this is that it is a freak."
                                            },
                                            {
                                                "example_id": "29fc26d8-0b7d-4c1d-b9e5-2173e290e089",
                                                "sense_id": "5ec975cd-64a5-3323-a236-7465dd6d0588",
                                                "text": "There may be good points about a freak reel, but because it is a freak it will stand little show of even a fair try-out"
                                            },
                                            {
                                                "example_id": "15bb74e8-f3b5-4f94-9b6c-c06704b4bca0",
                                                "sense_id": "5ec975cd-64a5-3323-a236-7465dd6d0588",
                                                "text": "It is a freak that people talk about when they see it. Not everyone calls it by the right name, and few people know how it gets to be what it is. This freak is hail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dba5eae-6a07-3269-b393-dde5c5074ccc",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "A hippie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e08ca0be-edd4-41f7-919d-1eb249428909",
                                                "sense_id": "6dba5eae-6a07-3269-b393-dde5c5074ccc",
                                                "text": "When long-haired, outlandishly dressed, drug-using hippies pilgrimaged to Haight-Ashbury in the early 1960s, they were quickly dubbed freaks; the pejorative appellation was both obvious and intended. It was not long before freak had become practically synonymous with hippie. It seems, however, that with the acceptance of long hair, the appearance and popularity of some rather bizarre fashions, and the emphasis placed upon \"doing one's own thing,\" freak is no longer burdened with all of its former derogatory associations. Instead […] the word is beginning to acquire a quality which is favorable, glamorous, and somehow even admirable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65320bd7-c105-397a-8794-5bc4765479c7",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "A drug addict."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f1618bb-792c-489d-a7b8-6b30733ff7dd",
                                                "sense_id": "65320bd7-c105-397a-8794-5bc4765479c7",
                                                "text": "Smith and Sturges [June 1969] note in their study of the San Francisco drug scene that freak means \"anyone addicted to drugs.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad2ba898-9176-3376-9046-5b5bce2225a8",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "A person who is extremely abnormal in appearance, social behavior, sexual orientation, gender identity, or business practices; an oddball, a unique person, originally in a displeasing or alienating way."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb6cc65-f334-4bac-b06d-b94e40721376",
                                                "sense_id": "ad2ba898-9176-3376-9046-5b5bce2225a8",
                                                "text": "Gentrification often starts with the artists, revolutionaries, freaks, transfolks, and queers (what I would call my people) moving into poor neighborhoods inhabited by people of color."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef179282-91d1-35b4-a969-d80df490cf43",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "A person whose physique has grown far beyond the normal limits of muscular development; often a bodybuilder weighing more than 260 pounds (120 kg)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3f7aef6-9655-3c37-88bc-ccd1b172be49",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "An enthusiast, or person who has an obsession with, or extreme knowledge of, something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f30823ab-221e-430b-9db1-b8df78331a6e",
                                                "sense_id": "f3f7aef6-9655-3c37-88bc-ccd1b172be49",
                                                "text": "Bob's a real video-game freak. He owns every games console of the last ten years."
                                            },
                                            {
                                                "example_id": "73a4e117-536e-4e9c-a161-a599923f55aa",
                                                "sense_id": "f3f7aef6-9655-3c37-88bc-ccd1b172be49",
                                                "text": "Anyone […] who seems \"hung up\" on some idea, activity or interactional disposition, might be called a \"freak.\""
                                            },
                                            {
                                                "example_id": "125747ff-c25d-4435-b4fb-30d0a6f1033c",
                                                "sense_id": "f3f7aef6-9655-3c37-88bc-ccd1b172be49",
                                                "text": "Presently […] college students […] use freak to denote any kind of enthusiast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0397ebdd-7a43-3006-8c45-2d9c12414f75",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "A very sexually perverse individual."
                                        ],
                                        "tags": [
                                            "endearing",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51d4c961-6ef2-4c65-8e1d-11bd48fd7639",
                                                "sense_id": "0397ebdd-7a43-3006-8c45-2d9c12414f75",
                                                "text": "She's a freak in the sheets!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcdafdf6-b7a3-332d-8251-e50c81d6b9cb",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "A wild dance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a52a8dd-f1da-4210-9588-a181aff5fa25",
                                                "sense_id": "dcdafdf6-b7a3-332d-8251-e50c81d6b9cb",
                                                "text": "Get your freak on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cb90a2c-a378-36c7-ba4d-3cdc282afd3d",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "A sudden change of mind."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a2bc61-e6fd-4a66-ab6f-5b35c0a2f717",
                                                "sense_id": "2cb90a2c-a378-36c7-ba4d-3cdc282afd3d",
                                                "text": "And then, with heart more hard than stone,\nHe pick'd my marrow from the bone.\nTo vex me more, he took a freak\nTo slit my tongue and make me speak:\nBut, that which wonderful appears,\nI speak to eyes, and not to ears."
                                            },
                                            {
                                                "example_id": "0d79efb9-4856-481a-a50e-6d674cfc4fa0",
                                                "sense_id": "2cb90a2c-a378-36c7-ba4d-3cdc282afd3d",
                                                "text": "It would be a great comfort to Mr. Weston, as he grew older—and even Mr. Weston might be growing older ten years hence—to have his fireside enlivened by the sports and the nonsense, the freaks and the fancies of a child never banished from home;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3369d02-a1e9-307c-9579-4c7a9016ce16",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "A streak of colour; variegation."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "339efd05-562e-3937-8560-1cca50856c64",
                                        "entry_id": "50b68b57-994b-3152-92f4-43d7e610d7de",
                                        "glosses": [
                                            "Euphemistic form of fuck (“smallest amount of concern or consideration”)."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1dd347f-6187-4ee7-bd63-3bbbc892c3b8",
                                                "sense_id": "339efd05-562e-3937-8560-1cca50856c64",
                                                "text": "So why am I grieving over someone who doesn't even give a freak about me? These vindictive ideas flowed through my head. A part of me wanted to carve my name into his little Saturn leather seats, but I remembered they weren't leather."
                                            },
                                            {
                                                "example_id": "66e73e10-e0ad-4245-b4e0-4acf0ed27051",
                                                "sense_id": "339efd05-562e-3937-8560-1cca50856c64",
                                                "text": "They hear you, not out in the car, but when you practically say it to their face, they could make things hard for you, just to get back at you. You never know.” “Hey, Flor, not for nothin', but I don't give a freak about them guys or[…]"
                                            },
                                            {
                                                "example_id": "c6f5ddfb-1c4c-4589-9b2a-a2e605676ed4",
                                                "sense_id": "339efd05-562e-3937-8560-1cca50856c64",
                                                "text": "Because I've seen the vampires up there, and they don't give a freak about anyone or anything. Tell me you are different.\" \"I am trying to be. The urges are hard to overcome, but, I assure you, you're safe with me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "freak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef560c2f-b3ec-34d0-8d84-f78146b1123d",
                                        "entry_id": "89bc7e08-ad60-368d-be6b-fe691bd7d91a",
                                        "glosses": [
                                            "To react extremely or irrationally, usually under distress or discomposure."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8851243-4266-4304-b543-a17d05068e88",
                                                "sense_id": "ef560c2f-b3ec-34d0-8d84-f78146b1123d",
                                                "text": "When the owner found a bunch of beatniks in there, he freaked, but that was later."
                                            },
                                            {
                                                "example_id": "579c7a0d-5d80-41ff-bf2c-2c5d407c8854",
                                                "sense_id": "ef560c2f-b3ec-34d0-8d84-f78146b1123d",
                                                "text": "But after one night turned into five days, I was freaking out. I missed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "745c06ad-2dcd-3c04-965e-1aab33b26118",
                                        "entry_id": "89bc7e08-ad60-368d-be6b-fe691bd7d91a",
                                        "glosses": [
                                            "To be placed or place someone under the influence of a psychedelic drug, (especially) to experience reality withdrawal, or hallucinations (nightmarish), to behave irrational or unconventional due to drug use."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25dde872-1df1-3ef8-ae67-a968cf601120",
                                        "entry_id": "89bc7e08-ad60-368d-be6b-fe691bd7d91a",
                                        "glosses": [
                                            "To streak; to variegate"
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a14863f1-daf8-4729-83b6-bf8a7cf406c8",
                                                "sense_id": "25dde872-1df1-3ef8-ae67-a968cf601120",
                                                "text": "Freakt with many a mingled hue."
                                            },
                                            {
                                                "example_id": "5c1969c5-e1c0-45d8-9e44-be523071bf4a",
                                                "sense_id": "25dde872-1df1-3ef8-ae67-a968cf601120",
                                                "text": "[…] in fine diaper of silver and mother-of-pearl freaking the intense azure; Now scurrying close overhead, wild ink-hued random racers that fling sheeted […]"
                                            }
                                        ]
