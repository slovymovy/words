                        "examples": [
                            {
                                "example_id": "456bb8a9-09af-4383-96a1-d3d2e3ab0e88",
                                "sense_id": "3591ca14-42a2-3090-8471-f71bdac69c80",
                                "text": "In het Zuiden van Australie probeert de brandweer een grote bosbrand onder controle te krijgen. Er is inmiddels meer dan 2000 hectare in vlammen opgegaan. Een koala wist de vuurzee te overleven en krijgt water van een voorbijganger. De koala is naar een dierenkliniek in de buurt gebracht, om op krachten te komen."
                            },
                            {
                                "example_id": "5db89c3d-8f47-4d6e-bdab-52126858a1ee",
                                "sense_id": "3591ca14-42a2-3090-8471-f71bdac69c80",
                                "text": "De man uit het Engelse Norfolk nam de vis mee naar een dierenkliniek nadat hij erachter was gekomen dat de vis geconstipeerd was. Hij hoopte dat de vis er door een eenvoudige behandeling weer snel bovenop zou komen, schrijft The Telegraph."
                            }
                        ]
                    }
