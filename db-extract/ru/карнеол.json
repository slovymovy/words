                    {
                        "translation_id": "3bd3a6cf-77ca-4413-becc-8fa842e7cc52",
                        "source_entry_id": "62857505-d679-3378-8eb9-50a845cf7a69",
                        "source_sense_id": "39a46e5f-38b3-33c4-843e-69adf6b4cba3",
