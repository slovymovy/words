                        ],
                        "form": "endeavoured"
                    },
                    {
                        "form_id": "2ae25f39-d8d2-4165-912d-3166ae3ef099",
                        "entry_id": "d9610c0e-27e6-355f-96b4-2c4d59b9972b",
                        "tags": [
                            "past"
                        ],
                        "form": "endeavoured"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b419583-e995-3b6e-a2a8-147c93db7eca",
                        "entry_id": "d9610c0e-27e6-355f-96b4-2c4d59b9972b",
                        "glosses": [
                            "British standard spelling of endeavor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76d29e14-e2f7-4db3-9923-18e0bc40a9f1",
                                "sense_id": "5b419583-e995-3b6e-a2a8-147c93db7eca",
                                "text": "And such were Prais'd who but endeavour'd well."
                            },
                            {
                                "example_id": "7c4f99d7-2ffe-41d7-93d7-a4f08e107fc1",
                                "sense_id": "5b419583-e995-3b6e-a2a8-147c93db7eca",
                                "text": "The other species of philosophers consider man in the light of a reasonable rather than an active being, and endeavour to form his understanding more than cultivate his manners."
                            },
                            {
                                "example_id": "6d7335e4-c8ae-4d4e-9dd7-9f41c1b98e66",
                                "sense_id": "5b419583-e995-3b6e-a2a8-147c93db7eca",
                                "text": "November 20, 1777, William Pitt, 1st Earl of Chatham, Debate in the Lords on the Address of Thanks\nIt is our duty […] to endeavour the recovery of these most beneficial subjects."
                            },
                            {
                                "example_id": "a1c25f26-1a70-4c38-85ec-aca50566a1f2",
                                "sense_id": "5b419583-e995-3b6e-a2a8-147c93db7eca",
                                "text": "If you be affronted, it is better, in a foreign country, to pass it by in silence, and with a jest, though with some dishonour, than to endeavour revenge; for, in the first case, your credit's ne'er the worse when you return into England, or come into other company that have not heard of the quarrel."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
