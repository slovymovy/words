    ],
    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "07743635-571a-3aee-9f05-ead5a71bce26",
                    "sense_definition": "Порядковое числительное, следующее за вторым и перед четвёртым.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы живём на <w>третьем</w> этаже пятиэтажного дома.",
                            "target_lang_translations": {
                                "en": "We live on the <w>third</w> floor of a five-story building.",
                                "nl": "We wonen op de <w>derde</w> verdieping van een gebouw met vijf verdiepingen.",
                                "zh": "我们住在五层楼房的<w>第三</w>层。"
                            }
                        },
                        {
                            "text": "Это уже <w>третий</w> раз, когда я пытаюсь тебе дозвониться.",
                            "target_lang_translations": {
                                "en": "This is already the <w>third</w> time I've tried to call you.",
                                "nl": "Dit is al de <w>derde</w> keer dat ik je probeer te bellen.",
                                "zh": "这已经是我<w>第三</w>次尝试给你打电话了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "третий раз",
                        "третий день",
                        "третий этаж",
                        "третий лишний"
                    ],
                    "target_lang_definitions": {
                        "en": "An ordinal numeral following the second and preceding the fourth.",
                        "nl": "Rangtelwoord dat volgt op het tweede en voorafgaat aan het vierde.",
                        "zh": "序数词，排在第二之后、第四之前。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "third",
                                "target_lang_sense_clarification": "ordinal number"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "derde",
                                "target_lang_sense_clarification": "rangtelwoord"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第三",
                                "target_lang_sense_clarification": "序数词，表示顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "365d3362-7f6c-3e17-ba49-9b8917475230",
                    "sense_definition": "Обозначение времени в пределах часа, следующего за двумя часами (от 02:00 до 03:00 или от 14:00 до 15:00).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы договорились встретиться в половине <w>третьего</w>.",
                            "target_lang_translations": {
                                "en": "We agreed to meet at half past <w>two</w>.",
                                "nl": "We hebben afgesproken om om half <w>drie</w> af te spreken.",
                                "zh": "我们约好在<w>两点半</w>见面。"
                            }
                        },
                        {
                            "text": "Уже пошёл <w>третий</w> час, а мы всё ещё ждём автобус.",
                            "target_lang_translations": {
                                "en": "It's already the <w>third</w> hour, and we are still waiting for the bus.",
                                "nl": "Het is al over <w>tweeën</w>, en we wachten nog steeds op de bus.",
                                "zh": "已经<w>两点多</w>了，我们还在等公交车。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "половина третьего",
                        "в начале третьего"
                    ],
                    "target_lang_definitions": {
                        "en": "A designation of time within the hour following two o'clock (from 02:00 to 03:00 or 14:00 to 15:00).",
                        "nl": "Aanduiding van de tijd binnen het uur dat volgt op twee uur (van 02:00 tot 03:00 of van 14:00 tot 15:00).",
                        "zh": "指两点到三点之间的时间段（02:00-03:00 或 14:00-15:00）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "third",
                                "target_lang_sense_clarification": "referring to the current hour"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "drie",
                                "target_lang_sense_clarification": "bij tijdsaanduiding, bijv. half drie"
                            },
                            {
                                "target_lang_word": "derde",
                                "target_lang_sense_clarification": "verwijzend naar het lopende uur"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "两点多",
                                "target_lang_sense_clarification": "指两点之后的时间"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1b6cc396-1022-314c-8259-5d0246c61f3c",
                    "sense_definition": "Посторонний, не участвующий непосредственно в деле, конфликте или диалоге (о лице или стороне).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В наш спор не должна вмешиваться <w>третья</w> сторона.",
                            "target_lang_translations": {
                                "en": "A <w>third</w> party should not interfere in our dispute.",
                                "nl": "Een <w>derde</w> partij mag zich niet met ons geschil bemoeien.",
                                "zh": "我们的争论不应该有<w>第三方</w>介入。"
                            }
                        },
                        {
                            "text": "Эта конфиденциальная информация не должна быть передана <w>третьим</w> лицам.",
                            "target_lang_translations": {
                                "en": "This confidential information must not be passed on to <w>third</w> parties.",
                                "nl": "Deze vertrouwelijke informatie mag niet aan <w>derden</w> worden verstrekt.",
                                "zh": "这些机密信息不得泄露给<w>第三方</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "посторонний",
                        "внешний"
                    ],
                    "common_phrases": [
                        "третье лицо",
                        "третья сторона"
                    ],
                    "target_lang_definitions": {
                        "en": "An outsider, someone not directly participating in a matter, conflict, or dialogue.",
                        "nl": "Een buitenstaander, iemand die niet direct betrokken is bij een zaak, conflict of dialoog.",
                        "zh": "指不直接参与某事、冲突或对话的外部人员或一方。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "third",
                                "target_lang_sense_clarification": "external, additional party"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "derde",
                                "target_lang_sense_clarification": "externe partij"
                            },
                            {
                                "target_lang_word": "derden",
                                "target_lang_sense_clarification": "andere personen, buitenstaanders"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第三方",
                                "target_lang_sense_clarification": "指外部参与者"
                            },
                            {
                                "target_lang_word": "第三者",
                                "target_lang_sense_clarification": "指介入他人关系或事务的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1229cde6-80ed-3b85-90f7-23d885c081ce",
                    "sense_definition": "Сладкое блюдо, которое подают в конце обеда; десерт.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На <w>третье</w> нам принесли вкусное мороженое.",
                            "target_lang_translations": {
                                "en": "For <w>dessert</w> they brought us delicious ice cream.",
                                "nl": "Als <w>dessert</w> brachten ze ons heerlijk ijs.",
                                "zh": "他们给我们端上了美味的<w>甜点</w>。"
                            }
                        },
                        {
                            "text": "Обычно я не заказываю <w>третье</w>, потому что наедаюсь супом.",
                            "target_lang_translations": {
                                "en": "I usually don't order <w>dessert</w> because I get full on soup.",
                                "nl": "Meestal bestel ik geen <w>nagerecht</w> omdat ik al vol zit van de soep.",
                                "zh": "我通常不点<w>甜点</w>，因为喝汤就饱了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "десерт",
                        "сладкое"
                    ],
                    "antonyms": [
                        "первое",
                        "второе"
                    ],
                    "common_phrases": [
                        "на третье",
                        "компот на третье"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "субстантивированное прилагательное (средний род)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A sweet dish served at the end of a meal; dessert.",
                        "nl": "Een zoet gerecht dat aan het einde van een maaltijd wordt geserveerd; dessert.",
                        "zh": "正餐最后一道甜味菜肴；甜点。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dessert",
                                "target_lang_sense_clarification": "sweet course"
                            },
                            {
                                "target_lang_word": "third course",
                                "target_lang_sense_clarification": "culinary term"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dessert",
                                "target_lang_sense_clarification": "nagerecht"
                            },
                            {
                                "target_lang_word": "nagerecht",
                                "target_lang_sense_clarification": "zoet gerecht aan het einde van de maaltijd"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甜点",
                                "target_lang_sense_clarification": "餐后甜食"
                            },
                            {
                                "target_lang_word": "第三道菜",
                                "target_lang_sense_clarification": "西餐中指甜点"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}