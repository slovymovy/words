                "senses": [
                    {
                        "sense_id": "770c3e94-934a-37ce-add6-0d020a4c6af7",
                        "entry_id": "d65d75b8-78e6-32df-8431-0dc41d274bb9",
                        "glosses": [
                            "die geordnete Organisation der Verteilung von Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e19c1ec-8b2c-4c13-b74a-5b4a77d61a80",
                                "sense_id": "770c3e94-934a-37ce-add6-0d020a4c6af7",
                                "text": "„Weil das Wassermanagement der gesamten Gemeinschaft zugutekam, verfestigte sich wohl auch die bestehende Gesellschaftsordnung.“"
                            },
                            {
                                "example_id": "c4b57103-a3d5-4eef-8635-b30cb815547e",
                                "sense_id": "770c3e94-934a-37ce-add6-0d020a4c6af7",
                                "text": "[Wassermangel in Städten:] „Langfristig denken Städte ihr Wassermanagement neu, um Wasser zu sparen, die Infrastruktur anzupassen und natürliche Wasserquellen besser zu nutzen.“"
                            },
                            {
                                "example_id": "473bc1fb-b3bc-4362-a88b-cb883111a612",
                                "sense_id": "770c3e94-934a-37ce-add6-0d020a4c6af7",
                                "text": "„Effizientes städtisches Wassermanagement wird weltweit immer wichtiger, um den wachsenden Bedarf zu decken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
