                "senses": [
                    {
                        "sense_id": "88be5411-6c41-3d4f-b6f7-9522e8a43715",
                        "entry_id": "d3eaf3c4-380f-366e-8305-784a9b1a26ef",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße extravagantes, elegantes (mondänes) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c90cb859-1df3-4a61-8892-95d69545c11e",
                                "sense_id": "88be5411-6c41-3d4f-b6f7-9522e8a43715",
                                "text": "„Das trifft auch auf den Cosmopolitan zu, der sowohl seinem Namen nach als auch in der Art, wie er Mondänität vermittelt, und selbst in seiner Ausstrahlungskraft durchweg mondän ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "99300d5d-a840-3fb7-834c-3ff7de8cc614",
                        "entry_id": "d3eaf3c4-380f-366e-8305-784a9b1a26ef",
                        "glosses": [
                            "Sache/Handlung, die man als extravagant elegant bezeichnen kann"
                        ],
                        "tags": [
                            "mit Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5b4dc365-f608-4385-9cbc-24a21c15962e",
                                "sense_id": "99300d5d-a840-3fb7-834c-3ff7de8cc614",
                                "text": "„Sie wählte eindeutig zuerst das Leben einer Hausfrau gegenüber den Mondänitäten, das der Kindererziehung gegenüber den Frivolitäten, das der Hingabe gegenüber dem ambitionierten Streben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
