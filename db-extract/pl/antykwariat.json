                                        "entry_id": "e7c53b16-bf12-363d-9572-9656bbb2137d",
                                        "glosses": [
                                            "Geschäft, in dem alte, oft restaurierte Gegenstände (Antiquitäten) verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b16e978-c49c-4850-977b-56a76d93d2a8",
                                                "sense_id": "eda25c15-4ba5-3edd-a396-23be481f3514",
                                                "text": "„Die Tür des Antiquitätenladens, vor dem ich stand, öffnete sich plötzlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
