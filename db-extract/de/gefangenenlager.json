                ],
                "senses": [
                    {
                        "sense_id": "a7cb6c8e-1943-341a-8261-8ca3684451c3",
                        "entry_id": "f1145082-9d83-3180-8808-22118602e705",
                        "glosses": [
                            "ein Lager, in dem Gefangene festgehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b35f96e2-2b00-4304-9c47-95471b6a124f",
                                "sense_id": "a7cb6c8e-1943-341a-8261-8ca3684451c3",
                                "text": "Kurz nach Kriegsende hatten sie sich das letzte mal in einem Gefangenenlager der Russen getroffen."
                            },
                            {
                                "example_id": "b94f6485-1756-470a-85a7-aced38f019ba",
                                "sense_id": "a7cb6c8e-1943-341a-8261-8ca3684451c3",
                                "text": "„Sie sollten ins dritte Gefangenenlager gebracht werden, in die Nähe der Hauptstadt.“"
                            },
                            {
                                "example_id": "e38b09be-4b41-42c4-9998-c5cc25909b9f",
                                "sense_id": "a7cb6c8e-1943-341a-8261-8ca3684451c3",
                                "text": "„Nguyen und seine Mitgefangenen werden unmittelbar damit beauftragt, das Gefangenenlager aufzubauen und den Wald zu roden, um Nahrungsmittel anbauen zu können.“"
                            },
                            {
                                "example_id": "b6805274-dc3a-4a26-a340-edcefb473d9d",
                                "sense_id": "a7cb6c8e-1943-341a-8261-8ca3684451c3",
                                "text": "„An der Stelle, wo sich das Gefangenenlager befand, steht seit einigen Jahren ein Zeltplatz, und alle, die hier campen, kommen freiwillig.“"
                            },
                            {
                                "example_id": "86992482-b68a-40a2-96c3-d5245469512e",
                                "sense_id": "a7cb6c8e-1943-341a-8261-8ca3684451c3",
                                "text": "„Erst war Otto aus dem sibirischen Gefangenenlager nach Petrograd überstellt worden, wurde dort von einer ärztlichen Kommission als invalid eingestuft und dann im Rahmen eines Gefangenenaustauschs im September heimgeschickt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
