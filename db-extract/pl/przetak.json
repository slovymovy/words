                        "entry_id": "95c9493a-dbcd-3103-84f7-1c6987bdb0eb",
                        "glosses": [
                            "rodzaj sita gospodarskiego z większymi otworami, służącego do oczyszczania ziarna"
                        ],
                        "tags": [
