                "senses": [
                    {
                        "sense_id": "e7af1d73-e31d-3718-9ca9-611379f59388",
                        "entry_id": "522c778d-8e75-3abf-877e-619b5714f0fd",
                        "glosses": [
                            "Hut, der zum Schutz gegen die Sonne getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93a57f3b-6fe3-48b9-9c33-99bf46be7233",
                                "sense_id": "e7af1d73-e31d-3718-9ca9-611379f59388",
                                "text": "„Dort saß auf einer Bank ein dickes Kindermädchen in einem Schürzenkleid und Sonnenhut mit einem winzigen weißen Mädchen auf ihrem riesigen, weichen Schoß.“"
                            },
                            {
                                "example_id": "ef016e33-a667-44f6-ba0f-8dabe21f8a5b",
                                "sense_id": "e7af1d73-e31d-3718-9ca9-611379f59388",
                                "text": "„Almuth legte ihren Sonnenhut auf die Rückbank und band sich das Tuch um den Kopf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0b58ddee-4c6b-325f-bf66-a37c3cb43e5a",
