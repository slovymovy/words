                "senses": [
                    {
                        "sense_id": "63265aa7-73c1-3e61-b4a3-8733c771b043",
                        "entry_id": "06dd6ae2-aa1d-30bc-9ccf-49a4b5c8332f",
                        "glosses": [
                            "Spielerin auf einer defensiven Position beim Fußball und Volleyball"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5135fbd-976f-4609-afdf-aa52ced74b3b",
                                "sense_id": "63265aa7-73c1-3e61-b4a3-8733c771b043",
                                "text": "„Neben Kozuch wussten im Angriff auch Maren Brinker und Heike Beier zu überzeugen, Libera Lenka Dürr zeigte eine souveräne Leistung.“"
                            },
                            {
                                "example_id": "5a87bcc1-d474-41b0-8d18-cf8ba9ee8223",
                                "sense_id": "63265aa7-73c1-3e61-b4a3-8733c771b043",
                                "text": "„Es ist verwunderlich - und für ein modernes Spiel kontraproduktiv - noch eine letzte Frau hinter die Abwehr zu postieren. Doch Nationaltrainer Lima, 37 Jahre jung, benötigt tatsächlich eine Libera.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
