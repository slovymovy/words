                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gig",
                                "target_lang_sense_clarification": "A temporary or freelance job, often informal."
                            },
                            {
                                "target_lang_word": "side hustle",
                                "target_lang_sense_clarification": "A popular term for a secondary job done for extra income."
                            },
                            {
                                "target_lang_word": "moonlighting",
                                "target_lang_sense_clarification": "Working a second job, often at night or secretly."
