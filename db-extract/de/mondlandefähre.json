                "senses": [
                    {
                        "sense_id": "195aca5a-efa8-323b-8931-a9c210e0e45e",
                        "entry_id": "f1f21e05-a30c-30e7-8d0c-0cb8a847f745",
                        "glosses": [
                            "Teil eines Raumfahrzeugs, der die Landung auf dem Mond ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b808a40f-0835-4a5f-891e-2bdbc9922ad8",
                                "sense_id": "195aca5a-efa8-323b-8931-a9c210e0e45e",
                                "text": "Als Neil Armstrong die Mondlandefähre verließ und den Mond betrat, war dies ein großer Augenblick für die gesamte Menschheit."
                            },
                            {
                                "example_id": "964f3a07-2161-4593-a411-979a30e342f9",
                                "sense_id": "195aca5a-efa8-323b-8931-a9c210e0e45e",
                                "text": "„Die Mondlandefähre, der Eagle, setzte auf.“"
                            },
                            {
                                "example_id": "df4d186a-2532-4d48-a3ae-3725f7874809",
                                "sense_id": "195aca5a-efa8-323b-8931-a9c210e0e45e",
                                "text": "„Die Mondlandefähre, ein 15 Meter hohes spinnenartiges Ungetüm mit nur millimeterdicker Aluminiumhaut, sollte zwei Astronauten sicher vom Mondorbit zur Mondoberfläche und zurück bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
