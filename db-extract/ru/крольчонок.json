                                "target_senses": [
                                    {
                                        "sense_id": "b2672292-727a-3ada-92ef-602a9d82b8fb",
                                        "entry_id": "4b5d8d90-a8c9-389a-8f56-210070d09efb",
                                        "glosses": [
                                            "Jeune lapin."
                                        ],
                                        "tags": [
                                            "Glirologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "881712ed-3381-44d3-8165-e1bed0547045",
                                                "sense_id": "b2672292-727a-3ada-92ef-602a9d82b8fb",
                                                "text": "Continuez en revanche à les faire cohabiter en votre présence si le lapereau parvient à se contenir et que l’autre lapin le supporte parfaitement."
                                            },
                                            {
                                                "example_id": "d391677b-4e4d-492c-8ab9-c6f5e57ed0ee",
                                                "sense_id": "b2672292-727a-3ada-92ef-602a9d82b8fb",
                                                "text": "es garçons enlevaient les assiettes à potage, des crépinettes de lapereaux aux truffes et des niokys au parmesan circulaient."
                                            },
                                            {
                                                "example_id": "aecfcef0-be30-428b-ba7b-1bc72576e0d9",
                                                "sense_id": "b2672292-727a-3ada-92ef-602a9d82b8fb",
                                                "text": "Asepsie. Mesures de précaution que l'on doit prendre après une opération chirurgicale quelconque, pratiquée sur les animaux de basse-cour, notamment lorsqu'on castre les coquelets et les lapereaux, pour éviter l'infection des plaies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
