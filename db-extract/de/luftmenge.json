                ],
                "senses": [
                    {
                        "sense_id": "226a9df0-65eb-30cf-849b-ca1eb4892b24",
                        "entry_id": "1c311d7d-141a-3394-bd3f-6ecf0bbf59cb",
                        "glosses": [
                            "Menge an Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c93cf968-c53f-4d4c-9f7b-6365509771ed",
                                "sense_id": "226a9df0-65eb-30cf-849b-ca1eb4892b24",
                                "text": "„Ein Ballon steigt solange in die Höhe, bis die Dichte der ihn umgebenden Luft so gering ist, daß das Gewicht des Ballons dem Gewicht der von ihm insgesamt verdrängten Luftmenge entspricht.“"
                            },
                            {
                                "example_id": "19524a78-f1f1-4536-a87a-eda1af3510d1",
                                "sense_id": "226a9df0-65eb-30cf-849b-ca1eb4892b24",
                                "text": "„Bei einem gesunden Organismus beträgt die Luftmenge, die bei normaler, ruhiger Atmung ein- und ausgeatmet wird, etwa 500 Milliliter, was nahezu dem Volumen eines Fußballs entspricht.“"
                            },
                            {
                                "example_id": "3da5a59f-6c97-403c-9ddc-5ecd8622ff2d",
                                "sense_id": "226a9df0-65eb-30cf-849b-ca1eb4892b24",
                                "text": "„Bei einem in großer Höhe lebenden Menschen beträgt die in einer Minute ein- und ausgeatmete Luftmenge acht bis neun Liter gegenüber sechs Liter auf Meereshöhe.“"
                            },
                            {
                                "example_id": "70fa8810-0797-4ab6-b851-15167e7a1fe1",
                                "sense_id": "226a9df0-65eb-30cf-849b-ca1eb4892b24",
                                "text": "„Weil Scramjets große Luftmengen auffangen müssen, verschwimmt der Unterschied zwischen Flugkörper und Triebwerk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
