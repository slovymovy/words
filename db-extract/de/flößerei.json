                        "sense_id": "4d0f8d95-2dc3-3652-9167-7eec7cc6ba85",
                        "entry_id": "e7c451d4-a7ab-3894-96ab-292eb0fa74a3",
                        "glosses": [
                            "Gesamtheit der Aktivitäten um den Transport von Baumstämmen auf dem Wasser mittels Flößen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa2b514d-2583-436a-accf-80c08536404d",
                                "sense_id": "4d0f8d95-2dc3-3652-9167-7eec7cc6ba85",
                                "text": "„Im 17. Jahrhundert erfolgte aufgrund der zunehmenden Flößerei eine Sohlenvertiefung auf vier Meter, an der Wasserlinie auf vierzehn Meter Breite.“"
                            },
                            {
                                "example_id": "b096133e-0653-4eba-970a-2d512ba9d9dd",
                                "sense_id": "4d0f8d95-2dc3-3652-9167-7eec7cc6ba85",
                                "text": "„Ohne Flößerei wäre die Versorgung der Städte mit Bauholz gar nicht möglich gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
