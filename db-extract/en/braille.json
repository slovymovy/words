                    {
                        "translation_id": "4aa2d44b-efe6-4168-aeaf-8596db4ad4be",
                        "source_entry_id": "30621f05-1071-3837-83ac-5389e9a353d5",
                        "source_sense_id": "f666a3d6-029c-30b0-ad7c-e6b93b94beb0",
                        "source_sense_description": "system of writing using raised dots",
                        "target_lang_word": "Brailleschrift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brailleschrift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6feb712-c764-3808-be70-f0c6ebf11683",
                                        "entry_id": "79239d5f-2eba-3370-b900-521bcab7cb7d",
                                        "glosses": [
                                            "Blindenschrift, eine Schrift für blinde Personen, bei der die Buchstaben kombinatorisch auf je sechs erhabenen, meist in Papier eingeprägten Punkten abgebildet sind, und daher ertastet werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74c15ae6-843e-46b4-925f-5980e4de8d1c",
                                                "sense_id": "a6feb712-c764-3808-be70-f0c6ebf11683",
                                                "text": "Die Brailleschrift ist wohl die bekannteste der Blindenschriften."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff0a98b5-3e79-4d1e-93a4-ee3b50bc68b4",
                        "source_entry_id": "30621f05-1071-3837-83ac-5389e9a353d5",
                        "source_sense_id": "f666a3d6-029c-30b0-ad7c-e6b93b94beb0",
                        "source_sense_description": "system of writing using raised dots",
                        "target_lang_word": "Blindenschrift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blindenschrift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d074e2f0-09db-314f-9877-01d2a18e6bb6",
                                        "entry_id": "d8c772a4-4880-35b8-87db-fdc9387d5a46",
                                        "glosses": [
                                            "eine Schrift für blinde Personen, die so gestaltet ist, dass sie ertastet werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f0ad5fd-43f6-442b-bfe6-79c2333af8dd",
                                                "sense_id": "d074e2f0-09db-314f-9877-01d2a18e6bb6",
                                                "text": "„»Wir möchten auch erreichen, dass die Blindenschrift die Förderung erhält, die sie weiterhin braucht«, erklärte der Geschäftsführer des Deutschen Blinden- und Sehbehindertenverbandes, Andreas Bethke.“"
                                            },
                                            {
                                                "example_id": "bed1a916-7713-4ab2-bdfd-ddb6eda0f0d9",
                                                "sense_id": "d074e2f0-09db-314f-9877-01d2a18e6bb6",
                                                "text": "„Von seiner Herkunftsgruppe nun auf Dauer räumlich getrennt und ihrer Entwicklung entzogen, wird er in der Religion unterwiesen und erlernt zu seiner Muttersprache Romanes Deutsch, die Blindenschrift und ein Handwerk: wie das Zigeunerstoffele das Holzschnitzen.“"
                                            },
                                            {
                                                "example_id": "e7cdd78d-c6cb-4dc8-81a7-5568319075ee",
                                                "sense_id": "d074e2f0-09db-314f-9877-01d2a18e6bb6",
                                                "text": "„Nur zu bekannt sind all die Erzählungen vom Schotten, der die Blindenschrift lernt, um abends beim Lesen Strom zu sparen, der keine Leselampe kauft, um nicht auch noch ein Buch anschaffen zu müssen, und der in der Dunkelheit bei der ohnehin gesparten Beleuchtung seine Hose auszieht, um sie nicht unnötig abzunutzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
