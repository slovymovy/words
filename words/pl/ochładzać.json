    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7ebb6de-07f5-3e7a-b757-3436bffec0fe",
                    "sense_definition": "powodować obniżenie temperatury czegoś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperatura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W upalne popołudnie chłodny wiatr przyjemnie <w>ochładza</w> rozgrzane powietrze w całym pokoju.",
                            "target_lang_translations": {
                                "ru": "В жаркий полдень прохладный ветер приятно <w>охлаждает</w> нагретый воздух во всей комнате."
                            }
                        },
                        {
                            "text": "Klimatyzator szybko <w>ochładza</w> nagrzane pomieszczenie biurowe przed przyjściem pracowników.",
                            "target_lang_translations": {
                                "ru": "Кондиционер быстро <w>охлаждает</w> нагретое офисное помещение перед приходом сотрудников."
                            }
                        }
                    ],
                    "synonyms": [
                        "oziębiać",
                        "studzić"
                    ],
                    "common_phrases": [
                        "ochładzać powietrze",
                        "ochładzać napój"
                    ],
                    "target_lang_definitions": {
                        "ru": "понижать температуру чего-либо, делать более холодным или прохладным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охлаждать",
                                "target_lang_sense_clarification": "воздух, напитки, помещение"
                            },
                            {
                                "target_lang_word": "остужать",
                                "target_lang_sense_clarification": "горячую еду, жидкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb180b5e-2e3f-3354-afe9-da783ed3eb5f",
                    "sense_definition": "stawać się chłodniejszym, tracić ciepło",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperatura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wieczorem nagrzana przez słońce ziemia powoli się <w>ochładza</w>.",
                            "target_lang_translations": {
                                "ru": "Вечером нагретая солнцем земля медленно <w>охлаждается</w>."
                            }
                        },
                        {
                            "text": "Kiedy gorąca zupa za bardzo się <w>ochładza</w>, trzeba ją ponownie podgrzać na kuchence.",
                            "target_lang_translations": {
                                "ru": "Когда горячий суп слишком сильно <w>остывает</w>, его нужно снова подогреть на плите."
                            }
                        }
                    ],
                    "synonyms": [
                        "oziębiać się",
                        "studzić się"
                    ],
                    "common_phrases": [
                        "powoli się ochładzać"
                    ],
                    "target_lang_definitions": {
                        "ru": "становиться более холодным, терять тепло (о температуре)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охлаждаться",
                                "target_lang_sense_clarification": "о воздухе, земле, предметах"
                            },
                            {
                                "target_lang_word": "остывать",
                                "target_lang_sense_clarification": "о горячей еде, напитках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c333d496-1618-327b-8925-08c489a20223",
                    "sense_definition": "czynić relacje lub emocje mniej serdecznymi albo mniej intensywnymi",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kolejny spór o pieniądze skutecznie <w>ochładza</w> relacje między wspólnikami w firmie.",
                            "target_lang_translations": {
                                "ru": "Очередной спор из-за денег заметно <w>охлаждает</w> отношения между партнерами по компании."
                            }
                        },
                        {
                            "text": "Dyrektor celowo <w>ochładza</w> emocje panujące wśród pracowników podczas trudnego zebrania.",
                            "target_lang_translations": {
                                "ru": "Директор намеренно <w>охлаждает</w> эмоции сотрудников во время непростого собрания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ochładzać relacje",
                        "ochładzać stosunki",
                        "ochładzać emocje"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать отношения или эмоции менее тёплыми, бурными или интенсивными"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охлаждать",
                                "target_lang_sense_clarification": "отношения, пыл, эмоции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3503a98-deed-315c-9646-7155be30b108",
                    "sense_definition": "tracić dawną serdeczność, stawać się bardziej powściągliwym lub obojętnym",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po tamtym nieporozumieniu ich dawna przyjaźń wyraźnie się <w>ochładza</w>.",
                            "target_lang_translations": {
                                "ru": "После того недоразумения их давняя дружба заметно <w>охладевает</w>."
                            }
                        },
                        {
                            "text": "Z czasem kontakty z dawnymi sąsiadami powoli się <w>ochładzają</w>.",
                            "target_lang_translations": {
                                "ru": "Со временем контакты со старыми соседями постепенно <w>охлаждаются</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stosunki się ochładzają"
                    ],
                    "target_lang_definitions": {
                        "ru": "терять душевную теплоту, становиться более сдержанным или равнодушным (об отношениях)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охладевать",
                                "target_lang_sense_clarification": "о чувствах, привязанности"
                            },
                            {
                                "target_lang_word": "охлаждаться",
                                "target_lang_sense_clarification": "об отношениях, контактах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}