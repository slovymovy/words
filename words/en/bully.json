                                "target_lang_sense_clarification": "физически сильный и опасный человек"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "pestkop",
                                "target_lang_sense_clarification": "iemand die anderen op een gemene manier plaagt of kwelt"
                            },
                            {
