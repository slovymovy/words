                "senses": [
                    {
                        "sense_id": "8fc40790-7cad-30f8-a51d-8aa9c9c81453",
                        "entry_id": "b5c8a3c5-74b2-377c-b4e8-b4af2eb13de5",
                        "glosses": [
                            "воен. относящийся к танковому десанту"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecfa7adb-1fff-4583-94e7-8363787ccacd",
                                "sense_id": "8fc40790-7cad-30f8-a51d-8aa9c9c81453",
                                "text": "Далее в первом эшелоне следует первый танковый батальон с танкодесантной ротой МСПБ."
                            }
                        ]
                    },
                    {
                        "sense_id": "7183f329-f86e-3ab8-8bfa-0a0669c71030",
                        "entry_id": "b5c8a3c5-74b2-377c-b4e8-b4af2eb13de5",
                        "glosses": [
                            "воен. о корабле: предназначенный для перевозки и высадки на необорудованное побережье войск десанта, танков и другой бронетанковой техники"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa83cd5e-12f8-4c6c-9cc4-f4274b3cabd5",
                                "sense_id": "7183f329-f86e-3ab8-8bfa-0a0669c71030",
                                "text": "Рассматривается вопрос о закупке тральщиков, судов на воздушной подушке, танкодесантных корабля и катера, а также высокоскоростного десантного транспорта катамаранного типа, предназначенного для перевозки личного состава."
                            }
                        ]
                    }
