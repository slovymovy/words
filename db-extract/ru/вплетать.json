                    },
                    {
                        "translation_id": "48c62fe5-2904-48b1-89db-f9e4295378b2",
                        "source_entry_id": "d15d2f27-6716-3f8a-aa5b-e77b6ed4f0ba",
                        "source_sense_description": "вставлять что-либо куда-либо посредством плетения",
                        "target_lang_word": "entwine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entwine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbfb3515-0360-3bbf-bbe5-06da279ff737",
                                        "entry_id": "01741bf6-1d9f-3618-bf4d-38d58eae9c03",
                                        "glosses": [
                                            "To twist or twine around something (or one another)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4ac9651-4854-4b48-9902-5c261a6d7b03",
                                                "sense_id": "fbfb3515-0360-3bbf-bbe5-06da279ff737",
                                                "text": "Twilight, ascending slowly from the east, / Entwin'd in duskier wreaths her braided locks / O'er the fair front and radiant eyes of day; […]"
                                            },
                                            {
                                                "example_id": "0b2999be-9599-4716-b80b-fbff2c680ba2",
                                                "sense_id": "fbfb3515-0360-3bbf-bbe5-06da279ff737",
                                                "text": "Swearing doesn't just mean what we now understand by \"dirty words\". It is entwined, in social and linguistic history, with the other sort of swearing: vows and oaths."
                                            },
                                            {
                                                "example_id": "b125df7a-d037-483c-952c-e5261953b68d",
                                                "sense_id": "fbfb3515-0360-3bbf-bbe5-06da279ff737",
                                                "text": "And with the story of the booking office, we have a fortune deeply entwined with the stations encasing them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33cbd8d4-266c-4e1e-b0bb-6795d63c5a86",
                        "source_entry_id": "d15d2f27-6716-3f8a-aa5b-e77b6ed4f0ba",
                        "source_sense_description": "вставлять что-либо в рассказ, повествование",
                        "target_lang_word": "intersperse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intersperse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1814b18b-70d8-32b9-a082-8a23b33fc375",
                                        "entry_id": "9926d86d-a5b1-304a-a5b0-f18b0997a472",
                                        "glosses": [
                                            "To mix two things irregularly, placing things of one kind among things of other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baa3ec70-6a79-4778-a812-38624e9166d6",
                                                "sense_id": "1814b18b-70d8-32b9-a082-8a23b33fc375",
                                                "text": "For example, a commercial sequence might intersperse pictures of a senator working in his office with shots of ordinary Americans happily working in various walks of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f9a44ff-f8ff-3b98-994c-d331941517c6",
                                        "entry_id": "9926d86d-a5b1-304a-a5b0-f18b0997a472",
                                        "glosses": [
                                            "To scatter or insert something into or among other things."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "504f15c9-a14c-4577-aafc-5daf05762c00",
                                                "sense_id": "3f9a44ff-f8ff-3b98-994c-d331941517c6",
                                                "text": "When writing, I intersperse details."
                                            },
                                            {
                                                "example_id": "323bd942-df1b-4a95-a6f0-0848efac4ba2",
                                                "sense_id": "3f9a44ff-f8ff-3b98-994c-d331941517c6",
                                                "text": "Kjelsås (six miles) marks the end of the suburbs, and the line immediately plunges into Nordmarka. This vast untamed area of forest and mountain (much of it over 2,000 ft. above sea level), interspersed with innumerable lakes, large and small, is known as Oslo's playground."
                                            },
                                            {
                                                "example_id": "ac018486-bc06-4eb2-ae5a-dc8a34cd9a87",
                                                "sense_id": "3f9a44ff-f8ff-3b98-994c-d331941517c6",
                                                "text": "Review tasks are particularly useful to intersperse when students are experiencing considerable failure."
                                            },
                                            {
                                                "example_id": "d9d22288-8eb4-439c-a897-44a0c661d992",
                                                "sense_id": "3f9a44ff-f8ff-3b98-994c-d331941517c6",
                                                "text": "Goffin is a prose text interspersed with short lists of typical terms exemplifying certain sub-classes of Indian English lexis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2577d917-2d50-31ad-bea7-b66a888661f2",
                                        "entry_id": "9926d86d-a5b1-304a-a5b0-f18b0997a472",
                                        "glosses": [
                                            "To diversify by placing or inserting other things among something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f01a411-d283-4308-a822-46d4ac52e73d",
                                                "sense_id": "2577d917-2d50-31ad-bea7-b66a888661f2",
                                                "text": "Mother Nature interspersed the petunias with a few dandelions, but it was a pretty garden, anyway."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
