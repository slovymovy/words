                    {
                        "sense_id": "05893f6b-606b-3c37-a366-6e3e3d48b35b",
                        "entry_id": "7215cfc0-7a55-3df9-8ec6-1b3af000ac30",
                        "glosses": [
                            "Personenschiff, speziell Dampfschiff, das für den Ausflugsverkehr eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7de4d35-aeee-4c17-b713-ec0334ff96e4",
                                "sense_id": "05893f6b-606b-3c37-a366-6e3e3d48b35b",
                                "text": "„Auf dem Weg dorthin sahen sie Frachter und Ausflugsdampfer auf der linken Dammseite vorbeifahren und Züge und Autos auf der rechten.“"
                            },
                            {
                                "example_id": "596e6a21-bbb9-40fc-a5df-c0f10edf11dd",
                                "sense_id": "05893f6b-606b-3c37-a366-6e3e3d48b35b",
                                "text": "Als Höhepunkt der Sightseeingtour erwartet uns eine Fahrt mit einem Ausflugsdampfer."
                            },
                            {
                                "example_id": "4562d922-3957-4b7b-932e-ec2e5d4e34f6",
                                "sense_id": "05893f6b-606b-3c37-a366-6e3e3d48b35b",
                                "text": "„Kommt man in Bacharach mit dem Ausflugsdampfer oder der Fähre an, trifft man als Allererstes, mitten an der Promenade, in einem kleinen Landschaftsgarten, auf drei Skulpturen, die zusammen um einen Tisch sitzen, auf dem zwei Gläser und eine Weinflasche stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
