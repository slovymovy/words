                "senses": [
                    {
                        "sense_id": "7d5a30b7-8308-3ea7-bec7-49af1a5b1654",
                        "entry_id": "05e08bec-3ce8-3e32-9710-6e8bd575515c",
                        "glosses": [
                            "Wand voller Bücherregale und/oder -schränke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799185c7-26a6-4e0a-841c-e08587cb5b3a",
                                "sense_id": "7d5a30b7-8308-3ea7-bec7-49af1a5b1654",
                                "text": "„Außerdem gab es in dem Laden noch eine breite Bücherwand mit alten, antiquarischen Noten.“"
                            },
                            {
                                "example_id": "8f26ce0b-74a2-4f42-81bf-05c1364b3787",
                                "sense_id": "7d5a30b7-8308-3ea7-bec7-49af1a5b1654",
                                "text": "„Marga deutete auf ihre Bücherwand.“"
                            },
                            {
                                "example_id": "162aefc8-4a21-4d02-afa3-7a63af1dc2c7",
                                "sense_id": "7d5a30b7-8308-3ea7-bec7-49af1a5b1654",
                                "text": "„Er erwiderte den Druck, wandte sich einen Moment von mir ab, und ich betrachtete seinen Rücken, seine starken Arme, die gerade Linie seines Nackens, während er auf die Bücherwand vor sich starrte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "625e91e4-9281-3b0c-a9cf-e0fa03dd2889",
                        "entry_id": "05e08bec-3ce8-3e32-9710-6e8bd575515c",
                        "glosses": [
                            "Möbel für [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ae13c1-5644-4382-b912-4762c8e59589",
                                "sense_id": "625e91e4-9281-3b0c-a9cf-e0fa03dd2889",
                                "text": "Die Bücherwand im Schaufenster würde vom Stil her sehr gut passen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
