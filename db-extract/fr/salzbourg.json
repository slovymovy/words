                "senses": [
                    {
                        "sense_id": "a7bea4ac-4892-37c0-b9eb-8d3f4b739d0e",
                        "entry_id": "18f06660-a8a8-3708-a252-bad27fba320f",
                        "glosses": [
                            "État d’Autriche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b94b37-6aad-4a37-8917-cbb3197aede8",
                                "sense_id": "a7bea4ac-4892-37c0-b9eb-8d3f4b739d0e",
                                "text": "Le land de Salzbourg est l'un des neuf États fédérés de l'Autriche."
                            }
                        ]
                    },
                    {
                        "sense_id": "c268527a-e766-37da-9e03-3f67cddeeffc",
                        "entry_id": "18f06660-a8a8-3708-a252-bad27fba320f",
                        "glosses": [
                            "Ville et capitale de cet État."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e60c3c0-0475-4098-92b9-706943b3cf07",
                                "sense_id": "c268527a-e766-37da-9e03-3f67cddeeffc",
                                "text": "J'arrive à Salzbourg en fin d'après-midi. Ville-musée, dômes de cuivre, rues piétonnes pleines de vie, la belle rivière Salzach au centre de la ville, Mozart omniprésent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a0ba9e9-59b6-414b-a0c2-7cb6e05cfe04",
                        "source_entry_id": "18f06660-a8a8-3708-a252-bad27fba320f",
                        "target_lang_word": "Salzburg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salzburg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a617a3cc-2cc2-36c0-936d-273ed464bfe6",
                                        "entry_id": "b8860808-7e0d-30c1-aa1a-82190955215d",
                                        "glosses": [
                                            "ein Bundesland der Republik Österreich"
                                        ],
                                        "tags": [
                                            "in Österreich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "474d0aaf-50e2-4ac5-80f0-1b86e6787745",
                                                "sense_id": "a617a3cc-2cc2-36c0-936d-273ed464bfe6",
                                                "text": "„Fremdenverkehr ist somit in Salzburg […] ein de facto flächendeckendes Phänomen …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9a0fe61-f16b-3a5f-a042-a687be1521fa",
                                        "entry_id": "b8860808-7e0d-30c1-aa1a-82190955215d",
                                        "glosses": [
                                            "Hauptstadt des gleichnamigen Bundeslandes"
                                        ],
                                        "tags": [
                                            "in Österreich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79053cca-a1c3-4e49-862e-1c1de5f56580",
                                                "sense_id": "c9a0fe61-f16b-3a5f-a042-a687be1521fa",
                                                "text": "„Wolfgang Amadeus Mozart wurde in Salzburg geboren.“"
                                            },
                                            {
                                                "example_id": "f5daa856-309a-41f8-8e44-0fb66e078c15",
                                                "sense_id": "c9a0fe61-f16b-3a5f-a042-a687be1521fa",
                                                "text": "„Sechs deutsche Segelflieger, unter ihnen Hanna Reitsch, überqueren von Salzburg aus die Alpen und landen bei Udine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6598f704-6b7e-3a88-943f-8b90ede30c5c",
                                        "entry_id": "b8860808-7e0d-30c1-aa1a-82190955215d",
                                        "glosses": [
                                            "Ortsgemeinde im Westerwald und Ortsteil anderer Gemeinden"
                                        ],
                                        "tags": [
                                            "in Deutschland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa261f3-0ae4-4723-ac77-3b4c4480b582",
                                                "sense_id": "6598f704-6b7e-3a88-943f-8b90ede30c5c",
                                                "text": "Sollten Sie den Ortsteil Salzburg in der Gemeinde Forstinning im Landkreis Ebersberg schon einmal besucht haben oder vielleicht leben Sie auch dort, dann schicken Sie uns doch bitte Ihre Impressionen, Fotos, Tipps und was Ihrer Meinung nach wissenswert ist."
                                            }
                                        ],
