                                            {
                                                "example_id": "07d7f1c8-e01b-4749-9e0f-c8f5f72a277f",
                                                "sense_id": "57488a1f-905b-3238-a79c-6eb641d9d7c4",
                                                "text": "La jeune rimailleuse fait une mine éberluée, avant de baisser les yeux vers son œuvre."
