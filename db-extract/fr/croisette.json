                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6bd2534-da2a-46b0-9eb5-4dd042de41a0",
                                "sense_id": "b7d71c2c-64df-3b23-b101-c3c59bcb00ad",
                                "text": "Les mâts de hunes ne portant point de jottereaux, on laisse, à cette partie du capelage, une lanterne en renfort sur le diamètre à huit pans, pour supporter les élongis des croisettes de perroquet."
                            }
                        ]
                    },
                    {
                        "sense_id": "47eaad82-c03a-38e6-8007-b86682c0882a",
                        "entry_id": "5f1c072b-d91b-3bf9-9ba6-2680ca1c5ee4",
                        "glosses": [
                            "Staurolite (forme particulière que revêt la macle)."
