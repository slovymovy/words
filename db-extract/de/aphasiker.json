                "senses": [
                    {
                        "sense_id": "9719aba6-c4f9-32a6-af58-d49a6331c435",
                        "entry_id": "ea6235c2-a66a-34a6-b9d5-a7d222cc0113",
                        "glosses": [
                            "Person, die an Aphasie leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd5d937f-80d9-4451-ba61-48a25702dc55",
                                "sense_id": "9719aba6-c4f9-32a6-af58-d49a6331c435",
                                "text": "„Aphasiker können verstehen, was andere zu ihnen sagen, sie wissen auch, was sie antworten wollen, aber sie können es nicht artikulieren.“"
                            },
                            {
                                "example_id": "9d8d1e60-5089-4c5c-b510-f5ff104c0bb4",
                                "sense_id": "9719aba6-c4f9-32a6-af58-d49a6331c435",
                                "text": "„Schriftliche Aufgaben hingegen lösen die Aphasiker, die wegen eines zentralen Hirnschadens sowohl mit der Sprachverarbeitung als auch dem Sprechen Probleme haben, weitaus besser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
