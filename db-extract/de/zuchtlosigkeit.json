                "senses": [
                    {
                        "sense_id": "3f4a5633-be67-3ec8-8084-5e69a8a2e882",
                        "entry_id": "5f2d662f-51b3-3ee0-9a9f-01002bd08a87",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße zeigt, dass Regeln nicht eingehalten werden, keine Disziplin (Zucht und Ordnung) vorhanden ist"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "dda74f1c-d54c-41ab-86e2-5a856aa749c8",
                                "sense_id": "3f4a5633-be67-3ec8-8084-5e69a8a2e882",
                                "text": "Früher sah man die Zuchtlosigkeit in der Nähe zur Verwahrlosung."
                            },
                            {
                                "example_id": "f3855018-a619-40ef-89da-70eb0513c34b",
                                "sense_id": "3f4a5633-be67-3ec8-8084-5e69a8a2e882",
                                "text": "„Gern möchte ich diese, schon vor langer Zeit niedergeschriebenen Worte an die Lehrer der nächsten Umgebung, z. B. des Regierungsbezirks Düsseldorf, richten, und sie auffordern, darüber nachzudenken, welche Folgen der Ungehorsam und die Zuchtlosigkeit einer Schule dem Leben des Einzelnen, der in dieser Zuchtlosigkeit aufgewachsen ist, und der Gesellschaft, in die er nachher hineintritt, bringen wird.“ (1828)"
                            },
                            {
                                "example_id": "777cb73c-d561-4f0e-8cfb-ebedf06e280b",
                                "sense_id": "3f4a5633-be67-3ec8-8084-5e69a8a2e882",
                                "text": "„Im Felde begangene Zuchtlosigkeiten sind: Unbefugtes Beutemachen, Marodieren, Plünderung, Verwüstung und Leichenraub (Fledderei).“ (1943)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
