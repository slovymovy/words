                "senses": [
                    {
                        "sense_id": "3480eab9-1551-3640-8262-2babc1692459",
                        "entry_id": "3235b38c-ebde-37aa-a07d-55d8bd9a0f5c",
                        "glosses": [
                            "betriebsinternes Wissen zur Produktion, ein Rezept oder Ähnliches, das von den Arbeitnehmern geheimgehalten werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daa78347-1a5d-485c-9ecb-d6d18bd08e1d",
                                "sense_id": "3480eab9-1551-3640-8262-2babc1692459",
                                "text": "„Bekannt ist der Magenbitter für seinen würzigen Geschmack und die dunkelgrüne Farbe; das Rezept ist Firmengeheimnis.“"
                            },
                            {
                                "example_id": "d13a092d-d521-41bf-8d36-eb41af8cae08",
                                "sense_id": "3480eab9-1551-3640-8262-2babc1692459",
                                "text": "„Manchmal nutzen die Täter schlicht das Telefon, um den IT-Support einer Organisation zu beschwatzen und so weitere Passwörter und Zugang zu Firmengeheimnissen zu erlangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43e15c80-2648-4892-b7a3-bd717c4ee93f",
                        "source_entry_id": "3235b38c-ebde-37aa-a07d-55d8bd9a0f5c",
                        "source_sense_id": "3480eab9-1551-3640-8262-2babc1692459",
                        "source_sense_description": "betriebsinternes Wissen, das von den Arbeitnehmern geheimgehalten werden muss",
                        "target_lang_word": "secret d’entreprise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secret d’entreprise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f2f070-579e-351e-89ac-ee64092416d8",
                                        "entry_id": "286abdf8-4a93-32ea-bcbe-d088db38379d",
                                        "glosses": [
                                            "Secret, information confidentielle d’une entreprise, dont la divulgation nuirait à ses affaires."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaed9ef3-d48f-4644-a9f8-5b8a6b08287b",
                                                "sense_id": "a3f2f070-579e-351e-89ac-ee64092416d8",
                                                "text": "Dès son premier rapport (classifié) de décembre 1996, le nouveau Comité pour la compétitivité et la sécurité économique (CSCE) préconisa en effet de développer, en droit français, la protection du secret d’entreprise, au titre de la dimension défensive de l’intelligence économique."
                                            },
                                            {
                                                "example_id": "5de599c7-28b7-4da7-bcdb-fc299b673dac",
                                                "sense_id": "a3f2f070-579e-351e-89ac-ee64092416d8",
                                                "text": "L’employeur admettait d'ailleurs «n’avoir aucun reproche à lui formuler s’agissant de la qualité de son travail», relève l’arrêt. Une manière, en quelque sorte, d’autoriser les entreprises à pratiquer à l’égard de leur personnel une politique du zéro risque en matière de secret d’entreprise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
