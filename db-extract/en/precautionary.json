                "senses": [
                    {
                        "sense_id": "efd1d092-cc6c-38a4-bcc6-c3ab25b21dcf",
                        "entry_id": "f5a7eb42-42fd-3042-adf5-c6b3ad89c7a8",
                        "glosses": [
                            "Of, pertaining to, or serving as a precaution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "376b11b6-0fe5-4fbf-bb69-5593a7cc3d15",
                                "sense_id": "efd1d092-cc6c-38a4-bcc6-c3ab25b21dcf",
                                "text": "The port cities were quarantined as a precautionary measure, though no cases of the disease had been found."
                            },
                            {
                                "example_id": "fa11b3da-e4e6-4611-9c69-47244a5dfdee",
                                "sense_id": "efd1d092-cc6c-38a4-bcc6-c3ab25b21dcf",
                                "text": "Fearing attack on the northern ports by the English, he even took precautionary measures by strengthening the defense of Shan-hai-kuan 山海關 and Ch‘in-huang-tao 秦皇島."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1b9d8fd-7883-4024-b670-9fdb1b7e0d25",
                        "source_entry_id": "f5a7eb42-42fd-3042-adf5-c6b3ad89c7a8",
                        "source_sense_id": "efd1d092-cc6c-38a4-bcc6-c3ab25b21dcf",
                        "source_sense_description": "of, pertaining to, or serving as a precaution",
                        "target_lang_word": "précautionneux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précautionneux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "782f8745-a1a6-32e4-9449-e34f74075ba6",
                                        "entry_id": "96f6555b-3f85-3280-9a78-d031a41c86b2",
                                        "glosses": [
                                            "Qui prend des précautions, qui est prudent."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f1665c2-e639-4bba-8360-46d32732603e",
                                                "sense_id": "782f8745-a1a6-32e4-9449-e34f74075ba6",
                                                "text": "La rieuse, qui s’appelait Jeanne et était la fille d’un riche fermier de l’endroit, avouait que son choix était fait depuis longtemps. Puis, curieuse, elle interrogeait sa compagne, avec des détours habiles et précautionneux."
                                            },
                                            {
                                                "example_id": "6f407919-cf80-4446-a64b-ca21469aaac5",
                                                "sense_id": "782f8745-a1a6-32e4-9449-e34f74075ba6",
                                                "text": "C’est un homme précautionneux."
                                            },
                                            {
                                                "example_id": "9385dc5f-4652-4e27-ae91-7b8451f7abb4",
                                                "sense_id": "782f8745-a1a6-32e4-9449-e34f74075ba6",
                                                "text": "Mais sa si précautionneuse prudence fut déjouée un soir qu’il était allé dans le monde."
                                            },
                                            {
                                                "example_id": "1a359897-a130-411d-9d4f-aa68327890c3",
                                                "sense_id": "782f8745-a1a6-32e4-9449-e34f74075ba6",
                                                "text": "Un silence fut si long qu’Alice s’inquiéta. Mais le monologue recommença, plus bas, apaisé ou précautionneux."
                                            },
                                            {
                                                "example_id": "0a55d08b-9c0b-452f-903d-b977310f16ef",
                                                "sense_id": "782f8745-a1a6-32e4-9449-e34f74075ba6",
                                                "text": "Avant de se décider à la séparation, il fallait des mois de nouvelles scènes conjugales et de réconciliations lasses, de conversations entre amies, d’annonces précautionneuses aux parents sur la mésentente du ménage, à eux qui avaient prévenu au moment du mariage, le divorce ça n’existe pas chez nous."
                                            },
                                            {
                                                "example_id": "825ff06f-b5f8-4458-a50d-2c6753955295",
                                                "sense_id": "782f8745-a1a6-32e4-9449-e34f74075ba6",
                                                "text": "Or, c’est à cette étape que s’est déployé le lobbying de toutes les forces hostiles à une gestion précautionneuse de la chimie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "précautionneux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99d51cf0-b02c-3b72-9bd9-beda277d027b",
                                        "entry_id": "a0e60e19-e71b-3247-8b1d-ec09aeab65cb",
                                        "glosses": [
                                            "Personne prudente, qui prend des précautions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbc4b99c-2d5f-4d82-ad5f-2ab31686c151",
                                                "sense_id": "99d51cf0-b02c-3b72-9bd9-beda277d027b",
                                                "text": "Libre à chacun de pléonasmer en connaissance de cause : n’y a-t-il pas des précautionneux qui portent à la fois une ceinture et des bretelles ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06b52ead-c55d-48ac-8a2a-dbe8cdfdeefc",
                        "source_entry_id": "f5a7eb42-42fd-3042-adf5-c6b3ad89c7a8",
