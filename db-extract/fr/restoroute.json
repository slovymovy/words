                                "example_id": "57ba78cf-1080-41fe-9383-ead09f3421f6",
                                "sense_id": "49758962-8dd6-348c-813a-8e2d1918844c",
                                "text": "Après Valréas, il y a un restoroute, des toilettes décentes et peut-être la possibilité de manger un morceau."
                            },
                            {
                                "example_id": "5aacffa6-1485-4793-9ffb-86c28ee04be0",
                                "sense_id": "49758962-8dd6-348c-813a-8e2d1918844c",
                                "text": "Marthe décide de s’arrêter sur l’aire de repos d’un restoroute dont les fenêtres sont brillamment éclairées."
                            }
                        ]
                    }
