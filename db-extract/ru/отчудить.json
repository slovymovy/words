                    },
                    {
                        "form_id": "f0df3509-4df1-4c60-bba0-80140f534a81",
                        "entry_id": "5ab3d1b8-293f-3619-a845-6aa00127d0b9",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "отчуди́в"
                    },
                    {
                        "form_id": "6be3b067-fef4-4dc2-a262-dff447eafae4",
                        "entry_id": "5ab3d1b8-293f-3619-a845-6aa00127d0b9",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "отчуди́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52f80287-4f60-3304-bd59-1cfbfc082e42",
                        "entry_id": "5ab3d1b8-293f-3619-a845-6aa00127d0b9",
                        "glosses": [
                            "редк. отобрать у кого-нибудь (имущество) для передачи в собственность государства или общественных организаций"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1be72f4-c0a0-449b-8194-037539635022",
                                "sense_id": "52f80287-4f60-3304-bd59-1cfbfc082e42",
                                "text": "Моряки оказались того же мнения и скоро вернулись с обязательным предложением отчудить участок для постройки форта."
                            },
                            {
                                "example_id": "3f0c0e85-2660-46e7-9b0d-d8a509f59ea0",
                                "sense_id": "52f80287-4f60-3304-bd59-1cfbfc082e42",
                                "text": "Но раз признан принцип отчуждаемости, то кто же поверит тому, что, если понадобится со временем отчудить земли крестьян, они не будут отчуждены, и поэтому мне кажется, что в этом отношении проект левых партий гораздо более искренен и правдив, признавая возможность пересмотра трудовых норм, отнятие излишка земли у домохозяев."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbfedbfa-7653-43d0-8cfe-f7ca06d1c16f",
                        "source_entry_id": "5ab3d1b8-293f-3619-a845-6aa00127d0b9",
                        "source_sense_id": "52f80287-4f60-3304-bd59-1cfbfc082e42",
                        "target_lang_word": "aliéner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aliéner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "740a8052-17ef-3f17-b5f1-9908af48647a",
                                        "entry_id": "4d64530a-1d18-348a-ba55-f496e326887c",
                                        "glosses": [
                                            "Transférer à un autre la propriété d’un fonds ou de ce qui tient lieu de fonds."
                                        ],
                                        "tags": [
                                            "Droit de propriété"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02bb30fd-0007-47a5-a9f4-897694c1fb25",
                                                "sense_id": "740a8052-17ef-3f17-b5f1-9908af48647a",
                                                "text": "Cette manière de raisonner fait un peu penser à ce qui existe déjà à propos de ce que l’on appelle la « domanialité publique » , c’est-à-dire la forme particulière de propriété dont bénéficient les personnes sur les biens affectés à l’usage d’un service public. L’État et les collectivités territoriales doivent prendre en compte que ces biens sont « affectés à l’usage de tous » et ne peuvent utiliser leurs pouvoirs de propriétaire à des fins d’exclusion, tout comme ils perdent la possibilité d’aliéner ces biens par voie de vente sur le marché."
                                            },
                                            {
                                                "example_id": "5b3354a8-35ca-442f-a18a-77bf1e8adae0",
                                                "sense_id": "740a8052-17ef-3f17-b5f1-9908af48647a",
                                                "text": "Selon lui, la principauté de Cochin était tributaire, vassale du royaume de Mysore ; en conséquence aucune portion du territoire n'en pouvait être légalement aliénée, sans le consentement du souverain de ce dernier pays."
                                            },
                                            {
                                                "example_id": "d6ebcc39-0004-4b3e-99d5-d8f953e02132",
                                                "sense_id": "740a8052-17ef-3f17-b5f1-9908af48647a",
                                                "text": "On peut aliéner le capital de deux manières : par la vente ou par la donation."
                                            },
                                            {
                                                "example_id": "a660cbcc-4dfc-40cb-8dc9-095b7f8f6cdf",
                                                "sense_id": "740a8052-17ef-3f17-b5f1-9908af48647a",
                                                "text": "On lit, en effet, dans le procès-verbal de la séance du 18 janvier, présidée par Emile Flostroy, premier échevin : […]\nvu l'épuisement des fonds en caisse, vu les différentes réclamations de l'entrepreneur à l'égard du paiement de cette somme, le Conseil propose d’aliéner des mauvais terrains, la plupart incultes ni même essartables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5da5e580-ad13-3b7d-a5d3-7ce820804ba5",
                                        "entry_id": "4d64530a-1d18-348a-ba55-f496e326887c",
                                        "glosses": [
                                            "Faire perdre l’affection, la sympathie de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a76aad35-bcc0-4685-a833-1f6ae958177c",
                                                "sense_id": "5da5e580-ad13-3b7d-a5d3-7ce820804ba5",
                                                "text": "Aliéner les affections, les cœurs, les esprits, c’est faire perdre la bienveillance, l’affection, l’estime."
                                            },
                                            {
                                                "example_id": "5012a482-7df9-479d-be90-302ce9cb2182",
                                                "sense_id": "5da5e580-ad13-3b7d-a5d3-7ce820804ba5",
                                                "text": "Cela lui aliéna les anciens orléanistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e09102c7-4e5c-360c-9be6-74b52d49d048",
                                        "entry_id": "4d64530a-1d18-348a-ba55-f496e326887c",
                                        "glosses": [
                                            "Se priver de quelque chose, perdre sa volonté, sa liberté."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c50df2a-1793-40ca-9f2a-1d538be626ce",
                                                "sense_id": "e09102c7-4e5c-360c-9be6-74b52d49d048",
                                                "text": "Il a fini par s'aliéner toute estime de la part des autres."
                                            },
                                            {
                                                "example_id": "ffb324ba-bc7d-4a42-85ad-59a611b06858",
                                                "sense_id": "e09102c7-4e5c-360c-9be6-74b52d49d048",
                                                "text": "Mais dans la psychose, l’anti-narcissisme se radicalise en une aliénation au monde extérieur : « Le sujet à la limite s’aliène de lui-même. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a36e2d23-9ad8-4462-86fb-23566bde4bd4",
                        "source_entry_id": "5ab3d1b8-293f-3619-a845-6aa00127d0b9",
                        "source_sense_id": "52f80287-4f60-3304-bd59-1cfbfc082e42",
