                        "glosses": [
                            "Abgleich von Textvarianten"
                        ],
                        "tags": [
                            "Philologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3b034237-1b42-411d-9c12-23401a95ec06",
                                "sense_id": "a664d775-3ede-3ae1-934d-b4b3d11022a5",
                                "text": "Meine Kollation der Geschichte „Die Leiden des jungen Werther“ über die abweichenden Textstellen der Fassung von 1787 und 1774."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2a5b5ef-3a5c-42a2-9ed0-90450dc90a0f",
                        "source_entry_id": "9074ae0e-160e-33bf-a560-dc38de5e0840",
                        "source_sense_id": "a664d775-3ede-3ae1-934d-b4b3d11022a5",
                        "source_sense_description": "Philologie: Abgleich von Textvarianten",
                        "target_lang_word": "collation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d267eb7-33a0-3712-abf7-71736d5cdc2d",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Bringing together.",
                                            "The act of bringing things together and comparing them; comparison."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a6d693f-a2e0-4c48-bb0c-816388dd5002",
                                                "sense_id": "6d267eb7-33a0-3712-abf7-71736d5cdc2d",
                                                "text": "November 8, 1717, The Bishop of Rochester, letter to Alexander Pope\nI return you your Milton, which, upon collation, I find to be revised, and augmented, in several places"
                                            },
                                            {
                                                "example_id": "43ad87f8-a343-41b5-9a95-9698f56a1299",
                                                "sense_id": "6d267eb7-33a0-3712-abf7-71736d5cdc2d",
                                                "text": "The collation of philosophical opinions, the study of historical facts, the acquirement of languages, were at once my recreation, and the serious aim of my life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e13e8c1c-467c-31ab-9897-49b221fe801a",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Bringing together.",
                                            "The act of collating pages or sheets of a book, or from printing etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "065dffe9-04b1-379f-8585-2442d634c000",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Bringing together.",
                                            "A collection, a gathering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b31eda-281b-4f96-b7b5-dec860a59214",
                                                "sense_id": "065dffe9-04b1-379f-8585-2442d634c000",
                                                "text": "It's fantastic, as is so much of Forgiveness Rock Record, a collation of so many talents that it's practically bursting at the seams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb2693e-e08e-37c6-bb0b-3bbd0b85fc36",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Discussion, light meal.",
                                            "A conference or consultation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a164773-3f3c-3f3e-82b0-bc7aa714d342",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Discussion, light meal.",
                                            "The Collationes Patrum in Scetica Eremo Commorantium by John Cassian, an important ecclesiastical work. (Now usually with capital initial.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001d36d0-3942-46da-835d-59a04dacc92c",
                                                "sense_id": "1a164773-3f3c-3f3e-82b0-bc7aa714d342",
                                                "text": "A certain abbot, named Moses, thus testifieth of himself in the Collations of Cassianus, that he so afflicted himself with much fasting and watching, that sometimes, for two or three days together, not only he felt no appetite to eat, but also had no remembrance of any meat at all […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d18babba-19a1-3dd5-ab1b-e2ca2a3035ec",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Discussion, light meal.",
                                            "A reading held from the work mentioned above, as a regular service in Benedictine monasteries."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "072364f4-d8bf-4a4b-afa9-17caf18f899e",
                                                "sense_id": "d18babba-19a1-3dd5-ab1b-e2ca2a3035ec",
                                                "text": "When the hymn was over the Sacrist was to strike the table for collation, and the Deacon to enter with the Gospel, preceded by three converts, carrying the candlestick and censer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d60d94c-2db7-3599-bf10-c1faf44e650e",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Discussion, light meal.",
                                            "The light meal taken by monks after the reading service mentioned above."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "456bc25e-3ffa-38c9-b555-2a3f1da725c9",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Discussion, light meal.",
                                            "Any light meal or snack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b2aa64f-e1cb-4910-9789-363aa6177860",
                                                "sense_id": "456bc25e-3ffa-38c9-b555-2a3f1da725c9",
                                                "text": "Her first glance was one of triumph—her next was one of mingled admiration and gratitude for Louis; and, accepting his offered hand, they led the way to the banquet prepared in the Palais Orion,—a favourite garden-house, where they often had collations when the party was but small, which was the case to-day."
                                            },
                                            {
                                                "example_id": "0eb9c76f-2b6b-4a1b-aecd-4fa490d12592",
                                                "sense_id": "456bc25e-3ffa-38c9-b555-2a3f1da725c9",
                                                "text": "There were some unofficial local rejoicings, but none of the elaborate junketings which marked the birth of earlier railways. The company had little cash to spend on sumptuous cold collations, and the like."
                                            },
                                            {
                                                "example_id": "49e7bfa5-6aa9-4cf3-9b94-12c3b8e3ddb6",
                                                "sense_id": "456bc25e-3ffa-38c9-b555-2a3f1da725c9",
                                                "text": "Yes, absolutely; supper, at least in English tradition, was a cold collation, left out by cook before retiring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce7cc8c4-b6a3-320e-a221-191b99bea58c",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "The presentation of a clergyman to a benefice by a bishop, who has it in his own gift."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82c49617-c94b-315a-b32b-90e31258f5c4",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "The blending together of property so as to achieve equal division, mainly in the case of inheritance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25bc1172-d261-33e1-bc47-960f0e5a3c2f",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "An heir's right to combine the whole heritable and movable estates of the deceased into one mass, sharing it equally with others who are of the same degree of kindred."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d33e664c-ba85-383d-a4ff-92c1c5ba7d76",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "The act of conferring or bestowing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f7b62a2-71d9-46bc-bc48-6fc1bd8471af",
                                                "sense_id": "d33e664c-ba85-383d-a4ff-92c1c5ba7d76",
                                                "text": "Not by the collation of the king […] but by the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dde43bb0-3b9c-3d75-9449-b491762aa22b",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Presentation to a benefice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64d5b537-4fb4-374b-b679-387575ecc4fd",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
