                "senses": [
                    {
                        "sense_id": "26856c52-ac36-3e4f-9f35-a5863bee3ec6",
                        "entry_id": "a0f2345b-fc71-3952-93d2-796b22ebedde",
                        "glosses": [
                            "Qui concerne à la fois l’Europe en général et la Méditerranée en général."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d67a82c-b223-48fe-827a-87571a919f9d",
                                "sense_id": "26856c52-ac36-3e4f-9f35-a5863bee3ec6",
                                "text": "La stratégie euro-méditerranéenne consiste ainsi à affermir le centre européen en contrôlant sa périphérie méditerranéenne, potentiellement dangereuse parce que musulmane, par toute une série d’accords."
                            },
                            {
                                "example_id": "34c1fac0-c515-448c-9628-fed5cb08d1cb",
                                "sense_id": "26856c52-ac36-3e4f-9f35-a5863bee3ec6",
                                "text": "M. Arkab a insisté sur la nécessité de construire une coopération énergétique régionale équitable et durable, appelant à un partenariat euro-méditerranéen fondé sur le partage des bénéfices et des responsabilités, ainsi que sur l’exploitation des ressources considérables dont regorge la région méditerranéenne."
                            }
                        ]
                    }
