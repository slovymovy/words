                        {
                            "text": "<w>Puur</w> alle voordelen uit deze situatie nu het nog kan.",
                            "target_lang_translations": {
                                "en": "<w>Distill</w> all the benefits from this situation while you still can."
                            }
                        }
                    ],
                    "target_lang_definitions": {
