                                "target_senses": [
                                    {
                                        "sense_id": "3c58d68d-af9d-3132-9172-ef8c7733ffc1",
                                        "entry_id": "86ba8b59-6eca-3c66-bcac-b2d4c9ceca66",
                                        "glosses": [
                                            "A name used to clandestinely identify somebody or something, either for military or espionage purposes, or for commercial confidentiality."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10582c35-fec0-4cbb-b231-77f86a816ed9",
                        "source_entry_id": "1f456902-04d5-3be4-a0e6-260b1c92e69e",
                        "source_sense_id": "5bbf1d5c-a50d-336b-9e51-79b0494e941f",
                        "target_lang_word": "cryptonym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cryptonym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3eef60c6-9946-3ce5-9cce-5757297dc510",
                                        "entry_id": "bc5a3c3d-87c5-31ae-ad55-91565c2b044e",
                                        "glosses": [
                                            "A secret name, a code name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2dea4f8-4f09-45a3-b7c7-54b91acd096e",
                                                "sense_id": "3eef60c6-9946-3ce5-9cce-5757297dc510",
                                                "text": "The spy was known only by his cryptonym, 'Shadow'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "497a358a-2ad0-478a-8664-79cc164de3b9",
                        "source_entry_id": "1f456902-04d5-3be4-a0e6-260b1c92e69e",
                        "source_sense_id": "5bbf1d5c-a50d-336b-9e51-79b0494e941f",
                        "target_lang_word": "Deckname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deckname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "228eb283-eb2a-3cd7-90e3-d9b720250d39",
                                        "entry_id": "dede5f52-f4d6-3d96-8f42-f349ed8c082c",
                                        "glosses": [
                                            "Name, der verwendet wird, um den richtigen Namen nicht zu benutzen, damit die betreffende Person oder Sache unerkannt bleibt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "741e3c95-0991-4cf8-b892-8150906cb303",
                                                "sense_id": "228eb283-eb2a-3cd7-90e3-d9b720250d39",
                                                "text": "Kurt Tucholsky schrieb unter verschiedenen Decknamen, z.B. \"Peter Panter\"."
                                            },
                                            {
                                                "example_id": "e76ab0bd-be33-419a-b238-d5140835ccc2",
                                                "sense_id": "228eb283-eb2a-3cd7-90e3-d9b720250d39",
                                                "text": "„Der Akt der Zuteilung von Decknamen ist eine Widerstandshandlung.“"
                                            },
                                            {
                                                "example_id": "84f18b21-896a-4b9b-8724-9ac9a679d458",
                                                "sense_id": "228eb283-eb2a-3cd7-90e3-d9b720250d39",
                                                "text": "„Werte Leserschaft, ihr müßt wissen, in der damaligen Zeit, gegen Ende der Mongolenherrschaft, bestand in akademischen Kreisen der kuriose Brauch, sich einen Decknamen zuzulegen und inkognito zu reisen.“"
                                            },
                                            {
                                                "example_id": "0280f94b-035c-494f-82ec-4d6eeb620e80",
                                                "sense_id": "228eb283-eb2a-3cd7-90e3-d9b720250d39",
                                                "text": "„M war es völlig gleich gewesen, unter welchem Decknamen er auftrat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7db5bae3-13f7-3e12-8ce0-c6d24d40f77b",
                                        "entry_id": "dede5f52-f4d6-3d96-8f42-f349ed8c082c",
                                        "glosses": [
                                            "verschlüsselte Bezeichnung für ein Vorhaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e15fc6fd-96d7-4eea-ad7d-39aa9f0a8c61",
                                                "sense_id": "7db5bae3-13f7-3e12-8ce0-c6d24d40f77b",
                                                "text": "Die Aktion wurde unter dem Decknamen … geplant."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da5afcff-528e-43fc-adf7-c6c5f9c9b856",
                        "source_entry_id": "1f456902-04d5-3be4-a0e6-260b1c92e69e",
                        "source_sense_id": "5bbf1d5c-a50d-336b-9e51-79b0494e941f",
                        "target_lang_word": "Tarnname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tarnname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ed88143-d59e-3861-a894-4a675380b61d",
                                        "entry_id": "93c6a91d-ac9b-3210-88ab-1cdb714356df",
                                        "glosses": [
                                            "Name, der zu dem Zweck gewählt wird, nicht Eingeweihten die wahre Identität zu verschleiern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a39e3d40-ebd6-40be-8040-02de7b0aa373",
                                                "sense_id": "8ed88143-d59e-3861-a894-4a675380b61d",
                                                "text": "„Aber natürlich versteckt nicht nur er sich hinter einem Pseudonym: Dschihadisten-Foren rufen unter kruden Tarnnamen zu Hass und Gewalt gegen »Ungläubige« auf, Rechtsextreme veröffentlichen unter dem Schutz der Anonymität Namen und Adressen von Mitgliedern der Antifa - und umgekehrt tun es diese genauso.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bee5eb98-d47e-412a-bfcb-973a69ccb2ec",
                        "source_entry_id": "1f456902-04d5-3be4-a0e6-260b1c92e69e",
                        "source_sense_id": "5bbf1d5c-a50d-336b-9e51-79b0494e941f",
                        "target_lang_word": "Kryptonym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kryptonym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb9f562b-2d78-308d-92c4-0c52577f30d4",
                                        "entry_id": "c6702e83-a872-3e37-8eb4-7023e776a29f",
                                        "glosses": [
                                            "von Tätern als Verschleierung ihres Klarnamens verwendeter Ausdruck"
                                        ],
                                        "tags": [
                                            "Kriminologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fbf6e00-569f-4d2e-950f-4fe2d17d34be",
                                                "sense_id": "cb9f562b-2d78-308d-92c4-0c52577f30d4",
                                                "text": "„Anthroponyme sind in der Wahlfreiheit des Namensträgers wesentlich eingeschränkter als dies bei Pseudonymen oder Kryptonymen der Fall ist.“"
                                            },
                                            {
                                                "example_id": "461a8b2c-4e0d-4fbb-bfe7-b1b38fefab8c",
                                                "sense_id": "cb9f562b-2d78-308d-92c4-0c52577f30d4",
                                                "text": "„Das sei zwar illegal, aber nicht wirklich zu kontrollieren, zumal wenn die Werkstatt im Impressum verschwiegen würde oder ein Kryptonym die Herkunft verschleierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae7a2c07-7d87-339e-bd81-e1b8ea07bda7",
                                        "entry_id": "c6702e83-a872-3e37-8eb4-7023e776a29f",
                                        "glosses": [
                                            "Name, der aus dem richtigen Namen durch Kürzung oder Buchstabenverteilung im Text entstanden ist und diesen mehr oder weniger anonymisiert, verschleiert"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53d4efb5-7871-4369-bee3-ebfba37facb4",
                                                "sense_id": "ae7a2c07-7d87-339e-bd81-e1b8ea07bda7",
                                                "text": "Wollte man für „Kurt Beck“ Kryptonyme bilden, könnten sie zum Beispiel „K.B.“, „Kube“ oder „Kabe“ lauten."
                                            },
                                            {
                                                "example_id": "0786a789-3295-4254-8654-785b5953df21",
                                                "sense_id": "ae7a2c07-7d87-339e-bd81-e1b8ea07bda7",
                                                "text": "Kryptonyme können auch als Pseudonyme verwendet werden; Pseudonyme entstehen vielfach aber auf andere Weise als Kryptonyme. „Pauline Réage“ zum Beispiel (= Verfasserin des Romans „Die Geschichte der O.“) oder „Peter Panter“ (= Kurt Tucholsky) sind Pseudonyme, aber keine Kryptonyme, da sie nicht durch Kürzung oder Buchstabenverteilung entstanden sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "447c9f5b-8ae2-35c4-a2d2-76222502d72b",
                                        "entry_id": "c6702e83-a872-3e37-8eb4-7023e776a29f",
                                        "glosses": [
                                            "bei der Planung und Durchführung geheim gehaltener Operationen (Geheimdienst, Militär) verwendeter Deckname oder Deckwort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5bfb7d8-2c67-4d05-b795-008bb69986a1",
                                                "sense_id": "447c9f5b-8ae2-35c4-a2d2-76222502d72b",
                                                "text": "„Das geheimnisvolle Wort ‚Aktion‘ erwies sich als Teil des Kryptonyms ‚Aktion Reinhardt‘, das heißt, für den Befehl Himmlers, alle Juden im Generalgouvernement zu ermorden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
