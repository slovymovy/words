                "senses": [
                    {
                        "sense_id": "2d775939-f22c-3126-b18c-e6ec90a15ce3",
                        "entry_id": "fc054faf-0283-3550-a511-1cb297b66307",
                        "glosses": [
                            "Händler, der Waren in kleinen Mengen an Endverbraucher verkauft"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "9c41928e-e500-459c-945b-ba2f5575f3e0",
                                "sense_id": "2d775939-f22c-3126-b18c-e6ec90a15ce3",
                                "text": "„In der Güterbeschaffung der Detaillisten spielt der starke Franken in der Regel eine untergeordnete Rolle.“"
                            },
                            {
                                "example_id": "2c272e19-c4b7-4ecf-a80d-a3755a8683c6",
                                "sense_id": "2d775939-f22c-3126-b18c-e6ec90a15ce3",
                                "text": "„Er hatte Scheunen voller Ware, die er an Detaillisten verkaufte, vieles davon ohne Rechnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "469eb58b-5d92-319a-bf18-36cb52748e75",
                        "entry_id": "fc054faf-0283-3550-a511-1cb297b66307",
                        "glosses": [
                            "Laden, in dem Waren in kleinen Mengen an Endverbraucher verkauft werden"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "4e8e411b-17c5-4b53-874b-b18d4d9b5768",
                                "sense_id": "469eb58b-5d92-319a-bf18-36cb52748e75",
                                "text": "„In Kombination zu einem Einkaufscenter seien die Leistungen der Detaillisten weiter gefragt, sagt Martin Bosshard, Vizepräsident des Uzwiler Gewerbevereins.“"
                            },
                            {
                                "example_id": "82968b64-843d-4668-9a44-1fe12482b4d9",
                                "sense_id": "469eb58b-5d92-319a-bf18-36cb52748e75",
                                "text": "„‚Die Tankstellenshops lösen die Dorfläden und kleinen Detaillisten ab‘, erklärt Thomas Hochreutener, Direktor des Hergiswiler Marktforschungsinstituts IHA-GfK.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
