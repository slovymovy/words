                                "target_lang_sense_clarification": "маленький кусок"
                            },
                            {
                                "target_lang_word": "частица",
                                "target_lang_sense_clarification": "мельчайшая часть"
                            },
                            {
                                "target_lang_word": "немного",
                                "target_lang_sense_clarification": "небольшое количество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "片",
                                "target_lang_sense_clarification": "小块、小片的东西"
                            },
                            {
                                "target_lang_word": "块",
                                "target_lang_sense_clarification": "较小的一块"
                            },
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "少量"
                            }
