                "senses": [
                    {
                        "sense_id": "ec4aeecc-1e17-3c55-8783-ecd9c4ba934f",
                        "entry_id": "93d8e024-bf86-3492-9edf-ef264fcb4ede",
                        "glosses": [
                            "Relatif aux aponévroses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00797921-3c33-4733-8194-9e397724187c",
                                "sense_id": "ec4aeecc-1e17-3c55-8783-ecd9c4ba934f",
                                "text": "Fibres aponévrotiques."
                            },
                            {
                                "example_id": "83113f40-5998-4760-95cc-901e9b528e2b",
                                "sense_id": "ec4aeecc-1e17-3c55-8783-ecd9c4ba934f",
                                "text": "Ecchymoses des muscles antérolatéraux et de leurs gaines aponévrotiques, ruptures du chef antérieur du sterno-cléido-mastoïdien, manchon ecchymotique péricarotidien, spume, exophtalmie et lividités : il ne fait aucun doute que la victime est morte par pendaison !"
                            },
                            {
                                "example_id": "1b113d71-528d-421c-a69a-7edc091b39da",
                                "sense_id": "ec4aeecc-1e17-3c55-8783-ecd9c4ba934f",
                                "text": "La partie inférieure du contour de cette ouverture est formée par un repli aponévrotique semi-lunaire, qui est reçu dans lʼangle rentrant que laissent entrʼelles les veines fémorale et saphène."
                            }
                        ]
                    }
                ],
