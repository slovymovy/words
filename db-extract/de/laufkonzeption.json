                "senses": [
                    {
                        "sense_id": "94d60186-0b5a-3493-b1ba-d2a873626fd8",
                        "entry_id": "c4386e36-7821-332b-832e-04b45d21107e",
                        "glosses": [
                            "persönliche Art und Weise, wie jemand mit dem Laufen umgeht; Herangehensweise, Strategie oder Philosophie des Laufens beziehungsweise des Lauftrainings"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af3eed48-217b-4b0c-93cd-97b214ea5422",
                                "sense_id": "94d60186-0b5a-3493-b1ba-d2a873626fd8",
                                "text": "„Mit meiner Laufkonzeption gelingt mir das auch gut.“"
                            },
                            {
                                "example_id": "400ed771-00df-4e11-93fc-46aa9ad68bd4",
                                "sense_id": "94d60186-0b5a-3493-b1ba-d2a873626fd8",
                                "text": "„Dies hier ist mein Lauftagebuch, welches vornehmlich als Protokoll meiner jüngst eingenommenen Laufkonzeption, dem Täglichlaufen, dient.“"
                            },
                            {
                                "example_id": "1c8b5327-740a-438f-a206-0d80780f71ca",
                                "sense_id": "94d60186-0b5a-3493-b1ba-d2a873626fd8",
                                "text": "„Ich wünsche Dir weiterhin die Zufriedenheit, die Du in Deiner Laufkonzeption findest und die notwendige Gesundheit dazu.“"
                            },
                            {
                                "example_id": "2625821e-525b-4c09-9744-023e6f55bd84",
                                "sense_id": "94d60186-0b5a-3493-b1ba-d2a873626fd8",
                                "text": "„Natürlich währt nichts ewig, alles hat seine Zeit – für mich das gewichtigste Argument, die Endlichkeit meiner Laufkonzeption täglich zu feiern – mit einem entsprechenden Lauf in der von mir so geliebten Natur.“"
                            },
                            {
                                "example_id": "14799f6f-fbce-4f5e-965a-a5b75718b94b",
                                "sense_id": "94d60186-0b5a-3493-b1ba-d2a873626fd8",
                                "text": "„Derzeit umarmt mich eine leichte Erkältung, die meiner Laufkonzeption nicht sonderlich förderlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
