{
    "word_family": [
        "mot"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd829cf2-913a-3d7e-bd1e-d43a5cc11bb8",
                    "sense_definition": "een onprettig gevoel in de maag hebben, vaak met de neiging om over te geven",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik voel me een beetje <w>mottig</w> na die lange rit in de auto.",
                            "target_lang_translations": {
                                "en": "I feel a bit <w>nauseous</w> after that long car ride."
                            }
                        },
                        {
                            "text": "Dju, ik ben <w>mottig</w> van al dat ronddraaien in de draaimolen!",
                            "target_lang_translations": {
                                "en": "Damn, I'm <w>queasy</w> from all that spinning on the carousel!"
                            }
                        }
                    ],
                    "synonyms": [
                        "misselijk"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in België gebruikt"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informele spreektaal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "having an unpleasant feeling in the stomach, often with the urge to vomit"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nauseous",
                                "target_lang_sense_clarification": "feeling sick to one's stomach"
                            },
                            {
                                "target_lang_word": "queasy",
                                "target_lang_sense_clarification": "slightly nauseated or uneasy"
                            },
                            {
                                "target_lang_word": "sick",
                                "target_lang_sense_clarification": "feeling unwell or about to vomit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f2e80f8-e7ba-3b14-85f9-916658f15b21",
                    "sense_definition": "onaantrekkelijk of lelijk om naar te kijken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Amai, die zijn vriendin is maar een <w>mottige</w>, zé!",
                            "target_lang_translations": {
                                "en": "Wow, his girlfriend is really <w>ugly</w>, you know!"
                            }
                        },
                        {
                            "text": "Hij droeg een <w>mottig</w> hemd dat totaal niet bij zijn broek paste.",
                            "target_lang_translations": {
                                "en": "He wore a <w>hideous</w> shirt that didn't match his pants at all."
                            }
                        }
                    ],
                    "synonyms": [
                        "lelijk"
                    ],
                    "antonyms": [
                        "mooi",
                        "knap"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in België gebruikt"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informele spreektaal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "unattractive or ugly to look at"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ugly",
                                "target_lang_sense_clarification": "unpleasant to look at"
                            },
                            {
                                "target_lang_word": "hideous",
                                "target_lang_sense_clarification": "extremely ugly"
                            },
                            {
                                "target_lang_word": "unattractive",
                                "target_lang_sense_clarification": "not pleasing to the eye"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6835c01-905a-3308-9077-433a52e6e959",
                    "sense_definition": "grijs, somber en vochtig weer door aanhoudende motregen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is vandaag weer van dat <w>mottig</w> weer met die constante miezer.",
                            "target_lang_translations": {
                                "en": "It's that <w>miserable</w> weather again today with that constant drizzle."
                            }
                        },
                        {
                            "text": "Door de <w>mottige</w> lucht was het zicht op de weg erg beperkt.",
                            "target_lang_translations": {
                                "en": "Due to the <w>gloomy</w> sky, visibility on the road was very limited."
                            }
                        }
                    ],
                    "antonyms": [
                        "zonnig",
                        "helder"
                    ],
                    "common_phrases": [
                        "mottig weer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in België gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "grey, gloomy, and damp weather caused by persistent drizzle"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drizzly",
                                "target_lang_sense_clarification": "weather with light, fine rain"
                            },
                            {
                                "target_lang_word": "gloomy",
                                "target_lang_sense_clarification": "dark and depressing weather"
                            },
                            {
                                "target_lang_word": "miserable",
                                "target_lang_sense_clarification": "unpleasant and wet weather"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a02bc00d-e238-3ecb-8ca6-774c81bc41d5",
                    "sense_definition": "beschadigd door de larven van een <w>mot</w>, vaak herkenbaar aan kleine gaatjes in textiel",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beschadiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een jaar in de kast te hebben gehangen was het wollen pak helemaal <w>mottig</w> geworden.",
                            "target_lang_translations": {
                                "en": "After hanging in the closet for a year, the wool suit had become completely <w>moth-eaten</w>."
                            }
                        },
                        {
                            "text": "Zij weigerde de <w>mottige</w> deken te gebruiken omdat er overal gaten in zaten.",
                            "target_lang_translations": {
                                "en": "She refused to use the <w>moth-eaten</w> blanket because there were holes everywhere."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "damaged by moth larvae, often recognizable by small holes in textiles"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moth-eaten",
                                "target_lang_sense_clarification": "damaged by moths"
                            }
                        ]
                    }
                }
            ]
        }
    ]
