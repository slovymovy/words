                    ]
                },
                {
                    "sense_id": "14f6e675-fbae-306e-8323-f7b3ab718d82",
                    "sense_definition": "Qui présente une saveur ou une odeur subtile, agréable et raffinée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce dessert offre un parfum <w>délicat</w> de vanille et de fleur d'oranger."
                        },
                        {
                            "text": "Le chef propose un plat aux saveurs <w>délicates</w> qui ravira les gourmets."
                        }
                    ],
                    "synonyms": [
                        "raffiné"
                    ],
                    "common_phrases": [
                        "saveur délicate",
                        "parfum délicat"
                    ]
                },
                {
                    "sense_id": "bcf4f521-2c88-3ed0-82ea-136173ce75bd",
                    "sense_definition": "Qui fait preuve d'égards, de prévenance ou de politesse envers autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous vous remercions pour cette <w>délicate</w> attention qui nous a beaucoup touchés."
                        },
                        {
                            "text": "Il a eu un geste très <w>délicat</w> en venant nous rendre visite à l'hôpital."
                        }
                    ],
                    "common_phrases": [
                        "délicate attention"
                    ]
                },
                {
                    "sense_id": "dcc5aba0-2141-36cb-a94e-b5decdfd6f2c",
                    "sense_definition": "Qui est difficile à satisfaire, exigeant ou pointilleux dans ses choix.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet enfant est très <w>délicat</w> pour la nourriture et refuse beaucoup d'aliments."
                        },
                        {
                            "text": "Ne sois pas si <w>délicat</w> et accepte ce qu'on te propose poliment."
                        }
                    ],
                    "common_phrases": [
                        "être délicat"
                    ]
                }
            ]
        },
        {
