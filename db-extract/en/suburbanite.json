                                    {
                                        "sense_id": "2e85fb9f-2400-3f63-a44f-a0220ee08b1a",
                                        "entry_id": "cea2885c-a336-32d7-9f82-e5c7e11d5b71",
                                        "glosses": [
                                            "Relatif à la banlieue ou à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "banlieusard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7df28a6d-2b52-39b8-9222-534a4bfb5b0c",
                                        "entry_id": "85de8bc1-9ea0-3e34-a8f9-950e0863c473",
                                        "glosses": [
                                            "Habitant d’une banlieue de ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa6ab7f9-6378-4e15-b97c-c8867df694da",
                                                "sense_id": "7df28a6d-2b52-39b8-9222-534a4bfb5b0c",
                                                "text": "Plus précisément, 3 % des actifs de la Région sont des banlieusards qui rejoignent Paris en automobile, et 9 % sont des banlieusards qui rejoignent Paris en chemin de fer de banlieue ou en RER."
                                            },
                                            {
                                                "example_id": "202170eb-2839-4a92-9dcd-6fd95cb8278e",
                                                "sense_id": "7df28a6d-2b52-39b8-9222-534a4bfb5b0c",
                                                "text": "En passant, Baudrillard associe les décadents ayant voté Non à la Constitution européenne aux banlieusards qui niquent leur mère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63923485-7800-488a-a842-46e0a952a74a",
                        "source_entry_id": "cdce897b-1579-38c1-83a3-929788a0325d",
                        "source_sense_id": "28773780-e95e-3323-9be3-2962d5e73dae",
                        "source_sense_description": "someone who dwells in suburbia",
                        "target_lang_word": "banlieusarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banlieusarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "577587d0-f3d8-3092-be7c-96ab26443c0c",
                                        "entry_id": "6e6a2caf-3083-3347-b9bb-c7acd3da0472",
                                        "glosses": [
                                            "Habitante d’une banlieue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae825e90-ebec-41e5-bb76-f57c6159ad4b",
                                                "sense_id": "577587d0-f3d8-3092-be7c-96ab26443c0c",
                                                "text": "J’avais choisi d’être candidate à Paris. Je n’ai pas cherché de point de chute. Pour moi, Paris, c’était naturel. Ma seconde ville en somme. J’étais parisienne avant l’heure. Une banlieusarde comme des millions d’autres qui étudient ou travaillent à Paris. ."
                                            },
                                            {
                                                "example_id": "572b3444-cd5a-487b-890a-be6bffea4f81",
                                                "sense_id": "577587d0-f3d8-3092-be7c-96ab26443c0c",
                                                "text": "Marginale, dégingandée, plate comme une planche à pain, la jeune banlieusarde du New Jersey en avait vu de toutes les couleurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "banlieusarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a29945f-ea91-3f5c-8641-4a552edf30ee",
                                        "entry_id": "6442733f-404b-3acf-9785-578cc21e59e9",
                                        "glosses": [
                                            "Féminin singulier de banlieusard."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48c64e74-b163-4a27-9f1e-f37aeec95a5b",
                                                "sense_id": "5a29945f-ea91-3f5c-8641-4a552edf30ee",
                                                "text": "Certes, au courant de ma vie citadine, banlieusarde et départementale, j'ai vu des gens bien crottés."
                                            },
                                            {
                                                "example_id": "58873a10-a936-48bb-85ff-dcd690e2c103",
                                                "sense_id": "5a29945f-ea91-3f5c-8641-4a552edf30ee",
                                                "text": "Poissy, avec ses pêcheurs à la ligne, Villennes et son Sophora aux vastes ramures éployées sur les tables du restaurant, forment l'extrême frontière, de ce côté, de la zone banlieusarde, hantée, le dimanche, de bandes tapageuses et pillardes de Parisiens lâchés."
                                            },
                                            {
                                                "example_id": "cf1e26d8-98a6-42e2-9429-86e2feeca4b8",
                                                "sense_id": "5a29945f-ea91-3f5c-8641-4a552edf30ee",
                                                "text": "Regardé aussi les immensités banlieusardes, si tristes, surtout en hiver. Quel cafard j'aurais si j'étais obligé d'habiter là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
