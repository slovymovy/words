                                        "glosses": [
                                            "jemanden überraschend bei einer verbotenen, heimlichen Handlung antreffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd939074-e6ea-4c85-b6af-607c7abecbaa",
                                                "sense_id": "31271cee-ae57-3b51-9b27-b9f6aa88229a",
                                                "text": "Hab ich dich erwischt - du gehst nachts heimlich an den Kühlschrank!"
                                            }
                                        ],
