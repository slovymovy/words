                ],
                "senses": [
                    {
                        "sense_id": "67466896-5f2a-3450-93f5-05d637aa1b99",
                        "entry_id": "2918609a-f14b-3297-ace3-56fb2cbd3d51",
                        "glosses": [
                            "A monoamine C₈H₁₁NO₂ that is a decarboxylated form of dopa, present in the body as a neurotransmitter and a precursor of other substances including adrenalin."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0cb475ba-e928-433a-b323-88e0470b6fe2",
                                "sense_id": "67466896-5f2a-3450-93f5-05d637aa1b99",
                                "text": "Epinephrine and dopamine are two other catecholamine transmitters."
                            },
                            {
                                "example_id": "aeccf547-f6ed-4776-ad54-2951b7a645f3",
                                "sense_id": "67466896-5f2a-3450-93f5-05d637aa1b99",
                                "text": "“The short-term, dopamine-driven feedback loops that we have created are destroying how society works: no civil discourse, no cooperation, misinformation, mistruth. And it’s not an American problem. This is not about Russian ads. This is a global problem.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a95ca184-10d3-48e8-aa8e-518392d80818",
                        "source_entry_id": "2918609a-f14b-3297-ace3-56fb2cbd3d51",
