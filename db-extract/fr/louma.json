                        "sense_id": "0b883758-c3b5-3f6f-88e9-0c5c42dfa6fd",
                        "entry_id": "058626b0-e169-32e6-970d-72d684b9c63d",
                        "glosses": [
                            "Caméra de prise de vue multidirectionnelle fixée sur une grue dirigée par une télécommande ou manuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b2909ec-5403-4428-bd02-25ad36a26e73",
                                "sense_id": "0b883758-c3b5-3f6f-88e9-0c5c42dfa6fd",
                                "text": "La caméra est plus mobile, effectuant grâce à une louma des mouvements sophistiqués, offrant parfois des vues en plongée, accentuant la perspective."
                            },
                            {
                                "example_id": "f90252e4-9450-4982-a15e-1f44d70161c2",
                                "sense_id": "0b883758-c3b5-3f6f-88e9-0c5c42dfa6fd",
                                "text": "Les travellings de la séquence sont faits, tout simplement, en deux-chevaux, et c’est bien mieux qu’avec toutes les loumas du monde !"
                            }
                        ]
                    }
                ],
