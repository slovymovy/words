                                                "sense_id": "73a476e5-d9d0-3d26-a36f-f2065d498fe2",
                                                "text": "He withdrew money to his bank account after several years of trading stocks on E-Trade."
                                            },
                                            {
                                                "example_id": "383aef50-c6a1-4978-8a3a-8cffe6437c9f",
                                                "sense_id": "73a476e5-d9d0-3d26-a36f-f2065d498fe2",
                                                "text": "[…]a free port, where Nations warring with one another resorted with their Goods, and traded as in a neutral Country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a6d44a9-6d91-3067-a9ee-2539ee311c0a",
                                        "entry_id": "c567fb0c-8203-3b58-9f42-3762d5ad6a32",
                                        "glosses": [
                                            "To be traded at a certain price or under certain conditions."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53b471af-a833-498a-a750-57bc313cfdc0",
                                                "sense_id": "7a6d44a9-6d91-3067-a9ee-2539ee311c0a",
                                                "text": "Apple is trading at $200."
                                            },
                                            {
                                                "example_id": "1093fd0e-fec6-479a-ad90-3e5ab52cc303",
                                                "sense_id": "7a6d44a9-6d91-3067-a9ee-2539ee311c0a",
                                                "text": "ExxonMobil trades on the NYSE."
                                            },
                                            {
                                                "example_id": "c5b7fe0b-fdfd-474e-809a-7a7692abb5b4",
                                                "sense_id": "7a6d44a9-6d91-3067-a9ee-2539ee311c0a",
                                                "text": "The stock is trading rich relative to its sector."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d71adda-98a2-3525-b34f-6541732b897b",
                                        "entry_id": "c567fb0c-8203-3b58-9f42-3762d5ad6a32",
                                        "glosses": [
                                            "To give (something) in exchange (for)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbbfea09-1d50-4d2d-9cd6-37367fce8362",
                                                "sense_id": "3d71adda-98a2-3525-b34f-6541732b897b",
                                                "text": "Will you trade your precious watch for my earring?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23a2ffc1-8f62-3ae0-9352-a802ed1d0df1",
                                        "entry_id": "c567fb0c-8203-3b58-9f42-3762d5ad6a32",
                                        "glosses": [
                                            "To mutually exchange (something) (with)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e36674d-eb6b-44a3-8316-412b6d1ffa5c",
                                                "sense_id": "23a2ffc1-8f62-3ae0-9352-a802ed1d0df1",
                                                "text": "The rival schoolboys traded insults and punches."
                                            },
                                            {
                                                "example_id": "b07ef2da-8154-44b5-b52a-8af2267ba228",
                                                "sense_id": "23a2ffc1-8f62-3ae0-9352-a802ed1d0df1",
                                                "text": "The [Halo effect] strikes our combined fleets. All ships piloted by biologicals are now [adrift]. I can trade Mendicant ship for ship now and still prevail."
                                            },
                                            {
                                                "example_id": "b145d2ae-809b-4061-bbe2-3f0f8971076f",
                                                "sense_id": "23a2ffc1-8f62-3ae0-9352-a802ed1d0df1",
                                                "text": "Kalinin Bay is also in trouble, trading fire with Japanese destroyers and taking hits from both them and cruisers at the same time. Unlike the Gambier Bay, however, it does not appear that these ships have realized they need to switch to high explosive from armor-piercing, and, despite being riddled with shellfire, the ship stays afloat, despite this rather-unequal battering going on for another twenty to thirty minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fda0340-d05a-3e06-a242-9c04b17843f8",
                                        "entry_id": "c567fb0c-8203-3b58-9f42-3762d5ad6a32",
                                        "glosses": [
                                            "To use or exploit a particular aspect, such as a name, reputation, or image, to gain advantage or benefit."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "with-on"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05552b6b-7dc6-4d1e-88d5-e3a3cd219112",
                                                "sense_id": "1fda0340-d05a-3e06-a242-9c04b17843f8",
                                                "text": "Some musicians try to trade on their past success by playing the same hits over and over again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "060d71ab-8f9f-3dca-9730-e74c4c89ec80",
                                        "entry_id": "c567fb0c-8203-3b58-9f42-3762d5ad6a32",
                                        "glosses": [
                                            "To give someone a plant and receive a different one in return."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2c16252-cb94-3eab-a840-e464ef8121ad",
                                        "entry_id": "c567fb0c-8203-3b58-9f42-3762d5ad6a32",
                                        "glosses": [
                                            "To do business; offer for sale as for one's livelihood."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc271ddc-d6ee-3c70-af02-4a211d955f96",
                                        "entry_id": "c567fb0c-8203-3b58-9f42-3762d5ad6a32",
                                        "glosses": [
                                            "To have dealings; to be concerned or associated (with)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9b6f796-efef-4a58-a836-9cbf89480076",
                                                "sense_id": "bc271ddc-d6ee-3c70-af02-4a211d955f96",
                                                "text": "Saucy and over bold, how did you dare / To trade and traffic with Macbeth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34d44f1c-b925-3afa-81c7-20b48a4b499d",
                                        "entry_id": "c567fb0c-8203-3b58-9f42-3762d5ad6a32",
                                        "glosses": [
                                            "To recommend and get recommendations."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc3935f-1769-3a02-af54-ed08e15330d1",
                                        "entry_id": "a8d50fe4-584b-3731-9fe7-5703df09629e",
                                        "glosses": [
                                            "Of a product, produced for sale in the ordinary bulk retail trade and hence of only the most basic quality."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf694801-4c66-4619-bdc8-9af98190268b",
                                                "sense_id": "0dc3935f-1769-3a02-af54-ed08e15330d1",
                                                "text": "\"It is monstrous - grotesque.\" \"But what made him draw such an animal?\" \"Trade gin, I should think.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
