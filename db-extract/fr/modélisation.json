        "fr-extract.jsonl": [
            {
                "entry_id": "b8148dce-80d3-341d-ad9c-d71b97aaa5af",
                "word": "modélisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0187d2fe-c666-47ab-b38a-3a3559c98d27",
                        "entry_id": "b8148dce-80d3-341d-ad9c-d71b97aaa5af",
                        "tags": [
                            "plural"
                        ],
                        "form": "modélisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d8c4f78-7c7b-36f0-a918-a500549a1b4b",
                        "entry_id": "b8148dce-80d3-341d-ad9c-d71b97aaa5af",
                        "glosses": [
                            "Action de modéliser, ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9a792bb-d6fc-4a61-ba47-80c916970532",
                                "sense_id": "7d8c4f78-7c7b-36f0-a918-a500549a1b4b",
                                "text": "Une dernière classe de modélisations rencontrées dans la littérature est celle qui cherche à rendre compte des phénomènes hystérétiques (à savoir hystérésis et effet Mullins)."
                            },
                            {
                                "example_id": "bad6863a-2d7c-4355-bc89-a5eacf84b7d1",
                                "sense_id": "7d8c4f78-7c7b-36f0-a918-a500549a1b4b",
                                "text": "Météo France se base pour ses prévisions sur des modélisations de dispersion du panache de fumée du volcan Eyjafjöll ainsi que sur des observations satellitaires et collabore avec les services météorologiques des pays voisins."
                            },
                            {
                                "example_id": "01c1f2d9-54db-465a-97d1-43d3df48bb92",
                                "sense_id": "7d8c4f78-7c7b-36f0-a918-a500549a1b4b",
                                "text": "Si le principe de cette « sismologie stellaire », ou astérosismologie, est simple, sa mise en œuvre est un véritable défi, tant en termes d'observations que de modélisation théorique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9b729da-da62-48e9-87c1-ba0be998560e",
                        "source_entry_id": "b8148dce-80d3-341d-ad9c-d71b97aaa5af",
                        "source_sense_id": "7d8c4f78-7c7b-36f0-a918-a500549a1b4b",
                        "target_lang_word": "Modellierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Modellierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "721c72d7-71a8-3267-92f9-0eeb563a8d25",
                                        "entry_id": "98e3ca12-3ede-346d-97a3-4dc8f00e5d37",
                                        "glosses": [
                                            "Entwicklung, Formung oder Herstellung eines Modells"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb42862-7a9f-4842-a5b9-5a9c5b15d81a",
                                                "sense_id": "721c72d7-71a8-3267-92f9-0eeb563a8d25",
                                                "text": "Wenn etwas neu entwickelt werden soll, ist die Modellierung des geplanten Gegenstands ein guter Zwischenschritt."
                                            },
                                            {
                                                "example_id": "c776e757-9376-40be-874e-406d5c242e78",
                                                "sense_id": "721c72d7-71a8-3267-92f9-0eeb563a8d25",
                                                "text": "Modellierungen sind gute Maßnahmen, um einen Sachverhalt besser zu durchschauen."
                                            },
                                            {
                                                "example_id": "c9d38dee-d178-4e81-a211-68a02589e913",
                                                "sense_id": "721c72d7-71a8-3267-92f9-0eeb563a8d25",
                                                "text": "„Unter den Grundsätzen ordnungsmäßiger Modellierung werden zwei Aspekte subsumiert: Ziele und Modellierungskonventionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
