                ],
                "senses": [
                    {
                        "sense_id": "09458553-b6a9-3a97-90c4-c2336ed89c34",
                        "entry_id": "86220d93-4423-3a0d-9267-372bab693acc",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e219ee8e-a9b6-4ffc-bd6a-728c13d2ea3a",
                                "sense_id": "09458553-b6a9-3a97-90c4-c2336ed89c34",
                                "text": "Frau Schätzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "160cb5d2-936d-4af2-a196-8e7e83b9af67",
                                "sense_id": "09458553-b6a9-3a97-90c4-c2336ed89c34",
                                "text": "Herr Schätzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "79854aa0-ceba-4a1b-8450-bacd9b8d1ab3",
                                "sense_id": "09458553-b6a9-3a97-90c4-c2336ed89c34",
                                "text": "Die Schätzles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "095ff968-88b5-4554-950f-cd745ebe822e",
                                "sense_id": "09458553-b6a9-3a97-90c4-c2336ed89c34",
                                "text": "Der Schätzle trägt nie die Pullover, die die Schätzle ihm strickt."
                            },
                            {
                                "example_id": "dea621c5-d92c-4cc2-8392-dd5431ce8e08",
                                "sense_id": "09458553-b6a9-3a97-90c4-c2336ed89c34",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schätzle kommt, geht der Herr Schätzle.“"
                            },
                            {
                                "example_id": "5a469ae0-e69d-48b0-a6bd-01e209ebc5b2",
                                "sense_id": "09458553-b6a9-3a97-90c4-c2336ed89c34",
                                "text": "Schätzle kommt und geht."
                            },
                            {
                                "example_id": "29cca514-66bf-47e5-aa30-8f1497c28722",
                                "sense_id": "09458553-b6a9-3a97-90c4-c2336ed89c34",
                                "text": "Schätzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
