                                "sense_id": "f426e313-ee5d-30b0-8094-74b94743efd8",
                                "text": "On dirait que la Dream Team 73 est en train de se botiser."
                            },
                            {
                                "example_id": "7973b948-bfdf-4ff2-a018-e69017a84bf3",
                                "sense_id": "f426e313-ee5d-30b0-8094-74b94743efd8",
                                "text": "Sinon, je crois que Limoges CSP va bientôt se botiser..."
                            },
                            {
                                "example_id": "63a28965-2ae9-432c-a1a6-e259dd0fca57",
                                "sense_id": "f426e313-ee5d-30b0-8094-74b94743efd8",
                                "text": "De plus ca va surement se botiser dans ta poule."
                            }
                        ]
                    }
