                        "examples": [
                            {
                                "example_id": "e2864926-464e-4214-bffa-6fbe7e12f661",
                                "sense_id": "e39ff796-154f-375e-9522-33c504871b43",
                                "text": "The cell is provided with a nucleus at the base and usually filled with coarse granules, which are fuchsinophil as well as edsinophil."
                            },
                            {
                                "example_id": "d9301921-ddf0-46db-9ca4-057cf2dfcb4e",
                                "sense_id": "e39ff796-154f-375e-9522-33c504871b43",
                                "text": "Kull's method for mitochondria reveals the presence of strongly fuchsinophil material in the cells of the yolk-sac endoderm."
                            }
                        ]
                    }
                ],
