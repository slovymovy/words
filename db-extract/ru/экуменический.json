                                    {
                                        "sense_id": "c679a275-e055-3f27-bc04-23e42c708cc3",
                                        "entry_id": "20063468-c608-33e4-9d48-b88d0f36082b",
                                        "glosses": [
                                            "di tutto il mondo cattolico"
                                        ],
                                        "tags": [],
