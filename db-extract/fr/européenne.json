                ],
                "senses": [
                    {
                        "sense_id": "a8b41781-4db0-3663-b59c-ceed0d974d98",
                        "entry_id": "6d07fc37-38d3-345e-b18f-f66db5961a00",
                        "glosses": [
                            "Habitante de l’Europe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "396a97c3-d633-4107-aeb5-04e97ef2f894",
                                "sense_id": "a8b41781-4db0-3663-b59c-ceed0d974d98",
                                "text": "Ils étaient, en outre, convaincus — et non sans raison — qu’à part les religieuses et les Amazones, les Européennes n’ont pas plus de goût pour la vie solitaire ou unisexuelle, que les Turkestanes, qui ont obtenu le droit de se remarier, lorsque leurs maris sont absents plus de vingt jours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ee8f2be-6017-4e39-b692-187a8a38ead7",
                        "source_entry_id": "6d07fc37-38d3-345e-b18f-f66db5961a00",
                        "source_sense_id": "a8b41781-4db0-3663-b59c-ceed0d974d98",
                        "target_lang_word": "European",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "European",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24b51796-5cbc-332b-b526-64f445d61ee5",
                                        "entry_id": "eab63725-6259-3ab5-a458-ace11b0ef795",
                                        "glosses": [
                                            "Related to Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195e4f73-cad5-48be-9f17-1596f6d3fad0",
                                                "sense_id": "24b51796-5cbc-332b-b526-64f445d61ee5",
                                                "text": "By the time this mysterious knight died in the 1360s, his book was available in every European language, including Dutch, Gaelic, Czech, Catalan, and Walloon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df057f26-f6ab-364f-9b9b-0450620217dd",
                                        "entry_id": "eab63725-6259-3ab5-a458-ace11b0ef795",
                                        "glosses": [
                                            "Related to the European Union."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06d3e767-66f4-351f-b56d-31eed0f2ca0e",
                                        "entry_id": "eab63725-6259-3ab5-a458-ace11b0ef795",
                                        "glosses": [
                                            "Of white ethnicity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17518dda-21ba-4731-8215-b0f5282d003c",
                                                "sense_id": "06d3e767-66f4-351f-b56d-31eed0f2ca0e",
                                                "text": "Stamps like this were common on furniture made in Australia in the first half of last century, when there were a number of Chinese furniture makers in Australia who were seen as competition to 'European Australian' makers."
                                            },
                                            {
                                                "example_id": "d4ba9455-96ad-4768-ad0e-1d11406b3df6",
                                                "sense_id": "06d3e767-66f4-351f-b56d-31eed0f2ca0e",
                                                "text": "From a domestic point of view the advent of the Chinese was a decided blessing, for, instead of the European ladies of the settlement having to do all their own work, they were able to employ a proper staff of Chinese boys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88b74854-2936-30f2-bdf7-50a443c940fd",
                                        "entry_id": "eab63725-6259-3ab5-a458-ace11b0ef795",
                                        "glosses": [
                                            "That can be exercised only at the expiry date."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55433e14-53d1-4b68-9175-f2b7d7618797",
                                                "sense_id": "88b74854-2936-30f2-bdf7-50a443c940fd",
                                                "text": "All of these trade on the Chicago Board Options Exchange. Most of the contracts are European. An exception is the OEX contract on the S&P 100, which is American."
                                            },
                                            {
                                                "example_id": "f4fa470b-ae83-4acb-b7ed-c6806e22bb22",
                                                "sense_id": "88b74854-2936-30f2-bdf7-50a443c940fd",
                                                "text": "Based on the analyses throughout the case study, it is recommended that the use of a model that assumes an ESO is European style when, in fact, the option is American style with the other exotic variables should not be permitted, as this substantially overstates compensation expenses."
                                            },
                                            {
                                                "example_id": "e1a95f9c-79f0-40a3-92a7-3ee961878f2b",
                                                "sense_id": "88b74854-2936-30f2-bdf7-50a443c940fd",
                                                "text": "Nevertheless, as we shall see, some properties of American options may be readily deduced from those of their European counterparts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "European",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78edf99c-97f9-3a05-a5fb-6c847f7d2ab9",
                                        "entry_id": "57948eb2-d448-3745-bc63-26e81a21a3d9",
                                        "glosses": [
                                            "A person living or originating from Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49e1aed6-f837-4bcd-9ebc-60a73b7d082f",
                                                "sense_id": "78edf99c-97f9-3a05-a5fb-6c847f7d2ab9",
                                                "text": "Until the close of the early modern era, Western Europeans on most evenings experienced two major intervals of sleep bridged by up to an hour or more of quiet wakefulness. […] The initial interval of slumber was usually referred to as “first sleep,” or, less often, “first nap” or “dead sleep.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac0813ba-e8a9-319d-b037-8f19bb3d5a92",
                                        "entry_id": "57948eb2-d448-3745-bc63-26e81a21a3d9",
                                        "glosses": [
                                            "A person who resides within the European Union."
                                        ],
                                        "tags": [],
