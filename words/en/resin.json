    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37ea014f-3269-3e26-a161-6863fa202c06",
                    "sense_definition": "A sticky organic substance produced by certain plants and trees, especially pines, often used to make varnishes and adhesives.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resin_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fragrant pine <w>resin</w> stuck to my fingers as we walked through the forest."
                        },
                        {
                            "text": "Natural tree <w>resin</w> has been collected and used for sealing boats for centuries."
                        }
                    ],
                    "common_phrases": [
                        "tree resin",
                        "pine resin"
                    ]
                },
                {
                    "sense_id": "af47fd4c-da50-353e-894d-45966bc2b5d9",
                    "sense_definition": "A synthetic polymer compound with properties similar to natural resin, widely used in plastics, casting, and adhesives.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resin_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She poured the epoxy <w>resin</w> into the mold to create decorative jewelry."
                        },
                        {
                            "text": "The workshop smelled strongly of synthetic <w>resin</w> while the parts were curing."
                        }
                    ],
                    "common_phrases": [
                        "epoxy resin",
                        "synthetic resin"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c306f63-ecaa-3fb7-91f7-1766560a328c",
                    "sense_definition": "To treat, coat, or rub something with resin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The violinist carefully <w>resined</w> the horsehair of her bow before the performance."
                        },
                        {
                            "text": "Workers must <w>resin</w> the fiberglass cloth to give it strength and rigidity."
                        }
                    ],
                    "synonyms": [
                        "rosin"
                    ]
                }
            ]
        }
    ]
