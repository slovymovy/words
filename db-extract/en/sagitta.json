                    {
                        "translation_id": "dc95d7ce-7197-45b7-8da5-d615187c51b3",
                        "source_entry_id": "70b52c6a-4e68-3184-a69d-164259160eb1",
                        "source_sense_id": "d4e3886e-372b-3ece-9f08-99bd7bc8c41a",
                        "source_sense_description": "constellation",
                        "target_lang_word": "Pfeil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfeil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c5263c-cb66-330e-a056-8dfc09a050fe",
                                        "entry_id": "1b88c99b-e05d-3c86-b375-37851381d5f2",
                                        "glosses": [
                                            "Geschoss, bestehend aus Rohr und Spitze, das mit einem Bogen abgeschossen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f5a8b9-e81b-4c5d-bf1b-0fcedcd9dfad",
                                                "sense_id": "f0c5263c-cb66-330e-a056-8dfc09a050fe",
                                                "text": "Die Indianer können mit dem Pfeil und Bogen auch Fische erlegen."
                                            },
                                            {
                                                "example_id": "1ebd63ac-bbc2-4e17-adb3-23ff1a8d71b0",
                                                "sense_id": "f0c5263c-cb66-330e-a056-8dfc09a050fe",
                                                "text": "„Die Rebellen kämpften mit Pfeilen, Macheten und Steinschleudern.“"
                                            },
                                            {
                                                "example_id": "4153c1c7-9f9d-46a7-b869-d96cd9b2b324",
                                                "sense_id": "f0c5263c-cb66-330e-a056-8dfc09a050fe",
                                                "text": "„Am Kongo trifft die Expedition auf einen Weißen, der mit einem langen Pfeil durch die Brust an einen Baum genagelt ist.“"
                                            },
                                            {
                                                "example_id": "2a831b82-e4d8-441b-b172-9c3a59452599",
                                                "sense_id": "f0c5263c-cb66-330e-a056-8dfc09a050fe",
                                                "text": "„Sie ließen sich zuerst in Maryland, später dann in Pennsylvanien nieder, wo man damals am meisten in der Bibel las und vor den Beilen und Pfeilen der Wildnis nichts mehr zu befürchten hatte.“"
                                            },
                                            {
                                                "example_id": "e67fdcd2-d80f-4fb9-bc50-ad3f289d3088",
                                                "sense_id": "f0c5263c-cb66-330e-a056-8dfc09a050fe",
                                                "text": "„Johnson wog den Bogen einen Augenblick lächelnd in der Hand, legte dann den Pfeil auf, zielte wenige Sekunden, und gleich darauf zitterte der hölzerne Schaft, der das Ziel vollkommen durchbohrt hatte, in der weichen Erde des Herdes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "58396b27-d0af-3d53-8b3e-87936c294018",
                                        "entry_id": "1b88c99b-e05d-3c86-b375-37851381d5f2",
                                        "glosses": [
                                            "abstraktes Bild von [1] (bestehend aus Linie und Spitze), das auf etwas oder in eine Richtung zeigt"
                                        ],
                                        "tags": [
                                            "figürlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bec8fcb7-55fb-4814-a2d5-531dd99c4642",
                                                "sense_id": "58396b27-d0af-3d53-8b3e-87936c294018",
                                                "text": "Klicken Sie auf die Schaltfläche mit dem Pfeil nach links."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
