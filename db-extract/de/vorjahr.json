                        ],
                        "form": "das Vorjahr"
                    },
                    {
                        "form_id": "27bbbc0b-6184-44ba-abe4-23fa686f911d",
                        "entry_id": "6d48d1a3-6e2d-3637-bde2-f8624d4700db",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vorjahre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "779ce31e-5ffd-3aad-bf3c-1b2bc9c0b038",
                        "entry_id": "6d48d1a3-6e2d-3637-bde2-f8624d4700db",
                        "glosses": [
                            "das vorhergehende Jahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7304cd8-c646-4ce3-8a4d-c5b6ce01290d",
                                "sense_id": "779ce31e-5ffd-3aad-bf3c-1b2bc9c0b038",
                                "text": "Im Vergleich zum Vorjahr geht es der Wirtschaft schlechter."
                            },
                            {
                                "example_id": "4223cf04-ce2c-4e99-8b58-9c1f506d4e55",
                                "sense_id": "779ce31e-5ffd-3aad-bf3c-1b2bc9c0b038",
                                "text": "„Trotz aller Anstrengung ging der Marsch langsamer als im Vorjahre vonstatten.“"
                            },
                            {
                                "example_id": "7c8160fd-06ac-49f9-87b2-49f27b2a8c5b",
                                "sense_id": "779ce31e-5ffd-3aad-bf3c-1b2bc9c0b038",
                                "text": "„Im Vorjahr hatte er durch die Ernennung des konservativen Juristen Neil Gorsuch das zuvor bestehende Patt zwischen vier liberalen und vier konservativen Höchstrichtern aufgehoben.“"
                            },
                            {
                                "example_id": "605d4114-8922-4c16-868a-03fc38d1255b",
                                "sense_id": "779ce31e-5ffd-3aad-bf3c-1b2bc9c0b038",
                                "text": "„83 Prozent der Schüler waren damals nichtdeutscher Herkunft, und keiner der Schulabgänger aus dem Vorjahr hatte einen Ausbildungsplatz erhalten.“"
                            },
                            {
                                "example_id": "56a4635a-36fa-454c-96ca-ad0174c9fb9b",
                                "sense_id": "779ce31e-5ffd-3aad-bf3c-1b2bc9c0b038",
                                "text": "„Die Aussöhnung war im Vorjahr durch den Vormarsch ›des Türken‹ nach Wien erzwungen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
