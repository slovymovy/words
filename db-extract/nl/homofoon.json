                    {
                        "translation_id": "42a00148-dfe0-4510-81ac-7970dd7b59e4",
                        "source_entry_id": "cbcd6e63-2a73-343e-a76e-0df0bd83587c",
                        "source_sense_id": "3acf73ca-1fa7-3e71-8b55-8e4c39bc5f95",
                        "source_sense_description": "muziekstijl",
                        "target_lang_word": "monophonique",
