                "senses": [
                    {
                        "sense_id": "ebb78481-4e8e-3bb4-8a80-501a19b16770",
                        "entry_id": "95a3b888-fbd7-3805-bfdf-912795b95a5a",
                        "glosses": [
                            "dem Vergleich dienender Zeitraum; als Referenz genommener zeitlicher Abschnitt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89f8daed-f71b-4349-b33f-4b5768c53eb1",
                                "sense_id": "ebb78481-4e8e-3bb4-8a80-501a19b16770",
                                "text": "„Nur in diesem Referenzzeitraum wird das Modell mit gemessenen CO2-Daten (Kontrolllauf) angetrieben.“"
                            },
                            {
                                "example_id": "a653208b-2363-45d7-84d0-063bdf893d04",
                                "sense_id": "ebb78481-4e8e-3bb4-8a80-501a19b16770",
                                "text": "„Als Referenzzeitraum für die Berechnung der spezifischen Einsparungen wurde das Betriebsjahr 2011 gewählt.“"
                            },
                            {
                                "example_id": "f888b525-35af-4331-ab8a-290793b492bd",
                                "sense_id": "ebb78481-4e8e-3bb4-8a80-501a19b16770",
                                "text": "„Dabei sei ein Referenzzeitraum von drei Monaten regelmäßig zu kurz, zwölf Monate seien in der Regel jedoch ausreichend.“"
                            },
                            {
                                "example_id": "8d474d37-0294-4c6f-ab61-2f3fe0beabbd",
                                "sense_id": "ebb78481-4e8e-3bb4-8a80-501a19b16770",
                                "text": "„Maßgeblich müsse daher der Referenzzeitraum vor der Bekanntgabe der Strukturentscheidung sein, um Manipulationen ausschließen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
