                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befreier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa69c71-66cf-3ee0-b51a-40adf671986c",
                                        "entry_id": "c3d538e7-7d41-3ada-bc99-3b3230907bc8",
                                        "glosses": [
                                            "Person, die jemanden oder etwas aus einer Zwangslage herausholt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb5432b8-6129-475c-b820-1e7a17b4ac2d",
                                                "sense_id": "aaa69c71-66cf-3ee0-b51a-40adf671986c",
                                                "text": "„Und es werden Befreier auf den Berg Zion hinaufziehen, um das Gebirge Esaus zu richten. Und die Königsherrschaft wird dem HERRN gehören!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2505aad-1c77-4b88-9697-e7122e1288d6",
                        "source_entry_id": "05b47d1c-772a-3cc8-91f8-8b83729c7b26",
                        "source_sense_id": "dc50ef87-23db-3844-a8eb-31b2e65d309d",
                        "source_sense_description": "person who frees or liberates",
                        "target_lang_word": "Befreierin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befreierin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1727161-9ece-341d-8b3b-7e8f65535394",
                                        "entry_id": "94798193-3d6e-3e1c-89c6-29c2bb26a17d",
                                        "glosses": [
                                            "weibliche Person oder grammatikalisch weibliche Organisation, die andere Personen in irgendeiner Weise befreit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1140b41d-84ed-4fd8-85fe-56a014179953",
                                                "sense_id": "f1727161-9ece-341d-8b3b-7e8f65535394",
                                                "text": "„Ekajati ist eine der mächtigsten und furchtbarsten Göttinnen in der tibetischen Mythologie. Sie erscheint häufig als Befreierin im Mandala der grünen Tara.“"
                                            },
                                            {
                                                "example_id": "60a27485-9306-4ffe-9b2c-00a28b4a340a",
                                                "sense_id": "f1727161-9ece-341d-8b3b-7e8f65535394",
                                                "text": "„Die Tat wird entdeckt, und die dadurch ermutigten Bethulier stürmen das Lager und preisen Judith als ihre Befreierin.“"
                                            },
                                            {
                                                "example_id": "dc341238-632d-4afc-a1b0-343f69a6a4bb",
                                                "sense_id": "f1727161-9ece-341d-8b3b-7e8f65535394",
                                                "text": "„Die SPÖ hatte das ihre stets durch den Verweis auf ihre historische Mission und Dimension als Befreierin der Arbeiterklasse zusammengehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbb51597-7ac5-461f-a917-bed3846aafc2",
                        "source_entry_id": "05b47d1c-772a-3cc8-91f8-8b83729c7b26",
                        "source_sense_id": "dc50ef87-23db-3844-a8eb-31b2e65d309d",
                        "source_sense_description": "person who frees or liberates",
                        "target_lang_word": "Erlöser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erlöser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0573379-d8f0-3a75-9ee8-951e58cc46c9",
                                        "entry_id": "3a41e82f-6729-3aa2-9212-6e731cd58b54",
                                        "glosses": [
                                            "(männliche^☆) Person, die jemanden von etwas befreit/erlöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "347324c7-2fda-4a4a-ad4a-97ad70489075",
                                                "sense_id": "f0573379-d8f0-3a75-9ee8-951e58cc46c9",
                                                "text": "Ewald erschien uns als Erlöser."
                                            },
                                            {
                                                "example_id": "9c073a6c-b3d2-49fe-9cdd-f1c79e18f90b",
                                                "sense_id": "f0573379-d8f0-3a75-9ee8-951e58cc46c9",
                                                "text": "„Es umgab sie wie ein roter Wind und leuchtete hinter ihr wie ein riesiger mittelalterlicher Komet, der einen Weltuntergang ankündigt oder die Geburt eines späten Erlösers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "975106f8-2dc2-353f-9a92-0cd14bdf3e41",
                                        "entry_id": "3a41e82f-6729-3aa2-9212-6e731cd58b54",
                                        "glosses": [
                                            "Jesus Christus als Messias und Sohn Gottes, der die Menschen von allem Negativen befreien soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de99b81c-27df-403b-818e-c8aecb8962e7",
                                                "sense_id": "975106f8-2dc2-353f-9a92-0cd14bdf3e41",
                                                "text": "„Schon zweihundert Jahre vor Christi Geburt hatten andere Propheten verkündet, der versprochene Messias werde der Erlöser der ganzen Welt sein.“"
                                            },
                                            {
                                                "example_id": "256616f0-1dad-4319-b6bf-d0ddef410572",
                                                "sense_id": "975106f8-2dc2-353f-9a92-0cd14bdf3e41",
                                                "text": "„Jemandem, der alles vergöttlicht, konnte diese Statue sehr leicht als Abbild unseres Erlösers erscheinen, denn der Bildhauer hatte den Kopf mit einer Art Heiligenschein umgeben, mit dem die Bildhauer und Maler die Heiligen darstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bc4ee3c-8125-43da-8f44-9bcccc7acd20",
                        "source_entry_id": "05b47d1c-772a-3cc8-91f8-8b83729c7b26",
