                    {
                        "sense_id": "52979d29-5422-3837-a0d3-1c49dca9aa77",
                        "entry_id": "ffd0fb17-352d-34f3-b2ef-b8fd6edb2c81",
                        "glosses": [
                            "Appareil de massage mécanique, inventé au début du XXᵉ siècle par le docteur Gérald Joseph Macaura. Il fonctionne en actionnant une manivelle qui fait tourner une roue à cames qui fait vibrer une tige métallique au bout de laquelle on visse des embouts en caoutchouc de formes diverses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a3099cc-2eba-4a5c-8428-0cefe08e5474",
                                "sense_id": "52979d29-5422-3837-a0d3-1c49dca9aa77",
                                "text": "Il avait inventé un appareil vibratoire qui guérissait toutes les maladies : le pulsocon. Il fit une publicité importante. Son succès fut étonnant. Chaque jour la police dut établir un service d'ordre à sa porte."
                            },
                            {
                                "example_id": "df2efd98-4e48-4b55-9e5d-122d7c198496",
                                "sense_id": "52979d29-5422-3837-a0d3-1c49dca9aa77",
                                "text": "… avait dit, écrit, affirmé, répété que la poésie d'Henri de Régnier doit être achetée au même titre que les pilules Pink ou le pulsocon du docteur Macaura."
                            }
                        ]
                    }
