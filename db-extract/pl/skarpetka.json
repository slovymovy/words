                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sok",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0889789e-5282-3f28-9642-f658a476e6a3",
                                        "entry_id": "eaa66640-deb6-3c2c-bdf7-7a77fec4985a",
                                        "glosses": [
                                            "kous die tot net boven de enkel komt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "563ac8f7-2c53-46e5-9628-4188cc01cab3",
                                                "sense_id": "0889789e-5282-3f28-9642-f658a476e6a3",
                                                "text": "Na alle ellende met de banken en zakkenvullerij had de oude man net als in de crisistijd zijn geld maar weer in een ouwe sok onder het bed gestopt."
                                            },
                                            {
                                                "example_id": "e63646fc-9618-424e-91b7-42ab358f8d34",
                                                "sense_id": "0889789e-5282-3f28-9642-f658a476e6a3",
                                                "text": "Om te voorkomen dat ik blaren zou krijgen had ik een dubbele laag sokken aangedaan (Darn Tough en Injinji teensokken)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbc29b81-be4d-3cb0-bb62-d0c26d3d99b7",
                                        "entry_id": "eaa66640-deb6-3c2c-bdf7-7a77fec4985a",
                                        "glosses": [
                                            "bij viervoeters het anders gekleurde, onderste deel van de poot"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sok",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e2e70f-dd53-3509-a1a4-55276466e83e",
                                        "entry_id": "6fd6152a-85f9-3327-a903-3ba3df299610",
                                        "glosses": [
                                            "verbindingsstuk dat over twee buizen geschoven wordt om ze te verbinden, mof [3]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc5b77e8-b800-4427-8a2f-bd9cad23e939",
                                                "sense_id": "a3e2e70f-dd53-3509-a1a4-55276466e83e",
                                                "text": "De rubberen sok verbindt de twee delen en wordt bij het ouder worden hard en zal gaan scheuren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
