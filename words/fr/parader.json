                },
                {
                    "sense_id": "9231e2cd-4e50-32e9-92a7-0ba79d885c78",
                    "sense_definition": "Défiler solennellement dans une revue ou un cortège, notamment en parlant de troupes ou de délégations.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "défilé",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont <w>paradé</w> pendant plus d'une heure devant une foule enthousiaste."
                        },
                        {
                            "text": "Chaque été, les fanfares de la région viennent <w>parader</w> au centre de la ville."
                        }
                    ],
                    "synonyms": [
                        "défiler"
                    ],
                    "common_phrases": [
                        "faire parader les troupes",
                        "parader en uniforme"
                    ]
                },
                {
                    "sense_id": "11f985cc-daec-345a-b1d5-e396b8050187",
                    "sense_definition": "En équitation, faire exécuter à un cheval des allures élégantes pour le mettre en valeur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "équitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier faisait <w>parader</w> sa monture devant les juges attentifs du concours."
                        },
                        {
                            "text": "L'écuyer a appris au jeune étalon à <w>parader</w> avec grâce sur la piste."
