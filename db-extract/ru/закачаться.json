                "senses": [
                    {
                        "sense_id": "64d483a4-82de-3f9c-bbfe-0136f8727430",
                        "entry_id": "8e0f044c-2c98-3ef8-80a3-b466d1e9016a",
                        "glosses": [
                            "начать качаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "005cbe46-6629-4134-adba-72903584a91f",
                                "sense_id": "64d483a4-82de-3f9c-bbfe-0136f8727430",
                                "text": "Поплыла вместо этого всего какая-то багровая гуща, в ней закачались водоросли и двинулись куда-то, а вместе с ними двинулся и сам Пилат."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9dcb045-c947-384e-90c1-99a6c74ddf0b",
                        "entry_id": "8e0f044c-2c98-3ef8-80a3-b466d1e9016a",
                        "glosses": [
                            "страд. к закачать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "e98509ec-234e-4456-849c-d725b2068082",
                                "sense_id": "f9dcb045-c947-384e-90c1-99a6c74ddf0b",
                                "text": "Ползущая зелёная полосочка будет вам показывать, какая часть файла уже закачалась и сколько ещё осталось."
                            }
                        ]
                    }
