                "senses": [
                    {
                        "sense_id": "3bd3b7f8-48f9-3ee5-bf77-740dec052187",
                        "entry_id": "2b855d31-b84c-3660-83a7-19653ff5b969",
                        "glosses": [
                            "группа специалистов, решающих вопрос о присуждении премии или награды на конкурсах, состязаниях, выставках и т. п."
                        ],
