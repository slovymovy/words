                                "sense_id": "fcc79127-d2b1-3342-9fa4-cbd3e0a62e9f",
                                "text": "Baseballschläger können auch als Schlagwaffe verwendet werden."
                            },
                            {
                                "example_id": "ef117b27-f0c7-4974-83f6-1bc25d99b76b",
                                "sense_id": "fcc79127-d2b1-3342-9fa4-cbd3e0a62e9f",
                                "text": "„Als sie anhalten, springen die Bürgerwehrler aus dem Auto und zertrümmern mit Baseballschlägern die Fenster des Golf.“"
                            },
                            {
                                "example_id": "4fd8264d-0a2c-4c99-a9aa-4bf2ba307a81",
                                "sense_id": "fcc79127-d2b1-3342-9fa4-cbd3e0a62e9f",
                                "text": "„Eine 18-Jährige soll von ihrer Mutter Geld gefordert haben – mit einem Baseballschläger in der Hand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
