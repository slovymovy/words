                ],
                "senses": [
                    {
                        "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                        "entry_id": "880a5a6a-9b4f-3200-b889-4b93a1ee3de1",
                        "glosses": [
                            "Erhöhung des Wasserstandes des Meeres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6873e0a3-cfc6-4245-9938-4dbabe6df2be",
                                "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                                "text": "„Mit jedem Meter Meeresspiegelanstieg steigen die Kosten für die Sicherung der Küsten und der Platz auf kleinen Inseln schrumpft“ […]."
                            },
                            {
                                "example_id": "61e93f16-6e1c-40b8-a085-5e03014f88ae",
                                "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                                "text": "„Auch die Menschen in Ländern, die nicht direkt vom Meeresspiegelanstieg bedroht werden, haben zunehmend Angst.“"
                            },
                            {
                                "example_id": "fa8f212d-4355-4b03-9b9f-5273836ff9a9",
                                "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                                "text": "„Der kleine Inselstaat setzt sich vor allem für die Belange vieler pazifischer Länder ein, die vom Meeresspiegelanstieg infolge der globalen Erwärmung bedroht sind.“"
                            },
                            {
                                "example_id": "f7946ed1-f1c7-42a3-a6e4-d939242bae8b",
                                "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                                "text": "„Wenn wir weitermachen wie bisher, wird meine Generation noch erleben, wie Bangladesch von der Erdkarte durch den Meeresspiegelanstieg verschwunden sein wird. Genauso wie Florida.“"
                            },
                            {
                                "example_id": "c376437f-f9de-411f-86ce-902a03b989c9",
                                "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                                "text": "Alle Faktoren zusammen ergeben dann das Gesamtrisiko des Meeresspiegelanstiegs."
                            },
                            {
                                "example_id": "2d537799-bf7a-4956-8c78-40d03ba6f181",
                                "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                                "text": "„»Die Einbeziehung der anderen Beiträge zum Meeresspiegelanstieg von Grönland, Gebirgsgletschern und der Ausdehnung der Ozeane kann zu einem Meeresspiegelanstieg bis zu 150 Zentimeter führen«, sagte Levermann der Nachrichtenagentur AFP mit Blick auf den Zeitraum bis Ende des Jahrhunderts.“"
                            },
                            {
                                "example_id": "d5afa78e-9185-4d6d-a6a0-02e79ddf4ca2",
                                "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                                "text": "„Auch New York wäre vom Meeresspiegelanstieg betroffen“"
                            },
                            {
                                "example_id": "ca42abe3-ad86-4e96-9d48-fcb684b1a346",
                                "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                                "text": "„»Natürlich bleibt offen, inwieweit der für die Vergangenheit festgestellte enge Zusammenhang zwischen der globalen Temperatur und dem Meeresspiegelanstieg sich auch in Zukunft fortsetzt«, sagt Rahmstorf.“"
                            },
                            {
                                "example_id": "9692d130-4603-47ac-a126-f628cf98ea9e",
                                "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                                "text": "„»Wir haben nach einem Weg gesucht, wie der Meeresspiegelanstieg zumindest verzögert werden könnte. Denn selbst mit strengem Klimaschutz ist der Anstieg nicht mehr vermeidbar und steigt bis Ende des Jahrhunderts im globalen Mittel auf über 40 Zentimeter«, sagt Leitautorin Katja Frieler.“"
                            },
                            {
                                "example_id": "f215fa27-277b-43c7-9d43-c721186fd4cd",
                                "sense_id": "8962b8f5-627d-3188-b499-3fed19b60a09",
                                "text": "„Eine Forschergruppe um Steve Nerem von der University of Colorado in Boulder fand im Februar 2018 heraus, dass sich der Meeresspiegelanstieg beschleunigt: jedes Jahr steigt der Meeresspiegel um 0,08 Millimeter schneller als zuvor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
