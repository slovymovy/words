                "senses": [
                    {
                        "sense_id": "d365d136-6f88-3700-90de-7a440ad56c05",
                        "entry_id": "f5956900-18dc-3327-ab1c-d479e395f2c5",
                        "glosses": [
                            "устар. парикмахер (часто владевший также элементарными приёмами врачевания)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f35db31b-6fc3-46df-94f7-0d4077baea5a",
                                "sense_id": "d365d136-6f88-3700-90de-7a440ad56c05",
                                "text": "Те же парикмахеры были цирюльниками, фельдшерами, брили бороду, пускали кровь разными манерами, а подчас выдёргивали и зубы."
                            },
                            {
                                "example_id": "142fddf3-8862-4163-9f63-46083986b0ca",
                                "sense_id": "d365d136-6f88-3700-90de-7a440ad56c05",
                                "text": "Меня лечил полковой цирюльник, ибо в крепости другого лекаря не было, и, слава богу, не умничал."
                            }
                        ]
                    }
                ],
