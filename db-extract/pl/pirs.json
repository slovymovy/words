                        "translation_id": "2cabd91d-f6f6-4174-8e43-38c7aa95b204",
                        "source_entry_id": "3f1b673b-bc8a-39a4-8ccf-fc5d1eb190f1",
                        "source_sense_id": "3f786e86-57c7-3598-bcba-6efb768e1ecf",
                        "target_lang_word": "pier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b97ea1d-00a7-347f-86af-30dacaa57544",
                                        "entry_id": "ad1e7dd9-55e9-3e0e-9cc8-c66e3e220ec4",
                                        "glosses": [
                                            "A raised platform built from the shore out over water, supported on piles; used to secure, or provide access to shipping; a jetty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c877b11-382d-46b7-9caf-dcaa6ad6aa3c",
                                                "sense_id": "9b97ea1d-00a7-347f-86af-30dacaa57544",
                                                "text": "Your boat is docked at the pier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04c6665c-f814-3593-b013-47321cc78e4d",
                                        "entry_id": "ad1e7dd9-55e9-3e0e-9cc8-c66e3e220ec4",
                                        "glosses": [
                                            "A similar structure, especially at a seaside resort, used to provide entertainment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39bfbebd-1142-4cda-9c1f-d68b446eb7a0",
                                                "sense_id": "04c6665c-f814-3593-b013-47321cc78e4d",
                                                "text": "There is a gaming arcade on the pier."
                                            },
                                            {
                                                "example_id": "02f4252b-74e3-40a3-b06d-3b804f554ea1",
                                                "sense_id": "04c6665c-f814-3593-b013-47321cc78e4d",
                                                "text": "A fresh breeze comes off the water and down the pier."
                                            },
                                            {
                                                "example_id": "b66c5fa4-7b43-4ea2-9d8b-1bef03d3708f",
                                                "sense_id": "04c6665c-f814-3593-b013-47321cc78e4d",
                                                "text": "Ryde Pier's claim to fame is being the world's oldest seaside pleasure pier, with construction starting in 1813."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d232cb78-3cbf-3643-b153-2f33beecbf86",
                                        "entry_id": "ad1e7dd9-55e9-3e0e-9cc8-c66e3e220ec4",
                                        "glosses": [
                                            "A structure supporting the junction between two spans of a bridge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f18a89e8-2bd3-4715-95e3-d562e2f644ab",
                                                "sense_id": "d232cb78-3cbf-3643-b153-2f33beecbf86",
                                                "text": "The force of the explosion demolished one pair of piers and two spans of the bridge crashed down into the river on top of the barges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "440c22aa-2a84-31b7-bdb2-6c353b3a3a30",
                                        "entry_id": "ad1e7dd9-55e9-3e0e-9cc8-c66e3e220ec4",
                                        "glosses": [
                                            "A rectangular pillar, or similar structure, that supports an arch, wall or roof, or the hinges of a gate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3146fba-c1b4-40e6-8159-1c525d82a714",
                        "source_entry_id": "3f1b673b-bc8a-39a4-8ccf-fc5d1eb190f1",
                        "source_sense_id": "3f786e86-57c7-3598-bcba-6efb768e1ecf",
                        "target_lang_word": "jetée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jetée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "326270d5-b225-341e-a60e-db495a594998",
                                        "entry_id": "152bd3df-c0b0-3ec7-9de9-14ccbc87d65a",
                                        "glosses": [
                                            "Amas de pierres, de cailloux et d’autres matériaux jetés à côté du canal qui forme l’entrée d’un port, fortement maçonnés et ordinairement soutenus de pilotis, pour servir à rompre l’impétuosité des vagues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd8fc8ab-808c-4f5a-8b27-4b5b3ce9effa",
                                                "sense_id": "326270d5-b225-341e-a60e-db495a594998",
                                                "text": "La rue de la République, à Nouméa, partait d'une jetée de bois sur la mer et gagnait, après le palais blanc du gouverneur, une autre rue, que des maisons, […], flanquaient à droite."
                                            },
                                            {
                                                "example_id": "33aaf040-c3d5-4741-a5ff-f04e7bec64e3",
                                                "sense_id": "326270d5-b225-341e-a60e-db495a594998",
                                                "text": "[…], à 1 heure du matin, je pénétrais dans le port de Colon. Entre les deux jetées j’étais ébloui par de nombreuses lumières et j’évitais de justesse un vapeur qui sortait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50ef4d41-91f1-3a8a-bc0e-e77233026a7a",
                                        "entry_id": "152bd3df-c0b0-3ec7-9de9-14ccbc87d65a",
                                        "glosses": [
                                            "Construction de bois ou de pierre que l’on fait dans un cours d’eau pour en redresser le lit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3ca6a05-508b-4e1e-96ac-fcdaf6172cee",
                                                "sense_id": "50ef4d41-91f1-3a8a-bc0e-e77233026a7a",
                                                "text": "Jetée de fascinage."
                                            },
                                            {
                                                "example_id": "f48aa37f-b41c-47e5-8353-1d30fb9edd38",
                                                "sense_id": "50ef4d41-91f1-3a8a-bc0e-e77233026a7a",
                                                "text": "Jetée de charpente."
                                            },
                                            {
                                                "example_id": "accc2d0b-7f9d-427d-b2a9-9a5b981fc26d",
                                                "sense_id": "50ef4d41-91f1-3a8a-bc0e-e77233026a7a",
                                                "text": "Jetée de maçonnerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b88a93f1-0911-3235-99df-c062db833680",
                                        "entry_id": "152bd3df-c0b0-3ec7-9de9-14ccbc87d65a",
                                        "glosses": [
                                            "Amas de pierres, de sable et de cailloux jetés dans la longueur d’un mauvais chemin pour le rendre plus praticable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd1cd86-19e8-4264-8066-339e1ce8a862",
                                                "sense_id": "b88a93f1-0911-3235-99df-c062db833680",
                                                "text": "Ce chemin est devenu très commode depuis qu’on y a fait une jetée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2063eeb4-9b5f-3b68-8a70-50e818778f8c",
                                        "entry_id": "152bd3df-c0b0-3ec7-9de9-14ccbc87d65a",
                                        "glosses": [
                                            "Chaque nouvel essaim d'abeilles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cacdb8ce-dbd9-3736-9465-2ec2a181ea1e",
                                        "entry_id": "152bd3df-c0b0-3ec7-9de9-14ccbc87d65a",
                                        "glosses": [
                                            "Par analogie, système flottant ayant fonction de jetée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d557322-2be0-4e99-ade0-da61532fe0ff",
                                                "sense_id": "cacdb8ce-dbd9-3736-9465-2ec2a181ea1e",
                                                "text": "La livraison d'aide humanitaire à Gaza via la jetée temporaire construite par les Etats-Unis a été suspendue après que cette installation a été endommagée en raison des conditions météorologiques, a annoncé mardi le ministère américain de la Défense. \"La reconstruction et la réparation de la jetée prendront au moins plus d'une semaine\", a déclaré Sabrina Singh, porte-parole adjointe du Pentagone, durant un point presse, précisant qu'après cette opération les Etats-Unis allaient \"reprendre\" la livraison de l'aide humanitaire. Alternative jugée insuffisante par les humanitaires, la jetée américaine n'en est pas à son premier revers. Samedi, quatre embarcations de l'armée américaine utilisées pour cette jetée se sont échouées à cause d'une \"mer agitée\", selon le Commandement militaire américain pour le Moyen-Orient (Centcom)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
