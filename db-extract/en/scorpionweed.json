                                "sense_id": "002104a4-7625-346f-8676-275a42ccd73b",
                                "text": "The name scorpionweed comes from the curling habit of the blossoming flower heads which somewhat resemble the flexed tail of a scorpion in striking position."
                            },
                            {
                                "example_id": "55fc0e20-00ae-4fd1-83e9-99dfb0e80199",
                                "sense_id": "002104a4-7625-346f-8676-275a42ccd73b",
                                "text": "Lyall's scorpionweed is closely related to the more common species silky scorpionweed (Phacelia sericea (Graham) A. Gray) and was once considered a variety of that species."
                            }
                        ]
                    }
