                                        "sense_id": "4fa09054-9de9-3944-a9da-41d54664b16a",
                                        "entry_id": "45320753-851f-3560-8c14-65cd7383b484",
                                        "glosses": [
                                            "The property of being Jewish."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2f37a39-6792-4fb7-986d-0682b8c8ac2d",
                                                "sense_id": "4fa09054-9de9-3944-a9da-41d54664b16a",
                                                "text": "When I first knew you I was struck by your pride in your Jewishness, but as far as I knew you weren't yet a lesbian. Can you ttell me something about how you came to terms with these two parts of yourself?"
                                            },
                                            {
                                                "example_id": "a9916d19-2f44-451b-89af-5923f79ca4cd",
                                                "sense_id": "4fa09054-9de9-3944-a9da-41d54664b16a",
                                                "text": "When Zack Galifianakis asks Paul Rudd about his Jewishness in “Between Two Ferns: The Movie,” the actor responds with a quip."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ded2ba7-4b3b-4705-9731-c8625b15e152",
                        "source_entry_id": "8f4de380-ac54-3d55-84d9-0c6f780491b1",
                        "source_sense_id": "ad6dfad4-ab23-3868-97d8-ccb6e0c4e182",
