                ],
                "senses": [
                    {
                        "sense_id": "937a6e15-312c-3f23-b29b-92a1408fa3be",
                        "entry_id": "8f82665b-79cc-3018-9c7a-40c141c0c837",
                        "glosses": [
                            "A room designated as a place to eat lunch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43c6caa3-0cc5-45ef-a2f6-1305ae581ca0",
                                "sense_id": "937a6e15-312c-3f23-b29b-92a1408fa3be",
                                "text": "Company policy was to eat snacks only in the lunchroom."
                            },
                            {
                                "example_id": "4e51f6a0-3222-4908-800d-b847c896196f",
                                "sense_id": "937a6e15-312c-3f23-b29b-92a1408fa3be",
                                "text": "Kraft Heinz said the new products will be available nationwide to all school administrators to procure and offer to students either for purchase in the lunchroom – though the company did not disclose the cost to schools – or for free through the National School Lunch Program (NSLP)."
                            },
                            {
                                "example_id": "e3927b90-0a84-4cd7-af45-95ea6e1f9e92",
                                "sense_id": "937a6e15-312c-3f23-b29b-92a1408fa3be",
                                "text": "Lunchables, made by Kraft Heinz, took its packaged ready-to-eat kids meals directly into K-12 school lunchrooms nationwide through the National School Lunch Program (NSLP) for the first time last year."
                            }
                        ]
                    },
                    {
                        "sense_id": "35a166fe-2dd9-33f6-b8ac-c56196fc4328",
                        "entry_id": "8f82665b-79cc-3018-9c7a-40c141c0c837",
                        "glosses": [
                            "A diner or small restaurant that serves lunch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28b3f1e0-599d-42fa-9045-cd9d2b3565c9",
                                "sense_id": "35a166fe-2dd9-33f6-b8ac-c56196fc4328",
                                "text": "I don't know how they stay in business serving only lunch, but the lunchroom on the corner is cheap and fast so I like it."
                            }
                        ]
                    }
                ],
