                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In zijn <w>boosheid</w> scheurde hij het contract doormidden.",
                            "target_lang_translations": {
                                "en": "In his <w>anger</w>, he tore the contract in half.",
                                "pl": "W swojej <w>złości</w> podarł kontrakt na pół.",
                                "de": "In seinem <w>Zorn</w> zerriss er den Vertrag in zwei Hälften.",
                                "fr": "Dans sa <w>colère</w>, il a déchiré le contrat en deux.",
                                "it": "Nella sua <w>rabbia</w> ha strappato il contratto a metà.",
                                "cs": "Ve svém <w>hněvu</w> roztrhl smlouvu napůl.",
                                "tr": "<w>Öfkesinden</w> dolayı sözleşmeyi ikiye yırttı.",
                                "es": "En su <w>ira</w>, rompió el contrato por la mitad.",
                                "zh": "他因<w>愤怒</w>把合同撕成了两半。"
                            }
                        },
                        {
                            "text": "Zij probeerde haar <w>boosheid</w> te onderdrukken tijdens het gesprek.",
                            "target_lang_translations": {
                                "en": "She tried to suppress her <w>anger</w> during the conversation.",
                                "pl": "Próbowała stłumić swoją <w>złość</w> podczas rozmowy.",
                                "de": "Sie versuchte, ihren <w>Ärger</w> während des Gesprächs zu unterdrücken.",
                                "fr": "Elle a essayé de réprimer sa <w>colère</w> pendant la conversation.",
                                "it": "Ha cercato di reprimere la sua <w>rabbia</w> durante la conversazione.",
                                "cs": "Během rozhovoru se snažila potlačit svůj <w>vztek</w>.",
                                "tr": "Görüşme sırasında <w>öfkesini</w> bastırmaya çalıştı.",
                                "es": "Ella intentó reprimir su <w>enfado</w> durante la conversación.",
                                "zh": "她在谈话中试图压抑自己的<w>愤怒</w>。"
                            }
                        }
