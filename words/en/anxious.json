                },
                {
                    "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                    "sense_definition": "Experiencing a strong feeling of disquietude or extreme concern, especially regarding future or unknown events.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>anxious</w> to hear how her test results were.",
                            "target_lang_translations": {
                                "ru": "Она с <w>волнением</w> ждала результатов своего теста.",
                                "nl": "Ze was <w>bezorgd</w> om te horen wat haar testresultaten waren.",
                                "pl": "Z <w>niepokojem</w> czekała na wyniki swojego testu.",
                                "de": "Sie war <w>gespannt</w> darauf, ihre Testergebnisse zu erfahren."
                            }
                        },
                        {
                            "text": "They faced an <w>anxious</w> wait as the final votes were being counted.",
                            "target_lang_translations": {
                                "ru": "Их ждало <w>тревожное</w> ожидание, пока шел подсчет последних голосов.",
                                "nl": "Ze stonden voor een <w>spannend</w> wachten terwijl de laatste stemmen werden geteld.",
                                "pl": "Czekało ich <w>pełne niepokoju</w> oczekiwanie, podczas gdy liczono ostatnie głosy.",
                                "de": "Sie erlebten ein <w>beklommenes</w> Warten, während die letzten Stimmen ausgezählt wurden."
                            }
                        }
                    ],
