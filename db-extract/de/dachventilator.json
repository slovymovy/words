                "senses": [
                    {
                        "sense_id": "fdbad195-1d6b-34bc-bb73-78650edb583a",
                        "entry_id": "d2bc1e33-9936-31c1-8701-68554669f790",
                        "glosses": [
                            "Gerät, welches umgebende Luft durch Drehung eines Laufrades mit Schaufeln fördert und in oder auf dem Dach installiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9faf59c0-b2f9-48e5-82b7-539a2b5dfdd1",
                                "sense_id": "fdbad195-1d6b-34bc-bb73-78650edb583a",
                                "text": "„Als Abschluss von Rohrlüftungssystemen konzipiert und sicher am Dach befestigt, ist der industrielle Dachventilator auch für Großküchen, Schwimmbäder und sogar im Wohnumfeld geeignet.“"
                            },
                            {
                                "example_id": "109a9ce1-1663-4614-9cfc-9420c598cca3",
                                "sense_id": "fdbad195-1d6b-34bc-bb73-78650edb583a",
                                "text": "„Ein zentraler Ventilator in Form eines Rohr- oder Boxventilators unter dem Dach oder als Dachventilator auf dem Dach befördert die Abluft über eine gemeinsame Luftleitung (Hauptleitung) ins Freie.“"
                            },
                            {
                                "example_id": "794be50f-2eff-4811-8d9f-f9536b985f0f",
                                "sense_id": "fdbad195-1d6b-34bc-bb73-78650edb583a",
                                "text": "„Beim Einbau als Dachventilator wird die Abluft senkrecht nach oben ausgeblasen.“"
                            },
                            {
                                "example_id": "6cf11769-1dd4-4480-bca4-a46f18580886",
                                "sense_id": "fdbad195-1d6b-34bc-bb73-78650edb583a",
                                "text": "„Die von uns angebotenen Radial- und Dachventilatoren sowie Axialventilatoren sind hervorragend geeignet zur Förderung aggressiver Abluft und Gase.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
