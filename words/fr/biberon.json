                    "frequency": "High",
                    "semantic_group_id": "nourrisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bébé a faim, je vais lui préparer un <w>biberon</w> de lait tiède avant de le coucher."
                        },
