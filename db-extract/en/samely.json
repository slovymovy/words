                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "7a633279-d76f-4251-acad-dda46576a109",
                                "sense_id": "aa1858b7-e09a-36d5-a2fd-9342816c2431",
                                "text": "It is commonly said that the world today is becoming very samely, and the traveller who visits lands that were yesterday regarded as remote haunts of barbarism usually experiences much disillusion."
                            },
                            {
                                "example_id": "48dbd2ab-7a23-42a5-9d49-4b6bfe4b6404",
                                "sense_id": "aa1858b7-e09a-36d5-a2fd-9342816c2431",
                                "text": "It all helps to vary a diet which, at this time of year, is very samely and low on greens."
                            }
                        ]
                    }
