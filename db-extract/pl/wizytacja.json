                                "target_senses": [
                                    {
                                        "sense_id": "1e646c25-eeff-34d5-9083-1cbe94d51018",
                                        "entry_id": "d0e033cf-560a-3337-aa54-79fe76b2bc88",
                                        "glosses": [
                                            "The act of visiting, or an instance of being visited."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce2ea6e7-4443-4f49-a0bc-058ad9f8d74c",
                                                "sense_id": "1e646c25-eeff-34d5-9083-1cbe94d51018",
                                                "text": "Existing visitor facilities for both frontcountry areas experience crowding during the summer season, when the park receives most of its visitation, […]"
                                            },
                                            {
                                                "example_id": "7ddbc3db-a859-4131-a940-43d2e8438537",
                                                "sense_id": "1e646c25-eeff-34d5-9083-1cbe94d51018",
                                                "text": "Such abundance must be laid out on superfluous recreations, buildings, ornaments, furniture, equipage, attendants, entertainments, visitations, braveries, and a world of need-nots […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e7a9eb7-fe0d-3c0a-a160-be1624eed506",
                                        "entry_id": "d0e033cf-560a-3337-aa54-79fe76b2bc88",
                                        "glosses": [
                                            "An official visit to inspect or examine something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6db91ad7-d11a-32f1-96d7-7ba9a7afe883",
                                        "entry_id": "d0e033cf-560a-3337-aa54-79fe76b2bc88",
                                        "glosses": [
                                            "An encounter with aliens or supernatural beings such as ghosts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d398c78-0afc-38b0-93e5-359628d80e1a",
                                        "entry_id": "d0e033cf-560a-3337-aa54-79fe76b2bc88",
                                        "glosses": [
                                            "An affliction or disaster attributed to destiny, or to God."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "473193ef-608b-4339-9f46-a2ec7a2cfd44",
                                                "sense_id": "0d398c78-0afc-38b0-93e5-359628d80e1a",
                                                "text": "But when the blow comes down in the fulness of expectation; when the bough is smitten while green, and the flower cut down in its spring; when the young and lovely perish, while the eyes, full of light, were fixed on the future,—then, indeed, is the visitation heavy to bear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c97c4311-bb84-3313-a6ac-385101ec4546",
                                        "entry_id": "d0e033cf-560a-3337-aa54-79fe76b2bc88",
                                        "glosses": [
                                            "The right of a separated or divorced parent to visit a child; access."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1e6bdd3-76d8-3218-8bdc-f095f3a5892b",
                                        "entry_id": "d0e033cf-560a-3337-aa54-79fe76b2bc88",
                                        "glosses": [
                                            "A punishment or blessing ordained by God."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f45e1af8-2fbc-3a8b-9ba7-98843ae25481",
                                        "entry_id": "d0e033cf-560a-3337-aa54-79fe76b2bc88",
