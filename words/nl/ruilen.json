            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c8effb7-d5c3-3e4e-b8cc-2259d3ebc71d",
                    "sense_definition": "het geven van iets en daarvoor in de plaats iets anders terugkrijgen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uitwisseling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil mijn sandwich <w>ruilen</w> voor jouw appeltaart.",
                            "target_lang_translations": {
                                "en": "I want to <w>exchange</w> my sandwich for your apple pie.",
                                "ru": "Я хочу <w>поменять</w> свой сэндвич на твой яблочный пирог."
                            }
                        },
                        {
                            "text": "Kunnen we een dag van auto <w>ruilen</w>?",
                            "target_lang_translations": {
                                "en": "Can we <w>swap</w> cars for a day?",
                                "ru": "Мы можем <w>поменяться</w> машинами на один день?"
                            }
                        }
                    ],
                    "synonyms": [
                        "verwisselen",
                        "omruilen",
                        "uitwisselen"
                    ],
                    "common_phrases": [
                        "van auto ruilen",
                        "ruilen voor"
                    ],
                    "target_lang_definitions": {
                        "en": "giving something and receiving something else in its place",
                        "ru": "отдавать что-либо и получать взамен что-то другое"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exchange",
                                "target_lang_sense_clarification": "to give and receive something else"
                            },
                            {
                                "target_lang_word": "swap",
                                "target_lang_sense_clarification": "to trade one thing for another"
                            },
                            {
                                "target_lang_word": "trade",
                                "target_lang_sense_clarification": "to exchange items"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "менять",
                                "target_lang_sense_clarification": "отдавать одно взамен другого"
                            },
                            {
                                "target_lang_word": "обмениваться",
                                "target_lang_sense_clarification": "совершать взаимный обмен чем-либо"
                            },
                            {
                                "target_lang_word": "поменяться",
                                "target_lang_sense_clarification": "совершить разовый обмен"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a9137f3-03fd-38d2-8892-b19cc8a0db30",
                    "sense_definition": "het drijven van handel door goederen direct tegen elkaar uit te wisselen zonder geld",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitwisseling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude culturen <w>ruilden</w> mensen vaak goederen in plaats van geld te gebruiken.",
                            "target_lang_translations": {
                                "en": "In ancient cultures, people often <w>bartered</w> goods instead of using money.",
                                "ru": "В древних культурах люди часто <w>обменивали</w> товары вместо того, чтобы использовать деньги."
                            }
                        },
                        {
                            "text": "Zij doet aan <w>ruilen</w> door haar handgemaakte sieraden te geven voor voedsel en kleding.",
                            "target_lang_translations": {
                                "en": "She engages in <w>trading</w> by giving her handmade jewelry for food and clothing.",
                                "ru": "Она <w>выменивает</w> еду и одежду на свои украшения ручной работы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "goederen ruilen"
                    ],
                    "target_lang_definitions": {
                        "en": "conducting trade by directly exchanging goods for each other without using money",
                        "ru": "ведение торговли путем прямого обмена товарами без использования денег"
                    },
                    "translations": {
