                "forms": [],
                "senses": [
                    {
                        "sense_id": "88b33126-bbe8-3425-adb3-e2024c5f43b3",
                        "entry_id": "e61f11cd-db75-39c0-b67e-2b9b5b8cd6bc",
                        "glosses": [
                            "To serve or help; used only in the phrase \\\"Ka me, ka thee\\\" or variants thereof."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "064aa575-20f8-4551-a264-ea84789a379a",
                                "sense_id": "88b33126-bbe8-3425-adb3-e2024c5f43b3",
                                "text": "Now nature stood ever on this point, Kæ mee Ile kæ thee, and ever ready to bee even alwaies on recompences and vicissitude of things, and to give as good as one brings."
                            },
                            {
                                "example_id": "6ae07c84-fe7f-422e-ab5d-9ac39d059c42",
                                "sense_id": "88b33126-bbe8-3425-adb3-e2024c5f43b3",
                                "text": "Ka me, ka thee, is a proverb all over the world."
                            }
                        ]
                    }
