                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af60a5f2-a3ed-4253-8c5d-6052bc42b5f9",
                                "sense_id": "88ff0524-c7f6-3cea-bac7-e678a882041f",
                                "text": "These children are constitutionally sad. Other children, like Luke, develop depressive feelings out of the blue or in response to some mild stressor."
                            },
                            {
                                "example_id": "3830aabf-3c26-43c5-8882-9a5a2f3ed679",
                                "sense_id": "88ff0524-c7f6-3cea-bac7-e678a882041f",
                                "text": "These paradoxical pleasures […] are acquired by controlling one's exposure to the stressor in gradually increasing doses."
                            },
                            {
                                "example_id": "217269cd-180b-4c7c-8b22-3f533b0ca41e",
                                "sense_id": "88ff0524-c7f6-3cea-bac7-e678a882041f",
                                "text": "Plenty of people see hosting a large group as a stressor."
                            }
                        ]
