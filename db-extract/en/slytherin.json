                "senses": [
                    {
                        "sense_id": "cabe659a-b8bf-3b0e-bcae-210d0703d8b5",
                        "entry_id": "7087cd06-48d8-3257-8675-fee6faf07585",
                        "glosses": [
                            "A person having traits associated with Slytherin house from the Harry Potter series, including ambition, cunning, or an affinity for snakes or the colours green and silver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37bbc304-54ce-46d4-8e34-652a73f98e52",
                                "sense_id": "cabe659a-b8bf-3b0e-bcae-210d0703d8b5",
                                "text": "“You know, there are colors beyond black and green. You're not a Slytherin.”"
                            },
                            {
                                "example_id": "f9690491-8976-42a1-844c-d6ad15e4aea5",
                                "sense_id": "cabe659a-b8bf-3b0e-bcae-210d0703d8b5",
                                "text": "I'll admit, this place creeps me out, but Slytherins out there will enjoy viewing (and holding) over 50 types of snakes and reptiles, including bearded dragons, horned frogs, and tarantulas."
                            },
                            {
                                "example_id": "68d7f31e-13bf-4680-a86e-35dc3c12019f",
                                "sense_id": "cabe659a-b8bf-3b0e-bcae-210d0703d8b5",
                                "text": "“It's too bad your Slytherin brother can't be persuaded to tell the truth to Will,” Annabeth mused.\n“Not unless there's something in it for him.”"
                            }
                        ]
                    }
                ],
