                "senses": [
                    {
                        "sense_id": "70d4e8c1-f4e3-3aff-b5be-31e30324163b",
                        "entry_id": "2b2fca3a-d506-3a8f-b2d2-3a880ee17387",
                        "glosses": [
                            "Intervention d’un expert grâce à des moyens de communication et d’information, sans que celui-ci se déplace sur le lieu de l’élément à expertiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "221e4696-d12c-4962-9c3b-94c87dd18e96",
                                "sense_id": "70d4e8c1-f4e3-3aff-b5be-31e30324163b",
                                "text": "La téléexpertise, ou expertise à distance (EAD), est de plus en plus pratiquée par les compagnies d’assurance afin d’économiser les coûts. L’expert ne se déplace plus : il expertise sur photo et devis en faisant une moyenne par rapport à d’autres dossiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b206e62-40f8-343f-a8ac-07a5a26ff178",
                        "entry_id": "2b2fca3a-d506-3a8f-b2d2-3a880ee17387",
                        "glosses": [
                            "Acte de télémédecine par lequel un professionnel de santé demande, à distance, l’avis d’un autre professionnel."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3e44dda1-0465-4d49-baa9-ae7c7fc05ab3",
                                "sense_id": "9b206e62-40f8-343f-a8ac-07a5a26ff178",
                                "text": "Parmi les différents actes de télémédecine, la téléexpertise consiste en la demande à distance par un professionnel de santé d’un deuxième avis médical, grâce à l’envoi d’images (scanner, radio, fond de l’œil…) et parfois à de l’échange en visioconférence via internet."
                            }
                        ]
                    }
