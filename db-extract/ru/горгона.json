                                        "glosses": [
                                            "Synonym of Demogorgon (“a pagan god or demon”)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c3513ab-978f-42da-b2ad-67de171291a1",
                                                "sense_id": "20684d09-58c2-36eb-94df-03c9666e3e45",
                                                "text": "Uillain I tel thee, were that Tamburlaine\nAs monſtrous as Gorgon, prince of Hel,\nThe Souldan would not ſtart a foot from him."
                                            }
                                        ]
