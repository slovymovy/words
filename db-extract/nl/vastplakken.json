        "nl-extract.jsonl": [
            {
                "entry_id": "e9cbb1f2-e21f-34a7-bc15-d84394c91be2",
                "word": "vastplakken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c8c16641-2746-39ca-a863-36758f2e48cd",
                        "entry_id": "e9cbb1f2-e21f-34a7-bc15-d84394c91be2",
                        "glosses": [
                            "met lijm iets vastmaken aan iets anders"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3b691da1-1e95-4fd9-ae6c-9fddaebe44e2",
                                "sense_id": "c8c16641-2746-39ca-a863-36758f2e48cd",
                                "text": "De vrouwtjes leggen eieren die ze vastplakken aan de haarschacht. Na een week komen de eitjes uit en dan duurt het ongeveer een week voor de nieuwe luizen eitjes kunnen leggen.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "e3489a86-c6e4-3192-80a0-c1eb1eddc9eb",
                        "entry_id": "e9cbb1f2-e21f-34a7-bc15-d84394c91be2",
                        "glosses": [
                            "voortdurend kleven of steeds opnieuw hechten"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "b30011d8-9e64-44e7-8cfa-fe2c67bc0e9d",
                                "sense_id": "e3489a86-c6e4-3192-80a0-c1eb1eddc9eb",
                                "text": "\"Hebben we gedaan: we spuiten nu een glycol-laag onder treinen bij winterweer. Dat is een anti-ijslaagje waardoor de sneeuw niet zo erg onder de trein blijft vastplakken. En we hebben gemerkt dat het werkt. Dat wisten we niet eerder, want in de afgelopen jaren is er niet genoeg sneeuw gevallen om het te testen. Nu dus wel.\""
                            },
                            {
                                "example_id": "ba0a6ba5-c8c4-472e-b596-384172404209",
                                "sense_id": "e3489a86-c6e4-3192-80a0-c1eb1eddc9eb",
                                "text": "‘Een mooi interieur hoeft niet altijd fortuinen te kosten’, zegt Voorjans. ‘Er moeten evenmin grote namen of bekende merken aan vastplakken. Veel mensen willen dat wel omdat ze zich dan beter voelen. Het geeft hen bevestiging, het stelt hen gerust."
                            }
                        ]
                    }
                ],
