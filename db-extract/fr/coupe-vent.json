            {
                "entry_id": "a1b17573-39e5-3ee0-944e-8a8a8cb39b85",
                "word": "coupe-vent",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "11952efd-1f62-4e54-b133-481756d4ad3b",
                        "entry_id": "a1b17573-39e5-3ee0-944e-8a8a8cb39b85",
                        "tags": [
                            "plural"
                        ],
                        "form": "coupe-vents"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ceb4e5c0-2774-3369-b191-2f89a4777ab8",
                        "entry_id": "a1b17573-39e5-3ee0-944e-8a8a8cb39b85",
                        "glosses": [
                            "Qui sert à couper, à arrêter le vent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3731fd4-0839-4081-93c2-8d5cd72b9b2b",
                                "sense_id": "ceb4e5c0-2774-3369-b191-2f89a4777ab8",
                                "text": "Voûté, les mains au dos, le profil en coupe-vent, il s’en va, par habitude au devant de son train."
                            },
                            {
                                "example_id": "3bdf9489-cb52-41de-a741-9c97b4d7bd95",
                                "sense_id": "ceb4e5c0-2774-3369-b191-2f89a4777ab8",
                                "text": "Le briquet, je me le voulais capable de s’allumer même sous la pluie, même dans la tempête. Papa, dans son fourbi, en avait un, cassé, mais muni d’un coupe-vent, merveille. Avec les morceaux de deux ou trois autres débris, je l’ai remis en état."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b736aa8-9433-30a3-a725-670f626851ff",
                        "entry_id": "a1b17573-39e5-3ee0-944e-8a8a8cb39b85",
                        "glosses": [
                            "Vêtement dont la coupe et la texture protègent des effets du vent. → voir anorak"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "ea20354e-a5eb-453d-b429-a0af482775fe",
                                "sense_id": "0b736aa8-9433-30a3-a725-670f626851ff",
                                "text": "Le coupe-vent, un vêtement technique pour une protection optimale. Le coupe-vent est l’allié de tous les sportifs et motards qui affrontent souvent le vent et les intempéries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1faae4fc-3a03-464f-bd8e-d7cd55a7dcbe",
                        "source_entry_id": "a1b17573-39e5-3ee0-944e-8a8a8cb39b85",
                        "target_lang_word": "Windjacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windjacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "934aa7bd-73b0-3691-9534-706ee820a6b3",
                                        "entry_id": "099d8dc5-767e-39fd-aae1-b992eb01dbad",
                                        "glosses": [
                                            "leichtes, winddichtes Stück Oberbekleidung für schlechtes Wetter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e91d7e9-e56f-41ea-89e3-4650dae41ae4",
                                                "sense_id": "934aa7bd-73b0-3691-9534-706ee820a6b3",
                                                "text": "Beim Urlaub an der See ist eine Windjacke immer angebracht."
                                            },
                                            {
                                                "example_id": "f1f539b7-aa34-43a5-9a16-381090448815",
                                                "sense_id": "934aa7bd-73b0-3691-9534-706ee820a6b3",
                                                "text": "„Himpel erwartete mich in Hemd und Knickerbockern, an seiner Windjacke putzten die beiden Sekretärinnen herum, rieben da, wischten, reinigten mit Terpentin.“"
                                            },
                                            {
                                                "example_id": "398dc721-40b4-4596-8ece-c7da91f3f50a",
                                                "sense_id": "934aa7bd-73b0-3691-9534-706ee820a6b3",
                                                "text": "„Dr. Grüner trägt einen blauen Pullover und eine helle Windjacke und wirkt deutlich jünger als in seiner Robe.“"
                                            },
                                            {
                                                "example_id": "1c41a12a-25d3-452e-9a8b-09597ec59e36",
                                                "sense_id": "934aa7bd-73b0-3691-9534-706ee820a6b3",
                                                "text": "„Nach dem Cafébesuch hat Schulz seine blaue Windjacke übergestreift und ist ins Rathaus gegangen.“"
                                            },
                                            {
                                                "example_id": "35a30b0e-de28-4325-ad47-fbc236c85b80",
                                                "sense_id": "934aa7bd-73b0-3691-9534-706ee820a6b3",
                                                "text": "„Nie zuvor in seinem Leben hatte Thomas Lieven schwere Bergschuhe an den Füßen gehabt, nie in seinem Leben hatte er eine gefütterte Windjacke getragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
