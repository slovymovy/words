                ],
                "senses": [
                    {
                        "sense_id": "9f450caf-b27b-3cc7-b30c-7daacc17fb31",
                        "entry_id": "31af50da-5df6-34ad-b6d7-78606232c3dd",
                        "glosses": [
                            "Bank aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c220e9-b675-4e43-97de-1fd15291a247",
                                "sense_id": "9f450caf-b27b-3cc7-b30c-7daacc17fb31",
                                "text": "„Wir marschierten über einen Trampelpfad bergauf und machten zwischendurch an kleinen Lichtungen auf alten, verwitterten Holzbänken Rast.“"
                            },
                            {
                                "example_id": "64c0d3f1-65b2-4ab3-b7d7-efbc97fc7d05",
                                "sense_id": "9f450caf-b27b-3cc7-b30c-7daacc17fb31",
                                "text": "„Du hast dich noch nicht an die Hitze und den Regen gewöhnt, sagte ich mir und ließ mich auf die Holzbank vor dem Eingang sinken.“"
                            },
                            {
                                "example_id": "d635436f-0569-43ae-82a6-1a3476447965",
                                "sense_id": "9f450caf-b27b-3cc7-b30c-7daacc17fb31",
                                "text": "„Ida setzte sich auf die Holzbank und schnürte ihre Stiefel auf.“"
                            },
                            {
                                "example_id": "f0359eb1-6be2-4f33-875a-aa168fd1a901",
                                "sense_id": "9f450caf-b27b-3cc7-b30c-7daacc17fb31",
                                "text": "„Neben der Tür hatten Fried und zwei ältere Männer auf einer Holzbank Platz genommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
