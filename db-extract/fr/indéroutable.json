                "senses": [
                    {
                        "sense_id": "5ac67712-5fd4-3d1e-b87f-4ad639321775",
                        "entry_id": "a655a7c6-92d6-33d0-bfc9-8e871ab7fd85",
                        "glosses": [
                            "Que l’on ne peut pas faire dévier de sa route."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10273343-46d6-46c8-b68c-e1ee6197928b",
                                "sense_id": "5ac67712-5fd4-3d1e-b87f-4ad639321775",
                                "text": "… un cauchemar s’installait, toujours le même, d’une précision, d’une réalité indéroutable, qui l’introduisait toujours au même lieu,un endroit vrai, dont son sommeil seul savait l’existence, un lieu de plaisir bas dans un jardin équivoque, orchestral."
                            },
                            {
                                "example_id": "ef1d95e6-8cc0-4092-991d-5e09fed2be4b",
                                "sense_id": "5ac67712-5fd4-3d1e-b87f-4ad639321775",
                                "text": "Fatalité des retours, retours de la fatalité : tragiques ou heureuses, les destinées se tracent d’un seul trait tendu, rectiligne. Ainsi Lena, la nomade, en son droit chemin, en sa droite route, indéroutable, sans erreur."
                            },
                            {
                                "example_id": "bb054a5b-5866-4cdd-afef-3a0421991475",
                                "sense_id": "5ac67712-5fd4-3d1e-b87f-4ad639321775",
                                "text": "C’est que situation et processus d’installation s’entremêlent si bien qu’une fois amorcé le phénomène apparaît en constante et indéroutable progression."
                            }
                        ]
                    },
                    {
                        "sense_id": "9613765e-3b46-3074-b729-4896a02c9e69",
                        "entry_id": "a655a7c6-92d6-33d0-bfc9-8e871ab7fd85",
                        "glosses": [
                            "Que rien ne peut perturber."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5ee7893e-d133-437a-92c7-03c9dc155e51",
                                "sense_id": "9613765e-3b46-3074-b729-4896a02c9e69",
                                "text": "Il voit juste, il dit juste, il a une vaste instruction, une indéroutable mémoire, une ardeur qui ne tombe jamais."
                            },
                            {
                                "example_id": "468fbdaa-299e-4b8b-8a85-95c0d4f2b0da",
                                "sense_id": "9613765e-3b46-3074-b729-4896a02c9e69",
                                "text": "Le Louvre le considérait comme sa meilleure représentation à l’étranger et comme l’homme le plus capable, par ses manières de bonne famille et par son indéroutable autorité, de faire figure au nom de la plus belle maison de France."
                            },
                            {
                                "example_id": "4d0774f3-376a-488f-9364-e424cbfb336e",
                                "sense_id": "9613765e-3b46-3074-b729-4896a02c9e69",
                                "text": "Car elle était à notre propos d’une indéroutable lucidité."
                            }
                        ]
                    }
                ],
