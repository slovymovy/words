            "senses": [
                {
                    "sense_id": "63c82bad-a327-3d2c-b704-abd1bf0b8496",
                    "sense_definition": "Iemand die kleine, onbeduidende diefstallen plegt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misdadiger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kruimeldief</w> werd gegrepen nadat hij een appel had gestolen op de markt.",
                            "target_lang_translations": {
                                "en": "The <w>petty thief</w> was caught after stealing an apple at the market."
                            }
                        },
                        {
                            "text": "Politieagenten hebben gisteren een bekende <w>kruimeldief</w> aangehouden in het winkelcentrum.",
                            "target_lang_translations": {
                                "en": "Police officers arrested a well-known <w>small-time thief</w> in the shopping mall yesterday."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een kleine kruimeldief"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who commits small, petty thefts."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "petty thief",
                                "target_lang_sense_clarification": "someone who steals items of low value"
                            },
                            {
                                "target_lang_word": "small-time thief",
                                "target_lang_sense_clarification": "a thief who operates on a small scale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7361dc0c-3920-3df7-a28d-560758a30c1e",
                    "sense_definition": "Een klein, draadloos apparaat om snel tafelkruimels en klein vuil op te zuigen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemorste koffie was zo opgeruimd met de <w>kruimeldief</w>.",
                            "target_lang_translations": {
                                "en": "The spilled coffee was quickly cleaned up with the <w>handheld vacuum</w>."
                            }
                        },
                        {
                            "text": "Ik gebruik de <w>kruimeldief</w> altijd om de bank snel schoon te maken.",
                            "target_lang_translations": {
                                "en": "I always use the <w>dustbuster</w> to quickly clean the couch."
                            }
                        }
                    ],
                    "synonyms": [
                        "kruimelzuiger"
                    ],
                    "common_phrases": [
                        "de kruimeldief gebruiken"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, handheld wireless device for quickly vacuuming up crumbs and small dirt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "handheld vacuum",
                                "target_lang_sense_clarification": "small portable vacuum cleaner"
                            },
                            {
                                "target_lang_word": "dustbuster",
                                "target_lang_sense_clarification": "handheld vacuum cleaner"
                            }
                        ]
                    }
                }
            ]
        }
