{
    "word_family": [
        "menace",
        "menacer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c78ea68f-fc61-398b-a197-05797f9ced84",
                    "sense_definition": "Qui constitue ou exprime une menace, qui annonce un danger ou inspire la crainte.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien du voisin s'est approché avec un grognement particulièrement <w>menaçant</w>.",
                            "target_lang_translations": {
                                "en": "The neighbour's dog approached with a particularly <w>threatening</w> growl.",
                                "ru": "Собака соседа подошла с особенно <w>угрожающим</w> рычанием.",
                                "de": "Der Hund des Nachbarn näherte sich mit einem besonders <w>bedrohlichen</w> Knurren.",
                                "es": "El perro del vecino se acercó con un gruñido particularmente <w>amenazador</w>.",
                                "zh": "邻居家的狗走近时，发出了一声格外<w>凶狠</w>的低吼。"
                            }
                        },
                        {
                            "text": "Des nuages sombres et <w>menaçants</w> s'amoncelaient rapidement à l'horizon.",
                            "target_lang_translations": {
                                "en": "Dark and <w>threatening</w> clouds were gathering rapidly on the horizon.",
                                "ru": "На горизонте быстро собирались тёмные и <w>грозные</w> тучи.",
                                "de": "Dunkle und <w>drohende</w> Wolken türmten sich rasch am Horizont auf.",
                                "es": "Nubes oscuras y <w>amenazantes</w> se amontonaban rápidamente en el horizonte.",
                                "zh": "地平线上迅速聚集起一片阴沉而<w>不祥</w>的乌云。"
                            }
                        }
                    ],
                    "antonyms": [
                        "rassurant"
                    ],
                    "common_phrases": [
                        "air menaçant",
                        "ciel menaçant",
                        "ton menaçant",
                        "geste menaçant"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing or constituting a threat; suggesting danger or inspiring fear.",
                        "ru": "Выражающий угрозу, предвещающий опасность или внушающий страх.",
                        "de": "Eine Gefahr ankündigend oder Furcht einflößend.",
                        "es": "Que constituye o expresa una amenaza, que anuncia peligro o inspira temor.",
                        "zh": "能够构成威胁、预示危险或令人感到恐惧的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "threatening",
                                "target_lang_sense_clarification": "intimidating gestures, tones, or looks"
                            },
                            {
                                "target_lang_word": "menacing",
                                "target_lang_sense_clarification": "dark, ominous appearance or sound"
                            },
                            {
                                "target_lang_word": "ominous",
                                "target_lang_sense_clarification": "foreboding, signalling coming trouble"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "угрожающий",
                                "target_lang_sense_clarification": "угрожающий жест или тон"
                            },
                            {
                                "target_lang_word": "грозный",
                                "target_lang_sense_clarification": "грозные тучи, внушительный вид"
                            },
                            {
                                "target_lang_word": "зловещий",
                                "target_lang_sense_clarification": "мрачный, предвещающий беду"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bedrohlich",
                                "target_lang_sense_clarification": "einschüchternde Gesten oder Töne"
                            },
                            {
                                "target_lang_word": "drohend",
                                "target_lang_sense_clarification": "drohende Wolken, Gewitter"
                            },
                            {
                                "target_lang_word": "unheilvoll",
                                "target_lang_sense_clarification": "Unheil ankündigend, dunkel wirkend"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "amenazante",
                                "target_lang_sense_clarification": "gesto o actitud intimidante"
                            },
                            {
                                "target_lang_word": "amenazador",
                                "target_lang_sense_clarification": "nubes, miradas o sonidos sombríos"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凶狠",
                                "target_lang_sense_clarification": "凶狠的神色或动作"
                            },
                            {
                                "target_lang_word": "不祥",
                                "target_lang_sense_clarification": "预示灾祸的征兆"
                            },
                            {
                                "target_lang_word": "吓人",
                                "target_lang_sense_clarification": "令人害怕的外表或声音"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5558f4ce-5ce6-3b34-8b23-275904600bf9",
                    "sense_definition": "Participe présent de <w>menacer</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'inconnu a exigé la caisse en <w>menaçant</w> les employés avec une arme factice.",
                            "target_lang_translations": {
                                "en": "The stranger demanded the cash by <w>threatening</w> the employees with a fake weapon.",
                                "ru": "Незнакомец потребовал деньги из кассы, <w>угрожая</w> сотрудникам муляжом оружия.",
                                "de": "Der Unbekannte verlangte die Kasse, indem er die Angestellten mit einer Spielzeugwaffe <w>bedrohte</w>.",
                                "es": "El desconocido exigió la caja <w>amenazando</w> a los empleados con un arma falsa.",
                                "zh": "陌生人用一把假枪<w>威胁</w>员工，索要收银台里的钱。"
                            }
                        },
                        {
                            "text": "Il a quitté la réunion en colère, <w>menaçant</w> de démissionner sur-le-champ.",
                            "target_lang_translations": {
                                "en": "He left the meeting angrily, <w>threatening</w> to resign on the spot.",
                                "ru": "Он в гневе покинул совещание, <w>грозя</w> тут же уволиться.",
                                "de": "Er verließ die Besprechung wütend und <w>drohte</w>, sofort zu kündigen.",
                                "es": "Salió de la reunión enfadado, <w>amenazando</w> con dimitir de inmediato.",
                                "zh": "他怒气冲冲地离开了会议，<w>扬言</w>要当场辞职。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of the verb menacer, meaning to threaten; used for threatening someone or something with harm.",
                        "ru": "Деепричастие от глагола «угрожать»: угрожая кому-либо или чему-либо вредом.",
                        "de": "Partizip Präsens von „menacer“: jemandem oder etwas mit Schaden drohend.",
                        "es": "Gerundio del verbo «amenazar», que indica advertir a alguien de un daño o castigo.",
                        "zh": "以伤害或后果相要挟，使人感到害怕。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "threaten",
                                "target_lang_sense_clarification": "to intimidate someone with harm"
                            },
                            {
                                "target_lang_word": "menace",
                                "target_lang_sense_clarification": "formal or literary register"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "угрожать",
                                "target_lang_sense_clarification": "угрожать оружием, насилием"
                            },
                            {
                                "target_lang_word": "грозить",
                                "target_lang_sense_clarification": "грозить увольнением, наказанием"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bedrohen",
                                "target_lang_sense_clarification": "jemanden mit Gewalt einschüchtern"
                            },
                            {
                                "target_lang_word": "drohen",
                                "target_lang_sense_clarification": "Konsequenzen oder Kündigung ankündigen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "amenazar",
                                "target_lang_sense_clarification": "intimidar con daño o castigo"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "威胁",
                                "target_lang_sense_clarification": "以伤害相要挟"
                            },
                            {
                                "target_lang_word": "扬言",
                                "target_lang_sense_clarification": "声称要做某事以施压"
                            },
                            {
                                "target_lang_word": "恐吓",
                                "target_lang_sense_clarification": "用暴力或言语使人害怕"
                            }
                        ]
                    }
                }
            ]
        }
