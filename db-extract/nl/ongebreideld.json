                ],
                "senses": [
                    {
                        "sense_id": "1332a9a0-e10a-3aae-be70-2ce0ecdab763",
                        "entry_id": "cd93a2fb-6519-3542-8fa3-1e3ded13a184",
                        "glosses": [
                            "zonder remmingen, beperkingen of grenzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c3020af-136e-4f50-a5e0-2609cd083aef",
                                "sense_id": "1332a9a0-e10a-3aae-be70-2ce0ecdab763",
                                "text": "Marije Langelaar is een dichter met een ongebreidelde scheppingsdrift. Het moet rinkelen, het moet vonken, schitteren, glinsteren, glanzen in haar wereld. Ze wil alles wat haar omringt tot brandstof van haar verzen maken. Vitalisme is troef."
                            },
                            {
                                "example_id": "7d601489-4b73-43c2-ad2a-fe10c897120e",
                                "sense_id": "1332a9a0-e10a-3aae-be70-2ce0ecdab763",
                                "text": "Aan de horizon doemt een nieuw dossier op dat minstens zoveel tongen zal in beweging zal brengen. De huidige afspraken over de groei van Schiphol gelden tot en met 2020, daarna mogen er dus meer vliegbewegingen komen dan het huidige plafond van 500.000. Tenminste, dat is wel waar Nijhuis op aast. ,,Ik hoop dat verdere groei mogelijk is. Goede verbindingen zijn belangrijk voor een klein land als Nederland. Er is een noodzaak om door te groeien. Niet ongebreideld, maar beheerst.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "515df536-276f-4260-afe6-ff600359db00",
                        "source_entry_id": "cd93a2fb-6519-3542-8fa3-1e3ded13a184",
                        "source_sense_id": "1332a9a0-e10a-3aae-be70-2ce0ecdab763",
                        "source_sense_description": "zonder remmingen, beperkingen of grenzen",
                        "target_lang_word": "unrestrained",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unrestrained",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54cc60f0-080f-3e1c-b7b6-218d1d934778",
                                        "entry_id": "22c62495-204d-3dcf-a7f2-cb3b28c32144",
                                        "glosses": [
                                            "immoderate; not restrained or held in check; inordinate (literary)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26400c84-0d3a-4297-972a-10e47ab79c78",
                                                "sense_id": "54cc60f0-080f-3e1c-b7b6-218d1d934778",
                                                "text": "The party was a scene of unrestrained debauchery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "834a8fea-f5a0-3a9c-ac87-e3b16b28bbb9",
                                        "entry_id": "22c62495-204d-3dcf-a7f2-cb3b28c32144",
                                        "glosses": [
                                            "spontaneous, natural and informal; unconstrained"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf529a9-ed70-4f8c-be82-b472e2b91853",
                                                "sense_id": "834a8fea-f5a0-3a9c-ac87-e3b16b28bbb9",
                                                "text": "Their meeting was one of unrestrained joy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f962df5d-97de-38b1-877f-aa896fa47531",
                                        "entry_id": "22c62495-204d-3dcf-a7f2-cb3b28c32144",
                                        "glosses": [
                                            "Not subject to physical restraint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc5e99f-10fb-40d7-960d-7b717efcb957",
                                                "sense_id": "f962df5d-97de-38b1-877f-aa896fa47531",
                                                "text": "Managing unrestrained prisoners alone in any environment is inherently dangerous and should not be tolerated."
                                            },
                                            {
                                                "example_id": "38a9905d-c4bb-4ed6-9e35-57d6bece0a30",
                                                "sense_id": "f962df5d-97de-38b1-877f-aa896fa47531",
                                                "text": "In an accident there will often be injuries, as people are unrestrained. But in the case of Sandilands, I don't think anyone would have foreseen the seven deaths and 62 injuries that occurred when the tram overturned [...]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unrestrained",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffdaafd5-059b-3b29-91e6-9477cbfbf0e3",
