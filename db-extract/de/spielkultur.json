                "senses": [
                    {
                        "sense_id": "f66ace4d-e068-37ab-8fb1-88bba0639c63",
                        "entry_id": "9c3f2e45-38a6-322f-8f8a-538b74205420",
                        "glosses": [
                            "hochstehender Entwicklungsstand, das Spielen bzw. das Spiel betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30004abc-8e3c-4fe1-9914-8113899b3abf",
                                "sense_id": "f66ace4d-e068-37ab-8fb1-88bba0639c63",
                                "text": "„Deutschland hat eine andere Spielkultur.“"
                            },
                            {
                                "example_id": "f60c47e9-4e3b-49a7-983c-d3b3f07538d6",
                                "sense_id": "f66ace4d-e068-37ab-8fb1-88bba0639c63",
                                "text": "„Die neue Spielkultur breitet sich angeblich auch in den USA aus.“"
                            },
                            {
                                "example_id": "66226765-25fa-47ac-a957-37c6eca574f4",
                                "sense_id": "f66ace4d-e068-37ab-8fb1-88bba0639c63",
                                "text": "„Ohne jeden direkten Eingriff läßt sich schon durch die Atmosphäre, die die Erziehung schafft, eine gewisse Höhe der Spielkultur, die ihre eigene Tradition hat, erreichen.“"
                            },
                            {
                                "example_id": "65f77607-c51e-4721-9dd1-6d0e3c47a41c",
                                "sense_id": "f66ace4d-e068-37ab-8fb1-88bba0639c63",
                                "text": "„Das macht auch das Spiel der Demokratie so schwer, in dem die einzelnen Parteien immer wieder verleitet sind, zur Macht zu drängen; weshalb das demokratische Prinzip bei den Völkern am besten eingespielt ist, die auch sonst eine hohe Spielkultur haben.“"
                            },
                            {
                                "example_id": "5e677b49-8feb-4aa1-9559-ed1ceeeec18c",
                                "sense_id": "f66ace4d-e068-37ab-8fb1-88bba0639c63",
                                "text": "„Dabei bietet sich –wie in der Momo-Welt – ein eher negatives Bild der heute gegebenen Spielkultur.“"
                            },
                            {
                                "example_id": "e791d912-6daa-4bc5-855e-f72c9f3f5668",
                                "sense_id": "f66ace4d-e068-37ab-8fb1-88bba0639c63",
                                "text": "„Aber hat die Entwicklung einer Spielkultur, die ein bestimmender und prägender Faktor von Kindheit und Jugend ist, damit Schritt gehalten?“"
                            },
                            {
                                "example_id": "390584b0-f84a-4919-9afd-8d4e69a6c69d",
                                "sense_id": "f66ace4d-e068-37ab-8fb1-88bba0639c63",
                                "text": "„Die Spiele unserer Kinder sind Kulturspiele und die Kultivierung ihres Spiels fängt bei den frühen Mutter-Kind-Spielen an.“"
                            },
                            {
                                "example_id": "99caaf7f-7a3d-4f35-8c9d-ad3e33297140",
                                "sense_id": "f66ace4d-e068-37ab-8fb1-88bba0639c63",
                                "text": "„Die Spielkultur der menschlichen Vor- und Frühzeit war noch wesentlich bestimmt von totemistischen, magischen und religiösen Vorstellungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
