                    },
                    {
                        "translation_id": "0c9817a8-204e-4de7-b076-eadbaf4f32dd",
                        "source_entry_id": "76a85996-2257-3961-ad33-ca92a1c35f0d",
                        "source_sense_id": "794d5d32-33cb-3f78-a5a0-c71f6a64581b",
