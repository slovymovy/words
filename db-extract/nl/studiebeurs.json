                            {
                                "example_id": "2099a9e6-98af-4f5b-99a0-1b2730687639",
                                "sense_id": "3e418aa1-1214-34b8-ad2f-e1e5164f8e8d",
                                "text": "D66 komt met een plan voor een nieuwe studiebeurs. In het huidige stelsel voor studiefinanciering zitten enkele knelpunten. D66 stelt daarom een nieuwe studiebeurs voor. Studenten waarvan ouders tot 70.000 euro per jaar verdienen (twee keer modaal), krijgen een studiebeurs van maximaal 400 euro per maand."
                            }
                        ]
                    }
