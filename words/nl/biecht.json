    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8776a40a-8214-3b93-b6d1-56aac9392854",
                    "sense_definition": "Het belijden van zonden aan een priester binnen de katholieke kerk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>biecht</w> is een van de zeven sacramenten van de Katholieke Kerk.",
                            "target_lang_translations": {
                                "en": "The <w>confession</w> is one of the seven sacraments of the Catholic Church."
                            }
                        },
                        {
                            "text": "Hij ging naar de kerk om zijn <w>biecht</w> te doen bij de pastoor.",
                            "target_lang_translations": {
                                "en": "He went to church to make his <w>confession</w> to the priest."
                            }
                        }
                    ],
                    "synonyms": [
                        "sacramentele biecht"
                    ],
                    "common_phrases": [
                        "biecht doen",
                        "naar de biecht"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of disclosing one's sins to a priest for absolution, particularly within the Roman Catholic Church."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confession",
                                "target_lang_sense_clarification": "The religious act of disclosing sins to a priest for absolution."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0552149-979d-35f6-a49e-3e7ca474b57b",
                    "sense_definition": "Het openlijk toegeven van eigen fouten of misstappen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bekentenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>biecht</w> van de moordenaar betekende dat de nabestaanden eindelijk rust vonden.",
                            "target_lang_translations": {
                                "en": "The murderer's <w>confession</w> meant that the surviving relatives finally found peace."
                            }
                        },
                        {
                            "text": "Na lang zwijgen kwam er eindelijk een eerlijke <w>biecht</w> over zijn daden.",
                            "target_lang_translations": {
                                "en": "After a long silence, there finally came an honest <w>confession</w> about his actions."
                            }
                        }
                    ],
                    "synonyms": [
                        "bekentenis"
                    ],
                    "common_phrases": [
                        "een biecht afleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "The open admission of one's own mistakes, faults, or wrongdoing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confession",
                                "target_lang_sense_clarification": "The act of admitting to a crime or wrongdoing."
                            },
                            {
                                "target_lang_word": "admission",
                                "target_lang_sense_clarification": "The act of acknowledging a mistake or truth."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9707f3a0-318c-3ee3-9a83-8b4742de85f2",
                    "sense_definition": "Enkelvoud tegenwoordige tijd van <w>biechten</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>biecht</w> al zijn zonden op aan de priester.",
                            "target_lang_translations": {
                                "en": "He <w>confesses</w> all his sins to the priest."
                            }
                        },
                        {
                            "text": "Zij <w>biecht</w> haar fouten eerlijk op aan haar ouders.",
                            "target_lang_translations": {
                                "en": "She honestly <w>confesses</w> her mistakes to her parents."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoeging van het werkwoord biechten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Third-person singular present tense of the verb 'to confess'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confesses",
                                "target_lang_sense_clarification": "Third-person singular present tense of the verb 'to confess'."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9eb65362-e4c1-3832-b3a7-55c1baf75808",
                    "sense_definition": "Gebiedende wijs van <w>biechten</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Biecht</w> nu eindelijk de waarheid aan iedereen.",
                            "target_lang_translations": {
                                "en": "<w>Confess</w> the truth to everyone at last."
                            }
                        },
                        {
                            "text": "<w>Biecht</w> je zonden en zoek naar vergeving.",
                            "target_lang_translations": {
                                "en": "<w>Confess</w> your sins and seek forgiveness."
                            }
                        }
                    ],
                    "traits": [
