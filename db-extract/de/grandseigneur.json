                "senses": [
                    {
                        "sense_id": "ebc31093-42d3-31f0-beba-58f4ce02c83d",
                        "entry_id": "6a29b5fe-1d63-3c07-8675-c72be1664d4b",
                        "glosses": [
                            "Angehöriger des Hochadels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74bd5aae-83f1-4f2a-a52e-cb74b9b95f1a",
                                "sense_id": "ebc31093-42d3-31f0-beba-58f4ce02c83d",
                                "text": "„In den Augen der Welt war Pierre ein Grandseigneur, als Mann einer berühmten Frau ein wenig blind und ein wenig komisch, sonst ein keineswegs dummer Sonderling, der eigentlich nichts tat, aber auch niemandem schadete, alles in allem eine brave Haut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b71274f4-4a4a-33aa-9c3d-447865b92249",
                        "entry_id": "6a29b5fe-1d63-3c07-8675-c72be1664d4b",
                        "glosses": [
                            "vornehmer, weltgewandter Herr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7215cc7b-7dca-41fd-944e-0d338a66aff2",
                                "sense_id": "b71274f4-4a4a-33aa-9c3d-447865b92249",
                                "text": "„Aber mit dem Gebaren eines weltlichen Grandseigneurs verbanden sich bei ihm eine gottesfürchtige Lebenshaltung, Wohltätigkeit, strenge Übung der kirchlichen Vorschriften.“"
                            },
                            {
                                "example_id": "768b822d-275f-4623-8905-a69ef375f255",
                                "sense_id": "b71274f4-4a4a-33aa-9c3d-447865b92249",
                                "text": "„Noch immer war er vernarrt in das studentische Leben Kopenhagens und maß sich selbst die Rolle eines rebellischen Grandseigneurs an, der sich über die Obrigkeit lustig machte, die sich trotz allem bemühte, die färöische Scholle zum Blühen zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
