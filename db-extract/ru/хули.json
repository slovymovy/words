                        "glosses": [
                            "народность, живущая в Новой Гвинее"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "976dd213-8967-3944-a1f7-1210730404aa",
                        "entry_id": "60cfc5df-59f8-3070-8efe-bd956bb6e000",
