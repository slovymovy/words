{
    "word_family": [
        "sprong",
        "springer",
        "springing",
        "ontsprong"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c8add8d-2856-38bf-8436-e0b136d1bcac",
                    "sense_definition": "Het ontstaan of beginnen op een specifieke locatie, vaak gebruikt voor rivieren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oorsprong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rivier <w>ontspringt</w> hoog in de bergen.",
                            "target_lang_translations": {
                                "it": "Il fiume <w>nasce</w> in alta montagna."
                            }
                        },
                        {
                            "text": "De Rijn <w>ontspringt</w> in de Zwitserse Alpen.",
                            "target_lang_translations": {
                                "it": "Il Reno <w>nasce</w> nelle Alpi svizzere."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontstaan",
                        "beginnen"
                    ],
                    "common_phrases": [
                        "rivier ontspringt"
                    ],
                    "target_lang_definitions": {
                        "it": "Avere origine o iniziare in un luogo specifico, usato spesso per fiumi o sorgenti."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "nascere",
                                "target_lang_sense_clarification": "riferito a fiumi che hanno la loro sorgente in un luogo"
                            },
                            {
                                "target_lang_word": "sgorgare",
                                "target_lang_sense_clarification": "riferito all'acqua che esce da una sorgente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bda11d9c-360e-361d-85d2-3bfd37367c7e",
                    "sense_definition": "Het uitlopen of groeien van een plant of bloem uit een bron of stam.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "groei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is een prachtige roos <w>ontsprongen</w> aan de oude stam.",
                            "target_lang_translations": {
                                "it": "Una bellissima rosa è <w>germogliata</w> dal vecchio tronco."
                            }
                        },
                        {
                            "text": "Nieuwe takken <w>ontspringen</w> aan de hoofdwortel van de boom.",
                            "target_lang_translations": {
                                "it": "Nuovi rami <w>spuntano</w> dalla radice principale dell'albero."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitlopen",
                        "uitbotten"
                    ],
                    "target_lang_definitions": {
                        "it": "Germogliare o crescere da una pianta o da un tronco."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "germogliare",
                                "target_lang_sense_clarification": "riferito a piante o rami che iniziano a crescere"
                            },
                            {
                                "target_lang_word": "spuntare",
                                "target_lang_sense_clarification": "riferito a qualcosa che emerge o cresce da una base"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e4e16eb-a024-327a-83cc-0e032914fc12",
                    "sense_definition": "Ontkomen aan een gevaarlijke of ongewenste situatie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontsnappen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is door geluk de dans <w>ontsprongen</w>.",
                            "target_lang_translations": {
                                "it": "Per fortuna è <w>scampato</w> al pericolo."
                            }
                        },
                        {
                            "text": "Dankzij zijn snelle reactie is hij de dans <w>ontsprongen</w>.",
                            "target_lang_translations": {
                                "it": "Grazie alla sua rapida reazione è <w>scampato</w> al pericolo."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontkomen",
                        "ontsnappen"
                    ],
                    "common_phrases": [
                        "de dans ontspringen"
                    ],
                    "target_lang_definitions": {
                        "it": "Scampare o sfuggire a una situazione pericolosa o indesiderata."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scampare",
                                "target_lang_sense_clarification": "evitare un pericolo o una situazione negativa"
                            },
                            {
                                "target_lang_word": "sfuggire",
                                "target_lang_sense_clarification": "evitare di essere coinvolti in qualcosa di spiacevole"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e133d4d-1bda-3c0b-b1f2-b6350cb0792e",
                    "sense_definition": "Het beginnen te bestaan of voortkomen uit iets anders.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "oorsprong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel nieuwe ideeën <w>ontspringen</w> aan een simpel gesprek.",
                            "target_lang_translations": {
                                "it": "Molte nuove idee <w>nascono</w> da una semplice conversazione."
                            }
                        },
                        {
                            "text": "Uit deze samenwerking is een groot project <w>ontsprongen</w>.",
                            "target_lang_translations": {
                                "it": "Da questa collaborazione è <w>scaturito</w> un grande progetto."
                            }
                        }
                    ],
                    "synonyms": [
                        "voortkomen",
                        "ontstaan"
                    ],
                    "target_lang_definitions": {
                        "it": "Iniziare a esistere o derivare da qualcos'altro."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "nascere",
                                "target_lang_sense_clarification": "riferito a idee o progetti che prendono forma"
                            },
                            {
                                "target_lang_word": "scaturire",
                                "target_lang_sense_clarification": "derivare o provenire da una causa o fonte specifica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2a94e14-1c54-3395-811b-9a23ce8e8da4",
                    "sense_definition": "Met een sprong ergens vandaan gaan.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het dier <w>ontsprong</w> aan de valstrik.",
                            "target_lang_translations": {
                                "it": "L'animale è <w>balzato</w> via dalla trappola."
                            }
                        },
                        {
                            "text": "Hij <w>ontsprong</w> aan de groep om te vluchten.",
                            "target_lang_translations": {
                                "it": "È <w>balzato</w> via dal gruppo per fuggire."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegspringen"
                    ],
                    "target_lang_definitions": {
                        "it": "Allontanarsi rapidamente da un luogo con un salto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "balzare via",
                                "target_lang_sense_clarification": "allontanarsi con un movimento rapido e improvviso"
                            },
                            {
                                "target_lang_word": "saltare via",
                                "target_lang_sense_clarification": "scappare via compiendo un salto"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}