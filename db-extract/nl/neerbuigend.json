        "nl-extract.jsonl": [
            {
                "entry_id": "26478a36-7053-33bc-b4cd-0e536bc835be",
                "word": "neerbuigend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1caf726d-e3db-3b58-b27e-1418daecfff1",
                        "entry_id": "26478a36-7053-33bc-b4cd-0e536bc835be",
                        "glosses": [
                            "je beter voelend dan een ander en dat ook laten merken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66189e58-23c8-47d2-be2a-b750da336ade",
                                "sense_id": "1caf726d-e3db-3b58-b27e-1418daecfff1",
                                "text": "Sarah Rose Summers (24), miss Amerika 2018, is diep door het stof gegaan nadat ze op sociale media een golf kritiek over zich heen kreeg voor ‘denigrerende, respectloze en neerbuigende en discriminerende‘ uitspraken over twee concurrentes bij de Miss Universe-verkiezingen in Bangkok."
                            },
                            {
                                "example_id": "554a0037-0c09-476c-b93d-02abab23d9be",
                                "sense_id": "1caf726d-e3db-3b58-b27e-1418daecfff1",
                                "text": "Ze had een hautaine, zowel gekwetste als neerbuigende blik, alsof ze een dichteres was die zich met tegenzin onder het ongevoelige gepeupel begaf. `Frarwaise; fluisterde de grote Griek en hij keek mij aan met een veelbetekenende blik, waarvan ik niet goed wist wat die betekende."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5944de3-7d30-4d6f-bf9a-efeb3feb03be",
                        "source_entry_id": "26478a36-7053-33bc-b4cd-0e536bc835be",
                        "source_sense_id": "1caf726d-e3db-3b58-b27e-1418daecfff1",
                        "source_sense_description": "met onecht, gespeeld, cynisch respect",
                        "target_lang_word": "derogatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derogatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60102955-8f20-392f-9cd6-33e21b3e92b4",
                                        "entry_id": "efc55c7b-0ebd-38ef-b082-a755d424aef7",
                                        "glosses": [
                                            "Disparaging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb5aaac-1172-4196-ae53-b99588b5afaa",
                                                "sense_id": "60102955-8f20-392f-9cd6-33e21b3e92b4",
                                                "text": "It was perfectly plain, that fast and far as scandal flies, Lady Anne's words, when derogatory to the Count, and that beloved wife, for whose sake they would have been most resented, had never reached their retreat in Devonshire, much less followed them to distant Italy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf15a76-ace5-33ab-aef0-fcd768a00f14",
                                        "entry_id": "efc55c7b-0ebd-38ef-b082-a755d424aef7",
                                        "glosses": [
                                            "Tending to derogate"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0a068a7-312c-4dc5-9920-35b1cb420e95",
                                                "sense_id": "fdf15a76-ace5-33ab-aef0-fcd768a00f14",
                                                "text": "The Tories […] knew that […] the House which should be the first to come to a resolution would have a great advantage over the other. […] The Commons had determined that, on Monday the twenty-eighth of January, they would take into consideration the state of the nation. The Tory Lords therefore proposed, on Friday the twenty-fifth, to enter instantly on the great business […]. But […] Devonshire moved that Tuesday the twenty-ninth should be the day. “By that time,” he said with more truth than discretion, “we may have some lights from below which may be useful for our guidance.” His motion was carried; but his language was severely censured by some of his brother peers as derogatory to their order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce6e6271-d8ba-31c8-b33a-41da330fda7f",
                                        "entry_id": "efc55c7b-0ebd-38ef-b082-a755d424aef7",
                                        "glosses": [
                                            "Tending to derogate:",
                                            "Reducing the power or value of (a governmental body, etc); detracting from."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20dc7ad0-883b-4dce-b5ce-2c36031b954c",
                                                "sense_id": "ce6e6271-d8ba-31c8-b33a-41da330fda7f",
                                                "text": "Acts of Parliament derogatory from the power of subsequent Parliaments bind not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af140ee4-2a90-39f2-98fa-64441ca676bf",
                                        "entry_id": "efc55c7b-0ebd-38ef-b082-a755d424aef7",
                                        "glosses": [
                                            "Tending to derogate:",
                                            "Lessening the worth of (a person, etc); expressing derogation; insulting."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f3fe88b-c012-4d58-80ad-3ec07e4fe188",
                                                "sense_id": "af140ee4-2a90-39f2-98fa-64441ca676bf",
                                                "text": "Billie Jean King said Friday that the Australian Open’s Margaret Court Arena should have its name changed because of Court’s derogatory comments about gay and transgender people."
                                            }
                                        ]
                                    },
