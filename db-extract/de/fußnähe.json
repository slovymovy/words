                                    {
                                        "sense_id": "08abd701-f2f8-30e1-a454-f225e90743bf",
                                        "entry_id": "93a1648e-06b2-33e3-89eb-ef0914377bdb",
                                        "glosses": [
                                            "verschil in plaats dat je gemakkelijk te voet kan afleggen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e13e545e-314c-4643-9f68-7c8d087bfdf8",
                                                "sense_id": "08abd701-f2f8-30e1-a454-f225e90743bf",
                                                "text": "De camping meldt op zijn website dat het stadscentrum op loopafstand ligt – wat klopt voor wie 4,5 kilometer wil lopen."
                                            },
                                            {
                                                "example_id": "0600f705-0592-4445-afd0-cbb86765f099",
                                                "sense_id": "08abd701-f2f8-30e1-a454-f225e90743bf",
                                                "text": "Weenen heeft de tram uit de binnenstad verwijderd, maar deze tramvrije cirkel is zoo klein, dat alle punten op loopafstand van de lijnen liggen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1b8c59c-a99d-3e0b-8e40-fa1cd902db63",
                                        "entry_id": "93a1648e-06b2-33e3-89eb-ef0914377bdb",
                                        "glosses": [
                                            "totale lengte die te voet moet worden afgelegd om iets te doen of te bezoeken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "578b14e1-2429-46c4-bcb3-f0dfb08d55de",
                                                "sense_id": "f1b8c59c-a99d-3e0b-8e40-fa1cd902db63",
                                                "text": "Hij kon niet terug naar Parijs, waar hij al een atelier had. In plaats daarvan ging hij in 1915 op een kamertje in Laren wonen. En op tien minuten loopafstand, in Blaricum, stond het huisje waar hij anderhalf jaar lang heeft geschilderd."
                                            },
                                            {
                                                "example_id": "a9946052-db41-4b27-9122-d59fbac2496f",
                                                "sense_id": "f1b8c59c-a99d-3e0b-8e40-fa1cd902db63",
                                                "text": "De verbinding van Ketabang met de andere stadsgedeelten is de ongunstigste, die zich denken laat; de loopafstand tusschen het nieuwe stadhuis en de dichtstbijzijnde tramhalte is zeker een half uur; de bouw van het nieuwe residentiekantoor op Ketabang zou veel menschen op onnoodige vervoerskosten jagen, want ook het naaste station is er een klein half uur loopen van verwijderd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
