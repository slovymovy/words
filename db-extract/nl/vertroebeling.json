                    {
                        "sense_id": "ab449aca-e70c-3c6d-b62d-7e5e3a912406",
                        "entry_id": "299fa5ca-e2c6-320e-bf96-34fadaf376bc",
                        "glosses": [
                            "dat wat er voor zorgt dat iets minder helder doorzichtig wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ee0a070-cb4f-4ce2-9a7b-42de01214ab1",
                                "sense_id": "ab449aca-e70c-3c6d-b62d-7e5e3a912406",
                                "text": "Het is bekend dat bepaalde gelaatstrekken in verband kunnen worden gebracht met een verhoogd risico op hartaandoeningen, onder meer dunner wordend of grijs haar, rimpels, een oorlelplooi, gele bultjes in de ooghoeken en vertroebeling van het hoornvlies."
                            },
                            {
                                "example_id": "2f98da83-71fb-4782-87f5-ca2e7c6f44d5",
                                "sense_id": "ab449aca-e70c-3c6d-b62d-7e5e3a912406",
                                "text": "De vertroebeling van de lens treedt geleidelijk op en ondertussen zullen ze meer vertrouwen op geur, gehoor en tast. De meeste oudere honden en katten passen zich dus aan en doen sowieso alles in een lager tempo."
                            }
                        ]
                    }
                ],
