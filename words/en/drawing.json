                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "отдёргивание",
                                "target_lang_sense_clarification": "штор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "拖拽",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                }
            ]
        },
