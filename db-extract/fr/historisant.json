                    },
                    {
                        "translation_id": "497cfa79-ef92-4a1c-a5b0-b997637f50e9",
                        "source_entry_id": "ada4d3e2-8416-360b-a43a-d4e2c490e689",
                        "target_lang_word": "historical",
                        "target_lang_code": "en",
