{
    "word_family": [
        "aggrandizement",
        "aggrandizer",
        "self-aggrandizement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "761bbb18-c2f1-3396-83e9-7319931cc5cb",
                    "sense_definition": "To make great or greater in power, rank, honor, or wealth, especially applied to individuals, families, or nations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "elevate_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The emperor sought to <w>aggrandize</w> his dynasty by conquering neighboring territories."
                        },
                        {
                            "text": "He was accused of using public funds to <w>aggrandize</w> himself and his close associates."
                        }
                    ],
                    "synonyms": [
                        "exalt",
                        "elevate",
                        "ennoble",
                        "dignify"
                    ],
                    "antonyms": [
                        "degrade",
                        "humble",
                        "abase"
                    ],
                    "common_phrases": [
                        "aggrandize oneself",
                        "aggrandize his family",
                        "aggrandize their power"
                    ]
                },
                {
                    "sense_id": "e0bc44d8-7f43-36bc-857f-da7210ebd6cf",
                    "sense_definition": "To make something appear great or greater than it is; to praise highly or exaggerate the importance of.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exaggerate_importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The media tended to <w>aggrandize</w> the minor incident into a national crisis."
                        },
                        {
                            "text": "She did not wish to <w>aggrandize</w> her achievements, preferring to let the results speak for themselves."
                        }
                    ],
                    "synonyms": [
                        "magnify",
                        "glorify",
                        "exaggerate",
                        "overstate"
                    ],
                    "antonyms": [
                        "belittle",
                        "minimize",
                        "understate",
                        "deprecate"
                    ],
                    "common_phrases": [
                        "aggrandize his actions",
                        "aggrandize their achievements"
                    ]
                },
                {
                    "sense_id": "4d933334-0d0a-387f-98f9-bc7b5d177a98",
                    "sense_definition": "To make physically larger, greater, or to enlarge in size or scope.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enlarge_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect proposed a plan to <w>aggrandize</w> the estate by adding a new wing."
                        },
                        {
                            "text": "They sought to <w>aggrandize</w> their land holdings through strategic purchases."
                        }
                    ],
                    "synonyms": [
                        "enlarge",
                        "expand",
                        "increase",
                        "extend"
                    ],
                    "antonyms": [
                        "diminish",
                        "decrease",
                        "shrink"
                    ],
                    "common_phrases": [
                        "aggrandize the estate",
                        "aggrandize one's authority"
                    ]
                },
                {
                    "sense_id": "fd894241-5dfa-323d-91bf-c24743d2bf6c",
                    "sense_definition": "To increase in size, power, or influence; to become great.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grow_great",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aggressive nation wanted to <w>aggrandize</w> at the expense of its weaker neighbors."
                        },
                        {
                            "text": "Historically, empires tend to <w>aggrandize</w> until they become too large to govern effectively."
                        }
                    ],
                    "synonyms": [
                        "grow",
                        "expand",
                        "flourish"
                    ],
                    "antonyms": [
                        "decline",
                        "shrink"
                    ],
                    "common_phrases": [
                        "tendency to aggrandize"
                    ]
                }
            ]
        }
    ]
}