{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc0e52dc-dc12-3a26-8e6e-504d5a829410",
                    "sense_definition": "A metal band, chain, or shackle fastened around a person's wrist or ankle to restrict movement; a handcuff or fetter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard unlocked the heavy iron <w>manacles</w> around the prisoner's wrists.",
                            "target_lang_translations": {
                                "nl": "De bewaker ontgrendelde de zware ijzeren <w>handboeien</w> rond de polsen van de gevangene."
                            }
                        },
                        {
                            "text": "He struggled in vain against the cold steel <w>manacles</w> that held him securely to the wall.",
                            "target_lang_translations": {
                                "nl": "Hij verzette zich vergeefs tegen de koudstalen <w>boeien</w> die hem stevig aan de muur vastklinkten."
                            }
                        }
                    ],
                    "synonyms": [
                        "handcuff",
                        "fetter",
                        "shackle"
                    ],
                    "common_phrases": [
                        "iron manacles"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een metalen beugel, ketting of boei die om iemands pols of enkel wordt vastgemaakt om de beweging te beperken; een handboei of voetboei."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "handboei",
                                "target_lang_sense_clarification": "boei voor de pols"
                            },
                            {
                                "target_lang_word": "boei",
                                "target_lang_sense_clarification": "algemeen voor pols of enkel"
                            },
                            {
                                "target_lang_word": "kluister",
                                "target_lang_sense_clarification": "vaak meervoud; traditionele of zware boei"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21677119-6f4b-3d14-a8d6-ed4f0a2c577e",
                    "sense_definition": "Something that restricts or hinders freedom, thought, or action; a constraint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author sought to free society from the outdated <w>manacles</w> of tradition.",
                            "target_lang_translations": {
                                "nl": "De auteur probeerde de samenleving te bevrijden van de verouderde <w>kluisters</w> van de traditie."
                            }
                        },
                        {
                            "text": "Economic despair acted as a psychological <w>manacle</w> on the nation's creative energy.",
                            "target_lang_translations": {
                                "nl": "Economische wanhoop werkte als een psychologische <w>boei</w> voor de creatieve energie van het land."
                            }
                        }
                    ],
                    "synonyms": [
                        "constraint",
                        "restriction"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets wat vrijheid, gedachten of handelingen beperkt of belemmert; een belemmering of kluister."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kluister",
                                "target_lang_sense_clarification": "figuurlijk; belemmering van vrijheid"
                            },
                            {
                                "target_lang_word": "boei",
                                "target_lang_sense_clarification": "figuurlijk; beperkende factor"
                            },
                            {
                                "target_lang_word": "belemmering",
                                "target_lang_sense_clarification": "beperking"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8214c33b-53bd-31fe-889c-74fad72ba589",
                    "sense_definition": "To fasten handcuffs or shackles on someone; to restrict someone's movement using physical bonds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officers immediately <w>manacled</w> the suspect before leading him out.",
                            "target_lang_translations": {
                                "nl": "De politieagenten <w>boeiden</w> de verdachte onmiddellijk voordat ze hem naar buiten leidden."
                            }
                        },
                        {
                            "text": "They threatened to <w>manacle</w> his hands and feet if he continued to resist.",
                            "target_lang_translations": {
                                "nl": "Ze dreigden zijn handen en voeten te <w>boeien</w> als hij zich bleef verzetten."
                            }
                        }
                    ],
                    "synonyms": [
                        "handcuff",
                        "shackle",
                        "fetter"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand handboeien of boeien omdoen; iemands beweging fysiek beperken met boeien."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "boeien",
                                "target_lang_sense_clarification": "in boeien slaan"
                            },
                            {
                                "target_lang_word": "handboeien omdoen",
                                "target_lang_sense_clarification": "polissen vastmaken met handboeien"
                            },
                            {
                                "target_lang_word": "geboeien",
                                "target_lang_sense_clarification": "in ketenen vastmaken"
                            },
                            {
                                "target_lang_word": "kluisteren",
                                "target_lang_sense_clarification": "vastbinden met kluisters"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}