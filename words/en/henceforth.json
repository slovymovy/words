{
    "word_family": [
        "hence"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6e3c2786-77b7-3d98-8632-d6201a0ca7f6",
                    "sense_definition": "From this time forward.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Henceforth</w>, all employees must submit their reports by Friday afternoon.",
                            "target_lang_translations": {
                                "ru": "<w>Отны́не</w> все сотрудники должны сдавать свои отчеты до обеда в пятницу."
                            }
                        },
                        {
                            "text": "The new rules will apply <w>henceforth</w> to ensure better safety for everyone.",
                            "target_lang_translations": {
                                "ru": "Новые правила будут действовать <w>впредь</w> для обеспечения большей безопасности для всех."
                            }
                        }
                    ],
                    "synonyms": [
                        "from now on",
                        "henceforward",
                        "hereafter",
                        "moving forward"
                    ],
                    "antonyms": [
                        "hitherto",
                        "heretofore"
                    ],
                    "common_phrases": [
                        "henceforth apply",
                        "henceforth known"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начиная с этого момента и в будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отны́не",
                                "target_lang_sense_clarification": "указывает на начало нового периода времени"
                            },
                            {
                                "target_lang_word": "впредь",
                                "target_lang_sense_clarification": "часто используется в официальном или юридическом контексте для обозначения будущего времени"
                            },
                            {
                                "target_lang_word": "с э́тих пор",
                                "target_lang_sense_clarification": "указывает на точку отсчета в настоящем или прошлом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51f6c79b-546f-397c-b74e-7835e836ffac",
                    "sense_definition": "Further within this document.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The specific terms are detailed <w>henceforth</w> in the appendix of this contract.",
                            "target_lang_translations": {
                                "ru": "Конкретные условия подробно описаны <w>здесь и да́лее</w> в приложении к данному договору."
                            }
                        },
                        {
                            "text": "Please refer to the guidelines provided <w>henceforth</w> for further instructions.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, обратитесь к руководству, представленному <w>дале́е</w>, для получения дальнейших инструкций."
                            }
                        }
                    ],
                    "synonyms": [
                        "hereinafter",
                        "hereunder"
                    ],
                    "antonyms": [
                        "hereinbefore"
                    ],
                    "common_phrases": [
                        "detailed henceforth",
                        "provided henceforth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Далее в тексте документа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "здесь и да́лее",
                                "target_lang_sense_clarification": "стандартная фраза для отсылки к последующим частям документа"
                            },
                            {
                                "target_lang_word": "дале́е",
                                "target_lang_sense_clarification": "указывает на то, что информация будет представлена позже в тексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}