                                "target_senses": [
                                    {
                                        "sense_id": "7eb3adb7-1e96-3937-91c7-6ec92a794ae8",
                                        "entry_id": "7c196588-9dbf-3ebd-9890-9a70f3d79879",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 12, das zur Gruppe der Erdalkalimetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfd5dcbb-6523-437e-bb87-edd623bfa07f",
                                                "sense_id": "7eb3adb7-1e96-3937-91c7-6ec92a794ae8",
                                                "text": "Magnesium brennt mit blendend weißer Flamme."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdf10427-9c70-4840-9a0a-061f83d9a658",
                        "source_entry_id": "fe2fb67a-19ea-31f2-b213-8cdef3561a65",
                        "source_sense_id": "8ed89dba-4d61-39d3-a5df-cd1d4e8760b9",
                        "target_lang_word": "магний",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "магний",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2f3f6023-9e69-3593-bcb0-65c8e3f0b309",
                                        "entry_id": "875661c4-ddbb-3c64-8df2-25551c2a995d",
                                        "glosses": [
                                            "хим. химический элемент с атомным номером 12, обозначается химическим символом Mg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd7cdde9-479c-43ce-8af1-8d3d72e17725",
                                                "sense_id": "2f3f6023-9e69-3593-bcb0-65c8e3f0b309",
                                                "text": "В ржаной муке на треть больше железа, чем в пшеничной, и в два раза больше магния и калия, меньше крахмала и больше пищевых волокон."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ab0a77b-9936-3e3a-9336-3d7e2cfff1e6",
                                        "entry_id": "875661c4-ddbb-3c64-8df2-25551c2a995d",
                                        "glosses": [
                                            "лёгкий, ковкий металл серебристо-белого цвета, состоящий из атомов элемента магния [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d36584a3-ef6b-48e5-9210-37e7c4df5a35",
                                                "sense_id": "3ab0a77b-9936-3e3a-9336-3d7e2cfff1e6",
                                                "text": "Возьмите ленточку магния, привяжите ее к какой-нибудь палочке, подожгите и опустите в кастрюлю, где только что погасла лучинка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3f26910-403e-382e-8750-51a92379d039",
                                        "entry_id": "875661c4-ddbb-3c64-8df2-25551c2a995d",
                                        "glosses": [
                                            "устар. фотовспышка, основанная на сгорании магния [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e8e544-0379-4ffb-9d03-bc80f3f64dda",
                                                "sense_id": "d3f26910-403e-382e-8750-51a92379d039",
                                                "text": "Не переставая, щёлкали фотокамеры; как магний, вспыхивали улыбки."
                                            },
                                            {
                                                "example_id": "42190994-a2b3-4d06-b5c6-32439dab65e6",
                                                "sense_id": "d3f26910-403e-382e-8750-51a92379d039",
                                                "text": "Вдруг совсем близко от нас два или три раза ярко вспыхнул магний: должно быть, среди пассажиров была какая-то знаменитость и для взятого в последний миг интервью понадобился портрет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
