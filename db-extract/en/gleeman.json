                        ],
                        "examples": [
                            {
                                "example_id": "5829dbf0-fe1c-44e3-9456-6fc1b7fee483",
                                "sense_id": "01e4de88-8c62-3976-ad81-22ef73ddb49d",
                                "text": "The ancient Celts carefully distinguished the poet, who was originally a priest and judge as well and whose person was sacrosanct, from the mere gleeman."
                            },
                            {
                                "example_id": "baf3de99-aa66-4cc5-b379-74ae00e97e91",
                                "sense_id": "01e4de88-8c62-3976-ad81-22ef73ddb49d",
                                "text": "“One truth would I set high above all others,” repeated the gleeman."
                            }
                        ]
                    }
