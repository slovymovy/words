                "senses": [
                    {
                        "sense_id": "a69a34b1-f0e9-34ef-b30c-4bf315f5edc2",
                        "entry_id": "9acc1752-109c-33ef-9588-ebaaa19f1f7e",
                        "glosses": [
                            "volle, nach außen gewölbte Backe"
                        ],
                        "tags": [
                            "colloquial",
                            "familiär",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "2c1b62d7-2339-4d6a-b84d-7f5f9eb3db5b",
                                "sense_id": "a69a34b1-f0e9-34ef-b30c-4bf315f5edc2",
                                "text": "„Thomas stopfte sich nun Brotkugeln zwischen Wangen und Zahnfleisch, wodurch er tatsächlich Hamsterbacken bekam.“"
                            },
                            {
                                "example_id": "a14c5881-90a5-487f-9836-69b1bf02635b",
                                "sense_id": "a69a34b1-f0e9-34ef-b30c-4bf315f5edc2",
                                "text": "„Hamsterbacken sind das Markenzeichen von Hamster. … Die Taschen der Hamsterbacken reichen vom Unterkiefer des Tieres bis hinter seine Schulterblätter.“"
                            },
                            {
                                "example_id": "2f06096c-467d-4d0f-9f9c-fdc619949771",
                                "sense_id": "a69a34b1-f0e9-34ef-b30c-4bf315f5edc2",
                                "text": "„Außerdem werden auch runde Pausbacken manchmal als Hamsterbacken bezeichnet, analog zum Hamster mit prall gefüllten Backentaschen.“"
                            },
                            {
                                "example_id": "1a262aed-c822-4ead-bd0e-33a1be9d58a4",
                                "sense_id": "a69a34b1-f0e9-34ef-b30c-4bf315f5edc2",
                                "text": "„Verursacht wird Mumps durch das sogenannte Paramyxovirus parotitis. Deutlich geschwollene »Hamsterbacken« und starke Schmerzen gehen mit der Infektion einher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
