                    {
                        "sense_id": "12310937-dff9-31fe-bc49-b6550e648c5b",
                        "entry_id": "0a6fb0e6-22b6-3060-845a-00913b23d882",
                        "glosses": [
                            "Insecte du genre Longitarsus de la famille des Chrysomelidae caractérisée par des tarses très développés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d9cb0a-7b2b-4cf8-b1b4-6b1d68e18015",
                                "sense_id": "12310937-dff9-31fe-bc49-b6550e648c5b",
                                "text": "Ce longitarse ressemble étonnamment à pusillus ; sa coloration est plus gélatineuse, ses caractères sexuels à peu près nuls, sa ponctuation plus accusée."
                            },
                            {
                                "example_id": "b4f070e7-846e-4dd5-82d7-cc8001d187d7",
                                "sense_id": "12310937-dff9-31fe-bc49-b6550e648c5b",
                                "text": "Les longitarses sont des alticides très-sauteurs, comme l’indique la configuration des pattes postérieures. Les antennes sont plus longues que la moitié du corps, et parfois presque aussi longues que lui chez les mâles."
                            }
                        ]
                    },
                    {
                        "sense_id": "1afc2fd5-d8ee-3468-8b69-24ccfdf5a2d9",
                        "entry_id": "0a6fb0e6-22b6-3060-845a-00913b23d882",
                        "glosses": [
                            "Échassier."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1c91a460-72e1-4d84-9065-de81acf2a66a",
                                "sense_id": "1afc2fd5-d8ee-3468-8b69-24ccfdf5a2d9",
                                "text": "Les longitarses sont les vrais échassiers, les types populaires et classiques de l'ordre."
                            }
                        ]
                    }
