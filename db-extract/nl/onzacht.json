                "senses": [
                    {
                        "sense_id": "bd5adbd5-23a6-348c-b672-daa71701bf46",
                        "entry_id": "3222f200-e7ae-3138-9f05-f89528a96d43",
                        "glosses": [
                            "heel hard, heel ruw en met veel geweld"
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "78955721-00bc-41bb-80c2-545582733c6d",
                                "sense_id": "bd5adbd5-23a6-348c-b672-daa71701bf46",
                                "text": "Paus komt onzacht in aanraking met pausmobiel."
                            },
                            {
                                "example_id": "039b6ea2-b193-4659-bd39-e790f081142e",
                                "sense_id": "bd5adbd5-23a6-348c-b672-daa71701bf46",
                                "text": "Woensdagochtend raakte een 17-jarige fietsster uit Nijverdal rond kwart over acht gewond bij een aanrijding op de kruising Rijssensestraat/Nijkerkendijk. Het meisje botste daar tegen een andere fietser en kwam daardoor onzacht met het asfalt in aanraking. Ze werd ter controle naar het ziekenhuis vervoerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b5d3f42-8fba-4fe6-a474-0005ce4d15d9",
                        "source_entry_id": "3222f200-e7ae-3138-9f05-f89528a96d43",
                        "source_sense_id": "bd5adbd5-23a6-348c-b672-daa71701bf46",
                        "source_sense_description": "(eufemisme) heel hard, heel ruw en met veel geweld",
                        "target_lang_word": "harsh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harsh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0446f7f-b1cb-3861-9ff4-32325b810144",
                                        "entry_id": "38b87a17-f127-332c-8f6a-c1efde06f7f4",
                                        "glosses": [
                                            "Unpleasantly rough to the touch or other senses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "423c1508-d5c0-3900-b3c8-1659a97d2eeb",
                                        "entry_id": "38b87a17-f127-332c-8f6a-c1efde06f7f4",
                                        "glosses": [
                                            "Severe or cruel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d2097d-9505-4bf7-b780-ca62b6e04407",
                                                "sense_id": "423c1508-d5c0-3900-b3c8-1659a97d2eeb",
                                                "text": "harsh decision"
                                            },
                                            {
                                                "example_id": "66328c82-ab00-4c49-a642-147c65bfd5b9",
                                                "sense_id": "423c1508-d5c0-3900-b3c8-1659a97d2eeb",
                                                "text": "harsh penalty"
                                            },
                                            {
                                                "example_id": "b011197c-aa4b-4fac-9e0a-7e9929936288",
                                                "sense_id": "423c1508-d5c0-3900-b3c8-1659a97d2eeb",
                                                "text": "harsh teacher"
                                            },
                                            {
                                                "example_id": "446bbb8d-93f9-4d05-b539-3c29bb8d7b4c",
                                                "sense_id": "423c1508-d5c0-3900-b3c8-1659a97d2eeb",
                                                "text": "harsh rule"
                                            },
                                            {
                                                "example_id": "1992086b-706c-42b3-8013-0269145372db",
                                                "sense_id": "423c1508-d5c0-3900-b3c8-1659a97d2eeb",
                                                "text": "harsh ruling"
                                            },
                                            {
                                                "example_id": "bd950e0a-d159-4d13-bb86-42d685d37327",
                                                "sense_id": "423c1508-d5c0-3900-b3c8-1659a97d2eeb",
                                                "text": "Partly because of the heavy burden of government debt built up during his stewardship, and the uncurbed recklessness of the country’s banks, Britain’s recession is already the harshest in Western Europe."
                                            },
                                            {
                                                "example_id": "e651b9ec-30e7-4849-9ac7-c7daa4e8d500",
                                                "sense_id": "423c1508-d5c0-3900-b3c8-1659a97d2eeb",
                                                "text": "There were harsher comments from Nabil Abu Rudeineh, spokesman for Palestinian president Mahmoud Abbas: \"The negotiations are in a state of paralysis, and the result of Israel's intransigence and America's backpedalling is that there is no hope of negotiations on the horizon.\""
                                            },
                                            {
                                                "example_id": "5859d3d1-6dea-4d4c-9de0-cc44dbe2327c",
                                                "sense_id": "423c1508-d5c0-3900-b3c8-1659a97d2eeb",
                                                "text": "Great news for City, but the result was harsh on Neil Warnock's side who gave as good as they got even though the odds were stacked against them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harsh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7643e7c-0fbf-3d20-97b0-ea75ae63fac4",
                                        "entry_id": "2583cee2-2392-3b68-85ff-d847b4f859d0",
                                        "glosses": [
                                            "To negatively criticize."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61c8f64d-1b8d-41a8-8453-8a145f7cdc94",
                                                "sense_id": "e7643e7c-0fbf-3d20-97b0-ea75ae63fac4",
                                                "text": "Quit harshing me already, I said that I was sorry!"
                                            },
                                            {
                                                "example_id": "f747cacc-487f-46b1-bc32-e75c2eee9a34",
                                                "sense_id": "e7643e7c-0fbf-3d20-97b0-ea75ae63fac4",
                                                "text": "Stop harshing on yourself. Who said you're the ugly sister?"
                                            },
                                            {
                                                "example_id": "54d9d1b5-523e-460c-a6c4-25bd083c9ad8",
                                                "sense_id": "e7643e7c-0fbf-3d20-97b0-ea75ae63fac4",
                                                "text": "“Stop harshing on me, Daddy.” “Harshing?” “Don't yell at me. I didn't do anything.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d3ee90e-0513-38bc-a22a-e9df2e8b5bbf",
                                        "entry_id": "2583cee2-2392-3b68-85ff-d847b4f859d0",
                                        "glosses": [
                                            "To put a damper on (a mood)."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c13f6c39-db52-4dee-8178-231848456f10",
                                                "sense_id": "4d3ee90e-0513-38bc-a22a-e9df2e8b5bbf",
                                                "text": "Dude, you're harshing my buzz."
                                            },
                                            {
                                                "example_id": "a63a9c8e-9a44-498c-9ff5-0e1a0f83f0dd",
                                                "sense_id": "4d3ee90e-0513-38bc-a22a-e9df2e8b5bbf",
                                                "text": "They're always harshing on the plan, but we're still going through with it."
                                            },
                                            {
                                                "example_id": "a2d322eb-3670-4ca8-9bc2-aa26e73e9fe1",
                                                "sense_id": "4d3ee90e-0513-38bc-a22a-e9df2e8b5bbf",
                                                "text": "On their third date, Lizzie had actually said to him, \"You're sort of harshing my mellow.\" It made him wonder if she might be stupid, and not just young."
                                            },
                                            {
                                                "example_id": "b80dbc61-0253-4c7d-b4bf-64f7c60b3a0f",
                                                "sense_id": "4d3ee90e-0513-38bc-a22a-e9df2e8b5bbf",
                                                "text": "\"They're mostly mercenaries these days. But whose?\" \"Serbian mercenaries? You're harshing my groove, man. I'm gonna pretend I didn't hear that....\""
                                            },
                                            {
                                                "example_id": "277ec77d-b7ef-4caf-8dca-857bbb7a6457",
                                                "sense_id": "4d3ee90e-0513-38bc-a22a-e9df2e8b5bbf",
                                                "text": "\"Getting back to the issue of the child,\" Tina said, harshing our buzz as usual, \"I really think you should reconsider....\""
                                            },
                                            {
                                                "example_id": "8dfd940c-c2fc-4282-a754-bee5b594eaa4",
                                                "sense_id": "4d3ee90e-0513-38bc-a22a-e9df2e8b5bbf",
                                                "text": "He's totally harshing my vibe,\" Lila said airily. \"Someone should tell him to get over himself. He's lucky I even invited him!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
