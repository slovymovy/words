                    },
                    {
                        "translation_id": "11417c12-4a23-4afe-8751-aab292cdeac5",
                        "source_entry_id": "0a5157d1-7b40-36d6-beef-aa412c3054ec",
                        "source_sense_id": "aabac7de-6984-3078-90c5-8f5310ec2cf1",
                        "target_lang_word": "allein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9daa6b6-35e4-3059-bf70-47921d3d80aa",
                                        "entry_id": "571e9911-c823-34d6-86ec-3630442146c7",
                                        "glosses": [
                                            "für sich, getrennt, einsam, einzeln sein; nur; ohne Beistand, Zeugen, Anwesenheit von anderen Personen, ohne Hilfe sein"
                                        ],
                                        "tags": [
                                            "als Adjektiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b83e386-8d80-461c-829e-e56925d5232a",
                                                "sense_id": "f9daa6b6-35e4-3059-bf70-47921d3d80aa",
                                                "text": "Bei dieser Unternehmung sind wir allein."
                                            },
                                            {
                                                "example_id": "0394a6af-a0a9-488a-b8ed-d9aac033291e",
                                                "sense_id": "f9daa6b6-35e4-3059-bf70-47921d3d80aa",
                                                "text": "Wir kommen allein."
                                            },
                                            {
                                                "example_id": "8daa9c1a-40fa-4be2-a840-24faac4b67a2",
                                                "sense_id": "f9daa6b6-35e4-3059-bf70-47921d3d80aa",
                                                "text": "Er ist allein einkaufen gegangen."
                                            },
                                            {
                                                "example_id": "9b316dfb-33f0-40d9-b54d-079275b7585d",
                                                "sense_id": "f9daa6b6-35e4-3059-bf70-47921d3d80aa",
                                                "text": "Sie fühlt sich sehr allein."
                                            },
                                            {
                                                "example_id": "76272a17-bb1d-4ff7-9ecc-5ccc4d0121a3",
                                                "sense_id": "f9daa6b6-35e4-3059-bf70-47921d3d80aa",
                                                "text": "Er ist allein auf die Idee gekommen."
                                            },
                                            {
                                                "example_id": "43fa23d3-f1a5-49ca-a1c1-b613ffe114dd",
                                                "sense_id": "f9daa6b6-35e4-3059-bf70-47921d3d80aa",
                                                "text": "„Alex Honnold, der wohl beste Freikletterer der aktuellen Kletterer-Generation hat sich im Sommer 2017 geistig und körperlich auf die Begehung der 975 Meter hohen Route ‚Freerider’ am El Capitan allein und ohne jegliche Hilfsmittel vorbereitet.“"
                                            },
                                            {
                                                "example_id": "e34c7b5b-f763-4bba-91a6-2637bf5c0b26",
                                                "sense_id": "f9daa6b6-35e4-3059-bf70-47921d3d80aa",
                                                "text": "„Und außerdem bin ich davon ausgegangen, dass die anderen das schon von allein tun würden.“"
                                            },
                                            {
                                                "example_id": "18603214-e3c4-490e-96be-8d4fe242d9b2",
                                                "sense_id": "f9daa6b6-35e4-3059-bf70-47921d3d80aa",
                                                "text": "„Allein gelassen werden ist ein Gefühl, dass viele der Befragten teilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62cb5096-656c-3f7e-b458-19b7d1a7c510",
                                        "entry_id": "571e9911-c823-34d6-86ec-3630442146c7",
                                        "glosses": [
                                            "ausschließlich anderer Personen, Gegenstände, Umstände; nur"
                                        ],
                                        "tags": [
                                            "als Adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06bf0311-4446-44e0-9478-ef12ba3aeb56",
                                                "sense_id": "62cb5096-656c-3f7e-b458-19b7d1a7c510",
                                                "text": "„Er allein wird sie umwerben, er allein ihre Leidenschaft befriedigen.“"
                                            },
                                            {
                                                "example_id": "391b3d57-ab33-4484-96d4-6b629d525400",
                                                "sense_id": "62cb5096-656c-3f7e-b458-19b7d1a7c510",
                                                "text": "„Auch die passende Tageszeit ist allein Ihre Entscheidung. Ob morgens, mittags, abends oder alle drei Einheiten gleich nach dem Aufstehen – machen Sie es so, wie es Ihnen am leichtesten fällt.“"
                                            },
                                            {
                                                "example_id": "e65a826f-8720-4bbe-8511-25397b0ab133",
                                                "sense_id": "62cb5096-656c-3f7e-b458-19b7d1a7c510",
                                                "text": "„Schon allein die Idee zur Durchsetzung zu bringen, ist ein starkes Stück für einen Neunjährigen.“"
                                            },
                                            {
                                                "example_id": "8e5ddc21-540d-4da2-8e34-9bd41f2dad0e",
                                                "sense_id": "62cb5096-656c-3f7e-b458-19b7d1a7c510",
                                                "text": "„Ich denke, allein deshalb ist es eine Überlegung wert.“"
                                            },
                                            {
                                                "example_id": "1b40f43a-7d33-42b0-b605-5d81e545b7b7",
                                                "sense_id": "62cb5096-656c-3f7e-b458-19b7d1a7c510",
                                                "text": "„Allein die Geschichte Lydias hatte alle dramatischen und mysteriösen Ingredienzien, die ich von einer Liebe in Jericho erwartete.“"
                                            },
                                            {
                                                "example_id": "65c87e51-b57e-42f3-a635-ee9c412e0dd4",
                                                "sense_id": "62cb5096-656c-3f7e-b458-19b7d1a7c510",
                                                "text": "„Diese in erster Linie von Angst-Lust-Gefühlen geprägte Art, Fallen zu gustieren, ist jedoch nicht allein und durchgängig kennzeichnend für das Fallerleben. Sie ist vornehmlich für den Erstfaller und Neuling des Bungeejumping typisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "allein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e9afb17-d7c9-3bbe-b304-c5ecf9efcb14",
                                        "entry_id": "3fc4e167-5c44-3767-a4b0-ee8c959215c3",
                                        "glosses": [
                                            "aber, doch"
                                        ],
                                        "tags": [
                                            "gehoben",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14f9bc4b-6db0-47b1-bdda-9510bdce8947",
                                                "sense_id": "5e9afb17-d7c9-3bbe-b304-c5ecf9efcb14",
                                                "text": "„[D]ie Botschaft hör’ ich wohl, allein mir fehlt der Glaube.“"
                                            },
                                            {
                                                "example_id": "cf68ef75-2d2c-48d6-9c25-58789c412203",
                                                "sense_id": "5e9afb17-d7c9-3bbe-b304-c5ecf9efcb14",
                                                "text": "„Allein man täte mir unrecht, indem man schlösse, daß ich aufgrund dieser besonderen natürlichen Mitgift zum Lüstling und Weiberhelden geworden sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac2aaaba-3b0e-4b55-99f6-e7a0f397e031",
                        "source_entry_id": "0a5157d1-7b40-36d6-beef-aa412c3054ec",
