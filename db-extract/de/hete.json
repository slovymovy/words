                "senses": [
                    {
                        "sense_id": "89a6d44e-807e-3e89-9a72-a1af25c2bb7f",
                        "entry_id": "acc1568a-591c-31fb-a25d-0f2b587c94bf",
                        "glosses": [
                            "hetty, breeder (heterosexual person)"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "01c26573-46e6-4545-8c90-e4658ae7a8c5",
                                "sense_id": "89a6d44e-807e-3e89-9a72-a1af25c2bb7f",
                                "text": "2000, Johannes Julius Jansen, Jojo: Ich werde berühmt...: Der schwule Alltag ist pure Satire: Ein Jojo Buch, p. 71 (in direct speech)",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "acbd2f4d-bee7-4445-960b-8271f44206c5",
                                "sense_id": "89a6d44e-807e-3e89-9a72-a1af25c2bb7f",
                                "text": "Er zeigt auf Johnny. „Der kleine Lord ist eingeschlafen. Wohl aus Langeweile. Kunst und Kultur interessieren dein Mündel offenbar nicht die Bohne. Ich fürchte, du hast eine Hete adoptiert!“",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "b055975c-4d9f-4744-a675-2c2f1bf0d987",
                                "sense_id": "89a6d44e-807e-3e89-9a72-a1af25c2bb7f",
                                "text": "Ja, viele Heten wollten unbedingt bei uns buchen, weil sie gehört hätten, wie nett es bei uns zugeht und es war manchmal richtig süß zu lesen, was sie alles anführten, um zu zeigen, daß sie mit Schwulen und Lesben kein Problem hatten."
                            },
                            {
                                "example_id": "82a70868-2819-4dc2-8aec-167523c243aa",
                                "sense_id": "89a6d44e-807e-3e89-9a72-a1af25c2bb7f",
                                "text": "Berührungsängste hat sie nicht. Manche Heten denken, dass sich unglückliche Lesben im nächsten Augenblick auf sie stürzen, und bekommen Panik."
                            }
                        ]
                    }
                ],
