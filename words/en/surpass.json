                {
                    "sense_id": "3408f43d-1988-3d21-b5d8-11eb10e70987",
                    "sense_definition": "To go beyond or exceed something in quality, degree, or amount.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exceeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The former student <w>surpassed</w> his instructor's expectations and scored top marks on his examination.",
                            "target_lang_translations": {
                                "ru": "Бывший студент <w>превзошел</w> ожидания своего преподавателя и получил высшие баллы на экзамене.",
                                "zh": "这位学生<w>超过</w>了他导师的预期，在考试中获得了最高分。"
                            }
                        },
                        {
                            "text": "The heavy rains threatened to <w>surpass</w> the capabilities of the levee, endangering the town.",
                            "target_lang_translations": {
                                "ru": "Сильные дожди грозили <w>превысить</w> возможности дамбы, подвергая город опасности.",
                                "zh": "大雨威胁着要<w>超过</w>堤坝的承受能力，使城镇陷入危险之中。"
                            }
                        },
                        {
                            "text": "He became the sixth player to <w>surpass</w> fifty goals this season.",
                            "target_lang_translations": {
                                "ru": "Он стал шестым игроком, <w>преодолевшим</w> отметку в пятьдесят голов в этом сезоне.",
                                "zh": "他成为本赛季第六位进球数<w>超过</w>五十个的球员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exceed",
                        "transcend",
                        "excel",
                        "outdo",
                        "outstrip"
                    ],
                    "antonyms": [
                        "fail",
                        "fall short"
                    ],
                    "common_phrases": [
                        "surpass expectations",
                        "surpass all records",
                        "surpass the limit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть лучше, больше или сильнее чего-либо по качеству, степени или количеству.",
                        "zh": "在质量、程度或数量上超过某事物。"
