                    },
                    {
                        "translation_id": "dcfd7319-ba14-4fe9-8276-dd3355aa5b28",
                        "source_entry_id": "9e71d7f7-dc02-3652-b366-f7ccbac7f261",
                        "source_sense_description": "produced by grating",
                        "target_lang_word": "тёртый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тёртый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fe25df40-1c48-3150-a180-58cfbf0c224a",
                                        "entry_id": "4d7277ed-7743-3f8c-bf1e-9b99b3feb3b3",
                                        "glosses": [
                                            "перен., разг. бывалый, опытный, много видевший и испытавший"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1bc9da4-0fc6-4ea7-9357-3200e17dbbea",
                                                "sense_id": "fe25df40-1c48-3150-a180-58cfbf0c224a",
                                                "text": "— Не волнуйся, — проговорил Базаров, — народ мы тёртый, в городах живали."
                                            },
                                            {
                                                "example_id": "5ec887ee-834f-417d-95f8-a1b7c543c5a3",
                                                "sense_id": "fe25df40-1c48-3150-a180-58cfbf0c224a",
                                                "text": "Человек, видимо, тёртый и, безусловно, в своём деле сведущий."
                                            },
                                            {
                                                "example_id": "adecc655-f34d-48fe-8dc0-c6b6840cb8ca",
                                                "sense_id": "fe25df40-1c48-3150-a180-58cfbf0c224a",
                                                "text": "Среди волнения и потуг малый столбняк этот разразился наконец многочисленными бурными вздохами, а также тщеславным взглядом на себя со стороны, как на бывалого человека, — этакого тёртого дядю, которого теперь трудно удивить чем-нибудь."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "тёртый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7fb8ba49-5def-3abe-889e-f4ea4dff2aeb",
                                        "entry_id": "466f7a53-1337-3271-b601-bde965d480c3",
                                        "glosses": [
                                            "страд. прич. прош. вр. от тереть"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8f03150-9175-4e56-93af-98c367e8fa28",
                                                "sense_id": "7fb8ba49-5def-3abe-889e-f4ea4dff2aeb",
                                                "text": "Достань его, там он лежит, близ покута; гляди только, не опрокинь горшка с тёртым табаком."
                                            },
                                            {
                                                "example_id": "12e2c130-1a6b-43c8-b068-4e9990528541",
                                                "sense_id": "7fb8ba49-5def-3abe-889e-f4ea4dff2aeb",
                                                "text": "Она тотчас повела меня в свою столовую и показала горшок с какою-то белою кашею, вроде тёртого картофеля."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
