                {
                    "sense_id": "76e2d91d-4241-3800-b7ef-0d9ae9f4f644",
                    "sense_definition": "Pretentious, sham, or counterfeit",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's <w>shoddy</w> excuses did little to convince the public of his innocence.",
                            "target_lang_translations": {
                                "ru": "<w>Дешевые</w> оправдания политика мало помогли убедить общественность в его невиновности.",
                                "nl": "De <w>gekunstelde</w> excuses van de politicus overtuigden het publiek nauwelijks van zijn onschuld.",
                                "cs": "Politikovy <w>chabé</w> výmluvy veřejnost o jeho nevině příliš nepřesvědčily."
                            }
                        },
                        {
                            "text": "He tried to pass off a <w>shoddy</w> imitation as a genuine antique.",
                            "target_lang_translations": {
                                "ru": "Он пытался выдать <w>дешевую</w> подделку за подлинный антиквариат.",
                                "nl": "Hij probeerde een <w>nagemaakte</w> imitatie te verkopen als een echt antiekstuk.",
                                "cs": "Pokusil se vydat <w>lacinou</w> napodobeninu za pravou starožitnost."
                            }
                        }
