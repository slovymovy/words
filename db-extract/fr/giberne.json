                                "target_senses": [
                                    {
                                        "sense_id": "8df58fbb-0327-33b4-92aa-9220790e9d54",
                                        "entry_id": "f898a387-f583-3ca4-b509-897458b877e7",
                                        "glosses": [
                                            "tas waarin men munitie bewaart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62486250-ded7-4ac8-8d0c-3a2b847c1b8b",
                                                "sense_id": "8df58fbb-0327-33b4-92aa-9220790e9d54",
                                                "text": "De soldaat was gekleed in een blauwige jas van fabriekslaken, droeg geen ransel en sjako, had een verband om zijn hoofd en een Franse patroontas over zijn schouder."
                                            },
                                            {
                                                "example_id": "9d0c9f32-96d8-4b00-ab58-299626bb1e88",
                                                "sense_id": "8df58fbb-0327-33b4-92aa-9220790e9d54",
                                                "text": "De wagen werd schoongemaakt en mogelijk werden daarbij heel wat vingerafdrukken gewist. In de koffer van de auto werd, naast enkele persoonlijke spullen, een patroontas gevonden vergelijkbaar met de patroontassen van de politie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8f992ac-c9de-46bb-945f-4f40b43ee7e0",
                        "source_entry_id": "cbd1ed52-a808-31e8-8b25-f50a1af7594a",
                        "target_lang_word": "патронта́ш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "патронта́ш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cea9928b-ae8a-3eb0-9da6-d6be9428993d",
                                        "entry_id": "f17af1a9-9a68-30b2-85a0-6f95813559cd",
                                        "glosses": [
                                            "сумка или пояс с гнёздами для патронов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "635ac579-3a39-42e1-89a8-6509099130a4",
                                                "sense_id": "cea9928b-ae8a-3eb0-9da6-d6be9428993d",
                                                "text": "На голове была развалина какой-то шляпы, но ружьё новой системы было игрушечка, и ягдташ и патронташ, хотя истасканные, были наилучшей доброты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6df4101c-2f85-4889-9022-6597627dd0b5",
                        "source_entry_id": "cbd1ed52-a808-31e8-8b25-f50a1af7594a",
                        "target_lang_word": "лядунка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лядунка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5c5aeda8-6bc5-378d-b950-2175c025ed07",
                                        "entry_id": "9afdf2f4-9ce8-3c0c-8d5a-7ae6e4f6a4f4",
                                        "glosses": [
                                            "сумка для патронов на перевязи через плечо у кавалеристов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13152a1-cf9e-42e3-80de-a69c46d06f27",
                                                "sense_id": "5c5aeda8-6bc5-378d-b950-2175c025ed07",
                                                "text": "Через плечо у каждого висел рог с порохом и небольшая лядунка для пуль."
                                            },
                                            {
                                                "example_id": "57849f08-fba2-4d6e-b011-93fa1b4ff57f",
                                                "sense_id": "5c5aeda8-6bc5-378d-b950-2175c025ed07",
                                                "text": "Утром на другой день я оделся в его мундир, надел саблю и кивер и посмотрел в зеркало. Боже мой, как я казался себе хорош в синем куцом мундире с красными выпушками! А этшкеты, а помпон, а лядунка... что с ними в сравнении была камлотовая куртка, которую я носил дома, и жёлтые китайчатые панталоны?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
