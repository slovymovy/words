                    {
                        "translation_id": "0ad51f41-94be-404a-be21-6517a895bb22",
                        "source_entry_id": "c90dc7f2-ac32-3a3d-8c6e-8935ec322924",
                        "source_sense_id": "1edbe097-172c-3c5f-9660-395d083bc63b",
