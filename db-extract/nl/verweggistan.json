                                            {
                                                "example_id": "20c6bb2a-e061-46c5-96e3-82145c3b1e4a",
                                                "sense_id": "647ab448-af15-3ea5-a761-14c35a84e70a",
                                                "text": "Buxtehude liegt in Deutschlands Nordwesten."
                                            },
                                            {
                                                "example_id": "0531d307-f7ba-4a75-86ec-8a14f0b4edbc",
                                                "sense_id": "647ab448-af15-3ea5-a761-14c35a84e70a",
                                                "text": "Ich bin in Buxtehude geboren."
                                            },
                                            {
                                                "example_id": "a605fb93-e58c-42d5-bb95-533a35605471",
                                                "sense_id": "647ab448-af15-3ea5-a761-14c35a84e70a",
                                                "text": "Ich habe in Buxtehude meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "d19013c3-cc90-476d-b85c-2ef3606aae92",
                                                "sense_id": "647ab448-af15-3ea5-a761-14c35a84e70a",
                                                "text": "Nach Buxtehude führen viele Wege."
