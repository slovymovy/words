                },
                {
                    "sense_id": "c2957925-cf18-3445-aa18-aa2f153e40b0",
                    "sense_definition": "zwrócić czyjąś uwagę na dany fakt, problem lub szczegół",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "uwaga",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ekspert w swoim raporcie <w>wskazał</w> na poważne błędy w projekcie budowlanym.",
                            "target_lang_translations": {
                                "ru": "Эксперт в своём отчёте <w>указал</w> на серьёзные ошибки в строительном проекте."
                            }
                        },
                        {
                            "text": "Nauczyciel natychmiast <w>wskazał</w> problem i wyjaśnił uczniom trudne pojęcia.",
                            "target_lang_translations": {
                                "ru": "Учитель сразу же <w>обозначил</w> проблему и объяснил ученикам сложные понятия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wskazać błędy",
                        "wskazać problem",
                        "wskazać na potrzebę"
                    ],
                    "target_lang_definitions": {
                        "ru": "обратить чьё-либо внимание на факт, проблему, ошибку или деталь"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указать",
                                "target_lang_sense_clarification": "на ошибку, проблему, факт"
                            },
                            {
                                "target_lang_word": "отметить",
                                "target_lang_sense_clarification": "обратить внимание на деталь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a186891-bfa1-3275-8629-c44315ec3859",
                    "sense_definition": "stanowić podstawę do wyciągnięcia określonego wniosku; dawać powód do przypuszczeń",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wnioskowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszystkie zebrane dowody jednoznacznie <w>wskazały</w> na winę oskarżonego kierowcy.",
                            "target_lang_translations": {
                                "ru": "Все собранные улики однозначно <w>указали</w> на вину обвиняемого водителя."
                            }
                        },
                        {
                            "text": "Wyniki ostatnich badań laboratoryjnych <w>wskazały</w>, że woda w rzece jest zanieczyszczona.",
                            "target_lang_translations": {
                                "ru": "Результаты последних лабораторных исследований <w>показали</w>, что вода в реке загрязнена."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wyniki wskazały",
                        "badania wskazały",
                        "wskazać na to"
                    ],
                    "target_lang_definitions": {
                        "ru": "послужить основанием для вывода; свидетельствовать о чём-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указать",
                                "target_lang_sense_clarification": "засвидетельствовать, послужить признаком"
                            },
                            {
                                "target_lang_word": "засвидетельствовать",
                                "target_lang_sense_clarification": "о фактах, данных"
                            },
                            {
                                "target_lang_word": "показать",
                                "target_lang_sense_clarification": "выявить в результате анализа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09177faa-de7c-3b6a-b683-85a8fff8be8e",
                    "sense_definition": "sformułować oficjalne zalecenie, wydać polecenie lub rekomendację",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decyzja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz specjalista <w>wskazał</w> operację jako jedyną skuteczną metodę leczenia schorzenia.",
                            "target_lang_translations": {
                                "ru": "Врач-специалист <w>назвал</w> операцию единственным эффективным методом лечения заболевания."
                            }
                        },
                        {
                            "text": "W urzędowym dokumencie wyraźnie <w>wskazano</w> termin złożenia wszystkich niezbędnych wniosków.",
                            "target_lang_translations": {
                                "ru": "В официальном документе был чётко <w>указан</w> срок подачи всех необходимых заявлений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wskazać leczenie",
                        "wskazać termin"
                    ],
                    "target_lang_definitions": {
                        "ru": "официально предписать, назначить или порекомендовать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назначить",
                                "target_lang_sense_clarification": "лечение, срок"
                            },
                            {
                                "target_lang_word": "предписать",
                                "target_lang_sense_clarification": "официально определить меры"
                            },
                            {
                                "target_lang_word": "указать",
                                "target_lang_sense_clarification": "официально обозначить срок или порядок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2106ecde-5081-3317-88c2-ecf5ee929cc0",
                    "sense_definition": "dokonać urzędowego lub prawnego przekazania praw albo mienia",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zgodnie z dawnym prawem dziedzic <w>wskazał</w> majątek swojemu najstarszemu potomkowi.",
                            "target_lang_translations": {
                                "ru": "Согласно старинному праву помещик <w>отписал</w> имение своему старшему потомку."
                            }
                        },
                        {
                            "text": "W testamencie formalnie <w>wskazano</w> dobra ziemskie na rzecz lokalnej fundacji.",
                            "target_lang_translations": {
                                "ru": "В завещании земельные владения были официально <w>отписаны</w> в пользу местного фонда."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "używane rzadko, w kontekstach historycznych lub dawnym języku prawnym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "официально или юридически отписать, завещать или передать права на имущество"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отписать",
                                "target_lang_sense_clarification": "имущество по завещанию, устар."
                            },
                            {
                                "target_lang_word": "завещать",
                                "target_lang_sense_clarification": "передать права на наследство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
