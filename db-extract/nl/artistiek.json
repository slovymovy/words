                "senses": [
                    {
                        "sense_id": "db9a7a80-951b-3fce-ad97-e7d40f4257ae",
                        "entry_id": "537f9182-d969-3084-b245-2d41f3c64c0e",
                        "glosses": [
                            "aanleg hebbend voor het maken van kunst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd76ee44-782b-42e2-ab24-94fce84695d4",
                                "sense_id": "db9a7a80-951b-3fce-ad97-e7d40f4257ae",
                                "text": "De artistieke leraar had al diverse bladen gevuld met illustraties."
                            }
                        ]
                    },
                    {
                        "sense_id": "be82ec23-256e-30b6-a15f-418572561b42",
                        "entry_id": "537f9182-d969-3084-b245-2d41f3c64c0e",
                        "glosses": [
                            "op kunstzinnige manier uitgevoerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e66addf-6eb5-47e6-ba35-fcf606ec0c8e",
                                "sense_id": "be82ec23-256e-30b6-a15f-418572561b42",
                                "text": "Door de artistieke versieringen zag de betonnen wand er minder somber uit."
                            }
                        ]
                    },
                    {
                        "sense_id": "b09eda0b-5f77-34ee-adfa-bd6ec3de691b",
                        "entry_id": "537f9182-d969-3084-b245-2d41f3c64c0e",
                        "glosses": [
                            "met betrekking tot opvattingen over kunst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f314709f-7b30-4c85-9fa8-40014bf46e41",
                                "sense_id": "b09eda0b-5f77-34ee-adfa-bd6ec3de691b",
                                "text": "De samenwerking is door een artistiek meningsverschil beëindigd."
                            },
                            {
                                "example_id": "cb80622a-01bb-4f14-9405-815b82b4ef14",
                                "sense_id": "b09eda0b-5f77-34ee-adfa-bd6ec3de691b",
                                "text": "Sjarel Ex stopt komend najaar als directeur van het Rotterdamse museum Boijmans Van Beuningen. Ex is sinds 2004 artistiek en zakelijk eindverantwoordelijke bij het museum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e643aa72-9ad5-4b62-b6ff-0437643c5968",
                        "source_entry_id": "537f9182-d969-3084-b245-2d41f3c64c0e",
                        "source_sense_id": "db9a7a80-951b-3fce-ad97-e7d40f4257ae",
                        "source_sense_description": "aanleg hebbend voor het maken van kunst",
                        "target_lang_word": "artistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artistic",
