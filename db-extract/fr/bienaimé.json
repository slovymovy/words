                ],
                "translations": [
                    {
                        "translation_id": "30e8d11b-9b3e-401a-9a20-2c621db192a2",
                        "source_entry_id": "37c61f53-296f-316a-9119-947f2a84e65c",
                        "source_sense_id": "784bc05c-a25f-353a-a72c-ebb50e34b596",
                        "target_lang_word": "Liebling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liebling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5958922-2f89-3d90-93bd-d3042a7b39f4",
                                        "entry_id": "a4ff6177-f258-30ed-a97a-1131a3b59395",
                                        "glosses": [
                                            "Kosename und Anrede für einen geliebten Menschen, aber auch für ein bestimmtes, besonders geliebtes Tier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac1a2650-de6a-47ac-b81e-fe56bdc8ecaf",
                                                "sense_id": "f5958922-2f89-3d90-93bd-d3042a7b39f4",
                                                "text": "Manche Hundebesitzer ziehen ihrem Liebling Stiefelchen und Regencape über."
                                            },
                                            {
                                                "example_id": "aadf6c9b-8c39-4549-bf24-afdafe170320",
                                                "sense_id": "f5958922-2f89-3d90-93bd-d3042a7b39f4",
                                                "text": "Komm Liebling, sei mein Liebling."
                                            },
                                            {
                                                "example_id": "1e91ffce-4c59-4e48-9013-778a7d4891a7",
                                                "sense_id": "f5958922-2f89-3d90-93bd-d3042a7b39f4",
                                                "text": "Liebling, mein Herz läßt dich grüßen!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "66f831ef-db5c-3277-8802-d78aa2cfefe3",
                                        "entry_id": "a4ff6177-f258-30ed-a97a-1131a3b59395",
                                        "glosses": [
                                            "eine geschätzte, beliebte Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70591995-6ef6-4393-aed8-efcc096568f4",
                                                "sense_id": "66f831ef-db5c-3277-8802-d78aa2cfefe3",
                                                "text": "Liebt denn die Lieblingin aller Männer auch nur genau den Liebling aller Fraun?"
                                            },
                                            {
                                                "example_id": "1ab51f24-01ac-4e96-90e1-1b9599c0f08e",
                                                "sense_id": "66f831ef-db5c-3277-8802-d78aa2cfefe3",
                                                "text": "Der strohblonde Schauspieler ist der Liebling des Publikums."
                                            },
                                            {
                                                "example_id": "9a9fcc00-54ce-4731-a4ad-d45f246ee201",
                                                "sense_id": "66f831ef-db5c-3277-8802-d78aa2cfefe3",
                                                "text": "Auf dem Höhepunkt ihrer Karriere war sie der Liebling der Nation."
                                            },
                                            {
                                                "example_id": "ad080f21-85ed-4bd3-88a4-130deef185f0",
                                                "sense_id": "66f831ef-db5c-3277-8802-d78aa2cfefe3",
                                                "text": "Das Walrossbaby war der Liebling aller Besucher."
                                            },
                                            {
                                                "example_id": "542702ef-6012-4dc5-9f4e-b35eb8bb41c9",
                                                "sense_id": "66f831ef-db5c-3277-8802-d78aa2cfefe3",
                                                "text": "„Da ich eine ganz besondere Zuneigung für die Tiere empfand, beglückten mich meine Eltern gern mit allerlei Lieblingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "43abd35f-287b-3669-a115-6f76e210d4c4",
                                        "entry_id": "a4ff6177-f258-30ed-a97a-1131a3b59395",
                                        "glosses": [
                                            "eine von einflussreichen Instanzen, Institutionen, Personen oder Ähnlichem bevorzugte Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc242411-d205-4567-b94a-029ff20f17b0",
                                                "sense_id": "43abd35f-287b-3669-a115-6f76e210d4c4",
                                                "text": "Jetzt gilt es, auch die Lieblinge des gestürzten Diktators zu beseitigen!"
                                            },
                                            {
                                                "example_id": "ff0938fa-645a-472b-a0e1-9d7941444d28",
                                                "sense_id": "43abd35f-287b-3669-a115-6f76e210d4c4",
                                                "text": "Man sagte über ihn, er sei ein Liebling des Kaisers."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
