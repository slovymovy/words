                                    {
                                        "sense_id": "6fb49ac1-530e-321b-9bbe-e09c7cfca625",
                                        "entry_id": "a05789dc-a965-31bf-a630-6019d092ca9f",
                                        "glosses": [
                                            "degene die of het bedrijf dat vervuilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b27761-7b25-4c31-b69a-bab6f9df53cd",
                                                "sense_id": "6fb49ac1-530e-321b-9bbe-e09c7cfca625",
                                                "text": "het principe moet zijn: de vervuiler betaalt"
                                            },
                                            {
                                                "example_id": "b2e54a73-164c-40bb-84f7-afa31b751652",
                                                "sense_id": "6fb49ac1-530e-321b-9bbe-e09c7cfca625",
                                                "text": "Het Wereld Natuur Fonds (WNF) zegt dat het in Madrid aan de politieke wil ontbrak om ‘iets aan de klimaatverandering te doen’. “De onderhandelingen werden gegijzeld door de grootste vervuilers,” doelt WNF in een verklaring op een aantal landen als China, de Verenigde Staten, India en Brazilië."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37acce4a-8b30-43cf-a522-6bef22c36e65",
                        "source_entry_id": "3179f272-d106-3a47-b59d-a559392ecbba",
                        "source_sense_id": "81bf857a-d49c-3ba4-8709-d42bdc5b95d2",
                        "source_sense_description": "something that pollutes",
                        "target_lang_word": "polluant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polluant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6363d57-4d55-3e05-985d-2a5d4894a221",
                                        "entry_id": "a36a68df-fe9f-34d9-997d-cb50fdcbaefe",
                                        "glosses": [
                                            "Qui pollue, qui souille ou dénature l’environnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17c0801f-810a-4775-bf3a-c4f3a97a0da4",
                                                "sense_id": "e6363d57-4d55-3e05-985d-2a5d4894a221",
                                                "text": "On utilise sans vergogne l’arrière-pays, du moins sa partie non protégée, non mise en réserve pour accueillir des décharges intempestives, les fûts toxiques, les activités polluantes et les ayatollahs de l'écologie."
                                            },
                                            {
                                                "example_id": "43b57a88-1e48-4abf-b69c-bff672e9061e",
                                                "sense_id": "e6363d57-4d55-3e05-985d-2a5d4894a221",
                                                "text": "Encore un truc made in China, avec des colorants polluants, importés en cargos, pour un événement climaticide complètement inutile en plein effondrement climatique, se désole Marie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polluant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf6e9aa2-796a-3bb9-9e4d-f860b58f6c05",
                                        "entry_id": "6d7090ea-8584-3ce9-9bb5-11dc37117307",
                                        "glosses": [
                                            "Substance qui pollue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65138d2-171e-45bf-a5ff-357f98e312c5",
                                                "sense_id": "bf6e9aa2-796a-3bb9-9e4d-f860b58f6c05",
                                                "text": "Les propriétés physico-chimiques du polluant influencent fortement son devenir dans la lithosphère."
                                            },
                                            {
                                                "example_id": "9a4648c8-5828-43b9-b4a1-a14f2df5aa33",
                                                "sense_id": "bf6e9aa2-796a-3bb9-9e4d-f860b58f6c05",
                                                "text": "Un appareil surdimensionné fonctionne le plus souvent au ralenti, tirage fermé. Il s’encrasse, ses émissions de polluants augmentent, et il est soumis à une forte corrosion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polluant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6048f7d5-6708-3ac3-a788-c59d69b7bc75",
                                        "entry_id": "3a78f3ae-267f-3375-9c0e-6af3b27b3bf5",
                                        "glosses": [
                                            "Participe présent de polluer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a177e06f-ff06-4144-9699-7c50acf43be3",
                        "source_entry_id": "3179f272-d106-3a47-b59d-a559392ecbba",
                        "source_sense_id": "81bf857a-d49c-3ba4-8709-d42bdc5b95d2",
                        "source_sense_description": "something that pollutes",
                        "target_lang_word": "Schadstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schadstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                        "entry_id": "8412e246-1cf9-3e15-80e6-38779b98f287",
                                        "glosses": [
                                            "chemischer Stoff, der ab einem bestimmten Ausmaß der Natur schadet"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94bef9f3-58d7-4036-bb3d-c40d17e65f90",
                                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                                "text": "Durch den Bau von sehr vielen Kläranlagen und die Abkoppelung der Industrie wurden sämtliche Flüsse in Deutschland von der weiteren Einleitung von Schadstoffen befreit."
                                            },
                                            {
                                                "example_id": "bc5cbda3-f23e-404f-9a7f-93de643f1264",
                                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                                "text": "Die ungebremste Abgabe der Schadstoffe an die Luft hat dazu geführt, dass wir ernsthaft über ein Ozonloch diskutieren und gar verwundert sind, wenn Wind und Wetter durcheinander geraten."
                                            },
                                            {
                                                "example_id": "43d7dc77-4ca8-451e-98fb-a60e5432b0de",
                                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                                "text": "„Die Forschungsanstalt für Forst- und Holzwirtschaft habe aufgrund seines Materials eine Studie über die waldschädigenden industriellen Schadstoffe erarbeitet; mit Fotos von kranken Bäumen.“"
                                            },
                                            {
                                                "example_id": "2d8316ef-d99f-4b6c-ac36-e54bd93b4746",
                                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                                "text": "„Die Schadstoffe gelangen unter anderem durch Industrieabfälle in Boden und Wasser.“"
                                            },
                                            {
                                                "example_id": "37eeb519-c8aa-44f4-be6e-5a3fa82b7231",
                                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                                "text": "„Eine neue Studie hat gezeigt, dass Schadstoffe in Boden und Wasser einen erheblichen Einfluss auf unsere Gesundheit haben können.“"
                                            },
                                            {
                                                "example_id": "24be066c-dfc5-476f-89b8-5c26f83b356a",
                                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                                "text": "„Nehmen wir die Schadstoffe dann mit der Nahrung auf, könnte das erhebliche Folgen für unser Herz-Kreislauf-System haben.“"
                                            },
                                            {
                                                "example_id": "2d33b7b4-232b-4602-a612-8628929ef269",
                                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                                "text": "[…] „Blei [ist] der bedenklichste Schadstoff, der in Boden und Wasser vorkommt.“"
                                            },
                                            {
                                                "example_id": "57dff1da-8416-4c60-bf9c-2b489b0074a4",
                                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                                "text": "„Wer den Anteil der Schadstoffe reduzieren will, muss deshalb auch die Landwirte überzeugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
