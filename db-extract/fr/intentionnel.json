                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1b02fe2-b651-3083-b6f5-e9b908927bf4",
                        "entry_id": "c2d93a37-e4e9-33d3-8cbc-b2c7a970270b",
                        "glosses": [
                            "Relatif à l’intention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe3931a4-f98e-40f2-9962-db6e3fd04158",
                                "sense_id": "d1b02fe2-b651-3083-b6f5-e9b908927bf4",
                                "text": "L’idée d’une sépulture intentionnelle est donc d’emblée refusée, malgré la présence d’une vingtaine de cyprées d’origine méditerranéenne disposées par paire à divers endroits du corps, […]."
                            },
                            {
                                "example_id": "397b05e9-363c-4873-918d-2c2b32c65210",
                                "sense_id": "d1b02fe2-b651-3083-b6f5-e9b908927bf4",
                                "text": "Travailler auprès d’enfants victimes d’événements traumatiques nous apprend combien les répercussions psychiques sont différentes lorsque les blessures ont été causées de façon intentionnelle, qu’elles ont duré, qu’elles ont été commises par des adultes faisant autorité et censés les protéger."
                            },
                            {
                                "example_id": "d8dc1bdd-d5f9-42c0-96a1-e6ec36f2e12d",
                                "sense_id": "d1b02fe2-b651-3083-b6f5-e9b908927bf4",
                                "text": "Plus le réchauffement climatique se rend visible à travers diverses catastrophes naturelles, plus la communauté complotiste s’empare de la question de la modification intentionnelle du climat. Pourtant, derrière les théories farfelues des illuminés du web, modifier le climat est une science bien réelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8320ebd1-dc6c-4edd-8afb-5d2da0b7f9db",
                        "source_entry_id": "c2d93a37-e4e9-33d3-8cbc-b2c7a970270b",
                        "source_sense_id": "d1b02fe2-b651-3083-b6f5-e9b908927bf4",
                        "source_sense_description": "Qui appartient à l’intention",
                        "target_lang_word": "vorsätzlich",
