                                                "sense_id": "f7926329-5e1a-3be3-9e89-378b06fe65d9",
                                                "text": "malgrado alcuni piccoli litigi, ho trascorso una buona infanzia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dba5b88-5dce-3920-a42b-01f4ea878c54",
