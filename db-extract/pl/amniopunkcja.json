                "senses": [
                    {
                        "sense_id": "afc21c36-9940-3509-89bd-27903a45de66",
                        "entry_id": "d3a0ca25-6b00-3a0d-ae4c-00d2d30ea5f6",
                        "glosses": [
                            "inwazyjne badanie prenatalne, diagnostyczny zabieg medyczny polegający na nakłuciu pęcherza płodowego (owodni) w celu pobrania próbki płynu owodniowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053bda7a-649b-49b6-bcdb-004ecaf294b7",
                                "sense_id": "afc21c36-9940-3509-89bd-27903a45de66",
                                "text": "Zabieg amnipunkcji wykonuje się pod kontrolą USG."
                            },
                            {
                                "example_id": "8d1da957-b21d-4502-9501-7e1be09982d0",
                                "sense_id": "afc21c36-9940-3509-89bd-27903a45de66",
                                "text": "Mało którą pacjentkę stać na amniopunkcję za ponad 1000 zł w prywatnym szpitalu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b483d903-254d-43ac-975a-c71be8cdfed5",
                        "source_entry_id": "d3a0ca25-6b00-3a0d-ae4c-00d2d30ea5f6",
                        "source_sense_id": "afc21c36-9940-3509-89bd-27903a45de66",
                        "target_lang_word": "amniocentesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amniocentesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10943873-fa3c-3a6e-9af8-4b2c19a2c847",
                                        "entry_id": "badc273d-7ce2-338d-a0e9-17847e57c9db",
                                        "glosses": [
                                            "A procedure for obtaining amniotic fluid from a pregnant animal, by inserting a hollow needle through the abdominal wall and into the amniotic sac. Used in diagnosing possible genetic defects and/or obstetric complications, or simply to drain excess amniotic fluid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4493ce5-b3a3-43c7-962d-f59113be7616",
                                                "sense_id": "10943873-fa3c-3a6e-9af8-4b2c19a2c847",
                                                "text": "In most countries amniocentesis is now offered to – perhaps even imposed on – all older mothers, to check whether the foetus carries an extra chromosome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fae2a0cf-6b2d-45e0-82e0-33b37975bda3",
                        "source_entry_id": "d3a0ca25-6b00-3a0d-ae4c-00d2d30ea5f6",
                        "source_sense_id": "afc21c36-9940-3509-89bd-27903a45de66",
                        "target_lang_word": "amniocentesi",
