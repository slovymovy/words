                                        "entry_id": "c0d5ec8e-fcb8-350c-a09e-17f0d3ac016b",
                                        "glosses": [
                                            "The Greek goddess of the hunt, wild animals, and wilderness; the daughter of Leto and Zeus; the sister of Apollo. (Compare Diana.)"
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
