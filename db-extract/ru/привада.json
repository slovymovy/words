                        "glosses": [
                            "разг. приманка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05b36ec7-9eec-4796-9ebd-dbc3ca8836b6",
                                "sense_id": "efc19a53-7cfc-384b-992f-c6c23235443d",
                                "text": "А приваду маманя варила? - сипло спросил он, выходя за отцом в сенцы."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dc07f8a-c075-3080-8553-fd54ff608c68",
                        "entry_id": "59140545-f8d5-321b-a6d3-177a1fde8fb3",
                        "glosses": [
                            "место, где кладётся приманка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ab7d272-52dc-425b-8310-e493924a4db3",
                                "sense_id": "9dc07f8a-c075-3080-8553-fd54ff608c68",
                                "text": "Это необходимо ввиду того, что медведь, раз попробовав мяса, устраивает свое логово в недалеком расстоянии от привады, особенно если это медведица с детьми."
                            }
                        ]
                    }
