        "fr-extract.jsonl": [
            {
                "entry_id": "9ef088d6-abfd-3a8c-a92d-59df336501ff",
                "word": "CDI",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1adba66d-a0fd-3413-8a05-442dc6f66c56",
                        "entry_id": "9ef088d6-abfd-3a8c-a92d-59df336501ff",
                        "glosses": [
                            "Contrat à durée indéterminée, type de contrat de travail en France."
                        ],
                        "tags": [
                            "Droit du travail",
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "fc0f7c51-d40f-4aa6-90d7-e031c214aaf5",
                                "sense_id": "1adba66d-a0fd-3413-8a05-442dc6f66c56",
                                "text": "Si le CDI est encore plébiscité pour souscrire un contrat immobilier, « la majorité des jeunes ne peuvent plus acheter, déplore Yadi. Alors quel intérêt ? »."
                            },
                            {
                                "example_id": "9a0cd5bf-39cb-48f1-9531-b310e579321b",
                                "sense_id": "1adba66d-a0fd-3413-8a05-442dc6f66c56",
                                "text": "En y arrivant, j’avais découvert la règle : on pouvait faire deux cents jours de travail annuel, ensuite on dégageait, sinon la boîte risquait les prud’hommes et la requalification des CDD en CDI."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bb4d35a-385e-342c-8fe0-8d8caf0d1cf2",
                        "entry_id": "9ef088d6-abfd-3a8c-a92d-59df336501ff",
                        "glosses": [
                            "Bibliothèque d'un collège et d'un lycée français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b57031da-2c2d-44ed-9264-c5cb1cd31b59",
                                "sense_id": "9bb4d35a-385e-342c-8fe0-8d8caf0d1cf2",
                                "text": "Pour que chacun puisse travailler ou lire et pour que chacun puisse passer un agréable moment, le CDI doit rester un lieu calme."
                            }
                        ]
                    }
                ],
