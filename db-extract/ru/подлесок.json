                        ]
                    },
                    {
                        "translation_id": "46bbd958-e21e-4f2f-9bf4-88014679e62b",
                        "source_entry_id": "bda07951-4370-3513-9396-20ad49fa8a72",
                        "source_sense_id": "c0c26b08-3a53-31d0-9ca3-187d4e79cb24",
                        "target_lang_word": "Unterholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterholz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0298dffe-64e5-3f7d-b137-10d6450a08a6",
                                        "entry_id": "d03f3751-2a98-36df-bec4-0f752cb8880b",
                                        "glosses": [
                                            "das unter den Kronen großer Bäume niedrig wachsende Gehölz"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eacaf04a-8d7a-4282-b2c3-6b86319f4849",
                                                "sense_id": "0298dffe-64e5-3f7d-b137-10d6450a08a6",
                                                "text": "„Heute wird jedoch immer öfter bewusst Verjüngung als Unterholz angepflanzt, da so die jungen Bäume im Schutz der alten Bäume heranwachsen können und kein Kahlschlag entsteht, wenn die alten Bäume geerntet werden“."
                                            },
                                            {
                                                "example_id": "1c595362-b712-4594-847f-f84db4cc882d",
                                                "sense_id": "0298dffe-64e5-3f7d-b137-10d6450a08a6",
                                                "text": "„Ich hörte die anderen in meiner Nähe durchs Unterholz brechen, dazu die Rufe der Soldaten und immer wieder Schüsse.“"
                                            },
                                            {
                                                "example_id": "66d40e76-77d6-4f28-8a32-a32b8567d05c",
                                                "sense_id": "0298dffe-64e5-3f7d-b137-10d6450a08a6",
                                                "text": "„Er war erst hastig seitwärts in den Wald gegangen und dann gelaufen, und schließlich hatte er sich ins Unterholz geworfen, als die Lungen keinen Atem mehr hergaben.“"
                                            },
                                            {
                                                "example_id": "e73bd7e3-e8c3-435d-a788-af10515380ae",
                                                "sense_id": "0298dffe-64e5-3f7d-b137-10d6450a08a6",
                                                "text": "„Schweifende Indianer, nach mißlungenem Überfall auf weiter ostwärts abgelegene Siedlungen versprengt und desto rachsüchtiger, waren auf die sorglose Spur der Deutschen gestoßen, hatten sie verfolgt und im dichten Unterholz still umflügelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
