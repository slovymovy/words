                ],
                "senses": [
                    {
                        "sense_id": "fed849c6-1f0b-38f0-874c-dbb213b293ea",
                        "entry_id": "28171ec4-664d-3650-bdab-2d7e1074e78e",
                        "glosses": [
                            "wiederholte spöttische Äußerungen gegenüber jemandem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71529802-3d2f-4fb1-8045-c9eaaae859da",
                                "sense_id": "fed849c6-1f0b-38f0-874c-dbb213b293ea",
                                "text": "„Ellbogenmentalität und strukturierte Hänseleien bestimmten den Arbeitsalltag.“"
                            },
                            {
                                "example_id": "1c9ed3a6-943f-4b5a-a92b-df37d2300b51",
                                "sense_id": "fed849c6-1f0b-38f0-874c-dbb213b293ea",
                                "text": "„Diese gegenseitige Hänselei der Kantone nimmt kein Ende.“"
                            },
                            {
                                "example_id": "5fab8326-b97b-4b18-8ed0-68dfb328d476",
                                "sense_id": "fed849c6-1f0b-38f0-874c-dbb213b293ea",
                                "text": "„Zwei oder drei Mal griff er noch ein, dann hörten die Hänseleien und Schikanen der anderen Kinder auf.“"
                            },
                            {
                                "example_id": "b33fbc6d-dfe7-4faa-a748-0af69128dfe5",
                                "sense_id": "fed849c6-1f0b-38f0-874c-dbb213b293ea",
                                "text": "„Das trug ihnen Hänseleien ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
