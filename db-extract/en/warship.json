                    {
                        "translation_id": "4c51a135-c724-4193-85ef-c94ba7d9534c",
                        "source_entry_id": "721fd804-6a0f-3bd9-b9fe-5eafc4ff6b57",
                        "source_sense_description": "ship built or armed for naval combat",
                        "target_lang_word": "Kriegsschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kriegsschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff1ab49-873f-3e73-8bad-17d0ca73fd20",
                                        "entry_id": "dd2045bb-8d74-3ca3-bd41-6fb25287447a",
                                        "glosses": [
                                            "Schiff einer Kriegsmarine, das im Krieg eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbba4d09-7435-4a41-81a3-f126d794b056",
                                                "sense_id": "8ff1ab49-873f-3e73-8bad-17d0ca73fd20",
                                                "text": "Die „Bismarck“ war ein großes deutsches Kriegsschiff."
                                            },
                                            {
                                                "example_id": "6745382c-5768-48f6-960f-725e522c1144",
                                                "sense_id": "8ff1ab49-873f-3e73-8bad-17d0ca73fd20",
                                                "text": "„Die britischen Kriegsschiffe waren in den Hafen zurückgekehrt.“"
                                            },
                                            {
                                                "example_id": "bdb25490-4214-443b-a575-9da7a93ce050",
                                                "sense_id": "8ff1ab49-873f-3e73-8bad-17d0ca73fd20",
                                                "text": "„Alle hatten Befehl, einen der von Kriegsschiffen stark bewachten Geleitzüge unserer Gegner anzugreifen, mit denen die Alliierten Kriegsmaterial aus den USA nach Europa beförderten.“"
                                            },
                                            {
                                                "example_id": "b93164f7-b8c4-4bf5-b6e7-991d0c58abe7",
                                                "sense_id": "8ff1ab49-873f-3e73-8bad-17d0ca73fd20",
                                                "text": "„Aber als richtige Kriegsschiffe und einsatzfähige Besatzungen konnte man sie eigentlich nicht ansehen.“"
                                            },
                                            {
                                                "example_id": "8f58fd99-0607-4b51-ab4d-f7926349f56b",
                                                "sense_id": "8ff1ab49-873f-3e73-8bad-17d0ca73fd20",
                                                "text": "„Ich begleitete ihn auf drei oder vier Fahrten und wuchs zu einem großen, kräftigen Burschen heran; da kaperte uns auf der Heimfahrt von der Neufundlandbank ein algerischer Seeräuber oder ein Kriegsschiff.“"
                                            },
                                            {
                                                "example_id": "231768ae-123e-4d56-873e-21c9383f776c",
                                                "sense_id": "8ff1ab49-873f-3e73-8bad-17d0ca73fd20",
                                                "text": "„1000 Jahre lang wird es keiner anderen europäischen Kultur gelingen, Segler zu konstruieren, die schneller unterwegs sind als die Kriegsschiffe der Wikinger, die Drachenboote.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66fb9d8f-7a4b-407d-89f9-816846ca6423",
                        "source_entry_id": "721fd804-6a0f-3bd9-b9fe-5eafc4ff6b57",
                        "source_sense_description": "ship built or armed for naval combat",
                        "target_lang_word": "Kampfschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kampfschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fa64b16-b313-32a8-a815-b7065df41498",
                                        "entry_id": "901d15ec-230b-3c32-a555-d59a520a3bdd",
                                        "glosses": [
                                            "Schiff, das für militärische Einsätze vorgesehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d464b046-4204-44da-9bc2-2da069073ee9",
                                                "sense_id": "6fa64b16-b313-32a8-a815-b7065df41498",
                                                "text": "„Anders als Kampfschiffe sind Hilfsschiffe nicht in die Liste der Kriegsschiffe eingetragen; […]“"
                                            },
                                            {
                                                "example_id": "7b689407-5bf9-4a13-8adc-815d62855935",
                                                "sense_id": "6fa64b16-b313-32a8-a815-b7065df41498",
                                                "text": "„Mit dem MSK 180 soll die Bundeswehr ein zeitgemäßes Kampfschiff bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
