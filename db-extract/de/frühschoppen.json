                "senses": [
                    {
                        "sense_id": "11cecf06-2e19-3780-a40d-85d294efcb78",
                        "entry_id": "e2a95cb4-f9b7-3bd1-8ccc-16fdfc3c91f8",
                        "glosses": [
                            "geselliges, traditionelles Beisammensein und gemeinsames Essen und Trinken am Vormittag meist begleitet von einer Musikgruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bae5b220-ba44-4abb-aa63-c5bec0b75746",
                                "sense_id": "11cecf06-2e19-3780-a40d-85d294efcb78",
                                "text": "Am Sonntag gehen wir zum Frühschoppen."
                            },
                            {
                                "example_id": "d1d1ba18-5db1-40f7-bf89-c69d213d3769",
                                "sense_id": "11cecf06-2e19-3780-a40d-85d294efcb78",
                                "text": "„Er hat eine nette, hilfsbereite Nachbarschaft, trifft sich seit vierzig Jahren mit seinen Freunden sonntags zum Frühschoppen und wurde als Vorstandsmitglied des Turnvereins zur großen Europa-Kreisel-Eröffnung sogar persönlich eingeladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
