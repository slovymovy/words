                                "target_senses": [
                                    {
                                        "sense_id": "09cc4201-7e68-3018-a4f4-9ed91aa338ff",
                                        "entry_id": "69a67eee-0195-3e0a-bb61-53074f6f01b8",
                                        "glosses": [
                                            "eilandengroep in de Atlantische Oceaan, een overzees gebied van het Verenigd Koninkrijk en een bekend belastingparadijs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "071f73a8-0aca-4eda-90aa-abd5518255ea",
                                                "sense_id": "09cc4201-7e68-3018-a4f4-9ed91aa338ff",
                                                "text": "Google heeft in 2017 bijna 20 miljard euro via Nederland naar belastingparadijs Bermuda gesluisd via een legale – maar zeer omstreden – truc. Dat schrijft het FD op basis van onlangs gedeponeerde stukken bij de Kamer van Koophandel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "441f8852-2710-3bfe-804e-ff5d075df443",
                                        "entry_id": "69a67eee-0195-3e0a-bb61-53074f6f01b8",
                                        "glosses": [
                                            "grootste eiland van de gelijknamige eilandengroep"
                                        ],
                                        "tags": [
                                            "toponiem: eiland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc02114d-c977-42ee-b835-19ff83fb9ee2",
                                                "sense_id": "441f8852-2710-3bfe-804e-ff5d075df443",
                                                "text": "Hoewel orkaan Gonzalo flink heeft huisgehouden op Bermuda, is het Britse eiland ontsnapt aan een ramp."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61d04e7d-d054-46a9-8a5c-bb1a2169c725",
                        "source_entry_id": "a5c39d7b-4aad-3814-8be7-2b8e902b8542",
                        "source_sense_id": "2fff1bf3-907d-3edd-94a8-53b087d8d130",
                        "source_sense_description": "island group",
                        "target_lang_word": "Bermudes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
