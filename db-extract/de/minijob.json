                ],
                "senses": [
                    {
                        "sense_id": "4173367b-0b5d-3475-97f5-2327bf085450",
                        "entry_id": "454b6425-420b-3222-be10-df8ca3266c4d",
                        "glosses": [
                            "Job, der ein bestimmtes Gehalt nicht übersteigt (meist bis zur steuerfreien Grenze) und/oder Job, der auf bestimmte Tage oder Stunden begrenzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0132bf2e-335f-4479-bc5b-c5c163628f8e",
                                "sense_id": "4173367b-0b5d-3475-97f5-2327bf085450",
                                "text": "Bei einem Minijob arbeitet man beispielsweise 60 Stunden im Monat, also 15 Stunden pro Woche und dann meist an einem Tag acht Stunden und an einem 7 Stunden."
                            },
                            {
                                "example_id": "6c5a59bf-7d73-4fb6-8224-36f00a127475",
                                "sense_id": "4173367b-0b5d-3475-97f5-2327bf085450",
                                "text": "„Die einen verdienen 15 Millionen Euro im Jahr, andere kommen mit drei Minijobs kaum über die Runden.“"
                            },
                            {
                                "example_id": "ecd4724c-a71a-4ee5-bfa0-d795a4df1804",
                                "sense_id": "4173367b-0b5d-3475-97f5-2327bf085450",
                                "text": "„Die Senioren haben oft Minijobs und tragen beispielsweise Zeitungen aus oder sitzen am Empfang und übernehmen Telefondienste.“"
                            },
                            {
                                "example_id": "fea96388-bc64-4df3-a0d5-33c9743e117d",
                                "sense_id": "4173367b-0b5d-3475-97f5-2327bf085450",
                                "text": "„Minijobbern begegnet man überall: Zeitungsausträger, Verkäuferinnen, Pizzaboten - für maximal 450 Euro monatlich arbeiten fast sieben Millionen Menschen auf Minijob-Basis in fast allen Bereichen.“"
                            },
                            {
                                "example_id": "932cfe23-6003-4c7e-b313-4f2417d4afee",
                                "sense_id": "4173367b-0b5d-3475-97f5-2327bf085450",
                                "text": "„Zu [den Erwerbstätigen] zählen neben Arbeitern und Angestellten beispielsweise auch Beamte, Selbständige oder Leute mit Minijob.“"
                            },
                            {
                                "example_id": "b57ead63-0521-4206-a5ac-2f76439b6133",
                                "sense_id": "4173367b-0b5d-3475-97f5-2327bf085450",
                                "text": "„Knapp die Hälfte der geringfügig Beschäftigten mit einem Minijob als Haupterwerbsquelle soll [nach eine Studie der gewerkschaftsnahen Hans-Böckler-Stiftung] weniger als [den Mindestlohn von] 8,50 Euro brutto die Stunde bekommen.“"
                            },
                            {
                                "example_id": "11cf48c5-d587-4901-83be-0fa05604c82e",
                                "sense_id": "4173367b-0b5d-3475-97f5-2327bf085450",
                                "text": "Oft sind es Rentner, Hausfrauen oder Studenten, die sich etwas dazuverdienen. Viele müssen aber auch von einem oder zwei Minijobs leben."
                            },
                            {
                                "example_id": "e9edb25a-7481-47d2-b60c-5faa9dbc89a9",
                                "sense_id": "4173367b-0b5d-3475-97f5-2327bf085450",
                                "text": "„Zwei Vereine in Bremerhaven, die sich angeblich um Integration kümmerten, haben Zuwanderer nach Deutschland geschleust und in Minijobs beschäftigt.“"
                            },
                            {
                                "example_id": "ffdb3de3-c2f0-40db-80e8-b1923f479dcd",
                                "sense_id": "4173367b-0b5d-3475-97f5-2327bf085450",
                                "text": "„Es gibt ja viele bei uns, die das nur als Neben- oder Minijob machen. Aber kein Mensch will immer nur so arbeiten!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
