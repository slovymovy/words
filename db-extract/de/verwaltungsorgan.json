                        "examples": [
                            {
                                "example_id": "a6fe88ac-9d23-4f87-874a-ae726bba829a",
                                "sense_id": "c407e5cc-5fab-35c3-b45d-2d4658400106",
                                "text": "„Sie unterhielt Privatarmeen mit Tausenden von Söldnern, und ihre Verwaltungsorgane ließen so gut wie keine lokale Autonomie zu.“"
                            },
                            {
                                "example_id": "5012341c-4c93-4478-abb8-cb724061c6c1",
                                "sense_id": "c407e5cc-5fab-35c3-b45d-2d4658400106",
                                "text": "„2004 setzte die Regierung diese schließlich ab und richtete neue zentralstaatliche Verwaltungsstrukturen ein; auch auf dem Land wurden alle dezentralen Verwaltungsorgane entmachtet und der Zentralregierung unterstellt.“"
                            }
                        ],
