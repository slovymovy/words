                {
                    "sense_id": "8f7700af-0334-35f5-a296-ede5dc71b8c4",
                    "sense_definition": "Répandre dans toutes les directions de la lumière, de la chaleur, une odeur ou des informations.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "propagation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La lampe de chevet <w>diffuse</w> une lumière douce et agréable dans la chambre.",
                            "target_lang_translations": {
                                "en": "The bedside lamp <w>diffuses</w> a soft, pleasant light throughout the bedroom.",
                                "ru": "Прикроватная лампа <w>рассеивает</w> мягкий и приятный свет по спальне.",
                                "de": "Die Nachttischlampe <w>strahlt</w> ein sanftes, angenehmes Licht im Schlafzimmer <w>aus</w>.",
                                "es": "La lámpara de la mesilla de noche <w>difunde</w> una luz suave y agradable en el dormitorio.",
                                "zh": "床头灯在卧室里<w>散发</w>出柔和舒适的光。"
                            }
                        },
                        {
                            "text": "Le journal s'efforce de <w>diffuser</w> une information claire et vérifiée auprès des citoyens.",
                            "target_lang_translations": {
                                "en": "The newspaper strives to <w>disseminate</w> clear, verified information to citizens.",
                                "ru": "Газета стремится <w>распространять</w> ясную и проверенную информацию среди граждан.",
                                "de": "Die Zeitung bemüht sich, klare und überprüfte Informationen an die Bürger zu <w>verbreiten</w>.",
                                "es": "El periódico se esfuerza por <w>difundir</w> una información clara y verificada entre los ciudadanos.",
                                "zh": "这家报纸努力向市民<w>传播</w>清晰可靠、经过核实的信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "répandre",
                        "propager",
                        "disperser"
                    ],
                    "antonyms": [
                        "concentrer"
                    ],
                    "common_phrases": [
                        "diffuser de la lumière",
                        "diffuser une odeur",
                        "diffuser une information",
                        "diffuser des idées"
                    ],
                    "target_lang_definitions": {
                        "en": "To spread light, heat, a smell or information out in all directions.",
                        "ru": "Распространять свет, тепло, запах или информацию во всех направлениях.",
                        "de": "In alle Richtungen verteilen, etwa Licht, Wärme, einen Geruch oder Informationen.",
                        "es": "Extender en todas direcciones luz, calor, olor o información.",
                        "zh": "向四面八方散发光、热、气味，或传播信息。"
                    },
