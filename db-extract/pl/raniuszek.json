                        "source_sense_id": "b05cfbbf-9e93-3f48-b400-dcc5a92843e7",
                        "target_lang_word": "mésange à longue queue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mésange à longue queue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67d09590-ecaa-3a2d-91a7-a00799e86d95",
                                        "entry_id": "65306189-cd4c-3536-9cb4-c67a9827fbf6",
                                        "glosses": [
                                            "Espèce de très petit oiseau passereau d'Eurasie, mésange à très longue queue, à la tête blanche et grise et au ventre blanc légèrement rosé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28bc4c4f-1280-4b29-bba6-eae83bf14803",
                                                "sense_id": "67d09590-ecaa-3a2d-91a7-a00799e86d95",
                                                "text": "La mésange à longue queue est un petit passereau caractéristique des lisières forestières."
                                            },
                                            {
                                                "example_id": "4d466a7c-6131-440d-8e51-01088994e78c",
                                                "sense_id": "67d09590-ecaa-3a2d-91a7-a00799e86d95",
                                                "text": "En boisement mixte, on trouve : mésanges nonettes au niveau des branches, mésanges à longue queue et mésanges bleues sur les rameaux, mésanges noires sur les feuilles, les mésanges charbonnières étant encore au sol."
                                            },
                                            {
                                                "example_id": "88265b07-4977-46b0-9cba-dd54e4cba52f",
                                                "sense_id": "67d09590-ecaa-3a2d-91a7-a00799e86d95",
                                                "text": "Alors, elle prenait à témoin la pie-grièche cachée dans l’aubépine ou la mésange à longue queue qui penchait la tête pour l’écouter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
