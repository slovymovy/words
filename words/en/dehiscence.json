{
    "word_family": [
        "dehisce",
        "dehiscent",
        "indehiscent",
        "indehiscence"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee9380b6-1489-3e8a-9cbf-47885e4e3905",
                    "sense_definition": "The spontaneous rupture or reopening of a previously closed surgical wound, often accompanied by fluid discharge.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient had to return to the operating room due to acute wound <w>dehiscence</w>.",
                            "target_lang_translations": {
                                "ru": "Пациенту пришлось вернуться в операционную из-за острого <w>расхождения краев раны</w>."
                            }
                        },
                        {
                            "text": "Poor nutrition and excessive physical strain can significantly increase the risk of surgical <w>dehiscence</w>.",
                            "target_lang_translations": {
                                "ru": "Плохое питание и чрезмерные физические нагрузки могут значительно повысить риск <w>расхождения послеоперационных швов</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rupture"
                    ],
                    "common_phrases": [
                        "wound dehiscence",
                        "surgical dehiscence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спонтанный разрыв или расхождение краев ранее ушитой хирургической раны, часто сопровождающийся выделениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расхождение",
                                "target_lang_sense_clarification": "краев раны или шва"
                            },
                            {
                                "target_lang_word": "раскрытие",
                                "target_lang_sense_clarification": "хирургической раны"
                            },
                            {
                                "target_lang_word": "дегисценция",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "981abda4-3cfc-3ec6-82e8-14dc16c7a03f",
                    "sense_definition": "The natural bursting open of a plant organ, such as a fruit, anther, or seed pod, at maturity to release its contents.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warm and dry weather accelerates the <w>dehiscence</w> of seed pods across the field.",
                            "target_lang_translations": {
                                "ru": "Теплая и сухая погода ускоряет <w>растрескивание</w> семенных коробочек по всему полю."
                            }
                        },
                        {
                            "text": "Botanists study anther <w>dehiscence</w> to better understand the timing of pollen release.",
                            "target_lang_translations": {
                                "ru": "Ботаники изучают <w>вскрывание</w> пыльников, чтобы лучше понять сроки высвобождения пыльцы."
                            }
                        }
                    ],
                    "antonyms": [
                        "indehiscence"
                    ],
                    "common_phrases": [
                        "anther dehiscence",
                        "pod dehiscence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественное вскрытие органа растения (плода, пыльника или семенной коробочки) при созревании для освобождения содержимого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растрескивание",
                                "target_lang_sense_clarification": "плодов или семенных коробочек"
                            },
                            {
                                "target_lang_word": "вскрывание",
                                "target_lang_sense_clarification": "органов растения при созревании"
                            },
                            {
                                "target_lang_word": "дегисценция",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2ae3397-6494-31e6-b2c5-202ed62556c2",
                    "sense_definition": "The action of opening widely, splitting, or gaping.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>dehiscence</w> of the dry soil revealed a network of deep fissures.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>растрескивание</w> сухой почвы обнажило сеть глубоких трещин."
                            }
                        },
                        {
                            "text": "Geologists observed the <w>dehiscence</w> along the fault line following the tremor.",
                            "target_lang_translations": {
                                "ru": "Геологи наблюдали <w>расщепление</w> вдоль линии разлома после подземных толчков."
                            }
                        }
                    ],
                    "synonyms": [
                        "gaping",
                        "opening"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкое раскрытие, расщепление или зияние (поверхности, земли и т. д.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расщепление",
                                "target_lang_sense_clarification": "образование трещин или разломов"
                            },
                            {
                                "target_lang_word": "зияние",
                                "target_lang_sense_clarification": "широкое раскрытие трещины или щели"
                            },
                            {
                                "target_lang_word": "растрескивание",
                                "target_lang_sense_clarification": "образование щелей на поверхности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}