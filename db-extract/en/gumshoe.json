                    {
                        "translation_id": "027958f2-4a9c-422b-af1e-22082afc40ef",
                        "source_entry_id": "d47af488-d86c-3b69-bc80-94bb67604298",
                        "source_sense_description": "slang: a detective",
                        "target_lang_word": "Schnüffler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
