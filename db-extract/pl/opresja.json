                ],
                "senses": [
                    {
                        "sense_id": "06876481-b245-349d-a1c1-7c54c1d598cc",
                        "entry_id": "ea351faf-45fd-3e6c-95f3-77e5dd6a707e",
                        "glosses": [
                            "trudna sytuacja"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4549c954-07e3-474d-9dbb-fadb2d0ce42b",
                                "sense_id": "06876481-b245-349d-a1c1-7c54c1d598cc",
                                "text": "Wreszcie Buffalo Bill wybawił przyjaciela z opresji, ogłaszając wszem i wobec, że Nick[…] posiada 5 żon"
                            },
                            {
                                "example_id": "1d5fa1e2-066e-4f61-ba3a-2afa3e2417fd",
                                "sense_id": "06876481-b245-349d-a1c1-7c54c1d598cc",
                                "text": "Lokalista znowu wyszedł obronną ręką z opresji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49cc865f-789f-4e0d-ad72-1ab106612555",
                        "source_entry_id": "ea351faf-45fd-3e6c-95f3-77e5dd6a707e",
                        "source_sense_id": "06876481-b245-349d-a1c1-7c54c1d598cc",
                        "target_lang_word": "oppression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oppression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e298c771-79a1-392d-99e9-75f51b85ace1",
                                        "entry_id": "59f5644c-284c-3bda-ae88-79b3922c9716",
                                        "glosses": [
                                            "The exercise of authority or power in a burdensome, cruel, or unjust manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "683ec9fb-1535-4771-8c34-72aa06e20f61",
                                                "sense_id": "e298c771-79a1-392d-99e9-75f51b85ace1",
                                                "text": "Oh, by what plots, by what forswearings, betrayings, oppressions, imprisonments, tortures, poisonings, and under what reasons of state and politic subtilty, have these forenamed kings […] pulled the vengeance of God upon themselves […]"
                                            },
                                            {
                                                "example_id": "ea19a154-a256-44be-be3c-d7137587295e",
                                                "sense_id": "e298c771-79a1-392d-99e9-75f51b85ace1",
                                                "text": "\"Tibet challenges the conscience of the world,\" I told the audience at a gathering outside the town's main temple. \"If freedom-loving people throughout the world do not speak out against China's oppression in China and Tibet, we have lost all moral authority to speak on behalf of human rights anywhere in the world.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf83d21f-d682-34c5-b27f-0245f46fc20c",
                                        "entry_id": "59f5644c-284c-3bda-ae88-79b3922c9716",
                                        "glosses": [
                                            "The act of oppressing, or the state of being oppressed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41bad48a-bdf0-4523-aa74-0e2c1a1f595e",
                                                "sense_id": "cf83d21f-d682-34c5-b27f-0245f46fc20c",
                                                "text": "Extreme freedom is followed by extreme oppression, said Plato."
                                            },
                                            {
                                                "example_id": "662d42b9-b31e-44d9-8444-037e3ea8c67f",
                                                "sense_id": "cf83d21f-d682-34c5-b27f-0245f46fc20c",
                                                "text": "We're choosing to use \"anti-Jewishness\" [rather than \"anti-Semitism\"] in recognition of the separate experiences and different oppressions of other peoples who also claim the name of \"Semite.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15e92a4d-4741-3c33-b879-a32b6c3c402f",
                                        "entry_id": "59f5644c-284c-3bda-ae88-79b3922c9716",
                                        "glosses": [
                                            "A feeling of being oppressed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33e64bf3-1efa-426d-9163-4ade560c36a6",
                                                "sense_id": "15e92a4d-4741-3c33-b879-a32b6c3c402f",
                                                "text": "Our oppression was lifted by the reappearance of the sun."
                                            },
                                            {
                                                "example_id": "24afe788-b5ab-41fe-8e6c-5af07a985706",
                                                "sense_id": "15e92a4d-4741-3c33-b879-a32b6c3c402f",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80e21c13-ab35-4677-beda-8bd77a2773e2",
                        "source_entry_id": "ea351faf-45fd-3e6c-95f3-77e5dd6a707e",
                        "source_sense_id": "06876481-b245-349d-a1c1-7c54c1d598cc",
                        "target_lang_word": "útlak",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bbd7c092-d25c-4179-828f-6e3dde750307",
                        "source_entry_id": "ea351faf-45fd-3e6c-95f3-77e5dd6a707e",
                        "source_sense_id": "06876481-b245-349d-a1c1-7c54c1d598cc",
                        "target_lang_word": "útisk",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4db30395-da5c-4ff4-a72f-824839f8e9bf",
                        "source_entry_id": "ea351faf-45fd-3e6c-95f3-77e5dd6a707e",
                        "source_sense_id": "06876481-b245-349d-a1c1-7c54c1d598cc",
                        "target_lang_word": "oppression",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oppression",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19849baf-ad7b-3f61-a313-21de6f890123",
                                        "entry_id": "1a3e5f75-4bf0-3ee5-aff5-91678130e7ab",
                                        "glosses": [
                                            "Action d’opprimer et état de ce qui est opprimé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea517c1f-86c0-480c-83c8-65783028c0bd",
                                                "sense_id": "19849baf-ad7b-3f61-a313-21de6f890123",
                                                "text": "À peine l’indépendance de l’Amérique du Nord fut-elle proclamée, la paix conclue avec l’ancienne métropole, que ces hommes qui criaient si haut à la tyrannie, à l’oppression, qui réclamaient contre la violation du droit des gens, dont, disaient-ils, ils étaient victimes, organisèrent avec cet implacable sang-froid qu’ils tiennent de leur origine une chasse aux Indiens."
                                            },
                                            {
                                                "example_id": "f228ddc5-d045-4b60-bf57-ef2fa35ff1bc",
                                                "sense_id": "19849baf-ad7b-3f61-a313-21de6f890123",
                                                "text": "Le cas de la société tibétaine d’avant 1950 illustre de façon tragique les lacunes d’une idéologie dogmatique bouddhiste gérée par de faillibles humains. Elle a conduit à une société féodale esclavagiste basée sur l’oppression de presque toute la population par les hiérarchies religieuse et aristocratique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e1af497-f6cd-3af4-a970-b3cefa178353",
                                        "entry_id": "1a3e5f75-4bf0-3ee5-aff5-91678130e7ab",
                                        "glosses": [
                                            "Action d’opprimer et état de ce qui est opprimé.",
                                            "Domination systémique ou violence exercée par un groupe social ou une institution sur un autre groupe, entraînant discrimination ou exclusion."
                                        ],
                                        "tags": [
                                            "Science politique",
                                            "Études féministes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2f45c87-3813-3d22-ba24-44c1caf24fed",
                                        "entry_id": "1a3e5f75-4bf0-3ee5-aff5-91678130e7ab",
                                        "glosses": [
                                            "État de ce qui est oppressé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41e15426-dc87-4e35-81a7-149980d61640",
                                                "sense_id": "e2f45c87-3813-3d22-ba24-44c1caf24fed",
                                                "text": "Oppression de poitrine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73dc61b1-3708-32f5-88cb-a4cf085b9350",
                                        "entry_id": "1a3e5f75-4bf0-3ee5-aff5-91678130e7ab",
                                        "glosses": [
                                            "Influence négative du diable ou de ses démons sur une personne, pour la couper de Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d5312e-6d33-46b2-af64-e79a99aed5d3",
                                                "sense_id": "73dc61b1-3708-32f5-88cb-a4cf085b9350",
                                                "text": "L'oppression diabolique est un malaise récurrent. Nous devons nous rappeler que les symptômes et la gravité varient considérablement au cas par cas. Elle peut frapper la santé, le travail, les affections, les relations avec les autres, et ainsi de suite. Ses symptômes comprennent la rage inexplicable et une tendance à l'isolement. Elle peut affecter à la fois l'individuel et les groupes"
                                            },
                                            {
                                                "example_id": "64a977ee-e5fe-4790-9e14-9fdfac868ffa",
                                                "sense_id": "73dc61b1-3708-32f5-88cb-a4cf085b9350",
                                                "text": "Il y a beaucoup plus d'infestations, d'oppressions ou d'obsessions qu'on ne le croit et beaucoup moins de possessions qu'on ne l'imagine"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76d9cf91-1f88-4b78-bfa6-b742edac6595",
                        "source_entry_id": "ea351faf-45fd-3e6c-95f3-77e5dd6a707e",
                        "source_sense_id": "06876481-b245-349d-a1c1-7c54c1d598cc",
                        "target_lang_word": "Unterdrückung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterdrückung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d68628a2-405a-3f9e-906b-9d70f061787f",
                                        "entry_id": "4437cf48-0c6e-3580-a6e9-d2e01026b6ad",
                                        "glosses": [
                                            "Verhinderung eines Geschehens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06c28aaf-0aab-4f10-90b9-e0148eeca20e",
                                                "sense_id": "d68628a2-405a-3f9e-906b-9d70f061787f",
                                                "text": "„ Als leidenschaftlicher Gegner von ‚Demokratie‘, Liberalismus u. nationalen Strömungen schuf er ein konservatives, vornehmlich, auf den Polizeiapparat und die Zensur (Sedlnitzky) gestütztes Regime, als dessen einzige Ziele die Erhaltung der staatlichen Ordnung von 1815 und die Unterdrückung jeder revolutionären Bewegung anzusehen sind.“"
                                            },
                                            {
                                                "example_id": "096c9479-311d-4d91-8df3-8fb4dc9c4235",
                                                "sense_id": "d68628a2-405a-3f9e-906b-9d70f061787f",
                                                "text": "„Darum konnte es den Herausgeber in keiner Weise überraschen, daß diese Prophezeiung an ihm selber in Erfüllung gieng; die Unterdrückung des Blattes hatte ihn nicht befremdet, er hatte sie sogar aus Gründen allgemeiner Billigkeit sich selbst entschuldigt.“"
                                            },
                                            {
                                                "example_id": "b5c5c9a3-a846-4711-b7be-f1d1e11e1583",
                                                "sense_id": "d68628a2-405a-3f9e-906b-9d70f061787f",
                                                "text": "„Die im Mittelohr befindliche Luft, die ja normalerweise durch den Schluckakt eine ständige Erneuerung erfährt, jedoch beim Tauchen durch die natürliche Unterdrückung des Schluckreflexes, in der Paukenhöhle eingeschlossen bleibt, verhindert nun selbst bei einreißender, oder schon vorher perforierter Membrana tympani ein Eindringen von Wasser.“"
                                            },
                                            {
                                                "example_id": "d5dd65e5-82c0-4c17-889e-d3761788a53e",
                                                "sense_id": "d68628a2-405a-3f9e-906b-9d70f061787f",
                                                "text": "„Die Prohibition, Sumners Tugendwächtertrupp, die Feindseligkeit gegenüber den Immigranten, die Unterdrückung von anarchistischen und anderen »ausländischen« Ideen – all das waren aus Sylvias Sicht Aspekte ein und desselben grundsätzlichen Problems in Amerika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a839849a-5959-37de-9396-2e49c6f5be5f",
                                        "entry_id": "4437cf48-0c6e-3580-a6e9-d2e01026b6ad",
                                        "glosses": [
                                            "starke Benachteiligung von Personen(gruppen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dc8154e-f4a6-4e57-a808-af57f4de8113",
                                                "sense_id": "a839849a-5959-37de-9396-2e49c6f5be5f",
                                                "text": "„Dies mündete in eigenständige Bürgerrechtsbewegungen, die sich gegen Rassismus bzw. rassistische Unterdrückung und soziale Benachteiligungen zur Wehr setzten.“"
                                            },
                                            {
                                                "example_id": "0f3457f3-ca05-4ae0-918b-98587392dd35",
                                                "sense_id": "a839849a-5959-37de-9396-2e49c6f5be5f",
                                                "text": "„So zeigen der Regisseur und sein Kostümbildner Ingo Krügler die Protagonisten als eine chic gekleidete Oberschicht, in der Gewalt und Unterdrückung herrschen.“"
                                            },
                                            {
                                                "example_id": "bebbfcdb-61aa-4cbf-a5d1-da51304f5172",
                                                "sense_id": "a839849a-5959-37de-9396-2e49c6f5be5f",
                                                "text": "„Nach dem Zweiten Weltkrieg hoffen Menschen überall in Afrika auf das Ende der Unterdrückung durch die Kolonialmächte, auch viele Kenianer schöpfen Mut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
