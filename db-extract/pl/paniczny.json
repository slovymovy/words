                                "target_senses": [
                                    {
                                        "sense_id": "caf060fd-0cea-3ff3-9841-26fc496ce342",
                                        "entry_id": "0d348a8e-b11c-33f7-a936-515740999bf4",
                                        "glosses": [
                                            "In a state of panic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9158848-02d5-4e29-9b0f-9f3f646c4fc8",
                                                "sense_id": "caf060fd-0cea-3ff3-9841-26fc496ce342",
                                                "text": "At six feet the panicky thought rushed into my mind, What if he will not run? Why, then I shall club him, came the answer. In my fear I had forgotten that I was there to get the bull instead of to make him run. And just then he gave a snort and a snarl and rushed at me."
                                            },
                                            {
                                                "example_id": "4854ed6b-8c43-48f4-9603-7f356af1b422",
                                                "sense_id": "caf060fd-0cea-3ff3-9841-26fc496ce342",
                                                "text": "Banning the king from Cop27 looks clumsy. News that Sunak could make a U-turn dash to Egypt having learned that Johnson may go looks panicky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
