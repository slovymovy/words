                "senses": [
                    {
                        "sense_id": "08aaee0a-f99c-311a-b45c-b326c0f48816",
                        "entry_id": "a3fb48a5-d76c-3303-973b-82de65d34a55",
                        "glosses": [
                            "van iets of iemand dat het met roet bedekt is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9579c2c-d28d-45a5-9654-1802b44b42b4",
                                "sense_id": "08aaee0a-f99c-311a-b45c-b326c0f48816",
                                "text": "Venus schuift als een zwarte stip voor de zon langs tijdens zonsopkomst. Een unieke gebeurtenis, maar niet zonder gevaar voor de mensen die thuis even willen kijken. „Je moet niet kijken door een beroet glaasje of een cd. Die laten uv-straling en infrarood door."
                            },
                            {
                                "example_id": "04a4748f-c53b-4405-ade9-e42749532622",
                                "sense_id": "08aaee0a-f99c-311a-b45c-b326c0f48816",
                                "text": "Beroete bakstenen schoonmaken kan tijdens het stoken. Gooi hiertoe voorzichtig enkele eetlepels zout in het laaiende vuur. Dit helpt om het roet los te maken terwijl het vuur brandt. Het roet zal samen met de rest van de rook door de schoorsteen verdwijnen."
                            },
                            {
                                "example_id": "73eb070e-fdb8-48c4-a42d-c2681c0d610c",
                                "sense_id": "08aaee0a-f99c-311a-b45c-b326c0f48816",
                                "text": "Ze verhuisde naar een beroet huisje onder de aanvliegroute van een vliegveld in L.A., werd door haar dokters mismeesterd en kampte met steeds zwaardere rugproblemen."
                            }
                        ]
                    }
