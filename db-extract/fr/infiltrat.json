                "senses": [
                    {
                        "sense_id": "9e1ef6a7-91b7-3e44-a8d8-7dc8fe8f6dd2",
                        "entry_id": "49555726-e509-3891-a96d-6af98da45407",
                        "glosses": [
                            "Accumulation de cellules par infiltration pathologique dans un tissu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c7d47f4-314a-485e-9da8-d85899ca8185",
                                "sense_id": "9e1ef6a7-91b7-3e44-a8d8-7dc8fe8f6dd2",
                                "text": "L’angio-IRM montre un infiltrat péri-carotidien gauche."
                            },
                            {
                                "example_id": "cc27c54e-a646-491d-8aef-b261f5d14852",
                                "sense_id": "9e1ef6a7-91b7-3e44-a8d8-7dc8fe8f6dd2",
                                "text": "\"Lorsque la peau s’étire de manière trop importante, il y a un infiltrat de cellules inflammatoires qui vont grignoter le tissu élastique et le collagène de la peau\" indique le Dr Nina Roos, dermatologue."
                            },
                            {
                                "example_id": "c40a6482-35c2-4a86-8821-3f874ac51a55",
                                "sense_id": "9e1ef6a7-91b7-3e44-a8d8-7dc8fe8f6dd2",
                                "text": "Peu avant ce passage, un autre extrait évoque le \"niveau cardiaque\": \"A signaler au niveau cardiaque, la présence d’un infiltrat lymphocytaire interstitiel sans nécrose pouvant témoigner de lésions de myocardite a minima et pouvant expliquer la symptomatologie de Monsieur Beltra dans les jours précédents son décès. …\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba33f5d1-e62e-3076-b275-dc852fd8af47",
                        "entry_id": "49555726-e509-3891-a96d-6af98da45407",
                        "glosses": [
                            "En radiologie, opacité observée sur une image pulmonaire et qui correspond souvent à une infiltration pathologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7f31244-85c1-4dd5-a5e0-ab93a272d098",
                                "sense_id": "ba33f5d1-e62e-3076-b275-dc852fd8af47",
                                "text": "Les scans, relayés par nos confrères du Daily Mail, montrent en effet des taches blanches dans les coins inférieurs des poumons, indiquant ce que les radiologues appellent un infiltrat en verre dépoli – un remplissage partiel des petits espaces dans les poumons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9400ea8e-21e3-40e5-82cb-4327847566f7",
                        "source_entry_id": "49555726-e509-3891-a96d-6af98da45407",
                        "source_sense_id": "9e1ef6a7-91b7-3e44-a8d8-7dc8fe8f6dd2",
                        "source_sense_description": "Infiltration de cellules",
                        "target_lang_word": "infiltrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infiltrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2575db1-2bfb-3a00-bb3a-c344b39e14f7",
                                        "entry_id": "8b3ebc1d-42d6-3b78-b8b4-5c11d486e83a",
                                        "glosses": [
                                            "To surreptitiously penetrate, enter or gain access to."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f6eefa7-09fd-40fe-a896-5550d0e82df9",
                                                "sense_id": "c2575db1-2bfb-3a00-bb3a-c344b39e14f7",
                                                "text": "The spy infiltrated the high-tech company and stole many secrets."
                                            },
                                            {
                                                "example_id": "22b5eb03-985d-4923-8d24-153f94f917c7",
                                                "sense_id": "c2575db1-2bfb-3a00-bb3a-c344b39e14f7",
                                                "text": "Caithness was infiltrated with a palpable sense of being underimagined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae242da-11e0-3cf0-9eb8-48684be22d7f",
                                        "entry_id": "8b3ebc1d-42d6-3b78-b8b4-5c11d486e83a",
                                        "glosses": [
                                            "To cause to penetrate in this way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "211e455c-bb2f-48ef-a55f-689f5b7dab02",
                                                "sense_id": "cae242da-11e0-3cf0-9eb8-48684be22d7f",
                                                "text": "The agency infiltrated several spies into the company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10c3f852-8b82-3e70-9245-b3312cc92e7a",
                                        "entry_id": "8b3ebc1d-42d6-3b78-b8b4-5c11d486e83a",
                                        "glosses": [
                                            "To pass through something by filtration."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4dd2cd1f-857c-357f-8a89-16fd3eea5bc6",
                                        "entry_id": "8b3ebc1d-42d6-3b78-b8b4-5c11d486e83a",
                                        "glosses": [
                                            "To cause (a liquid) to pass through something by filtration."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e2a1d52-85e8-3516-abc4-4cf8993b1b4d",
                                        "entry_id": "8b3ebc1d-42d6-3b78-b8b4-5c11d486e83a",
                                        "glosses": [
                                            "To invade or penetrate a tissue or organ."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f47e885a-2894-46b2-b5a0-4219c30afc1a",
                                                "sense_id": "4e2a1d52-85e8-3516-abc4-4cf8993b1b4d",
                                                "text": "High-grade tumors often infiltrate surrounding structures."
                                            },
                                            {
                                                "example_id": "5d64ac94-5054-41e5-a71d-a391ed374bd9",
                                                "sense_id": "4e2a1d52-85e8-3516-abc4-4cf8993b1b4d",
                                                "text": "In certain conditions, immune cells may infiltrate into the cerebrospinal fluid."
                                            },
                                            {
                                                "example_id": "b1cba28e-058b-45b4-88fa-6fbf4a78fb6c",
                                                "sense_id": "4e2a1d52-85e8-3516-abc4-4cf8993b1b4d",
                                                "text": "Plesner et al. reported the nonbeta islet endocrine cell remodeling in diabetic NOD mice: that study suggested that infiltrating immune cells may restrict alpha-cell expansion in NOD mouse islet in the diabetic state [ 36 ]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c807a204-eacb-3aa0-ab97-44dea12ebea3",
                                        "entry_id": "8b3ebc1d-42d6-3b78-b8b4-5c11d486e83a",
                                        "glosses": [
                                            "To send (soldiers, spies, etc.) through gaps in the enemy line."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6d5f39c-b1dc-3ac2-969a-02a06784b969",
                                        "entry_id": "8b3ebc1d-42d6-3b78-b8b4-5c11d486e83a",
                                        "glosses": [
                                            "To move from a vein, remaining in the body."
