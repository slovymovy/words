                    },
                    {
                        "sense_id": "f192721d-98b4-379a-904c-5648447b103f",
                        "entry_id": "1e997e77-2613-3ff8-8976-9baa9e23507b",
                        "glosses": [
                            "de keer dat de politie een ruimte onderzoekt zonder dat hiervoor toestemming door de eigenaar of de bewoner is gegeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83921e09-db36-473a-956e-e1ceef2ca4f1",
                                "sense_id": "f192721d-98b4-379a-904c-5648447b103f",
                                "text": "Het is onbekend of er nog andere verdachten zijn aangehouden. In verband met de vondst deed de politie een inval in een woning van een ex-lid van de Hells Angels, die zich inmiddels heeft aangesloten bij de motorclub Bandidos. Bij die doorzoeking is niets bijzonders gevonden, zegt de politie."
                            },
                            {
                                "example_id": "8574e964-f323-45e6-8b3b-1fbe689e20dd",
                                "sense_id": "f192721d-98b4-379a-904c-5648447b103f",
                                "text": "Ook de woning van de vrouw in Vianen is doorzocht. Splinter denkt dat media van tevoren over die doorzoeking zijn getipt, omdat er een filmploeg bij aanwezig was."
                            }
                        ]
                    }
