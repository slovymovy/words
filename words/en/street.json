                },
                {
                    "sense_id": "80ef8ea4-b3c3-3824-9735-056eb1431ff6",
                    "sense_definition": "Living or occurring outdoors in a city, often referring to homeless people or stray animals.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "urban_life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity provides food and shelter for <w>street</w> children in the city center.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация предоставляет еду и кров <w>беспризорным</w> детям в центре города."
                            }
                        },
                        {
                            "text": "We found a <w>street</w> cat shivering in the cold and decided to take it home.",
                            "target_lang_translations": {
                                "ru": "Мы нашли <w>уличную</w> кошку, дрожащую от холода, и решили забрать ее домой."
                            }
