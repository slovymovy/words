                    {
                        "translation_id": "e1dffb73-1da0-46bf-9b37-ab586269ad62",
                        "source_entry_id": "588bad6f-7755-31f3-b336-9c7df1449233",
                        "source_sense_id": "1ffcc57b-cf9b-37bb-bfad-f2e1640c7366",
                        "source_sense_description": "spelwoord voor de letter s",
                        "target_lang_word": "Samuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Samuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a4a7531-fcb6-3f46-8090-dbd937d6402c",
                                        "entry_id": "0a9bc7af-d085-34a7-bac5-63ed4edfcc6a",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c41c9ee4-d4cb-48e8-9e25-c9714b6c6a0a",
                                                "sense_id": "4a4a7531-fcb6-3f46-8090-dbd937d6402c",
                                                "text": "It was quite unnecessary to call Samuel Weller; for Samuel Weller stepped briskly into the box the instant his name was pronounced; and placing his hat on the floor, and his arms on the rail, took a bird’s–eye view of the Bar, and a comprehensive survey of the Bench, with a remarkably cheerful and lively aspect. ‘What’s your name, sir?’ inquired the judge. / ‘Sam Weller, my Lord,’ replied that gentleman. / ‘Do you spell it with a “V” or a “W”?’ inquired the judge. / ‘That depends upon the taste and fancy of the speller, my Lord,’ replied Sam; ‘I never had occasion to spell it more than once or twice in my life, but I spells it with a “V.” ’ / Here a voice in the gallery exclaimed aloud, ‘Quite right too, Samivel, quite right. Put it down a “we,” my Lord, put it down a “we.”’"
                                            },
                                            {
                                                "example_id": "4c216d2f-4775-418e-947c-40d0f77df109",
                                                "sense_id": "4a4a7531-fcb6-3f46-8090-dbd937d6402c",
                                                "text": "I went down the dark road between the hawthorn hedges puzzling over the why of like, repeating SAMUEL to myself and aloud and listening to the rolling wonder in its sound that had charmed her soul and led her life in tragic places. SAMUEL! There was a rolling wonder in the sound. Aye, there was!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa58c55-1321-32a8-8604-1ae8fa274039",
                                        "entry_id": "0a9bc7af-d085-34a7-bac5-63ed4edfcc6a",
                                        "glosses": [
                                            "One of two books of the Old Testament and the Hebrew Tanakh."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20d6d9f3-384a-308f-a4e5-ec53094d9ecc",
                                        "entry_id": "0a9bc7af-d085-34a7-bac5-63ed4edfcc6a",
                                        "glosses": [
                                            "The primary author and central character of the first book of Samuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5328a3-525c-4c82-9188-aae7344a4af2",
                                                "sense_id": "20d6d9f3-384a-308f-a4e5-ec53094d9ecc",
                                                "text": "Wherefore it came to pass, when the time was come about after Hannah had conceived, that she bare a son, and called his name Samuel, saying, Because I have asked him of the LORD."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "116b65c9-2f71-3d73-9a2a-878f800405b0",
                                        "entry_id": "0a9bc7af-d085-34a7-bac5-63ed4edfcc6a",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f98212f9-baf9-4ca9-aa82-1c252055bb4a",
                        "source_entry_id": "588bad6f-7755-31f3-b336-9c7df1449233",
