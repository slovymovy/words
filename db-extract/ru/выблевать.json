                "senses": [
                    {
                        "sense_id": "010fbbcd-3d22-3c5f-a971-30495b7b7a73",
                        "entry_id": "c3490198-d179-34a9-876d-2f866df71f05",
                        "glosses": [
                            "разг. извергнуть, обычно непроизвольно, через рот содержимое желудка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b98eba5e-c34d-4fd9-9410-6ec3a412e93d",
                                "sense_id": "010fbbcd-3d22-3c5f-a971-30495b7b7a73",
                                "text": "Секунда ― и Андрей, содрогнувшись, выблевал всё, чем за день наполнился его желудок."
                            },
                            {
                                "example_id": "8390c4b6-43eb-4af6-832e-0685b70da0fc",
                                "sense_id": "010fbbcd-3d22-3c5f-a971-30495b7b7a73",
                                "text": "Изнемогший, он выблевал мучившую водку и двинулся по комнатке, начав куда-то наугад снаряжаться."
                            }
                        ]
                    }
