{
    "word_family": [
        "klinken",
        "klinker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f92c536-ebb7-3241-8f5b-de75dcce8034",
                    "sense_definition": "handvat om een deur te openen of te sluiten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deurbeslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik neem de <w>klink</w> vast en doe de deur open.",
                            "target_lang_translations": {
                                "it": "Afferro la <w>maniglia</w> e apro la porta."
                            }
                        },
                        {
                            "text": "Druk op de <w>klink</w> om de deur te openen.",
                            "target_lang_translations": {
                                "it": "Premi la <w>maniglia</w> per aprire la porta."
                            }
                        }
                    ],
                    "synonyms": [
                        "deurklink"
                    ],
                    "common_phrases": [
                        "deur klink"
                    ],
                    "target_lang_definitions": {
                        "it": "Maniglia o leva utilizzata per aprire o chiudere una porta."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "maniglia",
                                "target_lang_sense_clarification": "il dispositivo manuale per azionare l'apertura di una porta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "269db602-0754-3eca-9710-a4b0cbbf09cc",
                    "sense_definition": "constructie om een deur gesloten te houden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deurbeslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>klink</w> is stuk waardoor de deur steeds opnieuw openzwaait.",
                            "target_lang_translations": {
                                "it": "La <w>serratura</w> è rotta, perciò la porta continua a spalancarsi."
                            }
                        },
                        {
                            "text": "Zorg dat de <w>klink</w> goed vastzit zodat de deur dicht blijft.",
                            "target_lang_translations": {
                                "it": "Assicurati che il <w>chiavistello</w> sia ben fissato affinché la porta rimanga chiusa."
                            }
                        }
                    ],
                    "synonyms": [
                        "grendel"
                    ],
                    "common_phrases": [
                        "klink vastzetten"
                    ],
                    "target_lang_definitions": {
                        "it": "Meccanismo o dispositivo che mantiene una porta chiusa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "serratura",
                                "target_lang_sense_clarification": "meccanismo di chiusura"
                            },
                            {
                                "target_lang_word": "chiavistello",
                                "target_lang_sense_clarification": "dispositivo di bloccaggio manuale"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9449c26-987f-392b-869e-42a6953a575e",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>klinken</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>klink</w> mijn glas op een goede afloop.",
                            "target_lang_translations": {
                                "it": "Io <w>brindo</w> al buon esito."
                            }
                        },
                        {
                            "text": "Ik <w>klink</w> graag met mijn vrienden tijdens het feest.",
                            "target_lang_translations": {
                                "it": "Mi piace <w>brindare</w> con i miei amici durante la festa."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Prima persona singolare del presente indicativo del verbo 'klinken' (brindare)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "brindo",
                                "target_lang_sense_clarification": "atto di toccare i bicchieri in segno di augurio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d33b8cb2-bb02-3c8a-856f-ca7743c9f4f1",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>klinken</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Klink</w> jij ook mee op het succes?",
                            "target_lang_translations": {
                                "it": "<w>Brindi</w> anche tu al successo?"
                            }
                        },
                        {
                            "text": "Waarom <w>klink</w> je niet met ons mee?",
                            "target_lang_translations": {
                                "it": "Perché non <w>brindi</w> insieme a noi?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Seconda persona singolare del presente indicativo del verbo 'klinken' (brindare)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "brindi",
                                "target_lang_sense_clarification": "atto di toccare i bicchieri in segno di augurio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d15ca2bb-a54b-34c1-8cea-4ec62af0dbba",
                    "sense_definition": "gebiedende wijs van <w>klinken</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Klink</w> nu met je glas op de jarige!",
                            "target_lang_translations": {
                                "it": "<w>Brinda</w> ora con il tuo bicchiere al festeggiato!"
                            }
                        },
                        {
                            "text": "<w>Klink</w> nog een keer met iedereen.",
                            "target_lang_translations": {
                                "it": "<w>Brinda</w> ancora una volta con tutti."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Forma imperativa del verbo 'klinken' (brindare)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "brinda",
                                "target_lang_sense_clarification": "invito a brindare"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}