                ],
                "senses": [
                    {
                        "sense_id": "66f4e8a9-0483-382a-9ca2-e6b417ea8400",
                        "entry_id": "bc626f1a-8080-3663-8ad0-562beeafe4bc",
                        "glosses": [
                            "Intention der Texte, deren Textfunktion hauptsächlich darin besteht, dass der Verfasser sich auf eine zukünftige Handlung oder Unterlassung festlegt"
                        ],
                        "tags": [
                            "Textlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "4ae32902-b491-4f21-8141-13a6fd64218a",
                                "sense_id": "66f4e8a9-0483-382a-9ca2-e6b417ea8400",
                                "text": "Die Obligationsfunktion ist die dominierende Textfunktion in Textklassen wie Angeboten, Versprechen, Zusagen u.ä."
                            },
                            {
                                "example_id": "12272a65-2bba-488d-8012-3e931a6a3973",
                                "sense_id": "66f4e8a9-0483-382a-9ca2-e6b417ea8400",
                                "text": "„Die Obligationsfunktion ist eng verbunden mit thematischen Einstellungen voluntativer und intentionaler Art (…).“"
                            },
                            {
                                "example_id": "eea5409a-83c7-468f-a143-ff91e252879b",
                                "sense_id": "66f4e8a9-0483-382a-9ca2-e6b417ea8400",
                                "text": "„Textsorten mit Obligationsfunktion sind Vertrag, Vereinbarung, Garantieschein, Gelübde, Gelöbnis, Angebot usw.“"
                            },
                            {
                                "example_id": "f39270bb-399c-40a6-9f09-572f3a50c410",
                                "sense_id": "66f4e8a9-0483-382a-9ca2-e6b417ea8400",
                                "text": "„Eine Obligationsfunktion beinhaltet eine Verpflichtung, die sich aus dem Text ergibt.“"
                            },
                            {
                                "example_id": "d64e2884-a4c7-491a-92c8-4c4c371ce4b7",
                                "sense_id": "66f4e8a9-0483-382a-9ca2-e6b417ea8400",
                                "text": "„Texte mit Obligationsfunktion sind solche, in denen sich ein Sprecher oder Schreiber selbst verpflichtet, eine bestimmte Handlung zu vollziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
