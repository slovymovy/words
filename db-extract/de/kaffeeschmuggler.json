                "senses": [
                    {
                        "sense_id": "dfd898b1-5e05-3420-8060-474c06e3105f",
                        "entry_id": "a51f1e82-11dd-30c1-bb94-43a38057a5ac",
                        "glosses": [
                            "jemand, der Kaffee schmuggelt; der Kaffee illegal über eine Staatsgrenze bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2433663c-f7c5-422f-bf50-ee7d71b21ea8",
                                "sense_id": "dfd898b1-5e05-3420-8060-474c06e3105f",
                                "text": "„In den fünfziger Jahren war Miguel Kaffeeschmuggler in der Karibik.“"
                            },
                            {
                                "example_id": "a04e47a9-50ac-4d4f-9677-be27eeaece63",
                                "sense_id": "dfd898b1-5e05-3420-8060-474c06e3105f",
                                "text": "„Eine solche existierte auch an der Salzburger Grenze zu Deutschland, in der Nähe von Lofer und Unken, wo ich einen Kaffeeschmuggler der Vorkriegszeit traf. Seine Aufgabe war es, Kaffee auf Schleichwegen zu einem deutschen Bauern an der Grenze zu bringen.“"
                            },
                            {
                                "example_id": "de73bc34-5824-4a67-bae2-9403913e44a7",
                                "sense_id": "dfd898b1-5e05-3420-8060-474c06e3105f",
                                "text": "„Der war damals auch einer von den Kaffeeschmugglern, aber der macht keinen Hehl daraus, muss sich die Dinge nicht schönreden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
