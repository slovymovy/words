                "senses": [
                    {
                        "sense_id": "d005700b-4c26-3c92-b35c-35255968b42a",
                        "entry_id": "d91be697-c86c-331e-ae84-1f3c6c63d482",
                        "glosses": [
                            "Post des Deutschen Reiches (1871-1945)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "499a257b-127f-4d46-a03c-87f4c74e8be6",
                                "sense_id": "d005700b-4c26-3c92-b35c-35255968b42a",
                                "text": "„Von Station zu Station gaben Beamte der Reichspost verwirrende, oft widersprüchliche Nachrichten weiter - und erzählten sie unmittelbar danach Bekannten und Verwandten.“"
                            },
                            {
                                "example_id": "5e605fb2-ea69-4b60-9e53-6a3bfdc1a62c",
                                "sense_id": "d005700b-4c26-3c92-b35c-35255968b42a",
                                "text": "„Sie sind daher spätestens seit der Umbenennung der Norddeutschen Post (12. Mai 1871) Marken der Deutschen Reichspost.“"
                            },
                            {
                                "example_id": "6f791c6a-2de3-436a-901e-9a5581636371",
                                "sense_id": "d005700b-4c26-3c92-b35c-35255968b42a",
                                "text": "„Wäre dies nicht so, dann hätte die Reichspost auch keine Handhabe gehabt, hier Nachgebühren zu erheben.“"
                            },
                            {
                                "example_id": "0e2c5146-0c92-422a-b296-19c30921a09e",
                                "sense_id": "d005700b-4c26-3c92-b35c-35255968b42a",
                                "text": "„Der größte Teil wurde von der Reichspost über den Landweg gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
