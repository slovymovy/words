                        "examples": [
                            {
                                "example_id": "3eb95d08-ca0c-496b-b211-334f6248b6aa",
                                "sense_id": "0124a090-6483-3fa9-96e2-ac7b204598fb",
                                "text": "Он тотчас начал говорить мне о том, и что говорил, то и писать не поленился. Что именно, то, чтоб не удлинить без меры теперешнего моего слова, я напишу в других словах, в обрадование и услаждение тех, которые любят читать такого рода писания с верою."
                            }
                        ]
                    }
