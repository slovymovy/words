                ],
                "senses": [
                    {
                        "sense_id": "76810919-976f-3550-8c74-61649f3409a2",
                        "entry_id": "85292005-0b0b-3ea6-851f-bf351ce08e56",
                        "glosses": [
                            "Ärger empfindend, in Wut gebracht sein"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "7510ae73-0d4e-4cad-a842-c48550b12fbf",
                                "sense_id": "76810919-976f-3550-8c74-61649f3409a2",
                                "text": "„Die drei Teile waren nicht ganz billig, deshalb entschloss ich mich vergnatzt, wieder auszuchecken und mit dem Bus zu fahren.“"
                            },
                            {
                                "example_id": "94b87f3a-0e7f-4fea-b799-661a59b72619",
                                "sense_id": "76810919-976f-3550-8c74-61649f3409a2",
                                "text": "„Vielleicht war Karl nur vergnatzt, weil er keine ehrenwerte Dekoration abbekommen hatte?“"
                            },
                            {
                                "example_id": "06933b7f-78a9-4a06-979e-8a3f4dea6fd6",
                                "sense_id": "76810919-976f-3550-8c74-61649f3409a2",
                                "text": "„Zunächst kehre ich vergnatzt um, denn unsere Freunde aus Prag dürfen Westberlin auch nicht betreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
