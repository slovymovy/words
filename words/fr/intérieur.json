                    "frequency": "Middle",
                    "semantic_group_id": "partie du dedans",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>intérieur</w> de cette voiture est très confortable et bien éclairé."
                        },
                        {
                            "text": "Ils ont fait appel à un architecte d'<w>intérieur</w> pour rénover le salon."
                        }
                    ],
                    "antonyms": [
                        "extérieur"
                    ],
                    "common_phrases": [
                        "architecte d'intérieur",
                        "décoration d'intérieur"
                    ]
                },
                {
                    "sense_id": "2b7e9250-3451-3bd8-ad78-efce3205d493",
                    "sense_definition": "Partie d'un pays située loin des frontières ou de la côte, par opposition à l'étranger ou aux colonies.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les villes de l'<w>intérieur</w> sont souvent plus calmes que celles de la côte."
