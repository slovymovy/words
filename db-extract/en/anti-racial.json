    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a1cc6baa-949e-319d-87fe-a86b394d1f1c",
                "word": "anti-racial",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e501c2cb-ba3d-3d76-8a2e-83b6c0fdc8bf",
                        "entry_id": "a1cc6baa-949e-319d-87fe-a86b394d1f1c",
                        "glosses": [
                            "Opposed to racial distinctions, especially those that are due to racism."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "eed4c87a-1880-4543-90b3-7bf64f59f155",
                                "sense_id": "e501c2cb-ba3d-3d76-8a2e-83b6c0fdc8bf",
                                "text": "To be clear, to reiterate: I am suggesting that in the wake of whatever nominal successes, antiracist struggle gave way in each instance to anti-racial commitments at the expense of antiracist effects and ongoing struggle."
                            },
                            {
                                "example_id": "79d0ae81-bcd3-4dc3-9587-55751e90db35",
                                "sense_id": "e501c2cb-ba3d-3d76-8a2e-83b6c0fdc8bf",
                                "text": "The major modern scholarly studies on race in the United States were triggered by the ideological and sociopolitical struggles surrounding the New Deal —the anti-dictatorial, anti-colonial, anti-capitalist, and anti-racial struggles that reached their peaks during the 1930s."
                            },
                            {
                                "example_id": "abad489b-4806-413f-81ec-153998e4c1fd",
                                "sense_id": "e501c2cb-ba3d-3d76-8a2e-83b6c0fdc8bf",
                                "text": "That is to say we must be both “racial” and anti-racial at the same time, which really means that nationalism and internationalism must be combined in the same philosophy."
                            }
                        ]
                    }
                ],
