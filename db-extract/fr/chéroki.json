                "senses": [
                    {
                        "sense_id": "5a0b55cc-0df4-3065-a828-96c85362f5ae",
                        "entry_id": "da293e5f-de8c-34d2-aa20-e63fd420fe65",
                        "glosses": [
                            "Variante orthographique de Cherokee."
                        ],
                        "tags": [
                            "alt-of",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e6ce5a76-bd13-4529-b5c3-c0c69b3a63af",
                                "sense_id": "5a0b55cc-0df4-3065-a828-96c85362f5ae",
                                "text": "Les Chérokis contestèrent la décision en Cour suprême à titre de nation souveraine, argument que rejeta le juge John Marshall."
                            },
                            {
                                "example_id": "ca332291-299c-4ec0-9084-7427d1c257a4",
                                "sense_id": "5a0b55cc-0df4-3065-a828-96c85362f5ae",
                                "text": "Ils étaient tous désormais alliés, unis aux Britanniques par la même « chaîne » ; à l’instar des Six-Nations et des Sept-Nations membres du Covenant, les Chérokis avaient maintenant les mêmes obligations."
                            },
                            {
                                "example_id": "8f3b6e63-71b7-463a-96f9-5e50c23b1d29",
                                "sense_id": "5a0b55cc-0df4-3065-a828-96c85362f5ae",
                                "text": "Les Indiennes qui débarquèrent auprès de nous, issues d’un sang mêlé de Chéroki et de Castillan, avaient la taille élevée."
                            },
                            {
                                "example_id": "7d4167f3-0318-46f6-a480-375afda6b122",
                                "sense_id": "5a0b55cc-0df4-3065-a828-96c85362f5ae",
                                "text": "Toutefois la cour exprima l’opinion décisive que les Chérokis avaient droit à la protection du pouvoir exécutif."
                            }
                        ]
                    }
