                        "examples": [
                            {
                                "example_id": "4633022d-f8d7-4714-9d0c-55e59be4f918",
                                "sense_id": "4bb58f6f-cef4-3e52-b230-23d5315491c9",
                                "text": "“Actually, I like you growling when we're in our bedchamber. It, um . . . makes me think of all the things we do.” “Oh.” He processed that for a moment, then grinned down at her. “I'll take that as permission to growl at you all the more, then!” “Wolfer!” She bapped him again with the back of her fingers."
                            },
