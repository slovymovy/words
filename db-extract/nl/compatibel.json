                                        "sense_id": "ed9b7673-0379-3e35-a027-77da5aa33f3f",
                                        "entry_id": "bd92a5ca-f72b-3bae-8f0e-f9552cf9e8bd",
                                        "glosses": [
                                            "Qui peut exister, s’accorder avec quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7be5e032-74e3-4282-a374-cda34ce39dc5",
                                                "sense_id": "ed9b7673-0379-3e35-a027-77da5aa33f3f",
                                                "text": "La France demande que soit soumise au Tribunal de La Haye la question de savoir si le pacte franco-soviétique est compatible avec Locarno."
                                            },
                                            {
                                                "example_id": "9a2b6e5c-b2bb-4f5f-9297-e609a10e349e",
                                                "sense_id": "ed9b7673-0379-3e35-a027-77da5aa33f3f",
                                                "text": "J'attends qu'elle revienne tandis qu'elle voudrait que je l'oublie. J'attends qu'elle change, alors qu'elle est enfin bien dans sa peau, dit-elle, et elle m'en remercie, mais je ne suis plus compatible avec ce que je l'ai aidée à devenir."
                                            },
                                            {
                                                "example_id": "c96cfab9-19d8-4f07-84f2-05d1c628360b",
                                                "sense_id": "ed9b7673-0379-3e35-a027-77da5aa33f3f",
                                                "text": "Cela met en évidence la nécessité de concevoir un matériel compatible avec la nettoyabilité, pour lequel il n'existera pas de zones inaccessibles au nettoyage et à la désinfection."
                                            },
                                            {
                                                "example_id": "7784161b-05a6-4de6-b446-de3782816762",
                                                "sense_id": "ed9b7673-0379-3e35-a027-77da5aa33f3f",
                                                "text": "Les fonctions d’avoué sont compatibles avec celles de juge suppléant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9bdf27-3a16-3ec7-941b-d2f657ddf1c7",
                                        "entry_id": "bd92a5ca-f72b-3bae-8f0e-f9552cf9e8bd",
                                        "glosses": [
                                            "Facilement modulable ou connectable sans interface ou manipulation compliquée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8122efe-82ce-472f-ab72-e231c7326f0e",
                                                "sense_id": "6a9bdf27-3a16-3ec7-941b-d2f657ddf1c7",
                                                "text": "Ce logiciel est compatible avec votre ordinateur."
                                            }
                                        ]
