                                                "sense_id": "925abd77-b50f-3b90-b1a9-991b4db7c967",
                                                "text": "Gymnastics was a significant part of the physical education curriculum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "958300c5-c41c-323b-8eb4-0d9afdb5c0b4",
                                        "entry_id": "0dc4814f-cc1e-3893-9b91-bf882ebeac95",
                                        "glosses": [
                                            "Complex intellectual or artistic exercises or feats of physical agility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef44f45c-6d22-45f3-a352-e89aec5cbbbf",
                                                "sense_id": "958300c5-c41c-323b-8eb4-0d9afdb5c0b4",
                                                "text": "His mental gymnastics are legendary."
                                            },
                                            {
                                                "example_id": "bb44d2bf-dcdc-45f8-8913-ed9e06471f87",
                                                "sense_id": "958300c5-c41c-323b-8eb4-0d9afdb5c0b4",
                                                "text": "Her voice swooped and soared as she raced through some double time vocal gymnastics which included a beautifully clear horn impersonation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc66fdd5-bbcc-497b-942f-c88a2e31ae01",
                        "source_entry_id": "019a0b37-fe7e-3ec2-a415-99784776dfaa",
