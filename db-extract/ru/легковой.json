                "senses": [
                    {
                        "sense_id": "ee1bbbd9-87ec-33f1-b88b-3ef43fab2e81",
                        "entry_id": "297bea4c-6ce7-3e1c-b4a9-cbccad851bce",
                        "glosses": [
                            "предназначенный для перевозки пассажиров, ручного багажа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ec77636-01b8-4893-8a46-0e416c9ab6fc",
                                "sense_id": "ee1bbbd9-87ec-33f1-b88b-3ef43fab2e81",
                                "text": "Легковой автомобиль"
                            },
                            {
                                "example_id": "a668ef49-eb39-42cf-9694-10ae7fe5aa0d",
                                "sense_id": "ee1bbbd9-87ec-33f1-b88b-3ef43fab2e81",
                                "text": "Едем, малец, гроши добывать! ― шутил Трифон, усаживаясь на легковые санки… ― Ну, желтоглазая!"
                            }
                        ]
                    },
                    {
                        "sense_id": "93c49f9a-75bd-38d1-9eba-af3eb0203fe8",
                        "entry_id": "297bea4c-6ce7-3e1c-b4a9-cbccad851bce",
                        "glosses": [
                            "управляющий или владеющий средством для перевозки пассажиров, ручного багажа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b0f450-3011-4964-809c-96c09c8f8062",
                                "sense_id": "93c49f9a-75bd-38d1-9eba-af3eb0203fe8",
                                "text": "Владелец ее, зажиточный легковой извозчик, вслед за объявлением воли, собрал семейство, заколотил окна избы досками и совсем переселился в Москву."
                            }
                        ]
                    }
