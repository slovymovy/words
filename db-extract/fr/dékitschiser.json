                "senses": [
                    {
                        "sense_id": "d12c65d1-1cc4-3aed-8fea-cb2a49db0a27",
                        "entry_id": "bd8b0c85-9f01-3888-ab07-41ef355f5350",
                        "glosses": [
                            "Enlever son caractère kitsch à quelque chose ou quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "553c01f7-0812-4b25-93cd-774c9f03a2da",
                                "sense_id": "d12c65d1-1cc4-3aed-8fea-cb2a49db0a27",
                                "text": "le dj est trés ^([sic : très]) bon en musique mais c’est dur de le dékitschiser !!"
                            },
                            {
                                "example_id": "ff771153-c939-4ff7-ac45-64ec2a341bcc",
                                "sense_id": "d12c65d1-1cc4-3aed-8fea-cb2a49db0a27",
                                "text": "Après dix ans d’existence, nous avions envie de relifter l’endroit et de “dékitschiser” un peu certaines choses, esquisse Laurent Taïeb."
                            },
                            {
                                "example_id": "e2f444e9-5b54-4018-a6f3-21929dc330a3",
                                "sense_id": "d12c65d1-1cc4-3aed-8fea-cb2a49db0a27",
                                "text": "Si vous êtes passé à côté de la rencontre de M. Gabulle et du trophée cerf (qu’il regarde toujours de travers même dékitschisé), je vous renvoie ici."
                            }
                        ]
                    }
