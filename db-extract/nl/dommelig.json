                        "examples": [
                            {
                                "example_id": "b868c3ae-2f1c-40e6-8c5d-96cdfa6896b3",
                                "sense_id": "a78ee77b-112e-39cf-9ba4-b2a0463c5746",
                                "text": "Het was een nogal dommelig ritje in de nachttrein van Rotterdam naar Amsterdam geweest, totdat drie Surinaamse Nederlanders in Leiden hun entree maakten. Drie stevige mannen van in de dertig. Ze stapten luidruchtig binnen, namen luidruchtig plaats in een aangrenzend compartiment en begonnen aan een luidruchtige conversatie, waarbij het er om leek te gaan dat de een de ander zo hard mogelijk overschreeuwde."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e46f49c-5524-31cb-bcff-f01a2c4382eb",
                        "entry_id": "4814b10c-56ec-3f1a-b182-33e03747eb0f",
                        "glosses": [
                            "half slapend, niet helemaal wakker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ab5f09f-4395-4041-84ef-0d4e2e3663bc",
                                "sense_id": "1e46f49c-5524-31cb-bcff-f01a2c4382eb",
                                "text": "Als je dommelig achter het stuur zit, kun je makkelijk een ongeluk veroorzaken"
                            }
                        ]
                    }
                ],
