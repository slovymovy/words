{
    "word_family": [
        "cloud",
        "cloudiness",
        "cloudless",
        "cloudscape",
        "becloud",
        "encloud"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a1988719-2dbc-371d-a2d6-ec0822d5427b",
                    "sense_definition": "Covered with or characterized by clouds in the sky.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather forecast says it will be a <w>cloudy</w> day with a chance of rain.",
                            "target_lang_translations": {
                                "ru": "Прогноз погоды говорит, что день будет <w>облачным</w>, с вероятностью дождя."
                            }
                        },
                        {
                            "text": "We could not see the stars because the sky was too <w>cloudy</w> tonight.",
                            "target_lang_translations": {
                                "ru": "Мы не видели звезд, потому что небо сегодня было слишком <w>пасмурным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "overcast",
                        "clouded"
                    ],
                    "antonyms": [
                        "cloudless",
                        "unclouded"
                    ],
                    "common_phrases": [
                        "cloudy sky",
                        "cloudy day",
                        "partly cloudy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый облаками или характеризующийся наличием облаков на небе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облачный",
                                "target_lang_sense_clarification": "о погоде или небе"
                            },
                            {
                                "target_lang_word": "пасмурный",
                                "target_lang_sense_clarification": "о погоде, когда небо затянуто тучами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2aa48b0-cee8-3931-8b3b-e9e9758c72c6",
                    "sense_definition": "Not transparent or clear, often describing liquids or materials that look murky.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water in the pond became <w>cloudy</w> after the heavy storm stirred up the mud.",
                            "target_lang_translations": {
                                "ru": "Вода в пруду стала <w>мутной</w> после того, как сильный шторм поднял ил со дна."
                            }
                        },
                        {
                            "text": "If the apple juice looks <w>cloudy</w> liquid, it might mean it is unfiltered.",
                            "target_lang_translations": {
                                "ru": "Если яблочный сок выглядит как <w>мутная</w> жидкость, это может означать, что он нефильтрованный."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloudy liquid",
                        "cloudy water",
                        "cloudy appearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрозрачный или неясный, часто описывает жидкости или материалы, которые выглядят мутными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "о жидкости или прозрачности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8138bc6-b3e2-37c0-b163-c30b423aef91",
                    "sense_definition": "Uncertain, unclear, or confused in meaning or thought.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His memory of the accident was <w>cloudy</w> and he could not recall the details.",
                            "target_lang_translations": {
                                "ru": "Его воспоминания об аварии были <w>туманными</w>, и он не мог вспомнить детали."
                            }
                        },
                        {
                            "text": "The future of the project remains <w>cloudy</w> due to a lack of funding.",
                            "target_lang_translations": {
                                "ru": "Будущее проекта остается <w>неясным</w> из-за отсутствия финансирования."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloudy memory",
                        "cloudy future"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопределенный, неясный или запутанный по смыслу или в мыслях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туманный",
                                "target_lang_sense_clarification": "о памяти, будущем или смысле"
                            },
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "о мыслях или ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9afe0859-22fb-312b-8ca5-09a11492920c",
                    "sense_definition": "Using or relating to cloud computing technology.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is moving its data to a <w>cloudy</w> infrastructure to save on server costs.",
                            "target_lang_translations": {
                                "ru": "Компания переносит свои данные в <w>облачную</w> инфраструктуру, чтобы сэкономить на расходах на серверы."
                            }
                        },
                        {
                            "text": "Many modern software applications rely on <w>cloudy</w> solutions for real-time updates.",
                            "target_lang_translations": {
                                "ru": "Многие современные программные приложения полагаются на <w>облачные</w> решения для обновлений в реальном времени."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloudy infrastructure",
                        "cloudy environment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использующий или относящийся к технологиям облачных вычислений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облачный",
                                "target_lang_sense_clarification": "относящийся к облачным технологиям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c009e2b2-3e99-362e-bc57-5731addd7fe0",
                    "sense_definition": "Shady, sketchy, or suspicious in nature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suspicion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are investigating his <w>cloudy</w> past and his connections to the gang.",
                            "target_lang_translations": {
                                "ru": "Полиция расследует его <w>темное</w> прошлое и его связи с бандой."
                            }
                        },
                        {
                            "text": "I would avoid that shop because they have a reputation for <w>cloudy</w> business dealings.",
                            "target_lang_translations": {
                                "ru": "Я бы избегал этого магазина, потому что у них репутация за <w>мутные</w> деловые отношения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloudy past",
                        "cloudy dealings"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe suspicious character or history"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подозрительный, сомнительный или имеющий плохую репутацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темный",
                                "target_lang_sense_clarification": "о прошлом или делах"
                            },
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "вызывающий подозрения"
                            },
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "разговорное о подозрительных людях или делах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}