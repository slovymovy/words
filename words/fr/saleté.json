                {
                    "sense_id": "b1a2704b-cc22-3fbb-abc3-70a395d02b64",
                    "sense_definition": "Matière sale, déchet ou poussière qui rend un endroit ou une chose malpropre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "propreté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut balayer toutes ces <w>saletés</w> accumulées sur le sol.",
                            "target_lang_translations": {
                                "en": "All this <w>dirt</w> that has built up on the floor must be swept up.",
                                "ru": "Нужно подмести всю эту <w>грязь</w>, скопившуюся на полу.",
                                "de": "Den ganzen <w>Schmutz</w>, der sich auf dem Boden angesammelt hat, muss man zusammenkehren.",
                                "es": "Hay que barrer toda esta <w>mugre</w> acumulada en el suelo.",
                                "zh": "必须把地上积攒的这些<w>污物</w>全部扫干净。"
                            }
                        },
                        {
                            "text": "Le filtre retient la <w>saleté</w> pour garder une eau transparente.",
                            "target_lang_translations": {
                                "en": "The filter traps the <w>dirt</w> to keep the water clear.",
                                "ru": "Фильтр задерживает <w>грязь</w>, чтобы вода оставалась прозрачной.",
                                "de": "Der Filter hält den <w>Schmutz</w> zurück, damit das Wasser klar bleibt.",
                                "es": "El filtro retiene la <w>suciedad</w> para mantener el agua transparente.",
                                "zh": "过滤器能截留<w>污物</w>，让水保持透明。"
                            }
                        }
                    ],
