    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f665bb2-5a2a-3b1a-84a9-8c7a7beb7d4c",
                    "sense_definition": "Een grote aasetende roofvogel met een kale kop en machtige vleugels.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vogels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gier</w> cirkelde hoog boven het karkas in de woestijn.",
                            "target_lang_translations": {
                                "en": "The <w>vulture</w> circled high above the carcass in the desert."
                            }
                        },
                        {
                            "text": "In de dierentuin konden we een zeldzame <w>gier</w> van dichtbij bekijken.",
                            "target_lang_translations": {
                                "en": "At the zoo, we were able to see a rare <w>vulture</w> up close."
                            }
                        }
                    ],
                    "synonyms": [
                        "giervogel",
                        "aasgier"
                    ],
                    "common_phrases": [
                        "een hongerige gier"
                    ],
                    "target_lang_definitions": {
                        "en": "A large carrion-eating bird of prey with a bald head and powerful wings."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vulture",
                                "target_lang_sense_clarification": "the bird"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce0d52d5-ee5f-3f4e-bb5a-29ea5b242c27",
                    "sense_definition": "Vloeibare mest bestaande uit urine en uitwerpselen van vee.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer verspreidde de <w>gier</w> over het land om het gras te bemesten.",
                            "target_lang_translations": {
                                "en": "The farmer spread the <w>liquid manure</w> over the land to fertilize the grass."
                            }
                        },
                        {
                            "text": "Er hing een sterke geur van <w>gier</w> rond de boerderij.",
                            "target_lang_translations": {
                                "en": "There was a strong smell of <w>slurry</w> around the farm."
                            }
                        }
                    ],
                    "synonyms": [
                        "aalmest",
                        "aalt",
                        "beer",
                        "mestvocht"
                    ],
                    "common_phrases": [
                        "gier over het land"
                    ],
                    "target_lang_definitions": {
                        "en": "Liquid manure consisting of urine and excrement from livestock."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "liquid manure",
                                "target_lang_sense_clarification": "agricultural fertilizer"
                            },
                            {
                                "target_lang_word": "slurry",
                                "target_lang_sense_clarification": "liquid waste used as fertilizer"
                            },
                            {
                                "target_lang_word": "muck-water",
                                "target_lang_sense_clarification": "liquid from manure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c5e9981-2de5-37ea-a6c1-ce378c3aa85a",
                    "sense_definition": "Een uiterst hebzuchtig of roofzuchtig persoon die profiteert van anderen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die projectontwikkelaar gedraagt zich als een echte <w>gier</w> bij faillissementen.",
                            "target_lang_translations": {
                                "en": "That property developer behaves like a real <w>vulture</w> during bankruptcies."
                            }
                        },
                        {
                            "text": "Pas op voor die <w>gier</w> want hij wil alleen maar jouw geld.",
                            "target_lang_translations": {
                                "en": "Watch out for that <w>shark</w> because he only wants your money."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een echte gier"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figuurlijk gebruikt voor mensen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An extremely greedy or predatory person who profits from others."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vulture",
                                "target_lang_sense_clarification": "figurative: predatory person"
                            },
                            {
                                "target_lang_word": "shark",
                                "target_lang_sense_clarification": "predatory person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "892780bd-3de9-38e4-8823-60000f5975c8",
                    "sense_definition": "Een harde, schelle schreeuw of kreet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een luide <w>gier</w> vloog de vogel plotseling weg uit de boom.",
                            "target_lang_translations": {
                                "en": "With a loud <w>shriek</w>, the bird suddenly flew away from the tree."
                            }
                        },
                        {
                            "text": "De wind liet een angstaanjagende <w>gier</w> horen door de smalle kieren.",
                            "target_lang_translations": {
                                "en": "The wind made a terrifying <w>howl</w> through the narrow cracks."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A loud, shrill scream or cry."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shriek",
                                "target_lang_sense_clarification": "high-pitched cry"
                            },
                            {
                                "target_lang_word": "screech",
                                "target_lang_sense_clarification": "harsh, shrill cry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6326cbd-ba31-3ad5-8adb-299f9bdbd4f7",
                    "sense_definition": "Een verterend of hevig verlangen naar iets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>gier</w> naar macht dreef hem tot wanhoopsdaden.",
                            "target_lang_translations": {
                                "en": "His <w>lust</w> for power drove him to acts of desperation."
                            }
                        },
                        {
                            "text": "Zij voelde een onweerstaanbare <w>gier</w> naar avontuur in verre landen.",
                            "target_lang_translations": {
                                "en": "She felt an irresistible <w>craving</w> for adventure in distant lands."
                            }
                        }
                    ],
                    "synonyms": [
                        "begeerte"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "weinig meer gebruikt in deze betekenis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A consuming or intense desire for something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "craving",
                                "target_lang_sense_clarification": "intense desire"
                            },
                            {
                                "target_lang_word": "lust",
                                "target_lang_sense_clarification": "strong desire"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46afac38-25df-356c-853b-84204411e56d",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>gieren</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>gier</w> het uit van het lachen om die grap.",
                            "target_lang_translations": {
                                "en": "I am <w>howling</w> with laughter at that joke."
                            }
                        },
                        {
                            "text": "Soms <w>gier</w> ik van de zenuwen voor een belangrijk examen.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>shriek</w> with nerves before an important exam."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gier van het lachen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'gieren' (to shriek, howl, or rush)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shriek",
                                "target_lang_sense_clarification": "to scream loudly"
                            },
                            {
                                "target_lang_word": "howl",
                                "target_lang_sense_clarification": "to cry out loudly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db5daf98-9472-300e-a1c4-cb3c6391ab87",
                    "sense_definition": "Gebiedende wijs van <w>gieren</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Gier</w> niet zo hard als je door de bocht gaat!",
                            "target_lang_translations": {
                                "en": "Don't <w>screech</w> so loudly when you go through the corner!"
                            }
                        },
                        {
                            "text": "Kom op en <w>gier</w> van plezier tijdens de vakantie.",
                            "target_lang_translations": {
                                "en": "Come on and <w>howl</w> with pleasure during the holiday."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
