                        ],
                        "form": "die Bachhuber"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fca333c-15e8-37ce-af01-182a315f6d38",
                        "entry_id": "16eab531-c72c-3e41-8a37-a95fbe513372",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname, Vorkommen flächendeckend in Niederbayern und Oberbayern; in restlichen Deutschland und in Österreich selten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf1688db-e11b-4f78-8300-2d9d7cac89ca",
                                "sense_id": "6fca333c-15e8-37ce-af01-182a315f6d38",
                                "text": "Frau Bachhuber ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a26f8f36-8920-4c79-bdab-9da7ab3aba43",
                                "sense_id": "6fca333c-15e8-37ce-af01-182a315f6d38",
                                "text": "Herr Bachhuber wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1a26fc66-af12-4816-930c-2b8feacbf250",
                                "sense_id": "6fca333c-15e8-37ce-af01-182a315f6d38",
                                "text": "Die Bachhubers kommen heute aus Xanten."
                            },
                            {
                                "example_id": "f4e9367a-97a9-48b8-af10-55f956f6811d",
                                "sense_id": "6fca333c-15e8-37ce-af01-182a315f6d38",
                                "text": "Der Bachhuber trägt nie die Schals, die die Bachhuber ihm strickt."
                            },
                            {
                                "example_id": "2f169a2e-7a8a-40de-99db-e40cecc0eabb",
                                "sense_id": "6fca333c-15e8-37ce-af01-182a315f6d38",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bachhuber kommt, geht der Herr Bachhuber.“"
                            },
                            {
                                "example_id": "9741ac61-712d-4e5c-8e70-db1288883412",
                                "sense_id": "6fca333c-15e8-37ce-af01-182a315f6d38",
                                "text": "Bachhuber kommt und geht."
                            },
                            {
                                "example_id": "10905085-a29c-458a-b41b-73718d55c736",
                                "sense_id": "6fca333c-15e8-37ce-af01-182a315f6d38",
                                "text": "Bachhubers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "924024ff-6c6b-470d-a06c-aeff93751e20",
                                "sense_id": "6fca333c-15e8-37ce-af01-182a315f6d38",
                                "text": "An verregneten Herbsttagen ist Familie Bachhubers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "0767622e-ebfc-4af6-9a6b-aa4f8a348ff3",
                                "sense_id": "6fca333c-15e8-37ce-af01-182a315f6d38",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Bachhuber das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
