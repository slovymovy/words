                "senses": [
                    {
                        "sense_id": "78a1cbdf-06fb-3ff1-9a84-635cd7c40d60",
                        "entry_id": "f04aee84-08b5-305e-9233-131d9d73a854",
                        "glosses": [
                            "eine Erhöhung oder Vergrößerung auf das zweifache (=doppelte) des Ursprünglichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42b43996-a9cd-4d68-8e71-0ea58dc69b14",
                                "sense_id": "78a1cbdf-06fb-3ff1-9a84-635cd7c40d60",
                                "text": "Der Schutzwall hat eine Verdopplung der Dicke nötig, damit er effektiv gegen das Hochwasser wirkt."
                            },
                            {
                                "example_id": "1d83c8f3-5b49-46bd-a9e8-37147e06fd84",
                                "sense_id": "78a1cbdf-06fb-3ff1-9a84-635cd7c40d60",
                                "text": "Eine Verdopplung meines Gehaltes könnte mich zum Bleiben überreden."
                            },
                            {
                                "example_id": "72bd1e07-6e71-4e5b-b78b-d3755168f0ee",
                                "sense_id": "78a1cbdf-06fb-3ff1-9a84-635cd7c40d60",
                                "text": "„In Indien wird bis 2040 mit einer Verdopplung der Kohleförderung und des Kohleverbrauchs im Vergleich zum Stand des Jahres 2018 gerechnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
