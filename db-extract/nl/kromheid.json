                "entry_id": "c6f9940e-90a3-333f-959c-f39d64fcd100",
                "word": "kromheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38ce8fa1-7295-3c0a-ac83-59b72e05f61d",
                        "entry_id": "c6f9940e-90a3-333f-959c-f39d64fcd100",
                        "glosses": [
                            "het niet logisch of rechtlijnig zijn van iets"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ca2e7d69-928c-4f56-92e9-3b50ec9ad174",
                                "sense_id": "38ce8fa1-7295-3c0a-ac83-59b72e05f61d",
                                "text": "\"Gaandeweg dit traject ben ik me steeds meer gaan verbazen over de enorme kromheid van dit beleid en de grote hoeveelheid haken en ogen die er op juridisch gebied bij komen kijken\", legde Tim eerder uit."
                            }
                        ]
                    },
                    {
                        "sense_id": "78af8333-1624-3dea-84f4-d4e018f4cfa3",
                        "entry_id": "c6f9940e-90a3-333f-959c-f39d64fcd100",
                        "glosses": [
                            "het niet recht zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a84ea7f1-d7a3-4cfb-a109-3ed66cf90b23",
                                "sense_id": "78af8333-1624-3dea-84f4-d4e018f4cfa3",
                                "text": "Brussel hoopt de groeiende euroscepsis de wind uit de zeilen te kunnen nemen. Geen gedoe meer over de kromheid van een banaan of komkommer, hopen Juncker en diens commissie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c212e473-5e48-4bc2-a89b-fba25bce6f2b",
                        "source_entry_id": "c6f9940e-90a3-333f-959c-f39d64fcd100",
                        "source_sense_id": "38ce8fa1-7295-3c0a-ac83-59b72e05f61d",
