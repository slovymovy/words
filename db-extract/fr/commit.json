                                            {
                                                "example_id": "e3bab5a1-82fe-4d02-b116-c2b3277948b0",
                                                "sense_id": "b8c176ed-40fa-3eb3-92fe-4e1ef3bb6e6a",
                                                "text": "To support locking and process synchronization independently of transaction commits, the server provides semaphore objects[…]"
                                            },
                                            {
                                                "example_id": "502bfe80-a7a4-48b4-811e-da907c372622",
                                                "sense_id": "b8c176ed-40fa-3eb3-92fe-4e1ef3bb6e6a",
