                                "sense_id": "d4a99135-6c59-3c63-93ed-4718e34c587f",
                                "text": "\"Für die über Frankreichs Atommeilern kreisenden Drohnen sei man nicht verantwortlich, hat ein Sprecher der Umweltschutzorganisation am Donnerstag versichert. Wer dann?\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
