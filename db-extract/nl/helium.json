                        "entry_id": "9220e3e8-8b88-36fd-90a9-6a1d75f08a2e",
                        "glosses": [
                            "een chemisch element en een inert edelgas, met symbool He en atoomnummer 2"
                        ],
                        "tags": [
                            "element"
                        ],
                        "examples": [
                            {
                                "example_id": "d6fc94c1-88b9-4495-b377-dd3d35081206",
                                "sense_id": "1b73bbb2-b88e-3f07-b1f9-004af397d9b8",
                                "text": "Van helium krijg je een hoge stem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02861d2a-71d0-41c1-98b9-f23e537fca61",
                        "source_entry_id": "9220e3e8-8b88-36fd-90a9-6a1d75f08a2e",
                        "source_sense_id": "1b73bbb2-b88e-3f07-b1f9-004af397d9b8",
                        "source_sense_description": "een chemisch element en een inert edelgas",
                        "target_lang_word": "Helium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Helium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b555b02-891e-3353-997c-08c842bdb00c",
                                        "entry_id": "d62d62a9-7d6a-39a1-8bbe-b4157772bad5",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 2 und einer Atommasse von 4,002602 u"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0773f4d7-aba0-48fe-b689-556b1b3c363d",
                                                "sense_id": "0b555b02-891e-3353-997c-08c842bdb00c",
                                                "text": "Da Helium etwa fünfmal leichter als Luft ist, dient es als Füllgas für Ballone."
                                            },
                                            {
                                                "example_id": "b2198be3-4c2d-4a2c-9fe3-132bdf047d13",
                                                "sense_id": "0b555b02-891e-3353-997c-08c842bdb00c",
                                                "text": "„Die Sonne enthält etwa 71 % Wasserstoff, 27 % Helium und 2 % schwerere Elemente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43b10bc9-f1b9-420f-8f63-a774edb35408",
                        "source_entry_id": "9220e3e8-8b88-36fd-90a9-6a1d75f08a2e",
                        "source_sense_id": "1b73bbb2-b88e-3f07-b1f9-004af397d9b8",
                        "source_sense_description": "een chemisch element en een inert edelgas",
                        "target_lang_word": "helium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "helium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf6319f3-39fa-36ed-b695-d7dc8071e7a2",
                                        "entry_id": "d3cd93cf-266f-3341-b469-d3bdf402daaa",
                                        "glosses": [
                                            "The second-lightest chemical element (symbol He), with an atomic number of 2 and atomic weight of 4.002602, a colorless, odorless and inert noble gas."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f71e4c7-9c91-4cda-bd6d-bd697c28bfc9",
                                                "sense_id": "cf6319f3-39fa-36ed-b695-d7dc8071e7a2",
                                                "text": "It was an enormous balloon filled with helium, that elemental gas forged from hydrogen in the nuclear furnace of the stars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e7d5ffb-d110-3176-a058-ec2303ff1323",
                                        "entry_id": "d3cd93cf-266f-3341-b469-d3bdf402daaa",
                                        "glosses": [
                                            "A form or sample of the element."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b814e819-62fe-4494-9dab-4741fb31aba6",
                        "source_entry_id": "9220e3e8-8b88-36fd-90a9-6a1d75f08a2e",
                        "source_sense_id": "1b73bbb2-b88e-3f07-b1f9-004af397d9b8",
                        "source_sense_description": "een chemisch element en een inert edelgas",
                        "target_lang_word": "hélium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hélium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89623d39-016d-3959-9891-2eb29c9e606d",
                                        "entry_id": "a50f50eb-6dc2-3e2c-94b3-1b6c50aebf28",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 2 et de symbole He qui fait partie à la série de gaz nobles."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a9af572-2634-40c4-a80d-00c5bd5bf1c0",
                                                "sense_id": "89623d39-016d-3959-9891-2eb29c9e606d",
                                                "text": "L’hélium est le deuxième élément le plus abondant de l’Univers. Trop léger, l’hélium primordial, surtout constitué d’hélium 3 (3He), a échappé à l’attraction terrestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae23404-4000-373a-9684-3b56aa22372e",
                                        "entry_id": "a50f50eb-6dc2-3e2c-94b3-1b6c50aebf28",
                                        "glosses": [
                                            "Corps simple gazeux monoatomique incolore, inodore, insipide et ininflammable. Il est en outre très léger et en pratique chimiquement inerte."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5d36fa8-3dbc-4b40-84fd-0c6daa393827",
                                                "sense_id": "fae23404-4000-373a-9684-3b56aa22372e",
                                                "text": "Conçu pour être gonflé à l’hélium, le grand dirigeable traversera l’Atlantique avec de classiques ballonnets d’hydrogène qui seront démontés à son arrivée aux États-Unis."
                                            },
                                            {
                                                "example_id": "225bbf33-fc4d-40c6-949f-9a5f8a8261fd",
                                                "sense_id": "fae23404-4000-373a-9684-3b56aa22372e",
                                                "text": "En plongée commerciale et militaire, ils ont su depuis longtemps que l’ajout d’hélium au gaz respiré présentait d'énormes avantages physiologiques pour un plongeur travaillant en profondeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2753494b-9219-3c94-a749-6430af60d016",
                                        "entry_id": "a50f50eb-6dc2-3e2c-94b3-1b6c50aebf28",
                                        "glosses": [
                                            "(Rare) (Chimie physique) Atome d’hélium. S’il s’agit de noyaux sans leur escorte d’électrons, on parlera plutôt d’hélions.\\n#* Le détecteur est capable de réagir à une concentration aussi faible que dix héliums par mètre cube."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f69d5847-a3cd-4b9f-9fcc-1441d92cd62b",
                        "source_entry_id": "9220e3e8-8b88-36fd-90a9-6a1d75f08a2e",
