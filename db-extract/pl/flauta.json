                                                "sense_id": "acaf06bd-daa5-3e2d-ae89-1de6ec4d3776",
                                                "text": "to calm a crying baby"
                                            },
                                            {
                                                "example_id": "b166ffbb-e910-40f4-a806-d3c623f9752c",
