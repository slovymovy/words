                                        "glosses": [
                                            "The date by which it is advised that a perishable product be consumed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca59327-d26a-4732-8c84-1f96b7692f13",
                                                "sense_id": "d0b9f458-4464-3788-a641-12f59455c3cf",
                                                "text": "The 2023-24 winter has come and gone without a whisper of when the cork will come out of the bottle regarding an announcement about replacing the ailing 1972 Stock, which is now 15 years past its use-by date."
                                            }
