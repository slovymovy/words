                "senses": [
                    {
                        "sense_id": "23ed5f0b-a3d0-3501-bcd9-5d75a1bae9d7",
                        "entry_id": "61bbd20b-81e6-304a-bd4e-a47fa94ca845",
                        "glosses": [
                            "To unhand, release from one's grasp, let go of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "22599263-f687-4142-801f-ec5715c8ed49",
                                "sense_id": "23ed5f0b-a3d0-3501-bcd9-5d75a1bae9d7",
                                "text": "The unrefuted accusation had also been a libel on yourselves, whose great intelligence has unholden Maga in so unprecedented a degree, and who monthly devour the astonishing number of six and thirty thousand of her copies."
                            },
                            {
                                "example_id": "d3d3a2d3-9641-4542-a677-9714df3eef87",
                                "sense_id": "23ed5f0b-a3d0-3501-bcd9-5d75a1bae9d7",
                                "text": "For each man has the same problem — women — how to hold them when you want to hold them — how to unhold them when you want to unhold."
                            },
                            {
                                "example_id": "2c45ef66-26fc-4631-a609-667b52f5f629",
                                "sense_id": "23ed5f0b-a3d0-3501-bcd9-5d75a1bae9d7",
                                "text": "I unheld my ears. It wasn't all that yucky."
                            },
                            {
                                "example_id": "bad9d4ad-fa36-4b12-8495-154ee3ac102a",
                                "sense_id": "23ed5f0b-a3d0-3501-bcd9-5d75a1bae9d7",
                                "text": "Say the love, create the romance, fizz out the anger or walk away the way your heart wishes... Life is simple as we listen daily but only when we un-hold the load... Everything is changing around you and you also can't escape the change."
                            }
                        ]
                    },
