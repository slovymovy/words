{
    "word_family": [
        "superstition",
        "superstitieusement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "807e0c0f-1179-3cc7-825a-00e82db6d6ea",
                    "sense_definition": "Qui croit aux superstitions ou craint des influences surnaturelles et des présages.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "croyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère refuse de passer sous une échelle parce qu'il est très <w>superstitieux</w>."
                        },
                        {
                            "text": "Elle n'est pas particulièrement <w>superstitieuse</w>, mais elle évite de croiser un chat noir."
                        }
                    ],
                    "synonyms": [
                        "crédule"
                    ],
                    "antonyms": [
                        "rationnel"
                    ],
                    "common_phrases": [
                        "être superstitieux"
                    ]
                },
                {
                    "sense_id": "0775b802-9829-35c0-bc53-101c36098165",
                    "sense_definition": "Qui relève de la superstition ou en est empreint.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "croyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces coutumes locales reposent sur une croyance <w>superstitieuse</w> transmise de génération en génération."
                        },
                        {
                            "text": "Une terreur <w>superstitieuse</w> s'empara des habitants lorsqu'ils entendirent les bruits nocturnes dans les ruines."
                        }
                    ],
                    "antonyms": [
                        "rationnel"
                    ],
                    "common_phrases": [
                        "croyance superstitieuse",
                        "peur superstitieuse",
                        "terreur superstitieuse"
                    ]
                },
                {
                    "sense_id": "5678894e-ea67-3ea9-b0c7-6ecbcd40ef28",
                    "sense_definition": "Qui manifeste un respect ou un attachement scrupuleux et excessif à quelque chose.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet artisan conserve un respect <w>superstitieux</w> pour les anciennes méthodes de fabrication manuelle."
                        },
                        {
                            "text": "Il accordait une attention presque <w>superstitieuse</w> à l'accomplissement des moindres détails du protocole."
                        }
                    ],
                    "synonyms": [
                        "scrupuleux",
                        "pointilleux"
                    ],
                    "common_phrases": [
                        "respect superstitieux",
                        "attachement superstitieux"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30939592-c1fc-3719-9f74-ed9b96b01b60",
                    "sense_definition": "Personne qui croit aux superstitions ou aux présages surnaturels.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "croyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>superstitieux</w> pensent souvent que briser un miroir apporte sept ans de malheur."
                        },
                        {
                            "text": "Face aux prédictions inquiétantes de la voyante, le <w>superstitieux</w> préféra annuler son voyage."
                        }
                    ]
                }
            ]
        }
    ]
}