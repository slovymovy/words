                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бернер",
                                "target_lang_sense_clarification": "участник Burning Man"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07cdf2dd-59ef-3108-a5c6-4aaa25ee8ec7",
                    "sense_definition": "A hardware device used to record data onto optical discs like CDs or DVDs.",
