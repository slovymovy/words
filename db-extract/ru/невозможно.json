        "ru-extract.jsonl": [
            {
                "entry_id": "af0c44f8-1895-36b5-abcf-b6be63df54db",
                "word": "невозможно",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fad389ff-6831-37ff-8606-ed67881abe4e",
                        "entry_id": "af0c44f8-1895-36b5-abcf-b6be63df54db",
                        "glosses": [
                            "о ситуации, представляющейся невозможной, недопустимой, неосуществимой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f79ec68-53f1-4581-9d33-2e5457d713a8",
                                "sense_id": "fad389ff-6831-37ff-8606-ed67881abe4e",
                                "text": "Оставаться долее в Петербурге было, разумеется, невозможно, тем более что и Степана Трофимовича постигло окончательное fiasco."
                            },
                            {
                                "example_id": "6dd640b6-2438-4818-b779-65c934e478f9",
                                "sense_id": "fad389ff-6831-37ff-8606-ed67881abe4e",
                                "text": "— Вы точно хотите идти теперь к маме со мною? к маме, которая уверяет, что…что все это между нами невозможно — и никогда сбыться не может?"
                            }
                        ]
                    },
                    {
                        "sense_id": "36402386-8602-31a2-87e9-a4851222d70a",
                        "entry_id": "af0c44f8-1895-36b5-abcf-b6be63df54db",
                        "glosses": [
                            "о трудности или невозможности терпеть, выносить что-либо; невыносимо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "889cd7d1-af70-4f15-937d-27aaac2e6786",
                                "sense_id": "36402386-8602-31a2-87e9-a4851222d70a",
                                "text": "Обыкновенно вся семья сидит полуголая вокруг огня, разложенного посредине шалаша, до того наполненного дымом, что с непривычки почти невозможно открыть глаза."
                            }
                        ]
                    },
                    {
                        "sense_id": "8702e5a6-9245-3639-bf17-d1f08f93669e",
                        "entry_id": "af0c44f8-1895-36b5-abcf-b6be63df54db",
                        "glosses": [
                            "перен. оценочная характеристика чего-либо как необыкновенного, чрезвычайного, исключительного по силе проявления"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d745a830-3cc5-31ea-80ef-23744086cd16",
                        "entry_id": "af0c44f8-1895-36b5-abcf-b6be63df54db",
                        "glosses": [
                            "запрещено, запрещается; нельзя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "776cb91a-ff53-4d91-90e8-876dc2fb7337",
                                "sense_id": "d745a830-3cc5-31ea-80ef-23744086cd16",
                                "text": "Отрицать чье бы то ни было право на еду невозможно."
                            },
                            {
                                "example_id": "98642026-11ae-451c-9362-8888f29bea94",
                                "sense_id": "d745a830-3cc5-31ea-80ef-23744086cd16",
                                "text": "Не слушать отца — невозможно: он, пожалуй, употребит насилие, будет бить тебя…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4293b3b-ca60-4caf-befa-1a3c4cb045f1",
                        "source_entry_id": "af0c44f8-1895-36b5-abcf-b6be63df54db",
                        "source_sense_description": "наречие",
                        "target_lang_word": "impossibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impossibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35d7dab8-d1c0-3813-8540-c5fdff0da095",
                                        "entry_id": "414e70d0-3649-3fd5-9bf8-a9fa3653304e",
                                        "glosses": [
                                            "Not possibly; in an impossible manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1658b198-191c-30da-8e85-857e4b697f39",
                                        "entry_id": "414e70d0-3649-3fd5-9bf8-a9fa3653304e",
                                        "glosses": [
                                            "To the point of impossibility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d3f0cb5-9ea1-4135-a0a0-253188b59f6a",
                                                "sense_id": "1658b198-191c-30da-8e85-857e4b697f39",
                                                "text": "The topology problem was impossibly difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7358267-f8ec-38b7-9183-382e7ef83359",
                                        "entry_id": "414e70d0-3649-3fd5-9bf8-a9fa3653304e",
                                        "glosses": [
                                            "Contrary to what had been thought possible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84dc0ca9-abbe-4ddd-9dd1-f8e54ae1595e",
                                                "sense_id": "d7358267-f8ec-38b7-9183-382e7ef83359",
                                                "text": "Impossibly, after the water receded, the cat was found asleep on a chair jammed in a tree."
                                            },
                                            {
                                                "example_id": "e5d2b9d0-ec0b-42f8-8ac7-8e3a1f857899",
                                                "sense_id": "d7358267-f8ec-38b7-9183-382e7ef83359",
                                                "text": "ANDRÉ SARAIVA, the slight 35-year-old graffitist and night-life entrepreneur, showed up at the Emmanuel Perrotin gallery in the Marais on a recent Saturday night in his trademark impossibly skinny jeans and a navy Thom Browne peacoat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99abc006-f119-42f8-9b2d-cca408b1e58b",
                        "source_entry_id": "af0c44f8-1895-36b5-abcf-b6be63df54db",
                        "source_sense_description": "наречие",
                        "target_lang_word": "unmöglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmöglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "695b16b2-dd18-31b7-95f0-4417a86d7726",
                                        "entry_id": "35d93d23-ce6a-3303-9d18-d1002463c3f1",
                                        "glosses": [
                                            "nicht machbar, undurchführbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bfab9f1-e3d5-4eec-81db-76d233a0e014",
                                                "sense_id": "695b16b2-dd18-31b7-95f0-4417a86d7726",
                                                "text": "Es ist unmöglich, diese schwierige Aufgabe in so kurzer Zeit zu lösen."
                                            },
                                            {
                                                "example_id": "75b5d9f0-673d-4f89-ae50-e404721cb894",
                                                "sense_id": "695b16b2-dd18-31b7-95f0-4417a86d7726",
                                                "text": "„Die Bank zu steuern, das scheint fast unmöglich. […] Sein Job [als Chef] wird aber noch unmöglicher, wenn eine weitere Bank dazukommt.“"
                                            },
                                            {
                                                "example_id": "983bd214-1ee0-4973-8ce2-cce81a2c9a93",
                                                "sense_id": "695b16b2-dd18-31b7-95f0-4417a86d7726",
                                                "text": "„Der englische Jurist, der mit der Entscheidung über den Grenzverlauf beauftragt wurde, Sir Cyril Radcliffe, war nie zuvor in Indien gewesen, hatte für seine unmögliche Aufgabe fünf Wochen Zeit und bekam keine Gelegenheit, die betroffenen Landstriche selbst zu besichtigen.“"
                                            },
                                            {
                                                "example_id": "50681bf6-312d-48ee-bab9-877da2143cbd",
                                                "sense_id": "695b16b2-dd18-31b7-95f0-4417a86d7726",
                                                "text": "[Chemie:] Eine Elementumwandlung, zum Beispiel von Gold aus Blei, wie es sie Alchimisten früher oft versuchten, ist mit chemischen Mittel unmöglich."
                                            },
                                            {
                                                "example_id": "bfbf775c-e9a3-4f44-9185-11eb619444b7",
                                                "sense_id": "695b16b2-dd18-31b7-95f0-4417a86d7726",
                                                "text": "„Es wird immer unmöglicher, schlafen zu gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3f17f0d-2609-3c23-9c9e-d61d1f3a0e31",
                                        "entry_id": "35d93d23-ce6a-3303-9d18-d1002463c3f1",
                                        "glosses": [
                                            "unduldbar, unentschuldbar, nicht akzeptabel, unpassend"
                                        ],
                                        "tags": [
                                            "personenbezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe84a554-4c07-40e7-99d0-83e70a5c901c",
                                                "sense_id": "a3f17f0d-2609-3c23-9c9e-d61d1f3a0e31",
                                                "text": "Du siehst mit diesem Hut wieder einmal unmöglich aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e5cefab7-77b0-3a41-a7df-b81bf956e989",
                                        "entry_id": "35d93d23-ce6a-3303-9d18-d1002463c3f1",
                                        "glosses": [
                                            "unwahrscheinlich, nicht vorstellbar, seltsam, merkwürdig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aeac6a3-f1d9-4470-b378-a1be10e92dd4",
                                                "sense_id": "e5cefab7-77b0-3a41-a7df-b81bf956e989",
                                                "text": "An der Fundstelle fanden sich alle möglichen und unmöglichen Gegenstände."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
