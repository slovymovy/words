        "nl-extract.jsonl": [
            {
                "entry_id": "f4916d33-4a54-3ed6-82a6-cbce6b760c20",
                "word": "muziekkorps",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "93449186-0b64-4b29-91ec-b0a993467701",
                        "entry_id": "f4916d33-4a54-3ed6-82a6-cbce6b760c20",
                        "tags": [
                            "plural"
                        ],
                        "form": "muziekkorpsen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8b13602-703f-3d8a-9710-a3c72f545aa8",
                        "entry_id": "f4916d33-4a54-3ed6-82a6-cbce6b760c20",
                        "glosses": [
                            "orkest met slagwerkers en koperblazers waarbij de leden een uniform dragen en marcherend muziek kunnen uitvoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799ef3d4-e88b-4ec7-9bc9-ca2410c4773c",
                                "sense_id": "a8b13602-703f-3d8a-9710-a3c72f545aa8",
                                "text": "Tijdens de carnavalsoptocht in het dorp speelde het fanfare muziekkorps van de schutterij een vrolijk deuntje."
                            },
                            {
                                "example_id": "39451e59-2e4f-4617-ba4d-7efb33c2c797",
                                "sense_id": "a8b13602-703f-3d8a-9710-a3c72f545aa8",
                                "text": "Tijdens ROTC (‘Reserve Officers’ Training Corps’), meestal een schoolvak als een ander, krijgen jongeren niet alleen les over de strijdkrachten, maar leren ze eveneens omgaan met wapens en nemen ze deel aan activiteiten als valschermspringen. De middelbare scholieren, allemaal netjes in uniform, marcheerden dus in groten getale mee in de Veterans Dayparade, soms gewapend met sabels en geweren. De ROTC-afdelingen van de meeste scholen hadden hun eigen muziekkorps bij, terwijl de leerlingen van andere afdelingen luidkeels zongen om de cadans in de pas te handhaven:"
                            },
                            {
                                "example_id": "671617fc-241e-44d9-ade7-5daac4b9abcb",
                                "sense_id": "a8b13602-703f-3d8a-9710-a3c72f545aa8",
                                "text": "\"Pas als de kanonnen zwijgen begint de slag\", legt Pim Jonkers uit Amsterdam even later uit. \"Dan valt de infanterie met de cavalerie aan de flanken de vijand aan. Vaak vormen de soldaten carrés (vierkanten) om de muzikanten en commandanten te beschermen.\" Korporaal Jonkers staat trots afgebeeld op een spelkaart uit het kwartet dat het bestuur van het Historisch Festival dit jaar liet drukken. Jonkers was trompetten bij een muziekkorps en kwam via vrienden bij de re-enactors terecht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30a8c3b6-0cf4-465b-a83e-1dbda5c878f2",
                        "source_entry_id": "f4916d33-4a54-3ed6-82a6-cbce6b760c20",
                        "source_sense_id": "a8b13602-703f-3d8a-9710-a3c72f545aa8",
                        "source_sense_description": "(muziek) orkest met slagwerkers en koperblazers waarbij de leden een uniform dragen en marcherend muziek kunnen uitvoeren",
                        "target_lang_word": "marching band",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marching band",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64ead8d8-1831-3192-a1f8-8368595f1c43",
                                        "entry_id": "de5b0b4a-3dbd-3dc5-91ad-c7fb947ed0c1",
                                        "glosses": [
                                            "A group of instrumental musicians who generally perform outdoors, and who often incorporate movement, usually some type of marching, with their musical performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a023f6e-6ecc-4174-a673-947ba4fe7ab4",
                                                "sense_id": "64ead8d8-1831-3192-a1f8-8368595f1c43",
                                                "text": "No, republicans did not celebrate; they took their placards and their yellow T-shirts to Trafalgar Square, where their voices could (almost) be heard against a backdrop of marching bands and pealing bells."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
