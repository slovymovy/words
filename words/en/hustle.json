{
    "word_family": [
        "hustler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dda54aa5-cccb-32f2-b523-611e34169bd3",
                    "sense_definition": "To work with great energy and effort to achieve a goal.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "work_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He really had to <w>hustle</w> to get the project finished on time.",
                            "target_lang_translations": {
                                "ru": "Ему действительно пришлось <w>посуетиться</w>, чтобы закончить проект вовремя.",
                                "zh": "为了按时完成项目，他真的必须<w>拼搏</w>一番。",
                                "nl": "Hij moest echt <w>zwoegen</w> om het project op tijd af te krijgen."
                            }
                        },
                        {
                            "text": "They <w>hustled</w> all summer to save enough money for the trip.",
                            "target_lang_translations": {
                                "ru": "Они <w>вкалывали</w> все лето, чтобы накопить достаточно денег на поездку.",
                                "zh": "他们整个夏天都在<w>忙碌</w>，以便攒够旅行的钱。",
                                "nl": "Ze hebben de hele zomer <w>hard gewerkt</w> om genoeg geld voor de reis te sparen."
                            }
                        }
                    ],
                    "synonyms": [
                        "labor"
                    ],
                    "antonyms": [
                        "slack off",
                        "laze"
                    ],
                    "common_phrases": [
                        "hustle hard",
                        "hustle for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать с большой энергией и усилием для достижения цели.",
                        "zh": "为了实现目标而以极大的精力和努力工作。",
                        "nl": "Met grote energie en inzet werken om een doel te bereiken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкалывать",
                                "target_lang_sense_clarification": "усердно, энергично работать ради цели"
                            },
                            {
                                "target_lang_word": "суетиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拼搏",
                                "target_lang_sense_clarification": "为了达到目的而努力奋斗"
                            },
                            {
                                "target_lang_word": "忙碌",
                                "target_lang_sense_clarification": "为了某事而奔波忙碌"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zwoegen",
                                "target_lang_sense_clarification": "hard en intensief werken"
                            },
                            {
                                "target_lang_word": "zich uit de naad werken",
                                "target_lang_sense_clarification": "idiomatisch voor zeer hard werken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "243327b6-8149-3e62-b0d9-031401d9c858",
                    "sense_definition": "To move or act with speed and urgency.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speed_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>hustle</w> if we want to catch the last train.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>поторопиться</w>, если мы хотим успеть на последний поезд.",
                                "zh": "如果我们想赶上末班车，就得<w>赶快</w>。",
                                "nl": "We moeten <w>opschieten</w> als we de laatste trein willen halen."
                            }
                        },
                        {
                            "text": "The waiters <w>hustled</w> around the busy restaurant serving customers.",
                            "target_lang_translations": {
                                "ru": "Официанты <w>суетились</w> по переполненному ресторану, обслуживая клиентов.",
                                "zh": "服务员在繁忙的餐厅里<w>匆忙</w>地穿梭，为顾客提供服务。",
                                "nl": "De obers <w>renden</w> door het drukke restaurant om klanten te bedienen."
                            }
                        }
                    ],
                    "synonyms": [
                        "rush",
                        "make tracks",
                        "fly"
                    ],
                    "antonyms": [
                        "dawdle",
                        "linger"
                    ],
                    "common_phrases": [
                        "hustle up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или действовать быстро и безотлагательно.",
                        "zh": "快速且紧急地行动。",
                        "nl": "Zich met spoed of haast verplaatsen of handelen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спешить",
                                "target_lang_sense_clarification": "действовать быстро, чтобы успеть"
                            },
                            {
                                "target_lang_word": "торопиться",
                                "target_lang_sense_clarification": "стараться делать что-либо быстрее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赶快",
                                "target_lang_sense_clarification": "抓紧时间行动"
                            },
                            {
                                "target_lang_word": "匆忙",
                                "target_lang_sense_clarification": "动作迅速地做某事"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "opschieten",
                                "target_lang_sense_clarification": "haast maken"
                            },
                            {
                                "target_lang_word": "zich haasten",
                                "target_lang_sense_clarification": "snel handelen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82f25e72-aafc-348c-b2a3-1287b7dab230",
                    "sense_definition": "To deceive or cheat someone, especially to get money from them.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>hustle</w> me into buying a fake watch.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>развести</w> меня на покупку поддельных часов.",
                                "zh": "他试图<w>忽悠</w>我买一块假表。",
                                "nl": "Hij probeerde me te <w>beduvelen</w> om een nep horloge te kopen."
                            }
                        },
                        {
                            "text": "Don't let them <w>hustle</w> you out of your savings.",
                            "target_lang_translations": {
                                "ru": "Не позволяй им <w>выманить</w> у тебя твои сбережения.",
                                "zh": "别让他们<w>诈骗</w>走你的积蓄。",
                                "nl": "Laat je niet <w>oplichten</w> en je spaargeld afhandig maken."
                            }
                        }
                    ],
                    "synonyms": [
                        "swindle",
                        "defraud",
                        "deceive"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманывать или мошенничать, особенно с целью получения денег.",
                        "zh": "欺骗或诈骗某人，特别是为了骗取钱财。",
                        "nl": "Iemand bedriegen of oplichten, vooral om geld afhandig te maken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надуть",
                                "target_lang_sense_clarification": "разг. обмануть, провести"
                            },
                            {
                                "target_lang_word": "раскрутить",
                                "target_lang_sense_clarification": "разг. обманом заставить потратить деньги"
                            },
                            {
                                "target_lang_word": "обманывать",
                                "target_lang_sense_clarification": "вводить в заблуждение, поступать нечестно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诈骗",
                                "target_lang_sense_clarification": "以欺骗手段获取钱财"
                            },
                            {
                                "target_lang_word": "忽悠",
                                "target_lang_sense_clarification": "口语，指用言语欺骗他人"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "oplichten",
                                "target_lang_sense_clarification": "bedriegen voor geld"
                            },
                            {
                                "target_lang_word": "beduvelen",
                                "target_lang_sense_clarification": "informeel voor bedriegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ca77ba4-6f99-3c76-9f10-20c57a086538",
                    "sense_definition": "To push or shove someone roughly, often to make them move.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_push",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guards <w>hustled</w> the protesters out of the building.",
                            "target_lang_translations": {
                                "ru": "Охранники <w>вытолкали</w> протестующих из здания.",
                                "zh": "保安把抗议者<w>推搡</w>出了大楼。",
                                "nl": "De beveiligers <w>duwden</w> de demonstranten het gebouw uit."
                            }
                        },
                        {
                            "text": "She was <w>hustled</w> into a waiting car before the reporters could ask questions.",
                            "target_lang_translations": {
                                "ru": "Её <w>запихнули</w> в ожидающую машину, прежде чем репортеры успели задать вопросы.",
                                "zh": "在记者提问前，她就被<w>推</w>进了一辆等候的车里。",
                                "nl": "Ze werd een wachtende auto in <w>geduwd</w> voordat de verslaggevers vragen konden stellen."
                            }
                        }
                    ],
                    "synonyms": [
                        "pimp",
                        "pimp out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубо толкать или пихать кого-либо, часто заставляя двигаться.",
                        "zh": "粗暴地推搡某人，通常是为了强迫其移动。",
                        "nl": "Iemand ruw duwen of trekken, vaak om diegene te dwingen zich te verplaatsen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выталкивать",
                                "target_lang_sense_clarification": "грубо толкать, заставляя двигаться"
                            },
                            {
                                "target_lang_word": "запихивать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推搡",
                                "target_lang_sense_clarification": "用力推挤"
                            },
                            {
                                "target_lang_word": "驱赶",
                                "target_lang_sense_clarification": "强迫某人离开"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "naar buiten duwen",
                                "target_lang_sense_clarification": "iemand dwingend verplaatsen"
                            },
                            {
                                "target_lang_word": "afvoeren",
                                "target_lang_sense_clarification": "onder dwang meenemen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e12c3dbd-d523-3cc4-9e96-ccccd6b41c50",
                    "sense_definition": "To work as a prostitute or pimp.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "prostitution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years <w>hustling</w> on the streets of the city.",
                            "target_lang_translations": {
                                "ru": "Он провел годы, <w>торгуя телом</w> на улицах города.",
                                "zh": "他多年来一直在这座城市的街头<w>卖淫</w>为生。",
                                "nl": "Hij bracht jaren door met <w>prostitutie</w> op de straten van de stad."
                            }
                        },
                        {
                            "text": "She had to <w>hustle</w> to survive during those difficult times.",
                            "target_lang_translations": {
                                "ru": "Ей приходилось <w>заниматься проституцией</w>, чтобы выжить в те трудные времена.",
                                "zh": "在那些艰难的日子里，她不得不<w>卖淫</w>以求生存。",
                                "nl": "Ze moest <w>in de prostitutie werken</w> om te overleven in die moeilijke tijden."
                            }
                        }
                    ],
                    "synonyms": [
                        "turn tricks",
                        "prostitute oneself"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься проституцией.",
                        "zh": "从事卖淫或拉皮条。",
                        "nl": "Werken als prostituee of pooier."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься проституцией",
                                "target_lang_sense_clarification": "работать проституткой или сутенёром"
                            },
                            {
                                "target_lang_word": "торговать телом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卖淫",
                                "target_lang_sense_clarification": "以出卖肉体为生"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "in de prostitutie werken",
                                "target_lang_sense_clarification": "het beroep uitoefenen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d465f751-0f07-3dfb-b5f8-d1eb32e95847",
                    "sense_definition": "A state of busy, noisy activity and excitement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "speed_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I enjoy the <w>hustle</w> and bustle of living in a big city.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>суета</w> и шум жизни в большом городе.",
                                "zh": "我喜欢大城市生活的<w>喧嚣</w>。",
                                "nl": "Ik geniet van de <w>drukte</w> van het wonen in een grote stad."
                            }
                        },
                        {
                            "text": "There was a lot of <w>hustle</w> in the office before the deadline.",
                            "target_lang_translations": {
                                "ru": "В офисе было много <w>суеты</w> перед дедлайном.",
                                "zh": "截止日期前，办公室里一片<w>忙乱</w>。",
                                "nl": "Er was veel <w>reuring</w> op kantoor voor de deadline."
                            }
                        }
                    ],
                    "synonyms": [
                        "rush"
                    ],
                    "antonyms": [
                        "quiet",
                        "stillness"
                    ],
                    "common_phrases": [
                        "hustle and bustle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние шумной деятельности, оживления и суматохи.",
                        "zh": "一种繁忙、嘈杂且令人兴奋的状态。",
                        "nl": "Een toestand van drukke, luidruchtige activiteit en opwinding."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суета",
                                "target_lang_sense_clarification": "торопливые, беспорядочные действия"
                            },
                            {
                                "target_lang_word": "сутолока",
                                "target_lang_sense_clarification": "беспорядочное движение, суматоха"
                            },
                            {
                                "target_lang_word": "толкотня",
                                "target_lang_sense_clarification": "теснота, давка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喧嚣",
                                "target_lang_sense_clarification": "嘈杂且繁忙的景象"
                            },
                            {
                                "target_lang_word": "忙乱",
                                "target_lang_sense_clarification": "繁忙而混乱的状态"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "drukte",
                                "target_lang_sense_clarification": "algemene staat van activiteit"
                            },
                            {
                                "target_lang_word": "reuring",
                                "target_lang_sense_clarification": "levendige drukte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc3d7e9e-1b8c-3833-9974-f9f94f68dc2a",
                    "sense_definition": "Energetic effort and the determination to work hard to succeed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "work_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a lot of <w>hustle</w> and is sure to go far in her career.",
                            "target_lang_translations": {
                                "ru": "У неё есть <w>хватка</w>, и она наверняка далеко пойдет в своей карьере.",
                                "zh": "她很有<w>干劲</w>，事业一定会大有前途。",
                                "nl": "Ze heeft veel <w>gedrevenheid</w> en zal zeker ver komen in haar carrière."
                            }
                        },
                        {
                            "text": "The coach admired the player's <w>hustle</w> on the field.",
                            "target_lang_translations": {
                                "ru": "Тренер восхищался <w>самоотдачей</w> игрока на поле.",
                                "zh": "教练很欣赏这位球员在场上的<w>进取心</w>。",
                                "nl": "De coach bewonderde de <w>werklust</w> van de speler op het veld."
                            }
                        }
                    ],
                    "synonyms": [
                        "labor"
                    ],
                    "antonyms": [
                        "laziness",
                        "indolence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергичные усилия и решимость много работать ради успеха; пробивная сила.",
                        "zh": "为取得成功而付出的精力与决心；进取心。",
                        "nl": "Energieke inzet en de vastberadenheid om hard te werken voor succes."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хватка",
                                "target_lang_sense_clarification": "энергичность, напор, самоотдача"
                            },
                            {
                                "target_lang_word": "напор"
                            }
                        ],
                        "zh": [
                            {
