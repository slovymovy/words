                "senses": [
                    {
                        "sense_id": "732bfcc0-1252-307f-b363-2a001564e148",
                        "entry_id": "ed795f6f-d116-3858-808a-c93b6e982f12",
                        "glosses": [
                            "Variante, bei der in der Erbinformation zwei Mutationen (gegenüber einer früheren Variante oder dem Wildtyp) vorliegen"
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "6bc28d85-bc89-495f-a3bf-30b6ee0ee24e",
                                "sense_id": "732bfcc0-1252-307f-b363-2a001564e148",
                                "text": "„Zumindest im Falle der Doppelmutante sh bz - m4 ist es offensichtlich, daß eine Deletion vorliegt.“ (1982)"
                            },
                            {
                                "example_id": "c71034a1-241c-4edb-9a7f-3dbc070959d9",
                                "sense_id": "732bfcc0-1252-307f-b363-2a001564e148",
                                "text": "„Die Mutante 48 wird durch den Suppressor Sa supprimiert, die Mutante 35 aber nicht durch Sa, sondern nur durch andere Supersuppressoren. Es konnte durch intragenische Rekombination eine Doppelmutante 35—48 hergestellt werden.“ (1970)"
                            },
                            {
                                "example_id": "4c621940-fe53-4ad5-8f4d-8cccbe58f2c8",
                                "sense_id": "732bfcc0-1252-307f-b363-2a001564e148",
                                "text": "„Wie verbreitet ist die indische Doppelmutante bereits?“ (2021)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
