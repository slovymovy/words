                    {
                        "form_id": "516b2388-3753-4245-9bf2-2b3f74a6da1a",
                        "entry_id": "da8cc4a8-86ed-32b2-9dda-17cfa5a5bc4f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Magendrücken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54304a9c-3ab3-3c6c-862a-b2f9cf2f9c5d",
                        "entry_id": "da8cc4a8-86ed-32b2-9dda-17cfa5a5bc4f",
                        "glosses": [
                            "Schmerzgefühl im Bauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db89da69-c8cf-4f01-ab57-5d988e926dc6",
                                "sense_id": "54304a9c-3ab3-3c6c-862a-b2f9cf2f9c5d",
                                "text": "„Wenn das Magendrücken länger als einige Tage anhält oder ständig wiederkehrt, gehen Sie bitte zum Arzt.“"
                            },
                            {
                                "example_id": "345a1a6f-11c0-4379-b871-eb98fed69446",
                                "sense_id": "54304a9c-3ab3-3c6c-862a-b2f9cf2f9c5d",
                                "text": "„Viele hart gesottene Eier werden sehr gut verdaut, brauchen aber noch lange nicht bekömmlich zu sein (da sie meist Magendrücken verursachen).“"
                            },
                            {
                                "example_id": "a8ae500a-f083-4d80-91d3-872ef2f19a42",
                                "sense_id": "54304a9c-3ab3-3c6c-862a-b2f9cf2f9c5d",
                                "text": "„Symptome wie Kopfschmerzen, Magendrücken und Darmstörungen kündigen Erschöpfungszustände wie Burn-out und Depressionen an: Rund 26 500 KKH-Versicherte im Alter von sechs bis 18 Jahren sind bundesweit betroffen.“"
                            },
                            {
                                "example_id": "aa836d03-fe4c-4baf-8e49-1d7c7bd92ba7",
                                "sense_id": "54304a9c-3ab3-3c6c-862a-b2f9cf2f9c5d",
                                "text": "„Gegen Verdauungsstörungen im Magen selbst als Magendrücken, Sodbrennen oder Magenkrampf, ist nichts besser als doppeltkohlenjaures Natron.“"
                            },
                            {
                                "example_id": "47b7b704-bdfb-4dbc-be0b-326313582b39",
                                "sense_id": "54304a9c-3ab3-3c6c-862a-b2f9cf2f9c5d",
                                "text": "„An Verstopfung leidet er auch jetzt noch, dieselbe ist aber nicht so hartnäckig wie vorher; das Magendrücken ist gänzlich beseitigt.“"
                            },
                            {
                                "example_id": "547633d2-789b-4587-aba2-d3de341cbbc5",
                                "sense_id": "54304a9c-3ab3-3c6c-862a-b2f9cf2f9c5d",
                                "text": "„Nach dem Frühstück stellten sich Übelkeit, Magendrücken von Schmerz begleitet und zwei halbflüssige, dunkelgelb gefärble, nicht kopiöse Stublentleerungen ein.“"
                            },
                            {
                                "example_id": "6e5f59d0-2ce2-47eb-bd0b-bfe88106cbd3",
                                "sense_id": "54304a9c-3ab3-3c6c-862a-b2f9cf2f9c5d",
                                "text": "„Nach dem Frühstück stellten sich Uebelkeit, Magendrücken von Schmerz begleitet und 2 halbflüssige, dunkelgelbgefärbte nicht copiöse Stuhlentleerungen ein.“"
                            },
                            {
                                "example_id": "8e341ee7-fd07-4a68-8f95-1d8a52c9285e",
                                "sense_id": "54304a9c-3ab3-3c6c-862a-b2f9cf2f9c5d",
                                "text": "„Bei leichten Beschwerden wie Schnupfen oder Magendrücken greifen viele zu pflanzlichen Hausmitteln.“"
                            },
                            {
                                "example_id": "bd06aefa-c4cc-4a73-a8ff-2bb728d6d86b",
                                "sense_id": "54304a9c-3ab3-3c6c-862a-b2f9cf2f9c5d",
                                "text": "„Allein beim Gedanken an eine Fahrt auf der Autobahn wurde mir schlecht, ich bekam Herzflattern, Magendrücken, Schweißausbrüche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f28b4e18-bec9-35a4-9b3a-170a931cd0ac",
                        "entry_id": "da8cc4a8-86ed-32b2-9dda-17cfa5a5bc4f",
                        "glosses": [
                            "unangenehmes Gefühl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6aaf50e-909a-442d-9d39-b01564cc440b",
                                "sense_id": "f28b4e18-bec9-35a4-9b3a-170a931cd0ac",
                                "text": "„Allein beim Gedanken an eine Fahrt auf der Autobahn wurde mir schlecht, ich bekam Herzflattern, Magendrücken, Schweißausbrüche.“"
                            },
                            {
                                "example_id": "835095a9-43c5-4cd9-ae9c-b4e6bf17be9c",
                                "sense_id": "f28b4e18-bec9-35a4-9b3a-170a931cd0ac",
                                "text": "„Gefühle zu unterdrücken sorgt auch im echten Leben für viel Magendrücken […].“"
                            },
                            {
                                "example_id": "a94dabea-c85f-4571-aed6-4e23eaf1efa6",
                                "sense_id": "f28b4e18-bec9-35a4-9b3a-170a931cd0ac",
                                "text": "„Er selbst sei in seinen letzten Jahren als Vorsitzender immer häufiger mit Magendrücken zu den Gremiensitzung gefahren, klagte Gabriel.“"
                            },
                            {
                                "example_id": "cc811b8a-d566-4402-881d-f24750018e24",
                                "sense_id": "f28b4e18-bec9-35a4-9b3a-170a931cd0ac",
                                "text": "„Wer wie die McLaren-Crew den Zweiten für den ersten Verlierer hält, bekommt Magendrücken angesichts der Aussichten.“"
                            },
                            {
                                "example_id": "fdd376af-0488-4bc0-af5b-64471e805aea",
                                "sense_id": "f28b4e18-bec9-35a4-9b3a-170a931cd0ac",
                                "text": "„Der Gedanke daran war gar nicht mal so falsch, auch wenn er bei mir für ein heftiges Magendrücken sorgte.“"
                            },
                            {
                                "example_id": "9e22a61a-538b-4942-9066-7584ed2ef7c8",
                                "sense_id": "f28b4e18-bec9-35a4-9b3a-170a931cd0ac",
                                "text": "„Magendrücken am Morgen deshalb, weil die mündliche Gegenwartskunde-Prüfung bevorstand, die letzte der Grundschulprüfungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
