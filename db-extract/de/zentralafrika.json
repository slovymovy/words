                "senses": [
                    {
                        "sense_id": "fc9a5b10-00bb-30ba-9844-42adc5feb129",
                        "entry_id": "5aa1c84a-4c50-3855-aea6-cfd2440890b0",
                        "glosses": [
                            "nicht präzise definierte Großregion auf dem afrikanischen Kontinent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c97d2b19-2cd6-4ec1-a24e-89e5e4fc9d51",
                                "sense_id": "fc9a5b10-00bb-30ba-9844-42adc5feb129",
                                "text": "„Was wird aus Palästina? Gebannt und voller Spannung verfolgen die Staaten des Vorderen Orients und des afrikanischen Raumes vom Schwarzen Meer bis zur Straße von Gibraltar und bis weit hinein nach Zentralafrika jede Phase der Entwicklung.“"
                            },
                            {
                                "example_id": "afc3c734-6694-47e9-9eb0-8ff5b4f688da",
                                "sense_id": "fc9a5b10-00bb-30ba-9844-42adc5feb129",
                                "text": "„Die Herrschaft des Monarchen, der Zivilisation und Christentum nach Zentralafrika bringen und die Sklaverei dort beenden soll, entwickelt sich zu einem der größten Verbrechen der Geschichte.“"
                            },
                            {
                                "example_id": "cb69f629-97cf-462d-9ef0-1e39e0df46e8",
                                "sense_id": "fc9a5b10-00bb-30ba-9844-42adc5feb129",
                                "text": "„In ein paar Hundert Kilometern begann die Sahara, und danach warteten die ungezähmten Länder Zentralafrikas auf mich.“"
                            },
                            {
                                "example_id": "e248ad91-d9ce-4617-a158-fed8305942e1",
                                "sense_id": "fc9a5b10-00bb-30ba-9844-42adc5feb129",
                                "text": "„Eine Flucht mit dem Ziel Zentralafrika scheitert.“"
                            },
                            {
                                "example_id": "7b830e25-065b-428b-a414-0cb1dd46117c",
                                "sense_id": "fc9a5b10-00bb-30ba-9844-42adc5feb129",
                                "text": "„Robert Gabriel Mugabe wurde in der Nähe des kleinen Dorfes Kutama im südlichen Zentralafrika geboren, in dem er seine Kindheit und Jugend verbrachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
