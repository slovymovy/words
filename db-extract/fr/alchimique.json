                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e0b53bd-2eb1-3475-95e6-1ba66fb35447",
                                        "entry_id": "4cba1a00-86cb-30c6-86dc-41dcde61806b",
                                        "glosses": [
                                            "Of or pertaining to the medieval chemical science and philosophy of alchemy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da21fbb-f86e-4887-a0d5-b8d0a3a6fe17",
                                                "sense_id": "6e0b53bd-2eb1-3475-95e6-1ba66fb35447",
                                                "text": "[Isaac Newton] was obsessed with alchemy. He spent hours copying alchemical recipes and trying to replicate them in his laboratory. He believed that the Bible contained numerological codes. The truth is that Newton was very much a product of his time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81b10d5-74de-320c-ab07-a03e0f9589a0",
                                        "entry_id": "4cba1a00-86cb-30c6-86dc-41dcde61806b",
                                        "glosses": [
                                            "Of or pertaining to an unexplainable transmutation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f33e971c-de1e-3496-a93e-312784f88d0f",
