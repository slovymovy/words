                    {
                        "form_id": "07986e7f-cb9b-4077-8c58-7d1b4f8497c9",
                        "entry_id": "b11878b7-9fad-3b95-9613-633e4424248e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Poliomyelitiden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                        "entry_id": "b11878b7-9fad-3b95-9613-633e4424248e",
                        "glosses": [
                            "virale Infektionskrankheit, meist bei Kindern oder Jugendlichen, welche die Extremitäten lähmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7ded48f-1d43-4cf4-b4c6-9010787d2675",
                                "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                                "text": "Die Schluckimpfung verhindert sicher Poliomyelitis."
                            },
                            {
                                "example_id": "c16db315-109a-4537-8fde-7d6f4d5188f6",
                                "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                                "text": "Vor 60 Jahren gab es eine Krankheit, die hieß Kinderlähmung, man sagt auch Poliomyelitis. Heute erkrankt fast niemand mehr daran, und zwar, weil eben die meisten Menschen dagegen geimpft sind."
                            },
                            {
                                "example_id": "6a3c10b2-a3c2-4693-887b-7ab9aa475bab",
                                "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                                "text": "Poliomyelitis, kurz Polio genannt, ist hoch ansteckend. Die Übertragung erfolgt über Tröpfchen- oder Schmierinfektion."
                            },
                            {
                                "example_id": "ed9ed8b4-b7e3-4fa1-99f6-ecba87ce19a2",
                                "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                                "text": "Die ersten Symptome sind Fieber, Übelkeit, Kopfschmerzen. Bei der sogenannten Abortiven Poliomyelitis sind Zellen des Zentralen Nervensystems nicht betroffen. Bei der Paralytischen Poliomyelitis kommt es nach etwa zwei bis drei Tagen zu Lähmungserscheinungen."
                            },
                            {
                                "example_id": "485773d8-d4ba-4f3b-989b-4b9b88d5812c",
                                "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                                "text": "Kinderlähmung oder Poliomyelitis ist eine ansteckende, von Polioviren hervorgerufene Infektionskrankheit, die hauptsächlich Kinder im Alter zwischen drei und acht Jahren befällt."
                            },
                            {
                                "example_id": "c52464ec-670c-47de-ab09-61c9f7cd5ba0",
                                "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                                "text": "Vor knapp 30 Jahren steckten sich jedes Jahr 200.000 Kinder in Indien mit Poliomyelitis an. Seit fast zwei Jahren gilt der Subkontinent als frei von Polio, dank eines Impfprogramms, dessen engmaschiges Netz einmalig ist."
                            },
                            {
                                "example_id": "e8215780-d614-4d8d-ab86-d9e245a3aa48",
                                "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                                "text": "Im Jahr 2006 wurden insgesamt 1.939 Fälle von Kinderlähmung (Poliomyelitis) weltweit registriert."
                            },
                            {
                                "example_id": "fbd2006b-bf1f-44b8-89e1-8c534468ea20",
                                "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                                "text": "Einmal im Jahr am 28.10. erinnert sich die Welt an Poliomyelitis - Kinderlähmung, von der man glaubte, sie sei längst besiegt."
                            },
                            {
                                "example_id": "ed927fe0-ce35-4efc-9c71-78ea52bd0c37",
                                "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                                "text": "Die Folgen einer Poliomyelitis können grausam sein: Nach Angaben der Weltgesundheitsorganisation führt 1 von 200 Polio-Infektionen zu lebenslangen Lähmungen. 5 bis 10 Prozent der Gelähmten sterben, wenn die Atemmuskeln von der Krankheit befallen werden."
                            },
                            {
                                "example_id": "eee69a02-4711-451c-88a0-fffaf58224e8",
                                "sense_id": "b07a6171-04e1-38b2-9067-b1d5836e4967",
                                "text": "Überall, wo Krieg ist, kehrt die Poliomyelitis zurück, beispielsweise in Syrien, in Afghanistan oder in der Ukraine."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
