                ],
                "senses": [
                    {
                        "sense_id": "c035eb7f-a8fe-3606-a289-c8df9713cfda",
                        "entry_id": "8eabf3b7-b47f-3b93-b5c9-b3f7e226cc41",
                        "glosses": [
                            "Faire passer d’une main à l’autre un cordage que l’on visite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7024848-ff2c-4c2d-94b4-3f81b4f7b3e3",
                                "sense_id": "c035eb7f-a8fe-3606-a289-c8df9713cfda",
                                "text": "Acrobates laborieux, paumoyant la toile à quinze mètres au-dessus des ponts, vertigineusement balancés aux marche-pieds des vergues, ils n’en redescendent que pour trouver à terre des tâches de « pattes vasouses » ou de terrassiers !"
                            }
                        ]
                    },
                    {
                        "sense_id": "7bf36b55-9ffe-3552-b9f4-18d7e725ecac",
                        "entry_id": "8eabf3b7-b47f-3b93-b5c9-b3f7e226cc41",
                        "glosses": [
                            "Coudre avec la paumelle."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4f30fca0-5369-3240-9cd5-c2368c68d313",
                        "entry_id": "8eabf3b7-b47f-3b93-b5c9-b3f7e226cc41",
                        "glosses": [
                            "Mesurer à la paume."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b266438-a246-4903-ace8-9acc542ecf1e",
                                "sense_id": "4f30fca0-5369-3240-9cd5-c2368c68d313",
                                "text": "Paumoyer le lin, le chanvre."
                            }
                        ]
                    },
                    {
                        "sense_id": "1814dd87-83d2-3c36-a87d-12f99ba01e9f",
                        "entry_id": "8eabf3b7-b47f-3b93-b5c9-b3f7e226cc41",
                        "glosses": [
                            "Se hisser à force de mains le long d’un câble."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "0491aeab-2385-4616-998a-d7044bb2b616",
                                "sense_id": "1814dd87-83d2-3c36-a87d-12f99ba01e9f",
                                "text": "[…]; tandis qu'on hisse le kayak par ses deux extrémités, l'esquimau, sans sortir de son trou; se paumoie en suivant l'ascension, jusqu'au pont du navire."
                            }
                        ]
                    }
