            {
                "entry_id": "b4afc76b-69df-3127-91a2-c016d56e264c",
                "word": "bey",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7e2c60cc-92bb-4b83-be19-7a8937ddfc16",
                        "entry_id": "b4afc76b-69df-3127-91a2-c016d56e264c",
                        "tags": [
                            "plural"
                        ],
                        "form": "beys"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "545e22db-8cbb-3626-8c29-bc7003c414ba",
                        "entry_id": "b4afc76b-69df-3127-91a2-c016d56e264c",
                        "glosses": [
                            "Gouverneur dans l’ancien Empire ottoman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51025523-6f02-4087-ab7a-4c7aaa29701a",
                                "sense_id": "545e22db-8cbb-3626-8c29-bc7003c414ba",
                                "text": "Cinq partis armés se disputaient alors les bords du Nil : Ibraïm-Bey dans la Haute-Égypte, deux autres petits beys indépendants, le pacha de la Porte au Caire, une troupe d’Albanais révoltés, El-Fy-Bey dans la Basse-Égypte."
                            },
                            {
                                "example_id": "f24276fa-b355-4ead-9f93-d68db18c81eb",
                                "sense_id": "545e22db-8cbb-3626-8c29-bc7003c414ba",
                                "text": "En 1830, il n'y avait en Algérie, que des tribus ennemies sur lesquelles pesaient, selon les régions, la terreur des Turcs qui avaient leur bey à Alger, et puis les peuples berbères et arabo-berbères."
                            }
                        ]
                    },
                    {
                        "sense_id": "fce4e963-a7c2-333f-b92b-74a642ca1e95",
                        "entry_id": "b4afc76b-69df-3127-91a2-c016d56e264c",
                        "glosses": [
                            "Titre honorifique (sire, sieur) accordé par le sultan."
                        ],
                        "tags": [],
                        "note": "le titre se place après le nom de la personne",
                        "examples": [
                            {
                                "example_id": "c598e2fd-dd8f-441e-8d2b-49950cc3d48e",
                                "sense_id": "fce4e963-a7c2-333f-b92b-74a642ca1e95",
                                "text": "Tugay Bey."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5da5c1d2-a569-4b92-a416-535c822e987a",
                        "source_entry_id": "b4afc76b-69df-3127-91a2-c016d56e264c",
                        "target_lang_word": "bey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29e05fb0-ce97-319f-ae0a-580042dcf69b",
                                        "entry_id": "ff74937c-f44f-352a-8c98-069cfc99dcae",
                                        "glosses": [
                                            "A governor of a province or district in the Turkish (e.g. Ottoman) dominions."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ac58958-c0fe-43e5-a398-2703f954ede4",
                                                "sense_id": "29e05fb0-ce97-319f-ae0a-580042dcf69b",
                                                "text": "She was chaperoned by the widow of a Bey whose son had been at Oxford with him, and this gave him the excuse to exchange a few words with her, and then to be presented to the Princess."
                                            },
                                            {
                                                "example_id": "0d50b41f-04d1-4c72-bccf-ad1016fcb4ac",
                                                "sense_id": "29e05fb0-ce97-319f-ae0a-580042dcf69b",
                                                "text": "Whether his position with the Third Circle made the difference or the fact that he ranked as a bey, life in El Iskandryia was proving easier than he'd ever dreamed possible when he stepped off the plane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2477f495-831e-3842-801d-e45353088185",
                                        "entry_id": "ff74937c-f44f-352a-8c98-069cfc99dcae",
                                        "glosses": [
                                            "in various other places, a prince or nobleman"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
