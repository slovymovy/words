                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96e8e9d5-bef1-4dbc-803f-efe4de550d10",
                                                "sense_id": "33fe13df-8c99-3804-8e8e-f8ea7c6630c2",
                                                "text": "I fluctuated between wishing he was back home and wishing I'd never met him."
                                            }
