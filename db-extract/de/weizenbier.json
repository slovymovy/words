                                "target_senses": [
                                    {
                                        "sense_id": "3b03b899-7f5a-328b-bf6e-b79ca3d77da5",
                                        "entry_id": "0cbb359a-d718-3431-9caa-b78772185791",
                                        "glosses": [
                                            "A top-fermented beer brewed with a large proportion of wheat relative to the amount of malted barley."
                                        ],
