                        "glosses": [
                            "Question dont la réponse est importante. Question épineuse. Question cruciale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0426ad64-f40c-4032-8f3f-279a3ebc599f",
                                "sense_id": "3d5134a1-b48e-34b9-a7ea-d18f55e38394",
                                "text": "Meine Tochter will Klaus heiraten, die Gretchenfrage, ob er auch Kinder will, hat sie aber noch nicht gestellt. -Ma fille veut épouser Klaus, mais elle ne lui encore pas posé la question décisive : est-ce que lui aussi veut des enfants ?"
                            }
                        ]
                    }
