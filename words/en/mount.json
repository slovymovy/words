{
    "word_family": [
        "mountain",
        "mountaineer",
        "mountainous",
        "dismount",
        "remount",
        "surmount",
        "paramount",
        "amount"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca474aaf-d23f-3322-932f-5bae4dd6b953",
                    "sense_definition": "To increase gradually in amount, degree, or intensity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tension began to <w>mount</w> as the deadline for the project approached.",
                            "target_lang_translations": {
                                "ru": "Напряжение начало <w>нарастать</w> по мере приближения срока сдачи проекта.",
                                "zh": "随着项目截止日期的临近，紧张气氛开始<w>增加</w>。"
                            }
                        },
                        {
                            "text": "Her debts continued to <w>mount</w> up because she refused to stop spending money.",
                            "target_lang_translations": {
                                "ru": "Её долги продолжали <w>расти</w>, потому что она отказывалась прекратить тратить деньги.",
                                "zh": "由于她拒绝停止花钱，她的债务持续<w>增长</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "build"
                    ],
                    "common_phrases": [
                        "tension mounts",
                        "pressure mounts",
                        "mount up",
                        "debts mount"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно увеличиваться в количестве, степени или интенсивности.",
                        "zh": "指数量、程度或强度逐渐增加。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возрастать",
                                "target_lang_sense_clarification": "увеличиваться (о напряжении, давлении)"
                            },
                            {
                                "target_lang_word": "расти",
                                "target_lang_sense_clarification": "увеличиваться в размере или количестве (о долгах)"
                            },
                            {
                                "target_lang_word": "нарастать",
                                "target_lang_sense_clarification": "накапливаться, усиливаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增加",
                                "target_lang_sense_clarification": "指程度或数量的提升"
                            },
                            {
                                "target_lang_word": "增长",
                                "target_lang_sense_clarification": "指数值或规模的扩大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1fdc46-eaa5-3dd0-ab30-fa12f14b745c",
                    "sense_definition": "To go up something or climb to a higher position.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ascend_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired hikers had to <w>mount</w> the steep stone steps to reach the temple.",
                            "target_lang_translations": {
                                "ru": "Уставшим туристам пришлось <w>подниматься</w> по крутым каменным ступеням, чтобы добраться до храма.",
                                "zh": "疲惫的徒步旅行者必须<w>攀登</w>陡峭的石阶才能到达寺庙。"
                            }
                        },
                        {
                            "text": "He watched the smoke <w>mount</w> slowly into the clear blue sky.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как дым медленно <w>поднимается</w> в ясное голубое небо.",
                                "zh": "他看着烟雾缓缓向晴朗的蓝天<w>上升</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mount the stairs",
                        "mount the steps",
                        "mount the platform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься на что-либо или взбираться на более высокую позицию.",
                        "zh": "向上移动或攀登到更高的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "двигаться вверх (по ступеням, в небо)"
                            },
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "подниматься с усилием"
                            },
                            {
                                "target_lang_word": "восходить",
                                "target_lang_sense_clarification": "подниматься (книжн.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "攀登",
                                "target_lang_sense_clarification": "指费力地向上爬"
                            },
                            {
                                "target_lang_word": "上升",
                                "target_lang_sense_clarification": "指物体向上移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00156d87-61af-3610-a897-0773326da1f9",
                    "sense_definition": "To get onto a horse, bicycle, or motorcycle in order to ride it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ascend_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight prepared to <w>mount</w> his horse and ride into battle.",
                            "target_lang_translations": {
                                "ru": "Рыцарь приготовился <w>сесть</w> на коня и поскакать в бой.",
                                "zh": "骑士准备<w>骑上</w>他的马奔赴战场。"
                            }
                        },
                        {
                            "text": "It takes some practice to <w>mount</w> a bicycle without losing your balance.",
                            "target_lang_translations": {
                                "ru": "Требуется некоторая практика, чтобы <w>сесть</w> на велосипед, не потеряв равновесия.",
                                "zh": "<w>骑上</w>自行车而不失去平衡需要一些练习。"
                            }
                        }
                    ],
                    "antonyms": [
                        "dismount"
                    ],
                    "common_phrases": [
                        "mount a horse",
                        "mount a bike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Садиться на лошадь, велосипед или мотоцикл для езды.",
                        "zh": "骑上马、自行车或摩托车以便骑行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "садиться",
                                "target_lang_sense_clarification": "верхом на лошадь или транспорт"
                            },
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "залезать наверх"
                            },
                            {
                                "target_lang_word": "оседлать",
                                "target_lang_sense_clarification": "сесть верхом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骑上",
                                "target_lang_sense_clarification": "指跨上交通工具或动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d00d45c-2f04-3c45-94f3-d034fa69c2a7",
                    "sense_definition": "To organize and begin a campaign, attack, or other course of action.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "organize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army plans to <w>mount</w> a surprise attack at dawn tomorrow.",
                            "target_lang_translations": {
                                "ru": "Армия планирует <w>предпринять</w> внезапную атаку завтра на рассвете.",
                                "zh": "军队计划在明天黎明时分<w>发起</w>突袭。"
                            }
                        },
                        {
                            "text": "The museum will <w>mount</w> an exhibition of modern art next month.",
                            "target_lang_translations": {
                                "ru": "В следующем месяце музей <w>организует</w> выставку современного искусства.",
                                "zh": "博物馆下个月将<w>举办</w>一场现代艺术展。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mount an attack",
                        "mount a campaign",
                        "mount a challenge",
                        "mount an exhibition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать и начинать кампанию, атаку или другое действие.",
                        "zh": "组织并开始一项运动、攻击或其他行动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организовывать",
                                "target_lang_sense_clarification": "подготавливать мероприятие (выставку)"
                            },
                            {
                                "target_lang_word": "предпринимать",
                                "target_lang_sense_clarification": "начинать активные действия (атаку)"
                            },
                            {
                                "target_lang_word": "начинать",
                                "target_lang_sense_clarification": "приступать к действию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发起",
                                "target_lang_sense_clarification": "指开始一项行动或攻击"
                            },
                            {
                                "target_lang_word": "举办",
                                "target_lang_sense_clarification": "指组织展览或活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f47162cd-9f52-3f6f-bb09-95335f35f23b",
                    "sense_definition": "To fix an object firmly to a support, backing, or setting.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>mount</w> the large television on the living room wall.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>повесить</w> большой телевизор на стену в гостиной.",
                                "zh": "他们决定把大电视<w>安装</w>在客厅的墙上。"
                            }
                        },
                        {
                            "text": "The scientist used a slide to <w>mount</w> the specimen for the microscope.",
                            "target_lang_translations": {
                                "ru": "Ученый использовал предметное стекло, чтобы <w>поместить</w> образец для микроскопа.",
                                "zh": "科学家用载玻片将标本<w>固定</w>好以便在显微镜下观察。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mount on the wall",
                        "mount a picture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочно прикреплять объект к опоре, основе или оправе.",
                        "zh": "将物体牢固地固定在支撑物、底座或框架上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устанавливать",
                                "target_lang_sense_clarification": "размещать оборудование"
                            },
                            {
                                "target_lang_word": "крепить",
                                "target_lang_sense_clarification": "фиксировать на поверхности"
                            },
                            {
                                "target_lang_word": "монтировать",
                                "target_lang_sense_clarification": "собирать и устанавливать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安装",
                                "target_lang_sense_clarification": "指将设备固定在墙上或支架上"
                            },
                            {
                                "target_lang_word": "固定",
                                "target_lang_sense_clarification": "指使物体保持不动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f2d7868-026e-3446-a48e-57e35e6219d9",
                    "sense_definition": "To make a file system or disk available for use by the operating system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>mount</w> the external drive before you can access the files on it.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>подключить</w> внешний диск, прежде чем сможете получить доступ к файлам на нем.",
                                "zh": "你必须先<w>挂载</w>外部驱动器，才能访问其中的文件。"
                            }
                        },
                        {
                            "text": "The server failed to <w>mount</w> the disk automatically after the restart.",
                            "target_lang_translations": {
                                "ru": "Серверу не удалось автоматически <w>смонтировать</w> диск после перезагрузки.",
                                "zh": "服务器重启后未能自动<w>挂载</w>磁盘。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unmount"
                    ],
                    "common_phrases": [
                        "mount a drive",
                        "mount the disk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать файловую систему или диск доступными для использования операционной системой.",
                        "zh": "使文件系统或磁盘可供操作系统使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "монтировать",
                                "target_lang_sense_clarification": "компьютерный термин"
                            },
                            {
                                "target_lang_word": "подключать",
                                "target_lang_sense_clarification": "соединять устройство с системой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挂载",
                                "target_lang_sense_clarification": "计算机术语，指连接存储设备"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a421d1c-04f7-3282-b43b-d653bc31c600",
                    "sense_definition": "A mountain or hill; often used in proper names of mountains.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many climbers dream of reaching the summit of <w>Mount</w> Everest.",
                            "target_lang_translations": {
                                "ru": "Многие альпинисты мечтают достичь вершины <w>горы</w> Эверест.",
                                "zh": "许多登山者梦想登上珠穆朗玛<w>山</w>的顶峰。"
                            }
                        },
                        {
                            "text": "The castle was built on a high <w>mount</w> overlooking the valley.",
                            "target_lang_translations": {
                                "ru": "Замок был построен на высокой <w>горе</w>, возвышающейся над долиной.",
                                "zh": "城堡建在一座俯瞰山谷的高<w>山</w>上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Mount Everest",
                        "Mount Fuji",
                        "rocky mount"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гора или холм; часто используется в названиях гор.",
                        "zh": "山或丘陵；常用于山名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гора",
                                "target_lang_sense_clarification": "возвышенность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "山",
                                "target_lang_sense_clarification": "指地理上的高地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d4e959e-2633-37c2-91dd-a982a1cbeb63",
                    "sense_definition": "An object, such as a stand, frame, or backing, on which something is fixed or supported.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diamond was set in a beautiful gold <w>mount</w>.",
                            "target_lang_translations": {
                                "ru": "Бриллиант был вставлен в красивую золотую <w>оправу</w>.",
                                "zh": "这颗钻石镶嵌在一个精美的黄金<w>底座</w>上。"
                            }
                        },
                        {
                            "text": "We need to buy a new wall <w>mount</w> for the television.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить новое настенное <w>крепление</w> для телевизора.",
                                "zh": "我们需要为电视买一个新的墙面<w>支架</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wall mount",
                        "engine mount"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект, такой как подставка, рама или основа, на котором что-то закреплено.",
                        "zh": "用于固定或支撑某物的物体，如支架、框架或底座。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепление",
                                "target_lang_sense_clarification": "устройство для фиксации"
                            },
                            {
                                "target_lang_word": "оправа",
                                "target_lang_sense_clarification": "для драгоценных камней"
                            },
                            {
                                "target_lang_word": "подставка",
                                "target_lang_sense_clarification": "опора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支架",
                                "target_lang_sense_clarification": "指支撑物体的结构"
                            },
                            {
                                "target_lang_word": "底座",
                                "target_lang_sense_clarification": "指安装物体的基础"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06ec9887-7feb-304d-80c2-dbca17143133",
                    "sense_definition": "A horse or other animal used for riding.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier signaled for his <w>mount</w> to be brought to the front of the line.",
                            "target_lang_translations": {
                                "ru": "Солдат подал знак, чтобы его <w>скакуна</w> подвели к началу строя.",
                                "zh": "士兵示意将他的<w>坐骑</w>带到队伍最前面。"
                            }
                        },
                        {
                            "text": "She patted her <w>mount</w> gently on the neck to calm it down.",
                            "target_lang_translations": {
                                "ru": "Она нежно похлопала свою <w>лошадь</w> по шее, чтобы успокоить её.",
                                "zh": "她轻轻拍了拍<w>坐骑</w>的脖子，让它平静下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steed"
                    ],
                    "common_phrases": [
                        "trusty mount"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лошадь или другое животное, используемое для верховой езды.",
                        "zh": "用于骑乘的马或其他动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скакун",
                                "target_lang_sense_clarification": "быстрая лошадь (литературное)"
                            },
                            {
                                "target_lang_word": "конь",
                                "target_lang_sense_clarification": "самец лошади, верховая лошадь"
                            },
                            {
                                "target_lang_word": "лошадь",
                                "target_lang_sense_clarification": "животное (общее название)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坐骑",
                                "target_lang_sense_clarification": "指供人骑乘的马匹"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cd1da9cc-8f7f-3a0f-b19b-b4a2c1ee48bf",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Mount</w> was known for his contributions to the local library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Маунт</w> был известен своим вкладом в местную библиотеку.",
                                "zh": "<w>蒙特</w>先生以对当地图书馆的贡献而闻名。"
                            }
                        },
                        {
                            "text": "We invited the <w>Mount</w> family to the dinner party.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Маунт</w> на званый ужин.",
                                "zh": "我们邀请了<w>蒙特</w>一家参加晚宴。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Маунт",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蒙特",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}