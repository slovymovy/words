                "entry_id": "c19a5271-6f20-3371-9266-d45e4e544221",
                "word": "regardant",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "af18521c-4d0c-38bb-aecf-dd2b2a4a9c8a",
                        "entry_id": "c19a5271-6f20-3371-9266-d45e4e544221",
                        "glosses": [
                            "With the head turned toward the back of the body."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "723c7e38-62b1-4d19-b4c0-5ec60c143d9c",
                                "sense_id": "af18521c-4d0c-38bb-aecf-dd2b2a4a9c8a",
                                "text": "The dog was waiting for him, her paws on the second tread, pere regardant with a happy lolling tongue."
                            },
                            {
                                "example_id": "e7b55196-670a-474c-8177-c222afbfac5b",
                                "sense_id": "af18521c-4d0c-38bb-aecf-dd2b2a4a9c8a",
                                "text": "The official blazon of the arms of Perth is \"Gules, a Holy Lambe passant regardant staff and cross argent, with the banner of St. Andrew proper, all within a double tressure counter-flowered of the second\": […]."
                            },
                            {
                                "example_id": "76ab27f0-5604-443c-a97b-cf2a4fd92d41",
                                "sense_id": "af18521c-4d0c-38bb-aecf-dd2b2a4a9c8a",
                                "text": "I see a forked beast squatting on the midden of the world, red-eyed, regardant, gnawing on a shinbone: poor, dumb destroyer."
                            }
                        ]
                    },
                    {
                        "sense_id": "6168db0d-b8c9-378f-8788-ca584f675017",
                        "entry_id": "c19a5271-6f20-3371-9266-d45e4e544221",
                        "glosses": [
                            "Watchful, attentive; contemplative."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1032a07c-32cd-4d47-9fd0-42e6f3a7477b",
                                "sense_id": "6168db0d-b8c9-378f-8788-ca584f675017",
                                "text": "To horse, to horse: thus once Eurydice, / With looks regardant, did the Thracian gaze […]."
                            },
                            {
                                "example_id": "48594de9-7549-4147-8275-a54aeddaa0e8",
                                "sense_id": "6168db0d-b8c9-378f-8788-ca584f675017",
                                "text": "He stood regardant for a moment."
                            },
                            {
                                "example_id": "c8e4f2fd-282e-4efa-bac7-5c74ecf330ca",
                                "sense_id": "6168db0d-b8c9-378f-8788-ca584f675017",
                                "text": "And now others, casually regardant, passed the place in automobiles …."
                            }
                        ]
                    }
                ],
