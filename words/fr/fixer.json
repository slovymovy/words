                {
                    "sense_id": "c01d73db-0ebd-35f4-9a6f-e19b18683396",
                    "sense_definition": "Attacher, accrocher ou immobiliser solidement un objet sur un support pour le maintenir en place.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "attacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>fixer</w> cette étagère au mur avec des vis solides pour éviter qu'elle ne tombe."
                        },
                        {
                            "text": "Nous avons <w>fixé</w> le miroir dans le couloir juste au-dessus du meuble d'entrée."
                        }
                    ],
                    "synonyms": [
                        "attacher",
                        "accrocher",
                        "immobiliser"
                    ],
                    "antonyms": [
                        "détacher",
                        "enlever"
                    ],
                    "common_phrases": [
                        "fixer au mur"
                    ]
                },
                {
                    "sense_id": "e88201e8-d8c8-3b66-ae58-62bc24520b35",
                    "sense_definition": "Déterminer, régler ou décider formellement d'un rendez-vous, d'une date, d'un prix ou d'une règle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "determiner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a proposé de <w>fixer</w> un rendez-vous pour la semaine prochaine à quatorze heures."
                        },
                        {
                            "text": "Ils ont enfin réussi à <w>fixer</w> la date de leur départ en vacances."
                        }
                    ],
                    "synonyms": [
