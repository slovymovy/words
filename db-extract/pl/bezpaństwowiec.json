                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcbce574-1a33-433b-8577-e74b1079bb0d",
                        "source_entry_id": "d5b6ba34-3a92-3e2e-9683-77872310ed3a",
                        "source_sense_id": "29bbcb7c-6b52-3580-bd8f-3240ca5997ce",
                        "target_lang_word": "Staatenloser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staatenloser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6834ecda-e38b-3099-805f-20d7f90b7028",
                                        "entry_id": "fa7b752a-b880-3aed-bfff-ec4024c594b6",
                                        "glosses": [
                                            "(männliche) Person, die keine (anerkannte) Staatsbürgerschaft besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd08ec1-c4de-45a3-8181-e80c481f9537",
                                                "sense_id": "6834ecda-e38b-3099-805f-20d7f90b7028",
                                                "text": "„Er traf gute alte Bekannte, so seinen ersten Konzertmeister von den Prager Philharmonikern, der als Staatenloser nicht für die neuen Herren auf dem Hradschin optiert hatte.“"
                                            },
                                            {
                                                "example_id": "df066807-d7aa-4cae-aeef-8671d067a31b",
                                                "sense_id": "6834ecda-e38b-3099-805f-20d7f90b7028",
                                                "text": "„Wer sich auf Menschenrechte stützen will und dies als Staatenloser (der er etwa durch Gewalt seines ihn ausschließenden Staats geworden ist) versucht, erfährt, daß er in der Tat gar keine Rechte, weniger Rechte als ein Mensch hat.“"
                                            },
                                            {
                                                "example_id": "4ab687fe-a695-45fd-8a2e-8aa19f6de6f8",
                                                "sense_id": "6834ecda-e38b-3099-805f-20d7f90b7028",
                                                "text": "„Doch im neuen Staatsbürgerschaftsgesetz hatte die Regierung vor zwei Jahren erst einmal Zehntausende Roma zu Staatenlosen und Entrechteten gemacht.“"
                                            },
                                            {
                                                "example_id": "8562da47-4a1a-40c8-bb00-58f97c3d05c0",
                                                "sense_id": "6834ecda-e38b-3099-805f-20d7f90b7028",
                                                "text": "„Rachel Salamanders Eltern sind in Deutschland als Staatenlose gestorben, sie selbst hat noch lange an diesem Status festgehalten, auch als sie schon etablierte Geschäftsfrau und Liebling der Münchner Gesellschaft war.“"
                                            },
                                            {
                                                "example_id": "3227543e-c7f1-44f7-806f-bd12fc592f96",
                                                "sense_id": "6834ecda-e38b-3099-805f-20d7f90b7028",
                                                "text": "„Es gibt rund 10 Millionen Staatenlose weltweit, die keinen Anspruch auf normal geltene Rechte haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
