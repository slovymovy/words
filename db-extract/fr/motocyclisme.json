                        "glosses": [
                            "Terme regroupant tous les sports pratiqués sur une motocyclette ou un side-car."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f58dcb-9319-47c0-af0b-663bd7276747",
                                "sense_id": "3a547c69-7791-387a-a369-c03268c20eb4",
                                "text": "Le motocyclisme regroupe les courses de vitesse, d’endurance, de motocross, d’enduro, de speedway et de trial."
                            },
                            {
                                "example_id": "80b72ee0-abea-4aa8-8df2-9a26f11b106c",
                                "sense_id": "3a547c69-7791-387a-a369-c03268c20eb4",
                                "text": "Depuis 2007, elle collabore régulièrement avec la société Motoress pour promouvoir le motocyclisme féminin au Canada et à l’étranger."
                            }
                        ]
                    }
                ],
