                        "source_sense_id": "075a0da5-02cf-31b0-9e30-d08ef194a00e",
                        "source_sense_description": "Pilgerfahrt zur Kaaba nach Mekka, die jede volljährige Person muslimischen Glaubens einmal im Leben unternehmen soll",
                        "target_lang_word": "хадж",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
