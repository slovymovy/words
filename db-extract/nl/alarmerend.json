                "forms": [],
                "senses": [
                    {
                        "sense_id": "c06e30e9-8120-32d0-b77f-6e828761a5ac",
                        "entry_id": "0c055574-6f90-3175-a974-796436922293",
                        "glosses": [
                            "van iets dat het angst veroorzaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98f60066-5188-4800-9711-c10def9cfec8",
                                "sense_id": "c06e30e9-8120-32d0-b77f-6e828761a5ac",
                                "text": "Door de slechte resultaten waren de Noorderlingen een heuse degradatiekandidaat en in de winterstop stond de club op een alarmerende vijftiende plek in de eredivisie."
                            },
                            {
                                "example_id": "c28f7f73-d4c2-4462-b08b-5754d5c79709",
                                "sense_id": "c06e30e9-8120-32d0-b77f-6e828761a5ac",
                                "text": "Volgens het Amerikaanse ministerie van Justitie is er een ,,alarmerende toename’’ van Amerikaanse spionnen die hun land verraden aan China."
                            },
                            {
                                "example_id": "9f59d285-b418-4cd1-8adf-e512e476100f",
                                "sense_id": "c06e30e9-8120-32d0-b77f-6e828761a5ac",
                                "text": "Het merendeel van de tijd zijn ze gericht tot de anderen, maar soms zijn er van die dagen waarop hij de spanning als een alarmerend luchtje om haar heen kan ruiken, en probeert hij zich afzijdig te houden."
                            },
                            {
                                "example_id": "1cb615ad-a955-4299-9090-854366072bb5",
                                "sense_id": "c06e30e9-8120-32d0-b77f-6e828761a5ac",
                                "text": "Vanwege het alarmerende telefoontje had hij een feestje moeten verlaten."
                            }
                        ]
                    }
                ],
