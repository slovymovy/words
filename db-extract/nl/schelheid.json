                                        "entry_id": "561e243b-50c1-3cd3-8ccf-8c63e68e4583",
                                        "glosses": [
                                            "The product or result of being sharp."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c7650b6-88d9-48c5-a24b-5b5fc91801fa",
                                                "sense_id": "b767dde4-f3d3-382e-8841-fa5f79d456e8",
                                                "text": "The first thing that strikes the stranger is the sharpness of the curves on the metre gauge; it is not unusual for a long train to be travelling in three directions at once, and the engine is frequently in full view of the windows of the ninth or tenth carriage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd12f7ff-0e63-34d3-aee9-943e9ecdb0bd",
                                        "entry_id": "561e243b-50c1-3cd3-8ccf-8c63e68e4583",
                                        "glosses": [
                                            "pungency or acidity."
                                        ],
