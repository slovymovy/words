                                            {
                                                "example_id": "fda944a0-fb95-40f4-80b1-5d00af217a2a",
                                                "sense_id": "4d6eeeec-9889-3b9e-bf9a-b456637cdd2e",
                                                "text": "Ein Chinese und ein Amerikaner sitzen in einem Auto."
                                            },
                                            {
                                                "example_id": "51e1eebc-2e2e-4195-964b-46727e12f9f9",
                                                "sense_id": "4d6eeeec-9889-3b9e-bf9a-b456637cdd2e",
                                                "text": "„Die großen Reiche Asiens – die Osmanen, Perser, Moguln und Chinesen – bekamen sehr bald mit, dass die Europäer einen neuen Kontinent entdeckt hatten.“"
                                            },
                                            {
                                                "example_id": "dfae1f95-d452-4383-a56d-a305e757f4d4",
                                                "sense_id": "4d6eeeec-9889-3b9e-bf9a-b456637cdd2e",
                                                "text": "„In China, weißt Du ja wohl, ist der Kaiser ein Chinese, und alle, die er um sich hat, sind Chinesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24533484-5f8b-3ecd-a7eb-e1c741733a02",
