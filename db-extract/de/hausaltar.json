                "senses": [
                    {
                        "sense_id": "bf82b9a9-8d02-386c-aae3-3938e0175650",
                        "entry_id": "1d09b7d0-73f3-3a1c-a132-416ce2c643f9",
                        "glosses": [
                            "privater Altar in einem Haus/einer Wohnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "923d88a9-94f8-408a-a05c-f561a88b2bb9",
                                "sense_id": "bf82b9a9-8d02-386c-aae3-3938e0175650",
                                "text": "„Zwei Tische aus grobem Holz und ein paar Stühle standen da, und auf einem Brett oben rechts in der Ecke war ein Fernseher, darunter eine Art Hausaltar mit einem vergilbten Madonnenbild und Papierblumen.“"
                            },
                            {
                                "example_id": "3a3d177f-9178-4552-8a60-317b974ec66b",
                                "sense_id": "bf82b9a9-8d02-386c-aae3-3938e0175650",
                                "text": "„Es war ein kleiner Hausaltar, an den sie und ihre Mutter sich in all den Jahren gewandt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
