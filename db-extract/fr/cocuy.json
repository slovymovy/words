                        "glosses": [
                            "Eau-de-vie vénézuélienne, fabriquée à partir de tiges d’agave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d2233a4-0756-4a90-a20e-fe679e5f7145",
                                "sense_id": "f381a7cb-dcea-337e-9ea3-af880f68ac95",
                                "text": "Il est vrai qu'elle avait forcé sur le cocuy, eau-de-vie extraite des tiges grillées d’une espèce d’agave, et qu’il se pouvait que sa vision des choses et des gens en fût troublée."
                            },
                            {
                                "example_id": "d13080dc-801c-4adb-a6aa-5103a9ea478a",
                                "sense_id": "f381a7cb-dcea-337e-9ea3-af880f68ac95",
                                "text": "Devant un verre de cocuy ou un criollo, ils racontent aux filles combien ils ont ramassé de pépites ou de diamants au cours de la semaine."
                            },
                            {
                                "example_id": "f64852e9-f086-4909-bc3d-78b8b3b39561",
                                "sense_id": "f381a7cb-dcea-337e-9ea3-af880f68ac95",
                                "text": "La tradition veut que l’on prenne en premier un verre de cocuy (liqueur d’agave du Venezuela)."
                            }
                        ]
