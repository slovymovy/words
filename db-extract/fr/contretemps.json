        "fr-extract.jsonl": [
            {
                "entry_id": "2eb33088-5cd0-346d-89e2-fb4fc8c89356",
                "word": "contretemps",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "98ba4f6f-b5fb-4e12-8ebe-a81ddb697581",
                        "entry_id": "2eb33088-5cd0-346d-89e2-fb4fc8c89356",
                        "tags": [],
                        "form": "contre-temps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3c700f8-169c-3cbd-8983-854f598e2b87",
                        "entry_id": "2eb33088-5cd0-346d-89e2-fb4fc8c89356",
                        "glosses": [
                            "Accident inopiné qui nuit au succès d’une affaire et qui compromet la réalisation d’un dessein, d’un projet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e8031b-b7fc-481f-858b-36b348a640f7",
                                "sense_id": "b3c700f8-169c-3cbd-8983-854f598e2b87",
                                "text": "Il est arrivé un fâcheux contretemps dans cette affaire."
                            },
                            {
                                "example_id": "ccce1908-16b8-4a34-840e-ccb5fc8e30dd",
                                "sense_id": "b3c700f8-169c-3cbd-8983-854f598e2b87",
                                "text": "Quel contretemps !"
                            },
                            {
                                "example_id": "bf1506b7-72e7-4e24-9bff-a21141af6629",
                                "sense_id": "b3c700f8-169c-3cbd-8983-854f598e2b87",
                                "text": "Au bout d’une demi-heure, avec de grandes excuses, il nous a été dit qu’il y avait un contretemps et que nous avions le choix de rester dans l’avion ou de retourner dans la gare, ce que j’ai choisi, car je voulais rassurer le fonctionnaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "a38d66ff-66f8-36a9-acd1-62d606774b50",
                        "entry_id": "2eb33088-5cd0-346d-89e2-fb4fc8c89356",
                        "glosses": [
                            "Certain pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f04644fd-4560-4916-af76-f60a9470d9a3",
                                "sense_id": "a38d66ff-66f8-36a9-acd1-62d606774b50",
                                "text": "On fait des contretemps dans la gavotte."
                            }
                        ]
                    },
                    {
                        "sense_id": "635ee180-9c9b-372b-80a4-6a7b50c07db5",
                        "entry_id": "2eb33088-5cd0-346d-89e2-fb4fc8c89356",
                        "glosses": [
                            "Syncope rythmique qui rompt une accentuation régulière lorsqu'un son, commencé sur un temps faible, est interrompu sur le temps fort qui suit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d647c7-532c-48b1-a0c3-61337a3ede24",
                                "sense_id": "635ee180-9c9b-372b-80a4-6a7b50c07db5",
                                "text": "Mesure à contretemps."
                            },
                            {
                                "example_id": "3ecd6f58-7e5a-421b-a91d-ff65cba422fb",
                                "sense_id": "635ee180-9c9b-372b-80a4-6a7b50c07db5",
                                "text": "De son éventail elle battait pendant un instant la mesure, mais, pour ne pas abdiquer son indépendance, à contretemps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cc72a30-0572-4cb5-be6a-d750158e820e",
                        "source_entry_id": "2eb33088-5cd0-346d-89e2-fb4fc8c89356",
                        "source_sense_id": "b3c700f8-169c-3cbd-8983-854f598e2b87",
                        "source_sense_description": "Accident inopiné qui nuit au succès d’une affaire",
                        "target_lang_word": "Hindernis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hindernis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2db4c298-0bac-3902-afab-46e89e348c83",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "Gegenstand, der das Weiterkommen verhindert oder behindert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43cde951-f903-48d9-89a6-c2c012b35f94",
                                                "sense_id": "2db4c298-0bac-3902-afab-46e89e348c83",
                                                "text": "„Karl Joswig konnte und wollte er nicht als Hindernis ansehen, da Eddi Sillus es allein übernommen hatte, mit unserem Lieblingswärter fertig zu werden - Eddi, der schon früh den Meistergürtel der nordwestdeutschen Judokas erworben hatte.“"
                                            },
                                            {
                                                "example_id": "2f5a8e41-7239-4f79-b995-ca31e7d1fbbd",
                                                "sense_id": "2db4c298-0bac-3902-afab-46e89e348c83",
                                                "text": "„Es gab noch ein anderes Hindernis auf meinem Schulweg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "eine Tatsache, die eine Entwicklung verhindert oder behindert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6fbe64-f65e-4329-bd57-9f86cd0ad08e",
                                                "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                                "text": "„Erotik ist Überwindung von Hindernissen. Das verlockendste und populärste Hindernis ist die Moral.“"
                                            },
                                            {
                                                "example_id": "deed5b89-a19a-4b39-90be-f31fe7c9f3f5",
                                                "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                                "text": "Ich sehe keine Hindernisse, die einem Vertragsabschluss im Wege stehen könnten."
                                            },
                                            {
                                                "example_id": "5dad2b78-4deb-412e-935f-5238812a4417",
                                                "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                                "text": "„So sollte sich meiner Wahl immer ein Hindernis entgegensetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3d8e394e-b530-379b-9028-9316e271b722",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "durch Springen zu überwindende Konstruktion, zum Beispiel beim Hindernislauf oder beim Spring- oder Vielseitigkeitsreiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9184b899-89ee-4feb-b29d-48a4bf143c27",
                                                "sense_id": "3d8e394e-b530-379b-9028-9316e271b722",
                                                "text": "Das nächste Hindernis ist die Mauer, vor der die Stute das letzte Mal scheute."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "68fbc43e-5ef2-3aa3-8bb8-92b33c842d34",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "regelkonform zu durchfahrendes Kegelpaar auf einem Parcours"
                                        ],
                                        "tags": [
                                            "Fahrsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe397161-ac40-4d79-9cdb-ec8ab17104f5",
                                                "sense_id": "68fbc43e-5ef2-3aa3-8bb8-92b33c842d34",
                                                "text": "Wer stellt heute die Hindernisse auf?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0cfa1b8-96ad-408b-824f-ff9baa023f79",
                        "source_entry_id": "2eb33088-5cd0-346d-89e2-fb4fc8c89356",
                        "source_sense_id": "b3c700f8-169c-3cbd-8983-854f598e2b87",
                        "source_sense_description": "Accident inopiné qui nuit au succès d’une affaire",
                        "target_lang_word": "setback",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "setback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee3b6616-56d9-3a30-b209-9e7201804d11",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "An obstacle, delay, disadvantage, or blow (an adverse event which slows down, or prevents progress towards a desired outcome)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1320dd-505f-4766-8c7c-e74505066fde",
                                                "sense_id": "ee3b6616-56d9-3a30-b209-9e7201804d11",
                                                "text": "After some initial setbacks, the expedition went safely on its way."
                                            },
                                            {
                                                "example_id": "cbca7d98-84dc-4441-8426-595d032b902c",
                                                "sense_id": "ee3b6616-56d9-3a30-b209-9e7201804d11",
                                                "text": "DUKAT: I blame no one but myself. I was indiscreet. I compromised myself and have been punished accordingly. If someone under my command had behaved so outrageously, I would do the same thing to him. Besides, I assure you, this is only a temporary setback. Everything I have lost, I will regain. It's only a matter of time."
                                            },
                                            {
                                                "example_id": "5d1613d7-6d1f-42a3-8e5d-3e58c5d1ba1c",
                                                "sense_id": "ee3b6616-56d9-3a30-b209-9e7201804d11",
                                                "text": "The Constitutional Court has ruled today, November 17th, that Section 1448 of the Thai Civil and Commercial, stating that “a marriage can take place only between a man and a woman”, is constitutional under the Thai constitutional law. This decision could be a major setback for many Thai LGBTQ activist groups’ continued journey of what they call basic human rights to legally allow same-sex marriages in Thailand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8286dc9f-aaea-339f-979d-d151f6e45a06",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "Any adverse event, defeat, or impediment of progress."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b873526f-4c6f-37ad-94f8-6da9df810b3f",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "The required distance between a structure and a road."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23b78388-e8de-3b4f-b18a-e69ff4021c95",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "A step-like recession in a wall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec1b5262-b0a6-43c5-9a65-9e016f80db1f",
                                                "sense_id": "23b78388-e8de-3b4f-b18a-e69ff4021c95",
                                                "text": "Setbacks were initially used for structural reasons, but now are often mandated by land use codes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d9fbbe6-3624-31f1-b0fd-9df5e38de1b4",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "An offset to the temperature setting of a thermostat to cover a period when more or less heating is required than usual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c11b7d21-2a33-43db-a6e7-c9a0242dbf64",
                                                "sense_id": "6d9fbbe6-3624-31f1-b0fd-9df5e38de1b4",
                                                "text": "Fuel savings from thermostat setbacks have long been accepted as fact, but little documentation existed to support it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7433905d-e377-3592-8ce0-53cc4c11683a",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "A backset; a countercurrent; an eddy."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "possibly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f97b26a-83b5-3f33-97f8-b40fba5806cd",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "A backset; a check; a repulse; a relapse."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "983879b4-ec83-469a-9945-0bf3f7ab9d28",
                        "source_entry_id": "2eb33088-5cd0-346d-89e2-fb4fc8c89356",
                        "source_sense_id": "b3c700f8-169c-3cbd-8983-854f598e2b87",
                        "source_sense_description": "Accident inopiné qui nuit au succès d’une affaire",
                        "target_lang_word": "contretemps",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contretemps",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d0b6c9f-c354-3c6c-8143-1324043d8298",
                                        "entry_id": "b14acbb1-07d4-3cf7-9e4c-3d5358d4fbdf",
                                        "glosses": [
                                            "An unforeseen, inopportune, or embarrassing event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9337a34e-0be4-46d9-98eb-305d5e2e396e",
                                                "sense_id": "0d0b6c9f-c354-3c6c-8143-1324043d8298",
                                                "text": "...and said \"she had been the most efficient friend of the charity;\" and whether a whisper that had gone forth respecting her contretemps with the strange man was spread, or it had fortunately been so well managed by the Count as to have escaped observation..."
                                            },
                                            {
                                                "example_id": "58575b63-ca3d-48bd-a47f-53c525d14f58",
                                                "sense_id": "0d0b6c9f-c354-3c6c-8143-1324043d8298",
                                                "text": "\"I see that you are a born American citizen--and an earlier knowledge of that fact would have prevented this little contretemps. You are aware, Mr. Hoffman, that your name is German?\""
                                            },
                                            {
                                                "example_id": "0804c306-a671-44c9-8e23-e1363ad6f0df",
                                                "sense_id": "0d0b6c9f-c354-3c6c-8143-1324043d8298",
                                                "text": "What a strange contretemps! Its suddenness left me temporarily speechless; the embarrassment of Duare was only too obvious. Yet it was that unusual paradox, a happy contretemps--for me at least."
                                            },
                                            {
                                                "example_id": "56c890e1-9c4b-4270-8579-c1c78bbb8b74",
                                                "sense_id": "0d0b6c9f-c354-3c6c-8143-1324043d8298",
                                                "text": "Mrs. Post was the center of a notable contretemps when she spilled a spoonful of berries at a dinner of the Gourmet Society here in 1938."
                                            },
                                            {
                                                "example_id": "cdbcc4d1-65da-4613-80dc-f3787b0675dc",
                                                "sense_id": "0d0b6c9f-c354-3c6c-8143-1324043d8298",
                                                "text": "The small flap over the pronunciation of her name was but the first, and the least, of the contretemps of the succeeding session."
                                            },
                                            {
                                                "example_id": "d7cccb2e-0f5b-4ce8-9fec-1eae720cca04",
                                                "sense_id": "0d0b6c9f-c354-3c6c-8143-1324043d8298",
                                                "text": "It won't rank with the doping scandals in track and field and baseball's steroid controversy but the Rose Cup race had its own little contretemps last year."
                                            },
                                            {
                                                "example_id": "f55581ec-6951-4be5-83fe-1637e9bfe2c7",
                                                "sense_id": "0d0b6c9f-c354-3c6c-8143-1324043d8298",
                                                "text": "It is worth considering what the misperceptions about him might be if the whole “contretemps with Oprah,” as he calls it, hadn’t happened."
                                            },
                                            {
                                                "example_id": "8424137f-cb27-44c1-a462-d0aa051b080a",
                                                "sense_id": "0d0b6c9f-c354-3c6c-8143-1324043d8298",
                                                "text": "The spat was just the latest in a series of contretemps between the RN and the AfD."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16270b82-aa40-3134-a1c7-f17e7ccb1219",
                                        "entry_id": "b14acbb1-07d4-3cf7-9e4c-3d5358d4fbdf",
                                        "glosses": [
                                            "An ill-timed pass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
