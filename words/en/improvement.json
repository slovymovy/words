{
    "word_family": [
        "improve",
        "improver",
        "improvable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9372947-4848-385f-912e-50bb34063a64",
                    "sense_definition": "The process of becoming better or making something better.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_betterment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is definitely room for <w>improvement</w> in his behavior.",
                            "target_lang_translations": {
                                "ru": "В его поведении определённо есть место для <w>улучшения</w>.",
                                "zh": "他的行为确实还有<w>改善</w>的空间。"
                            }
                        },
                        {
                            "text": "The doctor noticed a gradual <w>improvement</w> in her health.",
                            "target_lang_translations": {
                                "ru": "Врач заметил постепенное <w>улучшение</w> её здоровья.",
                                "zh": "医生注意到她的健康状况有了逐渐的<w>改善</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amelioration",
                        "progress",
                        "advancement"
                    ],
                    "antonyms": [
                        "deterioration",
                        "worsening"
                    ],
                    "common_phrases": [
                        "room for improvement",
                        "self-improvement",
                        "show improvement",
                        "vast improvement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс изменения к лучшему или результат этого процесса.",
                        "zh": "变得更好或使某事变得更好的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улучшение",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "совершенствование",
                                "target_lang_sense_clarification": "развитие навыков или качеств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "改善",
                                "target_lang_sense_clarification": "指状况或环境变得更好"
                            },
                            {
                                "target_lang_word": "进步",
                                "target_lang_sense_clarification": "指水平或能力的提升"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a383fad-bea0-3b57-ace2-e78a2eb5ee1a",
                    "sense_definition": "A specific change or addition that makes something better than it was before.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_betterment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new software version is a significant <w>improvement</w> on the previous one.",
                            "target_lang_translations": {
                                "ru": "Эта новая версия программного обеспечения представляет собой значительное <w>улучшение</w> по сравнению с предыдущей.",
                                "zh": "这个新版本的软件比上一个版本有了显著的<w>改进</w>。"
                            }
                        },
                        {
                            "text": "We have made several <w>improvements</w> to the safety procedures.",
                            "target_lang_translations": {
                                "ru": "Мы внесли несколько <w>усовершенствований</w> в процедуры безопасности.",
                                "zh": "我们对安全程序做了几项<w>改进</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "improvement on",
                        "make improvements",
                        "big improvement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное изменение или нововведение, которое делает что-то лучше, чем раньше.",
                        "zh": "使某事物比以前更好的具体改变或增补。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усовершенствование",
                                "target_lang_sense_clarification": "техническое или системное улучшение"
                            },
                            {
                                "target_lang_word": "улучшение",
                                "target_lang_sense_clarification": "конкретное изменение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "改进",
                                "target_lang_sense_clarification": "针对具体事物或方法的优化"
                            },
                            {
                                "target_lang_word": "改良",
                                "target_lang_sense_clarification": "指对原有事物的修正或提升"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dd65ef2-1ad8-3e36-bbe8-d9186cf2ef90",
                    "sense_definition": "A renovation, addition, or change to a property or building that increases its value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the weekend working on various home <w>improvements</w>.",
                            "target_lang_translations": {
                                "ru": "Они провели выходные, занимаясь различным <w>благоустройством</w> дома.",
                                "zh": "他们周末都在忙着进行各种房屋<w>装修</w>。"
                            }
                        },
                        {
                            "text": "The landlord paid for the <w>improvements</w> to the kitchen and bathroom.",
                            "target_lang_translations": {
                                "ru": "Домовладелец заплатил за <w>ремонт</w> кухни и ванной.",
                                "zh": "房东支付了厨房和浴室的<w>改造</w>费用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "home improvement",
                        "capital improvement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ремонт, пристройка или изменение недвижимости, повышающие её стоимость.",
                        "zh": "对房产或建筑进行的翻新、增建或改动，以增加其价值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благоустройство",
                                "target_lang_sense_clarification": "обустройство дома или территории"
                            },
                            {
                                "target_lang_word": "ремонт",
                                "target_lang_sense_clarification": "обновление помещений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装修",
                                "target_lang_sense_clarification": "指房屋内部的翻新"
                            },
                            {
                                "target_lang_word": "改造",
                                "target_lang_sense_clarification": "指对建筑结构或设施的改动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e57be96c-ae40-3c2f-835a-09569ecb2a49",
                    "sense_definition": "The act of using something profitably or for good purpose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_use",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher spoke about the <w>improvement</w> of one's time for spiritual growth.",
                            "target_lang_translations": {
                                "ru": "Проповедник говорил о <w>полезном использовании</w> своего времени для духовного роста.",
                                "zh": "牧师谈到了如何<w>善用</w>时间以促进精神成长。"
                            }
                        },
                        {
                            "text": "He sought the <w>improvement</w> of every opportunity that came his way.",
                            "target_lang_translations": {
                                "ru": "Он стремился к <w>полезному применению</w> каждой возможности, которая ему представлялась.",
                                "zh": "他力求<w>善用</w>每一个出现在他面前的机会。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the profitable use or application of something, often in religious or formal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование чего-либо с пользой или выгодой (устаревшее или формальное значение).",
                        "zh": "将某物用于有益的目的或从中获益（陈旧或正式用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полезное использование",
                                "target_lang_sense_clarification": "извлечение выгоды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "善用",
                                "target_lang_sense_clarification": "指充分利用资源或时间"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}