                    {
                        "translation_id": "2b5d9d7e-6ffb-4f9f-aa72-514b0520e115",
                        "source_entry_id": "e27d4032-d234-31fc-8c33-b6b618af22fd",
                        "source_sense_id": "c3300f2a-1b4a-309d-8b43-1244a6151b3e",
                        "target_lang_word": "Glöckner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glöckner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd92de58-9acd-3fad-a708-6506d0302278",
                                        "entry_id": "7422fe01-8651-3fa7-a634-579b7bd8b72d",
                                        "glosses": [
                                            "Person, deren Aufgabe es ist, ein in oder an Kirchen aufgehängtes Läuteinstrument durch Bewegen zum Klingen zu bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec84dc1a-1516-46bd-bb9d-e9d735973e3f",
                                                "sense_id": "bd92de58-9acd-3fad-a708-6506d0302278",
                                                "text": "Der Beruf des Glöckners ist heute so gut wie ausgestorben."
                                            },
                                            {
                                                "example_id": "c92bb2a0-359b-4a2d-96a4-98c82f4961de",
                                                "sense_id": "bd92de58-9acd-3fad-a708-6506d0302278",
                                                "text": "„Die Menschen, die ich mit meiner Großmutter aufsuchte, wie die Melkotsleute und Bjarni, der Glöckner, hatten keine Kinder, und meine Großmutter hatte alle ihre Kinder verloren.“"
                                            },
                                            {
                                                "example_id": "e173b65d-d658-4d95-b748-39c0e6032244",
                                                "sense_id": "bd92de58-9acd-3fad-a708-6506d0302278",
                                                "text": "„Gregor war 1858 zur Welt gekommen, und bereits mit zwölf Jahren hatte er begonnen, dem alten Glöckner in der Kirche zu helfen.“"
                                            },
                                            {
                                                "example_id": "2673d473-3c02-4fa6-bce5-022b78182305",
                                                "sense_id": "bd92de58-9acd-3fad-a708-6506d0302278",
                                                "text": "„Der Glöckner behauptete, man könne vom Kirchturm aus die Staubwolke erkennen, die sich zusammenballte, wo die Ebene an die ferne Hügelkette stieß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
