                        "glosses": [
                            "onderneming die zich bezighoudt met het innen van openstaande vorderingen in opdracht van, hoofdzakelijk, andere ondernemingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbc9703b-45e3-4234-bb28-dcb61347749b",
                                "sense_id": "40753352-ecef-3fd1-be70-ffd805db6ee5",
                                "text": "FNV noemt het diefstal als werkgevers betaalde premies niet afdragen. Het pensioenfonds Vervoer heeft besloten sneller een incassobedrijf te sturen."
                            },
                            {
                                "example_id": "bad5ff5d-d1d5-4c5d-ae86-273238492ec7",
                                "sense_id": "40753352-ecef-3fd1-be70-ffd805db6ee5",
                                "text": "Bijna driekwart van de ondernemers in landen in en rond Europa zegt nog geen economische opleving te zien. Dat blijkt uit onderzoek van incassobedrijf Intrum Justitia. Het bedrijf deed navraag bij 10.000 bedrijven in 31 landen. 72 procent ziet nog geen tekenen van economisch herstel."
                            }
                        ]
