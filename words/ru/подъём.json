{
    "word_family": [
        "поднимать",
        "подняться",
        "подъёмный",
        "подъёмник"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5bab627e-6591-39a4-b00f-01a54e64c752",
                    "sense_definition": "Пробуждение от сна, вставание с постели, а также сигнал или время для этого",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "бодрствование",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В нашем летнем лагере ранний <w>подъём</w> был назначен на семь часов утра.",
                            "target_lang_translations": {
                                "en": "In our summer camp, the early <w>wake-up</w> was scheduled for seven in the morning."
                            }
                        },
                        {
                            "text": "Дежурный офицер громко скомандовал <w>подъём</w>, и солдаты сразу начали одеваться.",
                            "target_lang_translations": {
                                "en": "The duty officer loudly ordered <w>reveille</w>, and the soldiers immediately began to get dressed."
                            }
                        }
                    ],
                    "synonyms": [
                        "побудка",
                        "вставание"
                    ],
                    "antonyms": [
                        "отбой"
                    ],
                    "common_phrases": [
                        "ранний подъём",
                        "время подъёма",
                        "команда на подъём"
                    ],
                    "target_lang_definitions": {
                        "en": "Awakening from sleep, getting out of bed, or a signal or scheduled time for this (such as reveille)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reveille",
                                "target_lang_sense_clarification": "military wake-up signal"
                            },
                            {
                                "target_lang_word": "wake-up",
                                "target_lang_sense_clarification": "time or act of getting up"
                            },
                            {
                                "target_lang_word": "getting up",
                                "target_lang_sense_clarification": "act of rising from bed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fdc2b54-fd5a-33b6-a0a2-aaf6ec79cbbd",
                    "sense_definition": "Перемещение чего-либо снизу вверх, действие по значению глагола <w>поднимать</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "движение_вверх",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для безопасного <w>подъёма</w> тяжёлых строительных материалов рабочие использовали специальный кран.",
                            "target_lang_translations": {
                                "en": "For the safe <w>lifting</w> of heavy building materials, the workers used a special crane."
                            }
                        },
                        {
                            "text": "Утром на главной площади города состоялся торжественный <w>подъём</w> государственного флага.",
                            "target_lang_translations": {
                                "en": "In the morning, the ceremonial <w>raising</w> of the national flag took place in the city's main square."
                            }
                        }
                    ],
                    "synonyms": [
                        "поднятие"
                    ],
                    "antonyms": [
                        "опускание",
                        "спуск"
                    ],
                    "common_phrases": [
                        "подъём флага",
                        "подъём тяжестей"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of raising or moving something upwards from a lower position"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lifting",
                                "target_lang_sense_clarification": "action of moving something upward"
                            },
                            {
                                "target_lang_word": "raising",
                                "target_lang_sense_clarification": "act of hoisting or elevating something"
                            },
                            {
                                "target_lang_word": "lift",
                                "target_lang_sense_clarification": "act of lifting or hoisting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00798979-93f1-37c9-a05e-1e684b39ba78",
                    "sense_definition": "Движение вверх, восхождение на высоту",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "движение_вверх",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Долгий <w>подъём</w> на вершину горы занял у туристов почти весь день.",
                            "target_lang_translations": {
                                "en": "The long <w>ascent</w> to the mountain peak took the tourists almost the entire day."
                            }
                        },
                        {
                            "text": "После взлёта самолёт начал плавный <w>подъём</w> на нужную высоту.",
                            "target_lang_translations": {
                                "en": "After takeoff, the aircraft began a smooth <w>climb</w> to the required altitude."
                            }
                        }
                    ],
                    "synonyms": [
                        "восхождение"
                    ],
                    "antonyms": [
                        "спуск"
                    ],
                    "common_phrases": [
                        "подъём на гору",
                        "подъём на вершину"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of ascending, climbing, or gaining altitude"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ascent",
                                "target_lang_sense_clarification": "climb up a mountain or rise in altitude"
                            },
                            {
                                "target_lang_word": "climb",
                                "target_lang_sense_clarification": "act of ascending a slope or height"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "922143dd-27e8-3bbf-bd44-8c3eaa3e8851",
                    "sense_definition": "Участок дороги или местности, идущий вверх под наклоном",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "рельеф",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель переключил скорость перед тем, как машина въехала на крутой <w>подъём</w>.",
                            "target_lang_translations": {
                                "en": "The driver shifted gears before the car drove onto a steep <w>incline</w>."
                            }
                        },
                        {
                            "text": "После долгой прогулки этот затяжной <w>подъём</w> показался пешеходам очень тяжёлым.",
                            "target_lang_translations": {
                                "en": "After a long walk, this sustained <w>slope</w> seemed very tough to the pedestrians."
                            }
                        }
                    ],
                    "antonyms": [
                        "спуск"
                    ],
                    "common_phrases": [
                        "крутой подъём",
                        "затяжной подъём"
                    ],
                    "target_lang_definitions": {
                        "en": "An upward slope, gradient, or incline on a road or terrain"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slope",
                                "target_lang_sense_clarification": "upward incline on terrain or a road"
                            },
                            {
                                "target_lang_word": "incline",
                                "target_lang_sense_clarification": "upward gradient on a path or road"
                            },
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "upward elevation of the ground"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0628392c-f37d-32f6-b0b7-da92ce1f55c8",
                    "sense_definition": "Быстрое развитие, рост, улучшение состояния чего-либо",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "развитие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В последние годы в стране наблюдается заметный экономический <w>подъём</w> и рост производства.",
                            "target_lang_translations": {
                                "en": "In recent years, the country has seen a notable economic <w>upturn</w> and growth in manufacturing."
                            }
                        },
                        {
                            "text": "Новые реформы вызвали общий <w>подъём</w> промышленности во всех регионах государства.",
                            "target_lang_translations": {
                                "en": "The new reforms caused a general <w>boost</w> in industry across all regions of the state."
                            }
                        }
                    ],
                    "synonyms": [
                        "рост",
                        "расцвет"
                    ],
                    "antonyms": [
                        "спад",
                        "кризис"
                    ],
                    "common_phrases": [
                        "экономический подъём",
                        "подъём промышленности"
                    ],
                    "target_lang_definitions": {
                        "en": "Rapid growth, upsurge, or improvement in development or economy"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upsurge",
                                "target_lang_sense_clarification": "strong rise or growth"
                            },
                            {
                                "target_lang_word": "upturn",
                                "target_lang_sense_clarification": "economic or developmental improvement"
                            },
                            {
                                "target_lang_word": "boost",
                                "target_lang_sense_clarification": "rise or growth in activity"
                            },
                            {
                                "target_lang_word": "boom",
                                "target_lang_sense_clarification": "period of rapid economic expansion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43f7373b-80d2-3e03-bcf4-6a391f4bd60e",
                    "sense_definition": "Состояние высокого воодушевления, прилива сил и радости",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "чувства",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Художник работал с необыкновенным душевным <w>подъёмом</w>, забывая про усталость и сон.",
                            "target_lang_translations": {
                                "en": "The artist worked with extraordinary spiritual <w>uplift</w>, forgetting fatigue and sleep."
                            }
                        },
                        {
                            "text": "После неожиданной победы любимой команды зрители испытали сильный эмоциональный <w>подъём</w>.",
                            "target_lang_translations": {
                                "en": "After their favorite team's unexpected victory, the spectators felt a powerful emotional <w>surge</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "воодушевление",
                        "энтузиазм"
                    ],
                    "antonyms": [
                        "упадок"
                    ],
                    "common_phrases": [
                        "душевный подъём",
                        "эмоциональный подъём"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of high spirits, inspiration, enthusiasm, or emotional surge"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uplift",
                                "target_lang_sense_clarification": "feeling of high spirits or inspiration"
                            },
                            {
                                "target_lang_word": "enthusiasm",
                                "target_lang_sense_clarification": "surge of eagerness and energy"
                            },
                            {
                                "target_lang_word": "lift",
                                "target_lang_sense_clarification": "improvement in mood or spirits"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d4c4b21-a064-332d-ad83-be5197492fbb",
                    "sense_definition": "Выпуклая верхняя часть стопы от пальцев к щиколотке",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "анатомия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из-за высокого <w>подъёма</w> ноги ему было трудно подобрать удобные кожаные туфли.",
                            "target_lang_translations": {
                                "en": "Because of his high <w>instep</w>, it was difficult for him to find comfortable leather shoes."
                            }
                        },
                        {
                            "text": "Новые сапоги сильно жали в <w>подъёме</w>, поэтому пришлось купить обувь на размер больше.",
                            "target_lang_translations": {
                                "en": "The new boots were very tight across the <w>instep</w>, so he had to buy shoes one size larger."
                            }
                        }
                    ],
                    "common_phrases": [
                        "высокий подъём",
                        "подъём ноги"
                    ],
                    "target_lang_definitions": {
                        "en": "The arched upper surface of the human foot between the toes and the ankle"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "instep",
                                "target_lang_sense_clarification": "upper surface of the human foot"
                            },
                            {
                                "target_lang_word": "arch",
                                "target_lang_sense_clarification": "curve of the foot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fa61b02-7d5b-3de0-95f4-34b3c2bf3355",
                    "sense_definition": "Степень поднятия спинки языка к нёбу при произнесении гласных звуков",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "лингвистика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В русской фонетике звук 'о' классифицируется как гласный среднего <w>подъёма</w>.",
                            "target_lang_translations": {
                                "en": "In Russian phonetics, the sound 'o' is classified as a mid-<w>height</w> vowel."
                            }
                        },
                        {
                            "text": "Преподаватель подробно описал различия между звуками верхнего и нижнего <w>подъёма</w>.",
                            "target_lang_translations": {
                                "en": "The instructor described in detail the differences between high- and low-<w>height</w> sounds."
                            }
                        }
                    ],
                    "common_phrases": [
                        "гласный среднего подъёма",
                        "гласный верхнего подъёма"
                    ],
                    "target_lang_definitions": {
                        "en": "Vowel height; the vertical position of the tongue relative to the roof of the mouth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "height",
                                "target_lang_sense_clarification": "vowel height in phonetics"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6613877c-6a19-34ee-9e19-480838b1c739",
                    "sense_definition": "Сельский населённый пункт в Тамбовской области России",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "топоним",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Небольшое село <w>Подъём</w> находится недалеко от города Тамбова среди живописных полей.",
                            "target_lang_translations": {
                                "en": "The small village of <w>Podyom</w> is located near the city of Tambov among picturesque fields."
                            }
                        },
                        {
                            "text": "Летом наши дальние родственники часто приезжают на отдых в тихий <w>Подъём</w>.",
                            "target_lang_translations": {
                                "en": "In summer, our distant relatives often come to relax in quiet <w>Podyom</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A rural locality in Tambov Oblast, Russia"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Podyom",
                                "target_lang_sense_clarification": "village in Tambov Oblast"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99e83086-4460-3e98-bb69-b00d034501de",
                    "sense_definition": "Посёлок в Тюменском районе Тюменской области России",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "топоним",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Посёлок <w>Подъём</w> расположен в нескольких десятках километров от областного центра Тюмени.",
                            "target_lang_translations": {
                                "en": "The settlement of <w>Podyom</w> is located a few tens of kilometers from the regional center of Tyumen."
                            }
                        },
                        {
                            "text": "Новая асфальтированная трасса соединяет посёлок <w>Подъём</w> с соседними деревнями района.",
                            "target_lang_translations": {
                                "en": "A new paved highway connects the settlement of <w>Podyom</w> with neighboring villages in the district."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A settlement in Tyumen District, Tyumen Oblast, Russia"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Podyom",
                                "target_lang_sense_clarification": "settlement in Tyumen Oblast"
                            }
                        ]
                    }
                }
            ]
        }
    ]
