                "translations": [
                    {
                        "translation_id": "35954195-5171-493d-9780-0e867a76b2c9",
                        "source_entry_id": "ee8dbea1-5004-39cf-a4a1-5d585fae3105",
                        "source_sense_id": "9eacfbe5-41a5-300e-84f8-6df70050c7c4",
                        "target_lang_word": "cheat",
