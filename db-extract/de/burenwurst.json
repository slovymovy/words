                                "sense_id": "59761df0-96d2-3a39-ba20-0c596369cd1c",
                                "text": "Ich esse jeden Tag eine Burenwurst.",
                                "translation": "I eat a Burenwurst every day.",
                                "english": "I eat a Burenwurst every day."
                            },
                            {
                                "example_id": "9be3f87d-b0e8-4b59-8aaf-64330e4f83d0",
                                "sense_id": "59761df0-96d2-3a39-ba20-0c596369cd1c",
                                "text": "Die „Haaße“ (Heiße) ist die Burenwurst, ein grobe Brühwurst, die nur im Wasser erhitzt wird."
                            }
                        ]
                    }
