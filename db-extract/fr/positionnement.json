                "senses": [
                    {
                        "sense_id": "659f316f-0471-3705-94f9-5066c1a2e465",
                        "entry_id": "4614b36c-bcf3-3b99-af4b-169d7f20a35e",
                        "glosses": [
                            "Détermination de la position d'un objet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d89ba71-5860-4e6d-abf8-f3cf2c82b48b",
                                "sense_id": "659f316f-0471-3705-94f9-5066c1a2e465",
                                "text": "Avec le GPS on sait où un train se trouve sur la carte de France, avec Galileo on sait sur quelle voie il se trouve, ce qui rend possible son pilotage avec le système de positionnement par satellite, explique le patron du CNES."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ced5755-31f4-3c8b-99c8-deac4c997dc0",
                        "entry_id": "4614b36c-bcf3-3b99-af4b-169d7f20a35e",
                        "glosses": [
                            "Action de positionner, de placer dans une certaine position selon le but recherché ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa41364e-05d9-42f5-ae10-c8e5cd4abbe0",
                                "sense_id": "8ced5755-31f4-3c8b-99c8-deac4c997dc0",
                                "text": "Le positionnement des troupes avant une bataille est souvent décisif."
                            },
                            {
                                "example_id": "bba49cdb-0b4c-41ab-aea5-0622a27800c6",
                                "sense_id": "8ced5755-31f4-3c8b-99c8-deac4c997dc0",
                                "text": "Le bon positionnement de cette goupille est très important si l'on veut que la machine fonctionne bien."
                            }
                        ]
                    },
                    {
                        "sense_id": "240ab30f-23e0-3096-9610-f25b4a42454a",
                        "entry_id": "4614b36c-bcf3-3b99-af4b-169d7f20a35e",
                        "glosses": [
                            "Détermination de l'image que se fera le client des produits vendus sur le marché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1af6f5a5-b802-4ca9-b550-ed757dee40af",
                                "sense_id": "240ab30f-23e0-3096-9610-f25b4a42454a",
                                "text": "Le positionnement est le choix d'une stratégie marketing permettant de donner à une offre (produit, marque ou enseigne) une position crédible, différente et attractive au sein d’un marché et dans l’esprit des clients."
                            }
                        ]
                    }
                ],
