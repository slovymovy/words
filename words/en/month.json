            "senses": [
                {
                    "sense_id": "c23f0c3b-6537-3fab-aa13-f5a443ea6917",
                    "sense_definition": "One of the twelve named periods of time into which a year is divided, such as January or February.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "July is my favourite <w>month</w>.",
                            "target_lang_translations": {
                                "ru": "Июль — мой любимый <w>месяц</w>.",
                                "tr": "Temmuz benim en sevdiğim <w>aydır</w>.",
                                "nl": "Juli is mijn favoriete <w>maand</w>.",
                                "pl": "Lipiec to mój ulubiony <w>miesiąc</w>.",
                                "de": "Der Juli ist mein Lieblings<w>monat</w>.",
                                "fr": "Juillet est mon <w>mois</w> préféré.",
                                "it": "Luglio è il mio <w>mese</w> preferito.",
                                "cs": "Červenec je můj nejoblíbenější <w>měsíc</w>.",
                                "es": "Julio es mi <w>mes</w> favorito."
                            }
                        },
                        {
                            "text": "We have to pay the rent every <w>month</w>.",
                            "target_lang_translations": {
                                "ru": "Мы должны платить за аренду каждый <w>месяц</w>.",
                                "tr": "Kirayı her <w>ay</w> ödemek zorundayız.",
                                "nl": "We moeten de huur elke <w>maand</w> betalen.",
                                "pl": "Musimy płacić czynsz co <w>miesiąc</w>.",
                                "de": "Wir müssen die Miete jeden <w>Monat</w> bezahlen.",
                                "fr": "Nous devons payer le loyer chaque <w>mois</w>.",
                                "it": "Dobbiamo pagare l'affitto ogni <w>mese</w>.",
                                "cs": "Musíme platit nájem každý <w>měsíc</w>.",
                                "es": "Tenemos que pagar el alquiler cada <w>mes</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "next month",
                        "last month",
                        "every month",
                        "this month"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из двенадцати периодов времени, на которые делится год, например, январь или февраль.",
                        "tr": "Yılın bölündüğü Ocak veya Şubat gibi on iki isimlendirilmiş zaman diliminden her biri.",
                        "nl": "Een van de twaalf benoemde perioden waarin een jaar is verdeeld, zoals januari of februari.",
                        "pl": "Jeden z dwunastu nazwanych okresów, na które dzieli się rok, np. styczeń lub luty.",
                        "de": "Einer der zwölf benannten Zeitabschnitte, in die ein Jahr unterteilt ist, wie Januar oder Februar.",
                        "fr": "L'une des douze périodes de temps nommées en lesquelles une année est divisée, comme janvier ou février.",
                        "it": "Uno dei dodici periodi di tempo in cui è diviso l'anno, come gennaio o febbraio.",
                        "cs": "Jedno z dvanácti pojmenovaných období, na která se dělí rok, jako je leden nebo únor.",
                        "es": "Uno de los doce períodos de tiempo en que se divide un año, como enero o febrero."
                    },
