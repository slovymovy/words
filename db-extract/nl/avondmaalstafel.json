                        "sense_id": "23a08d50-b1db-33b3-af08-0427b61bc3bc",
                        "entry_id": "cfeb1fba-7269-3c50-bf0d-8aee962ff7ac",
                        "glosses": [
                            "tafel gebruikt bij de viering van het Laatste Avondmaal"
                        ],
                        "tags": [
                            "protestantisme"
                        ],
                        "examples": [
                            {
                                "example_id": "6ba9200c-c869-4d67-9066-e3ae7e2a5992",
                                "sense_id": "23a08d50-b1db-33b3-af08-0427b61bc3bc",
                                "text": "De opvattingen over kerkinrichting waren in de tussentijd namelijk sterk veranderd onder invloed van de Liturgische Beweging binnen de Nederlandse Hervormde Kerk. Kort gezegd komen de nieuwe opvattingen hierop neer: het middelpunt van de eredienst dient het liturgisch centrum te zijn, dat zich vooraan in de kerk of in het koor behoort te bevinden, met niet alleen een preekstoel maar vooral ook een avondmaalstafel."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a31d31d-9072-3164-bfd8-831787165329",
                        "entry_id": "cfeb1fba-7269-3c50-bf0d-8aee962ff7ac",
                        "glosses": [
                            "weergave van het Laatste Avondmaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f655a0be-7048-4465-b9bd-99e8ca167e4a",
                                "sense_id": "0a31d31d-9072-3164-bfd8-831787165329",
                                "text": "Grenzen worden getoond en tegelijk uitgewist, zoals op het schilderij Crack L.A. waarop de bloedrode realiteit van de verf over Da Vinci's avondmaalstafel heendruipt."
                            }
                        ]
                    },
                    {
                        "sense_id": "061396a2-fb29-3ff5-98ee-6b8cd5a92201",
                        "entry_id": "cfeb1fba-7269-3c50-bf0d-8aee962ff7ac",
                        "glosses": [
                            "meubel bestaande uit een vlak op poten dat bestemd is om aan te dineren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49c85e73-bfcc-405d-abdf-77bab98a3148",
                                "sense_id": "061396a2-fb29-3ff5-98ee-6b8cd5a92201",
                                "text": "Zo lijkt het in elkaar timmeren van een avondmaalstafel veel op het timmeren van een ronde tafel, de voorzittershamer van koning Arthur veel op de doffe klop van een kruisiging."
                            }
                        ]
                    }
