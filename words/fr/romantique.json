                },
                {
                    "sense_id": "dc1e4954-1eff-31e6-9fa1-2c9ee6b1a6ca",
                    "sense_definition": "Qui manque de réalisme pratique, où l'imagination l'emporte sur les réalités.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "idealisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a une vision <w>romantique</w> de la vie qui ne correspond pas aux réalités économiques."
                        },
                        {
                            "text": "Croire que tout s'arrangera sans effort relève d'une illusion purement <w>romantique</w>."
                        }
                    ],
                    "synonyms": [
                        "idéaliste",
                        "chimérique",
                        "utopique"
                    ],
                    "antonyms": [
                        "réaliste",
                        "pragmatique"
                    ],
                    "common_phrases": [
                        "vision romantique",
                        "illusion romantique"
                    ]
                }
            ]
        },
        {
