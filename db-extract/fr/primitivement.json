        "fr-extract.jsonl": [
            {
                "entry_id": "55f7e155-e01f-3a3e-a42f-4301cc057541",
                "word": "primitivement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8af12a71-d354-3937-a663-0c32d3a7c6d7",
                        "entry_id": "55f7e155-e01f-3a3e-a42f-4301cc057541",
                        "glosses": [
                            "À l’origine, originairement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeb265d2-c7bf-4bc7-9b5c-4570f878af18",
                                "sense_id": "8af12a71-d354-3937-a663-0c32d3a7c6d7",
                                "text": "Suivant les principes de la religion, cette soustraction de grâces ne vient pas de Dieu primitivement, pour m’exprimer de la sorte, mais de nous-mêmes, …"
                            },
                            {
                                "example_id": "39adb10c-7817-40ae-b671-842ae50dd124",
                                "sense_id": "8af12a71-d354-3937-a663-0c32d3a7c6d7",
                                "text": "Puisque les éléphants et les autres animaux quadrupèdes de l’Afrique et des grandes Indes ont primitivement occupé les terres du nord dans les deux continents, …"
                            },
                            {
                                "example_id": "616a4f22-3b9f-4ed0-a099-cd2e1085c675",
                                "sense_id": "8af12a71-d354-3937-a663-0c32d3a7c6d7",
                                "text": "Elle était primitivement desservie par des bénédictins; mais vers 1343 Philippe de Valois en fit don aux cordeliers."
                            },
                            {
                                "example_id": "5cdd25d9-56bf-4fab-9d24-1de8ee09dcbf",
                                "sense_id": "8af12a71-d354-3937-a663-0c32d3a7c6d7",
                                "text": "Donc, primitivement, il y avait eu là quatre maisons distinctes qui n'en faisaient plus qu'une et qui devaient appartenir maintenant au même propriétaire."
                            },
                            {
                                "example_id": "590405ad-d5d8-48c8-8f49-67de2e0e26ba",
                                "sense_id": "8af12a71-d354-3937-a663-0c32d3a7c6d7",
                                "text": "Cette nation a su transformer une race primitivement sauvage en des êtres civilisés ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cabe237-0fe8-411e-abaa-8d123bf3c601",
                        "source_entry_id": "55f7e155-e01f-3a3e-a42f-4301cc057541",
                        "source_sense_id": "8af12a71-d354-3937-a663-0c32d3a7c6d7",
                        "target_lang_word": "originally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "originally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                        "entry_id": "9157079e-624d-3ee9-b135-0d6d2deeb4ea",
                                        "glosses": [
                                            "As it was in the beginning; at first."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d66e37-82ce-4e15-869e-f6f7d6cd2e25",
                                                "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                                "text": "Originally, this paper was white, but over the years it has yellowed with age."
                                            },
                                            {
                                                "example_id": "af10b5cb-60e7-4daf-8e5b-63bc093f8653",
                                                "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                                "text": "There are 36 known praenomina, though there may originally have been more."
                                            },
                                            {
                                                "example_id": "a43b0e92-06ba-4da6-9f72-96a918009c9c",
                                                "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                                "text": "The little green men were clearly professional soldiers by their bearing, carried Russian weapons, and wore Russian combat fatigues, but they had no identifying insignia. Vladimir Putin originally denied they were Russian soldiers; that April, he confirmed they were."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae720122-c444-30ab-985d-c8379b5d9818",
                                        "entry_id": "9157079e-624d-3ee9-b135-0d6d2deeb4ea",
                                        "glosses": [
                                            "In an original manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b2f3562-9390-4bae-80bf-d57d71676d16",
                                                "sense_id": "ae720122-c444-30ab-985d-c8379b5d9818",
                                                "text": "They had to think originally to come up with those creative ideas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efe1b174-344d-4dfd-9bbe-9744bcfc0a67",
