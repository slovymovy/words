            "senses": [
                {
                    "sense_id": "1e83f3a6-0696-38f5-abe9-82b00c1b6126",
                    "sense_definition": "etwas empfangen, erhalten oder in seinen Besitz übergehen lassen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "erhalten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zum Geburtstag <w>bekomme</w> ich jedes Jahr viele Geschenke von meiner Familie."
                        },
                        {
                            "text": "Hast du meine wichtige E-Mail von heute Morgen schon <w>bekommen</w>?"
                        }
                    ],
                    "synonyms": [
                        "kriegen"
                    ],
                    "common_phrases": [
                        "eine Antwort bekommen",
                        "ein Geschenk bekommen",
                        "Besuch bekommen"
                    ]
                },
                {
                    "sense_id": "034d15fa-6884-3c87-8edd-ed968bf418ab",
                    "sense_definition": "sich eine Krankheit oder körperliche Beschwerden zuziehen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "erkranken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im nasskalten Herbst <w>bekommen</w> viele Kinder einen Schnupfen."
                        },
                        {
                            "text": "Wenn du im Regen ohne Jacke draußen bleibst, wirst du sicher Fieber <w>bekommen</w>."
