                                    },
                                    {
                                        "sense_id": "1fdf3465-2a54-3218-8cc0-05d19d1d5366",
                                        "entry_id": "1e8ca906-f811-34bf-915e-363fc4fafa18",
                                        "glosses": [
                                            "(о погоде) безоблачно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22442a74-a0d9-4489-b8f7-8630c3146837",
                                                "sense_id": "1fdf3465-2a54-3218-8cc0-05d19d1d5366",
                                                "text": "Завтра в Санкт-Петербурге ясно, температура плюс двадцать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9583a78f-01ef-3f5e-aa61-34332f40458a",
                                        "entry_id": "1e8ca906-f811-34bf-915e-363fc4fafa18",
                                        "glosses": [
                                            "отчётливо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f407b59-7e55-4372-8258-5cef0592a0d3",
                                                "sense_id": "9583a78f-01ef-3f5e-aa61-34332f40458a",
                                                "text": "Ясно он никогда не обдумывал этого вопроса, но смутно ему представлялось, что жена давно догадывается, что он не верен ей, и смотрит на это сквозь пальцы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a46c1d8-f4f8-34f8-9a42-1cd8a24a5f3b",
                                        "entry_id": "1e8ca906-f811-34bf-915e-363fc4fafa18",
                                        "glosses": [
                                            "безл., предик. понятно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0e8681-5de1-4aa4-a583-dcbb180e93f7",
                                                "sense_id": "2a46c1d8-f4f8-34f8-9a42-1cd8a24a5f3b",
                                                "text": "Вам всё ясно, или ещё раз объяснить?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ясно",
                                "target_lang_code": "ru",
                                "target_senses": [
