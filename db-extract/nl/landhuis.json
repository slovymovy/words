                "senses": [
                    {
                        "sense_id": "70c534e7-5ea6-33ff-8b9e-05875cae7d55",
                        "entry_id": "405dcf5f-54d6-3ae2-860b-8c9b0121bc2f",
                        "glosses": [
                            "een groot huis op het platteland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9b32991-fea9-4da6-8ff9-4ebd2e0cf330",
                                "sense_id": "70c534e7-5ea6-33ff-8b9e-05875cae7d55",
                                "text": "Diverse tentoonstellingen en activiteiten werden van het Centraal Museum in het landhuis georganiseerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7578114d-1d8f-4b65-960a-16285681f3de",
                        "source_entry_id": "405dcf5f-54d6-3ae2-860b-8c9b0121bc2f",
                        "source_sense_id": "70c534e7-5ea6-33ff-8b9e-05875cae7d55",
                        "source_sense_description": "een groot huis op het platteland",
                        "target_lang_word": "Landhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                                        "entry_id": "2ab88812-0f76-3a32-a1a3-349205557733",
                                        "glosses": [
                                            "Haus auf dem Land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3137d1c8-8295-4209-9b9d-f9713d9f5ba5",
                                                "sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                                                "text": "„Der Wahlmünchner weilte noch in der Sommerfrische in seinem Landhaus in Bad Tölz.“"
                                            },
                                            {
                                                "example_id": "2b7452e1-e1dd-475b-958a-6028020470f0",
                                                "sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                                                "text": "„Je mehr U-Boote für die Kriegsflotte vom Stapel laufen und zum Einsatz gelangen, desto mehr Platz wird benötigt, und schon bald werden noch weitere Hotels und Landhäuser beschlagnahmt.“"
                                            },
                                            {
                                                "example_id": "e48eb28d-c5ad-4365-8a13-cc1866995f8d",
                                                "sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                                                "text": "„Graf Rastoptschin nahm noch rasch im Wagen Platz und befahl dem Kutscher, nach Sokolniki zu seinem Landhause zu fahren.“"
                                            },
                                            {
                                                "example_id": "1c4833aa-e2f4-4c57-a2cb-ca533d92f078",
                                                "sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                                                "text": "„Schon damals, das ist vor fünfundzwanzig bis dreißig Jahen, waren die Ufer des Mississippi mehrere hundert Meilen entlang mit herrlichen Pflanzungen bedeckt, aus denen prachtvolle Landhäuser hervorragten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b1c5e6c-cc24-33be-9f10-33613df4ac9d",
                                        "entry_id": "2ab88812-0f76-3a32-a1a3-349205557733",
                                        "glosses": [
                                            "Amtssitz von Regierung und Landtag (eines österreichischen Bundeslandes)"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b488b488-3ffa-479b-b1af-797aa9390af9",
                                                "sense_id": "1b1c5e6c-cc24-33be-9f10-33613df4ac9d",
                                                "text": "Später zog das Landesverkehrsamt als Abteilung IIc ins Tiroler Landhaus um."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "699f926a-beb8-38a1-b261-2405a39349c0",
                                        "entry_id": "2ab88812-0f76-3a32-a1a3-349205557733",
                                        "glosses": [
                                            "Versammlungshaus für Landstände"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ed2686-2613-4d62-89d0-e31606191e76",
                                                "sense_id": "699f926a-beb8-38a1-b261-2405a39349c0",
                                                "text": "Rechts sehen Sie das ehemalige Landhaus, in dem zeitweise die Landstände tagten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "474d5b4b-588f-4dfb-ac29-47e9689dbdbc",
                        "source_entry_id": "405dcf5f-54d6-3ae2-860b-8c9b0121bc2f",
                        "source_sense_id": "70c534e7-5ea6-33ff-8b9e-05875cae7d55",
                        "source_sense_description": "een groot huis op het platteland",
                        "target_lang_word": "Villa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Villa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                        "entry_id": "e19e19a5-07f9-3027-838d-e40b5caa8894",
                                        "glosses": [
                                            "großes, freistehendes Einfamilienhaus mit großem Garten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ff35bdd-f23d-4dce-a93f-968c0cb8961a",
                                                "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                                "text": "In Hamburg kann man am Elbufer schöne Villen sehen."
                                            },
                                            {
                                                "example_id": "fb90b220-f5f6-4f56-8a24-e9be9f16169a",
                                                "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                                "text": "„Die reichen Weißen in den Villen an der Esplanade ließen auf der gegenüberliegenden Seite großzügige Häuser für ihre schwarzen und halbblütigen Mätressen errichten.“"
                                            },
                                            {
                                                "example_id": "41613d25-a176-4b59-b612-f0506effc220",
                                                "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                                "text": "„Vor dem Abflug brachte sie ihren Freund dazu, ihr eine Generalvollmacht über sein Vermögen, Blankounterschriften, die Schlüssel für sein Auto und den Tresor in der Villa samt Zahlenkombinationen zu überlassen.“"
                                            },
                                            {
                                                "example_id": "507c5c3e-c5d1-4e4c-9f8a-012a2561fd46",
                                                "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                                "text": "„Gestern bin ich aus der Villa ausgezogen.“"
                                            },
                                            {
                                                "example_id": "15fdda7e-f741-4f65-a2d6-2c40dbda74c9",
                                                "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                                "text": "„Da sie auch Diener und Hausmädchen mitgenommen hätten, stünden ihre Villen und Paläste leer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8fd1709-6ef4-4ba8-9a29-584fae1c3496",
                        "source_entry_id": "405dcf5f-54d6-3ae2-860b-8c9b0121bc2f",
                        "source_sense_id": "70c534e7-5ea6-33ff-8b9e-05875cae7d55",
