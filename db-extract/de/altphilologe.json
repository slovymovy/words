                "senses": [
                    {
                        "sense_id": "38cff952-648b-3ac2-a0c5-cbe331c6e656",
                        "entry_id": "005a6349-1ecc-3dca-a91b-35b2a4dc2809",
                        "glosses": [
                            "Philologe, der Fachmann für die klassischen Sprachen Griechisch und Latein und ihre Literatur ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52aaa7a0-5c9a-4b03-80cf-afa6b414310e",
                                "sense_id": "38cff952-648b-3ac2-a0c5-cbe331c6e656",
                                "text": "„Der Einfluss der antiken Autoren, besonders von Lukrez – »De rerum natura« –, auf den jungen Kant war so groß, dass er zusammen mit zwei anderen Schülern beschloss, Altphilologe zu werden.“"
                            },
                            {
                                "example_id": "80edfff6-266d-44ba-84b9-0cb0d9b7a9c6",
                                "sense_id": "38cff952-648b-3ac2-a0c5-cbe331c6e656",
                                "text": "„Dieser Frage gingen Altphilologinnen und Altphilologen auf der Tagung vom 22. bis 23. Oktober 2018 im Veranstaltungsforum Fürstenfeldbruck nach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
