{
    "word_family": [
        "sad",
        "sadness",
        "sadden"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                    "sense_definition": "Used to express that a situation is unfortunate or regrettable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sadly</w>, the two were never to meet again after that final summer.",
                            "target_lang_translations": {
                                "ru": "<w>К сожалению</w>, им двоим так и не суждено было встретиться снова после того последнего лета.",
                                "zh": "<w>遗憾的是</w>，那个夏天之后，他们两人再也没能见面。"
                            }
                        },
                        {
                            "text": "If you think the project is finished, you are <w>sadly</w> mistaken.",
                            "target_lang_translations": {
                                "ru": "Если вы думаете, что проект закончен, вы <w>глубоко</w> ошибаетесь.",
                                "zh": "如果你认为项目已经完成了，那你可就<w>大错特错</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unfortunately",
                        "regrettably",
                        "alas"
                    ],
                    "antonyms": [
                        "fortunately",
                        "luckily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения того, что ситуация является прискорбной или вызывает сожаление.",
                        "zh": "用于表示某种情况令人遗憾或可惜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "к сожалению",
                                "target_lang_sense_clarification": "вводное слово"
                            },
                            {
                                "target_lang_word": "печально",
                                "target_lang_sense_clarification": "оценка ситуации"
                            },
                            {
                                "target_lang_word": "прискорбно",
                                "target_lang_sense_clarification": "официально или книжно"
                            },
                            {
                                "target_lang_word": "глубоко",
                                "target_lang_sense_clarification": "в сочетании с 'ошибаться'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遗憾的是",
                                "target_lang_sense_clarification": "用于句首，表示对某事感到惋惜"
                            },
                            {
                                "target_lang_word": "可惜",
                                "target_lang_sense_clarification": "表示令人惋惜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bdac360-dbee-34b6-982f-ff1d605331d5",
                    "sense_definition": "In a way that shows or suggests sorrow or unhappiness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked <w>sadly</w> at the old photographs of his childhood home.",
                            "target_lang_translations": {
                                "ru": "Он <w>грустно</w> смотрел на старые фотографии дома своего детства.",
                                "zh": "他<w>伤心地</w>看着童年故居的老照片。"
                            }
                        },
                        {
                            "text": "The child smiled <w>sadly</w> as she waved goodbye to her friends.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>печально</w> улыбнулся, махая друзьям на прощание.",
                                "zh": "孩子向朋友挥手告别时，<w>悲伤地</w>笑了笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sorrowfully",
                        "mournfully",
                        "ruefully"
                    ],
                    "antonyms": [
                        "happily",
                        "cheerfully",
                        "joyfully"
                    ],
                    "common_phrases": [
                        "smiled sadly",
                        "looked sadly",
                        "sighed sadly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таким образом, что это выражает печаль, грусть или несчастье.",
                        "zh": "以一种表现出悲伤或不快乐的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грустно",
                                "target_lang_sense_clarification": "испытывая грусть"
                            },
                            {
                                "target_lang_word": "печально",
                                "target_lang_sense_clarification": "выражая печаль"
                            },
                            {
                                "target_lang_word": "уныло",
                                "target_lang_sense_clarification": "безрадостно"
                            },
                            {
                                "target_lang_word": "тоскливо",
                                "target_lang_sense_clarification": "с чувством тоски"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伤心地",
                                "target_lang_sense_clarification": "形容动作带有悲伤的情绪"
                            },
                            {
                                "target_lang_word": "悲伤地",
                                "target_lang_sense_clarification": "形容动作带有忧郁或悲痛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ce4f8f1-a94e-3c01-9c35-f16a6eb6ff23",
                    "sense_definition": "In a manner that causes sadness or is very bad; terribly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local library has been <w>sadly</w> neglected for many years.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека уже много лет находится в <w>плачевном</w> запустении.",
                                "zh": "当地图书馆多年来一直被<w>严重</w>忽视。"
                            }
                        },
                        {
                            "text": "The village was <w>sadly</w> plagued by a series of natural disasters.",
                            "target_lang_translations": {
                                "ru": "Деревня была <w>ужасно</w> истерзана серией стихийных бедствий.",
                                "zh": "这个村庄<w>不幸</w>遭受了一连串自然灾害的侵袭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heavily",
                        "regrettably"
                    ],
                    "common_phrases": [
                        "sadly neglected",
                        "sadly lacking"
                    ],
                    "target_lang_definitions": {
                        "ru": "В манере, которая вызывает грусть или является очень плохой; ужасно.",
                        "zh": "以一种导致悲伤或非常糟糕的方式；极其。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плачевно",
                                "target_lang_sense_clarification": "о состоянии дел"
                            },
                            {
                                "target_lang_word": "прискорбно",
                                "target_lang_sense_clarification": "вызывая сожаление"
                            },
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "в значении степени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "表示程度非常深"
                            },
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "用于强调负面状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "137725de-f8bd-36ac-b4bc-105465fbe964",
                    "sense_definition": "To a great degree; very much or urgently.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>sadly</w> want to quiet myself after such a long and stressful day.",
                            "target_lang_translations": {
                                "ru": "Я <w>отчаянно</w> хочу покоя после такого долгого и напряженного дня.",
                                "zh": "在经历了如此漫长且充满压力的一天后，我<w>非常</w>渴望能安静一会儿。"
                            }
                        },
                        {
                            "text": "The garden <w>sadly</w> needs some attention before the guests arrive.",
                            "target_lang_translations": {
                                "ru": "Сад <w>крайне</w> нуждается в уходе до приезда гостей.",
                                "zh": "客人们到来之前，花园<w>急需</w>打理。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sadly want"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used with verbs of wanting or needing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В значительной степени; очень сильно или крайне необходимо.",
                        "zh": "在很大程度上；非常或迫切地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчаянно",
                                "target_lang_sense_clarification": "очень сильно"
                            },
                            {
                                "target_lang_word": "сильно",
                                "target_lang_sense_clarification": "в высокой степени"
                            },
                            {
                                "target_lang_word": "крайне",
                                "target_lang_sense_clarification": "о нужде в чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "表示程度高"
                            },
                            {
                                "target_lang_word": "迫切地",
                                "target_lang_sense_clarification": "表示需求强烈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc809da5-f620-364c-94cb-ce70f6cd066a",
                    "sense_definition": "In a deep or complete manner; soundly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lay down in the bed and fell on sleep <w>sadly</w> until morning.",
                            "target_lang_translations": {
                                "ru": "Он лег в постель и <w>крепко</w> проспал до самого утра.",
                                "zh": "他躺在床上，<w>沉沉地</w>睡到了天亮。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sleep sadly"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used regarding sleep"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоко или полностью; крепко.",
                        "zh": "以一种深沉或完全的方式；熟睡地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепко",
                                "target_lang_sense_clarification": "о сне"
                            },
                            {
                                "target_lang_word": "глубоко",
                                "target_lang_sense_clarification": "о сне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉沉地",
                                "target_lang_sense_clarification": "形容睡眠深沉"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}