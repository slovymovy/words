                ],
                "senses": [
                    {
                        "sense_id": "6cb20742-bd1b-3bf8-830a-3151a27bcaa3",
                        "entry_id": "c5d6c0c3-abac-344f-880b-339531fee727",
                        "glosses": [
                            "opgevuld met aarde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c1280ef-93b5-4983-8f8b-a9ae727e4009",
                                "sense_id": "6cb20742-bd1b-3bf8-830a-3151a27bcaa3",
                                "text": "Door de gedempte sloot werden de twee stukken land aan elkaar verbonden."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f338eb1-ee52-3003-b04b-e60f900cba1c",
                        "entry_id": "c5d6c0c3-abac-344f-880b-339531fee727",
                        "glosses": [
                            "met een demper erin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "953a1d8f-1a04-49eb-9f71-447340a8ab59",
                                "sense_id": "5f338eb1-ee52-3003-b04b-e60f900cba1c",
                                "text": "De solist speelde op een gedempte trompet."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e33fd8f-8994-3fd6-9435-7829adc711fb",
                        "entry_id": "c5d6c0c3-abac-344f-880b-339531fee727",
                        "glosses": [
                            "niet luid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d73bdc4-977b-4bb3-a7f1-6ac831e3d13e",
                                "sense_id": "5e33fd8f-8994-3fd6-9435-7829adc711fb",
                                "text": "Franse kinderen schreeuwen niet\nTerwijl Nederlandse moeders over het strand schallen: 'Kevin, hiieeerrr kooomeeen…’, praten Franse moeders alleen op gedempte toon met hun kinderen. Sterker nog; ik heb een heel gezin naast ons een hele dag lang alleen op fluistertoon met elkaar horen praten. Niemand viel uit zijn of haar rol. Heerlijk rustig. Waarom moeten wij eigenlijk altijd zo tetteren?"
                            },
                            {
                                "example_id": "e9c4747e-646d-4770-b1b1-f8c63482a9c1",
                                "sense_id": "5e33fd8f-8994-3fd6-9435-7829adc711fb",
                                "text": "„Het was een bewolkte, zwoele namiddag; de matrozen hingen lui op het dek rond of staarden wezenloos over het loodkleurige water. Queequeg en ik waren rustig een zogenaamde zwaardmat aan het weven als extra sjorring voor onze sloep. Om ons heen was alles zo stil en gedempt en toch ook vervuld van wat ging komen en in de lucht hing zo’n mijmerachtige betovering dat die zwijgende mannen stuk voor stuk in hun eigen onzichtbare ik leken op te gaan."
                            }
                        ]
                    }
                ],
