                        ]
                    },
                    {
                        "translation_id": "3be126fc-edc3-4794-959e-0c65a31d257d",
                        "source_entry_id": "48e8a0c2-73b9-3a96-b23a-a2674e59e48c",
                        "source_sense_id": "5aa0001a-0316-3b18-ba50-d3285c0f00c6",
                        "source_sense_description": "Mathematik: halber Durchmesser",
                        "target_lang_word": "rayon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rayon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ec0ae9c-79a1-3e61-8d8f-ef353ff0d43e",
                                        "entry_id": "ae0ec761-e0ff-3c91-a51e-fc9c83153de2",
                                        "glosses": [
                                            "Ligne rectiligne qui part d’un centre et va en divergeant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b997fb18-7089-3dd9-b494-366f2c724df7",
                                        "entry_id": "ae0ec761-e0ff-3c91-a51e-fc9c83153de2",
                                        "glosses": [
                                            "Ligne rectiligne qui part d’un centre et va en divergeant.",
                                            "Segment de droite joignant le centre d’un cercle ou d'une sphère à tout point de la circonférence, représentant la moitié du diamètre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "730385fa-e397-4c86-ae71-25380be8eb55",
                                                "sense_id": "b997fb18-7089-3dd9-b494-366f2c724df7",
                                                "text": "On appelle rayon, toute droite CA menée du centre à la circonférence, et diamètre, toute droite DB, qui passe par le centre et qui se termine de part et d'autre à la circonférence. On voit immédiatement par la génération du cercle que tous les rayons sont égaux."
                                            },
                                            {
                                                "example_id": "9baa9ad8-3092-4026-9c0c-775523ec992a",
                                                "sense_id": "b997fb18-7089-3dd9-b494-366f2c724df7",
                                                "text": "Si l’on piquait la pointe d’un compas à l’emplacement de Rhages, Vezzano était, de tous les points du territoire d’Orsenna, celui qui s’inscrivait dans le cercle de rayon le plus court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2236e37-8d8e-30e5-a903-39eb16e89dd0",
                                        "entry_id": "ae0ec761-e0ff-3c91-a51e-fc9c83153de2",
                                        "glosses": [
                                            "Espace à l’entour, plus ou moins circulaire."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43cdcd9-54fb-4a1b-afeb-4b4743ae2abe",
                                                "sense_id": "c2236e37-8d8e-30e5-a903-39eb16e89dd0",
                                                "text": "Les desservants peuvent, désormais, disparaître ; le peuple tiendra. Il tiendra, car il est, par caractère, obstiné ; car il vit groupé dans un rayon peu étendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c16c9ab7-d60c-347a-a0a6-27687e76732c",
                                        "entry_id": "ae0ec761-e0ff-3c91-a51e-fc9c83153de2",
                                        "glosses": [
                                            "Pédoncule floral d’une ombelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda0ad4b-89cf-4e5c-85ae-2f1fffba5c0c",
                                                "sense_id": "c16c9ab7-d60c-347a-a0a6-27687e76732c",
                                                "text": "A la base des rayons de l’ombelle et des ombellules on peut trouver des bractées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d630fcb-a506-373f-81ca-d50f8ea67c5a",
                                        "entry_id": "ae0ec761-e0ff-3c91-a51e-fc9c83153de2",
                                        "glosses": [
                                            "Chacune des parties qui vont du moyeu de la roue à la jante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f86d4d6c-1360-419a-9b1e-417e3bb299f3",
                                                "sense_id": "0d630fcb-a506-373f-81ca-d50f8ea67c5a",
                                                "text": "Les rayons de la roue."
                                            },
                                            {
                                                "example_id": "2fcdd69f-9306-4345-9a1c-02194e1545bf",
                                                "sense_id": "0d630fcb-a506-373f-81ca-d50f8ea67c5a",
                                                "text": "Les catadioptres sont également obligatoires sur les pédales, à l’avant et à l’arrière du vélo. Sur les rayons des roues aussi, à moins que les pneus ne comportent déjà des bandes rétroréfléchissantes. Quant au gilet fluorescent est obligatoire de nuit hors agglomération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ee7fef0-8280-34b3-b5ba-81ccadb91642",
                                        "entry_id": "ae0ec761-e0ff-3c91-a51e-fc9c83153de2",
                                        "glosses": [
                                            "Émanation issue d’une source lumineuse irradiante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c4ac58-085e-4cf1-a11e-6ec3cd9ec5bf",
                                                "sense_id": "9ee7fef0-8280-34b3-b5ba-81ccadb91642",
                                                "text": "Un rayon de soleil, qui passait à travers la feuillée des tilleuls, jouait sur sa chevelure et en faisait une auréole d’or."
                                            },
                                            {
                                                "example_id": "12b004d2-6b3a-4e73-83e8-cfe3d639b9b4",
                                                "sense_id": "9ee7fef0-8280-34b3-b5ba-81ccadb91642",
                                                "text": "Les physiciens, et notamment M. Bravais, ont démontré que les halos et les parhélies se produisent par suite de l’action exercée sur les rayons solaires traversant des cirrhus composés de petits prismes de glace."
                                            },
                                            {
                                                "example_id": "96ffc45c-d154-48b5-bc12-53b12aad6db6",
                                                "sense_id": "9ee7fef0-8280-34b3-b5ba-81ccadb91642",
                                                "text": "Le soleil qui quelques minutes avant était rouge cramoisi, était devenu d’un jaune vif, et les rayons d’or qu’il dardait étaient si flamboyants que l’œil en était éblouif."
                                            },
                                            {
                                                "example_id": "312952ec-7845-4283-b04a-b1ae82f1e499",
                                                "sense_id": "9ee7fef0-8280-34b3-b5ba-81ccadb91642",
                                                "text": "Par un entrebâillement de rideaux, un rayon de soleil planta dans la pièce sa lance d’or, et son éclat, […], sembla transformer la chambre du poêle du père Jourgeot."
                                            },
                                            {
                                                "example_id": "a15b87fe-df8d-4cec-977c-c496b7e10010",
                                                "sense_id": "9ee7fef0-8280-34b3-b5ba-81ccadb91642",
                                                "text": "La porte ouverte un moment laissa passer un rayon de lumière. J’entrevis sa silhouette : il était jeune, correctement habillé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69cf9e4a-52fa-368e-9165-7df7195da4fa",
                                        "entry_id": "ae0ec761-e0ff-3c91-a51e-fc9c83153de2",
                                        "glosses": [
                                            "Lueur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67b227d9-e01b-4b5f-adad-9fcd9ecb14ab",
                                                "sense_id": "69cf9e4a-52fa-368e-9165-7df7195da4fa",
                                                "text": "Un rayon de joie pénétra son âme, pénétra dans son âme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de05f09a-7c11-3629-b20c-e4046e08cd55",
                                        "entry_id": "ae0ec761-e0ff-3c91-a51e-fc9c83153de2",
                                        "glosses": [
                                            "Faisceau de particules énergétiques lumineuses."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bee25914-276b-414d-8dce-92e1162c19ca",
                                                "sense_id": "de05f09a-7c11-3629-b20c-e4046e08cd55",
                                                "text": "Rayons infrarouges, ultra-violets, etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rayon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4d52e86-3b70-31a2-a6a6-8f54556b3119",
                                        "entry_id": "1184b21c-0ede-3ad4-b092-60d5b715fbb7",
                                        "glosses": [
                                            "Gâteau de cire, divisé en alvéoles, construit par les abeilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e11ea32-5246-4c8c-a88f-284d33043b13",
                                                "sense_id": "d4d52e86-3b70-31a2-a6a6-8f54556b3119",
                                                "text": "L’essaim doit débuter un élevage à partir de zéro : trouver un nouveau nid, bâtir les rayons, élever des ouvrières à partir de l’œuf, ce qui prend vingt en un jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d08a7908-20d6-3189-a579-5b7f39417943",
                                        "entry_id": "1184b21c-0ede-3ad4-b092-60d5b715fbb7",
                                        "glosses": [
                                            "Étagère servant à entreposer des livres, du linge, des marchandises, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0827690-8452-46dc-a9b2-e68cb339b064",
                                                "sense_id": "d08a7908-20d6-3189-a579-5b7f39417943",
                                                "text": "Puis, les allées et venues des moineaux au rayon des pâtes, en face de sa caisse, retiennent son attention. Les piafs se faufilent sous les comptoirs et les plus culottés s'attaquent aux paquets de cellophane dans les rayons."
                                            },
                                            {
                                                "example_id": "9d20e150-4248-4938-8915-13d324a9000f",
                                                "sense_id": "d08a7908-20d6-3189-a579-5b7f39417943",
                                                "text": "Le bon traducteur est un bon lecteur, car tout bon traducteur sait qu’un rayon de bibliothèque est à l’esprit, ce qu’un rayon de soleil est pour l’œil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4950487-a970-3de9-ad40-76f0364b8813",
                                        "entry_id": "1184b21c-0ede-3ad4-b092-60d5b715fbb7",
                                        "glosses": [
                                            "Chacun des groupes d’articles de même espèce, dans un même magasin."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "373321fe-2a68-4ecb-8b52-96a82856e6f0",
                                                "sense_id": "c4950487-a970-3de9-ad40-76f0364b8813",
                                                "text": "De sa caisse, située près de la porte, il apercevait celle de son fils, qui se trouvait au rayon de la ganterie."
                                            },
                                            {
                                                "example_id": "9da1321e-e78a-4293-80c5-51c7990f170c",
                                                "sense_id": "c4950487-a970-3de9-ad40-76f0364b8813",
                                                "text": "Il y a une vingtaine d’années, ayant dû renoncer à l’étude des langues romanes, j’étais vendeur aux « Dames de France » de Marseille, rayon des cravates."
                                            },
                                            {
                                                "example_id": "94cd4e57-a711-445f-9882-8e5a245b3b91",
                                                "sense_id": "c4950487-a970-3de9-ad40-76f0364b8813",
                                                "text": "— Tu la trompes, ta femme ?\n— Ça arrive.\n— Et alors ?\n— Ça ne compte pas. C’est le rayon d’à côté."
                                            },
                                            {
                                                "example_id": "6f3115e0-15f1-434b-8e7c-56f5d5c00c77",
                                                "sense_id": "c4950487-a970-3de9-ad40-76f0364b8813",
                                                "text": "Mon enfance, je n’en suis jamais sorti et elle ne finira qu’avec moi. Je demeure une espèce de nain qui s’habillera toujours au rayon garçonnet."
                                            },
                                            {
                                                "example_id": "833c1465-7126-43b1-b511-282e29c81348",
                                                "sense_id": "c4950487-a970-3de9-ad40-76f0364b8813",
                                                "text": "Chef de rayon, celui qui a la direction de l’un de ces groupes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rayon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43ffd471-e5c4-3929-917f-23cf58a88e07",
                                        "entry_id": "b4b9986d-7939-32c7-8112-bb69899b888b",
                                        "glosses": [
                                            "Petit sillon tracé le long d’un cordeau tendu sur une planche labourée et passée au râteau, ou sur le bord d’une allée pour en fixer la largeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77df6bd7-c45c-4826-bf51-e78e0628ab27",
                                                "sense_id": "43ffd471-e5c4-3929-917f-23cf58a88e07",
                                                "text": "Semer, planter en rayons."
                                            },
                                            {
                                                "example_id": "660cbdaa-7411-460c-b20f-121693112c65",
                                                "sense_id": "43ffd471-e5c4-3929-917f-23cf58a88e07",
                                                "text": "Lui, traçait à la houe des rayons dans le guéret préparé ; elle, dans ces rayons, semait des graines et, comme il allait à reculons, elle semblait le poursuivre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
