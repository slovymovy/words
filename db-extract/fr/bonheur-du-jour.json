                "forms": [
                    {
                        "form_id": "a280f837-fb8f-4884-b689-115cca5778c3",
                        "entry_id": "483e2e5a-51d0-326f-a58c-e233020a071a",
                        "tags": [],
                        "form": "bonheur du jour"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff1f0161-9219-3c8f-a92d-1492ae28ef00",
                        "entry_id": "483e2e5a-51d0-326f-a58c-e233020a071a",
                        "glosses": [
                            "Meuble de dame comportant une table à tiroirs surmontée partiellement d’une petite armoire ou d’autres éléments de rangement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59622dfe-6df2-433c-ac81-52b49cfcad9a",
                                "sense_id": "ff1f0161-9219-3c8f-a92d-1492ae28ef00",
                                "text": "Un bonheur-du-jour en bois de rose."
                            },
                            {
                                "example_id": "d2590cf0-6484-4559-8541-1458d6bb3dc9",
                                "sense_id": "ff1f0161-9219-3c8f-a92d-1492ae28ef00",
                                "text": "Elle bondit, elle passa comme un nuage blanc entre les trois spectateurs, et alla se blottir sous le bonheur-du-jour, en se cachant la tête dans ses mains."
                            },
                            {
                                "example_id": "402c5ff6-430a-4abc-aed6-f8d0e1259f4e",
                                "sense_id": "ff1f0161-9219-3c8f-a92d-1492ae28ef00",
                                "text": "Il posa le verre, à demi plein d’une eau rose, sur la commode, la brosse dans le verre, et s’assit devant un petit bonheur-du-jour en érable où Marguerite avait accoutumé d’écrire sa correspondance."
                            },
                            {
                                "example_id": "2965c0a0-f8e9-44c3-b6ea-045fba369b4e",
                                "sense_id": "ff1f0161-9219-3c8f-a92d-1492ae28ef00",
                                "text": "Des bonheurs-du-jour Louis XV-Eugénie détonnent au milieu des vieux bahuts flamands et des honnêtes meubles Restauration."
                            },
                            {
                                "example_id": "bc974e70-3f93-4e2f-9949-013046527aef",
                                "sense_id": "ff1f0161-9219-3c8f-a92d-1492ae28ef00",
                                "text": "La table peut être à écrire, à thé, à jeu, en chiffonnière, en bonheur-du-jour (pour la toilette !)…"
                            }
                        ]
                    }
                ],
