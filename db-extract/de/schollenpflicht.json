                ],
                "senses": [
                    {
                        "sense_id": "3745520a-4541-3fc5-9629-511328bc22c7",
                        "entry_id": "fe93c5c6-380f-38f1-ac82-377278cee120",
                        "glosses": [
                            "Bindung (Pflicht) eines Bauern an sein Gut (die Scholle) und damit an den Gutsherren"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "14393559-1f77-4d41-a89d-f54f3cb8283f",
                                "sense_id": "3745520a-4541-3fc5-9629-511328bc22c7",
                                "text": "„Die Schollenpflicht wurde an die Kinder vererbt und blieb auch bei Veräußerung des Gutes erhalten.“"
                            },
                            {
                                "example_id": "3848bb7c-9c7a-41f5-a41b-4e9c49167d77",
                                "sense_id": "3745520a-4541-3fc5-9629-511328bc22c7",
                                "text": "„In Österreich wurde die Leibeigenschaft und die Schollenpflicht, die Bindung von Dienstpersonen an ein bestimmtes Stück Land, zwar schon 1781 aufgehoben, die allgemeine Aufhebung der Grundherrschaft erfolgte aber erst 1848.“"
                            },
                            {
                                "example_id": "cdedc54e-0f20-46e7-9172-e462b96a5022",
                                "sense_id": "3745520a-4541-3fc5-9629-511328bc22c7",
                                "text": "„Nun war in den böhmischen Ländern der Einführung der Schollenpflicht dadurch vorgearbeitet, daß die Freizügigkeit der Bauern seit langem durch die Pflicht, beim Abzug einen Ersatzmann für ihren Hof zu stellen, beschränkt war.“"
                            },
                            {
                                "example_id": "03968271-a3ab-4423-a22d-53c082cb1134",
                                "sense_id": "3745520a-4541-3fc5-9629-511328bc22c7",
                                "text": "„Parallel mit dieser Entwicklung verschärften sich auch die Maßnahmen zur Durchsetzung der Schollenpflicht: die Verfolgung der Flüchtlinge und die Bestrafung der sie Aufnehmenden.“"
                            },
                            {
                                "example_id": "6406016c-1aaa-4640-92d2-8ba05ba1bc80",
                                "sense_id": "3745520a-4541-3fc5-9629-511328bc22c7",
                                "text": "„Nur wenn der Gutsherr auf sie verzichtete, durften sie sich einen anderen Dienst suchen; nur mit Erlaubnis des Herrn durften sie ein Handwerk erlernen. Ein zweites Grundmerkmal des Erbuntertänigen war die Schollenpflicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
