                                "target_senses": [
                                    {
                                        "sense_id": "f2d78678-5c5c-3a0c-8afc-c445387683c3",
                                        "entry_id": "91e38b89-5f25-339b-998e-a0da77ada5ce",
                                        "glosses": [
                                            "The act of conquering or subjugation in war."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b302e11-a58d-3648-a0b7-7725ca22e28b",
                                        "entry_id": "91e38b89-5f25-339b-998e-a0da77ada5ce",
                                        "glosses": [
                                            "The annihilation of a sovereign state through its complete destruction in a war."
                                        ],
                                        "tags": [
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00a286c7-7cc7-4227-b2ee-3f12e5a14642",
                                                "sense_id": "7b302e11-a58d-3648-a0b7-7725ca22e28b",
                                                "text": "Strupp goes on to speak of transfer of territory ‘by annexation after debellation’."
                                            },
                                            {
                                                "example_id": "b8082d1d-e756-423e-a07f-5d691e2cb266",
                                                "sense_id": "7b302e11-a58d-3648-a0b7-7725ca22e28b",
                                                "text": "This time, the arguments of those who favored the total debellation of the defeated adversary were again defeated […]"
                                            },
                                            {
                                                "example_id": "93b035bf-967c-44ee-ab16-52155dabbc2d",
                                                "sense_id": "7b302e11-a58d-3648-a0b7-7725ca22e28b",
                                                "text": "They exclude […] wars that resulted in surrender or “debellation,” in which one side is completely vanquished […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efaf03c9-92b9-4f1d-ba44-bea68513bc5c",
                        "source_entry_id": "e615a7dd-6aa6-3623-be1e-965d3a054d09",
                        "source_sense_id": "3aad3173-2317-3545-a894-26517697c6da",
                        "source_sense_description": "Niederwerfung eines Staatswesens im Krieg und die Vernichtung der Staatsgewalt, an deren Stelle die unbeschränkte Verfügungsrecht des Siegers tritt",
                        "target_lang_word": "debellatio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debellatio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95e59e40-9dde-3c69-8635-550a77f779c0",
                                        "entry_id": "e5a5b4e5-02dd-3995-b8b6-0b26359a4761",
                                        "glosses": [
                                            "Debellation, the annihilation of a sovereign state through complete destruction in a war."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b5468f5-4905-4a9f-b8e4-f08a7ff1d4f9",
                                                "sense_id": "95e59e40-9dde-3c69-8635-550a77f779c0",
                                                "text": "According to the International Law doctrine of debellatio (KO’d by war), under which we profess to operate, it is the coalition, through Ambassador L. Paul Bremer III and his administration, that makes the important political and economic decisions for the Iraqis."
                                            },
                                            {
                                                "example_id": "6b197582-0175-49c5-8574-c5e6a96cd959",
                                                "sense_id": "95e59e40-9dde-3c69-8635-550a77f779c0",
                                                "text": "The invasion of Iraq by the British and U.S.-led Coalition forces in March 2003 silently effected debellatio, the ancient doctrine by which a military victor takes title to territory in which the defeated government has ceased to function."
                                            },
                                            {
                                                "example_id": "5d0d6926-67ef-43f0-9f8b-5342148186c5",
                                                "sense_id": "95e59e40-9dde-3c69-8635-550a77f779c0",
                                                "text": "Further, occupation based on debellatio must be distinguished from the situation in which a belligerent conquers the whole territory of an adverse party but meets resistance movements (including those of sporadic nature)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
