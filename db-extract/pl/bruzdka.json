                ],
                "senses": [
                    {
                        "sense_id": "ad4c7416-2a20-3086-b7c1-e677ce5bc457",
                        "entry_id": "d937ad2b-919d-3d67-b1fb-b624efbb92cd",
                        "glosses": [
                            "od bruzda (rów wykonany pługiem)"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "bd4f3310-799d-4ba5-aec3-61d727380760",
                                "sense_id": "ad4c7416-2a20-3086-b7c1-e677ce5bc457",
                                "text": "Przy należytym przygotowaniu roli pod buraki dobre wyniki daje siew redlicami o płaskim spodzie (…) w tym wypadku ciężka redlica ugniata dno bruzdki, a wysypujące się nasienie zostaje wgniecione w dno bruzdki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "44e0242b-359f-37d4-9450-bc6ca54c6589",
                        "entry_id": "d937ad2b-919d-3d67-b1fb-b624efbb92cd",
                        "glosses": [
                            "od bruzda (zagłębienie na powierzchni)"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "cf075f0f-99d5-40a7-802e-f90335eacb74",
                                "sense_id": "44e0242b-359f-37d4-9450-bc6ca54c6589",
                                "text": "Rządca czerwieniał powoli, aż gdy nasiąknął krwią do bruzdek koło nosa, zakwitł prawie fioletowo"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "88901924-8d5d-39ba-aa2a-178c0c2055a8",
                        "entry_id": "d937ad2b-919d-3d67-b1fb-b624efbb92cd",
                        "glosses": [
                            "od bruzda (zmarszczka na twarzy)"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "5d6b03f3-8c14-4a10-ae3f-609bff4f9095",
                                "sense_id": "88901924-8d5d-39ba-aa2a-178c0c2055a8",
                                "text": "W kawie surowej bada się jej wygląd. Sztuczne ziarna poznaje się po przekroju poprzecznym: wyraźnie widać, że bruzdka jest tylko powierzchowna"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
