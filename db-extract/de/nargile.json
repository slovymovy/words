                        "examples": [
                            {
                                "example_id": "33e2f9c4-defb-4177-95ce-53ee443b4a85",
                                "sense_id": "32e04e7d-2df2-3c4a-91c2-983ae1f8d838",
                                "text": "„Die Urform der Nargile stammt aus Indien, sie wurde aus Kokosnüssen gefertigt.“"
                            },
                            {
                                "example_id": "dcd35405-ce21-488e-bdcd-e5d926586453",
                                "sense_id": "32e04e7d-2df2-3c4a-91c2-983ae1f8d838",
                                "text": "„Um ein Nargile zu bedienen, sind zwei Personen nötig: denn einer bewältigt nichts weiter als den Kopf und der andere nichts weiter als das Rohr.“"
                            }
                        ],
