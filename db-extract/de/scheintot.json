                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98a0ba40-f2c9-40c3-ba59-9e33c593f81e",
                                "sense_id": "b9b57630-4da1-3ba8-9c3e-8e888107115f",
                                "text": "„Dass in Deutschland ein Mensch zwei volle Tage scheintot ist und dann im Sarg wieder zu Bewusstsein kommt, kann deshalb wohl ausgeschlossen werden.“"
