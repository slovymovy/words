                "senses": [
                    {
                        "sense_id": "e680edfb-d6ca-32c2-8e38-a1e0eff7e95d",
                        "entry_id": "6f882986-1be8-3587-a302-e659f5951f71",
                        "glosses": [
                            "virgin (male)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfabaab9-0254-4976-baec-bec45be6f237",
                                "sense_id": "e680edfb-d6ca-32c2-8e38-a1e0eff7e95d",
                                "text": "Ба́бушка обрати́лась к рабо́тавшей с не́ю де́вочке и посла́ла её в сад набра́ть мали́ны, а когда́ та вы́шла, она́ значи́тельно взгляну́ла мне в глаза́ и проговори́ла:\n— Голова́н был де́вственник!",
                                "translation": "Grandmother turned to the girl who was working with her and sent her to the garden to pick raspberries, and when the girl left, she looked me in the eye significantly and said:\n“Golovan was a virgin!”",
                                "english": "Grandmother turned to the girl who was working with her and sent her to the garden to pick raspberries, and when the girl left, she looked me in the eye significantly and said:\n“Golovan was a virgin!”"
                            }
                        ]
                    }
