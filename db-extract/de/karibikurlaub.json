                "senses": [
                    {
                        "sense_id": "f1c49299-69e2-3ad2-9904-3bb9c3647964",
                        "entry_id": "27ed48e9-cb8a-390a-9d92-3eeffb45caf6",
                        "glosses": [
                            "Reise, beispielsweise zur Erholung, in die Karibik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0540715e-8d2b-4628-9074-c864eba7fbf5",
                                "sense_id": "f1c49299-69e2-3ad2-9904-3bb9c3647964",
                                "text": "Lass uns zum Flughafen fahren, einfach einen Karibikurlaub buchen und eine Woche ausspannen."
                            },
                            {
                                "example_id": "f9aa97fe-782e-45f5-afbf-38e884891081",
                                "sense_id": "f1c49299-69e2-3ad2-9904-3bb9c3647964",
                                "text": "In Zeiten des menschengemachten Klimawandels kann man sich einen Karibikurlaub einfach nicht mehr leisten."
                            },
                            {
                                "example_id": "51745596-2e40-4d98-a5fc-d74a1579462d",
                                "sense_id": "f1c49299-69e2-3ad2-9904-3bb9c3647964",
                                "text": "„Man müsse sich eben fragen, ob man die 37. Jeans oder den Karibikurlaub wirklich brauche, gibt sich die 41-Jährige für sich bescheiden […].“"
                            },
                            {
                                "example_id": "71ecb5d2-12a1-4f97-82e6-848159def343",
                                "sense_id": "f1c49299-69e2-3ad2-9904-3bb9c3647964",
                                "text": "Für viele Deutsche ist ein Karibikurlaub immer noch ein Traum."
                            },
                            {
                                "example_id": "ef5550f0-3788-41b5-8ffd-ca0f7267268f",
                                "sense_id": "f1c49299-69e2-3ad2-9904-3bb9c3647964",
                                "text": "Mit einem Karibikurlaub verbinden die meisten Sonne, Strand und Palmen."
                            },
                            {
                                "example_id": "b7f9bb9e-f91a-4bbf-9117-d70bc8863179",
                                "sense_id": "f1c49299-69e2-3ad2-9904-3bb9c3647964",
                                "text": "„Edwin Ibarra hat eine elektronische Postkarte aus seinem Karibikurlaub in Costa Rica geschickt.“"
                            },
                            {
                                "example_id": "32953a17-4e5f-4e2b-8f64-ba82df41f884",
                                "sense_id": "f1c49299-69e2-3ad2-9904-3bb9c3647964",
                                "text": "„Der Richter sah es als erwiesen an, dass Boateng seiner damaligen Partnerin im Karibikurlaub 2018 ins Gesicht geschlagen hatte.“"
                            },
                            {
                                "example_id": "3bfbfef1-61a7-4469-86b7-204da9fe479a",
                                "sense_id": "f1c49299-69e2-3ad2-9904-3bb9c3647964",
                                "text": "„Eigentlich hatte er Geld für einen Karibikurlaub angespart - und es dann aber in Hilfsprojekte im Ahrtal gesteckt.“"
                            },
                            {
                                "example_id": "ef07ba7e-0396-4743-9a60-1aa3dfa828ae",
                                "sense_id": "f1c49299-69e2-3ad2-9904-3bb9c3647964",
                                "text": "„Ganz besonderes Urlaubsambiente bietet Sea-U Guest House - der Geheimtipp von Barbados! Schön gepflegte und anspruchsvoll ausgestattete, lädt zu einem unvergesslichen Karibikurlaub ein. Preis: Übernachtung und Frühstück im Sommer: Studio 109-139 US $, Apartment 159 US $; […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
