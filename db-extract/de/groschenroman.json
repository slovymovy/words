                "senses": [
                    {
                        "sense_id": "d7d739f2-4e48-3ac7-8c39-300e04cc03bc",
                        "entry_id": "24ec58fb-a39d-33c9-b537-6700afe4fe6c",
                        "glosses": [
                            "dünnes Heft zu niedrigem Preis, dessen Inhalt ein Trivialroman ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "395c48c6-d80e-4ba4-b139-56fb7852c930",
                                "sense_id": "d7d739f2-4e48-3ac7-8c39-300e04cc03bc",
                                "text": "Sie verdiente sich das Geld für ihr Studium mit dem Schreiben von Groschenromanen."
                            },
                            {
                                "example_id": "f5df25eb-bba3-4a83-ab27-b1fd5f85ad7f",
                                "sense_id": "d7d739f2-4e48-3ac7-8c39-300e04cc03bc",
                                "text": "„Das Schreiben hatte er in Roszkow gelernt, und im Lesen hatte er sich mittels der Lektüre von Zeitungen und Groschenromanen geübt.“"
                            },
                            {
                                "example_id": "03b3c602-0b47-400f-b456-ad4a82b1643b",
                                "sense_id": "d7d739f2-4e48-3ac7-8c39-300e04cc03bc",
                                "text": "„Schließlich fand er in einer düsteren Nebenstraße einen schmuddeligen kleinen Laden, in dem man außer Schreibwaren auch Illustrierte und Groschenromane kaufen konnte sowie billiges Spielzeug und Bonbons.“"
                            },
                            {
                                "example_id": "28a73bce-79e1-4240-8c5b-48a31863ca92",
                                "sense_id": "d7d739f2-4e48-3ac7-8c39-300e04cc03bc",
                                "text": "„Sie lasen von beiden Dingen in den hochliterarischen Groschenromanen, aus denen sie ihr Wissen schöpften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
