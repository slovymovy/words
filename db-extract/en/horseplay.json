                        "cross_references": [
                            {
                                "target_word": "chahut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cdc3dbd-d971-3af6-b16e-febd5a608adf",
                                        "entry_id": "a5caccd5-9f62-307f-825f-78781a33f709",
                                        "glosses": [
                                            "Danse excentrique, proche du cancan, à la mode au XIXᵉ siècle dans les bals publics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebac0a7f-389b-480b-ad62-098b3068997f",
                                                "sense_id": "6cdc3dbd-d971-3af6-b16e-febd5a608adf",
                                                "text": "Une douzaine d’hommes et de femmes déguisés, à moitié ivres, se livraient avec emportement à cette danse folle et obscène appelée le chahut."
                                            },
                                            {
                                                "example_id": "ce69a310-8238-42af-bd09-1c81ab8456ca",
                                                "sense_id": "6cdc3dbd-d971-3af6-b16e-febd5a608adf",
                                                "text": "Après avoir fait cercle avec des gens autour de trois quatre filles qui dansaient le chahut non sans grâce ni sans impudeur, nous étions allés nous asseoir à une petite table, tout près du petit salon qu’on trouve à l’entrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "381df2fa-fe9a-39eb-903a-19a6715715cb",
                                        "entry_id": "a5caccd5-9f62-307f-825f-78781a33f709",
                                        "glosses": [
                                            "Désordre, tumulte d’écoliers."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78046d26-9a4b-48ac-ac3b-23afdaa8db96",
                                                "sense_id": "381df2fa-fe9a-39eb-903a-19a6715715cb",
                                                "text": "Ce n’est pas un peu fini, tout ce chahut ???"
                                            },
                                            {
                                                "example_id": "ac33b528-c8ec-472f-a76d-6a7f1cb89be3",
                                                "sense_id": "381df2fa-fe9a-39eb-903a-19a6715715cb",
                                                "text": "Toute l’étude se mit à rire hautement. Entendre le pion bafoué par le meilleur élève les encourageait. Un chahut s’organisa."
                                            },
                                            {
                                                "example_id": "43d50a41-4ed7-45c3-adbc-ac92077f4995",
                                                "sense_id": "381df2fa-fe9a-39eb-903a-19a6715715cb",
                                                "text": "Chaque fois qu’un farceur de sa classe montait un « chahut », il ne pouvait pas s’empêcher d’éclater de rire, et c’était lui qui passait à la porte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cca8770-56bb-3a9d-ae5c-171e1658c0f7",
                                        "entry_id": "a5caccd5-9f62-307f-825f-78781a33f709",
                                        "glosses": [
                                            "Perturbation volontaire d’un discours, d’un cours, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c53646b8-df33-4fbc-9c0c-83b76c2a27b0",
                                                "sense_id": "6cca8770-56bb-3a9d-ae5c-171e1658c0f7",
                                                "text": "Les députés de l’opposition ont fait un chahut monstre!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3752731-9c2e-38e3-91fb-bbb20f280720",
                                        "entry_id": "a5caccd5-9f62-307f-825f-78781a33f709",
                                        "glosses": [
                                            "Perturbation émotionnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b5da4f-0281-435b-8594-6a2ab83fa753",
                                                "sense_id": "e3752731-9c2e-38e3-91fb-bbb20f280720",
                                                "text": "Padam… padam… padam…\nÉcoutez le chahut qu’il me fait […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "378edc30-8c2f-45bb-84c4-78b8b7e8db34",
                        "source_entry_id": "0e904ee9-2103-32b0-85f2-f30d820ded3e",
                        "source_sense_id": "4dc9093d-ee53-34e3-a67c-e9d956eb945e",
