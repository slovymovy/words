                                "target_senses": [
                                    {
                                        "sense_id": "b26b6f8a-9e6a-3dad-8c80-fe94d0b6bb8e",
                                        "entry_id": "93ccd23d-58a4-35f2-897c-7e4978e1944d",
                                        "glosses": [
                                            "Action d'hésiter, doute, indécision qu’une personne manifeste par ses mouvements, par sa conduite, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "653d31b4-22cd-47f8-88e2-76218f594a9c",
                                                "sense_id": "b26b6f8a-9e6a-3dad-8c80-fe94d0b6bb8e",
                                                "text": "Libre à d'autres de rire d'une lenteur apparente, d'une hésitation qui est scrupule, d'une méthode qu'on croit inhabile."
                                            },
                                            {
                                                "example_id": "e7489c6d-d7ac-4cd6-879b-6f32194990c8",
                                                "sense_id": "b26b6f8a-9e6a-3dad-8c80-fe94d0b6bb8e",
                                                "text": "Mouvement d’hésitation."
                                            },
                                            {
                                                "example_id": "552bc64d-9250-4206-a5bd-36a73cd1bef0",
                                                "sense_id": "b26b6f8a-9e6a-3dad-8c80-fe94d0b6bb8e",
                                                "text": "Ses perpétuelles hésitations rendirent sa bonne foi suspecte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70e81801-e230-3a17-b647-690baf011b04",
                                        "entry_id": "93ccd23d-58a4-35f2-897c-7e4978e1944d",
                                        "glosses": [
                                            "Incertitude dans l’énonciation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75111ba-6ad8-456e-9be0-c83dd309c35f",
                                                "sense_id": "70e81801-e230-3a17-b647-690baf011b04",
                                                "text": "Réciter sans hésitation, sans la moindre hésitation."
                                            },
                                            {
                                                "example_id": "54778431-e718-485f-b2a9-c3f2470163a3",
                                                "sense_id": "70e81801-e230-3a17-b647-690baf011b04",
                                                "text": "Parler, répondre avec hésitation."
                                            },
                                            {
                                                "example_id": "8fdf33b0-3f8d-4660-bdbe-0a760804ea7c",
                                                "sense_id": "70e81801-e230-3a17-b647-690baf011b04",
                                                "text": "Ses fréquentes hésitations fatiguaient l’auditoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
