                    {
                        "translation_id": "2a15d88a-a4ea-46ae-9209-29533df1c99c",
                        "source_entry_id": "a2b4ee87-781d-3218-88c6-bd261575d273",
                        "source_sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                        "target_lang_word": "завистливый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "завистливый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "48b52a5a-1b10-39a9-803d-5f2080fa190b",
                                        "entry_id": "09f17d4e-57c6-3371-8753-723017320ad5",
                                        "glosses": [
                                            "исполненный зависти, постоянно завидующий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f64210-ad4c-4705-8ad9-227d1f980687",
                                                "sense_id": "48b52a5a-1b10-39a9-803d-5f2080fa190b",
                                                "text": "― Я не понимаю, ― продолжал Илагин, ― как другие охотники завистливы на зверя и на собак."
                                            },
                                            {
                                                "example_id": "54baaf2f-0b4d-417d-b3bc-45f3775c0eb0",
                                                "sense_id": "48b52a5a-1b10-39a9-803d-5f2080fa190b",
                                                "text": "― Я человек завистливый, ― сознался Бендер, ― но тут завидовать нечему."
                                            },
                                            {
                                                "example_id": "b4ee9f0b-c923-48e9-92e5-7f6d53329db5",
                                                "sense_id": "48b52a5a-1b10-39a9-803d-5f2080fa190b",
                                                "text": "Жокей, однако, был подкуплен завистливым конкурентом и, ведя Фараона в хлысте, проиграл на финише, так что к этому нельзя было придраться."
                                            },
                                            {
                                                "example_id": "33a4844a-bd51-4d1d-af0a-2d4eccdedc7d",
                                                "sense_id": "48b52a5a-1b10-39a9-803d-5f2080fa190b",
                                                "text": "Жадный, завистливый на чужое добро, он выше всего на свете ценил богатство и пробивался к нему любыми путями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47af43a9-3b22-35bc-9bc6-2dfe9445a4b7",
                                        "entry_id": "09f17d4e-57c6-3371-8753-723017320ad5",
                                        "glosses": [
                                            "выражающий зависть или вызванный завистью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66bbb2ad-1c06-4ca0-92a0-c96deba24f74",
                                                "sense_id": "47af43a9-3b22-35bc-9bc6-2dfe9445a4b7",
                                                "text": "Первые сотни метров я гордо скользил сквозь павильоны, ловя на себе завистливые взгляды обыкновенных посетителей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fb94946-7807-3602-ba77-4a597c412cf8",
                                        "entry_id": "09f17d4e-57c6-3371-8753-723017320ad5",
                                        "glosses": [
                                            "перен., разг. ретивый, ревностный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5ba2b0d-84d2-48f5-9b7a-1313ea3f1cd6",
                                                "sense_id": "4fb94946-7807-3602-ba77-4a597c412cf8",
                                                "text": "Сарра Бернар, когда будет старой старушкой, вероятно с таким же умилением будет вспоминать восторги, которые она вызывала в массах зрителей, какое испытывал этот старик, вспоминая время, когда он сеял де-вя-но-сто мер, вспоминая крестецкий овёс и «своих баб», которые так были «завистливы» на работу, что принимались за жнитво до свету."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "265b4a51-8591-30a1-9283-cc20b8f8d5c2",
                                        "entry_id": "09f17d4e-57c6-3371-8753-723017320ad5",
                                        "glosses": [
                                            "рег. жадный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95a29719-a146-4949-92ef-dc9bdeb4c16a",
                                                "sense_id": "265b4a51-8591-30a1-9283-cc20b8f8d5c2",
                                                "text": "Завистливый на еду."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
