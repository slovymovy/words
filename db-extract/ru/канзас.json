                    {
                        "translation_id": "c9b5bb20-9653-4aea-932a-1c447d2998ba",
                        "source_entry_id": "102eada0-dd15-3499-9590-7848726404e2",
                        "source_sense_id": "b0e56dab-30c3-3ad4-b33b-645286bdcf10",
                        "target_lang_word": "Kansas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kansas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eca71dcd-9869-3a67-b5e3-b92fdea61b35",
                                        "entry_id": "91eb1b87-cf91-3921-812d-ff492df3ac8b",
                                        "glosses": [
                                            "Bundesstaat im mittleren Westen der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "057a0b44-530e-47e6-b7f1-47fbf5aa1d83",
                                                "sense_id": "eca71dcd-9869-3a67-b5e3-b92fdea61b35",
                                                "text": "Ich habe einen Austauschschüler aus Kansas zu Gast."
                                            },
                                            {
                                                "example_id": "388ae466-b234-4567-8d7a-be1f0c8fe0a3",
                                                "sense_id": "eca71dcd-9869-3a67-b5e3-b92fdea61b35",
                                                "text": "Der erste Europäer, der Kansas erreichte, war der Spanier Francisco Vásquez de Coronado im Jahre 1541."
                                            },
                                            {
                                                "example_id": "bb612239-9c7b-4dfe-99eb-620f24259bab",
                                                "sense_id": "eca71dcd-9869-3a67-b5e3-b92fdea61b35",
                                                "text": "1953 wurde der in Kansas aufgewachsene Dwight Eisenhower Präsident der Vereinigten Staaten."
                                            },
                                            {
                                                "example_id": "5360c11b-aa3d-4fbd-bf07-5213e52e4486",
                                                "sense_id": "eca71dcd-9869-3a67-b5e3-b92fdea61b35",
                                                "text": "Dieser Versuchung widerstand vor vier Jahren auch Barack Obama, dessen Vater aus Kenia stammt und dessen Mutter eine weiße Amerikanerin aus Kansas ist."
                                            },
                                            {
                                                "example_id": "3535cbc2-d764-456c-a289-a69bb2ad3d4e",
                                                "sense_id": "eca71dcd-9869-3a67-b5e3-b92fdea61b35",
                                                "text": "Vergebens suchten wir nach Anzeichen, dass das Firmament sich grün verfärbt - nach Ansicht unserer Freunde aus Kansas ein Zeichen, dass der Tornado jetzt gleich mit voller Wucht herumwirbeln wird und man besser einen Bunker aufsucht."
                                            }
                                        ],
