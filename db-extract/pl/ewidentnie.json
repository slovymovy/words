        "pl-extract.jsonl": [
            {
                "entry_id": "c2aa6f7b-df98-3096-a117-2b83f6447bc9",
                "word": "ewidentnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a231975-10fb-3afe-98e0-64e8300ea166",
                        "entry_id": "c2aa6f7b-df98-3096-a117-2b83f6447bc9",
                        "glosses": [
                            "w sposób ewidentny, oczywisty, jasny, jawny, wyraźny, widoczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa69335a-9c5f-4529-9c52-81db117cea07",
                                "sense_id": "3a231975-10fb-3afe-98e0-64e8300ea166",
                                "text": "Ta procedura została ustanowiona na wypadek, gdyby testament ewidentnie faworyzował jednego z członków rodziny czy jakiegokolwiek spadkobiercę, a krzywdził innego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e8dda7f-eb86-4625-aace-48914c9357fc",
                        "source_entry_id": "c2aa6f7b-df98-3096-a117-2b83f6447bc9",
                        "source_sense_id": "3a231975-10fb-3afe-98e0-64e8300ea166",
                        "target_lang_word": "apparently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6236f0d2-3b0e-3ca1-a4a9-45cbc3e84a81",
                                        "entry_id": "dacc25af-db06-3a95-a9c0-46b4529e42cf",
                                        "glosses": [
                                            "Plainly; clearly; manifestly; evidently."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "845e893b-9f78-4967-96af-b5e2e7c19f22",
                                                "sense_id": "6236f0d2-3b0e-3ca1-a4a9-45cbc3e84a81",
                                                "text": "If he should scorn me so apparently."
                                            },
                                            {
                                                "example_id": "02e20786-fa66-44bf-ac80-8e74a76db730",
                                                "sense_id": "6236f0d2-3b0e-3ca1-a4a9-45cbc3e84a81",
                                                "text": "One, my lord, that doth so palpably, so apparently make her adulteries a trophy, whiles the poting-stick to her unsatiate goatish abomination jeers at, and flouts your sleepish, and more than sleepish, security."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02b9a4ee-57cd-3cff-9b0e-93147c4164af",
                                        "entry_id": "dacc25af-db06-3a95-a9c0-46b4529e42cf",
                                        "glosses": [
                                            "Seemingly; in appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17632980-be42-46b4-a213-808792486d5e",
                                                "sense_id": "02b9a4ee-57cd-3cff-9b0e-93147c4164af",
                                                "text": "A man may be apparently friendly, yet malicious in heart."
                                            },
                                            {
                                                "example_id": "2ac21fa0-00c6-459f-a706-b6d1902c7958",
                                                "sense_id": "02b9a4ee-57cd-3cff-9b0e-93147c4164af",
                                                "text": "The r-stems had apparently been reduced to the five nuclear kinship terms that still survive in Modern English."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d44f1e54-3d7e-3612-81f9-bb342fa379c5",
                                        "entry_id": "dacc25af-db06-3a95-a9c0-46b4529e42cf",
                                        "glosses": [
                                            "According to what the speaker has read or heard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdde7d89-130b-463c-8181-2f82c36e5898",
                                                "sense_id": "d44f1e54-3d7e-3612-81f9-bb342fa379c5",
                                                "text": "Apparently you are quite a good dancer."
                                            },
                                            {
                                                "example_id": "936d47ec-319e-46af-a3a2-d672a2c9010e",
                                                "sense_id": "d44f1e54-3d7e-3612-81f9-bb342fa379c5",
                                                "text": "\"[…] Apparently they are going to contact the adoption agency and see if they can locate that child. […]\""
                                            },
                                            {
                                                "example_id": "a5ddb8ab-e3de-4f76-83d1-45bc078298d8",
                                                "sense_id": "d44f1e54-3d7e-3612-81f9-bb342fa379c5",
                                                "text": "Similarly, the new move to apparently involve the National Guard in ICE operations could rub people the wrong way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d7256d8-ee5b-3dd6-ab02-b8577ada3865",
                                        "entry_id": "dacc25af-db06-3a95-a9c0-46b4529e42cf",
                                        "glosses": [
                                            "According to what one can deduce."
                                        ],
                                        "tags": [
                                            "often",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a634ca1-de4b-4b9d-a5c8-24f6cbfd5965",
                                                "sense_id": "7d7256d8-ee5b-3dd6-ab02-b8577ada3865",
                                                "text": "Peridot: I can tell you with certainty that there are things on this planet worth protecting!\nYellow Diamond: What do you know about the Earth?!\nPeridot: Apparently more than you, you clod!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "173ce787-ecec-4fba-9197-7787109c0888",
                        "source_entry_id": "c2aa6f7b-df98-3096-a117-2b83f6447bc9",
                        "source_sense_id": "3a231975-10fb-3afe-98e0-64e8300ea166",
                        "target_lang_word": "очевидно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "очевидно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2ec985e4-1280-3b33-92d3-d8ea8d7fa6e5",
                                        "entry_id": "d474d30e-583a-3340-a474-a19582b4a38d",
                                        "glosses": [
                                            "не вызывая споров, сомнений, возражений; несомненно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3168614-72f3-4530-a889-57660deca2c7",
                                                "sense_id": "2ec985e4-1280-3b33-92d3-d8ea8d7fa6e5",
                                                "text": "В ней произошла перемена — это было очевидно."
                                            },
                                            {
                                                "example_id": "28d0ced3-c0c1-41f6-b4b4-ca81a22a8c2c",
                                                "sense_id": "2ec985e4-1280-3b33-92d3-d8ea8d7fa6e5",
                                                "text": "Ему вдруг, как это часто бывает, после того как человека, которому мы поверим, нет больше перед глазами, ему вдруг совершенно ясно и очевидно стало, что унтер-офицер этот обманщик, что он наврал и только испортит всё дело атаки отсутствием этих двух полков, которых он заведёт бог знает куда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "421bcc12-2155-312e-9a7c-90961d4966d7",
                                        "entry_id": "d474d30e-583a-3340-a474-a19582b4a38d",
                                        "glosses": [
                                            "устар. заметно, видимо взору"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "835cecca-e6de-4470-a887-d895703eba26",
                                                "sense_id": "421bcc12-2155-312e-9a7c-90961d4966d7",
                                                "text": "Вот что в ребячестве читал я про Скупого. // Был человек, который никакого // Не знал ни промысла, ни ремесла, // Но сундуки его полнели очевидно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5c18fc1-234c-3cbe-b4e6-6c09b53e1859",
                                        "entry_id": "d474d30e-583a-3340-a474-a19582b4a38d",
                                        "glosses": [
                                            "предик. оценочная характеристика чего-либо как не вызывающего споров, сомнений, возражений; ясно, понятно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6710c684-1f17-428a-bd13-d110fe371409",
                                                "sense_id": "a5c18fc1-234c-3cbe-b4e6-6c09b53e1859",
                                                "text": "Таким образом, очевидно, что Плутарх понимал, что не Цезарь создал монархию."
                                            },
                                            {
                                                "example_id": "c36fcf9a-a532-4225-899f-ea968d228683",
                                                "sense_id": "a5c18fc1-234c-3cbe-b4e6-6c09b53e1859",
                                                "text": "Очевидно ― она не в силах одна рассечь своего гордиева узла, а гордость или привычка жить своими силами ― хоть погибать, да жить ими ― мешает ей высказаться!"
                                            },
                                            {
                                                "example_id": "044b00d3-5d6c-413e-8578-88ece704cfb1",
                                                "sense_id": "a5c18fc1-234c-3cbe-b4e6-6c09b53e1859",
                                                "text": "Нет, очевидно, могло только так и произойти, как произошло."
                                            },
                                            {
                                                "example_id": "de7744c3-922b-4a3c-9a17-5a61c39bf050",
                                                "sense_id": "a5c18fc1-234c-3cbe-b4e6-6c09b53e1859",
                                                "text": "Для всех очевидно, что царевна никогда не достанется юноше."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "508f4cec-57f2-3b9e-9d18-65593e76c330",
                                        "entry_id": "d474d30e-583a-3340-a474-a19582b4a38d",
                                        "glosses": [
                                            "вводн. сл. употребляется как вводное слово, выражающее уверенное утверждение и соответствующее по значению словам: без сомнения, безусловно, бесспорно, разумеется, конечно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df4ad8c9-68a6-4666-b35b-dc6e495b0ca3",
                                                "sense_id": "508f4cec-57f2-3b9e-9d18-65593e76c330",
                                                "text": "Очевидно, мы не понимаем друг друга."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aff3e71-58ef-3473-9f7a-97b4d369c971",
                                        "entry_id": "d474d30e-583a-3340-a474-a19582b4a38d",
                                        "glosses": [
                                            "употребляется при выражении неуверенного подтверждения"
                                        ],
                                        "tags": [
                                            "частица"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "873bdf6a-b8ed-4c5c-903d-db7c21555e21",
                                                "sense_id": "4aff3e71-58ef-3473-9f7a-97b4d369c971",
                                                "text": "А он, очевидно догадываясь, что произошло что-то необычайное, торопливо спрашивал: — Я сквозь сон слышал стрельбу. Почему же замолчали наши орудия? Почему нет грохота от неприятельских снарядов?"
                                            },
                                            {
                                                "example_id": "138dfffb-fcf9-4a3c-adf1-e0e55ba94f54",
                                                "sense_id": "4aff3e71-58ef-3473-9f7a-97b4d369c971",
                                                "text": "А ночью, когда я, вернувшись домой, ложусь спать и в потёмках спрашиваю себя, отчего же это в самом деле мне так мучительно скучно, в груди моей беспокойно поворачивается какая-то тяжесть, — и я припоминаю, как неделю тому назад в скуки, какой-то незнакомый господин, очевидно не москвич, вдруг повернулся ко мне и сказал раздражённо: — Ах, возьмите вы кусок телефонной проволоки и повесьтесь вы на первом попавшемся телеграфном столбе!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94cc4b31-9cf2-3eb9-b940-624ebf95c520",
                                        "entry_id": "d474d30e-583a-3340-a474-a19582b4a38d",
                                        "glosses": [
                                            "вводн. сл. употребляется как вводное слово, выражающее возможность или допустимость чего-либо и соответствующее по значению словам: вероятно, наверное, по-видимому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50560d18-bce4-4674-afa1-921b6c9cf30c",
                                                "sense_id": "94cc4b31-9cf2-3eb9-b940-624ebf95c520",
                                                "text": "Убийство произошло, очевидно, в комнате, а не через окно, что положительно ясно из произведённого акта осмотра, из положения тела и по всему."
                                            },
                                            {
                                                "example_id": "14726bcd-d6bf-49ad-a0c0-bf291f6c627e",
                                                "sense_id": "94cc4b31-9cf2-3eb9-b940-624ebf95c520",
                                                "text": "Вы полагаете, очевидно, что я обязан ответить вам за каждый рубец на спине раба Джеваки, нанесённый домоправителем."
                                            },
                                            {
                                                "example_id": "cf8b9777-e93f-417b-8ce2-62ac0ef19fe9",
                                                "sense_id": "94cc4b31-9cf2-3eb9-b940-624ebf95c520",
                                                "text": "Алексею Степановичу почудился крик; он долго вслушивался и даже снял пальто с головы, но только дождь нарушал зловещую тишину, обнявшую реку. Очевидно, он ошибся."
                                            },
                                            {
                                                "example_id": "dc3db502-87a4-4e6f-a499-4f53866a4c59",
                                                "sense_id": "94cc4b31-9cf2-3eb9-b940-624ebf95c520",
                                                "text": "— Какой мрачный господин, — сказала шёпотом девушка, очевидно, намекая на меня."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13499f6d-315b-3c6c-ae28-ff8b8db800b5",
                                        "entry_id": "d474d30e-583a-3340-a474-a19582b4a38d",
                                        "glosses": [
                                            "вряд ли (как сарказм)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0bb4fa4-5788-419b-a89b-a90c5f9685b2",
                                                "sense_id": "13499f6d-315b-3c6c-ae28-ff8b8db800b5",
                                                "text": "До приватизации квартиросъёмщики, очевидно, обитали в шалашах."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "очевидно",
                                "target_lang_code": "ru",
                                "target_senses": [
