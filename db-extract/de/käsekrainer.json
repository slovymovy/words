                        "entry_id": "bebe3aa6-0f85-3d77-bed4-dfec45a683a1",
                        "glosses": [
                            "leicht geräucherte Brühwurst mit grobem Brät aus Schweinefleisch und einem Anteil von 10 bis 20 % Käse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "339023bc-cfc4-484a-b90b-abbc4034ea4e",
                                "sense_id": "7a78cdd0-1b89-3bb7-a326-586c050de9e9",
                                "text": "Die Käsekrainer gehören zu meinen Lieblingswürsten."
                            },
                            {
                                "example_id": "3798ccbf-3572-4558-9bde-1390f81d29ff",
                                "sense_id": "7a78cdd0-1b89-3bb7-a326-586c050de9e9",
                                "text": "„Wenn Curtiss Calleo Wien besucht, holt er sich die erste Käsekrainer noch am Weg vom Flughafen.“"
                            },
                            {
                                "example_id": "3b5bdf04-56c6-4f66-9e67-2cdfa60f1949",
                                "sense_id": "7a78cdd0-1b89-3bb7-a326-586c050de9e9",
                                "text": "„Am besten geht der Salt Beef Bagel mit gekochtem Rindfleisch, englischem Senf und Pickels, in vieler Hinsicht das Londoner Pendant zu einer Käsekrainer in Wien nach (allzu) langer Nacht.“"
                            }
                        ],
