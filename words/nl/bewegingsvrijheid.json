                {
                    "sense_id": "8a3361ee-bafa-31b3-ba60-4b7fa30719b5",
                    "sense_definition": "De mogelijkheid of het recht om te gaan en staan waar men wil of om naar eigen inzicht te handelen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit land hebben alle burgers volledige <w>bewegingsvrijheid</w>.",
                            "target_lang_translations": {
                                "en": "In this country, all citizens have complete <w>freedom of movement</w>."
                            }
                        },
                        {
                            "text": "Als ondernemer geniet hij van veel <w>bewegingsvrijheid</w> om beslissingen te nemen.",
                            "target_lang_translations": {
                                "en": "As an entrepreneur, he enjoys a lot of <w>freedom of action</w> to make decisions."
                            }
                        }
                    ],
                    "synonyms": [
                        "armslag",
                        "ruimte",
                        "speelruimte"
                    ],
                    "common_phrases": [
                        "veel bewegingsvrijheid"
                    ],
                    "target_lang_definitions": {
                        "en": "The possibility or right to go and stay wherever one wants, or to act as one sees fit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freedom of movement",
                                "target_lang_sense_clarification": "right to travel or move freely"
                            },
                            {
                                "target_lang_word": "freedom of action",
                                "target_lang_sense_clarification": "liberty to act independently"
                            },
                            {
                                "target_lang_word": "elbow room",
                                "target_lang_sense_clarification": "scope or latitude to act"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c7259ec-01ac-3d46-957a-cfcfb51a2959",
                    "sense_definition": "De mate waarin men het lichaam fysiek kan bewegen zonder gehinderd te worden door bijvoorbeeld kleding of krampen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze sportkleding biedt optimale <w>bewegingsvrijheid</w> tijdens het hardlopen.",
                            "target_lang_translations": {
                                "en": "This sportswear offers optimal <w>freedom of movement</w> while running."
                            }
                        },
                        {
                            "text": "Strakke kleding kan je fysieke <w>bewegingsvrijheid</w> erg beperken.",
                            "target_lang_translations": {
                                "en": "Tight clothing can severely restrict your physical <w>freedom of movement</w>."
