    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24f61f9e-b39e-35c7-8876-25ba7525ea1e",
                    "sense_definition": "Qualifie un regard qui évite de fixer l'interlocuteur, traduisant souvent la gêne ou la dissimulation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé gardait un regard <w>fuyant</w> chaque fois que le juge lui posait une question directe."
                        },
                        {
                            "text": "Elle a remarqué ses yeux <w>fuyants</w> et a tout de suite compris qu'il cachait quelque chose."
                        }
                    ],
                    "antonyms": [
                        "franc",
                        "direct"
                    ],
                    "common_phrases": [
                        "regard fuyant",
                        "yeux fuyants"
                    ]
                },
                {
                    "sense_id": "ea7a2e13-96b9-39ce-a667-907e835c0ded",
                    "sense_definition": "Qui esquive, évite de s'engager ou de répondre franchement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a donné une réponse <w>fuyante</w> aux journalistes pour éviter d'aborder la polémique."
                        },
                        {
                            "text": "Son attitude <w>fuyante</w> lors des réunions importantes inquiète profondément toute l'équipe."
                        }
                    ],
                    "synonyms": [
                        "évasif",
                        "insaisissable"
                    ],
                    "antonyms": [
                        "franc",
                        "direct"
                    ],
                    "common_phrases": [
                        "attitude fuyante",
                        "réponse fuyante"
                    ]
                },
                {
                    "sense_id": "9fd4f310-1151-3af4-9891-cb8ebac2dda3",
                    "sense_definition": "Qui s'efface ou penche vers l'arrière, en parlant des traits du visage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physionomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le portrait montre un vieil homme avec un front <w>fuyant</w> et un nez aquilin."
                        },
                        {
                            "text": "Ce personnage de roman est décrit avec un menton <w>fuyant</w> qui lui donne un air hésitant."
                        }
                    ],
                    "antonyms": [
                        "saillant"
                    ],
                    "common_phrases": [
                        "front fuyant",
                        "menton fuyant"
                    ]
                },
                {
                    "sense_id": "30a5a3ed-71c8-3ed7-adcb-bb8f6b5a95a7",
                    "sense_definition": "En dessin ou en peinture, qui donne une impression d'enfoncement ou de perspective vers le lointain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a utilisé des lignes <w>fuyantes</w> pour accentuer la profondeur de cette ruelle sombre."
                        },
                        {
                            "text": "Les parties <w>fuyantes</w> du tableau guident naturellement le regard du spectateur vers le fond."
                        }
                    ],
                    "common_phrases": [
                        "lignes fuyantes"
                    ]
                },
                {
                    "sense_id": "44c81faf-05df-3ed0-a60c-ecd2df577aed",
                    "sense_definition": "Qui est en train de s'enfuir ou qui passe très rapidement sans s'arrêter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont tenté d'arrêter les ombres <w>fuyantes</w> dans la nuit noire."
                        },
                        {
                            "text": "Il contemplait le paysage <w>fuyant</w> depuis la fenêtre du train lancé à grande vitesse."
                        }
                    ],
                    "synonyms": [
                        "fugitif"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6370797e-c739-3d2b-a4d4-4ec6f7171111",
                    "sense_definition": "Participe présent de <w>fuir</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>fuyant</w> le danger, les habitants ont trouvé refuge dans la forêt voisine."
