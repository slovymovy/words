    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a157bd99-7ccf-3513-bb59-42637905737e",
                    "sense_definition": "Перестать жить, прекратить биологическое существование",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "biological_death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой дедушка <умер> в прошлом году от старости.",
                            "target_lang_translations": {
                                "en": "My grandfather <died> last year of old age.",
                                "nl": "Mijn opa is vorig jaar van ouderdom <gestorven>."
                            }
                        },
                        {
                            "text": "Раненый солдат <умер> в госпитале через два дня.",
                            "target_lang_translations": {
                                "en": "The wounded soldier <died> in the hospital two days later.",
                                "nl": "De gewonde soldaat <overleed> twee dagen later in het ziekenhuis."
                            }
                        }
                    ],
                    "synonyms": [
                        "скончаться",
                        "погибнуть",
                        "уйти из жизни",
                        "помирать"
                    ],
                    "antonyms": [
                        "родиться",
                        "жить",
                        "ожить",
                        "воскреснуть"
                    ],
                    "common_phrases": [
                        "умереть от старости",
                        "умереть молодым",
                        "умереть от болезни",
                        "умереть за родину"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop living, to cease biological existence",
                        "nl": "Ophouden met leven, het biologische bestaan beëindigen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "die",
                                "target_lang_sense_clarification": "general"
                            },
                            {
                                "target_lang_word": "pass away",
                                "target_lang_sense_clarification": "polite/euphemistic"
                            },
                            {
                                "target_lang_word": "succumb",
                                "target_lang_sense_clarification": "formal, often with 'to'"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "sterven",
                                "target_lang_sense_clarification": "algemeen, vaak formeel of natuurlijk proces"
                            },
                            {
                                "target_lang_word": "doodgaan",
                                "target_lang_sense_clarification": "algemeen, informeel"
                            },
                            {
                                "target_lang_word": "overlijden",
                                "target_lang_sense_clarification": "formeel, respectvol (meestal voor mensen)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4ccb495-e177-3810-a138-a0c4ae008cd2",
                    "sense_definition": "Перестать работать, сломаться или разрядиться (о технике)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "malfunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой телефон внезапно <умер>, и я не смог позвонить.",
                            "target_lang_translations": {
                                "en": "My phone suddenly <died>, and I couldn't make a call.",
                                "nl": "Mijn telefoon <ging> plotseling <dood>, en ik kon niet bellen."
                            }
                        },
                        {
                            "text": "Батарея в ноутбуке <умерла> в самый неподходящий момент.",
                            "target_lang_translations": {
                                "en": "The laptop battery <died> at the most inopportune moment.",
                                "nl": "De batterij van de laptop <gaf het op> op het meest ongelegen moment."
                            }
                        }
                    ],
                    "synonyms": [
                        "сдохнуть",
                        "сломаться",
                        "разрядиться"
                    ],
                    "common_phrases": [
                        "телефон умер",
                        "аккумулятор умер",
                        "мотор умер"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used for devices"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To stop working, break down, or run out of power (of technology)",
                        "nl": "Ophouden met werken, kapotgaan of leeglopen (van apparaten of batterijen)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "die",
                                "target_lang_sense_clarification": "of a battery or device"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "leeg zijn",
                                "target_lang_sense_clarification": "van een batterij"
                            },
                            {
                                "target_lang_word": "het begeven",
                                "target_lang_sense_clarification": "van een apparaat, kapotgaan"
                            },
                            {
                                "target_lang_word": "doodgaan",
                                "target_lang_sense_clarification": "informeel, van een telefoon of batterij"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98b57e70-0e43-3426-b015-012f46128c3d",
                    "sense_definition": "Исчезнуть, прекратиться, перестать существовать (о чувствах, идеях или явлениях)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cessation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Их любовь <умерла> из-за долгой разлуки.",
                            "target_lang_translations": {
                                "en": "Their love <died> because of the long separation.",
                                "nl": "Hun liefde <stierf> door de lange scheiding."
                            }
                        },
                        {
                            "text": "Надежда на успех <умерла> последней.",
                            "target_lang_translations": {
                                "en": "Hope for success <died> last.",
                                "nl": "Hoop op succes <stierf> als laatste."
                            }
                        }
                    ],
                    "synonyms": [
                        "исчезнуть",
                        "прекратиться"
                    ],
                    "antonyms": [
                        "появиться",
                        "возобновиться"
                    ],
                    "common_phrases": [
                        "надежда умерла",
                        "любовь умерла",
                        "традиция умерла"
                    ],
                    "target_lang_definitions": {
                        "en": "To disappear, cease, or stop existing (of feelings, ideas, or phenomena)",
                        "nl": "Verdwijnen, ophouden te bestaan (van gevoelens, ideeën of verschijnselen)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "die",
                                "target_lang_sense_clarification": "figurative"
                            },
                            {
                                "target_lang_word": "perish",
                                "target_lang_sense_clarification": "literary/formal"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "sterven",
                                "target_lang_sense_clarification": "figuurlijk, uitdoven"
                            },
                            {
                                "target_lang_word": "verdwijnen",
                                "target_lang_sense_clarification": "ophouden te bestaan"
                            },
                            {
                                "target_lang_word": "uitsterven",
                                "target_lang_sense_clarification": "van tradities of gewoonten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f988542e-f416-3acf-8c8c-0bb3d4e63b58",
                    "sense_definition": "Испытать очень сильное чувство (смех, страх, скука)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "extreme_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы чуть не <умерли> со смеху, когда услышали эту историю.",
                            "target_lang_translations": {
                                "en": "We almost <died> laughing when we heard that story.",
                                "nl": "We <gingen> bijna <dood> van het lachen toen we dat verhaal hoorden."
                            }
                        },
                        {
                            "text": "Я думал, что <умру> от скуки на этом длинном собрании.",
                            "target_lang_translations": {
                                "en": "I thought I would <die> of boredom at that long meeting.",
                                "nl": "Ik dacht dat ik <zou sterven> van verveling tijdens die lange vergadering."
                            }
                        }
                    ],
                    "common_phrases": [
                        "умереть со смеху",
                        "умереть от скуки",
                        "умереть от страха",
                        "умереть от любопытства"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "hyperbole"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To experience an extremely strong feeling (laughter, fear, boredom)",
                        "nl": "Een extreem sterk gevoel ervaren (zoals lachen, angst, verveling)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "die",
                                "target_lang_sense_clarification": "hyperbolic, e.g. of laughter"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "doodgaan",
                                "target_lang_sense_clarification": "hyperbolisch, bijv. van het lachen of van verveling"
                            },
                            {
                                "target_lang_word": "sterven",
                                "target_lang_sense_clarification": "figuurlijk, bijv. van de honger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca5c0edf-c6aa-3fe5-b95f-9b50a3106538",
                    "sense_definition": "Сильно удивиться, не поверить чему-либо",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "amazement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты сейчас <умрёшь>, когда узнаешь последние новости!",
                            "target_lang_translations": {
                                "en": "You're going to <die> when you hear the latest news!",
                                "nl": "Je <valt> echt <om> als je het laatste nieuws hoort!"
                            }
                        },
                        {
                            "text": "Когда я увидела цены в этом магазине, я просто <умерла>.",
                            "target_lang_translations": {
                                "en": "When I saw the prices in this store, I just <died>.",
                                "nl": "Toen ik de prijzen in die winkel zag, <sloeg> ik echt <stijl achterover>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "умереть не встать"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "emotional reaction"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be very surprised or shocked",
                        "nl": "Zeer verbaasd zijn, iets niet kunnen geloven"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "die",
                                "target_lang_sense_clarification": "slang, emotional reaction"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "stijl achterover slaan",
                                "target_lang_sense_clarification": "informeel, van verbazing"
                            },
                            {
                                "target_lang_word": "omvallen",
                                "target_lang_sense_clarification": "informeel, van verbazing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
