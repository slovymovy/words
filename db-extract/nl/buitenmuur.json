                        "examples": [
                            {
                                "example_id": "c8a79151-e7f2-4e21-b505-6a82c191031f",
                                "sense_id": "b9af8e2b-7535-3f49-a005-14025f7eb8ee",
                                "text": "In de buitenmuur was een houten poort, waarvan hij het hangslot opende."
                            },
                            {
                                "example_id": "8df984f0-e054-41b0-8976-025ed35eb697",
                                "sense_id": "b9af8e2b-7535-3f49-a005-14025f7eb8ee",
                                "text": "Aan de buitenmuur is een plaquette te lezen met een versregel van oud-gevangene Anthonie Donker: \"Gedenk hun laatste gang door deze poort. Hun leven voor vrijheid en voor recht gegeven. Zet hun strijd voort.\""
                            }
                        ]
                    }
