        "ru-extract.jsonl": [
            {
                "entry_id": "4a2a15cf-faa5-3d2f-a77b-6518d3fb7dee",
                "word": "глухо",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4be358fe-1040-3bb9-8a6e-7d05d1192d2b",
                        "entry_id": "4a2a15cf-faa5-3d2f-a77b-6518d3fb7dee",
                        "glosses": [
                            "разг. преисполнено тишины"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66c8f9e-e8bf-49bf-b21b-a53861b6be39",
                                "sense_id": "4be358fe-1040-3bb9-8a6e-7d05d1192d2b",
                                "text": "Звон бубенчиков замирает, и нас охватывает гробовое молчание. ― Уж и глухо же тут! ― говорит Корней, слезая с козел, и голос его странно звучит возле пустых стен."
                            }
                        ]
                    },
                    {
                        "sense_id": "5322f969-7541-369a-83ab-9ecc63a6168b",
                        "entry_id": "4a2a15cf-faa5-3d2f-a77b-6518d3fb7dee",
                        "glosses": [
                            "перен. далеко от населённых, обжитых мест"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2adbfd32-31ca-4731-9d21-0ed4dee80476",
                                "sense_id": "5322f969-7541-369a-83ab-9ecc63a6168b",
                                "text": "Там глухо: леса, тьма, враги и звери; не на кого там оглянуться."
                            }
                        ]
                    },
                    {
                        "sense_id": "c03ae754-ddf2-3234-a393-a9acec2c5b3c",
                        "entry_id": "4a2a15cf-faa5-3d2f-a77b-6518d3fb7dee",
                        "glosses": [
                            "прост. безнадёжно, тщетно"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
