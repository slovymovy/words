                "senses": [
                    {
                        "sense_id": "97f17124-23a9-38a1-87a2-326633e7f74b",
                        "entry_id": "d2121269-c973-313c-a402-364e2207d312",
                        "glosses": [
                            "eine überall verwendbare Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3a666f0-8e31-4705-8154-f268c77f8268",
                                "sense_id": "97f17124-23a9-38a1-87a2-326633e7f74b",
                                "text": "Esperanto ist eine der bekannteren Universalsprachen."
                            },
                            {
                                "example_id": "dfc67360-4832-46d9-aab9-68a9adb8ca95",
                                "sense_id": "97f17124-23a9-38a1-87a2-326633e7f74b",
                                "text": "„In »Der Augenblick« trifft eine Person auf eine Gruppe fremder Menschen in einer ortlosen Landschaft, die eine gescheiterte Universalsprache Volapük sprechen.“"
                            },
                            {
                                "example_id": "8b76880c-5514-4180-aed8-4d3f056e8cd7",
                                "sense_id": "97f17124-23a9-38a1-87a2-326633e7f74b",
                                "text": "„Wird der Mensch, der die Sprache geschaffen hat, dieses Sprachgewirr eines Tages durch eine Universalsprache beenden?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f898e7d5-a6e0-3b3d-b487-986f7924769a",
                        "entry_id": "d2121269-c973-313c-a402-364e2207d312",
                        "glosses": [
                            "„nach LEIBNIZ ein System von Zeichen (→ characteristica universalis), mit dessen Hilfe alle Objekte und ihre Beziehungen, Gesetze usw. abgebildet werden sollen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ebe943-83a1-4e16-bc6a-39ccd3c6f14d",
                                "sense_id": "f898e7d5-a6e0-3b3d-b487-986f7924769a",
                                "text": "„Im Rahmen der rationalistischen Sprachphilosophie wurde der Gedanke einer Universalsprache entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
