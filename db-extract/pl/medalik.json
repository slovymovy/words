                    {
                        "translation_id": "526ea871-2ad5-422b-be79-4b2dc9f6e03b",
                        "source_entry_id": "2112ef90-db38-316d-8a6a-5b7262c0f9b1",
                        "source_sense_id": "f10c9659-46d2-375c-8c6d-e686cf6656fd",
                        "target_lang_word": "Medaille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Medaille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                        "entry_id": "e4e6061c-6085-3fb2-bc3c-aac38661c312",
                                        "glosses": [
                                            "nicht zur Zahlung bestimmte Münze, welche entweder an eine Persönlichkeit oder an ein bestimmtes Ereignis erinnern soll; es ist kein Nennwert aufgedruckt oder eingeprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3470d6d-f375-44f7-bc5a-72ddf55748e3",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "Im Gegensatz zu einer Plakette weist eine Medaille auf beiden Seiten Schriftzüge oder ein Bildmotiv auf."
                                            },
                                            {
                                                "example_id": "db8568da-6a1d-43ec-8c1f-326d04a7b9c7",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "Friedrich Schiller wurde auf zahlreichen Medaillen geehrt."
                                            },
                                            {
                                                "example_id": "1e2da0fd-a6d3-4668-8594-d09d655d4ada",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "Zu Ehren des ersten bemannten Weltraumflugs wurden mehrere Medaillen herausgegeben."
                                            },
                                            {
                                                "example_id": "8ac869e5-2340-40d7-908d-221c05a91106",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "Sportler kämpfen oft um Medaillen."
                                            },
                                            {
                                                "example_id": "08ca1154-4192-4cae-b929-7589bb554993",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "„Die Gäste erhalten goldene Medaillen zur Erinnerung an das Ereignis.“"
                                            },
                                            {
                                                "example_id": "7c9c3210-1f35-4625-bf66-0d44a91b661c",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "„Im ersten Saal waren die Edelleute in ihren Uniformen, im zweiten die Kaufmannschaft, Leute mit langen Bärten, in blaue Kaftans gekleidet, Medaillen auf der Brust.“"
                                            },
                                            {
                                                "example_id": "12781651-5262-47ed-9c9e-90eb750ddbba",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "„Der Legionär mit den vielen Medaillen drang bei mir ein.“"
                                            },
                                            {
                                                "example_id": "0a207b5b-358c-4185-b0c9-7b1fecd732ac",
                                                "sense_id": "53a01c2f-ee44-3259-82bf-778e117b13c5",
                                                "text": "„Sie wurden auf Gedenkmünzen und Medaillen geprägt, gern mit Melanchthon auf der Hinterseite, auf Holztäfelchen gepinselt und in großformatige Bilder gemalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
