    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                "word": "compulsion",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "175f44c1-cbf3-4d3c-8024-2e2e6913e1bc",
                        "entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                        "tags": [
                            "plural"
                        ],
                        "form": "compulsions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6d4d5fa-e7b2-3e50-bd10-4757b6e85c8b",
                        "entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                        "glosses": [
                            "An irrational need or irresistible urge to perform some action, often despite negative consequences."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "437a93a3-f38e-4c59-868f-88055ebb8688",
                                "sense_id": "b6d4d5fa-e7b2-3e50-bd10-4757b6e85c8b",
                                "text": "During the basketball game, I had a sudden compulsion to have a smoke."
                            },
                            {
                                "example_id": "06e8db7b-83ca-4e0e-aa28-12738001d522",
                                "sense_id": "b6d4d5fa-e7b2-3e50-bd10-4757b6e85c8b",
                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fe95c50-018c-346a-a96f-42e25a5b1681",
                        "entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                        "glosses": [
                            "The use of authority, influence, or other power to force (compel) a person or persons to act."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ab37bcfc-165e-4395-aff2-36368b5a55e3",
                                "sense_id": "7fe95c50-018c-346a-a96f-42e25a5b1681",
                                "text": "From the opening of the City & South London Railway independent electric locomotives were used under compulsion of the Board of Trade."
                            },
                            {
                                "example_id": "d07de75a-1abf-4b62-a8a4-207a24e85167",
                                "sense_id": "7fe95c50-018c-346a-a96f-42e25a5b1681",
                                "text": "But Treaty translator and Ottawa leader Andrew Blackbird described the Treaty as made “not with the free will of the Indians, but by compulsion.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "f70b60cc-d825-3d9f-abf8-fd885aadaf89",
                        "entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                        "glosses": [
                            "The lawful use of violence (i.e. by the administration)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caf055ea-7647-4e4d-8a9f-5af6d13076d1",
                        "source_entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                        "source_sense_description": "irrational need to perform some action",
                        "target_lang_word": "nutkání",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nutkání",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "210f6b3a-c2ad-3529-bff9-7e56c350ba50",
                                        "entry_id": "1488f178-ad73-3587-9f92-21c8abac8666",
                                        "glosses": [
                                            "chuť, touha"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df2583a0-45b0-46d3-ae78-8739de8a20d1",
                                                "sense_id": "210f6b3a-c2ad-3529-bff9-7e56c350ba50",
                                                "text": "Jakkoliv byl tento právní názor značně diskutabilní, a vyvolával nutkání s ním zásadně polemizovat, nezbývalo než jej respektovat, a to právě proto, že šlo o právní názor rozšířeného senátu, jehož posláním je svými právními názory sjednocovat rozdílnou judikaturu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5f6893d-f43b-458f-84f2-251a0a46fb26",
                        "source_entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                        "source_sense_description": "irrational need to perform some action",
                        "target_lang_word": "dwang",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwang",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b1fafec5-2c82-30d6-87a3-03f7807ad5bf",
                                        "entry_id": "23fb092a-199d-3215-970a-6a7d57697b7d",
                                        "glosses": [
                                            "het uitoefenen van macht om iemand tegen diens wil iets te laten doen of laten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76297c29-8970-4f82-a658-288f8bac6b7b",
                                                "sense_id": "b1fafec5-2c82-30d6-87a3-03f7807ad5bf",
                                                "text": "De dictator heerste met veel macht en dwang over het geknechte volk, dat na vele jaren onderdrukking eindelijk in opstand kwam."
                                            },
                                            {
                                                "example_id": "9697a8a3-f982-407b-907e-399838318833",
                                                "sense_id": "b1fafec5-2c82-30d6-87a3-03f7807ad5bf",
                                                "text": "Het gerechtshof in Amsterdam heeft Keith Bakker woensdag in hoger beroep veroordeeld tot achttien maanden cel voor het verkrachten van een minderjarig meisje. Het OM eiste eind juni zes jaar cel en tbs met dwangverpleging, maar de straf viel fors lager uit. Volgens het hof is bewijs voor dwang in de relatie niet gevonden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe3d90a5-87d1-305f-9283-b797770dc428",
                                        "entry_id": "23fb092a-199d-3215-970a-6a7d57697b7d",
                                        "glosses": [
                                            "ziekelijke neiging om bepaalde dingen te doen, zucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee8bc9e-0eb6-4c9a-889d-d5bbc8bb4b81",
                                                "sense_id": "fe3d90a5-87d1-305f-9283-b797770dc428",
                                                "text": "De vrouw poetste de hele dag haar schone huis, ze had dan ook een ziekelijke dwang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2140282d-2fb5-4d55-b580-e79bc31dc989",
                        "source_entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                        "source_sense_description": "irrational need to perform some action",
                        "target_lang_word": "drang",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drang",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "afb1b23f-782c-32c6-82e9-a03b94e919ad",
                                        "entry_id": "d2eadcf3-cf79-3eaf-96ab-76233be1ff87",
                                        "glosses": [
                                            "innerlijke neiging om iets te doen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96de3096-0b6b-46fb-b446-4864bb0ce5d0",
                                                "sense_id": "afb1b23f-782c-32c6-82e9-a03b94e919ad",
                                                "text": "Hij voelde een sterke drang om zich te bemoeien met de discussie, maar deed het toch niet."
                                            },
                                            {
                                                "example_id": "3d7799a9-0c4b-4f97-b9c1-84838a4e4e4f",
                                                "sense_id": "afb1b23f-782c-32c6-82e9-a03b94e919ad",
                                                "text": "En dat was precies wat ze zelf niet begreep; waar die drang vandaan kwam."
                                            },
                                            {
                                                "example_id": "1dab3b0e-4ef1-4ec1-bdf1-7128187d264f",
                                                "sense_id": "afb1b23f-782c-32c6-82e9-a03b94e919ad",
                                                "text": "' 'Wat dan?' 'Dat, als je je werk echt wilt voltooien, de drang om dat te doen veel sterker moet zijn dan je zou denken."
                                            },
                                            {
                                                "example_id": "92984dc8-89a8-42ef-95c9-79406eed6713",
                                                "sense_id": "afb1b23f-782c-32c6-82e9-a03b94e919ad",
                                                "text": "Even iets heel anders: waar komt die drang om te lopen vandaan?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c684f08-27d5-3f59-9594-39d565d4e639",
                                        "entry_id": "d2eadcf3-cf79-3eaf-96ab-76233be1ff87",
                                        "glosses": [
                                            "het dringen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c934e172-b3c6-411e-833f-c32134fa1678",
                        "source_entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                        "source_sense_description": "irrational need to perform some action",
                        "target_lang_word": "Zwang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb7c23b3-68c0-3372-b284-9a02dc66d778",
                                        "entry_id": "3e179eb0-dfc0-3603-9e87-2423a5b58e8d",
                                        "glosses": [
                                            "innerer oder äußerer Druck, etwas zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aa67f59-a5db-4af7-a438-1932a270f6ed",
                                                "sense_id": "bb7c23b3-68c0-3372-b284-9a02dc66d778",
                                                "text": "Es bestand kein Zwang, Mitglied zu sein."
                                            },
                                            {
                                                "example_id": "203a4b87-d70e-4a75-98f2-9791c892d7e5",
                                                "sense_id": "bb7c23b3-68c0-3372-b284-9a02dc66d778",
                                                "text": "„Der amerikanische Politologe, einer der meistzitierten seines Fachs, hat ein Gelehrtenleben lang Zeugnis abgelegt für all jene, die sich den Zwängen des Staates entziehen.“"
                                            },
                                            {
                                                "example_id": "fc0beeb0-6a7f-4e5b-beb1-804fba8ee83a",
                                                "sense_id": "bb7c23b3-68c0-3372-b284-9a02dc66d778",
                                                "text": "„Jede Lehre unterliegt nun aber, wie man weiß, auf Seiten der Benutzer solcher Stilbücher dem nicht immer mühelosen Zwang des Lernens.“"
                                            },
                                            {
                                                "example_id": "d52d8f44-5b8c-4daf-89db-6302b67a6172",
                                                "sense_id": "bb7c23b3-68c0-3372-b284-9a02dc66d778",
                                                "text": "„Jeder von uns sitzt solchen Zwängen und Trugbildern auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
