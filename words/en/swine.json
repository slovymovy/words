        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b1dae5e5-4c9a-316c-af0a-10009a4eb053",
                    "sense_definition": "A pig or related animal of the family Suidae, especially a domestic pig.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pig_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local farm introduced <w>swine</w> to improve their agricultural production.",
                            "target_lang_translations": {
                                "ru": "Местная ферма завела <w>свиней</w>, чтобы увеличить объёмы сельскохозяйственного производства."
                            }
                        },
                        {
                            "text": "Feral <w>swine</w> can cause significant damage to native ecosystems.",
                            "target_lang_translations": {
                                "ru": "Дикие <w>свиньи</w> могут нанести существенный вред местным экосистемам."
                            }
                        }
                    ],
                    "synonyms": [
                        "pig",
                        "hog"
                    ],
                    "common_phrases": [
                        "swine flu",
                        "feral swine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свинья или родственное животное семейства свиных, особенно домашняя свинья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свинья",
                                "target_lang_sense_clarification": "животное"
                            },
                            {
                                "target_lang_word": "свиньи",
                                "target_lang_sense_clarification": "собирательно, поголовье свиней"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ab58a95-65fb-3f13-ac1d-618d6bc16d1d",
                    "sense_definition": "A cruel, dishonest, or contemptible person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contemptible_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He proved to be an absolute <w>swine</w> after cheating his business partners.",
                            "target_lang_translations": {
                                "ru": "Он оказался настоящей <w>свиньёй</w>, когда обманул своих деловых партнёров."
                            }
                        },
                        {
                            "text": "I never expected that selfish <w>swine</w> to apologize for his actions.",
                            "target_lang_translations": {
                                "ru": "Я и не ожидал, что этот эгоистичный <w>свинтус</w> извинится за свои поступки."
                            }
                        }
                    ],
                    "synonyms": [
                        "scoundrel",
                        "wretch"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as an insult"
                        }
