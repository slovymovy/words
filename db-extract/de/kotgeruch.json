                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24c593d1-b505-4c10-ab3b-552922e3e7ab",
                                "sense_id": "ccf3679e-e149-38e1-af1c-a74d7c14b9dd",
                                "text": "„Den ganzen restlichen Tag hindurch hatte ich den Kotgeruch als Phantomduft jedoch immer wieder in der Nase.“"
                            },
                            {
                                "example_id": "239d4334-d185-4aae-93bf-13f57e22be23",
                                "sense_id": "ccf3679e-e149-38e1-af1c-a74d7c14b9dd",
                                "text": "„Es war, als sei sein Erscheinen an diesem Ort unausweichlich gewesen, als führten alle Wege zur Farm zurück, zu dem Strohverschlag und dem Kotgeruch.“"
                            }
                        ],
