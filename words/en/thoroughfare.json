{
    "word_family": [
        "thorough"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b578cce-d887-3092-90f1-c8bf49f075d8",
                    "sense_definition": "A public road or street that connects two areas and allows for easy travel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "road",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city plans to widen the main <w>thoroughfare</w> to reduce traffic congestion during the morning rush.",
                            "target_lang_translations": {
                                "zh": "市政府计划拓宽这条主要<w>大道</w>，以缓解早高峰期间的交通拥堵。"
                            }
                        },
                        {
                            "text": "Many shops are located along the busy <w>thoroughfare</w> that runs through the center of town.",
                            "target_lang_translations": {
                                "zh": "许多商店坐落在这条穿过市中心的繁忙<w>大道</w>两旁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "highway",
                        "main street",
                        "roadway"
                    ],
                    "common_phrases": [
                        "busy thoroughfare",
                        "main thoroughfare"
                    ],
                    "target_lang_definitions": {
                        "zh": "连接两个区域并允许交通通行的公共道路或街道。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大道",
                                "target_lang_sense_clarification": "指城市中宽阔的主要交通干道。"
                            },
                            {
                                "target_lang_word": "通衢",
                                "target_lang_sense_clarification": "指四通八达的大路，多用于书面语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "461ac537-3440-3650-98ff-6e4dee1d0505",
                    "sense_definition": "A path or passage that allows people to move from one place to another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "passage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The narrow alleyway served as a convenient <w>thoroughfare</w> for pedestrians walking to the station.",
                            "target_lang_translations": {
                                "zh": "这条狭窄的小巷是行人前往车站的一条便捷<w>通道</w>。"
                            }
                        },
                        {
                            "text": "The security guard blocked the <w>thoroughfare</w> to prevent unauthorized access to the private building.",
                            "target_lang_translations": {
                                "zh": "保安封锁了这条<w>通道</w>，以防止未经授权的人员进入私人大楼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "passage",
                        "pathway",
                        "thoroughway"
                    ],
                    "common_phrases": [
                        "no thoroughfare"
                    ],
                    "target_lang_definitions": {
                        "zh": "允许人们从一处移动到另一处的路径或通道。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "通道",
                                "target_lang_sense_clarification": "指供人或车辆通行的路径。"
                            },
                            {
                                "target_lang_word": "通路",
                                "target_lang_sense_clarification": "指可以通行的路径。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f98fb01d-6151-37da-9b76-d500ee4877f3",
                    "sense_definition": "The act of passing through a place or area.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "passage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treaty guaranteed free <w>thoroughfare</w> for merchant ships across the international waters.",
                            "target_lang_translations": {
                                "zh": "该条约保障了商船在国际水域的自由<w>通行</w>。"
                            }
                        },
                        {
                            "text": "The mountain pass provides the only <w>thoroughfare</w> for travelers during the harsh winter months.",
                            "target_lang_translations": {
                                "zh": "在严冬时节，这个山口是旅行者唯一的<w>通行</w>路径。"
                            }
                        }
                    ],
                    "synonyms": [
                        "transit",
                        "passage"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过某地或某区域的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "通行",
                                "target_lang_sense_clarification": "指通过或往来。"
                            },
                            {
                                "target_lang_word": "过境",
                                "target_lang_sense_clarification": "指经过某国或某地区的领土。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "725cce54-54c1-306a-a67f-1a231a2e765f",
                    "sense_definition": "A clear and open waterway that allows ships to travel through.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "road",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The canal acts as a vital <w>thoroughfare</w> for cargo ships moving between the two major ports.",
                            "target_lang_translations": {
                                "zh": "这条运河是往返于两大港口之间的货船的重要<w>航道</w>。"
                            }
                        },
                        {
                            "text": "Dredging the river ensured that it remained a navigable <w>thoroughfare</w> for large vessels.",
                            "target_lang_translations": {
                                "zh": "疏浚河流确保了它依然是大型船只可通行的<w>航道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "waterway",
                        "shipping lane"
                    ],
                    "target_lang_definitions": {
                        "zh": "允许船只通行的开阔水道。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "航道",
                                "target_lang_sense_clarification": "指水上交通的路线。"
                            },
                            {
                                "target_lang_word": "水道",
                                "target_lang_sense_clarification": "指天然或人工的水路。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}