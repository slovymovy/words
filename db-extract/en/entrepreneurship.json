                "senses": [
                    {
                        "sense_id": "ea9e1ec8-1dff-3a0b-ba9f-0d3a31a97dba",
                        "entry_id": "9090d039-3e0f-3f3c-94a8-a16fd5588760",
                        "glosses": [
                            "The art or science of innovation and risk-taking for profit in business."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5a780b24-5a35-4c8e-b36e-d350f321d06e",
                                "sense_id": "ea9e1ec8-1dff-3a0b-ba9f-0d3a31a97dba",
                                "text": "It is an example of what real entrepreneurship can do on the railway, but sadly there are not many other examples. Most of the private sector businesses in rail are simply 'gaming' the system, trying to outdo or outthink the regulator and the Government in order to generate profit."
                            }
                        ]
                    },
                    {
                        "sense_id": "585c12d6-8388-31d9-b289-37ae3ee9a64b",
                        "entry_id": "9090d039-3e0f-3f3c-94a8-a16fd5588760",
                        "glosses": [
                            "The quality of being an entrepreneur."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95476a46-9164-462a-8004-512d953271d5",
                        "source_entry_id": "9090d039-3e0f-3f3c-94a8-a16fd5588760",
                        "source_sense_description": "quality of being an entrepreneur",
