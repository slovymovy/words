                "translations": [
                    {
                        "translation_id": "5dc967bd-c8ca-4db6-8604-28c88ac8b117",
                        "source_entry_id": "10deacbc-6673-324e-91db-f03ed5e06cbc",
                        "source_sense_id": "78b6d5eb-f20f-32cb-95d7-a891ca541f39",
                        "source_sense_description": "Staatsbürger von Guatemala",
                        "target_lang_word": "Guatemalan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guatemalan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7245666-47b8-31d0-b8c7-5c2ac134763f",
                                        "entry_id": "8468cc48-4895-324b-b35c-bc949ab9e05b",
                                        "glosses": [
                                            "A person from Guatemala or of Guatemalan descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d2b7053-b7f5-4d6a-97f1-4848ffce73fa",
                                                "sense_id": "f7245666-47b8-31d0-b8c7-5c2ac134763f",
                                                "text": "The Guatemalans offered United Fruit $627,572 (about $2.99 an acre) in compensation, a figure that came from the company's own tax value assessment for the land."
                                            },
                                            {
                                                "example_id": "8f2303ba-a2d4-43c1-9c50-e66f37ffd8ce",
                                                "sense_id": "f7245666-47b8-31d0-b8c7-5c2ac134763f",
                                                "text": "Guatemala has pledged a 40% increase in deportation flights carrying Guatemalans and migrants of other nationalities from the United States, President Bernardo Arévalo announced Wednesday during a press conference with US Secretary of State Marco Rubio."
                                            },
                                            {
                                                "example_id": "13ff7ec5-9a02-449a-a22b-6e52aeacbe54",
                                                "sense_id": "f7245666-47b8-31d0-b8c7-5c2ac134763f",
                                                "text": "MAGA Republicans are calling for Democratic Representative Delia Ramirez to be deported after she said, \"I'm a proud Guatemalan before I'm an American.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Guatemalan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "509b508f-be7f-367e-8f98-84f7c156a6d1",
                                        "entry_id": "aef8f05a-06c7-3ce2-a09c-f2a6aff93210",
                                        "glosses": [
                                            "Of, from, or pertaining to Guatemala or the Guatemalan people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c3428fa-f10f-4255-9cb2-aabdd941adde",
                                                "sense_id": "509b508f-be7f-367e-8f98-84f7c156a6d1",
                                                "text": "Guatemalan snowpea production has continually been harmed by insect and disease infestations."
                                            },
                                            {
                                                "example_id": "22641d99-bdf4-4b48-81de-ea26eadbb790",
                                                "sense_id": "509b508f-be7f-367e-8f98-84f7c156a6d1",
                                                "text": "Ramirez, who has represented Illinois in Congress since 2023, is the daughter of Guatemalan immigrants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82ba4cc4-4a7a-4b0d-863c-d9455a99d6de",
                        "source_entry_id": "10deacbc-6673-324e-91db-f03ed5e06cbc",
                        "source_sense_id": "78b6d5eb-f20f-32cb-95d7-a891ca541f39",
                        "source_sense_description": "Staatsbürger von Guatemala",
                        "target_lang_word": "Guatémaltèque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guatémaltèque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c1a4dc4-a38d-3711-b293-f9bbe4e12f83",
                                        "entry_id": "46b28d0e-bcff-33f8-8836-95d3de269795",
                                        "glosses": [
                                            "Habitant ou originaire du Guatémala, en Amérique centrale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec775b74-6614-4d67-9896-6754cca23b48",
                                                "sense_id": "0c1a4dc4-a38d-3711-b293-f9bbe4e12f83",
                                                "text": "Moi, Guatémaltèque pur sang, héritier des héros du 24 juin, du 6 juillet et du 24 août, je ne crains pas de vous le dire."
                                            },
                                            {
                                                "example_id": "e4f96d86-49df-4549-b1de-88804c2e55c6",
                                                "sense_id": "0c1a4dc4-a38d-3711-b293-f9bbe4e12f83",
                                                "text": "L’indépendance des pays d’Amérique centrale du joug espagnol en 1821 allait provoquer une situation à double tranchant, puisque si les Espagnols ne pouvaient plus prétendre à leur souveraineté sur cette région, le gouvernement du Guatemala n’allait pas laisser filer pareille occasion d’augmenter son territoire. La dispute entre les Britanniques et les Guatémaltèques quant au territoire du Belize figurera au chapitre des principales préoccupations des Béliziens, et ce tout au long des XIXᵉ et XXᵉ siècles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
