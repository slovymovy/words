                "senses": [
                    {
                        "sense_id": "341a632d-b4e1-3d5c-8a0b-201390bfddc0",
                        "entry_id": "53755503-e9b2-30aa-a769-0aa7d2b5079e",
                        "glosses": [
                            "mający krzywe, asymetryczne usta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceed370d-811f-4498-bf76-4848e9a78206",
                                "sense_id": "341a632d-b4e1-3d5c-8a0b-201390bfddc0",
                                "text": "Pojrzenie krzywouste i nos zakrzywiony • W gębę patrzy, na straży zębom postawiony."
                            },
                            {
                                "example_id": "4f254d71-5f30-4d28-a41d-8ea858b3dcca",
                                "sense_id": "341a632d-b4e1-3d5c-8a0b-201390bfddc0",
                                "text": "Obie strony sięgnęły do repertuaru, którego by im pozazdrościły – w razie swego zmartwychwstania – krzywouste maszkary i strachy z ciemnych grobowców etruskich albo i wiedźmy z ustami od ucha do ucha, oddające się nieskromnym"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
