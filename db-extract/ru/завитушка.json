                ],
                "senses": [
                    {
                        "sense_id": "c041b536-5097-3693-a7e0-fb3000bedc88",
                        "entry_id": "a5c4e21d-eb07-31e5-99ae-fe74ce41de77",
                        "glosses": [
                            "то же, что завиток; то, что имеет форму спирали или образует закручивающуюся линию"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ebb6cace-8d37-3f52-af02-a01508ac71ca",
                        "entry_id": "a5c4e21d-eb07-31e5-99ae-fe74ce41de77",
                        "glosses": [
                            "перен., разг. вычурный, сложный оборот речи"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75da650b-6931-4d64-ba89-641c6ad44a49",
                        "source_entry_id": "a5c4e21d-eb07-31e5-99ae-fe74ce41de77",
                        "target_lang_word": "curlicue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curlicue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db77c9a0-9573-3a38-8b51-d7f19b37b6a2",
                                        "entry_id": "94eb7e84-a9a9-3286-9606-3a4b5b24d654",
                                        "glosses": [
                                            "A fancy twisting or curling shape usually made from a series of spirals and loops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e29345fa-2ca6-49ad-a614-d29ad1516f4c",
                                                "sense_id": "db77c9a0-9573-3a38-8b51-d7f19b37b6a2",
                                                "text": "I put in plenty of curlicues after the figures so that no one could raise the check into $400,000; then I got out my old rattan suit case and put in some clothes."
                                            },
                                            {
                                                "example_id": "3ac34547-42d9-457b-99bb-1dde80a70f75",
                                                "sense_id": "db77c9a0-9573-3a38-8b51-d7f19b37b6a2",
                                                "text": "There was not the slightest use in trying to make its twisty curlicue streets conform to any engineering plan on earth; so those sensible old-time folk didn't try."
                                            },
                                            {
                                                "example_id": "e208de2f-2561-46ca-ad82-b0de2ab3542d",
                                                "sense_id": "db77c9a0-9573-3a38-8b51-d7f19b37b6a2",
                                                "text": "(Curlicue hand-drawn cartoons blossom frequently throughout, touching base with the source material’s distinctive visual style while adding an aptly hallucinogenic vibe when required.)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "curlicue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25f78a12-8ca7-3c1a-8dc4-7500ff7a2847",
                                        "entry_id": "df6dce80-c6e5-3dd3-9f4e-3d763039914b",
                                        "glosses": [
                                            "To make or adorn (something) with curlicues, or as if with curlicues."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a84fec49-c144-454f-b9ff-47ec27f5d363",
                                                "sense_id": "25f78a12-8ca7-3c1a-8dc4-7500ff7a2847",
                                                "text": "A chandelier the shape of an anchor, hanging over Smith's head as he passed out through this vestibule. Walls curlicued with comb marks of some fancy plasterer."
                                            },
                                            {
                                                "example_id": "05f6d3af-98ce-4c79-b47d-c8db3f18d541",
                                                "sense_id": "25f78a12-8ca7-3c1a-8dc4-7500ff7a2847",
                                                "text": "I was looking, obliquely, at Bunny slumped over his bowl when all of a sudden, in the window behind his head, I saw the distant figure of Mr. Hatch, walking across the open field beyond the garden, carrying the dark, curlicued ruins of the Malacca chair to the rubbish heap."
                                            },
                                            {
                                                "example_id": "2658758d-3afd-42a7-99d0-f4b2622dcf55",
                                                "sense_id": "25f78a12-8ca7-3c1a-8dc4-7500ff7a2847",
                                                "text": "“Here We Go Again” is the gentlest kiss-off imaginable, with strings and harp and curlicued guitars cushioning Ms. Stone’s farewell[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57f5c13b-72d7-4b4c-aaa3-4db76da39418",
                        "source_entry_id": "a5c4e21d-eb07-31e5-99ae-fe74ce41de77",
                        "target_lang_word": "flourish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flourish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fed49d74-4e13-3341-b74a-252d5338a27f",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To thrive or grow well."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5afd6986-341a-4b03-8784-5dbbe669a7ac",
                                                "sense_id": "fed49d74-4e13-3341-b74a-252d5338a27f",
                                                "text": "The barley flourished in the warm weather."
                                            },
                                            {
                                                "example_id": "265f5501-6967-4d58-8cc1-fce3928125e9",
                                                "sense_id": "fed49d74-4e13-3341-b74a-252d5338a27f",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ac65f76-7222-33b9-837e-bd15b1ac4f8f",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To prosper or fare well."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fafa45a-1c77-4862-aee4-4e825c7bfcc0",
                                                "sense_id": "7ac65f76-7222-33b9-837e-bd15b1ac4f8f",
                                                "text": "The town flourished with the coming of the railway."
                                            },
                                            {
                                                "example_id": "a7709d42-df79-4486-b26d-cff2441e7362",
                                                "sense_id": "7ac65f76-7222-33b9-837e-bd15b1ac4f8f",
                                                "text": "The cooperation flourished as the customers rushed in the business."
                                            },
                                            {
                                                "example_id": "767a7898-6eb3-444a-b36e-128f9e0f7b74",
                                                "sense_id": "7ac65f76-7222-33b9-837e-bd15b1ac4f8f",
                                                "text": "Bad men as frequently prosper and flourish, and that by the means of their wickedness."
                                            },
                                            {
                                                "example_id": "46629cad-c770-4ab7-ba50-1e3495d16079",
                                                "sense_id": "7ac65f76-7222-33b9-837e-bd15b1ac4f8f",
                                                "text": "One hall called Civil Law Hall or School, flouriſhed about this time (though in its buildings decayed) by the care of the learned and judicious Dr. Will. Warham Principal or Moderator thereof […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e92e14-cfc6-3f0e-b9c9-bbfbae8af451",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To be in a period of greatest influence."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "212fda39-c59b-4a92-b5d0-763e8e5c16c8",
                                                "sense_id": "33e92e14-cfc6-3f0e-b9c9-bbfbae8af451",
                                                "text": "His writing flourished before the war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ca8c409-6fe5-351d-bd8a-3f81c29905a0",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To develop; to make thrive; to expand."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05c30f7b-ff90-4547-8076-c46f95898ab4",
                                                "sense_id": "6ca8c409-6fe5-351d-bd8a-3f81c29905a0",
                                                "text": "But all that I ſhall ſay in this vvhole Argument, vvill be but like Bottomes of Thred, cloſe vvound vp, vvhich vvith a good Needle (perhaps) may be flouriſhed into large VVorkes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e0bc8e1-aff8-305b-b415-56998ea1c5dc",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To make bold, sweeping movements with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a24de63b-eebb-47b4-885f-b421c16a73ad",
                                                "sense_id": "5e0bc8e1-aff8-305b-b415-56998ea1c5dc",
                                                "text": "They flourished the banner as they stormed the palace."
                                            },
                                            {
                                                "example_id": "20d50371-1ad0-4a67-aa18-eb73b755948d",
                                                "sense_id": "5e0bc8e1-aff8-305b-b415-56998ea1c5dc",
                                                "text": "The squirrel flourished its fluffy tail about as an alarm signal after its narrow escape from the cat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79877152-d8e8-3ceb-aeb5-4cd84ac1075a",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To make bold and sweeping, fanciful, or wanton movements, by way of ornament, parade, bravado, etc.; to play with fantastic and irregular motion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a0ea0c2-d06a-4627-b9cd-4df573212dd3",
                                                "sense_id": "79877152-d8e8-3ceb-aeb5-4cd84ac1075a",
                                                "text": "Impetuous spread the stream, and smoking flourished o'er his head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86d63443-e4fd-3996-b18e-a9e205812b94",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To use florid language; to indulge in rhetorical figures and lofty expressions."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c159133-3e7a-47f1-9def-1ac62d64af70",
                                                "sense_id": "86d63443-e4fd-3996-b18e-a9e205812b94",
                                                "text": "They dilate […] and flourish long upon little incidents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f47bfb8c-e3a9-396d-9ffc-969ce255840e",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To make ornamental strokes with the pen; to write graceful, decorative figures."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e8af8e5-1399-3f66-846e-bdc21787e4b8",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To adorn with beautiful figures or rhetoric; to ornament with anything showy; to embellish."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c69e0b3-2823-48b5-b9a0-ddc84c6ae996",
                                                "sense_id": "8e8af8e5-1399-3f66-846e-bdc21787e4b8",
                                                "text": "With shadowy verdure flourish'd high,\nA sudden youth the groves enjoy."
                                            },
                                            {
                                                "example_id": "30d8ac70-d5a9-48d6-b853-af57d80de0a7",
                                                "sense_id": "8e8af8e5-1399-3f66-846e-bdc21787e4b8",
                                                "text": "To bring you thus together, 'tis no sin, Sith that the justice of your title to him Doth flourish the deceit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6e06c21-6e21-33e3-b6c5-ef6f839ffd46",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To execute an irregular or fanciful strain of music, by way of ornament or prelude."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dba02bc-24d9-4d0d-8d55-33f37eea8ee3",
                                                "sense_id": "b6e06c21-6e21-33e3-b6c5-ef6f839ffd46",
                                                "text": "Why do the emperor's trumpets flourish thus?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fed0e101-52ac-337d-8e08-c50d09fbe98f",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To boast; to vaunt; to brag."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "101988d1-54b4-3b71-bfd6-8ef9ea9619db",
                                        "entry_id": "542cae16-62d2-34c3-b7ab-09158bcb57df",
                                        "glosses": [
                                            "To brandish (a weapon)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flourish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8a0ee87-0fb1-3c2f-8995-023e6179b424",
                                        "entry_id": "a5b1eb6b-2fae-38e7-9293-9cab1f25fb38",
                                        "glosses": [
                                            "A dramatic gesture such as the waving of a flag."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0bdb7c9-0854-4a54-9aec-f5625ac4cd46",
                                                "sense_id": "d8a0ee87-0fb1-3c2f-8995-023e6179b424",
                                                "text": "With many flourishes of the captured banner, they marched down the avenue."
                                            },
                                            {
                                                "example_id": "ec8846a1-8d2d-4767-bc9f-9d448d86c773",
                                                "sense_id": "d8a0ee87-0fb1-3c2f-8995-023e6179b424",
                                                "text": "This is my substitute for pistol and ball. With a philosophical flourish Cato throws himself upon his sword; I quietly take to the ship."
                                            },
                                            {
                                                "example_id": "1113c427-4737-400a-aea3-282b62ae1945",
                                                "sense_id": "d8a0ee87-0fb1-3c2f-8995-023e6179b424",
                                                "text": "Gabriel Jesus' solo goal - as a stunned United pushed for an equaliser - was a flourish that eased any late nerves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa691e67-131b-3d1d-bffc-1054ce0a8d65",
                                        "entry_id": "a5b1eb6b-2fae-38e7-9293-9cab1f25fb38",
                                        "glosses": [
                                            "An ornamentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f181326c-99a3-4a58-b2bf-df7872ceb23e",
                                                "sense_id": "fa691e67-131b-3d1d-bffc-1054ce0a8d65",
                                                "text": "His signature ended with a flourish."
                                            },
                                            {
                                                "example_id": "21f5ec8a-2742-4d7b-a6bd-def29ff3fb29",
                                                "sense_id": "fa691e67-131b-3d1d-bffc-1054ce0a8d65",
                                                "text": "[B]revity is the soul of wit,\nAnd tediousness the limbs and outward flourishes[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab696095-f776-3aca-aa8c-b2fd5619a63d",
                                        "entry_id": "a5b1eb6b-2fae-38e7-9293-9cab1f25fb38",
                                        "glosses": [
                                            "A ceremonious passage such as a fanfare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc43cbb8-dfae-4f3e-a03d-dcdfe9998ebf",
                                                "sense_id": "ab696095-f776-3aca-aa8c-b2fd5619a63d",
                                                "text": "The trumpets blew a flourish as they entered the church."
                                            },
                                            {
                                                "example_id": "8759e1f4-626e-438c-b15d-6c5a6ae60ff9",
                                                "sense_id": "ab696095-f776-3aca-aa8c-b2fd5619a63d",
                                                "text": "[I]f he is a soldier in command, successes will be amplified, and the results of his campaigns announced with a flourish of trumpets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cc4f93c-f253-35a8-8015-2f7aae29b987",
                                        "entry_id": "a5b1eb6b-2fae-38e7-9293-9cab1f25fb38",
                                        "glosses": [
                                            "A decorative embellishment on a building."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
