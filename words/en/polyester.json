                {
                    "sense_id": "1cce9ca3-1d40-3a2c-b056-0b82aca44dac",
                    "sense_definition": "A synthetic material or fabric made from polyester polymer, commonly used in clothing and textiles.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "materials",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This shirt is made of a <w>polyester</w> blend that does not wrinkle easily.",
                            "target_lang_translations": {
                                "ru": "Эта рубашка сделана из смеси с <w>полиэстером</w>, которая почти не мнется."
                            }
                        },
                        {
                            "text": "She prefers wearing <w>polyester</w> clothing because it is durable and dries very quickly.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает носить одежду из <w>полиэстера</w>, потому что она прочная и очень быстро сохнет."
                            }
                        }
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Синтетический материал или ткань, изготовленная из полиэфирного полимера, широко используемая в одежде и текстиле."
                    },
                    "translations": {
                        "ru": [
