                        ],
                        "examples": [
                            {
                                "example_id": "58a1a3f4-10e2-4eeb-b9ca-081ad02873b6",
                                "sense_id": "2898b8dd-f375-3bf0-86ab-545cc98f5edd",
                                "text": "Mein favorisierter Webbrowser ist der Internet Explorer."
                            },
                            {
                                "example_id": "ddbb47e8-cc65-4ebb-9875-a8ceb274a2e9",
                                "sense_id": "2898b8dd-f375-3bf0-86ab-545cc98f5edd",
                                "text": "„Neben HTML-Seiten können Webbrowser verschiedene andere Arten von Dokumenten wie zum Beispiel Bilder und PDF-Dokumente anzeigen. Webbrowser stellen die Benutzeroberfläche für Webanwendungen dar.“"
                            },
                            {
                                "example_id": "766e1046-5438-458f-b9f4-f4d7a4635f8a",
                                "sense_id": "2898b8dd-f375-3bf0-86ab-545cc98f5edd",
                                "text": "„Der erste brauchbare Webbrowser erschien erst weitere zehn Jahre später.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
