                {
                    "sense_id": "2eb4091a-775f-35f7-9bcf-361f76da40f9",
                    "sense_definition": "Possessing a very large amount of money.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
