                        "entry_id": "0de6f3eb-8469-347a-b256-0992381ffea0",
                        "glosses": [
                            "drewniana ubikacja na podwórzu"
                        ],
                        "tags": [
                            "colloquial",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "73695b64-4e40-43d6-a8f1-0a2d86aaf53e",
                                "sense_id": "d6fbba0f-1b29-3ae3-ae4b-82b4fffa1c1a",
                                "text": "U moich dziadków do niedawna chodziło się do sławojki."
                            }
                        ],
