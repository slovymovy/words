                    },
                    {
                        "form_id": "b2c56d18-269e-416a-82d0-3406c1130f6a",
                        "entry_id": "75db44a4-1d45-31bf-b43e-a595234f5585",
                        "tags": [
                            "potential",
                            "rare",
                            "vocative",
                            "plural"
                        ],
                        "form": "oszołomienia"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cae21b97-e948-3173-b3da-f1ac7dfca22a",
                        "entry_id": "75db44a4-1d45-31bf-b43e-a595234f5585",
                        "glosses": [
                            "stan ograniczonej świadomości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cd771b3-0d17-4659-b102-0e2a5b5fe4fa",
                                "sense_id": "cae21b97-e948-3173-b3da-f1ac7dfca22a",
                                "text": "Podniósł pięści i obiema równocześnie rąbnął w głowę młodego. Nie powaliło go to od razu, ale sekunda oszołomienia zgubiła go"
                            },
                            {
                                "example_id": "0d9addc2-627d-45f7-bbaa-20a37f81aeab",
                                "sense_id": "cae21b97-e948-3173-b3da-f1ac7dfca22a",
                                "text": "W sennym oszołomieniu [narkozą] Anna widziała nad sobą dwa olbrzymie, zielone owady z trupimi czaszkami […]"
                            },
                            {
                                "example_id": "7b6ce690-054e-48e0-a98b-1cf1af786334",
                                "sense_id": "cae21b97-e948-3173-b3da-f1ac7dfca22a",
                                "text": "Alkohol dawał mu tyle oszołomienia i zapomnienia, więc pił… pił"
                            },
                            {
                                "example_id": "3c32e860-20f6-4ba6-9d5b-9828e6cc5065",
                                "sense_id": "cae21b97-e948-3173-b3da-f1ac7dfca22a",
                                "text": "Powstanie tej nazwy [gazu rozweselającego] tłumaczy się przyjemnym stanem oszołomienia, odczuwanym przy wdychaniu gazu"
                            },
                            {
                                "example_id": "d842a3a7-8eb2-4c43-8d94-bc4505ce4406",
                                "sense_id": "cae21b97-e948-3173-b3da-f1ac7dfca22a",
                                "text": "Nocne czuwanie, sen pełny trwogi — wprawiły redaktora w stan szczególnego oszołomienia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "70801321-5a6d-3330-82d6-889b36e93e51",
                        "entry_id": "75db44a4-1d45-31bf-b43e-a595234f5585",
                        "glosses": [
                            "stan wywołany silnym przeżyciem"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "e9d9c19d-3a8e-4048-9a12-5a2f3c541530",
                                "sense_id": "70801321-5a6d-3330-82d6-889b36e93e51",
                                "text": "Wytrącony z równowagi tym wybuchem, spoglądał w oszołomieniu na wstrząsane płaczem plecy żony"
                            },
                            {
                                "example_id": "44e40652-6cf4-4901-be1e-61fdecee3c74",
                                "sense_id": "70801321-5a6d-3330-82d6-889b36e93e51",
                                "text": "Przeżył, jak w ubiegłych latach, radosne i hałaśliwe oszołomienie pierwszego dnia nowego roku"
                            },
                            {
                                "example_id": "c38edd45-e759-4538-93a4-319dc36dd70f",
                                "sense_id": "70801321-5a6d-3330-82d6-889b36e93e51",
                                "text": "Tymczasem ochłonąłem z pierwszego oszołomienia i poczułem przypływ odwagi"
                            },
                            {
                                "example_id": "355de159-92fd-4a6d-ac45-cd367d7898db",
                                "sense_id": "70801321-5a6d-3330-82d6-889b36e93e51",
                                "text": "Miłość pochłaniała go zupełnie, całymi tygodniami znajduje się to w stanie ekstazy, to w stanie boleśnego oszołomienia lub nerwowego odrętwienia"
                            },
                            {
                                "example_id": "2a9bf0ca-161a-4692-922c-5bee0d3792da",
                                "sense_id": "70801321-5a6d-3330-82d6-889b36e93e51",
                                "text": "Resztki śniegu przypominają rozczochrane peruki, porzucone w oszołomieniu przez zimę"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
