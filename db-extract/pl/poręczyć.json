                        "cross_references": [
                            {
                                "target_word": "поручиться",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "623cb678-6595-31ab-818d-64604f036e93",
                                        "entry_id": "12fdaac1-178c-38e4-999e-89d771a444e4",
                                        "glosses": [
                                            "принять на себя ответственность за кого-либо, что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d91639-f458-4b7a-bc8a-474904edf546",
                                                "sense_id": "623cb678-6595-31ab-818d-64604f036e93",
                                                "text": "Кто за тебя может поручиться?"
                                            },
                                            {
                                                "example_id": "31029258-447e-4920-8a10-50ef82065731",
                                                "sense_id": "623cb678-6595-31ab-818d-64604f036e93",
                                                "text": "Кто поручится, что это правда?"
                                            },
                                            {
                                                "example_id": "523b1948-bbd3-48af-90ed-8a82043a875a",
                                                "sense_id": "623cb678-6595-31ab-818d-64604f036e93",
                                                "text": "Я за тебя поручился отцу."
                                            },
                                            {
                                                "example_id": "4f7b9305-8d2b-4708-9ef9-6aac310891d8",
                                                "sense_id": "623cb678-6595-31ab-818d-64604f036e93",
                                                "text": "Поручиться честью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1db753c-6758-3a94-9751-b001687fddf9",
                                        "entry_id": "12fdaac1-178c-38e4-999e-89d771a444e4",
                                        "glosses": [
                                            "быть уверенным в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6edd457-4fe9-446f-a12e-a61ddb198fed",
                                                "sense_id": "d1db753c-6758-3a94-9751-b001687fddf9",
                                                "text": "Могу поручиться чем угодно, что этого не случится."
                                            },
                                            {
                                                "example_id": "06a25216-2667-4b32-a784-4699bc1bbe92",
                                                "sense_id": "d1db753c-6758-3a94-9751-b001687fddf9",
                                                "text": "Могу поручиться, что никогда не видел этого человека."
                                            },
                                            {
                                                "example_id": "e745af40-2cc9-480c-baa0-360ab36ed340",
                                                "sense_id": "d1db753c-6758-3a94-9751-b001687fddf9",
                                                "text": "Нельзя поручиться, что дождь снова не пойдёт."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
