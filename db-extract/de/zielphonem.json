                "senses": [
                    {
                        "sense_id": "d3f9bec0-05b0-36f8-8696-051c9cb4cf2e",
                        "entry_id": "4b79d124-24fd-33c6-92ee-b7d78cc4acaa",
                        "glosses": [
                            "Phonem, das angestrebt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b38f43b7-d93a-47e6-9081-74191c1546c0",
                                "sense_id": "d3f9bec0-05b0-36f8-8696-051c9cb4cf2e",
                                "text": "„Wir wollen uns nun mit den Veränderungen der einzelnen Artmerkmale der Zielphoneme beschäftigen.“"
                            },
                            {
                                "example_id": "1b7a1076-84c3-4f39-b425-1eb54656780d",
                                "sense_id": "d3f9bec0-05b0-36f8-8696-051c9cb4cf2e",
                                "text": "„Das Zielphonem befindet sich in Initialposition.“"
                            },
                            {
                                "example_id": "c9bc705f-0fdb-4db0-8822-6ae21a6c81ff",
                                "sense_id": "d3f9bec0-05b0-36f8-8696-051c9cb4cf2e",
                                "text": "„Sobald sie das vorgegebene Zielphonem hört, soll sie so schnell wie möglich (in der Regel durch das Drücken einer Taste) reagieren.“"
                            },
                            {
                                "example_id": "0a3d324b-a1f2-489f-a7e1-462f997daad5",
                                "sense_id": "d3f9bec0-05b0-36f8-8696-051c9cb4cf2e",
                                "text": "„Phonologische Fehler können im Hinblick darauf beschrieben werden, mit welchen spezifischen Zielphonemen ein Kind Probleme hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
