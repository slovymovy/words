                    "sense_definition": "Отобразить данные на экране или отправить их на внешнее устройство",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Программа должна <вывести> результат вычислений на монитор.",
                            "target_lang_translations": {
                                "en": "The program must <display> the calculation result on the monitor.",
                                "nl": "Het programma moet het resultaat van de berekeningen op het scherm <weergeven>."
