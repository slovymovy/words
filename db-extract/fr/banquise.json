                                "target_senses": [
                                    {
                                        "sense_id": "d4769b51-f771-3db6-9406-2f913581875a",
                                        "entry_id": "7b8b1d9e-8fcf-3b41-8a1c-c21476014508",
                                        "glosses": [
                                            "die am häufigsten vorkommende Art von Meereis, bestehend aus aufeinander geschobenen Eisschollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f22d1193-f969-462a-8dbd-dda6aa34b17b",
                                                "sense_id": "d4769b51-f771-3db6-9406-2f913581875a",
                                                "text": "Durch das Aufströmen auf Hindernisse bilden sich aus dem Packeis Presseisfelder, welche die Schifffahrt behindern oder sogar unmöglich machen können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
