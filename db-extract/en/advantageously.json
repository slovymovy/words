                                            {
                                                "example_id": "cce19b89-0da3-4b06-a57a-20bca0b4d7a3",
                                                "sense_id": "0608fefc-9479-38fe-99c1-e33b8c3a9729",
                                                "text": "Вчера на базаре выгодно продал тёлку."
                                            }
