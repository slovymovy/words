    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a002b22e-0f0d-30a4-b330-8ad59091c196",
                    "sense_definition": "Always doing things, moving around, or involved in activities; full of energy and not resting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother stays <w>active</w> by gardening and walking every day.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка остается <w>активной</w>, занимаясь садоводством и гуляя каждый день.",
                                "pl": "Moja babcia pozostaje <w>aktywna</w>, uprawiając ogród i spacerując każdego dnia.",
                                "zh": "我祖母每天通过园艺和散步来保持<w>活跃</w>。"
                            }
                        },
                        {
                            "text": "He is an <w>active</w> member of the local chess club.",
                            "target_lang_translations": {
                                "ru": "Он <w>активный</w> член местного шахматного клуба.",
                                "pl": "Jest <w>aktywnym</w> członkiem lokalnego klubu szachowego.",
                                "zh": "他是当地国际象棋俱乐部的一名<w>积极</w>成员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "energetic",
                        "busy",
                        "lively",
                        "dynamic"
                    ],
                    "antonyms": [
                        "inactive",
                        "sluggish",
                        "sedentary",
                        "passive",
                        "indolent"
                    ],
                    "common_phrases": [
                        "stay active",
                        "active lifestyle",
                        "active participant",
                        "active role"
                    ],
                    "target_lang_definitions": {
                        "ru": "Всегда занятый делом, подвижный или вовлеченный в деятельность; полный энергии и не сидящий на месте.",
                        "pl": "Zawsze zajęty, ruchliwy lub zaangażowany w działania; pełen energii i nieodpoczywający.",
                        "zh": "指人或事物始终在活动、忙碌或参与某项事务；充满活力，不处于休息状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "активный",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "деятельный",
                                "target_lang_sense_clarification": "постоянно занятый делом"
                            },
                            {
                                "target_lang_word": "энергичный",
                                "target_lang_sense_clarification": "полный энергии"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "aktywny",
                                "target_lang_sense_clarification": "ogólne określenie osoby"
                            },
                            {
                                "target_lang_word": "energiczny",
                                "target_lang_sense_clarification": "pełen energii"
                            },
                            {
                                "target_lang_word": "ruchliwy",
                                "target_lang_sense_clarification": "dużo się ruszający"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活跃",
                                "target_lang_sense_clarification": "指人或事物充满活力"
                            },
                            {
                                "target_lang_word": "积极",
                                "target_lang_sense_clarification": "指参与活动或态度主动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a16da0ee-084b-3a6f-961a-aa64dad8b7e6",
                    "sense_definition": "Currently functioning, operating, or in effect; not stopped, paused, or extinct.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mount Etna is one of the most <w>active</w> volcanoes in Europe.",
                            "target_lang_translations": {
                                "ru": "Этна — один из самых <w>активных</w> вулканов в Европе.",
                                "pl": "Etna to jeden z najbardziej <w>czynnych</w> wulkanów w Europie.",
                                "zh": "埃特纳火山是欧洲最<w>活跃</w>的火山之一。"
                            }
                        },
                        {
                            "text": "You need an <w>active</w> internet connection to use this application.",
                            "target_lang_translations": {
                                "ru": "Для использования этого приложения вам нужно <w>активное</w> интернет-соединение.",
                                "pl": "Do korzystania z tej aplikacji potrzebujesz <w>aktywnego</w> połączenia z internetem.",
                                "zh": "你需要一个<w>有效</w>的网络连接才能使用此应用程序。"
                            }
                        }
                    ],
                    "synonyms": [
                        "working",
                        "operative",
                        "running",
                        "in force",
                        "live",
                        "functional"
                    ],
                    "antonyms": [
                        "inactive",
                        "dormant",
                        "extinct",
                        "quiescent"
                    ],
                    "common_phrases": [
                        "active volcano",
                        "active account",
                        "active duty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Функционирующий, работающий или имеющий силу в данный момент; не остановленный и не исчезнувший.",
                        "pl": "Obecnie funkcjonujący, działający lub obowiązujący; niezatrzymany, nieprzerwany ani niewygasły.",
                        "zh": "指当前正在运行、生效或处于工作状态；未停止、未暂停或未灭绝。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действующий",
                                "target_lang_sense_clarification": "функционирующий (о вулкане, законе)"
                            },
                            {
                                "target_lang_word": "активный",
                                "target_lang_sense_clarification": "находящийся в действии (о счете, подключении)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "aktywny",
                                "target_lang_sense_clarification": "np. konto, połączenie"
                            },
                            {
                                "target_lang_word": "czynny",
                                "target_lang_sense_clarification": "np. wulkan, sklep"
                            },
                            {
                                "target_lang_word": "działający",
                                "target_lang_sense_clarification": "funkcjonujący"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活跃",
                                "target_lang_sense_clarification": "指火山等处于活动状态"
                            },
                            {
                                "target_lang_word": "有效",
                                "target_lang_sense_clarification": "指连接或账户处于可用状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c730114b-d1ca-3fff-a9ab-0c2862cdb889",
                    "sense_definition": "Relating to a verb form or voice in which the subject performs the action rather than receiving it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Teachers often encourage students to write in the <w>active</w> voice for greater clarity.",
                            "target_lang_translations": {
                                "ru": "Учителя часто советуют студентам писать в <w>действительном</w> залоге для большей ясности.",
                                "pl": "Nauczyciele często zachęcają uczniów do pisania w stronie <w>czynnej</w> dla większej jasności.",
                                "zh": "老师们经常鼓励学生使用<w>主动语态</w>写作，以使表达更清晰。"
                            }
                        },
                        {
                            "text": "In the sentence 'The cat chased the mouse', the verb is <w>active</w>.",
                            "target_lang_translations": {
                                "ru": "В предложении «Кошка погналась за мышью» глагол стоит в <w>действительном</w> залоге.",
                                "pl": "W zdaniu „Kot gonił mysz” czasownik jest w formie <w>czynnej</w>.",
                                "zh": "在“猫追赶老鼠”这句话中，动词使用的是<w>主动语态</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "passive"
                    ],
                    "common_phrases": [
                        "active voice",
                        "active verb"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к грамматическому залогу, в котором подлежащее выполняет действие, а не испытывает его на себе.",
                        "pl": "Odnoszący się do formy czasownika lub strony, w której podmiot wykonuje czynność, a nie jej podlega.",
                        "zh": "指动词的一种语态，在这种语态中，主语是动作的执行者而非承受者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действительный",
                                "target_lang_sense_clarification": "грамматический термин (залог)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "czynny",
                                "target_lang_sense_clarification": "termin gramatyczny (strona)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主动语态",
                                "target_lang_sense_clarification": "语法术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa1348b9-72f0-3607-974b-ed5db2b6e282",
                    "sense_definition": "Having a specific chemical, biological, or physical effect; capable of causing a reaction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Always check the label to see the <w>active</w> ingredients in the medicine.",
                            "target_lang_translations": {
                                "ru": "Всегда проверяйте этикетку, чтобы узнать <w>действующие</w> вещества в лекарстве.",
                                "pl": "Zawsze sprawdzaj etykietę, aby poznać składniki <w>czynne</w> w leku.",
                                "zh": "务必查看标签以了解药物中的<w>有效</w>成分。"
                            }
                        },
                        {
                            "text": "Yeast is an <w>active</w> culture that causes the bread dough to rise.",
                            "target_lang_translations": {
                                "ru": "Дрожжи — это <w>активная</w> культура, которая заставляет тесто подниматься.",
                                "pl": "Drożdże to <w>aktywne</w> kultury, które powodują wyrastanie ciasta chlebowego.",
                                "zh": "酵母是一种<w>活性</w>菌种，能使面包面团发酵膨胀。"
                            }
                        }
                    ],
                    "synonyms": [
                        "potent",
                        "effective"
                    ],
                    "antonyms": [
                        "inert",
                        "inactive"
                    ],
                    "common_phrases": [
                        "active ingredient",
                        "active substance",
                        "active agent"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий определенным химическим, биологическим или физическим действием; способный вызывать реакцию.",
                        "pl": "Mający określone działanie chemiczne, biologiczne lub fizyczne; zdolny do wywołania reakcji.",
                        "zh": "指具有特定的化学、生物或物理作用；能够引起反应。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действующий",
                                "target_lang_sense_clarification": "о веществе или ингредиенте"
                            },
                            {
                                "target_lang_word": "активный",
                                "target_lang_sense_clarification": "вызывающий реакцию"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "aktywny",
                                "target_lang_sense_clarification": "zdolny do reakcji"
                            },
                            {
                                "target_lang_word": "czynny",
                                "target_lang_sense_clarification": "o składniku leku"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有效",
                                "target_lang_sense_clarification": "指药物中的成分"
                            },
                            {
                                "target_lang_word": "活性",
                                "target_lang_sense_clarification": "指生物或化学物质的特性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83fe0d18-1b21-3dc6-ab11-7ed14cd53672",
                    "sense_definition": "A member of an organization, especially a fraternity or sorority, who is currently participating fully.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>actives</w> organized a welcome party for the new pledges.",
                            "target_lang_translations": {
                                "ru": "<w>Активные члены</w> организовали приветственную вечеринку для новичков.",
                                "pl": "<w>Aktywni członkowie</w> zorganizowali przyjęcie powitalne dla nowych kandydatów.",
                                "zh": "<w>活跃成员</w>们为新加入的成员举办了欢迎派对。"
                            }
                        },
                        {
                            "text": "Only <w>actives</w> are allowed to vote on the proposed changes to the chapter rules.",
                            "target_lang_translations": {
                                "ru": "Только <w>активным членам</w> разрешено голосовать по предложенным изменениям в правилах отделения.",
                                "pl": "Tylko <w>aktywni członkowie</w> mogą głosować nad proponowanymi zmianami w regulaminie oddziału.",
                                "zh": "只有<w>活跃成员</w>才有权对拟议的分会规则变更进行投票。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mostly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член организации (особенно студенческого братства), который в данный момент полноценно участвует в её деятельности.",
                        "pl": "Członek organizacji (zwłaszcza bractwa studenckiego), który obecnie w pełni uczestniczy w jej życiu.",
                        "zh": "指组织（尤其是学生联谊会）中目前全面参与活动的成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "активный член",
                                "target_lang_sense_clarification": "участник организации"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "aktywny członek",
                                "target_lang_sense_clarification": "uczestnik organizacji"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活跃成员",
                                "target_lang_sense_clarification": "组织中的正式参与者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "366ef85d-40b1-3a52-8364-611dc54157c9",
                    "sense_definition": "An electronic component, such as a transistor, that can control the flow of electricity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The circuit board contains a mix of passives and <w>actives</w>.",
                            "target_lang_translations": {
                                "ru": "Печатная плата содержит смесь пассивных и <w>активных элементов</w>.",
                                "pl": "Płytka drukowana zawiera mieszankę elementów pasywnych i <w>aktywnych</w>.",
                                "zh": "电路板上混合安装了无源元件和<w>有源元件</w>。"
                            }
                        },
                        {
                            "text": "Engineers tested the <w>actives</w> to ensure the signal was amplified correctly.",
                            "target_lang_translations": {
                                "ru": "Инженеры протестировали <w>активные компоненты</w>, чтобы убедиться в правильном усилении сигнала.",
                                "pl": "Inżynierowie przetestowali <w>elementy aktywne</w>, aby upewnić się, że sygnał jest prawidłowo wzmacniany.",
                                "zh": "工程师们测试了<w>有源元件</w>，以确保信号被正确放大。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "electronics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронный компонент, такой как транзистор, который может управлять потоком электричества.",
                        "pl": "Komponent elektroniczny, taki jak tranzystor, który może kontrolować przepływ prądu.",
                        "zh": "指能够控制电流流动的电子元件，如晶体管。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "активный элемент",
                                "target_lang_sense_clarification": "в электронике"
                            },
                            {
                                "target_lang_word": "активный компонент",
                                "target_lang_sense_clarification": "в электронике"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "element aktywny",
                                "target_lang_sense_clarification": "w elektronice"
                            },
                            {
                                "target_lang_word": "komponent aktywny",
                                "target_lang_sense_clarification": "w elektronice"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有源元件",
                                "target_lang_sense_clarification": "电子学专业术语"
                            }
                        ]
                    }
                }
            ]
        }
