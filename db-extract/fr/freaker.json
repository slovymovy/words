                "senses": [
                    {
                        "sense_id": "2737af36-27c5-3087-84a6-7cdd55384fe9",
                        "entry_id": "24c50a28-6ec8-3137-b499-079874390ebd",
                        "glosses": [
                            "Se sentir profondément bouleversé, voire paniquer, dans une situation ou devant une idée."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "13e91f23-b7de-4b44-b1ee-7a116c5a1ded",
                                "sense_id": "2737af36-27c5-3087-84a6-7cdd55384fe9",
                                "text": "« Il m’arrive de \"freaker\" tellement ça tourne vite. »"
                            },
                            {
                                "example_id": "6dadc3fd-b5f0-4c1a-be5d-d6d8d9760a8f",
                                "sense_id": "2737af36-27c5-3087-84a6-7cdd55384fe9",
                                "text": "La World War Web est commencé et en moins de 24 heures, on en sait maintenant assez pour freaker."
                            },
                            {
                                "example_id": "96a2b2f2-d165-4d72-8ad6-f58d54cf5658",
                                "sense_id": "2737af36-27c5-3087-84a6-7cdd55384fe9",
                                "text": "« Au début je freakais à l'idée d'être pensionnaire loin de mes amis de Montréal, mais en fin de compte, les Servites, c'était un peu un collège de mauvais garçons. Pendant trois ans, j'ai eu ben du fun. »"
                            }
                        ]
                    }
                ],
