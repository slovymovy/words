    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fc6f5fe3-28e2-39da-8711-95264f7723ee",
                    "sense_definition": "De manière conforme à la tradition ou aux coutumes transmises de génération en génération.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tradition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce gâteau est <w>traditionnellement</w> préparé pour célébrer le Nouvel An en famille."
                        },
                        {
                            "text": "Dans cette région, les mariés portent <w>traditionnellement</w> des costumes aux couleurs vives."
                        }
                    ],
                    "synonyms": [
                        "coutumièrement"
                    ],
                    "common_phrases": [
                        "préparé traditionnellement",
                        "servi traditionnellement"
                    ]
                },
                {
                    "sense_id": "ee66d080-56da-3018-9acb-26fe55667ef3",
                    "sense_definition": "Selon un usage constant ou une habitude établie de longue date.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "habitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette circonscription électorale vote <w>traditionnellement</w> pour les candidats de gauche."
                        },
                        {
                            "text": "Ces deux institutions sont <w>traditionnellement</w> rivales dans le domaine de la recherche."
                        }
                    ],
                    "synonyms": [
                        "habituellement",
                        "historiquement"
                    ],
                    "common_phrases": [
                        "traditionnellement opposé",
                        "traditionnellement associé"
                    ]
                }
            ]
        }
    ]
