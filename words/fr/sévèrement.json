                    "frequency": "High",
                    "semantic_group_id": "rigueur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a puni <w>sévèrement</w> les élèves qui ne respectaient pas le règlement."
                        },
                        {
                            "text": "Les critiques ont jugé très <w>sévèrement</w> le nouveau film de ce réalisateur réputé."
                        }
                    ],
                    "synonyms": [
                        "durement",
                        "rigoureusement",
                        "strictement"
                    ],
                    "antonyms": [
                        "indulgemment"
                    ],
                    "common_phrases": [
                        "punir sévèrement",
                        "juger sévèrement",
                        "réprimander sévèrement"
                    ]
                },
                {
                    "sense_id": "35a2cb6f-c1b5-3321-814e-068dec387a47",
                    "sense_definition": "D'une manière grave, sérieuse ou intense en parlant d'un dommage physique ou matériel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gravité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le motard a été <w>sévèrement</w> blessé lors d'une collision sur l'autoroute."
                        },
                        {
                            "text": "Toute la côte a été <w>sévèrement</w> touchée par les récentes inondations."
                        }
                    ],
                    "synonyms": [
                        "gravement",
                        "sérieusement"
                    ],
                    "antonyms": [
                        "légèrement"
                    ],
                    "common_phrases": [
