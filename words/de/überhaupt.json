                    ],
                    "common_phrases": [
                        "überhaupt noch"
                    ]
                },
                {
                    "sense_id": "4c017164-8b8f-37f9-b145-e894036b950f",
                    "sense_definition": "im Allgemeinen, ausnahmslos oder schlechthin, häufig zur Steigerung von Superlativen gebraucht",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "allgemein",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dieser Sommerurlaub in Italien war eine der schönsten Reisen <w>überhaupt</w>."
                        },
                        {
                            "text": "Das war das spannendste Fußballspiel, das ich <w>überhaupt</w> je im Stadion gesehen habe."
