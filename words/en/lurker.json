{
    "word_family": [
        "lurk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22181fab-d876-3127-b6b1-a241207b2115",
                    "sense_definition": "A user who observes an online community without contributing content or participating in discussions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "internet_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most members of the forum are <w>lurkers</w> who prefer reading to writing.",
                            "target_lang_translations": {
                                "zh": "论坛里的大多数成员都是只看不发的<w>潜水员</w>。"
                            }
                        },
                        {
                            "text": "The community manager encouraged <w>lurkers</w> to share their thoughts in the chat.",
                            "target_lang_translations": {
                                "zh": "社区管理员鼓励那些<w>潜水的用户</w>在聊天室里分享他们的想法。"
                            }
                        }
                    ],
                    "antonyms": [
                        "poster"
                    ],
                    "common_phrases": [
                        "online lurker"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在网络社区中只浏览内容而不参与讨论或发表言论的用户。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "潜水员",
                                "target_lang_sense_clarification": "网络用语，指长期潜水不发言的人。"
                            },
                            {
                                "target_lang_word": "潜水用户",
                                "target_lang_sense_clarification": "指只看不发的网络用户。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27e7f041-11bf-3a68-b20b-1287b7502d90",
                    "sense_definition": "A person who waits in a hidden place, often with suspicious or harmful intent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hidden_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard searched the dark alley for any potential <w>lurker</w>.",
                            "target_lang_translations": {
                                "zh": "保安在黑暗的巷子里搜寻是否有潜在的<w>潜伏者</w>。"
                            }
                        },
                        {
                            "text": "She felt uneasy knowing a <w>lurker</w> might be watching from the shadows.",
                            "target_lang_translations": {
                                "zh": "想到可能有个<w>潜伏者</w>正从阴影中窥视，她感到一阵不安。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指躲藏在暗处，通常带有可疑或恶意企图的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "潜伏者",
                                "target_lang_sense_clarification": "指隐藏在暗处的人。"
                            },
                            {
                                "target_lang_word": "暗中窥探者",
                                "target_lang_sense_clarification": "指躲在暗处观察的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d3e874e-e0c1-38bd-9512-267fe4fb5fcd",
                    "sense_definition": "A person who uses fake documents or false claims to deceive others for money.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deceiver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The street <w>lurker</w> tried to sell forged certificates to unsuspecting passersby.",
                            "target_lang_translations": {
                                "zh": "那个街头的<w>骗子</w>试图向毫无防备的行人兜售伪造的证书。"
                            }
                        },
                        {
                            "text": "Authorities warned citizens about the <w>lurker</w> operating in the city center.",
                            "target_lang_translations": {
                                "zh": "当局警告市民注意在市中心活动的<w>诈骗者</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical criminal slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指使用伪造文件或虚假声明欺骗他人以获取钱财的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "诈骗者",
                                "target_lang_sense_clarification": "指进行欺诈活动的人。"
                            },
                            {
                                "target_lang_word": "骗子",
                                "target_lang_sense_clarification": "指以欺骗手段谋取利益的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbe43063-3c7e-3d60-8040-affd474277dd",
                    "sense_definition": "A small boat used for fishing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman steered his small <w>lurker</w> toward the harbor.",
                            "target_lang_translations": {
                                "zh": "渔夫驾驶着他的<w>小渔船</w>驶向港口。"
                            }
                        },
                        {
                            "text": "They used a sturdy <w>lurker</w> to navigate the shallow coastal waters.",
                            "target_lang_translations": {
                                "zh": "他们用一艘坚固的<w>小渔船</w>在浅海区域航行。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in specific maritime contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于捕鱼的小型船只。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小渔船",
                                "target_lang_sense_clarification": "指用于捕鱼的小型船只。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}