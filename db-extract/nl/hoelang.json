                                                "example_id": "bb0b1f0f-f5bd-4236-8d3f-72db50d5f4f9",
                                                "sense_id": "15840920-28e7-3d24-9528-86c2262d9242",
                                                "text": "He won't tell me how long he is going to stay."
                                            },
                                            {
                                                "example_id": "b0bfa13c-39b1-4274-8440-6328e3823cc1",
                                                "sense_id": "15840920-28e7-3d24-9528-86c2262d9242",
                                                "text": "How long I slept I cannot tell, for I had nothing to guide me to the time, but woke at length, and found myself still in darkness."
                                            }
