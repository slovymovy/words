                ],
                "senses": [
                    {
                        "sense_id": "5c922d46-4055-3389-8cbc-411623e61ded",
                        "entry_id": "cd6c40d9-0818-3edf-906f-aaba54c0befe",
                        "glosses": [
                            "Person, die sich gegen das ausspricht, was im jeweiligen Kontext als Feminismus verstanden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ad77a65-cd18-443e-8ffc-d6ac6a911e74",
                                "sense_id": "5c922d46-4055-3389-8cbc-411623e61ded",
                                "text": "„Möchte der Antifeminist doch bei der Stange der Wahrheit bleiben, und sich hübsch der Gänsefüßchen bedienen, wenn er blödsinnige Lehren des Reformweibes geißelt.“"
                            },
                            {
                                "example_id": "4672479a-37aa-44c3-9ba3-8720dea5cb71",
                                "sense_id": "5c922d46-4055-3389-8cbc-411623e61ded",
                                "text": "„Damit war klargestellt: Wer behauptet, der Feminismus habe sich überlebt, weil die wesentlichen Ziele erreicht sind, ist ein Antifeminist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
