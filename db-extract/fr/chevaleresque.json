                    },
                    {
                        "translation_id": "4fccafe1-56da-4c68-a92b-d568ef5cf754",
                        "source_entry_id": "a2abea21-fc03-397d-99d4-4b89166a075a",
                        "source_sense_id": "f6eca8d4-9dc6-3c68-b46f-a68719192dfb",
                        "target_lang_word": "chivalrous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chivalrous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59c2a760-db68-33a0-9bcb-5619f8e29390",
                                        "entry_id": "f84136b3-3b60-39f1-b6bf-5e5978767f84",
                                        "glosses": [
                                            "Honourable, especially to women; gallant."
                                        ],
                                        "tags": [
                                            "of a man"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcc3ca70-9169-4a0f-af86-05410f64ba86",
                                                "sense_id": "59c2a760-db68-33a0-9bcb-5619f8e29390",
                                                "text": "Among boys there are laws of honour and chivalrous codes, not written, or formally taught, but intuitively understood by all, and invariably acted upon by the loyal and the true."
                                            },
                                            {
                                                "example_id": "46ded1f3-f329-4cac-8d96-f5fc8b94d08c",
                                                "sense_id": "59c2a760-db68-33a0-9bcb-5619f8e29390",
                                                "text": "“I would then never have known what minute, or by whom, I was to be attacked next. But the brutes are more chivalrous than man—they do not stoop to cowardly intrigue.”"
                                            },
                                            {
                                                "example_id": "cda06ddd-d7ae-42b8-836f-c46e47561993",
                                                "sense_id": "59c2a760-db68-33a0-9bcb-5619f8e29390",
                                                "text": "It amazed me that I could have allowed myself to be let in for a binge of this description simply because a woman wished it. Too bally chivalrous for our own good, we Woosters, and always have been."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "426e5a59-6c76-32a8-98ff-2d4d3d84cf1d",
                                        "entry_id": "f84136b3-3b60-39f1-b6bf-5e5978767f84",
                                        "glosses": [
                                            "Involving chivalry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
