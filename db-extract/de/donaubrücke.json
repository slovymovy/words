                "senses": [
                    {
                        "sense_id": "92f78520-fe64-388b-85a9-2542780f60f9",
                        "entry_id": "c75f80bd-4737-31e5-9dae-aacde383a3ac",
                        "glosses": [
                            "Brücke über den Fluss Donau"
                        ],
                        "tags": [
                            "Verkehrsinfrastruktur"
                        ],
                        "examples": [
                            {
                                "example_id": "62db8929-3f3c-4ba0-b7d6-ebb86b5b971d",
                                "sense_id": "92f78520-fe64-388b-85a9-2542780f60f9",
                                "text": "In Wien gibt es mehrere Donaubrücken."
                            },
                            {
                                "example_id": "e33d7117-d52c-49bb-ab4b-5c8c3585937e",
                                "sense_id": "92f78520-fe64-388b-85a9-2542780f60f9",
                                "text": "„Die Franzosen hatten, wie der Kundschafter meldete, die Wiener Donaubrücke überschritten und rückten jetzt in Eilmärschen auf Znaim zu, das an Kutusows Rückzugstrasse lag, und zwar etwas über hundert Werst vor ihm.“"
                            },
                            {
                                "example_id": "cf77562a-0008-43dc-998c-9dc1439f0d25",
                                "sense_id": "92f78520-fe64-388b-85a9-2542780f60f9",
                                "text": "„Das Ziel ist die Donaubrücke, kein Zweifel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
