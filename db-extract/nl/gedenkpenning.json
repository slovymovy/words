                "senses": [
                    {
                        "sense_id": "033f5a47-fc0d-3983-9080-e99ac53b48d5",
                        "entry_id": "e644003d-9ea0-3844-bf3b-fd9586332cff",
                        "glosses": [
                            "munt die is geslagen ter herdenking van een persoon of viering van een heugelijke gebeurtenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb397531-a231-41e4-98cd-8ee465039faf",
                                "sense_id": "033f5a47-fc0d-3983-9080-e99ac53b48d5",
                                "text": "Het was echt iets voor haar om gedenkpenningen te laten slaan met daarop de woorden „Venit, Vidit, Fugit\" die, als een woordspeling op de zinspreuk van Julius Caesar, voor eeuwig van de Spaanse armada vastlegden dat hij kwam, zag en vluchtte."
                            },
                            {
                                "example_id": "8553c6e0-4033-4623-989e-87fb85956d01",
                                "sense_id": "033f5a47-fc0d-3983-9080-e99ac53b48d5",
                                "text": "Het Vaticaan heeft de eerste euromunten met de beeltenis van paus Franciscus op de markt gebracht. De reeks van acht munten van één cent tot 2 euro kost 35 euro. Het Vaticaan heeft ook het zilveren 20 euro- en gouden 50 euro stuk heruitgegeven. Tevens is een zilveren gedenkpenning op de markt gebracht naar aanleiding van de heiligverklaring van de pausen Johannes Paulus II en paus Johannes XXIII op 27 april. Dat heeft Radio Vaticaan dinsdag gemeld."
                            }
                        ]
                    }
