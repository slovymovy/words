                        "entry_id": "a27806f5-bad3-31da-88ec-2b33087a6dfb",
                        "glosses": [
                            "Wahrnehmung von Geruch der von einem Öl stammt, von nachwachsenden Ölen oder fossilen Ölen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eb8eec7-a672-42de-92c5-0fadcf9b950e",
                                "sense_id": "1b1cbf42-df21-39b5-a469-f650888a6614",
                                "text": "„Die Lufthansa sucht seit Monaten nach einer Lösung für störenden Ölgeruch im A380.“"
                            },
                            {
                                "example_id": "d2ad6676-0cfc-4a78-a42e-a868e880a147",
                                "sense_id": "1b1cbf42-df21-39b5-a469-f650888a6614",
                                "text": "„Austretende Öltropfen sind aufzufangen und fachgerecht zu entsorgen, damit sie keinen Ölgeruch verursachen können.“"
                            }
                        ],
