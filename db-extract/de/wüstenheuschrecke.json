                    {
                        "sense_id": "1515ae2a-5234-3a43-81e2-dbc48c897806",
                        "entry_id": "32668ab4-dd68-3124-ab3f-991ac3afbd26",
                        "glosses": [
                            "Heuschrecke aus der Gattung Schistocerca innerhalb der Familie der Feldheuschrecken"
                        ],
                        "tags": [
                            "Acrididae"
                        ],
                        "examples": [
                            {
                                "example_id": "a48063a6-5ee6-416c-8060-2890ea04726d",
                                "sense_id": "1515ae2a-5234-3a43-81e2-dbc48c897806",
                                "text": "„Es fällt leicht, sich vorzustellen, wie Milliarden Wüstenheuschrecken als schwarze Wolke über ein grünes Land herfallen und eine Verwüstung biblischen Ausmasses hinterlassen“"
                            },
                            {
                                "example_id": "f3a63638-beed-4db5-afbb-eccb16ef3345",
                                "sense_id": "1515ae2a-5234-3a43-81e2-dbc48c897806",
                                "text": "„Die Wüstenheuschrecke Schistocerca gregaria hat verheerende gesellschaftliche und ökonomische Auswirkungen, da große Schwärme die Felder abfressen und so für Ernteausfälle sorgen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
