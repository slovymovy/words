                ],
                "senses": [
                    {
                        "sense_id": "b58e53e0-e8eb-3e8a-8eb7-42cdee6cf7d8",
                        "entry_id": "adab8a0a-faca-3fea-9687-b116f85b36fc",
                        "glosses": [
                            "Médiatiser à l’extrême, porter un évènement à l’attention des autres de façon excessive ou sans cesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74824c25-8c23-4207-afd0-6fc27e509dc3",
                                "sense_id": "b58e53e0-e8eb-3e8a-8eb7-42cdee6cf7d8",
                                "text": "Hypermédiatiser des résultats scientifiques qui n’en sont pas c'est dommageable."
                            },
                            {
                                "example_id": "5b2f2259-7f9b-4707-81f7-a4daef27e9d7",
                                "sense_id": "b58e53e0-e8eb-3e8a-8eb7-42cdee6cf7d8",
                                "text": "Il n’a pas pu s’empêcher de la médiatiser, ou plus exactement de l’hypermédiatiser."
                            }
                        ]
                    }
                ],
