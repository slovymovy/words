                        "glosses": [
                            "Enlever (ce qui avait été avitaillé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f43d5675-7542-4575-92ea-569982c0675d",
                                "sense_id": "c04bf3fb-ef1f-3c27-8afa-f4200715ab8a",
                                "text": "En 1782, on le voit alors simple garde du pavillon, affronter les feux du canon ennemi pour porter un cable destiné à remorquer le Glorieux, désavitaillé dans le combat livré aux Anglais, le 13 avril, sous les ordres de M. de Grasse ; on lui dût la conservation de ce vaisseau ; l’autre représente un trait de courage encore plus rare."
                            },
                            {
                                "example_id": "92a9f042-07eb-4674-b159-a5fa11a77b0d",
                                "sense_id": "c04bf3fb-ef1f-3c27-8afa-f4200715ab8a",
                                "text": "Avitailler et Désavitailler les avions"
                            }
                        ]
                    }
