                        "glosses": [
                            "Not pregnant."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bff400c5-3219-486a-b5f7-7f6ecd52597d",
                                "sense_id": "ed96985b-b1a9-39c4-8437-f019de696695",
                                "text": "Again, a wife, unpregnant, and when she rightfully wishes to remain so, may be somewhat fearful of becoming pregnant when she meets her husband, and so hesitate to give her passion full play, thereby missing the utmost delights of an embrace--but if she be pregnant, and so has no fear on this score, she can give herself up to utter abandonment to her impulses."
                            },
                            {
                                "example_id": "57b37c61-66de-4f1c-baa4-ae2ad7dd84df",
                                "sense_id": "ed96985b-b1a9-39c4-8437-f019de696695",
                                "text": "The most offensive portrayal is John O'Meara's tortured Leontes: he milks every line with an unpregnant pause."
                            },
                            {
                                "example_id": "9d2d87a4-96f9-484e-8104-8753656f9e60",
                                "sense_id": "ed96985b-b1a9-39c4-8437-f019de696695",
                                "text": "I've read that people in their 30s only talk about babies and real estate, but since my friends and I are all broke and unpregnant, all we have is the naked fact of aging, stripped of the signifiers of responsibility."
                            }
                        ]
                    }
