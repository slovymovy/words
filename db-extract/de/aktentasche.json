                    {
                        "translation_id": "8d085ac9-f379-4941-b26d-cd38e833e0d4",
                        "source_entry_id": "7d46d79a-1d16-30b2-9904-2c71140e1028",
                        "source_sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                        "source_sense_description": "Tasche für den Transport von Akten, Büchern und sonstigen Büromaterialien",
                        "target_lang_word": "serviette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serviette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fcbbabe-00cb-385a-a40c-6e6c3c4eb3cc",
                                        "entry_id": "8658df0e-acf2-3011-b8e2-e5b795767480",
                                        "glosses": [
                                            "Pièce de linge individuelle destiné à s’essuyer ou à éviter de se salir pendant un repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d168fc6-edc3-4eb0-b435-7ea3c3563bb0",
                                                "sense_id": "6fcbbabe-00cb-385a-a40c-6e6c3c4eb3cc",
                                                "text": "Aucun lieutenant un peu soucieux de sa tenue ne s'abaisserait à manger sans serviette!"
                                            },
                                            {
                                                "example_id": "400e7f61-b895-42a1-ad43-ad0511b26a2d",
                                                "sense_id": "6fcbbabe-00cb-385a-a40c-6e6c3c4eb3cc",
                                                "text": "Sur chaque assiette, une serviette brodée présentée en forme de chapeau de Colombine."
                                            },
                                            {
                                                "example_id": "9bbb6f29-c7e7-4d30-a4a8-9e322d6c90d1",
                                                "sense_id": "6fcbbabe-00cb-385a-a40c-6e6c3c4eb3cc",
                                                "text": "Georges, essuie ta bouche avec ta serviette !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4767ce86-4b01-3ad9-b58b-75330402e1aa",
                                        "entry_id": "8658df0e-acf2-3011-b8e2-e5b795767480",
                                        "glosses": [
                                            "Pièce de tissu rectangulaire destiné à s’essuyer la peau après la toilette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e397f00e-6a22-4973-838a-cac1185820b5",
                                                "sense_id": "4767ce86-4b01-3ad9-b58b-75330402e1aa",
                                                "text": "Tout en enveloppant la petite dans une serviette, Marnie éprouva une bouffée d’amour en contemplant son minois auréolé de boucles dorées."
                                            },
                                            {
                                                "example_id": "78c34f8c-3af7-4c97-afa8-93239db6674b",
                                                "sense_id": "4767ce86-4b01-3ad9-b58b-75330402e1aa",
                                                "text": "Soudain, la porte s'ouvre derrière moi, laissant apparaître Jordan vêtu d'une petite serviette de bain. Tim et Sonny ouvrent des yeux gros comme des billes.\n OK, véritable moment de « gênance » extrême."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "694c6382-1df7-3bb5-bb5b-28a0a69a6753",
                                        "entry_id": "8658df0e-acf2-3011-b8e2-e5b795767480",
                                        "glosses": [
                                            "Petite bande de tissu destinée à absorber le sang des règles."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbd095eb-c6e9-48b7-8302-029bf9a28d20",
                                                "sense_id": "694c6382-1df7-3bb5-bb5b-28a0a69a6753",
                                                "text": "Une serviette hygiénique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9843693d-e59a-3754-a079-6d62153345ad",
                                        "entry_id": "8658df0e-acf2-3011-b8e2-e5b795767480",
                                        "glosses": [
                                            "Sacoche ou grand portefeuille servant à transporter des documents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ee1238f-5785-43d8-9ba1-4165ce6efe1b",
                                                "sense_id": "9843693d-e59a-3754-a079-6d62153345ad",
                                                "text": "Il s’rend aux endroits en question et passe la loge d’la cloporte, une serviette sous le bras. « Eh bien ! crie la pip’lette, où qu’vous aller ? » — (Francis Carco, Messieurs les vrais de vrai, Les Éditions de France, Paris, 1927)"
                                            },
                                            {
                                                "example_id": "98430a12-265d-4317-938e-a16f1fda5d63",
                                                "sense_id": "9843693d-e59a-3754-a079-6d62153345ad",
                                                "text": "Un monsieur, courant, une serviette sous le bras, le heurta sans ménagements et l’arracha à son hébétude."
                                            }
                                        ]
                                    }
                                ]
                            },
