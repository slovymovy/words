                "senses": [
                    {
                        "sense_id": "c84a18b1-08fe-3f31-ab46-22e3800e55e5",
                        "entry_id": "f7965f32-8ecd-3a4e-a413-a075182db88f",
                        "glosses": [
                            "Autre orthographe de reboursicoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73016d1e-1e35-4542-b953-009b7b45d26a",
                                "sense_id": "c84a18b1-08fe-3f31-ab46-22e3800e55e5",
                                "text": "Ces dernières années, je re-boursicote avec plus ou moins de réussite, je suis encore en PV, mais je me suis ramassé de plein fouet, en toute immobilité (ca c'est grave, mais j'étais trop occupé), le krach de 2000 et celui de 2007 que j'ai mieux géré."
                            },
                            {
                                "example_id": "803721d6-648c-4f56-97d1-9011af09151e",
                                "sense_id": "c84a18b1-08fe-3f31-ab46-22e3800e55e5",
                                "text": "Maintenant les caisses ont reconstitué des millions de réserve grâce à notre argent, et ils re-boursicotent sûrement, pour payer les mercedes des managers et de nouveaux immeubles de luxe."
                            }
                        ]
                    }
