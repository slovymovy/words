                    {
                        "translation_id": "443fbae0-7380-409e-901a-d3993770136f",
                        "source_entry_id": "6d50a377-15b9-35ba-ad07-40af06c283a1",
                        "source_sense_id": "7ca2eef3-34c2-38e2-86eb-1dfc8c28c3a9",
                        "source_sense_description": "gecastreerde hengst",
                        "target_lang_word": "hongre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hongre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce4d20ce-2c04-32f5-9c08-55cd396e5150",
                                        "entry_id": "e5239b92-d3f7-3a60-a8a9-735576561d96",
                                        "glosses": [
                                            "Qui a été châtré, en parlant du cheval et par extension d’autres animaux comme l’âne."
                                        ],
                                        "tags": [
                                            "Hippologie",
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73393552-9fd0-40d6-9115-071e33ecc904",
                                                "sense_id": "ce4d20ce-2c04-32f5-9c08-55cd396e5150",
                                                "text": "J’étais en visite chez l’une d’elles, nous causions de chevaux et je feignis d’ignorer la différence entre l’étalon et le cheval hongre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hongre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54c87cb1-6f13-34fd-a9da-e6630c20ebe6",
                                        "entry_id": "97506324-5ea4-3ae8-ab59-844b936f2845",
                                        "glosses": [
                                            "Cheval castré."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dddf7499-b14a-4a03-ae70-9c4a91d6561e",
                                                "sense_id": "54c87cb1-6f13-34fd-a9da-e6630c20ebe6",
                                                "text": "Voilà le trophée de mon épée, ce brave hongre gris, que je serais bien content de revoir sur ses jambes, …."
                                            },
                                            {
                                                "example_id": "b1e77aa9-4ff8-43fe-8a00-9502fa90ae16",
                                                "sense_id": "54c87cb1-6f13-34fd-a9da-e6630c20ebe6",
                                                "text": "En somme, d’Aurevilly apparaissait, ainsi qu’un étalon, parmi ces hongres qui peuplent les écuries ultramontaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60bc07e8-d1e9-3a31-8f88-11e12961c711",
                                        "entry_id": "97506324-5ea4-3ae8-ab59-844b936f2845",
                                        "glosses": [
                                            "Homme castré."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32858fcf-d44b-4c2c-8c54-643023b7fdf1",
                                                "sense_id": "60bc07e8-d1e9-3a31-8f88-11e12961c711",
                                                "text": "Ce sont des êtres de la grande espèce neutre ; hongres, parasites, nuls, qui ont un peu de terre, un peu de sottise et un peu d’esprit."
                                            },
                                            {
                                                "example_id": "ce4da91e-a6b2-4e1a-854b-ea71a65da725",
                                                "sense_id": "60bc07e8-d1e9-3a31-8f88-11e12961c711",
                                                "text": "Le pays des terribles Cadets de Gascogne, le pays de madrés, des malins, des finauds, des habiles, […], ce pays là ne serait plus qu’un pays de hongres, voué à la décadence et à la destruction ?"
                                            }
                                        ]
                                    }
                                ]
                            },
