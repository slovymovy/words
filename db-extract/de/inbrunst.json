                        "entry_id": "bf1d6401-3f29-3d58-a031-d97e76183d8d",
                        "glosses": [
                            "starke Hingabe an ein Gefühl oder an ein Vorhaben"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "42341966-cdf7-4687-ba23-7fca6b8dcdfc",
                                "sense_id": "36aa0880-ea1b-3c84-8581-f3c022b1cbc6",
                                "text": "Mit Inbrunst umfing sie den so lange verloren Geglaubten."
                            },
                            {
                                "example_id": "e4da471d-ed77-4c89-aa01-136e9b945c44",
                                "sense_id": "36aa0880-ea1b-3c84-8581-f3c022b1cbc6",
                                "text": "Die Inbrunst seiner Sammelwut war schon bemerkenswert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c26e8788-46b6-4cfe-b7ab-8e5f6b38758e",
                        "source_entry_id": "bf1d6401-3f29-3d58-a031-d97e76183d8d",
                        "source_sense_id": "36aa0880-ea1b-3c84-8581-f3c022b1cbc6",
                        "source_sense_description": "gehoben: starke Hingabe an ein Gefühl oder an ein Vorhaben",
                        "target_lang_word": "ardour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ardour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "964695b5-facc-30cd-9d2f-b1e95f67f4b5",
                                        "entry_id": "32fa6d23-38db-37e5-8789-12dbded915d8",
                                        "glosses": [
                                            "British, Canada, and Australia spelling of ardor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33ceddc5-61db-4977-93ee-5743df95f79e",
                                                "sense_id": "964695b5-facc-30cd-9d2f-b1e95f67f4b5",
                                                "text": "I rushed towards her, and embraced her with ardour; but the deathly languor and coldness of the limbs told me, that what I now held in my arms had ceased to be the Elizabeth whom I had loved and cherished."
                                            },
                                            {
                                                "example_id": "f6b5d6af-9ca1-46ad-8739-f13dac82871d",
                                                "sense_id": "964695b5-facc-30cd-9d2f-b1e95f67f4b5",
                                                "text": "The purpose of my visit, and the frightful abnormalities it postulated struck at me all at once with a chill sensation that nearly over-balanced my ardour for strange delvings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef70ceaf-fc7d-4ae8-814e-d3cc7125425a",
                        "source_entry_id": "bf1d6401-3f29-3d58-a031-d97e76183d8d",
                        "source_sense_id": "36aa0880-ea1b-3c84-8581-f3c022b1cbc6",
                        "source_sense_description": "gehoben: starke Hingabe an ein Gefühl oder an ein Vorhaben",
                        "target_lang_word": "fervour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fervour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c5ff01c-4b5c-36f6-9053-3307790d0625",
                                        "entry_id": "9282a1af-e9df-3470-a3c8-73776c4005ee",
                                        "glosses": [
                                            "Commonwealth and Ireland standard spelling of fervor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08c2ac9-6ec0-44e7-a29d-65fed09583dc",
                                                "sense_id": "6c5ff01c-4b5c-36f6-9053-3307790d0625",
                                                "text": "The early Americans, inheriting the Hebraist fervour of the English Puritans, had enjoyed a Great Awakening of religious joy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abb92c39-429d-41c2-81d7-e30c74699889",
                        "source_entry_id": "bf1d6401-3f29-3d58-a031-d97e76183d8d",
                        "source_sense_id": "36aa0880-ea1b-3c84-8581-f3c022b1cbc6",
                        "source_sense_description": "gehoben: starke Hingabe an ein Gefühl oder an ein Vorhaben",
                        "target_lang_word": "ferveur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ferveur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f69ba38-5cfb-353a-aa81-fa7305d2842c",
                                        "entry_id": "39f691df-77f7-3a39-a06a-2027341d2154",
                                        "glosses": [
                                            "Ardeur, zèle, sentiment vif et affectueux avec lequel on se porte aux choses de piété, de charité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2ade5af-d2e2-4fc9-8fbb-9c44f3713f28",
                                                "sense_id": "4f69ba38-5cfb-353a-aa81-fa7305d2842c",
                                                "text": "J’implorai avec ferveur la belle image de la Vierge coloriée à laquelle, tous les soirs, avant de me coucher, j’adressais ma prière […]"
                                            },
                                            {
                                                "example_id": "de9b1912-2d11-4cff-beeb-3f73a1aa2171",
                                                "sense_id": "4f69ba38-5cfb-353a-aa81-fa7305d2842c",
                                                "text": "C’est cela qu’évoque le journaliste américain Garry Will lorsqu’il pose la question : « Un peuple qui croit avec plus de ferveur en la conception virginale du Christ qu’en l’évolution des espèces peut-il être encore qualifié de nation éclairée ?."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c650e84-dc00-3308-bf25-3971259ee5f4",
                                        "entry_id": "39f691df-77f7-3a39-a06a-2027341d2154",
                                        "glosses": [
                                            "Mode littéraire, philosophique, artistique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ba374c1-f552-48bf-90e0-70cf97604d49",
                                                "sense_id": "6c650e84-dc00-3308-bf25-3971259ee5f4",
                                                "text": "On était dans la ferveur du Romantisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
