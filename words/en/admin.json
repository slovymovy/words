{
    "word_family": [
        "administration",
        "administrator",
        "administrative",
        "administrate",
        "administer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eecfcaae-285c-3ba8-a20f-6997b6f17ed8",
                    "sense_definition": "The tasks and activities involved in managing an organization or business; <w>administration</w> work.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a lot of <w>admin</w> involved in the birth of a child.",
                            "target_lang_translations": {
                                "ru": "Рождение ребенка сопряжено с большим количеством <w>бумажной работы</w>."
                            }
                        },
                        {
                            "text": "She spends most of her morning doing <w>admin</w> tasks like filing and answering emails.",
                            "target_lang_translations": {
                                "ru": "Большую часть утра она тратит на <w>административные задачи</w>, такие как подшивка документов и ответы на электронные письма."
                            }
                        }
                    ],
                    "synonyms": [
                        "red tape"
                    ],
                    "common_phrases": [
                        "do the admin",
                        "heavy admin load",
                        "admin tasks"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened form of administration"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Задачи и действия, связанные с управлением организацией или бизнесом; административная работа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "администрирование",
                                "target_lang_sense_clarification": "процесс управления"
                            },
                            {
                                "target_lang_word": "административная работа",
                                "target_lang_sense_clarification": "офисные задачи"
                            },
                            {
                                "target_lang_word": "бумажная работа",
                                "target_lang_sense_clarification": "рутинные задачи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e55f95e-3bfe-36ce-a814-b12735290502",
                    "sense_definition": "A person who manages a website, forum, or social media group and has the power to control users.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>admin</w> changed the forum settings to enable the use of emoticons.",
                            "target_lang_translations": {
                                "ru": "<w>Админ</w> изменил настройки форума, чтобы разрешить использование смайликов."
                            }
                        },
                        {
                            "text": "If you have trouble logging in, you should contact the group <w>admin</w> for help.",
                            "target_lang_translations": {
                                "ru": "Если у вас возникли проблемы со входом, вам следует обратиться за помощью к <w>администратору</w> группы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "group admin",
                        "contact the admin",
                        "forum admin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in digital contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который управляет веб-сайтом, форумом или группой в социальных сетях и имеет право контролировать пользователей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "админ",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            },
                            {
                                "target_lang_word": "администратор",
                                "target_lang_sense_clarification": "официальное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2105da6-1072-3759-be77-04843f2058d3",
                    "sense_definition": "A professional responsible for maintaining and operating a computer system or network; a systems <w>administrator</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our <w>admin</w> has upgraded the server in our office, so we can exchange files faster.",
                            "target_lang_translations": {
                                "ru": "Наш <w>сисадмин</w> обновил сервер в офисе, так что теперь мы можем обмениваться файлами быстрее."
                            }
                        },
                        {
                            "text": "The network <w>admin</w> reset my password after I was locked out of the system.",
                            "target_lang_translations": {
                                "ru": "Сетевой <w>администратор</w> сбросил мой пароль после того, как я был заблокирован в системе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "network admin",
                        "system admin",
                        "server admin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специалист, ответственный за обслуживание и эксплуатацию компьютерной системы или сети; системный администратор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сисадмин",
                                "target_lang_sense_clarification": "компьютерный жаргон"
                            },
                            {
                                "target_lang_word": "системный администратор",
                                "target_lang_sense_clarification": "полное название должности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d81ec31-41ee-3760-ab5b-25360bd270fb",
                    "sense_definition": "The group of people who manage or direct an organization, company, or government body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school <w>admin</w> decided to cancel the event due to the bad weather.",
                            "target_lang_translations": {
                                "ru": "<w>Администрация</w> школы решила отменить мероприятие из-за плохой погоды."
                            }
                        },
                        {
                            "text": "Barren dirt plots behind knee-high metal fences indicated <w>admin</w> must have cut the flower budget.",
                            "target_lang_translations": {
                                "ru": "Пустые участки земли за металлическими заборами по колено указывали на то, что <w>руководство</w>, должно быть, урезало бюджет на цветы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "school admin",
                        "hospital admin",
                        "the admin office"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, которые управляют или руководят организацией, компанией или государственным органом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "администрация",
                                "target_lang_sense_clarification": "руководящий орган"
                            },
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "начальство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab8bff0a-824d-326d-abae-8a4b7de1a466",
                    "sense_definition": "To perform the duties of an <w>administrator</w> for a system, group, or organization.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spends his weekends <w>admining</w> a large online gaming community.",
                            "target_lang_translations": {
                                "ru": "По выходным он <w>админит</w> большое игровое онлайн-сообщество."
                            }
                        },
                        {
                            "text": "It is difficult to <w>admin</w> a server when you have so many other responsibilities.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>администрировать</w> сервер, когда у тебя так много других обязанностей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "admin a group",
                        "admin a server"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage of the noun as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять обязанности администратора системы, группы или организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "админить",
                                "target_lang_sense_clarification": "сленг, управлять ресурсом"
                            },
                            {
                                "target_lang_word": "администрировать",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}