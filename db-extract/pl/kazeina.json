                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e3884c-c498-473b-999f-2b585c0642c3",
                                "sense_id": "1d89d4fb-6e39-38eb-b6b2-ea0b73e4248d",
                                "text": "W cząsteczkach białek nabiału i zboża – kazeinie i glutenie znajdują się egzorfiny – podobnie działające jak morfina – alkaloid należący do opiatów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ff9b102-5428-4a78-be5e-0c8b5928fef2",
                        "source_entry_id": "569080a9-9086-3181-913b-1672517e8937",
                        "source_sense_id": "1d89d4fb-6e39-38eb-b6b2-ea0b73e4248d",
                        "target_lang_word": "casein",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casein",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62136fdb-590d-3a61-92d9-b3ea15a109b2",
                                        "entry_id": "d85960f0-4148-3b67-85c1-4d65a3a098f9",
                                        "glosses": [
                                            "A protein present in both milk and in the seeds of leguminous plants"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6284fd9-4ea2-47ea-923b-e768df9a7bac",
                                                "sense_id": "62136fdb-590d-3a61-92d9-b3ea15a109b2",
                                                "text": "It’s the clumping nature of the caseins that makes possible most thickened milk products, from yogurt to cheese. The whey proteins play a more minor role; they influence the texture of casein curds, and stabilize the milk foams on specialty coffees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85cbc3d2-7503-4990-8957-47d2792806fc",
                        "source_entry_id": "569080a9-9086-3181-913b-1672517e8937",
                        "source_sense_id": "1d89d4fb-6e39-38eb-b6b2-ea0b73e4248d",
