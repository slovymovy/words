                "senses": [
                    {
                        "sense_id": "74d368aa-1ad4-305c-9c5c-d8ae7475b8ec",
                        "entry_id": "5c5d4549-505a-33e5-8cb4-01fc049b5bce",
                        "glosses": [
                            "Konto, das sich außerhalb des Landes befindet, in dem der Kontoinhaber seinen Wohnsitz hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f147f449-b073-4fe1-8540-d986025fdb1a",
                                "sense_id": "74d368aa-1ad4-305c-9c5c-d8ae7475b8ec",
                                "text": "„Zoya sagte: ›Du hast recht. Ich habe Cassidys Klientenliste. Onkel Wladi steht drauf, und einige ziemlich üble Gestalten. Mit Informationen zu Offshore-Konten, auf die eine Menge Geld fließt.‹“"
                            },
                            {
                                "example_id": "260877ae-db78-4b27-be04-dca17f1ef514",
                                "sense_id": "74d368aa-1ad4-305c-9c5c-d8ae7475b8ec",
                                "text": "„Sie lassen Geld auf Offshore-Konten und in Schweizer Tresoren verschwinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
