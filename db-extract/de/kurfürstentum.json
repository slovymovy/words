                        "form_id": "1540967d-c096-4a5b-87e8-01ef6bfddbcb",
                        "entry_id": "275df388-ee1d-3306-a53e-85334c0a504d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kurfürstentümer"
