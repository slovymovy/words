                    {
                        "form_id": "0cd5507f-2385-4659-a422-1f91287d8ef8",
                        "entry_id": "99e54dab-2bcf-368e-a218-ba55d735693e",
                        "tags": [
                            "singular"
                        ],
                        "form": "asiels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "60a220e0-b787-32d4-926b-f5a5e03079a4",
                        "entry_id": "99e54dab-2bcf-368e-a218-ba55d735693e",
                        "glosses": [
                            "een verblijf voor verstoten of weggelopen honden, katten en andere huisdieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2176660d-c790-41e9-89a4-1a49e372d9ee",
                                "sense_id": "60a220e0-b787-32d4-926b-f5a5e03079a4",
                                "text": "Vooral tijdens de zomervakantie zitten de asiels weer erg vol."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0906be4-2ada-3a1f-b0a3-0e64b253836a",
                        "entry_id": "99e54dab-2bcf-368e-a218-ba55d735693e",
                        "glosses": [
                            "een status verleend door de ene staat aan een staatsburger van een andere staat, waar deze meestal om politieke redenen in levensbedreigende moeilijkheden gekomen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d241a7bb-e85e-4391-a000-ef0206c53d7c",
                                "sense_id": "d0906be4-2ada-3a1f-b0a3-0e64b253836a",
                                "text": "Staten zijn verplicht asiel te verlenen aan mensen die daarvoor in aanmerking komen."
                            },
                            {
                                "example_id": "d19e63b6-3708-4ffc-9bd7-49985c9ad06c",
                                "sense_id": "d0906be4-2ada-3a1f-b0a3-0e64b253836a",
                                "text": "De universiteit Aix-Marseille zegt al zo'n 300 aanvragen binnen te hebben voor wat wordt genoemd \"wetenschappelijk asiel\". Ook onderzoekers van prestigieuze instellingen als Yale en Stanford willen komen. De eersten zullen in juni aan het werk gaan aan de Zuid-Franse universiteit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b042b88b-7f8f-42bc-bee1-05510b12d710",
                        "source_entry_id": "99e54dab-2bcf-368e-a218-ba55d735693e",
                        "target_lang_word": "asylum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asylum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "847f123e-03e8-312f-8878-a3c4436f4ecb",
                                        "entry_id": "a305720b-ea68-32be-88b0-8afc09a14dab",
                                        "glosses": [
                                            "A place of safety or refuge."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4719fa5-9b5c-43ce-8f23-883d24491da8",
                                                "sense_id": "847f123e-03e8-312f-8878-a3c4436f4ecb",
                                                "text": "All the busy concerns of daily existence were utterly abhorrent to me. I loathed the sound of others' voices—I hated to be mixed up with their petty routine of ordinary cares; here was an asylum offered to me—here I might lay down all the offices of humanity, and dwell beside that grave whose rest was now my only desire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ef75426-6752-3199-bae0-410d11f2e52f",
                                        "entry_id": "a305720b-ea68-32be-88b0-8afc09a14dab",
                                        "glosses": [
                                            "The protection, physical and legal, afforded by such a place (as, for example, for political refugees)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37577d8d-8048-3840-9dd8-fe8bf6c0c5ab",
                                        "entry_id": "a305720b-ea68-32be-88b0-8afc09a14dab",
                                        "glosses": [
                                            "A place of protection or restraint for one or more classes of the disadvantaged, especially the mentally ill."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f84f9109-ee12-4cda-b57c-89f70e56ff37",
                                                "sense_id": "37577d8d-8048-3840-9dd8-fe8bf6c0c5ab",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "979975ca-b207-4274-bf72-51952be722a3",
