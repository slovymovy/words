                    }
                ],
                "senses": [
                    {
                        "sense_id": "01358d5c-6740-3da9-8fd1-ba6c169af37e",
                        "entry_id": "4ebc8e1d-f1cb-352a-8d40-d9cce1eb6468",
                        "glosses": [
                            "Action d’aleviner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ac0a88e-b014-4e3a-8d04-dfc9da4bd526",
                                "sense_id": "01358d5c-6740-3da9-8fd1-ba6c169af37e",
                                "text": "L’expérience a démontré que l’alevinage des sandres sous forme d’œufs ne donnait qu’un rendement médiocre."
                            },
                            {
                                "example_id": "87903bec-9dcd-4a7f-89e8-fe3a902b2261",
                                "sense_id": "01358d5c-6740-3da9-8fd1-ba6c169af37e",
                                "text": "Parmi les exemples d'aires d’alevinage du flétan de l’Atlantique, on cite les îles Féroé (Tâning 1936), la baie de Faxa sur la côte ouest de l’Islande (Sigurdsson 1956) et, peut-être, le voisinage de la vallée de l'île de Sable au large de la Nouvelle-Écosse (Stobo et coll. 1988)."
                            },
                            {
                                "example_id": "345296d1-bfc0-4005-9f55-a5186faccdb1",
                                "sense_id": "01358d5c-6740-3da9-8fd1-ba6c169af37e",
                                "text": "Les champs d'algues et les zones intertidales contribuent à la qualité de l'eau, facilitent la décomposition des matières organiques et constituent des sites de frai et d’alevinage."
                            }
                        ]
                    }
                ],
