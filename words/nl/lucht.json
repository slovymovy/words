        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4f4fd20-e2bf-37ea-99aa-b0e51ef36b25",
                    "sense_definition": "Vervoeging van <w>luchten</w>: eerste persoon enkelvoud tegenwoordige tijd.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>lucht</w> mijn slaapkamer elke ochtend minstens tien minuten.",
                            "target_lang_translations": {
                                "en": "I <w>air</w> my bedroom for at least ten minutes every morning.",
                                "ru": "Я <w>проветриваю</w> свою спальню каждое утро не менее десяти минут.",
                                "pl": "Każdego ranka <w>wietrzę</w> swoją sypialnię przez co najmniej dziesięć minut.",
                                "de": "Ich <w>lüfte</w> mein Schlafzimmer jeden Morgen mindestens zehn Minuten.",
                                "fr": "J'<w>aère</w> ma chambre tous les matins pendant au moins dix minutes.",
                                "it": "<w>Arieggio</w> la mia camera da letto ogni mattina per almeno dieci minuti.",
                                "cs": "Každé ráno <w>větrám</w> ložnici alespoň deset minut.",
                                "tr": "Her sabah yatak odamı en az on dakika <w>havalandırırım</w>.",
                                "es": "<w>Ventilo</w> mi dormitorio todas las mañanas durante al menos diez minutos."
                            }
                        },
                        {
                            "text": "Soms <w>lucht</w> ik mijn hart bij een goede vriend als ik problemen heb.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>pour out</w> my heart to a good friend when I have problems.",
                                "ru": "Иногда я <w>изливаю</w> душу хорошему другу, когда у меня проблемы.",
