                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db568b7c-eaf0-4460-9ab9-aed655d9189f",
                                                "sense_id": "fc368737-6289-3db9-b91b-a5be9c9bfca4",
                                                "text": "Saskia hat die ganze Torte verputzt."
                                            },
                                            {
                                                "example_id": "449af462-e23f-4f80-86d5-642f86088ce1",
                                                "sense_id": "fc368737-6289-3db9-b91b-a5be9c9bfca4",
                                                "text": "„Der unersättliche Malteser verputzte täglich eine mächtige Schüssel Nüsse, welche er leichthin mit den Fingern knackte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3d9efaf8-6558-300e-92f9-fcd4604bdb85",
                                        "entry_id": "7af2678e-f858-3c43-b6ee-6cd34bc4b436",
                                        "glosses": [
                                            "etwas verprassen, verschwenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f775c2-8f50-4e79-b2ba-938fda9d3303",
                                                "sense_id": "3d9efaf8-6558-300e-92f9-fcd4604bdb85",
                                                "text": "Er hat seinen Lottogewinn in kürzester Zeit verputzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4e327fe2-e47d-325a-bfad-f8086e3ae833",
                                        "entry_id": "7af2678e-f858-3c43-b6ee-6cd34bc4b436",
                                        "glosses": [
                                            "etwas verwinden, ausstehen können, etwas als annehmbar empfinden"
