                    {
                        "sense_id": "1e7e6a1c-fff3-34dd-9da8-603e5d0dd78a",
                        "entry_id": "9fdc13c9-35d6-30b6-835a-4c8bdef14d01",
                        "glosses": [
                            "een handwerktuig voor het verplaatsen van bladeren, gras of gewied materiaal in de vorm van een grote vork met smalle tanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d874087f-6f8f-449d-9bcf-e1352cd9615a",
                                "sense_id": "1e7e6a1c-fff3-34dd-9da8-603e5d0dd78a",
                                "text": "Geef de riek eens aan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3e77e8f-2740-442e-9359-24129c6ad660",
                        "source_entry_id": "9fdc13c9-35d6-30b6-835a-4c8bdef14d01",
                        "source_sense_id": "1e7e6a1c-fff3-34dd-9da8-603e5d0dd78a",
                        "source_sense_description": "een handwerktuig voor het verplaatsen van bladeren, gras of gewied materiaal in de vorm van een grote vork met smalle tanden",
                        "target_lang_word": "pitchfork",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pitchfork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "669e74b1-09e0-3e68-a5be-7ddc25bf0e6e",
                                        "entry_id": "250a89e5-4ce7-3002-a5d8-742fe48848f4",
                                        "glosses": [
                                            "An agricultural tool comprising a fork with sparse, light tines, attached to a long handle, used for pitching hay (especially loose hay) high up onto a stack (as on a wagon or haystack, or into a haymow)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dc54f89-7f01-3b8f-af75-cc6bb492bfdc",
                                        "entry_id": "250a89e5-4ce7-3002-a5d8-742fe48848f4",
                                        "glosses": [
                                            "A similar fork with slightly more and heavier tines, used for mucking stalls and pitching soiled bedding into a wagon or manure spreader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e349f72-bc2f-4811-9840-52f398d26462",
                                                "sense_id": "7dc54f89-7f01-3b8f-af75-cc6bb492bfdc",
                                                "text": "After my second illness, being too old for “piggy-back rides”, I generally sat in 'Resting Nuke' on a seat naturally formed in a low branch of a cedar, watching relatives down in the bay with pitchforks furiously digging out long black slithery \"cockworms\" from the muddy sands of Sinky Bay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4af938f4-0c3b-38d1-a72a-8267b414e70b",
                                        "entry_id": "250a89e5-4ce7-3002-a5d8-742fe48848f4",
                                        "glosses": [
                                            "Any fork used for farm labor, even a digging fork (but such usage is often considered ignorant by experienced farmers)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "690b8f3f-e46a-3b8b-8b7e-42e4ecd4f2a6",
                                        "entry_id": "250a89e5-4ce7-3002-a5d8-742fe48848f4",
                                        "glosses": [
                                            "A tuning fork."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de55f4a3-14ca-46e0-8143-d2db29b8eb3e",
                                                "sense_id": "690b8f3f-e46a-3b8b-8b7e-42e4ecd4f2a6",
                                                "text": "I went around with a pitchfork [tuning fork] in my pocket, and I'd hit it whenever I thought of it, and I developed perfect pitch […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pitchfork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ca825bb-7bf5-3b21-9ad2-80882eadaad7",
                                        "entry_id": "74447fe3-1fde-394a-8ebf-39a292ff6bed",
                                        "glosses": [
                                            "To toss or carry with a pitchfork."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d6b3ffd-8deb-4334-b112-1c444792c68d",
                                                "sense_id": "2ca825bb-7bf5-3b21-9ad2-80882eadaad7",
                                                "text": "The hay was soon pitchforked onto the wagon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "393aa5bc-d7fb-30fe-856f-9c98b3f0c107",
                                        "entry_id": "74447fe3-1fde-394a-8ebf-39a292ff6bed",
                                        "glosses": [
                                            "To throw suddenly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fa30382-1ae6-4b00-9ae6-d325b5d23d62",
                                                "sense_id": "393aa5bc-d7fb-30fe-856f-9c98b3f0c107",
                                                "text": "We have taken an age-old country, and we have suddenly, in 30 years, pitchforked it into the middle of the factory system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da761989-1b53-419d-8bda-0b486dd2b6d6",
                        "source_entry_id": "9fdc13c9-35d6-30b6-835a-4c8bdef14d01",
                        "source_sense_id": "1e7e6a1c-fff3-34dd-9da8-603e5d0dd78a",
                        "source_sense_description": "een handwerktuig voor het verplaatsen van bladeren, gras of gewied materiaal in de vorm van een grote vork met smalle tanden",
                        "target_lang_word": "horca",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horca",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7622899d-118b-3d9b-a9df-69c20500fc9f",
                                        "entry_id": "2fa3640d-608e-345c-815e-a250bfda0aa8",
                                        "glosses": [
                                            "Vara o palo cuyo extremo se bifurca en varias puntas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75b387d-3123-438f-97c6-fac421e6cd44",
                                                "sense_id": "7622899d-118b-3d9b-a9df-69c20500fc9f",
                                                "text": "Es un tronco hincado drecho, que es A, el qual, por la parte de arriba, está abierto a modo de una horca, ansí como se vehe pintado."
                                            },
                                            {
                                                "example_id": "07b44733-b166-4799-ba81-6cc325bab785",
                                                "sense_id": "7622899d-118b-3d9b-a9df-69c20500fc9f",
                                                "text": "El eje de las ruedas portadoras de la máquina va alto y está encorvado en forma de horca, para que pueda pasar por encima de los tallos del maíz sin rozarlos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a1ff5614-31f1-338e-b573-f01e6c43975f",
                                        "entry_id": "2fa3640d-608e-345c-815e-a250bfda0aa8",
                                        "glosses": [
                                            "En particular, herramienta formada por un asta acabada en varias puntas, que se emplea para mover material suelto, como heno u hojarasca."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae38291-c371-4268-9478-f519b6da9bd8",
                                                "sense_id": "a1ff5614-31f1-338e-b573-f01e6c43975f",
                                                "text": "El pobre guarda intentó forcejear para valerse de su arma; pero dos manos de hierro le arrancaron la escopeta, y cogiendo uno de ellos una horca de la era, le dio por añadidura una gran paliza, sin que a todo esto dejasen los gañanes de dormir y roncar de lo lindo."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9e8b3069-c5b5-32c6-8697-dcf666cc67fc",
                                        "entry_id": "2fa3640d-608e-345c-815e-a250bfda0aa8",
                                        "glosses": [
                                            "Yugo en forma de horca₁ que se empleaba antiguamente para pasear públicamente a los vencidos en batalla o a los condenados a penas de escarnio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0f561d5-7b5b-4e46-8a2b-9b14ba77c7a9",
                                                "sense_id": "9e8b3069-c5b5-32c6-8697-dcf666cc67fc",
                                                "text": "A los condenados se les encajaba la cabeza entre los dos dientes de la horca, al tiempo que se les ataba las manos a las dos extremidades dentadas."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b80894de-5ba0-34a4-93cf-0c54d4f210c6",
                                        "entry_id": "2fa3640d-608e-345c-815e-a250bfda0aa8",
                                        "glosses": [
                                            "Dispositivo similar a una horca₃ que se coloca al cuello de los animales para impedirles pasar entre cercados."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "27778257-5056-33be-9e99-d090b05eef37",
                                        "entry_id": "2fa3640d-608e-345c-815e-a250bfda0aa8",
                                        "glosses": [
                                            "Estructura, antiguamente en forma de horca₁, que se emplea para ejecutar a los reos de pena de muerte colgándolos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52f0e4a0-1e82-4ea6-ba0d-3f2507f922b5",
                                                "sense_id": "27778257-5056-33be-9e99-d090b05eef37",
                                                "text": "Yo me hallé en Segovia en el primero alboroto que hubo en el reino, cuando a veintitrés de mayo, miércoles después de Pascua, sacaron de la iglesia de Sant Miguel al regidor Tordesillas, y le llevaron a la horca, a do le ahorcaron entre dos porquerones, como a Jesuchristo entre dos ladrones."
                                            },
                                            {
                                                "example_id": "31a5977a-d084-4842-97e3-086d8dda6e99",
                                                "sense_id": "27778257-5056-33be-9e99-d090b05eef37",
                                                "text": "… se vió la muchedumbre de sus guerreros. Y se comenzó a matarlos. Y se levantaron horcas para que murieran."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "0a73a805-47f3-38a9-a82c-77994014f574",
                                        "entry_id": "2fa3640d-608e-345c-815e-a250bfda0aa8",
                                        "glosses": [
                                            "Horca₁ con que se soporta un larguero horizontal o una rama de árbol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8b72e97-7ce6-47ed-ab6e-b2add342fdac",
                                                "sense_id": "0a73a805-47f3-38a9-a82c-77994014f574",
                                                "text": "y porque quando nascen y son chiquitos los quema el sol pongan fuera dela era vnas horcas para poner vnos sombrajos encima. y sean tan altas que pueda andar por baxo vna persona quando fuere necessidad de escardarlos y mollirlos."
                                            },
                                            {
                                                "example_id": "702043d2-2f7c-4243-8838-1188f55168d0",
                                                "sense_id": "0a73a805-47f3-38a9-a82c-77994014f574",
                                                "text": "Envuelto en sus improvisados lutos que olían a tintas de ayer, el adolescente miraba la ciudad, extrañamente parecida, a esta hora de reverberaciones y sombras largas, a un gigantesco lampadario barroco, cuyas cristalerías verdes, rojas, anaranjadas, colorearan una confusa rocalla de balcones, arcadas, cimborrios, belvederes y galerías de persianas —siempre erizada de andamios, maderas aspadas, horcas y cucañas de albañilería, desde que la fiebre de la construcción se había apoderado de sus habitantes enriquecidos por la última guerra de Europa."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "f23a19be-e9bd-345b-94ef-5be9302e758e",
                                        "entry_id": "2fa3640d-608e-345c-815e-a250bfda0aa8",
                                        "glosses": [
                                            "Parte saliente del hueso de la taba."
                                        ],
                                        "tags": [
                                            "Spain"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    }
