                "senses": [
                    {
                        "sense_id": "8ac620ab-8cc6-3bc8-8fde-a9b8112820c6",
                        "entry_id": "b69784b9-7a63-316f-be79-15c57aaf5486",
                        "glosses": [
                            "Donner un caractère terminologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63c5ca7-bbd7-4dc2-b5cc-2467b87fa872",
                                "sense_id": "8ac620ab-8cc6-3bc8-8fde-a9b8112820c6",
                                "text": "La réponse allait peut-être de soi ou peut-être était-on trop occupé à «terminologiser» pour se poser la question…"
                            },
                            {
                                "example_id": "025de3f1-1051-4e0f-b3a9-9633d6b2e6e1",
                                "sense_id": "8ac620ab-8cc6-3bc8-8fde-a9b8112820c6",
                                "text": "Dans le contexte de ces technicismes, les verbes peuvent également se « terminologiser » en contexte et contribuent, en présence de documents multilingues, à désaligner les différentes versions produites."
                            },
                            {
                                "example_id": "4f2c1a8b-8251-4a5e-97f0-14b66209a236",
                                "sense_id": "8ac620ab-8cc6-3bc8-8fde-a9b8112820c6",
                                "text": "Naturel ou terminologisé, le langage est phonosémique, mais dans le mot il l'est par création, dans le terme par adaptation."
                            }
                        ]
                    }
