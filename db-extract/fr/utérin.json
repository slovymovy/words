                "senses": [
                    {
                        "sense_id": "f306d3ae-24d7-39e9-ac22-fbdee547f591",
                        "entry_id": "e100ca88-b897-3a18-8edf-e12f826dd5dc",
                        "glosses": [
                            "που αφορά τη μήτρα, μητριαίος"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9af7881-01ad-40fd-b91f-47695594b44d",
                                "sense_id": "f306d3ae-24d7-39e9-ac22-fbdee547f591",
                                "text": "Grossesse utérine. - Μητριαία εγκυμοσύνη (το αντίθετο είναι grossesse ectopique ή grossesse extra-utérine)."
                            },
                            {
                                "example_id": "74b0bb66-fe9c-4b6d-9c81-7b7d6866d990",
                                "sense_id": "f306d3ae-24d7-39e9-ac22-fbdee547f591",
                                "text": "Muqueuse utérine. - Μητριαία βλεννογόνος."
                            },
                            {
                                "example_id": "1703bc2b-0e32-47d2-a3a0-758c88850cc0",
                                "sense_id": "f306d3ae-24d7-39e9-ac22-fbdee547f591",
                                "text": "Hémorragie utérine. - Αιμορραγία της μήτρας."
                            },
                            {
                                "example_id": "0b85dece-3d1a-4dcb-8ecd-ac6bf45de7c7",
                                "sense_id": "f306d3ae-24d7-39e9-ac22-fbdee547f591",
                                "text": "Artère utérine. - Μητριαία αρτηρία."
                            },
                            {
                                "example_id": "668cdd6f-f11c-4c32-bffb-d490b9a980ac",
                                "sense_id": "f306d3ae-24d7-39e9-ac22-fbdee547f591",
                                "text": "Trompe utérine. - Μητριαία σάλπιγγα."
                            },
                            {
                                "example_id": "bc6586bb-0949-4221-abc0-bdeb19418992",
                                "sense_id": "f306d3ae-24d7-39e9-ac22-fbdee547f591",
                                "text": "Noblesse utérine. - Τίτλος ευγενείας που περνούσε από μητέρα σε παιδί."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbff6d8b-a279-38c9-8bc1-5bebfbabdbdd",
                        "entry_id": "e100ca88-b897-3a18-8edf-e12f826dd5dc",
                        "glosses": [
                            "λέγεται για αδέλφια που έχουν την ίδια μητέρα αλλά διαφορετικό πατέρα"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e907752b-d0af-49e6-a36f-bee472067a6b",
                                "sense_id": "fbff6d8b-a279-38c9-8bc1-5bebfbabdbdd",
                                "text": "Frère utérin, frère consanguin. - Ομομήτριος αδερφός, ετεροθαλής αδερφός."
                            }
                        ]
                    }
