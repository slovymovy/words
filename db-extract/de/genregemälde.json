                "senses": [
                    {
                        "sense_id": "7b8c6c03-84ae-3b03-a1e3-bc9ac0039f5e",
                        "entry_id": "f053e808-27b0-3189-a3d8-5fc4fedb2e04",
                        "glosses": [
                            "gemaltes Bild einer alltäglichen Szene zur Darstellung von bestimmten Lebensformen oder Umgebungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27e2082f-301d-49c6-9b07-aabdb4ea0f75",
                                "sense_id": "7b8c6c03-84ae-3b03-a1e3-bc9ac0039f5e",
                                "text": "„Da ein Großteil der Werke Genregemälde sind, beschäftigt sich das vierte Kapitel mit deren Stil.“"
                            },
                            {
                                "example_id": "289ab8bd-9e24-4d53-b474-981e7c58aa35",
                                "sense_id": "7b8c6c03-84ae-3b03-a1e3-bc9ac0039f5e",
                                "text": "„Besser sind die modernen Genregemälde aus dem Volksleben, wie sie insbesondere das witzige Berlin lieferte.“"
                            },
                            {
                                "example_id": "12a37e9d-db4e-4a6b-9b14-c379013f2cc4",
                                "sense_id": "7b8c6c03-84ae-3b03-a1e3-bc9ac0039f5e",
                                "text": "„Das Gegenstück unseres Bildes ist das Genregemälde, welches gewöhnlich auf Thetis bezogen wird, die den Achill in den Styx taucht.“"
                            },
                            {
                                "example_id": "26616f5b-cb77-4526-9ec1-2342e19a1156",
                                "sense_id": "7b8c6c03-84ae-3b03-a1e3-bc9ac0039f5e",
                                "text": "„Zwischen seinen bunten historischen und Genregemälden erblicken wir auch hohe Götterbilder, Abstracta, die in den Rhythmen Kranz der Zeit.“"
                            },
                            {
                                "example_id": "4641819f-8bca-4e06-bdf3-f6e73134fcf5",
                                "sense_id": "7b8c6c03-84ae-3b03-a1e3-bc9ac0039f5e",
                                "text": "„Als Ganzes ist keiner seiner Romane gelungen, es fehlt Allen die Einheit; um so meisterhafter sind die Einzelscenen, die poetischen Genregemälde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
