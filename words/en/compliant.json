{
    "word_family": [
        "compliance",
        "comply",
        "compliantly",
        "non-compliant"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6d388a25-14fc-35d8-a7ee-a458cdaf0dce",
                    "sense_definition": "Meeting or following specific rules, standards, or legal requirements.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adherence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company must ensure that all its software is <w>compliant</w> with the new privacy laws.",
                            "target_lang_translations": {
                                "ru": "Компания должна гарантировать, что все ее программное обеспечение <w>соответствует</w> новым законам о конфиденциальности.",
                                "zh": "公司必须确保其所有软件都<w>符合</w>新的隐私法。"
                            }
                        },
                        {
                            "text": "The building was fully <w>compliant</w> with safety regulations after the recent renovations.",
                            "target_lang_translations": {
                                "ru": "После недавнего ремонта здание полностью <w>соответствовало</w> правилам техники безопасности.",
                                "zh": "经过最近的翻新，该建筑完全<w>符合</w>安全法规。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conformant"
                    ],
                    "antonyms": [
                        "non-compliant",
                        "noncompliant"
                    ],
                    "common_phrases": [
                        "fully compliant",
                        "compliant with regulations",
                        "standards compliant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий определенным правилам, стандартам или юридическим требованиям.",
                        "zh": "符合特定规则、标准或法律要求的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответствующий",
                                "target_lang_sense_clarification": "нормам или правилам"
                            },
                            {
                                "target_lang_word": "согласованный",
                                "target_lang_sense_clarification": "с руководящими принципами"
                            },
                            {
                                "target_lang_word": "соблюдающий",
                                "target_lang_sense_clarification": "требования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合规的",
                                "target_lang_sense_clarification": "指符合法律或行业标准"
                            },
                            {
                                "target_lang_word": "符合……的",
                                "target_lang_sense_clarification": "指达到某种标准或要求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8dcd3e3-bf81-37ef-acb8-f041ce651621",
                    "sense_definition": "Willing to do what other people want or to follow orders without protest.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect remained <w>compliant</w> during the arrest and followed all police instructions.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый оставался <w>послушным</w> во время ареста и следовал всем указаниям полиции.",
                                "zh": "嫌疑人在被捕过程中保持<w>顺从</w>，并听从了警方的所有指示。"
                            }
                        },
                        {
                            "text": "She was a <w>compliant</w> child who rarely questioned her parents' authority.",
                            "target_lang_translations": {
                                "ru": "Она была <w>послушным</w> ребенком и редко подвергала сомнению авторитет родителей.",
                                "zh": "她是一个<w>顺从</w>的孩子，很少质疑父母的权威。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yielding",
                        "pliant",
                        "supple"
                    ],
                    "common_phrases": [
                        "compliant behavior",
                        "perfectly compliant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовый выполнять желания других людей или следовать приказам без протеста.",
                        "zh": "乐于顺从他人意愿或无异议地服从命令的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "послушный",
                                "target_lang_sense_clarification": "выполняющий просьбы или приказы"
                            },
                            {
                                "target_lang_word": "податливый",
                                "target_lang_sense_clarification": "легко поддающийся влиянию"
                            },
                            {
                                "target_lang_word": "уступчивый",
                                "target_lang_sense_clarification": "склонный соглашаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顺从的",
                                "target_lang_sense_clarification": "指听从他人意愿"
                            },
                            {
                                "target_lang_word": "服从的",
                                "target_lang_sense_clarification": "指听从命令"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}