    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "95d638dd-e9df-3e6d-ac21-013df57766ea",
                "word": "craftsmanship",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b6437768-074f-416c-9635-46fbc0e424b6",
                        "entry_id": "95d638dd-e9df-3e6d-ac21-013df57766ea",
                        "tags": [
                            "plural"
                        ],
                        "form": "craftsmanships"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e0d42df-a7da-320c-8db2-e10aff47c0fc",
                        "entry_id": "95d638dd-e9df-3e6d-ac21-013df57766ea",
                        "glosses": [
                            "The quality of being a craftsman."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6217faf7-189b-3195-961e-78618f170a11",
                        "entry_id": "95d638dd-e9df-3e6d-ac21-013df57766ea",
                        "glosses": [
                            "An example of a craftsman's work."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a5f6f1f3-9c60-4361-80a4-643b5f6c0e59",
                                "sense_id": "6217faf7-189b-3195-961e-78618f170a11",
                                "text": "The craftsmanship on the antique chair was exquisite."
                            },
                            {
                                "example_id": "8fd211b7-70bf-401c-9410-4883c7f9f9d5",
                                "sense_id": "6217faf7-189b-3195-961e-78618f170a11",
                                "text": "In Venice he eats fish and vegetables. In Paris he eats cakes, because he likes the craftsmanship of their creation. “But really, I have cheap taste. I like cheese and ice cream. The sluttier the better.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5c2f2ed-8a00-43e3-ab41-43c4e9f33444",
                        "source_entry_id": "95d638dd-e9df-3e6d-ac21-013df57766ea",
                        "source_sense_description": "quality of being a craftsman",
                        "target_lang_word": "vakmanschap",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vakmanschap",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a0ba7576-24eb-3dd5-847c-44a7f2fe6861",
                                        "entry_id": "b86f6a4f-30cb-3e31-8439-60877527524f",
                                        "glosses": [
                                            "vaardigheid in een beroep of handel, de vaardigheid om hoog kwalitatief werk af te leveren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c0c0e56-62f6-42a7-8d2f-8ff8ca7cf59e",
                                                "sense_id": "a0ba7576-24eb-3dd5-847c-44a7f2fe6861",
                                                "text": "Het kunnen inkleden van een onderwerp met behulp van personificaties en door het gebruik van beeldelementen (dieren, planten, voorwerpen, kleuren) met een diepere betekenis maakte deel uit van het vakmanschap van schilder en dichter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb54bab9-54e3-4f67-bf70-c8eaae9774ca",
                        "source_entry_id": "95d638dd-e9df-3e6d-ac21-013df57766ea",
                        "source_sense_description": "quality of being a craftsman",
                        "target_lang_word": "Handwerkskunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handwerkskunst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36a72e78-7a0b-3645-8c7f-2833641dde72",
                                        "entry_id": "fbb1935d-41cf-3fb8-a677-309620bc784c",
                                        "glosses": [
                                            "Fähigkeit zu hochwertiger handwerklicher Gestaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a032a58-f30f-4b93-8116-5db32cfe8ffc",
                                                "sense_id": "36a72e78-7a0b-3645-8c7f-2833641dde72",
                                                "text": "„Das lag bestimmt nicht an fehlender Handwerkskunst der Kelten; ihre Goldarbeiten sind von höchster Qualität, ebenso die komplizierten ornamentalen Muster in Schwertern oder auf Perlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd1442c4-3294-4375-9616-c367f88d1ffe",
                        "source_entry_id": "95d638dd-e9df-3e6d-ac21-013df57766ea",
                        "source_sense_description": "quality of being a craftsman",
                        "target_lang_word": "Handwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "357dc300-9958-38d9-8769-7517aa04cd52",
                                        "entry_id": "32f86cc5-aee8-3983-bfe0-3ec8b2ab963f",
                                        "glosses": [
                                            "traditionelle, mit Handarbeit verbundene Tätigkeiten oder Berufe, zum Beispiel Schreiner, Bäcker oder Schneider"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8435ab0-2582-44b2-935b-1f2438cc438f",
                                                "sense_id": "357dc300-9958-38d9-8769-7517aa04cd52",
                                                "text": "Es kann sinnvoll sein, zusätzlich zu einer Ausbildung in der Informationstechnik auch eine im Handwerk zu machen."
                                            },
                                            {
                                                "example_id": "7bed6b58-fdae-40f6-88f1-3fbd7e08b350",
                                                "sense_id": "357dc300-9958-38d9-8769-7517aa04cd52",
                                                "text": "„Das Handwerk lebt davon, dass es anders arbeitet als die Industrie.“"
                                            },
                                            {
                                                "example_id": "170f4cd3-1772-4702-a94a-8c2f29bbf89b",
                                                "sense_id": "357dc300-9958-38d9-8769-7517aa04cd52",
                                                "text": "„So gehen zum Beispiel Redensarten und Sprichwörter häufig auf alte Fachausdrücke zurück, nicht selten aus alten Handwerken.“"
                                            },
                                            {
                                                "example_id": "91ea54e1-ca63-4c62-a06a-72179f2ad406",
                                                "sense_id": "357dc300-9958-38d9-8769-7517aa04cd52",
                                                "text": "„Am schärfsten nahm der patrouillierende Witz das Handwerk der Maurer aufs Korn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae4bfa81-f88a-3aa4-904b-16222cf6806a",
                                        "entry_id": "32f86cc5-aee8-3983-bfe0-3ec8b2ab963f",
                                        "glosses": [
                                            "allgemeine Arbeit; etwas, was mit bestimmten Handgriffen zu erledigen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4518c912-2d7c-458f-a100-bd4131fdf857",
                                                "sense_id": "ae4bfa81-f88a-3aa4-904b-16222cf6806a",
                                                "text": "Der Bestatter übte sein Handwerk aus und füllte Erde in das Grab."
                                            },
                                            {
                                                "example_id": "99255803-75ad-4bb3-af98-042af9b8cc7c",
                                                "sense_id": "ae4bfa81-f88a-3aa4-904b-16222cf6806a",
                                                "text": "„Die alten Schreibkundigen brächten wenig Sympathie für unsere Schreibmaschinen und Computer auf, weil durch sie das Handwerk und die Kunst des Schreibens aussterben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
