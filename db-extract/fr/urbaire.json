                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15f2db61-c8aa-30dd-a8f6-527e5e0113c3",
                                        "entry_id": "d52df43c-ee0f-3b4a-b34a-ae85d2129712",
                                        "glosses": [
                                            "Verzeichnis über Besitzrechte eines Grundherrn und Leistungen seiner Grunduntertanen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb75594-44a1-44ab-bb6f-7ed1406411f1",
                                                "sense_id": "15f2db61-c8aa-30dd-a8f6-527e5e0113c3",
                                                "text": "Zahlreiche, vor allem im Rheinland gelegene Orte, werden im Prümer Urbar zum ersten Mal schriftlich dokumentiert."
                                            },
                                            {
                                                "example_id": "e4d1c182-57d1-4623-8a1e-c1e2fd3f0167",
                                                "sense_id": "15f2db61-c8aa-30dd-a8f6-527e5e0113c3",
                                                "text": "„Es war für die Gewinnung bestimmter methodischer Grundsätze und neuer Gesichtspunkte zur Interpretation der Urbare erforderlich, eine goße [sic!] Zahl von Urbaren und Rodeln durchzuarbeiten.“"
                                            },
                                            {
                                                "example_id": "9db0cd45-0ca9-4f6c-8b5f-7968e11c858f",
                                                "sense_id": "15f2db61-c8aa-30dd-a8f6-527e5e0113c3",
                                                "text": "„Das älteste landesfürstliche Urbar für das Herzogtum Österreich stammt aus der ersten Hälfte des 13. Jahrhunderts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Urbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcba6d6d-4446-3f5d-8e1b-11bc17516504",
                                        "entry_id": "828f381e-7da5-3c8f-b7b4-b0e5e2c136b6",
                                        "glosses": [
                                            "Name zweier Gemeinden in Rheinland-Pfalz"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6776b1fe-dd94-4e29-8fcb-43a181e4b27c",
                                                "sense_id": "dcba6d6d-4446-3f5d-8e1b-11bc17516504",
                                                "text": "Nirgendwo findet man die devonischen Schichten in ihrer ursprünglichen horizontalen Lagerung, wie sie für Meeressedimente selbstverständlich ist. Zwischen Ehrenbreitstein und Urbar trifft man sie in fast senkrechter Stellung an. In anderen Aufschlüssen erkennt man deutliche große Falten und kleine Fältelungen. …"
                                            },
                                            {
                                                "example_id": "3ff31c87-7dc0-496f-94ee-21708c289906",
                                                "sense_id": "dcba6d6d-4446-3f5d-8e1b-11bc17516504",
                                                "text": "„Ehrenbreitstein hatte von 1836 bis 1937 einen Stadtbürgermeister. Der Stadt waren angeschlossen die Gemeinden Pfaffendorf, Horchheim, Arzheim, Arenberg, Immendorf, Niederberg mit Neudorf und Urbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
