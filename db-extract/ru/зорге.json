                ],
                "senses": [
                    {
                        "sense_id": "6cbea409-cb29-3f00-a264-df58d680fe6f",
                        "entry_id": "53679ad0-1ebe-3b27-a8b8-d07b284e90e4",
                        "glosses": [
                            "немецкая фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d250993-ce4e-4aa5-9aaf-e06b4b253b50",
                                "sense_id": "6cbea409-cb29-3f00-a264-df58d680fe6f",
                                "text": "Советская страна войны на два фронта избежала, и в этом немалая заслуга Рихарда Зорге ― советского разведчика, немца по происхождению, внука соратника Карла Маркса."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c68bf3a-5a61-4263-ae73-0f37e257159c",
                        "source_entry_id": "53679ad0-1ebe-3b27-a8b8-d07b284e90e4",
                        "source_sense_id": "6cbea409-cb29-3f00-a264-df58d680fe6f",
                        "target_lang_word": "Sorge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sorge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                        "entry_id": "b808d179-341f-3bfc-9a30-25d3fed28985",
                                        "glosses": [
                                            "bedrückendes Gefühl der Unruhe und Angst, durch eine unangenehme und/oder gefahrvolle Situation hervorgerufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd18517-89b3-4260-ad10-a1fe9a8c39e6",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "Mach Dir bloß keine Sorgen!"
                                            },
                                            {
                                                "example_id": "bc1497ec-184e-4dda-adf0-5e6d7514d3f9",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "Ich werde noch ganz krank vor Sorge."
                                            },
                                            {
                                                "example_id": "69da2064-62c8-4c80-afcf-438fb586f5d3",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "Wir haben größte Sorge, dass die [Maschinen] uns nicht die Arbeit abnehmen, sondern uns die Arbeitsplätze wegnehmen [, ...]."
                                            },
                                            {
                                                "example_id": "9f868b27-64c6-442b-acbc-47df3cfd0113",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "„Für eine Weile bringt ihn die Welt wieder mit Spitzensport in Verbindung und nicht mit finanziellen Sorgen.“"
                                            },
                                            {
                                                "example_id": "38340f9d-f7cb-4d07-9a05-7cb4a3ea4ba9",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "„Die Sorge wurde zur Verzweiflung.“"
                                            },
                                            {
                                                "example_id": "8da0fcc2-9bac-4b87-b1c1-72894ffdd0f9",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "[Türkei:] „Am vergangenen Samstag nahmen sich sieben Menschen aus wirtschaftlichen Sorgen das Leben.“"
                                            },
                                            {
                                                "example_id": "11a27877-9748-4eed-a48f-55d6b6828d5b",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "[Februar 2022:] „Aus Sorge vor einem Großangriff russischer Truppen wurde in Kiew die Ausgangssperre erheblich ausgeweitet.“"
                                            },
                                            {
                                                "example_id": "a3cebe8f-a4c3-4dee-9f97-e8e8d3776659",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "[Jakarta/Indonesien:] „Überhaupt ist Wasser für die 18 Millionen Menschen im Ballungsgebiet ein Grund zur täglichen Sorge. Ursache ist der unverantwortliche Umgang mit Abwässern jeder Art.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "368175e6-9ea6-3a1b-a769-854f61048d33",
                                        "entry_id": "b808d179-341f-3bfc-9a30-25d3fed28985",
                                        "glosses": [
                                            "Bemühen um die als positiv empfundene Entwicklung einer Situation, speziell um das Wohlergehen eines anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67a3f607-5027-4e56-92db-c7bba8be70f0",
                                                "sense_id": "368175e6-9ea6-3a1b-a769-854f61048d33",
                                                "text": "Unter der Woche übernahm sie die Sorge für das Kind mit Freude."
                                            },
                                            {
                                                "example_id": "8dd1c864-a245-419b-9c14-21db9a02bd28",
                                                "sense_id": "368175e6-9ea6-3a1b-a769-854f61048d33",
                                                "text": "Ich werde persönlich dafür Sorge tragen, dass Ihre Bewerbung zum richtigen Ansprechpartner kommt."
                                            },
                                            {
                                                "example_id": "6ec90345-7f11-46c4-aa7d-2121a9b6a185",
                                                "sense_id": "368175e6-9ea6-3a1b-a769-854f61048d33",
                                                "text": "Du musst dich nicht um alles kümmern, das lass mal ihre Sorge sein!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
