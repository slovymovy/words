            {
                "entry_id": "28ace9ec-06e4-3618-a0e1-c17425c3d0d1",
                "word": "photobombing",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "571887f1-f9fe-311b-9d6d-6ef47c4f2ec6",
                        "entry_id": "28ace9ec-06e4-3618-a0e1-c17425c3d0d1",
                        "glosses": [
                            "Acte accidentel ou intentionnel consistant à apparaitre sur une photographie, contre la volonté du photographe et à l’insu des photographiés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8858359f-3b39-40e8-a85f-563aa319996f",
                                "sense_id": "571887f1-f9fe-311b-9d6d-6ef47c4f2ec6",
                                "text": "Il n’y a pas que les chats et le chiens qui savent pratiquer le photobombing, ou l’art de s’incruster sur un cliché."
                            },
                            {
                                "example_id": "9fa7edbb-6dca-46a4-98d2-cd37b5e7deef",
                                "sense_id": "571887f1-f9fe-311b-9d6d-6ef47c4f2ec6",
                                "text": "En discrétion ou en frontale déflagration, le photobombing consiste à ruiner, volontairement ou non, une photo posée par l’irruption d’une tierce personne dans le cadre"
                            },
                            {
                                "example_id": "f90c0d94-bfe8-463d-9474-e00b03e73d60",
                                "sense_id": "571887f1-f9fe-311b-9d6d-6ef47c4f2ec6",
                                "text": "La pratique du photobombing est également ouverte aux animaux."
                            },
                            {
                                "example_id": "2fdfaef6-5421-4337-865f-6a69cec041aa",
                                "sense_id": "571887f1-f9fe-311b-9d6d-6ef47c4f2ec6",
                                "text": "Après ce photobombing derrière le chef de l’État, on s’est pris à chercher un drapeau tricolore avec marqué Sarreguemines dessus."
                            }
                        ]
                    }
                ],
