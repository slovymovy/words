        "fr-extract.jsonl": [
            {
                "entry_id": "adfe7bdf-715e-388c-a3f4-795130dcbc39",
                "word": "régine",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "af6a41ac-5a88-3ffc-adb1-88e74495ce40",
                        "entry_id": "adfe7bdf-715e-388c-a3f4-795130dcbc39",
                        "glosses": [
                            "Qui appartient ou qui est relatif à une reine."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d827d0c1-9bbb-44e3-ba9f-68190d8c2110",
                                "sense_id": "af6a41ac-5a88-3ffc-adb1-88e74495ce40",
                                "text": "Se dressant sur la pointe des pieds pour atteindre les lèvres du chevalier, [elle] les baisa gentiment et dit : « Vous êtes le premier de ma garde régine »"
                            },
                            {
                                "example_id": "30e8c3f5-9acc-4e51-9a7d-9a0c69e177bf",
                                "sense_id": "af6a41ac-5a88-3ffc-adb1-88e74495ce40",
                                "text": "« Votre Grâce... », suggéra [le] lord Commandant de sa garde régine. « Il n’est pas nécessaire que vous voyez cela. »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cf5bd14e-5338-3823-a696-b0707e7eeb42",
                "word": "Régine",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "72aca33e-3cd2-3e7f-bb89-4d9bfc42b4f2",
                        "entry_id": "cf5bd14e-5338-3823-a696-b0707e7eeb42",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2d91518-f60b-4a21-bf99-0862e7a86f88",
                                "sense_id": "72aca33e-3cd2-3e7f-bb89-4d9bfc42b4f2",
                                "text": "Crispée de jalousie, elle observait le manège de Régine qui, à la fin de la soirée, jouant les étonnées, prétexta que le dernier train pour le Vésinet était depuis longtemps parti pour me prier de l'héberger dans mon studio."
                            },
                            {
                                "example_id": "d3ce4b35-bcfa-4373-9550-fdcb912ef352",
                                "sense_id": "72aca33e-3cd2-3e7f-bb89-4d9bfc42b4f2",
                                "text": "Les vins primeurs sont très flatteurs pour les consommateurs, car ils sont très aromatiques, explique l’œnologue Régine Le Coz."
                            }
                        ]
                    }
                ],
