                                        "entry_id": "00319730-c77e-307c-9027-eecde0d274ee",
                                        "glosses": [
                                            "chi si barcamena in circostanze difficili"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fd8e555-7e3e-4b61-88b4-3782292651a3",
                        "source_entry_id": "2153a0db-6ff1-371c-b9e7-afac2ef5510b",
                        "source_sense_id": "433e4ee3-8777-344d-a078-ecc5defab845",
                        "target_lang_word": "эквилибрист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эквилибрист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f8ed6c80-8ee9-38a9-a346-6caf03bb1dc5",
                                        "entry_id": "0946f43e-fc30-345a-b522-9c2090ef09a0",
                                        "glosses": [
                                            "артист цирка, также уличный артист, занимающийся эквилибристикой, то есть демонстрирующий способность сохранять равновесие при исполнении трюков на неустойчивых предметах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be071a88-b455-4714-8cbf-74cf6916c56c",
                                                "sense_id": "f8ed6c80-8ee9-38a9-a346-6caf03bb1dc5",
                                                "text": "Сделаны также были приуготовления к тому, чтоб эквилибристам ходить по верёвкам и утешать народ, и прочия тому подобныя забавы."
                                            },
                                            {
                                                "example_id": "7baf82f2-4372-4a2d-b7b4-504b8d2e67fd",
                                                "sense_id": "f8ed6c80-8ee9-38a9-a346-6caf03bb1dc5",
                                                "text": "Публика замирает, когда эквилибрист Владимир Манчук вытворяет чудеса на двойной свободной проволоке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58174dae-373b-3a21-8528-8d0c5a3f21d4",
                                        "entry_id": "0946f43e-fc30-345a-b522-9c2090ef09a0",
                                        "glosses": [
                                            "перен. человек, проявляющий изворотливость и лавирование в поведении, спорах и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4237618-b94d-4451-b1fe-b5402391e170",
                                                "sense_id": "58174dae-373b-3a21-8528-8d0c5a3f21d4",
                                                "text": "О нём много толковали в Москве как об удивительном эквилибристе: Яков Иванович не только остался хозяином своего завода в новой ипостаси заведующего, но и стал главнейшим консультантом по конному делу в Наркомземе, у Будённого и ещё где-то."
                                            },
                                            {
                                                "example_id": "eec7fffe-5478-47b8-8f2c-fd816cb194ae",
                                                "sense_id": "58174dae-373b-3a21-8528-8d0c5a3f21d4",
                                                "text": "Такие атрибуты щегольства мелькают во множестве мемуаров о живописцах речи, эквилибристах слова и акварелистах мысли."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
