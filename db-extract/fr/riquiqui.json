                "forms": [],
                "senses": [
                    {
                        "sense_id": "bcde76c2-5a2f-3190-8d2b-344f618bc165",
                        "entry_id": "13a1f6a0-462e-3491-ae6d-553dabc312ce",
                        "glosses": [
                            "tiny, narrow, cramped"
                        ],
                        "tags": [
                            "also",
