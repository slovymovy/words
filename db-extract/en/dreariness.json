                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "96fe4ade-fcbd-31c9-bff8-31420575fcca",
                                        "entry_id": "c6045ec8-03f8-3604-b58c-5b919a50e049",
                                        "glosses": [
                                            "anregungsarmer, langweiliger Bereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8844c963-4f1d-4f82-a1f3-b7b7936299ad",
                                                "sense_id": "96fe4ade-fcbd-31c9-bff8-31420575fcca",
                                                "text": "„Aber seltsamer Weise findet er jetzt die Öde und Hässlichkeit Ostberlins weit weniger deprimierend als damals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c0c0d472-f7bc-38a8-a175-3bb81fb7b5b6",
                                        "entry_id": "c6045ec8-03f8-3604-b58c-5b919a50e049",
                                        "glosses": [
                                            "Zustand des Mangels an geistigen Aktivitäten/Anregungen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6277f073-42f7-42bf-a8f1-d829aac1b84f",
                        "source_entry_id": "5379e926-8983-3bf9-836e-b3cebf5d4b1b",
                        "source_sense_id": "93a776a1-0b7b-35b8-b493-000a97b71b14",
                        "source_sense_description": "state of being dreary",
                        "target_lang_word": "Tristesse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tristesse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                                        "entry_id": "4ce33d92-baf0-3298-b1f4-9b8417935af1",
                                        "glosses": [
                                            "Gefühl der Traurigkeit, der Trübseligkeit, des Jammers oder der Ödnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0602ee7-c0b5-40ce-9e12-6bcc03e1125f",
                                                "sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                                                "text": "Sein Dasein ist an biederer Tristesse wohl gemeinhin nicht zu überbieten."
                                            },
                                            {
                                                "example_id": "d55f4376-d549-445c-9c7e-dcd78ffc7ab3",
                                                "sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                                                "text": "„Das waren Lieder, die die Tristesse des Alltags mit so etwas wie Taumel der Sinne beantworteten.“"
                                            },
                                            {
                                                "example_id": "0a50d6f7-e52a-43bc-b7af-9dc2487f9ed2",
                                                "sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                                                "text": "„Egal, wie viel Licht in die Straße fiel, die Tristesse blieb, eine Tristesse, die nur noch zunehmen würde.“"
                                            },
                                            {
                                                "example_id": "fab8b04e-cd77-4dec-85f7-8ce8b39ef07e",
                                                "sense_id": "adccb4a0-2293-39ca-ac0c-6a4fbb2f0c4b",
                                                "text": "„Diese Tristesse mache auch sie depressiv.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "beb3e97b-a4a2-308d-b48a-53ea27051871",
                                        "entry_id": "4ce33d92-baf0-3298-b1f4-9b8417935af1",
                                        "glosses": [
                                            "ästhetischer Eindruck der Langeweile, Geistlosigkeit oder Mangel an Abwechslung beschreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d022087-8f86-46aa-832a-2b050da7e978",
                                                "sense_id": "beb3e97b-a4a2-308d-b48a-53ea27051871",
                                                "text": "Die minimalen bis monotonen Stücke sind durch eine große immanente Tristesse gekennzeichnet."
                                            },
                                            {
                                                "example_id": "0fa127c0-c1da-4f7f-bef4-2ec77540a7d5",
                                                "sense_id": "beb3e97b-a4a2-308d-b48a-53ea27051871",
                                                "text": "„Um der Tristesse zu entgehen, nimmt sie Kontakt zu einheimischen Frauen auf, interessiert sich für ihr Handwerk, lernt ihre Sprachen, sammelt ihre Geschichten und Märchen, reist mehrmals durch Kaschmir.“"
                                            },
                                            {
                                                "example_id": "7ab7f95a-b1f3-4694-917b-c5f0e1be281a",
                                                "sense_id": "beb3e97b-a4a2-308d-b48a-53ea27051871",
                                                "text": "„Franc ließ sich von der Dunkelheit und der Tristesse des Ortes wenig beeindrucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed182439-2c03-48e1-8180-c203af866913",
                        "source_entry_id": "5379e926-8983-3bf9-836e-b3cebf5d4b1b",
