{
    "word_family": [
        "CD-ROM",
        "CD-RW"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e4f073e-926e-3117-b579-1f944efcbbe6",
                    "sense_definition": "A small plastic disc on which music or other digital information is stored, an initialism of <w>compact disc</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I misplaced the software installation <w>CD</w>.",
                            "target_lang_translations": {
                                "ru": "Я куда-то положил установочный <w>CD</w> с программным обеспечением."
                            }
                        },
                        {
                            "text": "He put the <w>CD</w> into the player to listen to his favorite album.",
                            "target_lang_translations": {
                                "ru": "Он вставил <w>компакт-диск</w> в проигрыватель, чтобы послушать свой любимый альбом."
                            }
                        }
                    ],
                    "synonyms": [
                        "compact disc"
                    ],
                    "common_phrases": [
                        "audio CD",
                        "CD player",
                        "burn a CD"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой пластиковый диск, на котором хранится музыка или другая цифровая информация; аббревиатура от компакт-диск."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "CD",
                                "target_lang_sense_clarification": "аббревиатура"
                            },
                            {
                                "target_lang_word": "компакт-диск",
                                "target_lang_sense_clarification": "носитель информации"
                            },
                            {
                                "target_lang_word": "си-ди",
                                "target_lang_sense_clarification": "фонетическая транскрипция"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd0aeac2-e3ee-3773-ae78-5d1afb177166",
                    "sense_definition": "A collection of musical recordings or an album released on a compact disc.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mariah Carey's new <w>CD</w> has some R'n'B influences.",
                            "target_lang_translations": {
                                "ru": "В новом <w>альбоме</w> Мэрайи Кэри чувствуется влияние R'n'B."
                            }
                        },
                        {
                            "text": "I bought her latest <w>CD</w> at the music store yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера я купил её последний <w>диск</w> в музыкальном магазине."
                            }
                        }
                    ],
                    "synonyms": [
                        "album",
                        "record"
                    ],
                    "common_phrases": [
                        "new CD",
                        "latest CD"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сборник музыкальных записей или альбом, выпущенный на компакт-диске."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альбом",
                                "target_lang_sense_clarification": "музыкальный"
                            },
                            {
                                "target_lang_word": "диск",
                                "target_lang_sense_clarification": "музыкальное издание"
                            },
                            {
                                "target_lang_word": "CD",
                                "target_lang_sense_clarification": "музыкальный релиз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b6f7689-59d4-3f26-b9e0-6c1a5712db69",
                    "sense_definition": "A person who wears clothing typically associated with the opposite sex; an initialism of <w>cross-dresser</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The support group provides a safe space for any <w>CD</w> to share their experiences.",
                            "target_lang_translations": {
                                "ru": "Группа поддержки предоставляет безопасное пространство для любого <w>кроссдрессера</w>, чтобы поделиться своим опытом."
                            }
                        },
                        {
                            "text": "He identifies as a <w>CD</w> and enjoys exploring different fashion styles.",
                            "target_lang_translations": {
                                "ru": "Он идентифицирует себя как <w>кроссдрессер</w> и любит экспериментировать с различными стилями моды."
                            }
                        }
                    ],
                    "synonyms": [
                        "cross-dresser"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used within specific communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который носит одежду, обычно ассоциирующуюся с противоположным полом; аббревиатура от кроссдрессер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроссдрессер",
                                "target_lang_sense_clarification": "человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fd41969-fa85-3cb3-a2ee-2a79b005b0fd",
                    "sense_definition": "A savings certificate with a fixed maturity date and specified fixed interest rate; an abbreviation of <w>certificate of deposit</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Banks may offer premium rates on <w>CDs</w> to attract deposits, but once they get those deposits, they end the offers.",
                            "target_lang_translations": {
                                "ru": "Банки могут предлагать премиальные ставки по <w>депозитным сертификатам</w>, чтобы привлечь вклады, но как только они получают эти вклады, они прекращают действие предложений."
                            }
                        },
                        {
                            "text": "She decided to invest her savings in a five-year <w>CD</w> for a higher return.",
                            "target_lang_translations": {
                                "ru": "Она решила вложить свои сбережения в пятилетний <w>депозитный сертификат</w> для получения более высокого дохода."
                            }
                        }
                    ],
                    "synonyms": [
                        "certificate of deposit"
                    ],
                    "common_phrases": [
                        "bank CD",
                        "CD rates"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сберегательный сертификат с фиксированной датой погашения и установленной процентной ставкой; аббревиатура от депозитный сертификат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "депозитный сертификат",
                                "target_lang_sense_clarification": "банковский инструмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca997242-799a-3c1e-be5d-a76f5d43b3d3",
                    "sense_definition": "The collective body of foreign diplomats resident in a particular country; an initialism of <w>corps diplomatique</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diplomacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jake lengthened his stride and crossed the road in front of a double-parked car, large, black and with <w>CD</w> plates.",
                            "target_lang_translations": {
                                "ru": "Джейк ускорил шаг и перешел дорогу перед припаркованным во втором ряду автомобилем — большим, черным и с номерами <w>дипкорпуса</w>."
                            }
                        },
                        {
                            "text": "Vehicles belonging to the <w>CD</w> often have special parking privileges near embassies.",
                            "target_lang_translations": {
                                "ru": "Транспортные средства, принадлежащие <w>дипломатическому корпусу</w>, часто имеют особые привилегии при парковке рядом с посольствами."
                            }
                        }
                    ],
                    "synonyms": [
                        "diplomatic corps"
                    ],
                    "common_phrases": [
                        "CD plates"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in official or diplomatic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность иностранных дипломатов, проживающих в определенной стране; аббревиатура от дипломатический корпус."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дипломатический корпус",
                                "target_lang_sense_clarification": "официальный термин"
                            },
                            {
                                "target_lang_word": "дипкорпус",
                                "target_lang_sense_clarification": "сокращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0a14b97-f4f3-3d71-a899-ac3b3ec81881",
                    "sense_definition": "The person in charge of the creative department at an agency; an initialism of <w>creative director</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>CD</w> approved the new advertising campaign before it was sent to the client.",
                            "target_lang_translations": {
                                "ru": "<w>Креативный директор</w> утвердил новую рекламную кампанию перед тем, как она была отправлена клиенту."
                            }
                        },
                        {
                            "text": "She was promoted to <w>CD</w> after leading several successful projects.",
                            "target_lang_translations": {
                                "ru": "Её повысили до <w>креативного директора</w> после того, как она успешно провела несколько проектов."
                            }
                        }
                    ],
                    "synonyms": [
                        "creative director"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, ответственное за творческий отдел в агентстве; аббревиатура от креативный директор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "креативный директор",
                                "target_lang_sense_clarification": "должность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aed78f99-4dc9-3c40-b977-6ebef5f370bd",
                    "sense_definition": "The time one must wait before using an ability or item again; an abbreviation of <w>cooldown</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can't use my ultimate ability yet because it is still on <w>CD</w>.",
                            "target_lang_translations": {
                                "ru": "Я пока не могу использовать свою ульту, потому что она еще на <w>кулдауне</w>."
                            }
                        },
                        {
                            "text": "The patch notes reduced the <w>CD</w> of the healing spell by two seconds.",
                            "target_lang_translations": {
                                "ru": "В описании патча время <w>отката</w> исцеляющего заклинания было сокращено на две секунды."
                            }
                        }
                    ],
                    "synonyms": [
                        "cooldown"
                    ],
                    "common_phrases": [
                        "on CD"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Время, которое необходимо подождать перед повторным использованием способности или предмета; сокращение от кулдаун."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кулдаун",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "откат",
                                "target_lang_sense_clarification": "время перезарядки"
                            },
                            {
                                "target_lang_word": "КД",
                                "target_lang_sense_clarification": "аббревиатура в играх"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e510f614-27c5-3831-8697-86213a846bed",
                    "sense_definition": "To wear clothing typically associated with the opposite sex; an initialism of <w>cross-dress</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By now I did not feel right without a bra and panties whenever I <w>CD'ed</w>.",
                            "target_lang_translations": {
                                "ru": "К тому времени я уже не чувствовал себя нормально без бюстгальтера и трусиков, когда <w>переодевался</w>."
                            }
                        },
                        {
                            "text": "He began to <w>CD</w> in private before gaining the confidence to go out.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>заниматься кроссдрессингом</w> дома, прежде чем набрался смелости выйти на улицу."
                            }
                        }
                    ],
                    "synonyms": [
                        "cross-dress"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used within specific communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Носить одежду, обычно ассоциирующуюся с противоположным полом; сокращение от кроссдрессинг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься кроссдрессингом",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "переодеваться",
                                "target_lang_sense_clarification": "в одежду другого пола"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}