                                "target_lang_sense_clarification": "Gedrag dat ergernis opwekt."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70e079fd-3322-3801-8b42-de5e05c1ce88",
                    "sense_definition": "Present participle and gerund of <w>antagonize</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hostile_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is constantly <w>antagonizing</w> his coworkers by questioning every decision they make.",
                            "target_lang_translations": {
                                "nl": "Hij is constant zijn collega's aan het <w>irriteren</w> door elke beslissing die ze nemen in twijfel te trekken."
                            }
                        },
                        {
                            "text": "Stop <w>antagonizing</w> the dog if you do not want it to bark at you.",
                            "target_lang_translations": {
                                "nl": "Stop met het <w>provoceren</w> van de hond als je niet wilt dat hij naar je blaft."
                            }
                        }
                    ],
