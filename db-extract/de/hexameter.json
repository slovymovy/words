                ],
                "senses": [
                    {
                        "sense_id": "94bf7b5e-a60d-32a3-b131-e41494ec0d43",
                        "entry_id": "efc2b5a8-ca9d-38a6-a1a4-ac5371cc764d",
                        "glosses": [
                            "antiker Vers, der aus sechs Daktylen oder Spondeen besteht, wobei der letzte um eine Silbe gekürzt (katalektisch) ist"
                        ],
                        "tags": [
                            "Metrik"
                        ],
                        "examples": [
                            {
                                "example_id": "e3827030-bab1-4fdd-97b7-397c6cab620d",
                                "sense_id": "94bf7b5e-a60d-32a3-b131-e41494ec0d43",
                                "text": "Die homerischen Epen sind in Hexametern verfasst."
                            },
                            {
                                "example_id": "db4b6b9f-aa4c-47a6-8294-1f596cc9fbc2",
                                "sense_id": "94bf7b5e-a60d-32a3-b131-e41494ec0d43",
                                "text": "Ein Hexameter und ein Pentameter bilden ein elegisches Distichon."
                            },
                            {
                                "example_id": "96a4b299-d70c-460f-a2d7-35f737e7ae8d",
                                "sense_id": "94bf7b5e-a60d-32a3-b131-e41494ec0d43",
                                "text": "„Die katholische Kirche legte im frühen Mittelalter einen solchen Ton gesetzlich fest, und das Orakel von Delphi war seinerseits an Hexameter gebunden, und diese waren noch dazu vertont.“"
                            },
                            {
                                "example_id": "0a646ee5-f3b8-4303-b1be-624d496eb60a",
                                "sense_id": "94bf7b5e-a60d-32a3-b131-e41494ec0d43",
                                "text": "„Ich fragte sie, was sie wolle, und sie antwortete mir in lateinischen Hexametern.“"
                            },
                            {
                                "example_id": "b770c5c5-d57d-4e83-af2b-eacbd0d8e4d6",
                                "sense_id": "94bf7b5e-a60d-32a3-b131-e41494ec0d43",
                                "text": "„Das Lateinische beherrschte er in Wort und Schrift bald in solcher Perfektion, daß er 1659 anläßlich einer Schulfeier ein Pfingstgedicht von 300 Hexametern an Stelle eines erkrankten Mitschülers in nur einem Vormittag niederschrieb und unter dem Beifall der Lehrer vortrug.“"
                            },
                            {
                                "example_id": "17db0eb8-bf42-450e-9ec3-c78ff95ea58b",
                                "sense_id": "94bf7b5e-a60d-32a3-b131-e41494ec0d43",
                                "text": "„Der »Cyrus« ist ein Heldenepos in daktylischen Hexametern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdb2af5a-144a-4ba4-bd49-e3d744007d54",
