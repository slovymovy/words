                                                "text": "Mit seiner bitterlichen Reaktion stieß er auf Unverständnis."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "560a1937-f019-39ca-ba8d-91fcc20965a4",
