{
    "word_family": [
        "wave",
        "waviness",
        "wavily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3e4c8739-28ac-3b3c-9acc-734d6d8e1e99",
                    "sense_definition": "Having wave-like shapes, curves, or bends on its border, surface, or structure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has beautiful <w>wavy</w> hair that falls naturally over her shoulders.",
                            "target_lang_translations": {
                                "ru": "У нее красивые <w>волнистые</w> волосы, которые естественно спадают на плечи."
                            }
                        },
                        {
                            "text": "The artist drew a <w>wavy</w> line across the canvas to represent the rolling hills.",
                            "target_lang_translations": {
                                "ru": "Художник провел <w>волнообразную</w> линию по холсту, чтобы изобразить пологие холмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiggly"
                    ],
                    "common_phrases": [
                        "wavy hair",
                        "wavy line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий волнообразную форму, изгибы или неровности на поверхности, краях или в структуре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волнистый",
                                "target_lang_sense_clarification": "о волосах, линиях, поверхностях"
                            },
                            {
                                "target_lang_word": "волнообразный",
                                "target_lang_sense_clarification": "о форме или структуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e2920b1-7278-3e80-90d9-237ed7e97552",
                    "sense_definition": "Rising, swelling, or moving in waves, especially referring to water or the sea.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat struggled to navigate through the <w>wavy</w> sea during the storm.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка с трудом пробиралась сквозь <w>волнующееся</w> море во время шторма."
                            }
                        },
                        {
                            "text": "Strong winds created a <w>wavy</w> surface on the usually calm lake.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер создал <w>рябь</w> на поверхности обычно спокойного озера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wavy water",
                        "wavy sea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимающийся волнами, волнующийся или движущийся волнами (особенно о воде или море)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волнующийся",
                                "target_lang_sense_clarification": "о море или воде"
                            },
                            {
                                "target_lang_word": "бурный",
                                "target_lang_sense_clarification": "о море с волнами"
                            },
                            {
                                "target_lang_word": "колеблющийся",
                                "target_lang_sense_clarification": "о водной глади"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51b0d669-e9fb-3e47-a831-eaeb7de19b65",
                    "sense_definition": "Cool, stylish, and fashionable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He showed up to the party wearing a really <w>wavy</w> outfit that everyone admired.",
                            "target_lang_translations": {
                                "ru": "Он пришел на вечеринку в очень <w>стильном</w> наряде, которым все восхищались."
                            }
                        },
                        {
                            "text": "That new song has a very <w>wavy</w> beat that makes you want to dance.",
                            "target_lang_translations": {
                                "ru": "У этой новой песни очень <w>качающий</w> бит, под который хочется танцевать."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used to describe something cool or fashionable"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крутой, стильный, модный (молодежный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стильный",
                                "target_lang_sense_clarification": "модный, крутой"
                            },
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "о стиле, музыке, одежде"
                            },
                            {
                                "target_lang_word": "вайбовый",
                                "target_lang_sense_clarification": "создающий классную атмосферу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb20b8ef-4b51-3c8c-b2ff-0096a5e3530e",
                    "sense_definition": "Intoxicated or drunk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After having a few drinks at the bar, he started feeling a bit <w>wavy</w>.",
                            "target_lang_translations": {
                                "ru": "Выпив несколько порций в баре, он начал чувствовать себя немного <w>пьяным</w>."
                            }
                        },
                        {
                            "text": "They got completely <w>wavy</w> celebrating his promotion last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером они изрядно <w>напились</w>, празднуя его повышение."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "meaning drunk or high"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пьяный, находящийся под воздействием алкоголя или веществ (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяный",
                                "target_lang_sense_clarification": "навеселе"
                            },
                            {
                                "target_lang_word": "тепленький",
                                "target_lang_sense_clarification": "слегка пьяный, подшофе"
                            },
                            {
                                "target_lang_word": "улетевший",
                                "target_lang_sense_clarification": "в состоянии опьянения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65ce5708-02da-3af9-9125-d6e8366e27f9",
                    "sense_definition": "An alternative spelling of <w>wavey</w>, referring to a wild goose, especially the snow goose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fauna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters spotted a flock of blue <w>wavies</w> flying south for the winter.",
                            "target_lang_translations": {
                                "ru": "Охотники заметили стаю голубых <w>гусей</w>, летящих на юг на зимовку."
                            }
                        },
                        {
                            "text": "In the northern regions, the white <w>wavy</w> is a common sight during migration season.",
                            "target_lang_translations": {
                                "ru": "В северных регионах белый <w>гусь</w> — обычное явление в сезон миграции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blue wavy",
                        "white wavy"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily Canadian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова wavey, означающего дикого гуся (особенно белого гуся)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "белый гусь",
                                "target_lang_sense_clarification": "дикая птица семейства утиных"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}