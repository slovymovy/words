                    {
                        "sense_id": "975c0a6d-90d3-340f-906a-5ff0bf8135c1",
                        "entry_id": "74604a77-e979-33e8-8eed-76a54c945ab7",
                        "glosses": [
                            "iemand die met zakendoen zijn brood verdient"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "6d5afa02-079c-4cf7-a614-ccc9814fc3ce",
                                "sense_id": "975c0a6d-90d3-340f-906a-5ff0bf8135c1",
                                "text": "Hij is een gewiekst zakenman."
                            },
                            {
                                "example_id": "78be1b1b-fea3-44ed-974e-5899e03dc9f2",
                                "sense_id": "975c0a6d-90d3-340f-906a-5ff0bf8135c1",
                                "text": "Maar zoals het er nu voor stond, moesten ze dus wachten tot die onbekwame zakenman zijn schaapjes op het droge had? Dan liepen ze het risico dat ze lang moesten wachten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6480f265-730d-4ad4-ae55-b180bec5f647",
                        "source_entry_id": "74604a77-e979-33e8-8eed-76a54c945ab7",
                        "source_sense_id": "975c0a6d-90d3-340f-906a-5ff0bf8135c1",
                        "source_sense_description": "iemand die met zakendoen zijn brood verdient",
                        "target_lang_word": "Geschäftsmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschäftsmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                        "entry_id": "7c242cc5-f4be-31e8-bb88-2358c33eb1df",
                                        "glosses": [
                                            "Person, die ein kommerzielles Geschäft (Unternehmen) leitet oder Geschäfte tätigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de02cab0-c4aa-427a-8f2d-69464ef5dd3e",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "Er gab seinen Beruf vage als Geschäftsmann an."
                                            },
                                            {
                                                "example_id": "afc69888-3207-41d4-91fe-238067f99e4b",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "„Großvater ist Geschäftsmann und weiß, was der Vater will.“"
                                            },
                                            {
                                                "example_id": "369f99f2-7b0e-4f36-bbe8-a6ea16a1b24b",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "„Als hartnäckiger Geschäftsmann denkt der neue Präsident langfristig.“"
                                            },
                                            {
                                                "example_id": "40c4a1c8-0257-410f-a43e-482676d327c7",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "„Auch Sung war eher ein Sammler als ein Geschäftsmann.“"
                                            },
                                            {
                                                "example_id": "977dea58-381b-42c5-a4be-fa21fee3e456",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "„Haile ist mittlerweile auch einer der erfolgreichsten Geschäftsmänner des Landes.“"
                                            },
                                            {
                                                "example_id": "396daa45-9ba4-43bf-b54d-ac64dfd0c420",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "„Um diese Geschäfte abzuwickeln, gründeten viele russische Geschäftsleute sogar eigene Firmen in der Türkei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98419964-192c-43dd-8f9c-ed91124b6342",
                        "source_entry_id": "74604a77-e979-33e8-8eed-76a54c945ab7",
                        "source_sense_id": "975c0a6d-90d3-340f-906a-5ff0bf8135c1",
                        "source_sense_description": "iemand die met zakendoen zijn brood verdient",
                        "target_lang_word": "businessman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
