                    {
                        "sense_id": "40535d40-39e2-3da6-8ba6-9d76707a6566",
                        "entry_id": "5fa291f4-eb25-3031-9c01-a87c556bf699",
                        "glosses": [
                            "Of, related to, encountered in, or derived from experience."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9c6b7c8-16bb-45df-86ae-e7aa9c56f81e",
                                "sense_id": "40535d40-39e2-3da6-8ba6-9d76707a6566",
                                "text": "Near-synonym: empirical"
                            },
                            {
                                "example_id": "b8990c6e-35cb-4d92-838e-5e2991baf8b4",
                                "sense_id": "40535d40-39e2-3da6-8ba6-9d76707a6566",
                                "text": "Atheists argue that there is no experiential confirmation for the existence of a god."
                            },
                            {
                                "example_id": "40b47fb0-6562-421b-afd5-00c495ba3cf3",
                                "sense_id": "40535d40-39e2-3da6-8ba6-9d76707a6566",
                                "text": "Each color has a unique experiential quality."
                            },
                            {
                                "example_id": "0c73dfe9-a082-454d-9f48-14caabfd3425",
                                "sense_id": "40535d40-39e2-3da6-8ba6-9d76707a6566",
                                "text": "The changes you're talking about here are experiential."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00f28724-36b5-4932-a719-cd642501c942",
                        "source_entry_id": "5fa291f4-eb25-3031-9c01-a87c556bf699",
