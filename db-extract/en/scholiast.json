                        "glosses": [
                            "A scholar who writes commentary on the works of an author, especially one of the ancient commentators on classical authors."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00db4dc5-4533-4067-a6ff-c28705599904",
                                "sense_id": "1211fcb8-3f94-34b9-aca8-6b451ca5e9b3",
                                "text": "[N]o pedantic quotations from Talmudists and scholiasts […] ever marred the effect of his grave and temperate discourses."
                            },
                            {
                                "example_id": "11a39e63-670c-4b37-8fb4-aaa5f8048909",
                                "sense_id": "1211fcb8-3f94-34b9-aca8-6b451ca5e9b3",
                                "text": "[L]ike it or not, I was caught up once more in the scholiast’s game, paring popular notions of the ‘queer’ and ‘unearthly’ from notions of the ‘monstrous’."
                            }
                        ]
                    }
