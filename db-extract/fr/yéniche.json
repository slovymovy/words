                                        "examples": [
                                            {
                                                "example_id": "86fd599c-3dfe-4c54-973d-76bd03b824b1",
                                                "sense_id": "8509f4ac-ce90-3f3f-9594-e1215614f8ba",
                                                "text": "Er wollte ein jenisches Mädchen heiraten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "645e976f-9e90-37dd-9f8c-2ff46097ba2f",
