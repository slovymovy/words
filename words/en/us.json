                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "c2f2b1e4-afa3-3628-8214-8d0216b369fc",
                    "sense_definition": "Designates the speaker and others as belonging to a specific category.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Life is often hard for <w>us</w> students during exam week.",
                            "target_lang_translations": {
                                "ru": "Жизнь часто тяжела для <w>нас</w>, студентов, во время экзаменационной недели.",
                                "es": "La vida suele ser difícil para <w>nosotros los</w> estudiantes durante la semana de exámenes."
                            }
                        },
                        {
                            "text": "They do not understand the problems faced by <w>us</w> locals.",
                            "target_lang_translations": {
                                "ru": "Они не понимают проблем, с которыми сталкиваемся <w>мы</w>, местные жители.",
                                "es": "No entienden los problemas a los que nos enfrentamos <w>nosotros los</w> lugareños."
                            }
