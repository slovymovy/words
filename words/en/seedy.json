{
    "word_family": [
        "seed",
        "seedling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd1e6900-00ea-3484-a155-bae8c7356084",
                    "sense_definition": "Containing or full of seeds.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "literal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>seedy</w> pomegranate was difficult to eat because of all the hard bits.",
                            "target_lang_translations": {
                                "cs": "To <w>jadérnaté</w> granátové jablko se jedlo obtížně kvůli všem těm tvrdým kouskům."
                            }
                        },
                        {
                            "text": "Some people prefer to remove the <w>seedy</w> center of the cucumber before slicing it.",
                            "target_lang_translations": {
                                "cs": "Někteří lidé dávají před krájením přednost odstranění <w>jadérnatého</w> středu okurky."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seedy fruit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Obsahující mnoho semen nebo plný semen."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jadérnatý",
                                "target_lang_sense_clarification": "obsahující mnoho semen (např. ovoce)"
                            },
                            {
                                "target_lang_word": "plný semen",
                                "target_lang_sense_clarification": "doslovný popis stavu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a894b8ac-e844-3782-a490-b986aae0f76f",
                    "sense_definition": "Shabby, run-down, or disreputable, often associated with dishonest or illegal activities.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disreputable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective followed the suspect into a <w>seedy</w> bar on the edge of town.",
                            "target_lang_translations": {
                                "cs": "Detektiv sledoval podezřelého do <w>pochybného</w> baru na kraji města."
                            }
                        },
                        {
                            "text": "He avoided the <w>seedy</w> part of the city where crime was common.",
                            "target_lang_translations": {
                                "cs": "Vyhýbal se <w>zpustlé</w> části města, kde byla kriminalita běžná."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleazy"
                    ],
                    "common_phrases": [
                        "seedy bar",
                        "seedy neighborhood"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ošuntělý, zchátralý nebo pochybný, často spojovaný s nečestnou či nelegální činností."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pochybný",
                                "target_lang_sense_clarification": "vyvolávající podezření, nečestný"
                            },
                            {
                                "target_lang_word": "ošuntělý",
                                "target_lang_sense_clarification": "vypadající zanedbaně, zchátrale"
                            },
                            {
                                "target_lang_word": "zpustlý",
                                "target_lang_sense_clarification": "v morálním úpadku nebo zanedbaném stavu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1540303e-710b-37bf-8dc4-ba88d57792a5",
                    "sense_definition": "Feeling unwell, infirm, or in poor physical condition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unwell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have been feeling a bit <w>seedy</w> all morning and decided to stay in bed.",
                            "target_lang_translations": {
                                "cs": "Celé dopoledne se cítím trochu <w>indisponovaně</w>, a tak jsem se rozhodl zůstat v posteli."
                            }
                        },
                        {
                            "text": "She looked quite <w>seedy</w> after working long hours without any rest.",
                            "target_lang_translations": {
                                "cs": "Vypadala po dlouhých hodinách práce bez odpočinku dost <w>sešle</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Cítící se špatně, indisponovaný nebo ve špatném fyzickém stavu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "indisponovaný",
                                "target_lang_sense_clarification": "necítící se dobře, oslabený"
                            },
                            {
                                "target_lang_word": "sešlý",
                                "target_lang_sense_clarification": "fyzicky vyčerpaný nebo vypadající nezdravě"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}