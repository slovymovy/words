                        "glosses": [
                            "одна порция нюхательного табака; понюшка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25929e3c-8256-46b3-81cc-dfbbfe93153d",
                                "sense_id": "6f8dbf5a-a06e-3994-8a06-73b42a66bd69",
                                "text": "Ермолов вынул тремя пальцами из тавлинки понюх желтоватого табаку и грубо затолкал в обе ноздри."
                            }
                        ]
                    },
                    {
                        "sense_id": "2be1f328-9651-3862-a8b9-e38638694b75",
                        "entry_id": "688ab235-4b4a-3704-9088-ca8d5e8c6827",
                        "glosses": [
                            "однократное вдыхание (обычно нюхательного табака)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "92359eeb-e945-3c7d-9735-19d7cfc547eb",
                        "entry_id": "688ab235-4b4a-3704-9088-ca8d5e8c6827",
                        "glosses": [
                            "перен. малая порция чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c4ea36d-a2a5-429a-bb37-77119497a728",
                                "sense_id": "92359eeb-e945-3c7d-9735-19d7cfc547eb",
                                "text": "К тому же нести бутылку домой — самому на понюх не достанется."
                            }
                        ]
                    }
