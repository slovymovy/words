            {
                "entry_id": "7f4bdf38-6e78-3eaf-a36a-ec2cef05443f",
                "word": "duizenden",
                "pos": "num",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d4eb389d-049b-3030-b471-2f54f8d4e25a",
                        "entry_id": "7f4bdf38-6e78-3eaf-a36a-ec2cef05443f",
                        "glosses": [
                            "een niet nader bepaald getal in de orde van 2.000 tot 10.000"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f100f0-e766-498c-8dde-75e1241ea889",
                                "sense_id": "d4eb389d-049b-3030-b471-2f54f8d4e25a",
                                "text": "Er zijn in Japan duizenden mensen omgekomen."
                            },
                            {
                                "example_id": "48a91e67-afc4-4556-8b36-b61b4ef23aa4",
                                "sense_id": "d4eb389d-049b-3030-b471-2f54f8d4e25a",
                                "text": "Toen de deuren van de basiliek van de stad vanochtend om zes uur opengingen, hadden zich al enige duizenden mensen verzameld. Verwacht wordt dat rond de honderdduizend mensen de kerk zullen aandoen. De organisatoren verwachten zelfs bussen uit Slovenië, Polen en Libanon."
                            },
                            {
                                "example_id": "41c202fa-9684-49dd-bd07-6d664e289717",
                                "sense_id": "d4eb389d-049b-3030-b471-2f54f8d4e25a",
                                "text": "En na de wedstrijd veranderde het centrum in een groot feest. Duizenden mensen verzamelden zich op De Brink in de binnenstad. \"We gaan Europa in\", klonk het massaal. Er werd ook vuurwerk afgestoken."
                            }
                        ]
                    },
                    {
                        "sense_id": "90ed6ee8-a663-3c18-a7eb-afae8f338c0a",
                        "entry_id": "7f4bdf38-6e78-3eaf-a36a-ec2cef05443f",
                        "glosses": [
                            "een heel groot aantal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83f772c-6f9d-4402-a474-a3d662ef6b8b",
                                "sense_id": "90ed6ee8-a663-3c18-a7eb-afae8f338c0a",
                                "text": "Toen ik Acke daar neerplantte, verklaarde ik wereldwijs dat ik al die oude films al duizenden keren had gezien toen ik klein was."
                            },
                            {
                                "example_id": "92922058-937f-4f6e-a153-ebb4e175ae91",
                                "sense_id": "90ed6ee8-a663-3c18-a7eb-afae8f338c0a",
                                "text": "Je moest je ook levensvormen kunnen voorstellen die op aardse mensen leken, soms in het stadium van het stenen tijdperk, soms duizenden jaren voor op ons in de technische ontwikkeling."
                            }
                        ]
                    }
                ],
