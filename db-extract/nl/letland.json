                                        "examples": [
                                            {
                                                "example_id": "1cd6edef-5fe5-458c-a80c-c764d507c14b",
                                                "sense_id": "0603e3bf-b29b-3ed1-90c0-3d54e6438ba8",
                                                "text": "Lettland zählt zum Baltikum."
                                            },
                                            {
                                                "example_id": "1e4dbdc1-8ec8-432b-a20e-08cc3179f728",
                                                "sense_id": "0603e3bf-b29b-3ed1-90c0-3d54e6438ba8",
                                                "text": "Lettlands Hauptstadt ist Riga."
                                            },
                                            {
                                                "example_id": "52ef8755-4186-417d-9904-218326c0110c",
                                                "sense_id": "0603e3bf-b29b-3ed1-90c0-3d54e6438ba8",
                                                "text": "Um das Lettland der Künstler zu finden, musst Du an den richtigen Stellen suchen."
                                            },
                                            {
                                                "example_id": "8f0dab6e-b7f3-40cc-91c4-7b7aa21c40dd",
                                                "sense_id": "0603e3bf-b29b-3ed1-90c0-3d54e6438ba8",
                                                "text": "„Sie fuhr nach Lettland zu meiner Frau, die damals dort studierte, und wohnte mit ihr in einem winzigen Zimmerchen unter unmöglichen Bedingungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
