                                "target_senses": [
                                    {
                                        "sense_id": "2abd643e-85b2-32a2-ae90-79017f892a6b",
                                        "entry_id": "573cee83-b08e-3c0b-a632-55ca91e1b38a",
                                        "glosses": [
                                            "Where ever; an emphatic form of where."
                                        ],
                                        "tags": [
                                            "interrogative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bc16d98-b95f-474c-b742-dfc9f1ca23f8",
                                                "sense_id": "2abd643e-85b2-32a2-ae90-79017f892a6b",
                                                "text": "Wherever have you been all my life?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29a9f886-5a0f-3764-b955-676127fd9826",
                                        "entry_id": "573cee83-b08e-3c0b-a632-55ca91e1b38a",
                                        "glosses": [
                                            "In, at or to any place that one likes or chooses."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53770573-da81-4fde-a230-6fa9ee3991e5",
                                                "sense_id": "29a9f886-5a0f-3764-b955-676127fd9826",
                                                "text": "I don't care what you do with it; just put it wherever."
                                            },
                                            {
                                                "example_id": "ab1dc5fa-1522-404d-86b8-0a10d2336602",
                                                "sense_id": "29a9f886-5a0f-3764-b955-676127fd9826",
                                                "text": "Where do you want to have lunch? — Wherever; I don't mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8063fff-4914-3d8b-9eef-5b7b0a32f75b",
                                        "entry_id": "573cee83-b08e-3c0b-a632-55ca91e1b38a",
                                        "glosses": [
                                            "The place (no matter where) in, at or to which."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f292bb72-e48d-4ac0-8a4d-3e93d8a43bba",
                                                "sense_id": "a8063fff-4914-3d8b-9eef-5b7b0a32f75b",
                                                "text": "He's back from wherever he's been hiding."
                                            },
                                            {
                                                "example_id": "41ab93e3-6a09-4a01-95c2-e79d9f386ba1",
                                                "sense_id": "a8063fff-4914-3d8b-9eef-5b7b0a32f75b",
                                                "text": "Go home to wherever you belong."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wherever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9ec93c2-a000-3b63-8e35-fbdc8f67f982",
                                        "entry_id": "f17f88e2-29a8-363f-87be-2be1800e9446",
                                        "glosses": [
                                            "Regardless of the place in, at or to which."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ee73031-546e-40f1-bbe4-61dc153cfe94",
                                                "sense_id": "a9ec93c2-a000-3b63-8e35-fbdc8f67f982",
                                                "text": "Wherever you go, I’ll find you."
                                            },
                                            {
                                                "example_id": "6a5341da-22df-49d7-9b63-b1bcfb87e1b1",
                                                "sense_id": "a9ec93c2-a000-3b63-8e35-fbdc8f67f982",
                                                "text": "Henceforth, wherever thou may’st roam,\n⁠My blessing, like a line of light,\n⁠Is on the waters day and night,\nAnd like a beacon guards thee home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd8bda4b-459d-3fa8-aa31-6e3056b0b916",
                                        "entry_id": "f17f88e2-29a8-363f-87be-2be1800e9446",
                                        "glosses": [
                                            "In, at or to any place (that); anywhere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f35be933-75fb-4e0d-b298-e1fa6ec48fd1",
                                                "sense_id": "dd8bda4b-459d-3fa8-aa31-6e3056b0b916",
                                                "text": "You can sit wherever you like."
                                            },
                                            {
                                                "example_id": "6f569491-b01c-4111-8957-9d07fff74c3f",
                                                "sense_id": "dd8bda4b-459d-3fa8-aa31-6e3056b0b916",
                                                "text": "I'd follow you wherever you went."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bdc204a-fed4-328d-b908-a630125b9dd9",
                                        "entry_id": "f17f88e2-29a8-363f-87be-2be1800e9446",
                                        "glosses": [
                                            "In, at or to all places or situations (that); everywhere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca32ef76-f147-450c-b3ee-38bf2ff13a11",
                                                "sense_id": "6bdc204a-fed4-328d-b908-a630125b9dd9",
                                                "text": "Add quotations wherever they are needed."
                                            },
                                            {
                                                "example_id": "9f29b80f-9bd3-43ae-889f-a6cde5857382",
                                                "sense_id": "6bdc204a-fed4-328d-b908-a630125b9dd9",
                                                "text": "I see mistakes wherever I look."
                                            },
                                            {
                                                "example_id": "6ac77e1f-a7cb-4076-ac3b-03d7f45f094d",
                                                "sense_id": "6bdc204a-fed4-328d-b908-a630125b9dd9",
                                                "text": "Our charity has limited funds, but we help wherever we can."
                                            },
                                            {
                                                "example_id": "156f4937-c6aa-4434-b1c3-cb1f200e12ae",
                                                "sense_id": "6bdc204a-fed4-328d-b908-a630125b9dd9",
                                                "text": "If the afternoon was fine they strolled together in the park, very slowly, and with pauses to draw breath wherever the ground sloped upward. The slightest effort made the patient cough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0302768d-0bab-3e35-a293-4c57d15908fd",
                                        "entry_id": "f17f88e2-29a8-363f-87be-2be1800e9446",
                                        "glosses": [
                                            "Used to show that one does not know where someone or something is located."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d4371f7-fc91-401c-9084-65659ea3d028",
                                                "sense_id": "0302768d-0bab-3e35-a293-4c57d15908fd",
                                                "text": "She lives in Puddletown, wherever that is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
