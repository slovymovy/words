                "senses": [
                    {
                        "sense_id": "adb2475c-797c-37ea-b349-68306a2a07c4",
                        "entry_id": "e508a9cb-4b76-3605-aa87-4ec3223c5f6c",
                        "glosses": [
                            "Séparer ce qui était ajointé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "119b1f99-5f34-41c3-a852-7ecd31eecf7b",
                                "sense_id": "adb2475c-797c-37ea-b349-68306a2a07c4",
                                "text": "Le temps de l’Apologia est donc toujours « out of joint », comme le dit le héros de Shakespeare, car il appartient précisément à l’autobiographie spirituelle de « désajointer » puis de « réajointer » les deux bouts, de faire coïncider à nouveau l’origine et l’arrivée."
                            },
                            {
                                "example_id": "757e55ad-123b-4bc4-a569-f64c26d75acb",
                                "sense_id": "adb2475c-797c-37ea-b349-68306a2a07c4",
                                "text": "Cyborg est nécessairement désajointé, recomposé, de guingois."
                            }
                        ]
                    }
