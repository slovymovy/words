                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "70a5f13a-14c8-4df1-a466-f94729504eb3",
                                "sense_id": "f607da5a-303c-3f53-a3b8-d212705e4c23",
                                "text": "The twin institutions of mahdist jihadism and radical puritanical sufism"
                            },
                            {
                                "example_id": "26d6daed-ab61-40b0-ae36-d62d17364397",
                                "sense_id": "f607da5a-303c-3f53-a3b8-d212705e4c23",
                                "text": "Liberals rightly recoil from the constant pressure on Muslims to explain themselves and denounce jihadism or even islamism."
                            }
                        ]
