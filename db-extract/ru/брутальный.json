                            "short-form"
                        ],
                        "form": "брута́льны"
                    },
                    {
                        "form_id": "1cbdaadd-020f-4c76-81f0-0012ce45b71d",
                        "entry_id": "5222ed57-07d4-3075-8fbc-4ceda2adbb4f",
                        "tags": [
                            "comparative"
                        ],
                        "form": "брута́льнее"
                    },
                    {
                        "form_id": "c0605a2b-b231-4733-97dc-6d35d9d3550d",
                        "entry_id": "5222ed57-07d4-3075-8fbc-4ceda2adbb4f",
                        "tags": [
                            "comparative"
                        ],
                        "form": "брута́льней"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68bec9dd-9b33-3e94-8038-0f8bb2cc669e",
                        "entry_id": "5222ed57-07d4-3075-8fbc-4ceda2adbb4f",
                        "glosses": [
                            "книжн., неодобр. грубый или жестокий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "891fb8c3-95ba-43f2-b3b3-6363154e5f1b",
                                "sense_id": "68bec9dd-9b33-3e94-8038-0f8bb2cc669e",
                                "text": "Этот старый, заматерелый бурбон, от начала до конца прошедший всю школу брутальной военщины .."
                            },
                            {
                                "example_id": "200098d6-5df3-47dc-92e1-b639dd6a7671",
                                "sense_id": "68bec9dd-9b33-3e94-8038-0f8bb2cc669e",
                                "text": "Бесспорно: легче всего создать сильную власть, как произвольную, бюрократическую, централизованную, воинскую, полицейски брутальную."
                            }
                        ]
                    },
                    {
                        "sense_id": "6975e158-6b9a-3ded-8794-0e982cedba37",
                        "entry_id": "5222ed57-07d4-3075-8fbc-4ceda2adbb4f",
                        "glosses": [
                            "разг. подчёркнуто мужественный, прямолинейный, выражающий грубую силу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2671d245-8b13-461e-9337-624e343fb873",
                                "sense_id": "6975e158-6b9a-3ded-8794-0e982cedba37",
                                "text": "Брутальный бард, скончавшийся годом раньше и бывший лишь двумя годами старше, Высоцкий, тоже начался там же, в сталинской коммуналке, в городском перенаселенном дворе, куда возвращались амнистированные, принося барачные песни и лагерные апокрифы."
                            },
                            {
                                "example_id": "076f2de6-a0ec-4043-85fe-71680ad9ce0e",
                                "sense_id": "6975e158-6b9a-3ded-8794-0e982cedba37",
                                "text": "Воцарение варваров, начинающих творить свою брутальную, грубую красоту, совсем не утонченную, но несомненно более витальную, живую, может вселять надежды."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc56b770-5aa9-3d04-a58e-b326ff9c8b1b",
                        "entry_id": "5222ed57-07d4-3075-8fbc-4ceda2adbb4f",
                        "glosses": [
                            "муз. о поджанрах экстремального металла: доведённый до крайности в музыкальном плане"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a1bd3a2-3450-407e-ae7b-75a2628018bf",
                                "sense_id": "fc56b770-5aa9-3d04-a58e-b326ff9c8b1b",
                                "text": "Дети не могут быть расслабленными, если рядом из колонок ревёт брутальный дэт-металл, блэк-металл или фальцет пауэр-металл."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48b0be60-f678-4983-a2c1-64659a00196e",
                        "source_entry_id": "5222ed57-07d4-3075-8fbc-4ceda2adbb4f",
                        "target_lang_word": "brutal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brutal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef24ef8c-6c8b-3155-8895-09cf694f7023",
                                        "entry_id": "5652b834-a5de-3a2f-8cd8-c51a3e7fd642",
                                        "glosses": [
                                            "Savagely violent, vicious, ruthless, or cruel, often in an unintelligent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "531f2444-de68-4d60-9251-90cb6d356b4c",
                                                "sense_id": "ef24ef8c-6c8b-3155-8895-09cf694f7023",
                                                "text": "The game was brutal, but after a bloodbath he finally won."
                                            },
                                            {
                                                "example_id": "1771d234-88f8-4046-a43d-687bf2b3bcb1",
                                                "sense_id": "ef24ef8c-6c8b-3155-8895-09cf694f7023",
                                                "text": "What began as a zeitgeisty outlaw romp in the Uncool Britannia of the 1990s is now reborn as a scabrous and brutal black comedy about middle-aged male disappointment and fear of death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5322e8cc-fe14-31c8-9f30-fce10ae2217d",
                                        "entry_id": "5652b834-a5de-3a2f-8cd8-c51a3e7fd642",
                                        "glosses": [
                                            "Crude or unfeeling in manner or speech."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a18a900b-e848-36a1-92ea-b68865a9f22a",
                                        "entry_id": "5652b834-a5de-3a2f-8cd8-c51a3e7fd642",
                                        "glosses": [
                                            "Harsh; unrelenting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2790ecd-b7cf-349b-9634-72e1c6f88336",
                                        "entry_id": "5652b834-a5de-3a2f-8cd8-c51a3e7fd642",
                                        "glosses": [
                                            "Disagreeably precise or penetrating."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d56fb73c-e442-31f0-9945-c54eaf229070",
                                        "entry_id": "5652b834-a5de-3a2f-8cd8-c51a3e7fd642",
                                        "glosses": [
