                "senses": [
                    {
                        "sense_id": "ac14e334-94e3-35b3-83f9-7fc020b3dcc9",
                        "entry_id": "d1177fe3-b1e2-3b58-b5f4-e830b11776e6",
                        "glosses": [
                            "Espèce de petit arbre de la famille des rutacées qui produit la mandarine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "525f080d-f68d-4b7c-bf12-6eb8ef346e20",
                                "sense_id": "ac14e334-94e3-35b3-83f9-7fc020b3dcc9",
                                "text": "Le mandarinier est beaucoup cultivé en Chine ; ses fruits sont offerts couramment en présents aux mandarins, d’où leur nom."
                            },
                            {
                                "example_id": "761979fd-0ec6-45fb-8f98-bcbd6c1708df",
                                "sense_id": "ac14e334-94e3-35b3-83f9-7fc020b3dcc9",
                                "text": "C'est ce qui fit qu'il ne vit pas qu'une forme agile les suivait, s'abritant dans les moindres recoins de la route, se blottissant dans un massif de maigres viornes, ou se logeant dans l'ombre portée des mandariniers hâves et pelés."
                            },
                            {
                                "example_id": "22702e45-643f-45ac-aa59-0deae1e0c7e9",
                                "sense_id": "ac14e334-94e3-35b3-83f9-7fc020b3dcc9",
                                "text": "Les mandariniers souffrent des mêmes problèmes climatiques et pédologiques que les caféiers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12ec662e-19dc-464c-bbdd-21fb045caa1c",
