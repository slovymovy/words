                "senses": [
                    {
                        "sense_id": "8201422c-89a1-37f4-a678-a3c3786de7fa",
                        "entry_id": "6acc7071-be96-3265-81f6-d0aaf541673e",
                        "glosses": [
                            "in einem grellleuchtenden, an Neonlicht erinnernden Farbton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96e1cb62-8d03-427a-831d-0d475686afbd",
                                "sense_id": "8201422c-89a1-37f4-a678-a3c3786de7fa",
                                "text": "„Als er den neonfarbenen Wolkenkratzer verlässt, sitzt ein schwarzweißes Mädchen auf seinem Motorrad und macht sich an den Kontrollen zu schaffen.“"
                            },
                            {
                                "example_id": "d1dfea1e-6f7a-4fee-93a4-4c72632b7c8d",
                                "sense_id": "8201422c-89a1-37f4-a678-a3c3786de7fa",
                                "text": "„Die Namensschilder der anderen sind auch neonfarben.“"
                            },
                            {
                                "example_id": "8e6868e0-6014-4c04-8a51-2366d2c12efd",
                                "sense_id": "8201422c-89a1-37f4-a678-a3c3786de7fa",
                                "text": "„Schmetterlinge kamen nicht. Auch keine neonfarbenen Libellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
