                                                "sense_id": "393a9bc1-e934-38d9-afd2-5140c3b5947e",
                                                "text": "Ich brauche etwas frische Luft, darum gehe ich jetzt nach draußen."
                                            },
                                            {
                                                "example_id": "12b0cd2c-b37e-41d0-ad05-f416079965cd",
                                                "sense_id": "393a9bc1-e934-38d9-afd2-5140c3b5947e",
                                                "text": "Warum? Darum!"
