                "senses": [
                    {
                        "sense_id": "33f24400-ed0f-38d4-80f4-bfb13ff41100",
                        "entry_id": "783e0bec-5493-358f-88ab-9671aa46e63e",
                        "glosses": [
                            "stechender, durch Ammoniak verursachter Geruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3b7b85-7933-4c81-b31f-f6263968c86b",
                                "sense_id": "33f24400-ed0f-38d4-80f4-bfb13ff41100",
                                "text": "„Die zu untersuchende Substanz wird zunächst nur mit Natronlauge behandelt und ggf. aufgekocht, bis kein Ammoniakgeruch mehr nachweisbar ist.“"
                            },
                            {
                                "example_id": "f0f8de9e-5682-4108-8707-05060e92377b",
                                "sense_id": "33f24400-ed0f-38d4-80f4-bfb13ff41100",
                                "text": "„Der Ammoniakgeruch von manchen Fischprodukten stammt aus der partiellen Hydrolyse von im Muskel abgelagertem Harnstoff zu Ammoniak und Kohlendioxid.“"
                            },
                            {
                                "example_id": "1af4aa38-bda0-4995-a3e9-56ff148f0598",
                                "sense_id": "33f24400-ed0f-38d4-80f4-bfb13ff41100",
                                "text": "„Ammoniak führt beim Einatmen zu einer Reizung der Atemwege. Sie sollten im Fall eines Auftretens von Ammoniakgeruch deshalb möglichst den entsprechenden Bereich verlassen und Ihre Mitmenschen auf die Gefahr hinweisen.“"
                            },
                            {
                                "example_id": "aff0dd47-59b4-479a-ad53-a740c0f0ea07",
                                "sense_id": "33f24400-ed0f-38d4-80f4-bfb13ff41100",
                                "text": "„Ammoniak ist ein farbloses, stechend riechendes Gas, welches in hoher Konzentration akute Vergiftungserscheinungen nach sich ziehen kann. Dieser sehr unangenehme Ammoniakgeruch deutet auf mangelnde Sauberkeit und Hygiene hin, ist jedoch harmloser Natur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
