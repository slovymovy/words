                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcddfbdc-ef91-4d1c-a31a-6badf2306706",
                                                "sense_id": "4458e6ac-216f-39cd-9e89-57604b878aa0",
                                                "text": "With a little forethought we'd have planned for this contingency and not been stuck here now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bdf0a9b-88be-3aee-9327-c600a89caee8",
