            {
                "entry_id": "59918153-99af-3241-84db-fa25db1a23f9",
                "word": "Jacquot",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "65ceae19-04a8-3a89-923a-bafc3ccea12b",
                        "entry_id": "59918153-99af-3241-84db-fa25db1a23f9",
                        "glosses": [
                            "Nom de famille français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8e73ca-142a-4f04-8ca9-6ba715d1674a",
                                "sense_id": "65ceae19-04a8-3a89-923a-bafc3ccea12b",
                                "text": "Benoît Jacquot, c’est un maître, une intelligence, un esthète, un charmeur d’acteurs, un fidèle bienveillant, un lecteur invétéré, une compagnie délicieuse, quelqu’un qui travaille, et moi j’aime ça."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "05bbcd75-0d70-3719-947e-1b6d025c5430",
                "word": "Jacquot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "248c50f8-fd56-4a47-8042-4fed8767947e",
