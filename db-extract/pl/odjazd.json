                        "glosses": [
                            "ruszenie w drogę, początek podróży jakimś środkiem lokomocji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd5c146-91d6-489d-a94a-1a0705bccd23",
                                "sense_id": "5f4d5f45-1ed5-3802-8ee0-ec246fe587b2",
                                "text": "Przed podróżą zawsze sprawdzam godzinę odjazdu pociągu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "42fde013-3e92-336e-b0d4-fff98235643f",
