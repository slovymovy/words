        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7ec6e918-c4a3-3738-ac41-1e9bfb1e5ed2",
                "word": "rhinoplasty",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c7db1b18-8768-4ab9-96c6-a918a3d2a717",
                        "entry_id": "7ec6e918-c4a3-3738-ac41-1e9bfb1e5ed2",
                        "tags": [
                            "plural"
                        ],
                        "form": "rhinoplasties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c7530dc-4e0f-3a32-b224-69b9e06640c2",
                        "entry_id": "7ec6e918-c4a3-3738-ac41-1e9bfb1e5ed2",
                        "glosses": [
                            "A type of plastic surgery that is used to improve the function (reconstructive surgery) or appearance (cosmetic surgery) of a person's nose."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ddda2b42-96ca-4a4c-bd51-1550afc9870b",
                                "sense_id": "2c7530dc-4e0f-3a32-b224-69b9e06640c2",
                                "text": "Dr. Sundine specializes in facelifts, necklifts and browlifting, eyelid surgery, as well as rhinoplasty, which involves both technically exacting skill and a keen eye for aesthetic balance."
                            },
                            {
                                "example_id": "2b59a77b-6253-4c40-8c85-0e6a2614933b",
                                "sense_id": "2c7530dc-4e0f-3a32-b224-69b9e06640c2",
                                "text": "Those can be signs of emotional immaturity, said Casas, a plastic surgeon in Chicago, Illinois. About 10 percent of her teenage rhinoplasty patients are boys."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6d28da8-16f8-353e-bd74-a3cb4d975021",
                        "entry_id": "7ec6e918-c4a3-3738-ac41-1e9bfb1e5ed2",
                        "glosses": [
                            "An instance of such surgery; one operation (procedure)."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "2174aeaa-32c5-47db-a534-e86a976e9fc3",
                                "sense_id": "f6d28da8-16f8-353e-bd74-a3cb4d975021",
                                "text": "Gone is the era of the cookie-cutter, ski jump nose. Today’s cosmetic doctors are approaching rhinoplasties with a more artistic, individualized approach, using new surgical and nonsurgical techniques to refine rather than revamp one of the most prominent features of the face."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b4d83e1-6f94-4b0c-acbf-13ea4ebd7a21",
                        "source_entry_id": "7ec6e918-c4a3-3738-ac41-1e9bfb1e5ed2",
                        "source_sense_description": "plastic surgery used to improve a person's nose",
