                "senses": [
                    {
                        "sense_id": "574fb731-e6f5-3f94-aaa6-31d2dfa9ffe4",
                        "entry_id": "4ed1265b-a393-344b-870d-b6f5b65374d5",
                        "glosses": [
                            "zware van rupsbanden voorziene machine om terreinen te egaliseren met behulp van een schuiver die stenen en aarde kan verplaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67398a22-bdc3-4696-b599-93c26e2f2039",
                                "sense_id": "574fb731-e6f5-3f94-aaa6-31d2dfa9ffe4",
                                "text": "Een bulldozer begint struiken omver te duwen en de modder naast de weg te egaliseren, zodat het verkeer wat ruimte krijgt."
                            },
                            {
                                "example_id": "d0d3b612-123e-406d-9d7b-a869434e5797",
                                "sense_id": "574fb731-e6f5-3f94-aaa6-31d2dfa9ffe4",
                                "text": "Met zijn ongeëvenaarde aanvallende kracht bracht hij een revolutie teweeg in het rugby. Tegenstanders ketsten simpelweg op hem af als Lomu, een menselijke bulldozer van 1,92 meter en 119 kilogram, op snelheid was gekomen – de bal losjes in een arm geklemd."
                            },
                            {
                                "example_id": "dd278243-91a3-4f0a-8604-93a6fb6bfebd",
                                "sense_id": "574fb731-e6f5-3f94-aaa6-31d2dfa9ffe4",
                                "text": "Ze was een menselijke bulldozer die een rechte lijn aanhield."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2d03b62-32f9-4acd-9a2e-750f3886b12a",
                        "source_entry_id": "4ed1265b-a393-344b-870d-b6f5b65374d5",
                        "source_sense_id": "574fb731-e6f5-3f94-aaa6-31d2dfa9ffe4",
                        "source_sense_description": "zware van rupsbanden voorziene machine om terreinen te egaliseren",
                        "target_lang_word": "Bulldozer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bulldozer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cb019fa-a1ee-32c5-9e2e-4e615f764ffb",
                                        "entry_id": "679e6ce8-1cfb-36bf-9a3c-3e9c5406b193",
                                        "glosses": [
                                            "Baumaschine zum Einebnen, Verschieben oder Lösen von Erdreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a08c100e-df15-4487-8720-2f1094410612",
                                                "sense_id": "6cb019fa-a1ee-32c5-9e2e-4e615f764ffb",
                                                "text": "Morgen kann der Bau beginnen, die Bulldozer stehen schon bereit."
                                            },
                                            {
                                                "example_id": "0751cd7a-2c0e-4bcf-b6cb-1394fe61305c",
                                                "sense_id": "6cb019fa-a1ee-32c5-9e2e-4e615f764ffb",
                                                "text": "„Bulldozer rollten die grünen Wälder auf und kehrten den Abfall zum Verbrennen zusammen.“"
                                            },
                                            {
                                                "example_id": "26e897d2-9308-4189-880d-4e1c1fd471d8",
                                                "sense_id": "6cb019fa-a1ee-32c5-9e2e-4e615f764ffb",
                                                "text": "„Als in den letzten Jahrzehnten den Bauern riesige Bulldozer übergeben wurden, teils damit sie ihren Spaß daran hatten, teils aus Idealismus, da griffen jene guten Männer diese alten Baureste an und machten sie der Erde gleich.“"
                                            },
                                            {
                                                "example_id": "45a09852-fc71-49d0-ac23-5418a63d5f6f",
                                                "sense_id": "6cb019fa-a1ee-32c5-9e2e-4e615f764ffb",
                                                "text": "„Der Bulldozer war inzwischen angekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12342977-a6d5-49b1-ab36-cc32db701f42",
                        "source_entry_id": "4ed1265b-a393-344b-870d-b6f5b65374d5",
                        "source_sense_id": "574fb731-e6f5-3f94-aaa6-31d2dfa9ffe4",
                        "source_sense_description": "zware van rupsbanden voorziene machine om terreinen te egaliseren",
