{
    "word_family": [
        "profond",
        "profondeur",
        "approfondir",
        "approfondissement"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "34709c4b-4088-3f7a-ab7f-249eb80d8ac0",
                    "sense_definition": "D'une manière complète, intime et intense, en parlant du sommeil, de la respiration ou d'un sentiment intime.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue journée de marche en montagne, l'enfant s'est endormi et dort <w>profondément</w>."
                        },
                        {
                            "text": "Avant de commencer l'exercice de méditation, le professeur demande à chacun de respirer <w>profondément</w>."
                        }
                    ],
                    "synonyms": [
                        "intensément",
                        "pleinement"
                    ],
                    "antonyms": [
                        "légèrement",
                        "superficiellement"
                    ],
                    "common_phrases": [
                        "dormir profondément",
                        "respirer profondément"
                    ]
                },
                {
                    "sense_id": "b8187213-2619-3f3f-84f8-ccc196c0460f",
                    "sense_definition": "À une grande profondeur physique, très avant à l'intérieur de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les racines de cet arbre centenaire s'enfoncent très <w>profondément</w> dans le sol pour trouver de l'eau."
                        },
                        {
                            "text": "Le chirurgien a retiré la flèche qui avait pénétré <w>profondément</w> dans les muscles de la cuisse."
                        }
                    ],
                    "antonyms": [
                        "superficiellement"
                    ],
                    "common_phrases": [
                        "s'enfoncer profondément"
                    ]
                },
                {
                    "sense_id": "1e49e953-95ee-3d6d-ad3f-a4f2eb33a62b",
                    "sense_definition": "Au plus haut point, à un degré extrême.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "degré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mauvaise nouvelle a <w>profondément</w> bouleversé toute la communauté du quartier."
                        },
                        {
                            "text": "Nous avons été <w>profondément</w> touchés par votre accueil chaleureux lors de notre visite."
                        }
                    ],
                    "synonyms": [
                        "extrêmement",
                        "foncièrement",
                        "infiniment",
                        "entièrement"
                    ],
                    "antonyms": [
                        "guère",
                        "peu"
                    ],
                    "common_phrases": [
                        "profondément touché",
                        "profondément déçu",
                        "profondément choqué"
                    ]
                }
            ]
        }
    ]
}