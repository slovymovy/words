                            {
                                "example_id": "bfa22357-bf9f-416b-92df-99234e4d3f3d",
                                "sense_id": "fa3ee6b8-a02a-3196-8e13-284f5d0e131f",
                                "text": "Wij konden."
                            },
                            {
                                "example_id": "f74ad5d0-8b11-4c6a-bd28-b528654f29e3",
                                "sense_id": "fa3ee6b8-a02a-3196-8e13-284f5d0e131f",
                                "text": "Jullie konden."
                            },
                            {
                                "example_id": "feabc058-d145-40fe-9536-0ac973b811dc",
                                "sense_id": "fa3ee6b8-a02a-3196-8e13-284f5d0e131f",
                                "text": "Zij konden."
                            },
                            {
                                "example_id": "a19bd1e4-fd41-4d11-9128-26621a199002",
                                "sense_id": "fa3ee6b8-a02a-3196-8e13-284f5d0e131f",
                                "text": "Toen ook de kinderen mijn rare plan accepteerden stonden alle lichten ineens op groen. De voorbereidingen konden beginnen."
                            },
                            {
                                "example_id": "e7a0f9e4-11ce-4679-950d-91f0ddd10f26",
                                "sense_id": "fa3ee6b8-a02a-3196-8e13-284f5d0e131f",
                                "text": "Zangeres Sita won meerdere TMF Awards en kijkt daar met plezier op terug: 'Ik stond er op het podium met Janet Jackson' Véras Fawaz (31) is regisseur van videoclips van artiesten als Joost Klein, Goldband en Bizzey. \"Ik ben opgegroeid in Stadskanaal, in het noorden. TMF was de plek waar we konden dromen van de wereld.\""
                            }
                        ]
                    }
