                "translations": [
                    {
                        "translation_id": "9a470b61-2e99-4edf-a8c8-0dcd59bb1f5d",
                        "source_entry_id": "0d9c735a-9697-3941-86fb-309e72c53bd4",
                        "source_sense_id": "272066af-7f1b-38b0-82d9-fd9da916cdc6",
