                                            {
                                                "example_id": "5c40ab7e-3bd1-4dd6-9057-4aaf9a92a43e",
                                                "sense_id": "a72f4926-3e11-3d30-a50e-e07062419b23",
                                                "text": "Besides the Animals which I have before mentioned, called by the Natives Kangooroo, or Kanguru […]."
                                            },
                                            {
                                                "example_id": "4b626bc2-5181-4708-ab91-fce18a4c54ad",
                                                "sense_id": "a72f4926-3e11-3d30-a50e-e07062419b23",
                                                "text": "In the woods are the kanguroo, the emu or cassowary, paroquets, and a variety of small birds […]."
                                            }
                                        ]
