                    },
                    {
                        "sense_id": "bda0ea6b-ea14-3d82-b1af-60190a7b92ba",
                        "entry_id": "3913bddf-ac1a-344a-96fb-6b15f3cb2618",
                        "glosses": [
                            "Designed to be used with two hands."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "95d075c8-15d7-43a0-9539-9201cfc613ec",
                                "sense_id": "bda0ea6b-ea14-3d82-b1af-60190a7b92ba",
                                "text": "Usually 2–3.5 metres in length, double-handed spinning rods are ideal for tackling slightly larger fish, including tailor, salmon (hahawai), trevally, flathead, snapper, barramundi, and Murray cod."
                            }
                        ]
                    },
                    {
                        "sense_id": "4648790c-9506-3841-a524-8d0fd98c6e16",
                        "entry_id": "3913bddf-ac1a-344a-96fb-6b15f3cb2618",
                        "glosses": [
                            "Involving two people."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3c8a0413-bcd8-4215-bfd3-2f1eb377dd69",
                                "sense_id": "4648790c-9506-3841-a524-8d0fd98c6e16",
                                "text": "The double-handed conversation had started to resemble a vaudeville act."
                            }
                        ]
                    },
                    {
                        "sense_id": "d62bf9c1-55fe-382c-8b4e-f4ef0db5fbff",
                        "entry_id": "3913bddf-ac1a-344a-96fb-6b15f3cb2618",
                        "glosses": [
                            "Serving two purposes or involving two approaches."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "63edb9b7-d003-417c-a85e-f6c6a238a479",
                                "sense_id": "d62bf9c1-55fe-382c-8b4e-f4ef0db5fbff",
                                "text": "A “double-handed” strategy is called for, where the authorities show a readiness to intervene in the short run to support the economy should it flag again, while at the same time providing economic agents with a sense of long-term direction and governance to re-establish confidence."
                            },
                            {
                                "example_id": "548f4749-2b22-4829-aca8-a9de5fa43139",
                                "sense_id": "d62bf9c1-55fe-382c-8b4e-f4ef0db5fbff",
                                "text": "Duchamp played a double-handed game, on one hand a public strategy on the other a clandestine commitment."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d14cd02-ac38-3e17-b297-3e412fb3fd6d",
                        "entry_id": "3913bddf-ac1a-344a-96fb-6b15f3cb2618",
                        "glosses": [
                            "deceitful; deceptive"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3af92045-5f95-4943-b9bc-72d384014ae2",
                                "sense_id": "2d14cd02-ac38-3e17-b297-3e412fb3fd6d",
                                "text": "Ibrahim, who entertains suspicions of this double-handed policy, compromises the Prince by every means in his power."
                            },
                            {
                                "example_id": "0fe2ce68-62bd-475d-9d4f-21c8d56e8b0d",
                                "sense_id": "2d14cd02-ac38-3e17-b297-3e412fb3fd6d",
                                "text": "While the idea of a “special post” reflects, as we have seen earlier, the double-handed way in which female professional labor was capitalized upon by the state, it also shows how the colonial bureaucracy used the vector of work to normalize a certain congruity between gender and citizenship."
                            }
                        ]
                    }
