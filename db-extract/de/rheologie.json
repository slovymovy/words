                                "target_senses": [
                                    {
                                        "sense_id": "f3718831-db48-3820-88bc-1643f7305a72",
                                        "entry_id": "2ca39d3e-f125-381a-be96-f7d4ff1fbc32",
                                        "glosses": [
                                            "The branch of physics that studies the deformation and flow of matter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40353913-d96e-498a-976e-b3992ffdc0f6",
                                                "sense_id": "f3718831-db48-3820-88bc-1643f7305a72",
                                                "text": "Curious as to whether other had explored the connection between Oreos and rheology, Owens found mention of a 2016 Princeton University study in which physicists first reported that indeed, when twisting Oreos by hand, the cream almost always came off on one wafer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6008eb7-0e9d-4ef4-9baa-477a33e08797",
                        "source_entry_id": "468eaff9-3f92-3817-891e-2d5647d1a24d",
                        "source_sense_id": "bc11e4f3-8df8-3f11-a8ca-b4c37022fd43",
                        "target_lang_word": "rhéologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhéologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c6de08d-726d-3f71-91ac-b62be40fe9ca",
                                        "entry_id": "d99e5c58-41d8-3b63-9330-e894c412d211",
                                        "glosses": [
                                            "Étude de la déformation et de l’écoulement de la matière sous l’effet d’une contrainte."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99627b05-75a0-4cd8-ac53-6f2fdd85cda4",
                                                "sense_id": "7c6de08d-726d-3f71-91ac-b62be40fe9ca",
                                                "text": "La rhéologie est une extension des disciplines telles que l’élasticité et la mécanique des fluides newtoniens, aux matériaux dont le comportement mécanique ne peut être décrit par ces théories classiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d3ecf06-23d8-3445-8fb2-63cc2ad6fa53",
                                        "entry_id": "d99e5c58-41d8-3b63-9330-e894c412d211",
                                        "glosses": [
                                            "Comportement rhéologique d’un matériau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37206c06-a7c0-48d3-b9c1-02448b86880b",
                                                "sense_id": "6d3ecf06-23d8-3445-8fb2-63cc2ad6fa53",
                                                "text": "En 1975, G.SUSS de la Technische Hochschule de Darmstadt, a repris l’étude de l’influence de la taille des particules de filler sur la rhéologie des mélanges filler-liant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
