                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "be906742-4840-4bed-8146-f5e50b07be4d",
                        "source_entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                        "source_sense_description": "Afro-Caribbean religion",
                        "target_lang_word": "voodoo",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voodoo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7d56c2b4-670c-3f47-8535-81df9dcda1d6",
                                        "entry_id": "4582e787-569a-35de-b227-f195c0e130cb",
                                        "glosses": [
                                            "een geloof dat inheems is in Haïti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "873e75da-0989-4702-858c-f0e0d1be324a",
                                                "sense_id": "7d56c2b4-670c-3f47-8535-81df9dcda1d6",
                                                "text": "Bij rituelen die gebruikelijk zijn in voodoo, worden soms kippen geslacht en dansen mensen tot zij in vervoering zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de4f8bab-5f02-4134-b2d8-c2a29da51c4e",
                        "source_entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                        "source_sense_description": "Afro-Caribbean religion",
                        "target_lang_word": "vaudou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaudou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a523bd3c-2342-3465-b75a-b1eb5c5a6de8",
                                        "entry_id": "94edfb57-a58c-32c0-a8f5-a6b08e96fd9b",
                                        "glosses": [
                                            "Religion animiste originaire de l’ancien royaume du Dahomey, répandue au Bénin et au Togo, aux Antilles et en Amérique latine, principalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439d663d-2c10-4f86-a824-3d01b0592e61",
                                                "sense_id": "a523bd3c-2342-3465-b75a-b1eb5c5a6de8",
                                                "text": "En Haïti, le vaudou mélange vaudou d’Afrique de l’Ouest et folklore religieux chrétien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6ae0c48-da9c-3c50-aef1-27fb549aaf76",
                                        "entry_id": "94edfb57-a58c-32c0-a8f5-a6b08e96fd9b",
                                        "glosses": [
                                            "Dieu de cette religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3cb547-5de0-4df5-a3b9-114c27579517",
                                                "sense_id": "d6ae0c48-da9c-3c50-aef1-27fb549aaf76",
                                                "text": "Un vaudou trônant en divinité principale dans un sanctuaire n’est plus qu’une divinité secondaire dans le temple voisin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9c15192-4c10-377a-ae08-b5b148835798",
                                        "entry_id": "94edfb57-a58c-32c0-a8f5-a6b08e96fd9b",
                                        "glosses": [
                                            "Adepte de ce culte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47391a0c-7fbf-4cfd-bf27-d34bc7cbbf92",
                                                "sense_id": "f9c15192-4c10-377a-ae08-b5b148835798",
                                                "text": "Les vaudous forment parmi les noirs [des États-Unis] une société secrète, une sorte de franc-maçonnerie placée sous l’invocation d’un être tout-puissant et surnaturel qui gouverne toutes les choses d’ici-bas."
                                            },
                                            {
                                                "example_id": "8bfac53c-a71f-40da-b7c6-81d083db69d9",
                                                "sense_id": "f9c15192-4c10-377a-ae08-b5b148835798",
                                                "text": "Les vaudoux parurent subitement pris de vertige et ils furent à l’instant agités de mouvements convulsifs dans lesquels la partie supérieure du corps, la tête et les épaules semblèrent se disloquer ; une exaltation fiévreuse s’empara de tous."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vaudou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f4e9662-48ac-3ea0-a239-00350c68794f",
                                        "entry_id": "e9fb0057-e6ce-37fa-b0f5-d25b167e075c",
                                        "glosses": [
                                            "Relatif à ce culte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "010c5d7a-f277-458c-b12e-55624c8ee6a3",
                                                "sense_id": "2f4e9662-48ac-3ea0-a239-00350c68794f",
                                                "text": "Le panthéon vaudou est avant tout constitué des forces de la nature."
                                            },
                                            {
                                                "example_id": "c46084ed-95ad-45fc-baee-b39380e454c6",
                                                "sense_id": "2f4e9662-48ac-3ea0-a239-00350c68794f",
                                                "text": "Une grande-prêtresse vaudoue."
                                            },
                                            {
                                                "example_id": "7f091b31-8e02-4f86-aa10-81f4d62ac8f9",
                                                "sense_id": "2f4e9662-48ac-3ea0-a239-00350c68794f",
                                                "text": "Peut-être la musique, qui rappelait quelque incantation vaudoue, agissait-elle sur les nerfs tendus, car nul ne parlait, ne touchait à son verre […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
