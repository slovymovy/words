                    },
                    {
                        "translation_id": "cb7fe927-4f89-4821-8cb2-166f6d52b09e",
                        "source_entry_id": "81951aaa-ddf0-3931-9aeb-ce6140cff700",
                        "source_sense_id": "29dd3923-fdcf-34d1-b08a-1275583744fe",
                        "source_sense_description": "Bauer, der einen kleinen (ertragsarmen/umsatzarmen) landwirtschaftlichen Betrieb hat",
                        "target_lang_word": "crofter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crofter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03040272-b184-3d43-b450-8d00feb61e9e",
                                        "entry_id": "45dad27c-531f-3811-b99c-49bae900e171",
                                        "glosses": [
                                            "One who has the tenure of a croft, usually also the occupant and user."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea05d29-100d-4519-a7cd-ad957ea03c0b",
                                                "sense_id": "03040272-b184-3d43-b450-8d00feb61e9e",
                                                "text": "c. 1795: Sir John Sinclair\n...yet even these sub-divisions are diminished by a still lower order of occupiers (if such they may be deemed) under the name of acre men or crofters. This extraordinary class of cultivators appear to have been quartered upon the tenants after the farms were split down into their smallest size: the crofters being a species of sub-tenants on the farms to which they are respectively attached"
                                            },
                                            {
                                                "example_id": "42052b42-eeaa-4a05-ac93-f19f77b06b24",
                                                "sense_id": "03040272-b184-3d43-b450-8d00feb61e9e",
                                                "text": "The passage is remarkable, as proving that at the end of the eighteenth century the crofters were not only hardly recognized but were at the very bottom of the scale in the rural economy of the Central Highlands."
                                            },
                                            {
                                                "example_id": "f03c608b-98cf-4950-afec-d55c91509672",
                                                "sense_id": "03040272-b184-3d43-b450-8d00feb61e9e",
                                                "text": "Many of the crofters on Fair Isle and Shetland know as much about the birds as the birders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
