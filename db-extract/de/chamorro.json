                "senses": [
                    {
                        "sense_id": "75f610a0-58a2-341a-83ad-513bd1aa7f20",
                        "entry_id": "7a62fbd4-2ad5-350f-8cba-47511d1f20e1",
                        "glosses": [
                            "eine Sprache, die auf den Marianen gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35cb553-8c34-40b6-83a9-061ae7ea5ce5",
                                "sense_id": "75f610a0-58a2-341a-83ad-513bd1aa7f20",
                                "text": "„Eine Genus-Unterscheidung, wie sie beispielsweise im Deutschen üblich ist, nimmt das Chamorro nicht vor.“"
                            },
                            {
                                "example_id": "2da46820-7b26-41e6-aa89-5cc55b85d073",
                                "sense_id": "75f610a0-58a2-341a-83ad-513bd1aa7f20",
                                "text": "„Die Inselsprache Chamorro, mit ihren Grußworten buenos días oder adíos entfernt ans Spanische gemahnend, war bald überrollt.“"
                            },
                            {
                                "example_id": "d7a7344c-06d8-4cd0-b1c8-3b1fb62fa1b3",
                                "sense_id": "75f610a0-58a2-341a-83ad-513bd1aa7f20",
                                "text": "„Radiosendungen werden in Englisch, Chamorro, und Tagalog ausgestrahlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
