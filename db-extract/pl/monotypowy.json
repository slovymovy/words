                                                "example_id": "605c8752-cbf7-41c2-a829-8d70448ebe9f",
                                                "sense_id": "ca6d9e83-26bb-3149-ad36-31c698540d6a",
                                                "text": "«Elle est monotypique, c’est la seule représentante de son espèce sur terre. Vous vous rendez compte?», dit-il visiblement ému."
                                            }
