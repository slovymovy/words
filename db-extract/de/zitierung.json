                "senses": [
                    {
                        "sense_id": "d7838050-b5c7-3340-868f-1a2da8286509",
                        "entry_id": "08ff3a60-08d5-3a6f-8a1c-048583eeba73",
                        "glosses": [
                            "das Zitieren oder Zitiertwerden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "020a7aa1-3db3-43a6-8615-9d63d803d176",
                                "sense_id": "d7838050-b5c7-3340-868f-1a2da8286509",
                                "text": "„Denn ein Plagiat stellt nicht nur die wortgetreue Übernahme fremden Gedankenguts ohne ausreichende Zitierung dar.“"
                            },
                            {
                                "example_id": "1cd057c8-ad2f-47b6-afc3-17c6144554f1",
                                "sense_id": "d7838050-b5c7-3340-868f-1a2da8286509",
                                "text": "„Dazu gehören auch der Ruf der Hochschule und die Zahl der Zitierungen in wissenschaftlichen Publikationen.“"
                            },
                            {
                                "example_id": "3dda4b46-ca79-4cd3-8350-8d26ed8a1f2b",
                                "sense_id": "d7838050-b5c7-3340-868f-1a2da8286509",
                                "text": "„Maßgebend waren die Zahl der wissenschaftlichen Publikationen und die Zitierungen in Fachpublikationen.“"
                            },
                            {
                                "example_id": "671165b8-8c1b-43cc-aab4-14412220a842",
                                "sense_id": "d7838050-b5c7-3340-868f-1a2da8286509",
                                "text": "„Die Zitierung des Verfassungsgerichtsurteils lautet: BVerfG, 1 BvR 80/95 vom 26.7.2005, Absatz-Nr. (1 - 100).“"
                            },
                            {
                                "example_id": "51973b53-f18a-448e-aaba-f4aed0b42e9d",
                                "sense_id": "d7838050-b5c7-3340-868f-1a2da8286509",
                                "text": "„… daß sie der Polemik förmlich entheben, da ihre monströse Verkehrtheit schon durch ihre Zitierung erhellt: »W befaßt sich mit außergeschlechtlichen Dingen nur für den Mann, den sie liebt, oder um des Mannes willen, von dem sie geliebt sein möchte.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
