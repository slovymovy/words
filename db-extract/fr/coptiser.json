                        "glosses": [
                            "Donner un caractère copte à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd643fcf-6167-4703-a8dc-026d5631b9c7",
                                "sense_id": "a49a1ab1-84ed-39da-8841-ec90df929978",
                                "text": "Ce que tu demandes aux chrétiens, c'est qu'au nom du christ, ils se laissent massacrer ou à la rigueur coptiser dans leur propre pays"
                            },
                            {
                                "example_id": "e0cb7c42-3fb5-4e47-8712-1cb1b7edd974",
                                "sense_id": "a49a1ab1-84ed-39da-8841-ec90df929978",
                                "text": "L'Ecof n'a plus qu'a se réunifier ou bien à se \"coptiser\" à la mode Bethanie..."
                            },
                            {
                                "example_id": "8c0525a3-c760-43a4-b00d-d159a419bb1f",
                                "sense_id": "a49a1ab1-84ed-39da-8841-ec90df929978",
                                "text": "et les botros rkhass (en arabe sans valeur) qui sont les crétins et la dernière race après les crapauds qui veulent coptiser l'Égypte."
                            }
                        ]
                    }
