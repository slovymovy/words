                    }
                ],
                "senses": [
                    {
                        "sense_id": "38ce9450-1977-3933-8973-b302f90707c6",
                        "entry_id": "ac41f7bf-546e-341f-ba1d-87966e915f14",
                        "glosses": [
                            "растеряться от неожиданности, испуга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5bdbf52-33e5-4c61-85cd-1cfb71f38748",
                                "sense_id": "38ce9450-1977-3933-8973-b302f90707c6",
                                "text": "Толпа на минуту как будто опешила; она, очевидно, была поражена таким неожиданным оборотом дела."
                            }
                        ]
                    },
                    {
                        "sense_id": "3666f506-252e-37d5-a7a5-0ae06c08a92f",
                        "entry_id": "ac41f7bf-546e-341f-ba1d-87966e915f14",
                        "glosses": [
                            "старин. лишиться лошади (о всаднике); неожиданно спешиться, быть на коне и вдруг оказаться пешим, оставшись без средства передвижения."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6806b976-1514-4c6c-bf11-6ece450c8c6c",
                                "sense_id": "3666f506-252e-37d5-a7a5-0ae06c08a92f",
                                "text": "Наша двигательная сила нас оставила: мы опешили; от десятка наших ещё так недавно бодрых собачонок при нас оставалась только одна, издохшая, которая валялась у наших ног в своем хомутишке."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f623532-e302-4b93-8a19-cc7e3f9217e2",
                        "source_entry_id": "ac41f7bf-546e-341f-ba1d-87966e915f14",
                        "source_sense_description": "растеряться",
                        "target_lang_word": "taken aback",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taken aback",
