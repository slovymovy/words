                ],
                "senses": [
                    {
                        "sense_id": "4fac5e6f-0517-36c5-8931-24939efddcb7",
                        "entry_id": "4549dea1-6500-35c7-9a9b-6d7be9333ada",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05a15279-065a-4d48-bf58-cc3d340cddd0",
                                "sense_id": "4fac5e6f-0517-36c5-8931-24939efddcb7",
                                "text": "Frau Reichle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e504f2f8-3c7a-44cb-983f-444abac4955c",
                                "sense_id": "4fac5e6f-0517-36c5-8931-24939efddcb7",
                                "text": "Herr Reichle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7ca9748a-7ee4-45d7-8b88-2d62f5400f23",
                                "sense_id": "4fac5e6f-0517-36c5-8931-24939efddcb7",
                                "text": "Die Reichles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b64ccc37-9388-4721-a49c-20ffaa5bc01e",
                                "sense_id": "4fac5e6f-0517-36c5-8931-24939efddcb7",
                                "text": "Der Reichle trägt nie die Schals, die die Reichle ihm strickt."
                            },
                            {
                                "example_id": "1a58f007-df7d-42cc-8608-fb59a4e3f641",
                                "sense_id": "4fac5e6f-0517-36c5-8931-24939efddcb7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reichle kommt, geht der Herr Reichle.“"
                            },
                            {
                                "example_id": "3f6c901e-52df-4627-b32a-14279f0b1335",
                                "sense_id": "4fac5e6f-0517-36c5-8931-24939efddcb7",
                                "text": "Reichle kommt und geht."
                            },
                            {
                                "example_id": "1452ba67-4e20-45b3-b2da-89d3298bef52",
                                "sense_id": "4fac5e6f-0517-36c5-8931-24939efddcb7",
                                "text": "Reichles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
