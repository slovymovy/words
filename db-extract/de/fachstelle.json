                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387b9364-23c4-4c0b-adc8-409cff30e778",
                                "sense_id": "2bc7187d-b861-3e7b-bbcd-9d63cc1ba012",
                                "text": "„Die Fachstelle für Demokratie der Stadt München warnt vor einer Zunahme rechtsextremer, rassistischer, antisemitischer Übergriffe in der Landeshauptstadt.“"
                            },
                            {
                                "example_id": "17785065-ba4a-4e80-a099-f601c866dd3b",
                                "sense_id": "2bc7187d-b861-3e7b-bbcd-9d63cc1ba012",
                                "text": "„Die Fachstelle für pflegende Angehörige der Johanniter-Notfallhilfe zieht zum 1. April um: von der Seumestraße 3 in Obersendling an die Perlacher Straße 21.“"
                            },
                            {
                                "example_id": "067ba457-55f4-4036-aee8-d118bcb79ae9",
                                "sense_id": "2bc7187d-b861-3e7b-bbcd-9d63cc1ba012",
                                "text": "„Die Fachstelle für Museumsberatung erhält in den in diesem Jahr und 2021 insgesamt 240 000 Euro. Damit sollen die öffentlichen Museen bei der Arbeit unterstützt werden, wie das Kulturministerium am Freitag mitteilte.“"
                            }
                        ],
