                                "sense_id": "67dbc598-fb77-33a0-a37c-6a55d4daccd4",
                                "text": "The fire was caused by an unattended electric blanket."
                            },
                            {
                                "example_id": "14a22c89-a048-4449-9c1f-619f73c78a26",
                                "sense_id": "67dbc598-fb77-33a0-a37c-6a55d4daccd4",
                                "text": "I have been attempting to persuade gay organizations and leaders to take this approach, without concrete results. It is a serious failure of gay leadership not to have organized open defiance of sodomy laws, and my own attitude is not to wait for leaders when there is an unattended need."
                            }
                        ]
                    }
