                                "target_senses": [
                                    {
                                        "sense_id": "72d8f49f-f123-3ba0-90d2-bbc0cb943bc2",
                                        "entry_id": "9ac9f8ff-b444-36ee-a9ab-49baa37d9d43",
                                        "glosses": [
