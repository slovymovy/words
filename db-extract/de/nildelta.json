                "senses": [
                    {
                        "sense_id": "31a12d2a-bda0-38c1-b5bf-2850d1c1dbae",
                        "entry_id": "719473cd-5d06-3674-8f78-17e3d6de837c",
                        "glosses": [
                            "Mündungsgebiet des afrikanischen Nils"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe15da2-ab03-44a0-8c52-516305eba341",
                                "sense_id": "31a12d2a-bda0-38c1-b5bf-2850d1c1dbae",
                                "text": "„Die Niederlage der athenischen Flotte im Nildelta gegen persische Schiffe beendet die griechische Intervention im ägyptischen Aufstand.“"
                            },
                            {
                                "example_id": "b528ca64-7f63-47d5-8df2-a131ba72b15b",
                                "sense_id": "31a12d2a-bda0-38c1-b5bf-2850d1c1dbae",
                                "text": "„Als besonders verwundbar nennt der Wissenschafter auch die dicht besiedelten Flussmündungen. Dazu zählen etwa das Nildelta, das Mekongdelta sowie das Ganges-Brahmaputra-Meghna-Delta in Bangladesch.“"
                            },
                            {
                                "example_id": "5f8592fb-9d56-478c-ad62-da92af27fa45",
                                "sense_id": "31a12d2a-bda0-38c1-b5bf-2850d1c1dbae",
                                "text": "„Ägypten besaß zur Zeit der Pharaonen eine hohe Weinbaukultur, die edlen Weine aus dem Nildelta und den Oasen hatten einen sehr guten Ruf.“"
                            },
                            {
                                "example_id": "ae54051a-6070-4376-9eda-b034ee8ffdd7",
                                "sense_id": "31a12d2a-bda0-38c1-b5bf-2850d1c1dbae",
                                "text": "„Séez im Departement Orne wird zuweilen Saïs geschrieben wie die Stadt im Nildelta.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
