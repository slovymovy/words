                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e0462fb-96ff-41f3-9a0d-1abf9c0c4dd5",
                        "source_entry_id": "dd31036b-1a57-3744-9ad5-48ab58a90af2",
