                    },
                    {
                        "form_id": "12921d08-17ea-419a-962e-437b8cb51365",
                        "entry_id": "b52eb593-f482-37aa-8def-26226eca7f20",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Scharteken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6e8acd6-c76d-3726-a755-54af26781b65",
                        "entry_id": "b52eb593-f482-37aa-8def-26226eca7f20",
                        "glosses": [
                            "altes Buch oder Urkunde"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "12893f67-95a4-47ca-a226-42046ac828f6",
                                "sense_id": "c6e8acd6-c76d-3726-a755-54af26781b65",
                                "text": "„Auch mit Büchern gab sich Samuel Freudenstein ab; alte Folianten in Schweinsleder waren ein wertvoller Handelsartikel, es gab keine Scharteke, die nicht zuletzt doch noch der Welt auf irgendeine Art nützlich wurde, an die der Autor einst nicht gedacht hatte.“"
                            },
                            {
                                "example_id": "4848e1d5-bab1-42b1-95b9-5db78e4b741c",
                                "sense_id": "c6e8acd6-c76d-3726-a755-54af26781b65",
                                "text": "„Dann mag er die Scharteke, die er Ihnen letzten Sonnabend vorgelesen, man in den Papierkorb werfen, oder die Frau Gräfin ihre Locken drein wickeln.“"
                            },
                            {
                                "example_id": "7e0e20a6-449c-4838-8315-bc029a830444",
                                "sense_id": "c6e8acd6-c76d-3726-a755-54af26781b65",
                                "text": "„Tun Sie doch, als ob sie Ihnen, wer weiß was, mitbringen würde! Und ich wette, wenn's hoch kömmt, so ist es eine neue Scharteke oder eine Zeitung oder sonst ein Wisch.“"
                            },
                            {
                                "example_id": "7d881d37-587c-4999-b4ee-6e93d8aa0f4f",
                                "sense_id": "c6e8acd6-c76d-3726-a755-54af26781b65",
                                "text": "„Meine Leser werden wohl so freundlich sein, mir zu glauben, daß ich an die Wissenschaft dieser alten Scharteken nicht im geringsten glaubte; aber ich hatte sie und belustigte mich daran, wie man sich eben an den tausend Dummheiten belustigt, die aus hohlen Köpfen entsprungen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5819ed9-3925-3041-9959-0e1917790be4",
                        "entry_id": "b52eb593-f482-37aa-8def-26226eca7f20",
                        "glosses": [
                            "ältere weibliche Person"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "bfa629ea-767a-4bb7-bf98-7248efffee61",
                                "sense_id": "c5819ed9-3925-3041-9959-0e1917790be4",
                                "text": "Du kannst ja die Bibliothekarin fragen, oder sprichst du mit der alten Scharteke nicht mal mehr?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "db39cf15-cd34-3088-83d2-2748a8a7da1d",
                        "entry_id": "b52eb593-f482-37aa-8def-26226eca7f20",
                        "glosses": [
                            "Theaterstück ohne Wert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73d7d40-367c-4248-98b0-0afc7cf80ae7",
                                "sense_id": "db39cf15-cd34-3088-83d2-2748a8a7da1d",
                                "text": "Heutzutage bringen sie nur noch Scharteken auf die Bühne."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
