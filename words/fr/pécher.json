{
    "word_family": [
        "péché",
        "pécheur",
        "pécheresse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "014d04e3-bdab-3fae-8184-6d518c6ad05c",
                    "sense_definition": "Transgresser les lois divines ou les règles de sa religion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le croyant demande pardon après avoir reconnu qu'il a <w>péché</w> contre la volonté divine."
                        },
                        {
                            "text": "Selon la tradition religieuse, chaque être humain risque un jour ou l'autre de <w>pécher</w>."
                        }
                    ]
                },
                {
                    "sense_id": "61297f2b-b6d7-3029-860e-10f8e80bd7c6",
                    "sense_definition": "Commettre une faute contre la morale, l'honneur ou la bienséance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "faute_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En refusant d'aider son ami dans le besoin, il a eu le sentiment de <w>pécher</w> contre la morale."
                        },
                        {
                            "text": "Trahir ses propres principes en public, c'est assurément <w>pécher</w> contre l'honneur."
                        }
                    ],
                    "synonyms": [
                        "faillir",
                        "fauter"
                    ],
                    "common_phrases": [
                        "pécher contre l'honneur",
                        "pécher contre les mœurs"
                    ]
                },
                {
                    "sense_id": "1849305e-0dd1-3960-8753-0222e97994db",
                    "sense_definition": "Présenter une défaillance ou manquer à une règle logique, formelle ou pratique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defaut_regle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette démonstration mathématique est intéressante mais elle <w>pèche</w> par manque de rigueur."
                        },
                        {
                            "text": "Son argumentation <w>pèche</w> contre le bon sens et ne parvient pas à convaincre l'assemblée."
                        }
                    ],
                    "synonyms": [
                        "clocher",
                        "faillir"
                    ],
                    "common_phrases": [
                        "pécher par la forme",
                        "pécher contre le bon sens"
                    ]
                },
                {
                    "sense_id": "84f8f9af-875e-338b-bfeb-0660c798f2cb",
                    "sense_definition": "Porter une bonne intention ou une qualité à un tel excès qu'elle en devient préjudiciable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune employé a <w>péché</w> par trop de zèle en voulant réorganiser tout le service."
                        },
                        {
                            "text": "Dans son souci extrême de bien faire, l'équipe a parfois <w>péché</w> par excès de précaution."
                        }
                    ],
                    "common_phrases": [
                        "pécher par excès",
                        "pécher par trop de zèle"
                    ]
                }
            ]
        }
    ]
}