                    },
                    {
                        "translation_id": "d846b3ff-9788-405f-91e1-3d0fd06e044a",
                        "source_entry_id": "2ef689d0-9f90-3c01-8fdf-70a3ccbc99e1",
                        "source_sense_id": "8da35d50-7986-3963-835e-68cd0f3a3b12",
                        "target_lang_word": "prolétariat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prolétariat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e7029a9-8719-3a88-8ffd-648fed453ddf",
                                        "entry_id": "7b18126e-a954-3c51-a84d-0f3aec199f41",
                                        "glosses": [
                                            "Classe des travailleur libre qui, dépourvus d’accès aux moyens de production, n’ont à vendre que leur force de travail contre un salaire."
                                        ],
                                        "tags": [
                                            "Marxism",
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "821af2cd-afee-4bf5-9b2d-d7d81621ca03",
                                                "sense_id": "9e7029a9-8719-3a88-8ffd-648fed453ddf",
                                                "text": "Cette domestication des conduites sexuelles me parait essentielle en ce qu’elle accompagne et même, semble-t-il, précède l’atténuation de la violence diffuse au sein du prolétariat, processus qui recouvre, on le sait, tout le XIXᵉ siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba586476-5eba-3b7e-abb7-77019a54cdfb",
                                        "entry_id": "7b18126e-a954-3c51-a84d-0f3aec199f41",
                                        "glosses": [
                                            "Classe ouvrière d’un pays, d’une ville ou d’un secteur à une époque donnée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950758be-0401-4b24-9f8c-3d44b8f766d0",
                                                "sense_id": "ba586476-5eba-3b7e-abb7-77019a54cdfb",
                                                "text": "Aucun autre prolétariat n’est aussi riche en souvenirs historiques, car aucun n’a eu une destinée aussi dramatique que le prolétariat français."
                                            },
                                            {
                                                "example_id": "5bcecf73-6d4d-47c3-8231-d87b7f229b8b",
                                                "sense_id": "ba586476-5eba-3b7e-abb7-77019a54cdfb",
                                                "text": "Le militant faisait connaissance avec le prolétariat ardennais de la première industrialisation, prompt et quelque peu libertaire, qui put le gêner dans la discussion […]"
                                            },
                                            {
                                                "example_id": "fa09d087-2805-4bac-8af2-70a7fdeeabc6",
                                                "sense_id": "ba586476-5eba-3b7e-abb7-77019a54cdfb",
                                                "text": "Le prolétariat de Thiers, très fermé, vivant en quelque sorte en vase clos, constitue d’ailleurs un monde d’exception doué corporativement, croirait-on, de certaines dextérités manuelles transmises par ses ancêtres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
