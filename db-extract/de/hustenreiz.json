                            {
                                "example_id": "e35c9b4d-50af-45e5-a3ad-d4219fee2be0",
                                "sense_id": "7d6cffe2-4525-3a0c-bb41-18f91618bfe8",
                                "text": "Die Einnahme von Hustensaft lindert oder unterdrückt den Hustenreiz."
                            },
                            {
                                "example_id": "0be3cc20-6be3-4ec1-9d3c-5974b5b6afe4",
                                "sense_id": "7d6cffe2-4525-3a0c-bb41-18f91618bfe8",
                                "text": "Wenn man sich verschluckt, wird sofort ein Hustenreiz ausgelöst."
                            },
                            {
                                "example_id": "0de4d7bf-ac3d-4980-9a3e-7a8a15fca395",
                                "sense_id": "7d6cffe2-4525-3a0c-bb41-18f91618bfe8",
                                "text": "„Hustenreiz würgt mir in der Kehle hoch.“"
                            }
                        ],
