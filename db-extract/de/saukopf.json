                                "target_senses": [
                                    {
                                        "sense_id": "73783183-f846-3bce-9de6-952934747be0",
                                        "entry_id": "4cc8b081-33a3-335a-8fe4-09ccf97bace8",
                                        "glosses": [
                                            "Personne têtue, obstinée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d907fd-c226-40de-9644-cf5908989a01",
                                                "sense_id": "73783183-f846-3bce-9de6-952934747be0",
                                                "text": "« Ton père a une tête de cochon, reprit le vieux délégué. Mais du temps qu’il travaillait dans une boîte, il n’a jamais fait de saloperie."
                                            },
                                            {
                                                "example_id": "c7a897da-86e9-499c-ba5a-329d0e804388",
                                                "sense_id": "73783183-f846-3bce-9de6-952934747be0",
                                                "text": "Maudite tête de cochon ! Est-ce qu’il va falloir qu’on l’attache pour qu’il se repose pour vrai ?"
                                            },
                                            {
                                                "example_id": "1edfaf01-e4e3-4a31-8727-a09f97525ddd",
                                                "sense_id": "73783183-f846-3bce-9de6-952934747be0",
                                                "text": "Sa tête de cochon a sauvé le réseau français de bien des pressions indues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
