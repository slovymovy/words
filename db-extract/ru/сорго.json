                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                        "entry_id": "d468ed8b-80dd-3240-9041-d43c26bacdc0",
                                        "glosses": [
                                            "Wissenschaftlicher Name der Gattung „Mohrenhirse“ aus der Familie der Süßgräser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12114676-04f6-4c06-a9d4-3fe4263c0682",
                                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                                "text": "Sorghum ist das Grundnahrungsmittel vieler afrikanischer Stämme."
                                            },
                                            {
                                                "example_id": "ca07f5d0-68b8-4fff-aff4-e0caaea8f13b",
                                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                                "text": "Ursprünglich war das anspruchslose Sorghum in Afrika beheimatet, aber heute wird es weltweit angebaut und ist die fünftwichtigste Nahrungsgetreideart der Welt."
                                            },
                                            {
                                                "example_id": "8979c178-0244-4b3c-965e-b2bae499c0bb",
                                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                                "text": "Gleichzeitig führt ein Subventionswettlauf dazu, daß der Sudan die Getreidesorte Sorghum in die EG exportiert."
                                            },
                                            {
                                                "example_id": "606db9f7-e374-4791-8ed6-ac2de2f27732",
                                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                                "text": "In Somalia ist der Preis für Sorghum, eine Getreideart, unerschwinglich geworden (Anstieg gar um 240 Prozent)."
                                            },
                                            {
                                                "example_id": "7765abcb-480a-4164-ac8a-c31321bb1143",
                                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                                "text": "Den Ärmeren ließen wir Reis und Hirse und Sorghum."
                                            },
                                            {
                                                "example_id": "89345b30-ec8f-4538-81ae-933a778cecfc",
                                                "sense_id": "bb86dc6f-88de-3cfc-a481-207c3b1223f4",
                                                "text": "Das Genom der afrikanischen Hirse Sorghum bicolor ist entschlüsselt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
