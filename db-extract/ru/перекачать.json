                                "target_senses": [
                                    {
                                        "sense_id": "553c164e-1b01-3305-9330-07866a2ad404",
                                        "entry_id": "49828694-3f0b-3b0b-ab84-6d2a945ad03b",
                                        "glosses": [
                                            "Verser un liquide d’un récipient dans un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ba640e-6987-4f61-88ae-0dbfedecdc5f",
                                                "sense_id": "553c164e-1b01-3305-9330-07866a2ad404",
                                                "text": "Elle surveilla l’ébullition une dizaine de minutes, puis retira le bol du feu, filtra la potion et la transvasa dans une gourde."
                                            },
                                            {
                                                "example_id": "b9828f3a-1360-4841-96cb-c7d0316e4a8b",
                                                "sense_id": "553c164e-1b01-3305-9330-07866a2ad404",
                                                "text": "Il faut transvaser ce vin, cette eau-de-vie."
                                            },
                                            {
                                                "example_id": "045e2bed-9c76-442c-9a05-04d27b453c1c",
                                                "sense_id": "553c164e-1b01-3305-9330-07866a2ad404",
                                                "text": "Il transvasa l’eau de la casserole dans sa gourde en peau de bouc, puis il se remit en selle et, faisant passer la jeune femme devant lui, il s’éloigna en protégeant l’arrière-garde."
                                            },
                                            {
                                                "example_id": "ad38883c-e516-4111-8018-178374a0512c",
                                                "sense_id": "553c164e-1b01-3305-9330-07866a2ad404",
                                                "text": "À l’aide d’un tuyau, elle avait entrepris de transvaser dans le réservoir de sa voiture le carburant acheté à prix réduit et stocké dans un bidon. Et n’avait rien trouvé de mieux à faire que d’amorcer le siphon avec sa bouche, ce qui avait, semble-t-il, fort bien fonctionné."
                                            }
                                        ]
                                    }
                                ]
