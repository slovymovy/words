                        "source_entry_id": "2a7463d2-2a8b-303c-9505-c82b5da52eae",
                        "source_sense_description": "feeding on ants",
                        "target_lang_word": "myrmécophage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myrmécophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd8cd82-bcd6-37b6-99da-0e56ae4c437a",
                                        "entry_id": "d363a40d-6997-35ab-bf6a-914264f4b93d",
                                        "glosses": [
                                            "Se nourrissant de fourmis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ea3fc75-962e-4f98-afda-df2608cf34f2",
                                                "sense_id": "fcd8cd82-bcd6-37b6-99da-0e56ae4c437a",
                                                "text": "L’ouverture buccale, parfois considérable, peut devenir fort petite chez les espèces myrmécophages."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "myrmécophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ddd4bfa-f037-3560-9bb7-fe6bc362508b",
                                        "entry_id": "c73f3133-c253-3cb5-bb11-3f537a687fa8",
                                        "glosses": [
                                            "Animal se nourrissant de fourmis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3b3cbbb-b4c8-4a48-b6e0-b2c9b1d48c23",
                                                "sense_id": "4ddd4bfa-f037-3560-9bb7-fe6bc362508b",
                                                "text": "On sait que le Pic vert est un myrmécophage distingué et il est donc souvent difficile de dire si telle fourmilière a reçu la visite du Dryocope ou seulement celle du Gécine."
                                            },
                                            {
                                                "example_id": "2b6abaa4-7859-4ab6-ba7c-5d11b0486ebe",
                                                "sense_id": "4ddd4bfa-f037-3560-9bb7-fe6bc362508b",
                                                "text": "L’Oryctérope, le meilleur fouisseur et le plus gros des myrmécophages, est le seul à pouvoir exploiter les termitières en totalité, souvent même il les détruit."
                                            },
                                            {
                                                "example_id": "81a79e12-9982-4b48-bd15-7965d2918a9a",
                                                "sense_id": "4ddd4bfa-f037-3560-9bb7-fe6bc362508b",
                                                "text": "Les myrmécophages exclusifs."
                                            }
                                        ]
                                    }
                                ]
                            }
