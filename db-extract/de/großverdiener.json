                    {
                        "sense_id": "8a8196ff-5935-308e-b606-26eb256fbfd8",
                        "entry_id": "7a27dcc4-90e5-378c-ae24-3b72cfbe74b4",
                        "glosses": [
                            "jemand, der mit seiner Arbeit ein überdurchschnittlich hohes Einkommen erzielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc7f5b5-e630-4df1-9f63-c71ebb51104d",
                                "sense_id": "8a8196ff-5935-308e-b606-26eb256fbfd8",
                                "text": "Großverdiener sind immer auf der Suche nach Schlupflöchern in der Einkommensbesteuerung."
                            },
                            {
                                "example_id": "320fe612-c2f7-40fe-93f7-408aa92bf38a",
                                "sense_id": "8a8196ff-5935-308e-b606-26eb256fbfd8",
                                "text": "„Ob es letztlich die Rücksichtnahme der Stadtverwaltung gegenüber einem ihrer besten Steuerzahler war, die das für mitteleuropäische Maßstäbe recht exotische Gebäude nicht als Hirngespinst eines Großverdieners enden ließ, ist heute nicht mehr nachweisbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
