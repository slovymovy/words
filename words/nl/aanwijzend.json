            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c31e6afa-a358-3cde-8da7-415537903426",
                    "sense_definition": "Duidt aan naar iets of iemand, vaak gebruikt in de taalkunde als term voor een specifiek type voornaamwoord.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taalkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het woord 'deze' is een <w>aanwijzend</w> voornaamwoord.",
                            "target_lang_translations": {
                                "ru": "Слово 'deze' — это <w>указательное</w> местоимение."
                            }
                        },
                        {
                            "text": "In die zin fungeert het woord als een <w>aanwijzend</w> element.",
                            "target_lang_translations": {
                                "ru": "В этом предложении слово выступает в качестве <w>указывающего</w> элемента."
                            }
                        }
                    ],
                    "synonyms": [
                        "indicatief",
                        "aanduidend",
                        "verwijzend"
                    ],
                    "common_phrases": [
                        "aanwijzend voornaamwoord"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывающий на что-либо или кого-либо; часто используется в лингвистике для обозначения типа местоимений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указательный",
                                "target_lang_sense_clarification": "используется в грамматике для классификации местоимений"
                            },
                            {
                                "target_lang_word": "указывающий",
                                "target_lang_sense_clarification": "общий термин для обозначения действия указания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a8a586b-2df2-32d7-8a0b-3e7bdfda3044",
                    "sense_definition": "Het onvoltooid deelwoord van <w>aanwijzen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar liep door de klas, <w>aanwijzend</w> welke leerlingen moesten spreken.",
                            "target_lang_translations": {
                                "ru": "Учитель ходил по классу, <w>указывая</w>, кто из учеников должен говорить."
                            }
                        },
                        {
                            "text": "Hij stond daar, naar de kaart <w>aanwijzend</w> waar we heen moesten gaan.",
                            "target_lang_translations": {
                                "ru": "Он стоял там, <w>указывая</w> на карте, куда нам нужно идти."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия настоящего времени от глагола 'aanwijzen' (указывать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указывая",
                                "target_lang_sense_clarification": "деепричастие, описывающее процесс указания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
