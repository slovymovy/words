                    {
                        "sense_id": "3ade82ab-0dac-3eb9-914a-21cd224452ac",
                        "entry_id": "e1a2089c-f4e5-3d20-bf58-7470b4f2c10e",
                        "glosses": [
                            "Application d’une couche de cadmium par électrolyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9caaf4c-60e7-4156-ab0c-5afce91de56f",
                                "sense_id": "3ade82ab-0dac-3eb9-914a-21cd224452ac",
                                "text": "Le cadmiage augmente la tenue des pièces à la corrosion et réduit les effets de corrosion par couple galvanique."
                            },
                            {
                                "example_id": "2b36a81a-03e7-4074-a43b-c7d4dc79ff78",
                                "sense_id": "3ade82ab-0dac-3eb9-914a-21cd224452ac",
                                "text": "Le cadmiage est, aussi, peu important. Il ressemble à l’étamage et est d'un prix trop élevé pour recevoir des applications industrielles."
                            },
                            {
                                "example_id": "3113820f-d228-4add-b8ef-e3c4ba9711f9",
                                "sense_id": "3ade82ab-0dac-3eb9-914a-21cd224452ac",
                                "text": "Tous les traitements électrolytiques de préparation avant cadmiage sont anodiques, sauf le nickelage."
                            }
                        ]
                    }
                ],
