                                                "example_id": "8859d8b0-0759-4656-be7d-bfb3e6765816",
                                                "sense_id": "6e7497be-9921-3d4a-ad18-621a30d0945a",
                                                "text": "Der einfältige Freund ließ fast alles mit sich geschehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7596f328-0a8c-35c6-8fc4-edc306c2a75a",
                                        "entry_id": "9bd60520-4e5d-3e7d-bf08-2ab80cc0a55a",
                                        "glosses": [
                                            "nicht sehr schlau, nicht besonders klug, geistig ein wenig beschränkt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5e5152-d4f4-4ded-84ff-091fc3813c79",
                                                "sense_id": "7596f328-0a8c-35c6-8fc4-edc306c2a75a",
                                                "text": "Wie einfältig muss man sein, um diese Finte nicht zu durchschauen?"
                                            }
