                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuillère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a982164b-5116-30c4-bd2f-ba82d3aa47ba",
                                        "entry_id": "9e3a33df-4ccc-39c3-a3a2-6515285a209b",
                                        "glosses": [
                                            "Ustensile de table formé d’un manche et d’un cuilleron dont on se sert ordinairement pour manger le potage et d’autres aliments liquides ou de peu de consistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e078e3-beb2-4b19-a913-b6f1cc368acf",
                                                "sense_id": "a982164b-5116-30c4-bd2f-ba82d3aa47ba",
                                                "text": "Lesdits seigneurs et gentilshommes vaudois, en leur châtel de Mont-Richer, étant assis au festin, qui consistait principalement, outre le produit de leurs chasses, en laitage des montagnes, qu'ils mangeaient avec des cuillères de buis artistement façonnées; l'un d'eux , François de Pontveyre, seigneur de Ferni, savoyard, brave et intrépide guerrier, ayant déclaré, en levant la main dont il tenait sa cuillère, qu'avant qu'il fût peu ils mangeraient de même les Genevois, tous répondirent à cette bravade en levant en l'air leurs cuillères , et faisant le serment d'exterminer les Genevois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0c7d87b-ef8a-3e25-a1a8-d7917b45da52",
                                        "entry_id": "9e3a33df-4ccc-39c3-a3a2-6515285a209b",
                                        "glosses": [
                                            "Ustensile de cuisine servant à préparer différents aliments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14f85871-9c5d-3f6e-a73e-b5595c0574b0",
                                        "entry_id": "9e3a33df-4ccc-39c3-a3a2-6515285a209b",
                                        "glosses": [
                                            "Unité de mesure utilisée en cuisine pour préparer différents aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4032b57-7cf2-4749-b4f2-0f66a1d80146",
                                                "sense_id": "14f85871-9c5d-3f6e-a73e-b5595c0574b0",
                                                "text": "Une cuillère à soupe d’huile."
                                            },
                                            {
                                                "example_id": "1e7d221e-386c-4a8e-bc4e-fc72ba4f4902",
                                                "sense_id": "14f85871-9c5d-3f6e-a73e-b5595c0574b0",
                                                "text": "Une cuillère à café de sel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede0583c-3537-35dc-970c-7fbdbf5addbe",
                                        "entry_id": "9e3a33df-4ccc-39c3-a3a2-6515285a209b",
                                        "glosses": [
                                            "Ustensiles de forme identique dont on fait usage dans certains métiers ou loisirs."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e98815e1-b9b7-41a5-ad98-241f53bbc127",
                                                "sense_id": "ede0583c-3537-35dc-970c-7fbdbf5addbe",
                                                "text": "Faire fondre du plomb, de la poix-résine dans une cuillère de fer."
                                            },
                                            {
                                                "example_id": "ff956797-b1e3-438f-b350-2fb2dd964308",
                                                "sense_id": "ede0583c-3537-35dc-970c-7fbdbf5addbe",
                                                "text": "Sur le fond, et autour de l’aquarium, des présentoirs exhibaient les attirails, des plus simples aux plus compliqués : gaules en bambou, cannes en fibre de verre, grandes cannes télescopiques pour moulinet à tambour tournant, boîtes de mouches et de cuillères, d’hameçons et de plombs, devons, moulinets de tous calibres, montures pour poissons morts, dégorgeoirs, bourriches, épuisettes, appâts réputés fantastiques ! fabuleux ! ou, plus prosaïquement, épatants !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6627e0db-93e6-3146-8496-aac0eee94cd3",
                                        "entry_id": "9e3a33df-4ccc-39c3-a3a2-6515285a209b",
                                        "glosses": [
                                            "Position du coït où l’un des deux partenaires est derrière l’autre, son abdomen contre le dos de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e761c9e-cf8a-44c8-a173-f82e4f32b21b",
                                                "sense_id": "6627e0db-93e6-3146-8496-aac0eee94cd3",
                                                "text": "La position en cuillères est également appelée position 99, le nombre 99 en lui-même étant une représentation figurative de cette position."
                                            },
                                            {
                                                "example_id": "c976d654-8260-4823-bc5e-96d0781eb308",
                                                "sense_id": "6627e0db-93e6-3146-8496-aac0eee94cd3",
                                                "text": "Couché en cuillère, collé sur ton derrière, t'es mon petit port de mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee24d8a-9b09-37cb-9eec-5f993fb07785",
                                        "entry_id": "9e3a33df-4ccc-39c3-a3a2-6515285a209b",
                                        "glosses": [
                                            "Main ; surtout employé lorsqu’il s’agit de la serrer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0cea906-9558-490c-82fe-8221f32a9717",
                                                "sense_id": "fee24d8a-9b09-37cb-9eec-5f993fb07785",
                                                "text": "Je leur serre la cuillère à tous et je m’esbigne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdae5077-e284-37bc-9e8e-9abb88f3345f",
                                        "entry_id": "9e3a33df-4ccc-39c3-a3a2-6515285a209b",
                                        "glosses": [
                                            "Plaquage de dernier recours où la main du plaqueur attrape le pied de l’adversaire pour le faire trébucher dans sa course."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "029df9f6-8b96-3a2c-adca-432da5e0a83a",
                                        "entry_id": "9e3a33df-4ccc-39c3-a3a2-6515285a209b",
                                        "glosses": [
                                            "Anneau placé sur le trapèze d’un voilier dans lequel il est possible de s’accrocher avec un harnais pour réduire la gîte du voilier."
                                        ],
                                        "tags": [
                                            "Sports nautiques"
                                        ],
