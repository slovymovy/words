                "senses": [
                    {
                        "sense_id": "269ffe88-88da-3465-8c00-eb08dae6b0e5",
                        "entry_id": "8da43dc5-d22a-38e6-9c9e-6cc430c42854",
                        "glosses": [
                            "kreisfreie Stadt in Bayern, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7265b82-c135-480b-a566-7818edbb9737",
                                "sense_id": "269ffe88-88da-3465-8c00-eb08dae6b0e5",
                                "text": "Aschaffenburg liegt im westlichen Unterfranken."
                            },
                            {
                                "example_id": "9b4fe48a-9f15-4594-b7e7-267c6b9ff43f",
                                "sense_id": "269ffe88-88da-3465-8c00-eb08dae6b0e5",
                                "text": "Ich bin in Aschaffenburg geboren."
                            },
                            {
                                "example_id": "dd44f514-9a2d-498f-9e2d-b9f25115546f",
                                "sense_id": "269ffe88-88da-3465-8c00-eb08dae6b0e5",
                                "text": "Wir haben in Aschaffenburg unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "d691d267-9ca8-4d9f-9c97-9bafd6f4b034",
                                "sense_id": "269ffe88-88da-3465-8c00-eb08dae6b0e5",
                                "text": "Nach Aschaffenburg führen viele Wege."
                            },
                            {
                                "example_id": "d76a2049-3cb7-4130-b6b9-b3fb5011f741",
                                "sense_id": "269ffe88-88da-3465-8c00-eb08dae6b0e5",
                                "text": "Aschaffenburg liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "c8c38c2b-78dd-41d3-88aa-3f9534bbbe0f",
                                "sense_id": "269ffe88-88da-3465-8c00-eb08dae6b0e5",
                                "text": "Das Aschaffenburg des 18. Jahrhunderts hinterließ noch einen ländlichen Eindruck."
                            },
                            {
                                "example_id": "5a224b28-1d91-40f6-af3e-68aebe45c548",
                                "sense_id": "269ffe88-88da-3465-8c00-eb08dae6b0e5",
                                "text": "Der Hersteller von Gabelstaplern Linde Material Handlung hat seinen Hauptsitz in Aschaffenburg."
                            },
                            {
                                "example_id": "17365ccf-ff3a-44c9-88f1-99e4afd3e53d",
                                "sense_id": "269ffe88-88da-3465-8c00-eb08dae6b0e5",
                                "text": "„Vielleicht läßt sich das nachempfinden, wenn man in Aschaffenburg den Reliquienkalender Albrechts von Brandenburg besichtigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a83b2df9-16ca-32bd-93ce-f6b4b65f47fd",
                        "entry_id": "8da43dc5-d22a-38e6-9c9e-6cc430c42854",
                        "glosses": [
