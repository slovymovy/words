                        "sense_id": "afe48aa1-13f5-3ed4-ae11-bcdbeae8248a",
                        "entry_id": "a59e6820-fa42-325f-acdc-a1350612d6a0",
                        "glosses": [
                            "A Russian district or provincial council, or elective local-governmental administrative division, founded in 1864 by Tsar Alexander the Liberator."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3bf120db-f4f7-4f86-a100-e47fd05fd014",
                                "sense_id": "afe48aa1-13f5-3ed4-ae11-bcdbeae8248a",
                                "text": "Two of Alexander III's counter-reforms, in 1890 and 1892, greatly increased the governors' powers over the zemstvos and municipal bodies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8eb0c475-92fd-44c0-8c3d-be031e4dd2c1",
                        "source_entry_id": "a59e6820-fa42-325f-acdc-a1350612d6a0",
                        "source_sense_id": "afe48aa1-13f5-3ed4-ae11-bcdbeae8248a",
                        "source_sense_description": "a Russian districtual or provincial conciliary or elective local-governmental administrative division",
                        "target_lang_word": "zemstvo",
