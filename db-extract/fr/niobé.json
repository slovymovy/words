                                "target_senses": [
                                    {
                                        "sense_id": "21533a37-90a0-3f70-ab7e-bb00b6cabb78",
                                        "entry_id": "8981d61e-1291-398d-a85c-0d79245cccb1",
                                        "glosses": [
                                            "A crying woman; a woman who is bereaved or inconsolable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7544da99-0fec-4a37-b362-c5a19648a07a",
                                                "sense_id": "21533a37-90a0-3f70-ab7e-bb00b6cabb78",
                                                "text": "With which she followed my poore Fathers body / Like Niobe, all teares."
                                            },
                                            {
                                                "example_id": "27f7a42b-eac9-491c-b28c-772a6341eb67",
                                                "sense_id": "21533a37-90a0-3f70-ab7e-bb00b6cabb78",
                                                "text": "There is a word will Priam turne to stone, Make wells and Niobe’s of the maides and wiues."
                                            },
                                            {
                                                "example_id": "4c2af565-aed4-45bd-85a9-726defb5936d",
                                                "sense_id": "21533a37-90a0-3f70-ab7e-bb00b6cabb78",
                                                "text": "But when a man has been ranging, like the painful bee, from flower to flower, perhaps for a month together, and the thoughts of home and wife begin to have their charms with him, to be received by a Niobe, who, like a wounded vine, weeps her vitals away, while she but involuntarily curls about him; how shall I be able to bear that?"
                                            },
                                            {
                                                "example_id": "4b695a14-06b9-4be5-892d-cbd5f081d4d1",
                                                "sense_id": "21533a37-90a0-3f70-ab7e-bb00b6cabb78",
                                                "text": "Here poor Mrs Vincy's spirit quite broke down, and her Niobe throat and good-humoured face were sadly convulsed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
