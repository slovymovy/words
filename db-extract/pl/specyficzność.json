                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7241edb7-cc3a-4937-b498-5a0dfd357db9",
                                "sense_id": "f314b9b2-2945-3169-9198-a9a519d77af4",
                                "text": "Na czym polegała specyficzność tej postaci?"
                            }
                        ],
