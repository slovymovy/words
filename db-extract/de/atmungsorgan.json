                "senses": [
                    {
                        "sense_id": "f425f261-f3b2-3414-8634-7b7502205edb",
                        "entry_id": "2703ec9a-7108-373f-8d3d-8297d1450582",
                        "glosses": [
                            "Organ, durch das die Atmung eines Tieres oder Menschen ermöglicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d76e8b0c-6005-49d9-b232-b75c7f904e02",
                                "sense_id": "f425f261-f3b2-3414-8634-7b7502205edb",
                                "text": "„Die Rußpartikel reicherten sich nur bei extrem hohen Dosen im Atmungsorgan an, führten dann zu Entzündungen und letztlich zu Tumoren.“"
                            },
                            {
                                "example_id": "1076c274-f165-4acb-9c5e-b00715a94525",
                                "sense_id": "f425f261-f3b2-3414-8634-7b7502205edb",
                                "text": "So konnten sie beobachten, wie die Reptilien mit Hilfe spezieller Muskeln die Position ihrer Atmungsorgane nach vorne oder hinten verlagern, um ihren Auftrieb zu regulieren."
                            },
                            {
                                "example_id": "e9d73bfc-ace0-4c4c-a95c-068e384a6295",
                                "sense_id": "f425f261-f3b2-3414-8634-7b7502205edb",
                                "text": "\"Die Atmungsorgane von Astronauten sind in der Schwerelosigkeit besonders gefährdet\", erklärt Isakeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
