                "senses": [
                    {
                        "sense_id": "78b42662-2ac8-3693-a55c-fae02dfe97fb",
                        "entry_id": "c785f5a7-d8f3-302b-882a-49dd636660fa",
                        "glosses": [
                            "aus einem Stiel und befestigten Borsten bestehender Gegenstand, der zum Säubern von Schuhen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16423dcd-a960-475f-9207-91b0e6ebf701",
                                "sense_id": "78b42662-2ac8-3693-a55c-fae02dfe97fb",
                                "text": "Mit der Schuhbürste putzt meine Oma jeden Tag Opas Lederschuhe."
                            },
                            {
                                "example_id": "3de3773b-103c-47ef-8ffc-0650a5b0d2dd",
                                "sense_id": "78b42662-2ac8-3693-a55c-fae02dfe97fb",
                                "text": "„Manchmal landete die Milch im Kehrichtsack, die Unterwäsche im Putzkasten, die Schuhbürste im Kühlschrank, die Kleider auf einem Haufen, Türe zu und fertig.“"
                            },
                            {
                                "example_id": "577b59f3-2dbc-44aa-a86f-a53bd84a30b7",
                                "sense_id": "78b42662-2ac8-3693-a55c-fae02dfe97fb",
                                "text": "„Bislang hat die »Craft«-Bewegung, die vom Bier bis zur Schuhbürste so ziemlich jedes Produkt zu romantisieren verstanden hat, das Präservativ eher vernachlässigt.“"
                            },
                            {
                                "example_id": "a62ea5b3-6ffe-42c3-beb9-a5705756af2d",
                                "sense_id": "78b42662-2ac8-3693-a55c-fae02dfe97fb",
                                "text": "„Die Schuhbürste trieb sich auf dem Rande des Bettes herum, dessen Laken herabhingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
