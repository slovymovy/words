                },
                {
                    "sense_id": "034e5bc2-ef55-364c-bae7-c192dc204ffd",
                    "sense_definition": "Incapable of being fully understood; unfathomable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The motives behind the strange crime remained a <w>bottomless</w> mystery.",
                            "target_lang_translations": {
                                "es": "Los motivos detrás del extraño crimen siguieron siendo un misterio <w>insondable</w>."
                            }
