                "senses": [
                    {
                        "sense_id": "4d195c60-9772-3d7a-a963-a906536825f3",
                        "entry_id": "66a1abaa-ac5b-3757-9461-4c622cdbe5b5",
                        "glosses": [
                            "mogelijk om aan te tonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f582e915-505c-4e31-b7d1-d3b441bfe791",
                                "sense_id": "4d195c60-9772-3d7a-a963-a906536825f3",
                                "text": "‘Er staat bijvoorbeeld dat we failliet gaan’, zegt Atasoy. ‘Dat is aantoonbaar onjuist. We hebben de rechter ook laten zien dat het niet klopt. Dan moet dat toch uit het rapport geschrapt worden?’"
                            },
                            {
                                "example_id": "46b2cde0-6001-4971-b9ad-5f63e3eb7a08",
                                "sense_id": "4d195c60-9772-3d7a-a963-a906536825f3",
                                "text": "Niemand had iets verkeerds gedaan, althans niets aantoonbaar verkeerds, hijzelf niet en niemand anders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36172be7-8ded-48c2-b779-01ea0e4fb2cf",
                        "source_entry_id": "66a1abaa-ac5b-3757-9461-4c622cdbe5b5",
                        "source_sense_id": "4d195c60-9772-3d7a-a963-a906536825f3",
                        "source_sense_description": "mogelijk om aan te tonen",
                        "target_lang_word": "nachweislich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachweislich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63791b3d-be9e-3cb8-bf99-8fd56ad004f1",
                                        "entry_id": "f246c9c0-ece6-360c-b077-d9f72bfd77ba",
                                        "glosses": [
                                            "beweisbar; so beschaffen, dass der Beweis erbracht worden ist oder jederzeit erbracht werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9466b3e0-b161-4e37-886e-0525badeaa06",
                                                "sense_id": "63791b3d-be9e-3cb8-bf99-8fd56ad004f1",
                                                "text": "Der Beklagte hat den Raum nachweislich betreten, da dort sowohl seine Fingerabdrücke als auch signifikante genetische Spuren von ihm gefunden wurden."
                                            },
                                            {
                                                "example_id": "95511709-16b9-44bf-8e47-62d38c1f4099",
                                                "sense_id": "63791b3d-be9e-3cb8-bf99-8fd56ad004f1",
                                                "text": "„Für wie selbstsüchtig man den Menschen auch halten mag, es gibt nachweislich einige Grundlagen seines Wesens, die dazu führen, dass er sich für das Schicksal anderer interessiert, deren Glück ihm notwendig erscheint, obwohl er nichts davon hat außer dem Vergnügen, es zu sehen.“ - Adam Smith, Die Theorie der ethischen Gefühle"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "442a9472-61a3-4a84-a8f2-55b9fee17a89",
                        "source_entry_id": "66a1abaa-ac5b-3757-9461-4c622cdbe5b5",
                        "source_sense_id": "4d195c60-9772-3d7a-a963-a906536825f3",
                        "source_sense_description": "mogelijk om aan te tonen",
                        "target_lang_word": "demonstrable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demonstrable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce6c8088-5001-3862-8ac8-9e0dbd295014",
                                        "entry_id": "4157bec3-2e65-3b71-bc38-14ef7ca0802e",
                                        "glosses": [
                                            "Able to be demonstrated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da41b56a-a9a3-413a-a4d9-e3f6b0b37e92",
                                                "sense_id": "ce6c8088-5001-3862-8ac8-9e0dbd295014",
                                                "text": "It is easily demonstrable that water extinguishes fire."
                                            },
                                            {
                                                "example_id": "2c08a04d-ed41-4a15-8078-34e40c02470a",
                                                "sense_id": "ce6c8088-5001-3862-8ac8-9e0dbd295014",
                                                "text": "Responding, Transport Secretary Mark Harper accused Haigh and Labour of making \"unfunded promises of £62 billion of rail spending with no demonstrable means to pay for them\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demonstrable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe4ae45-7c68-34e7-9019-d228420da8c7",
                                        "entry_id": "16f34d94-9691-30c1-9f8c-2f1c6b906183",
                                        "glosses": [
                                            "Something that can be demonstrated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a886b5b1-37c8-45de-b645-7f38c296937b",
                                                "sense_id": "2fe4ae45-7c68-34e7-9019-d228420da8c7",
                                                "text": "We deal here with imponderables rather than demonstrables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1aa93451-2314-475c-810e-f0aec55dcdd5",
                        "source_entry_id": "66a1abaa-ac5b-3757-9461-4c622cdbe5b5",
                        "source_sense_id": "4d195c60-9772-3d7a-a963-a906536825f3",
                        "source_sense_description": "mogelijk om aan te tonen",
                        "target_lang_word": "démontrable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démontrable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52ea4f9f-9b03-365c-9363-710e06182f7e",
                                        "entry_id": "11dc8ace-0cfe-3fed-b68e-54b51fa73033",
                                        "glosses": [
                                            "Qui peut être démontré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b410578-f0ec-43e0-b111-121716c6261c",
                                                "sense_id": "52ea4f9f-9b03-365c-9363-710e06182f7e",
                                                "text": "A quelle condition un jugement a-t-il une raison - c'est-à-dire est-il démontrable ?."
                                            },
                                            {
                                                "example_id": "a9e7e7d4-a1f6-4cb2-aeec-8e5a9c30547c",
                                                "sense_id": "52ea4f9f-9b03-365c-9363-710e06182f7e",
                                                "text": "En sortant de la méta-arithmétique pour nous ramener à des termes courants, cette proposition signifie que la formule portant le nombre de Gödel z n’est pas démontrable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "851225ce-76da-430c-a4d3-38ebfccfca8e",
                        "source_entry_id": "66a1abaa-ac5b-3757-9461-4c622cdbe5b5",
                        "source_sense_id": "4d195c60-9772-3d7a-a963-a906536825f3",
                        "source_sense_description": "mogelijk om aan te tonen",
                        "target_lang_word": "décelable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décelable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b3adc36-bece-34ca-971a-7358a00542e0",
                                        "entry_id": "8f9cb0f0-e8e5-38fa-ab18-3819d56dcb7e",
                                        "glosses": [
                                            "Que l’on peut percevoir, découvrir, même caché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23766559-3550-4af3-a18d-1fe27718f9ad",
                                                "sense_id": "9b3adc36-bece-34ca-971a-7358a00542e0",
                                                "text": "Quelquefois on se borne à ajouter au lait de l’empois d’amidon décelable par l’iode, ou de l’amidon cru que le microscope dévoile aisément."
                                            },
                                            {
                                                "example_id": "32f3e15d-4896-4fca-8be3-3f5d825e0ddb",
                                                "sense_id": "9b3adc36-bece-34ca-971a-7358a00542e0",
                                                "text": "De plus, une étude menée sur trois types de sites, un lagon, une baie semi-fermée et la mer ouverte, montre que si l’impact est mesurable en baie fermée, ce qui implique un suivi de l’enrichissement en matière organique et un contrôle de la biomasse en élevage, il est faible en baie semi-ouverte et tout juste décelable en mer ouverte seulement par la concentration en ammoniaque à proximité immédiate du train de cages."
                                            },
                                            {
                                                "example_id": "6571dca0-0038-49be-ab4e-cf15c9cddac9",
                                                "sense_id": "9b3adc36-bece-34ca-971a-7358a00542e0",
                                                "text": "Problème majeur aux yeux de la police : la substance reste difficilement décelable dans l’organisme, sauf en cas d’analyse sanguine ou urinaire dans les heures qui suivent l'administration du produit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
