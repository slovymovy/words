                    {
                        "sense_id": "47af8316-4677-352d-8caf-f36b6c7c346f",
                        "entry_id": "908e6af5-e763-3d31-ad38-26a68d77b955",
                        "glosses": [
                            "Action de joindre ou fait d’être joint, réuni ou relié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d38c68d0-9874-4152-9edf-0cfc30897974",
                                "sense_id": "47af8316-4677-352d-8caf-f36b6c7c346f",
                                "text": "Madame, vous n’avez pas un instant à perdre, dit le valet de chambre, les Prussiens, les Autrichiens et les Anglais vont faire leur jonction à Blois ou à Orléans…"
                            }
                        ]
                    },
                    {
                        "sense_id": "a816cadf-e889-3c08-94fa-323cf6ca1091",
                        "entry_id": "908e6af5-e763-3d31-ad38-26a68d77b955",
                        "glosses": [
                            "Lieu, endroit de rencontre, de liaison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ee884be-7747-48ef-b418-bb4534234362",
                                "sense_id": "a816cadf-e889-3c08-94fa-323cf6ca1091",
                                "text": "La jonction des deux corps d’armée a eu lieu à l’endroit indiqué."
                            }
                        ]
