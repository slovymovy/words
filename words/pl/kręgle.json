                            "target_lang_translations": {
                                "ru": "Раньше на сельских праздниках были популярны <w>кегли</w>, в которые играли на току."
                            }
                        },
                        {
                            "text": "Tradycyjne <w>kręgle</w> różnią się od współczesnego bowlingu zasadami oraz sprzętem.",
                            "target_lang_translations": {
                                "ru": "Традиционные <w>кегли</w> отличаются от современного боулинга правилами и инвентарем."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "традиционная игра на ловкость, заключающаяся в сбивании деревянных кеглей"
