{
    "word_family": [
        "thwart"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "74e73703-4a6f-3767-8ee1-7d42c3601a5f",
                    "sense_definition": "Feeling frustrated or prevented from achieving a goal or desire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "frustrated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>thwarted</w> plans left the team feeling disappointed and unsure of their next steps.",
                            "target_lang_translations": {
                                "zh": "这些<w>落空的</w>计划让团队感到失望，且不知下一步该怎么做。"
                            }
                        },
                        {
                            "text": "She felt a deep sense of sadness over her <w>thwarted</w> ambitions to become a professional musician.",
                            "target_lang_translations": {
                                "zh": "对于自己成为职业音乐家的<w>受挫</w>抱负，她感到深深的悲伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frustrated",
                        "obstructed",
                        "prevented"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因受到阻碍而无法实现目标或愿望，感到沮丧或受挫的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "受挫的",
                                "target_lang_sense_clarification": "形容因目标受阻而感到沮丧的状态。"
                            },
                            {
                                "target_lang_word": "落空的",
                                "target_lang_sense_clarification": "形容计划或愿望未能实现。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa1bd714-5f28-34f6-907c-a46818db151e",
                    "sense_definition": "Simple past and past participle of <w>thwart</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security team <w>thwarted</w> the robbery before it could even begin.",
                            "target_lang_translations": {
                                "zh": "安保团队在抢劫开始前就将其<w>挫败</w>了。"
                            }
                        },
                        {
                            "text": "Their efforts were <w>thwarted</w> by the sudden change in the weather conditions.",
                            "target_lang_translations": {
                                "zh": "他们的努力因天气状况的突变而遭到<w>阻挠</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb thwart."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "阻止、挫败或使某事无法成功。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挫败",
                                "target_lang_sense_clarification": "指使对方的计划或企图失败。"
                            },
                            {
                                "target_lang_word": "阻挠",
                                "target_lang_sense_clarification": "指设置障碍使事情难以进行。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}