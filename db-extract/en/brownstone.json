                        "entry_id": "fdf15a41-1dba-3c14-a013-a2cd8c7297f0",
                        "glosses": [
                            "A variety of brown to red-brown sandstone once popular as a building material."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "43a9f834-ae3a-3009-81fc-064f26141e3d",
                        "entry_id": "fdf15a41-1dba-3c14-a013-a2cd8c7297f0",
                        "glosses": [
                            "A row house built of brownstone, especially in New York City."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "60cd7a6a-c8fd-4ffc-a5e0-844c994e31a0",
                                "sense_id": "43a9f834-ae3a-3009-81fc-064f26141e3d",
                                "text": "Lived in a brownstone, lived in the ghetto, I’ve lived all over this town."
                            },
                            {
                                "example_id": "ada55bee-8ac3-443d-85c5-5e9595a6d3cb",
                                "sense_id": "43a9f834-ae3a-3009-81fc-064f26141e3d",
                                "text": "Did I mention he lives in a fantastic, expensive-looking brownstone? Did I mention that he’s a published novelist? Did I mention that he’s an involved, attentive father?"
                            },
                            {
                                "example_id": "4d525eaa-84ad-4af3-83d3-6599d609922a",
                                "sense_id": "43a9f834-ae3a-3009-81fc-064f26141e3d",
                                "text": "They emerge from the car to face a pair of brownstones, stately narrow things, which seem to have been similarly renovated and decorated."
                            }
                        ]
                    }
                ],
