                                        "sense_id": "53f0d7c4-e52f-35e3-9ca5-deb3bf9f49d3",
                                        "entry_id": "c09d6ade-febe-3c20-bf8f-b726d4869b7b",
                                        "glosses": [
                                            "Apparat zur Verdichtung von Gasen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e944b2-d439-4701-9750-5b0a0acfe2ed",
                                                "sense_id": "53f0d7c4-e52f-35e3-9ca5-deb3bf9f49d3",
                                                "text": "Ich suche nach einem günstigen Kompressor, mit dem ich einen Schlagschrauber betreiben kann."
                                            },
                                            {
                                                "example_id": "6d5f5428-b810-4ef1-9b07-eaa84f4d367b",
                                                "sense_id": "53f0d7c4-e52f-35e3-9ca5-deb3bf9f49d3",
                                                "text": "Der Kompressor des Kühlaggregates für die Tiefkühlkost läuft nicht mehr."
                                            },
                                            {
                                                "example_id": "54b0a60b-c8d6-4476-afc5-850660b3ce59",
                                                "sense_id": "53f0d7c4-e52f-35e3-9ca5-deb3bf9f49d3",
                                                "text": "„Kai war kein Mensch mehr; er stöhnte mit dem tobenden Kompressor, und schob die Schultern vor und zurück, als wollte er dem Wagen noch mehr Schwung geben – hundertmal waren sie in Gefahr, umzukippen oder gegen die Böschung zu schlagen – doch sie kamen an Murphy heran –“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae3acfaa-86e5-3ffe-9671-1cff9ca03235",
                                        "entry_id": "c09d6ade-febe-3c20-bf8f-b726d4869b7b",
                                        "glosses": [
                                            "Gerät zur Reduzierung des Dynamikumfangs eines Tonsignals"
                                        ],
                                        "tags": [
                                            "Tontechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6528c175-7696-406a-8b4c-6eb4462f72a2",
                                                "sense_id": "ae3acfaa-86e5-3ffe-9671-1cff9ca03235",
                                                "text": "Der Klang der Musik wurde mittels Kompressor verändert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
