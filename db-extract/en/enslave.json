                        "target_lang_word": "versklaven",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versklaven",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2e6fff7-6b59-3b55-a6f5-4658e0186f51",
                                        "entry_id": "5fff4720-cf9d-3e1d-92b2-7237fb36b80d",
                                        "glosses": [
                                            "jemanden zu einem Sklaven machen, in die Sklaverei führen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a94fa0e-a29c-41b1-8587-e92d80ef7ab4",
                                                "sense_id": "f2e6fff7-6b59-3b55-a6f5-4658e0186f51",
                                                "text": "Eigentlich müsste die Menschheit längst von Robotern versklavt oder zu Zombies mutiert sein – so jedenfalls sah Hollywood die erste Dekade des 21. Jahrhunderts."
                                            },
                                            {
                                                "example_id": "1d95ad7a-b111-4196-b7a6-afac484028a9",
                                                "sense_id": "f2e6fff7-6b59-3b55-a6f5-4658e0186f51",
                                                "text": "„Erst werden die Menschen unters Joch gezwungen und dann als knechtisch verachtet, unterdrückt und dann von oben herab behandelt, verdummt und ihrer Dummheit wegen verhöhnt, versklavt und als Sklaven geschmäht.“"
                                            },
                                            {
                                                "example_id": "32e09564-2919-4187-8ef5-b44d4359253e",
                                                "sense_id": "f2e6fff7-6b59-3b55-a6f5-4658e0186f51",
                                                "text": "„Da seine Männer professionelle Soldaten sind und bereits mit Musketen statt mit traditionellen Langbögen kämpfen, siegen sie häufig – und versklaven anschließend ihre Gegner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
