                ],
                "senses": [
                    {
                        "sense_id": "5a901264-e82b-3633-a5f4-ac6862f88554",
                        "entry_id": "43ed7a32-9768-301d-8589-f253a613369f",
                        "glosses": [
                            "to watch together (or online), to look together"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f903680f-efd6-4a4a-9f22-7988445e9aea",
                                "sense_id": "5a901264-e82b-3633-a5f4-ac6862f88554",
                                "text": "De scheidsrechters die meekijken van achter de schermen komen ook in actie vanaf de kwartfinales van de KNVB-beker.",
                                "translation": "The referees who watch together from behind the scenes also come into action from the quarter-finals of the KNVB Cup.",
                                "english": "The referees who watch together from behind the scenes also come into action from the quarter-finals of the KNVB Cup."
                            },
                            {
                                "example_id": "9fa9d8df-117c-4e2b-96a0-2c6120a3afc1",
                                "sense_id": "5a901264-e82b-3633-a5f4-ac6862f88554",
                                "text": "Kijk mee: de nieuwe persconferentie over de coronamaatregelen.",
                                "translation": "Watch: the new press conference about the corona measures.",
                                "english": "Watch: the new press conference about the corona measures."
                            }
                        ]
                    },
                    {
                        "sense_id": "6279647a-e367-3b65-9cc6-cc89f2bff047",
                        "entry_id": "43ed7a32-9768-301d-8589-f253a613369f",
                        "glosses": [
                            "to look or observe what someone is doing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c3486a5-cc62-46e0-bd2c-172bd1e4c28d",
                                "sense_id": "6279647a-e367-3b65-9cc6-cc89f2bff047",
                                "text": "De helpdeskmedewerker kan meekijken en met jouw toestemming de besturing van de computer overnemen.",
                                "translation": "The helpdesk employee can observe and with your permission take control of the computer.",
                                "english": "The helpdesk employee can observe and with your permission take control of the computer."
                            },
                            {
                                "example_id": "4545792b-06d6-462d-9bf1-2dd5c004e873",
                                "sense_id": "6279647a-e367-3b65-9cc6-cc89f2bff047",
                                "text": "Ik krijg het gevoel dat ze iets te vaak over onze schouder meekijken",
                                "translation": "I'm starting to get the feeling they're looking over our shoulder a little too often.",
                                "english": "I'm starting to get the feeling they're looking over our shoulder a little too often."
                            }
                        ]
                    }
                ],
