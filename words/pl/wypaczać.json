    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6e45b8f-5b92-3bd1-88f0-bd4662705342",
                    "sense_definition": "powodować zmianę kształtu przedmiotu pod wpływem czynników zewnętrznych",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deformacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wilgoć może <w>wypaczać</w> drewniane deski podłogowe.",
                            "target_lang_translations": {
                                "ru": "Влага может <w>коробить</w> деревянные половицы."
                            }
                        },
                        {
                            "text": "Wysoka temperatura zaczęła <w>wypaczać</w> plastikowe elementy konstrukcji.",
                            "target_lang_translations": {
                                "ru": "Высокая температура начала <w>деформировать</w> пластиковые элементы конструкции."
                            }
                        }
                    ],
                    "synonyms": [
                        "odkształcać",
                        "wykrzywiać",
                        "wyginać",
                        "wichrować"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать изменение формы предмета под воздействием внешних факторов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деформировать",
                                "target_lang_sense_clarification": "изменять форму под физическим воздействием"
                            },
                            {
                                "target_lang_word": "коробить",
                                "target_lang_sense_clarification": "о материалах, которые искривляются от влаги или температуры"
                            },
                            {
                                "target_lang_word": "искривлять",
                                "target_lang_sense_clarification": "делать кривым, изменять прямолинейную форму"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea757ddb-d32f-3ca8-96e4-3ef0ce0b709d",
                    "sense_definition": "przedstawiać fakty lub informacje w sposób niezgodny z prawdą",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nieprawda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie należy <w>wypaczać</w> sensu wypowiedzi innych osób.",
                            "target_lang_translations": {
                                "ru": "Не следует <w>искажать</w> смысл высказываний других людей."
                            }
                        },
                        {
                            "text": "Media często <w>wypaczają</w> rzeczywistość dla zwiększenia oglądalności.",
                            "target_lang_translations": {
                                "ru": "СМИ часто <w>искажают</w> реальность ради повышения рейтингов."
                            }
                        }
                    ],
                    "synonyms": [
                        "przeinaczać",
                        "przekręcać",
                        "fałszować",
                        "zniekształcać"
                    ],
                    "common_phrases": [
                        "wypaczać sens"
                    ],
                    "target_lang_definitions": {
                        "ru": "представлять факты или информацию в искаженном, не соответствующем истине виде"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажать",
                                "target_lang_sense_clarification": "представлять что-либо в ложном свете"
                            },
                            {
                                "target_lang_word": "извращать",
                                "target_lang_sense_clarification": "грубо искажать смысл или суть чего-либо"
                            },
                            {
                                "target_lang_word": "перевирать",
                                "target_lang_sense_clarification": "передавать информацию неверно, путать факты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a010e939-dc8a-3b84-8782-e4687e51dd26",
                    "sense_definition": "negatywnie wpływać na czyjś charakter lub zasady moralne",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "demoralizacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złe towarzystwo może <w>wypaczać</w> młodych ludzi.",
                            "target_lang_translations": {
                                "ru": "Плохая компания может <w>развращать</w> молодых людей."
                            }
                        },
                        {
                            "text": "Władza potrafi <w>wypaczać</w> ludzkie charaktery.",
                            "target_lang_translations": {
                                "ru": "Власть способна <w>уродовать</w> человеческие характеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "wynaturzać",
                        "zwyradniać",
                        "degenerować",
                        "deprawować"
                    ],
                    "target_lang_definitions": {
                        "ru": "негативно влиять на чей-либо характер или моральные принципы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развращать",
                                "target_lang_sense_clarification": "лишать моральных устоев, портить нравственно"
                            },
                            {
                                "target_lang_word": "уродовать",
                                "target_lang_sense_clarification": "негативно влиять на формирование личности"
                            },
                            {
                                "target_lang_word": "деградировать",
                                "target_lang_sense_clarification": "приводить к упадку моральных качеств"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}