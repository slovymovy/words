            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc0b793e-e7d9-380e-bb11-8374ba710efd",
                    "sense_definition": "To perform exceptionally well or be superior in a specific activity or quality.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "perform_well",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has always <w>excelled</w> in mathematics and science subjects.",
                            "target_lang_translations": {
                                "ru": "Она всегда <w>блистала</w> в математике и естественных науках.",
                                "nl": "Zij heeft altijd <w>uitgeblonken</w> in wiskunde en natuurwetenschappelijke vakken.",
                                "zh": "她在数学和理科科目上一直<w>表现出色</w>。"
                            }
                        },
                        {
                            "text": "The team <w>excelled</w> at finding creative solutions to difficult problems.",
                            "target_lang_translations": {
                                "ru": "Команда <w>отличилась</w> умением находить творческие решения сложных проблем.",
                                "nl": "Het team <w>blonk uit</w> in het vinden van creatieve oplossingen voor moeilijke problemen.",
                                "zh": "该团队非常<w>擅长</w>为棘手问题找出创造性的解决方案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shine",
                        "outperform",
                        "succeed"
                    ],
                    "antonyms": [
                        "fail",
                        "underperform",
                        "underachieve"
                    ],
