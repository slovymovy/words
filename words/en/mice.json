                                "zh": "他只是在<w>走神</w>，根本没专心工作。",
                                "nl": "Hij was alleen maar wat aan het <w>dromen</w> in plaats van op zijn werk te letten.",
                                "pl": "Zamiast skupić się na pracy, on tylko <w>bujał w obłokach</w>.",
                                "de": "Er hat nur <w>herumgealbert</w>, anstatt sich auf seine Arbeit zu konzentrieren.",
                                "fr": "Il était juste en train de <w>rêvasser</w> au lieu de faire attention à son travail.",
                                "it": "Stava solo <w>distraendosi</w> invece di prestare attenzione al suo lavoro.",
                                "cs": "Jen tak <w>lítal v oblacích</w>, místo aby se soustředil na svou práci.",
                                "tr": "İşine odaklanmak yerine sadece <w>dalgın dalgın geziniyordu</w>.",
                                "es": "Él solo estaba <w>distraído</w> en lugar de prestar atención a su trabajo."
                            }
                        },
                        {
                            "text": "Stop <w>micing</w> and listen to what I am saying.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>зевать</w> и слушай, что я говорю.",
                                "zh": "别<w>发呆</w>了，听我说。",
                                "nl": "Stop met <w>dromen</w> en luister naar wat ik zeg.",
                                "pl": "Przestań <w>błądzić myślami</w> i słuchaj, co do ciebie mówię.",
                                "de": "Hör auf zu <w>trödeln</w> und hör zu, was ich sage.",
                                "fr": "Arrête de <w>rêvasser</w> et écoute ce que je dis.",
                                "it": "Smettila di <w>distrarti</w> e ascolta quello che sto dicendo.",
                                "cs": "Přestaň <w>snít</w> a poslouchej, co říkám.",
                                "tr": "<w>Hayallere dalmayı</w> bırak ve ne söylediğimi dinle.",
                                "es": "Deja de <w>estar en las nubes</w> y escucha lo que estoy diciendo."
                            }
