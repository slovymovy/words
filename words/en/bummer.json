{
    "word_family": [
        "bum",
        "bumming"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc99af36-ce23-369c-b822-b17e625efb57",
                    "sense_definition": "A situation or event that is disappointing, unpleasant, or a pity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disappointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a total <w>bummer</w> that the concert was canceled because of the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Полный <w>облом</w>, что концерт отменили из-за сильного дождя."
                            }
                        },
                        {
                            "text": "Missing the last train home was a real <w>bummer</w> for everyone in the group.",
                            "target_lang_translations": {
                                "ru": "Опоздание на последний поезд домой стало настоящим <w>разочарованием</w> для всех в группе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "real bummer",
                        "total bummer",
                        "major bummer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in informal spoken English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация или событие, которое вызывает разочарование, неприятно или вызывает жалость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облом",
                                "target_lang_sense_clarification": "разговорное, о разочаровании"
                            },
                            {
                                "target_lang_word": "досада",
                                "target_lang_sense_clarification": "чувство неудовольствия"
                            },
                            {
                                "target_lang_word": "подстава",
                                "target_lang_sense_clarification": "жаргон, неприятная ситуация"
                            },
                            {
                                "target_lang_word": "жаль",
                                "target_lang_sense_clarification": "в значении 'какая жалость'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbd43b7a-aac4-33df-97f5-f52222736879",
                    "sense_definition": "An unpleasant or frightening experience resulting from taking a psychedelic drug; a bad trip.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drug_experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was terrified to try the substance again after having a severe <w>bummer</w> last time.",
                            "target_lang_translations": {
                                "ru": "Он до смерти боялся пробовать это вещество снова после того, как в прошлый раз словил жесткий <w>бэд-трип</w>."
                            }
                        },
                        {
                            "text": "The user described his experience as a <w>bummer</w> filled with paranoid thoughts and hallucinations.",
                            "target_lang_translations": {
                                "ru": "Потребитель описал свой опыт как <w>неудачный трип</w>, наполненный параноидальными мыслями и галлюцинациями."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "specifically drug subculture slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятный или пугающий опыт, возникший в результате приема психоделических наркотиков; бэд-трип."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бэд-трип",
                                "target_lang_sense_clarification": "наркотический сленг"
                            },
                            {
                                "target_lang_word": "измена",
                                "target_lang_sense_clarification": "жаргон, состояние паранойи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57a07b59-db22-3b80-8445-b9362619cdfb",
                    "sense_definition": "An idle person who wanders around and lives off others without working.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old novel, the character was described as a <w>bummer</w> who never held a steady job.",
                            "target_lang_translations": {
                                "ru": "В старом романе персонаж описывался как <w>бездельник</w>, у которого никогда не было постоянной работы."
                            }
                        },
                        {
                            "text": "Nobody wanted to hire the old <w>bummer</w> who spent his days begging on the corner.",
                            "target_lang_translations": {
                                "ru": "Никто не хотел нанимать старого <w>тунеядца</w>, который проводил дни, попрошайничая на углу."
                            }
                        }
                    ],
                    "synonyms": [
                        "freeloader",
                        "moocher",
                        "parasite",
                        "scrounger",
                        "sponger"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly found in 19th-century literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Праздный человек, который бродит без дела и живет за счет других, не работая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездельник",
                                "target_lang_sense_clarification": "человек, который ничего не делает"
                            },
                            {
                                "target_lang_word": "тунеядец",
                                "target_lang_sense_clarification": "живущий на чужой счет"
                            },
                            {
                                "target_lang_word": "бродяга",
                                "target_lang_sense_clarification": "скитающийся человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "660e5c39-4923-3d70-bf24-d71c24b67b04",
                    "sense_definition": "A lamb that has been abandoned by its mother and is raised by humans.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer's children took turns bottle-feeding the <w>bummer</w> in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Дети фермера по очереди кормили <w>ягненка-сироту</w> из бутылочки на кухне."
                            }
                        },
                        {
                            "text": "A <w>bummer</w> lamb often becomes very attached to the people who care for it.",
                            "target_lang_translations": {
                                "ru": "<w>Выкормленный людьми</w> ягненок часто очень привязывается к тем, кто о нем заботится."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in farming communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ягненок, брошенный матерью и выращенный людьми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сирота",
                                "target_lang_sense_clarification": "о животном, оставшемся без матери"
                            },
                            {
                                "target_lang_word": "выкормыш",
                                "target_lang_sense_clarification": "животное, выкормленное человеком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06531d9e-1aa1-3a29-87e7-7fbcf9a3d382",
                    "sense_definition": "A forager, specifically one associated with Sherman's March during the American Civil War.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_roles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bummer</w> would scout ahead of the main army to find food and supplies.",
                            "target_lang_translations": {
                                "ru": "<w>Фуражир</w> разведывал местность впереди основной армии в поисках еды и припасов."
                            }
                        },
                        {
                            "text": "Historical accounts describe the <w>bummer</w> as a crucial but often undisciplined part of the march.",
                            "target_lang_translations": {
                                "ru": "Исторические отчеты описывают <w>фуражиров</w> как важную, но часто недисциплинированную часть похода."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical American Civil War term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фуражир, особенно связанный с маршем Шермана во время Гражданской войны в США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фуражир",
                                "target_lang_sense_clarification": "исторический термин"
                            },
                            {
                                "target_lang_word": "мародер",
                                "target_lang_sense_clarification": "в контексте поиска припасов в военное время"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "0c947867-4b37-3766-b527-33ddf499187c",
                    "sense_definition": "An expression used to show sympathy or frustration when something bad happens.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"I lost my wallet on the way here.\" \"Oh, <w>bummer</w>! I hope you find it soon.\"",
                            "target_lang_translations": {
                                "ru": "«Я потерял кошелек по дороге сюда». — «О, <w>как жаль</w>! Надеюсь, ты скоро его найдешь»."
                            }
                        },
                        {
                            "text": "<w>Bummer</w>, I really wanted to go to that party tonight but I have to work.",
                            "target_lang_translations": {
                                "ru": "<w>Облом</w>, я очень хотел пойти на ту вечеринку сегодня, но мне нужно работать."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal exclamation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение, используемое для выражения сочувствия или разочарования, когда случается что-то плохое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вот облом",
                                "target_lang_sense_clarification": "восклицание разочарования"
                            },
                            {
                                "target_lang_word": "жаль",
                                "target_lang_sense_clarification": "выражение сочувствия"
                            },
                            {
                                "target_lang_word": "печалька",
                                "target_lang_sense_clarification": "современный сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ab7dd8e-72d9-37f5-bec5-6c263d52fc89",
                    "sense_definition": "The comparative form of <w>bum</w>; more low-quality or inferior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "comparatives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is an even <w>bummer</w> deal than the one we were offered yesterday.",
                            "target_lang_translations": {
                                "ru": "Это еще более <w>паршивая</w> сделка, чем та, что нам предлагали вчера."
                            }
                        },
                        {
                            "text": "He felt that his luck was getting <w>bummer</w> as the day went on.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что в течение дня его удача становится всё <w>хуже</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная форма слова 'bum'; более низкого качества или худший."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хуже",
                                "target_lang_sense_clarification": "сравнительная степень"
                            },
                            {
                                "target_lang_word": "паршивее",
                                "target_lang_sense_clarification": "разговорное, о качестве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}