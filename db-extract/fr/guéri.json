                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dde348cb-d7af-46a5-9f48-bddda346c7cb",
                                                "sense_id": "91e07221-6f82-38f8-a39e-042645d81444",
                                                "text": "Een verkoudheid geneest meestal vanzelf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c27d5966-6666-38e7-960b-ee86c9131f9f",
                                        "entry_id": "9bada5a1-7d65-3d94-b245-769d80f90d19",
                                        "glosses": [
                                            "iemand gezond maken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e317afa-e058-40b9-834e-eed02356455f",
                                                "sense_id": "c27d5966-6666-38e7-960b-ee86c9131f9f",
                                                "text": "Hij werd door een beroemd arts behandeld en genezen."
                                            },
                                            {
                                                "example_id": "8f67346e-ad38-4efe-bcb5-0faff791166a",
                                                "sense_id": "c27d5966-6666-38e7-960b-ee86c9131f9f",
                                                "text": "Hij zegt uit naam van Jezus allerlei kwalen te kunnen genezen en zelfs blinden weer te kunnen laten zien."
                                            },
                                            {
                                                "example_id": "fec6c0c0-77af-406e-8d1e-911408c22bf7",
                                                "sense_id": "c27d5966-6666-38e7-960b-ee86c9131f9f",
                                                "text": "De tweede werd geboren in de zesde eeuw. Eigenlijk was hij een zeer eenvoudige monnik, die later abt werd van het klooster in Myra. Een bijzonder vrome man, die door zijn gebed de mensen kon genezen. Hij overleed op 10 december van het jaar 564."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "197f5f84-ed6e-3e8e-8d1e-61344eac25a5",
                                        "entry_id": "9bada5a1-7d65-3d94-b245-769d80f90d19",
                                        "glosses": [
                                            "helen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b06cb6e0-3a79-4b3c-834e-a2a275532c95",
                                                "sense_id": "197f5f84-ed6e-3e8e-8d1e-61344eac25a5",
                                                "text": "Kanker valt niet altijd te genezen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "865995fd-dd42-3e98-8b20-d3024207e482",
                                        "entry_id": "9bada5a1-7d65-3d94-b245-769d80f90d19",
                                        "glosses": [
                                            "niet meer geloven in een verkeerde opvatting"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2450f9a8-aa8f-4757-a41d-e50c50ee397f",
                                                "sense_id": "865995fd-dd42-3e98-8b20-d3024207e482",
                                                "text": "Vroeger zou ik hebben opgezocht wie hij was - maar na vijf jaar Londen was ik genezen van mijn belangstelling voor oude victoriaanse mannen."
                                            }
                                        ]
                                    }
                                ]
                            },
