                            {
                                "example_id": "fdd5c13b-3f2b-4845-b6e6-7fe345a03728",
                                "sense_id": "5781219b-d9a0-3299-9ae2-9426bfe3b334",
                                "text": "высокопоста́вленный чино́вник",
                                "translation": "a high-ranking official",
                                "english": "a high-ranking official"
                            },
                            {
                                "example_id": "0c77ca23-8f7d-4771-a08e-c7acdd76b575",
                                "sense_id": "5781219b-d9a0-3299-9ae2-9426bfe3b334",
                                "text": "То он телефони́ровал, что зака́нчивает карти́ну к вы́ставке, то присла́л письмо́, что до́лжен яви́ться к высокопоста́вленному лицу́, с кото́рого бу́дет писа́ть портре́т, то присла́л цветы́ без вся́кого письма́ и сам не пришёл.",
                                "translation": "Nadezhda Teffi",
                                "english": "Nadezhda Teffi"
                            }
                        ]
