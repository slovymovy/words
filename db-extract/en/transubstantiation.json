                                        "examples": [
                                            {
                                                "example_id": "e03bba95-95c2-4d9a-9e66-b523bf3968e9",
                                                "sense_id": "de60aca6-3981-3aff-804e-c48567009975",
                                                "text": "Die Lehre von der Transsubstantiation wurde von der katholischen Kirche erst durch das Konzil von Trient definiert."
                                            },
                                            {
                                                "example_id": "77a08711-b981-454f-b90e-07c04bfc13cd",
                                                "sense_id": "de60aca6-3981-3aff-804e-c48567009975",
                                                "text": "„[…] Ist die Lehre von der realen Gegenwart Christi in den eucharistischen Gaben nicht durch die Naturwissenschaften längst widerlegt, überholt? Hat die Kirche sich mit ihrem Substanzbegriff – sie redet ja von „Transsubstantiation“ - nicht viel zu weit an eine im Grunde primitive und überholte Wissenschaft gekettet, […]?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
