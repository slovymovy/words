{
    "word_family": [
        "controversy",
        "controversially",
        "controversialist",
        "controversialism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02eaf502-ca58-3dc1-a5da-52be807d430b",
                    "sense_definition": "Causing or likely to cause public disagreement or heated discussion.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "disagreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government's new tax policy has become a highly <w>controversial</w> issue among voters.",
                            "target_lang_translations": {
                                "ru": "Новая налоговая политика правительства стала крайне <w>спорным</w> вопросом среди избирателей."
                            }
                        },
                        {
                            "text": "The director is known for making a <w>controversial</w> decision that often divides the critics.",
                            "target_lang_translations": {
                                "ru": "Режиссер известен принятием <w>противоречивых</w> решений, которые часто разделяют критиков на два лагеря."
                            }
                        }
                    ],
                    "synonyms": [
                        "contentious",
                        "contested"
                    ],
                    "antonyms": [
                        "uncontroversial",
                        "non-controversial",
                        "incontrovertible"
                    ],
                    "common_phrases": [
                        "controversial decision",
                        "controversial issue",
                        "highly controversial",
                        "controversial figure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий или способный вызвать общественные разногласия или бурные обсуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спорный",
                                "target_lang_sense_clarification": "вызывающий разногласия"
                            },
                            {
                                "target_lang_word": "противоречивый",
                                "target_lang_sense_clarification": "содержащий противоречия или вызывающий разную реакцию"
                            },
                            {
                                "target_lang_word": "дискуссионный",
                                "target_lang_sense_clarification": "являющийся предметом дискуссии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80b65ae9-a5bd-36aa-8e61-ad30a1129633",
                    "sense_definition": "Fond of or given to engaging in arguments or disputes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disagreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a <w>controversial</w> nature and enjoys playing devil's advocate during every meeting.",
                            "target_lang_translations": {
                                "ru": "У него <w>полемичный</w> характер, и ему нравится выступать в роли адвоката дьявола на каждом собрании."
                            }
                        },
                        {
                            "text": "The author's <w>controversial</w> style often provokes strong reactions from his readers.",
                            "target_lang_translations": {
                                "ru": "<w>Противоречивый</w> стиль автора часто вызывает бурную реакцию у его читателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "contentious"
                    ],
                    "common_phrases": [
                        "controversial nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к участию в спорах или дискуссиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полемичный",
                                "target_lang_sense_clarification": "склонный к полемике или спорам"
                            },
                            {
                                "target_lang_word": "любящий спорить",
                                "target_lang_sense_clarification": "о характере человека"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ac36b56-40a2-39fc-ad5f-2136d250fa01",
                    "sense_definition": "A person or thing that is a subject of intense public disagreement or debate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In social psychology, <w>controversials</w> are individuals who are both strongly liked and strongly disliked by their peers.",
                            "target_lang_translations": {
                                "ru": "В социальной психологии <w>спорные личности</w> — это люди, которые одновременно вызывают как сильную симпатию, так и сильную неприязнь у своих сверстников."
                            }
                        },
                        {
                            "text": "The manager identified himself as a <w>controversial</w> due to his confrontational leadership style.",
                            "target_lang_translations": {
                                "ru": "Менеджер охарактеризовал себя как <w>противоречивую фигуру</w> из-за своего конфронтационного стиля руководства."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, являющийся предметом интенсивных общественных разногласий или дебатов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спорная личность",
                                "target_lang_sense_clarification": "о человеке, вызывающем разные оценки"
                            },
                            {
                                "target_lang_word": "противоречивая фигура",
                                "target_lang_sense_clarification": "о публичном лице"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}