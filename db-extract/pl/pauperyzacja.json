                                "target_senses": [
                                    {
                                        "sense_id": "29020f99-4597-3bcb-8173-fc91ba0d6925",
                                        "entry_id": "9427ef76-8e14-37e4-be1e-fc037073e551",
                                        "glosses": [
                                            "Appauvrissement d'une population ou d'une classe sociale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d9c207f-bc42-4c4f-98b8-47a8b86cb16d",
                                                "sense_id": "29020f99-4597-3bcb-8173-fc91ba0d6925",
                                                "text": "La paupérisation des classes moyennes gonfle la dette des ménages"
                                            },
                                            {
                                                "example_id": "276cd9c7-1647-4c13-9b63-009f2b9faf1f",
                                                "sense_id": "29020f99-4597-3bcb-8173-fc91ba0d6925",
                                                "text": "Chef d’état-major et patron des trois armées accusent l’Élysée d’être responsable de la « paupérisation » des troupes."
                                            },
                                            {
                                                "example_id": "b74bd056-5b51-47fe-9bfb-5bbda3f57120",
                                                "sense_id": "29020f99-4597-3bcb-8173-fc91ba0d6925",
                                                "text": "Une politique agraire d’expropriation et de contrainte à tous les niveaux, de paupérisation implacable de la paysannerie interdit la formation d’une petite bourgeoisie rurale issue de l’économie de traite ; les missions adoptent une position aussi négative dans le domaine de l’enseignement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
