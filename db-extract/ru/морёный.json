                                        "sense_id": "7eccabd0-fe79-3308-b1aa-690fe166a9ad",
                                        "entry_id": "f1230ae7-2d6c-39be-b19a-00d8a116d250",
                                        "glosses": [
                                            "Bold; boastful; proud."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19436c41-386f-4d37-ab03-3169f1a61c2c",
                                                "sense_id": "7eccabd0-fe79-3308-b1aa-690fe166a9ad",
                                                "text": "The Cuckooe, seeing him so bog, waxt also wondrous wroth."
                                            },
