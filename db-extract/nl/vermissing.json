                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10023171-7a90-4880-9486-dfcd9d0318aa",
                                                "sense_id": "076f70a8-b0e5-3b5f-9ad6-2561d3b426ce",
                                                "text": "We mourn his loss."
