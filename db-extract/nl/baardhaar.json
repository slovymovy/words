                "senses": [
                    {
                        "sense_id": "bbd94a27-d9f7-3c30-aaf5-11fd03255e30",
                        "entry_id": "b7b4be16-cc45-3967-a412-d7670f533fec",
                        "glosses": [
                            "al het haar van een baard"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "169f158c-2ab5-4e12-ae6e-53b11b85a01b",
                                "sense_id": "bbd94a27-d9f7-3c30-aaf5-11fd03255e30",
                                "text": "Baarden zijn hip, maar elke dag kijken naar hetzelfde baardhaar wordt ook weer zo gewoon. Gelukkig kunnen baarddragers met de feestdagen weer flink uitpakken. Na de kerstballenbaard, is het nu de glitterbaard die 'je van het'gaat worden."
                            },
                            {
                                "example_id": "e71276d4-d8a1-48f7-a2ec-059448dfa390",
                                "sense_id": "bbd94a27-d9f7-3c30-aaf5-11fd03255e30",
                                "text": "Er hoeven geen nieuwe regels te komen laat de woordvoerder van de plaatselijke brandweerkorps weten omdat daar al jaren in de reglementen staat dat baardhaar verboden is bij het dragen van zuurstofmaskers."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc4f425a-cc12-3226-9be9-a792c668c7e9",
                        "entry_id": "b7b4be16-cc45-3967-a412-d7670f533fec",
                        "glosses": [
                            "elk van de haren van een baard"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a6a404-e20f-4a3e-849d-aa224115b34d",
                                "sense_id": "bc4f425a-cc12-3226-9be9-a792c668c7e9",
                                "text": "En ze ontwikkelden de eerste space-shaver, een scheerapparaat met ingebouwde stofzuiger zodat de baardharen niet zouden gaan zweven in de ruimte. Maar vooral in consumenten-elektronica kreeg alles geleidelijk een heel sterk space-design. Alles werd rond en organisch gevormd en het bedrijf huurde topdesigners in."
                            }
                        ]
                    }
