        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "331116f2-1c55-3b53-be8b-5ddd3594643b",
                    "sense_definition": "obraz czegoś lub kogoś powstały w myślach lub świadomości na podstawie wspomnień lub fantazji",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mysl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rzeczywistość zupełnie różniła się od mojego wcześniejszego <w>wyobrażenia</w> o tym miejscu.",
                            "target_lang_translations": {
                                "en": "Reality was completely different from my earlier <w>idea</w> of this place."
                            }
                        },
                        {
                            "text": "Jego naiwne <w>wyobrażenie</w> o pracy w korporacji szybko zderzyło się z trudną codziennością.",
                            "target_lang_translations": {
                                "en": "His naive <w>notion</w> of working in a corporation quickly clashed with difficult everyday reality."
                            }
                        }
                    ],
                    "synonyms": [
                        "wizja",
                        "koncepcja"
                    ],
                    "common_phrases": [
                        "mieć wyobrażenie",
                        "błędne wyobrażenie",
                        "fałszywe wyobrażenie"
                    ],
                    "target_lang_definitions": {
                        "en": "a mental image or concept of someone or something formed in the mind based on memories or fantasy"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idea",
                                "target_lang_sense_clarification": "mental image or conception"
                            },
                            {
                                "target_lang_word": "notion",
                                "target_lang_sense_clarification": "mental concept or impression"
                            },
                            {
                                "target_lang_word": "mental picture",
                                "target_lang_sense_clarification": "visualized image in the mind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a53d12fc-a96d-3915-a25d-15616e5794fa",
                    "sense_definition": "opinia, pogląd lub pojęcie na jakiś temat",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opinia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie masz zielonego <w>wyobrażenia</w> o tym, jak trudne było to zadanie.",
                            "target_lang_translations": {
                                "en": "You have no <w>idea</w> how difficult that task was."
                            }
                        },
                        {
                            "text": "Społeczne <w>wyobrażenie</w> o tej chorobie jest często oparte na szkodliwych mitach.",
                            "target_lang_translations": {
                                "en": "The public <w>perception</w> of this disease is often based on harmful myths."
                            }
                        }
                    ],
                    "synonyms": [
                        "opinia",
                        "pojęcie",
                        "przekonanie",
                        "przeświadczenie",
                        "mniemanie"
                    ],
                    "common_phrases": [
                        "nie mieć zielonego wyobrażenia",
                        "ogólne wyobrażenie"
                    ],
                    "target_lang_definitions": {
                        "en": "an opinion, view, notion, or understanding of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idea",
                                "target_lang_sense_clarification": "understanding, clue, or conception"
                            },
                            {
                                "target_lang_word": "notion",
                                "target_lang_sense_clarification": "belief or general understanding"
                            },
                            {
                                "target_lang_word": "conception",
                                "target_lang_sense_clarification": "general view or understanding"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d194cf6-54b1-3e14-b1c0-59991afe797e",
                    "sense_definition": "materialny obraz, podobizna, wizerunek lub artystyczne przedstawienie kogoś albo czegoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sztuka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na starej monecie widniało wyraźne <w>wyobrażenie</w> rzymskiego cesarza.",
                            "target_lang_translations": {
                                "en": "The old coin showed a clear <w>image</w> of the Roman emperor."
                            }
                        },
                        {
                            "text": "W muzealnej sali zachwyciło nas malarskie <w>wyobrażenie</w> bitwy pod Grunwaldem.",
                            "target_lang_translations": {
                                "en": "In the museum hall, we were captivated by the painted <w>depiction</w> of the Battle of Grunwald."
                            }
                        }
                    ],
                    "synonyms": [
                        "przedstawienie"
                    ],
                    "common_phrases": [
                        "plastyczne wyobrażenie",
                        "malarskie wyobrażenie"
                    ],
                    "target_lang_definitions": {
                        "en": "a physical image, likeness, or artistic depiction/representation of someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "representation",
                                "target_lang_sense_clarification": "artistic depiction or portrayal"
                            },
                            {
                                "target_lang_word": "depiction",
                                "target_lang_sense_clarification": "visual or artistic portrayal"
                            },
                            {
                                "target_lang_word": "image",
                                "target_lang_sense_clarification": "likeness or visual reproduction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17184a6a-4733-3f8b-8595-130656164b0c",
                    "sense_definition": "rzeczownik odczasownikowy od: <w>wyobrazić</w>; akt tworzenia w umyśle obrazu czegoś",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dokładne <w>wyobrażenie</w> sobie skali tego zjawiska wymaga wiedzy naukowej.",
                            "target_lang_translations": {
                                "en": "Accurately <w>imagining</w> the scale of this phenomenon requires scientific knowledge."
                            }
                        },
                        {
                            "text": "Samo <w>wyobrażenie</w> sobie tak wielkiego sukcesu dodało mu odwagi.",
                            "target_lang_translations": {
                                "en": "Just <w>picturing</w> such great success gave him courage."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wyobrażenie sobie czegoś"
                    ],
                    "target_lang_definitions": {
                        "en": "the act of imagining or picturing something in one's mind"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imagining",
