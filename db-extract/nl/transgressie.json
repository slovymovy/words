                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40c48af0-7b85-4afa-8ea4-bb5df2458284",
                                "sense_id": "3cf1d52e-29c5-3650-bb95-20f71654c80c",
                                "text": "Het Noordzeebekken daalt daardoor verder, met een nieuwe, zeer grote transgressie in het Rupelien tot gevolg. De zee overspoelt Nederland en de noordelijke helft van België."
                            }
