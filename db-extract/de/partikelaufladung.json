                ],
                "senses": [
                    {
                        "sense_id": "5ff1a3bd-9922-3650-a62f-3b1f87123f19",
                        "entry_id": "04ef06d1-0691-301f-91b3-ec6ca077b4b7",
                        "glosses": [
                            "Vorgang, bei welchem gasgetragene Partikel elektrisch aufgeladen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51dbba6e-677f-43f4-85e5-12899d13dc3b",
                                "sense_id": "5ff1a3bd-9922-3650-a62f-3b1f87123f19",
                                "text": "„Die Partikelaufladung beschreibt physikalische Mechanismen zur elektrischen Aufladung von gasgetragenen Partikeln (Aerosol).“"
                            },
                            {
                                "example_id": "b2544f77-d074-4592-be52-11ca07265e8a",
                                "sense_id": "5ff1a3bd-9922-3650-a62f-3b1f87123f19",
                                "text": "„Die spezielle Anordnung der Coronaelektroden in der Düse führt zu einer hocheffizienten Partikelaufladung und folglich zu einer geringen Baugröße.“"
                            },
                            {
                                "example_id": "9e21c8e1-5082-488f-92b1-09f08daff054",
                                "sense_id": "5ff1a3bd-9922-3650-a62f-3b1f87123f19",
                                "text": "„Im Prinzip folgt die […] Technologie dem Ansatz, den unterschiedlichen physikalischen Anforderungen bei der Partikelaufladung durch Ionisation und der Partikelabscheidung im elektrischen Hochspannungsfeld Rechnung zu tragen.“"
                            },
                            {
                                "example_id": "96e7e426-3036-40e4-b569-002b0de55d38",
                                "sense_id": "5ff1a3bd-9922-3650-a62f-3b1f87123f19",
                                "text": "„Gegebenenfalls können […] mehrere Abschnitte für Ionisierung und Abscheidung innerhalb eines Elektrofilterfeldes angeordnet werden, wenn die einmalige Partikel-Aufladung nicht ausreichend sein sollte.“"
                            },
                            {
                                "example_id": "4d0d8141-7770-461e-b36d-67bf03ea39bc",
                                "sense_id": "5ff1a3bd-9922-3650-a62f-3b1f87123f19",
                                "text": "„Wesentliche Nachteile sind die sich aus dem benötigten elektrischen Feld ergebende Partikelabscheidung und eine überlagerte Partikelaufladung durch den Mechanismus der Feldaufladung, welche in aller Regel verhindert, dass sich die gewünschte Ladungsverteilung einstellt. Werden Ladungsgeneration und Partikelaufladung räumlich getrennt, ergeben sich – neben der Verdünnung des Aerosols mit dem Trägergasstrom der Ionen – Probleme unter anderem im Hinblick auf die Ozonbelastung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
