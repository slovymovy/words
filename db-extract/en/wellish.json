                "senses": [
                    {
                        "sense_id": "eb172afd-b420-3b89-9af0-7498e6ea8e7f",
                        "entry_id": "d5b8559c-943e-3aa4-839b-d666b3ab0470",
                        "glosses": [
                            "Somewhat well; in a fairly satisfactory manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5501796a-eb47-41d0-a814-2d549ec692e1",
                                "sense_id": "eb172afd-b420-3b89-9af0-7498e6ea8e7f",
                                "text": "He knew his letters pretty wellish, but no more."
                            },
                            {
                                "example_id": "4c3f5c05-9c8b-4465-aa9e-d9c1d921974a",
                                "sense_id": "eb172afd-b420-3b89-9af0-7498e6ea8e7f",
                                "text": "“Fine,” I relent. “Yes. It's going wellish.”"
                            },
                            {
                                "example_id": "d6dd927f-7ee4-46a7-878d-b833ec6b9504",
                                "sense_id": "eb172afd-b420-3b89-9af0-7498e6ea8e7f",
                                "text": "Prior to that day, everything I had tried on my healing journey hadn't worked very well or had only worked “wellish” enough."
                            }
                        ]
                    }
                ],
