{
    "word_family": [
        "atrocity",
        "atrociously",
        "atrociousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a646ca6b-8f3e-345a-b290-be7b99848e93",
                    "sense_definition": "Extremely bad, unpleasant, or of very poor quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather during our entire vacation was absolutely <w>atrocious</w> with constant rain.",
                            "target_lang_translations": {
                                "ru": "Погода на протяжении всего нашего отпуска была совершенно <w>отвратительной</w> из-за постоянных дождей."
                            }
                        },
                        {
                            "text": "I cannot believe they are charging so much for such <w>atrocious</w> service at this restaurant.",
                            "target_lang_translations": {
                                "ru": "Не могу поверить, что в этом ресторане берут так много за такое <w>ужасное</w> обслуживание."
                            }
                        }
                    ],
                    "synonyms": [
                        "terrible",
                        "awful",
                        "abominable",
                        "dreadful"
                    ],
                    "antonyms": [
                        "excellent",
                        "wonderful",
                        "superb"
                    ],
                    "common_phrases": [
                        "atrocious weather",
                        "atrocious service",
                        "atrocious taste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно плохой, неприятный или очень низкого качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "очень плохого качества или крайне неприятный"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "крайне плохой"
                            },
                            {
                                "target_lang_word": "омерзительный",
                                "target_lang_sense_clarification": "вызывающий отвращение своим качеством"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffb802fa-c86e-34ff-bf93-cd0621871636",
                    "sense_definition": "Exceedingly cruel, wicked, or monstrous in nature.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "wickedness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator was eventually tried for the <w>atrocious</w> crimes committed against his own people.",
                            "target_lang_translations": {
                                "ru": "Диктатора в конечном итоге судили за <w>чудовищные</w> преступления, совершенные против собственного народа."
                            }
                        },
                        {
                            "text": "Prisons have been the sites of <w>atrocious</w> mistreatment of prisoners throughout history.",
                            "target_lang_translations": {
                                "ru": "На протяжении всей истории тюрьмы были местами <w>зверского</w> обращения с заключенными."
                            }
                        }
                    ],
                    "synonyms": [
                        "heinous",
                        "monstrous",
                        "barbaric",
                        "vile"
                    ],
                    "antonyms": [
                        "virtuous",
                        "kind",
                        "humane"
                    ],
                    "common_phrases": [
                        "atrocious crimes",
                        "atrocious cruelty",
                        "atrocious act"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно жестокий, злой или чудовищный по своей природе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зверский",
                                "target_lang_sense_clarification": "крайне жестокий и бесчеловечный"
                            },
                            {
                                "target_lang_word": "чудовищный",
                                "target_lang_sense_clarification": "поражающий своей жестокостью"
                            },
                            {
                                "target_lang_word": "гнусный",
                                "target_lang_sense_clarification": "подлый и порочный"
                            },
                            {
                                "target_lang_word": "жестокий",
                                "target_lang_sense_clarification": "бессердечный и суровый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}