                        "tags": [],
                        "examples": [
                            {
                                "example_id": "659df93a-777c-4806-9b01-e9ef8038300b",
                                "sense_id": "bb702776-0458-37ae-b818-cd039c264bb4",
                                "text": "L’aspect sporadique de l’assistance à ce festival populaire rend impossible pour le moment le décernement d’un prix du public."
                            },
                            {
                                "example_id": "c16c6e49-51a3-41d0-a022-3560597b720c",
                                "sense_id": "bb702776-0458-37ae-b818-cd039c264bb4",
                                "text": "Le prix consiste en une plaque d’argent, mesurant environ 10 x 6 cm, mentionnant le nom du prix ainsi libellé : « Prix Paul Adam Even », l’année de son décernement, le nom du lauréat et le titre de l’ouvrage couronné, ainsi que l’emblème de l’Académie."
                            }
