                    {
                        "sense_id": "e1d99331-70b6-395d-86fa-51db9e9533f5",
                        "entry_id": "36dc707d-4cd5-3d10-95c4-e6715e523249",
                        "glosses": [
                            "устар. кол; шест; свая (крепостного палисада и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbf05cc0-4714-4416-b909-10e582c1e8ab",
                                "sense_id": "e1d99331-70b6-395d-86fa-51db9e9533f5",
                                "text": "Этапные помещения не запирались до поздней ночи, мы могли свободно гулять по двору; часовые, расставленные вдоль палей и ворот, не вмешивались во внутреннюю жизнь этапов, здесь следили жандармы."
                            }
                        ]
                    }
                ],
