                                        "examples": [
                                            {
                                                "example_id": "6c80b27f-d9df-4fe7-9628-b01c103c4762",
                                                "sense_id": "a74c9bb3-bf5b-38d9-9a48-b7eb7dd0e6e0",
                                                "text": "Dans la nature, on trouve les guppys dans de petites rivières du nord-est de l’Amérique du Sud et, non loin de là, dans de nombreuses rivières de montagne de l’île de la Trinité."
                                            }
