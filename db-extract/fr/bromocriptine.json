                                        "entry_id": "4e975196-6443-3ca4-8dcd-7e80fcd1b849",
                                        "glosses": [
                                            "A drug used in the treatment of parkinsonism, galactorrhea, and other conditions. It is a synthetic analog of the ergot alkaloids and stimulates the dopaminergic receptors of the brain, inhibiting the release of prolactin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d5d3f05-e7d2-43a4-939f-40e395659f8c",
                                                "sense_id": "da3d7101-bc75-3f33-bae6-724f479a1f31",
                                                "text": "We have observed that treatment with bromocriptine and levodopa prolongs the antitremor effectiveness of levodopa in monkeys with unilateral VMT lesions of the brain stem."
                                            }
                                        ]
                                    }
