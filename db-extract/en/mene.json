                "senses": [
                    {
                        "sense_id": "075eaf9e-e0ef-3c02-9c6c-47d10293a916",
                        "entry_id": "5146f777-1acb-3af8-abcd-736b7c0ad39b",
                        "glosses": [
                            "The high middle singing voice (especially as for a boy) or part in musical composition, corresponding roughly to the alto."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2972e2a-c819-466a-888e-fd18b0b9353e",
                                "sense_id": "075eaf9e-e0ef-3c02-9c6c-47d10293a916",
                                "text": "He starts out by saying that there are three sights, the mene, treble, and quadreble, but actually he discusses only two, the treble and quadreble, both of which are read at the transposition of an octave."
                            },
                            {
                                "example_id": "79b05bdf-17e2-456c-92cb-f2f47655b19a",
                                "sense_id": "075eaf9e-e0ef-3c02-9c6c-47d10293a916",
                                "text": "The voices include a counter (always below the tenor), a countertenor (moving above and below the tenor), mene, treble, and quadreble."
                            },
                            {
                                "example_id": "d23bdabd-baad-47cf-bcb2-5264440c7eaf",
                                "sense_id": "075eaf9e-e0ef-3c02-9c6c-47d10293a916",
                                "text": "The counter involves transposition of the sighted note to the fifth below (for extremely low notes a twelfth), the mene and countertenor do not transpose, the treble transposes to the octave above, and the quadreble to the twelfth above."
                            }
                        ]
                    }
                ],
