                                        "glosses": [
                                            "Relatif au Baloutchistan, son peuple ou sa langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "819c3f65-4d11-418a-a9be-4d7000092b1b",
                                                "sense_id": "a6f9fda2-cf0d-33cc-8f40-ed7c970ce9d8",
                                                "text": "Elles lui donnaient l’allure d’un chef de bande baloutche."
                                            },
                                            {
                                                "example_id": "e6c16b64-6928-4ec4-b695-f33f38d1eef5",
                                                "sense_id": "a6f9fda2-cf0d-33cc-8f40-ed7c970ce9d8",
                                                "text": "Mme Shamdasani a notamment évoqué les exécutions de ressortissants afghans ainsi que de Kurdes d’Iran, d’Iraniens arabes ou de membres de la minorité baloutche."
                                            }
                                        ]
                                    }
                                ]
