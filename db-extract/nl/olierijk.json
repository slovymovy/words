                        "examples": [
                            {
                                "example_id": "d1c94947-4672-42f1-acdc-be7d2af2dd62",
                                "sense_id": "915670af-656d-3f6f-8c88-1fd8b1ac72c6",
                                "text": "De Bentley Dominator werd onthuld in een tijd waarin superrijken die een luxe off-roader wilden alleen konden kiezen voor een Range Rover. De Sultan van Brunei, de leider van een klein islamitisch en olierijk land en bekend om het verzamelen van supercars en ultra-zeldzame voertuigen, zorgde ervoor dat 'ie gebouwd werd."
                            },
                            {
                                "example_id": "897f77f8-6b17-4e78-965b-7a8b1bfdfee5",
                                "sense_id": "915670af-656d-3f6f-8c88-1fd8b1ac72c6",
                                "text": "De geboren Iraniër al-Mansouri kwam in zijn geboorteland als activist op voor de Arabische minderheid in Ahwaz, een olierijk gebied in Iran."
                            },
                            {
                                "example_id": "bdcc7fb1-9414-4f86-93ab-5f48afc57d86",
                                "sense_id": "915670af-656d-3f6f-8c88-1fd8b1ac72c6",
                                "text": "De voorbije maanden kwam het echter ook geregeld tot confrontaties met de regeringsgetrouwe troepen van Assad, onder andere in de olierijke provincie Deir Ezzor. De Syrische regeringstroepen worden ondersteund door de Russische luchtmacht."
                            }
                        ]
                    }
