    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7de3e4a-23fc-316d-885f-62a2bc58bac4",
                    "sense_definition": "Een kledingstuk voor het bovenlichaam, meestal met knopen en een kraag.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij draagt elke dag een schoon wit <w>hemd</w> naar zijn werk.",
                            "target_lang_translations": {
                                "en": "He wears a clean white <w>shirt</w> to work every day.",
                                "ru": "Он каждый день надевает на работу чистую белую <w>рубашку</w>."
                            }
                        },
                        {
                            "text": "Vergeet niet om de strijken voordat je dat <w>hemd</w> aantrekt.",
                            "target_lang_translations": {
                                "en": "Don't forget to iron before you put on that <w>shirt</w>.",
                                "ru": "Не забудь погладить, прежде чем надеть эту <w>рубашку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "overhemd"
                    ],
                    "common_phrases": [
                        "wit hemd",
                        "hemd met knopen"
                    ],
                    "target_lang_definitions": {
                        "en": "A garment for the upper body, usually with buttons and a collar.",
                        "ru": "Предмет одежды для верхней части тела, обычно с пуговицами и воротником."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shirt",
                                "target_lang_sense_clarification": "general upper body garment"
                            },
                            {
                                "target_lang_word": "dress shirt",
                                "target_lang_sense_clarification": "formal or button-down shirt"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рубашка",
                                "target_lang_sense_clarification": "общий термин для мужской или женской рубашки"
                            },
                            {
                                "target_lang_word": "сорочка",
                                "target_lang_sense_clarification": "мужская классическая рубашка под костюм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fcf8227-77f9-340e-a45e-e64353b3f284",
                    "sense_definition": "Een mouwloos kledingstuk dat direct op de huid onder andere kleding wordt gedragen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onderkleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter draag ik altijd een extra <w>hemd</w> onder mijn trui.",
                            "target_lang_translations": {
                                "en": "In the winter I always wear an extra <w>undershirt</w> under my sweater.",
                                "ru": "Зимой я всегда ношу дополнительную <w>майку</w> под свитер."
                            }
                        },
                        {
                            "text": "Het kind liep alleen in zijn <w>hemd</w> door de tuin.",
                            "target_lang_translations": {
                                "en": "The child walked through the garden in only his <w>undershirt</w>.",
                                "ru": "Ребенок гулял по саду в одной <w>майке</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderhemd",
                        "singlet"
                    ],
                    "common_phrases": [
                        "onder het hemd",
                        "katoenen hemd"
                    ],
                    "target_lang_definitions": {
                        "en": "A sleeveless garment worn directly on the skin under other clothing.",
                        "ru": "Предмет одежды без рукавов, который надевается непосредственно на тело под другую одежду."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "undershirt",
                                "target_lang_sense_clarification": "worn under other clothes"
                            },
                            {
                                "target_lang_word": "vest",
                                "target_lang_sense_clarification": "British English for undershirt"
                            },
                            {
                                "target_lang_word": "singlet",
                                "target_lang_sense_clarification": "sleeveless undergarment"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "майка",
                                "target_lang_sense_clarification": "нижнее белье без рукавов"
                            },
                            {
                                "target_lang_word": "нижняя рубашка",
                                "target_lang_sense_clarification": "нательная одежда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}