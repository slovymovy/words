                        "entry_id": "f1cbee40-3c99-359b-a320-88244be757e8",
                        "glosses": [
                            "auf die Sekunde genaue Taktung, vor allem zur Abrechnung von Telefongesprächen oder Ähnlichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a9a6372-7fbd-416a-b5c2-ef3b6725e68b",
                                "sense_id": "68080438-2c72-3e73-8fd8-cc2be3d1f299",
                                "text": "„Besonders ärgerlich ist die Veränderung deswegen, da bisher in die deutschen Mobilfunknetze nicht nur ein günstiger Preis von 13,50 Ct/Min. galt, sondern auch der faire und kundenfreundliche Sekundentakt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "22b1089a-d7af-376c-a2a5-9733ad5a520c",
