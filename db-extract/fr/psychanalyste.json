        "fr-extract.jsonl": [
            {
                "entry_id": "34a3930a-b966-337f-ba73-7b2ac6f5de97",
                "word": "psychanalyste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8bcf6780-ad7c-48d9-8035-1d67d3188501",
                        "entry_id": "34a3930a-b966-337f-ba73-7b2ac6f5de97",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "psychanalystes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a1bf78d-9024-3c9c-a5da-1fc7a676735f",
                        "entry_id": "34a3930a-b966-337f-ba73-7b2ac6f5de97",
                        "glosses": [
                            "Celui ou celle qui pratique la psychanalyse de quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d16440-1c22-4467-8c14-2be9c0c5fad2",
                                "sense_id": "3a1bf78d-9024-3c9c-a5da-1fc7a676735f",
                                "text": "L’homme a inventé les dieux et il a créé l’amour avec son cortège de sensibleries ridicules ou criminelles. L’amour a donné naissance au poète, puis au psychologue et, pour couronner l’humaine sottise, à cet enfonceur de portes ouvertes qui s’est baptisé psychanalyste — le paladin du refoulement et l’écuyer servant la Haute Dame Libido."
                            },
                            {
                                "example_id": "e78cd257-dd6c-435c-8d45-305220a02784",
                                "sense_id": "3a1bf78d-9024-3c9c-a5da-1fc7a676735f",
                                "text": "Il y a beau temps que le terrain de la tragédie hellénique est revendiqué par les mythologues, les hellénistes et les psychanalystes surtout depuis que ceux-ci, Freud le premier à la fin du siècle dernier, ont essayé de désénigmatiser les mythes en construisant celui du « complexe d’Œdipe »."
                            },
                            {
                                "example_id": "1467e241-4fd8-439f-9efc-31f568519781",
                                "sense_id": "3a1bf78d-9024-3c9c-a5da-1fc7a676735f",
                                "text": "Les psychanalystes, dont le métier est la découverte chaque fois renouvelée de l’inconscient, sont nécessairement d’infatigables chercheurs."
                            },
                            {
                                "example_id": "a222a201-bfd3-4a22-9396-1e82f0e779f9",
                                "sense_id": "3a1bf78d-9024-3c9c-a5da-1fc7a676735f",
                                "text": "Le psychanalyste est très mauvais, toutes ses réponses sont à côté de la plaque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cb9ca37-d621-4fe8-bcbd-52efdda255ff",
                        "source_entry_id": "34a3930a-b966-337f-ba73-7b2ac6f5de97",
                        "source_sense_id": "3a1bf78d-9024-3c9c-a5da-1fc7a676735f",
                        "target_lang_word": "Psychoanalytiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychoanalytiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c076dd3b-99c7-34b6-9517-05e3c5249a2c",
                                        "entry_id": "67b8349b-bf4e-3046-b8f8-c62b01f26ece",
                                        "glosses": [
                                            "Facharzt oder Psychologe, der Patienten mit Psychoanalyse behandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cbf7177-0435-459e-a2fc-57839cff6d15",
                                                "sense_id": "c076dd3b-99c7-34b6-9517-05e3c5249a2c",
                                                "text": "„Sie sagte, dass sich seit damals ja viel in der Wissenschaft getan hätte, und musste sich ziemlich beherrschen, sodass ich nicht umhinkam zu denken, dass die gewöhnlichen Pillenpsychiater diese wenigen Psychoanalytiker wohl in die Isolation getrieben hatten.“"
                                            },
                                            {
                                                "example_id": "13417832-19bf-4c2c-9843-1aec9e458a4d",
                                                "sense_id": "c076dd3b-99c7-34b6-9517-05e3c5249a2c",
                                                "text": "„Ein praktischer Arzt, der einen seelisch erkrankten Patienten zum Psychoanalytiker geschickt hatte, erkundigte sich nach einem halben Jahr, wie es dem Schmerzenskind ginge."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08c9d6d9-89db-4c57-bd69-791ec6040b61",
                        "source_entry_id": "34a3930a-b966-337f-ba73-7b2ac6f5de97",
                        "source_sense_id": "3a1bf78d-9024-3c9c-a5da-1fc7a676735f",
                        "target_lang_word": "Psychoanalytikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychoanalytikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89d5f1aa-0bb0-30ae-99aa-9182674cf492",
                                        "entry_id": "0be6baa7-d736-3233-b18e-9285cda490da",
                                        "glosses": [
                                            "Fachärztin oder Psychologin, die Patienten mit Psychoanalyse behandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "948be5ab-acee-4cc3-b581-d2eec3f176ff",
                                                "sense_id": "89d5f1aa-0bb0-30ae-99aa-9182674cf492",
                                                "text": "Als Psychoanalytikerin kümmerte sie sich um rund 20 Patienten und Patientinnen."
                                            },
                                            {
                                                "example_id": "fcf2d257-d83c-4630-a6b9-d8dafc8429f6",
                                                "sense_id": "89d5f1aa-0bb0-30ae-99aa-9182674cf492",
                                                "text": "„Die 1885 in Hamburg geborene Psychoanalytikerin lebte bis 1932 in Berlin und wanderte dann in die Vereinigten Staaten aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
