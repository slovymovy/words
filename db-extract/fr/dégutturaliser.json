                "senses": [
                    {
                        "sense_id": "b104bb55-036a-392e-8e0c-1d9eefe09d10",
                        "entry_id": "86ea659a-b7fe-3b73-989a-b01b76ed83ad",
                        "glosses": [
                            "Faire perdre à quelque chose son caractère guttural."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb9bc0f-5837-49f4-81dc-d23b5b296ff9",
                                "sense_id": "b104bb55-036a-392e-8e0c-1d9eefe09d10",
                                "text": "Edmond Duvernoy lui avait appris à dégutturaliser sa voix."
                            },
                            {
                                "example_id": "476bd8fb-34f4-4923-a00f-2d18ec08db27",
                                "sense_id": "b104bb55-036a-392e-8e0c-1d9eefe09d10",
                                "text": "Le G est dégutturalisé par le i dans la syllabe Gil (cf. Gillenormand, Gilbert, etc.) ; de Guernesey, mais aussi de Gil Holm Ur (ex-Kidor-mur, mot celte ou scandinave ?), la chaise de granit où il mourra, assis et noyé."
                            },
                            {
                                "example_id": "074cc13f-0e3c-41fa-99b2-a4c3e87436d0",
                                "sense_id": "b104bb55-036a-392e-8e0c-1d9eefe09d10",
                                "text": "La forme dégutturalisée est celle de la Turquie contemporaine Tanrï."
                            }
                        ]
                    }
