                        "entry_id": "c11456d2-7879-3dfe-ba8c-0b48dffcd6ab",
                        "glosses": [
                            "The act of one who clings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed96e07b-5428-444f-b1aa-465d8a6f7b5f",
                                "sense_id": "a9077bdb-49ac-3b18-b64e-3d4448c0c6f1",
                                "text": "The mind […] ascribes characters to things. It can become attached in the process, the attachment taking such forms as erroneous thoughts and clingings, and the Buddha-nature thereby becomes defiled in the way that the sun may be obscured by clouds or a mirror by dust."
                            }
                        ]
                    }
