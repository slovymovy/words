{
    "word_family": [
        "vain",
        "vainly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d116d1d-cf5a-3fe7-a195-4612c1c1b23a",
                    "sense_definition": "Excessive pride in or admiration of one's own abilities, appearance, achievements, or possessions.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "pride",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought the expensive sports car out of sheer <w>vanity</w>.",
                            "target_lang_translations": {
                                "ru": "Он купил дорогую спортивную машину из чистого <w>тщеславия</w>.",
                                "nl": "Hij kocht de dure sportwagen uit pure <w>ijdelheid</w>."
                            }
                        },
                        {
                            "text": "Her <w>vanity</w> prevented her from admitting that she had made a mistake.",
                            "target_lang_translations": {
                                "ru": "Её <w>тщеславие</w> помешало ей признать, что она совершила ошибку.",
                                "nl": "Haar <w>ijdelheid</w> weerhield haar ervan toe te geven dat ze een fout had gemaakt."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrogance",
                        "conceit"
                    ],
                    "antonyms": [
                        "modesty",
                        "humility"
                    ],
                    "common_phrases": [
                        "wounded vanity",
                        "sheer vanity",
                        "appeal to vanity",
                        "personal vanity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерная гордость или восхищение собственными способностями, внешностью или достижениями.",
                        "nl": "Overmatige trots op of bewondering voor eigen capaciteiten, uiterlijk of prestaties."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тщеславие",
                                "target_lang_sense_clarification": "стремление к славе и почитанию"
                            },
                            {
                                "target_lang_word": "самомнение",
                                "target_lang_sense_clarification": "высокое мнение о себе"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ijdelheid",
                                "target_lang_sense_clarification": "overdreven trots op uiterlijk of zichzelf"
                            },
                            {
                                "target_lang_word": "verwaandheid",
                                "target_lang_sense_clarification": "arrogantie of eigendunk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c73a024c-0f51-34f7-b642-8cfbcd2d9bdf",
                    "sense_definition": "A dressing table used to apply makeup, preen, and coif hair, in which the table is normally quite low and similar to a desk.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat at her <w>vanity</w> to brush her hair before the party.",
                            "target_lang_translations": {
                                "ru": "Она села за свой <w>туалетный столик</w>, чтобы причесаться перед вечеринкой.",
                                "nl": "Ze zat aan haar <w>kaptafel</w> om haar haar te borstelen voor het feest."
                            }
                        },
                        {
                            "text": "The antique <w>vanity</w> in the bedroom has a large oval mirror.",
                            "target_lang_translations": {
                                "ru": "У старинного <w>туалетного столика</w> в спальне есть большое овальное зеркало.",
                                "nl": "De antieke <w>kaptafel</w> in de slaapkamer heeft een grote ovale spiegel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vanity table",
                        "vanity mirror",
                        "sit at the vanity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Столик с зеркалом, за которым накладывают макияж и причесываются.",
                        "nl": "Een lage tafel met spiegel waaraan men zich kan opmaken en kappen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туалетный столик",
                                "target_lang_sense_clarification": "мебель"
                            },
                            {
                                "target_lang_word": "трюмо",
                                "target_lang_sense_clarification": "столик с большим зеркалом"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "kaptafel",
                                "target_lang_sense_clarification": "meubel met spiegel voor verzorging"
                            },
                            {
                                "target_lang_word": "toilettafel",
                                "target_lang_sense_clarification": "opmaaktafel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3c2b165-927d-3189-a30d-7e011afbf0a4",
                    "sense_definition": "A washbasin installed into a permanently fixed storage unit, used as an item of bathroom furniture.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to install a double <w>vanity</w> in the master bathroom.",
                            "target_lang_translations": {
                                "ru": "Мы решили установить двойную <w>раковину с тумбой</w> в главной ванной комнате.",
                                "nl": "We besloten een dubbel <w>badkamermeubel</w> te installeren in de hoofdbadkamer."
                            }
                        },
                        {
                            "text": "The plumber fixed the leak in the pipes underneath the <w>vanity</w>.",
                            "target_lang_translations": {
                                "ru": "Сантехник устранил течь в трубах под <w>тумбой раковины</w>.",
                                "nl": "De loodgieter repareerde het lek in de leidingen onder het <w>wastafelmeubel</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bathroom vanity",
                        "double vanity",
                        "vanity unit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раковина, встроенная в шкафчик или тумбу, используемая как мебель для ванной комнаты.",
                        "nl": "Een wastafel geïntegreerd in een vast badkamermeubel met opbergruimte."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тумба под раковину",
                                "target_lang_sense_clarification": "мебель в ванной"
                            },
                            {
                                "target_lang_word": "мойдодыр",
                                "target_lang_sense_clarification": "разг. раковина с тумбой"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "badkamermeubel",
                                "target_lang_sense_clarification": "kast met wastafel"
                            },
                            {
                                "target_lang_word": "wastafelmeubel",
                                "target_lang_sense_clarification": "onderkast inclusief wasbak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77127e3f-1c51-3a20-8236-513c0e9f85f3",
                    "sense_definition": "That which is vain, futile, or worthless; that which is of no value, use or profit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "futility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He eventually realized the <w>vanity</w> of trying to please everyone all the time.",
                            "target_lang_translations": {
                                "ru": "В конце концов он осознал <w>тщетность</w> попыток угодить всем и всегда.",
                                "nl": "Uiteindelijk besefte hij de <w>zinloosheid</w> van proberen iedereen altijd tevreden te stellen."
                            }
                        },
                        {
                            "text": "The novel explores the <w>vanity</w> of human wishes and the pursuit of wealth.",
                            "target_lang_translations": {
                                "ru": "Роман исследует <w>тщету</w> человеческих желаний и погони за богатством.",
                                "nl": "De roman onderzoekt de <w>ijdelheid</w> van menselijke wensen en het najagen van rijkdom."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vanity of vanities",
                        "vanity project"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often literary or biblical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что не имеет истинной ценности; бесполезность или бессмысленность усилий.",
                        "nl": "Het zinloze, nutteloze of waardeloze karakter van iets; leegheid."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тщетность",
                                "target_lang_sense_clarification": "бесполезность усилий"
                            },
                            {
                                "target_lang_word": "суета",
                                "target_lang_sense_clarification": "пустое, не имеющее ценности"
                            },
                            {
                                "target_lang_word": "тщета",
                                "target_lang_sense_clarification": "книжн. бессмысленность"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ijdelheid",
                                "target_lang_sense_clarification": "zinloosheid of vluchtigheid"
                            },
                            {
                                "target_lang_word": "zinloosheid",
                                "target_lang_sense_clarification": "nutteloosheid"
                            },
                            {
                                "target_lang_word": "nutteloosheid",
                                "target_lang_sense_clarification": "het vergeefs zijn"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1041366a-be60-361d-85db-43160f3a57d1",
                    "sense_definition": "A female given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I have never met anyone named <w>Vanity</w> before today.",
                            "target_lang_translations": {
                                "ru": "Я никогда не встречал никого по имени <w>Ванити</w> до сегодняшнего дня.",
                                "nl": "Ik heb tot vandaag nog nooit iemand ontmoet die <w>Vanity</w> heet."
                            }
                        },
                        {
                            "text": "<w>Vanity</w> is known for her hard work and dedication to the team.",
                            "target_lang_translations": {
                                "ru": "<w>Ванити</w> известна своим трудолюбием и преданностью команде.",
                                "nl": "<w>Vanity</w> staat bekend om haar harde werk en toewijding aan het team."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "nl": "Een vrouwelijke voornaam."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ванити",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "Vanity",
                                "target_lang_sense_clarification": "eigennaam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}