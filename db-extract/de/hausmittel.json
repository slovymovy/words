                        "sense_id": "5daee0aa-35eb-3f45-a347-21920c40d159",
                        "entry_id": "2a872e75-7c3c-319f-a0fb-73a1aaae9e25",
                        "glosses": [
                            "domestic remedy; nostrum; quick fix"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "eb0f0d8a-9679-4930-9ef0-4d2fb6722c66",
                                "sense_id": "5daee0aa-35eb-3f45-a347-21920c40d159",
                                "text": "ein bewährtes Hausmittel [gegen]"
                            },
                            {
                                "example_id": "0246541d-b42b-4556-9561-8fd887a23381",
                                "sense_id": "5daee0aa-35eb-3f45-a347-21920c40d159",
                                "text": "Nicht allen Menschen ist es eigentlich um ihre Bildung zu tun; viele wünschen nur so ein Hausmittel zum Wohlbefinden, Rezepte zum Reichtum und zu jeder Art von Glückseligkeit.",
                                "translation": "Not everyone cares about being cultivated, many just want a quick remedy for their well-being, recipes for wealth and all kinds of happiness.",
                                "english": "Not everyone cares about being cultivated, many just want a quick remedy for their well-being, recipes for wealth and all kinds of happiness."
                            },
                            {
                                "example_id": "28781121-4d90-48bd-9ca7-71423ae50fff",
                                "sense_id": "5daee0aa-35eb-3f45-a347-21920c40d159",
                                "text": "Heute gibt es Methoden, die weniger stinken. Bewährte Hausmittel konkurrieren mit künstlich hergestellten Wirkstoffen und modernen Technologien. Aber wie erwiesen ist ihre Wirksamkeit wirklich? Und wie beeinflussen sie unsere Gesundheit und Umwelt?"
                            }
                        ]
                    }
