                        "examples": [
                            {
                                "example_id": "25b9d3df-6d85-48d8-a30b-4e6e740ad931",
                                "sense_id": "25b99e3f-2992-3c83-ab6c-c45835b3654c",
                                "text": "A taxon is a group of real organisms recognised as a formal unit at any level of a hierarchic classification."
                            },
                            {
                                "example_id": "2444a0c1-7aec-4c76-b3b9-424a4f2eabbb",
                                "sense_id": "25b99e3f-2992-3c83-ab6c-c45835b3654c",
                                "text": "A taxon is a taxonomic group of any rank that is sufficiently distinct to be worthy of being assigned to a definite category."
                            }
                        ]
                    }
