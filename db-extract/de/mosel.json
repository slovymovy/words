                        ]
                    },
                    {
                        "translation_id": "d390ef73-61a9-47a9-8c67-62a882e961b9",
                        "source_entry_id": "3adee324-5e52-3128-b33c-94dc2074c1e4",
                        "source_sense_id": "93a79afb-1289-362a-844c-f58456a70603",
