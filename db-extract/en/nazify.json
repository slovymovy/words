                        "glosses": [
                            "To subject or convert to Nazism (National Socialism)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb2cf88-5a0d-407e-b462-5cef1322a9a5",
                                "sense_id": "20cc1a4d-8eb0-3cda-b179-65e4aaec3aa7",
                                "text": "It did more to de-nazify the Germans than to nazify the French."
                            },
                            {
                                "example_id": "db1ed165-4200-47ce-b65c-1e5d9938812c",
                                "sense_id": "20cc1a4d-8eb0-3cda-b179-65e4aaec3aa7",
                                "text": "The Ministry of Education expects the teachers of history to espouse National Socialism positively. Thus how to Nazify rather than whether to Nazify […]"
                            }
                        ]
                    }
                ],
