                                "target_senses": [
                                    {
                                        "sense_id": "71087ba9-b17a-310a-974c-010027671ec4",
                                        "entry_id": "ca1a35b0-0052-3373-90db-1bcebd6d0a65",
                                        "glosses": [
                                            "Of or pertaining to Portugal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98d9256e-f8a5-4a0e-8de1-e5d96e935524",
                                                "sense_id": "71087ba9-b17a-310a-974c-010027671ec4",
                                                "text": "Portuguese borders"
                                            },
                                            {
                                                "example_id": "9c58dbed-5c5e-433a-b0f2-d55d5354b96a",
                                                "sense_id": "71087ba9-b17a-310a-974c-010027671ec4",
                                                "text": "The British army had already moved over the border and the commander had established his HQ high in the central Portuguese mountains at Viseu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92c79b0d-68e9-3e2b-b636-bc3ec6f17466",
                                        "entry_id": "ca1a35b0-0052-3373-90db-1bcebd6d0a65",
                                        "glosses": [
                                            "Of or pertaining to the people of Portugal or their culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe9a1a55-b7d2-44f9-8046-2a00bb68485e",
                                                "sense_id": "92c79b0d-68e9-3e2b-b636-bc3ec6f17466",
                                                "text": "Portuguese cuisines"
                                            },
                                            {
                                                "example_id": "6aa5d899-b72b-4875-9432-d0692368a342",
                                                "sense_id": "92c79b0d-68e9-3e2b-b636-bc3ec6f17466",
                                                "text": "In San Diego County there is but one Portuguese fisherman, as is also the case in Los Angeles, the county immediately adjoining."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e96c176-d848-3ebd-8fcf-31f6b0531f83",
                                        "entry_id": "ca1a35b0-0052-3373-90db-1bcebd6d0a65",
                                        "glosses": [
                                            "Of or pertaining to the Portuguese language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03581c79-e309-4373-86a7-c4176a45defd",
                                                "sense_id": "8e96c176-d848-3ebd-8fcf-31f6b0531f83",
                                                "text": "Portuguese verbs"
                                            },
                                            {
                                                "example_id": "c92bb7f3-e3f4-48bd-ad94-a67a9262894b",
                                                "sense_id": "8e96c176-d848-3ebd-8fcf-31f6b0531f83",
                                                "text": "The latter feature indicates that a Portuguese consonant cannot constitute the nucleus of a syllable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Portuguese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d10c02d1-6999-3a08-b387-881998efb8d3",
                                        "entry_id": "15abf457-5a5a-383d-865b-47565407fe0d",
                                        "glosses": [
                                            "A person native to, or living in, Portugal."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a893678-e203-4524-987d-dca9c0f36feb",
                                                "sense_id": "d10c02d1-6999-3a08-b387-881998efb8d3",
                                                "text": "[…] but so close lay the boats that even single hooks snarled, and Harvey found himself in hot argument with a gentle, hairy Newfoundlander on one side and a howling Portuguese on the other."
                                            },
                                            {
                                                "example_id": "7015756c-4272-44fd-926f-53ada6fd2c47",
                                                "sense_id": "d10c02d1-6999-3a08-b387-881998efb8d3",
                                                "text": "With a view to securing its more efficient working, a Portuguese was placed in charge of the entire department as Vidane."
                                            },
                                            {
                                                "example_id": "2f308b36-c6ed-4e03-9b90-1fd03330ba11",
                                                "sense_id": "d10c02d1-6999-3a08-b387-881998efb8d3",
                                                "text": "Beresford required all materials for coatees, waistcoats and pantaloons to be sent out unmade, as the Portuguese were perfectly capable of making the suits up properly after delivery."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Portuguese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d895473-415f-35ee-b857-a9f4adb388e8",
                                        "entry_id": "1b4803b3-6b4a-3a2d-b294-0d95d6c1c6ec",
                                        "glosses": [
                                            "A Romance language originating in Portugal, and now the official language of Portugal, Angola, Mozambique, São Tomé and Príncipe, Guiné Bissau (Guinea-Bissau), Cape Verde, East Timor, and Brazil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47bc9d11-7d9d-48eb-aa57-9d56614db63a",
                                                "sense_id": "7d895473-415f-35ee-b857-a9f4adb388e8",
                                                "text": "Portuguese, however, is slightly different from Catalan, Spanish, and Romanian in that there is no strict adjacency requirement between wh-words and the verbal cluster in indirect questions."
                                            },
                                            {
                                                "example_id": "34c67902-6436-4a05-9577-363b69d9b55b",
                                                "sense_id": "7d895473-415f-35ee-b857-a9f4adb388e8",
                                                "text": "Overall it is Taipa (which means mudflats in Portuguese and its Cantonese name Tam-zai also means mud flats) that has changed the most through reclamation followed by the east coast of the Macau Peninsula.",
                                                "translation": "文化局",
                                                "english": "文化局"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
