                "senses": [
                    {
                        "sense_id": "39b49cb9-1287-3c16-9125-5efc2f24d0de",
                        "entry_id": "9b55b1d5-558c-3c00-88df-ed872aad8a7f",
                        "glosses": [
                            "Qui peut pourrir, se décomposer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "038e9106-808f-40c4-83ba-1e74ed97b4e8",
                                "sense_id": "39b49cb9-1287-3c16-9125-5efc2f24d0de",
                                "text": "La bière est d’ailleurs composée de substances plus putréfiables que le suc des raisins, parce que leur peau les garantit des impuretés dont l’eau qui fait la base de la bière n’est pas exempte."
                            },
                            {
                                "example_id": "7e5eb687-0785-4a58-8a66-9bef10c6c0f2",
                                "sense_id": "39b49cb9-1287-3c16-9125-5efc2f24d0de",
                                "text": "La substance médullaire nerveuse parait, au contraire, résister beaucoup plus à la pourriture : les nerfs sont même une des parties de l’économie animale les moins putréfiables."
                            },
                            {
                                "example_id": "e63c9215-ff5a-4b73-958e-68cdb4bd3fd2",
                                "sense_id": "39b49cb9-1287-3c16-9125-5efc2f24d0de",
                                "text": "Le tri sélectif à domicile apparaît en France en 1883. Eugène Poubelle, préfet de la Seine, impose alors aux Parisiens l’usage de récipients à couvercle baptisés « poubelles » : un pour les déchets putréfiables, un pour les papiers et les chiffons, et un pour le verre, la faïence ou les coquilles d’huîtres dont les Parisiens raffolent."
                            }
                        ]
                    }
