                ],
                "senses": [
                    {
                        "sense_id": "e385af94-d8c2-3060-b387-131cf137d2b7",
                        "entry_id": "c4a21678-e4e4-37eb-85bb-b2e3a47356b2",
                        "glosses": [
                            "fachlich durchgeführte Untersuchung und Auswertung des Bewegungsablaufs beim Gehen oder Laufen auf dem Laufband, meist zur Erkennung von Fehlbelastungen oder zur Empfehlung geeigneter Laufschuhe"
                        ],
                        "tags": [
                            "Laufsport",
                            "Orthopädie"
                        ],
                        "examples": [
                            {
                                "example_id": "b90a15ce-0e54-4d6c-bcc4-d60d51e8eccf",
                                "sense_id": "e385af94-d8c2-3060-b387-131cf137d2b7",
                                "text": "„Der Läufer stellt sich auf ein Laufband, woraufhin der Trainer die sogenannte Laufbandanalyse durchführt.“"
                            },
                            {
                                "example_id": "ade49e22-9dd2-40c2-a566-51d60c2583c6",
                                "sense_id": "e385af94-d8c2-3060-b387-131cf137d2b7",
                                "text": "„Einer erfahrenen Fachperson hilft der alte Laufschuh oft mehr als die Laufbandanalyse.“"
                            },
                            {
                                "example_id": "a48c6089-85fb-45cb-9e5b-b3eb46a2d1e7",
                                "sense_id": "e385af94-d8c2-3060-b387-131cf137d2b7",
                                "text": "„Anbieter einer Laufbandanalyse sind in der Regel Orthopäden, Sportmediziner, Physiotherapeuten und Orthopädie-Schuhtechniker sowie vereinzelt auch in Sportgeschäften.“"
                            },
                            {
                                "example_id": "50c2c3c0-c2a3-490b-9881-94400d3cb15e",
                                "sense_id": "e385af94-d8c2-3060-b387-131cf137d2b7",
                                "text": "„So zum Beispiel Funktions- und Sporteinlagen sowie sensomotorische Einlagen, die auf Basis von Haltungsanalysen, Rückenvermessung, Laufbandanalyse und sogar 3-D Video-Fußdruckanalyse individuell durch CAD / CAM-Technik direkt von AllOrtho gefertigt werden.“"
                            },
                            {
                                "example_id": "338e8da6-a58f-4515-8240-d583d56b85c0",
                                "sense_id": "e385af94-d8c2-3060-b387-131cf137d2b7",
                                "text": "„In einigen Fällen kann eine gezielte Trainingsanpassung oder Laufbandanalyse helfen, um Fehlbelastungen zu korrigieren und Verletzungen vorzubeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
