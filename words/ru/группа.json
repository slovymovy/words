                                "target_lang_sense_clarification": "close gathering"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "群",
                                "target_lang_sense_clarification": "用于人或物的集合"
                            },
                            {
                                "target_lang_word": "组",
                                "target_lang_sense_clarification": "用于分类或聚集的单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a966c4d5-19e6-3731-99e5-a4b1653c6044",
                    "sense_definition": "Музыкальный коллектив, исполняющий песни или музыку.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя любимая рок-<w>группа</w> приезжает с концертом в Москву.",
                            "target_lang_translations": {
                                "en": "My favorite rock <w>band</w> is coming to Moscow for a concert.",
                                "zh": "我最喜欢的摇滚<w>乐队</w>要来莫斯科开演唱会了。"
                            }
                        },
                        {
                            "text": "В молодости мой отец играл на гитаре в школьной <w>группе</w>.",
                            "target_lang_translations": {
                                "en": "In his youth, my father played guitar in a school <w>band</w>.",
                                "zh": "年轻时，我父亲曾在学校的<w>乐队</w>里弹吉他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "коллектив",
                        "ансамбль",
                        "бэнд"
                    ],
                    "common_phrases": [
                        "музыкальная группа",
                        "рок-группа",
                        "популярная группа"
                    ],
                    "target_lang_definitions": {
                        "en": "A musical collective performing songs or music.",
                        "zh": "表演歌曲或音乐的音乐团体。"
                    },
                    "translations": {
