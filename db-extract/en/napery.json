                        "sense_id": "4b62b7e3-f69d-3c47-aa40-e7e3efc303f1",
                        "entry_id": "c9549267-fd51-320a-8d79-b77c2d33628a",
                        "glosses": [
                            "Household linen, especially table linen."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "30f52653-7d3a-4bad-92ee-89c7e7e63b8a",
                                "sense_id": "4b62b7e3-f69d-3c47-aa40-e7e3efc303f1",
                                "text": "She led the way through a wide hall into a charming room, where a table was already spread in its dainty napery and silver."
                            },
                            {
                                "example_id": "0c3383c4-2a33-4e40-83e1-bebb24303cdd",
                                "sense_id": "4b62b7e3-f69d-3c47-aa40-e7e3efc303f1",
                                "text": "Many will have pleasing recollections of the attractive effect, especially on a winter evening, of a dining car or Pullman train, with its shaded table-lamps throwing their light on napery, cutlery, and glass to give a heartening picture of well-being."
                            },
                            {
                                "example_id": "e34152be-9beb-49e3-928e-169da4ffc2ef",
                                "sense_id": "4b62b7e3-f69d-3c47-aa40-e7e3efc303f1",
                                "text": "Banter and low laughter swayer about the huge tent, swayed among the shadows thrown by the brilliant candelabra pendant on their inverted stems above the white napery of the central table."
                            }
                        ]
                    }
                ],
