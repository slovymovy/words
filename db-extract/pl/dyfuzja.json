                                        "examples": [
                                            {
                                                "example_id": "33591cd2-965c-47a2-9cf1-86a38e1604c3",
                                                "sense_id": "faf9e255-6936-34c6-8850-5e4926d14d95",
                                                "text": "Man kann die Diffusion einsetzten, um Bildstörungen zu unterdrücken."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c1b58cb3-ed34-3d07-a9c7-794742e5cb7f",
                                        "entry_id": "797653dd-6ce2-37eb-9f89-d58dc8dfe299",
                                        "glosses": [
                                            "Einführung und Verbreitung von Innovationen in einem sozialen System"
                                        ],
                                        "tags": [
                                            "Betriebswirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51215687-1661-427d-82db-0ae242ab221d",
                                                "sense_id": "c1b58cb3-ed34-3d07-a9c7-794742e5cb7f",
                                                "text": "Die Diffusion gelingt, wenn mehr und mehr Individuen die Neuerung akzepieren und in der Praxis anwenden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5b1e3ef7-ad94-3ab7-999d-e2c11efa4506",
                                        "entry_id": "797653dd-6ce2-37eb-9f89-d58dc8dfe299",
                                        "glosses": [
                                            "Streuung von Licht oder Strahlung"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "695d5549-90aa-4348-a5e5-602a137985e2",
                                                "sense_id": "5b1e3ef7-ad94-3ab7-999d-e2c11efa4506",
                                                "text": "Durch die Diffusion des Lichtes am Lampenschirm wird die Raumbeleuchtung weicher."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a01aa39f-7d0b-319c-a6bf-3ebbdc706fa5",
                                        "entry_id": "797653dd-6ce2-37eb-9f89-d58dc8dfe299",
                                        "glosses": [
                                            "Verbreitung von Kulturelementen durch Übernahme und Wanderung"
                                        ],
                                        "tags": [
                                            "Kultur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "336f7645-6949-4181-92fc-bdbf49078c2e",
                                                "sense_id": "a01aa39f-7d0b-319c-a6bf-3ebbdc706fa5",
                                                "text": "Es ist wesentlich wahrscheinlicher, dass die kulturelle Gegebenheit über Diffusion einen Weg in den Nachbarstaat findet, als dass es dort unabhängig und zufällig zur gleichen Entwicklung kommt."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed737edc-3e2b-456d-b213-86a4a01c97d1",
                        "source_entry_id": "94283f63-771f-3fb6-929f-24bab6be40f0",
                        "source_sense_id": "abf1b18d-c2ce-3497-bfd0-4512125bbf57",
                        "target_lang_word": "диффузия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "диффузия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1f46072f-7366-3305-9f1b-4dc6c52dffbe",
                                        "entry_id": "41c62581-14ad-3c62-a17d-a637bd437ada",
                                        "glosses": [
                                            "физ., хим. взаимное проникновение соприкасающихся веществ друг в друга вследствие теплового движения частиц"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e33f31ca-5655-45f9-b463-08d594411a49",
                                                "sense_id": "1f46072f-7366-3305-9f1b-4dc6c52dffbe",
                                                "text": "Нетрудно также обнаружить и диффузию жидкостей: стоит вспомнить, вероятно, многим знакомый опыт с водой и вином; если на поверхность воды осторожно налить красного вина, то обе жидкости образуют два ясно между собой разграниченных слоя. Но мало-помалу резкая граница между ними исчезает, ― вино проникает в воду, вода в вино; обе жидкости смешиваются."
                                            },
                                            {
                                                "example_id": "84f4b269-c710-46bf-bcd4-d50b5b399e22",
                                                "sense_id": "1f46072f-7366-3305-9f1b-4dc6c52dffbe",
                                                "text": "И если, благодаря сравнительной свободе движущихся частиц, диффузия газообразных тел совершается в промежуток времени, измеряемый секундами и минутами, то то же явление в жидкостях требует часов и дней, а в твердых телах, где молекулы пробираются лишь с величайшим трудом, преодолевая на своем пути тысячи препятствий, скорость диффузии так мала, что требуются для сколько-нибудь заметного результата недели и месяцы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65c8b8ca-1683-3779-b1b1-56dd64019797",
                                        "entry_id": "41c62581-14ad-3c62-a17d-a637bd437ada",
                                        "glosses": [
                                            "перен., книжн. проникновение элементов какого-либо явления в другое явление"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eebf5fb-b7d4-4d96-b568-995a278406f6",
                                                "sense_id": "65c8b8ca-1683-3779-b1b1-56dd64019797",
                                                "text": "Сейчас диффузия жанров ― явление для критика само собой разумеющееся, нормальное и закономерное."
                                            }
                                        ]
                                    }
                                ]
