                        "entry_id": "af60e540-fe05-3899-b250-b64e58c9ed20",
                        "glosses": [
                            "Programs that surreptitiously monitor and report the actions of a computer user."
                        ],
                        "tags": [
                            "Internet",
                            "uncountable"
                        ],
                        "examples": [
                            {
