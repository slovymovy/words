                "senses": [
                    {
                        "sense_id": "8b105e39-82d4-3c3d-a200-aa5dc000cc76",
                        "entry_id": "3272b0b6-32c0-3650-bcec-8011450a5bea",
                        "glosses": [
                            "eine Ballsportart, bei der zwei Mannschaften den Ball mit dem Unterarm oder der Faust über ein Band schlagen müssen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "134d667e-2abd-45c5-9ea6-21ec073a7849",
                                "sense_id": "8b105e39-82d4-3c3d-a200-aa5dc000cc76",
                                "text": "„Im Gegensatz zum Volleyball, wo die Spieler rotieren und nach jedem Aufschlagwechsel eine andere Position einnehmen, hat im Faustball jeder Spieler seine feste Position.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "af4a3728-ac4f-3203-b24a-811e541e45f6",
                        "entry_id": "3272b0b6-32c0-3650-bcec-8011450a5bea",
                        "glosses": [
                            "der in dieser Sportart verwendete Lederball"
                        ],
                        "tags": [
                            "Ballsport",
                            "Freizeit"
                        ],
                        "examples": [
                            {
                                "example_id": "82014dfc-7281-4ef9-84bb-8879088372be",
                                "sense_id": "af4a3728-ac4f-3203-b24a-811e541e45f6",
                                "text": "„Der Faustball ist hohl, luftgefüllt und besteht aus Leder.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
