                "senses": [
                    {
                        "sense_id": "efa13a18-2904-3d2d-9d5f-1591d6b79f63",
                        "entry_id": "3f7c017e-5742-3408-8626-05f3dbaa9e2d",
                        "glosses": [
                            "größere Fläche mit Reklame darauf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b7b3fe1-3e97-418c-ac68-3f3a549fdd79",
                                "sense_id": "efa13a18-2904-3d2d-9d5f-1591d6b79f63",
                                "text": "„Die Reklametafel dient dem Auslieferator als Orientierungshilfe.“"
                            },
                            {
                                "example_id": "915508ff-1ab2-4037-bd3f-082693ac9e21",
                                "sense_id": "efa13a18-2904-3d2d-9d5f-1591d6b79f63",
                                "text": "„Drinnen im Zug gab es Reklamephotos von gräßlichen pittoresken Ruinen, draußen im Regen Reklametafeln für Spezialmedikamente und Hundekuchen.“"
                            },
                            {
                                "example_id": "5bd27205-a112-4bfa-b3dd-cca82dc7df11",
                                "sense_id": "efa13a18-2904-3d2d-9d5f-1591d6b79f63",
                                "text": "„Der Hilux rast an einer großen Reklametafel vorbei, die spanische Villen mit französischen Fenstern und importierten Küchen ankündigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
