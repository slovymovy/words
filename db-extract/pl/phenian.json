                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c76f8e2e-90f8-46b9-9c88-01de3327dd0b",
                                "sense_id": "63817beb-3586-3ee7-90b1-242b8ad7e2ba",
                                "text": "Władzom w Phenianie również zależało na szybkim załatwieniu sprawy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5eb5614-ebd2-410a-a7ad-8b00d1096587",
                        "source_entry_id": "af274737-08e2-3b68-8ebe-b7ca6f9bb173",
                        "source_sense_id": "63817beb-3586-3ee7-90b1-242b8ad7e2ba",
                        "target_lang_word": "Пхеньян",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Пхеньян",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bb085a05-c58e-352f-b9f6-a80aea9b670d",
                                        "entry_id": "a35422b0-c453-3936-bf93-b67f65ca5bb1",
                                        "glosses": [
                                            "геогр. город в Азии, столица КНДР"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f123008-65ec-46af-ab3c-0c5664a215cd",
                                                "sense_id": "bb085a05-c58e-352f-b9f6-a80aea9b670d",
                                                "text": "Численность населения современного Пхеньяна с пригородами превышает 4 млн человек."
                                            },
                                            {
                                                "example_id": "0a6b9b15-d9ab-40cf-b8a3-df12dfad41e5",
                                                "sense_id": "bb085a05-c58e-352f-b9f6-a80aea9b670d",
                                                "text": "Я ожидал увидеть сутолоку узеньких улиц, суету базаров, причудливую на взгляд европейца архитектуру. Ничего этого я не нашёл в Пхеньяне."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae119f82-fb71-3be5-9e56-c6546cef461e",
                                        "entry_id": "a35422b0-c453-3936-bf93-b67f65ca5bb1",
                                        "glosses": [
                                            "метоним., полит. правительство КНДР"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88dd8ac-8e56-47c2-9bd0-c027d7cf1068",
                                                "sense_id": "ae119f82-fb71-3be5-9e56-c6546cef461e",
                                                "text": "Официальный Пхеньян эти слухи пока не комментирует."
                                            },
                                            {
                                                "example_id": "f20b13eb-e5d1-47bf-80ee-cb65ce96f843",
                                                "sense_id": "ae119f82-fb71-3be5-9e56-c6546cef461e",
                                                "text": "Правительство Китая обратилось к Пхеньяну с просьбой принять меры, чтобы сократить поток беженцев из КНДР."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
