        "fr-extract.jsonl": [
            {
                "entry_id": "be5d49b1-ca66-3aa9-bcbf-cb40a6256437",
                "word": "apesanteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c305c8ed-5779-49e9-86aa-b8b2e2b054db",
                        "entry_id": "be5d49b1-ca66-3aa9-bcbf-cb40a6256437",
                        "tags": [
                            "plural"
                        ],
                        "form": "apesanteurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3874efcb-6bf4-32b3-8fa0-ba44a528c1db",
                        "entry_id": "be5d49b1-ca66-3aa9-bcbf-cb40a6256437",
                        "glosses": [
                            "Absence de pesanteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baccfd48-d826-4454-8f4c-611eddd28b78",
                                "sense_id": "3874efcb-6bf4-32b3-8fa0-ba44a528c1db",
                                "text": "Je collais mon front à la vitre. Quelques centimètres me séparaient du berceau et je n’aurais pas été étonné s’il s’était balancé dans l’air, en état d’apesanteur."
                            },
                            {
                                "example_id": "4766f452-5b33-4162-a56c-29ab2ac1d810",
                                "sense_id": "3874efcb-6bf4-32b3-8fa0-ba44a528c1db",
                                "text": "Dans l’espace, de graves dangers nous guettent, parmi lesquels : micrométéorites, radiations cosmiques mortelles et vieillissement accéléré en apesanteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "42dc6fa7-907f-3e67-8988-4f8c747f7326",
                        "entry_id": "be5d49b1-ca66-3aa9-bcbf-cb40a6256437",
                        "glosses": [
                            "Fait de ne peser en rien sur le cours du monde."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "50721132-1cbb-402e-9f1f-918124f15980",
                                "sense_id": "42dc6fa7-907f-3e67-8988-4f8c747f7326",
                                "text": "Ce \"non-lieu\" n'est-il pas propice à toutes les apesanteurs sociales, sentimentales, familiales, culturelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "0be2436a-ce76-3d95-a3d5-8b9133f6ba85",
                        "entry_id": "be5d49b1-ca66-3aa9-bcbf-cb40a6256437",
                        "glosses": [
                            "Sentiment de ne pas ressentir son propre poids."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d972f8bb-2c2b-4b38-bf64-dda4a602a0e3",
                                "sense_id": "0be2436a-ce76-3d95-a3d5-8b9133f6ba85",
                                "text": "Je me suis offert ses services, une fois n'est pas coutume, pour une heure en apesanteur, pétri ayurvédiquement telle une chapati avant le tandour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5b7a129-b8d2-49ea-b0f5-579bf2c7a8f0",
                        "source_entry_id": "be5d49b1-ca66-3aa9-bcbf-cb40a6256437",
                        "source_sense_id": "3874efcb-6bf4-32b3-8fa0-ba44a528c1db",
                        "source_sense_description": "(Astronautique) Absence de pesanteur.",
                        "target_lang_word": "Schwerelosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwerelosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c599b117-dce6-3ca4-943b-3ab0be5601f1",
                                        "entry_id": "67d53a3e-6404-37b2-9aac-ecd1e2ac2dcb",
                                        "glosses": [
                                            "Zustand, in dem entweder keine Schwerkraft wirkt oder deren Auswirkung nicht zu spüren ist (zum Beispiel im freien Fall)"
                                        ],
                                        "tags": [
                                            "no-plural",
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ef7cbc2-148a-4e61-959b-6f8fe65f51c7",
                                                "sense_id": "c599b117-dce6-3ca4-943b-3ab0be5601f1",
                                                "text": "„Als Fallturm bezeichnet man einen Turm, in dem zum Zweck der Erzeugung kurzzeitiger Schwerelosigkeit (bis etwa 10 Sekunden Dauer) Fallversuche durchgeführt werden.“"
                                            },
                                            {
                                                "example_id": "be66a1cd-0043-4ae3-aa09-41bb5750e299",
                                                "sense_id": "c599b117-dce6-3ca4-943b-3ab0be5601f1",
                                                "text": "„In der Schwerelosigkeit beziehungsweise bei einer Abwesenheit äußerer Kräfte nehmen Flüssigkeiten aufgrund ihrer Oberflächenspannung eine kugelförmige Gestalt an, da diese Form die Oberfläche minimiert.“"
                                            },
                                            {
                                                "example_id": "d468fd7a-8cbb-4366-ac6a-21e5266a0b0d",
                                                "sense_id": "c599b117-dce6-3ca4-943b-3ab0be5601f1",
                                                "text": "„In Gummischläuche gewickelt schwebten sie in der Schwerelosigkeit des Weltalls und winkten uns aus dem Fernseher zu.“"
                                            },
                                            {
                                                "example_id": "4169d0cd-9c9f-4fd7-8c02-54be5889ceec",
                                                "sense_id": "c599b117-dce6-3ca4-943b-3ab0be5601f1",
                                                "text": "„Wir werden nun endlich erfahren, wie man sich bei 29000 Stundenkilometern im Zustand völliger Schwerelosigkeit fühlt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4ac6486b-8220-3c16-9f62-0cb1d34f8fc5",
                                        "entry_id": "67d53a3e-6404-37b2-9aac-ecd1e2ac2dcb",
                                        "glosses": [
                                            "innere Ruhe, Unbeschwertheit"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76873f8-8acb-4081-a664-f9f216e49779",
                                                "sense_id": "4ac6486b-8220-3c16-9f62-0cb1d34f8fc5",
                                                "text": "„Schnell spiegelt sich die unendliche Ruhe in einem Gefühl tiefen Wohlbefindens wider, einem Zustand innerer Schwerelosigkeit – typische Symptome eines fortgeschrittenen Lapplandsfieber.“"
                                            },
                                            {
                                                "example_id": "6e179e0b-d21d-445f-9ada-98a23e576d00",
                                                "sense_id": "4ac6486b-8220-3c16-9f62-0cb1d34f8fc5",
                                                "text": "„Scheinbare Schwerelosigkeiten der Dorfgespräche lassen Abgründe zwischen den Worten ahnen, deren historische Tiefen kaum auszuloten sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
