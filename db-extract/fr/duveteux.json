                        "source_entry_id": "d42401e3-fb0a-3309-952d-bffadcab88e9",
                        "target_lang_word": "downy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "downy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f73da9-7f28-38ba-a072-80b6a6241400",
                                        "entry_id": "712830a6-387d-3882-b34e-5dfc1f26bd68",
                                        "glosses": [
                                            "Having down, covered with a soft fuzzy coating as of small feathers or hair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484b9de1-f9ac-4350-b481-8eac1a691701",
                                                "sense_id": "d1f73da9-7f28-38ba-a072-80b6a6241400",
                                                "text": "The chick's downy coat of feathers formed almost immediately to keep it warm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bba21517-0478-33dc-891b-d8b5748c4532",
                                        "entry_id": "712830a6-387d-3882-b34e-5dfc1f26bd68",
                                        "glosses": [
                                            "Sharp-witted, perceptive."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c992f75d-7f77-4efa-8932-ef6ddb9de8d8",
                                                "sense_id": "bba21517-0478-33dc-891b-d8b5748c4532",
                                                "text": "The right hon. Gentleman has much more claim to the adjective downy than I have, but he really cannot catch me with that one."
                                            },
                                            {
                                                "example_id": "0e89a88a-f647-4be8-afe2-bf18e5672dbd",
                                                "sense_id": "bba21517-0478-33dc-891b-d8b5748c4532",
                                                "text": "I’m not clever, p’raps: but I am rather downy; and partial friends say I know what’s o’clock tolerably well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa5c3367-97dc-326b-8b6f-381c66eaa2d5",
                                        "entry_id": "712830a6-387d-3882-b34e-5dfc1f26bd68",
                                        "glosses": [
                                            "Low-spirited; down in the mouth."
                                        ],
                                        "tags": [
                                            "Norfolk",
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "downy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53b7ce45-759f-3916-8d11-696d21aa031b",
                                        "entry_id": "b0e2c104-1295-3a9d-bf36-495b6d73b02b",
                                        "glosses": [
                                            "A blanket filled with down; a duvet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d6d01d6-4375-4a1d-aeab-6a62f078227d",
                                                "sense_id": "53b7ce45-759f-3916-8d11-696d21aa031b",
                                                "text": "Went to bed with 2 downies on the bed, but the heat finally kicked in and ended with one cover and my feet sticking out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960659c4-598d-3da6-9624-6b9f1c94c636",
                                        "entry_id": "b0e2c104-1295-3a9d-bf36-495b6d73b02b",
                                        "glosses": [
                                            "A bed."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dae342a2-9637-43f6-94ae-bc303f51efc0",
                                                "sense_id": "960659c4-598d-3da6-9624-6b9f1c94c636",
                                                "text": "to do the downy (i.e. lie in bed)"
                                            },
                                            {
                                                "example_id": "f48a04fb-8b6e-45ba-99fb-5b509d5ccdd6",
                                                "sense_id": "960659c4-598d-3da6-9624-6b9f1c94c636",
                                                "text": "\"Lord love you, Mr. Scott, I've a deal to do before I get to my downy; and I don't like those doctored tipples. Good night, Mr. Scott; I wishes you good night, sir;\" and making another slight reference to his hat, which had not been removed from his head during the whole interview, Mr. Manylodes took himself off."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f7b403f-66ad-4486-a3ab-ff98e8fd8117",
                        "source_entry_id": "d42401e3-fb0a-3309-952d-bffadcab88e9",
                        "target_lang_word": "donzig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donzig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "64fd0761-23bb-331e-99bf-8461168ddef3",
                                        "entry_id": "899e1efc-5395-33fe-8f49-d63d434137fc",
                                        "glosses": [
                                            "met een fijn los verenkleed bedekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f52ed2fc-7611-4fc6-a350-265c1f5aa921",
                                                "sense_id": "64fd0761-23bb-331e-99bf-8461168ddef3",
                                                "text": "\"Piep!\" zei het donzige kuikentje."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc7b79b2-72e2-4a54-acaf-bbf608fa1ba9",
                        "source_entry_id": "d42401e3-fb0a-3309-952d-bffadcab88e9",
                        "target_lang_word": "пушистый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пушистый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "16bdce3f-850b-396c-9376-9d98804aff94",
                                        "entry_id": "1b26a4cb-848f-36bf-b022-ec27295b1c38",
                                        "glosses": [
                                            "покрытый пухом, мехом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4706fb0e-8f1c-4347-9a2c-69b516e72db9",
                                                "sense_id": "16bdce3f-850b-396c-9376-9d98804aff94",
                                                "text": "Лебеди спали прямо посреди пруда ― упрятав под крыло головы, сложив петлей пушистые шеи, медленно дрейфуя вслед за едва ощутимым течением."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0a59a99-b8ca-3c66-9e41-baa01050588e",
                                        "entry_id": "1b26a4cb-848f-36bf-b022-ec27295b1c38",
                                        "glosses": [
                                            "лёгкий, очень мягкий и пышный как пух"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e9e478-93c4-443a-b549-0c629c299556",
                                                "sense_id": "f0a59a99-b8ca-3c66-9e41-baa01050588e",
                                                "text": "А сверху всё сыплет да сыплет пушистым белым саваном на помертвевшую землю…"
                                            },
                                            {
                                                "example_id": "6636b2f1-b276-4217-9a4c-2bd9417d1b4f",
                                                "sense_id": "f0a59a99-b8ca-3c66-9e41-baa01050588e",
                                                "text": "Передо мной предстал человек ещё молодой, лет тридцати, красивый, крепко сложённый, с румяным лицом и пушистою светлою бородой."
                                            },
                                            {
                                                "example_id": "1395eb3e-f8fe-410e-b04f-f0b316fb584d",
                                                "sense_id": "f0a59a99-b8ca-3c66-9e41-baa01050588e",
                                                "text": "Но длинные пушистые ресницы трепещут, и глаза смотрят на мир любопытно и весело, как будто увидели его заново."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b53dd843-314e-3291-a6bb-5f8335551158",
                                        "entry_id": "1b26a4cb-848f-36bf-b022-ec27295b1c38",
                                        "glosses": [
                                            "разг., перен., неол. добрый, доброжелательный, мягкий, покладистый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee03e720-a68e-427f-8761-7e691a95ca24",
                                                "sense_id": "b53dd843-314e-3291-a6bb-5f8335551158",
                                                "text": "Девушка белая, пушистая ― и фамилия белая, пушистая. Сейчас на ангелов вообще спрос…"
                                            },
                                            {
                                                "example_id": "438dce51-6777-4ab6-b867-4b488fb2c55e",
                                                "sense_id": "b53dd843-314e-3291-a6bb-5f8335551158",
                                                "text": "Предполагается доброжелательная сущность, белая и пушистая."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
