                    {
                        "sense_id": "1b4b69b5-b3ed-3877-91d3-2eb693e10a1d",
                        "entry_id": "58b20747-2354-3aef-9387-ea7bd6e5b46f",
                        "glosses": [
                            "Contribuer au projet Wikisource."
                        ],
                        "tags": [
                            "Extrêmement rare",
                            "Wikis"
                        ],
                        "examples": [
                            {
                                "example_id": "b808be7e-78cb-41cb-b123-2c54b239d21e",
                                "sense_id": "1b4b69b5-b3ed-3877-91d3-2eb693e10a1d",
                                "text": "profite d’un dimanche au calme pour wikisourcer."
                            },
                            {
                                "example_id": "41ee5cc8-0ad7-46a2-8d12-637d4c7a6d72",
                                "sense_id": "1b4b69b5-b3ed-3877-91d3-2eb693e10a1d",
                                "text": "ramène ta fraise pour wikisourcer des œuvres d’autrices! Ce matin (now) chez @Wikimedia_Fr"
                            },
                            {
                                "example_id": "7a0d3657-2363-44fe-b313-0bea678212e6",
                                "sense_id": "1b4b69b5-b3ed-3877-91d3-2eb693e10a1d",
                                "text": "Quelques ressources :\nPrésentation de l’atelier\n Comment Wikisourcer ?\nVidéo de présentation 1-5min"
                            },
                            {
                                "example_id": "3e643b72-2f2f-4b4b-a1df-80a3cf3cc39c",
                                "sense_id": "1b4b69b5-b3ed-3877-91d3-2eb693e10a1d",
                                "text": "Atelier sur le vocabulaire des Poilus à la BML\nMerci d’avoir participé à l’atelier sur le vocabulaire des Poilus !\nLe bilan de l’atelier est sur la page Wikipédia des ateliers et plus de 25 pages ont été enrichies (et patrouillées) en à peine deux heures, c’est super ! Si tu veux wikisourcer sur ce thème, voilà le lien vers le dictionnaire de 1916 avec plein d'images"
                            },
                            {
                                "example_id": "9d894b34-4a62-495c-b8f5-adcd761b9c51",
                                "sense_id": "1b4b69b5-b3ed-3877-91d3-2eb693e10a1d",
                                "text": "J’ai proposé une sélection des quatrains les plus caractéristiques et/ou amusants, ce qui n’empêche pas de wikisourcer la chose , si le contributeur le désire."
                            }
                        ]
                    }
