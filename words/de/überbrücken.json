                    "frequency": "High",
                    "semantic_group_id": "zeitlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir tranken am Bahnhof einen Kaffee, um die Wartezeit bis zur Abfahrt des Zuges zu <w>überbrücken</w>."
                        },
                        {
                            "text": "Während der langen Pause <w>überbrückte</w> sie die Zeit mit einem spannenden Buch."
                        }
                    ],
                    "synonyms": [
                        "ausfüllen"
                    ],
                    "common_phrases": [
