                "senses": [
                    {
                        "sense_id": "93d99309-1a4b-350b-ba9e-ddc1ed9e6ad3",
                        "entry_id": "3701e39e-b96c-385e-ad49-4fe46b4b565d",
                        "glosses": [
                            "om ergernis uit te drukken"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "52ebdc5b-2eec-42cc-8c23-e24eae86f33f",
                                "sense_id": "93d99309-1a4b-350b-ba9e-ddc1ed9e6ad3",
                                "text": "Het lijkt verdorie wel een zwijnenstal hier!"
                            },
                            {
                                "example_id": "a7e64719-6c3b-4160-bc35-625d6f42e125",
                                "sense_id": "93d99309-1a4b-350b-ba9e-ddc1ed9e6ad3",
                                "text": "Ik probeer de overheid te helpen, zoals ook de overheid steeds meer van haar burger verwacht. En dan krijg ik, verdorie, van diezelfde overheid, een boete!"
                            },
                            {
                                "example_id": "3e4b403c-dc91-4515-8879-9bd04a711031",
                                "sense_id": "93d99309-1a4b-350b-ba9e-ddc1ed9e6ad3",
                                "text": "Ze leek heel vrolijk en zei alleen verdorie, als in het voorbijgaan, toen ze onderweg op de trap een ladder in haar kous ontdekte."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae48358c-c568-3267-bf10-29896d6bd110",
                        "entry_id": "3701e39e-b96c-385e-ad49-4fe46b4b565d",
                        "glosses": [
                            "om grote verbazing uit te drukken"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "8ea486fe-5a1b-492d-97d8-68f6dffe3aa7",
                                "sense_id": "ae48358c-c568-3267-bf10-29896d6bd110",
                                "text": "Kijk eens goed, wat krioelt daar toch allemaal onder het oppervlak? Het lijken verdorie wel kreeftjes.\nVerrassing: het zíjn kreeftjes. De Nederlandse binnenwateren stikken ervan."
                            }
                        ]
                    }
                ],
