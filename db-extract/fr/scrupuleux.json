        "fr-extract.jsonl": [
            {
                "entry_id": "9a2ba3cb-d8a3-389c-82f3-1b609ef7b6c6",
                "word": "scrupuleux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "563d5daa-c787-4560-9d48-27d800014f2e",
                        "entry_id": "9a2ba3cb-d8a3-389c-82f3-1b609ef7b6c6",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "scrupuleuse"
                    },
                    {
                        "form_id": "6a50473c-02dd-4d34-8772-5697e0abec95",
                        "entry_id": "9a2ba3cb-d8a3-389c-82f3-1b609ef7b6c6",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "scrupuleuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5cc5b38-91c7-3b64-aabc-cc03f2e2d4bb",
                        "entry_id": "9a2ba3cb-d8a3-389c-82f3-1b609ef7b6c6",
                        "glosses": [
                            "Qui est sujet à avoir des scrupules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df24757-8307-43f0-903f-9e2246379403",
                                "sense_id": "d5cc5b38-91c7-3b64-aabc-cc03f2e2d4bb",
                                "text": "Conscience scrupuleuse."
                            },
                            {
                                "example_id": "a4eed2bb-14ec-4bcd-86e6-6d85723a01d0",
                                "sense_id": "d5cc5b38-91c7-3b64-aabc-cc03f2e2d4bb",
                                "text": "On ne peut être trop scrupuleux, dès qu’il s’agit de probité, de délicatesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b65bd78-7418-3ed8-a047-0a2d0f32b205",
                        "entry_id": "9a2ba3cb-d8a3-389c-82f3-1b609ef7b6c6",
                        "glosses": [
                            "Qui est délicat sur les procédés et sur les moyens de réussir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3ab504b-3d22-4bf3-97a0-0647ddd6c3a1",
                                "sense_id": "0b65bd78-7418-3ed8-a047-0a2d0f32b205",
                                "text": "C’est une race vigoureuse et résistante, assez travailleuse, patiente dans l’adversité, âpre au gain et peu scrupuleuse dans le choix de ses moyens, peu véridique et volontiers voleuse, pillarde et homicide."
                            },
                            {
                                "example_id": "2e4429c4-1722-4d24-bc8a-fd18f75c0ff4",
                                "sense_id": "0b65bd78-7418-3ed8-a047-0a2d0f32b205",
                                "text": "Premièrement, du point de vue historique, Bungener est un scrupuleux, un besogneux (comme le confirme la notice biographique que nous avons placée à la fin de ce volume, écrite par un de ses amis, le pasteur Jean-Pierre Gaberel)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b5d3e78-56e7-337d-8e49-f547f8b02e3f",
                        "entry_id": "9a2ba3cb-d8a3-389c-82f3-1b609ef7b6c6",
                        "glosses": [
                            "Qui est très exactement conforme à la règle, au devoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "058f20ba-d98e-4924-94c8-c06519e1001c",
                                "sense_id": "6b5d3e78-56e7-337d-8e49-f547f8b02e3f",
                                "text": "Nous sommes si éloignés de connaître tous les agens de la nature, et leurs divers modes d’action ; qu’il ne serait pas philosophique de nier les phénomènes, uniquement parce qu’ils sont inexplicables dans l’état actuel de nos connaissances. Seulement, nous devons les examiner avec une attention d’autant plus scrupuleuse, qu’il paraît plus difficile de les admettre […]"
                            },
                            {
                                "example_id": "9b364bb0-ede7-4e70-bc1f-c4b09bf1b54c",
                                "sense_id": "6b5d3e78-56e7-337d-8e49-f547f8b02e3f",
                                "text": "Le rameur qui conduit un jeteur d’épervier doit, avant tout, prendre attentivement le soin d’entretenir son bateau dans un scrupuleux état de propreté […]"
                            },
                            {
                                "example_id": "64b8585a-7889-45cf-b575-b80cfd79bca5",
                                "sense_id": "6b5d3e78-56e7-337d-8e49-f547f8b02e3f",
                                "text": "La souveraineté populaire, qui n’est pas le respect scrupuleux de la souveraineté individuelle, est un despotisme qui ne diffère du despotisme monarchique que par le costume ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c694075c-4a95-4a3b-8de6-8cf46b9435b7",
                        "source_entry_id": "9a2ba3cb-d8a3-389c-82f3-1b609ef7b6c6",
                        "source_sense_description": "qui peut avoir des scrupules",
                        "target_lang_word": "scrupulous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrupulous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5d89a81-5d7a-3bf2-be0b-cbc452b49733",
                                        "entry_id": "bd772c72-b525-3e78-8432-53b8aa5eea7e",
                                        "glosses": [
                                            "Exactly and carefully conducted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce3ed2c-73bf-417c-8f59-e2c8137d09f2",
                                                "sense_id": "e5d89a81-5d7a-3bf2-be0b-cbc452b49733",
                                                "text": "Come on! You have got to admire their dedication to the rules! These two men are so scrupulous, they would sit at a broken red traffic light for six hours in the middle of the night. “Hey, red is red! We live in a civilized society! Red is red! We stay!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97977855-a45b-320e-94d5-65c03a5d4f3d",
                                        "entry_id": "bd772c72-b525-3e78-8432-53b8aa5eea7e",
                                        "glosses": [
                                            "Having scruples or compunctions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa5b3458-cc67-3c5e-ba91-64f79821bbbc",
                                        "entry_id": "bd772c72-b525-3e78-8432-53b8aa5eea7e",
                                        "glosses": [
                                            "Precise; exact or strict."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b14f19fa-0ee7-49db-b652-b0e0c20c2c57",
                                                "sense_id": "aa5b3458-cc67-3c5e-ba91-64f79821bbbc",
                                                "text": "He is scrupulous in his finances."
                                            },
                                            {
                                                "example_id": "736402a4-bae0-4179-bac9-af8046e68b3b",
                                                "sense_id": "aa5b3458-cc67-3c5e-ba91-64f79821bbbc",
                                                "text": "He is a scrupulous businessman and always acts in the best interest of his company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5fa0a8-fa17-3c31-b6f5-441aff7fdf65",
                                        "entry_id": "bd772c72-b525-3e78-8432-53b8aa5eea7e",
                                        "glosses": [
                                            "Wrongly feeling guilt or anxiety about one’s morality; suffering from scrupulosity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "940347fd-321b-4a0c-9ab6-a73d77dff5cb",
                                                "sense_id": "3d5fa0a8-fa17-3c31-b6f5-441aff7fdf65",
                                                "text": "Because I have a scrupulous conscience, I sometimes need to be reminded that not everything I do is sinful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f3d51d4-ccc3-42c5-8ce5-e056f7dba4ef",
                        "source_entry_id": "9a2ba3cb-d8a3-389c-82f3-1b609ef7b6c6",
