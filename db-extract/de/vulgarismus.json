                                    {
                                        "sense_id": "80e297eb-c943-3f36-9ac8-fa1e9fefe536",
                                        "entry_id": "001a8938-a4bd-35a9-a71d-0304231a905c",
                                        "glosses": [
                                            "A word or term that is considered offensive or vulgar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c8173b-da20-43a5-a481-f8e436e20422",
                                                "sense_id": "80e297eb-c943-3f36-9ac8-fa1e9fefe536",
                                                "text": "\"Shit\" is a vulgarism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0782ced-f33b-3a67-a14e-75612b936f93",
                                        "entry_id": "001a8938-a4bd-35a9-a71d-0304231a905c",
                                        "glosses": [
                                            "A spelling, word, or phrase used in common speech that is considered improper or incorrect for formal communication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d098548a-abe4-472e-9408-85fbf873a7f0",
                                                "sense_id": "d0782ced-f33b-3a67-a14e-75612b936f93",
                                                "text": "We never descended to the vulgarism of a quarrel. People said that neither of us had a heart, but it appears to me that politeness is an excellent substitute."
                                            },
                                            {
                                                "example_id": "06930bf9-889d-4da2-a4a4-7f3f0e504f37",
                                                "sense_id": "d0782ced-f33b-3a67-a14e-75612b936f93",
                                                "text": "Editors of newspapers allow more vulgarisms to go to print today than they used to."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
