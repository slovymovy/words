                                "sense_id": "6697c5bc-b922-3a99-8ffa-ff189a748203",
                                "text": "Een weekdier bestaat voor het grootste deel uit water."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04ef02e6-8db0-4f0a-b81c-183e1e03a11a",
