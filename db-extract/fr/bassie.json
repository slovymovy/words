                        "entry_id": "9de24232-4b0f-3157-bcb5-05568c77d726",
                        "glosses": [
                            "Pièce proche de la cuisine et servant à divers travaux ménagers, souillarde, arrière-cuisine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7651552e-79c1-4641-9304-99f2e3fea0bd",
                                "sense_id": "153f75cb-8cf9-3755-8af2-cdd0b20fb4e8",
                                "text": "La bassie désigne l’arrière-cuisine ou souillarde et non plus l’évier, […]"
                            }
                        ]
