                ],
                "senses": [
                    {
                        "sense_id": "e25907e7-6b2d-31d1-9129-d780b1d91efa",
                        "entry_id": "e758d356-ffd1-3a00-9e01-583e309f269b",
                        "glosses": [
                            "Gitter, gefertigt aus Eisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14a0a16-fd5c-4954-a517-82489f2c804e",
                                "sense_id": "e25907e7-6b2d-31d1-9129-d780b1d91efa",
                                "text": "„[…] und hinter dem Eisengitter einer rauchgeschwärzten Höhle des Erdgeschosses, welche die Küche vorstellte, lehnte eine dicke Figur in vormals weißer Jacke und Kochmütze und schlief trotz der zahllosen Fliegen, die das breite, weinrothe Gesicht umschwärmten.“"
                            },
                            {
                                "example_id": "4d9731d7-e184-4cb7-b23c-bcd678fada77",
                                "sense_id": "e25907e7-6b2d-31d1-9129-d780b1d91efa",
                                "text": "„Am anderen Ende des Friedhofs war in der Ecke eine Fläche mit einem Eisengitter umfriedet.“"
                            },
                            {
                                "example_id": "8ba7c67a-4c28-446f-9dd3-4ac003c94d90",
                                "sense_id": "e25907e7-6b2d-31d1-9129-d780b1d91efa",
                                "text": "„Ein hoher weißer Marmorblock hob sich hervor aus der Umgebung, eingeschlossen von einem niederen Eisengitter, am Fuße überdeckt von Blumen und Kränzen.“"
                            },
                            {
                                "example_id": "ac3ae0c4-7b32-4eff-b851-62ed82b78124",
                                "sense_id": "e25907e7-6b2d-31d1-9129-d780b1d91efa",
                                "text": "„Ein naher Einschlag preßt seinen Luftdruck bis tief in den Kellerhals und wirft das Eisengitter um.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
