                            {
                                "example_id": "0ce80999-521a-41a2-881e-fdfd336dfaba",
                                "sense_id": "3392e5af-1afe-30ec-8f4a-9d1dba13e0e0",
                                "text": "Mein Vater hat eine entzündete Gallenblase."
                            },
                            {
                                "example_id": "afa084cc-e2c1-4f17-8244-fabd15b87890",
                                "sense_id": "3392e5af-1afe-30ec-8f4a-9d1dba13e0e0",
                                "text": "„Er hatte morgens eine Gallenblase operiert.“"
                            },
                            {
                                "example_id": "6c8abdaf-bfc5-4a17-a673-523dc4ec0aa1",
                                "sense_id": "3392e5af-1afe-30ec-8f4a-9d1dba13e0e0",
                                "text": "„Der Chirurg Jacques Marescaux steuerte von New York aus einen Operationsroboter und entfernte auf diese Weise einer Patientin in Straßburg die Gallenblase.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
