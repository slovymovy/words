                    {
                        "sense_id": "1c8bb89b-d610-3ab0-83c1-aea9e4677af4",
                        "entry_id": "26cab1c9-6726-3e43-afca-9c786843ecde",
                        "glosses": [
                            "een plan over hoe een bepaald gebied gebruikt mag gaan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "065ceeba-465e-459f-a229-e52d12d1e360",
                                "sense_id": "1c8bb89b-d610-3ab0-83c1-aea9e4677af4",
                                "text": "In het bestemmingsplan stond dat dit gebied gebruikt mocht worden voor recreatie."
                            },
                            {
                                "example_id": "8ae03698-8236-4ee3-8ba6-274e567487bb",
                                "sense_id": "1c8bb89b-d610-3ab0-83c1-aea9e4677af4",
                                "text": "Een zogeheten darkstore van een flitsbezorger in Amsterdam moet op last van de rechter uit het pand weg. De gemeente had de uitbater opgedragen de zaak te sluiten omdat de darkstore in strijd zou zijn met het bestemmingsplan. Daartegen werd bezwaar aangetekend, maar de voorzieningenrechter geeft de gemeente dus gelijk."
                            }
                        ]
                    }
                ],
