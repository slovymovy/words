                        "sense_id": "c1f750fb-5303-3061-a118-81e609355575",
                        "entry_id": "b451862d-ab08-373c-9f95-b43a59ee6406",
                        "glosses": [
                            "Qui est converti à l’état de nitrate ou auquel on a ajouté des nitrates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dec9d6ad-b808-466f-b11c-fae81ab1115b",
                                "sense_id": "c1f750fb-5303-3061-a118-81e609355575",
                                "text": "Depuis l'affaissement de la digue d'un bassin de décantation, le week-end dernier, sur le site de Malvési «pollué» par quelque 15.000 m³ de boues nitratées, une cellule de crise a été activée."
                            },
                            {
                                "example_id": "32dbe259-79ab-41ef-a2e9-2100bacf29fe",
                                "sense_id": "c1f750fb-5303-3061-a118-81e609355575",
                                "text": "Les bassins de décantation destinés à l’entreposage – c’est-à-dire au stockage provisoire – des boues nitratées radioactives sont ainsi transformés en installation de stockage de déchets industriels provenant d’installations classées (et, en l’occurrence, de déchets dangereux)."
                            }
                        ]
                    }
