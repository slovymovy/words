                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antioxidant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4630fd29-d2a2-37ab-b232-631934031ba0",
                                        "entry_id": "dff21d9c-a432-334c-8820-13fd9e8ba9ad",
                                        "glosses": [
                                            "Any substance that slows or prevents the oxidation of another chemical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca08ca65-abfa-35ee-b66c-d77e1b68796e",
                                        "entry_id": "dff21d9c-a432-334c-8820-13fd9e8ba9ad",
                                        "glosses": [
                                            "One of a group of vitamins that act against the effects of free radicals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e135e36a-9cfc-4949-b7f2-a3a479370d29",
                                                "sense_id": "ca08ca65-abfa-35ee-b66c-d77e1b68796e",
                                                "text": "Although BHA (butylated hydroxyanisole) and BHT (butylated hydroxytoluene) are avoided by some consumers because several studies have suggested they may be toxic or carcinogenic (they are banned in Britain), these antioxidants have also been shown to inhibit the action of cancer-causing chemicals, and BHT has been shown to suppress the growth of harmful viruses."
                                            },
                                            {
                                                "example_id": "56bfc6cc-37a7-4079-a93a-f1c2c612aaea",
                                                "sense_id": "ca08ca65-abfa-35ee-b66c-d77e1b68796e",
                                                "text": "The postulated mechanism for the reaction of coumarin 4 as an antioxidant, as indicated in Fig 3, relies on the mercapto hydrogen atom (bold), which is under the influence of resonance and inductive effects."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antioxidant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea05722a-4c39-3d86-8bbf-361543e9183b",
                                        "entry_id": "4a4d439c-fe45-3d0a-bbda-c968298b3982",
                                        "glosses": [
                                            "Acting or having agents that act against oxidation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d1d408a-14b1-4191-9465-838d14986d22",
                                                "sense_id": "ea05722a-4c39-3d86-8bbf-361543e9183b",
                                                "text": "In Philasterides dicentrarchi, a scuticociliate pathogen of turbot, resveratrol causes oxidative stress, inhibition of antioxidant enzymes and morphological alterations in the mitochondria [17 ,54 ]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
