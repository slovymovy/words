                ],
                "senses": [
                    {
                        "sense_id": "924bc02f-1640-3927-a250-dfb6ff4099ff",
                        "entry_id": "a818951a-16e6-37c8-9a70-69f740945928",
                        "glosses": [
                            "Christlich Demokratische Union [Deutschlands]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f545794d-b968-4a56-8711-0612ce808fb5",
                                "sense_id": "924bc02f-1640-3927-a250-dfb6ff4099ff",
                                "text": "Die CDU bezeichnet sich als Volkspartei."
                            },
                            {
                                "example_id": "4803be19-b346-41a5-88d4-0203d8469808",
                                "sense_id": "924bc02f-1640-3927-a250-dfb6ff4099ff",
                                "text": "„Das Mädchen lobte die CDU und hielt es für sinnvoll, dass auch die Wirtschaft ein Wörtchen mitzureden habe.“"
                            },
                            {
                                "example_id": "35ad40f4-f3e5-41ca-b07b-9f52d4c57bf7",
                                "sense_id": "924bc02f-1640-3927-a250-dfb6ff4099ff",
                                "text": "„Über ihn hatte ich mir nie Illusionen gemacht, und nicht einmal die Tatsache, daß er jetzt Wahlreden für die CDU hielt, konnte mich in Erstaunen versetzen.“"
                            },
                            {
                                "example_id": "de0503ba-3cd8-46a3-93a0-7a2b61f1424c",
                                "sense_id": "924bc02f-1640-3927-a250-dfb6ff4099ff",
                                "text": "„»Sie waren unfähig, den Ausbau der erneuerbaren Energien herbeizuführen. Sie haben Abwehrkämpfe geführt gegen jede einzelne Windkraftanlage«, sagt Scholz und zeigt dabei auf die Sitzreihen von CDU und CSU.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
