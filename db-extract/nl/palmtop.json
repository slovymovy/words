                        "cross_references": [
                            {
                                "target_word": "personal digital assistant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b03bd62-32bf-3233-818d-f338d03333d4",
                                        "entry_id": "f716c22d-8a27-3aca-abb7-35ee1833f01a",
                                        "glosses": [
                                            "A hand-held computer, mostly used as an organizer."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85a13b77-913a-4ebe-8416-4392be7fd807",
                                                "sense_id": "4b03bd62-32bf-3233-818d-f338d03333d4",
                                                "text": "The device, about the size of a fat paperback book, represents the most ambitious attempt yet by computer and communications companies to pool their resources in hopes of finally creating a market for what the industry calls \"personal digital assistants.\""
                                            },
                                            {
                                                "example_id": "2afe34fa-65ca-4742-809a-300807861960",
                                                "sense_id": "4b03bd62-32bf-3233-818d-f338d03333d4",
                                                "text": "Already, Sharp owns at least 60 percent of the market for personal digital assistants, or P.D.A.'s, with its Wizard line, ranking far ahead of Hewlett-Packard, Casio, Apple Computer and other competitors past and present."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
