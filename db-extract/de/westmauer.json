                "senses": [
                    {
                        "sense_id": "30b2397b-c7e2-3215-9d0a-13f8abc5b8e8",
                        "entry_id": "0478ef8b-c612-3aa9-a8d6-6d9e3511afbc",
                        "glosses": [
                            "westlich gelegene Mauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e3ef2b-f0c9-44f8-b146-6c515ef53b14",
                                "sense_id": "30b2397b-c7e2-3215-9d0a-13f8abc5b8e8",
                                "text": "„Sekunden später legte er eine heftige Bruchlandung in der Nähe der Westmauer hin.“"
                            },
                            {
                                "example_id": "6eec5218-09c6-4790-b123-8567a44566f3",
                                "sense_id": "30b2397b-c7e2-3215-9d0a-13f8abc5b8e8",
                                "text": "„Auf den Wachtürmen an der Ost- und Westmauer der Strafanstalt versuchen Sicherheitsbeamte, mit ihren Schrotflinten über die Köpfe der Aufrührer hinwegzuschießen – treffen aber einzelne Wärter und Insassen, sodass das Blutbad noch vergrößert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
