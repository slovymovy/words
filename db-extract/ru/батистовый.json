                "senses": [
                    {
                        "sense_id": "663165cc-5d63-3aaa-8805-9586c0157cf1",
                        "entry_id": "d0d95b59-70d4-3442-bd5a-993227968c0e",
                        "glosses": [
                            "cambric"
