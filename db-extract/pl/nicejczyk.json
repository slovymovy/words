                "senses": [
                    {
                        "sense_id": "40b49057-9bec-3683-8ff9-fe964c539a72",
                        "entry_id": "628cba60-befb-3530-9f09-f5c34f5c84cb",
                        "glosses": [
                            "mieszkaniec Nicei (miasta we Francji)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d9cc489-1697-43cd-9195-de66a77d3c21",
                                "sense_id": "40b49057-9bec-3683-8ff9-fe964c539a72",
                                "text": "Nicejczycy tłumnie wylegli na ulice swojego miasta."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a57e9836-5df8-3b56-85fe-2e4d726d53c2",
                        "entry_id": "628cba60-befb-3530-9f09-f5c34f5c84cb",
                        "glosses": [
                            "mieszkaniec Nicei (miasta w Turcji)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "4c5805df-0aec-37ff-bbc0-9d0858b1517f",
                        "entry_id": "628cba60-befb-3530-9f09-f5c34f5c84cb",
                        "glosses": [
                            "wierny lub zwolennik chrześcijaństwa zgodnego z postanowieniami soboru nicejskiego I"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "265416bd-360e-4867-a6c6-cdca38b6e95c",
                                "sense_id": "4c5805df-0aec-37ff-bbc0-9d0858b1517f",
                                "text": "Toteż dopiero po krótkim epizodzie Juliana Apostaty i panowaniu kilku cesarzy, na przemian nicejczyków i arian, Teodozjusz Wielki zadał arianizmowi decydujący cios"
                            },
                            {
                                "example_id": "04023240-d149-4420-95f1-2f5e528d3436",
                                "sense_id": "4c5805df-0aec-37ff-bbc0-9d0858b1517f",
                                "text": "Klęska Walensa w bitwie z Wizygotami pod Adrianopolem w 378 r. dała początek ostatecznemu zwycięstwu nicejczyków nad arianizmem"
                            },
                            {
                                "example_id": "3046f9cd-3973-440e-b7fd-2d14b57712f0",
                                "sense_id": "4c5805df-0aec-37ff-bbc0-9d0858b1517f",
                                "text": "Boś się przeobraziła wśród Burgundów w ariankę, więc wmawiasz w siebie, iż nic ciebie nie obchodzą spory chrystoznawcze między katolikami prawosławnymi, czyli inaczej, jak nazywają pogardliwie arianie nas – nicejczykami"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
