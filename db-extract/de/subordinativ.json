                        "form": "es ist subordinativ"
                    },
                    {
                        "form_id": "1ced03c3-0c6b-454f-84f9-f3d9b3c87f45",
                        "entry_id": "e34972c0-559a-31fb-b035-30e8b46a6704",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind subordinativ"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a970f5d4-5a5d-3753-92b2-8a25920be3fd",
                        "entry_id": "e34972c0-559a-31fb-b035-30e8b46a6704",
                        "glosses": [
                            "in Bezug auf die Unterordnung (Subordination) von etwas"
                        ],
                        "tags": [
                            "vor allem"
                        ],
                        "examples": [
                            {
                                "example_id": "2854384a-6fa6-47d5-9f53-81e29bfdaa78",
                                "sense_id": "a970f5d4-5a5d-3753-92b2-8a25920be3fd",
                                "text": "„Das Prinzip der subordinativen Verbindung wird bei der Einbettung eines Nebensatzes in einen Hauptsatz angewandt.“"
                            },
                            {
                                "example_id": "fb3cecbc-876d-48e4-ab39-55c211a90ed2",
                                "sense_id": "a970f5d4-5a5d-3753-92b2-8a25920be3fd",
                                "text": "„Appositionen stellen hingegen relativ oft koordinativ und subordinativ erweiterte Phrasen dar.“"
                            },
                            {
                                "example_id": "13ab75d0-dc2f-44af-809d-34d6b341f4e6",
                                "sense_id": "a970f5d4-5a5d-3753-92b2-8a25920be3fd",
                                "text": "„Relativsätze sind Bestandteil komplexer Satzstrukturen, insofern sie Nominalphrasen satzwertig subordinativ modifizieren.“"
                            },
                            {
                                "example_id": "2ebba6ab-a25d-4934-992a-ea1a4f57191a",
                                "sense_id": "a970f5d4-5a5d-3753-92b2-8a25920be3fd",
                                "text": "„Konzessive Konnektoren sind überwiegend Subjunktoren und Adverbien, verknüpfen also subordinativ und via Adverbintegration.“"
                            },
                            {
                                "example_id": "dc271bc8-8ab4-4939-ba7d-59242fe1e1f0",
                                "sense_id": "a970f5d4-5a5d-3753-92b2-8a25920be3fd",
                                "text": "„Das Futur II wird hauptsächlich in temporalen subordinativen Satzverknüpfungen gebraucht.“"
                            },
                            {
                                "example_id": "ac15d01f-69e9-4cea-a29f-7ff085208e6d",
                                "sense_id": "a970f5d4-5a5d-3753-92b2-8a25920be3fd",
