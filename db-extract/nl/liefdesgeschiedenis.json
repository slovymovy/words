                                "target_senses": [
                                    {
                                        "sense_id": "2b4b4421-2fdf-3ea0-829b-6f6fc01ec571",
                                        "entry_id": "8e8b1e83-3e31-3c4e-9a8f-dddebcdb460c",
                                        "glosses": [
                                            "An affair; a usually adulterous relationship between people who are not married to each other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b5e1141-fe17-427f-a15a-997a6adb8056",
                                                "sense_id": "2b4b4421-2fdf-3ea0-829b-6f6fc01ec571",
                                                "text": "He was involved in a love affair with a married woman."
                                            },
                                            {
                                                "example_id": "37976f6e-06d7-4536-bbfe-79aeb87c92ac",
                                                "sense_id": "2b4b4421-2fdf-3ea0-829b-6f6fc01ec571",
                                                "text": "\"A love affair is an insatiable curiosity over an inscrutable enigma.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3388865-de22-3bc6-8ab9-d0fb24a8b699",
                                        "entry_id": "8e8b1e83-3e31-3c4e-9a8f-dddebcdb460c",
                                        "glosses": [
                                            "A feeling of enthusiasm or strong liking for something; a fondness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9350a52b-1433-430c-996c-1c3a55fe1a7d",
                                                "sense_id": "d3388865-de22-3bc6-8ab9-d0fb24a8b699",
                                                "text": "Also in 1955 came the paralysing two-week ASLEF pay strike, which did even more to end the love affair between the railways and its regular customers."
                                            },
                                            {
                                                "example_id": "8c1729df-3b5c-492f-ad0e-28ac39111042",
                                                "sense_id": "d3388865-de22-3bc6-8ab9-d0fb24a8b699",
                                                "text": "I've always had a love affair with stamps."
                                            },
                                            {
                                                "example_id": "a4b54f29-903c-437d-869e-be2faa9b6a47",
                                                "sense_id": "d3388865-de22-3bc6-8ab9-d0fb24a8b699",
                                                "text": "And if his love affair with Old Trafford was strained by the saga of his demand to leave earlier this season, the bond was rekindled as United claimed a vital victory."
                                            }
                                        ]
                                    }
                                ]
