                        "entry_id": "50a21849-56ae-3b86-95d4-c838df921a32",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "anorexigènes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cfce9a47-7972-3ffd-8778-99e798c5b402",
                        "entry_id": "50a21849-56ae-3b86-95d4-c838df921a32",
                        "glosses": [
                            "Se dit d'une substance ou d'une préparation qui est capable de réduire la sensation de faim."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4c3674f-bdf2-4ecb-9588-aff0a3e5f420",
                                "sense_id": "cfce9a47-7972-3ffd-8778-99e798c5b402",
                                "text": "L’action anorexigène de l’amphétamine chez l’homme fut démontrée dès 1939."
                            },
                            {
                                "example_id": "6132bad9-d776-460f-abc8-04ceb7e8c4f5",
                                "sense_id": "cfce9a47-7972-3ffd-8778-99e798c5b402",
                                "text": "Elle possède en outre un effet anorexigène et thermogène et augmente le tonus sympathique et pourrait exercer, par l’action des protéines découplantes, une dissipation d’énergie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58814d8e-0c9a-4894-a50d-263233df5c1f",
