                "senses": [
                    {
                        "sense_id": "225964f4-600b-372d-9d34-63ae287cd4c4",
                        "entry_id": "3fccfd41-b9a8-3574-8a1d-a7db2b17eb86",
                        "glosses": [
                            "groeibeginsel van een bloem in een struik uit het geslacht Rosa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d5e7c9c-4443-4b78-a9dd-6c6d7acbb326",
                                "sense_id": "225964f4-600b-372d-9d34-63ae287cd4c4",
                                "text": "Hoe lees je aan een rozenknop af wanneer hij opengaat? Hoe lang blijft die roos bloeien?"
                            },
                            {
                                "example_id": "306c49c9-1eb3-49a4-8760-418216ccc402",
                                "sense_id": "225964f4-600b-372d-9d34-63ae287cd4c4",
                                "text": "Dat zijn schalen met een mengsel van geurende bloemen en plantenblaadjes. (…) Op het moment zitten er tulpenblaadjes in. Ik kreeg van iemand een bos die bleek te geuren, zoals ze vroeger deden. Hierna gaan er rozenknopjes in, en verse vlier."
                            },
                            {
                                "example_id": "872bd600-a3f0-4b9a-b88c-cb99d66b69a8",
                                "sense_id": "225964f4-600b-372d-9d34-63ae287cd4c4",
                                "text": "Of het bloemenmeisje nu met een ballon danst of haar rozenknoppen opeet, het maakt nooit de emotionele indruk die Lizari volgens mij wel wil achterlaten."
                            }
                        ]
                    },
