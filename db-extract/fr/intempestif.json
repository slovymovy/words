                ],
                "senses": [
                    {
                        "sense_id": "617d22f8-1814-38b0-b56d-978a468d3638",
                        "entry_id": "69f4bf9a-2565-310b-a764-0b540112ff96",
                        "glosses": [
                            "Qui survient au mauvais moment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5722f0b-fb7c-4328-ad62-4cfd1b83aeef",
                                "sense_id": "617d22f8-1814-38b0-b56d-978a468d3638",
                                "text": "Raphaël laissa tout à coup échapper un éclat de rire si brusquement intempestif, que son ami lui demanda compte d’une joie aussi brutale."
                            },
                            {
                                "example_id": "9e034a3a-ad8d-46ea-a6b2-b684c135204f",
                                "sense_id": "617d22f8-1814-38b0-b56d-978a468d3638",
                                "text": "Les floraisons intempestives ne sont pas rares, à la suite des printemps ou des étés secs, auxquels succèdent quelques journées de pluies abondantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "88c0a925-da1b-30a7-9bea-2cd9ae786b4e",
                        "entry_id": "69f4bf9a-2565-310b-a764-0b540112ff96",
                        "glosses": [
                            "Qui se produit inopportunément ; qui tombe mal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b5b50cf-d6d1-48c3-9a11-552505301088",
                                "sense_id": "88c0a925-da1b-30a7-9bea-2cd9ae786b4e",
                                "text": "Avec cela, il est intempestif, survenant à point nommé quand on n’a aucun besoin de lui, et le sentiment de son inexistence fait qu’il ne se croit jamais de trop."
                            },
                            {
                                "example_id": "0017418e-2789-48c4-9b0f-40fc16533406",
                                "sense_id": "88c0a925-da1b-30a7-9bea-2cd9ae786b4e",
                                "text": "On utilise sans vergogne l’arrière-pays, du moins sa partie non protégée, non mise en réserve pour accueillir des décharges intempestives, les fûts toxiques, les activités polluantes et les ayatollahs de l'écologie."
                            },
                            {
                                "example_id": "1e8ecc58-e56c-41b7-b6e1-e1cd6fd088f4",
                                "sense_id": "88c0a925-da1b-30a7-9bea-2cd9ae786b4e",
                                "text": "Les événements naturels intempestifs sont innombrables et, si l'on peut dire, leurs effets le sont davantage, puisque le même événement peut avoir des effets différents sur des ouvrages différents, ou bien des intensités différentes […]."
                            },
                            {
                                "example_id": "8b104cc1-9900-4ae8-98b0-3c580c06259d",
                                "sense_id": "88c0a925-da1b-30a7-9bea-2cd9ae786b4e",
                                "text": "Pour prévenir toute intervention intempestive du service d'ordre, Kimdall utilisa le langage universel pour se débarrasser des chieurs : elle entrouvrit son manteau et montra son colt. Les plantons la laissèrent passer sans moufter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "013e4bd9-e59f-4f2d-b855-79f110dce105",
                        "source_entry_id": "69f4bf9a-2565-310b-a764-0b540112ff96",
                        "source_sense_description": "qui survient au mauvais moment",
                        "target_lang_word": "unzeitig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unzeitig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2e79013-69ea-39fd-98fd-6bbcc7bfd421",
                                        "entry_id": "e7a55eea-ad55-3a4d-aec8-ab3c42672f9e",
                                        "glosses": [
                                            "für die rechte Zeit unangemessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a771d5c3-3b9e-47d3-882c-a7f97fe02358",
                                                "sense_id": "f2e79013-69ea-39fd-98fd-6bbcc7bfd421",
                                                "text": "„Ja, dann war es vielleicht doch der gute Tod, und sie durfte nicht klagen, daß er für sie unzeitig gekommen, so übel unzeitig, daß sie daran fast zerbrach ...“"
                                            },
                                            {
                                                "example_id": "c9b0999f-32e6-48f9-9c68-96ac0c36403a",
                                                "sense_id": "f2e79013-69ea-39fd-98fd-6bbcc7bfd421",
                                                "text": "„»Seine Königliche Hoheit lebe hoch!« schrie jetzt verfrüht, unzeitig und taktlos der Zimmermeister Schlegel, der immer etwas voraushaben mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c9d0779-de73-4e0e-9975-a595df87f008",
                        "source_entry_id": "69f4bf9a-2565-310b-a764-0b540112ff96",
