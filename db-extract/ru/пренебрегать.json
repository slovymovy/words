                        "sense_id": "62af230e-eb0f-3ea9-90d3-e27aa832e8c5",
                        "entry_id": "579d3663-48f8-3099-94c1-78b7a0504638",
                        "glosses": [
                            "to neglect, to disregard, to disdain, to slight"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a072ab9a-952c-3bdb-a9bf-0396ab53fbde",
                        "entry_id": "579d3663-48f8-3099-94c1-78b7a0504638",
                        "glosses": [
                            "to scorn, to ignore, to despise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b728bdf7-7072-4d0f-b233-6d4dd2a2ff21",
                                "sense_id": "a072ab9a-952c-3bdb-a9bf-0396ab53fbde",
                                "text": "Поблагодари́ же меня́; ведь ты охо́тница кла́няться тем, кото́рые пренебрега́ют тобо́ю, — поклони́сь же и мне.",
                                "translation": "Thank me now; thou art obsequious to those who despise thee: bow also to me.",
                                "english": "Thank me now; thou art obsequious to those who despise thee: bow also to me."
                            }
                        ]
                    }
                ],
