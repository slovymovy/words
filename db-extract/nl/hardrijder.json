                "senses": [
                    {
                        "sense_id": "1aba7c1e-2ae7-38b8-80da-13dd6f189b94",
                        "entry_id": "27afec4d-a102-3761-b0d0-a528e7c72f18",
                        "glosses": [
                            "iemand die heel snel kan schaatsen of fietsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e9e8190-7e50-4781-bccf-97c1a756d08d",
                                "sense_id": "1aba7c1e-2ae7-38b8-80da-13dd6f189b94",
                                "text": "Joan Haanappel en Sjoukje Dijkstra, al bijna zeventig jaar vriendinnen, proberen het kunstrijden levend te houden. Van de KNSB moeten ze het niet hebben. „Gerund worden door een hardrijder? Dat nooit.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "5172f021-c3b9-3c25-86ff-0f17ef615f7d",
                        "entry_id": "27afec4d-a102-3761-b0d0-a528e7c72f18",
                        "glosses": [
                            "iemand die te snel rijdt met een auto of motorfiets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "972cf0fe-979e-4505-b732-cb5c0093c794",
                                "sense_id": "5172f021-c3b9-3c25-86ff-0f17ef615f7d",
                                "text": "De afgelopen tien jaar vielen er bij verkeersongevallen op de N354, de Snitserdyk, zes doden, vertelt Van der Meulen. Oorzaak: er wordt veel te hard gereden. Er geldt een maximumsnelheid van 80 kilometer per uur, maar buiten de spits trapt menig automobilist het gaspedaal veel dieper in. De provincie Friesland onderkent het gevaar. Er geldt nu een inhaalverbod en er is extra belijning aangebracht. De maximumsnelheid is teruggebracht naar 60 kilometer en er wordt vaker gecontroleerd. Bij een recente controle kregen 92 hardrijders een bon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5df9fb15-3c1b-401e-9b24-0312c765b647",
                        "source_entry_id": "27afec4d-a102-3761-b0d0-a528e7c72f18",
                        "source_sense_id": "1aba7c1e-2ae7-38b8-80da-13dd6f189b94",
                        "source_sense_description": "(sport) iemand die heel snel kan schaatsen of fietsen",
                        "target_lang_word": "Rennfahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rennfahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91e7ef8d-c15c-30cf-8342-7d07e89fee15",
                                        "entry_id": "7bb4dc8a-c121-3709-87b8-1cfde8cb4536",
                                        "glosses": [
                                            "Sportler, der mit einem Sportgerät Rennen fährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9819c4d7-5ac5-4863-9c8b-b754f7cc7ab1",
                                                "sense_id": "91e7ef8d-c15c-30cf-8342-7d07e89fee15",
                                                "text": "Das schlechte Wetter bereitete den Rennfahrern Schwierigkeiten."
                                            },
                                            {
                                                "example_id": "5e91097f-41e8-4fbf-84e2-fca2fffc937e",
                                                "sense_id": "91e7ef8d-c15c-30cf-8342-7d07e89fee15",
                                                "text": "„Ich nahm es nur unbewusst wahr, als die Rennfahrer zu einer unchristlichen Zeit am nächsten Morgen losfuhren, und als ich aus meinem Zelt kroch, waren die meisten Begleiter und Support-Crews bereits verschwunden.“"
                                            },
                                            {
                                                "example_id": "32380e68-53c9-4511-8a2f-f73897e01d9b",
                                                "sense_id": "91e7ef8d-c15c-30cf-8342-7d07e89fee15",
                                                "text": "„Der sie liebende Mann ist nicht Rennfahrer, sondern ihr Arzt (David Niven), und ein Playboy und Rennfahrer (Richard Conte), der für viel Herzensverwirrung sorgt, ist auch da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec8b84a1-ee63-4603-b644-9aed8e8a6dda",
                        "source_entry_id": "27afec4d-a102-3761-b0d0-a528e7c72f18",
                        "source_sense_id": "5172f021-c3b9-3c25-86ff-0f17ef615f7d",
                        "source_sense_description": "(verkeer) iemand die te snel rijdt met een auto of motorfiets",
                        "target_lang_word": "Raser",
