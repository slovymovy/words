                    {
                        "sense_id": "6590c246-26bb-3158-a9f1-ff49e3528d3d",
                        "entry_id": "77fe882a-bb39-357b-9910-e4bdb139f7b9",
                        "glosses": [
                            "Stadt an der Mündung des Neckars in den Rhein in der Kurpfalz: Mannheim, diese Form mit -o- überwiegend im Zentrum und im Norden Mannheims sowie überwiegend in der Gegend nördlich von Mannheim"
                        ],
                        "tags": [
                            "Endonym",
                            "Pfälzisch"
                        ],
                        "examples": [
                            {
                                "example_id": "d135aff3-e810-4cd1-b8b3-976211967958",
                                "sense_id": "6590c246-26bb-3158-a9f1-ff49e3528d3d",
                                "text": "„›Du bist aber nicht aus Deutschland‹, hatten viele […] gemeint, worauf Jennifer stets in breitem Mannheimer Dialekt […] geantwortet hatte: ›Doch! Isch bin aus Monnem, aus em Jungbusch!‹“",
                                "translation": "Anmerkung: Jungbusch: Stadtteil im/beim Stadtzentrum Mannheims"
                            },
                            {
                                "example_id": "3dbaa19c-56b2-484c-808e-5148b312f8af",
                                "sense_id": "6590c246-26bb-3158-a9f1-ff49e3528d3d",
                                "text": "„Im Norde vun Monnem sachd ma Monnem. Im Süde vun Mannem hingege sachd ma Mannem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
