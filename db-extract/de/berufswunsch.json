                "senses": [
                    {
                        "sense_id": "a047f439-ec5f-3c25-a79e-7f97db45844d",
                        "entry_id": "48ee505c-25e1-390a-b17a-d173b2f9c18d",
                        "glosses": [
                            "Wunsch, einen bestimmten Beruf ergreifen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc908f4-a062-4442-8040-dac7ba08cb12",
                                "sense_id": "a047f439-ec5f-3c25-a79e-7f97db45844d",
                                "text": "„Es sind keine einfachen Jahre, aber als Arno aus dem Militärdienst entlassen wird, erfüllt er sich seinen Berufswunsch und wird Schmied.“"
                            },
                            {
                                "example_id": "764919d5-b779-4640-a724-070c2d27a675",
                                "sense_id": "a047f439-ec5f-3c25-a79e-7f97db45844d",
                                "text": "„Er entsprach auch keineswegs den damaligen Berufswünschen Roman Bertinis, der Jockey werden wollte, weil er klein und leicht war wie eine Feder, so daß jeder sagte, er müsse später Jockey werden.“"
                            },
                            {
                                "example_id": "55e6e229-c186-4c1e-9fe6-35ff912b61b6",
                                "sense_id": "a047f439-ec5f-3c25-a79e-7f97db45844d",
                                "text": "„In Bezug auf das Ranking der Berufswünsche in Frage 26 fällt auf, dass sich hierbei Berufsfelder häufen, die im handwerklichen Bereich verortet sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
