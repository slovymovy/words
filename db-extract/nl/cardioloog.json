                                "target_senses": [
                                    {
                                        "sense_id": "68562821-e581-39fa-b3d5-64a0616fe2b1",
                                        "entry_id": "7749d14d-d2b8-3786-af92-ec90ae18cb42",
                                        "glosses": [
                                            "A physician who specializes in medical problems related to the heart."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc3134e5-b22e-43ba-85bd-88ce12c7bef2",
                                                "sense_id": "68562821-e581-39fa-b3d5-64a0616fe2b1",
                                                "text": "The homeless guy thus ends up getting treated by one of the best cardiologists in the city."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96b9d7d7-c6e5-4aa2-b596-bd75efbfd603",
                        "source_entry_id": "e934c2d7-6f23-3749-beba-80f606d5076e",
                        "source_sense_id": "c8f30b05-ae3d-30a1-b629-5320af61ef9f",
                        "target_lang_word": "cardiologue",
                        "target_lang_code": "fr",
