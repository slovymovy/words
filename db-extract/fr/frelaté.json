                                                "sense_id": "3e43959c-5fa9-31f2-aa3a-3b4c5dcff2dc",
                                                "text": "Near-synonyms: laced, tainted, contaminated"
                                            },
                                            {
                                                "example_id": "e69a847b-a91c-4688-ba7c-85302ab11c85",
                                                "sense_id": "3e43959c-5fa9-31f2-aa3a-3b4c5dcff2dc",
                                                "text": "The problem of adulterated milk has periodically reemerged as a public health menace, from New York in the 1850s to China in 2008."
                                            },
                                            {
                                                "example_id": "6a55be0f-46c5-4418-91bd-03608d4377be",
                                                "sense_id": "3e43959c-5fa9-31f2-aa3a-3b4c5dcff2dc",
                                                "text": "Heroin is often adulterated with fentanyl."
                                            }
                                        ]
