                    {
                        "translation_id": "2839e038-c47a-4e9a-974e-9486d83ce7b6",
                        "source_entry_id": "7cefcb97-93c2-3db2-bb32-5af38bf80d4c",
                        "source_sense_description": "semicircle — see also semicircle",
                        "target_lang_word": "полукру́г",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
