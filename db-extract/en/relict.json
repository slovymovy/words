                    },
                    {
                        "translation_id": "6a5d94d3-366b-4e82-ba5e-996b167688bb",
                        "source_entry_id": "3ff604f5-4c94-3bfe-a53f-fd181214114d",
                        "source_sense_id": "e1fadd14-5705-35ee-8d67-94d9aeb7af12",
                        "source_sense_description": "Witwe",
                        "target_lang_word": "Witwe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Witwe",
