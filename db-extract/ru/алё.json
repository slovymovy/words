                    {
                        "translation_id": "e9e0a494-ea79-455e-b6df-5dcbcd3cd65c",
                        "source_entry_id": "c4c8328d-48ff-33cc-8008-e282891229c7",
                        "target_lang_word": "hullo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
