                "senses": [
                    {
                        "sense_id": "a85adb95-074d-3c60-854b-3af33c9f6fa7",
                        "entry_id": "a6a08ffb-4311-32a1-bdb4-6d9b00e9783f",
                        "glosses": [
                            "přímluvkyně, orodovnice"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "410ba6d9-c24d-431b-b35d-846b937daebf",
                                "sense_id": "a85adb95-074d-3c60-854b-3af33c9f6fa7",
                                "text": "Zu dir rufen wir verbannte Kinder Evas, zu dir seufzen wir trauernd und weinend in diesem Tal der Tränen. Wohlan denn, uns're Fürsprecherin, wende deine barmherzigen Augen uns zu, und nach diesem Elend zeige uns Jesus, die gebenedeite Frucht deines Leibes.",
                                "translation": "K tobě voláme, vyhnaní synové Evy, k tobě vzdycháme lkajíce a plačíce v tomto slzavém údolí. Proto tedy, orodovnice naše, obrať k nám své milosrdé oči a Ježíše, požehnaný plod života tvého, nám po tomto putování ukaž."
                            }
                        ]
                    },
                    {
