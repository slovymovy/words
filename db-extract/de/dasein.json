                        "form": "des Daseins"
                    },
                    {
                        "form_id": "f259b8f4-bec0-4c6c-bc2f-953ffcba6109",
                        "entry_id": "04e69999-17ff-3696-aada-fd205890d179",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Dasein"
                    },
                    {
                        "form_id": "061f5040-998b-4b71-85c0-aaf2565161f1",
                        "entry_id": "04e69999-17ff-3696-aada-fd205890d179",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Dasein"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                        "entry_id": "04e69999-17ff-3696-aada-fd205890d179",
                        "glosses": [
                            "das Leben eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85bb0262-6335-4b3e-b465-34d01db73d93",
                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                "text": "Sie freuten sich ihres Daseins."
                            },
                            {
                                "example_id": "c27897d6-faed-42a1-b195-55e2757d438d",
                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                "text": "„Es sieht also ganz so aus, als ob das Schimpfen essenziell zum menschlichen Dasein dazugehören würde.“"
                            },
                            {
                                "example_id": "b2cfd079-71e2-4d97-be33-1e875902fb87",
                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                "text": "„Schon in der Hafenkneipe hatte er erkannt, daß ihm John auf der weiten Fahrt in die Arktis das einsame Dasein unter den Grobianen und den ausgemachten Strolchen seiner Besatzung als guter Kamerad erträglich machen konnte.“"
                            },
                            {
                                "example_id": "14247b74-0608-4e19-ba2a-46c65834c8a6",
                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                "text": "„Die Bohémiens gehen jetzt ins Romanische Café, in dessen kuppelförmiger Halle die unter Kettenhändlern von der Rennbahn und Börsenspekulanten ein ziemlich geduldetes Dasein fristen.“"
                            },
                            {
                                "example_id": "531f2bd3-76b6-428a-8ef3-d79f8992da17",
                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                "text": "„In diesen drei entscheidenden Jahren meines Daseins verlor man oft die Hoffnung, daß ich weiterleben werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "60d5cda7-ad3b-3024-a652-8e41b7ec27a4",
                        "entry_id": "04e69999-17ff-3696-aada-fd205890d179",
                        "glosses": [
                            "Tatsache, anwesend/zugegen zu sein"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7a04c9d-bc80-4400-be1b-293f45c3ab25",
                        "source_entry_id": "04e69999-17ff-3696-aada-fd205890d179",
                        "source_sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                        "source_sense_description": "das Leben eines Menschen",
                        "target_lang_word": "existence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "existence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                        "entry_id": "097303ae-2ccd-3321-8f9c-e789f6f705d2",
                                        "glosses": [
                                            "The state of being, existing, or occurring; beinghood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b9466a8-7db2-4455-a509-bcf07092b654",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "In order to destroy evil, we must first acknowledge its existence."
                                            },
                                            {
                                                "example_id": "e2f64c68-d4f1-454f-9a89-61252bef7dec",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "Fortunate it is for the tranquillity of the new-born infant, if he have any turn for philosophy, that he understands none of the nonsense consecrated by old usage to the commencement of existence."
                                            },
                                            {
                                                "example_id": "b2b100d0-e7e5-4517-b3af-76d7c34870c7",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                                            },
                                            {
                                                "example_id": "725bd82d-e992-4c66-b680-9a4c50418d06",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "The physics of elementary particles in the 20th century was distinguished by the observation of particles whose existence had been predicted by theorists sometimes decades earlier."
                                            },
                                            {
                                                "example_id": "933a459d-402a-49d2-9209-efba7455dd07",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "The ancients said, “A ruler should exist for the existence of the people.” The famous thinker, Mencius noted, “The people are the most valuable, then the country, and the ruler comes last.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b47581ac-1901-34db-9aab-f235e5ade685",
                                        "entry_id": "097303ae-2ccd-3321-8f9c-e789f6f705d2",
                                        "glosses": [
                                            "Empirical reality; the substance of the physical universe. (Dictionary of Philosophy; 1968)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "372ec30b-1343-40dc-b640-796facdae029",
                        "source_entry_id": "04e69999-17ff-3696-aada-fd205890d179",
                        "source_sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                        "source_sense_description": "das Leben eines Menschen",
                        "target_lang_word": "être-là",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "être-là",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3dd049f-3e80-355f-8bbc-ab9a66733551",
                                        "entry_id": "604ff2aa-4d4d-3b24-8446-76bd9b47906b",
                                        "glosses": [
                                            "Situation d’une créature qui existe, indépendamment du sens éventuel de cette existence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ca16b1-261f-4af5-9054-5ca88f6e6a1c",
                                                "sense_id": "b3dd049f-3e80-355f-8bbc-ab9a66733551",
                                                "text": "Or, la boule « est » presque toujours. C’est même, nous dit M. Bailly, la plus haute de ses fonctions (disons le plus haut de ses états) : son « être-là », comme disent les philosophes. C’est même cet « être-là » qui est le plus là, le plus présent, c’est cette présence de la boule qui fait que je vous en parle, écrit M. Bailly."
                                            },
                                            {
                                                "example_id": "690a0a13-3df1-4fa1-9f93-8ced6c3f8299",
                                                "sense_id": "b3dd049f-3e80-355f-8bbc-ab9a66733551",
                                                "text": "L’homme […] jouit du même être-là obscur que l’animal, que le végétal, que le minéral."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a6afa65-4a4b-437f-9b09-6137966e9ce2",
