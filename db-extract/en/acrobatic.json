                    {
                        "translation_id": "bf45f939-b82f-4297-869e-26805c632890",
                        "source_entry_id": "d36a917f-70e1-32b1-b278-3ab4edb3eb56",
                        "source_sense_description": "of or pertaining to an acrobat",
                        "target_lang_word": "acrobatique",
