                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb de datum van de afspraak per ongeluk <w>verward</w>.",
                            "target_lang_translations": {
                                "en": "I accidentally <w>mixed up</w> the date of the appointment.",
                                "ru": "Я случайно <w>перепутал</w> дату встречи.",
                                "fr": "J'ai accidentellement <w>confondu</w> la date du rendez-vous."
