        "nl-extract.jsonl": [
            {
                "entry_id": "0e5cbbf9-4dc0-376f-9556-707b507f58be",
                "word": "preciseren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d5fac97-2691-33ad-93ec-bcf2358ec44f",
                        "entry_id": "0e5cbbf9-4dc0-376f-9556-707b507f58be",
                        "glosses": [
                            "nauwkeuriger omschrijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20aeefb7-882f-41ed-a917-33108026c6e1",
                                "sense_id": "1d5fac97-2691-33ad-93ec-bcf2358ec44f",
                                "text": "Op het moment dat het concert zou beginnen, is een personeelslid van de veiligheid het podium opgestapt en heeft het publiek gevraagd de zaal via de nooduitgangen te verlaten, zonder de reden te preciseren. De evacuatie verliep kalm', verklaarde de getuige."
                            },
                            {
                                "example_id": "be493efa-b9ea-44bc-951f-9a2e5abcf4b0",
                                "sense_id": "1d5fac97-2691-33ad-93ec-bcf2358ec44f",
                                "text": "Past het voorstel binnen het door het Europees Nationaliteitsverdrag getrokken kader, dat verlies van nationaliteit alleen mag als gedrag ernstige schade toebrengt aan essentiële belangen van de staat? Ja, zegt de regering, we mogen die verdragsbepaling zelf invullen en preciseren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41b05184-bf27-4637-bccc-29d75ec1ded6",
                        "source_entry_id": "0e5cbbf9-4dc0-376f-9556-707b507f58be",
                        "source_sense_id": "1d5fac97-2691-33ad-93ec-bcf2358ec44f",
                        "source_sense_description": "nauwkeuriger omschrijven",
                        "target_lang_word": "define",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "define",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66a4713c-0f11-3a00-a814-df02d5f0f6a0",
                                        "entry_id": "1e69a070-8e85-3410-a19f-5be729a25f34",
                                        "glosses": [
                                            "To determine with precision; to mark out with distinctness; to ascertain or exhibit clearly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19ded137-4329-4625-a6e9-a7d012cda08a",
                                                "sense_id": "66a4713c-0f11-3a00-a814-df02d5f0f6a0",
                                                "text": "the defining power of an optical instrument"
                                            },
                                            {
                                                "example_id": "604429ff-373a-4504-be1e-e86568ed80b7",
                                                "sense_id": "66a4713c-0f11-3a00-a814-df02d5f0f6a0",
                                                "text": "Rings[…]very distinct and well defined."
                                            },
                                            {
                                                "example_id": "eff79875-ec8c-4083-944d-f37603030608",
                                                "sense_id": "66a4713c-0f11-3a00-a814-df02d5f0f6a0",
                                                "text": "Turbines have been around for a long time—windmills and water wheels are early examples. The name comes from the Latin turbo, meaning vortex, and thus the defining property of a turbine is that a fluid or gas turns the blades of a rotor, which is attached to a shaft that can perform useful work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "508f6cf6-5274-39a5-81a1-c3b1387c649d",
                                        "entry_id": "1e69a070-8e85-3410-a19f-5be729a25f34",
                                        "glosses": [
                                            "To settle, decide (an argument etc.)"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7fe6f62-9eea-44e6-87a6-d3c27419c5b1",
                                                "sense_id": "508f6cf6-5274-39a5-81a1-c3b1387c649d",
                                                "text": "These warlike Champions, all in armour shine, / Assembled were in field the chalenge to define."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1de6ca78-ddc1-37a6-97bd-b615c1bf32a2",
                                        "entry_id": "1e69a070-8e85-3410-a19f-5be729a25f34",
                                        "glosses": [
                                            "To express the essential nature of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42d7fb94-b0f9-4ba9-a171-22967be3b50d",
                                                "sense_id": "1de6ca78-ddc1-37a6-97bd-b615c1bf32a2",
                                                "text": "I define myself as a techno-anarchist."
                                            },
                                            {
                                                "example_id": "33a5b520-a5eb-4013-bc37-afaa7b2fe8d8",
                                                "sense_id": "1de6ca78-ddc1-37a6-97bd-b615c1bf32a2",
                                                "text": "Your past mistakes do not define who you are."
                                            },
                                            {
                                                "example_id": "bf1df37d-8b66-4e46-92de-4551893f437a",
                                                "sense_id": "1de6ca78-ddc1-37a6-97bd-b615c1bf32a2",
                                                "text": "Cantor defined a one-to-one correspondence between the points of the square and the points of the line segment. Every point in the square was associated with a single point in the segment; every point in the segment was matched with a unique point in the square."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47567b43-d6db-3946-bbf0-7bb86e2830b9",
                                        "entry_id": "1e69a070-8e85-3410-a19f-5be729a25f34",
                                        "glosses": [
                                            "To state the meaning of a word, phrase, sign, or symbol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b9e4f9c-aebc-4233-9c65-9b2c4e473f2b",
                                                "sense_id": "47567b43-d6db-3946-bbf0-7bb86e2830b9",
                                                "text": "The textbook defined speed as velocity divided by time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764a7345-2dd4-33e3-b588-057570163bf2",
                                        "entry_id": "1e69a070-8e85-3410-a19f-5be729a25f34",
                                        "glosses": [
                                            "To describe, explain, or make definite and clear; used to request the listener or other person to elaborate or explain more clearly his or her intended meaning of a word or expression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "104f038c-9b3b-42b7-bdf1-a9691465d391",
                                                "sense_id": "764a7345-2dd4-33e3-b588-057570163bf2",
                                                "text": "Person 1: Is she good at math?\nPerson 2: Define \"good.\" If you mean if she is faster than the average middle schooler at multiplication, then yes. If you mean if she is able to do multivariable calculus, then no."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79221f1d-0a91-39e6-bacc-efb226916b5c",
                                        "entry_id": "1e69a070-8e85-3410-a19f-5be729a25f34",
                                        "glosses": [
                                            "To demark sharply the outlines or limits of an area or concept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceb7ff30-af03-4fe2-b214-40c920b62f52",
                                                "sense_id": "79221f1d-0a91-39e6-bacc-efb226916b5c",
                                                "text": "to define the legal boundaries of a property"
                                            },
                                            {
                                                "example_id": "32d54745-6fea-442a-b271-1165f55498da",
                                                "sense_id": "79221f1d-0a91-39e6-bacc-efb226916b5c",
                                                "text": "Few concepts are as emotionally charged as that of race. The word conjures up a mixture of associations—culture, ethnicity, genetics, subjugation, exclusion and persecution. But is the tragic history of efforts to define groups of people by race really a matter of the misuse of science, the abuse of a valid biological concept?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34f22d0d-489d-3ca1-952c-c5132a314e46",
                                        "entry_id": "1e69a070-8e85-3410-a19f-5be729a25f34",
                                        "glosses": [
                                            "To establish the referent of a term or notation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "define",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aeb093e-49ba-33e8-a3a6-1103cd5fae63",
                                        "entry_id": "205fb882-ecc5-3d55-ba38-b989f588f433",
                                        "glosses": [
                                            "A kind of macro in source code that replaces one text string with another wherever it occurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a835d84e-66a2-4f36-9443-0aa069278fdf",
                                                "sense_id": "0aeb093e-49ba-33e8-a3a6-1103cd5fae63",
                                                "text": "From the computer programming perspective, Java looks like C and C++ while discarding the overwhelming complexities of those languages, such as typedefs, defines, preprocessor, unions, pointers, and multiple inheritance."
                                            },
                                            {
                                                "example_id": "996839c0-5f73-4bc8-bdb1-a92c34714733",
                                                "sense_id": "0aeb093e-49ba-33e8-a3a6-1103cd5fae63",
                                                "text": "Anyone who has attempted to do OO programming in a conventional language using defines will find out that it is impossible to realize the benefits easily, if at all, without compiler support."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
