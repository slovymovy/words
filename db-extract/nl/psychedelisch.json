                    {
                        "sense_id": "49776fc8-f9d6-36a5-a2bf-ebe5451087ce",
                        "entry_id": "c0c6253e-688b-3b1f-9a82-22e5a4f8f8a0",
                        "glosses": [
                            "zorgend voor een veranderd bewustzijn waardoor je de werkelijkheid anders waarneemt dan dat je normaal doet"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afc86b31-1b9f-4c51-b10c-d2bc53c7d92a",
                        "source_entry_id": "c0c6253e-688b-3b1f-9a82-22e5a4f8f8a0",
                        "source_sense_id": "49776fc8-f9d6-36a5-a2bf-ebe5451087ce",
                        "source_sense_description": "de werking van het bewustzijn verruimend",
                        "target_lang_word": "psychedelisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychedelisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83114c96-a9ce-3fdf-aea6-239025e7af67",
                                        "entry_id": "e8708e53-7086-3d6d-ba7d-7948497a99da",
                                        "glosses": [
                                            "die Wahrnehmung verändernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c77bf3e9-81f0-494d-add1-cbbb0d1fba74",
                                                "sense_id": "83114c96-a9ce-3fdf-aea6-239025e7af67",
                                                "text": "Bei den Hippies stand psychedelische Musik hoch im Kurs."
                                            },
                                            {
                                                "example_id": "ac4dd524-3946-43f7-93ed-a64718f7263a",
                                                "sense_id": "83114c96-a9ce-3fdf-aea6-239025e7af67",
                                                "text": "„Er entblößte gerade ihre Brust, als sich das Narkotikum seiner vollends bemächtigte und ihn auf eine psychedelische Reise schickte, die die ganze Nacht anhielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99203739-c0d3-4378-9b35-77a77587bc60",
                        "source_entry_id": "c0c6253e-688b-3b1f-9a82-22e5a4f8f8a0",
                        "source_sense_id": "49776fc8-f9d6-36a5-a2bf-ebe5451087ce",
                        "source_sense_description": "de werking van het bewustzijn verruimend",
                        "target_lang_word": "psychedelic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychedelic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5447a64-0840-301c-8d38-27c657ce3551",
                                        "entry_id": "40156551-27b4-3fe8-8b2b-e588c9da5aa4",
                                        "glosses": [
                                            "Of, containing, generating, or reminiscent of drug-induced hallucinations, distortions of perception, altered awareness, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46754f92-cfde-4f60-a376-51d2aa62054e",
                                                "sense_id": "f5447a64-0840-301c-8d38-27c657ce3551",
                                                "text": "With those drugs has come the psychedelic philosophy, an impassioned belief in the self-revealing, mind-expanding powers of potent weeds and seeds and chemical compounds known to man since prehistory but wholly alien to the rationale of Western society."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b20612-f272-3c73-9c93-b1acb4b67276",
                                        "entry_id": "40156551-27b4-3fe8-8b2b-e588c9da5aa4",
                                        "glosses": [
                                            "Having bright colours, abstract shapes, etc. reminiscent of drug-induced hallucinations or distortions of perception."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b68f8ce-e52c-42b6-a36c-a240130c346c",
                                                "sense_id": "03b20612-f272-3c73-9c93-b1acb4b67276",
                                                "text": "There was a woman sitting on the edge of his bed. She had coral-orange hair, beryl-blue eyes, arched brows, freckles, a coy smile, a psychedelic labcoat and she was, he suddenly realized, his best friend of over twenty years."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psychedelic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5a3d6b1-607a-3497-b0c3-9f98c929b4c4",
                                        "entry_id": "c879a83a-e937-39d0-8ab1-c438060e34e2",
                                        "glosses": [
                                            "Any psychoactive substance (such as LSD or psilocybin) which, when consumed, causes perceptual changes (sometimes erratic and uncontrollable), visual hallucination, and altered awareness of the body and mind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396f0064-c274-499e-985d-fab875c32c41",
                                                "sense_id": "b5a3d6b1-607a-3497-b0c3-9f98c929b4c4",
                                                "text": "I was going to become a three-drug connection to all my friends, psychedelics, hash and pot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psychedelic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e37c3141-cca6-36ee-b913-cd2917a80e41",
                                        "entry_id": "aae8f476-f899-3ae4-8374-d9fb0b211b1e",
                                        "glosses": [
                                            "Awesome, cool, groovy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a080e161-797d-498c-a4d7-2be772ad1f3e",
                        "source_entry_id": "c0c6253e-688b-3b1f-9a82-22e5a4f8f8a0",
                        "source_sense_id": "49776fc8-f9d6-36a5-a2bf-ebe5451087ce",
                        "source_sense_description": "de werking van het bewustzijn verruimend",
                        "target_lang_word": "psychédélique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychédélique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a212eef8-efe4-3330-82b9-5219f3a6b74c",
                                        "entry_id": "e694fd73-63c9-31be-a15c-58b41614a481",
                                        "glosses": [
                                            "Se dit d’une substance qui, lorsque consommée, fait vivre une expérience psychologique exaltée, caractérisée par des hallucinations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02b8a4d7-ead5-4bcf-9bcd-def2eb2e6442",
                                                "sense_id": "a212eef8-efe4-3330-82b9-5219f3a6b74c",
                                                "text": "Ce n’est pas du LSD ordinaire, elle le sait, mais un mélange toxique de drogue psychédélique et d’amphétamine."
                                            },
                                            {
                                                "example_id": "96720da8-d31a-4f15-95c1-e5dbf8a5b5c0",
                                                "sense_id": "a212eef8-efe4-3330-82b9-5219f3a6b74c",
                                                "text": "Tout à coup, je reconnus dans le miroir l'homme à la redingote, qui devenait alternativement un loup, Harry Haller, Hermann Hesse et moi-même dans un cycle où les images se bousculaient de plus en plus pour devenir un kaléidoscope affolant me rappelant mes pires expériences de drogues psychédéliques"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee2af9f-3893-3377-b06d-892aa18e7935",
                                        "entry_id": "e694fd73-63c9-31be-a15c-58b41614a481",
                                        "glosses": [
                                            "Se dit d’une image, d’un tableau, d’une animation ou d’une musique, riche en couleurs, en mouvement ou en illusions et provoquant des sensations rappelant celles ressenties par des personnes sous l’emprise de psychotropes hallucinogènes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4504d378-fd07-4fc9-a6f3-ede0b7ce4915",
                                                "sense_id": "aee2af9f-3893-3377-b06d-892aa18e7935",
                                                "text": "Ce centre a attiré des milliers de jeunes du monde entier par son atmosphère psychédélique et onirique."
                                            },
                                            {
                                                "example_id": "5d0987aa-8aaa-4ff6-b3a4-c3ce28314c9f",
                                                "sense_id": "aee2af9f-3893-3377-b06d-892aa18e7935",
                                                "text": "Souvenons-nous du début de la carrière politique de Donald Trump. Les beaux esprits, ce qui inclut les milieux médiatiques et culturels, se moquaient de cet homme physiquement étrange à cause en particulier de sa chevelure orangée recréée par des coiffeurs psychédéliques."
                                            },
                                            {
                                                "example_id": "bbf50e41-a96c-4bae-bfbb-f4fd11a7ff45",
                                                "sense_id": "aee2af9f-3893-3377-b06d-892aa18e7935",
                                                "text": "La musique psychédélique."
                                            },
                                            {
                                                "example_id": "8370dae7-925f-4e52-9349-8015d4bf6599",
                                                "sense_id": "aee2af9f-3893-3377-b06d-892aa18e7935",
                                                "text": "Cette télévision mal réglée a un aspect assez psychédélique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psychédélique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acf3fba4-c0a8-3947-9bcd-4952cb727a6e",
                                        "entry_id": "e0b636d0-54e7-358b-9eb0-ecc216b33696",
                                        "glosses": [
                                            "Psychotrope hallucinogène, comme le LSD, la psilocybine, la mescaline ou le yagé, permettant à l’usager de plonger dans sa psychologie et de mieux la connaître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4abb7ef6-c07e-4296-81e4-98e9b1a7fd8d",
                                                "sense_id": "acf3fba4-c0a8-3947-9bcd-4952cb727a6e",
                                                "text": "Si une personne qui n’a pas de recherche spirituelle, qui n’a pas de pratique méditative, prend un psychédélique, elle va se retrouver à destination sans comprendre la nature de ce qu’elle va y découvrir , puisqu’elle ne se sera pas encore posé les questions qui sont constitutives de sa compréhension de la destination."
                                            },
                                            {
                                                "example_id": "560767f9-d51a-404f-a744-115181d8c8ac",
                                                "sense_id": "acf3fba4-c0a8-3947-9bcd-4952cb727a6e",
                                                "text": "« Ces molécules permettent au cerveau de créer de nouvelles connexions entre les neurones », explique Federico Seragnoli, docteur suisse en psychologie qui réalise des thérapies assistées par psychédéliques."
                                            },
                                            {
                                                "example_id": "f564b3bd-a75c-4512-a406-5a774ef87e5f",
                                                "sense_id": "acf3fba4-c0a8-3947-9bcd-4952cb727a6e",
                                                "text": "Mais ensuite vient la drogue, les psychédéliques s’entend et non tous les autres toxiques avec lesquels le public les confond volontiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
