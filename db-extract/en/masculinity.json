                                    {
                                        "sense_id": "3d31c943-8c15-3481-a24d-6327e0946abd",
                                        "entry_id": "8922e7b7-ecc4-3520-898d-14f108fb1744",
                                        "glosses": [
                                            "het geheel van eigenschappen, gedragingen en rollen die geassocieerd worden met mannen, deels biologisch en deels cultureel bepaald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0388da7-f836-4a38-b424-5316c5ebc872",
                                                "sense_id": "3d31c943-8c15-3481-a24d-6327e0946abd",
                                                "text": "“Een overdosis aan masculiniteit”, reageerde Sandrine Rousseau van de groene partij op X. “Wat een kaakslag voor progressiviteit en wat een zwakke politieke communicatie.” De krant Libération sprak van een “nogal onthutsende communicatiekeuze”, zeker omdat de twee foto’s van zijn officiële fotograaf komen en niet van een genieperd in de fitness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2acc039-ccbd-3e0e-9a40-c7020ed4a1c7",
                                        "entry_id": "8922e7b7-ecc4-3520-898d-14f108fb1744",
