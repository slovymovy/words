                        "entry_id": "6e1757d8-c74a-3499-b70e-78b2972d0d96",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "вы́живших"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd16bec2-8b8f-3fdc-b9de-404b33b94f21",
                        "entry_id": "6e1757d8-c74a-3499-b70e-78b2972d0d96",
                        "glosses": [
                            "действ. прич. прош. вр. от выжить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "c6c540a2-d279-4d7a-a023-2c58a2a5ee81",
                                "sense_id": "bd16bec2-8b8f-3fdc-b9de-404b33b94f21",
                                "text": "Есть ещё дон Сатарина, родовитейший имперский аристократ, ста двух лет от роду, совершенно выживший из ума."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d9eebea-99c8-3cb7-b680-a02b4f3338af",
                        "entry_id": "6e1757d8-c74a-3499-b70e-78b2972d0d96",
                        "glosses": [
                            "кто-то кому удалось выжить, остаться в живых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "937d06c5-c22f-48f9-b161-609291d89a1c",
                                "sense_id": "2d9eebea-99c8-3cb7-b680-a02b4f3338af",
                                "text": "Выживший в самые суровые времена, старый седой волк остался один в чаще."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abcf1555-6289-4268-a54c-cf75db46e03f",
                        "source_entry_id": "6e1757d8-c74a-3499-b70e-78b2972d0d96",
                        "target_lang_word": "survivor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "survivor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54954f96-ed6d-3ee8-91da-d5d0551aa1df",
                                        "entry_id": "b7f3cf55-bc23-3832-aa1a-be514c6c5b9d",
                                        "glosses": [
                                            "One who survives, especially one who survives a traumatic experience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db8ebe5-2b85-4588-9d06-f21942e0be8c",
                                                "sense_id": "54954f96-ed6d-3ee8-91da-d5d0551aa1df",
                                                "text": "From this moment on, I choose to live not as a victim, but as a survivor."
                                            },
                                            {
                                                "example_id": "2cb27de0-239c-4de8-878b-4651667d2acc",
                                                "sense_id": "54954f96-ed6d-3ee8-91da-d5d0551aa1df",
                                                "text": "Believing that requires trust, and trust is understandably a tough issue for those of us who are survivors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35f41446-e2c7-3420-831f-edd6021be7ae",
                                        "entry_id": "b7f3cf55-bc23-3832-aa1a-be514c6c5b9d",
                                        "glosses": [
                                            "A person who is able to endure hardship."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
