                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55201311-de21-469a-b986-21d24e81b03d",
                                "sense_id": "e97e282d-875d-3044-920e-39cb35fac309",
                                "text": "„Die Reisgrütze war aufgetragen worden und dazu zehn Sorten Gemüse und vier Teller mit Näschereien.“"
                            },
                            {
                                "example_id": "dfcbc76f-822c-4637-b92c-fea3361b8390",
                                "sense_id": "e97e282d-875d-3044-920e-39cb35fac309",
                                "text": "„Die Familien sind zusammen, die Kinder werden beschenkt und Erwachsene erhalten und schicken ihre Julklapps, während in der Mitte des Zimmers ein mit Blumen, Früchten und Näschereien reich behangener Weihnachtsbaum brennt.“"
                            },
                            {
                                "example_id": "e871921e-83bf-4ee6-b96d-2171d2e5fdbf",
                                "sense_id": "e97e282d-875d-3044-920e-39cb35fac309",
                                "text": "„Das sind Näschereien verschiedenster Art, die man dort meisterhaft herstellt.“"
                            },
                            {
                                "example_id": "fefb0006-7e9f-4331-967a-7d489d88b159",
                                "sense_id": "e97e282d-875d-3044-920e-39cb35fac309",
                                "text": "„Der Rest, die nächsten vier Seiten, waren nur noch Näschereien vom Text.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
