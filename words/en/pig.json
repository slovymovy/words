                                "target_lang_word": "пороситься",
                                "target_lang_sense_clarification": "рожать (о свинье)"
                            },
                            {
                                "target_lang_word": "опороситься",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "产仔",
                                "target_lang_sense_clarification": "指母猪生产"
                            }
                        ]
                    }
                }
            ]
        },
        {
