    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa74ce12-668a-36e8-b46d-28cfd100c01c",
                    "sense_definition": "A wide street or road, often with trees along the sides, especially in a city.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "street_road",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked down the <w>avenue</w> looking at the expensive shop windows.",
                            "target_lang_translations": {
                                "ru": "Мы шли по <w>проспекту</w>, разглядывая витрины дорогих магазинов.",
                                "zh": "我们沿着这条<w>大街</w>走，看着昂贵的商店橱窗。"
                            }
                        },
                        {
                            "text": "The hotel is located on a busy <w>avenue</w> in the center of the city.",
                            "target_lang_translations": {
                                "ru": "Отель расположен на оживленном <w>проспекте</w> в центре города.",
                                "zh": "这家酒店位于市中心一条繁忙的<w>大道</w>上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "boulevard",
                        "street",
                        "road"
                    ],
                    "common_phrases": [
                        "tree-lined avenue",
                        "broad avenue",
                        "Fifth Avenue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкая улица или дорога, часто обсаженная деревьями, особенно в городе",
                        "zh": "城市中宽阔的街道或道路，通常两旁种有树木。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проспект",
                                "target_lang_sense_clarification": "широкая городская улица"
                            },
                            {
                                "target_lang_word": "авеню",
                                "target_lang_sense_clarification": "в названиях улиц в США и Европе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大街",
                                "target_lang_sense_clarification": "城市中宽阔的街道"
                            },
                            {
                                "target_lang_word": "大道",
                                "target_lang_sense_clarification": "宽阔的道路，常用于路名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2af7258-3889-386d-bcb1-efe7e0290d39",
                    "sense_definition": "A possible way of doing something or achieving a goal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "method_means",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to explore every <w>avenue</w> to find a solution to this problem.",
                            "target_lang_translations": {
                                "ru": "Нам нужно исследовать каждый <w>путь</w>, чтобы найти решение этой проблемы.",
                                "zh": "我们需要探索每一个<w>途径</w>来找到解决这个问题的方法。"
                            }
                        },
                        {
                            "text": "The new job offers a promising <w>avenue</w> for his career development.",
                            "target_lang_translations": {
                                "ru": "Новая работа открывает многообещающую <w>возможность</w> для развития его карьеры.",
                                "zh": "这份新工作为他的职业发展提供了一个有前景的<w>渠道</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "explore every avenue",
                        "avenue of research",
                        "avenue for discussion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможный способ действий или достижения цели",
                        "zh": "实现目标或解决问题的可能途径或方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путь",
                                "target_lang_sense_clarification": "способ решения проблемы"
                            },
                            {
                                "target_lang_word": "возможность",
                                "target_lang_sense_clarification": "перспектива развития"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "途径",
                                "target_lang_sense_clarification": "实现目标的手段或方法"
                            },
                            {
                                "target_lang_word": "渠道",
                                "target_lang_sense_clarification": "获取信息或达成目的的路径"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "035f097a-9773-36f9-b429-f6ed530b161b",
                    "sense_definition": "A long, wide path or road leading to a large house, usually bordered by trees.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "street_road",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car drove slowly up the long <w>avenue</w> leading to the old manor.",
                            "target_lang_translations": {
                                "ru": "Машина медленно ехала по длинной <w>аллее</w>, ведущей к старой усадьбе.",
                                "zh": "汽车缓慢地沿着通往老庄园的漫长<w>林荫道</w>行驶。"
                            }
                        },
                        {
                            "text": "Ancient oak trees lined the <w>avenue</w> that stretched from the gate to the main house.",
                            "target_lang_translations": {
                                "ru": "Древние дубы окаймляли <w>аллею</w>, которая тянулась от ворот до главного дома.",
                                "zh": "古老的橡树排列在从大门延伸到主屋的<w>林荫大道</w>两旁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drive"
                    ],
                    "common_phrases": [
                        "long avenue",
                        "beech avenue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная широкая дорога, ведущая к большому дому, обычно обсаженная деревьями",
                        "zh": "通往大宅的宽阔长路，通常两旁有树木遮蔽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аллея",
                                "target_lang_sense_clarification": "дорога, обсаженная деревьями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "林荫道",
                                "target_lang_sense_clarification": "两旁种有树木的道路"
                            },
                            {
                                "target_lang_word": "林荫大道",
                                "target_lang_sense_clarification": "宽阔且有树木的通道"
                            }
                        ]
                    }
                }
            ]
        }
    ]
