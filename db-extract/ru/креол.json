                "translations": [
                    {
                        "translation_id": "dbf4ce1c-2aa8-492f-a63a-05007db90487",
                        "source_entry_id": "4ae36bf9-bdef-34da-b36e-d180cc96fc4f",
                        "target_lang_word": "Creole",
