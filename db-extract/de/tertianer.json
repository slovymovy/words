                "senses": [
                    {
                        "sense_id": "208244ad-62e2-38cb-b274-98b8cc6fa7a8",
                        "entry_id": "9b7ddd97-9496-340c-bd70-f8807df76b1b",
                        "glosses": [
                            "Schüler, der in der Tertia ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a368e30-24d1-45b8-ba85-7d0b01f46587",
                                "sense_id": "208244ad-62e2-38cb-b274-98b8cc6fa7a8",
                                "text": "„Immerhin waren sie keine Sextaner oder Quintaner mehr, sondern Tertianer, zwei Jahre vor dem Einjährigen.“"
                            },
                            {
                                "example_id": "34940d24-b59b-487f-9650-0922a308703e",
                                "sense_id": "208244ad-62e2-38cb-b274-98b8cc6fa7a8",
                                "text": "„Ein Tertianer, der die Anfangsgründe der Physik gerade hinter sich gebracht hat, hofft, mit seinem neuen Wissen den Postboten in Verlegenheit zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
