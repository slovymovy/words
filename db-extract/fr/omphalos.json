                                "target_senses": [
                                    {
                                        "sense_id": "2020ae2e-4b89-3427-9bde-34822090c294",
                                        "entry_id": "c323adda-64a9-37bf-8868-01e7a86dba3d",
                                        "glosses": [
                                            "An ancient religious stone artifact, or baetylus, used to denote the direction of the \\\"center\\\" of the world."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c05bdf87-eab2-3c56-8ad6-950165445fa1",
                                        "entry_id": "c323adda-64a9-37bf-8868-01e7a86dba3d",
                                        "glosses": [
                                            "The theological proposition that the world was created with certain indicia of a history which had not actually occurred (such as the humans who had never been connected to umbilical cords being created with navels)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3da74c6-d4fd-3964-a494-50ce71dead31",
                                        "entry_id": "c323adda-64a9-37bf-8868-01e7a86dba3d",
                                        "glosses": [
                                            "The navel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41c65c8b-c935-3ef2-a7fe-0e7377cd7b2f",
                                        "entry_id": "c323adda-64a9-37bf-8868-01e7a86dba3d",
                                        "glosses": [
                                            "A raised central point; a boss."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d31da80a-a4d8-36a3-859f-2256384c288f",
                                        "entry_id": "c323adda-64a9-37bf-8868-01e7a86dba3d",
                                        "glosses": [
                                            "The center or hub."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e6779a-f1fd-4518-a4ff-4f89a187673e",
                                                "sense_id": "d31da80a-a4d8-36a3-859f-2256384c288f",
                                                "text": "—Rather bleak in wintertime, I should say. Martello you call it? —Billy Pitt had them built, Buck Mulligan said, when the French were on the sea. But ours is the omphalos."
                                            },
                                            {
                                                "example_id": "0d6a4879-017b-420a-9a40-2935c1e367a0",
                                                "sense_id": "d31da80a-a4d8-36a3-859f-2256384c288f",
                                                "text": "Here I was, embosomed in the very nave, the very omphalos of furtive femininity—a prize patron of the women's restaurant, a member, privy to its innermost secrets."
                                            },
                                            {
                                                "example_id": "bcbb6f1c-e891-461b-8541-ed0c48ca6942",
                                                "sense_id": "d31da80a-a4d8-36a3-859f-2256384c288f",
                                                "text": "The place in which this statue stood, Malalas writes, was called “the omphalos of the city.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
