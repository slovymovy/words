                    },
                    {
                        "translation_id": "8dfafff7-4d9a-429b-8927-57aea7a8a9c4",
                        "source_entry_id": "85c07fc1-e89e-3aef-8a91-890e26bdddd6",
                        "source_sense_id": "6c98b271-ab38-3175-844c-b4e6a8d1e66e",
                        "source_sense_description": "To be inherent; to be an essential or intrinsic part of; to be fixed or permanently incorporated with something",
                        "target_lang_word": "innewohnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "innewohnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b30cd30-8a78-3107-8ffc-b76f9b1a79a3",
                                        "entry_id": "0ce6e6c4-5292-3aae-8111-23383cd9fdac",
                                        "glosses": [
                                            "fester Bestandteil sein von etwas; grundsätzlich dazugehören; typische Charakteristik von etwas sein"
                                        ],
                                        "tags": [
                                            "gehoben",
                                            "intransitive",
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaa5e9ce-d843-4734-a00f-dc52b8aacca7",
                                                "sense_id": "6b30cd30-8a78-3107-8ffc-b76f9b1a79a3",
                                                "text": "Die Gründe der Schwerkraft, die dieser Welt innewohnt, sind letztendlich unbekannt."
                                            },
                                            {
                                                "example_id": "4be12a9a-e8cf-421a-9cda-e2b45ff326de",
                                                "sense_id": "6b30cd30-8a78-3107-8ffc-b76f9b1a79a3",
                                                "text": "„Hinsichtlich der der Urteilsseite 12 zu entnehmenden Begründungspassage, die sich auf die Kontaktierung zahlreicher mit ungarischen Autobussen zur Mariahilferstraße angereister Touristen bezieht, nimmt die Beschwerdereklamation von Feststellungsmängeln zur Quantifizierung angeblich nicht nach Österreich geschmuggelter - weil das für Einzelpersonen zulässige zollfreie Importquantum nicht übersteigender - Zigarettenstangen einen Sinngehalt in Anspruch, der den relevierten Urteilsausführungen in Wahrheit nicht innewohnt.“"
                                            },
                                            {
                                                "example_id": "155c0d4f-252d-4a92-a10c-84fa616936be",
                                                "sense_id": "6b30cd30-8a78-3107-8ffc-b76f9b1a79a3",
                                                "text": "Wo ist der Unterschied zwischen der Zuschreibung einer charakteristischen Mentalität bestimmter Volksgruppen, die ihnen wegen ihres gemeinsamen kulturellen Hintergrundes innewohnt und unzulässiger Pauschalisierung?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "723c7fd0-eb7f-4976-a51b-f2888414377d",
                        "source_entry_id": "85c07fc1-e89e-3aef-8a91-890e26bdddd6",
                        "source_sense_id": "6c98b271-ab38-3175-844c-b4e6a8d1e66e",
                        "source_sense_description": "To be inherent; to be an essential or intrinsic part of; to be fixed or permanently incorporated with something",
                        "target_lang_word": "anhaften",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anhaften",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b49d0619-7b37-3252-b5ae-22fc2f23865f",
                                        "entry_id": "887e880e-52a5-3bb6-ae1e-b746892534d3",
                                        "glosses": [
                                            "fest mit etwas verbunden sein, an jemandem/etwas festhängen, dauerhaft kleben bleiben"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338f9803-78e7-47b2-8229-fc1cc189a5d1",
                                                "sense_id": "b49d0619-7b37-3252-b5ae-22fc2f23865f",
                                                "text": "Diese ganzen zerquetschten Mücken haften so fest an der Frontscheibe an, dass ich sie kaum abkriege."
                                            },
                                            {
                                                "example_id": "ba22074f-0468-4182-bc2a-a0756897e0f7",
                                                "sense_id": "b49d0619-7b37-3252-b5ae-22fc2f23865f",
                                                "text": "„Das Stück erzählt vom Festhalten an Vergänglichem, von Liebe und Schmerz, von Erlösung. ‚Wir erleben heute viele Menschen, die Vergänglichem anhaften.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f087d43-2bf8-326f-b7f1-248238b70dca",
                                        "entry_id": "887e880e-52a5-3bb6-ae1e-b746892534d3",
                                        "glosses": [
                                            "zu jemandem oder etwas gehören, mit jemandem oder etwas stets in Verbindung gebracht werden (meist etwas Negatives)"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fb375b3-7a4f-492a-b3cd-46563a60510d",
                                                "sense_id": "6f087d43-2bf8-326f-b7f1-248238b70dca",
                                                "text": "„Die Experten haben im vergangenen Jahr unter anderem die Vatikanbank IOR überprüft, der ein Ruf von Geldwäsche anhaftet.“"
                                            },
                                            {
                                                "example_id": "fa16e7ce-9324-4183-aaa8-bf84da2814a9",
                                                "sense_id": "6f087d43-2bf8-326f-b7f1-248238b70dca",
                                                "text": "„Chicago hatte bis dahin ein provinzieller Ruf angehaftet; es war vor allem als Umschlagplatz für Fleisch bekannt gewesen.“"
                                            },
                                            {
                                                "example_id": "88a5b953-a3d3-40ce-825b-3bf20cc3705a",
                                                "sense_id": "6f087d43-2bf8-326f-b7f1-248238b70dca",
                                                "text": "„»Plus-Size-Körpern haftet […] immer noch das Stigma des nicht Normalen an – sonst würden sie nicht so gut in den Kampagnen funktionieren.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
