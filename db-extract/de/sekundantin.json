                        ],
                        "examples": [
                            {
                                "example_id": "93875ad5-9a1f-41fb-be79-488aa27a8b1a",
                                "sense_id": "24bf2a4b-491a-37c1-8ddb-4482fe8aa00e",
                                "text": "Die zur Faust geballte linke Hand agiert als Sekundantin des zum Sprechen geöffneten Mundes."
                            }
