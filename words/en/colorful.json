                                "ru": "Она надела <w>я́ркое</w> платье на вечеринку.",
                                "nl": "Ze droeg een <w>kleurrijke</w> jurk naar het feest.",
                                "pl": "Założyła na przyjęcie <w>kolorową</w> sukienkę.",
                                "de": "Sie trug ein <w>farbenfrohes</w> Kleid zur Party.",
                                "fr": "Elle portait une robe <w>colorée</w> pour la fête.",
                                "it": "Ha indossato un vestito <w>variopinto</w> per la festa.",
                                "cs": "Na večírek si oblékla <w>pestré</w> šaty.",
                                "tr": "Partiye <w>renkli</w> bir elbise giydi.",
                                "es": "Ella llevó un vestido <w>colorido</w> a la fiesta.",
                                "zh": "她穿了一件<w>鲜艳</w>的裙子去参加聚会。"
