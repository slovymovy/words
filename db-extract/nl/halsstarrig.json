                    }
                ],
                "senses": [
                    {
                        "sense_id": "a42ce826-551b-3990-b846-eab4f73e49bb",
                        "entry_id": "d7c6ab8f-f018-363b-aea7-dcdd588204ea",
                        "glosses": [
                            "koppig en onredelijk vasthoudend aan een standpunt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7299e56-bbcb-434f-b67a-1ffc2af43e27",
                                "sense_id": "a42ce826-551b-3990-b846-eab4f73e49bb",
                                "text": "Hij verwijt het bestuur een halsstarrige opstelling."
                            },
                            {
                                "example_id": "7f9720bc-d3b3-4f78-8cda-61e2f441dad3",
                                "sense_id": "a42ce826-551b-3990-b846-eab4f73e49bb",
                                "text": "De halsstarrige weigering om mee te werken zet kwaad bloed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a80ca815-0c12-463c-bf53-86580c0e177a",
                        "source_entry_id": "d7c6ab8f-f018-363b-aea7-dcdd588204ea",
                        "source_sense_id": "a42ce826-551b-3990-b846-eab4f73e49bb",
                        "target_lang_word": "obstinate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstinate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "261c2b8a-e40a-369c-9eaf-face94b320e4",
                                        "entry_id": "6e507293-90c3-365a-b14e-b781097a2549",
                                        "glosses": [
                                            "Stubbornly adhering to an opinion, purpose, or course, usually with implied unreasonableness; persistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e6830f-826b-4744-84cc-275678b29c99",
                                                "sense_id": "261c2b8a-e40a-369c-9eaf-face94b320e4",
                                                "text": "From this consideration it is that we have derived the custom, in times of war, to punish […] those who are obstinate to defend a place that by the rules of war is not tenable […]"
                                            },
                                            {
                                                "example_id": "d6102396-742f-42ff-8d83-f9bfb9a11b8c",
                                                "sense_id": "261c2b8a-e40a-369c-9eaf-face94b320e4",
                                                "text": "[…] the junior Osborne was quite as obstinate as the senior: when he wanted a thing, quite as firm in his resolution to get it; and quite as violent when angered, as his father in his most stern moments"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b7564f-9761-30cc-93ec-c6843feef7ab",
                                        "entry_id": "6e507293-90c3-365a-b14e-b781097a2549",
                                        "glosses": [
                                            "Not easily subdued or removed."
                                        ],
                                        "tags": [
                                            "of inanimate things"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2adf9b9-04f1-4b39-9225-860a03d9759f",
                                                "sense_id": "77b7564f-9761-30cc-93ec-c6843feef7ab",
                                                "text": "1925-29, Mahadev Desai (translator), M.K. Gandhi, The Story of My Experiments with Truth, Part IV, Chapter XXIX,\nNow it happened that Kasturbai […] had again begun getting haemorrhage, and the malady seemed to be obstinate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae82ed82-bce8-3b94-8180-94591f857740",
                                        "entry_id": "6e507293-90c3-365a-b14e-b781097a2549",
                                        "glosses": [
                                            "Typical of an obstinate person; fixed and unmoving."
                                        ],
                                        "tags": [
                                            "of a facial feature"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df7acbd-e454-4714-8817-688fc5029a15",
                                                "sense_id": "ae82ed82-bce8-3b94-8180-94591f857740",
                                                "text": "He had the same pile of curly hair, but he was clean-shaven with a heavy, obstinate jowl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32889b5b-6685-4820-95ff-aee40cfc916d",
                        "source_entry_id": "d7c6ab8f-f018-363b-aea7-dcdd588204ea",
                        "source_sense_id": "a42ce826-551b-3990-b846-eab4f73e49bb",
                        "target_lang_word": "stubborn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stubborn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab4e1583-fe46-3086-a967-352071769ff4",
                                        "entry_id": "0d4f1be9-5978-372e-afba-e759cae22a85",
                                        "glosses": [
                                            "Refusing to move or to change one's opinion; obstinate; firmly resisting; persistent in doing something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ab06aae-8575-4870-976d-4fa7370e4550",
                                                "sense_id": "ab4e1583-fe46-3086-a967-352071769ff4",
                                                "text": "People are pretty stubborn about their political beliefs, so why bother arguing?"
                                            },
                                            {
                                                "example_id": "6e94a674-3d84-4569-b647-84182a831e23",
                                                "sense_id": "ab4e1583-fe46-3086-a967-352071769ff4",
                                                "text": "Blood can make a very stubborn stain on fabrics if not washed properly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1b73a0-24da-3910-a3ad-bc5adaf7794c",
                                        "entry_id": "0d4f1be9-5978-372e-afba-e759cae22a85",
                                        "glosses": [
                                            "Of materials: physically stiff and inflexible; not easily melted or worked."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stubborn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57f16671-9dd0-3280-be7f-83b751b007ab",
                                        "entry_id": "0d51b019-b064-3d31-909c-01a2e1b1c7cd",
                                        "glosses": [
                                            "Stubbornness."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f04535f9-a811-450d-a19b-ad7a8e9eb6b1",
                                                "sense_id": "57f16671-9dd0-3280-be7f-83b751b007ab",
                                                "text": "But I have to say that one thing you inherited from your mother is a whole lot of stubborn."
                                            },
                                            {
                                                "example_id": "43e23b0e-f4b8-447c-8b3c-5dfb6d881217",
                                                "sense_id": "57f16671-9dd0-3280-be7f-83b751b007ab",
                                                "text": "That takes a lot of stubborn for a seventy-something man."
                                            },
                                            {
                                                "example_id": "946037f6-d133-42ca-b637-cf21cc099281",
                                                "sense_id": "57f16671-9dd0-3280-be7f-83b751b007ab",
                                                "text": "Stubborn is not eating pizza out of a square pan because you know it won't taste as good as a round one. Stubborn is spending twelve thousand dollars to fix a five-hundred-dollar truck just because it's “your baby.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3561c383-f5f6-3f89-ad75-26e9b678d568",
                                        "entry_id": "0d51b019-b064-3d31-909c-01a2e1b1c7cd",
                                        "glosses": [
                                            "Ellipsis of stubborn disease (“a disease of citrus trees”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ce50eed-582f-4c1f-947b-7e8ace3fef17",
                                                "sense_id": "3561c383-f5f6-3f89-ad75-26e9b678d568",
                                                "text": "With evidence that the causal agent of stubborn is spread by insects, control or prevention of this disease will prove more difficult than formerly thought to be."
                                            },
                                            {
                                                "example_id": "6d29aa3c-fc38-474b-b929-53a8029ffc33",
                                                "sense_id": "3561c383-f5f6-3f89-ad75-26e9b678d568",
                                                "text": "Sectorial infection of stubborn could be stable for long periods, but may be manifested once the trees are severely pruned, this causing the system spread of S. citri to other non-infected parts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e57f7811-c9d8-468c-9d13-f606243b5033",
                        "source_entry_id": "d7c6ab8f-f018-363b-aea7-dcdd588204ea",
                        "source_sense_id": "a42ce826-551b-3990-b846-eab4f73e49bb",
                        "target_lang_word": "упрямый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "упрямый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6339554e-408d-386d-9317-2e43db266421",
                                        "entry_id": "a681a601-90ef-3855-ad88-8522b7306f9e",
                                        "glosses": [
                                            "несговорчивый, неуступчивый, непременно желающий настоять на своём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50b1f213-09ab-490f-9cfc-67ff6a83b186",
                                                "sense_id": "6339554e-408d-386d-9317-2e43db266421",
                                                "text": "Он чувствовал это, и это было справедливо: хитрый и упрямый шут, Фёдор Павлович, очень твёрдого характера «в некоторых вещах жизни», как он сам выражался, бывал, к собственному удивлению своему, весьма даже слабоват характером в некоторых других «вещах жизни»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5f28e10-503d-37d3-9544-2f4ceb4b289f",
                                        "entry_id": "a681a601-90ef-3855-ad88-8522b7306f9e",
                                        "glosses": [
                                            "выражающий упрямство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd78673f-e17e-431f-8ce9-9d49d03c088d",
                                                "sense_id": "c5f28e10-503d-37d3-9544-2f4ceb4b289f",
                                                "text": "И, действительно, поделать с ребёнком ничего нельзя было: если он начинал капризничать, то вы могли терпеть, могли раздражаться, упрекать няньку, свою жену за то, что они распустили ребёнка так, что хоть беги из дому; могли, действительно, убегать, и, проносясь мимо окон детской, уже с улицы видеть всё тот же упрямый, но с каким-то напряжённым интересом провожающий вас взгляд, — лицо, всё с тем же открытым ртом, из которого в это мгновение несётся всё тот же надрывающий душу вой."
                                            },
                                            {
                                                "example_id": "9f33a88d-04c1-48d8-a004-cfbb532bfbbe",
                                                "sense_id": "c5f28e10-503d-37d3-9544-2f4ceb4b289f",
                                                "text": "Теперь он стал весь виден: очень бледный, с нежным девичьим лицом, с голубыми глазами и упрямым детским подбородком с ямочкой посредине; лет ему, должно быть, было около тридцати, тридцати пяти."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7619dac2-38f0-3610-8d8c-ab1f4fd2f1b4",
                                        "entry_id": "a681a601-90ef-3855-ad88-8522b7306f9e",
                                        "glosses": [
                                            "перен. (о неодушевлённых предметах) неподдающийся"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a52ea4-021e-4645-9e57-de5edd2e4cd1",
                                                "sense_id": "7619dac2-38f0-3610-8d8c-ab1f4fd2f1b4",
                                                "text": "В такое время хорошо гнать метлой или лопатой грязную воду в канавах, пускать по воде кораблики или долбить каблуками упрямый лёд."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
