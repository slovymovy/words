                                "sense_id": "c6fdafaa-cd11-39bf-bc39-fbd278b48c34",
                                "text": "„Sie wandte sich ab, hob das Notenblatt in Gesichtshöhe und begann wieder singend im Saale auf und nieder zu gehen.“"
                            },
                            {
                                "example_id": "da5a0762-dda9-4533-a3f2-859b3649d50c",
                                "sense_id": "c6fdafaa-cd11-39bf-bc39-fbd278b48c34",
                                "text": "„Nur das Licht einer Stehlampe fällt auf die weißen Notenblätter.“"
                            }
                        ],
