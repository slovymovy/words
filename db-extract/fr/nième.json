                        ],
                        "examples": [
                            {
                                "example_id": "04da07a3-d323-4391-8dea-26d77f4eb2a5",
                                "sense_id": "9da24809-8d80-337c-8f75-166e1e204a14",
                                "text": "Ce faisant, pour la nième fois elle recommença, volubile, île par île, le récit de ses pérégrinations au pays des Guanches et des serins."
                            }
                        ]
                    }
