                                        "entry_id": "4eba097f-feaa-3525-8459-319a3544a676",
                                        "glosses": [
                                            "taki, który należy do słonia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f03be7-48c6-4790-b8a4-9a61a2e19637",
                                                "sense_id": "1de4ddd8-8b62-332e-ae92-42e34858575c",
                                                "text": "Pałac królewski, wzniesiony przez ojca, kazał rozbudować i bogato ozdobić kością słoniową"
                                            },
                                            {
                                                "example_id": "77b11c43-a310-4373-8cb8-614a40dc2adb",
                                                "sense_id": "1de4ddd8-8b62-332e-ae92-42e34858575c",
                                                "text": "Stare czaszki słoniowe, nosorożcowe, woliera z krzyczącymi papużkami, trzcinowy dach, tysiące kwiatów, palmy, susza, upał i cień pod mangowcami, no i zimne piwo z lodu - to jest Namanga."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
