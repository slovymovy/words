                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4aff7d8-4e30-4c90-abca-798c13cd18f4",
                        "source_entry_id": "dd72788f-ee80-342c-93f3-84066376028e",
                        "source_sense_id": "41dd6a9b-12ab-3f39-a6a8-d18ce4144f13",
                        "target_lang_word": "hexakaidecahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hexakaidecahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f53f6a84-ff0e-35f3-81ee-3c470205d7f6",
                                        "entry_id": "a884c106-9fef-3985-9c89-fe2b2ecafdf9",
                                        "glosses": [
                                            "Synonym of hexadecahedron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64eedcab-136f-42e8-a000-f5d497fcbeff",
                                                "sense_id": "f53f6a84-ff0e-35f3-81ee-3c470205d7f6",
                                                "text": "In structure I, the unit cell contains 136 water molecules which are arranged so that they form 16 pentagonal dodecahedra (small cavities) and 8 hexakaidecahedra (large cavities)."
                                            },
                                            {
                                                "example_id": "33e9a7c7-e06a-4c2a-a347-d102ccba9557",
                                                "sense_id": "f53f6a84-ff0e-35f3-81ee-3c470205d7f6",
                                                "text": "Other possible cage structures which the water molecules may adopt are the tetra- and the hexakaidecahedron."
                                            },
                                            {
                                                "example_id": "c23a6d39-5672-484e-9c0a-fb983735efd3",
                                                "sense_id": "f53f6a84-ff0e-35f3-81ee-3c470205d7f6",
                                                "text": "Moreover, it is impossible to separate gas molecules completely because the structure of propane hydrate consists of hexakaidecahedrons and dodecahedrons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f37e1461-b603-4498-81e4-45eeec952447",
                        "source_entry_id": "dd72788f-ee80-342c-93f3-84066376028e",
                        "source_sense_id": "41dd6a9b-12ab-3f39-a6a8-d18ce4144f13",
