                        "examples": [
                            {
                                "example_id": "5f83bcdf-4cb4-45c6-b6cb-2984071212fa",
                                "sense_id": "46b46cc4-da48-3dca-a9bd-09f233a269c6",
                                "text": "„Ob in den Aufzeichnungen altgriechischer und römischer Historiker in mittelalterlichen Legenden oder in den wabernden Fantasy-Nebeln zeitgenössischer Anderswelten von Arda bis Avalon: Sowohl die historischen Kriegerinnen wie die sagenhaften Feen, Zauberinnen und Göttinnen der keltischen Wandervölker umweht der Mythos, für ein frühes Feminat zu stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "365a0e21-9f4d-3b02-86d2-e4bdcdb4953b",
