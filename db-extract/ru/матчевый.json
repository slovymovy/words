                "translations": [
                    {
                        "translation_id": "080c9b0d-3b2e-4741-8c4b-b4f09dae20e5",
                        "source_entry_id": "8c9c7a7b-3873-33b6-9929-3baa1755a4be",
                        "target_lang_word": "meczowy",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meczowy",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e85efa2f-f2de-3188-8640-8e7664e6d805",
                                        "entry_id": "facb1586-7c73-3f67-8d3f-0072321403a4",
                                        "glosses": [
                                            "związany z meczem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1750d366-cf72-4027-9b89-4c9831a2626c",
                                                "sense_id": "e85efa2f-f2de-3188-8640-8e7664e6d805",
                                                "text": "Tacy młodzi zawodnicy … posiadają już dużo tenisowej wiedzy technicznej. Brak im tylko doświadczenia meczowego"
                                            },
                                            {
                                                "example_id": "61106d5f-823b-413b-8c95-fb9acfe03c96",
                                                "sense_id": "e85efa2f-f2de-3188-8640-8e7664e6d805",
                                                "text": "Na wymienionym terenie projektowane jest pomieszczenie 1 wzorowego boiska meczowego, otoczonego sześcio-torową, żużlową, bieżnią, dwu boisk treningowych i pewnej ilości ziemnych kortów tennisowych"
                                            },
                                            {
                                                "example_id": "29f37291-0d2f-4482-acfb-de8bbd3940bf",
                                                "sense_id": "e85efa2f-f2de-3188-8640-8e7664e6d805",
                                                "text": "W przerwie zmieniłem aż trzech zawodników, po pierwsze dlatego, aby wprowadzić trochę świeżej krwi, a po drugie, aby zobaczyć w meczowej walce jak najwięcej piłkarzy"
                                            },
                                            {
                                                "example_id": "3c9bd202-b5f6-4174-a8f1-87321c590539",
                                                "sense_id": "e85efa2f-f2de-3188-8640-8e7664e6d805",
                                                "text": "Poza tym meczowe statystyki wskazywały, że nasza gra w czasie tych spotkań nie była wcale taka tragiczna"
                                            },
                                            {
                                                "example_id": "f59b1a3b-d121-4b6a-9091-d9fc872a4f39",
                                                "sense_id": "e85efa2f-f2de-3188-8640-8e7664e6d805",
                                                "text": "— Powoli wchodził w rytm meczowy, strzelając jedną bramkę w pierwszej połowie — przypomina trener"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
