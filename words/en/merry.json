                            {
                                "target_lang_word": "праздничный",
                                "target_lang_sense_clarification": "торжественный и радостный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "088a75ae-caa2-37ea-a035-fa7b19b0f607",
