                                "target_senses": [
                                    {
                                        "sense_id": "877a4d4e-4cb4-3733-893d-8b8d02031a31",
                                        "entry_id": "57957dda-54e5-38a3-b188-b6300645f337",
                                        "glosses": [
                                            "Lier et serrer avec un bandage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "223a2b37-962a-4c9e-8b10-ca87ca9cb4f4",
                                                "sense_id": "877a4d4e-4cb4-3733-893d-8b8d02031a31",
                                                "text": "Bander une plaie."
                                            },
                                            {
                                                "example_id": "1efe7b03-3e29-409d-9721-904346cc1d6f",
                                                "sense_id": "877a4d4e-4cb4-3733-893d-8b8d02031a31",
                                                "text": "Bander le front d’un malade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33d6c25d-a9b4-3ca2-a331-f522912314be",
                                        "entry_id": "57957dda-54e5-38a3-b188-b6300645f337",
                                        "glosses": [
                                            "Couvrir les yeux d’un bandeau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af822459-6c94-4796-8505-4b60877e6cec",
                                                "sense_id": "33d6c25d-a9b4-3ca2-a331-f522912314be",
                                                "text": "Bander les yeux du soldat qu’on va fusiller."
                                            },
                                            {
                                                "example_id": "5372db40-4048-463c-a7ff-f073e13b3eaa",
                                                "sense_id": "33d6c25d-a9b4-3ca2-a331-f522912314be",
                                                "text": "Se bander les yeux."
                                            },
                                            {
                                                "example_id": "85ec5f96-aa90-4168-b4f4-71884dcfe422",
                                                "sense_id": "33d6c25d-a9b4-3ca2-a331-f522912314be",
                                                "text": "Il faut bien bander le colin-maillard, pour qu’il ne voie rien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bander",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b742c7d-36ee-3b2b-bfd3-21f1088dd080",
                                        "entry_id": "a18b8f67-58d4-3ad4-a0fc-5aa319f18441",
                                        "glosses": [
                                            "Raidir une arme de trait (arc, arbalète), un muscle ; tendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6893afe4-4344-4ba4-b462-621935b9ef26",
                                                "sense_id": "7b742c7d-36ee-3b2b-bfd3-21f1088dd080",
                                                "text": "Atteignons-nous un jour ce vers quoi, semblait-il, nous avions bandé toutes nos forces ?"
                                            },
                                            {
                                                "example_id": "639fb2cb-9134-4d24-b306-db82086bc71b",
                                                "sense_id": "7b742c7d-36ee-3b2b-bfd3-21f1088dd080",
                                                "text": "Sur la plage, il banda ses muscles pour impressionner les filles."
                                            },
                                            {
                                                "example_id": "db3375ff-f7df-44b5-9ad6-416c26934540",
                                                "sense_id": "7b742c7d-36ee-3b2b-bfd3-21f1088dd080",
                                                "text": "Bander un ressort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3ad6721-5b53-3569-90a8-1b41caeb7d6c",
                                        "entry_id": "a18b8f67-58d4-3ad4-a0fc-5aa319f18441",
                                        "glosses": [
                                            "Avoir une érection du pénis."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70a29c7d-d963-4935-b20f-fc1a83b06399",
                                                "sense_id": "e3ad6721-5b53-3569-90a8-1b41caeb7d6c",
                                                "text": "Si le monsieur qui parle à votre mère se met à bander dans son pantalon, ne le faites pas remarquer tout haut."
                                            },
                                            {
                                                "example_id": "62b8de60-b13a-45e2-8e52-bdec995dfc87",
                                                "sense_id": "e3ad6721-5b53-3569-90a8-1b41caeb7d6c",
                                                "text": "Quand je pense à Fernande,\nJe bande, je bande."
                                            },
                                            {
                                                "example_id": "8030a17a-c7b2-42b9-b84f-6c939fa96934",
                                                "sense_id": "e3ad6721-5b53-3569-90a8-1b41caeb7d6c",
                                                "text": "Si vous voyez Estelle,\nDites-lui mes amis\nQue je bande pour elle,\nQue j’en perds l’appétit\nQu’on se remettra ensemble\nQue je m’avoue vaincu\nEt que j’ai les mains qui tremblent\nQuand j’évoque son cul…"
                                            },
                                            {
                                                "example_id": "05bf2e7f-a34b-41e2-a79d-2062dcf7ea2f",
                                                "sense_id": "e3ad6721-5b53-3569-90a8-1b41caeb7d6c",
                                                "text": "Mais ça c’est du Cialis©, on en prescrit aux mecs qui ont du mal à bander. Moi perso', je n’ai pas de souci de ce côté. Mais si je prends deux cachetons, une double dose, je peux rester en érection plus de trois heures, voire quatre sans aucun problème."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcc5df7d-b311-3af7-8776-38bdc72b90a2",
                                        "entry_id": "a18b8f67-58d4-3ad4-a0fc-5aa319f18441",
                                        "glosses": [
                                            "Poser les pierres d’une voûte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33f3c2bc-4771-3017-b041-e01dd1b9d574",
                                        "entry_id": "a18b8f67-58d4-3ad4-a0fc-5aa319f18441",
                                        "glosses": [
                                            "Être tendu."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "626ce76e-3760-43ca-924f-55505623c91f",
                                                "sense_id": "33f3c2bc-4771-3017-b041-e01dd1b9d574",
                                                "text": "Cette corde bande trop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "600fd526-6183-35e3-bb9b-04723b979f89",
                                        "entry_id": "a18b8f67-58d4-3ad4-a0fc-5aa319f18441",
