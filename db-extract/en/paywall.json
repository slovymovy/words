    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b9af5c2d-445e-3ad3-b737-556fababdbf3",
                "word": "paywall",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5be548c4-be87-4a85-8584-9284c2e49841",
                        "entry_id": "b9af5c2d-445e-3ad3-b737-556fababdbf3",
                        "tags": [
                            "plural"
                        ],
                        "form": "paywalls"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                        "entry_id": "b9af5c2d-445e-3ad3-b737-556fababdbf3",
                        "glosses": [
                            "A system that restricts access to content with a purchase or a paid subscription."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "61f6c639-6809-4e28-93c5-fbc803ccbcda",
                                "sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                                "text": "The premium content on this website is behind a paywall."
                            },
                            {
                                "example_id": "8c5cee33-9bac-49f6-89f8-135ccc7f12f6",
                                "sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                                "text": "Techdirt got wind of a secret meeting by newspaper execs, complete with antitrust lawyers, to discuss how to proceed on the issue of implementing paywalls going forward."
                            },
                            {
                                "example_id": "fda90985-a7df-4489-9437-786dbb54c759",
                                "sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                                "text": "Scores of other newspapers started selling digital subscriptions in 2011, either with a paywall on their sites or by charging for mobile access with an e-reader app. […] Time magazine also set up a paywall in 2011, its second attempt in two years, […]"
                            },
                            {
                                "example_id": "3123d537-f9f8-4808-9b19-d5a9bd9310d8",
                                "sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                                "text": "As for the larger general-interest dailies, Long Island's Newsday was the first to erect its paywall, in October 2009. It allowed full access for subscribers to the print edition of the paper or the parent company Cablevision, or for people willing to pay $5 per week."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "953fb452-0128-4877-a134-13abcd1256c4",
                        "source_entry_id": "b9af5c2d-445e-3ad3-b737-556fababdbf3",
                        "source_sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                        "source_sense_description": "system that restricts access to paying subscribers",
                        "target_lang_word": "betaalmuur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "betaalmuur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5e5bee40-1605-3e43-b2f4-d9551546bc13",
                                        "entry_id": "d17f8962-edc1-3cd0-87bb-25114273f86e",
                                        "glosses": [
                                            "de afscherming van een product of dienst voor mensen die er niet voor betaald hebben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf69ab25-cc44-4f76-994f-bf632e2ec994",
                                                "sense_id": "5e5bee40-1605-3e43-b2f4-d9551546bc13",
                                                "text": "Fijn, maar wie heeft hier nou precies wat aan? \"Als je nog studeert, verandert er niet zoveel\", zegt Bastiaan Verweij van de VSNU, de belangenvereniging van de universiteiten. \"Als je nu voor een essay artikelen zoekt, stuit je heel soms op een betaalmuur. Soms dus, want universiteiten hebben contracten waardoor je de meeste publicaties kunt lezen. Dat zijn er nu nog iets meer.\""
                                            },
                                            {
                                                "example_id": "b957b71e-db9f-4777-9013-c5640ceca44b",
                                                "sense_id": "5e5bee40-1605-3e43-b2f4-d9551546bc13",
                                                "text": "Vanaf september start BitTorrent ook met de invoering van een betaalmuur. Je moet dan betalen voor sommige opkomende artiesten, die via de site een platform krijgen om hun muziek te verspreiden. \"We zien een kans om een toonaangevende plek te worden voor het creëren van bijzondere content zoals muziek, film en kunst\", zegt Mason tegen de New York Times."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df0e9e0a-1871-4974-a7af-cdf4668e9059",
                        "source_entry_id": "b9af5c2d-445e-3ad3-b737-556fababdbf3",
                        "source_sense_id": "ba3053fb-37c1-311b-a0d2-9f1f110b3c4a",
                        "source_sense_description": "system that restricts access to paying subscribers",
                        "target_lang_word": "péage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "péage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "289ed6f8-ea62-3654-84a8-6d3b86c23827",
                                        "entry_id": "66dfb884-90f7-3b70-9dba-5889b671264a",
                                        "glosses": [
                                            "Droit qui se lève sur les personnes, les animaux, les marchandises, pour leur passage sur un chemin, sur un pont, sur une rivière, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b4a14d-cd02-47e3-801f-28b51fa6972e",
                                                "sense_id": "289ed6f8-ea62-3654-84a8-6d3b86c23827",
                                                "text": "Je conseille à Charon de doubler son droit de péage, à Pluton de faire la guerre contre Jupiter pour être le premier des dieux, attendu que Jupiter gouverne mal les hommes, et que l’empire des morts est plus étendu que celui des vivants."
                                            },
                                            {
                                                "example_id": "98c6f396-b993-4749-b05d-d1e29007695d",
                                                "sense_id": "289ed6f8-ea62-3654-84a8-6d3b86c23827",
                                                "text": "Beaucoup de navires feront du charbon à Colon, et tous seront forcés de s'arrêter au port d'entrée pour acquitter le péage, prendre des pilotes."
                                            },
                                            {
                                                "example_id": "523cd641-42c5-4230-8f71-782eb459e0fc",
                                                "sense_id": "289ed6f8-ea62-3654-84a8-6d3b86c23827",
                                                "text": "Une surtout, le droit de péage dont les seigneurs prétendaient frapper la navigation du Ligneul, éternisa les querelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57e9e533-33ce-3515-a7b0-017e86cf9108",
                                        "entry_id": "66dfb884-90f7-3b70-9dba-5889b671264a",
                                        "glosses": [
                                            "Redevance pour circuler sur les autoroutes et certains ponts."
                                        ],
                                        "tags": [
                                            "Transport terrestre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e26807d-9c71-40f3-9c44-560118c42c7c",
                                                "sense_id": "57e9e533-33ce-3515-a7b0-017e86cf9108",
                                                "text": "La plupart des routes européennes font l’objet désormais d’un péage, d’une taxe ou d’une redevance."
                                            },
                                            {
                                                "example_id": "ff3fed75-0e34-4d75-9c9c-2c88ac53f0a5",
                                                "sense_id": "57e9e533-33ce-3515-a7b0-017e86cf9108",
                                                "text": "Nous considérons en effet que contraindre les clients à aller payer leur péage dans des bureaux de tabac dans un délai court après leur voyage constitue une vraie régression et une forte complication en matière d’expérience client"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5486d63-c0e7-3096-984c-0065a53c0899",
                                        "entry_id": "66dfb884-90f7-3b70-9dba-5889b671264a",
                                        "glosses": [
                                            "Lieu où l’on paye le droit de passage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b016d7-a7ab-443d-a719-6dcc15b81c7c",
                                                "sense_id": "f5486d63-c0e7-3096-984c-0065a53c0899",
                                                "text": "Mon cœur s'emballait à chaque pont quand l’autobus s’arrêtait au péage. Avec l’angoisse montait aussi le remords."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
