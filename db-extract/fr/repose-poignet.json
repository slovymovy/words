                    {
                        "sense_id": "1e78faed-2df3-33ab-a287-3dd405037e42",
                        "entry_id": "d8bff0ea-e0d6-3234-8c9b-674974116b45",
                        "glosses": [
                            "Coussin ergonomique positionné sous le poignet devant un clavier ou une souris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "916c1732-f97a-4377-b608-cf66275a1558",
                                "sense_id": "1e78faed-2df3-33ab-a287-3dd405037e42",
                                "text": "À l’affût de l’évolution des mœurs, des designers avaient imaginé, il y a quelques années, des coussinets repose-poignet pour soulager les internautes maniant trop fréquemment la souris."
                            },
                            {
                                "example_id": "7aa764a9-1552-4511-8d11-1f39b2993559",
                                "sense_id": "1e78faed-2df3-33ab-a287-3dd405037e42",
                                "text": "Son ADN a été découverte sur le repose-poignet de l’ordinateur des victimes, celui dont s’est servi le tueur pour revendiquer son crime."
                            }
                        ]
                    }
                ],
