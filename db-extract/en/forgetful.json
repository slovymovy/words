                                "target_senses": [
                                    {
                                        "sense_id": "4283022d-a2f6-3d12-a302-a9ef34a34946",
                                        "entry_id": "b9183a34-9eb9-3596-82e3-03961f5cc372",
                                        "glosses": [
                                            "Celui qui oublie ses obligations."
