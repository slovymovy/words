                    {
                        "sense_id": "8fdca934-26a9-3d42-8db0-e2147aa303f4",
                        "entry_id": "35f6193a-4cb7-3372-9f17-6ccde9520aba",
                        "glosses": [
                            "Pourpoint à manches et rembourré, servant à la fois de vêtement et de protection, en usage au Moyen Âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e033d72-70bc-44c5-aa1c-08a1162e7c09",
                                "sense_id": "8fdca934-26a9-3d42-8db0-e2147aa303f4",
                                "text": "Le roi était à cheval, vêtu de l’habillement court et étroit qu’on nommait une jacque ; le sien était en velours noir."
                            },
                            {
                                "example_id": "0d354432-52f6-46e2-a30a-af46e40a126d",
                                "sense_id": "8fdca934-26a9-3d42-8db0-e2147aa303f4",
                                "text": "Jeanne fut introduite (...). Robuste, le cou puissant et court, la poitrine ample, autant qu’il y pouvait paraître sous le jacque."
                            }
                        ]
                    }
                ],
