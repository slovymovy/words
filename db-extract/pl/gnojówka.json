                    {
                        "translation_id": "6319a69e-75e7-423b-b093-81a2aed40c18",
                        "source_entry_id": "911398f4-2022-3895-a851-1709db3cc462",
                        "source_sense_id": "c984395d-4f56-39c1-82ee-42b724427af3",
                        "target_lang_word": "Jauche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jauche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da2865d9-cf10-3218-b1cb-b28acaa2b7c8",
                                        "entry_id": "88a36cf4-20a9-393e-91c3-438f1871f60a",
                                        "glosses": [
                                            "gesammelte flüssige Exkremente (Harn) von Menschen und Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18835cad-3587-4bc8-ba54-d90e4fc0a0a0",
                                                "sense_id": "da2865d9-cf10-3218-b1cb-b28acaa2b7c8",
                                                "text": "Im Frühjahr bringen die Bauern die Jauche als Dünger auf die Felder."
                                            },
                                            {
                                                "example_id": "c2f3dc9a-33d3-4d11-9534-110345909333",
                                                "sense_id": "da2865d9-cf10-3218-b1cb-b28acaa2b7c8",
                                                "text": "„Eine Pumpe, auf einen Faßwagen montiert, spie Jauche auf die Erntefelder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8868974-32a3-3582-88cf-353c03a55647",
                                        "entry_id": "88a36cf4-20a9-393e-91c3-438f1871f60a",
                                        "glosses": [
                                            "Bereitung aus Wasser und Pflanzenteilen, die zu unterschiedlichen Zwecken im Gartenbau und der Landwirtschaft verwandt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae08b29-7c9f-4c75-a797-fa2aa3e69a95",
                                                "sense_id": "a8868974-32a3-3582-88cf-353c03a55647",
                                                "text": "Im biologischen Gartenbau wird zum Düngen eine Jauche aus Brennnessel- oder Rhabarberblättern genutzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "21bc995d-976e-3b88-b619-6e07ec56f2df",
                                        "entry_id": "88a36cf4-20a9-393e-91c3-438f1871f60a",
                                        "glosses": [
                                            "übelriechende, schlechte Flüssigkeit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7693274d-0fd3-45db-8727-c65efe1b37e2",
                                                "sense_id": "21bc995d-976e-3b88-b619-6e07ec56f2df",
                                                "text": "Dieses Bier kann man nicht trinken, das ist ja die reinste Jauche!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
