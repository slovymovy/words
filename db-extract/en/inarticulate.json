                        "source_entry_id": "4a648aa6-fa2d-3017-aa65-46b1860211df",
                        "source_sense_description": "unable to speak with clarity",
                        "target_lang_word": "undeutlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undeutlich",
