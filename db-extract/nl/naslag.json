                "senses": [
                    {
                        "sense_id": "766f71a7-d4a2-311e-a628-457e68856ad7",
                        "entry_id": "cf083670-ac4f-3257-8984-9338c7413db7",
                        "glosses": [
                            "onderzoek door referenties op te vragen terwijl er geen eigen onderzoek wordt gedaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e426e07-bbf6-4f55-989e-805f7e1c7158",
                                "sense_id": "766f71a7-d4a2-311e-a628-457e68856ad7",
                                "text": "Er is door de Dienst Koninklijke en Diplomatieke Beveiliging (DKDB) alleen 'naslag' gedaan naar De Roy van Zuydewijn, aldus Rutte. Dat duurde 2 dagen. Er was geen sprake van 'taps, volgen of spioneren'. Er is ook geen onderzoek gedaan naar de moeder of zussen van De Roy van Zuydewijn."
                            },
                            {
                                "example_id": "a35ba84b-984d-48fd-81b1-29bca6df972e",
                                "sense_id": "766f71a7-d4a2-311e-a628-457e68856ad7",
                                "text": "De AIVD heeft in 2009-2010 onderzoek gedaan naar de Israëlische contacten van PVV-leider Geert Wilders. Dat meldt de Volkskrant. De geheime dienst zou zogeheten 'naslag' hebben gedaan naar aanleiding van een tip over Wilders' gesprekspartners, onder meer bij de Israëlische ambassade in Den Haag, aldus de krant."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bd85a51-7067-3ad7-8473-bd9e1bcff46e",
                        "entry_id": "cf083670-ac4f-3257-8984-9338c7413db7",
                        "glosses": [
                            "replica van een munt of medaille"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528bc1bc-05fc-4ba9-ad6e-2a1d03b9e3d2",
                                "sense_id": "1bd85a51-7067-3ad7-8473-bd9e1bcff46e",
                                "text": "De firma Mauquoy Medal Company uit Grobbendonk wordt ongetwijfeld een van de blikvangers met een reeks naslagen van zeldzame medailles uit hun atelier."
                            }
                        ]
                    }
                ],
