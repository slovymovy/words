                                "sense_id": "b9ed4e33-505f-328b-bc7d-da7bf62bc78e",
                                "text": "Hij betuigde zijn deelneming aan de familie van de gestorven man."
                            },
                            {
                                "example_id": "e869b906-17a8-48d5-b303-b0fd5f8681c0",
                                "sense_id": "b9ed4e33-505f-328b-bc7d-da7bf62bc78e",
                                "text": "Geen boeketje op de begrafenis namens GoSunny of een telefoontje van iemand van toi die zijn deelneming betuigde."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbee5bc0-84e0-3b47-8b90-d1b777cf63b3",
                        "entry_id": "c4c4dccb-d5c2-32da-8536-5ef58c499d7a",
