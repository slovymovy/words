                        "cross_references": [
                            {
                                "target_word": "réarmement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ea455e2-01b2-374f-abcd-23dbfb2d1151",
                                        "entry_id": "4a8ea061-8aea-309c-8604-18cbb0edbf3f",
                                        "glosses": [
                                            "Action d’armer de nouveau ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "818e7d65-c560-4148-b770-6d8a41783b4d",
                                                "sense_id": "5ea455e2-01b2-374f-abcd-23dbfb2d1151",
                                                "text": "Le réarmement de la milice."
                                            },
                                            {
                                                "example_id": "709ac77c-a194-4d2c-9a7e-a220e1506302",
                                                "sense_id": "5ea455e2-01b2-374f-abcd-23dbfb2d1151",
                                                "text": "Le réarmement d’un vaisseau."
                                            },
                                            {
                                                "example_id": "840f016e-52a1-44be-9114-b7f7b8c7bbd9",
                                                "sense_id": "5ea455e2-01b2-374f-abcd-23dbfb2d1151",
                                                "text": "Le conflit indochinois et le déclenchement de la guerre de Corée à l'été 1950 obligent ce même gouvernement, dans le cadre du pacte de l'Atlantique Nord, à mettre en place un programme de réarmement impliquant une augmentation importante des crédits militaires."
                                            }
