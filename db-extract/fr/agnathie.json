                        "entry_id": "920767e3-35a3-3e0e-bbdb-f554726b4d79",
                        "glosses": [
                            "Absence de mandibule, spécifique à la classe des agnathes ou constituant une malformation chez les autres vertébrés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f9fc03f-eda6-402b-8057-9befa03ba7b1",
                                "sense_id": "fefc8f5b-5d5a-39ec-9640-de33bde9aa84",
                                "text": "De plus, il peut y avoir différents degrés dans l’anomalie, dont l’agnathie serait l’ultime manifestation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
