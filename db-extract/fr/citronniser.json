                "senses": [
                    {
                        "sense_id": "3931be3a-7d34-3db6-b2dd-3e6c2898ed25",
                        "entry_id": "3d1bdd8e-76d4-3cb6-bb31-d7a20355dfce",
                        "glosses": [
                            "Donner un caractère citronné à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e16f4a7f-6fd5-4308-814e-30efe8cbf816",
                                "sense_id": "3931be3a-7d34-3db6-b2dd-3e6c2898ed25",
                                "text": "Je connais le chemin des apothicaires et je citronnise, miellise, rhumise à tout va!"
                            },
                            {
                                "example_id": "5a3d8a1e-0de2-4bf3-aee2-1fd0fc509efc",
                                "sense_id": "3931be3a-7d34-3db6-b2dd-3e6c2898ed25",
                                "text": "En fait j'ai pris un essai sur la grippe aviaire, j'ai versé un demi verre de jus de citron sur la feuille...et ça s'est \"citronnisé\""
                            },
                            {
                                "example_id": "a8a79188-9252-48fe-a56c-848306032d52",
                                "sense_id": "3931be3a-7d34-3db6-b2dd-3e6c2898ed25",
                                "text": "On dirait même que Pompom se \"citronnise\", je trouve."
                            }
                        ]
                    }
                ],
