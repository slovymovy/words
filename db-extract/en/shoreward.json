                        "sense_id": "f72a7dfb-f9e8-3178-bedf-b79529a244c8",
                        "entry_id": "5bcf54a0-33bc-3cdf-83a8-cc2e27e9fe8a",
                        "glosses": [
                            "In the direction of the shoreline, relatively speaking."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c48b6535-a97b-4bb7-a0f8-5247162e4c18",
                                "sense_id": "f72a7dfb-f9e8-3178-bedf-b79529a244c8",
                                "text": "When he felt him grasp his tail, Buck headed for the bank, swimming with all his splendid strength. But the progress shoreward was slow; the progress down-stream amazingly rapid."
                            },
                            {
                                "example_id": "88d608ed-f74d-4677-8e3a-0a60a34abd15",
                                "sense_id": "f72a7dfb-f9e8-3178-bedf-b79529a244c8",
                                "text": "The shoreward arms of the north and south cantilevers were built into masonry abutments."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc8d1261-8914-3084-bcba-f717dcfd30ef",
                        "entry_id": "5bcf54a0-33bc-3cdf-83a8-cc2e27e9fe8a",
                        "glosses": [
                            "Facing the shore."
