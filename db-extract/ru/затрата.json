                                        "entry_id": "21d0e76b-cd24-3259-9fa2-57f344ca746a",
                                        "glosses": [
                                            "The spending of money, or an expenditure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1be4c3ad-4b19-464f-8555-014344bed723",
                                                "sense_id": "8b068660-9c0f-3ce9-a598-1dcf269b2cd6",
                                                "text": "Without too much outlay, you could buy a second-hand car."
                                            },
                                            {
                                                "example_id": "9e46806d-b5d0-461f-acf4-3791a7737a38",
                                                "sense_id": "8b068660-9c0f-3ce9-a598-1dcf269b2cd6",
                                                "text": "Regard must be had to the extent to which the original capital outlay has not been covered by the sum of the annual provisions for renewal, that is to say, in insurance terms, to the unexpired life of the original work, although this financial factor has to be modified in the light of the actual physical condition of the work to be replaced."
                                            },
                                            {
                                                "example_id": "785d7f00-3a85-4a7e-9cbc-88b187ec091b",
                                                "sense_id": "8b068660-9c0f-3ce9-a598-1dcf269b2cd6",
                                                "text": "Getting the right manager has just been made more difficult by not having Champions League to offer. There will also be a huge churn of players after the lavish, unrewarding outlay this season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67ceb6cc-7a6e-39a2-a446-bd4e2020bcd6",
                                        "entry_id": "21d0e76b-cd24-3259-9fa2-57f344ca746a",
                                        "glosses": [
                                            "A remote haunt or habitation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88afde40-e41b-47c7-b961-da48333d7f2e",
                                                "sense_id": "67ceb6cc-7a6e-39a2-a446-bd4e2020bcd6",
                                                "text": "I know her and her haunts, Her lays, leaps, and outlays, and will discover all."
                                            }
                                        ]
                                    }
                                ]
                            },
