                    {
                        "sense_id": "05bd9416-2d03-3b71-9a7e-6e5b3ddeebc5",
                        "entry_id": "9c5a0181-f3db-37e6-a37d-52846ab40973",
                        "glosses": [
                            "Qui fait partie d’une ligue politique, plutôt conservatrice, voire réactionnaire."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3e6a1649-1d47-45f3-965b-cad47d7cb198",
                                "sense_id": "05bd9416-2d03-3b71-9a7e-6e5b3ddeebc5",
                                "text": "Il ne tolérait ni les moines ligueurs, ni les moines d'affaires."
                            },
                            {
                                "example_id": "e9f52f4b-c39f-4000-82ee-e97f7f1c49cd",
                                "sense_id": "05bd9416-2d03-3b71-9a7e-6e5b3ddeebc5",
                                "text": "En Flandres, pourtant, deux considérations importent peut-être davantage: l'anti-communisme de combat des moines ligueurs de l'école congréganiste et des vicaires de la paroisse intolérante; …."
                            }
                        ]
                    }
                ],
