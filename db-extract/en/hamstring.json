                    },
                    {
                        "translation_id": "8a13b959-d268-4e25-a058-4cdeb4d117ed",
                        "source_entry_id": "8ca16d54-738f-3949-8dd7-21a1bf005004",
                        "source_sense_description": "to disable",
                        "target_lang_word": "paralyser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralyser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb6b658d-6ca6-3ce1-a9a7-d4359658b6a0",
                                        "entry_id": "ea7ccc58-2c3c-371e-8526-2c906107b47b",
                                        "glosses": [
                                            "Frapper de paralysie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc3b52f-9e31-4804-9091-65ec8895fd98",
                                                "sense_id": "cb6b658d-6ca6-3ce1-a9a7-d4359658b6a0",
                                                "text": "Elle souffrait d'une maladie dont elle avait bien cru mourir. Tout son côté droit avait été paralysé. Elle n'avait qu'une moitié d'elle en ce monde quand l'autre lui était déjà étrangère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64568305-388a-3b15-a213-d8728dd1234e",
                                        "entry_id": "ea7ccc58-2c3c-371e-8526-2c906107b47b",
                                        "glosses": [
                                            "Forcer l'immobilisation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1dfd8a1-e446-4d6b-ab31-704294004326",
                                                "sense_id": "64568305-388a-3b15-a213-d8728dd1234e",
                                                "text": "Jogging sur la High Line avant que la chaleur ne nous paralyse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1a70326-cb97-3561-921b-e041964cd976",
                                        "entry_id": "ea7ccc58-2c3c-371e-8526-2c906107b47b",
                                        "glosses": [
                                            "Rendre nul, frapper d’inertie, neutraliser."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36e667a5-acba-4936-87ca-a2e1a05b445d",
                                                "sense_id": "d1a70326-cb97-3561-921b-e041964cd976",
                                                "text": "Pour être heureux dans ce monde, il y a des côtés de son âme qu'il faudrait entièrement paralyser."
                                            },
                                            {
                                                "example_id": "ed8e6f6f-6377-4abf-b12b-f38bc87e9f30",
                                                "sense_id": "d1a70326-cb97-3561-921b-e041964cd976",
                                                "text": "Dans toutes les Bourses de la terre, ce fut une avalanche de titres que les porteurs voulaient vendre ; les banques suspendirent leurs paiements, les affaires furent paralysées et cessèrent."
                                            },
                                            {
                                                "example_id": "b3adc27f-56e9-4829-8ae4-55ace730e373",
                                                "sense_id": "d1a70326-cb97-3561-921b-e041964cd976",
                                                "text": "La torpeur qui paralysait son cerveau lui procurait trop de bien-être pour qu'il tentât de la chasser."
                                            },
                                            {
                                                "example_id": "675b4a0b-a3fc-43f3-80d0-cae3fa6dc35f",
                                                "sense_id": "d1a70326-cb97-3561-921b-e041964cd976",
                                                "text": "Sans les camionneurs, l’économie brésilienne serait paralysée. Sur les routes en bon état de Rio, de Sâo Paulo ou de Belo Horizonte, les camions circulent par milliers, tous les jours."
                                            },
                                            {
                                                "example_id": "4b78af12-3e2b-4943-83e7-ed8ff7bf5912",
                                                "sense_id": "d1a70326-cb97-3561-921b-e041964cd976",
                                                "text": "Élevées au contact des animaux, initiées dès leur plus jeune âge aux « mystères du sexe », elles n’étaient pas paralysées par la pudeur : elles étaient franches du collier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
