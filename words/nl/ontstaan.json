                                "target_lang_sense_clarification": "to become apparent or start to exist"
                            },
                            {
                                "target_lang_word": "come into being",
                                "target_lang_sense_clarification": "to start to exist"
                            },
                            {
                                "target_lang_word": "originate",
                                "target_lang_sense_clarification": "to have a specified beginning"
                            }
                        ],
                        "ru": [
