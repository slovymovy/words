                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "jewelry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore several gold <w>bracelets</w> on her left wrist.",
                            "target_lang_translations": {
                                "ru": "На ее левом запястье было несколько золотых <w>браслетов</w>."
                            }
                        },
                        {
                            "text": "The artisan makes beautiful handmade <w>bracelets</w> from silver and beads.",
                            "target_lang_translations": {
                                "ru": "Мастер делает красивые <w>браслеты</w> ручной работы из серебра и бусин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gold bracelets",
                        "wear bracelets"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма множественного числа от слова bracelet (браслет)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "браслеты",
                                "target_lang_sense_clarification": "украшения на руку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e891614e-a8a7-3fe2-9688-48cea3556904",
                    "sense_definition": "Handcuffs used by law enforcement to secure a suspect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restraints",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer quickly put the <w>bracelets</w> on the suspect before leading him away.",
                            "target_lang_translations": {
                                "ru": "Полицейский быстро надел <w>браслеты</w> на подозреваемого, прежде чем увести его."
                            }
                        },
                        {
                            "text": "He knew his run from the law was over when he felt the cold metal of the <w>bracelets</w> on his wrists.",
                            "target_lang_translations": {
                                "ru": "Он понял, что его бегство от закона окончено, когда почувствовал холодный металл <w>наручников</w> на своих запястьях."
                            }
                        }
                    ],
                    "synonyms": [
                        "handcuffs",
                        "shackles",
                        "cuffs"
                    ],
                    "common_phrases": [
                        "put the bracelets on"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal term for handcuffs"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наручники, используемые правоохранительными органами для задержания подозреваемого (разговорный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "браслеты",
                                "target_lang_sense_clarification": "жаргонное название наручников"
                            },
                            {
                                "target_lang_word": "наручники",
                                "target_lang_sense_clarification": "средство ограничения подвижности"
                            }
                        ]
                    }
                }
            ]
        },
        {
