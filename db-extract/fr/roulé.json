            {
                "entry_id": "22b5d428-8354-3824-bc4f-8676b1ea0745",
                "word": "roulé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5979ef83-84f8-42b5-ba4f-3ed698c3888c",
                        "entry_id": "22b5d428-8354-3824-bc4f-8676b1ea0745",
                        "tags": [
