                                    {
                                        "sense_id": "068fca82-dd35-3b35-b46a-ad193ae5b4c7",
                                        "entry_id": "5ee7a37c-11e3-3214-b84a-04ed3071d5f2",
                                        "glosses": [
                                            "To check or adjust by comparison with a standard."
                                        ],
                                        "tags": [],
