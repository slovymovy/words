    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be08a7e0-898f-3451-92ac-d9de7a93671e",
                    "sense_definition": "Mammifère carnivore domestique de la famille des canidés, élevé pour la compagnie, la garde ou la chasse.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>chien</w> aboie joyeusement chaque fois que quelqu'un frappe à la porte d'entrée."
                        },
                        {
                            "text": "Chaque matin, mon voisin sort faire une promenade avec son <w>chien</w> dans le quartier."
                        }
                    ],
                    "synonyms": [
                        "cabot",
                        "clébard",
                        "clebs",
                        "toutou"
                    ],
                    "common_phrases": [
                        "chien de garde",
                        "promener le chien"
                    ]
                },
                {
                    "sense_id": "90c8e1f0-6f08-372e-a73c-42eaa6b23eec",
                    "sense_definition": "Pièce d'une arme à feu portative qui frappe l'amorce ou le percuteur pour provoquer le tir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chasseur a doucement relevé le <w>chien</w> de son fusil avant de viser la cible."
                        },
                        {
                            "text": "Le soldat a nettoyé soigneusement le <w>chien</w> de son arme pour éviter les enrayages."
                        }
                    ],
                    "common_phrases": [
                        "armer le chien"
                    ]
                },
                {
                    "sense_id": "ea0f15f0-afea-36ff-aa2a-a5154093ceaa",
                    "sense_definition": "Au jeu de tarot, ensemble de cartes mises de côté lors de la distribution et revenant au preneur.",
