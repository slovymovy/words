                ],
                "senses": [
                    {
                        "sense_id": "02f03243-a5a2-3f45-a046-5c2cb36bb861",
                        "entry_id": "e453483d-92ee-3b94-9710-4f21a57290dd",
                        "glosses": [
                            "Zustand der Verwirrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b031e9c5-fa4b-4a19-9664-b0c96a75ce05",
                                "sense_id": "02f03243-a5a2-3f45-a046-5c2cb36bb861",
                                "text": "„Nach dieser kurzen, offenbar nicht in ihr Weltbild passenden Irritation ist Steinbach rasch wieder auf Kurs.“"
                            },
                            {
                                "example_id": "8f1343d5-7722-4bfb-bd93-9775713e18be",
                                "sense_id": "02f03243-a5a2-3f45-a046-5c2cb36bb861",
                                "text": "„Ich versuche meine Irritation zu erklären.“"
                            },
                            {
                                "example_id": "66208595-c67c-4e06-9728-c70b34a8ca72",
                                "sense_id": "02f03243-a5a2-3f45-a046-5c2cb36bb861",
                                "text": "„Chantal scheint Retos Irritation zu bemerken, sie bittet ihn, sich zu setzen, einen Moment zu warten, worauf sie erneut in die obere Etage geht.“"
                            },
                            {
                                "example_id": "f476f47d-72d4-4dc3-9899-bfcba1016c84",
                                "sense_id": "02f03243-a5a2-3f45-a046-5c2cb36bb861",
                                "text": "„Die ersten Begegnungen zwischen Powhatan und Engländern sind von Irritationen und Missverständnissen geprägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a1c825e2-5384-305e-bdf7-5a647b65d562",
                        "entry_id": "e453483d-92ee-3b94-9710-4f21a57290dd",
                        "glosses": [
                            "physische Reizung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e0af39e-fa99-45ba-a328-52f70c80a6a5",
                                "sense_id": "a1c825e2-5384-305e-bdf7-5a647b65d562",
                                "text": "Diese Irritation auf der Haut der Hände wird abklingen, wenn sie nur noch die neue Seife verwenden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
