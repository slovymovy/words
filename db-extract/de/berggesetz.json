                ],
                "senses": [
                    {
                        "sense_id": "f9c71f32-ac1b-31a2-a918-2a657a0cdc4c",
                        "entry_id": "8386d927-8742-3753-881b-85263e80a798",
                        "glosses": [
                            "Gesetz, das den Bergbau und die Kompetenzen der Bergbehörden regelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c7d66ff-aea8-46a1-bed1-a74d1888db00",
                                "sense_id": "f9c71f32-ac1b-31a2-a918-2a657a0cdc4c",
                                "text": "„In Frankreich tritt ein Berggesetz in Kraft, das den Maximalarbeitstag in Bergwerken bis 1910 auf neun Stunden und ab 1910 auf acht Stunden festsetzt.“"
                            },
                            {
                                "example_id": "9da90d36-740f-4a1e-9317-1f55d1a42285",
                                "sense_id": "f9c71f32-ac1b-31a2-a918-2a657a0cdc4c",
                                "text": "„Das preußische Abgeordnetenhaus in Berlin verabschiedet gegen die Stimmen der Deutschkonservativen und Polen sowie einer Anzahl Freikonservativer und Freisinniger das Berggesetz.“"
                            },
                            {
                                "example_id": "0b5bacfc-62e1-4941-a708-4f1d94ac02bc",
                                "sense_id": "f9c71f32-ac1b-31a2-a918-2a657a0cdc4c",
                                "text": "„Die zweite sächsische Kammer nimmt ein neues Berggesetz an, das zahlreiche soziale Reformen enthält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
