                            {
                                "example_id": "b7d399a0-10de-4b40-96fc-f4c53f20ba1b",
                                "sense_id": "bf2ab6e3-7d21-304b-88eb-0578f037452d",
                                "text": "De Braziliaanse brokkenpiloot is hersteld van scheurtje in een dijspier. Voor Pato was het de dertiende blessure in twee jaar tijd."
                            },
                            {
                                "example_id": "8fc66f2d-bf3b-438a-bfb2-1174e6c44f42",
                                "sense_id": "bf2ab6e3-7d21-304b-88eb-0578f037452d",
                                "text": "De barre komt voornamelijk in beeld bij de dij- en biloefeningen. Heel elegant worden deze poses aan de houten stang alleen niet, want na een paar minuten op de bal van je voet je dijspieren ‘aanspannen en loslaten, aanspannen en loslaten’ beginnen de bovenbenen onstuimig te trillen. „Enjoy the pain” roept Nicole."
                            }
