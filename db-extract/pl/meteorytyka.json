                "senses": [
                    {
                        "sense_id": "c3f068dd-a706-3ae0-8cec-e03e4f97bf9d",
                        "entry_id": "c1999e7d-6dcd-38a8-bcab-baf12ba02eb6",
                        "glosses": [
                            "nauka o meteorytach i związanych z nimi zjawiskach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb1e268-a8bb-4d3b-be60-2adb5c1c4b3c",
                                "sense_id": "c3f068dd-a706-3ae0-8cec-e03e4f97bf9d",
                                "text": "W połowie bieżącego wieku meteorytyka, czyli nauka o meteorytach, przekształciła się w odrębną gałąź wiedzy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19d414e6-bcc9-40f5-ab5a-b0905dc6a660",
                        "source_entry_id": "c1999e7d-6dcd-38a8-bcab-baf12ba02eb6",
                        "source_sense_id": "c3f068dd-a706-3ae0-8cec-e03e4f97bf9d",
                        "target_lang_word": "meteoritics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meteoritics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf907f8-27fe-3586-8e40-6df93fcd2790",
                                        "entry_id": "738210e3-ea40-3149-ba94-4e7546bd572e",
                                        "glosses": [
                                            "The science that deals with meteors, meteorites, and meteoroids."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2487b01f-01bf-4300-960c-7e67a6526c49",
                                                "sense_id": "4bf907f8-27fe-3586-8e40-6df93fcd2790",
                                                "text": "From the beginning of the nineteenth century forward, meteoritics progressed steadily to an exacting and highly interdisciplinary field."
                                            },
                                            {
                                                "example_id": "24f4e1ae-91ca-482a-a882-894b164d23f4",
                                                "sense_id": "4bf907f8-27fe-3586-8e40-6df93fcd2790",
                                                "text": "Following the precedents set in previous editions of the Catalogue of Meteorites, it is not the intention of this Introduction to discuss the science of meteoritics, but simply to provide a summary of the nomenclature and classification of meteorites and the system of entries adopted."
                                            },
                                            {
                                                "example_id": "6eaded7b-c639-43dc-9ce5-a8ce148a983d",
                                                "sense_id": "4bf907f8-27fe-3586-8e40-6df93fcd2790",
                                                "text": "Meteoritics, the laboratory study of meteorites, was regarded as our best window on events at the time of the origin of the planets even before their age could be measured.[…]Recently, discoveries in both meteoritics and asteroid research have brought forward several interesting connections with comets, and even the Voyager revelation of the nature of ice-rich satellites has influenced our understanding of meteorite origins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
