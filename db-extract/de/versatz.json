                ],
                "senses": [
                    {
                        "sense_id": "b2b55cd8-690e-3802-9727-2bf361a3f0f3",
                        "entry_id": "45080955-cb76-3c1b-b207-ed354a01c2a1",
                        "glosses": [
                            "Verpfänden eines Gegenstands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82537b9f-d4eb-4570-9aac-532b3fa90313",
                                "sense_id": "b2b55cd8-690e-3802-9727-2bf361a3f0f3",
                                "text": "„Eine Wiener Kundschaft hatte die drei Stücke dem hiesigen Kaufmanne Adolph Bettelheim um 1500 fl. in Versatz gegeben – […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "07335548-4107-3452-a8d1-e6b216b2db81",
                        "entry_id": "45080955-cb76-3c1b-b207-ed354a01c2a1",
                        "glosses": [
                            "Material zum Verfüllen nicht mehr gebrauchter Stollen oder Flöze"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "c105b5c9-1e9b-45c5-ab73-d7d94d9a601c",
                                "sense_id": "07335548-4107-3452-a8d1-e6b216b2db81",
                                "text": "„Schon in den 1940er Jahren war der Barbarastollen nach knapp 170 m durch eingebrochenen Versatz verschüttet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c220f593-13d5-3d76-bbaf-c50f1b411d54",
                        "entry_id": "45080955-cb76-3c1b-b207-ed354a01c2a1",
                        "glosses": [
                            "(plötzliche) Verschiebung"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "72d23f30-2abf-4a38-add5-b81c94aac079",
                                "sense_id": "c220f593-13d5-3d76-bbaf-c50f1b411d54",
                                "text": "„Am Rand des Japan-Grabens betrug der Versatz von Teilen der Erdkruste sogar über 50 Meter.“"
                            },
                            {
                                "example_id": "43661a52-49e2-4470-9bbb-9701f691602c",
                                "sense_id": "c220f593-13d5-3d76-bbaf-c50f1b411d54",
                                "text": "„Sie ergaben einen diagonalen Versatz des Gebäudes, um den Ankommenden in einem einladenden Hof zu empfangen und von beiden Richtungen in das Gebäude einzulassen.“"
                            },
                            {
                                "example_id": "2ac9f864-b9ce-4be2-99d9-c80615866f9d",
                                "sense_id": "c220f593-13d5-3d76-bbaf-c50f1b411d54",
                                "text": "„Ein solcher Versatz liegt vor, wenn die auf dem Testglas abgeschiedene Schichtdicke größer ist als auf der Substratkalotte.“"
                            },
                            {
                                "example_id": "2be53140-74c1-489b-9f30-8f62f6a0bc50",
                                "sense_id": "c220f593-13d5-3d76-bbaf-c50f1b411d54",
                                "text": "„Die Schwarzjura-Schichten nahe der Störung sind deutlich vom Versatz auf der Störung betroffen.“"
                            },
                            {
                                "example_id": "34531d1b-305c-4d23-b721-9d79cf3b9c83",
                                "sense_id": "c220f593-13d5-3d76-bbaf-c50f1b411d54",
                                "text": "„Ein Mauerziegelverband beschreibt eine feste Anordnung von Steinen durch Versatz der Stoßfugen, um eine höhere Stabilität der Mauer zu gewährleisten.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "b149b921-70b9-3404-800f-e45f2c933fff",
                        "entry_id": "45080955-cb76-3c1b-b207-ed354a01c2a1",
                        "glosses": [
                            "(plötzliche) Verschiebung",
                            "Ein- oder Ausrückung eines gedruckten Objekts"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "fe20816e-db3a-43e0-a2d8-90d165a0de82",
                                "sense_id": "b149b921-70b9-3404-800f-e45f2c933fff",
                                "text": "„Ein Versatz verschiebt den Text im Rahmen.“"
                            },
                            {
                                "example_id": "fea60481-1d99-482f-99d2-f48065871d35",
                                "sense_id": "b149b921-70b9-3404-800f-e45f2c933fff",
                                "text": "„Legen Sie die Stärke oder Breite der Linie größer an und erhöhen Sie den Versatz, bis die Linie bzw. der Rahmen an der gewünschten Position sitzt.“"
                            },
                            {
                                "example_id": "5510a4ba-4d18-47e6-b594-ccddb187d05c",
                                "sense_id": "b149b921-70b9-3404-800f-e45f2c933fff",
                                "text": "„Sie sollte möglichst nicht geneigt werden, damit kein Versatz der Einzelbilder nach oben oder unten entsteht.“"
                            },
                            {
                                "example_id": "e2b19b32-7feb-4111-a106-12ef5f0959b7",
                                "sense_id": "b149b921-70b9-3404-800f-e45f2c933fff",
                                "text": "„Zusätzlich zur Seite, auf die der verankerte Rahmen plaziert werden soll, kann bei diesen vier Einstellungen ein Versatz und ein seitlicher Abstand vorgegeben werden.“"
                            },
                            {
                                "example_id": "9fdd9580-2df3-4ed7-b753-a1bff8cc0544",
                                "sense_id": "b149b921-70b9-3404-800f-e45f2c933fff",
                                "text": "„Um den Text besser im Rahmen anzuordnen, können Sie einen inneren Versatz definieren.“"
                            }
                        ],
                        "sense_index_json": "\"3a\""
                    }
