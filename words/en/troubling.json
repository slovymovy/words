                    "sense_definition": "present participle and gerund of <w>trouble</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry for <w>troubling</w> you with my personal problems so late at night.",
                            "target_lang_translations": {
