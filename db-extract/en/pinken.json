                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a5426a8-d1ed-4525-bef6-c7767d22e635",
                                                "sense_id": "fa40f796-bf70-34ed-963d-1915467aec93",
                                                "text": "Il serra la patte velue du comte qui sembla réveillé par sa venue, et baisa la main de la comtesse dont la joue d'ivoire rosit un peu, et dont les paupières eurent un tressaillement."
                                            },
                                            {
                                                "example_id": "a831f579-f532-443f-9f70-c9fa7f5549c9",
                                                "sense_id": "fa40f796-bf70-34ed-963d-1915467aec93",
                                                "text": "— Oh ! docteur, je n’ai pas fait exprès, murmura Henri en rosissant."
                                            },
                                            {
                                                "example_id": "169959cb-da3c-4398-abd2-c47aeff13ef5",
                                                "sense_id": "fa40f796-bf70-34ed-963d-1915467aec93",
                                                "text": "Les joues de Pierrot Bernard rosissaient de satisfaction."
                                            }
                                        ]
                                    },
