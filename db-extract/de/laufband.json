                        "form": "die Laufbänder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ecef8d52-5f86-39d7-a01c-aab2a5312e74",
                        "entry_id": "1618872a-9126-3b14-a52d-692b303c6e37",
                        "glosses": [
                            "motorbetriebenes Fitnessgerät mit einem endlosen, umlaufenden Band, auf dem Personen gehen oder laufen, ohne sich dabei räumlich fortzubewegen"
                        ],
                        "tags": [
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "a59f5dcb-790d-4f9e-a647-3e40985d8061",
                                "sense_id": "ecef8d52-5f86-39d7-a01c-aab2a5312e74",
                                "text": "Ich habe gestern auf dem Laufband einen richtigen Workout absolviert."
                            },
                            {
                                "example_id": "eab7c542-9ddc-4f2b-ab89-ad1ebbc48c3b",
                                "sense_id": "ecef8d52-5f86-39d7-a01c-aab2a5312e74",
                                "text": "„Während ich auf dem Laufband stand und meine Kilometer runterspulte, saß Francesco an der Saftbar und versuchte, Frauen anzusprechen."
                            },
                            {
                                "example_id": "a1fbdb73-6c47-472f-a7b0-fb786f91bc3a",
                                "sense_id": "ecef8d52-5f86-39d7-a01c-aab2a5312e74",
                                "text": "„Statt den geplanten wenigen Minuten auf dem Laufband endete es damit, dass sie rannte, bis ihr der Schweiß von der Stirne floss, und erst wieder aufhörte, als sie kaum noch Luft bekam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "50da081e-1ace-343c-8c9d-6a49e7270720",
                        "entry_id": "1618872a-9126-3b14-a52d-692b303c6e37",
                        "glosses": [
                            "Fahrsteig; ein der Rolltreppe ähnliches Personenbeförderungsmittel, bei dem die einzelnen Metallsegmente keine Treppe bilden, sondern in horizontaler Bauweise ausgeführt sind"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "babfa250-c154-46d2-b053-cd3f1a244633",
                                "sense_id": "50da081e-1ace-343c-8c9d-6a49e7270720",
                                "text": "Auf Flughäfen benutze ich gerne die Laufbänder."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "332fec9e-43d8-3896-aff8-ec58949e08b8",
                        "entry_id": "1618872a-9126-3b14-a52d-692b303c6e37",
                        "glosses": [
                            "Förderband; endloses mechanisch angetriebenes Band zum Transport von Gütern"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3265c331-e9d6-4b7c-9cdd-9d0af98656f7",
                                "sense_id": "332fec9e-43d8-3896-aff8-ec58949e08b8",
                                "text": "Die Pakete werden über Laufbänder geleitet, die hoch oben unter der Decke entlangführen."
                            },
                            {
                                "example_id": "5d7ee03f-dc68-48a6-9f56-3d7a2e12e234",
                                "sense_id": "332fec9e-43d8-3896-aff8-ec58949e08b8",
                                "text": "„Viele Fluggäste hatten bereits ihr Gepäck vom Laufband gefischt und waren auf dem Weg zum Parkplatz oder zu den Taxiständen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb732ac3-2996-4fa3-b3ac-9a0cf2c74872",
                        "source_entry_id": "1618872a-9126-3b14-a52d-692b303c6e37",
                        "source_sense_id": "ecef8d52-5f86-39d7-a01c-aab2a5312e74",
                        "source_sense_description": "Sport: Sportgerät, auf dem man sich laufend körperlich betätigt",
                        "target_lang_word": "treadmill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treadmill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5260e641-c637-3fbd-af0d-5327e35d295e",
                                        "entry_id": "13da0a8d-dd29-361c-9997-48102a58f3c3",
                                        "glosses": [
                                            "A piece of indoor sporting equipment used to allow for the motions of running or walking while staying in one place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "145ffe15-eeab-3a12-8222-5dd718ffefc6",
                                        "entry_id": "13da0a8d-dd29-361c-9997-48102a58f3c3",
                                        "glosses": [
                                            "A mill worked by persons treading upon steps on the periphery of a wide wheel having a horizontal axis. It was used principally as a means of prison discipline."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "143c6f24-37ea-4649-a0e4-31172737bf10",
                                                "sense_id": "145ffe15-eeab-3a12-8222-5dd718ffefc6",
                                                "text": "Their paternal house of Drummington, Foker could very seldom be got to visit. He swore he had rather go on the treadmill than stay there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ee1f2ce-afb8-37d9-a6db-2b5cb9f3b0f5",
                                        "entry_id": "13da0a8d-dd29-361c-9997-48102a58f3c3",
                                        "glosses": [
                                            "A mill worked by horses, dogs, etc., treading an endless belt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b79b3d8a-eb24-47f2-a952-187d0a1e3cd1",
                                                "sense_id": "9ee1f2ce-afb8-37d9-a6db-2b5cb9f3b0f5",
                                                "text": "Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame. With more settled people, animals were harnessed to capstans or caged in treadmills to turn grist into meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd1c2911-db04-3c78-ba2d-4140c011c1b9",
                                        "entry_id": "13da0a8d-dd29-361c-9997-48102a58f3c3",
                                        "glosses": [
                                            "A process or situation in which continued effort leads to or is required for remaining at a particular state or level without moving ahead."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a63f32b5-3b24-4e0a-837c-9741e06340e5",
                                                "sense_id": "cd1c2911-db04-3c78-ba2d-4140c011c1b9",
                                                "text": "1 As a result, people can easily find themselves alternating between various treadmills: the hedonic treadmill of pursuing happiness, the status treadmill requiring conspicuous consumption, and the treadmill of work undertaken to finance one's activity on the other two treadmills."
                                            },
                                            {
                                                "example_id": "3a90224e-3294-41d0-951d-1e401770824d",
                                                "sense_id": "cd1c2911-db04-3c78-ba2d-4140c011c1b9",
                                                "text": "Elizabeth Schor (1999) has long argued that this status treadmill, even if not universal, has worked to “ratchet” global conceptualizations of need and desire upward over time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "treadmill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a14beeb6-3759-3134-b621-cff2d17498ee",
                                        "entry_id": "d98c9192-1462-395d-b9b7-15b0230632f3",
                                        "glosses": [
                                            "To exercise on a treadmill."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d408e7b7-db7d-3b3a-b394-a3eb3c3df15e",
                                        "entry_id": "d98c9192-1462-395d-b9b7-15b0230632f3",
                                        "glosses": [
                                            "To keep busy, for example with work or with other tasks, without being able to get ahead or make progress towards long-term goals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e69336b-8ecd-443f-be54-b005a059bdbc",
                                                "sense_id": "d408e7b7-db7d-3b3a-b394-a3eb3c3df15e",
                                                "text": "Most of us are so busy \"earning each day our daily bread\" that we have but little \"open\" time. […] Occasionally one wonders \"What's it all for, anyway?\" For years he's been treadmilling it, day in and day out, and presently the graying hair at the temples will shock him into the grim reality that he is getting old—and getting little else."
                                            },
                                            {
                                                "example_id": "e64ecc4e-aa22-4330-b7ad-58075d020b03",
                                                "sense_id": "d408e7b7-db7d-3b3a-b394-a3eb3c3df15e",
                                                "text": "Back we were in the rat race, treadmilling sixty hours a week and sleeping forty, our sex life was like that of most busy cohabiters I suppose: fun, frolicky, and squeezed in haphazardly when we had a minute—or thirty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
