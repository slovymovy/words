        "ru-extract.jsonl": [
            {
                "entry_id": "7ebba3b7-e301-3f87-a550-b456311915a1",
                "word": "ошибочно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                        "entry_id": "7ebba3b7-e301-3f87-a550-b456311915a1",
                        "glosses": [
                            "неверно, неправильно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdab0d83-17b0-4ea0-a530-29c221af7d04",
                                "sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                                "text": "— Это простое и вероятное объяснение наверняка ошибочно: судя по законам психики, все гораздо сложнее, — закончила Родис дискуссию."
                            },
                            {
                                "example_id": "48df8df9-1d51-4462-ab15-cf0eb863c28a",
                                "sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                                "text": "В корне ошибочно."
                            },
                            {
                                "example_id": "97e969a9-e4ca-440e-a803-01087e9ddf48",
                                "sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                                "text": "Первое впечатление ошибочно."
                            },
                            {
                                "example_id": "c1983026-b8a4-451e-8eee-004d5512dc09",
                                "sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                                "text": "Но ничто не могло быть более ошибочно, чем это впечатление: он был беспощаден, неподкупен и принципиален."
                            },
                            {
                                "example_id": "a0886700-ce9d-40ca-8bc3-efccd3fd3cb2",
                                "sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                                "text": "Многие ошибочно думают, что вообще колонии, и в том числе Капская, доходами своими обогащают британскую казну; напротив, последняя сама должна была тратить огромные суммы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a9a6630-f9ce-4877-915b-f485c8cc2d23",
                        "source_entry_id": "7ebba3b7-e301-3f87-a550-b456311915a1",
                        "source_sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                        "target_lang_word": "by mistake",
