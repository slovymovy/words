                    },
                    {
                        "translation_id": "fe3b50fa-2f21-472e-9f56-42a8549e464d",
                        "source_entry_id": "ad2a4bbf-8952-31e4-ad0f-54cbdc9eae4a",
                        "target_lang_word": "agouti",
                        "target_lang_code": "en",
