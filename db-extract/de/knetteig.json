                "senses": [
                    {
                        "sense_id": "1a2ec9e7-c45f-3969-8525-0ce8f8292cd9",
                        "entry_id": "cd3be733-e6c4-3ee7-aa2e-1f263c85131a",
                        "glosses": [
                            "viel Zucker, Mehl und Fett und wenig Wasser enthaltender, fester Teig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab3828b-38e9-4acc-a80b-e6baa3f8daca",
                                "sense_id": "1a2ec9e7-c45f-3969-8525-0ce8f8292cd9",
                                "text": "„Wenn der Knetteig bei der Zubereitung bricht, fehlt meistens Flüssigkeit. Drücken Sie dann den Teig so zusammen, dass in der Mitte eine Vertiefung entsteht. In diese etwas Milch oder Wasser geben und […]“"
                            },
                            {
                                "example_id": "ec7e065e-0fd4-4059-9dd9-e00659c3accb",
                                "sense_id": "1a2ec9e7-c45f-3969-8525-0ce8f8292cd9",
                                "text": "„Sie erhalten einen glatten, elastischen Knetteig. Lassen Sie den Teig für mindestens eine 1⁄2 bis 1 Stunde im Kühlschrank ruhen.“"
                            },
                            {
                                "example_id": "d0cba0c5-ed82-4d88-bf74-f62563a8a2d4",
                                "sense_id": "1a2ec9e7-c45f-3969-8525-0ce8f8292cd9",
                                "text": "„Backpulver eignet sich für Rühr- und Knetteige, die nicht lange ruhen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
