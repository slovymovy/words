                                    {
                                        "sense_id": "bb8d07e6-409d-35b0-ad8f-d8fab75aeb80",
                                        "entry_id": "4d840a8c-ee0f-3002-a25d-ecef982d0b54",
                                        "glosses": [
                                            "In a childish manner."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae64c7eb-ee0c-4faf-9626-a1feb81d14de",
                                                "sense_id": "bb8d07e6-409d-35b0-ad8f-d8fab75aeb80",
                                                "text": "I knew, of course, it was but an innocent game on her part, a bit of backfisch foolery in imitation of some simulacrum of fake romance, and since (as the psychotherapist, as well as the rapist, will tell you) the limits and rules of such girlish games are fluid, or at least too childishly subtle for the senior partner to grasp—I was dreadfully afraid I might go too far and cause her to start back in revulsion and terror."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "296b4cae-fb7f-4a43-877a-71652d63dd7f",
                        "source_entry_id": "c24ea881-2606-311d-adff-237677730dcd",
                        "source_sense_id": "376d6ddf-bed2-3f64-8456-718184d87a80",
                        "target_lang_word": "puerilely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puerilely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "864bd76b-fa6c-3d2b-b508-5cb1104a03b3",
                                        "entry_id": "25197c95-aff7-31b5-9dbf-4a6849d00853",
                                        "glosses": [
                                            "In a puerile manner; childishly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867d4a93-a4ca-45b5-8acc-23aa12f0c8a8",
                                                "sense_id": "864bd76b-fa6c-3d2b-b508-5cb1104a03b3",
                                                "text": "If you find the idea that mothers shape their children’s “whole” lives original rather than simultaneously banal and puerilely overstated, then Barnes & Noble, here you come!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ce58678-7ecb-4fe3-8ba9-486e8f496964",
                        "source_entry_id": "c24ea881-2606-311d-adff-237677730dcd",
                        "source_sense_id": "376d6ddf-bed2-3f64-8456-718184d87a80",
                        "target_lang_word": "sillily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sillily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4555398f-4058-39ce-9590-6b2a341e34a4",
                                        "entry_id": "ec69c594-07f1-3a7d-9708-50bd8fbbdbf3",
                                        "glosses": [
                                            "In a silly manner; foolishly."
                                        ],
                                        "tags": [
                                            "dated",
                                            "hypercorrect"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57301c90-13a4-48a6-8b88-0bda07f22107",
                                                "sense_id": "4555398f-4058-39ce-9590-6b2a341e34a4",
                                                "text": "The man walked down the street so sillily that many a bystander stopped and stared slack-jawed."
                                            },
                                            {
                                                "example_id": "51ae79a0-412f-4190-b3b2-8297f32d6491",
                                                "sense_id": "4555398f-4058-39ce-9590-6b2a341e34a4",
                                                "text": "It was a fish-trap—just a ring of reeds set up in the water with only one little opening in it, and in this opening, just below the water, were stuck reeds slanting the way of the river's flow, so that the fish, when they had swum sillily in, sillily couldn't get out again."
                                            },
                                            {
                                                "example_id": "eae69aa3-451d-4ce1-a854-a5deefd1e440",
                                                "sense_id": "4555398f-4058-39ce-9590-6b2a341e34a4",
                                                "text": "Even 'Che Isa [...] had behaved sillily, making up to married men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
