                                        "entry_id": "fbc0e6b4-4888-3245-9a6b-f4b05767af89",
                                        "glosses": [
                                            "Any very ravenous, rapacious, or destructive person or thing; especially, want; starvation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d481f6a-3436-4e27-b397-eb3ad6dbb371",
                                                "sense_id": "7e3658b4-42cb-3948-b7d8-253311bb4656",
                                                "text": "They toiled hard to keep the wolf from the door."
                                            },
                                            {
                                                "example_id": "3ff0bd8b-81c7-48de-a321-c7627dde406d",
                                                "sense_id": "7e3658b4-42cb-3948-b7d8-253311bb4656",
                                                "text": "the bee wolf"
