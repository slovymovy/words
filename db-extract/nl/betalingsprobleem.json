                            {
                                "example_id": "5c21974d-4d75-44cc-92f6-1056d4a46415",
                                "sense_id": "82e0d0d9-78f9-3f15-8933-660b50cce844",
                                "text": "Het komt er volgens de rechter op neer dat de gemeente óp veel vage en onvoldoende gronden heeft gemeend haar betalingsverplichtingen te kunnen opschorten'aan een bedrijf dat daardoor in betalingsproblemen is gekomen."
                            },
                            {
                                "example_id": "12b135bc-c3fa-4de9-89e9-35ba63aae2c7",
                                "sense_id": "82e0d0d9-78f9-3f15-8933-660b50cce844",
                                "text": "Ook de aflossingsverplichtingen op studieschulden worden volgens de onderzoekers vaak overschat. De helft gaf aan daar geen rekening mee te houden bij de berekening van de maandelijkse lasten. \"Het verzwijgen van een studieschuld kan later tot betalingsproblemen leiden,\"waarschuwt directeur Rob Mulder van VEH."
                            }
