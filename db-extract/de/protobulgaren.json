                        "glosses": [
                            "Mitglieder eines der turksprachigen Nomadenstämme aus Zentralasien (um 600)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "465c28f4-6445-44e5-91db-918a8d97aeb9",
                                "sense_id": "a28dc522-7194-3663-9853-fc59d18e9a11",
                                "text": "„Zu Beginn des 9. Jahrhunderts expandierte das Reich der Protobulgaren unter ihrem Anführer, Khan Krum.“"
                            },
                            {
                                "example_id": "9e364c2c-9241-4619-88e4-77020aaee608",
                                "sense_id": "a28dc522-7194-3663-9853-fc59d18e9a11",
                                "text": "„Zuvor bewohnten die Protobulgaren das sogenannte Onglos-Gebiet, das sich den zeitgenössischen Quellen zufolge zu beiden Ufern des untersten Donaulaufes erstreckte und von Norden und Süden von Erdwällen begrenzt wurde (Abb. 1).“"
                            }
                        ],
