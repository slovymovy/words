                "senses": [
                    {
                        "sense_id": "cbd74ad6-4208-34ea-b3af-0daa2b1e3dca",
                        "entry_id": "e5a73cb6-7a5a-3e58-a9df-07b36e07b2d9",
                        "glosses": [
                            "Se dit d’une phrase, d’un syntagme ou d’un mot qui se décrit lui-même"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8d55b9-9499-4019-a7cf-062cc76b94a6",
                                "sense_id": "cbd74ad6-4208-34ea-b3af-0daa2b1e3dca",
                                "text": "Les mots « bref » et « polysyllabique » sont autologiques, contrairement à « long » et « monosyllabique »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08dbfa4a-1f2e-444f-affd-fe10729fa61a",
                        "source_entry_id": "e5a73cb6-7a5a-3e58-a9df-07b36e07b2d9",
                        "source_sense_id": "cbd74ad6-4208-34ea-b3af-0daa2b1e3dca",
                        "target_lang_word": "autological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed476594-75d6-3cd9-8df2-37e69a538b99",
                                        "entry_id": "7c0a7d91-0547-37e6-9a72-ff95ba84e905",
                                        "glosses": [
                                            "Possessing the property it describes."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "phrase"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e7c76dd-709f-47aa-b62a-965e985aa643",
                                                "sense_id": "ed476594-75d6-3cd9-8df2-37e69a538b99",
                                                "text": "The word polysyllabic is autological, but the word monosyllabic is not."
                                            },
                                            {
                                                "example_id": "34f118b5-1d16-4398-ab37-f0c48bb63242",
                                                "sense_id": "ed476594-75d6-3cd9-8df2-37e69a538b99",
                                                "text": "Because the word short is in fact short, it is considered autological."
                                            },
                                            {
                                                "example_id": "97cf58f1-57c8-4d48-b7c2-f0dccc0c0800",
                                                "sense_id": "ed476594-75d6-3cd9-8df2-37e69a538b99",
                                                "text": "The word noun is itself a noun, and is thus autological."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce3c6c83-7b46-4912-a195-b41ba6181bd4",
                        "source_entry_id": "e5a73cb6-7a5a-3e58-a9df-07b36e07b2d9",
                        "source_sense_id": "cbd74ad6-4208-34ea-b3af-0daa2b1e3dca",
