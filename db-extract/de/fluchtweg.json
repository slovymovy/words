                    },
                    {
                        "form_id": "1adcd59a-6673-4599-86ee-d3dea7182d01",
                        "entry_id": "5b022a82-c728-3699-a705-38bd21f403da",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Fluchtweg"
                    },
                    {
                        "form_id": "fef499f5-d9a4-439c-8dbb-e667065ba032",
                        "entry_id": "5b022a82-c728-3699-a705-38bd21f403da",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fluchtwege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b39c7ea-3be8-3f58-9de1-749acf6c044c",
                        "entry_id": "5b022a82-c728-3699-a705-38bd21f403da",
                        "glosses": [
                            "festgelegter einzuschlagender sicherer Weg zur Flucht als Eigenrettung und gleichzeitig sicherer Zugang für die Fremdrettung durch Rettungskräfte, die im Notfall eine Rettung oder Befreiung aus einer Gefahrensituation gewährleisten sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "262c5b3a-b600-490d-9340-93c0b04d20b5",
                                "sense_id": "7b39c7ea-3be8-3f58-9de1-749acf6c044c",
                                "text": "„Fluchtwege sind Verkehrswege, an die besondere Anforderungen zu stellen sind und die der Flucht aus einem möglichen Gefährdungsbereich und in der Regel zugleich der Rettung von Personen dienen. Fluchtwege führen ins Freie oder in einen gesicherten Bereich. Fluchtwege im Sinne dieser Regel sind auch die im Bauordnungsrecht definierten Rettungswege, sofern sie selbstständig begangen werden können.“"
                            },
                            {
                                "example_id": "d094706a-8fbc-4c26-a8c4-915c3ecaaf7b",
                                "sense_id": "7b39c7ea-3be8-3f58-9de1-749acf6c044c",
                                "text": "„Hintergrund der Schließung der Wohnheime sind Mängel beim Brandschutz, die im Herbst bei einer Begehung durch die Feuerwehr festgestellt wurden. Ein zweiter Fluchtweg fehlt und die Treppenhäuser sind nicht rauchdicht.“"
                            },
                            {
                                "example_id": "3da55eb6-8212-4c41-8072-55258cd8e506",
                                "sense_id": "7b39c7ea-3be8-3f58-9de1-749acf6c044c",
                                "text": "„Denn Fluchtwege studieren sie äußerst genau und halten sie sich frei.“"
                            },
                            {
                                "example_id": "f3f0a1fa-9320-4d26-92f0-cc9c7e1374c3",
                                "sense_id": "7b39c7ea-3be8-3f58-9de1-749acf6c044c",
                                "text": "„Türen im Verlauf von Fluchtwegen und Notausstiege müssen sich leicht und ohne besondere Hilfsmittel öffnen lassen, solange Personen im Gefahrenfall auf die Nutzung des entsprechenden Fluchtweges angewiesen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5f7210d1-f9c1-3edf-852c-6d21cf706137",
                        "entry_id": "5b022a82-c728-3699-a705-38bd21f403da",
                        "glosses": [
                            "Weg, über den jemand geflohen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa95c43e-d075-4ba6-a363-6937ed375552",
                                "sense_id": "5f7210d1-f9c1-3edf-852c-6d21cf706137",
                                "text": "Ein Spürhund konnte den Fluchtweg der Diebe nachverfolgen."
                            },
                            {
                                "example_id": "d82b20ec-177e-4df3-a3f5-2904b2562877",
                                "sense_id": "5f7210d1-f9c1-3edf-852c-6d21cf706137",
                                "text": "„Sie hat mir ihren Fluchtweg mal so, mal so erzählt.“"
                            },
                            {
                                "example_id": "70d8d18c-e51f-40e5-867a-0c6628e23429",
                                "sense_id": "5f7210d1-f9c1-3edf-852c-6d21cf706137",
                                "text": "„Auf der Suche nach einem Fluchtweg öffnete er die Seitentüre zur Sakristei und versteckte sich in einem Beichtstuhl.“"
                            },
                            {
                                "example_id": "658f6fd2-3004-4a7b-95c8-532dc1b77060",
                                "sense_id": "5f7210d1-f9c1-3edf-852c-6d21cf706137",
                                "text": "„Niemand vermag all diese Menschen von ihren Fluchtwegen abzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c175d9a-9cb2-4a5b-bc76-3898e1b08603",
                        "source_entry_id": "5b022a82-c728-3699-a705-38bd21f403da",
                        "source_sense_id": "7b39c7ea-3be8-3f58-9de1-749acf6c044c",
                        "target_lang_word": "escape route",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escape route",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c702bd3-df1e-3fad-be3a-c5280715c60e",
                                        "entry_id": "cd9a54de-27c2-3d37-943f-0777a174b03d",
                                        "glosses": [
                                            "A path used by someone to escape from a dangerous place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1e4dde6-11e4-4d16-8718-c6fcaeb74fd6",
                                                "sense_id": "0c702bd3-df1e-3fad-be3a-c5280715c60e",
                                                "text": "In case of emergency, all personnel must follow the escape routes."
                                            },
                                            {
                                                "example_id": "fae942df-54ac-4edc-af84-f30532cac1ab",
                                                "sense_id": "0c702bd3-df1e-3fad-be3a-c5280715c60e",
                                                "text": "The UN estimates that 368,000 people have already fled from Ukraine into neighbouring countries in recent days, and for many the train remains the most reliable escape route, not least to Przemyśl, the first station in Poland across the border."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7abc3083-c7b5-3b31-9f4a-cf6c920a6d90",
                                        "entry_id": "cd9a54de-27c2-3d37-943f-0777a174b03d",
                                        "glosses": [
                                            "A way out of a difficult or unpleasant situation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff5de7a-98c1-4781-88d4-42e03aee6548",
                                                "sense_id": "7abc3083-c7b5-3b31-9f4a-cf6c920a6d90",
                                                "text": "Success was a laugh for Dizzee, but it was also his escape route from a tense upbringing: he was expelled from four schools and often ran into trouble; shortly after winning the Mercury prize in 2003, he was stabbed by a rival crew member in Ayia Napa. Now, suddenly, he could travel freely, support his family, make a difference in people’s lives with his music."
                                            },
                                            {
                                                "example_id": "c3e00081-e440-40a6-9c66-0dec9cabbb47",
                                                "sense_id": "7abc3083-c7b5-3b31-9f4a-cf6c920a6d90",
                                                "text": "Books and stories have always been my escape route from busy London life. As a child I was often found reading – in a corner at home in Battersea, or in the library, on a bus, or the back of a car, drifting into the lives of others for hours on end, with only the act of turning the page occasionally jolting me back into reality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
