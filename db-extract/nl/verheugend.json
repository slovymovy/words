                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "47d27436-3f52-3528-8481-046ebab574ba",
                        "entry_id": "f6aa88ec-f812-37a8-ba2f-aaa33eec369a",
                        "glosses": [
                            "blij makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7856dde-d9a4-421f-93d8-12df9c012af6",
                                "sense_id": "47d27436-3f52-3528-8481-046ebab574ba",
                                "text": "Het gaat weer de goede kant op met de christelijke muziekvereniging Crescendo. Met die verheugende boodschap kwam het bestuur in de jaarvergadering. Financieel staat de vereniging er weer goed voor, zo bleek uit de jaarcijfers."
                            },
                            {
                                "example_id": "af9ce392-f7b2-4c88-a357-1023ad834e36",
                                "sense_id": "47d27436-3f52-3528-8481-046ebab574ba",
                                "text": "Op een aantal plekken zoals bijvoorbeeld bij de Leemansmolen, kwamen veel jonge gezinnen met kinderen. \"Een verheugende ontwikkeling\", stellen de organisatoren van het Comité Open Monumentendag Twenterand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ac50811-835b-467b-8568-1b82e32e924a",
                        "source_entry_id": "f6aa88ec-f812-37a8-ba2f-aaa33eec369a",
                        "source_sense_id": "47d27436-3f52-3528-8481-046ebab574ba",
                        "source_sense_description": "bij makend",
                        "target_lang_word": "joyful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joyful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7e5b3c9-325b-3b09-bca7-c44fdaa37e0b",
                                        "entry_id": "22b3addb-6cc8-3520-ae8f-af65e94c258b",
                                        "glosses": [
                                            "Feeling or causing joy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ff3db83-f5d7-4d50-9c78-7cd77270e4f0",
                                                "sense_id": "b7e5b3c9-325b-3b09-bca7-c44fdaa37e0b",
                                                "text": "The children were joyful on the first day of summer break."
                                            },
                                            {
                                                "example_id": "df8fc50d-ac32-4f18-805e-73bbbe040d4e",
                                                "sense_id": "b7e5b3c9-325b-3b09-bca7-c44fdaa37e0b",
                                                "text": "Her joyful smile lit up the room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be3fd516-24e0-451a-8031-44eb07f6916b",
                        "source_entry_id": "f6aa88ec-f812-37a8-ba2f-aaa33eec369a",
                        "source_sense_id": "47d27436-3f52-3528-8481-046ebab574ba",
