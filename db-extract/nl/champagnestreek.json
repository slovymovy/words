                        "examples": [
                            {
                                "example_id": "ae0a0c9b-a6a5-4b7c-b0c5-37104a067c07",
                                "sense_id": "c89aa2e5-af2c-3077-a551-50eaddc857dc",
                                "text": "Zelfs een beschermde Europese status van champagne kan budgetsuper Aldi waarschijnlijk niet weerhouden van de verkoop van champagnesorbetijs. Het Europees Hof heeft vandaag bepaald dat 'Champagner Sorbet', met 12 procent champagne, gewoon zo mag heten, zolang het enigszins smaakt naar de luxe bubbelwijn uit de Champagnestreek."
                            },
                            {
                                "example_id": "770d178d-e61c-4fdc-ad19-7d19c222da13",
                                "sense_id": "c89aa2e5-af2c-3077-a551-50eaddc857dc",
                                "text": "Alaphilippe vierde zijn ritzege en gele trui op de parkeerplaats van het hotel met champagne. Dat had ook nauwelijks anders gekund na een overwinning in Épernay, de hoofdstad van de champagnestreek."
                            },
                            {
                                "example_id": "d7a4052f-89d7-4db2-bee9-b61ee9dea185",
                                "sense_id": "c89aa2e5-af2c-3077-a551-50eaddc857dc",
                                "text": "Op de achterkant van de flessen zal in het Russisch ‘schuimwijn’ gedrukt staan, weliswaar met de vermelding dat de wijn uit de Franse champagnestreek komt."
                            }
                        ]
