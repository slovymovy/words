                            }
                        },
                        {
                            "text": "Doświadczenie życiowe <w>czyni</w> go mądrzejszym i bardziej wyrozumiałym człowiekiem.",
                            "target_lang_translations": {
                                "en": "Life experience <w>makes</w> him a wiser and more understanding person."
                            }
