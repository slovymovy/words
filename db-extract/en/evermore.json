                                                "sense_id": "d5defadb-4a47-3844-98e9-9c195523f9e5",
                                                "text": "Zawsze niech będzie słońce, zawsze niech będzie niebo, zawsze niech będzie mama, zawsze niech będę ja!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
