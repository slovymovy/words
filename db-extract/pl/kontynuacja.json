                                    {
                                        "sense_id": "121cc04b-840c-3845-ab6b-7440eda2d790",
                                        "entry_id": "82ddece0-4989-3ea5-b320-352117e5ab27",
                                        "glosses": [
                                            "The act or state of continuing or being continued; uninterrupted extension or succession"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb76ec63-9264-3fec-9d8c-e736b071c0cb",
                                        "entry_id": "82ddece0-4989-3ea5-b320-352117e5ab27",
                                        "glosses": [
                                            "That which extends, increases, supplements, or carries on."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cdb2635-3a0e-41e1-af95-37828ffc251e",
                                                "sense_id": "eb76ec63-9264-3fec-9d8c-e736b071c0cb",
                                                "text": "the continuation of a story"
                                            },
                                            {
                                                "example_id": "115c6f1f-dc6d-448f-9991-703435722bc8",
                                                "sense_id": "eb76ec63-9264-3fec-9d8c-e736b071c0cb",
                                                "text": "The series' continuation was commercially if not artistically successful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceaeabf5-86be-394e-a21b-b8d42a9ad346",
                                        "entry_id": "82ddece0-4989-3ea5-b320-352117e5ab27",
                                        "glosses": [
                                            "A representation of an execution state of a program at a certain point in time, which may be used at a later time to resume the execution of the program from that point."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f009211b-9755-4435-bc9c-1087091989ce",
                                                "sense_id": "ceaeabf5-86be-394e-a21b-b8d42a9ad346",
                                                "text": "Whenever a Scheme expression is evaluated a continuation exists that wants the result of the expression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e097f73b-8db9-343b-bd1b-fb7ce11226f7",
                                        "entry_id": "82ddece0-4989-3ea5-b320-352117e5ab27",
                                        "glosses": [
                                            "A successful shot that, despite a foul, is made with a single continuous motion beginning before the foul, and that is therefore valid in certain forms of basketball."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "638e79b0-dbd8-4804-90ac-e034e0506030",
                        "source_entry_id": "edc6d802-daf6-3072-9ed3-86191750b128",
