                "senses": [
                    {
                        "sense_id": "65778ccc-8c24-353d-8fb6-acf07a8c8eb1",
                        "entry_id": "889ad496-1236-3202-a507-57a4321bd06c",
                        "glosses": [
                            "разг. ворочая, придвинуть, прислонить к чему-либо что-либо тяжелое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae158bf8-ac7b-4d88-a918-1761ed5df8dc",
                                "sense_id": "65778ccc-8c24-353d-8fb6-acf07a8c8eb1",
                                "text": "[Дерсу] продолжал укреплять свою палатку. Он забился под скалу, с одной стороны приворотил большой пень и обложил его камнями."
                            }
                        ]
                    },
                    {
                        "sense_id": "7be513b8-9263-382e-b391-8f4e35ff4295",
                        "entry_id": "889ad496-1236-3202-a507-57a4321bd06c",
                        "glosses": [
                            "разг. изогнув, повернув, приблизить к чему-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0e8ed9d3-fb05-34ff-8593-108b9a2064cd",
                        "entry_id": "889ad496-1236-3202-a507-57a4321bd06c",
                        "glosses": [
                            "разг. повернув, заставить приблизиться к чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6407c0fe-8434-4565-a807-8d9778be9a1a",
                                "sense_id": "0e8ed9d3-fb05-34ff-8593-108b9a2064cd",
                                "text": "Кузьма приворотил лошадь к пустому корыту."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4063bbc-1fe8-3479-a353-58c089f45f86",
                        "entry_id": "889ad496-1236-3202-a507-57a4321bd06c",
                        "glosses": [
