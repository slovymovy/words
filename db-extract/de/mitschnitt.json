                    {
                        "form_id": "0f76d578-7d0b-4234-a34f-2dd6c90f5063",
                        "entry_id": "179d7451-6e4f-3ce6-b0c6-b632fb89ea8f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mitschnitte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "650f71b0-fb29-32a6-9e84-41182df7d823",
                        "entry_id": "179d7451-6e4f-3ce6-b0c6-b632fb89ea8f",
                        "glosses": [
                            "Aufzeichnung eines akustischen und/oder optischen Ereignisses (beispielsweise einer Fernsehsendung, Radiosendung, eines Konzerts oder der heimlichen Aufzeichnung eines Telefonats)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e883cfae-e08e-440c-80a4-219722bbcadc",
                                "sense_id": "650f71b0-fb29-32a6-9e84-41182df7d823",
                                "text": "Roger Cicero singt Frank Sinatra. Mit dem Mitschnitt seiner Konzert-Huldigung an den US-Entertainer erobert der deutsche Jazz-Popper die Charts."
                            },
                            {
                                "example_id": "f836efba-d8c9-4330-ab51-16c6df744a35",
                                "sense_id": "650f71b0-fb29-32a6-9e84-41182df7d823",
                                "text": "Sie haben eine Sendung der DW verpasst? Wir bieten Ihnen Mitschnitte zu ausgewählten Sendungen für die private Nutzung an."
                            },
                            {
                                "example_id": "809e96eb-8911-47d7-a442-cefbb40c0317",
                                "sense_id": "650f71b0-fb29-32a6-9e84-41182df7d823",
                                "text": "Früher hatten wir kein Geld. Da mussten wir Mitschnitte von Radiosendungen auf Kassette machen."
                            },
                            {
                                "example_id": "980c6bae-7e91-43e2-8d7a-633db2f84b94",
                                "sense_id": "650f71b0-fb29-32a6-9e84-41182df7d823",
                                "text": "„Der Mitschnitt seines Notrufs gibt eine Ahnung, in welcher Panik sich der Mann befand.“"
                            },
                            {
                                "example_id": "52f61ec1-72c5-483c-ae5a-da7b764ca1ae",
                                "sense_id": "650f71b0-fb29-32a6-9e84-41182df7d823",
                                "text": "[Rechtsexperte Udo] Vetter plädiert … für den Mitschnitt jedes Strafprozesses - und sogar für die Vernehmungen bei der Polizei. Dies sei seiner Ansicht nach \"überfällig\"."
                            },
                            {
                                "example_id": "1f19e024-550f-4b05-8669-e21d2cf5fb59",
                                "sense_id": "650f71b0-fb29-32a6-9e84-41182df7d823",
                                "text": "Das Telefonat fand am 26. Februar statt …. Woher der Mitschnitt stammt und wer ihn veröffentlicht hat, ist unklar."
                            },
                            {
                                "example_id": "c54e54dc-76b3-41fc-a174-161f32235d7f",
                                "sense_id": "650f71b0-fb29-32a6-9e84-41182df7d823",
                                "text": "[Brasiliens] Präsident [Michel Temer] steht seit geraumer Zeit unter Korruptionsverdacht. Ausgelöst wird dieser Verdacht durch den Mitschnitt eines Gesprächs zwischen Temer und dem Besitzer des weltgrößten Fleischkonzerns JBS, Joesley Batista."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "534b96be-f91e-411d-a4f8-6fd54c7cae83",
                        "source_entry_id": "179d7451-6e4f-3ce6-b0c6-b632fb89ea8f",
                        "source_sense_id": "650f71b0-fb29-32a6-9e84-41182df7d823",
                        "target_lang_word": "recording",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recording",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0039a62b-bbab-31a3-a7ef-567353083510",
                                        "entry_id": "65c69e77-4211-3886-a0a6-91816a6e5490",
                                        "glosses": [
                                            "present participle and gerund of record"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0dca5d9-499c-4796-996b-bd945974e834",
                                                "sense_id": "0039a62b-bbab-31a3-a7ef-567353083510",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "recording",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca97bf6-a0e9-3372-82d2-af9f5bb4281a",
                                        "entry_id": "59ed8b04-a130-3416-9c56-1c54ada03477",
                                        "glosses": [
                                            "The act of storing sound, video, etc., in a permanent medium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e94a0df-4512-470e-a92c-fe93eafb3776",
                                                "sense_id": "4ca97bf6-a0e9-3372-82d2-af9f5bb4281a",
                                                "text": "The one-party consent law permits the recording of telephone calls with the consent of at least one of the parties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ccdb358-b1d9-3d98-a15d-1efa9ae207a9",
                                        "entry_id": "59ed8b04-a130-3416-9c56-1c54ada03477",
                                        "glosses": [
                                            "A reproduction of sound, video, etc., stored in a permanent medium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76b249a2-5377-4521-8739-a20b714ffb05",
                                                "sense_id": "3ccdb358-b1d9-3d98-a15d-1efa9ae207a9",
                                                "text": "I made a recording of the TV show so that I could watch it later."
                                            },
                                            {
                                                "example_id": "e14d1866-66c9-4175-aaaf-a2289fcb0755",
                                                "sense_id": "3ccdb358-b1d9-3d98-a15d-1efa9ae207a9",
                                                "text": "But, she says, a wartime ban on recordings using shellac and vinyl kept the Walker version from being released."
                                            },
                                            {
                                                "example_id": "b7e9988d-3dff-4a22-909a-c2f1aa120746",
                                                "sense_id": "3ccdb358-b1d9-3d98-a15d-1efa9ae207a9",
                                                "text": "The resulting integrated neurograms were then studied, and only the recordings with bursts that reached a signal:noise ratio of at least 3:1 were accepted for analysis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5bdfaa-5b1e-3539-ad4c-a1631eaf8c88",
                                        "entry_id": "59ed8b04-a130-3416-9c56-1c54ada03477",
                                        "glosses": [
                                            "The act of registering for something; registration."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "453c6e5b-f317-4770-afba-f02a97ffc20f",
                        "source_entry_id": "179d7451-6e4f-3ce6-b0c6-b632fb89ea8f",
