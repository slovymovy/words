    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6979e210-b973-343c-a7a3-4d93774da193",
                    "sense_definition": "Qui inspire l'effroi, la tristesse ou l'angoisse par son aspect sombre ou lugubre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aspect_inquietant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille maison abandonnée au bout du village avait une allure particulièrement <w>sinistre</w>."
                        },
                        {
                            "text": "Un silence <w>sinistre</w> régnait dans les couloirs obscurs du vieux château en ruine."
                        }
                    ],
                    "synonyms": [
                        "lugubre",
                        "sombre",
                        "inquiétant",
                        "angoissant"
                    ],
                    "antonyms": [
                        "joyeux",
                        "lumineux",
                        "rassurant"
                    ],
                    "common_phrases": [
                        "lueur sinistre",
                        "bruit sinistre",
                        "paysage sinistre"
                    ]
                },
                {
                    "sense_id": "1f02e5d8-2f9d-3cbc-823a-1987e9b3318f",
                    "sense_definition": "Qui annonce ou fait craindre de grands malheurs ; de mauvais augure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mauvais_augure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cri nocturne de cet oiseau était considéré par les villageois comme un <w>sinistre</w> présage."
                        },
                        {
                            "text": "Ces nuages noirs à l'horizon donnaient une tournure <w>sinistre</w> à notre expédition."
                        }
                    ],
                    "synonyms": [
                        "funeste"
                    ],
                    "antonyms": [
                        "faste",
                        "propice"
                    ],
                    "common_phrases": [
                        "présage sinistre",
                        "pressentiment sinistre"
                    ]
                }
            ]
        },
        {
