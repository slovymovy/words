                ],
                "senses": [
                    {
                        "sense_id": "4e559f23-9433-36ae-ae25-232157d1c385",
                        "entry_id": "024b7fd5-442d-39ea-9549-07381bd542ed",
                        "glosses": [
                            "widriger Umstand, Unzulänglichkeit, Missstand"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "b9a3e687-d175-40be-b382-5535990de5bd",
                                "sense_id": "4e559f23-9433-36ae-ae25-232157d1c385",
                                "text": "„Eine positive Zukunftsprognose könne dazu führen, dass die Klage abzuweisen ist, wenn ‚die Wiederholung der bisherigen Unzukömmlichkeiten ausgeschlossen werden kann‘.“"
                            },
                            {
                                "example_id": "1d8b9f58-5360-40e8-b51e-e9633d0349e2",
                                "sense_id": "4e559f23-9433-36ae-ae25-232157d1c385",
                                "text": "„[Brandstetter:] Ohne Beamte, und ohne die sonstigen Unzukömmlichkeiten bis hin zur Korruption.“"
                            },
                            {
                                "example_id": "97663975-8e73-4039-941d-7bfcd16ba37d",
                                "sense_id": "4e559f23-9433-36ae-ae25-232157d1c385",
                                "text": "„Zur wirksamen Abstellung dieser Unzukömmlichkeit ist von nun an der Sittenkalkul nur in einer Zusammentretung der sämmtlichen Professoren der Obligatstudien jedes Jahrganges unter der Leitung des Studien-Directors zu bestimmen.“"
                            },
                            {
                                "example_id": "634060b6-2280-4d36-b849-76ee8104b7ea",
                                "sense_id": "4e559f23-9433-36ae-ae25-232157d1c385",
                                "text": "„Freilich entsteht hieraus auf der andern Seite die Unzukömmlichkeit, daß auch der unter dem bestimmten Alter stehende, nach seinen Verstandeskräften bereits Zurechnungsfähige wegen eines Verbrechens nicht gestraft werden kann, wegen welchen er doch, wenn nicht die höchste Culturstufe bei Bestimmung des Alters zur Grundlage genommen seyn würde, bestraft worden wäre.“"
                            },
                            {
                                "example_id": "7958db3b-514b-4b8e-8f9c-c8c98784a2e2",
                                "sense_id": "4e559f23-9433-36ae-ae25-232157d1c385",
                                "text": "„Es hat sich gezeigt, dass die Information durch mehrere Stellen in solchen Fällen zu Unzukömmlichkeiten führt. Daher ist … die Information zentralisiert worden.“"
                            },
                            {
                                "example_id": "e4e1ed09-2881-4a42-bdb1-500fc3015000",
                                "sense_id": "4e559f23-9433-36ae-ae25-232157d1c385",
                                "text": "„Es würde zweifellos zu Unzukömmlichkeiten führen, wenn der suspendierte Direktor des Institutes –“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
