                                        "sense_id": "151f29be-a1a0-3ea2-93bb-2c147a660df5",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A hotel employee performing such duties for guests."
