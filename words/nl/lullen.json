                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die jongens gedragen zich als een stelletje <w>lullen</w> op het veld.",
                            "target_lang_translations": {
