            "senses": [
                {
                    "sense_id": "db38a726-3443-3c27-94e7-eb0232da30eb",
                    "sense_definition": "Simple past and past participle of <w>confine</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The authorities <w>confined</w> the wild animal to a secure cage.",
                            "target_lang_translations": {
                                "ru": "Власти <w>заперли</w> дикое животное в надежную клетку.",
                                "de": "Die Behörden <w>sperrten</w> das wilde Tier in einen sicheren Käfig."
                            }
                        },
                        {
                            "text": "He <w>confined</w> his remarks to the subject at hand.",
                            "target_lang_translations": {
                                "ru": "Он <w>ограничил</w> свои замечания обсуждаемой темой.",
                                "de": "Er <w>beschränkte</w> seine Anmerkungen auf das aktuelle Thema."
                            }
                        }
