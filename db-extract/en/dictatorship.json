                                    {
                                        "sense_id": "63412b8e-c5bb-381d-99e7-d317d6367e6f",
                                        "entry_id": "f58db645-cbb2-3221-9162-528be997a7d0",
                                        "glosses": [
                                            "vláda samovládce (diktátora) v římské republice"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e1078d-4127-406a-84c7-41069e2f90c4",
                                                "sense_id": "63412b8e-c5bb-381d-99e7-d317d6367e6f",
                                                "text": "Vzhledem k mimořádné koncentraci moci zanikala diktatura nejen dosažením cíle (např. porážkou nepřítele), ale i uplynutím relativně krátké lhůty: diktátor se po 6 měsících musel své funkce vzdát. Diktatura rovněž zanikala s koncem úřední lhůty konsula, který jmenování diktátora provedl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d66723bc-153d-386f-b8c5-2b15eb15843c",
                                        "entry_id": "f58db645-cbb2-3221-9162-528be997a7d0",
                                        "glosses": [
                                            "neomezená vláda jednotlivce"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dc51f2a-010c-4ec7-b09a-d678680f2b21",
                                                "sense_id": "d66723bc-153d-386f-b8c5-2b15eb15843c",
                                                "text": "Každá diktatura (i ta podniková nebo rodinná) je svým způsobem legrační. Tyranie svými každodenními i slavnostními projevy buď nedosahuje na míru lidské důstojnosti, nebo ji zbrkle překračuje ve snaze vytvářet cosi gigantického, nebývalého a neopakovatelného."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4c10188-1919-3dcf-8c00-53cfa988dd45",
                                        "entry_id": "f58db645-cbb2-3221-9162-528be997a7d0",
                                        "glosses": [
                                            "neomezená moc, ovládání diktátem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d1c2bd5-54ec-4bf4-8974-f1b0fc46d06b",
                                                "sense_id": "e4c10188-1919-3dcf-8c00-53cfa988dd45",
                                                "text": "Dlouhá diktatura komunistů se podepsala na vztahu obyvatelstva k církvi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b00adce4-3937-395d-a9cb-7ede32106ffa",
                                        "entry_id": "f58db645-cbb2-3221-9162-528be997a7d0",
                                        "glosses": [
                                            "stát ovládaný diktátorem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d4909c7-f12a-454f-84f6-869fa4bcb1d7",
                                                "sense_id": "b00adce4-3937-395d-a9cb-7ede32106ffa",
                                                "text": "Zvláštní diktatura Barma je dnes izolovaným, zaostalým ostrovem s padesáti miliony obyvatel uvězněných uprostřed bouřlivě se rozvíjejícího regionu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diktatura",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "746b10bd-e808-3fdc-9ae5-eaef7657aa4e",
                                        "entry_id": "20f2e480-282e-30e4-81c0-a2deca7b5fa3",
                                        "glosses": [
                                            "diktatura proletariátu"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ef59862-1c07-493f-95b4-a549bf396acf",
                        "source_entry_id": "ebbc96b6-426c-3a1c-9a07-6df5803d4cbb",
                        "source_sense_description": "a government led by a dictator",
                        "target_lang_word": "dictatuur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dictatuur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8f5ceb90-03d2-3dfb-b439-338606d62291",
                                        "entry_id": "7f78bc04-3259-3f3f-8417-d3ec9271f0e9",
                                        "glosses": [
                                            "staatsvorm waarbij de macht vrijwel volledig in handen van een of enkele personen ligt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f68dc8-78cf-491e-9850-9208a0ecb5ec",
                                                "sense_id": "8f5ceb90-03d2-3dfb-b439-338606d62291",
                                                "text": "“Dertien jaar na de invasie is Irak een verscheurd, verwoest en getraumatiseerd land. Van een snelle overgang van dictatuur naar democratie, zoals de Amerikaanse en Britse regering voorspelden, is niets terechtgekomen. In plaats daarvan is in Irak een meedogenloze machtsstrijd uitgebroken, die tot op de dag van vandaag voortduurt, en die heeft geleid tot opmars van de meest gevreesde terreurbeweging ter wereld: Islamitische Staat (IS).”"
                                            },
                                            {
                                                "example_id": "75da91a8-d349-422c-82b3-e358c1fe2837",
                                                "sense_id": "8f5ceb90-03d2-3dfb-b439-338606d62291",
                                                "text": "steeds meer Russen constateren dat ook zij gevangenen zijn - niet van granaatvuur, maar van een volwaardige dictatuur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc029ba5-43a6-390b-938d-0639be365db1",
                                        "entry_id": "7f78bc04-3259-3f3f-8417-d3ec9271f0e9",
                                        "glosses": [
                                            "meedogenloze overheersing"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5d6f404-c509-4ca1-abce-ca9df32924a0",
                                                "sense_id": "dc029ba5-43a6-390b-938d-0639be365db1",
                                                "text": "Brusselaars zijn de dictatuur van Koning Auto zat"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bccaac06-ba73-4dae-80e8-2e8bc8c2faec",
                        "source_entry_id": "ebbc96b6-426c-3a1c-9a07-6df5803d4cbb",
                        "source_sense_description": "a government led by a dictator",
                        "target_lang_word": "dictature",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dictature",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "843c2d74-3921-3426-9d55-707fa9a8459f",
                                        "entry_id": "d38b8946-768f-33c3-b559-586c60ede17f",
                                        "glosses": [
                                            "Dignité, pouvoir du dictateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8f575d3-f126-48d5-b0c4-b877a7ace67d",
                                                "sense_id": "843c2d74-3921-3426-9d55-707fa9a8459f",
                                                "text": "Sylla abdiqua la dictature. — La dictature, à Rome, n’était ordinairement conférée que pour six mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33c34e27-2393-34be-8471-9ae2f2d3e6d0",
                                        "entry_id": "d38b8946-768f-33c3-b559-586c60ede17f",
                                        "glosses": [
                                            "Temps pendant lequel s’exerce cette dignité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f320ca0b-adb3-49ad-ab03-08684d5e67fd",
                                                "sense_id": "33c34e27-2393-34be-8471-9ae2f2d3e6d0",
                                                "text": "Sous la dictature de Sylla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df2bda5d-0ed1-3c26-91eb-50d754e692ae",
                                        "entry_id": "d38b8946-768f-33c3-b559-586c60ede17f",
                                        "glosses": [
                                            "Autorité absolue ; autocratie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871ce0ba-0c5e-44bf-9c62-beddbee970bd",
                                                "sense_id": "df2bda5d-0ed1-3c26-91eb-50d754e692ae",
                                                "text": "À la différence des orléanistes cherchant à se persuader que le pays consentirait à dormir de longues années sous le mancenillier d’une gloire militaire, les bonapartistes aperçurent que le mac-mahonisme ne vivrait que s’il se résolvait en une dictature."
                                            },
                                            {
                                                "example_id": "f7a1b854-477a-4fcd-bf3a-e9fd1ba0e295",
                                                "sense_id": "df2bda5d-0ed1-3c26-91eb-50d754e692ae",
                                                "text": "La victoire armée du peuple cubain sur la dictature de Batista […] a démontré de façon tangible que, par la guérilla, un peuple peut se libérer d’un gouvernement qui l’opprime."
                                            },
                                            {
                                                "example_id": "78cc3c47-6903-42d3-8b72-68bb204599d8",
                                                "sense_id": "df2bda5d-0ed1-3c26-91eb-50d754e692ae",
                                                "text": "Buddhadasa va aller plus loin dans la provocation, en prônant l’établissement d’un « socialisme dhammique autoritaire », justifiant une dictature bouddhiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29047824-173c-35ca-b6df-565383be0d8f",
                                        "entry_id": "d38b8946-768f-33c3-b559-586c60ede17f",
                                        "glosses": [
                                            "Pression psychologique et insidieuse, qui s’impose du fait de l’appartenance à un groupe, de l’évolution des modes de vie, de l’environnement, etc."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904a08fc-fabf-4d9f-8057-0e0fce28bb1f",
                                                "sense_id": "29047824-173c-35ca-b6df-565383be0d8f",
                                                "text": "Et nous avons ainsi renoncé à l’ambition du « nourrissage culturel », seul rempart contre la dictature de l’appartenance."
                                            },
                                            {
                                                "example_id": "1bda1cec-86ab-4cf0-b47e-d6b04c575f91",
                                                "sense_id": "29047824-173c-35ca-b6df-565383be0d8f",
                                                "text": "Plus loin, une mère frissonnant de fièvre sur sa couche, des bébés hurlant et des puanteurs cruelles, des échos excrémentitiels, imposant sur tout cela leur dictature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79122cfb-2a75-4392-893c-7b25e2469b57",
                        "source_entry_id": "ebbc96b6-426c-3a1c-9a07-6df5803d4cbb",
                        "source_sense_description": "a government led by a dictator",
                        "target_lang_word": "Diktatur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diktatur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bf33f52-dcf0-3128-9db5-4e93fa71c798",
                                        "entry_id": "725c390e-b171-31b6-92eb-495be3b81422",
                                        "glosses": [
                                            "auf unbeschränkte Vollmacht einer Person oder Gruppe basierende Herrschaft in einem Staat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6895d31f-2a4f-4770-8c36-291ebab256cf",
                                                "sense_id": "3bf33f52-dcf0-3128-9db5-4e93fa71c798",
                                                "text": "Der Irak lebte bis vor Kurzem in einer Diktatur."
                                            },
                                            {
                                                "example_id": "fca98a02-1ba3-43e8-9823-5f6984135081",
                                                "sense_id": "3bf33f52-dcf0-3128-9db5-4e93fa71c798",
                                                "text": "„Die meisten Diktaturen wurden gestürzt, da es für sie keine Verwendung mehr gab.“"
                                            },
                                            {
                                                "example_id": "5afc4a43-4fdf-4ccf-b738-a5ed139f6c57",
                                                "sense_id": "3bf33f52-dcf0-3128-9db5-4e93fa71c798",
                                                "text": "„Die Mutter antwortete, wenn man unter einer Diktatur aufgewachsen sei, wäre immer irgendetwas nicht in Ordnung.“"
                                            },
                                            {
                                                "example_id": "a6b91d7f-a4e2-4758-bc06-7780b954e933",
                                                "sense_id": "3bf33f52-dcf0-3128-9db5-4e93fa71c798",
                                                "text": "„Diese Plakate, deren schöne Fassade nichts anderes als die schlimmste Waffe der Diktatur ist.“"
                                            },
                                            {
                                                "example_id": "979f201f-fc06-4021-98f2-4c77153d7f32",
                                                "sense_id": "3bf33f52-dcf0-3128-9db5-4e93fa71c798",
                                                "text": "„Alles andere wäre Diktatur, und die würde, wie wir gesehen haben, zur Produktion neuer, anderer Witze Anlass geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a35becc-dc50-4b70-937a-553ac308d491",
                        "source_entry_id": "ebbc96b6-426c-3a1c-9a07-6df5803d4cbb",
                        "source_sense_description": "a government led by a dictator",
                        "target_lang_word": "Gewaltherrschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewaltherrschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27769fd6-4836-3f93-ac4f-5055ab6a7395",
                                        "entry_id": "0b6d443a-b6fb-3328-901c-6976d45449c1",
                                        "glosses": [
                                            "Herrschaft, die mit willkürlicher Gewalt ausgeübt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db5ee77e-78ad-42c9-8c80-9a271f4740fa",
                                                "sense_id": "27769fd6-4836-3f93-ac4f-5055ab6a7395",
                                                "text": "„Für die Schwarzen, egal welchen Bildungsstandes, gibt es als Strafe weiterhin Hiebe mit der Peitsche aus Flusspferdhaut, wie einst unter Leopolds Gewaltherrschaft.“"
                                            },
                                            {
                                                "example_id": "4fa3b46e-de1a-4ca8-b6ee-d32c3d6c62f6",
                                                "sense_id": "27769fd6-4836-3f93-ac4f-5055ab6a7395",
                                                "text": "„Während er im Westen weithin als Diktator eingeschätzt wird, findet er in Afrika trotz seiner Gewaltherrschaft und der Zerstörung seines Landes eine erstaunlich positive Resonanz.“"
                                            },
                                            {
                                                "example_id": "58610659-642b-4482-b341-af58a2f76b0a",
                                                "sense_id": "27769fd6-4836-3f93-ac4f-5055ab6a7395",
                                                "text": "[Richard von Weizsäcker, 8. Mai 1985:] […] „»Der 8. Mai war ein Tag der Befreiung. Er hat uns alle befreit von dem menschenverachtenden System der nationalsozialistischen Gewaltherrschaft.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de3e0f7f-c8bc-4593-ae5e-046280f91f1a",
                        "source_entry_id": "ebbc96b6-426c-3a1c-9a07-6df5803d4cbb",
                        "source_sense_description": "a government led by a dictator",
                        "target_lang_word": "Willkürherrschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Willkürherrschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b68efcd-6201-331c-bc82-210b79e7d0bd",
                                        "entry_id": "90f70a01-78fd-3e3f-aa86-36f8cf09e336",
                                        "glosses": [
                                            "Herrschaft, die nur die Interessen des/der Herrschenden wahrnimmt, ohne Rücksicht auf Gesetze oder Menschenrechte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1368b329-3d84-4baa-8f5b-1aff809ed3a8",
                                                "sense_id": "1b68efcd-6201-331c-bc82-210b79e7d0bd",
                                                "text": "„Doch die Kommission tut ihm nicht den Gefallen: Sie sammelt von Hunderten Zeugen derart vernichtende Aussagen, dass Leopold die Willkürherrschaft im Kongo nicht mehr leugnen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
