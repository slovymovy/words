                    {
                        "translation_id": "4d998103-4181-4189-ad86-d98a70d8195e",
                        "source_entry_id": "15d5a826-2de9-346e-94a7-fbddaf13498b",
                        "source_sense_id": "a09fc20a-f7dd-3862-b839-deddff72ae76",
