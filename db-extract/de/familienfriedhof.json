                                "example_id": "ad375f64-0d6e-4215-a3e6-77ed4ba6a010",
                                "sense_id": "c0a50250-f8e7-35ca-a172-8cddddb4d478",
                                "text": "„Nahum hatte auf dem umzäunten Grundstück, das als Familienfriedhof diente, ein Grab ausgehoben und darin das beerdigt, was er vorgefunden hatte.“"
                            },
                            {
                                "example_id": "740394fa-70e1-4aa7-b1a5-3346159e8aff",
                                "sense_id": "c0a50250-f8e7-35ca-a172-8cddddb4d478",
                                "text": "„Der Familienfriedhof lag unmittelbar vor der hohen Steinmauer, welche das Haus umfriedete.“"
                            }
