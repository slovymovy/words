                "senses": [
                    {
                        "sense_id": "90d90b75-be0a-3619-928d-760d3a13deae",
                        "entry_id": "94be74e0-b86e-3996-998f-9e0f7fababa4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e39bab2-89d5-4ed5-adac-d3e6a12c0a5c",
                                "sense_id": "90d90b75-be0a-3619-928d-760d3a13deae",
                                "text": "Frau Scheindlin ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0daf09e2-0d38-413b-a521-0a3e2fa6024a",
                                "sense_id": "90d90b75-be0a-3619-928d-760d3a13deae",
                                "text": "Herr Scheindlin wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0ca8559f-9914-43f1-9465-1dd3fe5844c4",
                                "sense_id": "90d90b75-be0a-3619-928d-760d3a13deae",
                                "text": "Die Scheindlins fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bfaba4a9-34ca-4bff-9354-3cbcd70152e5",
                                "sense_id": "90d90b75-be0a-3619-928d-760d3a13deae",
                                "text": "Der Scheindlin trägt nie die Schals, die die Scheindlin ihm strickt."
                            },
                            {
                                "example_id": "2be96954-1f2d-4377-b45f-53b9f10e979c",
                                "sense_id": "90d90b75-be0a-3619-928d-760d3a13deae",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scheindlin kommt, geht der Herr Scheindlin.“"
                            },
                            {
                                "example_id": "b1e6436c-3034-4081-a0f5-17e93b17fb6f",
                                "sense_id": "90d90b75-be0a-3619-928d-760d3a13deae",
                                "text": "Scheindlin kommt und geht."
                            },
                            {
                                "example_id": "76b89beb-b313-44a3-baed-6f50625bb820",
                                "sense_id": "90d90b75-be0a-3619-928d-760d3a13deae",
                                "text": "Scheindlins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
