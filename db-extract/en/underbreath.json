                ],
                "senses": [
                    {
                        "sense_id": "4f4fe1cd-bd1c-3bcd-b58a-64fc6108c603",
                        "entry_id": "e8ceec4c-bb60-319b-8c79-640c09df54d7",
                        "glosses": [
                            "An utterance made so as not to be heard by most people in the area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e609d874-2860-4663-841d-10eb5998e745",
                                "sense_id": "4f4fe1cd-bd1c-3bcd-b58a-64fc6108c603",
                                "text": "The underbreath of our every prayer should be, “Father, not my will, but thine be done”"
                            },
                            {
                                "example_id": "14b8faed-da28-4619-b4a0-0f3d90f0f1a3",
                                "sense_id": "4f4fe1cd-bd1c-3bcd-b58a-64fc6108c603",
                                "text": "He complained in occasional underbreaths, correcting himself immediately with a \" No, no !\" and blinking briskly."
                            },
                            {
                                "example_id": "69f3a882-e949-425d-8640-af19a2b2f011",
                                "sense_id": "4f4fe1cd-bd1c-3bcd-b58a-64fc6108c603",
                                "text": "\"Miss Barnard,\" he said, hurriedly, and in an underbreath. \"This has been an unfortunate thing — these words over this play. I want to be able just to speak to you about it. Can I see you somewhere? Could you come into the garden? \""
                            },
                            {
                                "example_id": "7bd0b1d9-c303-4c94-9b6b-ddea1a8024ee",
                                "sense_id": "4f4fe1cd-bd1c-3bcd-b58a-64fc6108c603",
                                "text": "Alexandra asked in an underbreath as Ramsey turned and started down the hall."
                            }
                        ]
                    }
                ],
