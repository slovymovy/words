                    "frequency": "VeryLow",
                    "semantic_group_id": "etablissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années d'errance, il décida de s'<w>habituer</w> dans ce petit village isolé."
                        },
                        {
                            "text": "La famille a choisi de s'<w>habituer</w> dans cette province pour fuir les tumultes urbains."
                        }
                    ],
