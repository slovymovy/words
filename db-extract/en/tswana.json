                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "540c1f2e-66dc-3ac0-88db-699577c17780",
                        "entry_id": "0b841ee2-04ef-357d-a308-922929cd9054",
                        "glosses": [
                            "The Bantu language of these people; Setswana."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1fbf1e2-574f-4256-bcb0-85ba9b76db4f",
                        "source_entry_id": "0b841ee2-04ef-357d-a308-922929cd9054",
                        "source_sense_id": "540c1f2e-66dc-3ac0-88db-699577c17780",
                        "source_sense_description": "language",
                        "target_lang_word": "Tswana",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tswana",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0448f5c8-da22-3056-9698-30378283602a",
                                        "entry_id": "94988466-b9aa-3c8a-91a4-d256c5f908f5",
                                        "glosses": [
                                            "Bantoetaal die wordt gesproken door 4,5 miljoen mensen in Botswana en Zuid-Afrika"
                                        ],
                                        "tags": [
                                            "linguistics",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba375850-653d-462e-b0dd-195f2f9ff01a",
                                                "sense_id": "0448f5c8-da22-3056-9698-30378283602a",
                                                "text": "In Botswana wordt vooral Tswana gesproken."
                                            },
                                            {
                                                "example_id": "e69b2628-60a2-472c-ac21-d654c82f588a",
                                                "sense_id": "0448f5c8-da22-3056-9698-30378283602a",
                                                "text": "Macht en rijkdom zijn van elkaar afhankelijk geworden, meent Good. De lokale taal Tswana gebruikt voor die twee begrippen zelfs hetzelfde woord: kgosi."
                                            },
                                            {
                                                "example_id": "3dd17ed3-5358-49f7-88e3-3d69e92551c4",
                                                "sense_id": "0448f5c8-da22-3056-9698-30378283602a",
                                                "text": "Volgens de interim-grondwet zijn er elf officiële talen: Afrikaans, Engels, Zoeloe, Xhosa, Swazi, Noord- en Zuid-Sotho, Tswana, Ndebele, Venda en Tsonga."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Tswana",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4004e8c4-89b5-3a99-bc0a-3700a30cdb51",
                                        "entry_id": "2426764e-5047-38ba-b2d5-675de727e20f",
                                        "glosses": [
                                            "iemand die behoort tot het volk van de Tswana"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6903afe-59ad-4bee-b63e-621ee84f000c",
                                                "sense_id": "4004e8c4-89b5-3a99-bc0a-3700a30cdb51",
                                                "text": "Hier proberen ze nu ook de Tswana, de Boer en de Zoeloe in één volk te stoppen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Tswana",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "55012600-0246-3ed3-8011-dd26d7ec6246",
                                        "entry_id": "5145be8a-faca-307e-8c10-df8707fa560e",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord Tswana"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a329ee4a-e5a8-4f3b-96f5-a1ddff295dd0",
                                                "sense_id": "55012600-0246-3ed3-8011-dd26d7ec6246",
                                                "text": "„We kwijnen weg in ellende”, vertelt Martin, een jonge San in d'Kar. „Voor de Tswana, de heersers van Botswana, zijn wij veejongens.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaea73d5-3908-32dd-9fc8-24d8c575d206",
                                        "entry_id": "5145be8a-faca-307e-8c10-df8707fa560e",
                                        "glosses": [
                                            "volk dat leeft in zuidelijk Afrika"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7d18718-ec4a-44f8-88a4-750c2574b31b",
                                                "sense_id": "eaea73d5-3908-32dd-9fc8-24d8c575d206",
                                                "text": "Basters die deelnamen aan het verzet tegen de apartheid krijgen daar geen erkenning voor. Andere, zwarte volken – de Ovambo in Namibië en de Xhosa, Zulu en Tswana in Zuid-Afrika – krijgen voorrang."
                                            },
                                            {
                                                "example_id": "b47c6cb9-3ef2-480b-a34d-d310f4b1bb92",
                                                "sense_id": "eaea73d5-3908-32dd-9fc8-24d8c575d206",
                                                "text": "Anders dan Angola, Zimbabwe of Congo kent Botswana slechts één etnische groepering: de Tswana."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
