            "senses": [
                {
                    "sense_id": "01c1d443-a514-3a36-9b15-3ec5de4134f1",
                    "sense_definition": "Dégager une personne, un animal ou une chose de ce qui le retenait ou le liait.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>détacher</w> le chien avant de commencer la promenade dans le parc."
                        },
                        {
                            "text": "Le marin a décidé de <w>détacher</w> la barque pour naviguer sur la rivière."
                        }
                    ],
                    "synonyms": [
                        "délier",
                        "débloquer",
                        "décrocher"
                    ],
                    "antonyms": [
                        "attacher",
                        "lier",
                        "fixer"
                    ],
                    "common_phrases": [
                        "détacher la barque",
                        "détacher un chien"
                    ]
                },
                {
                    "sense_id": "b560e06e-a76d-33fc-a0f9-2910e36a2735",
                    "sense_definition": "Faire disparaître une salissure ou une tache sur un vêtement ou un tissu.",
