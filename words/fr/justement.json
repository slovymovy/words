                                "nl": "Deze hardwerkende student is <w>terecht</w> beloond met een excellentiebeurs.",
                                "de": "Dieser fleißige Student wurde <w>zu Recht</w> mit einem Exzellenzstipendium belohnt.",
                                "pl": "Ten pracowity student został <w>słusznie</w> nagrodzony stypendium naukowym za wybitne wyniki.",
                                "it": "Questo studente laborioso è stato <w>meritatamente</w> ricompensato con una borsa di studio d'eccellenza.",
                                "cs": "Tento pilný student byl <w>zaslouženě</w> odměněn stipendiem za vynikající výsledky.",
                                "tr": "Bu çalışkan öğrenci, başarı bursuyla <w>haklı olarak</w> ödüllendirildi.",
                                "es": "Este estudiante esforzado fue <w>merecidamente</w> recompensado con una beca de excelencia.",
                                "zh": "这名勤奋的学生获得了优秀奖学金，<w>实至名归</w>。"
                            }
                        }
