                "senses": [
                    {
                        "sense_id": "bedd9a90-dcb5-394a-9e90-f490ad0195d4",
                        "entry_id": "5ba13b26-22b3-3735-9c62-aaba83f04c7e",
                        "glosses": [
                            "nicht vollwertiger Politiker"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d3cc02a5-b4a5-4336-a696-a6f011445666",
                                "sense_id": "bedd9a90-dcb5-394a-9e90-f490ad0195d4",
                                "text": "„Man pflegt uns Laien gerne vorzuwerfen, daß wir nur Dilettanten seien, Schmalspurpolitiker, und daß wir besser täten, die großen politischen Probleme den Fachleuten, den Sachverständigen zu überlassen.“"
                            },
                            {
                                "example_id": "3861a4e7-0e10-450d-a389-50ea0f72f302",
                                "sense_id": "bedd9a90-dcb5-394a-9e90-f490ad0195d4",
                                "text": "„Denn er ist nun einmal kein Schmalspurpolitiker.“"
                            },
                            {
                                "example_id": "6ea1d7f4-871e-4c34-8478-c00be761b195",
                                "sense_id": "bedd9a90-dcb5-394a-9e90-f490ad0195d4",
                                "text": "„Da muß ne Frau mehr können als son Schmalspurpolitiker oder Manager.“"
                            },
                            {
                                "example_id": "872b52db-5f5f-4cf3-b7b5-b01464fb72cb",
                                "sense_id": "bedd9a90-dcb5-394a-9e90-f490ad0195d4",
                                "text": "„Bis es soweit kommt, traktiert Schlämmer reale Schmalspurpolitiker mit einer Frage, die so schief ist wie seine Zähne und gleichzeitig nach Heidegger, nach tief ersonnener Daseinskepsis klingt: \"Was mangelt?\"“"
                            },
                            {
                                "example_id": "baef0050-49ee-4c23-8054-1e30f4b9c4f7",
                                "sense_id": "bedd9a90-dcb5-394a-9e90-f490ad0195d4",
                                "text": "„Kabarettist Macharski verkörpert den Landwirt und Schmalspurpolitiker seit 23 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
