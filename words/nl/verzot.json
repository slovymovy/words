                    "synonyms": [
                        "stapelgek",
                        "wild"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Deze betekenis komt minder vaak voor in modern taalgebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "mentally confused, deranged, or out of one's mind"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mad",
                                "target_lang_sense_clarification": "mentally deranged or insane"
                            },
