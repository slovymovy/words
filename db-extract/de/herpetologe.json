                "senses": [
                    {
                        "sense_id": "1d7c6c4b-8be7-3512-a335-8dd405a4684c",
                        "entry_id": "bc040636-fb65-37dd-9e1a-ee33e22daf3e",
                        "glosses": [
                            "Experte für Amphibien und Reptilien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81b343b5-9700-412d-9957-e88631f63f68",
                                "sense_id": "1d7c6c4b-8be7-3512-a335-8dd405a4684c",
                                "text": "„Neben seiner Sammlung von Madagaskar-Fröschen hat Herpetologe Vences auch noch Froschkonserven aus verschiedenen Regionen Afrikas im Kühlfach.“"
                            },
                            {
                                "example_id": "ce0a1aba-d078-4e7b-a987-9cca02d1f012",
                                "sense_id": "1d7c6c4b-8be7-3512-a335-8dd405a4684c",
                                "text": "„Sebastian Lotzkat, Herpetologe in Panama und Science-Slammer, widerlegt das schlechte Image der Schlangen, indem er an die Stelle der Mythen die viel spannendere Realität der Biologie setzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6f10367-9da5-47aa-8d83-80b15f7dc284",
                        "source_entry_id": "bc040636-fb65-37dd-9e1a-ee33e22daf3e",
                        "source_sense_id": "1d7c6c4b-8be7-3512-a335-8dd405a4684c",
                        "source_sense_description": "Experte für Amphibien und Reptilien",
                        "target_lang_word": "herpetologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herpetologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c1e85d-561a-3c0b-b60a-41b5835971b6",
                                        "entry_id": "08fd9462-1406-326f-8dc4-5d1f7cf663b8",
                                        "glosses": [
                                            "One who studies reptiles and amphibians; a reptile and amphibian specialist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1da26720-5ad0-4a64-b078-7b8810abeba1",
                                                "sense_id": "e0c1e85d-561a-3c0b-b60a-41b5835971b6",
                                                "text": "Already, Griffith has observed several amphibian extinctions. Pretty much every herpetologist working out in the field has watched several."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ebfc563-83eb-4d2d-8734-d712dbf9182d",
                        "source_entry_id": "bc040636-fb65-37dd-9e1a-ee33e22daf3e",
                        "source_sense_id": "1d7c6c4b-8be7-3512-a335-8dd405a4684c",
                        "source_sense_description": "Experte für Amphibien und Reptilien",
                        "target_lang_word": "herpétologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herpétologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5b9308a-968a-3a0a-8c8e-49ea67b808ce",
                                        "entry_id": "e7df6b05-25e2-3823-8cae-b7a8826fa16c",
                                        "glosses": [
                                            "Spécialiste des reptiles et des amphibiens, qui étudie l’herpétologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a143ba-b708-474a-a18e-d1bd144f457a",
                                                "sense_id": "a5b9308a-968a-3a0a-8c8e-49ea67b808ce",
                                                "text": "Il obtient, en 1870, un poste non salarié au Senckenberg Museum de Francfort, d’abord comme paléontologue et ensuite comme herpétologue en 1875."
                                            },
                                            {
                                                "example_id": "a02c2701-07e4-4e45-abff-9f9874f0bd17",
                                                "sense_id": "a5b9308a-968a-3a0a-8c8e-49ea67b808ce",
                                                "text": "Une nasse tambour a été placée la veille dans une mare par Maud Berroneau, herpétologue et cheffe de projet à Cistude nature pour capturer la tortue Cistude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9aa65fd7-1e40-4cee-a3fc-0f94f7a8f6ac",
                        "source_entry_id": "bc040636-fb65-37dd-9e1a-ee33e22daf3e",
                        "source_sense_id": "1d7c6c4b-8be7-3512-a335-8dd405a4684c",
                        "source_sense_description": "Experte für Amphibien und Reptilien",
