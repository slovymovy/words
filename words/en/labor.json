        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc1c87eb-6334-3de1-8e02-42c5b5f25dff",
                    "sense_definition": "The American English spelling of <w>labour</w>, meaning to work hard, make a great effort, or move with difficulty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <labor> for years to build his business from the ground up.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <трудиться> годами, чтобы построить свой бизнес с нуля.",
                                "zh": "他<w>苦干</w>了多年，才从零开始建立起自己的事业。"
                            }
                        },
                        {
                            "text": "The old engine began to <labor> as the truck climbed the steep hill.",
                            "target_lang_translations": {
                                "ru": "Старый двигатель начал <работать с натугой>, когда грузовик поднимался на крутой холм.",
                                "zh": "当卡车爬上陡坡时，那台旧引擎开始<w>吃力地运行</w>。"
                            }
                        }
                    ],
