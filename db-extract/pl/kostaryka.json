                                "target_senses": [
                                    {
                                        "sense_id": "defdb3a4-2e48-344d-a717-2f7a8b3606c2",
                                        "entry_id": "6b262525-9354-37c5-8f03-baf09e23ec77",
                                        "glosses": [
                                            "Pays d’Amérique centrale, bordé au nord par le Nicaragua, au nord-est par la mer des Caraïbes, à l’est par le Panama, et au sud et à l’ouest par l’océan Pacifique Nord, dont la capitale est San José."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4002664d-aa5c-4102-8d8f-cc4654d9bbc3",
                                                "sense_id": "defdb3a4-2e48-344d-a717-2f7a8b3606c2",
                                                "text": "Le Costa Rica est, depuis les années 2000, le quatrième exportateur mondial de ce fruit [la banane], derrière l’Équateur, les Philippines et le Guatemala, selon l’Organisation des Nations unies pour l’alimentation et l’agriculture (FAO)."
                                            },
                                            {
                                                "example_id": "41cd36cb-fd3b-4def-87bb-0b7e012e1ea2",
                                                "sense_id": "defdb3a4-2e48-344d-a717-2f7a8b3606c2",
                                                "text": "Bah, fait Béhanzigue, les expositions, ça n’est jamais sûr. C’est ainsi qu’un de mes amis, qui avait envoyé un Raphaël à Costa Rica…"
                                            },
                                            {
                                                "example_id": "c86b9114-f47f-4f71-84a3-99fd3c3beb40",
                                                "sense_id": "defdb3a4-2e48-344d-a717-2f7a8b3606c2",
                                                "text": "Je suis allé au Costa Rica pour mes vacances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff48483c-f898-4b7f-9747-39931ec545e3",
                        "source_entry_id": "97640a04-b490-3da5-94ca-cde9f1fdd23f",
                        "source_sense_id": "de82e70c-edad-31f4-ac0a-cb2ea5bf290c",
