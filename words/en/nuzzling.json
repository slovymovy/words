    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "611f7588-5275-362b-9023-da48e340782c",
                    "sense_definition": "The act of gently pushing or rubbing with the nose or snout.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy gave soft <w>nuzzlings</w> to its mother while they rested together.",
                            "target_lang_translations": {
                                "cs": "Štěně se jemně <w>otíralo čenichem</w> o svou matku, zatímco spolu odpočívali."
                            }
                        },
                        {
                            "text": "Despite the animals' friendly <w>nuzzlings</w>, the farmer finally chased them off with a broom.",
                            "target_lang_translations": {
                                "cs": "Navzdory přátelskému <w>otírání se čenichy</w> je farmář nakonec zahnal koštětem."
                            }
                        }
                    ],
                    "synonyms": [
                        "nuzzling"
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt jemného tlačení nebo tření nosem či čenichem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otírání se čenichem",
                                "target_lang_sense_clarification": "popis fyzického kontaktu zvířete"
                            },
                            {
                                "target_lang_word": "šťouchání nosem",
                                "target_lang_sense_clarification": "jemný kontakt nosem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "decf984b-792c-32c0-a1cc-1b454a555962",
                    "sense_definition": "Present participle and gerund of <w>nuzzle</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse was <w>nuzzling</w> my hand in search of a treat.",
                            "target_lang_translations": {
                                "cs": "Kůň se <w>otíral čenichem</w> o mou ruku a hledal pamlsek."
                            }
                        },
                        {
                            "text": "She felt the cat <w>nuzzling</w> against her leg while she worked.",
                            "target_lang_translations": {
                                "cs": "Cítila, jak se o ni kočka při práci <w>otírá čenichem</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nuzzling against",
                        "nuzzling into"
                    ],
                    "traits": [
