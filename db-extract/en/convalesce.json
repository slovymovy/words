                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396b03fc-cd91-4824-9687-666263f117e6",
                                                "sense_id": "80eec6c0-4ab3-30a4-b546-fcd2a4a8918e",
                                                "text": "Nachdem er von seiner Krankheit genesen war, konnte er sich wieder dem Turnen widmen."
                                            },
                                            {
                                                "example_id": "cde51583-8731-4445-a8ec-096f496041b2",
                                                "sense_id": "80eec6c0-4ab3-30a4-b546-fcd2a4a8918e",
                                                "text": "Sie genas nach der erfolgreichen Operation sehr schnell."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e9665d6-3804-4192-9b9a-2121b1a33634",
                        "source_entry_id": "1dcde569-8016-3dad-ba24-09aa886e76bd",
                        "source_sense_id": "46bb324a-7f02-3c2e-9d38-871dfa25e605",
                        "source_sense_description": "to recover",
                        "target_lang_word": "выздора́вливать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "выздора́вливать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bbf3515f-8bed-31b4-a618-bf26290dd2cd",
                                        "entry_id": "57116d74-55a6-306a-89fc-0fc1f45b004e",
                                        "glosses": [
                                            "становиться здоровым, оправляться после болезни, травмы и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d7aa6b5-6ff2-4449-8a2b-f98fbaba837a",
                                                "sense_id": "bbf3515f-8bed-31b4-a618-bf26290dd2cd",
                                                "text": "Это вопрос не только географический, но и медицинский: дома люди выздоравливают быстрее."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54aa4431-2275-3db6-b7f7-42b3e9e271be",
                                        "entry_id": "57116d74-55a6-306a-89fc-0fc1f45b004e",
                                        "glosses": [
                                            "перен. выправляться, избавляться от чего-либо неприятного, вредного, опасного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f252eb53-ef3c-4492-8ca7-15b91508f9f1",
                                                "sense_id": "54aa4431-2275-3db6-b7f7-42b3e9e271be",
                                                "text": "А ещё ему не нравилось, что общество выздоравливает, не прислушиваясь к его советам и даже вовсе без его участия."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2303f42-4dfd-46e4-ba6f-519a6db412c4",
                        "source_entry_id": "1dcde569-8016-3dad-ba24-09aa886e76bd",
                        "source_sense_id": "46bb324a-7f02-3c2e-9d38-871dfa25e605",
                        "source_sense_description": "to recover",
                        "target_lang_word": "вы́здороветь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вы́здороветь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "96207e42-cf5c-3b5d-85cd-53c1767f9a44",
                                        "entry_id": "d2102172-e7cc-33a4-b013-d93b2ed10eaf",
                                        "glosses": [
                                            "стать здоровым, оправиться от болезни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f946efe8-53e7-4fd7-8761-565f3bd5a372",
                                                "sense_id": "96207e42-cf5c-3b5d-85cd-53c1767f9a44",
                                                "text": "Вскоре я выздоровел, и мог перебраться на мою квартиру."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6da15c4-b672-4ea8-8e76-13d21dc099ff",
                        "source_entry_id": "1dcde569-8016-3dad-ba24-09aa886e76bd",
                        "source_sense_id": "46bb324a-7f02-3c2e-9d38-871dfa25e605",
                        "source_sense_description": "to recover",
                        "target_lang_word": "поправля́ться",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "поправля́ться",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "741f17c7-cbc3-35b6-a9c0-3dfc64118b7f",
                                        "entry_id": "bf825912-ead8-3576-813c-658d9363972d",
                                        "glosses": [
                                            "выздоравливать, восстанавливать свои силы и здоровье; приходить в себя после какого-либо потрясения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e7ad081-cb88-4824-b74a-287dbc8b7914",
                                                "sense_id": "741f17c7-cbc3-35b6-a9c0-3dfc64118b7f",
                                                "text": "Таин, в тот же день начала поправляться, кушать, пить и говорить, между тем, как она была почти в беспамятстве, металась сильно и ничего не ела, не пила."
                                            },
                                            {
                                                "example_id": "803bf9be-025f-477a-9edb-2279128cf8fd",
                                                "sense_id": "741f17c7-cbc3-35b6-a9c0-3dfc64118b7f",
                                                "text": "Я то поправлялся, то заболевал с новой силой, то мучился, то переставал вовсе страдать, пока, наконец, не умер сего дня по всем правилам науки в тот самый день и час, которые мне были назначены для смерти с минуты рождения."
                                            },
                                            {
                                                "example_id": "651095ae-89ca-40d0-b80f-b9540ba1a302",
                                                "sense_id": "741f17c7-cbc3-35b6-a9c0-3dfc64118b7f",
                                                "text": "Вы поправитесь и будете таким же здоровым, как раньше."
                                            },
                                            {
                                                "example_id": "ff104e35-8b8f-42c4-bf21-6a8214d8d7bf",
                                                "sense_id": "741f17c7-cbc3-35b6-a9c0-3dfc64118b7f",
                                                "text": "В степи паслось довольно много скота, поправлявшегося на молодой весенней траве от зимнего поста."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b0c36b4-2c29-32ff-ab17-a1002a630a2c",
                                        "entry_id": "bf825912-ead8-3576-813c-658d9363972d",
                                        "glosses": [
                                            "перен., разг. толстеть, набирать вес, становиться полнее"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1d48f06-095b-4c49-966a-d5b740752f6e",
                                                "sense_id": "3b0c36b4-2c29-32ff-ab17-a1002a630a2c",
                                                "text": "Те, кто, являясь толстяками, не пытаются похудеть, а будучи худыми, не стремятся поправиться."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a8a155e-3e7c-3924-a6ed-d98d11a4edb1",
                                        "entry_id": "bf825912-ead8-3576-813c-658d9363972d",
                                        "glosses": [
                                            "перен., разг. изменяться к лучшему, улучшаться; исправляться и становиться лучше в моральном плане; восстанавливать своё благосостояние (хозяйство, дела)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c506a1ba-facf-42ec-af82-daf67ba26500",
                                                "sense_id": "6a8a155e-3e7c-3924-a6ed-d98d11a4edb1",
                                                "text": "Четвертую часть подарка содрал с меня варварски типографщик за печать, а остальными деньгами я несколько поправился, ибо в то время так я издержался на бумагу, что я стоял одной ногой при дверях нищеты."
                                            },
                                            {
                                                "example_id": "403b635c-5750-41a3-8d42-adeebf07a66a",
                                                "sense_id": "6a8a155e-3e7c-3924-a6ed-d98d11a4edb1",
                                                "text": "Смекнул тоже, что Данилушко вовсе другой стал: поправился, рубашонка на нём добрая, штанишки тоже и на ногах сапожнешки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bd92d66-6c27-3822-8d01-0027eb85d5e4",
                                        "entry_id": "bf825912-ead8-3576-813c-658d9363972d",
                                        "glosses": [
                                            "исправлять свою ошибку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "232f5237-291c-4b1f-b8ae-6e356bddcc6b",
                                                "sense_id": "6bd92d66-6c27-3822-8d01-0027eb85d5e4",
                                                "text": "С изменой юности моей // Пора мне сделаться умней, // В делах и в слоге поправляться, // И эту пятую тетрадь // От отступлений очищать."
                                            },
                                            {
                                                "example_id": "a096deb1-0b16-4d10-9aa1-3b597ed5317e",
                                                "sense_id": "6bd92d66-6c27-3822-8d01-0027eb85d5e4",
                                                "text": "Это возражение свалило было с ног всю стрелковую линию доводов, готовых выступить против чудака; но Иван, погладив немногие волосы, окаймившие его лысую голову, поправился и отвечал:…"
                                            },
                                            {
                                                "example_id": "87973d56-2e30-480a-b10f-c22a0b962e2f",
                                                "sense_id": "6bd92d66-6c27-3822-8d01-0027eb85d5e4",
                                                "text": "Когда придет тебе в голову безрассудная мысль — сосчитать какие-либо добрые дела свои, тотчас же поправься в этой ошибке и скорей считай свои грехи, свои непрерывные, бесчисленные оскорбления всеблагого и праведного Владыки и найдешь, что их у тебя как песку морского, а добродетелей сравнительно сними, все равно что нет."
                                            },
                                            {
                                                "example_id": "030e2f00-98a5-458e-a412-f7eb24a67702",
                                                "sense_id": "6bd92d66-6c27-3822-8d01-0027eb85d5e4",
                                                "text": "Почувствовав ошибку, стал поправляться, «спрямлять» и, как водится, вовсе сбился."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c661af04-8c36-46e0-856f-2e207b5115a2",
                        "source_entry_id": "1dcde569-8016-3dad-ba24-09aa886e76bd",
