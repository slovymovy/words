                "word": "oho",
                "pos": "intj",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b145fdb-fc97-3bd7-bbb6-10bd7f989e8c",
                        "entry_id": "aa43c9ed-ad5e-3489-99ea-c49c73d6c7bb",
                        "glosses": [
                            "Ausruf des Erstaunens, des Unwillens, des Widerspruchs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b923ca-867d-407f-b171-ff9f40ff6848",
                                "sense_id": "2b145fdb-fc97-3bd7-bbb6-10bd7f989e8c",
                                "text": "Oho, da liegt der Hase im Pfeffer!"
                            },
                            {
                                "example_id": "dc44f9db-7c5a-4290-ba5b-f4d082a6d108",
                                "sense_id": "2b145fdb-fc97-3bd7-bbb6-10bd7f989e8c",
                                "text": "Oho, so haben wir nicht gewettet!"
                            },
                            {
                                "example_id": "3224982a-6f69-4ddc-aecf-44c8b793b39c",
                                "sense_id": "2b145fdb-fc97-3bd7-bbb6-10bd7f989e8c",
                                "text": "Die Weinbauern hoffen nun auf einen schönen Herbst, sodass der Jahrgang \"klein, aber oho\" wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1de9e12-8f1c-4988-977a-5e31bd6f8a12",
                        "source_entry_id": "aa43c9ed-ad5e-3489-99ea-c49c73d6c7bb",
                        "source_sense_id": "2b145fdb-fc97-3bd7-bbb6-10bd7f989e8c",
                        "source_sense_description": "Ausruf des Erstaunens, des Unwillens, des Widerspruchs",
                        "target_lang_word": "oho",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oho",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "749cb4bf-72c2-3bea-a75e-1c976afd823c",
                                        "entry_id": "aa469502-2030-381b-b727-ece02b838320",
                                        "glosses": [
                                            "Expressing surprise or gloating realisation; aha."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c9da0b2-6384-495d-af58-875aa6f01065",
                                                "sense_id": "749cb4bf-72c2-3bea-a75e-1c976afd823c",
                                                "text": "\"There is Kate, taking no heed of anybody; sensible old darling — she goes at her tea and cake — Oho! she has not touched them!\""
                                            },
                                            {
                                                "example_id": "d5cab04f-a913-4038-8081-77c3eaa3abae",
                                                "sense_id": "749cb4bf-72c2-3bea-a75e-1c976afd823c",
                                                "text": "\"Oho, my boy, that's the woman who keeps you here! Mrs. Neff hinted at it, but I wouldn't believe it till I had it from you.\""
                                            },
                                            {
                                                "example_id": "6ac204d8-d4b8-477b-a061-e775d954ff70",
                                                "sense_id": "749cb4bf-72c2-3bea-a75e-1c976afd823c",
                                                "text": "\"Oho,\" he said, \"a vile thing to say. It is. I am losing check upon my tongue, it is running free like a riderless horse. And I don't give a damn. I can say at last what I wanted for years to say, years of being politic and demure. No longer.\""
                                            },
                                            {
                                                "example_id": "2bc46f57-cf3a-4c69-b7cd-38e90c69dc2e",
                                                "sense_id": "749cb4bf-72c2-3bea-a75e-1c976afd823c",
                                                "text": "\"Oho! Now I see where he's going with this, Frank thinks. Would have seen it earlier if I hadn't been so tired.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
