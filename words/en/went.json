                    "target_lang_definitions": {
                        "ru": "Устаревшая форма прошедшего времени от глагола \"wend\" (держать путь).",
                        "zh": "动词 wend 的过去时和过去分词形式，意为行进、走（古英语或文学用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "держал путь",
                                "target_lang_sense_clarification": "двигался в определенном направлении (устар.)"
                            },
                            {
