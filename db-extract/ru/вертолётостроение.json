                "senses": [
                    {
                        "sense_id": "11f5f659-ce25-324f-9c44-17a70b563391",
                        "entry_id": "56e4945d-e23c-3c95-9531-8090db960b3b",
                        "glosses": [
                            "отрасль промышленности, производящая вертолёты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29c79a18-18f6-4470-9ba4-a2bd985a1f0a",
                                "sense_id": "11f5f659-ce25-324f-9c44-17a70b563391",
                                "text": "За рубежом в середине ― конце тридцатых годов больше других в вертолётостроении преуспели французы и немцы."
                            },
                            {
                                "example_id": "33b4e5bf-c685-4f60-9d6e-0cdacec70d7a",
                                "sense_id": "11f5f659-ce25-324f-9c44-17a70b563391",
                                "text": "Органопластики нашли применение в вертолётостроении. Они легче углепластиков, обладают большей ударной прочностью, поэтому обшивки вертолётов можно сделать очень тонкими."
                            }
                        ]
                    }
