                "senses": [
                    {
                        "sense_id": "c6b0534a-9316-3b8b-bf03-09723f9edae6",
                        "entry_id": "9fd92ca9-ef60-305e-a022-f272fee77e36",
                        "glosses": [
                            "Tür, die den Zugang zu einem Waggon ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5e0e5c0-72a1-49de-97b1-0d5090d827a1",
                                "sense_id": "c6b0534a-9316-3b8b-bf03-09723f9edae6",
                                "text": "„Nach einem endlosen Stau zurück in die Stadt lacht uns Sergej schon an der Waggontür entgegen.“"
                            },
                            {
                                "example_id": "fcfd7526-7e0e-4f59-aaa6-05b2cf240328",
                                "sense_id": "c6b0534a-9316-3b8b-bf03-09723f9edae6",
                                "text": "„Ich werfe die Koffer in eine Waggontür und springe hinterher.“"
                            },
                            {
                                "example_id": "0c1ae6f3-3235-4c8b-b003-1be41816e1d5",
                                "sense_id": "c6b0534a-9316-3b8b-bf03-09723f9edae6",
                                "text": "„Die restlichen Kameraden seiner Einheit, die sich in die Fenster gezwängt hatten und aus den Waggontüren hingen, lachten und winkten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
