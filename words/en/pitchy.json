{
    "word_family": [
        "pitch",
        "pitchiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3cf46ed9-634e-3b16-8dda-08a8cf2b6201",
                    "sense_definition": "Slightly off-key or out of tune when singing or playing an instrument.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge noted that the performance was a bit <w>pitchy</w> during the high notes.",
                            "target_lang_translations": {
                                "ru": "Судья отметил, что исполнение было немного <w>фальшивым</w> на высоких нотах."
                            }
                        },
                        {
                            "text": "Even professional singers can sound <w>pitchy</w> if they cannot hear themselves on stage.",
                            "target_lang_translations": {
                                "ru": "Даже профессиональные певцы могут <w>фальшивить</w>, если не слышат себя на сцене."
                            }
                        }
                    ],
                    "synonyms": [
                        "out-of-tune",
                        "off-key"
                    ],
                    "antonyms": [
                        "in-tune"
                    ],
                    "common_phrases": [
                        "sound pitchy",
                        "bit pitchy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "frequently used in music criticism and talent shows"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Немного фальшивый или не попадающий в ноты при пении или игре на инструменте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "о пении или игре"
                            },
                            {
                                "target_lang_word": "нечистый",
                                "target_lang_sense_clarification": "об интонации"
                            },
                            {
                                "target_lang_word": "детонирующий",
                                "target_lang_sense_clarification": "музыкальный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4004ab8f-b61f-308e-9125-7359431c52a4",
                    "sense_definition": "Extremely dark or black in color, like the substance pitch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers found themselves in <w>pitchy</w> darkness once their torches went out.",
                            "target_lang_translations": {
                                "ru": "Исследователи оказались в <w>непроглядной</w> тьме, как только их факелы погасли."
                            }
                        },
                        {
                            "text": "The <w>pitchy</w> night made it impossible to see the trail ahead of us.",
                            "target_lang_translations": {
                                "ru": "<w>Черная как смоль</w> ночь сделала невозможным разглядеть тропу впереди нас."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitch-black",
                        "inky",
                        "stygian"
                    ],
                    "antonyms": [
                        "bright",
                        "luminous"
                    ],
                    "common_phrases": [
                        "pitchy darkness",
                        "pitchy black"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно темный или черный, как смола."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черный как смоль",
                                "target_lang_sense_clarification": "о цвете или темноте"
                            },
                            {
                                "target_lang_word": "непроглядный",
                                "target_lang_sense_clarification": "о темноте"
                            },
                            {
                                "target_lang_word": "смоляной",
                                "target_lang_sense_clarification": "литературно о цвете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7371b7ee-6e50-34d1-a88d-5854e6353811",
                    "sense_definition": "Having the qualities of or being covered with <w>pitch</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden boat had a <w>pitchy</w> residue along its hull to keep it watertight.",
                            "target_lang_translations": {
                                "ru": "На корпусе старой деревянной лодки был <w>смолистый</w> налет, обеспечивающий ее водонепроницаемость."
                            }
                        },
                        {
                            "text": "He tried to wash the <w>pitchy</w> substance off his hands after repairing the roof.",
                            "target_lang_translations": {
                                "ru": "Он пытался отмыть <w>смолистую</w> субстанцию с рук после ремонта крыши."
                            }
                        }
                    ],
                    "synonyms": [
                        "resinous",
                        "sticky"
                    ],
                    "common_phrases": [
                        "pitchy residue",
                        "pitchy substance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий свойствами смолы или покрытый смолой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смолистый",
                                "target_lang_sense_clarification": "содержащий смолу"
                            },
                            {
                                "target_lang_word": "засмоленный",
                                "target_lang_sense_clarification": "покрытый смолой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}