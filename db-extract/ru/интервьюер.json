                        "sense_id": "db35a226-51d6-3c02-9622-7c5e8d565c12",
                        "entry_id": "28cc1dca-050f-3acb-99db-3bd52487bf23",
                        "glosses": [
                            "журналист, интервьюирующий кого-либо; тот, кто берёт интервью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cec08d77-ed40-445f-bb7e-c693a64d31dd",
                                "sense_id": "db35a226-51d6-3c02-9622-7c5e8d565c12",
                                "text": "Отовсюду бегали в редакцию «Нового мира» журналисты, интервьюеры, хроникёры, репортёры."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5a5eefb-21c7-406b-9635-cfb9c2b6df3c",
                        "source_entry_id": "28cc1dca-050f-3acb-99db-3bd52487bf23",
                        "source_sense_id": "db35a226-51d6-3c02-9622-7c5e8d565c12",
                        "target_lang_word": "interviewer",
