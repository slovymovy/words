                            {
                                "example_id": "35f8dfbb-465f-4739-8ed9-b035f3c09b5d",
                                "sense_id": "7b62f076-6347-3e62-b0bf-79ab1a9e05c3",
                                "text": "Woland osadził swego dzianeta na kamienistym, posępnym, płaskim szczycie i odtąd jeźdźcy pojechali stępa, nasłuchując, jak podkowy ich rumaków biją o żwir i kamienie"
                            },
                            {
                                "example_id": "ea27ae11-3420-4262-a92c-1e04bd065c96",
                                "sense_id": "7b62f076-6347-3e62-b0bf-79ab1a9e05c3",
                                "text": "Nazajutrz przysłał pan hetman dla Wołodyjowskiego bułanego dzianeta wielkiej wartości"
                            }
                        ],
