                    },
                    {
                        "translation_id": "5e598b90-2dc0-4c68-97cf-06cb081384a2",
                        "source_entry_id": "3cb4e7da-3158-3a7e-b8fc-9dc1a21755c6",
                        "source_sense_id": "e17b3200-e69e-35f6-87cb-5b577d001ec8",
