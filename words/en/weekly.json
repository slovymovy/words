                        "weekly meeting",
                        "weekly basis",
                        "weekly report",
                        "weekly event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий один раз в неделю или каждую неделю.",
                        "zh": "指每周发生一次或每周都有的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "еженеде́льный",
                                "target_lang_sense_clarification": "происходящий каждую неделю"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "每周的",
                                "target_lang_sense_clarification": "形容词，表示每周一次"
