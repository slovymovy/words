    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48ec8573-d1e3-397f-b33f-9ac425d48d98",
                    "sense_definition": "Учащийся в начальной или средней школе.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "student_learner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В наш класс пришёл новый <w>ученик</w>, который сразу со всеми подружился.",
                            "target_lang_translations": {
                                "en": "A new <w>pupil</w> came to our class who immediately made friends with everyone.",
                                "zh": "我们班来了一位新<w>学生</w>，他很快就和大家成了朋友。"
                            }
                        },
                        {
                            "text": "Этот прилежный <w>ученик</w> всегда вовремя делает домашнее задание.",
                            "target_lang_translations": {
                                "en": "This diligent <w>student</w> always does his homework on time.",
                                "zh": "这位勤奋的<w>学生</w>总是按时完成家庭作业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "школьник",
                        "учащийся"
                    ],
                    "antonyms": [
                        "учитель"
                    ],
                    "common_phrases": [
                        "новый ученик",
                        "прилежный ученик",
                        "способный ученик",
                        "ученик первого класса"
                    ],
                    "target_lang_definitions": {
                        "en": "A student attending primary or secondary school.",
                        "zh": "在小学或中学就读的学生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pupil",
                                "target_lang_sense_clarification": "a child or young person in school"
                            },
                            {
                                "target_lang_word": "student",
                                "target_lang_sense_clarification": "general term for a learner at a school"
                            },
                            {
                                "target_lang_word": "schoolboy",
                                "target_lang_sense_clarification": "a male student at a school"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "学生",
                                "target_lang_sense_clarification": "在学校学习的人的通用称呼"
                            },
                            {
                                "target_lang_word": "小学生",
                                "target_lang_sense_clarification": "指小学阶段的学生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96236742-510b-3534-8846-6d0bc49d51a5",
                    "sense_definition": "Человек, который обучается какой-либо профессии или ремеслу под руководством мастера.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "student_learner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер внимательно следил за тем, как работает его <w>ученик</w>.",
                            "target_lang_translations": {
                                "en": "The master watched closely how his <w>apprentice</w> was working.",
                                "zh": "师傅仔细观察着他的<w>学徒</w>工作。"
                            }
                        },
                        {
                            "text": "Молодой <w>ученик</w> парикмахера уже умеет делать простые стрижки.",
                            "target_lang_translations": {
                                "en": "The young hairdresser's <w>apprentice</w> already knows how to do simple haircuts.",
                                "zh": "理发师的年轻<w>学徒</w>已经会剪简单的发型了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "мастер",
                        "наставник"
                    ],
                    "common_phrases": [
                        "взять в ученики",
                        "ученик мастера"
                    ],
                    "target_lang_definitions": {
                        "en": "A person learning a trade or craft under the guidance of a master.",
                        "zh": "在师傅指导下学习某种职业或手艺的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apprentice",
                                "target_lang_sense_clarification": "a person learning a skilled trade"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "学徒",
                                "target_lang_sense_clarification": "学习手艺或职业技能的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcfdd63a-ecb7-3203-bffd-32f2c6208678",
                    "sense_definition": "Последователь чьего-либо учения, научных, философских или религиозных взглядов.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "follower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Известный философ передал свои знания верным <w>ученикам</w>.",
                            "target_lang_translations": {
                                "en": "The famous philosopher passed on his knowledge to his faithful <w>disciples</w>.",
                                "zh": "那位著名的哲学家将他的知识传授给了忠实的<w>门徒</w>。"
                            }
                        },
                        {
                            "text": "Он считал себя <w>учеником</w> великого художника и продолжал его традиции.",
                            "target_lang_translations": {
                                "en": "He considered himself a <w>disciple</w> of the great artist and continued his traditions.",
                                "zh": "他视自己为那位伟大艺术家的<w>门徒</w>，并延续着他的传统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "последователь",
                        "сторонник",
                        "адепт"
                    ],
                    "antonyms": [
                        "учитель",
                        "основатель"
                    ],
                    "common_phrases": [
                        "верный ученик",
                        "духовный ученик",
                        "любимый ученик"
                    ],
                    "target_lang_definitions": {
                        "en": "A follower of someone's teachings, scientific, philosophical, or religious views.",
                        "zh": "追随某人的学说、科学、哲学或宗教观点的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disciple",
                                "target_lang_sense_clarification": "a devoted follower of a teacher or philosophy"
                            },
                            {
                                "target_lang_word": "follower",
                                "target_lang_sense_clarification": "an adherent to a person or set of ideas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "门徒",
                                "target_lang_sense_clarification": "追随导师或宗教领袖的人"
                            },
                            {
                                "target_lang_word": "追随者",
                                "target_lang_sense_clarification": "信奉某种思想或学说的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}