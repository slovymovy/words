                        "glosses": [
                            "рег. надеть недоуздок, оброть (на лошадь)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dddc0cde-23b3-4622-b4f1-e38ad5584b8f",
                                "sense_id": "bcfc7ea5-1019-3507-94ea-5323f4b857a9",
                                "text": "Поймал кобылу одну, обротал, а своего коня пустил; думаю, выведет."
                            },
                            {
                                "example_id": "7c5b6c19-fb50-4093-b91d-dc37cc814d94",
                                "sense_id": "bcfc7ea5-1019-3507-94ea-5323f4b857a9",
                                "text": "― Хотел обротать, так он меня кусанул зубами, как пёс!"
                            }
                        ]
                    },
                    {
                        "sense_id": "15a196dc-15b0-3655-9c16-0e0a2d6c58b4",
