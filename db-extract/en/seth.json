                                    {
                                        "sense_id": "2ca875bc-aa64-37f9-912d-8b03bd060bb4",
                                        "entry_id": "c2426351-09b2-398e-afe6-9ce6c529d738",
                                        "glosses": [
                                            "biblischer männlicher Eigenname; dritter Sohn von Adam und Eva"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13ea2cbc-42bd-4eb9-875c-5faa29be295e",
                                                "sense_id": "2ca875bc-aa64-37f9-912d-8b03bd060bb4",
                                                "text": "Von Seth anfangend wird die Nachkommenschaft bis zu Noah wiedergegeben, zu dessen Zeit alle anderen durch die Flut hinweggerafft wurden (1. Mo 5,3-8; 1. Chr 1,1; Lk 3,38)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Seth",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14e71978-ef23-3f33-a1e0-badad6964d93",
                                        "entry_id": "5101d4d0-91f2-36ad-bd28-4c390facc5dd",
                                        "glosses": [
                                            "Angehöriger einer indischen Händler- und Bankierskaste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd97ef73-d7e1-4cc7-b1aa-889e5e62d78d",
                                                "sense_id": "14e71978-ef23-3f33-a1e0-badad6964d93",
                                                "text": "„Die Rakshaks hatten in Morwada noch nie eine Wahl gewonnen, und zwar hauptsächlich wegen dieser Mistkerle, die alles mögliche seien, Seths, Akademiker, Flugpersonal, Rentner; am meisten jedoch ärgerte sich Bipin Bhonsle über die armen Chutiyas, die in den Hütten von Lalghar lebten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b32c06e-b620-4988-b1c2-9195ac675daf",
                        "source_entry_id": "602b722e-96a5-3618-ac04-c80c6e012337",
                        "source_sense_description": "the third son of Adam and Eve",
