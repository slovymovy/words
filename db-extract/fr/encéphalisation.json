                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e56f39fa-ba18-4979-b5ca-3e35667f5779",
                        "source_entry_id": "1bc0fe89-cd98-33c2-96e3-7923e8d1e23b",
