                "senses": [
                    {
                        "sense_id": "a0598c98-bce5-3ddb-ab44-25a328c14475",
                        "entry_id": "f5fdf2d0-e3c4-369e-9ee1-35e8847b7739",
                        "glosses": [
                            "jemand, der Ackerbau oder Viehhaltung betreibt; Bauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "580f707c-a92e-43c4-a3bc-7051855527b1",
                                "sense_id": "a0598c98-bce5-3ddb-ab44-25a328c14475",
                                "text": "„Kuhbauer Michael, 30, hingegen, der einzige Bio-Landwirt und attraktivste der neun Herren, flirtete wild mit der von Markus abgewiesenen Bianca.“"
                            },
                            {
                                "example_id": "7afe7f4d-4031-4ab3-91e0-b36102f216b5",
                                "sense_id": "a0598c98-bce5-3ddb-ab44-25a328c14475",
                                "text": "„Ein Kuhbauer in Deutschland bekommt für einen Liter Milch im Moment weniger Geld, als im Supermarkt bald eine leere Plastiktüte kostet.“"
                            },
                            {
                                "example_id": "826a31df-75cb-4cd1-a8ef-d49931312f32",
                                "sense_id": "a0598c98-bce5-3ddb-ab44-25a328c14475",
                                "text": "„Auch Kuhbauer Horst im Bergischen Land und der ‚fröhliche Friese‘ Gerold aus Niedersachsen sind in Sachen Osterrituale auf sich alleine gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4e36ca7-a93e-3b7f-b60f-116a28e7c24a",
                        "entry_id": "f5fdf2d0-e3c4-369e-9ee1-35e8847b7739",
                        "glosses": [
                            "Mensch mit schlechten Manieren"
                        ],
                        "tags": [
                            "Schimpfwort"
                        ],
                        "examples": [
                            {
                                "example_id": "0c489e2a-5a6a-497a-b15f-348b2e75bd03",
                                "sense_id": "e4e36ca7-a93e-3b7f-b60f-116a28e7c24a",
                                "text": "„Um Himmels willen, Greggy, dieser ungehobelte Klotz, dieser Kuhbauer ist Ihr Bruder? Nicht möglich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
