                ],
                "senses": [
                    {
                        "sense_id": "56514c86-3c51-38d4-8602-0c814600f9c9",
                        "entry_id": "0911df4c-68ae-3cf0-bdba-2de489ef9f03",
                        "glosses": [
                            "Schwert eines Samurai"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47e7f7bf-fb67-47ee-8ae9-89865cb0b05d",
                                "sense_id": "56514c86-3c51-38d4-8602-0c814600f9c9",
                                "text": "„Die heutigen Yakuza sind findige Unternehmer, eher »Geschäftsleute mit Gewehren« als ein Haufen tätowierter Strolche in weißen Anzügen, die Samuraischwerter schwingen.“"
                            },
                            {
                                "example_id": "0c10bb4a-bcac-4ef7-85dc-05ea74072532",
                                "sense_id": "56514c86-3c51-38d4-8602-0c814600f9c9",
                                "text": "„Kondenswasser tropft von der Klinge von Bruce Lees Samuraischwert.“"
                            },
                            {
                                "example_id": "a7f6faa8-e6d5-4ea8-96c1-806af2fa82e4",
                                "sense_id": "56514c86-3c51-38d4-8602-0c814600f9c9",
                                "text": "„Wenn mein Dad von den Vernetzungsmöglichkeiten hier unten wüsste, würde er wahrscheinlich auf der Stelle Rattengift schlucken und sich in ein Samuraischwert stürzen.“"
                            },
                            {
                                "example_id": "32079b87-eac6-49cc-8a06-3bca954254a3",
                                "sense_id": "56514c86-3c51-38d4-8602-0c814600f9c9",
                                "text": "„Mit der Spitze seines Samuraischwerts lupfte Court die AK aus dem Schoß des Mannes und bugsierte sie aus seiner Reichweite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
