                },
                {
                    "sense_id": "07a47ba8-f9b7-3352-b959-a3883bd1b273",
                    "sense_definition": "Вырастить новый сорт растений или породу животных путём селекции",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учёные смогли <вывести> сорт пшеницы, устойчивый к холоду.",
                            "target_lang_translations": {
                                "en": "Scientists were able to <develop> a variety of wheat resistant to cold.",
                                "nl": "Wetenschappers zijn erin geslaagd een tarweras te <kweken> dat bestand is tegen kou."
                            }
                        },
                        {
                            "text": "В этом питомнике хотят <вывести> новую породу собак.",
                            "target_lang_translations": {
                                "en": "In this kennel, they want to <breed> a new breed of dogs.",
                                "nl": "In deze kennel willen ze een nieuw hondenras <fokken>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "вывести сорт",
                        "вывести породу",
                        "вывести гибрид"
