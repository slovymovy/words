        "fr-extract.jsonl": [
            {
                "entry_id": "44e08dc1-3a4d-3f4a-a90b-b6759864bd55",
                "word": "toxine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "131b86fc-39a5-4a4e-b9ed-5d99036aaebd",
                        "entry_id": "44e08dc1-3a4d-3f4a-a90b-b6759864bd55",
                        "tags": [
                            "plural"
                        ],
                        "form": "toxines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd4e734e-8766-3d6f-a652-189de0927ea2",
                        "entry_id": "44e08dc1-3a4d-3f4a-a90b-b6759864bd55",
                        "glosses": [
                            "Poison produit par certains microbes, par certaines décompositions organiques ou par certains êtres vivants, tels que les bactéries, les insectes, les plantes et les reptiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0978a881-dfb1-4274-8c0f-7770527851db",
                                "sense_id": "cd4e734e-8766-3d6f-a652-189de0927ea2",
                                "text": "Certains auteurs ont estimé que les plantes déversent des toxines dans le sol. Ces toxines pourraient être nuisibles à ces plantes elles-mêmes, empêchant leur conservation à la même place, ou à d’autres plantes, empêchant leur installation à cet endroit."
                            },
                            {
                                "example_id": "3cfa1ae1-8bb8-48a4-9a7f-1c6fcec0b776",
                                "sense_id": "cd4e734e-8766-3d6f-a652-189de0927ea2",
                                "text": "La scarlatine est une angine streptococcique accompagnée d’une éruption cutanée due à la sécrétion de toxine."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f448932-d7f8-3c99-9ece-293529836039",
                        "entry_id": "44e08dc1-3a4d-3f4a-a90b-b6759864bd55",
                        "glosses": [
                            "Substance inconnue."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "65c9c96d-102c-417f-9db6-9bc957564d27",
                                "sense_id": "5f448932-d7f8-3c99-9ece-293529836039",
                                "text": "Depuis que j’avais laissé pénétrer en moi ce sentiment nouveau il me semblait qu’une toxine était entrée dans mon sang."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6923d6e-e42f-4515-af57-a8af9507a77d",
                        "source_entry_id": "44e08dc1-3a4d-3f4a-a90b-b6759864bd55",
                        "target_lang_word": "Giftstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Giftstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0f7d714-8c93-3010-a5ae-e4de2da12b06",
                                        "entry_id": "94adf9e0-ec41-320a-b4dc-dbb58e360d47",
                                        "glosses": [
                                            "toxische chemische Verbindung oder toxisches Stoffgemisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef194082-b620-4ef9-b0f4-8a89985b31df",
                                                "sense_id": "f0f7d714-8c93-3010-a5ae-e4de2da12b06",
                                                "text": "Mit dem Abwasser gelangen auch viele Giftstoffe in den Fluss."
                                            },
                                            {
                                                "example_id": "f947026e-48db-485c-b69b-cd625e0478c5",
                                                "sense_id": "f0f7d714-8c93-3010-a5ae-e4de2da12b06",
                                                "text": "„Auch wegen der Giftstoffe im Fleisch hat der Walfang seine Bedeutung für die Nahrungsbeschaffung gänzlich verloren.“"
                                            },
                                            {
                                                "example_id": "8f50c6a2-baab-4c66-9d4a-878c733b7fcb",
                                                "sense_id": "f0f7d714-8c93-3010-a5ae-e4de2da12b06",
                                                "text": "„Der eigentliche Giftstoff in diesem Pilz ist Monomethylhydrazin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d51a8d3d-7a70-4fe3-873c-cfff462a8fef",
