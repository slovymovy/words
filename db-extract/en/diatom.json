                                            {
                                                "example_id": "a3c399dd-3ace-44b5-b664-6f21da602536",
                                                "sense_id": "b158a5c2-fa9e-34d4-867c-f571d81847e5",
                                                "text": "Amerikaanse onderzoekers hebben een alg gemaakt die groeit in het donker. In de alg, de eencellige kiezelwier Phaeodactylum tricornutum, is een mensen-gen, geïsoleerd uit rode bloedlichaampjes, ingebouwd dat codeert voor de productie van glucose...."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abd781f8-63fc-403b-8e26-86453663fa85",
