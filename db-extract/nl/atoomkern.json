                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noyau atomique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d765c45-c3f6-3334-908b-d7e589e55d64",
                                        "entry_id": "05902125-7b44-3830-bf74-620a6bcf908a",
                                        "glosses": [
                                            "Partie centrale de l’atome constituée de protons et de neutrons, portant une charge positive et concentrant presque toute la masse de l'atome."
                                        ],
                                        "tags": [
                                            "Physique nucléaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d917054-8455-4c64-9394-4db6ddc05858",
                                                "sense_id": "9d765c45-c3f6-3334-908b-d7e589e55d64",
                                                "text": "La cohésion du noyau atomique est assurée par l’interaction forte, qui attire les nucléons entre eux."
                                            },
                                            {
                                                "example_id": "e27d22ea-f76d-4492-ba90-9ede3187c31d",
                                                "sense_id": "9d765c45-c3f6-3334-908b-d7e589e55d64",
                                                "text": "Le noyau atomique est constitué d’un nombre varié de protons et de neutrons. Par exemple, le noyau d’un atome d’hydrogène se compose d’un unique proton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
