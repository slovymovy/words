                                "sense_id": "24f13dfa-9da1-3632-a338-b39dba9dc37b",
                                "text": "Nu zitten er weer spetters op mijn zojuist gezeemde raam!"
                            }
                        ]
                    },
                    {
                        "sense_id": "5cf43dd2-a426-3fa7-9202-cc227c77293e",
                        "entry_id": "c1539833-b6d9-3aff-8c56-77564a62f853",
                        "glosses": [
