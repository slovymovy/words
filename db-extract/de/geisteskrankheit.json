                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "051b101b-7c92-492c-b469-b8eb1455c28c",
                                                "sense_id": "72b41fca-a512-3751-9859-79ed37c27f6c",
                                                "text": "Such studies show that geniuses are not any more likely to suffer from mental illness than the rest of us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaf674fb-d436-3626-83be-34dfecd765ce",
                                        "entry_id": "97a9aa17-07d1-37cf-a565-732fad0349ce",
                                        "glosses": [
                                            "A mental disorder."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4de6ac8-fcfb-44f6-9b4b-7cbbdaf24260",
                                                "sense_id": "aaf674fb-d436-3626-83be-34dfecd765ce",
                                                "text": "Epilepsy is not a mental illness. It is caused by electrical changes in the brain."
                                            }
