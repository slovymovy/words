                "senses": [
                    {
                        "sense_id": "8459871e-839b-3fd9-91c0-a96b1256b05b",
                        "entry_id": "6a601d3d-109b-372a-9cd6-af7b01da6208",
                        "glosses": [
                            "niezgodny z czymś, niedokładnie czemuś odpowiadający"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "1efaa58d-8c6c-4f9c-8311-c9d733a405a5",
                                "sense_id": "8459871e-839b-3fd9-91c0-a96b1256b05b",
                                "text": "Niepokoi mnie twoje zachowanie. Twój wybuch złości był nieadekwatny do sytuacji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f3cb433-119b-40ee-9e1a-2156a10f40a2",
                        "source_entry_id": "6a601d3d-109b-372a-9cd6-af7b01da6208",
                        "source_sense_id": "8459871e-839b-3fd9-91c0-a96b1256b05b",
                        "target_lang_word": "inadequate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inadequate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                        "entry_id": "3a5a2a55-d4d7-3311-8712-66d3e270d146",
                                        "glosses": [
                                            "Not adequate; lacking in quality or quantity required; insufficient for a purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c761ec15-37af-45c8-b47e-7479dafabf97",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "inadequate resources"
                                            },
                                            {
                                                "example_id": "6e33d876-59b1-49ae-9f42-30adc64342ef",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "inadequate representation"
                                            },
                                            {
                                                "example_id": "2f89d0a5-da60-4628-9dc8-3261b27aea1d",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "I had not yet seen Mrs. Kennedy. I wondered with what inadequate words I could try to console her."
                                            },
                                            {
                                                "example_id": "9715dfe0-96f7-4196-96f8-746c27ba1fc7",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "In a convulsion that has caught many in Brazil and beyond by surprise, waves of protesters denounced their leaders for dedicating so many resources to cultivating Brazil’s global image by building stadiums for international events, when basic services like education and health care remain woefully inadequate."
                                            },
                                            {
                                                "example_id": "7becd9ad-c29d-4add-a951-e138fc9240e7",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "By the 21st century, the clearly inadequate facilities needed to be replaced, so the area was rebuilt and modernised between 2009-13 as part of regeneration efforts focused upon the wider area."
                                            },
                                            {
                                                "example_id": "cdad34a6-5cb4-4977-a71e-4da2db3559b0",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "“Russia is a terrorist country whose leader is an inadequate person”. Putin's failings are evident to the “entire world”, he said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inadequate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30b6cbb4-a8f0-3ff2-9382-a5c3c818e0d6",
                                        "entry_id": "58260bd8-afa9-32ac-bd0f-47b183153a75",
                                        "glosses": [
                                            "A person who is inadequate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dceda84b-11c3-477a-b53b-215db70f90ad",
                                                "sense_id": "30b6cbb4-a8f0-3ff2-9382-a5c3c818e0d6",
                                                "text": "Thus, at some critical level of unemployment, “the unemployed” becomes a negative reference group of inadequates, the hardcore unemployed […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2b643ef-a37a-43e0-ba0d-680efa78d0c1",
                        "source_entry_id": "6a601d3d-109b-372a-9cd6-af7b01da6208",
                        "source_sense_id": "8459871e-839b-3fd9-91c0-a96b1256b05b",
                        "target_lang_word": "out-of-the-way",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "out-of-the-way",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ff5a5f6-6664-3749-b147-ba69eb230c9d",
                                        "entry_id": "1c5b7954-f78f-3c77-8486-1ca302b683e8",
                                        "glosses": [
                                            "Remote or secluded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13cc9186-ed96-4e4a-b9f2-7371d4309cd1",
                                                "sense_id": "6ff5a5f6-6664-3749-b147-ba69eb230c9d",
                                                "text": "I know this out-of-the-way hotel where we could stay."
                                            },
                                            {
                                                "example_id": "98375b31-6209-4f3e-9446-e5d3a2371cc4",
                                                "sense_id": "6ff5a5f6-6664-3749-b147-ba69eb230c9d",
                                                "text": "It was from no choice of my own that I was brought up in an out-of-the-way pallazzo, with nothing to do but to fall in love."
                                            },
                                            {
                                                "example_id": "d2f4724b-210e-455a-9cc9-ce7817887e3c",
                                                "sense_id": "6ff5a5f6-6664-3749-b147-ba69eb230c9d",
                                                "text": "“Even Darjiling is a little out-of-the-way hole.”"
                                            },
                                            {
                                                "example_id": "191c39c2-a589-40d8-b4f5-9457b819b3d1",
                                                "sense_id": "6ff5a5f6-6664-3749-b147-ba69eb230c9d",
                                                "text": "Passenger numbers had been rising sharply. But the replacement of the services by buses, which take far longer because of the number of stations in out-of-the-way villages on the route, will ensure they plummet again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f315a7d-2125-463d-9bc0-a35835e9ecd3",
                        "source_entry_id": "6a601d3d-109b-372a-9cd6-af7b01da6208",
                        "source_sense_id": "8459871e-839b-3fd9-91c0-a96b1256b05b",
                        "target_lang_word": "inadecuado",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inadecuado",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "1451ce6f-4736-31cd-a56f-5ecc4b61a767",
                                        "entry_id": "cb47f653-f62a-35b9-851c-edcac1efb1b3",
                                        "glosses": [
                                            "Que no es adecuado."
                                        ],
                                        "tags": [],
                                        "examples": [],
