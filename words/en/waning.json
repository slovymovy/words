                        "waning of influence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенное уменьшение размера, силы, важности или интенсивности; спад, угасание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угасание",
