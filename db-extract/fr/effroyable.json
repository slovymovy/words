                    {
                        "translation_id": "0b1ff4fb-ac50-45c4-ad91-6dbf1df9d430",
                        "source_entry_id": "fd47b6b4-7f5e-323a-8418-f25adf2dd6d3",
                        "target_lang_word": "fearful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
