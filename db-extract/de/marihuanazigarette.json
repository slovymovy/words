                            {
                                "example_id": "6970dfa6-4e01-4582-a6ef-fde654f5c89d",
                                "sense_id": "da0f1360-460e-3afc-a9e0-1574adaaae73",
                                "text": "„Abel nahm zwei Marihuanazigaretten aus der Tasche seines Hausmantels.“"
                            },
                            {
                                "example_id": "a8e3070b-286f-4d1e-b23d-1038efd4e74f",
                                "sense_id": "da0f1360-460e-3afc-a9e0-1574adaaae73",
                                "text": "„Lee drehte den Toten die Taschen nach außen, warf Springmesser und Marihuanazigaretten aufs Pflaster, dorthin, wo sich keine Blutlachen ausbreiteten.“"
                            }
                        ],
