                                "target_senses": [
                                    {
                                        "sense_id": "cb5e1f18-1280-3e8a-87f4-b876538e0b42",
                                        "entry_id": "393fbf92-ab6f-3619-a378-cace08162090",
                                        "glosses": [
                                            "definizione mancante; se vuoi, aggiungila tu"
                                        ],
                                        "tags": [],
