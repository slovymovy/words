                "senses": [
                    {
                        "sense_id": "a5181480-2caa-38ca-a141-e583e9040797",
                        "entry_id": "afb86990-1a78-34e1-8d83-8da1e44776db",
                        "glosses": [
                            "Wort, auf das sich satzintern oder satzübergreifend ein sprachlicher Ausdruck bezieht (zum Beispiel, um Kongruenz herzustellen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b02e73e-51aa-479a-9c5c-dbe7b7db7d93",
                                "sense_id": "a5181480-2caa-38ca-a141-e583e9040797",
                                "text": "„Die übrigen Pronomen richten sich im Genus nach ihrem Bezugswort; das bedeutet, daß sie nicht wie Substantive über e i n e n Satz von Flexiven verfügen, sondern mit Flexivsätzen, die sich für maskulin, feminin und neutral unterscheiden, verbunden werden.“"
                            },
                            {
                                "example_id": "d7f46a16-bbb7-4c0b-a579-24103e954c93",
                                "sense_id": "a5181480-2caa-38ca-a141-e583e9040797",
                                "text": "„Die Verhältniswörter bestimmen auch den Kasus ihrer Bezugswörter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
