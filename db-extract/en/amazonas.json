                                                "sense_id": "4983e320-440f-3462-8dbf-f0226947a61a",
                                                "text": "Der Amazonas fließt durch die Regenwälder Brasiliens."
                                            },
                                            {
                                                "example_id": "f0a3d9a1-59de-45b7-8bb2-7a30ddf08494",
                                                "sense_id": "4983e320-440f-3462-8dbf-f0226947a61a",
                                                "text": "„Nach alten Berichten gebe es einen Kanal zwischen den Strömen Orinoko und Amazonas.“"
                                            },
                                            {
                                                "example_id": "c1d253d8-34db-4c37-bba1-3f9abe7e31e7",
                                                "sense_id": "4983e320-440f-3462-8dbf-f0226947a61a",
                                                "text": "„Aber wir verstanden einander nicht, redeten einfach nicht dieselbe Sprache, egal, was ich tat – bis er über dem Amazonas abstürzte und mit ihm jede weitere Chance auf Verständigung verschwand.“"
                                            }
