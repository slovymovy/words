                                                "example_id": "eacea5e4-081a-4d37-8ed2-a319ae582a48",
                                                "sense_id": "fa2b6fc5-ba02-3dac-bca4-9a59ea7ad9b9",
                                                "text": "Removing categories orphans pages from the main category tree."
                                            },
