                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il met la bouteille au réfrigérateur pour la <w>refroidir</w> avant le dîner."
                        },
                        {
                            "text": "Le vent du nord a vite <w>refroidi</w> la pièce restée ouverte."
                        }
                    ],
                    "synonyms": [
