            "senses": [
                {
                    "sense_id": "e1ef4635-9e5f-355f-a583-36320c48c167",
                    "sense_definition": "Goede wensen jegens iemand uitspreken, gewoonlijk naar aanleiding van een bijzondere gebeurtenis.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd van alle kanten <w>gelukgewenst</w> met de geboorte van de tweelingen.",
                            "target_lang_translations": {
                                "en": "He was <w>congratulated</w> from all sides on the birth of the twins."
                            }
                        },
                        {
                            "text": "We moeten de winnaar van de wedstrijd nog persoonlijk <w>gelukwensen</w>.",
                            "target_lang_translations": {
                                "en": "We still need to <w>congratulate</w> the winner of the competition in person."
                            }
                        }
                    ],
                    "synonyms": [
                        "feliciteren"
                    ],
                    "common_phrases": [
                        "iemand hartelijk gelukwensen"
                    ],
