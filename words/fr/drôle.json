                    "sense_definition": "Qui amuse, qui fait rire ; comique.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "humour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce film est vraiment très <w>drôle</w>, toute la famille a ri du début à la fin.",
                            "target_lang_translations": {
                                "en": "This film is really <w>funny</w>, the whole family laughed from start to finish.",
                                "ru": "Этот фильм и правда очень <w>смешной</w>, вся семья смеялась от начала до конца.",
                                "nl": "Deze film is echt heel <w>grappig</w>, de hele familie heeft van begin tot eind gelachen.",
                                "de": "Dieser Film ist wirklich sehr <w>lustig</w>, die ganze Familie hat vom Anfang bis zum Ende gelacht.",
                                "pl": "Ten film jest naprawdę bardzo <w>zabawny</w>, cała rodzina śmiała się od początku do końca.",
                                "it": "Questo film è davvero molto <w>divertente</w>, tutta la famiglia ha riso dall'inizio alla fine.",
                                "cs": "Ten film je opravdu moc <w>legrační</w>, celá rodina se smála od začátku do konce.",
                                "tr": "Bu film gerçekten çok <w>komik</w>, tüm aile baştan sona güldü.",
                                "es": "Esta película es realmente muy <w>graciosa</w>, toda la familia se rió de principio a fin.",
                                "zh": "这部电影真的很<w>好笑</w>，全家人从头笑到尾。"
                            }
                        },
                        {
                            "text": "Il raconte toujours une histoire <w>drôle</w> pour détendre ses collègues avant une réunion.",
                            "target_lang_translations": {
                                "en": "He always tells a <w>funny</w> story to relax his colleagues before a meeting.",
                                "ru": "Перед совещанием он всегда рассказывает коллегам <w>смешную</w> историю, чтобы их расслабить.",
                                "nl": "Voor een vergadering vertelt hij altijd een <w>grappig</w> verhaal om zijn collega's te ontspannen.",
                                "de": "Vor einer Besprechung erzählt er seinen Kollegen immer eine <w>lustige</w> Geschichte, um sie aufzulockern.",
                                "pl": "Przed spotkaniem zawsze opowiada współpracownikom <w>zabawną</w> historyjkę, żeby ich rozluźnić.",
                                "it": "Prima di una riunione racconta sempre una storia <w>divertente</w> per rilassare i colleghi.",
                                "cs": "Před poradou kolegům vždy vypráví nějakou <w>vtipnou</w> historku, aby se uvolnili.",
                                "tr": "Toplantıdan önce iş arkadaşlarını rahatlatmak için her zaman <w>komik</w> bir hikâye anlatır.",
                                "es": "Antes de una reunión, siempre cuenta alguna historia <w>graciosa</w> para relajar a sus compañeros.",
                                "zh": "每次开会前，他都会讲个<w>好笑</w>的故事，让同事们放松一下。"
                            }
                        }
