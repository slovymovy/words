                                    {
                                        "sense_id": "69b69612-a8bf-3264-b37c-e823d9ceef2e",
                                        "entry_id": "ababbe61-0c3f-36cc-b4df-713b4e51f450",
                                        "glosses": [
                                            "A neopagan religion that was first popularized by books written in 1949, 1954, and 1959 by Englishman Gerald Gardner, involving the worship of a horned male god and a moon goddess, the observance of eight Sabbats, and the performance of various rituals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd1afbf2-0f00-45c9-9e8d-d98ad0769013",
                        "source_entry_id": "28fb263c-b22d-3b50-b0f3-3fcacd41eb2e",
                        "source_sense_id": "6f87e7ef-17af-398e-8306-82050e9f552a",
                        "target_lang_word": "Wicca",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wicca",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55a58785-57fd-3439-8424-30e746c4adfb",
                                        "entry_id": "993f1733-804a-3573-bdd2-6ef887e3d918",
                                        "glosses": [
                                            "Religion néo-païenne lunaire, attentive à l’écologie de la planète, fondée par le théosophe Gerald Brosseau Gardner entre 1939 et 1949."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a64d4eb2-88a8-49d3-aafe-a7b0152dd086",
                                                "sense_id": "55a58785-57fd-3439-8424-30e746c4adfb",
                                                "text": "Pratiquer la Wicca."
                                            },
                                            {
                                                "example_id": "218edb7d-70da-46be-be93-aae361ee93c5",
                                                "sense_id": "55a58785-57fd-3439-8424-30e746c4adfb",
                                                "text": "La Wicca francophone."
                                            },
                                            {
                                                "example_id": "d8213c37-8d8b-4734-ba40-139a6ca92b10",
                                                "sense_id": "55a58785-57fd-3439-8424-30e746c4adfb",
                                                "text": "La tradition de la Wicca aradrienne remonte à 1999."
                                            },
                                            {
                                                "example_id": "aff37dde-98df-428a-9028-2c4e94e3e6de",
                                                "sense_id": "55a58785-57fd-3439-8424-30e746c4adfb",
                                                "text": "Le magma originel. Depuis les vingt dernières années, néanmoins, quelques chercheurs ont éclairé la pratique occidentale de la sorcellerie, de la magie et du paganisme. Dans son ouvrage « Emerging Network », traitant par ailleurs des mouvements du nouvel âge, le sociologue Micheal York consacre tout un chapitre au mouvement de la sorcellerie néo-païenne et à la Wicca. […] Hutton affirme ainsi que la Wicca est en fait un produit du XXᵉ siècle et non une survivance comme l’a prétendu Murray. Il est question, donc, d’une résurgence et d’un renouveau païen et magique dans le monde occidental moderne plutôt que de continuité."
                                            },
                                            {
                                                "example_id": "c25e95af-b38d-480a-b80b-15a08588c97b",
                                                "sense_id": "55a58785-57fd-3439-8424-30e746c4adfb",
                                                "text": "La religion qui gagne le plus de membres aux États-Unis est une religion non chrétienne fondée sur les traditions celtiques de sorcellerie (le Wicca) !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
