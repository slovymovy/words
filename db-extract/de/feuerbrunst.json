                            {
                                "example_id": "6eef8f3c-a290-4401-a4e6-ef17c9cd07a2",
                                "sense_id": "9dcd6f17-70fa-3120-8533-344329a8a89c",
                                "text": "„Sie warnen vor dem Tag des Jüngsten Gerichts am 21. Mai, die Zahl 2012 ist durchgestrichen worden, darunter steht 2011. Der Chef des Radionetzwerkes, hat den endgültigen Weltuntergang durch eine Feuerbrunst für den 21. Oktober vorausgesagt.“"
                            }
                        ],
