            {
                "entry_id": "24acc2da-2bcd-305e-806e-51e820909dfd",
                "word": "others",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea2a14b8-3976-3091-8b04-ed5d7c52d022",
                        "entry_id": "24acc2da-2bcd-305e-806e-51e820909dfd",
                        "glosses": [
                            "Other people."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "49e81813-b053-404f-bad3-e57d50c37a66",
                                "sense_id": "ea2a14b8-3976-3091-8b04-ed5d7c52d022",
                                "text": "I treat others like I treat myself."
                            },
                            {
                                "example_id": "18aba3b4-8567-4c2f-bf61-10192f80c0af",
                                "sense_id": "ea2a14b8-3976-3091-8b04-ed5d7c52d022",
                                "text": "Javik: Do not care what others think. Do what you must."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d0789f2-bf77-32c5-a224-282fcdf5b686",
                        "entry_id": "24acc2da-2bcd-305e-806e-51e820909dfd",
                        "glosses": [
                            "Those remaining after one or more people or items have left, or done something else, or been excluded."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "193fc9ff-4037-4358-b830-6b042d3da5ae",
                                "sense_id": "7d0789f2-bf77-32c5-a224-282fcdf5b686",
                                "text": "Two decided to hide, the others surrendered. I kept two special jars and threw away all the others."
                            },
                            {
                                "example_id": "e9d8d6ed-d090-4e3b-8e41-2e71a6f7c776",
                                "sense_id": "7d0789f2-bf77-32c5-a224-282fcdf5b686",
                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track.[…]Their example was followed by others at a time when the master of Mohair was superintending in person the docking of some two-year-olds, and equally invisible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c79185d-0a94-464c-9589-57bee71a2b13",
                        "source_entry_id": "24acc2da-2bcd-305e-806e-51e820909dfd",
                        "source_sense_description": "other people",
                        "target_lang_word": "ostatní",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ostatní",
