                    {
                        "translation_id": "5315fae6-eca6-4a45-8166-c6a82ce42f6e",
                        "source_entry_id": "d78a27e7-7715-38c5-a966-037cb3c56867",
                        "source_sense_id": "78e9f3ff-c27e-3a3d-a148-7e41cf94c5af",
                        "source_sense_description": "van een persoon dat deze genegen is zich aan te passen aan andere mensen",
                        "target_lang_word": "accommodant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accommodant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                        "entry_id": "1389b203-b12f-3425-a846-41fb65cffbd2",
                                        "glosses": [
                                            "Qui s’accommode à tous et à tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f99e91-6637-4769-85b0-cdb97902fb42",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "C’est un homme accommodant, d’un esprit fort accommodant."
                                            },
                                            {
                                                "example_id": "320f525c-4cad-4106-ae59-8dbed7d7bb2a",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "Une humeur, une personne accommodante."
                                            },
                                            {
                                                "example_id": "24fbaae2-f468-4b80-a64d-1b179b5276f1",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "Ce marchand est fort accommodant."
                                            },
                                            {
                                                "example_id": "4972dad4-356b-4c74-a7ec-3d1aa9ce393b",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "« Ces Parisiens, se dit-il, sont les gens les plus accommodants du monde. On les juge mal dans nos provinces. »"
                                            },
                                            {
                                                "example_id": "7cb59238-29b4-4f72-9646-e6d50d68706e",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "Julius sourit avec une accommodante condescendance et, pour changer de sujet, demande à son beau-frère des nouvelles de sa sciatique, qu’il appelle par erreur : son lumbago."
                                            },
                                            {
                                                "example_id": "cf03a790-6023-46d6-bfea-e26bfb4a65ee",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "Nous lui passâmes cette niaiserie. Mais nous n’étions pas toujours aussi accommodantes ; quand un sujet nous intéressait, nous discutions ferme."
                                            },
                                            {
                                                "example_id": "1222dfee-d5fe-436c-9f32-7636da6f0842",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "Les lentilles ont un effet de mise au repos accommodant parfois supérieur aux cycloplégies qui ont pu être réitérées lors du suivi habituel du patient, y compris chez l’adulte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accommodant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "763604ce-eaf2-3d98-ab5e-74dea4b11d63",
                                        "entry_id": "16bc7672-6023-36a9-9271-06b25328d8b8",
                                        "glosses": [
                                            "Participe présent du verbe accommoder."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23c38f83-a5f5-4003-960f-0985d50cffd0",
                                                "sense_id": "763604ce-eaf2-3d98-ab5e-74dea4b11d63",
                                                "text": "A la différence des gens de condition élevée, il n’a pas été formé à une culture classique qui a pour effet de dénationaliser les intelligences, si j’ose ainsi dire, en les accommodant à la manière grecque et latine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
