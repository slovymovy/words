    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d603aaf-349a-33ad-a34c-d609d1426dbf",
                    "sense_definition": "Stan psychiczny polegający na całkowitym przekonaniu, że coś jest prawdą; brak wątpliwości.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mam stuprocentową <w>pewność</w>, że zamknąłem drzwi przed wyjściem.",
                            "target_lang_translations": {
                                "ru": "У меня стопроцентная <w>уверенность</w> в том, что я закрыл дверь перед уходом.",
                                "en": "I have one hundred percent <w>certainty</w> that I locked the door before leaving.",
                                "zh": "我百分之百<w>确定</w>出门前把门锁好了。"
                            }
                        },
                        {
                            "text": "Musisz mieć absolutną <w>pewność</w>, zanim podejmiesz tę trudną decyzję.",
                            "target_lang_translations": {
                                "ru": "Тебе нужна абсолютная <w>уверенность</w>, прежде чем принять это трудное решение.",
                                "en": "You must have absolute <w>certainty</w> before you make this difficult decision.",
                                "zh": "在做出这个艰难的决定之前，你必须有绝对的<w>把握</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "przekonanie"
                    ],
                    "antonyms": [
                        "niepewność",
                        "wątpliwość"
                    ],
                    "common_phrases": [
                        "mieć pewność",
                        "z całą pewnością",
                        "nabrać pewności",
                        "dla pewności"
                    ],
                    "target_lang_definitions": {
                        "ru": "Психическое состояние, заключающееся в полной убежденности в истинности чего-либо; отсутствие сомнений.",
                        "en": "A mental state of being completely convinced that something is true; absence of doubt.",
                        "zh": "完全相信某事属实、毫无疑问的心理状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уверенность",
                                "target_lang_sense_clarification": "отсутствие сомнений"
                            },
                            {
                                "target_lang_word": "убеждённость",
                                "target_lang_sense_clarification": "твердая вера во что-то"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "certainty",
                                "target_lang_sense_clarification": "freedom from doubt"
                            },
                            {
                                "target_lang_word": "sureness",
                                "target_lang_sense_clarification": "feeling of conviction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "把握",
                                "target_lang_sense_clarification": "确信、胜算"
                            },
                            {
                                "target_lang_word": "确信",
                                "target_lang_sense_clarification": "坚定的信念"
                            },
                            {
                                "target_lang_word": "确定",
                                "target_lang_sense_clarification": "无疑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "331250be-aff5-34c1-9d18-1664083777f6",
                    "sense_definition": "Swoboda i zdecydowanie w działaniu, poruszaniu się lub mówieniu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przemawiał z taką <w>pewnością</w>, że wszyscy na sali mu uwierzyli.",
                            "target_lang_translations": {
                                "ru": "Он говорил с такой <w>уверенностью</w>, что все в зале ему поверили.",
                                "en": "He spoke with such <w>confidence</w> that everyone in the room believed him.",
                                "zh": "他演讲时充满了<w>自信</w>，以至于全场的人都相信了他。"
                            }
                        },
                        {
                            "text": "Jej ruchy na korcie tenisowym cechowała duża siła i <w>pewność</w>.",
                            "target_lang_translations": {
                                "ru": "Её движения на теннисном корте отличались большой силой и <w>уверенностью</w>.",
                                "en": "Her movements on the tennis court were marked by great strength and <w>assurance</w>.",
                                "zh": "她在网球场上的动作兼具强大的力量与<w>沉稳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swoboda",
                        "zdecydowanie"
                    ],
                    "antonyms": [
                        "niepewność"
                    ],
                    "common_phrases": [
                        "pewność siebie",
                        "z dużą pewnością"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свобода и решительность в действиях, движениях или речи.",
                        "en": "Ease, poise, and decisiveness in action, movement, or speech.",
                        "zh": "在行动、举止或说话时表现出的沉着、果断和自信。"
