{
    "word_family": [
        "подовый"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "86a6af6f-0310-3996-8fd1-b064655f1b70",
                    "sense_definition": "Указывает на нахождение ниже предмета или движение в пространство ниже чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кошка любит спать <под> столом.",
                            "target_lang_translations": {
                                "en": "The cat likes to sleep <w>under</w> the table.",
                                "zh": "猫喜欢<w>在</w>桌子下面睡觉。"
                            }
                        },
                        {
                            "text": "Мы спрятались от дождя <под> дерево.",
                            "target_lang_translations": {
                                "en": "We hid from the rain <w>under</w> a tree.",
                                "zh": "我们躲到树<w>下</w>避雨。"
                            }
                        },
                        {
                            "text": "Положи свои вещи <под> кровать.",
                            "target_lang_translations": {
                                "en": "Put your things <w>under</w> the bed.",
                                "zh": "把你的东西放到床<w>下</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "над"
                    ],
                    "common_phrases": [
                        "под столом",
                        "под водой",
                        "под землёй",
                        "под кровать"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates location below an object or movement into the space below something.",
                        "zh": "表示位于某物下方或向某物下方移动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "under",
                                "target_lang_sense_clarification": "physical location or movement below"
                            },
                            {
                                "target_lang_word": "beneath",
                                "target_lang_sense_clarification": "formal or literary synonym for under"
                            },
                            {
                                "target_lang_word": "below",
                                "target_lang_sense_clarification": "lower in position than"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……下",
                                "target_lang_sense_clarification": "表示物理位置或移动到下方"
                            },
                            {
                                "target_lang_word": "下方",
                                "target_lang_sense_clarification": "位置比某物低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b10e6d4c-12e6-3c8f-ab8c-5bf27ebf26fb",
                    "sense_definition": "Указывает на нахождение вблизи, недалеко от какого-либо места (обычно города).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "location_vicinity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У моих родителей есть дача <под> Москвой.",
                            "target_lang_translations": {
                                "en": "My parents have a dacha <w>near</w> Moscow.",
                                "zh": "我父母在莫斯科<w>附近</w>有一座别墅。"
                            }
                        },
                        {
                            "text": "Решающая битва произошла <под> Полтавой.",
                            "target_lang_translations": {
                                "en": "The decisive battle took place <w>near</w> Poltava.",
                                "zh": "决定性的战役发生在波尔塔瓦<w>附近</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "подле",
                        "около",
                        "вблизи"
                    ],
                    "common_phrases": [
                        "под Москвой",
                        "под городом"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates location close to or not far from a place (usually a city).",
                        "zh": "表示位于某地（通常指城市）附近。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "near",
                                "target_lang_sense_clarification": "in the vicinity of"
                            },
                            {
                                "target_lang_word": "just outside",
                                "target_lang_sense_clarification": "located immediately outside a city or town"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附近",
                                "target_lang_sense_clarification": "在某地周边区域"
                            },
                            {
                                "target_lang_word": "郊外",
                                "target_lang_sense_clarification": "位于城市边缘或紧邻城市的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7431409b-f3ef-32bf-9853-4239be6aa528",
                    "sense_definition": "Указывает на предмет или место, для которого что-либо предназначено или используется.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эту пустую банку можно использовать <под> варенье.",
                            "target_lang_translations": {
                                "en": "This empty jar can be used <w>for</w> jam.",
                                "zh": "这个空罐子可以<w>用来</w>装果酱。"
                            }
                        },
                        {
                            "text": "Мы расчистили площадку <под> строительство дома.",
                            "target_lang_translations": {
                                "en": "We cleared the site <w>for</w> the construction of the house.",
                                "zh": "我们清理了场地<w>作为</w>建房用地。"
                            }
                        },
                        {
                            "text": "В новой квартире выделили комнату <под> детскую.",
                            "target_lang_translations": {
                                "en": "In the new apartment, a room was allocated <w>for</w> the nursery.",
                                "zh": "新公寓里专门腾出一间房<w>作为</w>儿童房。"
                            }
                        }
                    ],
                    "synonyms": [
                        "для"
                    ],
                    "common_phrases": [
                        "место под строительство",
                        "банка под варенье",
                        "коробка под обувь"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an object or place for which something is intended or used.",
                        "zh": "表示某物被预定或用于某种特定用途。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for",
                                "target_lang_sense_clarification": "indicating purpose or intended use"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用来",
                                "target_lang_sense_clarification": "表示用途或预定功能"
                            },
                            {
                                "target_lang_word": "作为",
                                "target_lang_sense_clarification": "表示被指定为某种用途"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "889cc9fb-22a6-38c8-8bc8-9689d0959b60",
                    "sense_definition": "Указывает на приближение к определённому времени, возрасту или количеству.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "approximation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы вернулись домой только <под> утро.",
                            "target_lang_translations": {
                                "en": "We returned home only <w>towards</w> morning.",
                                "zh": "我们直到<w>临近</w>清晨才回到家。"
                            }
                        },
                        {
                            "text": "Этому мужчине уже лет <под> пятьдесят.",
                            "target_lang_translations": {
                                "en": "This man is already <w>nearly</w> fifty.",
                                "zh": "这个男人已经<w>将近</w>五十岁了。"
                            }
                        },
                        {
                            "text": "Вчера <под> вечер пошёл сильный снег.",
                            "target_lang_translations": {
                                "en": "Yesterday <w>towards</w> evening heavy snow began to fall.",
                                "zh": "昨天<w>临近</w>傍晚时下起了大雪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "под вечер",
                        "под утро",
                        "под конец",
                        "лет под сорок"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates approaching a certain time, age, or quantity.",
                        "zh": "表示接近某个时间、年龄或数量。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "towards",
                                "target_lang_sense_clarification": "approaching a specific time"
                            },
                            {
                                "target_lang_word": "nearly",
                                "target_lang_sense_clarification": "approaching an age or amount"
                            },
                            {
                                "target_lang_word": "getting on for",
                                "target_lang_sense_clarification": "approaching an age (idiomatic)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "临近",
                                "target_lang_sense_clarification": "接近某个时间点"
                            },
                            {
                                "target_lang_word": "将近",
                                "target_lang_sense_clarification": "接近某个年龄或数量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0365807a-8549-3ca9-a27e-d4a2b1751473",
                    "sense_definition": "Указывает на нахождение в каком-либо состоянии, под чьим-либо влиянием, контролем или руководством.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condition_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весь проект находится <под> контролем директора.",
                            "target_lang_translations": {
                                "en": "The whole project is <w>under</w> the director's control.",
                                "zh": "整个项目都在主管的<w>控制</w>之下。"
                            }
                        },
                        {
                            "text": "Он совершил этот поступок <под> влиянием друзей.",
                            "target_lang_translations": {
                                "en": "He committed this act <w>under</w> the influence of friends.",
                                "zh": "他在朋友的<w>影响</w>下做出了这种行为。"
                            }
                        },
                        {
                            "text": "Солдаты попали <под> сильный обстрел.",
                            "target_lang_translations": {
                                "en": "The soldiers came <w>under</w> heavy fire.",
                                "zh": "士兵们遭到了猛烈的<w>炮火</w>攻击。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "под контролем",
                        "под руководством",
                        "под впечатлением",
                        "под арестом"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates being in a state, under someone's influence, control, or guidance.",
                        "zh": "表示处于某种状态，或受某人影响、控制或领导。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "under",
                                "target_lang_sense_clarification": "subject to control, influence, or conditions"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……下",
                                "target_lang_sense_clarification": "受控制、影响或处于某种条件下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b539ead-9614-3d25-91ea-041dce5430b3",
                    "sense_definition": "Указывает на действие, которое сопровождается звуками, музыкой или употреблением чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accompaniment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодёжь весело танцевала <под> громкую музыку.",
                            "target_lang_translations": {
                                "en": "The young people danced happily <w>to</w> loud music.",
                                "zh": "年轻人们<w>伴着</w>响亮的音乐快乐地跳舞。"
                            }
                        },
                        {
                            "text": "Хорошо засыпать <под> шум дождя.",
                            "target_lang_translations": {
                                "en": "It is nice to fall asleep <w>to</w> the sound of rain.",
                                "zh": "听着雨声<w>伴着</w>入睡感觉很好。"
                            }
                        },
                        {
                            "text": "Мы ели шашлыки <под> красное вино.",
                            "target_lang_translations": {
                                "en": "We ate shashlik <w>with</w> red wine.",
                                "zh": "我们<w>就着</w>红酒吃烤肉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "под музыку",
                        "под шум дождя",
                        "под водочку"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an action accompanied by sounds, music, or consumption.",
                        "zh": "表示伴随声音、音乐或饮食的行为。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "accompanied by sound or music"
                            },
                            {
                                "target_lang_word": "with",
                                "target_lang_sense_clarification": "accompanied by food or drink"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伴着",
                                "target_lang_sense_clarification": "伴随声音或音乐"
                            },
                            {
                                "target_lang_word": "就着",
                                "target_lang_sense_clarification": "伴随食物或饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "430855c3-df6e-3cb8-a08a-45e1992e322c",
                    "sense_definition": "Указывает на подражание чему-либо, стилизацию или имитацию.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Стены в ванной комнате раскрашены <под> мрамор.",
                            "target_lang_translations": {
                                "en": "The bathroom walls are painted <w>to look like</w> marble.",
                                "zh": "浴室的墙壁被漆成了<w>仿</w>大理石的纹理。"
                            }
                        },
                        {
                            "text": "Она сделала себе короткую стрижку <под> мальчика.",
                            "target_lang_translations": {
                                "en": "She got a short haircut <w>like</w> a boy's.",
                                "zh": "她剪了一个<w>男孩式</w>的短发。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "под старину",
                        "стрижка под мальчика",
                        "отделка под дерево"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates imitation, stylization, or simulation.",
                        "zh": "表示模仿、风格化或仿制。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "resembling or imitating"
                            },
                            {
                                "target_lang_word": "in the style of",
                                "target_lang_sense_clarification": "imitating a specific style"
                            },
                            {
                                "target_lang_word": "faux",
                                "target_lang_sense_clarification": "made to look like something else (e.g., materials)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仿",
                                "target_lang_sense_clarification": "模仿某种材质或风格"
                            },
                            {
                                "target_lang_word": "式",
                                "target_lang_sense_clarification": "模仿某种特定样式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12d3b9e8-1d6f-350b-999a-e04c851ed48c",
                    "sense_definition": "Указывает на угол наклона.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "angle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дорога шла вверх <под> крутым углом.",
                            "target_lang_translations": {
                                "en": "The road went up <w>at</w> a steep angle.",
                                "zh": "道路以陡峭的<w>角度</w>向上延伸。"
                            }
                        },
                        {
                            "text": "Лестница установлена <под> наклоном к стене.",
                            "target_lang_translations": {
                                "en": "The ladder is set <w>at</w> an angle to the wall.",
                                "zh": "梯子靠墙<w>倾斜</w>放置。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "под углом",
                        "под прямым углом"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an angle of inclination.",
                        "zh": "表示倾斜的角度。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at",
                                "target_lang_sense_clarification": "used to indicate an angle"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成……角",
                                "target_lang_sense_clarification": "用于表示倾斜角度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bed39587-cb27-3346-b9a8-e0f95f5f71f9",
                    "sense_definition": "Нижняя горизонтальная поверхность в печи, на которой горят дрова или выпекается хлеб.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oven_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хозяйка тщательно вымела <под> печи перед выпечкой.",
                            "target_lang_translations": {
                                "en": "The hostess carefully swept the <w>hearth</w> of the stove before baking.",
                                "zh": "女主人在烘焙前仔细清扫了<w>炉底</w>。"
                            }
                        },
                        {
                            "text": "Хлеб, испечённый на горячем <поду>, получается особенно вкусным.",
                            "target_lang_translations": {
                                "en": "Bread baked on a hot <w>hearth</w> turns out especially tasty.",
                                "zh": "在滚烫的<w>炉底</w>上烤出的面包格外美味。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "часто используется в контексте деревенского быта или металлургии"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The lower horizontal surface in a stove or oven where wood burns or bread is baked.",
                        "zh": "炉灶内燃烧木材或烘烤面包的底部水平表面。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hearth",
                                "target_lang_sense_clarification": "floor of a fireplace or oven"
                            },
                            {
                                "target_lang_word": "oven floor",
                                "target_lang_sense_clarification": "bottom surface of an oven"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炉底",
                                "target_lang_sense_clarification": "炉灶或烤箱的底部表面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}