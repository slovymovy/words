                                    {
                                        "sense_id": "bbfa67d7-5432-3a78-a97d-d380a42ab431",
                                        "entry_id": "ad2618b5-82b9-3d47-b668-4dd3a8108a66",
                                        "glosses": [
                                            "dramatische Gattung; Drama, in dem es um Schicksal, Unglück und tragische Katastrophen geht, und das meistens ein negatives Ende hat"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bfdc658-814f-4416-8835-8241f41543db",
                                                "sense_id": "bbfa67d7-5432-3a78-a97d-d380a42ab431",
                                                "text": "Goethes „Faust“ ist eine Tragödie."
                                            },
                                            {
                                                "example_id": "a379408f-845d-483e-9325-9c7969ff76c9",
                                                "sense_id": "bbfa67d7-5432-3a78-a97d-d380a42ab431",
                                                "text": "„Zudem gibt es bei Euripides die für die griechische Tragödie obligaten Chorszenen.“"
                                            },
                                            {
                                                "example_id": "f8cc2397-bab3-4167-8c7a-80c636c6e9d3",
                                                "sense_id": "bbfa67d7-5432-3a78-a97d-d380a42ab431",
                                                "text": "„Was ihnen an der Tragödie gefiel, war das Pathos, die Reden über die Politik und den Verfall der Sitten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a029a4d-ee0b-3dbf-97e1-5ee5ee91c7a4",
                                        "entry_id": "ad2618b5-82b9-3d47-b668-4dd3a8108a66",
                                        "glosses": [
                                            "als katastrophal empfundenes Ereignis"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d989af10-1d65-4b85-9b60-ea5a9286d656",
                                                "sense_id": "7a029a4d-ee0b-3dbf-97e1-5ee5ee91c7a4",
                                                "text": "Das Geiseldrama war eine Tragödie."
                                            },
                                            {
                                                "example_id": "821b3e4b-fb72-4d61-ae20-f06241790b49",
                                                "sense_id": "7a029a4d-ee0b-3dbf-97e1-5ee5ee91c7a4",
                                                "text": "„Fast genau 30 Jahre nach der Tragödie läuft Ried durch eine Rokokokirche nicht weit vom Unglückssee.“"
                                            },
                                            {
                                                "example_id": "c3b4ad62-f5b2-4236-9dc7-5f2da3c3ecd0",
                                                "sense_id": "7a029a4d-ee0b-3dbf-97e1-5ee5ee91c7a4",
                                                "text": "„In der Kirche hatte der Bürgermeister über die unfassbare Tragödie gesprochen, die unser Dorf heimgesucht hatte, und über den unmenschlichen Verlust, den sie verursacht hatte, einer der schlimmsten Erdrutsche in der Geschichte Norwegens, hatte er gesagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb1f0e5d-58f8-454f-a6cc-528ae7ba505c",
                        "source_entry_id": "5e77acb5-64ec-3604-af34-cfc2a1deb85e",
                        "source_sense_id": "4b5c0e16-9b8f-3a88-bf9b-00ce962f96a3",
                        "source_sense_description": "gebeurtenis met een droevige of rampzalige afloop",
                        "target_lang_word": "tragedy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tragedy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d63a0dd6-01a0-36c2-bdf2-67c5034521f8",
                                        "entry_id": "73f17e95-abfb-35b9-9fe9-731ecc1e693c",
                                        "glosses": [
                                            "A drama or similar work, in which the main character is brought to ruin or otherwise suffers the extreme consequences of some tragic flaw or weakness of character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b69df3ef-fed0-37dc-abfd-7df7a91fe382",
                                        "entry_id": "73f17e95-abfb-35b9-9fe9-731ecc1e693c",
                                        "glosses": [
                                            "The genre of such works, and the art of producing them."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a4afa41-730f-3a2e-bc57-968ff9c1d424",
                                        "entry_id": "73f17e95-abfb-35b9-9fe9-731ecc1e693c",
                                        "glosses": [
                                            "A disastrous event, especially one involving great loss of life or injury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ba4c6f5-3c43-4952-941c-b0aedde02d4e",
                                                "sense_id": "7a4afa41-730f-3a2e-bc57-968ff9c1d424",
                                                "text": "“The story of this adoption is, of course, the pivot round which all the circumstances of the mysterious tragedy revolved. Mrs. Yule had an only son, namely, William, to whom she was passionately attached; but, like many a fond mother, she had the desire of mapping out that son's future entirely according to her own ideas.[…]”"
                                            },
                                            {
                                                "example_id": "cad234cd-d336-455f-8101-7700c2c09ce7",
                                                "sense_id": "7a4afa41-730f-3a2e-bc57-968ff9c1d424",
                                                "text": "[…] last month's flooding in the Buffalo Creek Valley […]. The tragedy took more than one hundred lives[…]"
                                            },
                                            {
                                                "example_id": "60e44686-14e5-4c9d-a3ac-283c31f57f5c",
                                                "sense_id": "7a4afa41-730f-3a2e-bc57-968ff9c1d424",
                                                "text": "After the terrible tragedy of the Triangle Shirtwaist Fire in 1911, which killed 146 New York garment workers, proper fire drilling was considered a necessity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
