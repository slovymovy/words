                ],
                "senses": [
                    {
                        "sense_id": "81392c7c-78e9-390f-8a7c-33cf5bfa7c96",
                        "entry_id": "3d30ef5b-bda4-3250-8054-ae551377299a",
                        "glosses": [
                            "To change the brand name, logo, or image of a product or company."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d96756b4-a5ae-4764-a7cd-d0bbf3da871b",
                                "sense_id": "81392c7c-78e9-390f-8a7c-33cf5bfa7c96",
                                "text": "Acme Co. is trying to rebrand their line of toasters under the Bewidget name."
                            },
                            {
                                "example_id": "ffdde236-4478-47d4-b1ec-695dddb4de5e",
                                "sense_id": "81392c7c-78e9-390f-8a7c-33cf5bfa7c96",
                                "text": "Many have spoken about the need for a rebranding of America. Rebrand, restart, reboot."
                            },
                            {
                                "example_id": "2f5f3451-d466-492b-8ee3-9fdbbc1e8268",
                                "sense_id": "81392c7c-78e9-390f-8a7c-33cf5bfa7c96",
                                "text": "The latter issue dramatizes the long shadow Brexit is casting on Mr. Johnson’s effort to rebrand Britain as a vital player on the global stage."
                            },
                            {
                                "example_id": "a3ac5fe7-2eeb-44c7-8f80-96f057ce7675",
                                "sense_id": "81392c7c-78e9-390f-8a7c-33cf5bfa7c96",
                                "text": "Gaining a new headcode, it is then rebranded as the 2103 Carmarthen-Fishguard Harbour - a place I'd never visited by rail."
                            }
                        ]
                    }
                ],
