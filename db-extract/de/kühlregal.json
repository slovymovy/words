                "senses": [
                    {
                        "sense_id": "6689fd8b-4dc9-3def-ba15-f737a653bf71",
                        "entry_id": "d77b6d42-f15a-3cb2-b197-18413ce9d8e9",
                        "glosses": [
                            "ein offenes oder geschlossenes Warengestell mit Kühltechnik, in dem Kühlprodukte lagern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3e821c7-3e7b-41c4-a11d-649c4f02a830",
                                "sense_id": "6689fd8b-4dc9-3def-ba15-f737a653bf71",
                                "text": "Es gibt unterschiedliche Kühlregale, die sich in der Bauart und im Temperaturbereich unterscheiden."
                            },
                            {
                                "example_id": "cfe71f2b-d2f5-4edc-963c-534468914bd6",
                                "sense_id": "6689fd8b-4dc9-3def-ba15-f737a653bf71",
                                "text": "„Kühlregale werden beim Einsatz in Supermärkten, im Kiosk oder in der Tankstelle immer wichtiger.“"
                            },
                            {
                                "example_id": "a83140f3-b04b-4c11-a1e7-d4f5b4125314",
                                "sense_id": "6689fd8b-4dc9-3def-ba15-f737a653bf71",
                                "text": "„Bei der Anschaffung vom Kühlregal sollte weiterhin unbedingt ein Nachtrollo eingeplant werden.“"
                            },
                            {
                                "example_id": "e00c81cf-362a-46a6-b32f-f07440fcce05",
                                "sense_id": "6689fd8b-4dc9-3def-ba15-f737a653bf71",
                                "text": "„Ich drehe mich um, stehe vor einem neuen Kühlregal, das doppelt so groß ist wie das alte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
