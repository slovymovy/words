                    {
                        "translation_id": "94547022-f50d-4122-9f59-13130cd860bc",
                        "source_entry_id": "3af12366-195a-3419-bd29-eb02e8245d98",
                        "source_sense_description": "half of a circle",
                        "target_lang_word": "demi-cercle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-cercle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "924f8860-ffc5-385c-ba22-ce6470760824",
                                        "entry_id": "e02a05ed-8884-3ca8-b645-cd3fb89b3e89",
                                        "glosses": [
                                            "Moitié d’un cercle, limitée par un diamètre ; forme semi-circulaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0f955a-a833-49d3-bcd8-bd0553418df7",
                                                "sense_id": "924f8860-ffc5-385c-ba22-ce6470760824",
                                                "text": "Quand il entra dans le salon, tous se levèrent à grand bruit, on l’embrassa ; et avec les fauteuils et les chaises on fit un large demi-cercle autour de la cheminée."
                                            },
                                            {
                                                "example_id": "40c8d1fd-a15d-4651-b554-1acdd47b1a82",
                                                "sense_id": "924f8860-ffc5-385c-ba22-ce6470760824",
                                                "text": "Deux sourcils en demi-cercle couronnaient les yeux d’Alice, d’une courbe si pure et fine qu’on les aurait crus épilés puis redessinés au crayon ; ces sourcils renforçaient encore l’intensité ce ce regard, comme deux accents sur des voyelles."
                                            },
                                            {
                                                "example_id": "c5c45a22-5b0f-45ed-8faf-6bc2faea6ffb",
                                                "sense_id": "924f8860-ffc5-385c-ba22-ce6470760824",
                                                "text": "Le pic de Ternetiu élève sa crête parmi les nuages à douze cents mètres d’altitude. Ses pentes descendent autour d’un immense cratère en demi-cercle."
                                            },
                                            {
                                                "example_id": "89142d69-2f24-4098-b708-ede33a2f51f9",
                                                "sense_id": "924f8860-ffc5-385c-ba22-ce6470760824",
                                                "text": "Le prouvier aussi avait lancé son cri. Il disait ainsi que, déjà, le courant avait fait alliance avec la force des hommes. Déjà le bateau avait accompli son demi-cercle et s'était placé en direction de la descente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ca5ae72-bb3d-439a-b678-779f40493ad1",
                        "source_entry_id": "3af12366-195a-3419-bd29-eb02e8245d98",
                        "source_sense_description": "half of a circle",
                        "target_lang_word": "Halbkreis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbkreis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                        "entry_id": "2b0dcb0a-01e9-3b6f-ba32-77bff9b47dc7",
                                        "glosses": [
                                            "durch den Durchmesser begrenzte Hälfte eines Kreises"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e3259b-c6f2-4b91-97ae-0d6c569ad604",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "Bei praktischen Demonstrationen im Chemiekabinett stellen sich die Schüler alle im Halbkreis um den Lehrer auf, so dass jeder den gleichen Abstand zu diesem hat und gut sehen kann."
                                            },
                                            {
                                                "example_id": "1b55aab8-8d06-43c4-9597-26e40976ccf0",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Unten am Strand schützte Alf die Seinen vor der Flut durch hohe Wälle aus Sand, die in einem Halbkreis an die rote alte Ufermauer stießen.“"
                                            },
                                            {
                                                "example_id": "5c72278c-79f7-49cd-870f-53d9a08c63ce",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Vor dem Hotel Abdulla – auf dem Trottoir – saßen Männer im Halbkreis, rauchten Wasserpfeifen und tranken Türkischen aus kleinen, runden Tassen.“"
                                            },
                                            {
                                                "example_id": "00d7c675-d8ec-4d70-9fa1-eb986f9a33f7",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Er gab es auf, das Auf und Nieder seiner Promenade noch weiterfortzusetzen, und beschrieb lieber einen Halbkreis um den Fuß des Schloßhügels herum, bis er in Front des Schlosses selber war.“"
                                            },
                                            {
                                                "example_id": "5ed78533-48b4-42c5-9897-d71f788c734a",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Die Gruppe stand nun im Halbkreis um Roberts Tisch versammelt, der den Aufzug nicht ohne Verlegenheit betrachtet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
