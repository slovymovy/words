                    {
                        "form_id": "38d1f64c-7af2-4248-bc28-1796043060e6",
                        "entry_id": "a402208a-21de-3f08-ad90-a26cf6af778b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Dreißigecke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e25bfc35-7e96-3d13-876b-b87cc7d42cfb",
                        "entry_id": "a402208a-21de-3f08-ad90-a26cf6af778b",
                        "glosses": [
                            "geometrische Figur mit dreißig Ecken"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "edc3ae65-9f0e-41e2-918e-9a49f8c3d172",
                                "sense_id": "e25bfc35-7e96-3d13-876b-b87cc7d42cfb",
                                "text": "„Man kann also auch in jeden Kreis ein regelmäßiges Funfzehneck hineinzeichnen, und es ist daher nun auch leicht, ein regelmäßiges Dreißigeck oder Sechzigeck etc. zu construiren.“"
                            },
                            {
                                "example_id": "370f63a7-47d1-4226-8532-056613c93307",
                                "sense_id": "e25bfc35-7e96-3d13-876b-b87cc7d42cfb",
                                "text": "„Nach unserem Fortgangsprinzip können wir nun entweder die 3 Nebendreiecke einzeln an ihren freien Seiten oder auch gleich das ganze Sechseck an jeder seiner 6 Seiten spiegeln, wodurch wir ein Dreißigeck erhalten.“"
                            },
                            {
                                "example_id": "5b3f8d9a-33de-43ec-b679-0b1ec4024f9e",
                                "sense_id": "e25bfc35-7e96-3d13-876b-b87cc7d42cfb",
                                "text": "„Anders hingegen verhält es sich z. B. bei einem Dreißigeck.“"
                            },
                            {
                                "example_id": "f58c6dcb-7963-4b89-939e-a208a5e0be54",
                                "sense_id": "e25bfc35-7e96-3d13-876b-b87cc7d42cfb",
                                "text": "„Es ist eigentlich ein Dreißigeck, dessen höchster Punkt sich 65 m über dem Erdboden befindet.“"
                            },
                            {
                                "example_id": "b553a397-0197-46d7-8d92-e5e07dc2cb6e",
                                "sense_id": "e25bfc35-7e96-3d13-876b-b87cc7d42cfb",
                                "text": "„Das ganze Gebäude ist aus Eisen konstruiert, es stellt ein regelmäßiges Dreißigeck dar, dessen Eisenfachwerkseiten durch eine Schwellenkuppel überdeckt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95f8c3cb-c908-4b34-a12f-335aff74abb9",
                        "source_entry_id": "a402208a-21de-3f08-ad90-a26cf6af778b",
                        "source_sense_id": "e25bfc35-7e96-3d13-876b-b87cc7d42cfb",
                        "source_sense_description": "Mathematik, Geometrie: geometrische Figur mit dreißig Ecken",
                        "target_lang_word": "triacontagon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triacontagon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e121a8a3-1ef5-34ff-a901-8b778fc017dd",
                                        "entry_id": "7d51a58f-c428-3503-8e21-0fae9098b56f",
                                        "glosses": [
                                            "A polygon with thirty sides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44612917-901d-435f-ac65-cccc25634f8c",
                                                "sense_id": "e121a8a3-1ef5-34ff-a901-8b778fc017dd",
                                                "text": "After projection onto the (x₁, x₂) plane, the A’s, B’s, C’s, and D’s form four concentric triacontagons, inscribed in circles of radii a, b, c, and d."
                                            },
                                            {
                                                "example_id": "dfac756f-1f6c-403e-9b51-ba86a6e56fd2",
                                                "sense_id": "e121a8a3-1ef5-34ff-a901-8b778fc017dd",
                                                "text": "1964 July, B. L. Chilton, On the Projection of the Regular Polytope {5, 3, 3} into a Regular Triacontagon, Canadian Mathematical Bulletin, Volume 7, Number 3, page 386,\nIn the projection the 600 points can be classified in 12 sets: each set consists of either of 30 or of 60 vertices which lie on a circle concentric with the outer triacontagon."
                                            },
                                            {
                                                "example_id": "7dc81bff-1df2-4df6-93bd-cebc25db95ac",
                                                "sense_id": "e121a8a3-1ef5-34ff-a901-8b778fc017dd",
                                                "text": "1997, Johannes Kepler, E. J. Aiton, Alistair Matheson Duncan, Judith Veronica Field (translators), The Harmony of the World, [1619, Harmonices Mundi], American Philosophical Society, Volume 309, page 59,\nWhat should the decision now be about the sides of the Triacontagon?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
