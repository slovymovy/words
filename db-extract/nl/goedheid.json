                        "entry_id": "34e40464-aacb-3e77-92ae-251a65c8b6cd",
                        "glosses": [
                            "de hoedanigheid van het goed zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a5da0c-7f33-42de-a037-842d3c57f0df",
                                "sense_id": "cff71d7c-bdcc-32d2-98db-2469e6d1aa62",
                                "text": "De innerlijke goedheid van de mens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ff06292-28ff-454e-a00f-29368a081ef0",
                        "source_entry_id": "34e40464-aacb-3e77-92ae-251a65c8b6cd",
                        "source_sense_id": "cff71d7c-bdcc-32d2-98db-2469e6d1aa62",
                        "source_sense_description": "de hoedanigheid van het goed zijn",
                        "target_lang_word": "Güte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Güte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                        "entry_id": "2cdf01de-4927-35ad-baa0-17f5449253b1",
                                        "glosses": [
                                            "eine freundliche, wohlgesonnene, großzügige Einstellung und Handlungsweise gegenüber einer anderen Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ccc6ac-e23b-4f61-96b8-ed4f8ddeddee",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "Ich aber bin gewiss, zu schauen die Güte des HERRN im Land der Lebenden."
                                            },
                                            {
                                                "example_id": "81102cd9-78a1-4152-b65f-36e2cf1d1936",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "Sein Handeln gegenüber Kollegen und Untergebenen war von großer Güte bestimmt."
                                            },
                                            {
                                                "example_id": "9ecf68bf-95b0-4a14-894c-74a7c72ba63a",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "„Hätten Sie die Güte und reichten mir einmal die Karte herüber. Vielen Dank.“"
                                            },
                                            {
                                                "example_id": "0a7ff6fc-619f-422a-b8d3-5b9f7001e86e",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "Wie kann Gott Inbegriff der vollkommenen Güte sein, wenn er den Menschen schreckliche Schicksale auferlegt?"
                                            },
                                            {
                                                "example_id": "bfa4399e-bcaa-4b7b-95b3-325f01c8717f",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "Symbol [für die Menschlichkeit] ist Pater Maximilian Kolbe geworden. Seine sozusagen sein Leben abschließende Tat war ein Akt der Liebe für einen Mithäftling. Und letztlich hatte nicht die SS das letzte Wort, sondern die Güte dieses Paters."
                                            },
                                            {
                                                "example_id": "ecbaafc4-cd23-4938-af92-01861c20be12",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "Ein Foto zeigt sie [die 83-jährige Marissa Mavrapidou] und ihre Freunde, wie sie das Baby einer geflüchteten Frau trösten. Das Foto wurde in den Sozialen Medien weit verbreitet. Im Angesicht des ganzen Elends wurden die Frauen zu einem Symbol der Güte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df7a2d3a-30ed-39b4-9236-c8a97817df7a",
                                        "entry_id": "2cdf01de-4927-35ad-baa0-17f5449253b1",
                                        "glosses": [
                                            "der Grad der erwünschten und beabsichtigten Beschaffenheit (= Qualität) eines Materials oder eines Instruments"
                                        ],
                                        "tags": [
                                            "Materialwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aaa1e6d-7ca8-4823-97d0-aaa44f6518be",
                                                "sense_id": "df7a2d3a-30ed-39b4-9236-c8a97817df7a",
                                                "text": "Auf den Plantagen von São Tomé und Príncipe wächst Kakao von hervorragender Güte."
                                            },
                                            {
                                                "example_id": "fc4baf90-6b5e-44c0-a2e3-967bbacfdf4f",
                                                "sense_id": "df7a2d3a-30ed-39b4-9236-c8a97817df7a",
                                                "text": "[…] nur die wenigsten Ärzte [können] ihren Patienten zum Beispiel wirklich erklären, welchen Wert ein Krebstest hat. Dazu müssten sie etwas über die Güte des Tests wissen, aber auch über die Häufigkeit der Erkrankung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67d4600b-db99-4b10-98cc-5f3c4ef0d131",
                        "source_entry_id": "34e40464-aacb-3e77-92ae-251a65c8b6cd",
                        "source_sense_id": "cff71d7c-bdcc-32d2-98db-2469e6d1aa62",
                        "source_sense_description": "de hoedanigheid van het goed zijn",
                        "target_lang_word": "goodness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goodness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce3488d4-485c-39e2-aac5-048bb9ddbd97",
                                        "entry_id": "dc984558-4c6b-3086-bb64-f744669c0013",
                                        "glosses": [
                                            "The state or characteristic of being good."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e020423-6edb-49bc-b415-c19f043f96d6",
                                                "sense_id": "ce3488d4-485c-39e2-aac5-048bb9ddbd97",
                                                "text": "There is ſome ſoule of goodneſſe in things euill, / VVould men obſeruingly 'diſtill it out."
                                            },
                                            {
                                                "example_id": "76f46818-c7fe-4662-a7c4-2dd5d2c68958",
                                                "sense_id": "ce3488d4-485c-39e2-aac5-048bb9ddbd97",
                                                "text": "Rich, raisiny, smoky, coffee goodness: that is the flavor of urfa biber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64818e77-f431-3789-af4b-63c9db7a7362",
                                        "entry_id": "dc984558-4c6b-3086-bb64-f744669c0013",
                                        "glosses": [
                                            "The good, nutritional, healthy part or content of something."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1efbb148-4194-3677-ba2c-063792d30b20",
                                        "entry_id": "dc984558-4c6b-3086-bb64-f744669c0013",
                                        "glosses": [
                                            "God."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c4d8778-76ee-492b-b709-cc18f5606443",
                                                "sense_id": "1efbb148-4194-3677-ba2c-063792d30b20",
                                                "text": "Thank goodness that the war is over!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47c357ce-2d3e-3c24-8a75-6ac019d3125c",
                                        "entry_id": "dc984558-4c6b-3086-bb64-f744669c0013",
                                        "glosses": [
                                            "The moral qualities which constitute Christian excellence; moral virtue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10b62b18-cb0a-431a-b251-cc18e48337ad",
                                                "sense_id": "47c357ce-2d3e-3c24-8a75-6ac019d3125c",
                                                "text": "But the fruit of the ſpirit is loue, ioy, peace, long ſuffering, gentleneſſe, goodneſſe, faith, / Meekeneſſe, temperance: againſt ſuch there is no law."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "goodness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bb3cc76-2572-3639-ae58-40d04f87e235",
