                    {
                        "sense_id": "e782b6a5-e99b-3d13-aaf1-feae3b7af354",
                        "entry_id": "d3ddd184-86f3-325e-9a78-2500cd3f0a2d",
                        "glosses": [
                            "Particule élémentaire qui n’est sensible qu’à l’interaction électrofaible et à la gravitation."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "18e54626-1a1a-49a6-ae86-310f95c2983a",
                                "sense_id": "e782b6a5-e99b-3d13-aaf1-feae3b7af354",
                                "text": "L’autre catégorie de particules élémentaires, les leptons, est liée aux électrons qu'elle contient."
                            },
                            {
                                "example_id": "a03e68e5-8e04-4aea-a6f4-49d963a82b8c",
                                "sense_id": "e782b6a5-e99b-3d13-aaf1-feae3b7af354",
                                "text": "Les leptons forment une catégorie de particules insensibles à la force nucléaire forte, qui se combinent avec les quarks pour façonner la matière."
                            }
                        ]
                    }
                ],
                "translations": [
