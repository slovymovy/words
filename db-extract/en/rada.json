                                "target_senses": [
                                    {
                                        "sense_id": "e424c589-1761-3093-8f25-a33f3ac0ece7",
                                        "entry_id": "5aac1ec5-67d9-32f9-9803-7c0fe527caab",
                                        "glosses": [
                                            "wypowiedź skierowana do kogoś, zawierająca zalecenie, jak się należy zachować w określonej sytuacji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54a9e591-7c5b-49ad-b697-825b23a6d9aa",
                                                "sense_id": "e424c589-1761-3093-8f25-a33f3ac0ece7",
                                                "text": "Dam ci dobrą radę! Trzymaj się z dala od mojej dziewczyny!"
                                            },
                                            {
                                                "example_id": "561b2749-12f6-4daf-be46-e39e0d362ae3",
                                                "sense_id": "e424c589-1761-3093-8f25-a33f3ac0ece7",
                                                "text": "Ale najgorsze było to, że szczon, zamiast słuchać rad starszych i bardziej doświadczonych funkcjonariuszy, co to na robocie milicyjnej zęby zjedli, sam wiedział wszystko najlepiej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "aa41ab90-6f9d-3f6d-93a8-d38f7be5d53e",
                                        "entry_id": "5aac1ec5-67d9-32f9-9803-7c0fe527caab",
                                        "glosses": [
                                            "grupa osób, najczęściej wydzielona formalnie w ramach jakiejś organizacji lub społeczności, której celem jest znalezienie poprzez dyskusję lub z racji posiadanego doświadczenia, rozwiązania określonego problemu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abdff3e1-4f0e-4a2f-85d1-44a4eb526d80",
                                                "sense_id": "aa41ab90-6f9d-3f6d-93a8-d38f7be5d53e",
                                                "text": "Rada nadzorcza oceniła sytuację finansową naszej spółki bardzo pozytywnie."
                                            },
                                            {
                                                "example_id": "7a12655a-dacc-4886-9982-9dd0a036c0a6",
                                                "sense_id": "aa41ab90-6f9d-3f6d-93a8-d38f7be5d53e",
                                                "text": "Na sali obok recenzentów i przedstawicieli rady naukowej (recte: rady wydziału) zjawiają się jedynie z kurtuazji krewni oraz przyjaciele i znajomi autora."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "3f64a462-b9a5-3be0-b407-4378b6d69f1a",
                                        "entry_id": "5aac1ec5-67d9-32f9-9803-7c0fe527caab",
                                        "glosses": [
                                            "zebranie, na którym dyskutowany jest jakiś problem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36c3a330-2a59-4724-a801-b157a0876447",
                                                "sense_id": "3f64a462-b9a5-3be0-b407-4378b6d69f1a",
                                                "text": "Wodzowie plemion zostali zwołani na radę."
                                            },
                                            {
                                                "example_id": "8389f4bd-30b0-4d0b-ad18-de781f939531",
                                                "sense_id": "3f64a462-b9a5-3be0-b407-4378b6d69f1a",
                                                "text": "Na radzie nauczyciele zastanawiali się, co zrobić z zachowaniem tego ucznia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            },
