                        "entry_id": "c11f858d-2de1-384d-b1fc-6c069048b17e",
                        "glosses": [
                            "A mechanism that secures an aircraft's landing gear in the retracted position, helping to prevent an uncommanded gear deployment during flight."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2290ea5-f61d-4b76-bf9e-b88976cb60d2",
                                "sense_id": "0be13da6-b599-39c2-9032-bdcc8445e402",
                                "text": "The left and right wing landing gear uplock assemblies had separated from their attachment points on the fuselage structure. The interior skin and associated ribs on the left and right wing gear inboard doors were damaged in the vicinity of their striker plates and the striker plates also were damaged. The doors were damaged in the area where the tires are located when the gears are retracted."
                            }
                        ]
                    }
