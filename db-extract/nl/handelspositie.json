                        "examples": [
                            {
                                "example_id": "ca76f4df-f922-496c-9e61-351af43cfe04",
                                "sense_id": "25861c30-21cb-3c29-9f75-677846c4befc",
                                "text": "Trump ziet een mogelijke handelsoorlog als een goede manier om de handelspositie van de VS te verbeteren."
                            },
                            {
                                "example_id": "44e9a5f3-fd1f-4e9b-a005-360ba4e6d570",
                                "sense_id": "25861c30-21cb-3c29-9f75-677846c4befc",
                                "text": "Omdat het zo veel tijd kost om al die zaken uit te onderhandelen, wordt er al gesproken over een overgangsperiode. Een voorlopig akkoord moet ervoor zorgen dat de handel na de brexit niet totaal stilvalt en geeft de onderhandelaars de tijd om langer te spreken over een definitief akkoord. Het doel is dat de handel zo min mogelijk schade ondervindt, maar in Brussel zegt ook iedereen dat de Britten geen handelspositie mogen krijgen die beter is dan die van de 27 overgebleven EU-landen."
                            },
                            {
                                "example_id": "8b96d068-7eeb-46d0-a7f7-de43be2b7708",
                                "sense_id": "25861c30-21cb-3c29-9f75-677846c4befc",
                                "text": "Tot tevredenheid van de Amerikanen was er wel een gezamenlijke uitspraak tegen het opzettelijk devalueren van de eigen munt om de handelspositie van een land te verbeteren."
                            }
