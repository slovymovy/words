                "senses": [
                    {
                        "sense_id": "3d3fde9b-0396-3080-bc16-b96091377817",
                        "entry_id": "28127ba2-26d0-3066-ad7f-d7287d11dc30",
                        "glosses": [
                            "Bavarder en parlant beaucoup, jacasser."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "0bc80c82-3daf-42e3-90b1-1e5e28298305",
                                "sense_id": "3d3fde9b-0396-3080-bc16-b96091377817",
                                "text": "En passant, on s’arrêtait dans tel hameau où il savait qu’il retrouverait un des rescapés de l’aventure 1914-1918 avec lequel on était bien obligé de vider une bouteille et de batoiller."
                            },
                            {
                                "example_id": "c280f236-3610-434f-ae02-10dee378f6c4",
                                "sense_id": "3d3fde9b-0396-3080-bc16-b96091377817",
                                "text": "À part cela, elle n’aime pas babiller et encore moins batoiller, elle préfère de beaucoup écouter."
                            },
                            {
                                "example_id": "eddb5ee0-aa61-447b-88b8-383b430ede9e",
                                "sense_id": "3d3fde9b-0396-3080-bc16-b96091377817",
                                "text": "Nous sommes 2 filles qui aimons discuter, babiller, batoiller quoi…"
                            }
                        ]
                    }
