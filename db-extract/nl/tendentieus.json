                "senses": [
                    {
                        "sense_id": "14472ff5-d3b0-3180-9985-98dbbfe1d11d",
                        "entry_id": "f08da59d-90c3-3b67-9088-2614d9e7db10",
                        "glosses": [
                            "gekleurd door bijbedoelingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101b1424-a5e1-492d-bbb5-0ab0f8fd1441",
                                "sense_id": "14472ff5-d3b0-3180-9985-98dbbfe1d11d",
                                "text": "Dat hele stuk berichtgeving over de Ierse financiën is tendentieus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e599df1c-2a3e-4ca9-80a5-06f460efa9a6",
                        "source_entry_id": "f08da59d-90c3-3b67-9088-2614d9e7db10",
                        "source_sense_id": "14472ff5-d3b0-3180-9985-98dbbfe1d11d",
                        "source_sense_description": "gekleurd door bijbedoelingen",
                        "target_lang_word": "tendentious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tendentious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad9ab10a-3937-3106-af28-775d9af41ce4",
                                        "entry_id": "e594f9e3-4630-320e-9260-46fa5f66bc9a",
                                        "glosses": [
                                            "Having a tendency, written or spoken, with a partisan, biased or prejudiced purpose, especially a controversial one; implicitly or explicitly slanted; biased."
                                        ],
                                        "tags": [
                                            "of persons or their words"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f128d4-d1bc-4ac6-955b-378636f0cc3a",
                                                "sense_id": "ad9ab10a-3937-3106-af28-775d9af41ce4",
                                                "text": "Near-synonyms: partisan, slanted, partial, prejudiced"
                                            },
                                            {
                                                "example_id": "c789ab62-fc3a-4889-a180-a09006157a73",
                                                "sense_id": "ad9ab10a-3937-3106-af28-775d9af41ce4",
                                                "text": "That he was a supporter of the cause was clear, because his reports from the front were tendentious."
                                            },
                                            {
                                                "example_id": "aba817a5-205d-4992-ba74-647c88cf5e4d",
                                                "sense_id": "ad9ab10a-3937-3106-af28-775d9af41ce4",
                                                "text": "President-elect Donald Trump abruptly abandoned some of his most tendentious campaign promises Tuesday, saying he does not plan to prosecute Hillary Clinton for her use of a private email system or the dealings of her family foundation, has an “open mind” about a climate-change accord from which he vowed to withdraw the United States and is no longer certain that torturing terrorism suspects is a good idea."
                                            },
                                            {
                                                "example_id": "4187cb22-3fd5-4ef8-863d-468768a063ea",
                                                "sense_id": "ad9ab10a-3937-3106-af28-775d9af41ce4",
                                                "text": "It is a canard trotted out by lazy or tendentious journalists that nationalised British Railways lacked entrepreneurial flair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2d4b3a8-832b-4df9-aa4c-10ac8cf36b54",
                        "source_entry_id": "f08da59d-90c3-3b67-9088-2614d9e7db10",
                        "source_sense_id": "14472ff5-d3b0-3180-9985-98dbbfe1d11d",
                        "source_sense_description": "gekleurd door bijbedoelingen",
                        "target_lang_word": "tendencious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tendencious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9033fda9-5a3a-3308-8a95-0e5ba9bb7d17",
                                        "entry_id": "1479416d-a03c-3597-b692-e4b0b53316c9",
                                        "glosses": [
                                            "Obsolete spelling of tendentious."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f1bd47c-7204-49e9-84e2-26750f8dfbb9",
                                                "sense_id": "9033fda9-5a3a-3308-8a95-0e5ba9bb7d17",
                                                "text": "The most diligent censorship, the most tendencious Military communiques could not hide from the people of Brussels that the Allies were holding their own, and even gaining ground."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "016373b8-9d2a-4d2c-8e2a-e8fcf24996c6",
                        "source_entry_id": "f08da59d-90c3-3b67-9088-2614d9e7db10",
                        "source_sense_id": "14472ff5-d3b0-3180-9985-98dbbfe1d11d",
                        "source_sense_description": "gekleurd door bijbedoelingen",
                        "target_lang_word": "tendancieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tendancieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45a63df0-18a5-346f-95a9-5e1d6acee427",
                                        "entry_id": "bb90c622-6ddc-3b2a-a86f-c80b3d483ca0",
                                        "glosses": [
                                            "Qualifie des paroles ou des écrits qui laissent deviner certaines tendances sans les marquer explicitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd72104-9509-4b1f-9677-02fd2031f736",
                                                "sense_id": "45a63df0-18a5-346f-95a9-5e1d6acee427",
                                                "text": "On lui arrachait le livre des mains, avec l’espoir, visible, qu’il fût prohibé, parce qu’obscène ou tendancieux, et Chalumot attendait, le cœur dans la gorge, que le caporal ou le sous-off rendît sa sentence."
                                            },
                                            {
                                                "example_id": "ade38469-052f-4374-ba7c-3bd2c29a5553",
                                                "sense_id": "45a63df0-18a5-346f-95a9-5e1d6acee427",
                                                "text": "Je crois qu’il est utile, pour un premier numéro, que nos études soient délibérément tendancieuses, qu’elles affirment nettement notre tour d’esprit […]."
                                            },
                                            {
                                                "example_id": "0457e6b4-8594-4938-bc79-4808c24d6210",
                                                "sense_id": "45a63df0-18a5-346f-95a9-5e1d6acee427",
                                                "text": "Faire d’un événement un récit tendancieux."
                                            },
                                            {
                                                "example_id": "c3aee875-d21e-45d1-87a2-5c63ae98d3ad",
                                                "sense_id": "45a63df0-18a5-346f-95a9-5e1d6acee427",
                                                "text": "Ce livre ne doit être lu qu’avec une critique sévère, car il est très tendancieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2f049b4-1fe3-3515-9116-a8e066e96b24",
                                        "entry_id": "bb90c622-6ddc-3b2a-a86f-c80b3d483ca0",
                                        "glosses": [
                                            "Qualifie des paroles ou des écrits à connotation libidineuse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c32fd24-351a-4dc3-a664-6a56c9b80997",
                                                "sense_id": "f2f049b4-1fe3-3515-9116-a8e066e96b24",
                                                "text": "L'affaire débute à Marseille par le signalement de la directrice d'un foyer où un jeune homme de 17 ans, victime de viols, recevait à des heures tardives des messages tendancieux du policier chargé de son enquête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74d85e95-ab17-37d1-9992-b8ba76144815",
                                        "entry_id": "bb90c622-6ddc-3b2a-a86f-c80b3d483ca0",
                                        "glosses": [
                                            "Qualifie une notion partiale, engagée, injuste, intolérante, sectaire ou partisane."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58d10d9f-5741-476f-9c21-598fb1531df3",
                                                "sense_id": "74d85e95-ab17-37d1-9992-b8ba76144815",
                                                "text": "Il est faux à la fois et tendancieux de prétendre que la guerre est l’état normal de la moitié mâle de l’humanité ; la guerre vient d’en haut et non d’en bas. Ce sont les dirigeants qui la préparent et qui la font dans leur intérêt personnel."
                                            },
                                            {
                                                "example_id": "e295dc95-98b5-40f5-a587-409b1f2ab5d6",
                                                "sense_id": "74d85e95-ab17-37d1-9992-b8ba76144815",
                                                "text": "Pour éviter tout commentaire tendancieux, j’ai prié le Père Julien de m’assister et de contresigner les procès-verbaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
