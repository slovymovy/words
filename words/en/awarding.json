{
    "word_family": [
        "award",
        "awardee",
        "awarder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a579e7d3-0eb0-3e96-9a03-994f8eb63810",
                    "sense_definition": "The act of giving a prize or honor to someone.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>awarding</w> of the medals took place during the final ceremony.",
                            "target_lang_translations": {
                                "pl": "<w>Przyznanie</w> medali miało miejsce podczas ceremonii finałowej."
                            }
                        },
                        {
                            "text": "She felt proud during the <w>awarding</w> of the scholarship to her daughter.",
                            "target_lang_translations": {
                                "pl": "Czuła dumę podczas <w>wręczania</w> stypendium jej córce."
                            }
                        }
                    ],
                    "synonyms": [
                        "presentation",
                        "bestowal"
                    ],
                    "common_phrases": [
                        "awarding of prizes"
                    ],
                    "target_lang_definitions": {
                        "pl": "Akt przyznania nagrody lub wyróżnienia komuś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przyznanie",
                                "target_lang_sense_clarification": "oficjalne nadanie nagrody lub tytułu"
                            },
                            {
                                "target_lang_word": "wręczenie",
                                "target_lang_sense_clarification": "fizyczny akt przekazania nagrody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dec42ec-b310-365e-9a47-54bdee228cd2",
                    "sense_definition": "The act of officially deciding to give a contract or legal judgment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>awarding</w> of the construction contract was delayed by legal disputes.",
                            "target_lang_translations": {
                                "pl": "<w>Udzielenie</w> kontraktu budowlanego zostało opóźnione przez spory prawne."
                            }
                        },
                        {
                            "text": "Strict rules govern the <w>awarding</w> of government projects to private firms.",
                            "target_lang_translations": {
                                "pl": "Surowe zasady regulują <w>przyznawanie</w> projektów rządowych prywatnym firmom."
                            }
                        }
                    ],
                    "synonyms": [
                        "allocation",
                        "granting"
                    ],
                    "common_phrases": [
                        "awarding of contracts"
                    ],
                    "target_lang_definitions": {
                        "pl": "Akt oficjalnego decydowania o przyznaniu kontraktu lub wydaniu wyroku sądowego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "udzielenie",
                                "target_lang_sense_clarification": "w kontekście kontraktów lub zamówień"
                            },
                            {
                                "target_lang_word": "przyznanie",
                                "target_lang_sense_clarification": "w kontekście decyzji administracyjnych lub prawnych"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c96724b-17aa-3220-8aef-ca98003fcfa3",
                    "sense_definition": "The present participle and gerund of <w>award</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee is currently <w>awarding</w> grants to local artists.",
                            "target_lang_translations": {
                                "pl": "Komitet obecnie <w>przyznaje</w> dotacje lokalnym artystom."
                            }
                        },
                        {
                            "text": "He enjoys <w>awarding</w> points to students who participate in class.",
                            "target_lang_translations": {
                                "pl": "Lubi <w>przyznawać</w> punkty uczniom, którzy uczestniczą w zajęciach."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb award."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów czasu teraźniejszego i rzeczownik odczasownikowy od słowa 'award' (przyznawać)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przyznawanie",
                                "target_lang_sense_clarification": "proces nadawania czegoś komuś"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}