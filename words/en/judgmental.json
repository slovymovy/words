{
    "word_family": [
        "judge",
        "judgment",
        "judgmentally",
        "misjudge",
        "prejudge",
        "prejudgment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cc4cda06-c42d-3a79-9069-8cbe4000aa51",
                    "sense_definition": "Quick to criticize or form negative opinions about other people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "critical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Try not to be too <w>judgmental</w> until you understand all of the facts.",
                            "target_lang_translations": {
                                "ru": "Постарайся не быть слишком <w>осуждающим</w>, пока не поймёшь всех фактов."
                            }
                        },
                        {
                            "text": "She hated talking about her mistakes in front of such <w>judgmental</w> colleagues.",
                            "target_lang_translations": {
                                "ru": "Она терпеть не могла говорить о своих ошибках перед столь <w>критично настроенными</w> коллегами."
                            }
                        }
                    ],
                    "synonyms": [
                        "critical",
                        "censorious",
                        "faultfinding"
                    ],
                    "antonyms": [
                        "accepting",
                        "unjudgmental",
                        "nonjudgmental"
                    ],
                    "common_phrases": [
                        "judgmental attitude",
                        "sound judgmental",
                        "feel judgmental"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный критиковать или легко и категорично осуждать других людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осуждающий",
                                "target_lang_sense_clarification": "склонный порицать и упрекать"
                            },
                            {
                                "target_lang_word": "критичный",
                                "target_lang_sense_clarification": "склонный находить недостатки"
                            },
                            {
                                "target_lang_word": "категоричный",
                                "target_lang_sense_clarification": "склонный к резким однозначным суждениям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cbb73bd-6c77-3edf-8d6e-615e1ffd1c37",
                    "sense_definition": "Relating to the act, process, or capacity of making a judgment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "judgment_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee had to rely on a <w>judgmental</w> assessment rather than exact data.",
                            "target_lang_translations": {
                                "ru": "Комитету пришлось полагаться скорее на <w>экспертную</w> оценку, чем на точные данные."
                            }
                        },
                        {
                            "text": "Evaluating artistic merit often involves subjective and <w>judgmental</w> criteria.",
                            "target_lang_translations": {
                                "ru": "Оценка художественных достоинств часто опирается на субъективные и <w>оценочные</w> критерии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "judgmental process",
                        "judgmental error"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с процессом вынесения экспертного или субъективного суждения, оценки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспертный",
                                "target_lang_sense_clarification": "основанный на профессиональном мнении, а не на точных расчетах"
                            },
                            {
                                "target_lang_word": "субъективно-оценочный",
                                "target_lang_sense_clarification": "связанный с личным суждением или оценкой"
                            },
                            {
                                "target_lang_word": "оценочный",
                                "target_lang_sense_clarification": "относящийся к суждению или оценке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}