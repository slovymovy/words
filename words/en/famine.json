    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5080d9c4-3739-3049-95cb-9d07e72c78ee",
                    "sense_definition": "An extreme and widespread shortage of food in a region.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shortage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country suffered a terrible <w>famine</w> after the crops failed for three years."
                        },
                        {
                            "text": "International aid was sent to prevent a <w>famine</w> in the drought-stricken region."
                        }
                    ],
                    "common_phrases": [
                        "widespread famine",
                        "prevent famine"
                    ]
                },
                {
                    "sense_id": "11292b06-1043-3999-9e77-20ab73f85cf3",
                    "sense_definition": "A specific period of time characterized by an extreme shortage of food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shortage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "History books often describe the <w>famine</w> of the nineteenth century."
                        },
                        {
                            "text": "Many families struggled to survive during the long <w>famine</w>."
                        }
                    ],
                    "common_phrases": [
                        "during the famine"
                    ]
                },
                {
                    "sense_id": "414de0ff-bb8c-3ec3-ab29-613eb814ee8c",
                    "sense_definition": "The state of suffering from extreme hunger or malnutrition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shortage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoners were near death from <w>famine</w> and exhaustion."
                        },
                        {
                            "text": "He barely survived the <w>famine</w> that killed so many in his village."
                        }
                    ]
                },
                {
                    "sense_id": "c03ef89c-c941-3e7a-915d-0e0d9642cb58",
                    "sense_definition": "A severe lack or scarcity of a particular resource.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shortage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The industry faced a severe <w>famine</w> of skilled workers."
                        },
                        {
                            "text": "There is a <w>famine</w> of new ideas in the current project."
                        }
                    ],
                    "common_phrases": [
                        "famine of resources"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d0190dec-a3dd-3592-a71a-91dc3aa1ae83",
                    "sense_definition": "The personification of hunger, often depicted as a rider on a black horse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythology",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "In the biblical vision, <w>Famine</w> appears as the third horseman."
                        },
                        {
                            "text": "The artist painted <w>Famine</w> as a dark figure on a horse."
                        }
                    ],
                    "synonyms": [
