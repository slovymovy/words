                "senses": [
                    {
                        "sense_id": "f75a7f71-e6fc-3166-8625-9ec595a6b0d5",
                        "entry_id": "585c3ece-aa0d-3a99-bc63-93dc9e82bb7a",
                        "glosses": [
                            "jemand, der kulturellen Veranstaltungen nichts abgewinnen kann"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c56df5c3-cf62-4f01-abbd-ebe19dce2bbe",
                                "sense_id": "f75a7f71-e6fc-3166-8625-9ec595a6b0d5",
                                "text": "„Diesen Gedankengang wiederum finden augenscheinlich auch Kulturmuffel bestechend.“"
                            },
                            {
                                "example_id": "01b05603-87be-4a9b-b566-762e6427cca8",
                                "sense_id": "f75a7f71-e6fc-3166-8625-9ec595a6b0d5",
                                "text": "„Kulturmuffel aber sind die Ostler nicht: Während die Wessis sich häufiger auf dem Tennisplatz oder in der Kneipe herumdrücken, gehen Ostdeutsche öfter ins Theater, hören Musik und basteln daheim mit der Familie.“"
                            },
                            {
                                "example_id": "7780a87d-ba22-486c-a3f3-b3b192e5a6b5",
                                "sense_id": "f75a7f71-e6fc-3166-8625-9ec595a6b0d5",
                                "text": "„Weil wir unlängst aus Schweden von einer wissenschaftlichen Untersuchung an 13000 Leuten erfahren haben. Ergebnis: Bei Kulturmuffeln liegt die Sterblichkeitsrate um das Anderthalbfache höher als bei eifrigen Kulturkonsumenten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
