                    {
                        "translation_id": "e363bdbd-6f26-4619-8a8c-be6227f404fc",
                        "source_entry_id": "9a0dfb3f-90eb-37f6-91ea-22609489abec",
                        "source_sense_id": "768341fc-d3b5-3145-816e-e1e79159c3b0",
