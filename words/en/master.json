{
    "word_family": [
        "masterful",
        "mastery",
        "masterpiece",
        "mastermind",
        "masterclass",
        "masterwork"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e7a532b-e4e1-37d4-b690-1f8a0d7ec371",
                    "sense_definition": "A person who is very skilled or proficient in a particular activity or subject.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "proficiency_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mark Twain was a <w>master</w> of fiction and storytelling.",
                            "target_lang_translations": {
                                "ru": "Марк Твен был <w>мастером</w> художественной прозы и повествования.",
                                "zh": "马克·吐温是小说和讲故事的<w>大师</w>。"
                            }
                        },
                        {
                            "text": "She is a <w>master</w> at solving difficult mathematical puzzles.",
                            "target_lang_translations": {
                                "ru": "Она настоящий <w>мастер</w> в решении сложных математических головоломок.",
                                "zh": "她是解决高难度数学谜题的<w>能手</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expert",
                        "adept",
                        "wizard",
                        "virtuoso",
                        "pro",
                        "specialist"
                    ],
                    "common_phrases": [
                        "master of disguise",
                        "chess master",
                        "grand master",
                        "past master"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий высоким мастерством или квалификацией в каком-либо деле.",
                        "zh": "在某项活动或学科中非常熟练或精通的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастер",
                                "target_lang_sense_clarification": "человек, достигший совершенства в своей профессии"
                            },
                            {
                                "target_lang_word": "умелец",
                                "target_lang_sense_clarification": "искусный работник"
                            },
                            {
                                "target_lang_word": "виртуоз",
                                "target_lang_sense_clarification": "человек, владеющий техникой искусства в совершенстве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大师",
                                "target_lang_sense_clarification": "在艺术或学术领域有极高造诣的人"
                            },
                            {
                                "target_lang_word": "能手",
                                "target_lang_sense_clarification": "擅长某项具体工作的人"
                            },
                            {
                                "target_lang_word": "专家",
                                "target_lang_sense_clarification": "在特定领域有专门知识的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b13c79a-ce4d-3169-8d6c-a340bbb918f1",
                    "sense_definition": "An advanced university degree usually obtained after a bachelor's degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to study for a <w>master</w> in psychology at the state university.",
                            "target_lang_translations": {
                                "ru": "Она решила учиться на <w>магистра</w> психологии в государственном университете.",
                                "zh": "她决定在州立大学攻读心理学<w>硕士</w>学位。"
                            }
                        },
                        {
                            "text": "He worked hard to earn his <w>master</w> in business administration.",
                            "target_lang_translations": {
                                "ru": "Он усердно работал, чтобы получить степень <w>магистра</w> делового администрирования.",
                                "zh": "他努力学习，获得了工商管理<w>硕士</w>学位。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "master's degree",
                        "master of arts",
                        "master of science"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учёная степень, следующая за бакалавром, или человек, имеющий эту степень.",
                        "zh": "通常在学士学位之后获得的进阶大学学位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магистр",
                                "target_lang_sense_clarification": "ученая степень"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "硕士",
                                "target_lang_sense_clarification": "研究生学位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "999ba1ca-8d79-364b-8eba-8fb53de7a7ae",
                    "sense_definition": "A person who has control, authority, or ownership over someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authority_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog ran happily to its <w>master</w> when he returned home.",
                            "target_lang_translations": {
                                "ru": "Собака радостно побежала к своему <w>хозяину</w>, когда он вернулся домой.",
                                "zh": "当他回家时，那只狗高兴地跑向它的<w>主人</w>。"
                            }
                        },
                        {
                            "text": "He likes to be the <w>master</w> of his own destiny.",
                            "target_lang_translations": {
                                "ru": "Ему нравится быть <w>хозяином</w> своей судьбы.",
                                "zh": "他喜欢做自己命运的<w>主宰</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "owner",
                        "ruler",
                        "boss"
                    ],
                    "antonyms": [
                        "slave"
                    ],
                    "common_phrases": [
                        "master of the house",
                        "be your own master"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, имеющий власть, контроль или право собственности над кем-либо или чем-либо.",
                        "zh": "对某人或某物拥有控制权、权威或所有权的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хозяин",
                                "target_lang_sense_clarification": "владелец животного или глава дома"
                            },
                            {
                                "target_lang_word": "повелитель",
                                "target_lang_sense_clarification": "тот, кто имеет полную власть"
                            },
                            {
                                "target_lang_word": "владелец",
                                "target_lang_sense_clarification": "собственник"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主人",
                                "target_lang_sense_clarification": "拥有宠物或房产的人"
                            },
                            {
                                "target_lang_word": "主宰",
                                "target_lang_sense_clarification": "掌握命运或局势的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14f63a11-c02b-39f9-849d-6a0be931bdd8",
                    "sense_definition": "Someone who employs others, often used in historical or formal contexts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "authority_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The servant brought a message to his <w>master</w> in the study.",
                            "target_lang_translations": {
                                "ru": "Слуга принес послание своему <w>господину</w> в кабинет.",
                                "zh": "仆人把消息带给了书房里的<w>老爷</w>。"
                            }
                        },
                        {
                            "text": "The workers respected their <w>master</w> because he treated them fairly.",
                            "target_lang_translations": {
                                "ru": "Рабочие уважали своего <w>хозяина</w>, потому что он относился к ним справедливо.",
                                "zh": "工人们很尊敬他们的<w>雇主</w>，因为他对待他们很公平。"
                            }
                        }
                    ],
                    "synonyms": [
                        "employer"
                    ],
                    "antonyms": [
                        "worker"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "common in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто нанимает других; часто используется в историческом контексте.",
                        "zh": "雇佣他人的人，常用于历史或正式语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "господин",
                                "target_lang_sense_clarification": "обращение слуги к нанимателю"
                            },
                            {
                                "target_lang_word": "хозяин",
                                "target_lang_sense_clarification": "наниматель или владелец"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雇主",
                                "target_lang_sense_clarification": "雇佣劳动者的人"
                            },
                            {
                                "target_lang_word": "老爷",
                                "target_lang_sense_clarification": "旧时仆人对雇主的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2258ea59-92e2-3be8-b57b-898d36ec2eaa",
                    "sense_definition": "The original document, recording, or film from which copies are made.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "original_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band couldn't find the <w>master</w>, so they had to re-record the song.",
                            "target_lang_translations": {
                                "ru": "Группа не могла найти <w>оригинал</w>, поэтому им пришлось перезаписать песню.",
                                "zh": "乐队找不到<w>母带</w>，所以不得不重新录制这首歌。"
                            }
                        },
                        {
                            "text": "Please keep the <w>master</w> safe and only use copies for distribution.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, храните <w>оригинал</w> в безопасности и используйте для распространения только копии.",
                                "zh": "请妥善保管<w>原件</w>，仅使用副本进行分发。"
                            }
                        }
                    ],
                    "synonyms": [
                        "original"
                    ],
                    "common_phrases": [
                        "master copy",
                        "digital master",
                        "master tape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исходный документ, запись или пленка, с которых делаются копии.",
                        "zh": "用于制作副本的原始文档、录音或影片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оригинал",
                                "target_lang_sense_clarification": "исходный экземпляр"
                            },
                            {
                                "target_lang_word": "мастер-копия",
                                "target_lang_sense_clarification": "технический термин для исходной записи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "原件",
                                "target_lang_sense_clarification": "原始文件"
                            },
                            {
                                "target_lang_word": "母带",
                                "target_lang_sense_clarification": "录音或视频的原始录制版本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d59419c4-fc14-3a0c-a12c-43c0de61e6f0",
                    "sense_definition": "The captain of a merchant ship.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>master</w> of the vessel ordered the crew to prepare for the storm.",
                            "target_lang_translations": {
                                "ru": "<w>Капитан</w> судна приказал экипажу готовиться к шторму.",
                                "zh": "这艘船的<w>船长</w>命令船员为暴风雨做好准备。"
                            }
                        },
                        {
                            "text": "He is a qualified <w>master</w> mariner with years of experience at sea.",
                            "target_lang_translations": {
                                "ru": "Он квалифицированный <w>капитан</w> торгового флота с многолетним опытом работы в море.",
                                "zh": "他是一位拥有多年海上经验的合格<w>船长</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "captain",
                        "skipper"
                    ],
                    "common_phrases": [
                        "master mariner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Капитан торгового судна.",
                        "zh": "商船的船长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капитан",
                                "target_lang_sense_clarification": "командир судна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "船长",
                                "target_lang_sense_clarification": "船舶的指挥官"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d2d7853-a323-354d-afb5-5680c872d9a1",
                    "sense_definition": "A male schoolteacher.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "education_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The math <w>master</w> was known for being very strict with the students.",
                            "target_lang_translations": {
                                "ru": "<w>Учитель</w> математики был известен своей строгостью к ученикам.",
                                "zh": "那位数学<w>教师</w>以对学生要求严格而闻名。"
                            }
                        },
                        {
                            "text": "He worked as a <w>master</w> at a private boarding school in England.",
                            "target_lang_translations": {
                                "ru": "Он работал <w>учителем</w> в частной школе-интернате в Англии.",
                                "zh": "他在英国的一所私立寄宿学校担任<w>教师</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "teacher"
                    ],
                    "common_phrases": [
                        "head master"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "mostly historical or traditional schools"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Школьный учитель (обычно в частных школах Великобритании).",
                        "zh": "男教师，尤指英国私立学校的教师。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учитель",
                                "target_lang_sense_clarification": "преподаватель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "教师",
                                "target_lang_sense_clarification": "教学人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27a58ce1-f62e-30a9-b3ee-e425c045b1a3",
                    "sense_definition": "A title prefixed to the name of a boy not old enough to be called Mister.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butler addressed the young boy as <w>Master</w> Wayne.",
                            "target_lang_translations": {
                                "ru": "Дворецкий обращался к мальчику как <w>мастер</w> Уэйн.",
                                "zh": "管家称呼那个小男孩为韦恩<w>少爷</w>。"
                            }
                        },
                        {
                            "text": "I am terribly sorry, <w>Master</w> Luke, but we cannot go there.",
                            "target_lang_translations": {
                                "ru": "Мне ужасно жаль, <w>мастер</w> Люк, но мы не можем туда пойти.",
                                "zh": "非常抱歉，卢克<w>少爷</w>，我们不能去那里。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "formal or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливое обращение к мальчику, который еще слишком мал, чтобы его называли \"мистер\".",
                        "zh": "对尚未成年、不能被称为“先生”的男孩的礼貌称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастер",
                                "target_lang_sense_clarification": "используется в переводах английской литературы"
                            },
                            {
                                "target_lang_word": "молодой господин",
                                "target_lang_sense_clarification": "устаревшее или формальное обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少爷",
                                "target_lang_sense_clarification": "对年轻男子的尊称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72aa4f37-b06b-39f3-8454-0de2df7d3efe",
                    "sense_definition": "To learn a skill or language completely so that you can do it or understand it very well.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "proficiency_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took her many years to <w>master</w> the art of playing the piano.",
                            "target_lang_translations": {
                                "ru": "Ей потребовалось много лет, чтобы <w>овладеть</w> искусством игры на фортепиано.",
                                "zh": "她花了很多年才<w>掌握</w>了弹钢琴的艺术。"
                            }
                        },
                        {
                            "text": "He managed to <w>master</w> the basics of the language in just three months.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>освоить</w> основы языка всего за три месяца.",
                                "zh": "他只用了三个月就<w>精通</w>了这门语言的基础知识。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grasp",
                        "learn",
                        "perfect",
                        "pick up"
                    ],
                    "common_phrases": [
                        "master a skill",
                        "master a language",
                        "master the art"
                    ],
                    "target_lang_definitions": {
                        "ru": "Овладеть навыком или языком в совершенстве.",
                        "zh": "完全学会一项技能或语言，达到精通程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овладеть",
                                "target_lang_sense_clarification": "научиться чему-либо в совершенстве"
                            },
                            {
                                "target_lang_word": "освоить",
                                "target_lang_sense_clarification": "изучить основы или навык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掌握",
                                "target_lang_sense_clarification": "熟练地运用或理解"
                            },
                            {
                                "target_lang_word": "精通",
                                "target_lang_sense_clarification": "深入透彻地了解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd758c57-8f86-3471-b910-da1c9dfb3c39",
                    "sense_definition": "To manage to control or defeat an emotion, a situation, or an opponent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authority_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled to <w>master</w> her fear before walking onto the stage.",
                            "target_lang_translations": {
                                "ru": "Она изо всех сил пыталась <w>побороть</w> свой страх перед выходом на сцену.",
                                "zh": "在走上舞台之前，她努力<w>克服</w>了自己的恐惧。"
                            }
                        },
                        {
                            "text": "The team finally <w>mastered</w> their opponents in the final minutes of the game.",
                            "target_lang_translations": {
                                "ru": "Команда наконец <w>одолела</w> своих противников на последних минутах игры.",
                                "zh": "球队在比赛的最后几分钟终于<w>征服</w>了对手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conquer",
                        "overcome",
                        "subdue"
                    ],
                    "common_phrases": [
                        "master one's feelings",
                        "master the situation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Справиться с эмоциями, ситуацией или противником; взять под контроль.",
                        "zh": "设法控制或克服某种情绪、局势或对手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справиться",
                                "target_lang_sense_clarification": "взять под контроль эмоции или ситуацию"
                            },
                            {
                                "target_lang_word": "побороть",
                                "target_lang_sense_clarification": "победить чувство или страх"
                            },
                            {
                                "target_lang_word": "одолеть",
                                "target_lang_sense_clarification": "победить противника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "克服",
                                "target_lang_sense_clarification": "战胜困难或情绪"
                            },
