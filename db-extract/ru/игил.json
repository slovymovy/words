                "senses": [
                    {
                        "sense_id": "f9b3e9e5-6e6e-39f6-a37a-d21da433a3e7",
                        "entry_id": "e0baa141-bfd7-34c4-a61f-0a016077b6eb",
                        "glosses": [
                            "сокр. от Исламское государство Ирака и Леванта; исламистская террористическая организация, образованная в начале XXI века и действующая преимущественно на территории Сирии и Ирака"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75fe6079-2584-4d37-b832-7d3f71edae5d",
                                "sense_id": "f9b3e9e5-6e6e-39f6-a37a-d21da433a3e7",
                                "text": "Около 13 тысяч семей стали беженцами в результате агрессии ИГИЛ в Ираке."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea2f62c2-7ffc-496e-bdc5-7756007801b9",
