                        "sense_id": "634e1460-b463-3136-a75b-a10384a9c4c6",
                        "entry_id": "1e682251-135e-3473-961d-2b807517d448",
                        "glosses": [
                            "het recht om als enige in een bepaald gebied een bepaald product te verkopen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc0d75a-a12e-41d3-80e4-6e028223ff2d",
                                "sense_id": "634e1460-b463-3136-a75b-a10384a9c4c6",
                                "text": "Modehuizen met het recht op de alleenverkoop van exquise Italiaanse merken, ja ja, maar om binnen te komen moet je soms om de rekken met uitverkoopgoed heen lopen."
                            },
                            {
                                "example_id": "3397dd15-303e-4161-a884-44808780e866",
                                "sense_id": "634e1460-b463-3136-a75b-a10384a9c4c6",
                                "text": "De Belgische wet - waarvan we hier de hoofdlijnen aangeven - gaat bijzonder ver in het beschermen van concessiehouders indien er een concessie van alleenverkoop voor onbepaalde duur voorligt. De vergoedingen die worden toegekend aan de concessiehouder liggen, voorzover het niet gaat om een beëindiging om een „dringende reden”, zeer hoog. En dat wordt door concessiegevers meer dan eens vergeten. Zeker als het buitenlandse bedrijven zijn."
                            }
                        ]
                    }
