                ],
                "senses": [
                    {
                        "sense_id": "8c923c8a-9197-3484-b3b7-392e8d1031e9",
                        "entry_id": "55857e4a-c9c1-31a5-b878-8b5f5c132cfd",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92283a7b-9ec3-4dbf-a3de-3616672abf8c",
                                "sense_id": "8c923c8a-9197-3484-b3b7-392e8d1031e9",
                                "text": "Frau Gebardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e54f37ff-b5d8-4d19-86ba-d763c90cc3d2",
                                "sense_id": "8c923c8a-9197-3484-b3b7-392e8d1031e9",
                                "text": "Herr Gebardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f1af4871-8aa7-4392-ba0a-66a5d12b81bd",
                                "sense_id": "8c923c8a-9197-3484-b3b7-392e8d1031e9",
                                "text": "Die Gebardts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7758925a-cbe4-4149-83a8-988d1fee6330",
                                "sense_id": "8c923c8a-9197-3484-b3b7-392e8d1031e9",
                                "text": "Der Gebardt trägt nie die Schals, die die Gebardt ihm strickt."
                            },
                            {
                                "example_id": "b4b97714-d042-45e0-be1a-70ac65edb204",
                                "sense_id": "8c923c8a-9197-3484-b3b7-392e8d1031e9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gebardt kommt, geht der Herr Gebardt.“"
                            },
                            {
                                "example_id": "fab3decb-82d1-4d15-8231-0fd7cb16e299",
                                "sense_id": "8c923c8a-9197-3484-b3b7-392e8d1031e9",
                                "text": "Gebardt kommt und geht."
                            },
                            {
                                "example_id": "e33e89e4-2f71-4537-83af-df63f2b8131f",
                                "sense_id": "8c923c8a-9197-3484-b3b7-392e8d1031e9",
                                "text": "Gebardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
