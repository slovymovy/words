    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e933ba57-dcba-3415-b656-832ff19e0b5c",
                    "sense_definition": "Mouvoir un corps de manière continue d'un côté à l'autre ou d'avant en arrière.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent frais du matin fait <w>balancer</w> doucement les branches des arbres du jardin."
                        },
                        {
                            "text": "En marchant le long du sentier, il aime <w>balancer</w> les bras au rythme de ses pas."
                        }
                    ],
                    "common_phrases": [
                        "balancer les bras"
                    ]
                },
                {
                    "sense_id": "593608d0-a966-3f98-9f8d-b4e4f1205c53",
                    "sense_definition": "Jeter, lancer avec force ou se débarrasser de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "jeter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne garde pas ces vieux papiers, tu devrais les <w>balancer</w> à la poubelle dès aujourd'hui."
                        },
                        {
                            "text": "Il a voulu <w>balancer</w> ses vieux cahiers d'école pour libérer une étagère de son armoire."
                        }
                    ],
                    "common_phrases": [
                        "balancer à la poubelle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "853d4abe-de70-327c-b0cd-cd8aad290435",
                    "sense_definition": "Dénoncer une personne ou révéler ses actes répréhensibles à une autorité ou au public.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "denonciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suspect a refusé de <w>balancer</w> son complice lors de son entretien avec les enquêteurs."
                        },
                        {
                            "text": "Elle a fini par tout <w>balancer</w> aux journalistes pour faire éclater la vérité au grand jour."
                        }
                    ],
                    "synonyms": [
                        "dénoncer"
                    ],
                    "common_phrases": [
                        "balancer un complice"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "terme argotique ou très familier"
                        }
                    ]
                },
                {
                    "sense_id": "8ccf03b4-701b-3b32-8213-5d7af0f778d4",
                    "sense_definition": "Compenser une chose par une autre de façon à établir un équilibre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "equilibre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les gains obtenus ce trimestre viennent enfin <w>balancer</w> les pertes financières des mois précédents."
                        },
                        {
                            "text": "Les nombreux avantages de cette proposition suffisent largement à en <w>balancer</w> les quelques risques."
                        }
                    ]
                },
                {
                    "sense_id": "2f952871-88a3-3b57-b4ea-2742d02dd255",
                    "sense_definition": "Hésiter entre deux partis opposés, être indécis.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à un choix aussi délicat, il a longtemps <w>balancé</w> avant de prendre une décision définitive."
                        },
                        {
                            "text": "Dès qu'on lui a offert le poste, il a accepté l'offre sans <w>balancer</w> une seconde."
                        }
                    ],
                    "common_phrases": [
                        "sans balancer"
                    ]
                },
                {
                    "sense_id": "abc8fe2c-ecc1-3be7-be7f-516adc7aa713",
                    "sense_definition": "Rendre égales les sommes inscrites au débit et au crédit d'un compte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comptable a passé toute la soirée à vérifier les écritures pour <w>balancer</w> un compte difficile."
                        },
                        {
                            "text": "Il manquait quelques centimes dans le registre pour réussir à <w>balancer</w> les totaux du mois."
                        }
                    ],
                    "common_phrases": [
                        "balancer un compte"
                    ]
                }
            ]
        }
    ]
}