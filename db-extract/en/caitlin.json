                                "sense_id": "94c37fe4-64f8-373b-be80-e2c7345fafe7",
                                "text": "Beautiful, charming, rich, clever Caitlin needs one thing: love."
                            },
                            {
                                "example_id": "2117f772-b7dc-400f-85d1-d4cc45e85c51",
                                "sense_id": "94c37fe4-64f8-373b-be80-e2c7345fafe7",
                                "text": "Caitlin is sixteen and a sixth former at The Magna and is under a lot of pressure with exams."
                            },
                            {
                                "example_id": "9f1cb369-99c4-4bb8-971c-8229724f7ab3",
                                "sense_id": "94c37fe4-64f8-373b-be80-e2c7345fafe7",
                                "text": "Sixteen-year-old Caitlin — and all our nieces and sisters and friends — need to grow up in a culture that prizes difference, not conformity."
                            }
