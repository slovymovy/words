                        "entry_id": "8afb4220-0079-38ee-a7cc-3aba9c0a787e",
                        "glosses": [
                            "Cassette audio préenregistrée avec de la musique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "674f5154-b597-422d-a89d-edfa1bf78fbd",
                                "sense_id": "7cfc6143-dcaf-36b5-a77b-27c1f2848a17",
                                "text": "Le voyage se déroula au son d'une musicassette que la jeune fille avait emportée et branchée sur l'allume-cigare."
                            },
                            {
                                "example_id": "40e24098-86f2-4bea-bf91-68aae80e02b8",
                                "sense_id": "7cfc6143-dcaf-36b5-a77b-27c1f2848a17",
                                "text": "Dès maintenant ... et chaque fois que vous achèterez un disque ou une musicassette au prix normal, vous recevrez un certificat de réduction pour un disque ou une musicassette à moitié prix."
                            },
                            {
                                "example_id": "972c7705-02b5-4c14-b887-57618ca63976",
                                "sense_id": "7cfc6143-dcaf-36b5-a77b-27c1f2848a17",
                                "text": "Depuis elles ont connu un développement très frappant, comparé à celui des disques 33 tours : depuis 1970, la quantité annuelle de musicassettes vendues a été multipliée par 13, celle des 33 tours par 2 ; depuis 1974, cette quantité double tout les deux ans."
                            }
                        ]
                    }
