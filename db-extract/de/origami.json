                                "target_senses": [
                                    {
                                        "sense_id": "2e0d0b22-53a4-3d18-80b0-515573bfff79",
                                        "entry_id": "c8fccea2-49ee-3df8-9262-7ca9badfdf56",
                                        "glosses": [
                                            "The Japanese art of paper folding."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0961783-3075-4a86-9267-21160a9848b4",
                                                "sense_id": "2e0d0b22-53a4-3d18-80b0-515573bfff79",
                                                "text": "JongRak was a 10-year-old boy whose hands, eyes, and questions were all about origami: “Teacher, do you know how to fold a jumping frog?” With his deft little hands, he would teach me and the class how to fold a sunflower and a cicada. At some point, every kid’s little hands and pockets were filled with tiny origami models."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d6e84fd-3c4c-3e83-ab9a-c39e78872d0a",
                                        "entry_id": "c8fccea2-49ee-3df8-9262-7ca9badfdf56",
                                        "glosses": [
                                            "A piece of art made by folding paper."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41d471bc-6397-455a-99bb-95f62e7247e2",
                                                "sense_id": "7d6e84fd-3c4c-3e83-ab9a-c39e78872d0a",
                                                "text": "The production notes are folded like the funny origamis that I made in grammar school (only I used to write boy's names inside each section)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65f936f8-778d-305c-9552-9d9ced594386",
                                        "entry_id": "c8fccea2-49ee-3df8-9262-7ca9badfdf56",
                                        "glosses": [
                                            "The materials science technology that applies the art of origami to products."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c78a3a87-3d27-3b5b-bb9b-e6ef52d6543c",
                                        "entry_id": "c8fccea2-49ee-3df8-9262-7ca9badfdf56",
                                        "glosses": [
                                            "The materials science that studies origami applications in various material."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7225fca-25ae-3af3-ac9d-4afeaa175466",
                                        "entry_id": "c8fccea2-49ee-3df8-9262-7ca9badfdf56",
                                        "glosses": [
                                            "The mathematics field that studies folding two-dimensional surfaces into three-dimensional structures, using folds and creases akin to those in the art of origami."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "origami",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb900534-8e6c-3972-bc4a-a8b85ad995c7",
                                        "entry_id": "cf0241a3-9c95-3d9d-a2a3-3bea4f7bd471",
                                        "glosses": [
                                            "To construct by means of decorative paper folding."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6bdb6d2-6748-449e-bced-b2ddcda3cff9",
                                                "sense_id": "fb900534-8e6c-3972-bc4a-a8b85ad995c7",
                                                "text": "He snatched my serviette and swiftly origamied a swan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0afad144-d146-4e2e-b3e2-58b5c0da73ef",
                        "source_entry_id": "56220bf0-05e5-32f5-ab83-806225103abd",
                        "source_sense_id": "d09c5f22-4060-3eaf-aa6d-0f1e2ea58d70",
                        "source_sense_description": "japanische Kunst des Papierfaltens",
                        "target_lang_word": "origami",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "origami",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be6b8a6f-d7ea-3d1a-9a80-270b8de60375",
                                        "entry_id": "99f5451f-e8db-38d2-89e6-e3d885d2ece7",
                                        "glosses": [
                                            "Art traditionnel japonais du pliage du papier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76c836bd-f153-44ea-abdc-35c416b386b1",
                                                "sense_id": "be6b8a6f-d7ea-3d1a-9a80-270b8de60375",
                                                "text": "L’art du pliage de papier (plus connu sous le vocable origami, inventé vers 1950 par L. Oppenheimer) est vraisemblablement originaire de Chine, pays où le papier fut inventé. Si, depuis, la pratique de l’origami s’est perdue dans ce pays, il est apparu au Japon aux environs de 530 de notre ère. Utilisé alors dans un but religieux ou cérémonial, réservé aux seuls initiés, l’origami se popularise à partir du XVᵉ siècle."
                                            },
                                            {
                                                "example_id": "73f7bee0-0c15-4190-a4f0-96549a12bfb5",
                                                "sense_id": "be6b8a6f-d7ea-3d1a-9a80-270b8de60375",
                                                "text": "— Je suis sûr que tes talents d’origamiste vont l’impressionner, dit Gabe. Mais tu sais que tu t'es trompée de pays, pour l’origami ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "142b868f-f1c3-3188-b267-ae2cc19fc992",
                                        "entry_id": "99f5451f-e8db-38d2-89e6-e3d885d2ece7",
                                        "glosses": [
                                            "Objet en papier plié, réalisé selon les règles de l’art japonais."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af9a714f-e649-494f-a778-7a95ba75624d",
                                                "sense_id": "142b868f-f1c3-3188-b267-ae2cc19fc992",
                                                "text": "C’était un pliage en forme de cocotte. Intrigué, il saisit l’origami pour le regarder de plus près. Qui avait bien pu laisser ça ici ? En le tournant sur un côté il vit que la cocotte n’avait pas été pliée à partir d’une feuille vierge […]."
                                            },
                                            {
                                                "example_id": "988372be-e45d-47d6-a50f-9085117b9d86",
                                                "sense_id": "142b868f-f1c3-3188-b267-ae2cc19fc992",
                                                "text": "Dans le cas des origamis, les instructions concernant le mode de pliage ont des conséquences spatiales importantes, qui conditionnent la suite de l’opération."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
