        "nl-extract.jsonl": [
            {
                "entry_id": "c2e63c09-d800-391a-8cf4-182d1c1514ad",
                "word": "teraardebestelling",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "846c468b-8a69-4a36-aeef-bbb74d592dcf",
                        "entry_id": "c2e63c09-d800-391a-8cf4-182d1c1514ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "teraardebestellingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc0d9e66-9183-3112-89cc-e948ed42b97a",
                        "entry_id": "c2e63c09-d800-391a-8cf4-182d1c1514ad",
                        "glosses": [
                            "een vorm van lijkbezorging waarbij iemand die overleden is begraven wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa7d642-4c4e-4983-bf36-9a9090cfa6a8",
                                "sense_id": "bc0d9e66-9183-3112-89cc-e948ed42b97a",
                                "text": "Maar wat willen families zich dan herinneren? Duidelijke afspraken zijn nodig, beseft ook Tombeur. ‘De uitvaart, de teraardebestelling, de koffietafel? Foto’s van het lichaam? Dat zijn moeilijke afwegingen die families moeten maken. Verder blijf ik op de achtergrond. Ik maak dat ik onopgemerkt aanwezig ben. Ik neem dus geen foto’s met flits.’"
                            },
                            {
                                "example_id": "0626b65f-0bf4-4ca3-905f-2a587f33e9a5",
                                "sense_id": "bc0d9e66-9183-3112-89cc-e948ed42b97a",
                                "text": "Medewerkers van de uitvaartverzorger zullen alles in goede banen leiden. Ik wil er nadrukkelijk op wijzen dat de teraardebestelling op Het Lentfert in besloten kring zal plaatshebben\", zegt Holterman."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aef6fb35-0fa5-4566-bef9-82005100af64",
                        "source_entry_id": "c2e63c09-d800-391a-8cf4-182d1c1514ad",
                        "source_sense_id": "bc0d9e66-9183-3112-89cc-e948ed42b97a",
                        "source_sense_description": "begrafenis",
                        "target_lang_word": "burial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5eda4b-2c44-3eeb-9dae-9f6729dc3be5",
                                        "entry_id": "e5dd8c4b-236e-35be-984a-1b718e79bf19",
                                        "glosses": [
                                            "The act of burying; interment; placing remains into the earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "027a1b24-0068-4a22-a6d0-45a77cbddb43",
                                                "sense_id": "fc5eda4b-2c44-3eeb-9dae-9f6729dc3be5",
                                                "text": "His whole family was present at his burial."
                                            },
                                            {
                                                "example_id": "9e0e37eb-fc94-424b-8271-9f037bffeefc",
                                                "sense_id": "fc5eda4b-2c44-3eeb-9dae-9f6729dc3be5",
                                                "text": "The mourners listened as the priest performed the burial service of long-time parishioner Wendy Stuart."
                                            },
                                            {
                                                "example_id": "ae75cfba-8744-4e80-9667-c5f9dd5fffa7",
                                                "sense_id": "fc5eda4b-2c44-3eeb-9dae-9f6729dc3be5",
                                                "text": "A dreary year for the Squadron, this 1819, when officers and men fell sick by the shipload and were sent home by the tenderful, when Lemon Valley Hospital was supplemented by the one at High Peak, when Court-Martials were held at the rate of one a fortnight, burials thrice a week, and surveys on foul provisions every other day!"
                                            },
                                            {
                                                "example_id": "60db26b1-1add-4e85-983b-35835634c1fb",
                                                "sense_id": "fc5eda4b-2c44-3eeb-9dae-9f6729dc3be5",
                                                "text": "However, many Cromlechs and Dolmins are carelessly called \"Druid's circles\", when in reality they were the burial places of ancient chieftains and their households[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c9c3d64-5976-455d-a88e-b39969ae7b95",
                        "source_entry_id": "c2e63c09-d800-391a-8cf4-182d1c1514ad",
                        "source_sense_id": "bc0d9e66-9183-3112-89cc-e948ed42b97a",
                        "source_sense_description": "begrafenis",
                        "target_lang_word": "inhumation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhumation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35cddb1d-4ac7-3272-bc5b-24d5a08f3f87",
                                        "entry_id": "d4478c49-9d47-377f-8cf6-dae29272b87c",
                                        "glosses": [
                                            "The act of burial."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb48398-2645-4913-bfec-fedabc8b4bf1",
                                                "sense_id": "35cddb1d-4ac7-3272-bc5b-24d5a08f3f87",
                                                "text": "\"Cremation versus Inhumation\" was the subject considered at the meeting of the Nineteenth Century Club at the residence of Mr. Courtlandt Palmer, No. 117 East One Hundred and Seventeenth-street, last evening."
                                            },
                                            {
                                                "example_id": "412ff7ba-44bc-49c0-83fb-801ce7e467a6",
                                                "sense_id": "35cddb1d-4ac7-3272-bc5b-24d5a08f3f87",
                                                "text": "Stampolidis's team has unearthed three types of Iron Age burials at Orthi Petra . . . dating from the ninth to the seventh century B.C.: pithos (large ceramic jar) burials, cremations, and basic inhumations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d83e7b0b-58f9-3509-bafc-d3f1defaadb2",
                                        "entry_id": "d4478c49-9d47-377f-8cf6-dae29272b87c",
                                        "glosses": [
                                            "The act of burying vessels in warm earth in order to expose their contents to a steady moderate heat; the state of being thus exposed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
