                    "frequency": "Low",
                    "semantic_group_id": "doden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bendeleden dreigden hem te <w>mollen</w> als hij met de politie zou praten.",
                            "target_lang_translations": {
