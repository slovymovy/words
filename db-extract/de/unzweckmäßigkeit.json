                ],
                "senses": [
                    {
                        "sense_id": "ddda1a67-6eb8-3edb-a3be-ab23ccc3b6b4",
                        "entry_id": "786beaee-8550-38eb-b702-2dc400e1128d",
                        "glosses": [
                            "Zustand und/oder Eigenschaft, für seinen Zweck ungeeignet, nicht angemessen zu sein; Nutzlosigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ccb1a70-a968-4c77-9171-28c250649ab8",
                                "sense_id": "ddda1a67-6eb8-3edb-a3be-ab23ccc3b6b4",
                                "text": "„Vor dem Hintergrund der Informationseffizienz betrachtet gilt erneut, dass aus Kapitalgebersicht eine klare Unzweckmäßigkeit zu konstatieren ist.“"
                            },
                            {
                                "example_id": "7a166faa-bbc4-4a03-9f9b-b71f78ca009f",
                                "sense_id": "ddda1a67-6eb8-3edb-a3be-ab23ccc3b6b4",
                                "text": "„In Paragraf 92 wollen die Regierungsfraktionen sogar den Satz einfügen: Er dürfe nur dann ‚die Verordnung von Arzneimitteln einschränken oder ausschließen, wenn die Unzweckmäßigkeit erwiesen ist‘.“"
                            },
                            {
                                "example_id": "2418f2cd-1191-4f1f-b079-f2225f239329",
                                "sense_id": "ddda1a67-6eb8-3edb-a3be-ab23ccc3b6b4",
                                "text": "„Man glaube nicht, daß dies Verfahren die Studenten von der Unzweckmäßigkeit ihrer Proteste überzeugt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
