                        "glosses": [
                            "Instrument destiné à couper le pain sur lequel on verse le bouillon."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7c9cd33b-8b9a-499a-8b10-68ae65bd2084",
                                "sense_id": "def2ea3d-667c-3097-8783-d77fe5d23fc7",
                                "text": "Une autre médaille de bronze a été décernée à M. Prudhon pour un taille-soupe. Cet instrument, dont le nom indique suffisamment l'usage, doit être recommandé à tous les établissements qui ont un nombreux personnel à nourrir."
                            },
                            {
                                "example_id": "82bbb8e3-4a4b-4cec-93d9-64f2a011ce56",
                                "sense_id": "def2ea3d-667c-3097-8783-d77fe5d23fc7",
                                "text": "Comme son nom l'indique, le taille-soupe servait à couper des tranches de pain, les plus minces possibles, dans des gros pains faits à la maison qui avaient souvent quinze jours."
                            }
                        ]
                    }
