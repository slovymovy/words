                                        "sense_id": "6e8041cd-9e58-3094-8aa1-c9a38439c156",
                                        "entry_id": "f29e18a1-0878-3244-9d83-7d843c8e43f8",
                                        "glosses": [
                                            "Ensemble des procédures de contrôle de marchandises."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5291d250-c787-4622-9eac-8251b19ca905",
                                                "sense_id": "6e8041cd-9e58-3094-8aa1-c9a38439c156",
                                                "text": "… les provenances et les qualités ne nous sont jamais annonces dans les billets d’envoi et elles ne peuvent pas être déterminées d’une façon irrécusable par notre personnel du titrage."
                                            }
                                        ]
                                    },
