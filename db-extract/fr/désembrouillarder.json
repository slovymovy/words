                        "glosses": [
                            "Libérer du brouillard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32655ae2-0ffc-49eb-9e19-213be0830842",
                                "sense_id": "6f133fd6-bed8-38f5-b507-d99a820302b6",
                                "text": "Marc se frotta les yeux. Était-ce encore un rêve ? Quelle heure était-il donc ? Minuit sonnèrent. L’esprit désembrouillardé, Marc comprit."
                            },
                            {
                                "example_id": "8f7567c0-59b7-4e15-93f8-b30b992f758a",
                                "sense_id": "6f133fd6-bed8-38f5-b507-d99a820302b6",
                                "text": "Ils ont parfois bousculé la hiérarchie des valeurs et les habitudes établies, déboulonné les statues, désembrouillardé les mythes…"
                            },
                            {
                                "example_id": "3de7bc13-62a5-4f55-98ca-39c2b326eee9",
                                "sense_id": "6f133fd6-bed8-38f5-b507-d99a820302b6",
                                "text": "D'où tous ces embrouillottages que des citoyens courageux passent leur temps à désembrouillarder."
                            },
                            {
                                "example_id": "98a46420-dee6-4268-8907-dc2f6de00fb4",
                                "sense_id": "6f133fd6-bed8-38f5-b507-d99a820302b6",
                                "text": "Les utilisateurs aiment aussi ces idées. Ou comment se \"désembrouillarder\" grâce au dessin."
                            }
                        ]
                    }
                ],
