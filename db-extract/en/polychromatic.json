    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b969238d-a78b-36b6-98ab-1fa9eda96f17",
                "word": "polychromatic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f672a1a7-c322-3cc7-8080-3481bf428dfa",
                        "entry_id": "b969238d-a78b-36b6-98ab-1fa9eda96f17",
                        "glosses": [
                            "Showing a variety, or a change, of colours; having many colours."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f55e2786-2929-4b73-91b0-2d6f554b29e5",
                                "sense_id": "f672a1a7-c322-3cc7-8080-3481bf428dfa",
                                "text": "With our water goggles adjusted we gazed at the fishes displaying their polychromatic scales to the sea world, as, with true Puka-Pukan languor, they finned from coral to coral."
                            },
                            {
                                "example_id": "8b8d95c1-e387-4cb2-8cc4-7c6043cbd89e",
                                "sense_id": "f672a1a7-c322-3cc7-8080-3481bf428dfa",
                                "text": "As I rounded the corner nearest my hotel the Afrite coachman of the polychromatic, nonpareil coat seized me, swung open the dungeony door of his peripatetic sarcophagus, flirted his feather duster and began his ritual: […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e39920df-8909-364b-ac45-7757daacd2c9",
                        "entry_id": "b969238d-a78b-36b6-98ab-1fa9eda96f17",
                        "glosses": [
                            "Composed of more than one wavelength."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ef50809-cb2c-433d-b17a-5141833b5f72",
                        "source_entry_id": "b969238d-a78b-36b6-98ab-1fa9eda96f17",
                        "source_sense_description": "showing a variety of colours",
