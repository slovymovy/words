                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f7fccb5-0191-38cd-b07c-cc92cca2198c",
                        "entry_id": "2da0c713-ef20-38fb-b684-d172e5dabdae",
                        "glosses": [
                            "Ort, an dem etwas gefunden wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae912e65-2ebe-4e71-9cdc-15866b72b407",
                                "sense_id": "5f7fccb5-0191-38cd-b07c-cc92cca2198c",
                                "text": "Benannt wurde sie nach einem Fundort in einem Vorort von Paris."
                            },
                            {
                                "example_id": "d8e8e314-7574-4c2a-896a-435f3335e9c4",
                                "sense_id": "5f7fccb5-0191-38cd-b07c-cc92cca2198c",
                                "text": "„Die Wanderung ging durch einen Bachgrund, Dr. Mohr wies die Primaner auf die Fundorte von Seidelbast und Kuhschelle, Veilchen und Maiglöckchen hin, Käthe blieb in einem Sonnenstrich zurück, als sie weiterging, bemerkte sie, daß Ludwig Thelen auf sie wartete.“"
                            },
                            {
                                "example_id": "7336de69-0d37-4881-b41f-bb657d49e3a9",
                                "sense_id": "5f7fccb5-0191-38cd-b07c-cc92cca2198c",
                                "text": "„Manche Fundorte waren lediglich 200 Kilometer von der österreichischen Staatsgrenze entfernt.“"
                            },
                            {
                                "example_id": "00589079-5313-453e-b5c3-72b8eecc58fc",
                                "sense_id": "5f7fccb5-0191-38cd-b07c-cc92cca2198c",
                                "text": "„Schnell kamen weitere Fundorte hinzu – aber nicht unbedingt da, wo man sie vermutete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41079eea-bfd3-49f2-97e8-3548efd9d20a",
                        "source_entry_id": "2da0c713-ef20-38fb-b684-d172e5dabdae",
                        "source_sense_id": "5f7fccb5-0191-38cd-b07c-cc92cca2198c",
                        "source_sense_description": "Ort, an dem etwas gefunden wurde",
                        "target_lang_word": "find spot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "962ca6b7-47c0-4b87-b092-fa8b4ced02d7",
                        "source_entry_id": "2da0c713-ef20-38fb-b684-d172e5dabdae",
                        "source_sense_id": "5f7fccb5-0191-38cd-b07c-cc92cca2198c",
                        "source_sense_description": "Ort, an dem etwas gefunden wurde",
                        "target_lang_word": "gisement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gisement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e39fbdf-00af-3b08-83db-351f9fc769f2",
                                        "entry_id": "4a4c5a9e-45f8-33b3-a738-78c45369a0d4",
                                        "glosses": [
                                            "Situation des côtes de la mer."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0559d689-0888-4de4-bde3-ab4cc23bf874",
                                                "sense_id": "5e39fbdf-00af-3b08-83db-351f9fc769f2",
                                                "text": "Les bons pilotes doivent connaître le gisement des côtes où ils veulent aborder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d70cc25e-5b8a-35f8-a29b-68a311ea9414",
                                        "entry_id": "4a4c5a9e-45f8-33b3-a738-78c45369a0d4",
                                        "glosses": [
                                            "Coordonnées d'un lieu."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0c12397-de97-490a-bc41-668c2072f4ae",
                                                "sense_id": "d70cc25e-5b8a-35f8-a29b-68a311ea9414",
                                                "text": "Pour la même raison nous n'y avons mis que les villes, les kasbas et les zâouias importantes visitées par nous-même et quelques autres dont le gisement semble assez exactement établi, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a0c8ca-a1cb-39af-b119-78ffa70f1e03",
                                        "entry_id": "4a4c5a9e-45f8-33b3-a738-78c45369a0d4",
                                        "glosses": [
                                            "Position des masses de minéraux dans la terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3714b5ff-9155-46d4-985b-e999fd6e61d4",
                                                "sense_id": "a7a0c8ca-a1cb-39af-b119-78ffa70f1e03",
                                                "text": "Mais il faut connaître plutôt la constitution des substances dont il s’agit, les gisements géologiques, les actions atmosphériques."
                                            },
                                            {
                                                "example_id": "e3588492-7601-42d5-8e64-ae6c91822b59",
                                                "sense_id": "a7a0c8ca-a1cb-39af-b119-78ffa70f1e03",
                                                "text": "Le gisement tuffeux de La Celle-sur-Seine que nous visiterons dimanche 6 mai est une des stations paléontologiques les plus importantes de la région parisienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6a504a2-f7d9-3d2e-b352-d750aeeae0a3",
                                        "entry_id": "4a4c5a9e-45f8-33b3-a738-78c45369a0d4",
                                        "glosses": [
                                            "Filon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10fa459d-c10c-4778-b111-bb8c01f71c48",
                                                "sense_id": "c6a504a2-f7d9-3d2e-b352-d750aeeae0a3",
                                                "text": "Les phosphates arénacés, ou sables phosphatés, se rencontrent dans des poches à la partie supérieure de la craie à bélemnites, sur la limite des départements de la Somme et du Pas-de-Calais. Les principaux gisements sont à Beauval, Hallencourt et Orville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1da11b22-77e6-3b72-a993-94c7c4b65568",
                                        "entry_id": "4a4c5a9e-45f8-33b3-a738-78c45369a0d4",
                                        "glosses": [
                                            "Ressource disponible d’une matière première, y compris, en mercatique, de la clientèle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e72e81b-4552-45db-a22c-7f3ddabf473c",
                                                "sense_id": "1da11b22-77e6-3b72-a993-94c7c4b65568",
                                                "text": "Toujours plus voraces, les marchés asiatiques dépouillent nos forêts et privent, in fine, le marché intérieur des investissements qui lui sont nécessaires. « Le gisement n’a pas le temps de se renouveler et le temps nécessaire s’évalue en décennies », confirme le forestier."
                                            },
                                            {
                                                "example_id": "436670a6-78be-4ab7-88be-ff24b6772b64",
                                                "sense_id": "1da11b22-77e6-3b72-a993-94c7c4b65568",
                                                "text": "Le bois de la forêt Beaujolaise est un formidable gisement de matière première renouvelable, écologique et en pleine expansion."
                                            },
                                            {
                                                "example_id": "8f599bca-5f63-48b1-b5d9-5779c7de45c7",
                                                "sense_id": "1da11b22-77e6-3b72-a993-94c7c4b65568",
                                                "text": "Le gisement de clientèle nocturne révélé par Heetch attire les taxis"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dd4d43f-a8a6-34a7-83d1-d753bc43d4e1",
                                        "entry_id": "4a4c5a9e-45f8-33b3-a738-78c45369a0d4",
                                        "glosses": [
                                            "Angle que fait une direction du plan de projection en un point avec l’axe passant par ce point dont la direction est voisine de celle des méridiens, orienté vers le Nord."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7c26d6a-aa5e-3321-8e10-8cdc850004ff",
                                        "entry_id": "4a4c5a9e-45f8-33b3-a738-78c45369a0d4",
                                        "glosses": [
                                            "Angle formé entre la ligne de foi d’un véhicule et la ligne de visée d’un point."
                                        ],
                                        "tags": [
                                            "Navigation",
                                            "Armement"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
