                "senses": [
                    {
                        "sense_id": "991f8baa-4e00-321e-9d6a-a5ed5e47550b",
                        "entry_id": "95f2280d-b72d-3f57-994f-be06c311cb2e",
                        "glosses": [
                            "Abgabe einer leeren Liste als Zeichen, deren Anforderung zur Kenntnis genommen zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87ab4f32-88da-48e4-a316-fc663c20fcc9",
                                "sense_id": "991f8baa-4e00-321e-9d6a-a5ed5e47550b",
                                "text": "„Über das Kundenportal des RH wird es auch die Möglichkeit geben, eine Leermeldung abzugeben (d.h. ein Rechtsträger meldet, dass er im gegenständlichen Jahr keine Rechtsgeschäfte mit Beteiligungsunternehmen abgeschlossen hat).“"
                            },
                            {
                                "example_id": "1424336a-7ffa-4576-8145-38c792bd919f",
                                "sense_id": "991f8baa-4e00-321e-9d6a-a5ed5e47550b",
                                "text": "„Gering sind die Zahlen im Burgenland, wo die Bezirksverwaltungsbehörden Neusiedl am See, Mattersburg und Oberpullendorf lediglich ein Verwaltungsstrafverfahren meldeten, während die übrigen Bezirke eine Leermeldung erstattet haben“"
                            },
                            {
                                "example_id": "fa8c5f9d-de3d-4163-baea-aa39ac07d33f",
                                "sense_id": "991f8baa-4e00-321e-9d6a-a5ed5e47550b",
                                "text": "„Auch Weinbaubetriebe ohne aktuelle Ernte haben eine Erntemeldung (Leermeldung) zu erstatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "065bb7fd-0ff0-3d74-8953-1a484ca28619",
                        "entry_id": "95f2280d-b72d-3f57-994f-be06c311cb2e",
                        "glosses": [
                            "Meldung, dass ein Behälter leer ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2cde9c-0fc5-4190-ac8c-f3b89d868e2e",
                                "sense_id": "065bb7fd-0ff0-3d74-8953-1a484ca28619",
                                "text": "„Sehr feine Stäube haften auch nach Absinken des Füllstandes noch an den Sonden und verhindern so eine Leermeldung.“"
                            },
                            {
                                "example_id": "07842aa8-07d9-4d33-ad5a-bbcae3d6646b",
                                "sense_id": "065bb7fd-0ff0-3d74-8953-1a484ca28619",
                                "text": "„[Der Vibrationsschalter] eignet sich zur Voll-, Bedarfs- und Leermeldung von rieselfähigen Schüttgütern in Behältern, Silos und Trichtern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
