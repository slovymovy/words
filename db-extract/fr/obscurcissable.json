                        "examples": [
                            {
                                "example_id": "57879fb9-b814-4628-b37d-e776723e1273",
                                "sense_id": "03624d52-aa95-333b-b04b-ad85ddbabda1",
                                "text": "Il s’agit cette fois d’une surface obscurcissable qui vient s’apposer sur la partie interne des vitres latérales su poste de pilotage."
                            },
                            {
                                "example_id": "8b4cf75a-c785-4f39-a42e-35c3fa87732b",
                                "sense_id": "03624d52-aa95-333b-b04b-ad85ddbabda1",
                                "text": "Voyant que je m’y intéressais également, nous avons installé un petit labo dans l’un des coins du grenier facilement obscurcissable, pour faire passer d’abord la pellicule dans un bain « révélateur », puis dans un bain « fixateur »."
                            },
                            {
                                "example_id": "61ffaa6f-844d-4d4d-887b-a1c82182f694",
                                "sense_id": "03624d52-aa95-333b-b04b-ad85ddbabda1",
                                "text": "Obscurcissable par son jeu de rideaux, son mur-écran permet de recevoir des images projetées."
                            }
                        ]
                    }
