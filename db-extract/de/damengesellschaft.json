                "senses": [
                    {
                        "sense_id": "70539363-a028-3142-819c-044d520091ed",
                        "entry_id": "22f9c0cc-edc6-3f0d-8d5e-8132cea9ea4a",
                        "glosses": [
                            "Zusammensein mit einer Dame/Damen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06add174-2223-4fb6-bd05-27ad21de6630",
                                "sense_id": "70539363-a028-3142-819c-044d520091ed",
                                "text": "In Damengesellschaft verhalten Männer sich anders, als wenn sie unter sich sind."
                            },
                            {
                                "example_id": "53ad0a3e-64ef-498e-97f9-db6f43a012df",
                                "sense_id": "70539363-a028-3142-819c-044d520091ed",
                                "text": "„Dolochow, der bisher auf Damengesellschaft nicht den geringsten Wert gelegt hatte, verkehrte eifrig im Rostowschen Hause, und obgleich niemand darüber sprach, waren sich alle doch darüber einig, dass er Sonjas wegen so häufig kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2987500b-a654-3e33-811c-5490c5e3f350",
                        "entry_id": "22f9c0cc-edc6-3f0d-8d5e-8132cea9ea4a",
                        "glosses": [
                            "Gruppe von Damen, die gemeinsam etwas tun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84c6c516-4437-479b-bb61-d31d8594e32c",
                                "sense_id": "2987500b-a654-3e33-811c-5490c5e3f350",
                                "text": "„Und wenn er auf Bälle fuhr oder sonst Damengesellschaften besuchte, so gab er sich den Anschein, als tue er es nur widerwillig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
