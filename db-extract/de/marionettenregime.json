                "senses": [
                    {
                        "sense_id": "86a5c540-8fbf-32d6-8073-b71e976f5bf3",
                        "entry_id": "1482b7ac-aaa2-3802-bb3b-2cbe3b79e7b5",
                        "glosses": [
                            "Regime, das durch einen fremden Staat eingesetzt wurde und/oder geleitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55aa4820-d88b-4b46-bd63-2e193845f2ea",
                                "sense_id": "86a5c540-8fbf-32d6-8073-b71e976f5bf3",
                                "text": "„›Sollen wir etwa ein Marionettenregime der Vereinigten Staaten werden, Xavier?‹“"
                            },
                            {
                                "example_id": "2999969b-21dd-4b54-8af4-ca32a1cdebc6",
                                "sense_id": "86a5c540-8fbf-32d6-8073-b71e976f5bf3",
                                "text": "„Um diese Gefahr auszuschalten, so Gazit weiter, solle Israel im Westjordanland einen unabhängigen Palästinenserstaat gründen, der in Fragen der Verteidigung und inneren Sicherheit vollständig von der israelischen Armee abhängig sein und in der Außenpolitik von Israel kontrolliert werden müsse. Mordechai Gazit aus dem Außenministerium, Schlomos Bruder, erwiderte wenig begeistert, dann hätte man ›ein Marionettenregime‹.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
