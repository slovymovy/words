                    {
                        "sense_id": "41f9dbc2-481c-3740-bd42-29799f1505c5",
                        "entry_id": "f1597179-011f-34c4-9af4-5fa87fb8b0d6",
                        "glosses": [
                            "scorching heat"
                        ],
                        "tags": [
