                                        "entry_id": "a5359d32-c354-34fc-9fed-dd509ed7ace3",
                                        "glosses": [
                                            "A moving disturbance, or undulation, in the surface of a fluid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f93936a1-c93d-4c1a-9547-bff5a3913067",
                                                "sense_id": "1fb87beb-af08-31af-9c02-d428f164bfdd",
                                                "text": "I dropped a small stone into the pond and watched the ripples spread."
                                            },
                                            {
                                                "example_id": "635cbc25-72b7-473e-8889-1d49b429c0dc",
                                                "sense_id": "1fb87beb-af08-31af-9c02-d428f164bfdd",
                                                "text": "The ebbing tide had left ripples in the sand."
                                            },
                                            {
                                                "example_id": "064a0c41-d82b-4593-a8a8-9df953e9505e",
                                                "sense_id": "1fb87beb-af08-31af-9c02-d428f164bfdd",
                                                "text": "Ripples in the water betray the presence of the fish waiting for a chance to pounce on the insects skirting over the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5abde50d-532a-3a9c-a033-5dd53470e3df",
                                        "entry_id": "a5359d32-c354-34fc-9fed-dd509ed7ace3",
