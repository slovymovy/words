                            }
                        },
                        {
                            "text": "Hij hield een lekkere <w>kluif</w> vast en at het vlees er voorzichtig vanaf.",
                            "target_lang_translations": {
                                "en": "He held a tasty <w>bone</w> and carefully ate the meat off it."
                            }
                        }
                    ],
                    "synonyms": [
                        "kluifbot"
                    ],
                    "target_lang_definitions": {
                        "en": "A bone with meat on it that is gnawed on."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bone",
                                "target_lang_sense_clarification": "with meat on it, for gnawing"
                            },
                            {
                                "target_lang_word": "meat bone",
                                "target_lang_sense_clarification": "a bone with meat left on it"
                            }
                        ]
                    }
                }
            ]
        },
