                        "translation_id": "d0163bd6-1d8a-4094-86b5-95c803abbe83",
                        "source_entry_id": "555507bb-b5e2-351b-ae17-6a1de682fe86",
                        "source_sense_id": "2e0f22db-31fb-336e-953d-02852f3dd52b",
                        "target_lang_word": "tigress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tigress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f432416e-184f-3e11-8778-11a86c3e025c",
                                        "entry_id": "6c6a81a7-95dc-339b-af71-bc7faea268f6",
                                        "glosses": [
                                            "A female tiger; a she-tiger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50e63f49-03ba-4c27-aff6-2537523270ac",
                                                "sense_id": "f432416e-184f-3e11-8778-11a86c3e025c",
                                                "text": "So-al was a mighty fine-looking girl, built like a tigress as to strength and sinuosity, but withal sweet and womanly."
                                            },
                                            {
                                                "example_id": "4197ece3-0d30-457d-b9c0-c51d152d59e6",
                                                "sense_id": "f432416e-184f-3e11-8778-11a86c3e025c",
                                                "text": "Indestructibly seductive at 79, this greatest and wittiest of all singing tigresses has lasted even longer on the stage than the original glamorous grandmother, Marlene Dietrich."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a88adb59-0152-44f7-b151-e1e20da82adf",
                        "source_entry_id": "555507bb-b5e2-351b-ae17-6a1de682fe86",
                        "source_sense_id": "2e0f22db-31fb-336e-953d-02852f3dd52b",
                        "target_lang_word": "tygřice",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d277786b-a70d-406d-8540-df62ad5f86e8",
                        "source_entry_id": "555507bb-b5e2-351b-ae17-6a1de682fe86",
                        "source_sense_id": "2e0f22db-31fb-336e-953d-02852f3dd52b",
                        "target_lang_word": "tigresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tigresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fadc7a4-1838-3b3f-8050-610f8fcc51b1",
                                        "entry_id": "c7d3292b-a25d-3051-87fc-e4654782da28",
                                        "glosses": [
                                            "Femelle du tigre."
                                        ],
                                        "tags": [
                                            "Félinologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83b4d487-19d7-4e05-ac11-f87bab78981a",
                                                "sense_id": "6fadc7a4-1838-3b3f-8050-610f8fcc51b1",
                                                "text": "Pour Mogambo, un tigreau représente un obstacle entre lui et sa femelle, un gêneur, voire une proie bonne à dévorer. La tigresse le sait, elle a défendu ses petits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04f798be-be68-3dd8-a9c0-4c1b53adafbc",
                                        "entry_id": "c7d3292b-a25d-3051-87fc-e4654782da28",
                                        "glosses": [
                                            "Femme violente."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "081f1f27-b764-4a1c-a695-e09c72093354",
                                                "sense_id": "04f798be-be68-3dd8-a9c0-4c1b53adafbc",
                                                "text": "Voilà une tigresse ! s’écria celle-ci, lui rendant enfin sa liberté. Allez vous-en, pour l’amour de Dieu, et cachez votre maudite figure ! Quelle folie de révéler devant lui ces griffes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e24dcd5d-f65f-3d02-b69c-1b3e0294219e",
                                        "entry_id": "c7d3292b-a25d-3051-87fc-e4654782da28",
                                        "glosses": [
                                            "Femme très sensuelle et très attirante."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "206c034d-ab30-428f-a77f-2795ad73bcd7",
                                                "sense_id": "e24dcd5d-f65f-3d02-b69c-1b3e0294219e",
                                                "text": "J’ai un corps de tigresse ; saurez-vous m’apprivoiser ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
