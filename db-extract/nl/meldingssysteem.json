                        "examples": [
                            {
                                "example_id": "7fe8e28e-442d-40fd-a5bb-a5b91c8c225c",
                                "sense_id": "fe41a369-1a64-32e8-b05b-d3e80c17e4c0",
                                "text": "Vorig jaar (.pdf) werd in 1,3 procent van de onderzoeken een melding gemaakt. Oevering: \"Dna-onderzoek is zeer gevoelig en daar hoort ook een heel gevoelig meldingssysteem bij. Het aantal onderzoeken is gestegen en het aantal meldingen is ook gestegen.\" Ze zegt dat het NFI ook fouten van anderen registreert, zoals een sticker op een binnengekomen bewijsstuk die niet klopt."
                            },
                            {
                                "example_id": "8bcd1461-7b29-4106-a466-d7e4a6e81fff",
                                "sense_id": "fe41a369-1a64-32e8-b05b-d3e80c17e4c0",
                                "text": "Behalve een gezamenlijk meldingssysteem voor dierziekten die voor de mens gevaarlijk zijn, moet er heldere structuren komen. Er moet precies worden vastgelegd wie waarvoor verantwoordelijk is. Dus, wie moet signalen over dierziekten oppikken, hoe en aan wie moeten ze gemeld worden, wie moet maatregelen nemen, wie neemt de besluiten en wie is verantwoordelijk voor de communicatie. Nu is niet goed duidelijk wie wat moet doen."
                            }
                        ]
                    }
