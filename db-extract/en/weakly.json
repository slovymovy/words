                    },
                    {
                        "form_id": "94c46c43-c108-4d59-a328-fba1f70d7835",
                        "entry_id": "a99cf6e7-f5b8-3464-adb2-b0947b83fff9",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most weakly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2f679f7-2d0d-3d0a-9089-ae8ad897ee3d",
                        "entry_id": "a99cf6e7-f5b8-3464-adb2-b0947b83fff9",
                        "glosses": [
                            "With little strength or force."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c780834-8622-44e9-99bc-9ab19a85ed5a",
                                "sense_id": "a2f679f7-2d0d-3d0a-9089-ae8ad897ee3d",
                                "text": "The basitemporal platform is flat in posterior view because the mamillar tuberosities are very weakly developed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e0d6417-9e87-483d-b44d-041673f59d2a",
                        "source_entry_id": "a99cf6e7-f5b8-3464-adb2-b0947b83fff9",
                        "source_sense_id": "a2f679f7-2d0d-3d0a-9089-ae8ad897ee3d",
                        "source_sense_description": "with little strength or force",
                        "target_lang_word": "faiblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faiblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                        "entry_id": "14424ab6-2bdf-36a5-9c96-bb1962545589",
                                        "glosses": [
                                            "D’une manière faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fea9e79-66f1-45be-8f48-08adab7dab91",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Nos malheurs jusqu'ici vous touchent faiblement."
                                            },
                                            {
                                                "example_id": "65b86657-f031-4316-a654-68af1fb43f99",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Que le cœur d’une femme est mal connu de vous, Et que vous savez peu ce qu’il veut faire entendre, Lorsque si faiblement on le voit se défendre !"
                                            },
                                            {
                                                "example_id": "1a34a869-ed44-4ae3-96fd-cf3b4b2bbfff",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Rome s'accroissait, mais faiblement."
                                            },
                                            {
                                                "example_id": "a4b8fef1-48cf-4baf-b2bd-0b378efc9451",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Il faut prendre sur soi certaines choses décisives où l’on ne peut vous conseiller que faiblement."
                                            },
                                            {
                                                "example_id": "3e783c80-b78a-49fe-a1aa-666bd1f3bca7",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Je m’en plaignis, mais si faiblement que je n'insistai point."
                                            },
                                            {
                                                "example_id": "bcd5a1ba-a5bb-4f21-91d2-0d3817a77d33",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Après cette paix, la France se rétablit faiblement."
                                            },
                                            {
                                                "example_id": "717a70bf-75e9-4639-ac73-4b4dac49a498",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Le marquis d’Argens vient d’imprimer à Berlin le discours de l’empereur Julien contre les Galiléens, discours à la vérité un peu faible, mais beaucoup plus faiblement réfuté par saint Cyrille."
                                            },
                                            {
                                                "example_id": "f8eb718e-c0a9-4072-8e3b-a248b6fd47d5",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Je me croirais haï, d’être aimé faiblement."
                                            },
                                            {
                                                "example_id": "a9bd1883-1ce0-4d91-9fba-b0e426d9ac17",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "J'ai peur que la raison, l’amitié filiale Combattent faiblement l’illusion fatale."
                                            },
                                            {
                                                "example_id": "9d8a9543-88ae-4ee2-9257-05b939eb2ce2",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "C'est la plus faiblement écrite de mes pièces de théâtre, mais la plus pathétique."
                                            },
                                            {
                                                "example_id": "83f09052-3857-46ad-b747-67b551d26a65",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Il poussa la porte si fort que le fer à cheval suspendu au linteau de chêne tinta faiblement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
