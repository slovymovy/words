                "senses": [
                    {
                        "sense_id": "85900db4-4d53-33ae-a267-739557831548",
                        "entry_id": "86e0e51f-a9ca-327e-a394-d7ea435ed9f4",
                        "glosses": [
                            "Any of the 613 commandments of Jewish law."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "f70d9e7c-aeec-421e-b4be-1ce5f052ceb7",
                                "sense_id": "85900db4-4d53-33ae-a267-739557831548",
                                "text": "She called Penansky regularly to remind her to observe the mitzvahs."
                            }
                        ]
                    },
                    {
                        "sense_id": "906ad3de-a3d7-3fd4-9d81-cb07037a0190",
                        "entry_id": "86e0e51f-a9ca-327e-a394-d7ea435ed9f4",
                        "glosses": [
                            "An act of kindness, a good deed."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "ae5e1d99-12d6-49b7-86d0-c7a19d666437",
                                "sense_id": "906ad3de-a3d7-3fd4-9d81-cb07037a0190",
                                "text": "‘You heard about them pulling my license. That was indirectly Joel. Who, without meaning to, did me such a mitzvah.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "2ded5e1f-e670-38b8-8736-483ee1af6345",
                        "entry_id": "86e0e51f-a9ca-327e-a394-d7ea435ed9f4",
                        "glosses": [
                            "A Jewish celebration, but particularly a clipping of bar mitzvah and/or bat mitzvah."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "0a320661-a8f3-42a4-ab7f-f6aeed158fa9",
                                "sense_id": "2ded5e1f-e670-38b8-8736-483ee1af6345",
                                "text": "Glenview Mansion is an elegant 1926 home included on the National Register of Historic Places. Located in the 153-acre Rockville Civic Center Park, it is the perfect location for weddings, private parties, mitzvahs, conferences, and many other special occasions. Every rental includes a customized set-up to support the unique needs of your event."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d975b60-c82c-4fd6-8b62-26691ab28718",
                        "source_entry_id": "86e0e51f-a9ca-327e-a394-d7ea435ed9f4",
                        "source_sense_description": "any of the 613 commandments of Jewish law",
                        "target_lang_word": "mitzvah",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitzvah",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b4b55f1-7cc9-316e-9e26-db649df418ca",
                                        "entry_id": "ac7efe72-397a-3514-9a48-512c3b756a5e",
                                        "glosses": [
                                            "Commandement ou précepte inscrit dans la Thora."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf9713e5-f059-4c6a-9ca8-041339b3b5a3",
                                                "sense_id": "6b4b55f1-7cc9-316e-9e26-db649df418ca",
                                                "text": "Même si Auschwitz, dès les camps, mit plus d’un juif en délicatesse avec le Tout-Puissant, d’aucuns, observe le rabbi survivant, furent rassérénés d’avoir pu observer au moins une mitzvah à Auschwitz : celle du shofar à Rosh Hashanah."
                                            },
                                            {
                                                "example_id": "cc31f862-1962-4017-889b-7489915a2026",
                                                "sense_id": "6b4b55f1-7cc9-316e-9e26-db649df418ca",
                                                "text": "La discussion qui suit cet enseignement de Rabbi Yehouda dans la guemara précise que ces trois mitzvoth doivent être accomplies dans un ordre précis : la nomination du roi d’abord, la destruction d’Amalek ensuite, la construction du Temple en dernier lieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07348acb-b2ac-3d2d-8637-ca7fd33c5cfb",
                                        "entry_id": "ac7efe72-397a-3514-9a48-512c3b756a5e",
                                        "glosses": [
                                            "Bonne action de nature religieuse."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cf9ef54-e926-4010-9743-d921f7e649dd",
                                                "sense_id": "07348acb-b2ac-3d2d-8637-ca7fd33c5cfb",
                                                "text": "C’est ce que j’ai fait toutes ces années, prendre ces robes ordinaires et les adapter en les transformant, pour qu’elles tombent bien et soient taillées comme il faut afin que ces femmes aient l’air séduisantes dans ces robes, et si on se sent séduisante, on se sent bien, et permettre à ces femmes déjà un peu âgées, au corps avachi, de se sentir bien, c’est un service, non, je dirais une mitzwah, aussi je suis fière de ce que j’ai accompli, Sy, je ne crois pas avoir gâché mes talents à une activité qui n’en valait pas la peine, puisque toute personne vaut la peine, quelle qu’elle soit."
                                            },
                                            {
                                                "example_id": "2888d2a2-82bb-40aa-986a-309fdaaf0cc9",
                                                "sense_id": "07348acb-b2ac-3d2d-8637-ca7fd33c5cfb",
                                                "text": "Le vieux Shlomo apportait toujours l’attirail de prière : kippa, talith et tefillins. Ramener les démissionnaires à la religion était pour lui une mitzvah, une bonne action."
                                            },
                                            {
                                                "example_id": "0e080a46-7cc3-4118-8035-28260fca35c4",
                                                "sense_id": "07348acb-b2ac-3d2d-8637-ca7fd33c5cfb",
                                                "text": "Dix jours qui nous sont accordés pour réparer nos fautes par de bonnes actions, les mitzvoth ; comme ces bonnes actions ne sont pas des sanctions, elles se font dans l’allégresse ; au terme des dix jours, qui appartiennent déjà à la nouvelle année, Dieu, dans son infinie bonté, nous offre l’absolution, c’est cela la Fête de Kippour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de9efa30-d0f6-49ff-9195-cc260557e577",
                        "source_entry_id": "86e0e51f-a9ca-327e-a394-d7ea435ed9f4",
                        "source_sense_description": "any of the 613 commandments of Jewish law",
                        "target_lang_word": "Mitzwa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitzwa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3bfc030-c0fc-32a6-ab28-2d44bbb5a063",
                                        "entry_id": "a5afd6f0-2af9-3dd8-b3c1-f70c1f0d2c87",
                                        "glosses": [
                                            "eines der 620 teils in der Thora, teils von Rabbinern festgelegten Gebote"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec3ed73-9978-4543-a30e-867954c3d5d0",
                                                "sense_id": "d3bfc030-c0fc-32a6-ab28-2d44bbb5a063",
                                                "text": "„Fackenheims wohl bekannteste Erklärung bestand in der Erweiterung der 613 Mitzwoth (Gebote im jüdischen Glauben).“"
                                            },
                                            {
                                                "example_id": "33a7b61f-e8a9-4ad8-87cb-03154f55cd80",
                                                "sense_id": "d3bfc030-c0fc-32a6-ab28-2d44bbb5a063",
                                                "text": "„‚Mir geht es auch um das Wohl Israels‘, erwidert Verleger. Das Vorgehen der Regierung Olmert gegen Libanon sehe er aber als Schaden für Israel. Nur der deutsch-jüdische Publizist Uri Avnery habe sich bislang solidarisch mit seiner Kritik gezeigt, sagt der alleinstehende Kritiker […]. Avnery habe hervorgehoben, dass Verleger erfülle ‚eine Mitzwa, eine jüdische Pflicht‘.“"
                                            },
                                            {
                                                "example_id": "d0e32fe2-889b-4a9b-bd66-2ca1d3eee7a9",
                                                "sense_id": "d3bfc030-c0fc-32a6-ab28-2d44bbb5a063",
                                                "text": "„Ob jetzt Chanukka seine Quellen im Geschichtlichem, im Jahreszeitlichem, oder aber in der Verbindung von beiden hat, eines ist klar: dass der Gedanke des Lichts die zentrale Idee ist. Deshalb ist die Mitzwa, die mit diesem Fest verbunden ist, jeden Abend die Kerzen anzuzünden. Diese zentrale Befolgung gab dem Feiertag seinen zusätzlichen Namen Chag ha’Orot, das Fest der Lichter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1515468e-e238-35bc-902f-2d3573af5938",
                                        "entry_id": "a5afd6f0-2af9-3dd8-b3c1-f70c1f0d2c87",
                                        "glosses": [
                                            "gute, auf Gottes Wohlgefallen gerichtete Tat"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c4ecde-7758-451b-a8b9-e1f8cebf62b1",
                                                "sense_id": "1515468e-e238-35bc-902f-2d3573af5938",
                                                "text": "„‚Unsere Aktion ist eine Mitzwa‘, sagt die Siedlerin Rachel in Nezarim und erhebt den kollektiven Protest damit zur gottesfürchtigen guten Tat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
