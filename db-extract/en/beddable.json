                                        "examples": [
                                            {
                                                "example_id": "3997bbf8-3a96-4520-9dba-39ffa891cc97",
                                                "sense_id": "f59a5d9b-05b5-39d4-8694-32d2889d2307",
                                                "text": "Elle portait des robes si courtes aussi ! Et pas pudique du tout quand elle faisait sissite ! Elle est pinocumettable, prétendait Pactot."
                                            },
                                            {
                                                "example_id": "8e9e9237-b5a3-4630-809f-c79102c0b9ef",
                                                "sense_id": "f59a5d9b-05b5-39d4-8694-32d2889d2307",
                                                "text": "Mais, en ce temps-là, les filles pinauculmettables (comme nous disons) sont rares. Et qu’elles sont mal attifées, avec leurs jupasses de nonnes, leurs soquettes infantiles et leurs échafaudages de cheveux !"
                                            },
                                            {
                                                "example_id": "9551436c-5b77-4b4d-b489-d1a7b303e660",
                                                "sense_id": "f59a5d9b-05b5-39d4-8694-32d2889d2307",
                                                "text": "Arthur aperçu Clara au loin, son potentiel le frappa, elle était plus que pinocumettable, une vraie femme de caractère"
                                            }
                                        ]
                                    }
                                ]
