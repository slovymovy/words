                            {
                                "example_id": "32cbbcf6-740d-4682-ac70-67949f930972",
                                "sense_id": "49341022-2587-3d3f-8c11-7f02f6aeb0b3",
                                "text": "L’équipage devrait préparer un appareil de hissage et une caliorne pour repêcher l’homme à bord une fois qu’il est le long du navire."
                            },
                            {
                                "example_id": "dc711020-5a6c-4bb8-9f90-244aee769be0",
                                "sense_id": "49341022-2587-3d3f-8c11-7f02f6aeb0b3",
                                "text": "Dès que la chaîne est rendue à son poste et bien bossée sur l’avant de la bitte : défrapper la caliorne après l’avoir mollie en douceur ; prendre le tour de bitte et terminer l’opération comme il a été dit plus haut."
                            }
                        ]
