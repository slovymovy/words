                "forms": [],
                "senses": [
                    {
                        "sense_id": "1773d211-c14d-3e7f-b3fe-63dddb299043",
                        "entry_id": "944a025e-9b27-3275-9280-e47eb84a98e5",
                        "glosses": [
                            "simple past of take"
                        ],
                        "tags": [
                            "form-of",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "4544862b-9a83-44a9-8fe3-ea6d0ce7b19e",
                                "sense_id": "1773d211-c14d-3e7f-b3fe-63dddb299043",
                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                            }
                        ]
                    },
                    {
                        "sense_id": "afe94e75-31b1-3772-b87f-2a0c064aa7b9",
                        "entry_id": "944a025e-9b27-3275-9280-e47eb84a98e5",
                        "glosses": [
                            "past participle of take"
                        ],
                        "tags": [
                            "colloquial",
                            "dialectal",
                            "form-of",
                            "participle",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "f0c1a7ca-a360-4805-8dab-7c1e5c1c5854",
                                "sense_id": "afe94e75-31b1-3772-b87f-2a0c064aa7b9",
                                "text": "A gracious perſon ; But yet I cannot loue him : / He might have tooke his anſwer long ago"
                            },
                            {
                                "example_id": "99fb3706-301e-4956-9c88-7282f4fd3549",
                                "sense_id": "afe94e75-31b1-3772-b87f-2a0c064aa7b9",
                                "text": "\"There you're right,\" said Bill, \"especially as it was all in paper, and he might have took care of it so very easy, by folding it up into a small parcel.\""
                            },
                            {
                                "example_id": "a9c2d529-6434-45f4-88ec-bae16840bc76",
                                "sense_id": "afe94e75-31b1-3772-b87f-2a0c064aa7b9",
                                "text": "Linda: It was being there — if you could have took the work home I would have been alright, but being there, people watching over you, you know, you couldn't do anything wrong."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
