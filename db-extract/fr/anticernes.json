                "senses": [
                    {
                        "sense_id": "e6d2c42c-c3f6-3a2d-a71e-1a4a8bc71b43",
                        "entry_id": "80b0b10a-fbc7-36c8-b0e2-ccdd64d6cbec",
                        "glosses": [
                            "Spécialité commerciale proposée comme remède aux cernes des yeux, pour les corriger ou pour les masquer."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "80bd2389-3462-4d5b-b3f3-dced2250a147",
                                "sense_id": "e6d2c42c-c3f6-3a2d-a71e-1a4a8bc71b43",
                                "text": "Je me maquille ensuite comme l’expert m’a appris à le faire : apprêt, fond de teint, anticernes."
                            },
                            {
                                "example_id": "05961d5a-d7e0-4764-a4ed-5a94db29648c",
                                "sense_id": "e6d2c42c-c3f6-3a2d-a71e-1a4a8bc71b43",
                                "text": "Appliquer un anticernes plutôt sec, moins huileux, sur le bouton puis un peu de poudre pour fixer."
                            },
                            {
                                "example_id": "4fef200b-f401-436b-a6f3-3067c30a85fd",
                                "sense_id": "e6d2c42c-c3f6-3a2d-a71e-1a4a8bc71b43",
                                "text": "Et au niveau de l’anticernes, c’est la même chose : n’écoutez pas les idées reçues qui voudraient qu’un anticernes possède presque 2 teintes en-dessous de la couleur de votre peau : la différence sera flagrante."
                            }
                        ]
                    }
                ],
