                                        "glosses": [
                                            "Trouble pupillaire caractérisé par une différence de diamètre entre les pupilles des yeux d'une même personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "591b7862-de59-4a26-b7f0-bd2837840502",
                                                "sense_id": "5b0621df-c9f1-3575-9f26-f6ca9ae0d82f",
                                                "text": "Suite à une bagarre à l'age de 15 ans, David Bowie souffrait d'anisocorie et n'avait pas les yeux vairons contrairement à ce qui se disait."
                                            },
                                            {
                                                "example_id": "7f6e6083-3b79-48a7-8518-e8026d24bd95",
                                                "sense_id": "5b0621df-c9f1-3575-9f26-f6ca9ae0d82f",
                                                "text": "On peut ainsi distinguer une anisocorie statique et une anisocorie dynamique apparaissant après une excitation lumineuse."
                                            }
