                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4164641c-87ad-4849-83c4-8c25f3afb2c3",
                                "sense_id": "885af4c0-1142-3f7f-95cf-cb61ac3bf45c",
                                "text": "Een oorspronkelijk denker was hij maar in geringe mate, en zeker geen doordenker, maar met bliksemende helderheid brengt hij allerlei, vaak -naar hij zich ook zelf wel volkomen bewust was- fijne opmerkingen op veelal scherp treffende wijze onder woorden."
                            }
