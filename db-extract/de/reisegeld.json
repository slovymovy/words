                "senses": [
                    {
                        "sense_id": "c59789b1-e27e-3642-8e70-b1ca1dad8443",
                        "entry_id": "39f53368-6c7f-3db6-bef1-22fa95ff6c9f",
                        "glosses": [
                            "Geld, das für die Finanzierung einer Reise benötigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb79c610-3f07-487a-ad79-95e9701cce61",
                                "sense_id": "c59789b1-e27e-3642-8e70-b1ca1dad8443",
                                "text": "„Und wenn man an Reisen denkt, fällt einem das Reisegeld ein.“"
                            },
                            {
                                "example_id": "9297ca06-a24f-4449-a582-01a5e3191052",
                                "sense_id": "c59789b1-e27e-3642-8e70-b1ca1dad8443",
                                "text": "„Außerdem hatte er schon die Hälfte seine Reisegeldes ausgegeben.“"
                            },
                            {
                                "example_id": "148cde68-c0f4-4fb0-86da-22c8c8f09c61",
                                "sense_id": "c59789b1-e27e-3642-8e70-b1ca1dad8443",
                                "text": "„Das Reisegeld, so rät er ihm, bettelt man sich unterwegs zusammen, wie es bei Juden üblich ist; und von daheim geht man fort, indem man es dem Eheweib erst gar nicht verrät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ce7675e-6fe5-31c0-9b5a-436f5e41b1e3",
                        "entry_id": "39f53368-6c7f-3db6-bef1-22fa95ff6c9f",
                        "glosses": [
                            "nur im Plural: Spesen, die anlässlich einer beauftragten Reise (Dienstreise) entstanden sind"
                        ],
