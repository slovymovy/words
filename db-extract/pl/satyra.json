                                                "example_id": "abde7252-ef48-4f4c-83d2-8acf8e32721a",
                                                "sense_id": "fbaeaeee-e1ac-343e-b4c5-144a5ff94357",
                                                "text": "Satire tritt häufig als Mittel der Polemik auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd3dab24-ba4e-32ad-9ca1-995bc19980a7",
                                        "entry_id": "107d15e8-ff6f-3762-bf8f-c94f55d0974f",
                                        "glosses": [
                                            "literarische Gattung römischen Ursprungs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e4e1fcd-739d-4694-a772-18b2e5e6616f",
                                                "sense_id": "cd3dab24-ba4e-32ad-9ca1-995bc19980a7",
                                                "text": "An der Uni mussten wir die Gattung „Satire“ definieren und mit Beispielen belegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "16e42822-eb85-3625-8c2f-9b655dee6157",
                                        "entry_id": "107d15e8-ff6f-3762-bf8f-c94f55d0974f",
                                        "glosses": [
                                            "einzelnes künstlerisches Werk, das von der humorvoll kritisierenden Schreibweise Gebrauch macht oder der Gattung angehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d6c2b3-a42c-4fd9-bff3-13e796f9e230",
                                                "sense_id": "16e42822-eb85-3625-8c2f-9b655dee6157",
                                                "text": "„Der Satiriker hingegen kämpft oft einen verzweifelten Kampf, bei dem ungewiß bleibt, ob sich das Objekt der Satire überhaupt beeinflussen läßt.“"
                                            },
                                            {
                                                "example_id": "5f8563be-0da6-4152-8204-c229d69cee38",
                                                "sense_id": "16e42822-eb85-3625-8c2f-9b655dee6157",
                                                "text": "„Das Ende der Satire ist komisch und tragisch zugleich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
