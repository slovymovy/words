                                                "sense_id": "c076ddb1-ecac-336a-ac8f-46c28b1ad25e",
                                                "text": "De bitcoin is een digitale munt."
                                            },
                                            {
                                                "example_id": "084596f3-45bc-41fa-a656-0b8b98e7886d",
                                                "sense_id": "c076ddb1-ecac-336a-ac8f-46c28b1ad25e",
