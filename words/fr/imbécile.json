    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25443e1f-101d-3b9d-b615-cf5c60a046b7",
                    "sense_definition": "Personne qui manque d'intelligence, de bon sens ou qui agit de façon stupide.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stupidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne fais pas attention à ses remarques, c'est un pauvre <w>imbécile</w> qui cherche seulement à provoquer."
                        },
                        {
                            "text": "Cet <w>imbécile</w> a oublié de fermer la porte à clé avant de partir en vacances."
                        }
                    ],
                    "synonyms": [
                        "crétin",
                        "idiot",
                        "sot"
                    ],
                    "antonyms": [
                        "génie"
                    ],
                    "common_phrases": [
