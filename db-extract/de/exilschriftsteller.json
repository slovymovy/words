                        "glosses": [
                            "Schriftsteller, der im Exil ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f8f26dc-2e9e-491f-8111-0aebfbe45a9c",
                                "sense_id": "5d1d3885-a820-34de-ac0f-71bf9c185c78",
                                "text": "„Doch für beide Schriftsteller hat das Exil von Anfang an dieselben bitteren Konsequenzen wie für fast alle Exilschriftsteller: Der gewohnte Wiener Sprachraum fehlt, der so vieles ihrer Dichtungen prägt.“"
                            },
                            {
                                "example_id": "abb3d73d-09c8-4747-ad89-f29906dc2ca4",
                                "sense_id": "5d1d3885-a820-34de-ac0f-71bf9c185c78",
                                "text": "„Thomas Mann und andere Exilschriftsteller erreichten für ihn die Aufenthaltsgenehmigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
