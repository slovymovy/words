                    {
                        "sense_id": "16e96d43-1ecb-3227-be93-b2575973039c",
                        "entry_id": "e425afe1-84b1-3a90-86fb-2ec8ad7fc1ab",
                        "glosses": [
                            "de verlengde flexibele organen die vele ongewervelde dieren hebben."
