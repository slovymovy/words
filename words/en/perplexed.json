                            },
                            {
                                "target_lang_word": "verworren",
                                "target_lang_sense_clarification": "chaotisch oder kompliziert verflochten"
                            },
                            {
                                "target_lang_word": "labyrinthisch",
                                "target_lang_sense_clarification": "wie ein Irrgarten gebaut"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "intrincado",
                                "target_lang_sense_clarification": "enredado, complicado o difícil de desenredar"
                            },
                            {
                                "target_lang_word": "laberíntico",
                                "target_lang_sense_clarification": "con estructura semejante a un laberinto"
                            },
                            {
                                "target_lang_word": "enredado",
                                "target_lang_sense_clarification": "entrelazado de forma confusa"
                            }
                        ]
                    }
                }
            ]
        },
        {
