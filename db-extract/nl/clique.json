                "senses": [
                    {
                        "sense_id": "3929c384-5b97-347b-8fcf-b61c06f5eb10",
                        "entry_id": "1e8a6ab0-baf3-3558-9e99-cec127c96f67",
                        "glosses": [
                            "kleine, besloten groep van mensen die elkaar goed kennen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e39b3b6-61f5-41da-92a7-9ce79b9f2436",
                                "sense_id": "3929c384-5b97-347b-8fcf-b61c06f5eb10",
                                "text": ",Het is een soort vakantie, maar dan in eigen stad en met de vriendenkring. Het is een grote Nimweegse clique.’’"
                            },
                            {
                                "example_id": "549b89d0-25fa-4ffd-8143-035ee7d085ae",
                                "sense_id": "3929c384-5b97-347b-8fcf-b61c06f5eb10",
                                "text": "Equatoriaal-Guinea heeft enorme olievoorraden, maar het grootste deel van de bevolking is straatarm. De rijkdom komt vooral ten goede aan een corrupte clique rond de president, de vader van de vicepresident."
                            },
                            {
                                "example_id": "e9b87d43-03a4-45bd-8184-46994973c791",
                                "sense_id": "3929c384-5b97-347b-8fcf-b61c06f5eb10",
                                "text": "Prestigieuze bouwprojecten met al hun financiële voordeeltjes voor de betrokken clique zijn nu voorlopig ook verleden tijd."
                            }
                        ]
                    }
                ],
