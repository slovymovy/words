            "senses": [
                {
                    "sense_id": "28155c9c-18f5-34e9-b9d1-dcdf351116a4",
                    "sense_definition": "Despite that; however.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am very busy today, but I can help you tomorrow <w>though</w>.",
                            "target_lang_translations": {
                                "ru": "Я очень занят сегодня, но завтра я <w>всё-таки</w> смогу тебе помочь.",
                                "nl": "Ik heb het erg druk vandaag, maar morgen kan ik je <w>toch</w> helpen.",
                                "pl": "Jestem dzisiaj bardzo zajęty, ale jutro <w>jednak</w> będę mógł ci pomóc.",
                                "de": "Ich bin heute sehr beschäftigt, aber morgen kann ich dir <w>trotzdem</w> helfen.",
                                "fr": "Je suis très occupé aujourd'hui, mais je pourrai <w>quand même</w> t'aider demain.",
                                "it": "Oggi sono molto occupato, domani <w>però</w> posso aiutarti.",
                                "cs": "Dnes mám moc práce, zítra ti <w>ale</w> pomoct můžu.",
                                "tr": "Bugün çok meşgulüm ama yarın <w>yine de</w> sana yardım edebilirim.",
                                "es": "Hoy estoy muy ocupado, <w>pero</w> mañana te puedo ayudar."
                            }
                        },
                        {
                            "text": "The meal was quite expensive; it tasted very good <w>though</w>.",
                            "target_lang_translations": {
                                "ru": "Еда была довольно дорогой; <w>однако</w> на вкус она была очень хороша.",
                                "nl": "De maaltijd was vrij duur; hij smaakte <w>echter</w> erg goed.",
                                "pl": "Posiłek był dość drogi, <w>mimo to</w> smakował bardzo dobrze.",
                                "de": "Das Essen war ziemlich teuer; es hat <w>allerdings</w> sehr gut geschmeckt.",
                                "fr": "Le repas était assez cher ; il était <w>pourtant</w> très bon.",
                                "it": "Il pasto era piuttosto costoso; era <w>comunque</w> molto buono.",
                                "cs": "To jídlo bylo docela drahé; chutnalo <w>však</w> velmi dobře.",
                                "tr": "Yemek oldukça pahalıydı; <w>ama</w> tadı çok güzeldi.",
                                "es": "La comida fue bastante cara; <w>sin embargo</w>, estaba muy buena."
                            }
                        }
