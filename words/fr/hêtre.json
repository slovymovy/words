                    "frequency": "Middle",
                    "semantic_group_id": "arbre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous nous sommes reposés à l'ombre d'un grand <w>hêtre</w> au milieu de la forêt."
                        },
                        {
                            "text": "Les feuilles de ce vieux <w>hêtre</w> commencent à jaunir dès les premières semaines d'automne."
                        }
                    ],
