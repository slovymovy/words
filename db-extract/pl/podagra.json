                        "examples": [
                            {
                                "example_id": "d1486172-3716-4bcf-8ff5-bf9b853c910e",
                                "sense_id": "02acdb1b-4359-3c3a-bc08-d34e1ffcce7f",
                                "text": "Wszystkim osobom cierpiącym na podagrę, nadciśnienie lub choroby wątroby zaleca się zmniejszenie spożycia mięsa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
