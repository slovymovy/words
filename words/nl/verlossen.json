            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c88e4b2-5a5a-30fd-a6d4-a21ea0068aea",
                    "sense_definition": "iemand bevrijden van een last, pijn of een ongewenste situatie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bevrijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe medicijnen konden hem eindelijk van de pijn <w>verlossen</w>.",
                            "target_lang_translations": {
                                "en": "The new medication could finally <w>relieve</w> him of the pain.",
                                "de": "Die neuen Medikamente konnten ihn endlich von den Schmerzen <w>erlösen</w>."
                            }
                        },
                        {
                            "text": "Zij wilde hem uit zijn lijden <w>verlossen</w> door hem te helpen.",
                            "target_lang_translations": {
                                "en": "She wanted to <w>deliver</w> him from his suffering by helping him.",
                                "de": "Sie wollte ihn durch ihre Hilfe von seinen Leiden <w>erlösen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevrijden"
                    ],
                    "antonyms": [
                        "belasten"
                    ],
                    "common_phrases": [
                        "uit het lijden verlossen",
                        "van een last verlossen"
                    ],
                    "target_lang_definitions": {
                        "en": "To free someone from a burden, pain, or an undesirable situation.",
                        "de": "jemanden von einer Last, von Schmerzen oder aus einer unangenehmen Situation befreien"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "from pain or a burden"
                            },
                            {
                                "target_lang_word": "deliver",
                                "target_lang_sense_clarification": "from danger or restraint"
                            },
                            {
                                "target_lang_word": "release",
                                "target_lang_sense_clarification": "from suffering or a situation"
                            },
                            {
                                "target_lang_word": "free",
                                "target_lang_sense_clarification": "from a burden"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erlösen",
                                "target_lang_sense_clarification": "von Schmerzen, Leid oder einer Qual"
                            },
                            {
                                "target_lang_word": "befreien",
                                "target_lang_sense_clarification": "von einer Last oder Bedrängnis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fc5572a-cc1b-3d9a-8004-23dbecb5888d",
                    "sense_definition": "vrijmaken van zonden of morele schuld, vaak in een religieuze context",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religieus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In veel religies gelooft men dat een hogere macht de mensheid zal <w>verlossen</w>.",
                            "target_lang_translations": {
                                "en": "In many religions, it is believed that a higher power will <w>redeem</w> humanity.",
                                "de": "In vielen Religionen glaubt man, dass eine höhere Macht die Menschheit <w>erlösen</w> wird."
                            }
                        },
                        {
                            "text": "Hij hoopte dat zijn goede daden hem van zijn schuld zouden <w>verlossen</w>.",
                            "target_lang_translations": {
                                "en": "He hoped that his good deeds would <w>free</w> him from his guilt.",
                                "de": "Er hoffte, dass seine guten Taten ihn von seiner Schuld <w>befreien</w> würden."
                            }
                        }
                    ],
                    "synonyms": [
                        "vrijmaken",
                        "redden"
                    ],
                    "antonyms": [
                        "verdoemen"
                    ],
                    "common_phrases": [
                        "van zonden verlossen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in religieuze of plechtige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To free from sins or moral guilt, often in a religious context.",
                        "de": "von Sünde oder moralischer Schuld freimachen, oft im religiösen Kontext"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "redeem",
                                "target_lang_sense_clarification": "from sin or guilt"
                            },
                            {
                                "target_lang_word": "deliver",
                                "target_lang_sense_clarification": "from evil or sin"
                            },
                            {
                                "target_lang_word": "save",
                                "target_lang_sense_clarification": "in a religious sense"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erlösen",
                                "target_lang_sense_clarification": "im religiösen Sinn, von Schuld oder Sünde"
                            },
                            {
                                "target_lang_word": "erretten",
                                "target_lang_sense_clarification": "gehoben oder religiös, vor dem Verderben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7d5e1e3-0f92-33b5-9cf5-e7f7a7dd135b",
                    "sense_definition": "een vrouw medisch of deskundig bijstaan tijdens de bevalling",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verloskundige moest de vrouw midden in de nacht <w>verlossen</w>.",
                            "target_lang_translations": {
                                "en": "The midwife had to <w>deliver</w> the woman in the middle of the night.",
                                "de": "Die Hebamme musste die Frau mitten in der Nacht <w>entbinden</w>."
                            }
                        },
                        {
                            "text": "Zij werd in het ziekenhuis door een ervaren arts <w>verlost</w>.",
                            "target_lang_translations": {
                                "en": "She was <w>delivered</w> in the hospital by an experienced doctor.",
                                "de": "Sie wurde im Krankenhaus von einem erfahrenen Arzt <w>entbunden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "helpen bevallen"
                    ],
                    "common_phrases": [
                        "een vrouw verlossen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medische of vaktaal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To assist a woman medically or professionally during childbirth.",
                        "de": "eine Frau bei der Geburt eines Kindes fachlich oder medizinisch unterstützen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deliver",
                                "target_lang_sense_clarification": "a woman of a child"
                            },
                            {
                                "target_lang_word": "assist",
                                "target_lang_sense_clarification": "in childbirth"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "entbinden",
                                "target_lang_sense_clarification": "als Arzt oder Hebamme die Geburt leiten"
                            }
                        ]
                    }
                }
            ]
