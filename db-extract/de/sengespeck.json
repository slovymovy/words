                "senses": [
                    {
                        "sense_id": "34fb0b7f-adc2-3e40-b603-aa18ad637cae",
                        "entry_id": "f96d4830-378a-340d-a027-5d5fc13b3ceb",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0cd2822-9946-4c0c-8fb5-830f75c623fb",
                                "sense_id": "34fb0b7f-adc2-3e40-b603-aa18ad637cae",
                                "text": "Frau Sengespeck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d4ba33c1-400b-4f55-8c81-514149fea31a",
                                "sense_id": "34fb0b7f-adc2-3e40-b603-aa18ad637cae",
                                "text": "Herr Sengespeck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f8e7c288-ad2e-4ac7-8799-70e6bca5681f",
                                "sense_id": "34fb0b7f-adc2-3e40-b603-aa18ad637cae",
                                "text": "Die Sengespecks fahren heute ins Weimarer Land."
                            },
                            {
                                "example_id": "5df0aa88-0921-4e89-a2ed-cb1e7a676714",
                                "sense_id": "34fb0b7f-adc2-3e40-b603-aa18ad637cae",
                                "text": "Der Sengespeck trägt nie die Schals, die die Sengespeck ihm strickt."
                            },
                            {
                                "example_id": "69ebea36-124e-4802-b40c-b535075fbb94",
                                "sense_id": "34fb0b7f-adc2-3e40-b603-aa18ad637cae",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sengespeck kommt, geht der Herr Sengespeck.“"
                            },
                            {
                                "example_id": "33e2b08c-b7e3-4796-b389-3b950fba68c4",
                                "sense_id": "34fb0b7f-adc2-3e40-b603-aa18ad637cae",
                                "text": "Sengespeck kommt und geht."
                            },
                            {
                                "example_id": "06e04d4c-1bce-4528-a0f1-d8004ee4c688",
                                "sense_id": "34fb0b7f-adc2-3e40-b603-aa18ad637cae",
                                "text": "Sengespecks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
