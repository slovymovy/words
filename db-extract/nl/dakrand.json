                "senses": [
                    {
                        "sense_id": "9ffdf296-37e3-3b62-a05a-79e298449184",
                        "entry_id": "c9966ed5-6ff9-3840-8453-2500fad659f8",
                        "glosses": [
                            "zoom net onder het dak, de grens van het dak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "935bf42e-fa2e-47c8-a5a6-8a2a442e9a91",
                                "sense_id": "9ffdf296-37e3-3b62-a05a-79e298449184",
                                "text": "Een welgevormde, glanzend zwarte spin zat precies op de richel onder de dakrand aan de noordkant. Tijdens het plaatsen van de ombouw hadden Koos en Michel de spin waarschijnlijk uit zijn winterslaaphol verjaagd."
                            },
                            {
                                "example_id": "fc8c83b1-b62a-472c-bf67-a827054893a4",
                                "sense_id": "9ffdf296-37e3-3b62-a05a-79e298449184",
                                "text": "Het was een bakstenen gebouw met een dakrand van smoezelige trespaplaten en lag enigszins verscholen tussen twee andere bedrijven."
                            },
                            {
                                "example_id": "3a47164d-9e93-4945-bd02-80c34729a473",
                                "sense_id": "9ffdf296-37e3-3b62-a05a-79e298449184",
                                "text": "Tom Cruise sprong vanaf een stellage op een gebouw, maar dat ging goed mis. De aan veiligheidskabels gezekerde acteur moest een vrij grote afstand overbruggen en haalde de dakrand van een gebouw maar net. In een filmpje van het incident is te zien hoe Cruise na zijn val weer opkrabbelt en hinkend en met een van pijn vertrokken gezicht weg strompelt."
                            }
                        ]
                    }
