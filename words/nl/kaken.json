{
    "word_family": [
        "kaak",
        "kaker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fdf065fb-c581-3ddb-98c3-33e2716da777",
                    "sense_definition": "meervoud van <w>kaak</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kaak_plural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kou deed zijn <w>kaken</w> op elkaar klemmen.",
                            "target_lang_translations": {
                                "en": "The cold made him clench his <w>jaws</w>."
                            }
                        },
                        {
                            "text": "Zij lachte breed met haar rode wangen en sterke <w>kaken</w>.",
                            "target_lang_translations": {
                                "en": "She smiled broadly with her red cheeks and strong <w>jaws</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of kaak (jaw, cheek, or gill)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jaws",
                                "target_lang_sense_clarification": "plural of jaw, the bone structure of the mouth"
                            },
                            {
                                "target_lang_word": "cheeks",
                                "target_lang_sense_clarification": "plural of cheek, the side of the face"
                            },
                            {
                                "target_lang_word": "gills",
                                "target_lang_sense_clarification": "plural of gill, the respiratory organ of a fish"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b6aa1ab-e82c-3388-a058-f3d7924b0ed2",
                    "sense_definition": "een vis (met name haring) van de kieuwen en ingewanden ontdoen om deze beter te kunnen conserveren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vis_bewerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het <w>kaken</w> worden met een speciaal mesje de kieuwen en de ingewanden van de haring verwijderd.",
                            "target_lang_translations": {
                                "en": "During <w>gibbing</w>, the gills and internal organs of the herring are removed with a special knife."
                            }
                        },
                        {
                            "text": "De haring wordt eenmaal aan boord onmiddellijk <w>gekaakt</w>.",
                            "target_lang_translations": {
                                "en": "Once on board, the herring is immediately <w>gibbed</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wammen"
                    ],
                    "common_phrases": [
                        "haring kaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to gut and gill a fish (especially herring) to preserve it better"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to gib",
                                "target_lang_sense_clarification": "to remove the gills and guts of a herring"
                            },
                            {
                                "target_lang_word": "to gut",
                                "target_lang_sense_clarification": "to remove the internal organs of a fish"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}