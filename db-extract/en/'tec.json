                        "entry_id": "4ae9aa40-cb80-3a9f-ab1d-59713ec5fc68",
                        "glosses": [
                            "A detective."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c82521fd-b283-430c-bb13-cfaf9ec19c23",
                                "sense_id": "ec63d202-a21c-3f78-9854-39a6d99cec3e",
                                "text": "\"In the morning the blessed 'tecs will be out in all the stations, no doubt. And if they once got hold of her, for one reason or another she would be lost to him indeed.\""
                            },
                            {
                                "example_id": "7df5970e-808e-4103-8adc-508f41582273",
                                "sense_id": "ec63d202-a21c-3f78-9854-39a6d99cec3e",
                                "text": "\"You're a marvel, that's wot you are,\" ses the 'tec, shaking his 'ead. \"Have one with me.\""
                            },
                            {
                                "example_id": "43fe2367-cdab-48ab-bd50-6acd7a97f655",
                                "sense_id": "ec63d202-a21c-3f78-9854-39a6d99cec3e",
                                "text": "A collection of battered churns, looking like the jars for Ali-Baba's thieves, stood at one end of the room. A 'tec could hide in one of those, thought Robin."
                            }
                        ]
                    }
