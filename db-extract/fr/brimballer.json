                "senses": [
                    {
                        "sense_id": "64129542-95eb-37d6-9a30-b7a643cd651e",
                        "entry_id": "2cf02d85-3fef-32d8-8032-58c3dee18a23",
                        "glosses": [
                            "Secouer, bringuebaler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee87bb4-1e08-4b33-9ba3-d8c0b025cf79",
                                "sense_id": "64129542-95eb-37d6-9a30-b7a643cd651e",
                                "text": "d’un coup de crayon il taille en sac un paletot, il lire les sous-pieds d’un pantalon, rejette les basques d’un frac sur la poitrine, échancre ou boutonne un gilet, lustre ou hérisse la peluche noire d’un chapeau de soie, chausse les gants ou les bottes, encastre le lorgnon, fait plier le stick et brimballer les breloques, élime ou brosse les étoffes, serre ou débraille la tenue, et dessine aux coudes, aux entournures, aux tailles de chaque vêtement le pli caractéristique qui trahit la prétention, le lie, le vice, et raconte toute une vie."
                            },
                            {
                                "example_id": "a01f90e9-783e-442e-8753-d300b7dbd515",
                                "sense_id": "64129542-95eb-37d6-9a30-b7a643cd651e",
                                "text": "[…] brimballer sur l’épaule des charretées de draps, se déhancher à soutenir un panier énorme, marcher, courir, ne jamais se reposer."
                            },
                            {
                                "example_id": "2b1173cd-3fe4-46dd-a8d6-9096c643c334",
                                "sense_id": "64129542-95eb-37d6-9a30-b7a643cd651e",
                                "text": "Un plastron de fer luisait vaguement sur son buffle en lambeaux, et des targettes brimballaient sur ses cuisses."
                            },
                            {
                                "example_id": "3a05fb46-b5a5-4f7d-aca1-074afbf42198",
                                "sense_id": "64129542-95eb-37d6-9a30-b7a643cd651e",
                                "text": "Brimballer un fauteuil roulant sur un chemin cahotant ne se fait pas au 15 à l'heure."
                            }
                        ]
                    }
                ],
