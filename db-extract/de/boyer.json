                ],
                "senses": [
                    {
                        "sense_id": "60348a55-61ad-395c-a044-b4c0d298366c",
                        "entry_id": "b3a12191-c37a-3d3d-851f-e262143b6904",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f746226-ab51-4592-bfd1-a9899ea08a4b",
                                "sense_id": "60348a55-61ad-395c-a044-b4c0d298366c",
                                "text": "Frau Boyer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "50a56ca5-51f6-4bc4-acff-1e0ec371ad68",
                                "sense_id": "60348a55-61ad-395c-a044-b4c0d298366c",
                                "text": "Herr Boyer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f50213c5-a5ec-4f6e-aa1f-cf54f5f39610",
                                "sense_id": "60348a55-61ad-395c-a044-b4c0d298366c",
                                "text": "Die Boyers fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "e0f9f826-441a-4723-9f11-3991e8bf131a",
                                "sense_id": "60348a55-61ad-395c-a044-b4c0d298366c",
                                "text": "Der Boyer trägt nie die Pullover, die die Boyer ihm strickt."
                            },
                            {
                                "example_id": "9ab83cb4-c752-4abf-b94a-76e10fe9e318",
                                "sense_id": "60348a55-61ad-395c-a044-b4c0d298366c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Boyer kommt, geht der Herr Boyer.“"
                            },
                            {
                                "example_id": "0971c751-ddd2-4c37-9e0c-2cd66830311c",
                                "sense_id": "60348a55-61ad-395c-a044-b4c0d298366c",
                                "text": "Boyer kommt und geht."
                            },
                            {
                                "example_id": "18e8ffa4-565b-477f-b141-dbb25d9cbca6",
                                "sense_id": "60348a55-61ad-395c-a044-b4c0d298366c",
                                "text": "Boyers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
