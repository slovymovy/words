                        ],
                        "form": "die Spielsucht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "426c51bc-7500-36dc-bce2-66b0e99435fc",
                        "entry_id": "56af060b-0925-303d-a0d7-abdcb0c82457",
                        "glosses": [
                            "unbeherrschbarer innerer Drang, an Glücksspielen teilzunehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb5cb615-ec28-4904-938f-2466d3dbd310",
                                "sense_id": "426c51bc-7500-36dc-bce2-66b0e99435fc",
                                "text": "„Die Spielsucht zählt nach Expertenmeinung zu den Suchterkrankungen mit dem höchsten Selbstmord-Risiko.“"
                            },
                            {
                                "example_id": "bfe1cd11-5a0e-4748-b737-6c3f8b6789ae",
                                "sense_id": "426c51bc-7500-36dc-bce2-66b0e99435fc",
                                "text": "„Nun könnte die in der Influenza- und Parkinsonbehandlung eingesetzte Substanz Amatadin eine neue Behandlungsoption bei Spielsucht darstellen, berichteten Forscher der Italienischen Universität G. d'Annunzio in Chieti beim 23. Meeting der Europäischen Neurologengesellschaft (ENS) in Barcelona.“"
                            },
                            {
                                "example_id": "178ade91-b981-4413-81a5-a478ac383fc9",
                                "sense_id": "426c51bc-7500-36dc-bce2-66b0e99435fc",
                                "text": "„Keiner besonderen Aufmerksamkeit des Casinos hätte sich wohl der Freiherr von Knigge erfreuen dürfen, wenn der glückspielfeindliche Prominente überhaupt den Platz der vermaledeiten Spielsucht aufgesucht hätte.“"
                            },
                            {
                                "example_id": "2d2562f3-5ac4-4aaf-bfea-bfe14e34c163",
                                "sense_id": "426c51bc-7500-36dc-bce2-66b0e99435fc",
                                "text": "„Die Freude am Glücksspiel kann in pathologische Spielsucht ausarten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
