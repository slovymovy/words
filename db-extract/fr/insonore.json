                "senses": [
                    {
                        "sense_id": "8e53fbbb-9ca1-3190-b39d-bc7c9ab4b942",
                        "entry_id": "348e8cd7-c49f-3862-a386-5f74bead5c18",
                        "glosses": [
                            "Qui ne produit pas de son, qui ne s'entend pas, inaudible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c2adef8-fd17-47d0-8e29-56d9a68e8a3f",
                                "sense_id": "8e53fbbb-9ca1-3190-b39d-bc7c9ab4b942",
                                "text": "Les infrasons et les ultrasons sont insonores pour l'oreille humaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a4d02bd-cf70-3e5a-a9d5-55e1f2e9c5bf",
                        "entry_id": "348e8cd7-c49f-3862-a386-5f74bead5c18",
                        "glosses": [
                            "Qui étouffe le son, insonorisant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "193794ad-e936-4810-ba93-abb15410d9b3",
                                "sense_id": "0a4d02bd-cf70-3e5a-a9d5-55e1f2e9c5bf",
                                "text": "Le liège est une matière insonore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0558039a-6304-40a1-8bed-3deb32800e5a",
                        "source_entry_id": "348e8cd7-c49f-3862-a386-5f74bead5c18",
                        "target_lang_word": "schalldicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "666e2b76-07e9-4344-89df-e2c4849be661",
                        "source_entry_id": "348e8cd7-c49f-3862-a386-5f74bead5c18",
                        "target_lang_word": "inaudible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inaudible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0082a05d-6d08-3795-b111-951405f5dd6e",
                                        "entry_id": "1f173a4a-b8a9-3327-9bbc-7b5b1c3fd893",
                                        "glosses": [
                                            "Unable to be heard or not loud enough to be heard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c9e0d7c-d08e-426b-95a9-307b63d3f0ce",
                                                "sense_id": "0082a05d-6d08-3795-b111-951405f5dd6e",
                                                "text": "Dogs can hear this whistle, but for people it is inaudible."
                                            },
                                            {
                                                "example_id": "7b8eef64-ac89-4d9e-8671-41e029daebd3",
                                                "sense_id": "0082a05d-6d08-3795-b111-951405f5dd6e",
                                                "text": "At first his voice was almost inaudible; but soon the spirit mastered the body, and his hollow but distinct tones gained a supernatural strength."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cb1a355-e69c-422f-856b-bde1c0a00447",
                        "source_entry_id": "348e8cd7-c49f-3862-a386-5f74bead5c18",
                        "target_lang_word": "soundproof",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soundproof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32ad126e-00f2-33d8-9cf3-084f4dd08746",
                                        "entry_id": "5b19f6ad-e622-3f0b-9ee4-65598508f726",
                                        "glosses": [
                                            "Not allowing sound through."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c7942bb-ac71-4b30-a36b-1c39941381e0",
                                                "sense_id": "32ad126e-00f2-33d8-9cf3-084f4dd08746",
                                                "text": "The contestant was placed in a soundproof booth so he could not receive help from the audience."
                                            },
                                            {
                                                "example_id": "c9bbc1d0-c690-49fe-b7a4-0afbfe0b4250",
                                                "sense_id": "32ad126e-00f2-33d8-9cf3-084f4dd08746",
                                                "text": "The electrical activity of the subject's cerebral cortex was recorded in a state of relative rest, after a 5 min adaptation of the subject to a dark soundproof chamber. The biopotentials were recorded from the electroencephaloscope screen […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soundproof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7eb29e2d-a5be-394e-a825-7ac3f03ca9ae",
                                        "entry_id": "73e478b3-e125-35a9-acd5-ce7cc84c6c6a",
                                        "glosses": [
                                            "To make resistant to transmitting sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67744e03-6c4e-4d64-be17-892f9180bb5d",
                                                "sense_id": "7eb29e2d-a5be-394e-a825-7ac3f03ca9ae",
                                                "text": "We soundproofed the room so we couldn't hear the road noises; unfortunately we couldn't hear the fire alarm either."
                                            },
                                            {
                                                "example_id": "6aafe72a-d90d-4834-9f09-800a3eb3d5a6",
                                                "sense_id": "7eb29e2d-a5be-394e-a825-7ac3f03ca9ae",
                                                "text": "It almost goes without saying that the train is fully soundproofed, with double-glazed windows and highly efficient air-conditioning by the British firm of J. Stone."
                                            },
                                            {
                                                "example_id": "b4db9853-27f4-4d4c-9883-bf9d150526aa",
                                                "sense_id": "7eb29e2d-a5be-394e-a825-7ac3f03ca9ae",
                                                "text": "Soundproofing a room may be as simple as sealing gaps around a door, or it may require rebuilding an entire wall or lowering a ceiling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57bbf39c-e9f6-4ebe-b99e-91c3ce4bc034",
                        "source_entry_id": "348e8cd7-c49f-3862-a386-5f74bead5c18",
                        "target_lang_word": "soundless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soundless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85f3345f-1528-3e14-8348-965e42381f5d",
                                        "entry_id": "a6a1001d-e952-335b-8224-0e2c7c59cf34",
                                        "glosses": [
                                            "Without sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bbc86fb-35ac-48d8-986d-246c02b369a0",
                                                "sense_id": "85f3345f-1528-3e14-8348-965e42381f5d",
                                                "text": "a soundless tableau"
                                            },
                                            {
                                                "example_id": "9cee32a5-cdac-44d1-95a2-dcd03747878b",
                                                "sense_id": "85f3345f-1528-3e14-8348-965e42381f5d",
                                                "text": "Cassius. […] for your words, they rob the Hybla bees,\nAnd leave them honeyless.\nAntony. Not stingless too.\nBrutus. O yes, and soundless too;\nFor you have stol’n their buzzing, Antony,\nAnd very wisely threat before you sting."
                                            },
                                            {
                                                "example_id": "5019e985-b5a7-43be-814c-2a847eb702ee",
                                                "sense_id": "85f3345f-1528-3e14-8348-965e42381f5d",
                                                "text": "The Psalmist observes, That the Heavens declare the glory of God: And indeed, they celebrate his Praises, though with a soundless Voice, yet with so loud a one […] to our intellectual Ears, that he scruples not to affirm, that There is no Speech nor Language where their voice is not heard […]"
                                            },
                                            {
                                                "example_id": "e0a7f63d-913e-41bb-9aab-45ed66bf9f51",
                                                "sense_id": "85f3345f-1528-3e14-8348-965e42381f5d",
                                                "text": "The whole building, with its dark windows and soundless avenues, had an air strikingly forlorn and solitary."
                                            },
                                            {
                                                "example_id": "5e5054d2-149e-437f-b6a4-ba71e2de9b03",
                                                "sense_id": "85f3345f-1528-3e14-8348-965e42381f5d",
                                                "text": "During the whole of a dull, dark, and soundless day in the autumn of the year, when the clouds hang oppressively low in the heavens, I had been passing alone, on horseback, through a singularly dreary tract of country […]"
                                            },
                                            {
                                                "example_id": "91a9c505-8cf8-46e8-a36a-e5fea5c6e5e5",
                                                "sense_id": "85f3345f-1528-3e14-8348-965e42381f5d",
                                                "text": "The names of men blow soundless by,\nMy fellows’ and my own."
                                            },
                                            {
                                                "example_id": "c9fa7a94-a277-4168-bc73-44dfced6aeff",
                                                "sense_id": "85f3345f-1528-3e14-8348-965e42381f5d",
                                                "text": "All day a woman across the room from me has been rolling up her pages scroll-like and smoothing them out as soundless tears cascade down her face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "408c94d2-bdcd-3993-b3e4-1d72c6b38676",
                                        "entry_id": "a6a1001d-e952-335b-8224-0e2c7c59cf34",
                                        "glosses": [
                                            "Not capable of being sounded or fathomed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f354fa-aea0-41a5-832c-f9733f2023b8",
                                                "sense_id": "408c94d2-bdcd-3993-b3e4-1d72c6b38676",
                                                "text": "the soundless deep"
                                            },
                                            {
                                                "example_id": "ab7e486d-3bc9-46c0-b3a2-8f446cdeecf1",
                                                "sense_id": "408c94d2-bdcd-3993-b3e4-1d72c6b38676",
                                                "text": "Your shallowest help will hold me up afloat,\nWhilst he upon your soundless deep doth ride;"
                                            },
                                            {
                                                "example_id": "1f0dfbcd-1cf2-496c-b9c8-e43c16830716",
                                                "sense_id": "408c94d2-bdcd-3993-b3e4-1d72c6b38676",
                                                "text": "1614, Christopher Brooke, The Ghost of Richard the Third, London: L. Lisle, “The Legend of Richard the Third,”\nNor Wits, nor Chronicles could ere containe,\nThe Hell-deepe Reaches, of my soundlesse Braine."
                                            },
                                            {
                                                "example_id": "920524cd-ad5b-44e7-9e97-cbd4d3715aeb",
                                                "sense_id": "408c94d2-bdcd-3993-b3e4-1d72c6b38676",
                                                "text": "This heart’s geography’s map, this limitless small continent, this soundless sea;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
