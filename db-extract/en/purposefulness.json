                    {
                        "translation_id": "a0f14eef-f3e3-4554-b488-1a3c1118119f",
                        "source_entry_id": "8e4ec96a-df38-3e72-ad09-76242420361e",
                        "source_sense_id": "85719f6b-9414-3334-aa5a-d80fc4d0f5ca",
                        "source_sense_description": "being resolute",
                        "target_lang_word": "Entschlossenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entschlossenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                        "entry_id": "d4c5517d-5349-373f-9716-6bc2fde5cb6d",
                                        "glosses": [
                                            "Handlungsweise, mit der man willensstark und sicher (fest entschlossen) auf das ausgemachte Ziel zugeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d47f27-e2f6-4917-9938-de61b53f5457",
                                                "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                                "text": "„Damit hatte ich nun schon meine dritte Chance vertan und bekam Angst. Mir fehlte es an Entschlossenheit, ich hatte keinen klaren Kopf.“"
                                            },
                                            {
                                                "example_id": "82f9ba42-e216-4ade-8241-23f1552e05f3",
                                                "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                                "text": "„Cato war ein Mann von großer Entschlossenheit und republikanischer Tugend und stammte aus einem vornehmen Geschlechte.“"
                                            },
                                            {
                                                "example_id": "f9b67e9d-aa05-42e2-b5d4-8d5f5665f08c",
                                                "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                                "text": "„Mit wilder Entschlossenheit stößt er rückwärts in eine Parklücke.“"
                                            },
                                            {
                                                "example_id": "2dacfcfd-fce7-413d-9bd0-0b494951e6c2",
                                                "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                                "text": "„Die Selbstschwächung Europas in seinem vierzigjährigen Bruderkrieg beschleunigte indessen den letztlich unaufhaltsamen Prozess, indem sie allenthalben die Entschlossenheit und den Mut der Freiheitskämpfer beflügelte.“"
                                            },
                                            {
                                                "example_id": "c96a1f9c-cfc7-4820-a432-f530103adea9",
                                                "sense_id": "bb622000-8f96-3365-8dc4-d5a27fa3fee2",
                                                "text": "„Aber er war ein kräftiges Kind mit breiten Schultern und trotziger Entschlossenheit. Nach sieben Monaten hatte er es geschafft, den Bettrahmen aufzubiegen, die Kette herauszuziehen und Reißaus zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
