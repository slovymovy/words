                        ],
                        "form": "post-mortems"
                    },
                    {
                        "form_id": "cc492edd-9a98-4f68-aea7-35f9a972b40f",
                        "entry_id": "3b50ca37-60dd-3005-adad-b4daab2ab337",
                        "tags": [],
                        "form": "post mortem"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2109ba24-e6a7-38a4-ac30-9f326aac9a39",
                        "entry_id": "3b50ca37-60dd-3005-adad-b4daab2ab337",
                        "glosses": [
                            "Qui suit la mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4fe40e5-900d-4e7b-8ac9-7939bd9179bf",
                                "sense_id": "2109ba24-e6a7-38a4-ac30-9f326aac9a39",
                                "text": "Un ouvrage post-mortem."
                            },
                            {
                                "example_id": "bab3e080-91c4-4ddf-8b56-134324f23511",
                                "sense_id": "2109ba24-e6a7-38a4-ac30-9f326aac9a39",
                                "text": "Pour faire enregistrer son opposition aux prélèvements post-mortems, chacun peut obtenir une carte nominative auprès du Registre National des Refus qu’il faudra conserver sur soi. (« À propos du don d’organes » - Techouvot.com)"
                            },
                            {
                                "example_id": "61a5ee9c-f83a-4ae2-a094-f6329a54efb4",
                                "sense_id": "2109ba24-e6a7-38a4-ac30-9f326aac9a39",
                                "text": "Au reste, d’autres preuves d’identité seraient recherchées, mais plus tard. Empreintes digitales, génétiques, odontogramme post-mortem si besoin, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2398351b-f6c0-422d-b817-3e28aeabb650",
                        "source_entry_id": "3b50ca37-60dd-3005-adad-b4daab2ab337",
                        "source_sense_id": "2109ba24-e6a7-38a4-ac30-9f326aac9a39",
                        "target_lang_word": "post mortem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "post mortem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49b4474d-b366-32e8-aaed-928a0dbc540a",
                                        "entry_id": "2364d9ba-34a8-3d12-b9e0-282fd7fd62a3",
                                        "glosses": [
                                            "After death."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acacaee5-f15c-4417-816f-e48808dadb0c",
                                                "sense_id": "49b4474d-b366-32e8-aaed-928a0dbc540a",
                                                "text": "The hospice's standard procedure for post mortem room cleaning looks very thorough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "355e210a-c92a-3485-9c04-2f03d85fa034",
                                        "entry_id": "2364d9ba-34a8-3d12-b9e0-282fd7fd62a3",
                                        "glosses": [
                                            "Having been inflicted or having occurred after death."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a23a99c5-7962-415b-af37-8deacc62832d",
                                                "sense_id": "355e210a-c92a-3485-9c04-2f03d85fa034",
                                                "text": "We shouldn't let these post mortem injuries distract us while looking for the cause of death."
                                            },
                                            {
                                                "example_id": "fb3a4670-4416-4a08-9b26-41ffa1c6b53b",
                                                "sense_id": "355e210a-c92a-3485-9c04-2f03d85fa034",
                                                "text": "The post mortem timeline is incomplete."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "post mortem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4b2ecd-fda4-3386-94b5-fe892d79443a",
                                        "entry_id": "8b08b0e1-d52a-332c-b8ea-aab993bad278",
                                        "glosses": [
                                            "Occurring after death."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fb3755a-7695-49fa-b751-3e1d0cf38efc",
                                                "sense_id": "5f4b2ecd-fda4-3386-94b5-fe892d79443a",
                                                "text": "The injuries were found to have been caused post mortem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "post mortem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a08fcdba-df58-33a0-a977-c82f4e704ff1",
                                        "entry_id": "1214375e-1a2d-3ec1-a9d2-7e8eca5f5235",
                                        "glosses": [
                                            "An investigation of a corpse to determine the cause of death."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc720daa-1522-4d61-b5af-177ccb6e515e",
                                                "sense_id": "a08fcdba-df58-33a0-a977-c82f4e704ff1",
                                                "text": "Nor had the post mortem on Newson's body revealed any illness or other physical condition that might have prevented him from applying the brake, although after four days in the oven-like heat of the wreckage, the body was so badly decomposed as to make any reliable post mortem results unlikely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54308f8b-c89b-3570-8b49-3f7231cf6379",
                                        "entry_id": "1214375e-1a2d-3ec1-a9d2-7e8eca5f5235",
                                        "glosses": [
                                            "Any investigation after the conclusion of an activity, particularly when said activity produces an unwanted outcome."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11ab3daf-78e0-4d28-beef-25e90215c581",
                                                "sense_id": "54308f8b-c89b-3570-8b49-3f7231cf6379",
                                                "text": "Each user-visible outage or SLA violation should be followed by a postmortem and conclude with implementation of the recommendations in the postmortem report."
                                            },
                                            {
                                                "example_id": "c9746edc-518f-474b-ae5c-af9c9f98eb35",
                                                "sense_id": "54308f8b-c89b-3570-8b49-3f7231cf6379",
                                                "text": "After a serious delay there is often a post mortem on what happened, but this is usually in-house."
                                            },
                                            {
                                                "example_id": "a3555b42-cbc2-4984-913e-7eb2c6f98466",
                                                "sense_id": "54308f8b-c89b-3570-8b49-3f7231cf6379",
                                                "text": "Grinspoon finishes with some sage advice on the best way to avoid greening out: \"Keep the doses low and know yourself. If it happens to you, try to do a postmortem on what happened, like: 'Was there alcohol involved? Was there nicotine involved?' Was I overtired? Did I take five puffs when I usually take two puffs?'\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49c05651-bd9e-367e-a040-e4370bcb4501",
                                        "entry_id": "1214375e-1a2d-3ec1-a9d2-7e8eca5f5235",
                                        "glosses": [
                                            "At Cambridge, a second examination for those who were \\\"plucked\\\" or failed in the first."
                                        ],
                                        "tags": [
                                            "British",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5bf1e63-2bff-4cdd-95fd-471915d90c81",
                        "source_entry_id": "3b50ca37-60dd-3005-adad-b4daab2ab337",
                        "source_sense_id": "2109ba24-e6a7-38a4-ac30-9f326aac9a39",
                        "target_lang_word": "posmrtný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "posmrtný",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "4ea3ae98-3bfc-3294-b1cc-e3eee80215ad",
                                        "entry_id": "cce6b14b-bb00-32ad-927b-2dd416d1a29c",
                                        "glosses": [
                                            "vztahující se k době po smrti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a83e0c-8c2d-4597-b076-cb12741dacd3",
                                                "sense_id": "4ea3ae98-3bfc-3294-b1cc-e3eee80215ad",
                                                "text": "Mezi unikátní a přitom nepříliš známé poklady patří posmrtné masky slavných osobností či sbírka nemocí, které trápily naše předky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
