                "senses": [
                    {
                        "sense_id": "859f8e5a-23eb-303a-8f1f-a58f40575338",
                        "entry_id": "18d14d14-8c50-3f3e-9e39-a2ee6ac24003",
                        "glosses": [
                            "Empiler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f64f2769-aa11-44e1-a603-b806185e5e09",
                                "sense_id": "859f8e5a-23eb-303a-8f1f-a58f40575338",
                                "text": "Tout ce monde, à l'envi, pérorait, fumait, crachait. Les uns transportaient d'une table à l'autre des monceaux de paperasses qui s'écroulaient soudain. D'autres les ramassaient en vrac pour les réempiler au petit bonheur."
                            },
                            {
                                "example_id": "01350e61-f485-4e83-8d23-ad1c91720d56",
                                "sense_id": "859f8e5a-23eb-303a-8f1f-a58f40575338",
                                "text": "La société se réempila dans la limousine de de Morbihan, qui les emporta vers l’avenue des Champs-Élysées, où elle s’arrêta devant l’Élysée-Palace-Hôtel pour déposer Bannon et la jeune fille — sa fille — ou bien quoi ?"
                            },
                            {
                                "example_id": "723a9c28-b195-40ba-8d4a-557b6dc5270c",
                                "sense_id": "859f8e5a-23eb-303a-8f1f-a58f40575338",
                                "text": "Le Monotra CN permet d'effectuer l'éjection des pièces frappées ou éventuellement, de les réempiler dans un magasin prévu à cet effet."
                            }
                        ]
                    }
