                ],
                "senses": [
                    {
                        "sense_id": "8e3d5808-7b62-3a7a-a0d4-0f335aaff599",
                        "entry_id": "4342a13a-7001-3d41-a502-e6ef1c73dd60",
                        "glosses": [
                            "Dilettante qui fréquente les clubs, les cercles, etc."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1e6c9af8-875c-4f0f-92d8-033df8db1335",
                                "sense_id": "8e3d5808-7b62-3a7a-a0d4-0f335aaff599",
                                "text": "[…], Mmes Daudoird et Clara Lemonnier, dont la première portait l’habit noir avec un chic et une aisance qui auraient damé le pion au clubman le plus élégant."
                            },
                            {
                                "example_id": "7363594d-ac2e-4412-9b6f-502afce98ce8",
                                "sense_id": "8e3d5808-7b62-3a7a-a0d4-0f335aaff599",
                                "text": "Quelques jeunes clubmen, dont l’imagination aventureuse s’était enflammée de patriotisme, s’entassèrent dans cinq ou six automobiles et partirent clandestinement pour Beacon Hill."
                            },
                            {
                                "example_id": "96cf48bb-e514-4a48-86c8-99677fb89720",
                                "sense_id": "8e3d5808-7b62-3a7a-a0d4-0f335aaff599",
                                "text": "Sur les banquettes, des clubmans fatigués, escortés de jolies femmes consternées, anéanties, ahuries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aabdb54-93f0-43ef-a2e3-d234fe4470a5",
                        "source_entry_id": "4342a13a-7001-3d41-a502-e6ef1c73dd60",
                        "source_sense_id": "8e3d5808-7b62-3a7a-a0d4-0f335aaff599",
                        "target_lang_word": "clubman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clubman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d71e318-dd49-33b8-9720-5c68a1db5856",
                                        "entry_id": "e41b79cd-dc34-3755-8060-3693f1997139",
                                        "glosses": [
                                            "A man who attends a social club."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd91339a-0d09-49f8-a676-74b6a2f91ab2",
                                                "sense_id": "9d71e318-dd49-33b8-9720-5c68a1db5856",
                                                "text": "The fattest clubman in London. He sits at one of the little club tables in the huge bay by the fire, stuffing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c702717-3bec-3c62-9141-986e617e5331",
                                        "entry_id": "e41b79cd-dc34-3755-8060-3693f1997139",
                                        "glosses": [
                                            "A warrior who uses a club as a weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d741e57-656e-4699-8ff5-61a9163e23d6",
                                                "sense_id": "8c702717-3bec-3c62-9141-986e617e5331",
                                                "text": "The clubmen were second-class warriors. They wore closely woven braided coconut-husk armor and would drill with their clubs in preparation for war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
