                    "sense_id": "0810d8dd-b007-3dd5-ad06-2524db801d27",
                    "sense_definition": "Air inspiré ou expiré par les poumons ; acte même de respirer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir couru jusqu'à l'arrêt de bus, il s'est arrêté pour reprendre son <w>souffle</w>."
                        },
                        {
                            "text": "Le public a retenu son <w>souffle</w> pendant toute la durée du numéro d'équilibriste."
                        }
                    ],
                    "synonyms": [
                        "respiration",
                        "haleine"
                    ],
                    "common_phrases": [
                        "reprendre son souffle",
                        "à bout de souffle",
                        "retenir son souffle"
                    ]
                },
                {
                    "sense_id": "bff396f6-2eb7-3dc4-902b-03d1101bd6c8",
                    "sense_definition": "Jet d'air expulsé volontairement par la bouche.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a éteint les bougies de son gâteau d'anniversaire d'un seul <w>souffle</w> puissant."
                        },
                        {
                            "text": "Elle a senti un léger <w>souffle</w> chaud contre sa joue quand il lui a chuchoté ce mot."
