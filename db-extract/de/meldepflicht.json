                    {
                        "sense_id": "990f34f4-e010-39bd-9c42-6f8e16b1bb33",
                        "entry_id": "645be843-c236-3e9d-a639-d9cb22ff156c",
                        "glosses": [
                            "Auflage, gesetzliche Verpflichtung (Pflicht), gewisse Informationen an zuständige Behörden weiterzugeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10d56803-ee36-4ed7-ab84-c26c17fdea6f",
                                "sense_id": "990f34f4-e010-39bd-9c42-6f8e16b1bb33",
                                "text": "Im Rahmen des Kampfes gegen die Geldwäsche wurden die Meldepflichten überarbeitet und verschärft."
                            },
                            {
                                "example_id": "9b00530d-5ca7-4f4a-b752-d34d72236962",
                                "sense_id": "990f34f4-e010-39bd-9c42-6f8e16b1bb33",
                                "text": "Wenn dem Bewährungshelfer eine Verletzung der Bewährungsauflagen bekannt wird, hat er dem Richter gegenüber eine Meldepflicht."
                            },
                            {
                                "example_id": "af767671-c47b-4117-9d87-6204f33d96c1",
                                "sense_id": "990f34f4-e010-39bd-9c42-6f8e16b1bb33",
                                "text": "Tollwut unterliegt der Meldepflicht."
                            },
                            {
                                "example_id": "e9906674-db5a-4647-9b6e-2e1b0fc5d845",
                                "sense_id": "990f34f4-e010-39bd-9c42-6f8e16b1bb33",
                                "text": "Um der Meldepflicht nachzukommen, meldete sie sich beim zuständigen Einwohnermeldeamt an."
                            }
                        ],
