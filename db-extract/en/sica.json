                        "glosses": [
                            "A curved dagger used in Ancient Roman times, associated with the Thracian and Illyrians, gladiators, and Sicarii."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ce0f49cc-f456-477a-aecc-ab4828cf1641",
                                "sense_id": "954f8938-5f14-37e4-847f-c1230dbc2776",
                                "text": "[...] representation of a sheathed sickle on two fragments of a limestone plaque from Siristat (Figure 12). The plaque has not survived and only a sketch made by Jüthner records it. The publishers thought it showed a gladiatorial sica[…]"
                            },
                            {
                                "example_id": "602a8067-736c-4c88-a932-cee52ac8d46e",
                                "sense_id": "954f8938-5f14-37e4-847f-c1230dbc2776",
                                "text": "He had been honing the blades of sica daggers when Marie was brought in, work that could only be done in the secrecy of night. The huddle broke up and four Sicarii left, including the man with the nervous eyes."
                            },
                            {
                                "example_id": "0c53f01a-7788-45df-9dd9-71120d201747",
                                "sense_id": "954f8938-5f14-37e4-847f-c1230dbc2776",
                                "text": "We growled as short sica daggers flashed from the folds of many robes."
                            }
                        ]
                    }
