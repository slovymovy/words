    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bd63eff-3c4f-360f-81cc-c6928342daa0",
                    "sense_definition": "A letter or diacritic representing the sound of a vowel, such as a, e, i, o, or u.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word facetiously is spelled with all six <w>vowels</w> in alphabetical order.",
                            "target_lang_translations": {
                                "ru": "Слово «facetiously» пишется со всеми шестью <w>гласными</w> в алфавитном порядке."
                            }
                        },
                        {
                            "text": "Children learn to identify every <w>vowel</w> in the alphabet during their first year of school.",
                            "target_lang_translations": {
                                "ru": "В первый год обучения в школе дети учатся определять каждую <w>гласную</w> в алфавите."
                            }
                        }
                    ],
                    "antonyms": [
                        "consonant"
                    ],
                    "common_phrases": [
                        "short vowel",
                        "long vowel",
                        "vowel letter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Буква или диакритический знак, представляющий гласный звук, например, a, e, i, o или u."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гласная",
                                "target_lang_sense_clarification": "буква"
                            },
                            {
                                "target_lang_word": "гласная буква",
                                "target_lang_sense_clarification": "письменный символ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab14d148-dc7a-3395-b72f-774cdba5e82f",
                    "sense_definition": "A speech sound produced without significant constriction of the air flow from the lungs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the Welsh language, the letter w usually represents a <w>vowel</w> sound.",
                            "target_lang_translations": {
                                "ru": "В валлийском языке буква «w» обычно обозначает <w>гласный</w> звук."
                            }
                        },
                        {
                            "text": "The singer practiced a pure <w>vowel</w> to ensure the note sounded clear and resonant.",
                            "target_lang_translations": {
                                "ru": "Певец тренировал чистый <w>гласный</w>, чтобы нота звучала ясно и резонансно."
                            }
                        }
                    ],
                    "antonyms": [
                        "consonant"
                    ],
                    "common_phrases": [
                        "vowel sound",
                        "nasal vowel",
                        "pure vowel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук речи, образующийся без существенного препятствия воздушному потоку из легких."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гласный",
                                "target_lang_sense_clarification": "звук"
                            },
                            {
                                "target_lang_word": "гласный звук",
                                "target_lang_sense_clarification": "фонетика"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f933df41-762d-326f-b6c3-72a50d08e899",
                    "sense_definition": "To add vowel points or marks to a script that primarily uses consonants.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar decided to <w>vowel</w> the ancient text to make it easier for students to read.",
                            "target_lang_translations": {
                                "ru": "Ученый решил <w>огласовать</w> древний текст, чтобы студентам было легче его читать."
                            }
                        },
                        {
                            "text": "It is difficult to determine how the name should be <w>vowelled</w> without more historical context.",
                            "target_lang_translations": {
                                "ru": "Без дополнительного исторического контекста трудно определить, как это имя должно быть <w>огласовано</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vowelize",
                        "vocalize"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in linguistics or philology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять знаки огласовки в текст, состоящий преимущественно из согласных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огласовывать",
                                "target_lang_sense_clarification": "добавлять гласные знаки"
                            },
                            {
                                "target_lang_word": "вокализовать",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
