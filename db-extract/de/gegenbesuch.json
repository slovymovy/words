                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90785a5d-7f4e-434e-8236-e721d297bc5b",
                                "sense_id": "4f6916ab-e37e-31bd-bac1-bb8ea8f03bcc",
                                "text": "Eine Abordnung des Bezirksamtes machte im darauffolgenden Sommer einen Gegenbesuch in der französischen Partnerstadt."
                            },
                            {
                                "example_id": "f7d05996-b91d-44b3-9258-b116328ba19a",
                                "sense_id": "4f6916ab-e37e-31bd-bac1-bb8ea8f03bcc",
                                "text": "Nach dem netten Abend luden die Müllers spontan zu einem Gegenbesuch in deren Sommerhäuschen ein."
                            }
