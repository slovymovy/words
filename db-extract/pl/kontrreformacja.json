                    },
                    {
                        "translation_id": "c4c186b6-0f6b-47d3-8936-faad07bc7f1b",
                        "source_entry_id": "f61254d9-f412-303b-9e24-18096c9274b9",
                        "source_sense_id": "0e55b750-77f8-36a6-b9a0-6940e9741600",
                        "target_lang_word": "Gegenreformation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenreformation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b6c0998-72a9-330f-9d89-99bea04167c8",
                                        "entry_id": "4ae478bc-eb83-3571-89e9-77e9062b3648",
                                        "glosses": [
                                            "Bewegung innerhalb der katholischen Welt, die sich im 16. Jahrhundert und der ersten Hälfte des 17. Jahrhunderts bewusst gegen die Reformation wandte und die Zurückdrängung des Protestantismus zum Ziel hatte"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b00ca6b3-898b-4c84-b9d4-eb7bd85943ef",
                                                "sense_id": "3b6c0998-72a9-330f-9d89-99bea04167c8",
                                                "text": "Das Ziel der Gegenreformation, die Vernichtung der protestantischen Häresie und die Wiederherstellung der abendländischen Kircheneinheit, ist nicht erreicht worden."
                                            },
                                            {
                                                "example_id": "02ac6885-0402-4c43-9c53-a4e76d27f38d",
                                                "sense_id": "3b6c0998-72a9-330f-9d89-99bea04167c8",
                                                "text": "„In Irland setzte sich die Gegenreformation durch und die englische Krone musste ihre Eroberungen wiederholt mit der Ansiedlung von englischen und schottischen Protestanten sichern.“"
                                            },
                                            {
                                                "example_id": "fee206e1-dfb6-4b99-9444-95352dc11467",
                                                "sense_id": "3b6c0998-72a9-330f-9d89-99bea04167c8",
                                                "text": "„Selbst die Gegenreformation der römisch-katholischen Kirche konnte übrigens an dieser Konstellation nicht rütteln.“"
                                            },
                                            {
                                                "example_id": "ee177409-69fd-4e19-8d57-36dfd94bfb2e",
                                                "sense_id": "3b6c0998-72a9-330f-9d89-99bea04167c8",
                                                "text": "„In der endzeitlichen Radikalität erkannten alle, die sie nicht teilten, die gefährlichste Bedrohung jeder konfessionellen Konsolidierung, sei es aufseiten der Reformation oder aufseiten der Gegenreformation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
