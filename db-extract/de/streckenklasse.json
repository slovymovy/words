                "senses": [
                    {
                        "sense_id": "f1c2f6b9-bd5e-3f6d-af19-ead8647e6ad1",
                        "entry_id": "aa43152e-a851-36b4-ae4f-61c3f838baba",
                        "glosses": [
                            "(genormte) Einteilung von Eisenbahnstrecken anhand der Werte für die maximal zulässige Radsatzlast und die höchste zulässige Meterlast"
                        ],
                        "tags": [
                            "Eisenbahnwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "95614eb1-4827-4a89-9dae-a99080e74add",
                                "sense_id": "f1c2f6b9-bd5e-3f6d-af19-ead8647e6ad1",
                                "text": "„Oberbau und Bauwerke müssen hinsichtlich ihrer Belastbarkeit durch Schienenfahrzeuge in Streckenklassen gemäß ÖNORM EN 15528 „Bahnanwendungen – Streckenklassen zur Bewerkstelligung der Schnittstelle zwischen Lastgrenzen der Fahrzeuge und Infrastruktur“ vom 1. Jänner 2013 (Anlage 8) einklassifiziert sein.“"
                            },
                            {
                                "example_id": "39d76cfe-1e6c-435d-ac27-a264bc380d88",
                                "sense_id": "f1c2f6b9-bd5e-3f6d-af19-ead8647e6ad1",
                                "text": "„Auch mit einer niedrigeren Streckenklasse ließen sich hohe Verkehrsleistungen erbringen - so im Kombinierter Verkehr.“"
                            },
                            {
                                "example_id": "f84a5400-78a4-4738-ac05-6f4d87ef8d68",
                                "sense_id": "f1c2f6b9-bd5e-3f6d-af19-ead8647e6ad1",
                                "text": "„In diesem Sinne werden die Bahnunternehmen den Oberbau im Gesamtbereich für eine Radsatzlast von 22,5 Tonnen ausbauen (UIC-Streckenklasse D 4).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
