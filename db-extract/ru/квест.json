                                "target_senses": [
                                    {
                                        "sense_id": "09ef830a-6cb2-3fde-a028-5adbbb35d969",
                                        "entry_id": "f4b826bf-105a-374c-a85e-68f97d35e629",
                                        "glosses": [
                                            "A journey or effort in pursuit of a goal (often lengthy, ambitious, or fervent); a mission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e063aa6-bba9-47d3-b280-8c5ad3edad82",
                                                "sense_id": "09ef830a-6cb2-3fde-a028-5adbbb35d969",
                                                "text": "Cease your quest of love."
                                            },
                                            {
                                                "example_id": "70add11d-52dd-4925-8a20-8c5763cc122f",
                                                "sense_id": "09ef830a-6cb2-3fde-a028-5adbbb35d969",
                                                "text": "Everything I have done pales in comparison to what I am about to achieve. I am on a quest... a quest for the most revered icon in Klingon history. An icon that predates the Klingon Empire, an icon more sacred than the Torch of G'boj -- More revered than Sabak's armor, and more coveted than the Emperor's crown!"
                                            },
                                            {
                                                "example_id": "8a867337-41c9-45e9-a340-6164917622b8",
                                                "sense_id": "09ef830a-6cb2-3fde-a028-5adbbb35d969",
                                                "text": "In his first book since the 2008 essay collection Natural Acts: A Sidelong View of Science and Nature, David Quammen looks at the natural world from yet another angle: the search for the next human pandemic, what epidemiologists call “the next big one.” His quest leads him around the world to study a variety of suspect zoonoses—animal-hosted pathogens that infect humans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdaefec3-ec9e-3720-90a3-9b462f4bda0f",
                                        "entry_id": "f4b826bf-105a-374c-a85e-68f97d35e629",
                                        "glosses": [
                                            "A journey or effort in pursuit of a goal (often lengthy, ambitious, or fervent); a mission.",
                                            "A task that a player may complete in order to gain a reward or advance the story."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51d82e80-058d-3a7d-80bd-df8af154d0a5",
                                        "entry_id": "f4b826bf-105a-374c-a85e-68f97d35e629",
                                        "glosses": [
                                            "The act of seeking, or looking after anything; attempt to find or obtain; search; pursuit."
                                        ],
                                        "tags": [],
                                        "examples": [
