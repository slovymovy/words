                "translations": [
                    {
                        "translation_id": "ca6fde7f-3fa3-4c23-babf-ec20e69ce6d7",
                        "source_entry_id": "b342bd74-e226-348f-b74b-36377b3749a1",
                        "source_sense_id": "1f25c853-2902-3947-9b64-d8431efabc41",
                        "target_lang_word": "scatterbrained",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scatterbrained",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc55dacb-794d-3519-8ef2-c05284a8eccb",
