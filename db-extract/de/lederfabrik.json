                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ae90ca-72a7-43ed-9c88-84c2fd48a9f3",
                                "sense_id": "43d92988-149b-3e7a-a848-c315386d6f31",
                                "text": "Die Lederfabrik hat 100 Mitarbeiter und Kunden in der ganzen Region."
                            },
                            {
                                "example_id": "2d22e6ac-f196-469c-9531-bee7ecf3dc64",
                                "sense_id": "43d92988-149b-3e7a-a848-c315386d6f31",
                                "text": "Zwei Lederfabriken in unserer Stadt wurden bereits geschlossen, die dritte kämpft ums Fortbestehen."
                            },
                            {
                                "example_id": "db5da79d-14ae-491b-bd18-b70bc6a70fd2",
                                "sense_id": "43d92988-149b-3e7a-a848-c315386d6f31",
                                "text": "„Schließlich hatte er gegen den brummenden Generator angeschrien, in der Hoffnung, dass irgendein Arbeiter der Lederfabrik ihn hörte.“"
