                "forms": [],
                "senses": [
                    {
                        "sense_id": "2089a591-c1a3-3d64-b8f3-bc3e08d96845",
                        "entry_id": "687f7453-4178-3823-b6df-857f0bc99bf9",
                        "glosses": [
                            "Consisting of seawater."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0510d9c3-a5c7-4497-9a52-7235babaf291",
                                "sense_id": "2089a591-c1a3-3d64-b8f3-bc3e08d96845",
                                "text": "The continual seawater splashes corroded our equipment"
                            }
                        ]
                    },
                    {
                        "sense_id": "46275280-a140-31df-a6d1-72f258c1280b",
                        "entry_id": "687f7453-4178-3823-b6df-857f0bc99bf9",
                        "glosses": [
                            "Associated in some way with seawater, or intended for dealing with seawater."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "29de469c-fe6e-4ba0-9df9-ce9cb2a10ee7",
                                "sense_id": "46275280-a140-31df-a6d1-72f258c1280b",
                                "text": "The sharks in the aquarium had to be kept in a seawater tank"
                            },
                            {
                                "example_id": "3c9ce6fe-638a-45af-a24d-8a0e06b0f063",
                                "sense_id": "46275280-a140-31df-a6d1-72f258c1280b",
                                "text": "Aboard the ship we needed seawater soap for washing our clothes"
                            },
                            {
                                "example_id": "7de64ba5-45b2-47d4-960b-18e6d48e5322",
                                "sense_id": "46275280-a140-31df-a6d1-72f258c1280b",
                                "text": "Though it was a nuisance to arrange them, we found the seawater showers very refreshing"
                            }
                        ]
                    }
                ],
