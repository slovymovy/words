                                            {
                                                "example_id": "9e66f479-fd7f-4fb3-a4fb-4f00f24af563",
                                                "sense_id": "4063593e-2336-3bf6-aafe-db00765ef205",
                                                "text": "Das Turmspringen ist seine Spezialität."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1cb0b68e-4966-397f-b4ba-89145fcf6f68",
