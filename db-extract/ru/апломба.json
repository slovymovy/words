                "senses": [
                    {
                        "sense_id": "f27b17cd-17e9-3e60-8a72-0c6d50a18f63",
                        "entry_id": "c940546f-ff0f-3167-affb-9e1a00c77b74",
                        "glosses": [
                            "устар. то же, что апломб"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e19d656-203c-427c-b4d7-eaa0a2a3d856",
                                "sense_id": "f27b17cd-17e9-3e60-8a72-0c6d50a18f63",
                                "text": "Конечно, я ничего в этом не понимала, но проговорила ясно, громко, с большой апломбой."
                            },
                            {
                                "example_id": "04e53ed6-33e3-4917-8ae3-94468f3adb79",
                                "sense_id": "f27b17cd-17e9-3e60-8a72-0c6d50a18f63",
                                "text": "― А тебе, Павел, со всей апломбой заявляю: будешь притеснять сестру, увезу её к себе на дачу."
                            }
                        ]
                    }
