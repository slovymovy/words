                                    {
                                        "sense_id": "a268b24e-6db3-3578-b92a-db2272bc760e",
                                        "entry_id": "3ec7b7f6-3f87-3e24-a7ef-9b74d5d44dff",
                                        "glosses": [
                                            "Entremets fait de marmelade de pommes que l’on entoure de morceaux de pain rissolés au beurre."
