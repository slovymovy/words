                "senses": [
                    {
                        "sense_id": "e9f15e37-9320-310e-a3aa-3efd32490db3",
                        "entry_id": "f714e4e0-007e-345e-a3fb-f8597c187894",
                        "glosses": [
                            "Leitung eines Unternehmens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f83714-69b8-4b66-9ab0-5f0d09ad0921",
                                "sense_id": "e9f15e37-9320-310e-a3aa-3efd32490db3",
                                "text": "Die Chefetage erhielt immer das beste Essen."
                            },
                            {
                                "example_id": "addb34ce-d854-4a0b-9c30-c9abacf67271",
                                "sense_id": "e9f15e37-9320-310e-a3aa-3efd32490db3",
                                "text": "„Sie lassen eher an Landpomeranzen aus einer längst vergangenen Zeit denken als an emanzipierte Frauen, die den Aufstieg in die Chefetagen geschafft haben.“"
                            },
                            {
                                "example_id": "8b04c801-4568-4fed-aac2-8d72cdd0937a",
                                "sense_id": "e9f15e37-9320-310e-a3aa-3efd32490db3",
                                "text": "„Vor acht Jahren ist der Hein in die Chefetage der Hessischen Landesbank in Frankfurt gegangen und hat mit dem Präsidenten, Professor Hankel, Tee getrunken und sich über Wissenschaft und Religion unterhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "535ec87d-9203-3e79-8207-37142fe41dfa",
                        "entry_id": "f714e4e0-007e-345e-a3fb-f8597c187894",
                        "glosses": [
                            "Stockwerk der Geschäftsleitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cb1cace-1cdf-423c-b835-cb927a1e4c42",
                                "sense_id": "535ec87d-9203-3e79-8207-37142fe41dfa",
                                "text": "Um zu der Chefetage zu kommen, musste man den Aufzug nehmen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
