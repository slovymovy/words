                ],
                "senses": [
                    {
                        "sense_id": "0d860866-9e7e-3aa6-bbb1-19a3ead54dc6",
                        "entry_id": "2da6c293-e3ca-3985-9de3-214f0e84583f",
                        "glosses": [
                            "Stoff, der explodieren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3164546f-52ba-41ec-8a3c-5ff56bd919f5",
                                "sense_id": "0d860866-9e7e-3aa6-bbb1-19a3ead54dc6",
                                "text": "„Da auch jedes einzelne Gepäckstück auf Explosivstoffe hin besonders unter die Lupe genommen wird, sollten Gepäckstücke nicht verschlossen abgegeben werden, einzelne Gegenstände besser ohne Umverpackung im Koffer verstauen.“"
                            },
                            {
                                "example_id": "ad7325b0-28d7-46b5-8ce6-b7382693bd43",
                                "sense_id": "0d860866-9e7e-3aa6-bbb1-19a3ead54dc6",
                                "text": "„Bis vor etwa 140 Jahren war das Schwarzpulver – ein Gemenge aus Kaliumsalpeter, Schwefel und Holzkohle – der einzige praktisch nutzbare Explosivstoff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e6fe55de-280e-33c7-97a4-e7c83f82bfbf",
                        "entry_id": "2da6c293-e3ca-3985-9de3-214f0e84583f",
                        "glosses": [
                            "zum Sprengen genutzte Substanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a97a7b-d53d-4398-a6d2-d55e220acd13",
                                "sense_id": "e6fe55de-280e-33c7-97a4-e7c83f82bfbf",
                                "text": "„Bis vor etwa 140 Jahren war das Schwarzpulver – ein Gemenge aus Kaliumsalpeter, Schwefel und Holzkohle – der einzige praktisch nutzbare Explosivstoff.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "131adc73-83fc-3168-9a29-b35c1f4b0a78",
                        "entry_id": "2da6c293-e3ca-3985-9de3-214f0e84583f",
                        "glosses": [
                            "Stoff, der die Grundlage für eine Situation bildet, die außer Kontrolle geraten kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c3b3006e-6b01-49a1-8a0f-d28c4947b58e",
                                "sense_id": "131adc73-83fc-3168-9a29-b35c1f4b0a78",
                                "text": "Die Korruptionsaffäre des Präsidenten war der Explosivstoff für die politischen Unruhen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
