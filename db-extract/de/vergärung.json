                        "source_sense_description": "Verwertung von organischen Abfalles durch Mikroorganismen; ohne Sauerstoffverbrauch",
                        "target_lang_word": "méthanisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méthanisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c091696-2fbf-3625-b968-f7053d6d23d9",
                                        "entry_id": "46accd02-4486-32d7-9951-c9e32d928840",
                                        "glosses": [
                                            "Processus naturel biologique de dégradations biologiques (hydrolyse, fermentation, acétogénèse, méthanogénèse) de matières organiques en absence d’oxygène produisant un biogaz (méthane) et un digestat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e043270-b051-4497-8c06-f3c49947c6a5",
                                                "sense_id": "7c091696-2fbf-3625-b968-f7053d6d23d9",
                                                "text": "Autre atout du département, un fort vivier de chercheurs, notamment à l’UTT, et près de soixante-dix entreprises susceptibles d’assurer la construction, l’exploitation et la maintenance d’unités de méthanisation."
                                            },
                                            {
                                                "example_id": "85aad958-fd83-493b-be8f-7d46b4783667",
                                                "sense_id": "7c091696-2fbf-3625-b968-f7053d6d23d9",
                                                "text": "La méthanisation, c’est l’utilisation en combustible des gaz produits par la décomposition de matières organiques."
                                            },
                                            {
                                                "example_id": "35041ebe-dc50-4cea-9019-7863058b6996",
                                                "sense_id": "7c091696-2fbf-3625-b968-f7053d6d23d9",
                                                "text": "Six usines de méthanisation fonctionnent en France, mais Romainville est le projet le plus ambitieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4de72787-b41b-3686-8790-c4776ff8ade1",
                                        "entry_id": "46accd02-4486-32d7-9951-c9e32d928840",
                                        "glosses": [
                                            "Dernière phase de la digestion anaérobie, destinée à produire du méthane."
                                        ],
                                        "tags": [
                                            "Bioénergie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "492c9046-fe10-48fb-86c6-8bab598fa57c",
                                                "sense_id": "4de72787-b41b-3686-8790-c4776ff8ade1",
                                                "text": "Non à la méthanisation XXL et aux méga-méthaniseurs !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
