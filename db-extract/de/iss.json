                "senses": [
                    {
                        "sense_id": "3a0fa2dd-04ee-3e55-b920-0965b2cbb8d5",
                        "entry_id": "392809d0-19d1-3f70-85f3-d09a3e5b8236",
                        "glosses": [
                            "International Space Station; zu deutsch: Internationale Raumstation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "011b01ab-436c-4729-ae9f-5deeadc31e5b",
                                "sense_id": "3a0fa2dd-04ee-3e55-b920-0965b2cbb8d5",
                                "text": "Die ISS kann manchmal als leuchtendes Objekt am Himmel wahrgenommen werden."
                            },
                            {
                                "example_id": "9e8472a3-7a43-4401-a352-7afd4d73ba61",
                                "sense_id": "3a0fa2dd-04ee-3e55-b920-0965b2cbb8d5",
                                "text": "„Zur ISS wollen in diesem Jahr auch die Europäer aufbrechen, und zwar erstmals mit einem eigenen Fluggerät.“"
                            },
                            {
                                "example_id": "fbfee761-757e-4b38-a7f0-f110812a670b",
                                "sense_id": "3a0fa2dd-04ee-3e55-b920-0965b2cbb8d5",
                                "text": "„Weil in der Nacht zu Donnerstag ein russischer Erdbeobachtungssatellit zerfiel, war zwischenzeitlich unklar, ob Teile die ISS treffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
