                "translations": [
                    {
                        "translation_id": "93785e85-78fb-4d6e-b1aa-28560b807a80",
                        "source_entry_id": "be2b11cf-8993-3155-af74-2ed9defd2156",
                        "source_sense_id": "7eccf873-435b-3e9e-b30a-f91046f2d7a9",
                        "target_lang_word": "concretion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concretion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c08da7b-5df7-3949-9d91-536b3ce98e9f",
                                        "entry_id": "134ddec7-3886-398f-b1e6-950b631b18c8",
                                        "glosses": [
                                            "The process of aggregating or coalescing into a mass."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b83d72f3-97c4-35ac-ad75-c7df31875a90",
                                        "entry_id": "134ddec7-3886-398f-b1e6-950b631b18c8",
                                        "glosses": [
                                            "A solid, hard mass formed by a process of aggregation or coalescence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14c2b50a-dc7d-31a1-8d85-ebe09daf9336",
                                        "entry_id": "134ddec7-3886-398f-b1e6-950b631b18c8",
                                        "glosses": [
                                            "A rounded mass of a mineral, sometimes found in sedimentary rock or on the ocean floor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291d1e4a-6e17-40bb-94f0-c91b3010877f",
                                                "sense_id": "14c2b50a-dc7d-31a1-8d85-ebe09daf9336",
                                                "text": "Of the three beds, the central one is the most compact, and more like ordinary sandstone: it includes numerous flattened spherical concretions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "822680d3-0d4e-39dc-8bb6-ef1e59e53f11",
                                        "entry_id": "134ddec7-3886-398f-b1e6-950b631b18c8",
                                        "glosses": [
                                            "The action of making something concrete or the result of such an action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c4f822-e955-4136-9eac-d41b8b5dca5c",
                                                "sense_id": "822680d3-0d4e-39dc-8bb6-ef1e59e53f11",
                                                "text": "\"My new statue!\" said Kenyon. . . . \"It is the concretion of a good deal of thought, emotion, and toil of brain and hand.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e225a4c6-008e-42dd-9e35-a9f490b42d8c",
                        "source_entry_id": "be2b11cf-8993-3155-af74-2ed9defd2156",
                        "source_sense_id": "7eccf873-435b-3e9e-b30a-f91046f2d7a9",
                        "target_lang_word": "concrétion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concrétion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48f83bd0-0a94-3ae0-a7a6-3ec77d359e37",
                                        "entry_id": "d99296a5-dd1d-3969-9017-6ef97441e06e",
                                        "glosses": [
                                            "Action de s’épaissir."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcddb097-9dd1-4f1a-b8ed-5969e20d96b2",
                                                "sense_id": "48f83bd0-0a94-3ae0-a7a6-3ec77d359e37",
                                                "text": "La concrétion du lait, de l’huile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f46c7600-66f7-390a-9621-b75b5b8dae5e",
                                        "entry_id": "d99296a5-dd1d-3969-9017-6ef97441e06e",
                                        "glosses": [
                                            "Réunion de plusieurs parties en un corps solide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9c00b28-040f-46d9-8d82-7fcb92cef0af",
                                                "sense_id": "f46c7600-66f7-390a-9621-b75b5b8dae5e",
                                                "text": "[…] c'était la multitude de pointes, de cristaux, de prismes, de polyèdres de toutes sortes qui hérissaient la surface de l'icefield, comme une concrétion de stalactites."
                                            },
                                            {
                                                "example_id": "50f0a47f-5f14-49f3-8e4e-3a98c027cc55",
                                                "sense_id": "f46c7600-66f7-390a-9621-b75b5b8dae5e",
                                                "text": "La mulette perlière était cultivée et propagée pour ses précieuses concrétions et comme aliment."
                                            },
                                            {
                                                "example_id": "8c7bc645-c38a-439e-bc08-6bb8a9cd731c",
                                                "sense_id": "f46c7600-66f7-390a-9621-b75b5b8dae5e",
                                                "text": "Les personnes qui n’ont pas l’esprit scientifique ne comprennent guère qu’on laisse ses opinions se former hors de soi par une sorte de concrétion impersonnelle, dont on n’est en quelque sorte que le spectateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fccb8e9-1b43-3db9-bc90-5d78d96a0a55",
                                        "entry_id": "d99296a5-dd1d-3969-9017-6ef97441e06e",
                                        "glosses": [
                                            "Productions qui se forment dans l’épaisseur des tissus, dans les articulations, dans les conduits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0cca437-03cb-4362-97ea-46a7c9674968",
                                                "sense_id": "6fccb8e9-1b43-3db9-bc90-5d78d96a0a55",
                                                "text": "Sylvius avait déjà fait observer que les bœufs qui, pendant l'hiver, sont affectés de concrétions biliaires, se guérissent au printemps en mangeant les feuilles et les tiges de chiendent dans les pâturages."
                                            },
                                            {
                                                "example_id": "76a7a244-cc43-4142-9251-f2d6d8c91c14",
                                                "sense_id": "6fccb8e9-1b43-3db9-bc90-5d78d96a0a55",
                                                "text": "On nomme acide oxalique celui qui est contenu dans le sel d’oseille et dans beaucoup d'autres matières végétales. On le trouve fréquemment uni à la chaux dans les composés du règne végétal, et quelquefois même dans les concrétions calculeuses des animaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e412a608-4684-4118-9f1c-8367743c79f4",
                        "source_entry_id": "be2b11cf-8993-3155-af74-2ed9defd2156",
                        "source_sense_id": "7eccf873-435b-3e9e-b30a-f91046f2d7a9",
                        "target_lang_word": "concreción",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concreción",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "455c9a8d-8084-387b-95b1-6e29e548e147",
                                        "entry_id": "4696e7f1-8bc3-3ce0-8371-d60cd233bf09",
                                        "glosses": [
                                            "Acción y efecto de precisar o concretar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71e68aa4-ac72-4c12-a435-1ff4dfc77f30",
                                                "sense_id": "455c9a8d-8084-387b-95b1-6e29e548e147",
                                                "text": "Las discrepancias surgidas entre notario y trabajador sobre la concreción horaria y la determinación de los periodos de disfrute descritos serán resueltas por la jurisdicción competente"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ece51f81-56d9-3ab0-b4c7-5b0f8c98766b",
                                        "entry_id": "4696e7f1-8bc3-3ce0-8371-d60cd233bf09",
                                        "glosses": [
                                            "Acción de agrupar partículas unidas con el fin de formar una masa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0b89ebf-f0c0-4441-8b7f-94f296c87d6b",
                                                "sense_id": "ece51f81-56d9-3ab0-b4c7-5b0f8c98766b",
                                                "text": "Mientras que en el proceso de formación no intervengan partículas coloidales, en la concreción se produce aumento en el tamaño bajo presión, conocido como presión de crecimiento"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f976448c-5d6a-390a-a242-f6cd6f6af2fe",
                                        "entry_id": "4696e7f1-8bc3-3ce0-8371-d60cd233bf09",
                                        "glosses": [
                                            "Masa resultante de la agrupación de partículas unidas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd246bc-dba8-4049-beb9-74563beb6a41",
                                                "sense_id": "f976448c-5d6a-390a-a242-f6cd6f6af2fe",
                                                "text": "La piedra, considerada como enfermedad, no es otra cosa que la concreción caliza que se forma en los riñones, en la vejiga y en al sustancia del pulmón, del hígado y del bazo de los animales"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
