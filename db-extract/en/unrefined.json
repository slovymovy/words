                        "glosses": [
                            "crude, raw or unprocessed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc091063-e541-4b10-88ca-671db3d6f7fe",
                                "sense_id": "a0d65904-7c07-32d6-a9f4-6aca1a2c7431",
                                "text": "Some journal entries maybe raw and unrefined, others inspirational and detailed, but all show the truth and unbridled passion of what it is to put in your time as a true surf-caster, and maybe you can learn something from it."
                            }
                        ]
                    },
                    {
                        "sense_id": "97388f74-0cfb-3611-a68f-d676f0b9c66a",
                        "entry_id": "8cce8122-9a72-3bf1-9a51-09af0294e20f",
                        "glosses": [
                            "lacking refinement; uncouth"
                        ],
                        "tags": [
                            "of a person"
                        ],
                        "examples": [
                            {
                                "example_id": "9ab46c95-7dd3-4ec8-9779-77db27b6fac0",
                                "sense_id": "97388f74-0cfb-3611-a68f-d676f0b9c66a",
                                "text": "Depend upon it, it is the more coarse and unrefined portion of the community who outrage the feelings of churchgoing people by Sabbath desecration."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b941ce36-edec-402f-883a-4f0f6243b3eb",
