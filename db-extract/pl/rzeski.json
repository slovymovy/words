                        "entry_id": "04d53c2e-138f-3754-9abb-7ac95d76b2e9",
                        "glosses": [
                            "związany z rzeszą, dotyczący rzeszy (np.: Rzeszy Niemieckiej lub Monarchii Austro-Węgierskiej)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ddf75d57-03fd-49b6-82a2-bea8e3e19e75",
                                "sense_id": "00ff0229-3181-3641-b956-08c04be7148e",
                                "text": "W roku 955 dnia 10 sierpnia ponieśli Węgrzy zupełną klęskę nad Lechem pod Augsburgiem. Cesarz Otton I. poraził ich na głowę, wypędził z Marchii wschodniej i postanowił roku 983 Leopolda Babenberga margrabią, gdy Burchard, wójt rzeski ratyzboński, który tę godność piastował, żyć przestał"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
