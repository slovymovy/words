                                "example_id": "f68a30e6-431c-4ce0-8803-21e41f6a5ab7",
                                "sense_id": "2f516fce-18a7-356a-a69a-3ad0015a4653",
                                "text": "Louisette Dussault, actrice québécoise."
                            },
                            {
