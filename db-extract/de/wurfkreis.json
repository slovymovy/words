                "senses": [
                    {
                        "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                        "entry_id": "430ba904-64ac-33b6-bd74-0029e3c5682e",
                        "glosses": [
                            "kreisförmige Fläche mit 2,50 m Durchmesser, die der Sportler/die Sportlerin für einen gültigen Versuch beim Abwurf/Stoß seines/ihres Geräts nicht übertreten darf"
                        ],
                        "tags": [
                            "Leichtathletik: Diskuswerfen, Kugelstoßen, Hammerwerfen"
                        ],
                        "examples": [
                            {
                                "example_id": "90aae6ab-28e8-4f2e-ab0a-0a2429bf1682",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "Der Boden eines Wurfkreises ist meist aus Beton."
                            },
                            {
                                "example_id": "b80734ac-4cb6-4a36-90ba-dcc620fc3dae",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "[Liesel Westermann:] „Der Kampfrichter neben dem Wurfkreis hob die rote Fahne als Zeichen für einen ungültigen Wurf.“"
                            },
                            {
                                "example_id": "cc0bdca3-4a54-4fb3-97a5-896f6d0b601c",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "„Verlassen die Athleten den Wurfkreis durch die vordere Hälfte während oder nach dem Versuch, gilt er als ungültig.“"
                            },
                            {
                                "example_id": "4e7effb4-47c1-4458-bcab-6b9712fe3460",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "[Diskuswurf:] „»Die Windbedingungen und der Wurfkreis waren perfekt.«“"
                            },
                            {
                                "example_id": "47764134-aa1f-431e-b925-c6d38f490b86",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "[Diskuswurf:] „Besonders gravierend wurde es während des dritten Durchgangs. Der Regen wurde so stark, dass es nicht mehr möglich war, in dem rutschigen Wurfkreis überhaupt Halt zu finden.“"
                            },
                            {
                                "example_id": "efb8c91f-d53a-4f84-af9b-8d9a3c5bf81e",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "[Diskuswurf:] „Um eine Qualifikationschance zu haben, wurde eine Wettkampfserie in Schwechat ausgeschrieben. Dort kann der Wurfkreis ideal zur Windrichtung gelegt werden. International ist so ein Vorgehen längst üblich und bei Normen von 66,00 m nicht verwunderlich.“"
                            },
                            {
                                "example_id": "56b35186-a079-42f6-8350-110ca8dc24bb",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "„Erfahrungsgemäß ist beim Hammerwerfen die Erlangung der Sicherheit im Wurfkreis ein ausschlaggebendes und erstrebenswertes Ziel.“"
                            },
                            {
                                "example_id": "e2e40d5f-84cf-4a63-b315-ca7dedf6cbd1",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "„Sie betrat den Wurfkreis des Olympiastadions, hob den Hammer, brachte ihn über die linke Schulter hinweg in Schwung, ließ ihn kreisen, drehte sich ein-, zwei-, drei-, vier-, fünfmal und schleuderte die eiserne Kugel mit aller Kraft, die in ihr steckte, von sich weg.“"
                            },
                            {
                                "example_id": "9ab2eaca-9032-47fb-82b0-e6a5ae4f02ef",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "[Hammerwerfen:] „Im Wurfkreis steigerten sie die Abwurfgeschwindigkeit über 100 km/h. Dabei zerrt an ihren Armen eine Zugkraft von etwa sieben Zentnern.“"
                            },
                            {
                                "example_id": "d867fb96-495d-4fff-afbe-09621c11601e",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "„Ilke Wyludda war alleine im Diskusring, 80.000 Menschen jubelten ihr zu. Eine Übung, die sie schon tausend Mal vollführt hat - allerdings stand diesmal in der Mitte des Wurfkreises ein Hocker.“"
                            },
                            {
                                "example_id": "3bb4c2ad-7914-4dbf-9a6e-078013bf9a14",
                                "sense_id": "84a7b942-4151-31b2-a0b0-c0f027c1274e",
                                "text": "[Diskuswurf:] „Anders als bei seinem großen Durchbruch 2009, beim WM-Heimsieg in Berlin, geht Harting mit gemischten Gefühlen aus dem 2,5 Meter breiten Wurfkreis, der bis jetzt sein Leben bestimmte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                        "entry_id": "430ba904-64ac-33b6-bd74-0029e3c5682e",
                        "glosses": [
                            "Fläche im Halbkreis um das Tor, die weder Verteidiger noch Angreifer betreten dürfen"
                        ],
                        "tags": [
                            "Handball"
                        ],
                        "examples": [
                            {
                                "example_id": "3597bd80-e482-40dd-abc2-1f1ea6d2a18a",
                                "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                                "text": "Beim Kempa-Trick wird der Ball über den Wurfkreis geworfen, dort in der Luft vom Angreifer gefangen und vor dem Aufkommen aufs Tor geworfen."
                            },
                            {
                                "example_id": "b1fd8bdd-8cb7-47b8-a479-137e27449651",
                                "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                                "text": "„»Ein Anspieler hebt den Ball über die Abwehr, sein Mitspieler springt möglichst hoch in den Wurfkreis, fängt den Ball noch im Flug und wirft ein Tor.« – Bernhard Kempa“"
                            },
                            {
                                "example_id": "8d208b0b-cb2e-4c7a-92d5-e5996a9b54cd",
                                "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                                "text": "Durch einen Absprung vom Wurfkreis verkürzt man die Entfernung zum Tor und erhöht die Chancen für einen erfolgreichen Torwurf."
                            },
                            {
                                "example_id": "709690d1-4bf7-489a-9782-1385d48215f4",
                                "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                                "text": "„Bei einer \"6-0-Abwehr\" stehen die sechs Abwehrspieler in der Ausgangsposition mit den Fersen am eigenen Wurfkreis.“"
                            },
                            {
                                "example_id": "cdbacb01-2fc5-4e92-b7f6-767843d1950e",
                                "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                                "text": "„Die Verteidiger (Abwehrspieler) bilden aufgrund der Topographie des Spielfelds in der Regel eine Zonendeckung vor dem Wurfkreis.“"
                            },
                            {
                                "example_id": "d802a02d-21b7-4199-85f0-deed7c79a122",
                                "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                                "text": "„Die zwei gebräuchlichsten Deckungsvarianten sind 6–0 (die Grundposition aller Spieler ist direkt am Wurfkreis) und 5–1 (der mittlere Abwehrspieler ist vorgezogen).“"
                            },
                            {
                                "example_id": "be275c86-d7a5-468c-acde-06884368f47d",
                                "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                                "text": "„Nimm einen Handball und laufe damit zum Wurfkreis. Suche dir eine Ecke des Tores aus und wirf!“"
                            },
                            {
                                "example_id": "79a46c90-adbc-4146-bde1-0fc5a4107c3a",
                                "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                                "text": "„Am Wurfkreis mündet Hallenhandball allzuoft in »vorsätzliche Körperverletzung«, wie Altnationalspieler Hans-Günther Schmidt feststellte.“"
                            },
                            {
                                "example_id": "61654c2a-ab64-42f2-b6bf-5405b9ec5869",
                                "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                                "text": "„Die sogenannten Kreisläufer gehören zur Angriffstaktik. Sie wühlen sich wie Rammböcke in die gegnerische Abwehrkette vor dem Wurfkreis.“"
                            },
                            {
                                "example_id": "a6e3a3df-3e9e-43c3-9662-9dda549fcdea",
                                "sense_id": "633362f0-30d6-3178-9439-62c8f4f3990c",
                                "text": "„Riesner stellt immer wieder seine Durchsetzungsfähigkeit im Gedränge am Wurfkreis unter Beweis. Reaktionsschnell dreht und wendet er sich und schafft es, sich aus den Zugriffen der Gegner zu befreien.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
