                "senses": [
                    {
                        "sense_id": "5b923019-227f-36ee-8190-b2ef216bb51d",
                        "entry_id": "33848777-ee35-3a8f-b84c-94718c5be53f",
                        "glosses": [
                            "Atom des chemischen Elements Krypton"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "a6c8bb06-b0e0-4de0-a3c8-049906a09964",
                                "sense_id": "5b923019-227f-36ee-8190-b2ef216bb51d",
                                "text": "„Daher spürt ein Kryptonatom auf einer Trajektorie, die am Rand des Spalts verläuft, eine Kraft, die es um einen großen Winkel ablenkt oder es gegen das Gitter prallen lässt.“"
                            },
                            {
                                "example_id": "5f826dd9-23dd-4586-82a0-d734b9eaaa3a",
                                "sense_id": "5b923019-227f-36ee-8190-b2ef216bb51d",
                                "text": "„Andererseits weist die Proportionalität der Atomkonzentration mit α (1–α) darauf hin, daß an der Atombildungsreaktion sowohl ein Kryptonatom als auch ein Stickstoffmolekül teilnehmen.“"
                            },
                            {
                                "example_id": "404b3360-0b2d-4faa-995e-3d8a3ebb0e47",
                                "sense_id": "5b923019-227f-36ee-8190-b2ef216bb51d",
                                "text": "„Am Schluss befindet sich höchsteins ein Kryptonatom unter zehn Billionen Xenonatomen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
