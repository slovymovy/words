                        "cross_references": []
                    },
                    {
                        "translation_id": "42f0b43a-a526-46bb-b435-e40043cc1832",
                        "source_entry_id": "928b4c32-d9c4-3a4a-beea-414d04fc9757",
                        "source_sense_id": "814f41ed-b135-394d-9592-fba73f5086da",
                        "target_lang_word": "strillare",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strillare",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "53591bfa-aa3d-34ec-8be5-078e548ad74f",
                                        "entry_id": "3b69a101-46b3-318c-a5ae-c2458f359541",
                                        "glosses": [
                                            "dire qualcosa colla massima potenza della voce oppure emissione di un suono della voce pressoché acutissimo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c59aaade-afee-4a72-90a4-c2395762c1e3",
                                                "sense_id": "53591bfa-aa3d-34ec-8be5-078e548ad74f",
                                                "text": "Così il giovane ragazzo alla madre troppo apprensiva: \"Ok, va bene... basta: domani riprendo il lavoro. Non strillarmi così però\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "854c725b-ec62-32f8-8487-e33c36ecda24",
                                        "entry_id": "3b69a101-46b3-318c-a5ae-c2458f359541",
                                        "glosses": [
                                            "parlare con voce tonante ma fastidiosa, quasi a rimprovero... apparente ed inutile"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df58f27-6732-4a63-882f-74932d8004ba",
                                                "sense_id": "854c725b-ec62-32f8-8487-e33c36ecda24",
                                                "text": "\"Ma cosa ti strilli?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce563a01-10ba-3351-b146-0c741e13f2eb",
                                        "entry_id": "3b69a101-46b3-318c-a5ae-c2458f359541",
                                        "glosses": [
                                            "emettere un urlo acutissimo, in genere tipico delle donne in varie situazioni, non sempre necessariamente di pericolo"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04eeff9a-fab2-4c68-8f92-23b19928044b",
                                                "sense_id": "ce563a01-10ba-3351-b146-0c741e13f2eb",
                                                "text": "Disse il padre agitato ma con fermezza: \"Smetti subito di strillare!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cacead3a-9ad9-3141-9cea-9923e4cb8165",
                                        "entry_id": "3b69a101-46b3-318c-a5ae-c2458f359541",
                                        "glosses": [
                                            "piangere in modo estremamente disperato, fenomeno presente soprattutto nei bambini ancora piccoli"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcb335bf-a7d3-452d-a255-1ae030373eee",
                                                "sense_id": "cacead3a-9ad9-3141-9cea-9923e4cb8165",
                                                "text": "aveva una terribile otite e strillava, inizialmente senza che se ne capisse la ragione"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b79c68-6c50-3b18-8b93-daeac0c1ab67",
                                        "entry_id": "3b69a101-46b3-318c-a5ae-c2458f359541",
                                        "glosses": [
                                            "stonare alla grande, addirittura con \\\"sgradito rigurgito\\\" in semi-falsetto appunto non cercato né voluto"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b1e395a-f1e1-413e-9168-74747f9dd6f9",
                                                "sense_id": "72b79c68-6c50-3b18-8b93-daeac0c1ab67",
                                                "text": "quello strilla peggio di una cornacchia..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c838ae9a-ce2f-335b-9cf3-581b6dabd534",
                                        "entry_id": "3b69a101-46b3-318c-a5ae-c2458f359541",
                                        "glosses": [
                                            "parlare concitatamente ed in modo isterico, talvolta con movimenti nervosi ed agitati del corpo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5990ab26-fe1e-4ca2-93cb-519490821deb",
                                                "sense_id": "c838ae9a-ce2f-335b-9cf3-581b6dabd534",
                                                "text": "\"Smania, strilla... ed ha già oltrepassato il limite della decenza\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
