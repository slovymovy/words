                    {
                        "sense_id": "7fb5505a-372b-3b03-9056-cfd5e08dea26",
                        "entry_id": "ca29bdb1-3cc4-3c3e-b491-672777f7c192",
                        "glosses": [
                            "sneetje brood"
                        ],
                        "tags": [
                            "kindertaal"
                        ],
                        "examples": [
                            {
                                "example_id": "4641e3fa-12f0-45ba-bedb-bd3a2fbdcd00",
                                "sense_id": "7fb5505a-372b-3b03-9056-cfd5e08dea26",
                                "text": "Mam, mag ik nog een bo?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a69f93b-204a-4514-a33c-4855da5c156e",
                        "source_entry_id": "ca29bdb1-3cc4-3c3e-b491-672777f7c192",
                        "source_sense_id": "7fb5505a-372b-3b03-9056-cfd5e08dea26",
                        "source_sense_description": "sneetje brood",
                        "target_lang_word": "Butterbrot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Butterbrot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd8f68e-555f-39c2-bd75-09282d9f8232",
                                        "entry_id": "117e89f6-e263-30c9-ba1f-794b0b6ee527",
                                        "glosses": [
                                            "eine Scheibe Brot, die (unter anderem) mit einer Schicht Butter (oder auch Margarine) bestrichen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1c95ba-96ec-43d2-a446-174631639b0e",
                                                "sense_id": "2fd8f68e-555f-39c2-bd75-09282d9f8232",
                                                "text": "Vergiss dein Butterbrot nicht, wenn du zur Schule gehst."
                                            },
                                            {
                                                "example_id": "0bdcbbdc-cbbf-40ff-b687-b8ca64a9af34",
                                                "sense_id": "2fd8f68e-555f-39c2-bd75-09282d9f8232",
                                                "text": "„Zu Hause lag ein Butterbrot auf dem Brettchen für mich auf dem Tisch.“"
                                            },
                                            {
                                                "example_id": "99fa8ba2-6dad-4077-9c21-ceef2ae26b10",
                                                "sense_id": "2fd8f68e-555f-39c2-bd75-09282d9f8232",
                                                "text": "„Kritiker verweisen darauf, dass Medikamente gezielt und nicht unbewusst mit dem täglichen »Butterbrot« eingenommen werden sollten.“"
                                            },
                                            {
                                                "example_id": "c8f88fbe-1d92-4513-859a-148d6019e1cd",
                                                "sense_id": "2fd8f68e-555f-39c2-bd75-09282d9f8232",
                                                "text": "„Unter der Woche war es während der Frühstückszeit ruhig; es war nie sehr voll und die meisten aßen nur ein Butterbrot und tranken heiße Schokolade.“"
                                            },
                                            {
                                                "example_id": "30ead30c-9c03-408b-882c-d18734e1db8d",
                                                "sense_id": "2fd8f68e-555f-39c2-bd75-09282d9f8232",
                                                "text": "„Elsa sitzt, die Hände mit dem Butterbrot im Schoß, ganz still da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc5fd419-4717-42fc-836d-a3b04122b6be",
                        "source_entry_id": "ca29bdb1-3cc4-3c3e-b491-672777f7c192",
                        "source_sense_id": "7fb5505a-372b-3b03-9056-cfd5e08dea26",
