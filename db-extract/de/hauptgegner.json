                "senses": [
                    {
                        "sense_id": "42eb4817-3128-37ed-a7dc-6f1e83215b58",
                        "entry_id": "db3def1d-9d9a-3d05-bf47-b90beb30a40d",
                        "glosses": [
                            "größter Gegner/Konkurrent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c416c92c-ae92-4bc5-99d1-1b33ec7f1139",
                                "sense_id": "42eb4817-3128-37ed-a7dc-6f1e83215b58",
                                "text": "„Hauptgegner der Uskoken waren die Osmanen, deren Schiffe, geführt von muslimischen oder christlichen Untertanen, zu Friedenszeiten in großer Zahl nach Venedig segelten.“"
                            },
                            {
                                "example_id": "70e661e8-df25-49aa-ab0c-07cc28579ba6",
                                "sense_id": "42eb4817-3128-37ed-a7dc-6f1e83215b58",
                                "text": "„Ihren Hauptgegner sah die osteuropäische Haskala im Chassidismus, der für die Maskilim den Inbegriff von Aberglauben, Irrationalität, Unbildung und religiösem Fanatismus darstellte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
