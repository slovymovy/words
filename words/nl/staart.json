                },
                {
                    "sense_id": "21ef8deb-98f8-3116-8868-a54406c03200",
                    "sense_definition": "de gebiedende wijs (meervoud) van <w>staren</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Staart</w> niet zo naar die mensen, dat is onbeleefd!",
                            "target_lang_translations": {
                                "en": "Don't <w>stare</w> at those people like that, it's rude!"
                            }
                        },
                        {
                            "text": "Kom op jongens, <w>staart</w> niet naar je telefoon maar let op de weg.",
                            "target_lang_translations": {
                                "en": "Come on guys, don't <w>stare</w> at your phone but watch the road."
                            }
                        }
                    ],
