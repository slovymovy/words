                    "examples": [
                        {
                            "text": "Mr. <w>Bun</w> moved from Cambodia to the United States in the nineties.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бун</w> переехал из Камбоджи в США в девяностых."
                            }
