                    },
                    {
                        "form_id": "1aa475c5-3860-431e-8461-56fbccf0a987",
                        "entry_id": "f4a44898-6071-374a-8b4e-1b64cada1872",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Anbeter"
                    },
                    {
                        "form_id": "094d1760-143b-4c00-a0f8-f984b7cbc3a0",
                        "entry_id": "f4a44898-6071-374a-8b4e-1b64cada1872",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Anbeter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e9698ba-a6d5-3ae3-9990-fbe087d4cb00",
                        "entry_id": "f4a44898-6071-374a-8b4e-1b64cada1872",
                        "glosses": [
                            "Person, die eine Sache, eine Person oder ein göttliches Wesen anbetet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "248c0454-f562-40fd-83db-eb8ffde1ad0c",
                                "sense_id": "6e9698ba-a6d5-3ae3-9990-fbe087d4cb00",
                                "text": "„Gehen wir voran mit Christus und leben wir unser Leben als wirkliche Anbeter Gottes. Amen.“"
                            },
                            {
                                "example_id": "baff0706-59a1-4b8e-ab3e-97d47b4ece28",
                                "sense_id": "6e9698ba-a6d5-3ae3-9990-fbe087d4cb00",
                                "text": "„Sie sind die Anbeter der Äußerlichkeiten, die den Juden vergangener Tage ähnlich geworden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfbf8ca6-8e47-31e8-a937-fc450cb478e4",
                        "entry_id": "f4a44898-6071-374a-8b4e-1b64cada1872",
                        "glosses": [
                            "Person, die einen Star oder eine andere Person des öffentlichen Leben hoch verehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48de8af1-3b2c-4e74-8397-badb26091a12",
                                "sense_id": "cfbf8ca6-8e47-31e8-a937-fc450cb478e4",
                                "text": "„Ein Star mag seine Fans bezirzen, der Diva liegen Anbeter zu Füssen.“"
                            },
                            {
                                "example_id": "52e88157-0a86-4c0f-b3ce-686eb1fe9160",
                                "sense_id": "cfbf8ca6-8e47-31e8-a937-fc450cb478e4",
                                "text": "„Einer der Leute sagte, dass der Stein bei der letzten Ziehung richtig lag, als er einigen seiner Anbeter die 12 verriet, die dann tatsächlich gewann.“"
                            },
                            {
                                "example_id": "0e31fff1-9471-471c-a9bb-c48d3407711f",
                                "sense_id": "cfbf8ca6-8e47-31e8-a937-fc450cb478e4",
                                "text": "„Julie wartete schon seit langem auf einen Antrag ihres melancholischen Anbeters und war bereit, ihn anzunehmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8563b820-01b6-4598-9a5a-d1270a400ad8",
                        "source_entry_id": "f4a44898-6071-374a-8b4e-1b64cada1872",
                        "source_sense_id": "6e9698ba-a6d5-3ae3-9990-fbe087d4cb00",
                        "source_sense_description": "Religion: Person, die eine Sache, eine Person oder ein göttliches Wesen anbetet",
                        "target_lang_word": "adorer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adorer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "317c0b3a-88ca-3ce9-a0b2-d51116e09b9f",
                                        "entry_id": "5751aa61-8f07-3129-8b39-9fa6f528b2d1",
                                        "glosses": [
                                            "Someone who adores.",
                                            "Someone who worships."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fef78134-be2e-4fdf-bba7-b03bb829b77c",
                                                "sense_id": "317c0b3a-88ca-3ce9-a0b2-d51116e09b9f",
                                                "text": "1582, Gregory Martin (translator), The New Testament of Jesus Christ, Translated Faithfully into English, Reims: John Fogny, John 4.23, p. 226,\nBut the houre commeth, and now it is, when the true adorers shal adore the Father in spirit and veritie."
                                            },
                                            {
                                                "example_id": "432e7344-67e5-46da-aead-a6cc45cdf17a",
                                                "sense_id": "317c0b3a-88ca-3ce9-a0b2-d51116e09b9f",
                                                "text": "[…] I in one Night freed / From servitude inglorious welnigh half / Th’ Angelic Name, and thinner left the throng / Of his adorers […]"
                                            },
                                            {
                                                "example_id": "f3fbab3a-32c6-4e0b-a1ed-3918c002d553",
                                                "sense_id": "317c0b3a-88ca-3ce9-a0b2-d51116e09b9f",
                                                "text": "All men in the outset of the religion they profess are adorers of a God, and friends of man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "269549fc-e6da-345f-ba9e-6ae6ecb7a348",
                                        "entry_id": "5751aa61-8f07-3129-8b39-9fa6f528b2d1",
                                        "glosses": [
                                            "Someone who adores.",
                                            "Someone who has a deep admiration, fondness or love (of someone or something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c0319d-7b31-4adc-894a-e7d8e81a6ccf",
                                                "sense_id": "269549fc-e6da-345f-ba9e-6ae6ecb7a348",
                                                "text": "[…] I profess myself her adorer, not her friend."
                                            },
                                            {
                                                "example_id": "05bae697-295e-446d-92bd-f27d69e2a30a",
                                                "sense_id": "269549fc-e6da-345f-ba9e-6ae6ecb7a348",
                                                "text": "I vvho profeſs my ſelf an Admirer, an Adorer of Reaſon, am obliged to ovvn, that in ſome Caſes the Sharpneſs of Ridicule can do more than the Strength of Argument."
                                            },
                                            {
                                                "example_id": "75ee864a-46fe-4722-94f2-716bcf957242",
                                                "sense_id": "269549fc-e6da-345f-ba9e-6ae6ecb7a348",
                                                "text": "When rival adorers come courting a maid, / There’s something or other may often be said, / Why he should be pitched upon rather than him. / This wasn’t the case with Old Paul and Old Tim."
                                            },
                                            {
                                                "example_id": "a135d703-e54f-47a4-8d40-56d44325e832",
                                                "sense_id": "269549fc-e6da-345f-ba9e-6ae6ecb7a348",
                                                "text": "The funny thing was that all the envelopes were addressed in the same hand, in green or sometimes purple capitals. It was like one crazed adorer laying siege to Leo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
