                "senses": [
                    {
                        "sense_id": "c66e9626-fb84-3210-8801-d4c28ef0c5f2",
                        "entry_id": "5e4f678f-176c-3ac4-b79b-4e743a75c2c7",
                        "glosses": [
                            "Behälter für Auftaumittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae1130fb-b159-4ffb-b82a-97fd4f80b070",
                                "sense_id": "c66e9626-fb84-3210-8801-d4c28ef0c5f2",
                                "text": "„Die Kinder der Grundschule haben gemeinsam mit Jugendlichen der Produktionsschule »Plan B« den alten Streusalzcontainer auf dem Schulgelände entrostet und mit viel Liebe fürs Detail mit einer blühenden Wiese, Schmetterlingen und fußballspielenden Kindern bemalt.“"
                            },
                            {
                                "example_id": "c9367e6d-b7de-49fa-b280-1827bbdfbbfe",
                                "sense_id": "c66e9626-fb84-3210-8801-d4c28ef0c5f2",
                                "text": "„Ein 69 Jahre alter Pensionist ist am Montagnachmittag auf der Gailtal Bundesstraße mit seinem Wagen gegen einen Streusalzcontainer geprallt.“"
                            },
                            {
                                "example_id": "17e3a6bb-0777-45c0-bc65-a5fb96e0ba7d",
                                "sense_id": "c66e9626-fb84-3210-8801-d4c28ef0c5f2",
                                "text": "„ Der Pensionist war mit seinen beiden Enkerln (ein und sechs Jahre alt) unterwegs, als er mit seinem Wagen von der Fahrbahn abkam und gegen einen Streusalzcontainer stieß.“"
                            },
                            {
                                "example_id": "fd606210-8a07-4ce3-9cc0-afb34ba839d8",
                                "sense_id": "c66e9626-fb84-3210-8801-d4c28ef0c5f2",
                                "text": "„Ortschaftsrätin Kammer merkte an, dass der versprochene Streusalzcontainer im Neubaugebiet Sauberg noch nicht aufgestellt sei.“"
                            },
                            {
                                "example_id": "4ce1437b-413a-4a9e-8cd7-f0f16cce217a",
                                "sense_id": "c66e9626-fb84-3210-8801-d4c28ef0c5f2",
                                "text": "„Das Feuer geht auf einen Streusalzcontainer über.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
