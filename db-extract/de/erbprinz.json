                        "glosses": [
                            "derjenige männliche Nachkomme eines Herrschers, der dessen Thron- beziehungsweise Rechtsnachfolge antreten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97fe9f13-70f0-40c2-a55a-9a74802d1a99",
                                "sense_id": "e6a4ac0e-f0ad-3a7a-9e0b-985280ea6641",
                                "text": "„Im August 1804 fand die Hochzeit der Zarentochter Maria Pawlowna mit dem Erbprinzen Carl Friedrich statt, auf 79 Pferdewagen fuhr die Mitgift dem jungen Paar nach Weimar voraus.“"
                            },
                            {
                                "example_id": "cb6620ae-0b1a-4b8c-b95b-c7d1856afd2a",
                                "sense_id": "e6a4ac0e-f0ad-3a7a-9e0b-985280ea6641",
                                "text": "„Irgendwann Mitte des 16. Jahrhunderts begann Erbprinz Wilhelm von Hessen damit, nächtelang in den Himmel zu starren – sehr zum Missfallen seines Vaters.“"
                            }
                        ],
