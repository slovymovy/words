                "senses": [
                    {
                        "sense_id": "497fe689-1105-36e4-b860-07571dc55767",
                        "entry_id": "51000fbb-2a62-375b-8235-dca1b2619862",
                        "glosses": [
                            "tak, że ktoś lub coś żyje podczas pewnej czynności, której jest obiektem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "938d4bf5-e241-4580-bc2a-d83be61fc539",
                                "sense_id": "497fe689-1105-36e4-b860-07571dc55767",
                                "text": "Mateo i towarzysze bronili się zaciekle i długo, widocznie wróg chciał ich pojmać żywcem, i zanim ulegli przemocy, reszta grupy mogła daleko rozproszyć się po lesie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4a12e7f6-7acb-3949-908c-29cb69c4ffa8",
                        "entry_id": "51000fbb-2a62-375b-8235-dca1b2619862",
                        "glosses": [
                            "tak, że coś jest identyczne z oryginałem"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "3014fdf7-0c27-4157-91de-337409656f57",
                                "sense_id": "4a12e7f6-7acb-3949-908c-29cb69c4ffa8",
                                "text": "Wszystko to wygląda malowniczo i groźnie, jakby żywcem wzięte z amerykańskich filmów o wojnie wietnamskiej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37550665-0970-4c6a-8184-14a524decc61",
                        "source_entry_id": "51000fbb-2a62-375b-8235-dca1b2619862",
                        "source_sense_id": "497fe689-1105-36e4-b860-07571dc55767",
                        "target_lang_word": "alive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e6e052b-8927-398d-aff2-902f67544093",
                                        "entry_id": "b8557129-b3f3-3285-a72c-71c9a24d9c94",
                                        "glosses": [
                                            "Having life; living; not dead."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "749043e6-418d-44bc-9a60-c770a93d53f8",
                                                "sense_id": "8e6e052b-8927-398d-aff2-902f67544093",
                                                "text": "As long as the plant is alive, he will continue to water it."
                                            },
                                            {
                                                "example_id": "aa1db6c5-ace5-4d4f-92b8-256bf4890f73",
                                                "sense_id": "8e6e052b-8927-398d-aff2-902f67544093",
                                                "text": "I am hee that liueth, and was dead : and behold, I am aliue foꝛ euermoꝛe,Amen,and haue the keyes of hell and of death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f4fc800-76b3-3b32-a321-1e41c2ce5a11",
                                        "entry_id": "b8557129-b3f3-3285-a72c-71c9a24d9c94",
                                        "glosses": [
                                            "In a state of action; in force or operation; existent."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dced5921-c339-4a78-aa70-b2c375df546f",
                                                "sense_id": "1f4fc800-76b3-3b32-a321-1e41c2ce5a11",
                                                "text": "to keep the fire alive"
                                            },
                                            {
                                                "example_id": "d14ed231-6057-4952-aab7-f71a7254ea28",
                                                "sense_id": "1f4fc800-76b3-3b32-a321-1e41c2ce5a11",
                                                "text": "to keep the affections alive"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ba000fc-589f-3fe8-9b46-cf505d1da10f",
                                        "entry_id": "b8557129-b3f3-3285-a72c-71c9a24d9c94",
                                        "glosses": [
                                            "Busy with activity of many living beings; swarming; thronged; busy."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6de1fa84-0221-430a-96dc-0722d86b0b29",
                                                "sense_id": "0ba000fc-589f-3fe8-9b46-cf505d1da10f",
                                                "text": "Although quite dull during the day, the main street comes alive at night, with many bars and clubs opening."
                                            },
                                            {
                                                "example_id": "76fd3326-671e-4cd1-b623-56e0b5a97481",
                                                "sense_id": "0ba000fc-589f-3fe8-9b46-cf505d1da10f",
                                                "text": "The Boyne, for a quarter of a mile, was alive with muskets and green boughs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "021363c4-fdf2-380b-9301-627c71107837",
                                        "entry_id": "b8557129-b3f3-3285-a72c-71c9a24d9c94",
                                        "glosses": [
                                            "Carrying electrical current; energized."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e1137e0-3051-45ed-a3d8-b961410dd487",
                                                "sense_id": "021363c4-fdf2-380b-9301-627c71107837",
                                                "text": "DANGER: OVERHEAD CATENARY—WIRE IS ALIVE"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c332de17-0a20-3788-8ef8-d80739daf168",
                                        "entry_id": "b8557129-b3f3-3285-a72c-71c9a24d9c94",
                                        "glosses": [
                                            "Aware of; sensitive to."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11392cc0-fbd4-4161-be7d-f578fd9fd608",
                                                "sense_id": "c332de17-0a20-3788-8ef8-d80739daf168",
                                                "text": "We are alive to the ongoing potential for terrorist attacks."
                                            },
                                            {
                                                "example_id": "80bb6c6b-6b5c-4593-9482-6c383bc4cd28",
                                                "sense_id": "c332de17-0a20-3788-8ef8-d80739daf168",
                                                "text": "We may be sure that the Church would be alive to the dangers of allowing the plays to be performed outside the sacred edifice."
                                            },
                                            {
                                                "example_id": "4eee6ec4-3912-4b6f-9271-aa9e4d729aee",
                                                "sense_id": "c332de17-0a20-3788-8ef8-d80739daf168",
                                                "text": "Like many producers, she [Shonda Rhimes] is also alive to concerns over how AI tools will feed into the process of making TV."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eee9b3d-0bbb-33b1-8f61-68f81ba84b5e",
                                        "entry_id": "b8557129-b3f3-3285-a72c-71c9a24d9c94",
                                        "glosses": [
                                            "Sprightly; lively; brisk."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6632f9cd-bbaf-4fef-83f2-5fd9e02f6c12",
                                                "sense_id": "0eee9b3d-0bbb-33b1-8f61-68f81ba84b5e",
                                                "text": "Smouch, requesting Mr. Pickwick in a surly manner ‘to be as alive as he could, for it was a busy time,’ drew up a chair by the door and sat there, until he had finished dressing."
                                            },
                                            {
                                                "example_id": "632690e2-a631-484b-81a4-b579a54f1c6f",
                                                "sense_id": "0eee9b3d-0bbb-33b1-8f61-68f81ba84b5e",
                                                "text": "Liverpool’s equaliser came within four minutes. James Milner swung the ball over from a corner on the right and Sadio Mané, Liverpool’s most dangerous player, was alive in the six-yard area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b20135b1-bc6d-3169-832b-cba3ac2b79dc",
                                        "entry_id": "b8557129-b3f3-3285-a72c-71c9a24d9c94",
                                        "glosses": [
                                            "Susceptible, sensitive; easy to impress; having keen feelings, as opposed to apathy."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2920280c-6506-4973-b446-2655182a7bdf",
                                                "sense_id": "b20135b1-bc6d-3169-832b-cba3ac2b79dc",
                                                "text": "Though tremblingly alive to Nature's laws, Yet ever firm to Honour's sacred cause"
                                            },
                                            {
                                                "example_id": "dcc9c670-2436-4043-a596-7155ccb3a40d",
                                                "sense_id": "b20135b1-bc6d-3169-832b-cba3ac2b79dc",
                                                "text": "This was a reproach to John, and a slur upon the dog; and both were alive to their misfortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "457ab050-2f81-3fae-aa6b-9c613d745120",
                                        "entry_id": "b8557129-b3f3-3285-a72c-71c9a24d9c94",
                                        "glosses": [
                                            "Out of all living creatures."
                                        ],
                                        "tags": [
                                            "emphatic",
                                            "intensifier",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd9dbf21-bc91-44d7-af25-d25867850445",
                                                "sense_id": "457ab050-2f81-3fae-aa6b-9c613d745120",
                                                "text": "The Whitest Boy Alive"
                                            },
                                            {
                                                "example_id": "7ea03d03-6e33-45e8-ab98-db9b6b476fcf",
                                                "sense_id": "457ab050-2f81-3fae-aa6b-9c613d745120",
                                                "text": "The Earl of Northumberland 'was the proudest man alive' and 'was in all his deportment a very great man."
                                            },
                                            {
                                                "example_id": "64752126-dedb-415e-8489-05c8450cf362",
                                                "sense_id": "457ab050-2f81-3fae-aa6b-9c613d745120",
                                                "text": "I'm the toughest girl alive / I walked through the fire and I survived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32041ab7-daf8-3eb9-9d79-34658637c919",
                                        "entry_id": "b8557129-b3f3-3285-a72c-71c9a24d9c94",
                                        "glosses": [
                                            "Synonym of live."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
