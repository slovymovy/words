        "nl-extract.jsonl": [
            {
                "entry_id": "624434f3-ea89-309f-8b4f-5b4ef595bfb8",
                "word": "afhameren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e9c0b394-e1c9-3250-b85b-8b464577ee23",
                        "entry_id": "624434f3-ea89-309f-8b4f-5b4ef595bfb8",
                        "glosses": [
                            "door een slag met een hamer aangeven dat er een beslissing is genomen (met name tijdens een veiling dat de koop voor een bepaald bedrag is gesloten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaadb85e-51f5-4e8d-9ac0-5e80639a0c99",
                                "sense_id": "e9c0b394-e1c9-3250-b85b-8b464577ee23",
                                "text": "Crisis of niet. Het vat met Hollandse Nieuwe leverde donderdagavond bij de Almelose haringparty 4400 euro op. Veilingmeester Menno Knip kon het bedrag afhameren, nadat de drie gebroers Huzink tegen elkaar opboden."
                            },
                            {
                                "example_id": "b672dfd1-e489-4b59-9767-5f95de41d31a",
                                "sense_id": "e9c0b394-e1c9-3250-b85b-8b464577ee23",
                                "text": "De opbrengst overtrof de verwachtingen fors: naar schatting zou het werk vijf tot zeven miljoen dollar opleveren. De duurste foto tot nu toe was Rhein II, een foto van de Duitse Andreas Gursky die in 2011 voor 4,3 miljoen dollar werd afgehamerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b01748b-c27b-3c0c-9cf2-6e2ea7fa7e85",
                        "entry_id": "624434f3-ea89-309f-8b4f-5b4ef595bfb8",
                        "glosses": [
                            "iets afsluiten door een beslissing te nemen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d9135349-63b1-4405-9b44-73ce783adaaf",
                                "sense_id": "7b01748b-c27b-3c0c-9cf2-6e2ea7fa7e85",
                                "text": "'Zo'n premier heeft eigenlijk niks te doen', vertelde Zalm, nu demissionair vice-premier en minister van financiën, later met een knipoog. 'Wij ministers maken de dossiers, de minister-president hoeft alleen maar af te wachten totdat hij vrijdag in de ministerraad alles kan afhameren. De rest van de week heeft hij het eigenlijk niet zo geweldig druk.'"
                            },
                            {
                                "example_id": "45e094ed-fe7c-4fc2-a011-40e461c86320",
                                "sense_id": "7b01748b-c27b-3c0c-9cf2-6e2ea7fa7e85",
                                "text": "De voorzitter kon de bijeenkomst om even voor 03.00 uur afhameren. In totaal was er 18 uur vergaderd. 'Er wordt nu zelfs op slaap bezuinigd', knorde Elbert Dijkgraaf van de SGP. 'Halen we voor 03.00 vannacht de stemming, of is de wereld tegen die tijd al vergaan?' vroeg Henk Krol van 50Plus zich eerder vertwijfeld af."
                            }
                        ]
                    }
                ],
