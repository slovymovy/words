                    {
                        "sense_id": "b6c013a4-46dc-3cb2-b27c-392bc3c1bb30",
                        "entry_id": "d9149a10-f89e-3ca1-be8a-00936ea1c810",
                        "glosses": [
                            "kurzzeitige Arbeit für Schüler und Studenten während der Ferien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "add08b72-d945-4257-a420-7653a98ba514",
                                "sense_id": "b6c013a4-46dc-3cb2-b27c-392bc3c1bb30",
                                "text": "„Maternus lehnte mein Ersuchen um Ferienarbeit ab, ein Formbrief, derzeit kein Bedarf, gern könne ich zu einem späteren Zeitpunkt noch einmal anfragen.“"
                            },
                            {
                                "example_id": "089c70d0-41a7-4721-a72c-e61946851f65",
                                "sense_id": "b6c013a4-46dc-3cb2-b27c-392bc3c1bb30",
                                "text": "„Im Sommer hatte sie in der Ferienarbeit bei der Gemeinde gearbeitet und den gesamten Lohn auf ein Sparkonto gelegt, um irgendwann genug für die Kamera ihrer Träume zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
