                            },
                            {
                                "target_lang_word": "yelkencilik",
                                "target_lang_sense_clarification": "tekne kullanma sanatı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "航海术",
                                "target_lang_sense_clarification": "指专业技能"
                            },
                            {
                                "target_lang_word": "操船技术",
                                "target_lang_sense_clarification": "指驾驶船只的能力"
                            }
                        ]
                    }
