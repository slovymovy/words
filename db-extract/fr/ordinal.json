                    }
                ],
                "senses": [
                    {
                        "sense_id": "5628c2fb-a2e7-3e3b-aea9-b0a12da812d9",
                        "entry_id": "7147ea67-05be-393c-afe9-cecbf3422b89",
                        "glosses": [
                            "Se dit en général d'un nombre lorsqu'il ne sert qu'à indiquer une position ou un rang, dans une série."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "604f5498-83e9-47c6-a848-bd2925c102d0",
                                "sense_id": "5628c2fb-a2e7-3e3b-aea9-b0a12da812d9",
                                "text": "Dans la suite notée x(n), des nombres calculés en fonction de la suite des nombres entiers représentée par n, n est considéré comme ordinal, il permet seulement de ranger les termes de la suite."
                            },
                            {
                                "example_id": "4ee12bfd-d89a-4c6a-874c-fae4e24a428e",
                                "sense_id": "5628c2fb-a2e7-3e3b-aea9-b0a12da812d9",
                                "text": "« Premier » et « deuxième » sont des mots ordinaux."
                            },
                            {
                                "example_id": "d0846e7a-ab68-49d9-aede-d6e3c77a911f",
                                "sense_id": "5628c2fb-a2e7-3e3b-aea9-b0a12da812d9",
                                "text": "Les numéros portés sur certains objets, tels les faces d'un dé, les alvéoles d'une roue de jeu de roulette sont bien des nombres, mais ne sont pas employés de façon ordinale."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1f921a9-4534-3abf-96c4-24a560e8707a",
                        "entry_id": "7147ea67-05be-393c-afe9-cecbf3422b89",
                        "glosses": [
                            "Désigne un adjectif ou un adverbe qui sert à indiquer l’ordre dans lequel sont rangées les choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ad2e274-de22-498f-9eed-0e5395c4f19f",
                                "sense_id": "f1f921a9-4534-3abf-96c4-24a560e8707a",
                                "text": "Premier, second ou deuxième, troisième… sont des adjectifs ordinaux."
                            },
                            {
                                "example_id": "f506efa5-0a1d-4dfa-953f-6660a1a3fc93",
                                "sense_id": "f1f921a9-4534-3abf-96c4-24a560e8707a",
                                "text": "Premièrement, secondement ou deuxièmement, troisièmement… sont des adverbes ordinaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "a634418e-d3d4-362b-8fa3-70158e0f1683",
                        "entry_id": "7147ea67-05be-393c-afe9-cecbf3422b89",
                        "glosses": [
                            "Qualifie un ensemble transitif qui est bien ordonné par la relation d’appartenance."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ea4298ad-88b2-3177-9215-faddfc3efc0a",
                        "entry_id": "7147ea67-05be-393c-afe9-cecbf3422b89",
                        "glosses": [
                            "Qui concerne un ordre professionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc7a0c11-c852-48ea-ac43-e9cc359f0458",
                                "sense_id": "ea4298ad-88b2-3177-9215-faddfc3efc0a",
                                "text": "L'ordre des médecins peut prononcer une sanction ordinale même s'il n'y a pas eu de sanction pénale."
                            },
                            {
                                "example_id": "01f2b7ba-c53f-48bf-be5e-eabcf900bc9f",
                                "sense_id": "ea4298ad-88b2-3177-9215-faddfc3efc0a",
                                "text": "Il appartiendrait ensuite aux écoles de journalisme d’en faire la matière d’un enseignement, et à la profession de voir si elle se dote d’une instance ordinale."
                            },
                            {
                                "example_id": "b8395b1b-ad96-4f1b-b293-c158172932e1",
                                "sense_id": "ea4298ad-88b2-3177-9215-faddfc3efc0a",
                                "text": "[…] plaide le docteur Jacques Lucas, vice-président du Conseil national de l’ordre des médecins, délégué général au numérique. Face à ces enjeux à court terme, l’instance ordinale prépare des recommandations concernant l’usage de l’intelligence artificielle dans la profession."
                            }
                        ]
                    }
                ],
