                    {
                        "sense_id": "bdaebc97-079e-3484-b808-6f435f8d91dc",
                        "entry_id": "a1e5c264-1d5c-3e1b-8add-a660e25ad3b4",
                        "glosses": [
                            "Plaque en fonte destinée à faire cuire crêpes et galettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52c9c9ec-57fe-4170-b1fe-cac1d8708060",
                                "sense_id": "bdaebc97-079e-3484-b808-6f435f8d91dc",
                                "text": "Dans ces dernières, il faut distinguer les crêpes cuites sur le bilig et les crêpes à la poêle confectionnées dans les familles, particulièrement à la Chandeleur ou au Mardi-Gras."
                            },
                            {
                                "example_id": "5d8efa54-6917-4d8c-86f0-069f6d1fdc50",
                                "sense_id": "bdaebc97-079e-3484-b808-6f435f8d91dc",
                                "text": "Le bilig culotté à souhait (plaque chauffante circulaire), le rozell en buis (raclette) et le spanell (spatule) sont de la partie mais les crêpes sortent vraiment de l’ordinaire tout en empruntant au registre lexical vernaculaire."
                            }
                        ]
                    }
