                    {
                        "translation_id": "1518b71e-64bf-4415-8b9a-b34d1860c72f",
                        "source_entry_id": "e6fcf560-d84a-372f-b15d-d5489259cf59",
                        "source_sense_id": "118cfd55-1db7-35f1-b777-3bab9dbd1106",
