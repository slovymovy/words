                    },
                    {
                        "translation_id": "55f7db08-3485-4ab8-9d47-4f12d81fb525",
                        "source_entry_id": "1ab79019-9c6d-3f6e-8b09-1b3888d4ebca",
                        "source_sense_id": "f18b3eb3-938a-31cd-9fcf-ab5e892c72f7",
                        "target_lang_word": "Eisschild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eisschild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c41bb13-aa7d-3546-a7db-dbb44b53370b",
                                        "entry_id": "b027875c-aa01-3778-8c92-a9e61ce2e526",
                                        "glosses": [
                                            "ausgedehnte Eisdecke auf großen Landflächen in den Polarregionen"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "175f8a73-43a5-49ca-b6e2-e3960c8e3828",
                                                "sense_id": "3c41bb13-aa7d-3546-a7db-dbb44b53370b",
                                                "text": "Grönland besitzt einen Eisschild mit einer Fläche mehr als viermal so groß wie Deutschland."
                                            },
                                            {
                                                "example_id": "22d9791b-6e5f-4ae2-bd10-31d7242ee47b",
                                                "sense_id": "3c41bb13-aa7d-3546-a7db-dbb44b53370b",
                                                "text": "„Gerne führen Klimaaktivisten die Möglichkeit an, dass doch der Eisschild Grönlands komplett schmelzen könnte.“"
                                            },
                                            {
                                                "example_id": "2eb1b393-7724-4bf1-a001-a6c92d7afb96",
                                                "sense_id": "3c41bb13-aa7d-3546-a7db-dbb44b53370b",
                                                "text": "„Das passiert mit dem Eisschild, wenn die Temperaturen steigen: Ganze Berge von Eis geraten in Bewegung und werden von der Schwerkraft Richtung Meer gezogen.“"
                                            },
                                            {
                                                "example_id": "0f32e1bd-0aee-4804-837c-359b27c363a9",
                                                "sense_id": "3c41bb13-aa7d-3546-a7db-dbb44b53370b",
                                                "text": "„Wie diese arktischen Völker schon seit Jahrhunderten beklagen, haben die Südländer bereits in den Eisschild, auf dem die Nordländer leben und sterben, in ihrer Gier nach Ressourcen Löcher gebohrt.“"
                                            },
                                            {
                                                "example_id": "aa27e95e-51c2-4bac-bfbe-ba56180cec96",
                                                "sense_id": "3c41bb13-aa7d-3546-a7db-dbb44b53370b",
                                                "text": "„Die Weiße Insel und die Victoriainsel sind fast vollkommen von einem Eisschilde bedeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4234b0da-ccbd-46d0-ada6-f4a3f7d5eb9b",
                        "source_entry_id": "1ab79019-9c6d-3f6e-8b09-1b3888d4ebca",
                        "source_sense_id": "f18b3eb3-938a-31cd-9fcf-ab5e892c72f7",
                        "target_lang_word": "Inlandeis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inlandeis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac52b928-b4bc-3972-aafc-548c1a3d5faf",
                                        "entry_id": "c4912294-9f55-31f7-bff4-abd1a533a269",
                                        "glosses": [
                                            "ausgedehnte Eisdecke auf großen Landflächen in den Polarregionen"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7d709da-c390-437d-87a7-0135485c5dd4",
                                                "sense_id": "ac52b928-b4bc-3972-aafc-548c1a3d5faf",
                                                "text": "„Als Österreicher muss man gegen diese werbliche Monopolisierung ureigenen Exportgutes protestieren, aber die Wahrscheinlichkeit, dass einer bei Hitler an Österreich denkt, zumal in Thailand, ist, Mundgeruch hin, Mundgeruch her, wahrscheinlich ebenso gering wie die Wiederkehr Hitlers aus dem grönländischen Inlandeis.“"
                                            },
                                            {
                                                "example_id": "089716cc-c7ce-4cb0-929b-a5f81017aedf",
                                                "sense_id": "ac52b928-b4bc-3972-aafc-548c1a3d5faf",
                                                "text": "„Deutschland würde fünf Mal in diese riesige Eisfläche passen und die Zugspitze würde vom grönländischen Inlandeis komplett bedeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
