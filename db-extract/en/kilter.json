    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "61e1ccf4-4afa-3583-91fb-64eb0ba3275b",
                "word": "kilter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ef8e5b5d-f977-360c-808b-29a15d4d2112",
                        "entry_id": "61e1ccf4-4afa-3583-91fb-64eb0ba3275b",
                        "glosses": [
                            "Chiefly in out of kilter: (good) condition, form, or order; fettle."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7f2bf002-c2d8-4626-af34-619e838bbe9a",
                                "sense_id": "ef8e5b5d-f977-360c-808b-29a15d4d2112",
                                "text": "not in kilter"
                            },
                            {
                                "example_id": "4fe50d2f-28a6-4720-b1a4-c5a9f53dbe2e",
                                "sense_id": "ef8e5b5d-f977-360c-808b-29a15d4d2112",
                                "text": "[T]hey are either round-shouldered, knock-kneed, bow-legged, or parrot-toed; some are also badly cross-eyed. It seems as if they can see two different ways at the same time. Jack says they are lop-sided and out of kilter altogether."
                            },
                            {
                                "example_id": "cd9e31ee-ef37-4a55-8012-7f14116a608b",
                                "sense_id": "ef8e5b5d-f977-360c-808b-29a15d4d2112",
                                "text": "[H]e lived on tinned tomatoes, beef embalmed and sourdough bread, / On rusty beans and bacon furred with mould; / His stomach’s out of kilter and his system full of lead, / But it's over, and his poke is full of gold."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37c3bde1-eda6-4834-aaca-694f76f61bc6",
                        "source_entry_id": "61e1ccf4-4afa-3583-91fb-64eb0ba3275b",
                        "source_sense_id": "ef8e5b5d-f977-360c-808b-29a15d4d2112",
                        "source_sense_description": "(good) condition, form, or order",
                        "target_lang_word": "Einklang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einklang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af17e775-74bc-3074-bee7-ca92691e41c3",
                                        "entry_id": "310a0852-59d5-39f5-b77e-f712acf65051",
                                        "glosses": [
                                            "Übereinstimmung, Harmonie; in einem Zustand, in dem sich zwei Dinge miteinander so vereinbaren lassen, dass sie nicht widersprüchlich sind"
                                        ],
                                        "tags": [
                                            "im Einklang mit etwas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1778b5d3-5463-444c-935e-c0f54e709254",
                                                "sense_id": "af17e775-74bc-3074-bee7-ca92691e41c3",
                                                "text": "Ich beneide ihn, weil er seine privaten und beruflichen Interessen miteinander in Einklang bringen kann."
                                            },
                                            {
                                                "example_id": "4a806d1a-1a34-445f-bf91-10edec0c09ae",
                                                "sense_id": "af17e775-74bc-3074-bee7-ca92691e41c3",
                                                "text": "Die moderne Industrie produziert häufig nicht nachhaltig, geschweige denn im Einklang mit der Natur."
                                            },
                                            {
                                                "example_id": "881ffdc0-7b77-49b2-bcf0-88c327ed6396",
                                                "sense_id": "af17e775-74bc-3074-bee7-ca92691e41c3",
                                                "text": "„Die Beleuchtung des Ladens und die des Schaufensters müssen in harmonischen Einklang gebracht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5411a82d-dc73-3374-b723-cfcf3999a5cf",
                                        "entry_id": "310a0852-59d5-39f5-b77e-f712acf65051",
                                        "glosses": [
                                            "die gleiche Meinung haben (wie ein anderer/andere)"
                                        ],
                                        "tags": [
                                            "sich (mit jemandem) in Einklang (über etwas) befinden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d54bb562-c2ac-474f-99fe-237d25c9037f",
                                                "sense_id": "5411a82d-dc73-3374-b723-cfcf3999a5cf",
                                                "text": "Bei unserer Klassendiskussion befand ich mich mit vielen im Einklang."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b7cdbcbc-4c03-3cb6-bd52-e5d42e3a67d1",
                                        "entry_id": "310a0852-59d5-39f5-b77e-f712acf65051",
                                        "glosses": [
                                            "Zusammenklang zweier oder mehrerer Stimmen auf dem gleichen Ton oder im Oktavabstand"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae77a9c4-2eb0-4fbc-a5e4-3155458e1029",
                        "source_entry_id": "61e1ccf4-4afa-3583-91fb-64eb0ba3275b",
                        "source_sense_id": "ef8e5b5d-f977-360c-808b-29a15d4d2112",
                        "source_sense_description": "(good) condition, form, or order",
                        "target_lang_word": "Ordnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ordnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "411e6490-59ed-31b9-be41-fa53fd96628e",
                                        "entry_id": "de941fac-4212-34bb-9cc1-5feb32fae128",
                                        "glosses": [
                                            "Synonym für Organisation"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7789b6f3-d97c-4701-aa12-5ecfd9267e2e",
                                                "sense_id": "411e6490-59ed-31b9-be41-fa53fd96628e",
                                                "text": "„Ein grundlegendes Gesetz der Thermodynamik besagt, dass die Gesamtentropie der Welt langsam, aber sicher steigt, die Ordnung nimmt ab - es wird immer langweiliger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd2b379c-8ea7-38f2-9ea6-cfa1d5822a4a",
                                        "entry_id": "de941fac-4212-34bb-9cc1-5feb32fae128",
                                        "glosses": [
                                            "Zusammenfassung mehrerer eng verwandter Familien, wobei eine oder mehrere Ordnungen eine Klasse bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfe7399c-000e-4870-b787-92027de12cd5",
                                                "sense_id": "cd2b379c-8ea7-38f2-9ea6-cfa1d5822a4a",
                                                "text": "Die Nager sind eine Ordnung der Säugetiere."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e5bea36d-4f06-3a47-a1aa-aae12523918a",
                                        "entry_id": "de941fac-4212-34bb-9cc1-5feb32fae128",
                                        "glosses": [
                                            "aufgeräumter, organisierter Zustand"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "829f49f5-d80f-43d0-bca4-83dac84ab896",
                                                "sense_id": "e5bea36d-4f06-3a47-a1aa-aae12523918a",
                                                "text": "Die Polizei versuchte Ordnung in die Reihen der Demonstranten zu bringen."
                                            },
                                            {
                                                "example_id": "0bfd9ca9-4326-4bac-ae62-cecf8e3f6a6c",
                                                "sense_id": "e5bea36d-4f06-3a47-a1aa-aae12523918a",
                                                "text": "Bring doch bitte dein Zimmer in Ordnung, hier sieht es aus wie nach einem Bombenangriff."
                                            },
                                            {
                                                "example_id": "e979fd9b-a237-423a-bac7-71857d5f4b37",
                                                "sense_id": "e5bea36d-4f06-3a47-a1aa-aae12523918a",
                                                "text": "Ordnung kann auch strategische, herrschaftliche und manipulative Gründe haben: Ordnung erleichtert den Zugriff auf Ressourcen, das Beherrschen und Regieren sowie das Manipulieren."
                                            },
                                            {
                                                "example_id": "ea231db7-94b9-4179-b1a9-533b39c666d7",
                                                "sense_id": "e5bea36d-4f06-3a47-a1aa-aae12523918a",
                                                "text": "„Eine Religion ist ein System menschlicher Werte und Normen, das auf dem Glauben an eine übermenschliche Ordnung basiert.“"
                                            },
                                            {
                                                "example_id": "5c5c1614-1856-46a7-8e4c-0f27e89b6a27",
                                                "sense_id": "e5bea36d-4f06-3a47-a1aa-aae12523918a",
                                                "text": "„Die erzwungene Ordnung, die verbissen zur Schau gestellte Routine der Machthaber, geriet in diesen Winterwochen in immer krasseren Gegensatz zur Wirklichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fb4d39f2-49e4-3c89-a4fd-46b72c29e7e8",
                                        "entry_id": "de941fac-4212-34bb-9cc1-5feb32fae128",
                                        "glosses": [
                                            "Relation auf einer Menge M, die reflexiv, transitiv und antisymmetrisch ist; eine Ordnungsrelation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf87c4b-f45e-430d-9185-f95ddd7c9bac",
                                                "sense_id": "fb4d39f2-49e4-3c89-a4fd-46b72c29e7e8",
                                                "text": "Auf der Menge M:=𝔓(1,,2,,3) ist durch die Teilmengenbeziehung ⊆ eine Ordnung erklärt. Es gibt in dieser Ordnung unvergleichbare Elemente: Weder gilt 1⊆2, noch gilt 2⊆1."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "655881f2-4340-4bc6-95a3-921ca9009d12",
                        "source_entry_id": "61e1ccf4-4afa-3583-91fb-64eb0ba3275b",
                        "source_sense_id": "ef8e5b5d-f977-360c-808b-29a15d4d2112",
                        "source_sense_description": "(good) condition, form, or order",
                        "target_lang_word": "Zustand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zustand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ebd81fb-a154-3ecf-97ec-847e20fa633b",
                                        "entry_id": "4664d650-ef13-3277-a0bc-0d2d44b34f8b",
                                        "glosses": [
                                            "Art und Weise, wie etwas zu einem bestimmten Zeitpunkt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35931510-3c70-4d84-b8fd-025c690397fa",
                                                "sense_id": "6ebd81fb-a154-3ecf-97ec-847e20fa633b",
                                                "text": "„Die Erinnerung an die damaligen Zustände heilt einen von der deutschen Philosophie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da3610d5-c1b9-3ad4-9534-d7e9802d9e27",
                                        "entry_id": "4664d650-ef13-3277-a0bc-0d2d44b34f8b",
                                        "glosses": [
                                            "Art und Weise, wie etwas zu einem bestimmten Zeitpunkt ist",
                                            "physischer Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eba791a-0f21-4497-9606-08ecf3d8db07",
                                                "sense_id": "da3610d5-c1b9-3ad4-9534-d7e9802d9e27",
                                                "text": "Das Auto ist in einem guten Zustand."
                                            },
                                            {
                                                "example_id": "bfeb1f8e-5faf-47a4-8c14-a3f41822f0f7",
                                                "sense_id": "da3610d5-c1b9-3ad4-9534-d7e9802d9e27",
                                                "text": "„Gleichzeitig beobachtete er die Zustände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "a6c8e9c6-3928-3c12-873d-0c361e35053f",
                                        "entry_id": "4664d650-ef13-3277-a0bc-0d2d44b34f8b",
                                        "glosses": [
                                            "Art und Weise, wie etwas zu einem bestimmten Zeitpunkt ist",
                                            "psychischer Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17c8c45c-7041-487d-914b-457115b65230",
                                                "sense_id": "a6c8e9c6-3928-3c12-873d-0c361e35053f",
                                                "text": "„In dieser Nacht war Elena in einem schlimmen Zustand.“"
                                            },
                                            {
                                                "example_id": "d8370dbc-bf1a-4af9-99d7-e1491a87f932",
                                                "sense_id": "a6c8e9c6-3928-3c12-873d-0c361e35053f",
                                                "text": "„Es versetzte mich in einen Zustand außerhalb eines jeden Zustands, ich hatte keine Worte für diesen Nicht-Zustand.“"
                                            },
                                            {
                                                "example_id": "e8d2ee79-b9f8-42cf-a9ae-aeab1c29039d",
                                                "sense_id": "a6c8e9c6-3928-3c12-873d-0c361e35053f",
                                                "text": "„Endlich kam Laura und berichtete, daß sich die Kranke unverändert in einem Zustand der Entkräftung befinde, daß sich der Arzt über ihre große Schwäche sehr wundere und nicht wisse, worauf sie zurückzuführen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "809eac90-de84-36cb-a46a-387d63b4983f",
                                        "entry_id": "4664d650-ef13-3277-a0bc-0d2d44b34f8b",
                                        "glosses": [
                                            "plötzlich auftretende körperliche Beschwerden oder schlechte Laune"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e02318e7-91c8-4fd5-82fb-1f9d1c13bb4a",
                                                "sense_id": "809eac90-de84-36cb-a46a-387d63b4983f",
                                                "text": "Ich krieg Zustände mit diesen Nachbarn!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1f501763-2306-3215-8010-d049e1f7cc7b",
                                        "entry_id": "4664d650-ef13-3277-a0bc-0d2d44b34f8b",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e24848aa-568e-4dc1-bf9d-b85968e0cde3",
                                                "sense_id": "1f501763-2306-3215-8010-d049e1f7cc7b",
                                                "text": "„Wenn es gelingt, […] die Auf- und Abwinde richtig einzuschätzen, den Drachen optimal zu steuern, fehlerfrei zu navigieren, dann stellen sich dem Flieger schon während seiner Tätigkeit positive Rückmeldungen ein, die in einen Flow-Zustand versetzen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a, b\""
                                    }
                                ]
                            }
                        ]
                    }
