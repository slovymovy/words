{
    "word_family": [
        "thousand",
        "thousandfold"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ffb1fce3-f023-3432-88c8-b94bbbdb485d",
                    "sense_definition": "Occurring in the position corresponding to number one thousand in a series.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ordinal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum recently welcomed its <w>thousandth</w> visitor of the day.",
                            "target_lang_translations": {
                                "es": "El museo recibió recientemente a su <w>milésimo</w> visitante del día."
                            }
                        },
                        {
                            "text": "Today we are celebrating the town's <w>thousandth</w> anniversary.",
                            "target_lang_translations": {
                                "es": "Hoy celebramos el <w>milésimo</w> aniversario del pueblo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thousandth visitor",
                        "thousandth time",
                        "thousandth anniversary"
                    ],
                    "target_lang_definitions": {
                        "es": "Que ocupa el lugar correspondiente al número mil en una serie ordenada."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "milésimo",
                                "target_lang_sense_clarification": "masculino"
                            },
                            {
                                "target_lang_word": "milésima",
                                "target_lang_sense_clarification": "femenino"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f057b13-9302-3b0b-bfd5-8605cef3dd87",
                    "sense_definition": "One of one thousand equal parts into which something is divided.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A millimetre is one <w>thousandth</w> of a metre.",
                            "target_lang_translations": {
                                "es": "Un milímetro es una <w>milésima</w> de metro."
                            }
                        },
                        {
                            "text": "The race was decided by a <w>thousandth</w> of a second.",
                            "target_lang_translations": {
                                "es": "La carrera se decidió por una <w>milésima</w> de segundo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thousandth of a second"
                    ],
                    "target_lang_definitions": {
                        "es": "Cada una de las mil partes iguales en que se divide un todo o una unidad de medida."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "milésima",
                                "target_lang_sense_clarification": "fracción o parte igual, uso más frecuente"
                            },
                            {
                                "target_lang_word": "milésimo",
                                "target_lang_sense_clarification": "fracción de un todo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a78740c5-9510-393b-b349-d4171e9b4561",
                    "sense_definition": "The person or thing in the position of number one thousand.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ordinal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was the <w>thousandth</w> to cross the finish line in the marathon.",
                            "target_lang_translations": {
                                "es": "Ella fue la <w>milésima</w> en cruzar la línea de meta en el maratón."
                            }
                        },
                        {
                            "text": "He waited in line until the <w>thousandth</w> was finally admitted.",
                            "target_lang_translations": {
                                "es": "Esperó en la fila hasta que el <w>milésimo</w> fue finalmente admitido."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Persona o cosa que ocupa el lugar número mil en una sucesión."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "milésimo",
                                "target_lang_sense_clarification": "referido a hombre o entidad masculina"
                            },
                            {
                                "target_lang_word": "milésima",
                                "target_lang_sense_clarification": "referido a mujer o entidad femenina"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}