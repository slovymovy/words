                "senses": [
                    {
                        "sense_id": "0b810b03-c90e-3538-ab29-70dd354e7e01",
                        "entry_id": "e6eeb3dd-34e4-349e-8623-b661f4e701f2",
                        "glosses": [
                            "rabin, cadyk"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7bf08238-ce14-445a-b5f4-85e2ac409aab",
                                "sense_id": "0b810b03-c90e-3538-ab29-70dd354e7e01",
                                "text": "Chasydzki rebe miał w środowisku gminy pozycję dominującą."
                            },
                            {
                                "example_id": "82acf7c0-157f-4313-bac7-6d9597580e77",
                                "sense_id": "0b810b03-c90e-3538-ab29-70dd354e7e01",
                                "text": "Późno wieczorem rebe zawołał do siebie szamesa i kazał sobie powtórzyć nowiny. Wiadomości były okropne. W ciągu dnia zmarło jeszcze stu trzydziestu Żydów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "490f0331-09f2-3d99-9ea6-e61572ea97a1",
                        "entry_id": "e6eeb3dd-34e4-349e-8623-b661f4e701f2",
                        "glosses": [
                            "złodziejska sędzia"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3104eea8-d924-402f-a31b-b08286400dcb",
                        "source_entry_id": "e6eeb3dd-34e4-349e-8623-b661f4e701f2",
                        "source_sense_id": "0b810b03-c90e-3538-ab29-70dd354e7e01",
                        "target_lang_word": "rebbe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rebbe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5800cd2-5a6a-3a13-914e-b6c055cc2003",
                                        "entry_id": "24ee213d-223e-3c48-9eb0-145a07776229",
                                        "glosses": [
                                            "The spiritual leader of a Hasidic Jewish community."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f98117c9-53f1-40c1-b70b-0de3b2b566cc",
                                                "sense_id": "a5800cd2-5a6a-3a13-914e-b6c055cc2003",
                                                "text": "Born in Riga in 1909 into a vast cousinage that included the Lubavitcher rebbes, Isaiah Mendelevich Berlin was taken to Petrograd as a small boy, and then to London in 1921 when the Bolsheviks allowed his prosperous (and fortunate) parents to leave."
                                            },
                                            {
                                                "example_id": "741e3f11-15bd-4bda-92eb-67398250bd68",
                                                "sense_id": "a5800cd2-5a6a-3a13-914e-b6c055cc2003",
                                                "text": "But two men who said they spoke with some of those who broke through the synagogue wall said the motive was to hasten an expansion of 770 — a move that they say the Lubavitcher movement’s leader, Rabbi Menachem Mendel Schneerson, known as the rebbe, called for more than three decades ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
