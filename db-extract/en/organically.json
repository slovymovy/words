                    {
                        "translation_id": "6d272167-be0d-42dd-9f49-6c0de3557875",
                        "source_entry_id": "7363d1fc-466f-3beb-b4cc-d249f1481760",
                        "source_sense_description": "with regard to organic husbandry",
                        "target_lang_word": "ökologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ökologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acc265c9-389d-336e-9509-24e27b5589a9",
                                        "entry_id": "0411c0ab-5ab1-3b53-964c-7547b5ddd000",
                                        "glosses": [
                                            "die Ökologie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "514d5e68-9518-4010-a5d1-5f90035614a2",
                                                "sense_id": "acc265c9-389d-336e-9509-24e27b5589a9",
                                                "text": "„Die 14 Hektar große Grünzone hat heute neben der städtebaulichen auch wichtige wasserwirtschaftliche und ökologische Funktionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d721ec3-3155-3a9f-abbe-86b8dd8540f4",
                                        "entry_id": "0411c0ab-5ab1-3b53-964c-7547b5ddd000",
                                        "glosses": [
                                            "in Einklang mit der Natur, der Umwelt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c103a961-f031-4866-baa0-ecec5d468681",
                                                "sense_id": "2d721ec3-3155-3a9f-abbe-86b8dd8540f4",
                                                "text": "Die ökologische Landwirtschaft ist wichtig für die Umwelt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f3ec7ad-f3ce-4c9c-9dc7-709b03608a41",
                        "source_entry_id": "7363d1fc-466f-3beb-b4cc-d249f1481760",
                        "source_sense_description": "with regard to organic husbandry",
                        "target_lang_word": "biologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca7747ec-91f4-30a5-a75d-0b0ddf2e78e1",
                                        "entry_id": "48a8841f-2fe5-3c27-a9fa-c4628efa3c72",
                                        "glosses": [
                                            "die Biologie betreffend, den Gesetzen der Biologie entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e336812b-a46d-4740-affb-f0c9712eba92",
                                                "sense_id": "ca7747ec-91f4-30a5-a75d-0b0ddf2e78e1",
                                                "text": "„In den letzten Dekaden ist die biologische Forschung in zahlreiche neue Richtungen förmlich explodiert, und der heutige Wissenschaftsbetrieb ist in seiner Vielfalt kaum mehr zu überblicken.“"
                                            },
                                            {
                                                "example_id": "a7634419-4df6-48e5-b389-c4dcd8456cfa",
                                                "sense_id": "ca7747ec-91f4-30a5-a75d-0b0ddf2e78e1",
                                                "text": "Wichtig ist mir, die Wechselwirkungen zwischen biologischer Vielfalt und Klima zu behandeln."
                                            },
                                            {
                                                "example_id": "5624bab9-a81c-432c-8076-db1abd88b9cb",
                                                "sense_id": "ca7747ec-91f4-30a5-a75d-0b0ddf2e78e1",
                                                "text": "„Die moderne Paläoanthropologie basiert auf der Evolutionstheorie und bewegt sich innerhalb der Grenzen der biologischen und geologischen Wissenschaften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d955e72-c7e2-3cb5-87fe-d64c034256bb",
                                        "entry_id": "48a8841f-2fe5-3c27-a9fa-c4628efa3c72",
                                        "glosses": [
                                            "die natürlichen Ressourcen nutzend; auf den Einsatz von Chemie verzichtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2edf09f-9a88-445d-9367-11aa9aa7e000",
                                                "sense_id": "5d955e72-c7e2-3cb5-87fe-d64c034256bb",
                                                "text": "Immer mehr entsagen der chemischen Keule, widmen sich dem biologischen Weinbau, produzieren im extremsten Fall biodynamisch."
                                            },
                                            {
                                                "example_id": "c8f50d28-4658-4352-8e16-389303ab6220",
                                                "sense_id": "5d955e72-c7e2-3cb5-87fe-d64c034256bb",
                                                "text": "Er stellte seinen Hof auf biologische Landwirtschaft um – und lernte die Tücken des Systems kennen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
