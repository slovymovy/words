        "fr-extract.jsonl": [
            {
                "entry_id": "ac515cfa-e03a-3a7c-8d86-2e256cd3f98c",
                "word": "aromathérapie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "87058e9c-9bbd-4e1b-a610-bd92e4e0d8f7",
                        "entry_id": "ac515cfa-e03a-3a7c-8d86-2e256cd3f98c",
                        "tags": [
                            "plural"
                        ],
                        "form": "aromathérapies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe965915-196e-3705-bfab-623f33b10d59",
                        "entry_id": "ac515cfa-e03a-3a7c-8d86-2e256cd3f98c",
                        "glosses": [
                            "Usage des parfums et des essences de plantes dans le but d’améliorer la santé et le bien-être."
                        ],
                        "tags": [
                            "Médecine non conventionnelle"
                        ],
                        "examples": [
                            {
                                "example_id": "00ede63c-c3af-452b-9fdb-7bcdc7cef6ed",
                                "sense_id": "fe965915-196e-3705-bfab-623f33b10d59",
                                "text": "Enfin, de nombreuses approches médicales ou paramédicales sont à disposition pour améliorer la santé des yeux, depuis « le massage yoga jusqu’à l’acupuncture, en passant par le shiatsu, la phytothérapie, l’aromathérapie, la mésothérapie, l’hypnose et les remèdes de grand-mère, à l’instar du sachet de thé noir infusé en cas d’inflammation », liste la docteure Marie-Anne Giacometti dans le livre Comment prendre soin de vos yeux."
                            },
                            {
                                "example_id": "eaadf732-1853-4f10-a869-49d314a78502",
                                "sense_id": "fe965915-196e-3705-bfab-623f33b10d59",
                                "text": "C’est grâce au docteur Jean Valnet que l’aromathérapie prit enfin son essor dans les années cinquante."
                            },
                            {
                                "example_id": "19552ba4-68fc-4441-9330-7800da76e632",
                                "sense_id": "fe965915-196e-3705-bfab-623f33b10d59",
                                "text": "L’utilisation de l’aromathérapie pour combattre des virus n’est pas appuyée sur la science, souligne Jonathan Jarry, communicateur scientifique à l’Organisation pour la science et la société de l’Université McGill."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09b47fd6-348d-4c4c-a8bd-9a10797dbd80",
                        "source_entry_id": "ac515cfa-e03a-3a7c-8d86-2e256cd3f98c",
                        "source_sense_id": "fe965915-196e-3705-bfab-623f33b10d59",
                        "target_lang_word": "Aromatherapie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aromatherapie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c17d31e-8fa5-3413-802e-c665ff4d451e",
                                        "entry_id": "44a40a15-049b-3979-bffc-20046866e9bd",
                                        "glosses": [
                                            "medizinische Anwendung von ätherischen Ölen"
                                        ],
                                        "tags": [
                                            "Naturheilkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed0592ed-505e-4a0e-b3c1-728a310e3637",
                                                "sense_id": "7c17d31e-8fa5-3413-802e-c665ff4d451e",
                                                "text": "„Mit Ayurveda kommen Sie wieder ins Gleichgewicht. Dies geschieht durch vielfältige Kräuteranwendungen, eine spezielle Ernährungsweise, wohl tuende Massagen mit speziell bereiteten Kräuterölen, Bäder, Aromatherapie oder auch durch Yoga und Meditation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
