    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36c6f812-d234-3b8e-bdaa-a52d0a6de733",
                    "sense_definition": "Попадать в какое-либо место или ситуацию, часто неожиданно.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Когда я гуляю без карты, я всегда <w>оказываюсь</w> в незнакомом месте."
                        },
                        {
                            "text": "Иногда туристы <w>оказываются</w> в лесу без воды и еды."
                        }
                    ],
                    "synonyms": [
                        "попадать"
                    ],
                    "common_phrases": [
                        "оказаться в центре",
                        "оказаться на месте"
                    ]
                },
                {
                    "sense_id": "4b0474da-12c5-3f73-8980-4ac4d7fd7a96",
                    "sense_definition": "Обнаруживаться в каком-то качестве или состоянии, проявлять себя в итоге.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Простые на вид задачи часто <w>оказываются</w> самыми трудными."
                        },
                        {
                            "text": "Прогноз погоды, к сожалению, не всегда <w>оказывается</w> точным."
                        }
                    ],
                    "synonyms": [
                        "обнаруживаться"
                    ],
                    "common_phrases": [
                        "оказаться прав",
                        "оказаться полезным"
                    ]
                },
                {
                    "sense_id": "ab6bbd73-6b86-3514-91c1-339a0f2b18c4",
                    "sense_definition": "Находиться в наличии или быть обнаруженным в определенном месте.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Когда я ищу ручку, она почему-то всегда <w>оказывается</w> в другой сумке."
                        },
                        {
                            "text": "В этом магазине нужного размера часто не <w>оказывается</w>."
                        }
                    ],
                    "synonyms": [
                        "находиться"
                    ],
                    "common_phrases": [
                        "оказаться под рукой"
                    ]
                },
                {
                    "sense_id": "fc980f83-2c10-3f45-9ad1-84c5d7592f37",
                    "sense_definition": "Проявлять свои качества или свойства перед кем-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В критических ситуациях она всегда <w>оказывается</w> самым хладнокровным человеком в команде."
                        },
                        {
                            "text": "Люди, которые мало говорят, часто <w>оказываются</w> самыми надёжными друзьями."
                        }
                    ],
                    "synonyms": [
                        "проявлять себя",
                        "показывать себя"
                    ]
                }
            ]
        }
    ]
}