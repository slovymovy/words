                        "entry_id": "b4cc84e7-4a44-355d-92e4-6ef8e1c3d62a",
                        "glosses": [
                            "To pronounce (a word, phrase, etc.) incorrectly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c25d1d6a-70cb-408d-b0cf-601dc4157545",
                        "source_entry_id": "b4cc84e7-4a44-355d-92e4-6ef8e1c3d62a",
                        "source_sense_id": "1a22ed03-f017-3fa7-a54f-5c0548abddd9",
                        "source_sense_description": "to pronounce incorrectly",
                        "target_lang_word": "mal prononcer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d0d197b7-d58e-4717-8f8c-1608e7c7604d",
                        "source_entry_id": "b4cc84e7-4a44-355d-92e4-6ef8e1c3d62a",
                        "source_sense_id": "1a22ed03-f017-3fa7-a54f-5c0548abddd9",
                        "source_sense_description": "to pronounce incorrectly",
                        "target_lang_word": "écorcher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écorcher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1572776-a0fd-31e8-99d6-6b8938ae74f9",
                                        "entry_id": "818ee959-a329-3a7c-a86b-89e1b31b1fab",
                                        "glosses": [
                                            "Dépouiller un animal de sa peau."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f508f3e-12c4-40e5-9fc5-bd554999dbfc",
                                                "sense_id": "b1572776-a0fd-31e8-99d6-6b8938ae74f9",
                                                "text": "Son fripon de cuisinier n’est pas pour rien l’élève d’un Français ; il écorche un chat et le sert en guise de lièvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3bb7da4-66bc-33c6-9d94-9181b54fc5b0",
                                        "entry_id": "818ee959-a329-3a7c-a86b-89e1b31b1fab",
                                        "glosses": [
                                            "Supplicier certains condamnés en leur arrachant la peau en tout ou partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc57f7f3-f5e2-466c-974e-0c91b70eea02",
                                                "sense_id": "c3bb7da4-66bc-33c6-9d94-9181b54fc5b0",
                                                "text": "Écorcher vif."
                                            },
                                            {
                                                "example_id": "d2c4ba0e-cc30-429e-9c3b-f47e030fd458",
                                                "sense_id": "c3bb7da4-66bc-33c6-9d94-9181b54fc5b0",
                                                "text": "— Je veux mourir en paix, lui dit-il. Et si tu es prise une fois, une seule fois encore à rôder autour de ma tente, Mezror t’écorchera au fouet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dcdfae9-8a39-35b4-9fbb-e3a7ab3d7d4d",
                                        "entry_id": "818ee959-a329-3a7c-a86b-89e1b31b1fab",
                                        "glosses": [
                                            "Déchirer, enlever une partie de la peau d’une personne, d’un animal, ou de l’écorce d’un arbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa22bcb-b76d-483c-bb41-d781b2281e60",
                                                "sense_id": "6dcdfae9-8a39-35b4-9fbb-e3a7ab3d7d4d",
                                                "text": "À l’endroit d’où elle était venue, il y avait une sorte de tunnel si bas qu’Ouroz, pour le passer, dut se coucher sur l’encolure de Jehol, et si étroit que l’étalon écorcha ses épaules."
                                            },
                                            {
                                                "example_id": "6a8327db-8082-42f2-9cad-a051da5f648b",
                                                "sense_id": "6dcdfae9-8a39-35b4-9fbb-e3a7ab3d7d4d",
                                                "text": "Je suis tombée sur une pierre. De tout mon poids, j'ai mis une main devant moi mais trop tard. Mes genoux sont écorchés. J'ai un œil bleu. Mathieu s'en amuse. Il m'appelle la \"femme battue\"."
                                            },
                                            {
                                                "example_id": "cf03d408-197b-4dbc-8ce5-a2869bf6d2fb",
                                                "sense_id": "6dcdfae9-8a39-35b4-9fbb-e3a7ab3d7d4d",
                                                "text": "Il se souvenait du silence, du ciel couleur d'étain, des cristaux de givre qui lui écorchaient le nez, les joues ; de cette gadoue, neige et boue qui le faisait trébucher."
                                            },
                                            {
                                                "example_id": "aba086b0-1fd0-40ca-a1f8-d9b0a7e9934b",
                                                "sense_id": "6dcdfae9-8a39-35b4-9fbb-e3a7ab3d7d4d",
                                                "text": "— Ce soc est fort petit, et le coutre qui ne fait qu’écorcher la terre , pour ainsi dire ; à mesure que les sillons sont tirés, les laboureurs rompent les mottes avec de grosses maillottes de bois, […]."
                                            },
                                            {
                                                "example_id": "770c9cd8-a89e-4410-a4b5-5701fac0a091",
                                                "sense_id": "6dcdfae9-8a39-35b4-9fbb-e3a7ab3d7d4d",
                                                "text": "Ça marcha d’abord, bien que l’âne s’écorchât contre le plâtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e95abf40-09f4-3af4-ac9c-a1f6ef0bb96a",
                                        "entry_id": "818ee959-a329-3a7c-a86b-89e1b31b1fab",
                                        "glosses": [
                                            "Être rude au palais, à la gorge, en parlant d’un aliment, d’une boisson."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62339127-cd85-4fce-bb39-50f0e968a121",
                                                "sense_id": "e95abf40-09f4-3af4-ac9c-a1f6ef0bb96a",
                                                "text": "Le pain de son, le pain dur écorche le gosier."
                                            },
                                            {
                                                "example_id": "8cadfc49-de83-40f1-8370-5806664c1788",
                                                "sense_id": "e95abf40-09f4-3af4-ac9c-a1f6ef0bb96a",
                                                "text": "Ce vin est si âpre, qu’il écorche le palais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e085d85-d4ad-3b2c-b061-a50ebc24bab0",
                                        "entry_id": "818ee959-a329-3a7c-a86b-89e1b31b1fab",
                                        "glosses": [
                                            "Être rude à l’oreille, en parlant de paroles, de sons, entendus."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "826d937c-90f9-42ef-9e19-4bb804e85750",
                                                "sense_id": "1e085d85-d4ad-3b2c-b061-a50ebc24bab0",
                                                "text": "Un jargon barbare qui écorche les oreilles."
                                            },
                                            {
                                                "example_id": "0b15178f-edf4-432a-a09a-24a5c7220a97",
                                                "sense_id": "1e085d85-d4ad-3b2c-b061-a50ebc24bab0",
                                                "text": "Une voix, une musique qui écorche les oreilles."
                                            },
                                            {
                                                "example_id": "764a0966-d8a1-4ebd-a334-7e946479229a",
                                                "sense_id": "1e085d85-d4ad-3b2c-b061-a50ebc24bab0",
                                                "text": "Ses leçons de musique du couvent ne lui servaient plus qu’à écorcher les couplets de bouffonneries nouvelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0beac259-69e5-32e0-a881-b0f23c3d7e95",
                                        "entry_id": "818ee959-a329-3a7c-a86b-89e1b31b1fab",
                                        "glosses": [
                                            "Parler mal, prononcer mal les mots, être loin de maîtriser une langue, la rudoyer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63f04632-4285-4d31-9167-7224fc31b209",
                                                "sense_id": "0beac259-69e5-32e0-a881-b0f23c3d7e95",
                                                "text": "Écorcher une langue."
                                            },
                                            {
                                                "example_id": "37ddfe6a-28e3-4403-9aa7-12025aad268e",
                                                "sense_id": "0beac259-69e5-32e0-a881-b0f23c3d7e95",
                                                "text": "Écorcher un mot, le nom de quelqu’un."
                                            },
                                            {
                                                "example_id": "f228e105-d527-413a-9a38-9c7fb1afc17a",
                                                "sense_id": "0beac259-69e5-32e0-a881-b0f23c3d7e95",
                                                "text": "Car mon mari …, voyant entrer dans notre chambre un gentilhomme gênois, lequel écorchait un peu le français, lui demanda : \"Monsieur, vous plaît-il quelque chose ?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e815f3-48ec-3b19-81b4-c9dcc0353d10",
                                        "entry_id": "818ee959-a329-3a7c-a86b-89e1b31b1fab",
                                        "glosses": [
                                            "Rectifier l’épaisseur d’une ébauche avant de préparer le moule de fonderie."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56ce14aa-f1f3-3c94-b2dd-ded9bc20f8ae",
                                        "entry_id": "818ee959-a329-3a7c-a86b-89e1b31b1fab",
                                        "glosses": [
                                            "Exiger beaucoup plus de quelqu’un qu’il n’est équitable ou raisonnable pour des droits, des salaires, des vacations, pour des marchandises, des fournitures."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3880baf-528b-4c11-8138-80a8509f23ee",
                                                "sense_id": "56ce14aa-f1f3-3c94-b2dd-ded9bc20f8ae",
                                                "text": "Cet homme d’affaires écorchait ses clients."
                                            },
                                            {
                                                "example_id": "eab4e5fb-91b8-49a6-a837-5593be2d9c25",
                                                "sense_id": "56ce14aa-f1f3-3c94-b2dd-ded9bc20f8ae",
                                                "text": "Ce marchand est raisonnable, il n’écorche pas ses pratiques."
                                            },
                                            {
                                                "example_id": "a9e73860-659f-49ad-a2fb-d813b6d9a603",
                                                "sense_id": "56ce14aa-f1f3-3c94-b2dd-ded9bc20f8ae",
                                                "text": "Je leur conseille vivement de ne pas se loger à l'Hôtel de Florence, car c'est le premier de l'Amérique où, jusqu'ici, j’aie été écorché…, comme si j'avais été un castor ou une loutre."
                                            },
                                            {
                                                "example_id": "0da22f8f-82b2-4f82-a586-35a14f232884",
                                                "sense_id": "56ce14aa-f1f3-3c94-b2dd-ded9bc20f8ae",
                                                "text": "Ce n’était pas la première fois qu’elle se voyait ainsi écorchée ; bien souvent elle l’avait été plus durement encore dans leur long voyage, et elle finissait par croire que c’est la loi de nature pour ceux qui ont, au détriment de ceux qui n’ont pas."
                                            },
                                            {
                                                "example_id": "f94cd199-22f8-4a73-ac82-4d71b1e5a5ff",
                                                "sense_id": "56ce14aa-f1f3-3c94-b2dd-ded9bc20f8ae",
                                                "text": "Mais enfin, allez goûter à Rivebelle si cela vous amuse d'être écorché et de jeter l'argent par les fenêtres."
                                            },
                                            {
                                                "example_id": "209ac97a-789c-4b2d-94d9-371627a54a2d",
                                                "sense_id": "56ce14aa-f1f3-3c94-b2dd-ded9bc20f8ae",
                                                "text": "– Pourquoi pas chez nous ? Nous venons d’acheter une maison et nous sommes dit qu’en prenant un locataire nous sortirions plus vite d’hypothèque. On ne vous écorchera pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "580d7e6b-f2c5-3ef0-a2bf-9d71c6d123f7",
                                        "entry_id": "818ee959-a329-3a7c-a86b-89e1b31b1fab",
                                        "glosses": [
                                            "Tenir des propos malveillants à l’égard de quelqu’un."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e414dc3a-ae2e-4a97-a69c-bf29f04f54bc",
                                                "sense_id": "580d7e6b-f2c5-3ef0-a2bf-9d71c6d123f7",
                                                "text": "Écorcher son prochain."
                                            },
                                            {
                                                "example_id": "117cadb0-097e-43f0-a6ff-ad1d2b19c283",
                                                "sense_id": "580d7e6b-f2c5-3ef0-a2bf-9d71c6d123f7",
                                                "text": "Même s’il n’a pas cru le plaignant et que Salvail a été blanchi de toutes accusations, l’ex-animateur, qui disait ne pas être le genre de personne qui agresse le monde, a lui aussi été solidement écorché par le magistrat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
