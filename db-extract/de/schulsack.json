                "senses": [
                    {
                        "sense_id": "de041fd7-0349-3694-b28d-3b2d6b6f6a92",
                        "entry_id": "5222ec03-d767-3dfc-807c-73df3c4671f3",
                        "glosses": [
                            "auf dem Rücken getragene Tasche für den Transport von Schulsachen"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "a7a54e67-3589-4a02-acd1-3204400c0404",
                                "sense_id": "de041fd7-0349-3694-b28d-3b2d6b6f6a92",
                                "text": "„Dabei musste ich selber mitlachen, als ich über meinen eigenen Schulsack stolperte und quer zwischen die Schulbänke fiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8328a5d2-eec0-3d72-89ed-4ceb376c31de",
                        "entry_id": "5222ec03-d767-3dfc-807c-73df3c4671f3",
                        "glosses": [
                            "Gesamtheit des Wissens, das man sich in der Schule/Ausbildung angeeignet hat"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "a7e52c14-25d0-4e65-8617-0752ee051b64",
                                "sense_id": "8328a5d2-eec0-3d72-89ed-4ceb376c31de",
                                "text": "„Unsere Altvordern kamen mit viel leichterem Schulsack als wir zur Universität, und wurden die schöpferischen Begründer der humanistischen Wissenschaften.“"
                            },
                            {
                                "example_id": "1f0f6e8b-b5df-4264-8408-f74c8207dc20",
                                "sense_id": "8328a5d2-eec0-3d72-89ed-4ceb376c31de",
                                "text": "„Der Kanton Uri habe in der Vergangenheit immer wieder bewiesen, dass er seiner Jugend einen gut gefüllten Schulsack auf den Lebensweg mitgeben wolle.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad41ffb9-dd49-4456-9038-e752616e11df",
                        "source_entry_id": "5222ec03-d767-3dfc-807c-73df3c4671f3",
                        "source_sense_id": "de041fd7-0349-3694-b28d-3b2d6b6f6a92",
