{
    "word_family": [
        "bibberen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1d584ef-50fe-37b8-886f-e5831eb752ad",
                    "sense_definition": "Een trilling of beving van het lichaam, vaak door kou of angst.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "trilling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kreeg de <w>bibber</w> toen hij het enge verhaal hoorde.",
                            "target_lang_translations": {
                                "fr": "Il a eu des <w>tremblements</w> en entendant cette histoire effrayante."
                            }
                        },
                        {
                            "text": "Door de kou voelde ze een <w>bibber</w> door haar hele lichaam gaan.",
                            "target_lang_translations": {
                                "fr": "À cause du froid, elle a senti un <w>frisson</w> parcourir tout son corps."
                            }
                        }
                    ],
                    "synonyms": [
                        "bibbering"
                    ],
                    "common_phrases": [
                        "de bibber krijgen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Un tremblement ou une secousse du corps, souvent dû au froid ou à la peur."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tremblement",
                                "target_lang_sense_clarification": "mouvement involontaire du corps"
                            },
                            {
                                "target_lang_word": "frisson",
                                "target_lang_sense_clarification": "sensation de froid ou réaction émotionnelle"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5422959b-42bc-3391-b962-82b2c6d4653b",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>bibberen</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "trillen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bibber</w> van de kou als ik buiten sta zonder jas.",
                            "target_lang_translations": {
                                "fr": "<w>Je tremble</w> de froid quand je suis dehors sans manteau."
                            }
                        },
                        {
                            "text": "Ik <w>bibber</w> altijd een beetje als ik voor een grote groep moet spreken.",
                            "target_lang_translations": {
                                "fr": "<w>Je tremble</w> toujours un peu quand je dois parler devant un grand groupe."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier au présent du verbe trembler."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "je tremble",
                                "target_lang_sense_clarification": "forme conjuguée du verbe trembler"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07a05cee-1ea4-310c-a98d-255ba89b1ce0",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>bibberen</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "trillen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>bibber</w> je zo erg in deze koude wind?",
                            "target_lang_translations": {
                                "fr": "Pourquoi <w>trembles-tu</w> autant dans ce vent froid ?"
                            }
                        },
                        {
                            "text": "Als je zo hard <w>bibber</w> je, moet je echt naar binnen gaan.",
                            "target_lang_translations": {
                                "fr": "Si <w>tu trembles</w> si fort, tu devrais vraiment rentrer."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier au présent du verbe trembler."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tu trembles",
                                "target_lang_sense_clarification": "forme conjuguée du verbe trembler"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f951355-eaf0-39d3-b426-7e4c5b8f8464",
                    "sense_definition": "Gebiedende wijs van <w>bibberen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "trillen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bibber</w> maar eens goed om warm te worden.",
                            "target_lang_translations": {
                                "fr": "<w>Tremble</w> bien pour te réchauffer."
                            }
                        },
                        {
                            "text": "<w>Bibber</w> niet zo, het is helemaal niet zo koud buiten.",
                            "target_lang_translations": {
                                "fr": "<w>Ne tremble</w> pas comme ça, il ne fait pas si froid dehors."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe trembler."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tremble",
                                "target_lang_sense_clarification": "forme impérative du verbe trembler"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}