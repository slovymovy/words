                    {
                        "translation_id": "9090a0bc-2277-4431-bdb9-91a4bddf1af1",
                        "source_entry_id": "04ec573b-c16a-33cb-9c49-150ad7b6fe50",
                        "source_sense_id": "51be6ae6-3303-3bb1-aaee-f53d239dce86",
                        "target_lang_word": "corps de garde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corps de garde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c5170de-ac40-399e-8897-148f11c0b504",
                                        "entry_id": "c13ce626-bfde-3be5-96ff-a9e21118b50f",
                                        "glosses": [
                                            "Ensemble de soldats placés en un lieu pour faire la garde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49d367ec-a91a-4209-b6a0-9790b8653307",
                                                "sense_id": "7c5170de-ac40-399e-8897-148f11c0b504",
                                                "text": "Poser, mettre, établir un corps de garde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "141d6a59-d3ce-3cf7-8879-c0f857fadbb8",
                                        "entry_id": "c13ce626-bfde-3be5-96ff-a9e21118b50f",
                                        "glosses": [
                                            "Lieu où se tiennent les soldats du corps de garde."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e93c288-8d79-4dca-be03-8b7409683628",
                                                "sense_id": "141d6a59-d3ce-3cf7-8879-c0f857fadbb8",
                                                "text": "Sa maison servait de corps de garde."
                                            },
                                            {
                                                "example_id": "ef600a34-8ca3-4655-bf8c-377cf1f2fa1b",
                                                "sense_id": "141d6a59-d3ce-3cf7-8879-c0f857fadbb8",
                                                "text": "On le conduisit au corps de garde."
                                            },
                                            {
                                                "example_id": "faf40e84-300b-4666-aadd-7a94d2d9d056",
                                                "sense_id": "141d6a59-d3ce-3cf7-8879-c0f857fadbb8",
                                                "text": "— La caserne est une invention hideuse des temps modernes. Elle ne remonte qu’au XVIIᵉ siècle. Avant, on n’avait que le bon corps de garde où les soudards jouaient aux cartes et faisaient des contes de Merlusine."
                                            },
                                            {
                                                "example_id": "172511a0-9cc2-4a61-af2a-6cbfa41f4154",
                                                "sense_id": "141d6a59-d3ce-3cf7-8879-c0f857fadbb8",
                                                "text": "C'est une petite cahute en planches qui nous sert de corps de garde, non loin d'Honfleur, au bord de la Seine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82ee6dcc-be6a-49bc-b7f6-09de480649c1",
                        "source_entry_id": "04ec573b-c16a-33cb-9c49-150ad7b6fe50",
                        "source_sense_id": "51be6ae6-3303-3bb1-aaee-f53d239dce86",
                        "target_lang_word": "кордегардия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кордегардия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2e790087-c19b-31c4-9f4c-311bfdb87369",
                                        "entry_id": "1916474b-cfee-32f9-bfc6-dd17dfb05893",
                                        "glosses": [
                                            "истор., воен. помещение для военного караула"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d61a59-d824-41f9-b74d-cf428bc2adda",
                                                "sense_id": "2e790087-c19b-31c4-9f4c-311bfdb87369",
                                                "text": "Подполковница гарнизонного баталиона, дама отважная, дама хорошо воспитанная в разных казармах и кордегардиях, начинает роптать и повторяет свою вечную фразу: «Когда я стояла с мужем в Молдавии, то сам господарь…»"
                                            },
                                            {
                                                "example_id": "427b4165-5575-459f-921f-5c70a717cec3",
                                                "sense_id": "2e790087-c19b-31c4-9f4c-311bfdb87369",
                                                "text": "Чаще наезжал в острог, чаще кричал, чаще кидался на людей, чаще забирал народ в кордегардию и усиленно смотрел за чистотой и благообразием."
                                            },
                                            {
                                                "example_id": "194286e0-c24e-4289-b2da-a246f8fc3969",
                                                "sense_id": "2e790087-c19b-31c4-9f4c-311bfdb87369",
                                                "text": "Домик начальника, кордегардия, клуб для вольняшек и казарма находились в стороне, вне зоны: их рубили из бревен, добротно и скорее всего разобрали и увезли."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
