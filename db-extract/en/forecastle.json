    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ee23261a-d5e8-30a5-9815-bf136d81b27a",
                "word": "forecastle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e0956580-d19f-4dbf-8884-58701e5e79ed",
                        "entry_id": "ee23261a-d5e8-30a5-9815-bf136d81b27a",
                        "tags": [
                            "plural"
                        ],
                        "form": "forecastles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bef2c876-1353-38f0-9fa0-59deb5b764a4",
                        "entry_id": "ee23261a-d5e8-30a5-9815-bf136d81b27a",
                        "glosses": [
                            "A raised part of the upper deck at the front of a ship; the structure of this part of the ship; the crew's quarters located within it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5345615b-edf9-487c-aa33-05a1a7c37bda",
                                "sense_id": "bef2c876-1353-38f0-9fa0-59deb5b764a4",
                                "text": "Holonyms: watercraft, vessel, vessel"
                            },
                            {
                                "example_id": "7a65c0b0-9ef6-4657-9e7f-74b5fab3486a",
                                "sense_id": "bef2c876-1353-38f0-9fa0-59deb5b764a4",
                                "text": "My knife was at my hip. I returned to my hut for the shotgun, made sure it was loaded, and went down to the Ghost. With some difficulty, and at the expense of a wetting to the waist, I climbed aboard. The forecastle scuttle was open. I paused to listen for the breathing of the men, but there was no breathing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dbdb0f8-1161-4fc0-a91a-24f27b2bdfc1",
                        "source_entry_id": "ee23261a-d5e8-30a5-9815-bf136d81b27a",
                        "source_sense_id": "bef2c876-1353-38f0-9fa0-59deb5b764a4",
                        "source_sense_description": "nautical: raised part of the upper deck at bow",
                        "target_lang_word": "voorkasteel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2070ba24-9674-4ad3-b9ae-a1244f9fe308",
                        "source_entry_id": "ee23261a-d5e8-30a5-9815-bf136d81b27a",
                        "source_sense_id": "bef2c876-1353-38f0-9fa0-59deb5b764a4",
                        "source_sense_description": "nautical: raised part of the upper deck at bow",
                        "target_lang_word": "gaillard d'avant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4fa33e75-91b2-46aa-a7d6-ef616b4df91a",
                        "source_entry_id": "ee23261a-d5e8-30a5-9815-bf136d81b27a",
                        "source_sense_id": "bef2c876-1353-38f0-9fa0-59deb5b764a4",
                        "source_sense_description": "nautical: raised part of the upper deck at bow",
                        "target_lang_word": "Vorschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5b29362-dd6f-39af-a9dc-57277c67ef2e",
                                        "entry_id": "02600a0e-45d5-3f30-81e6-5ec392a58fe6",
                                        "glosses": [
                                            "vorderer Teil eines Schiffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6874834f-d2e5-4fce-aedf-94439284d07c",
                                                "sense_id": "b5b29362-dd6f-39af-a9dc-57277c67ef2e",
                                                "text": "„Wir gingen auf das Vorschiff und beugten uns dort über die Verschanzung.“"
                                            },
                                            {
                                                "example_id": "027f7862-1de8-460c-ab38-e529eb1fe1db",
                                                "sense_id": "b5b29362-dd6f-39af-a9dc-57277c67ef2e",
                                                "text": "„Kurz nachdem sich die beiden Matrosen Lenz und Kremp in ihre Unterkunft im Vorschiff zurückgezogen hatten, klopfte es an der Außentür zum Achterruff.“"
                                            },
                                            {
                                                "example_id": "386a97a7-39c6-46c7-8728-283da57be528",
                                                "sense_id": "b5b29362-dd6f-39af-a9dc-57277c67ef2e",
                                                "text": "„Im Laderaum stand Wasser, im Vorschiff reichte es bis zum Mastschuh, offenbar war es durch die offenen Luken eingedrungen.“"
                                            },
                                            {
                                                "example_id": "3228a463-4fd0-4d63-bc5c-109824d8af35",
                                                "sense_id": "b5b29362-dd6f-39af-a9dc-57277c67ef2e",
                                                "text": "„Es war wie immer, die Diesel sangen im Diskant, und das Boot bebte vor Kraft, der Turm nahm viel Wasser über, das Vorschiff wuchtete manchmal so schwer in die See, daß man Angst bekommen konnte, es käme niemals wieder hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f361619-8d9a-4772-8a98-be5fdd4294cf",
                        "source_entry_id": "ee23261a-d5e8-30a5-9815-bf136d81b27a",
                        "source_sense_id": "bef2c876-1353-38f0-9fa0-59deb5b764a4",
