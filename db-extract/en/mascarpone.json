                        "source_sense_id": "b10f813d-65d9-3f0c-9b5c-9c4da6b6765b",
                        "source_sense_description": "cheese",
                        "target_lang_word": "mascarpone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mascarpone",
