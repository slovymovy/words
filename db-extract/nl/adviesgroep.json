                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47ce38d2-2015-4bde-ae69-fdabfcff4733",
                                "sense_id": "e1f7d05a-6974-3a6c-8f48-93d18a57d90e",
                                "text": "\"Mensen willen weten: wat heeft dat voor gevolgen voor mij en wat kan ik nu doen om de schade te beperken?\", zegt Dorien Sanderink van de Kaplan Adviesgroep. \"Maar een verdubbeling van de rente betekent nog geen verdubbeling van de maandlasten.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "6340a0d7-2cff-3ad0-9bd1-23876e3a2c62",
