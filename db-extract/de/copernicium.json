                    {
                        "translation_id": "7f9e939f-23b0-4d2a-9228-7f7ba6cff925",
                        "source_entry_id": "7ad095d7-a8cb-3fcb-a1f2-2d493cd20796",
                        "source_sense_id": "f0f5287a-51b2-319f-b794-4f039d2f100b",
