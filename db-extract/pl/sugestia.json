                                    {
                                        "sense_id": "c23bbdc8-b37b-3a9a-b824-d5d13d5c905c",
                                        "entry_id": "b9187428-6b82-3aa7-bd39-c31ca20f2afb",
                                        "glosses": [
                                            "Something suggested (with subsequent adposition being for)"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3492705d-1246-4578-a7ea-11de8a9a5756",
                                                "sense_id": "c23bbdc8-b37b-3a9a-b824-d5d13d5c905c",
                                                "text": "make a suggestion"
                                            },
                                            {
                                                "example_id": "d37d9915-f072-4c57-9eb6-3bee90bebb30",
                                                "sense_id": "c23bbdc8-b37b-3a9a-b824-d5d13d5c905c",
                                                "text": "I have a small suggestion for fixing this: try lifting the left side up a bit."
                                            },
                                            {
                                                "example_id": "daecda69-fd9d-40af-b7a0-393d3f822d92",
                                                "sense_id": "c23bbdc8-b37b-3a9a-b824-d5d13d5c905c",
                                                "text": "Traffic signs seem to be more of a suggestion than an order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4925ecdb-0214-3581-b987-485a048fc9d6",
                                        "entry_id": "b9187428-6b82-3aa7-bd39-c31ca20f2afb",
                                        "glosses": [
                                            "The act of suggesting."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc188325-e0c7-424a-b74b-9742c93c5d7a",
                                                "sense_id": "4925ecdb-0214-3581-b987-485a048fc9d6",
                                                "text": "Suggestion often works better than explicit demand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6f49cd6-772b-3b26-9148-4056602a31bd",
                                        "entry_id": "b9187428-6b82-3aa7-bd39-c31ca20f2afb",
                                        "glosses": [
                                            "Something implied, which the mind is liable to take as fact."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f715fc26-08fb-4c49-b143-d196b157e682",
                                                "sense_id": "a6f49cd6-772b-3b26-9148-4056602a31bd",
                                                "text": "He’s somehow picked up the suggestion that I like peanuts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "687b9d7c-df1f-310c-827b-152f42784fd7",
                                        "entry_id": "b9187428-6b82-3aa7-bd39-c31ca20f2afb",
                                        "glosses": [
                                            "The act of exercising control over a hypnotised subject by communicating some belief or impulse by means of words or gestures; the idea so suggested."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16b37845-a59a-3242-b0c9-d07457e7940b",
                                        "entry_id": "b9187428-6b82-3aa7-bd39-c31ca20f2afb",
                                        "glosses": [
                                            "Information, insinuation, speculation, as opposed to a sworn testimony and evidence."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7a07e42-ca15-4e40-aaba-5712eb3fe80d",
                        "source_entry_id": "451a38a6-69bb-3234-b186-bf1fb456dde8",
                        "source_sense_id": "109c6a4e-0aaf-3cfb-b0e8-a6b3fcc55dd5",
