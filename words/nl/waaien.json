                {
                    "sense_id": "bff5f2f9-7b28-3785-a354-25de340e17dc",
                    "sense_definition": "het waaien van de wind als weersomstandigheid",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "wind-activiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>waaide</w> gisteren heel hard aan de kust.",
                            "target_lang_translations": {
                                "en": "It <w>blew</w> very hard at the coast yesterday."
                            }
                        },
                        {
                            "text": "Het <w>waait</w> vandaag te hard om buiten te gaan tennissen.",
                            "target_lang_translations": {
                                "en": "It is <w>blowing</w> too hard today to play tennis outside."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hard waaien",
                        "stevig waaien"
                    ],
                    "target_lang_definitions": {
                        "en": "the blowing of the wind as a weather condition"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "of the wind"
                            },
                            {
