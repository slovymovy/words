                "senses": [
                    {
                        "sense_id": "5aa029f7-e719-306f-828a-e54236c60c78",
                        "entry_id": "f0e1248f-fe85-31be-ae6c-e1a3a3149adb",
                        "glosses": [
                            "Palmipède africain, proche des tadornes, portant un éperon sur l’aile, d’où le nom vernaculaire d’oie armée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27275203-745b-4dc5-90bf-f3261f1df7a7",
                                "sense_id": "5aa029f7-e719-306f-828a-e54236c60c78",
                                "text": "Les Plectroptères sont caractérisés par une forte taille, un long cou qu’ils portent droit, un bec très fort, plutôt large, orné d'une caroncule sur la mandibule supérieure, la face nue, les jambes hautes, fortes et déplumées. Tous ces oiseaux ont l’aile armée au poignet d’une sorte d'éperon, qui leur sert d’instrument de défense."
                            },
                            {
                                "example_id": "2d28fc1f-a237-4730-9f0c-bca1c374324a",
                                "sense_id": "5aa029f7-e719-306f-828a-e54236c60c78",
                                "text": "La nidification du Plectroptère de Gambie (Plectropterus gambiensis) aurait été observée en 1976 par un technicien du Parc du Saloum."
                            }
                        ]
                    }
                ],
