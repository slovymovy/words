                        "entry_id": "e8d5515a-c31f-347e-8ab3-611a68932c34",
                        "glosses": [
                            "Bewegen des Balles durch Pässe in Richtung des gegnerischen Tors/Korbs"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "cb33af74-2ca8-4d43-a818-777c907708e2",
                                "sense_id": "85805eab-9be9-3fbf-8f16-d9466681a0fe",
                                "text": "„Die Gunners behinderten von Beginn an mit hohem Pressing den Ballvortrag der Spurs, sodass Tottenham das eigene Spiel kaum konstruktiv aufbauen konnte.“"
                            },
                            {
                                "example_id": "fdb9ade3-29c5-46ea-8e50-ca9c7efc90a3",
                                "sense_id": "85805eab-9be9-3fbf-8f16-d9466681a0fe",
                                "text": "„Teilweise zu ungestüm und ungeduldig gestalteten sie die Ballvorträge, sodass der BBC immer wieder zu leichten Ballgewinnen kam und damit auch zu Punkten.“"
                            }
                        ],
