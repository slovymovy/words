                ],
                "senses": [
                    {
                        "sense_id": "0663a162-1d52-3141-ad15-41a82e416e2d",
                        "entry_id": "9a9defb9-3045-324a-9bbf-e5b632d3819c",
                        "glosses": [
                            "Prendre pour une dinde, tromper, duper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "368fd882-e5cd-4637-98d7-b8057ebbaf31",
                                "sense_id": "0663a162-1d52-3141-ad15-41a82e416e2d",
                                "text": "Mais il n’aimait pas ce genre de filles. Avec elles, il fallait direct se montrer agressif pour ne pas se faire dinder."
                            },
                            {
                                "example_id": "30cc29e4-fdd3-4b2c-86a1-0c29e2927146",
                                "sense_id": "0663a162-1d52-3141-ad15-41a82e416e2d",
                                "text": "L’alternative est de se faire dinder en concession!"
                            },
                            {
                                "example_id": "7e5090f3-5991-405f-b9f5-23836ec941c2",
                                "sense_id": "0663a162-1d52-3141-ad15-41a82e416e2d",
                                "text": "Si tu m’aimes bien dis-moi qui c’est qui veut m’dinder"
                            },
                            {
                                "example_id": "5723c410-7802-4144-912a-ba855c654666",
                                "sense_id": "0663a162-1d52-3141-ad15-41a82e416e2d",
                                "text": "Ce soir le master hydroprotech va se faire turbo dinder"
                            },
                            {
                                "example_id": "542d422f-3c72-47e0-94df-e1da81239fab",
                                "sense_id": "0663a162-1d52-3141-ad15-41a82e416e2d",
                                "text": "Avec les potes on va s'autodinder à 15 heures"
                            }
                        ]
                    },
                    {
                        "sense_id": "f1d84c50-123e-3210-9ac4-2dc9a9c0e780",
                        "entry_id": "9a9defb9-3045-324a-9bbf-e5b632d3819c",
                        "glosses": [
                            "Donner un caractère rappelant la dinde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c25ff4b-a7c1-4064-b218-f1e38cdf271f",
                                "sense_id": "f1d84c50-123e-3210-9ac4-2dc9a9c0e780",
                                "text": "Tout le monde ne peut pas s’offrir une dinde de Noël. C’est bien ce qu’a pensé un marchand de comestibles, à la porte duquel nous voyions, hier, s’étaler de superbes poules prêtes à mettre au feu, et qualifiées poules dindées. Comment cet homme ingénieux a-t-il fait pour dinder ses poules ?"
                            },
                            {
                                "example_id": "63353135-06f4-4c42-baeb-5430a097f7cb",
                                "sense_id": "f1d84c50-123e-3210-9ac4-2dc9a9c0e780",
                                "text": "Alors princesse, raconte-nous un peu, comment ça s’est passé avec ta farce dindée, oups… avec la dinde farcie à la semoule"
                            }
                        ]
                    }
                ],
