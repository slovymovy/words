                "senses": [
                    {
                        "sense_id": "02b354b0-0f0d-383a-ad88-bb7a5cb4eb5a",
                        "entry_id": "11d09634-1fac-3cd7-97d9-7c15a269f677",
                        "glosses": [
                            "eher kleines Kino (in der Vorstadt)"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "8ba8b98d-4b8a-43a1-8d9e-1f870fd5e495",
                                "sense_id": "02b354b0-0f0d-383a-ad88-bb7a5cb4eb5a",
                                "text": "„Und wo Sie schon mal da sind, ich glaube, Sie waren mit meiner Tochter im örtlichen Flohkino.“"
                            },
                            {
                                "example_id": "8138e370-7ca1-4c6e-92f1-5254fd4356b5",
                                "sense_id": "02b354b0-0f0d-383a-ad88-bb7a5cb4eb5a",
                                "text": "„Unten in unserem Hause war ein kleines Kino, ein sogenanntes Flohkino, das wir mit einer Flasche Schnaps in der Tasche gemeinsam aufsuchten.“"
                            },
                            {
                                "example_id": "797b3865-5b3f-4bd7-9e88-ec2df3af54f9",
                                "sense_id": "02b354b0-0f0d-383a-ad88-bb7a5cb4eb5a",
                                "text": "„Die meisten Kinos allerdings waren keine »Paläste«, sondern manchmal geradezu schäbige »Flohkinos«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
