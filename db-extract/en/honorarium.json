                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72a63bd8-2cdc-4fad-889e-3062790811bf",
                                                "sense_id": "e834e29d-7e90-3389-a6d0-051bfec603be",
                                                "text": "Het honorarium van de notaris bedroeg 400 euro."
