                                            {
                                                "example_id": "af55a983-e31d-4f57-bed6-51de8a27798f",
                                                "sense_id": "070f1a86-5d5c-3aaa-a490-02a02ec721b8",
                                                "text": "— Touche du bois! se récria Toto. La chance!\n— Mon petit, répondit la fausse Russe avec bon sens, je préférerais les biffetons."
                                            },
                                            {
                                                "example_id": "58aa04d4-01f2-451b-9836-ae825b10a49f",
                                                "sense_id": "070f1a86-5d5c-3aaa-a490-02a02ec721b8",
                                                "text": "- Entre nous, Dabe, une supposition, je dis bien une supposition, que j’aie un graveur, du papier, et que j’imprime pour un milliard de biffetons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6556d7af-50bd-3abb-8662-01944198acff",
                                        "entry_id": "7e5e0a3f-dc29-3a6f-86f8-47d1c99f8ea4",
                                        "glosses": [
                                            "Billet de mille francs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65450e2f-b758-4d83-9280-ce8ccd938f7f",
                                                "sense_id": "6556d7af-50bd-3abb-8662-01944198acff",
                                                "text": "Un faux pas sur la pente des caprices, et les cent papiers pouvaient se retrouver engourdis, vite fait... Cent biffetons, c’était pas le Pactole !."
                                            }
                                        ]
                                    },
