                                        "entry_id": "71c7445a-b00f-3fcf-a3b3-a710e0b3b142",
                                        "glosses": [
                                            "iemand die het land met een ploeg bewerkt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb746dd-0e9f-42f3-947a-f83eef74c16d",
                                                "sense_id": "c8f1d600-10ba-384b-be8f-8e21f3a8617a",
                                                "text": "Hij zag in navolging van Vincent van Gogh schilders als ploegers. 'Wie ploegt, maakt nieuw leven en groei mogelijk.'"
                                            },
                                            {
                                                "example_id": "42a7d561-069c-46f8-8675-8947e1cdf8de",
                                                "sense_id": "c8f1d600-10ba-384b-be8f-8e21f3a8617a",
                                                "text": "Ook De Ploeger van Museum Helmond is tot Gouden Pronkstuk uitgeroepen. Het beeld van de Belg Constantin Meunier komt als 12 meter hoge replica in goudkleurig piepschuim in het centrum van Helmond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0078ba6c-2e05-48e0-8749-082279867aa3",
                        "source_entry_id": "70de9ff0-ee42-3916-9dd5-8fffed1cfad7",
                        "source_sense_id": "ab6d4ae0-dbf4-3011-8e0c-2395a2cf283a",
