                ],
                "senses": [
                    {
                        "sense_id": "1612b7bc-a5fe-3c84-9adf-1e09ebc95578",
                        "entry_id": "69ce19ae-ddda-3ded-8088-ab057eeaa7f7",
                        "glosses": [
                            "Situation, bei der ein Spielzug aufgrund einer strittigen Situation, einer Verletzung oder Ähnliches wiederholt wird"
                        ],
                        "tags": [
                            "Volleyball"
                        ],
                        "examples": [
                            {
                                "example_id": "062a8d49-ef8a-4ee3-8d86-27ef732ca916",
                                "sense_id": "1612b7bc-a5fe-3c84-9adf-1e09ebc95578",
                                "text": "„Es herrschte Uneinigkeit beim Schiedsgericht und nach langem Hin und Her gab es einen Nullball.“"
                            },
                            {
                                "example_id": "d024453c-e000-4e6c-ba7b-75ab6ad92ba1",
                                "sense_id": "1612b7bc-a5fe-3c84-9adf-1e09ebc95578",
                                "text": "„[…] gleich den nächsten Dresdner Angriff, der deutlich im Aus gelandet war, hatte das Schiedsgericht nicht gesehen, entschied auf Nullball und nahm so de facto den Punkt, den man uns im Spielzug zuvor zuerkannt hatte, wieder zurück.“"
                            },
                            {
                                "example_id": "73a22e85-c257-4315-a8e4-4d5c3b2ba25b",
                                "sense_id": "1612b7bc-a5fe-3c84-9adf-1e09ebc95578",
                                "text": "„Die Schiedsrichterin revidierte jedoch ihre Entscheidung und gab Nullball.“"
                            },
                            {
                                "example_id": "dd366263-286d-48af-a789-4dfb1bd61202",
                                "sense_id": "1612b7bc-a5fe-3c84-9adf-1e09ebc95578",
                                "text": "„Wenn jedoch grundlegende Sachen nicht beachtet werden und es z.B. nicht geahndet wird, wenn einer Spielerin während des Aufschlags der Ball aus der Hand fällt, dass während einer Auswechslung einfach ein Aufschlag ausgeführt wird und es bei Uneinigkeit der Schiedsrichter keinen Nullball gibt, dann muss sich der geneigte Zuschauer doch etwas wundern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
