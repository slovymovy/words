                    }
                ],
                "senses": [
                    {
                        "sense_id": "04d96de8-7ada-3d8d-abb7-05decbe80891",
                        "entry_id": "dee0f620-e62c-3db4-9122-5b4052185fc8",
                        "glosses": [
                            "kleine Siedlung, Dorf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc6f2ae2-8c8e-4102-9f70-ad285064b439",
                                "sense_id": "04d96de8-7ada-3d8d-abb7-05decbe80891",
                                "text": "Die Geschichte spielt im fiktiven Örtchen Glattenbach."
                            },
                            {
                                "example_id": "b62a2096-6dc9-4244-b4f2-74f53da3d320",
                                "sense_id": "04d96de8-7ada-3d8d-abb7-05decbe80891",
                                "text": "„Im Kern der verspielten Örtchen stieß ich auf bunte Cafés, in denen junge und alte Männer an ihren Frappés nippten und sich den Nachmittag vertrieben, bevor sie am Abend zurückkehren und ihren Frauen die Neuigkeiten des Tages berichten würden.“"
                            },
                            {
                                "example_id": "5e20dc8c-e4d2-4aca-817a-28249a3a68a4",
                                "sense_id": "04d96de8-7ada-3d8d-abb7-05decbe80891",
                                "text": "„Am Nachmittag ging sie mit uns die Umgebung erkunden, das an den Hängen eines Hügels gelegene Örtchen, in dem wir wohnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eed88d55-a1d2-35d5-94fd-373f772de3f9",
                        "entry_id": "dee0f620-e62c-3db4-9122-5b4052185fc8",
                        "glosses": [
                            "Toilette"
                        ],
                        "tags": [
                            "verhüllend"
                        ],
                        "examples": [
                            {
                                "example_id": "a9de9262-e9fb-4719-a00a-c9c60c56c207",
                                "sense_id": "eed88d55-a1d2-35d5-94fd-373f772de3f9",
                                "text": "Ich muss mal aufs Örtchen."
                            },
                            {
                                "example_id": "b050ac04-7ab2-4408-a8e1-7d524a9b2a5d",
                                "sense_id": "eed88d55-a1d2-35d5-94fd-373f772de3f9",
                                "text": "„Als ich sie dort hatte, wo ich sie haben wollte, den Kopf ein wenig benebelt und ganz in ihre alten Erinnerungen versunken, machte ich den beiden Schönen ein Zeichen, und sie gingen hinaus, als wollten sie ein Örtchen aufsuchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7116b215-5c8e-4863-bba6-54d9f5b68ccf",
                        "source_entry_id": "dee0f620-e62c-3db4-9122-5b4052185fc8",
                        "source_sense_id": "04d96de8-7ada-3d8d-abb7-05decbe80891",
                        "source_sense_description": "kleine Siedlung, Dorf",
                        "target_lang_word": "petit village",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3421318b-1b60-4156-a44e-8b56661fc511",
                        "source_entry_id": "dee0f620-e62c-3db4-9122-5b4052185fc8",
                        "source_sense_id": "04d96de8-7ada-3d8d-abb7-05decbe80891",
                        "source_sense_description": "kleine Siedlung, Dorf",
                        "target_lang_word": "hameau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hameau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                        "entry_id": "d2cb1608-7a3b-31df-b265-1b7dddba5808",
                                        "glosses": [
                                            "En milieu rural, groupe d’habitations à l’écart d’une commune, à laquelle il est rattaché administrativement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ab75b2-49d7-4e9c-96a1-69010e4ccdba",
                                                "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                                "text": "On déserte surtout les endroits inaccessibles […] Il faut donc s’attacher à les rendre d’un abord plus facile en multipliant partout, entre les villages et les hameaux, les petites routes."
                                            },
                                            {
                                                "example_id": "ade946c1-beb6-40cf-85aa-5b0d850fc0b8",
                                                "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                                "text": "Au terme d’un ancien chemin usé jusqu’à l’enrochement […] le hameau des Vieux Marais dérobe sa dizaine de masures à ras du sol, à l’orée de la Fagne."
                                            },
                                            {
                                                "example_id": "097c711d-57ea-44e3-af46-1c95d222bf54",
                                                "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                                "text": "Les jours lui sont comptés et, après, il ira s’encagnarder dans son hameau, à l'abri des vents mauvais et en dehors de toute civilisation."
                                            },
                                            {
                                                "example_id": "713bf310-2f6b-4eb0-81d1-626c442cf2f4",
                                                "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                                "text": "De même, pour le département de Seine-et-Marne, le dictionnaire topographique paru en 1954 permet de relever les noms de 87 localités disparues : 4 seulement sont données pour paroisses ou villages ; les autres sont des hameaux ou encore des écarts de 3 ou 4 maisons."
                                            },
                                            {
                                                "example_id": "7c81a579-90ae-44d3-b666-30227e01b184",
                                                "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                                "text": "— Nous possédons ici même, en plein Paris, un hameau à peu près inconnu malgré son nom illustre, et qui est la Butte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e52e76e2-336f-4a10-abd6-19a0f18bfe76",
                        "source_entry_id": "dee0f620-e62c-3db4-9122-5b4052185fc8",
                        "source_sense_id": "eed88d55-a1d2-35d5-94fd-373f772de3f9",
                        "source_sense_description": "verhüllend: Toilette",
                        "target_lang_word": "toilettes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toilettes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                        "entry_id": "5f9fc3d4-bb23-3442-ad52-42b4790c483b",
                                        "glosses": [
                                            "Petit espace clos utilisé pour se soulager des déjections corporelles, telles que l’urine, les selles et les vomissures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd5c64bf-921f-407f-985c-bc40cf1ac8fc",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "– Où sont les toilettes ? me pose problème. C’est une requête froide, qui sent son restaurant de province."
                                            },
                                            {
                                                "example_id": "f54fcbab-f35c-4f8d-8453-d93368b7adb4",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "Il n'y a pas un moment, ni un endroit, où nous puissions avoir du répit : aux États-Unis, 75 % des possesseurs de smartphones l'utilisent aux toilettes !"
                                            },
                                            {
                                                "example_id": "50c4717a-22e2-4928-8f9f-a5368b4d13f6",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "Une enquête de Moore et al. auprès de 528 femmes a révélé que 85 % d'entre elles s'accroupissent sur les toilettes publiques, 12 % s'assoient en tapissant la cuvette de papier et seulement 2 % s'assoient directement sur le siège."
                                            },
                                            {
                                                "example_id": "1085d7b5-ea57-40c7-89cc-82ada5c0d839",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "Dans tous les cas, ce sont des toilettes qui n'utilisent pas d'eau.\nOn peut distinguer deux types de toilettes sèches :\n• les toilettes où les selles et l'urine sont mélangées;\n• les toilettes où elles sont séparées."
                                            },
                                            {
                                                "example_id": "8fc49d52-4b28-4ccb-9434-f7a1cd97781c",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "Il est assuré que personne ne remarque rien, de même que les drogués peuvent aller dix fois par jour se faire leur fix aux toilettes sans prendre en compte que ça nuit à leur secret tant qu'on ne le leur a pas fait explicitement remarquer, […]."
                                            },
                                            {
                                                "example_id": "5d3b396a-4136-4c0b-96ed-c8718e8248b4",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "Mais la petite maison de bois se réchauffe rapidement – hormis les toilettes qui demeurent glaciales, car elles se trouvent à l’extérieur."
                                            },
                                            {
                                                "example_id": "3b2f60f6-8b43-4863-91ad-653edc6c2d7d",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "La procureure a souligné que les deux derniers cas étaient liés à « de la contamination secondaire, par les mains. C’est-à-dire qu’une personne contaminée a dû (…) sortir des toilettes sans bien se laver les mains, et tenir les mains d’une autre personne qui du coup va être contaminée »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "888e6abd-429b-3fa1-ba87-72e190a0d468",
                                        "entry_id": "5f9fc3d4-bb23-3442-ad52-42b4790c483b",
                                        "glosses": [
                                            "Appareil sanitaire servant à recueillir et à évacuer les besoins naturels."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "300df3f2-eb4b-4c46-bf93-48d9271906e3",
                                                "sense_id": "888e6abd-429b-3fa1-ba87-72e190a0d468",
                                                "text": "Les lingettes jetées dans les toilettes ont une double conséquence: elles bouchent les canalisations et polluent l’environnement. Le réseau d’assainissement du Lot-et-Garonne alerte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toilettes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89a988ae-c0fe-3678-ab8e-ed44725399a2",
                                        "entry_id": "b9399f21-6f23-3fb9-9819-cab44870fc2a",
                                        "glosses": [
                                            "Pluriel de toilette."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9eb018-aea0-4f4f-b176-bd7934d7615f",
                                                "sense_id": "89a988ae-c0fe-3678-ab8e-ed44725399a2",
                                                "text": "Pendant que le juge dépotait, repiquait, arrosait, marcotait, greffait, mariait et panachait ses fleurs, madame Blondet dépensait son bien en toilettes et en modes pour briller dans les salons de la Préfecture ; un seul intérêt, l’éducation d’Émile, qui certes appartenait encore à sa passion, pouvait l’arracher aux soins de cette belle affection, que la ville finit par admirer."
                                            }
                                        ]
                                    }
                                ]
                            },
