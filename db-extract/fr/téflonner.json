                "senses": [
                    {
                        "sense_id": "75d9ad34-777f-38dc-a453-50e081fab15c",
                        "entry_id": "4818cae3-2f5e-3093-bae7-6dc996423ffb",
                        "glosses": [
                            "Couvrir de téflon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2c6612e-d13a-4b62-a820-a3578c3d26fe",
                                "sense_id": "75d9ad34-777f-38dc-a453-50e081fab15c",
                                "text": "Un ami qui lui s'y connait m'a dit que on pouvait téflonner la tête de piston."
                            },
                            {
                                "example_id": "0b8eeaf4-7ec1-4583-8101-e67e3c869a45",
                                "sense_id": "75d9ad34-777f-38dc-a453-50e081fab15c",
                                "text": "Je n'ai pas encore eu le temps d'essayer cette méthode sur ma SVD mais téflonner ce ressort (une épaisseur seulement) ne permettrait pas d'amoindrir ces vibrations?"
                            },
                            {
                                "example_id": "021e8b48-65f7-43aa-83b7-b90365d7f701",
                                "sense_id": "75d9ad34-777f-38dc-a453-50e081fab15c",
                                "text": "Téflonner en serrant le téflon et faire un dôme qui va s'écraser et assurer l'étanchéité."
                            }
                        ]
                    }
