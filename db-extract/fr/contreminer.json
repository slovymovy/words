                                                "sense_id": "75a7f18f-87b4-3763-b666-7917524d3a47",
                                                "text": "controminare un piano criminale"
                                            },
                                            {
                                                "example_id": "d9156da7-c361-45a4-91e5-cda90f649e3d",
                                                "sense_id": "75a7f18f-87b4-3763-b666-7917524d3a47",
                                                "text": "ci pare che un altro modo di controminare i danni del parlamentarismo (...) sarebbe di rendere alcuni Ministeri affatto tecnici, e sottratti ad ogni influenza di partito"
                                            }
