                        "tags": [],
                        "examples": [
                            {
                                "example_id": "006fb34a-9846-482c-999a-a762530221f5",
                                "sense_id": "eafdc4ff-3d1d-36f3-a942-2814bfb610e2",
                                "text": "Wenn mal die Fußbodenheizung ausfällt, können wir immer noch einen der Radiatoren anstellen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8cd7100-e2f5-3731-80ea-19c135136dbc",
                        "entry_id": "1a495bbe-6bf2-30f4-82c6-7f31fb5f1d71",
                        "glosses": [
                            "Radiateur automobile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c62b5d92-02be-43a2-926f-1e07ee8049df",
                                "sense_id": "d8cd7100-e2f5-3731-80ea-19c135136dbc",
                                "text": "Wenn der Motor arbeitet, entsteht durch die Kraftstoffverbrennung und Reibung enorme Wärme. Die Kühlflüssigkeit wird durch Kanäle im Motorblock geleitet, um die Wärme abzuführen. Danach wird das Kühlmittel im Radiator wieder abgekühlt."
                            }
                        ]
                    }
