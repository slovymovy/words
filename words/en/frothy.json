{
    "word_family": [
        "froth"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2d5370cc-532d-3685-a5e1-0b0e7eb07a51",
                    "sense_definition": "Full of or covered in small bubbles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bubbles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like my milkshakes <w>frothy</w>, not flat like this.",
                            "target_lang_translations": {
                                "de": "Ich mag meine Milchshakes <w>schaumig</w>, nicht so abgestanden wie diesen."
                            }
                        },
                        {
                            "text": "For a <w>frothy</w> result, blend the hot chocolate in batches.",
                            "target_lang_translations": {
                                "de": "Für ein <w>schaumiges</w> Ergebnis die heiße Schokolade portionsweise mixen."
                            }
                        }
                    ],
                    "synonyms": [
                        "foamy"
                    ],
                    "common_phrases": [
                        "frothy milk",
                        "frothy head"
                    ],
                    "target_lang_definitions": {
                        "de": "Voll von oder bedeckt mit kleinen Bläschen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schaumig",
                                "target_lang_sense_clarification": "mit Luftblasen angefüllt oder mit Schaum bedeckt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c806459d-17d4-385c-857d-884dcf4473f7",
                    "sense_definition": "Lacking serious depth or substance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "superficial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer performed several <w>frothy</w> pop songs with very little meaning.",
                            "target_lang_translations": {
                                "de": "Die Sängerin trug mehrere <w>oberflächliche</w> Popsongs ohne große Bedeutung vor."
                            }
                        },
                        {
                            "text": "He dismissed the entire debate as a <w>frothy</w> argument without any real evidence.",
                            "target_lang_translations": {
                                "de": "Er tat die gesamte Debatte als <w>gehaltloses</w> Argument ohne echte Beweise ab."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne ernsthafte Tiefe oder Substanz; oberflächlich."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "oberflächlich",
                                "target_lang_sense_clarification": "ohne inhaltliche Tiefe"
                            },
                            {
                                "target_lang_word": "gehaltlos",
                                "target_lang_sense_clarification": "ohne wirklichen Inhalt oder Substanz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26eb503c-4dd4-3c3f-84a5-c8de204acb3f",
                    "sense_definition": "Characterized by high risk and excessive speculation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "superficial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors were cautious about entering such a <w>frothy</w> market during the boom.",
                            "target_lang_translations": {
                                "de": "Investoren waren vorsichtig, während des Booms in einen derart <w>überhitzten</w> Markt einzusteigen."
                            }
                        },
                        {
                            "text": "Many <w>frothy</w> investment opportunities collapsed when the economy finally slowed down.",
                            "target_lang_translations": {
                                "de": "Viele <w>spekulative</w> Investitionsmöglichkeiten brachen zusammen, als sich die Wirtschaft schließlich abkühlte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "frothy market"
                    ],
                    "target_lang_definitions": {
                        "de": "Gekennzeichnet durch hohes Risiko und übermäßige Spekulation."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "überhitzt",
                                "target_lang_sense_clarification": "in Bezug auf einen Markt, der durch Spekulation überbewertet ist"
                            },
                            {
                                "target_lang_word": "spekulativ",
                                "target_lang_sense_clarification": "mit hohem Risiko verbunden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6bbb02a8-47fb-31c6-bbfb-a7600ba44d45",
                    "sense_definition": "A serving of beer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bubbles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ordered a couple of <w>frothies</w> after a long day at work.",
                            "target_lang_translations": {
                                "de": "Er bestellte sich nach einem langen Arbeitstag ein paar <w>Feierabendbiere</w>."
                            }
                        },
                        {
                            "text": "They sat at the bar enjoying their <w>frothies</w> while watching the game.",
                            "target_lang_translations": {
                                "de": "Sie saßen an der Bar und genossen ihr <w>Bier</w>, während sie das Spiel schauten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for beer."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Portion Bier."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bier",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für das Getränk"
                            },
                            {
                                "target_lang_word": "Feierabendbier",
                                "target_lang_sense_clarification": "umgangssprachlich für ein Bier nach der Arbeit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}