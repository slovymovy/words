                        "cross_references": [
                            {
                                "target_word": "Pastille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36e129df-2d23-3faf-87b1-f9125e270ecc",
                                        "entry_id": "4e1a9e2d-0665-35bc-a5be-2007f93d36e1",
                                        "glosses": [
                                            "Kügelchen aus einer eingedickten Tinktur zum Lutschen, das Heilmittel enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8b3465c-f76c-48d2-8aef-947bf1e3c94c",
                                                "sense_id": "36e129df-2d23-3faf-87b1-f9125e270ecc",
                                                "text": "Die Forscher nehmen an, dass die antiken Pastillen direkt auf die Augenlider aufgetragen wurden."
                                            },
                                            {
                                                "example_id": "8d91a46c-96dc-4d92-b931-860ef5cbb743",
                                                "sense_id": "36e129df-2d23-3faf-87b1-f9125e270ecc",
                                                "text": "Dazwischen liegen längere Phasen, in denen ich tabakabstinent bin, in dieser Zeit lutsche ich, wie am Fließband, Pastillen der Marke Fisherman’s Friend."
                                            },
                                            {
                                                "example_id": "800a8c97-677d-4ef9-b0e2-9bb96ac4183e",
                                                "sense_id": "36e129df-2d23-3faf-87b1-f9125e270ecc",
                                                "text": "Kramt noch mal und verteilt Emser Pastillen und Vitamin-C-Taler. Veronica Ferres ist eine Kümmerin."
                                            },
                                            {
                                                "example_id": "b0bec89d-caf0-4b01-a696-1bdc2d589426",
                                                "sense_id": "36e129df-2d23-3faf-87b1-f9125e270ecc",
                                                "text": "Wenn dagegen Aspirin-Tabletten, Hustensaft oder Pastillen über Tag eingenommen werden, gilt das Fasten nach Angaben des Religionsamtes als gebrochen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19c9d1e1-d7a0-3ce4-a3d5-ed7b9707f582",
                                        "entry_id": "4e1a9e2d-0665-35bc-a5be-2007f93d36e1",
                                        "glosses": [
                                            "kleines Bonbon zum Lutschen, das Zucker und Geschmacksstoffe enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47a036b8-8656-4c95-8c05-b82b3530a8cc",
                                                "sense_id": "19c9d1e1-d7a0-3ce4-a3d5-ed7b9707f582",
                                                "text": "Gleich hinter dem Trichter bringt das Fließband die nun mit Schokolade übergossenen Pastillen in den langen Kühlkanal, an dessen Ende sie von der zweiten Mitarbeiterin entgegengenommen und in Schachteln gefüllt werden."
                                            },
                                            {
                                                "example_id": "6199e8ee-e15e-4a8e-95b1-d88b067da710",
                                                "sense_id": "19c9d1e1-d7a0-3ce4-a3d5-ed7b9707f582",
                                                "text": "Etwas Chesterkäse in Silberpapier, dazu Droste-Schokoladenpastillen sollten mir über die Runden helfen."
                                            },
                                            {
                                                "example_id": "48d31fdb-62bc-4810-b320-77fdf61438fc",
                                                "sense_id": "19c9d1e1-d7a0-3ce4-a3d5-ed7b9707f582",
                                                "text": "Die kleinen Kubanerinnen drinnen gönnen ihren Brüderchen draußen nicht eine einzige Pastille aus den gelben Schachteln."
                                            },
                                            {
                                                "example_id": "661c6e31-064e-43ab-a9aa-185d35343dd3",
                                                "sense_id": "19c9d1e1-d7a0-3ce4-a3d5-ed7b9707f582",
                                                "text": "Für sein neues Diogenes-Buch sollte er sowohl einen Literaturpreis, das Bundesverdienstkreuz und die internationale Auszeichnung der unterhaltenden Süßwaren-Zucker-und-Salmiak-Pastillen-Industrie bekommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
