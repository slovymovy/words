                        "form": "die Vielheit"
                    },
                    {
                        "form_id": "bee24f21-5e74-475e-b869-5ca9501d980c",
                        "entry_id": "6b9e34d2-b142-3ec4-a526-03c5f909b539",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vielheiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8cf9fca7-0912-37f1-8048-3ec3da6cfb58",
                        "entry_id": "6b9e34d2-b142-3ec4-a526-03c5f909b539",
                        "glosses": [
                            "große Anzahl, Menge"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "a319ef28-15cf-48a5-be31-ba992531fe13",
                                "sense_id": "8cf9fca7-0912-37f1-8048-3ec3da6cfb58",
                                "text": "Es gibt eine Vielheit von Menschen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9eb66ed9-d835-31cb-916e-3d6fb7ad864a",
                        "entry_id": "6b9e34d2-b142-3ec4-a526-03c5f909b539",
                        "glosses": [
                            "apriorischer Begriff der Menge von Einzeldingen"
                        ],
                        "tags": [
                            "Kategorienlehre"
                        ],
                        "examples": [
                            {
                                "example_id": "08fe7a3c-6dfb-4447-a235-408a7221bdab",
                                "sense_id": "9eb66ed9-d835-31cb-916e-3d6fb7ad864a",
                                "text": "„So hat er sich zu einer Welt der Vielheit zersplittert.“"
                            },
                            {
                                "example_id": "b682d220-7adc-4201-a7c5-fdeb3eb406b5",
                                "sense_id": "9eb66ed9-d835-31cb-916e-3d6fb7ad864a",
                                "text": "„Dem Abstieg des Lebens von oben nach unten folgt der Aufstieg von unten nach oben, bis schließlich alle Dinge nach dem Dasein in der Vielheit der Welt wiederum heimkehren zur ‚seligmachenden Wiedervereinigung‘, zur Einheit mit dem göttlichen Ursprung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c53b98a-a472-475c-b801-98a69b147aeb",
                        "source_entry_id": "6b9e34d2-b142-3ec4-a526-03c5f909b539",
                        "source_sense_id": "8cf9fca7-0912-37f1-8048-3ec3da6cfb58",
                        "source_sense_description": "allgemein: große Anzahl, Menge",
                        "target_lang_word": "multiplicity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiplicity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82c63e65-e954-3f57-ab30-e821b807d90b",
                                        "entry_id": "5c3da05c-80bc-3313-876a-97b96d421b10",
                                        "glosses": [
                                            "The state of being made of multiple diverse elements."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0420795-8100-4c0b-8c9b-e8da78dfbcee",
                                                "sense_id": "82c63e65-e954-3f57-ab30-e821b807d90b",
                                                "text": "Without consideration of the colony character of Malaysia in terms of its consistent interculturation with imperial and neoimperial power, multiplicity can easily be mistheorised as representing Saidian Orientalism or expatriates—such theorisations can be drawn from superficial reinterpretations of Taiwan's Tenryuubito phenomenon in recent years and Japan's Datsu-A Ron statement during the Meiji period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40e87684-d77d-3ea4-827a-97b3cfa1af03",
                                        "entry_id": "5c3da05c-80bc-3313-876a-97b96d421b10",
                                        "glosses": [
                                            "A large indeterminate number."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e0bf12-9bcf-4cfc-b5b8-ebefabebc55d",
                                                "sense_id": "40e87684-d77d-3ea4-827a-97b3cfa1af03",
                                                "text": "The coronary Thorns did not only express the scorn of the imposers, by that figure into which they were contrived; but did also pierce his tender and sacred temples to a multiplicity of pains, by their numerous acuminations."
                                            },
                                            {
                                                "example_id": "be15732c-3626-4846-97bb-7dc63468cf18",
                                                "sense_id": "40e87684-d77d-3ea4-827a-97b3cfa1af03",
                                                "text": "They saddled themselves with the handling of light flows on a multiplicity of branch lines, and they sacrificed the speed, reliability and low cost of through train operation, even over the main arteries of the system."
                                            },
                                            {
                                                "example_id": "7ba4ad46-c724-4a3a-b231-61547c1c032b",
                                                "sense_id": "40e87684-d77d-3ea4-827a-97b3cfa1af03",
                                                "text": "The combined events — the negotiations and the benefit — were a major step in addressing the multiplicity of concerns the group had been talking about for all those years at Doyles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54753f0a-5d32-3df9-93e4-03b5f82588dd",
                                        "entry_id": "5c3da05c-80bc-3313-876a-97b96d421b10",
                                        "glosses": [
                                            "The number of values for which a given condition holds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7457fdfc-293f-36c7-8429-b238f2e1f3b2",
                                        "entry_id": "5c3da05c-80bc-3313-876a-97b96d421b10",
                                        "glosses": [
                                            "The number of instances that can occur on a given end of a relationship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2bd16746-635c-33ed-a4e4-6b930bac82ab",
                                        "entry_id": "5c3da05c-80bc-3313-876a-97b96d421b10",
                                        "glosses": [
                                            "The number of microstates associated with a given macrostate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6757eff-8cee-41cf-916a-e37497f6be2e",
                                                "sense_id": "2bd16746-635c-33ed-a4e4-6b930bac82ab",
                                                "text": "In short , we are not replacing the old idea that “entropy is the logarithm of the multiplicity (times Boltzmann's constant). ” Rather , we are retaining that idea but are generalizing the notion of multiplicity."
                                            },
                                            {
                                                "example_id": "fbb6a8d6-58c4-4182-87de-ac211336b921",
                                                "sense_id": "2bd16746-635c-33ed-a4e4-6b930bac82ab",
                                                "text": "... the maximum-entropy (maxent) solution is the one which occurs with greatest multiplicity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adc3ff74-74ef-35ec-943c-762cf20b23f4",
                                        "entry_id": "5c3da05c-80bc-3313-876a-97b96d421b10",
                                        "glosses": [
                                            "The condition whereby a person displays or experiences multiple distinct personalities or selves in one body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d97e9f19-2602-43d7-af0e-f5f5acbc47e2",
                        "source_entry_id": "6b9e34d2-b142-3ec4-a526-03c5f909b539",
                        "source_sense_id": "8cf9fca7-0912-37f1-8048-3ec3da6cfb58",
                        "source_sense_description": "allgemein: große Anzahl, Menge",
                        "target_lang_word": "multitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                        "entry_id": "01e605a7-d50d-340b-8789-d82a4cf3cc48",
                                        "glosses": [
                                            "A great amount or number, often of people; abundance, myriad, profusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a7adbe-eba6-499a-85f5-c8abd1cc77ee",
                                                "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                                "text": "Do I contradict myself? / Very well then I contradict myself, / (I am large, I contain multitudes.)"
                                            },
                                            {
                                                "example_id": "d048a759-0609-44e2-a932-40eb57a6bad0",
                                                "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                                "text": "A torrential rain poured down from the floodgates of the angry heavens upon the bared heads of the assembled multitude which numbered at the lowest computation five hundred thousand persons."
                                            },
                                            {
                                                "example_id": "b86d6253-c4ab-4e23-a9b8-e029c4fb8f52",
                                                "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                                "text": "On the other hand, to arrive after dusk, when the multitude of garish little public-houses are lit up, giving glimpses of crowded jostling bars and taprooms, is an introduction to a fine city well calculated to affect even the most nonchalant."
                                            },
                                            {
                                                "example_id": "13f28a42-51a2-4cee-9e71-33842e62922f",
                                                "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                                "text": "We found Pop Glossop in his pantry polishing silver, and put in our order. He seemed a little surprised at the inrush of such a multitude, but on learning that our tongues were hanging out obliged with a bottle of the best […]"
                                            },
                                            {
                                                "example_id": "c1bff754-c375-43df-8ae3-ff408bd98ff2",
                                                "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                                "text": "Ever since El Martinez started asking to be called by the gender-neutral pronouns “they/them” in the ninth grade, they have fielded skepticism in a variety of forms and from a multitude of sources about what it means to identify as nonbinary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5433a94b-7540-31da-ac9d-ca7d9e42effb",
                                        "entry_id": "01e605a7-d50d-340b-8789-d82a4cf3cc48",
                                        "glosses": [
                                            "The mass of ordinary people; the masses, the populace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "291d4a46-abf3-4795-a52a-bd68769bc076",
                                                "sense_id": "5433a94b-7540-31da-ac9d-ca7d9e42effb",
                                                "text": "Thou shalt not follow a multitude to do evil"
                                            },
                                            {
                                                "example_id": "4f319a4a-4bcd-4a65-947e-96fb7f616c8e",
                                                "sense_id": "5433a94b-7540-31da-ac9d-ca7d9e42effb",
                                                "text": "Along with its natural protectors and guardians, learning will be caſt into the mire and trodden down under the hoofs of a ſwiniſh multitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e25a403-53e1-444d-8c7f-2a373c00e844",
                        "source_entry_id": "6b9e34d2-b142-3ec4-a526-03c5f909b539",
                        "source_sense_id": "8cf9fca7-0912-37f1-8048-3ec3da6cfb58",
                        "source_sense_description": "allgemein: große Anzahl, Menge",
                        "target_lang_word": "multitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b193eb52-1a64-377d-8d8e-5c084f268143",
                                        "entry_id": "fe4bd2d0-9516-3cbc-abb7-fd986f689f35",
                                        "glosses": [
                                            "Grand nombre."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "324e880e-b17d-42a6-9bda-0471d96ae756",
                                                "sense_id": "b193eb52-1a64-377d-8d8e-5c084f268143",
                                                "text": "Ce gouvernement était fédératif ; c'est-à-dire que la Gaule était divisée en une multitude de petits états indépendants, ayant leur vie propre, et ne se rattachant les uns aux autres que par une association peu étroite."
                                            },
                                            {
                                                "example_id": "470fa352-9418-46dc-b884-18476540b782",
                                                "sense_id": "b193eb52-1a64-377d-8d8e-5c084f268143",
                                                "text": "Les vestiges du culte primitif et du druidisme sont assez rares, grâce au zèle des chrétiens des premiers siècles, qui renversèrent, brisèrent et enfouirent une multitude de pierres-fittes."
                                            },
                                            {
                                                "example_id": "117cb231-fed0-40b5-b29d-bca9b5c1f4e7",
                                                "sense_id": "b193eb52-1a64-377d-8d8e-5c084f268143",
                                                "text": "Des multitudes d’hommes allaient et venaient ; la plupart, en treillis, travaillaient aux aérostats ; d’autres en uniforme brun faisaient l’exercice."
                                            },
                                            {
                                                "example_id": "e0247d8c-09ba-4247-ad0a-62b8c50ee319",
                                                "sense_id": "b193eb52-1a64-377d-8d8e-5c084f268143",
                                                "text": "La commune peut ne comprendre qu'un chef-lieu, […], ou, un chef-lieu et une multitude d'écarts (maisons isolées, groupements élémentaires et localités autres que le chef-lieu…), dans le pays bocager aux allures de Puisaye. Lorris n'en compte pas moins de 83 et Montereau 111."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a99b9805-16ab-3f5e-a0ed-26b53a5f3672",
                                        "entry_id": "fe4bd2d0-9516-3cbc-abb7-fd986f689f35",
                                        "glosses": [
                                            "La masse du peuple."
                                        ],
                                        "tags": [
                                            "collective",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91ea7439-36a4-4174-983f-197d4a80397d",
                                                "sense_id": "a99b9805-16ab-3f5e-a0ed-26b53a5f3672",
                                                "text": "Je fis entendre à la multitude que, si on nous tuait, ces huit prisonniers seraient mis à mort."
                                            },
                                            {
                                                "example_id": "2067b4a8-7046-4386-baf6-c963eef0dc38",
                                                "sense_id": "a99b9805-16ab-3f5e-a0ed-26b53a5f3672",
                                                "text": "Othon choisit la toque et alla s’agenouiller devant la princesse, au milieu d’une triple acclamation de la multitude."
                                            },
                                            {
                                                "example_id": "44debcf9-7c9f-45ca-ba13-15eaf076ae30",
                                                "sense_id": "a99b9805-16ab-3f5e-a0ed-26b53a5f3672",
                                                "text": "Pendant que des mortels la multitude vile\nSous le fouet du Plaisir, ce bourreau sans merci,\nVa cueillir des remords dans la fête servile,\nMa Douleur, donne-moi la main; viens par ici…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efc27bd2-012d-40a2-b9b7-be16e448c144",
                        "source_entry_id": "6b9e34d2-b142-3ec4-a526-03c5f909b539",
                        "source_sense_id": "8cf9fca7-0912-37f1-8048-3ec3da6cfb58",
                        "source_sense_description": "allgemein: große Anzahl, Menge",
                        "target_lang_word": "множество",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "множество",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "99964528-ae3d-30ac-acc8-0bf36b6dac85",
                                        "entry_id": "fb982f3c-b0e2-32ac-ba65-8c7e218f6f2f",
                                        "glosses": [
                                            "большое количество, изобилие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00bdd021-2a38-44e5-a5f7-37e659525640",
                                                "sense_id": "99964528-ae3d-30ac-acc8-0bf36b6dac85",
                                                "text": "В ау́ле мно́жество соба́к встре́тило нас гро́мким ла́ем."
                                            },
                                            {
                                                "example_id": "7e939292-4d97-4678-aad9-8939ba02b89b",
                                                "sense_id": "99964528-ae3d-30ac-acc8-0bf36b6dac85",
                                                "text": "Более же всего имейте усердную любовь друг ко другу, потому что любовь покрывает множество грехов."
                                            },
                                            {
                                                "example_id": "8cd8d0dc-fc1a-4ab3-9905-f27140c9b658",
                                                "sense_id": "99964528-ae3d-30ac-acc8-0bf36b6dac85",
                                                "text": "Кругом теснилось множество народу, впереди всех полицейские."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9ac7a2f-0c84-3e17-9e5e-63e8b720850e",
                                        "entry_id": "fb982f3c-b0e2-32ac-ba65-8c7e218f6f2f",
                                        "glosses": [
                                            "матем. совокупность, результат объединения объектов по определённому признаку, свойству"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b219ac39-da51-47dc-bc1a-b373844c6444",
                                                "sense_id": "c9ac7a2f-0c84-3e17-9e5e-63e8b720850e",
                                                "text": "По определению, пустое множество также относят к классу перечислимых."
                                            },
                                            {
                                                "example_id": "47c3ca88-2766-4c3f-817a-de99ef7edd9c",
                                                "sense_id": "c9ac7a2f-0c84-3e17-9e5e-63e8b720850e",
                                                "text": "Например, подмножеств множества натуральных чисел бесконечно много, и самих натуральных чисел бесконечно много."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2e06259-36af-3351-94e6-378ae2e4fd21",
                                        "entry_id": "fb982f3c-b0e2-32ac-ba65-8c7e218f6f2f",
                                        "glosses": [
                                            "матем., универсальная алгебра вырожденная алгебраическая система с пустым набором операций и отношений"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
