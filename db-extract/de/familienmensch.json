                        "sense_id": "6e93e558-739f-3c4b-9426-03363aeb8e7e",
                        "entry_id": "bdafed13-ca37-348c-afcd-873286e6d414",
                        "glosses": [
                            "Person, der die eigene Familie sehr wichtig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "274d15d3-dca1-400d-bee7-51e8f6535729",
                                "sense_id": "6e93e558-739f-3c4b-9426-03363aeb8e7e",
                                "text": "Hätte man es für möglich gehalten, dass Otto, der Einzelbrödler, nach der Heirat zu einem richtigen Familienmensch wird? Ich glaube nicht!"
                            },
                            {
                                "example_id": "b94e06c7-ac01-481d-b961-fd9dfd3590cb",
                                "sense_id": "6e93e558-739f-3c4b-9426-03363aeb8e7e",
                                "text": "„Klaus war ein Familienmensch, und da er als Kind nie ein richtiges Elternhaus gekannt hatte, wollte er das nun für seine drei Kinder schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
