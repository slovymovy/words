                        ]
                    },
                    {
                        "translation_id": "d80bfa6a-e8e0-41c0-8bf5-4b8b3ee59ad8",
                        "source_entry_id": "670198df-e179-3741-b8a0-3e74abe8862d",
                        "source_sense_id": "9f29b1e7-9447-30c5-9952-1b2d8417692f",
