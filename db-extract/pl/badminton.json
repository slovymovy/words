                    {
                        "translation_id": "3a75bf77-452f-40a2-a045-179b7e03aaa0",
                        "source_entry_id": "90d2e9c5-5c44-36c3-b6f7-8e8e97e51409",
                        "source_sense_id": "b43be818-18ff-3c12-91b8-45b143f7d210",
                        "target_lang_word": "Badminton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Badminton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c635dc0-1641-3f0b-b8c8-54b94161d7a9",
                                        "entry_id": "c6976830-4e44-312a-9218-91efcdffb770",
                                        "glosses": [
                                            "Wettkampfvariante des Hobbysports Federball; ein sportliches Ballspiel, welches als Rückschlagspiel mit einem kleinen Federball, dem so genannten Shuttlecock und jeweils einem Badmintonschläger pro Person gespielt wird."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "595dc97f-976d-489b-9471-eee239120784",
                                                "sense_id": "6c635dc0-1641-3f0b-b8c8-54b94161d7a9",
                                                "text": "Wer gerne Badminton spielt – und dies mit richtigen Federbällen, tut gut daran, sich nun ein ordentliches Vorratslager anzuschaffen. (focus.msn.de)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbd3ec9f-6650-4e41-a2ea-3b698cd131f3",
                        "source_entry_id": "90d2e9c5-5c44-36c3-b6f7-8e8e97e51409",
                        "source_sense_id": "b43be818-18ff-3c12-91b8-45b143f7d210",
                        "target_lang_word": "бадминтон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бадминтон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "940185b8-8860-348d-a814-ddbfb6379faf",
                                        "entry_id": "59d662e8-0b5c-3973-9919-5effc93ba342",
                                        "glosses": [
                                            "вид спорта, спортивная игра, состоящая в перебрасывании ракетками волана через натянутую сетку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b650030-ac66-4cf0-8db2-c96d9e7eb198",
                                                "sense_id": "940185b8-8860-348d-a814-ddbfb6379faf",
                                                "text": "Настоящий бадминтон — это небольшая площадка, сетка, натянутая на высоте полтора метра, и скорость волана — 250 километров в час."
                                            },
                                            {
                                                "example_id": "8fffa3e4-88d4-49f9-b3e4-80ba659054aa",
                                                "sense_id": "940185b8-8860-348d-a814-ddbfb6379faf",
                                                "text": "В настоящее время бадминтон является одной из самых распространённых в мире спортивных игр."
                                            },
                                            {
                                                "example_id": "28bafff7-5b75-42ec-8b1c-a1ac771deb98",
                                                "sense_id": "940185b8-8860-348d-a814-ddbfb6379faf",
                                                "text": "Играть в бадминтон можно вдвоём или вчетвером."
                                            },
                                            {
                                                "example_id": "8d65c7bc-e2e4-4f80-9c39-3047cb487abe",
                                                "sense_id": "940185b8-8860-348d-a814-ddbfb6379faf",
                                                "text": "Бадминтон — игра быстрая, подвижная, азартная и резкая, заставляющая игроков проделывать стремительные перемещения по площадке в сочетании с резкими разворотами и прыжками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edce9c28-e609-3c46-ae66-acf05397dfaa",
                                        "entry_id": "59d662e8-0b5c-3973-9919-5effc93ba342",
                                        "glosses": [
                                            "разг. народная подвижная игра, в которой участники с помощью ракеток перебрасываются воланом без сетки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "572fcbe7-064f-4159-9f50-62659172c892",
                                                "sense_id": "edce9c28-e609-3c46-ae66-acf05397dfaa",
                                                "text": "Необыкновенно демократичная игра бадминтон. Две ракетки, воланчик — и можно считать удары: сколько раз перебросишь волан, не уронив на землю. Спортивный бадминтон сложнее. Есть определённого размера площадка, сетка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
