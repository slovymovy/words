                ],
                "senses": [
                    {
                        "sense_id": "ab0900f0-ddef-3e8f-b3cf-ab1df110ee7e",
                        "entry_id": "80d75646-6dda-385b-ba40-d5b3fb733044",
                        "glosses": [
                            "Habitant ou habitante de la ville du Caire, en Égypte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3588a83-ea5a-439b-b533-a68336aebd32",
                                "sense_id": "ab0900f0-ddef-3e8f-b3cf-ab1df110ee7e",
                                "text": "Je rappelle qu’en décembre 2014, une délégation de quinze très hauts gradés du Caire étaient venus discuter à Paris, ce qui était exceptionnel : quinze, c’est le double d’une délégation normale, d'habitude, les Cairotes sont qu’huit."
                            },
                            {
                                "example_id": "788c5f64-c87a-418f-a20f-e783729c6dcc",
                                "sense_id": "ab0900f0-ddef-3e8f-b3cf-ab1df110ee7e",
                                "text": "Cette ligne avait tout d’abord été tracée à partir de la grande gare de Bab El-Hadid, elle passait par Abbasseïa et arrivait au Midan où les Cairotes s‘embarquaient pour se rendre à la nouvelle cité de Hélouan-les-Bains."
                            }
                        ]
                    }
