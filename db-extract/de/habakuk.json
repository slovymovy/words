                        "source_sense_id": "d10ce3df-38a0-3590-97cd-99d5c2151a25",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Habakkuk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Habakkuk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76b9bfa7-b263-3294-ba48-77f43f4e6af3",
                                        "entry_id": "7e81c031-2b34-3a83-9f4e-7bb64a52df10",
                                        "glosses": [
                                            "A prophetic book in the Old Testament of the Bible, one of the minor prophets; or the eighth part of the Tere Asar in the Jewish Tanakh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484f739f-750b-4bdc-874b-ff9ebead8280",
                                                "sense_id": "76b9bfa7-b263-3294-ba48-77f43f4e6af3",
                                                "text": "1988, Robert D. Haak, \"\"Poetry\" in Habakkuk 1:1–2:4?\". Journal of the American Oriental Society 108 (3): 437–444.\nThe present study concentrates on the various types of parallelism which may be observed within the prophetic text Habakkuk 1:1–2:4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ced1341-190a-3b6f-9edd-e285581a851c",
                                        "entry_id": "7e81c031-2b34-3a83-9f4e-7bb64a52df10",
                                        "glosses": [
                                            "A Jewish prophet of the Old Testament; author of the book that bears his name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a333c1-97a9-4103-94af-85f283ca72a7",
                                                "sense_id": "9ced1341-190a-3b6f-9edd-e285581a851c",
                                                "text": "Of Habakkuk's personal life nothing is known with certainty, though it has been inferred, from the fact that he is termed specifically 'the prophet,' that he held a recognized position as prophet[…], and belonged, consequently, to the tribe of Levi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe1a3cb8-b4a6-3f68-b389-2e27dfb8619c",
                                        "entry_id": "7e81c031-2b34-3a83-9f4e-7bb64a52df10",
                                        "glosses": [
                                            "A male given name from Hebrew of biblical origin."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcbe483f-6381-4714-9304-359763f99ed0",
                                                "sense_id": "fe1a3cb8-b4a6-3f68-b389-2e27dfb8619c",
                                                "text": "It would be Bowditch's last voyage. He had been lucky: a younger brother William died on a voyage to Trinidad in 1799, and an older brother Habakkuk drowned in Boston Harbor in 1800."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
