                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd838905-68fa-4939-a10c-a51610ec27d5",
                                "sense_id": "9ce2a5ae-4306-3d39-bd96-9a4294a5e1b1",
                                "text": "Het werd zoo stil als in de middagkerk, temeer omdat het Spaarne Zondags bijna niet door groote schepen werd bevaren, er zelden of nooit een vroolijk 'brug omhoog!' weêrklonk."
                            },
                            {
                                "example_id": "77ea7af6-81d0-405b-8db5-7fc354450fac",
                                "sense_id": "9ce2a5ae-4306-3d39-bd96-9a4294a5e1b1",
                                "text": "Bij het kerkgangetje Zondagsmorgens, want Jaap ging 's middags, 'binnen-door' reeds mee naar de middagkerk, wanneer om kwart-over-negenen de reek de straat uitkwam, over de brug naar 't huis van Jan de Lapper, keek hij meestal naar de drukkerij-kant uit of waar de schepen met bedekte ruimen druilden of waar een schipper in zijn bonte boezeroen op-sloffen aan de walkant 'Sting'."
                            }
                        ]
                    }
