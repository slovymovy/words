                "senses": [
                    {
                        "sense_id": "5af9254a-70ce-363d-b047-1fae17627b7e",
                        "entry_id": "ef4314e7-9b69-3408-91c1-f1204a6c4315",
                        "glosses": [
                            "Wörterbuch, das in der Bevölkerung große Verbreitung und großen Anklang findet; Wörterbuch, das für die breite Bevölkerung geschrieben ist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5909133-2996-4c89-b51d-695f38937a46",
                                "sense_id": "5af9254a-70ce-363d-b047-1fae17627b7e",
                                "text": "Der \"Rechtschreib-Duden\" wird oft als Volkswörterbuch bezeichnet."
                            },
                            {
                                "example_id": "777aef37-e38a-4aa8-9825-c4b3ae1d300f",
                                "sense_id": "5af9254a-70ce-363d-b047-1fae17627b7e",
                                "text": "„Als Propagandainstrument waren die Volkswörterbücher viel brauchbarer.“"
                            },
                            {
                                "example_id": "05266330-4dda-456c-ab02-81581c171c15",
                                "sense_id": "5af9254a-70ce-363d-b047-1fae17627b7e",
                                "text": "„Im Laufe der Zeit ist aus einem bescheidenen Wörterverzeichnis das deutsche ›Volkswörterbuch‹ schlechthin hervorgegangen.“"
                            },
                            {
                                "example_id": "d0db29e8-eb22-4d7f-918a-86bbafcfdad0",
                                "sense_id": "5af9254a-70ce-363d-b047-1fae17627b7e",
                                "text": "„Sie stellten dabei die von Christoph Landolt erarbeitete Machbarkeitsstudie zum Projekt eines Kurz- oder Volkswörterbuchs des Idiotikons vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "93bd86f5-1340-3dcd-91a6-b8fb75765afb",
                        "entry_id": "ef4314e7-9b69-3408-91c1-f1204a6c4315",
                        "glosses": [
                            "Wörterbuch, das sich der Sprache des Volkes widmet, womit sprachliche Varietäten wie Dialekte gemeint sind."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84053e3a-a6cc-4f2e-baaa-ca935a0df306",
                                "sense_id": "93bd86f5-1340-3dcd-91a6-b8fb75765afb",
                                "text": "„Sie stellten dabei die von Christoph Landolt erarbeitete Machbarkeitsstudie zum Projekt eines Kurz- oder Volkswörterbuchs des Idiotikons vor.“"
                            },
                            {
                                "example_id": "36d608d3-10b0-4d7e-87d1-c72f63ca4e78",
                                "sense_id": "93bd86f5-1340-3dcd-91a6-b8fb75765afb",
                                "text": "Die Bezeichnung \"Hessen-nassauisches Volkswörterbuch\" weist auf eine regionale Varietät des Deutschen hin."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
