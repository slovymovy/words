                "senses": [
                    {
                        "sense_id": "f79b5db9-4cc9-3fe1-8997-5db97a2a4243",
                        "entry_id": "fb5c2154-cc2c-30a6-9b09-589b52852a8b",
                        "glosses": [
                            "Wirtschaftszweig, der sich mit öffentlichen, das Publikum unterhaltenden, Darbietungen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb7a6f4-eec1-4dfb-b7c2-12b0dae1fbc5",
                                "sense_id": "f79b5db9-4cc9-3fe1-8997-5db97a2a4243",
                                "text": "Sie ist als Musikerin seit mehr als 20 Jahren im Showgeschäft und weiß, was das Publikum verlangt."
                            },
                            {
                                "example_id": "024b54cf-a12f-4bef-953c-304f5bf67d42",
                                "sense_id": "f79b5db9-4cc9-3fe1-8997-5db97a2a4243",
                                "text": "„Nach insgesamt drei Jahren der Selbstkasteiung versuchte ich mein Glück im Showgeschäft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abc98d0d-e8e3-4f01-a866-583f7ef92f7f",
                        "source_entry_id": "fb5c2154-cc2c-30a6-9b09-589b52852a8b",
                        "source_sense_id": "f79b5db9-4cc9-3fe1-8997-5db97a2a4243",
                        "source_sense_description": "Wirtschaftszweig, der sich mit öffentlichen, das Publikum unterhaltenden, Darbietungen befasst",
                        "target_lang_word": "spectacle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spectacle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d4ea04a-5738-3563-9e05-d8c7d0ecad6c",
                                        "entry_id": "b6591b00-80a6-3a84-a7cb-149f3f166a41",
                                        "glosses": [
                                            "Vue d’ensemble qui attire les regards, l’attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba36700a-378b-490e-8522-a60b616ae3fa",
                                                "sense_id": "9d4ea04a-5738-3563-9e05-d8c7d0ecad6c",
                                                "text": "Et, vivement impressionné par la noblesse réelle du spectacle, je ne pus m’empêcher de mêler ma voix aux acclamations enthousiastes des croyants prosternés."
                                            },
                                            {
                                                "example_id": "5939939d-6bd0-472a-b6c2-2f6958688e23",
                                                "sense_id": "9d4ea04a-5738-3563-9e05-d8c7d0ecad6c",
                                                "text": "[…], Henri dégusta, quelques secondes, le spectacle désolant de ces ombres errantes et pataugeantes, semblables à des bêtes d’un autre âge, grouillant dans un décor diluvien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aa44c96-3029-38f1-be6f-61e6ef1e7aa7",
                                        "entry_id": "b6591b00-80a6-3a84-a7cb-149f3f166a41",
                                        "glosses": [
                                            "Divertissement offert au public, et particulièrement de la représentation d’une pièce de théâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "632494c8-2937-4321-96e8-350588b3814e",
                                                "sense_id": "1aa44c96-3029-38f1-be6f-61e6ef1e7aa7",
                                                "text": "Ce n’est pas un spectacle extraordinaire à Saint-Louis que de voir deux hommes « respectables » mettre habit bas et se colleter publiquement."
                                            },
                                            {
                                                "example_id": "bfa626e1-f0f1-4385-bd50-aba0ae5e6b20",
                                                "sense_id": "1aa44c96-3029-38f1-be6f-61e6ef1e7aa7",
                                                "text": "À Rochechouard, « Médrano », a rajeuni le cirque Fernando, et dans le souvenir du clown Boum-Boum, a trouvé un heureux déroulement de spectacle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ee326d-50e4-323c-a336-8603a476cc9d",
                                        "entry_id": "b6591b00-80a6-3a84-a7cb-149f3f166a41",
                                        "glosses": [
                                            "Manifestation publique remarquable ou admirable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "669e1df9-f387-4cbf-a693-33bbd83724d4",
                                                "sense_id": "12ee326d-50e4-323c-a336-8603a476cc9d",
                                                "text": "La célébration du mouloud, de la nativité du Prophète, à laquelle je viens d’assister, fut un beau spectacle surtout en raison du temps superbe dont il a été favorisé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
