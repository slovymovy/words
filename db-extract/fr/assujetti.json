                    {
                        "sense_id": "c7bce4b2-3037-3ee3-b851-c430a66a12cc",
                        "entry_id": "e60d9805-5399-3b3f-916b-8fe09ed7efa3",
                        "glosses": [
                            "Personne redevable d’une taxe, d’un impôt par son activité économique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd95843c-f036-4d3f-a10d-0a6bbb95a17d",
                                "sense_id": "c7bce4b2-3037-3ee3-b851-c430a66a12cc",
                                "text": "Tous les assujettis à l’impôt sur le revenu s’acquitteront, en 2018 de leur impôt…"
                            },
                            {
                                "example_id": "9331b1b3-11db-4ac6-9654-48e6f696a6b7",
                                "sense_id": "c7bce4b2-3037-3ee3-b851-c430a66a12cc",
                                "text": "L’année de référence est alors établie par les assujettis sur la base de données de consommation objectives et ne peut être antérieure à 2010 ; à défaut, l’année de référence sera celle de la première année d’exploitation postérieure à 2010, correspondant à une durée de douze mois consécutifs."
                            }
                        ]
                    },
