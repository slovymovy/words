                "senses": [
                    {
                        "sense_id": "cdff5086-4e58-3272-9ff5-e3ead4dcc743",
                        "entry_id": "76543f1e-8c9c-37ea-ab4a-f3dfd5d5199e",
                        "glosses": [
                            "начать белеть, становясь белым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056b7311-cff8-4f0f-b225-977ebfd45212",
                                "sense_id": "cdff5086-4e58-3272-9ff5-e3ead4dcc743",
                                "text": "Страстная площадь вдруг забелела от тысяч листков — правительственное сообщение."
                            }
                        ]
                    },
                    {
                        "sense_id": "61219285-3542-3f8e-b1bf-1494c0417076",
                        "entry_id": "76543f1e-8c9c-37ea-ab4a-f3dfd5d5199e",
                        "glosses": [
                            "выделиться белым цветом, стать заметным благодаря своему белому цвету"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e558ae-9b4e-41c2-9eef-ab017f8a594c",
                                "sense_id": "61219285-3542-3f8e-b1bf-1494c0417076",
                                "text": "На четвёртый день забелели издали паруса, как стадо пеликанов."
                            },
                            {
                                "example_id": "2e9c3a80-2cbb-4220-8477-64751cefac86",
                                "sense_id": "61219285-3542-3f8e-b1bf-1494c0417076",
                                "text": "Впереди направо, в сизой дали, забелели далёкие горы."
                            }
                        ]
                    }
                ],
