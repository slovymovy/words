                                            {
                                                "example_id": "fd3228dc-79fc-4807-a246-21ffd94df48f",
                                                "sense_id": "4e5dea34-4114-3bc1-b1e7-51b468e62c14",
                                                "text": "De wetenschap die zich bezighoudt met het onderzoeken en interpreteren van dromen heet ‘oneirologie’."
                                            }
