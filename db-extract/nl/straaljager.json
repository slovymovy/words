                "translations": [
                    {
                        "translation_id": "c7354f89-abf6-4afb-ac6e-3b85c9838159",
                        "source_entry_id": "5e7b5215-053f-3f90-ab97-58cdad28bd14",
                        "source_sense_id": "6860b2f3-5c06-3990-974b-dfce45db950c",
                        "source_sense_description": "jachtvliegtuig met straalmotor",
                        "target_lang_word": "Düsenjäger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Düsenjäger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c183d958-5059-30ef-bc10-294b700c94ec",
                                        "entry_id": "e0deac5b-af69-3496-95db-a4e0b256a4a8",
                                        "glosses": [
                                            "ein Militärflugzeug mit Düsenantrieb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d9bfee-46a1-4f8f-99a9-a8f5a30975be",
                                                "sense_id": "c183d958-5059-30ef-bc10-294b700c94ec",
                                                "text": "Die Düsenjäger haben zwei feindliche Flugobjekte in der Luft abgefangen."
                                            },
                                            {
                                                "example_id": "9eda26e8-ce58-4948-96bf-700e5c96677b",
                                                "sense_id": "c183d958-5059-30ef-bc10-294b700c94ec",
                                                "text": "„Pilz hat diese Woche gefordert, die Eurofighter an EADS zurückzugeben, notfalls per Bahnfracht, weil nur noch drei der 15 Düsenjäger überhaupt flugfähig seien.“"
                                            },
                                            {
                                                "example_id": "2049d527-36bd-4f62-b45e-519a034ea380",
                                                "sense_id": "c183d958-5059-30ef-bc10-294b700c94ec",
                                                "text": "„Als er mit seinem Düsenjäger vom Typ Me 262 im Sturzflug einem Kameraden zu Hilfe kommen wollte, habe er typische Überschalleffekte gespürt. Bolzen seien aus den Tragflächen geflogen, der Fahrtmesser sei bei 1100 Kilometern pro Stunde stehen geblieben.“"
                                            },
                                            {
                                                "example_id": "ad256be6-1a5a-4775-9f27-0cf52aa2abce",
                                                "sense_id": "c183d958-5059-30ef-bc10-294b700c94ec",
                                                "text": "„Düsenjäger kamen übers Meer mit unheimlichem Lärm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
