                },
                {
                    "sense_id": "736713ca-6bc5-3e1a-91d8-ce2bab8ec1a4",
                    "sense_definition": "Совокупность ценных бумаг, заказов, страховых договоров или других активов, имеющихся у компании или инвестора.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Инвестор решил разнообразить свой инвестиционный <w>портфель</w> акциями технологических компаний.",
                            "target_lang_translations": {
                                "en": "The investor decided to diversify his investment <w>portfolio</w> with stocks of technology companies.",
                                "de": "Der Investor beschloss, sein <w>Anlageportfolio</w> mit Aktien von Technologieunternehmen zu diversifizieren."
                            }
                        },
                        {
                            "text": "В прошлом году <w>портфель</w> заказов завода значительно увеличился.",
                            "target_lang_translations": {
                                "en": "Last year, the factory's order <w>portfolio</w> increased significantly.",
                                "de": "Im vergangenen Jahr hat sich das <w>Auftragsportfolio</w> des Werks erheblich vergrößert."
                            }
                        }
                    ],
