                        "examples": [
                            {
                                "example_id": "82b580d6-4e19-473e-be45-23c98c4ef123",
                                "sense_id": "9e5b1716-f005-35a4-b63f-bca4a4f4a2f9",
                                "text": "Старик отворотился и проворчал слова: «рваные ноздри!»… — Что ты там шепчешь, старый хрыч? — закричал Хлопуша. — Я тебе дам рваные ноздри; погоди, придёт и твоё время; бог даст, и ты щипцов понюхаешь… А покамест смотри, чтоб я тебе бородишки не вырвал!"
                            }
                        ]
                    }
