                        "entry_id": "ed17a72d-33aa-3a75-8a4e-c82bae2a10e2",
                        "glosses": [
                            "een persoon op leeftijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5edf4b9-309c-4fa2-9eed-4216fba1a9ad",
                                "sense_id": "2659ce2c-618c-37b3-9b44-59fce79619c3",
                                "text": "Er moet ook met de ouderen rekening gehouden worden."
                            },
                            {
                                "example_id": "c5caf0a8-3f07-493a-bff0-7e2796861272",
                                "sense_id": "2659ce2c-618c-37b3-9b44-59fce79619c3",
                                "text": "Als de jongeren zich over de ouderen moeten gaan ontfermen, gaat er echt wat mis."
                            }
                        ]
                    }
