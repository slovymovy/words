                            {
                                "target_lang_word": "schraal",
                                "target_lang_sense_clarification": "met weinig opbrengst"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab4a64d0-0267-3cc2-b57b-6fc0d88f9050",
