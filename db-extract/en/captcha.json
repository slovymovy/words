                                "target_senses": [
                                    {
                                        "sense_id": "660b8d1b-6f29-309b-b5f9-47074acd0cfe",
                                        "entry_id": "30ab5265-3fdb-322c-8d82-3ce613434937",
                                        "glosses": [
                                            "een test waarbij een mens taakjes moet uitvoeren die lastig zijn te automatiseren zoals het overtypen van vervormde letters van een plaatje of het selecteren van afbeeldingen die bepaalde voorwerpen bevatten teneinde aan te tonen dat de mens geen computerprogramma is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e9e2290-2435-48fd-a9a3-af4e19d936a2",
                                                "sense_id": "660b8d1b-6f29-309b-b5f9-47074acd0cfe",
                                                "text": "Ik heb deze captcha nu al honderd keer ingevuld maar het wil maar niet lukken, ik zou bijna gaan denken dat ik een computerprogramma ben."
                                            },
                                            {
                                                "example_id": "fc07097c-719b-4433-8c7d-09052e5bc1f2",
                                                "sense_id": "660b8d1b-6f29-309b-b5f9-47074acd0cfe",
                                                "text": "Een captcha is een middel om misbruik van een website in te perken maar schrikt tegelijk ook bonafide bezoekers af."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7118b70-30b5-40e9-97ba-a1e5919266cd",
