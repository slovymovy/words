                "senses": [
                    {
                        "sense_id": "68f3247d-e774-3ab3-ab68-ed4451a64a12",
                        "entry_id": "538a43f5-acc7-3967-a929-5896f1a6cc76",
                        "glosses": [
                            "betrekking hebbend op, of behorend tot de Remonstrantse Broederschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a4cc4be-20bc-4863-93b6-718f74c2164f",
                                "sense_id": "68f3247d-e774-3ab3-ab68-ed4451a64a12",
                                "text": "In Nederland zijn er vier kerkgenootschappen waar het huwelijk tussen hetero-stellen en homoparen geheel gelijk is gesteld. Dat zijn de Algemene Doopsgezinde Sociëteit, het Apostolisch Genootschap, het Remonstrants Broederschap en de Vrijzinnige Geloofsgemeenschap NPB."
                            },
                            {
                                "example_id": "d76d1430-203e-40ff-849b-ea19e4ae294b",
                                "sense_id": "68f3247d-e774-3ab3-ab68-ed4451a64a12",
                                "text": "De remonstrantse gemeenschap hoopt dat de inbrekers of eventuele vinders het historisch belang van de ring zullen inzien."
                            },
                            {
                                "example_id": "f0d7e649-daef-4819-9fa7-022ae50b58ae",
                                "sense_id": "68f3247d-e774-3ab3-ab68-ed4451a64a12",
                                "text": "De Reuver sprak vanmiddag op een jubileumbijeenkomst van de remonstranten, een vrijzinnig kerkgenootschap met zo'n 5000 leden. \"De verbanning van remonstrantse predikanten en de beroepsverboden voor talloze remonstrantse bestuurders hebben hen diep geraakt en veel stuk gemaakt\", schrijft De Reuver."
                            }
                        ]
                    }
