                ],
                "senses": [
                    {
                        "sense_id": "bb0bb40c-7218-3ddc-acd0-ca7673ef77d4",
                        "entry_id": "7c240bd0-efde-3edb-b95e-3738d966d785",
                        "glosses": [
                            "Qui est opposé à la religion chrétienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35262b21-f5a8-4069-ac27-0cdaf7d73028",
                                "sense_id": "bb0bb40c-7218-3ddc-acd0-ca7673ef77d4",
                                "text": "Nous donnons le nom d’apostasie privée à la renonciation complète qu'un homme fait de sa religion , soit dans son cœur seulement, soit même au dehors par des discours, sans s'associer publiquement à une religion antichrétienne."
                            },
                            {
                                "example_id": "33f862ea-c10c-42af-8db7-ab60b2dd6914",
                                "sense_id": "bb0bb40c-7218-3ddc-acd0-ca7673ef77d4",
                                "text": "Ce siècle a enfanté quelques auteurs qui ont produit un athéisme se voulant radical et entier, et ceci dans un contexte toujours plus virulemment antichrétien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7ad08e1-0519-4b68-9ae0-d54183b676e8",
                        "source_entry_id": "7c240bd0-efde-3edb-b95e-3738d966d785",
                        "source_sense_id": "bb0bb40c-7218-3ddc-acd0-ca7673ef77d4",
                        "target_lang_word": "antichristlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antichristlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2bafb3e-f0b3-36e6-bbb8-13368eeb04fc",
                                        "entry_id": "82b372be-b9ca-37ba-a3b4-d845e5edd09f",
                                        "glosses": [
                                            "gegen das Christentum gerichtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1e258aa-1ce0-4d1c-b933-fcadf0421b40",
                                                "sense_id": "d2bafb3e-f0b3-36e6-bbb8-13368eeb04fc",
                                                "text": "„Der Nazismus war entschieden antichristlich und neuheidnisch, während Stalins Diamat (die offizielle Version des sowjetischen Marxismus) offen materialistisch und atheistisch war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
