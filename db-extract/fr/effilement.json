                        "glosses": [
                            "Caractère de ce qui est effilé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52ad1c39-8ffc-45ae-b8a0-ccbb944eba06",
                                "sense_id": "b1298ea6-3114-3bb8-85dd-2bf37640cb01",
                                "text": "Nul n’oserait frôler l’effilement des doigts,\nQue je tends en un geste indifférent et triste."
                            },
                            {
                                "example_id": "56090813-4c8c-4e95-90f1-3838d7ddde5e",
                                "sense_id": "b1298ea6-3114-3bb8-85dd-2bf37640cb01",
                                "text": "Cette colonne est droite, elle ne présente aucun effilement."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c9e8dd6-0c96-3e29-b2e4-5ef3f1fc835f",
                        "entry_id": "4a18a8a1-520c-3b3e-9cac-6ff78ebb12f5",
                        "glosses": [
                            "Sur un avion, rapport de la corde d’extrémité sur la corde d’emplanture, généralement égal à un (aile dite \\\"à corde constante\\\") ou inférieur à un (aile trapézoïdale)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5d75a21-b59b-4e65-9558-ffc4a5356bf6",
                                "sense_id": "9c9e8dd6-0c96-3e29-b2e4-5ef3f1fc835f",
                                "text": "Les avions de ligne qui volent à Mach élevé (0.85) présentent une effilement supérieur, de l'ordre de 0.3, à cause de l'angle de flèche des ailes (environ 25-30°) qui a pour effet de surcharger les extrémités de la voilure."
                            }
                        ]
                    }
