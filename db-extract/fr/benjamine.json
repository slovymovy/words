                                    {
                                        "sense_id": "bffafd2c-95e5-3832-b502-ab29240e3878",
                                        "entry_id": "3ff0fa52-18d6-38db-9ee7-e97a0bdb8f1b",
                                        "glosses": [
                                            "superlative form of young: most young"
                                        ],
                                        "tags": [
                                            "form-of",
