                                                "example_id": "92b664b8-4c7d-46fd-96c8-d936e7ac5a38",
                                                "sense_id": "1e9c4002-d0ec-3c01-a9ac-c0cefde8b2d1",
                                                "text": "La gestation est très utile à la santé."
                                            }
