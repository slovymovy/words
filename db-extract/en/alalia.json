                "senses": [
                    {
                        "sense_id": "3381751b-216a-3f3b-b2ef-cf016fc24063",
                        "entry_id": "78671aac-3201-33d2-bfe8-c61b16c34162",
                        "glosses": [
                            "The loss of the ability to speak, especially due to paralysis of the vocal cords."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce4b849f-892a-452c-b8f8-250c166cd1d7",
                                "sense_id": "3381751b-216a-3f3b-b2ef-cf016fc24063",
                                "text": "A striking case of amnesic alalia was that of Lordat, a French physician, who thus described his malady: \"I find myself deprived of the value of all words.[…]\""
                            }
                        ]
                    },
                    {
                        "sense_id": "1bc45fff-49f1-3dc4-8e01-8c88c9cf9a31",
                        "entry_id": "78671aac-3201-33d2-bfe8-c61b16c34162",
                        "glosses": [
                            "Speech delay, a delay in the development or use of the mechanisms that produce speech."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "715c0bfb-8874-47e4-94e8-80f3ebbb85c7",
                                "sense_id": "1bc45fff-49f1-3dc4-8e01-8c88c9cf9a31",
                                "text": "The other major exception, characters with Down syndrome (a condition that often includes among its symptoms alalia, or speech delay), are usually played by actors with Down syndrome[…]."
                            }
                        ]
                    }
                ],
