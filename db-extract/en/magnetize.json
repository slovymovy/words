                                    {
                                        "sense_id": "46df2b3e-37e3-3c76-bc4c-1b4640e84f05",
                                        "entry_id": "b4352c42-122d-3a04-a2a7-68502e0f6d6f",
                                        "glosses": [
                                            "einen magnetisierbaren Stoff magnetisch machen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3610587a-c27b-4be9-9a7d-b99b2a6dcfbf",
                                                "sense_id": "46df2b3e-37e3-3c76-bc4c-1b4640e84f05",
                                                "text": "Sie nutzte einen Magneten, um die vor ihr liegende Münze zu magnetisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "358f3dd4-e02c-3303-bf2a-d7639d0b0204",
                                        "entry_id": "b4352c42-122d-3a04-a2a7-68502e0f6d6f",
                                        "glosses": [
                                            "der Therapie des Mesmerismus unterziehen, mit „magnetischer Heilkraft“ behandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11694844-5057-4741-b93c-a4a4f81164fb",
                                                "sense_id": "358f3dd4-e02c-3303-bf2a-d7639d0b0204",
                                                "text": "Der Arzt schlug seinen Patienten vor, sich magnetisieren zu lassen, um geheilt zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7e804f6-c13c-42fb-8669-a58f156b3172",
