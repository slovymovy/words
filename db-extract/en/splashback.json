                        "entry_id": "2e2ccf63-b55e-3edf-94cf-493a07710b7c",
                        "glosses": [
                            "A shield of an easily-cleaned material, such as those placed behind an oven top or kitchen sink and at industrial facilities, construction sites, etc, in order to catch splashes of liquid."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f81d07c-4cf6-43d5-ac4c-138a2a1aa460",
                                "sense_id": "47397d71-adc0-33d7-82c0-0637133d5829",
                                "text": "The oven comes complete with a stainless steel splashback."
                            },
                            {
                                "example_id": "b46fcffe-a91a-471a-9e74-9bd21202b54f",
                                "sense_id": "47397d71-adc0-33d7-82c0-0637133d5829",
                                "text": "In 1959, for a girl there were toy cookers in clinical white stove enamel, with a time clock set in the splash-back, and with two hot plates which really worked by using special fuel tablets which burnt from ten to 15 minutes."
                            }
                        ]
                    }
