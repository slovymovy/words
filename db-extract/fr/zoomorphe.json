                    {
                        "sense_id": "5afaad3a-e677-3817-8ab9-f8b5317d6c5a",
                        "entry_id": "cf41001d-3e20-3721-8c2a-01ec26a2ec08",
                        "glosses": [
                            "Qui a ou prend l’apparence d’un animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d4fa86-7a53-483f-adc1-caeb442ae060",
                                "sense_id": "5afaad3a-e677-3817-8ab9-f8b5317d6c5a",
                                "text": "Aux côtés de l’objet-personnage, anthropomorphe ou zoomorphe, animé au moyen de fils, de tiges, de tringles ou en prise directe, on trouve également toutes sortes de formes abstraites, d’objets manufacturés, de matières brutes, d’ombres ou encore de créations vidéo ou numériques."
                            },
                            {
                                "example_id": "89450cab-19e2-415c-8d8b-046765ed35ac",
                                "sense_id": "5afaad3a-e677-3817-8ab9-f8b5317d6c5a",
                                "text": "Rondes, zoomorphes, ansées, avec grenats cloisonnés ou en alliage cuivreux, ces épingles retenaient un textile lâche, sans coutures, ajusté à même le corps."
                            }
                        ]
                    }
                ],
