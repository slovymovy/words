                ],
                "senses": [
                    {
                        "sense_id": "b1d4f712-4665-30b6-847a-b19284dc33cd",
                        "entry_id": "f09531d5-dfd9-3e5e-a0be-a3c96ac09ebc",
                        "glosses": [
                            "Stadt im Nordwesten von Nigeria"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f54e5a4e-1cec-404c-9ab6-aff8b39e1f7f",
                                "sense_id": "b1d4f712-4665-30b6-847a-b19284dc33cd",
                                "text": "„Bis auf die breite, ausgebaute Schnellstraße, die zur Hauptstadt führt, hat sich Sokoto nicht groß verändert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8abf5fb0-4009-30c0-bff6-bd2534b876d0",
                        "entry_id": "f09531d5-dfd9-3e5e-a0be-a3c96ac09ebc",
                        "glosses": [
                            "nigerianischer Bundesstaat mit [1] als Hauptstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc9a7b3-e518-4318-a6f7-0c69b94aca84",
                                "sense_id": "8abf5fb0-4009-30c0-bff6-bd2534b876d0",
                                "text": "„Mittlerweile gibt es zwei Bohrlöcher, sagt Khadija, das in der Nähe des Hauses vom Dorfoberhaupt, gehört dem Chef der Kommunalverwaltung und das andere dem Politiker, für den Shuaibu arbeitet. Der war früher mal Mitglied im Parlament von Sokoto und will jetzt ins Hauptstadtparlament.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0c4daf4f-8575-370b-bf14-b9d1dd68705b",
                        "entry_id": "f09531d5-dfd9-3e5e-a0be-a3c96ac09ebc",
                        "glosses": [
                            "von 1804 bis 1903 existierendes Kalifat im Norden des heutigen Nigerias"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1c2a507f-cb7b-4de8-84cb-41fc81d26cce",
                                "sense_id": "0c4daf4f-8575-370b-bf14-b9d1dd68705b",
                                "text": "„Außenpolitisch verschob sich die Stellung Benins erheblich, weil sich die politische Landschaft der ganzen Region durch die Eroberungskriege des Kalifates Sokoto, den Fall des Yoruba-Reiches Oyo, die Kriege der Yoruba-Städte und das Vorrücken Großbritanniens von Grund auf veränderte.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f2bd990-e64a-439a-9686-764cd05bd862",
                        "source_entry_id": "f09531d5-dfd9-3e5e-a0be-a3c96ac09ebc",
