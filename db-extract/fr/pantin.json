            {
                "entry_id": "277a1873-d15f-3f31-9c0d-76ff99d00e3e",
                "word": "pantin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fd59c4c5-7f55-4ee8-9382-d0ff5ace575a",
                        "entry_id": "277a1873-d15f-3f31-9c0d-76ff99d00e3e",
                        "tags": [
                            "plural"
                        ],
                        "form": "pantins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2fa810d-741c-324e-9c44-5c3be577afe2",
                        "entry_id": "277a1873-d15f-3f31-9c0d-76ff99d00e3e",
                        "glosses": [
                            "Petite figure de carton mince et colorié, dont on fait mouvoir les membres par le moyen d’un fil et qui sert de jouet aux enfants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32318326-ad88-438f-bddb-8d23a7523809",
                                "sense_id": "a2fa810d-741c-324e-9c44-5c3be577afe2",
                                "text": "À la tribune, l'orateur faisait figure d'un de ces ridicules pantins dont, en pressant le ressort, on déclenche la tête et les bras."
                            },
                            {
                                "example_id": "484d7844-376d-4ca8-a8f0-20e799f090d4",
                                "sense_id": "a2fa810d-741c-324e-9c44-5c3be577afe2",
                                "text": "Il déployait sa propre tente de cirque immense et noire, et attendait que notre petite tente rouge et jaune, presque un jouet d’enfant, vienne s’y lover, pour pouvoir se jouer de nous comme de pantins."
                            }
                        ]
                    },
                    {
                        "sense_id": "de6ace91-b2b9-3f29-9d36-51a6d01c1a16",
                        "entry_id": "277a1873-d15f-3f31-9c0d-76ff99d00e3e",
                        "glosses": [
                            "Celui qui gesticule sans motif et ridiculement."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "27203415-220d-4ee0-885a-c4285d5d0345",
                                "sense_id": "de6ace91-b2b9-3f29-9d36-51a6d01c1a16",
                                "text": "La musique enivre et règle le danseur, tandis que le curieux voit le mouvement seul et rit de ce pantin qui s’agite sans raison, car le curieux, lui, n’entend pas la musique."
                            }
                        ]
                    },
                    {
                        "sense_id": "be30edee-9e91-3fce-81e7-17dd092ceb92",
                        "entry_id": "277a1873-d15f-3f31-9c0d-76ff99d00e3e",
                        "glosses": [
                            "Quelqu’un qui n’a rien de sérieux et de constant dans ses actes, dans ses opinions."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "26c533e8-bbc1-4944-a930-c9871512d542",
                                "sense_id": "be30edee-9e91-3fce-81e7-17dd092ceb92",
                                "text": "Ceux qui fayotent avec l’originalité et qui à force d'abuser de fausses excentricités, de se mentir à eux-mêmes dans le but de se distinguer, ne sont plus que des pantins. Oui, on en perd du temps à s'affranchir des tabous, des flux et reflux des modes !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b2ddcd26-2362-3718-8ce8-04e11f4548bd",
                        "entry_id": "277a1873-d15f-3f31-9c0d-76ff99d00e3e",
                        "glosses": [
                            "Pâté en croûte façonné à la main, sans moule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bcb8d47-23cc-4adc-a5d3-2314f18918e3",
                                "sense_id": "b2ddcd26-2362-3718-8ce8-04e11f4548bd",
                                "text": "Abaisser la pâte à brioche en rectangle […] ; garnir le milieu, tout comme un « pantin », et par lits superposés avec : le kache ou le riz ; les escalope de saumon […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4bb0902-cc1a-43e0-9317-9935711965e8",
                        "source_entry_id": "277a1873-d15f-3f31-9c0d-76ff99d00e3e",
                        "source_sense_id": "a2fa810d-741c-324e-9c44-5c3be577afe2",
                        "source_sense_description": "Petite figure de carton mince et colorié",
                        "target_lang_word": "Hampelmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hampelmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18913906-a35d-3779-8d04-a39b491f211d",
                                        "entry_id": "955a2fc5-cff7-3513-bfd4-eba03f8f3040",
                                        "glosses": [
                                            "Figur, deren Arme und Beine mittels einer Schnur bewegt werden können"
                                        ],
                                        "tags": [
                                            "Spielzeug"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a8a609f-49d5-4ef0-be8d-87dcc67f8214",
                                                "sense_id": "18913906-a35d-3779-8d04-a39b491f211d",
                                                "text": "Wenn man an der Schnur zieht, hampelt der Hampelmann."
                                            },
                                            {
                                                "example_id": "88989613-5953-48f6-94e9-8cd58242c5ed",
                                                "sense_id": "18913906-a35d-3779-8d04-a39b491f211d",
                                                "text": "„Wie fast alle Liebhaber von Puppen und Hampelmännern fühlt er Kindern gegenüber eine große Indifferenz.“"
                                            },
                                            {
                                                "example_id": "d79f09fd-1e7a-417a-94d8-9a57a5bde665",
                                                "sense_id": "18913906-a35d-3779-8d04-a39b491f211d",
                                                "text": "„Sie haßte mich nicht, und sie liebte ich nicht, das war ganz einfach; und da sie sehr jung war und Grund zum Lachen haben mußte, hatte sie mich auserkoren, um sich über mich wie über einen Hampelmann lustig zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91d2a44a-25a6-3073-a943-e76c43ee4dca",
                                        "entry_id": "955a2fc5-cff7-3513-bfd4-eba03f8f3040",
                                        "glosses": [
                                            "willensschwacher Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cbe8f41-1cbe-4958-870e-461a493a7503",
                                                "sense_id": "91d2a44a-25a6-3073-a943-e76c43ee4dca",
                                                "text": "Der Hampelmann hat ja keine eigene Meinung – es gilt immer, was sie sagt."
                                            },
                                            {
                                                "example_id": "6882881c-e399-4163-8538-13e2634d3f9c",
                                                "sense_id": "91d2a44a-25a6-3073-a943-e76c43ee4dca",
                                                "text": "„»Er war in gewisser Hinsicht ein Clown, aber kein Hampelmann, der sich manipulieren ließ«, meint der Dali-Experte Ignacio Gomez de Liano.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "061d22cf-3820-3860-8d9e-b5d858e82779",
                                        "entry_id": "955a2fc5-cff7-3513-bfd4-eba03f8f3040",
                                        "glosses": [
                                            "zappelige (hyperaktive) Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6de99c-bf95-45f9-b04a-9977bc4d957c",
                                                "sense_id": "061d22cf-3820-3860-8d9e-b5d858e82779",
                                                "text": "Es ist nicht leicht den kleinen Hampelmann zu kämmen – er will nicht stillhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4177db53-8c37-369c-a424-0f34b2aa4a6c",
                                        "entry_id": "955a2fc5-cff7-3513-bfd4-eba03f8f3040",
                                        "glosses": [
                                            "Turnübung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4acc4feb-92b0-4830-b6df-e79c0899aba9",
                                                "sense_id": "4177db53-8c37-369c-a424-0f34b2aa4a6c",
                                                "text": "Zum Aufwärmen ist der Hampelmann gut geeignet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1603bdba-4d9f-454a-a87b-9f3181abdaa3",
                        "source_entry_id": "277a1873-d15f-3f31-9c0d-76ff99d00e3e",
                        "source_sense_id": "a2fa810d-741c-324e-9c44-5c3be577afe2",
                        "source_sense_description": "Petite figure de carton mince et colorié",
                        "target_lang_word": "Marionette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marionette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd8bc7c2-e774-339c-85a7-6b21a1b5b349",
                                        "entry_id": "d2461112-c970-3c64-a9ce-ae5b567ab67b",
                                        "glosses": [
                                            "Gliederpuppe, die an Fäden bewegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d712da-7120-411d-8246-3e326195798f",
                                                "sense_id": "bd8bc7c2-e774-339c-85a7-6b21a1b5b349",
                                                "text": "Die Herstellung von Marionetten ist Teil der sizilianischen Volkskunst."
                                            },
                                            {
                                                "example_id": "ab93fc22-0da3-42c0-8179-81737c9a7cd7",
                                                "sense_id": "bd8bc7c2-e774-339c-85a7-6b21a1b5b349",
                                                "text": "„In einem anderen Raum, den ein großer Ohrensessel beherrscht, schauen Marionetten den Besucher von den Wänden herab an.“"
                                            },
                                            {
                                                "example_id": "174c53f6-c689-4c04-84e7-64c44ac657c9",
                                                "sense_id": "bd8bc7c2-e774-339c-85a7-6b21a1b5b349",
                                                "text": "„Ich sah ihn nur an, mit ›leeren Augen‹, wie eine Kleistsche Marionette.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04889fb7-8d9e-3cc1-8f58-58d9c43a3d9e",
                                        "entry_id": "d2461112-c970-3c64-a9ce-ae5b567ab67b",
                                        "glosses": [
                                            "Mensch (insbesondere Politiker), der von anderen kontrolliert wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "876d4592-b866-4ae0-9800-2aa174b78816",
                                                "sense_id": "04889fb7-8d9e-3cc1-8f58-58d9c43a3d9e",
                                                "text": "Pétain war eine Marionette der deutschen Besatzer."
                                            },
                                            {
