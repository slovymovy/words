            {
                "entry_id": "b599e78b-c9bf-33ec-b792-176c050557ee",
                "word": "overboard",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "102e49c6-2179-3216-b7b5-3e57f465ec4a",
                        "entry_id": "b599e78b-c9bf-33ec-b792-176c050557ee",
                        "glosses": [
                            "Over the edge; especially, off or outside of a boat."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "09e48208-7ab0-4fab-8f80-2b93342b6b57",
                                "sense_id": "102e49c6-2179-3216-b7b5-3e57f465ec4a",
                                "text": "It was their practice to throw the scraps overboard."
                            },
                            {
                                "example_id": "25ca222f-3a7d-46e8-bc4f-6bbec9e14a21",
                                "sense_id": "102e49c6-2179-3216-b7b5-3e57f465ec4a",
                                "text": "Theon Greyjoy is the most well developed character on that stage, and the action comes down to him. Euron, with Yara underneath his ax, goads Theon into attack. But Theon is overwhelmed by the violence all around him, and instead he jumps overboard."
                            },
                            {
                                "example_id": "f0b29ea9-d262-4120-a607-e81253c502e8",
                                "sense_id": "102e49c6-2179-3216-b7b5-3e57f465ec4a",
                                "text": "Afore we got to the shanty Colonel Applegate stuck his head out of the door. His temper had been getting raggeder all the time, and the sousing he got when he fell overboard had just about ripped what was left of it to ravellings."
                            }
                        ]
                    },
                    {
                        "sense_id": "70e09009-eceb-3006-9c01-fe82b8b90343",
                        "entry_id": "b599e78b-c9bf-33ec-b792-176c050557ee",
                        "glosses": [
                            "Excessively; too much."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d4b4c730-2e4b-45ca-b2cf-a0c23f0d8d13",
                                "sense_id": "70e09009-eceb-3006-9c01-fe82b8b90343",
                                "text": "They really went overboard with the party preparations."
                            },
                            {
                                "example_id": "e5a9d808-c451-4c06-aa57-9ac5367cae0a",
                                "sense_id": "70e09009-eceb-3006-9c01-fe82b8b90343",
                                "text": "In reality, brains go overboard with this sort of fear validation. They love any chance to prove a fear is valid while ignoring all the reasons it's not."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a07dd81-9678-4cbb-abc5-da34a74e727c",
                        "source_entry_id": "b599e78b-c9bf-33ec-b792-176c050557ee",
                        "source_sense_description": "over the edge, off a boat",
                        "target_lang_word": "overboord",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overboord",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bd6bb75f-4af5-3480-8d41-b85c3b727e7e",
                                        "entry_id": "ebeb8317-2e16-39b3-be25-cded91493cb6",
                                        "glosses": [
                                            "het schip uit, het water in"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75bfcb4c-b3e7-4adb-bfd8-3a0442e676d1",
                                                "sense_id": "bd6bb75f-4af5-3480-8d41-b85c3b727e7e",
                                                "text": "Na de enorme golf bleken er twee man overboord te zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "299d8d65-74f2-48d6-b5e8-ac4d55fb1a2e",
                        "source_entry_id": "b599e78b-c9bf-33ec-b792-176c050557ee",
                        "source_sense_description": "over the edge, off a boat",
                        "target_lang_word": "par-dessus bord",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "par-dessus bord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a71a6c7b-047d-37a6-b335-a07b61afe296",
                                        "entry_id": "a237ca0f-f52f-3e8f-8c93-be5951a5d4d8",
                                        "glosses": [
                                            "Hors du navire, du vaisseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d1dde79-74db-4118-82a5-25da6529b4b7",
                                                "sense_id": "a71a6c7b-047d-37a6-b335-a07b61afe296",
                                                "text": "De mon cigare il ne me restait plus qu’un bout entre les lèvres, et, après en avoir aspiré les dernières bouffées, je le jette par-dessus le bord."
                                            },
                                            {
                                                "example_id": "76edd360-77f3-4897-8492-7c61965ced97",
                                                "sense_id": "a71a6c7b-047d-37a6-b335-a07b61afe296",
                                                "text": "[…] ; pour éviter d’être précipité par-dessus bord, Bert et la sentinelle durent s’accrocher aux montants de la galerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9083bc9e-9ae9-3252-b655-8cebf4cc3163",
                                        "entry_id": "a237ca0f-f52f-3e8f-8c93-be5951a5d4d8",
                                        "glosses": [
                                            "Hors du lieu ; à l’extérieur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3bce6e3-b605-4dcd-b611-a5f86e8fcb1e",
                                                "sense_id": "9083bc9e-9ae9-3252-b655-8cebf4cc3163",
                                                "text": "Ils jettent d’eux-mêmes leurs jeunes par-dessus bord et le coucoulet s’empiffre, s’empiffre, sans cesse affamé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ec6584-47bd-3163-86c4-edf0823f1ed5",
                                        "entry_id": "a237ca0f-f52f-3e8f-8c93-be5951a5d4d8",
                                        "glosses": [
                                            "Se débarrasser de."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "963aed26-4613-4108-bccb-e66a9bac46a6",
                                                "sense_id": "c7ec6584-47bd-3163-86c4-edf0823f1ed5",
                                                "text": "Elle ne disait ni au revoir ni adieu. Elle me laissait. Elle envisageait froidement de s'expatrier sur le tard, d'abandonner tout, d'expédier par-dessus bord habitudes, meubles, maison, pays, enfants, petits-enfants et le reste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
