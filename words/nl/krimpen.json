            "senses": [
                {
                    "sense_id": "b712948c-caab-3860-9ba7-2baf9b41d3f7",
                    "sense_definition": "kleiner worden van textiel na een wasbeurt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kleiner worden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn nieuwe wollen trui is helaas <w>gekrompen</w> in de wasmachine.",
                            "target_lang_translations": {
                                "en": "My new wool sweater has unfortunately <w>shrunk</w> in the washing machine."
                            }
                        },
                        {
                            "text": "Je moet deze broek koud wassen zodat de stof niet gaat <w>krimpen</w>.",
                            "target_lang_translations": {
                                "en": "You should wash these pants cold so the fabric doesn't <w>shrink</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in de was krimpen"
                    ],
                    "target_lang_definitions": {
                        "en": "the reduction in size of textiles after being washed"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrink",
                                "target_lang_sense_clarification": "of clothing or fabric"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8e2ab1e-06ad-3ac5-9b27-e58c4b4346a2",
                    "sense_definition": "kleiner in omvang, aantal of volume worden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kleiner worden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bevolking van dat kleine dorpje is de afgelopen jaren flink <w>gekrompen</w>.",
                            "target_lang_translations": {
                                "en": "The population of that small village has <w>shrunk</w> significantly in recent years."
                            }
                        },
                        {
                            "text": "Door de economische crisis begon de winst van het bedrijf snel te <w>krimpen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the economic crisis, the company's profits began to <w>shrink</w> rapidly."
                            }
                        }
                    ],
                    "synonyms": [
                        "afnemen",
                        "verminderen",
                        "slinken"
                    ],
                    "antonyms": [
                        "groeien"
                    ],
                    "common_phrases": [
                        "een krimpende markt"
                    ],
                    "target_lang_definitions": {
                        "en": "to become smaller in size, number, or volume"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrink",
                                "target_lang_sense_clarification": "to decrease in size or amount"
                            },
                            {
                                "target_lang_word": "contract",
                                "target_lang_sense_clarification": "to become smaller or tighter"
                            },
                            {
                                "target_lang_word": "dwindle",
                                "target_lang_sense_clarification": "to gradually diminish in size or strength"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "351a7208-bfa2-3033-994a-542417693800",
                    "sense_definition": "het geleidelijk van richting veranderen van de wind, tegen de wijzers van de klok in",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "windrichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op het noordelijk halfrond gaat de wind <w>krimpen</w> bij het naderen van een lagedrukgebied.",
                            "target_lang_translations": {
                                "en": "In the Northern Hemisphere, the wind will <w>back</w> as a low-pressure area approaches."
                            }
