                {
                    "sense_id": "676fe8e6-55f3-3dc0-a72b-0d8c59e4ce03",
                    "sense_definition": "mit etwas übereinstimmen oder in Wert bzw. Bedeutung gleichkommen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "übereinstimmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine Schilderung des Unfalls <w>entspricht</w> vollkommen den Tatsachen.",
                            "target_lang_translations": {
                                "en": "His account of the accident fully <w>corresponds to</w> the facts.",
                                "ru": "Его описание аварии полностью <w>соответствует</w> действительности.",
                                "nl": "Zijn beschrijving van het ongeval <w>strookt</w> volkomen <w>met</w> de feiten.",
                                "pl": "Jego opis wypadku całkowicie <w>odpowiada</w> faktom.",
                                "fr": "Son récit de l'accident <w>correspond</w> parfaitement aux faits.",
                                "it": "La sua descrizione dell'incidente <w>corrisponde</w> perfettamente ai fatti.",
                                "cs": "Jeho popis nehody plně <w>odpovídá</w> skutečnosti.",
                                "tr": "Onun kaza anlatımı gerçeklerle tamamen <w>örtüşüyor</w>.",
                                "es": "Su descripción del accidente <w>se corresponde</w> por completo con los hechos.",
                                "zh": "他对事故的描述完全<w>符合</w>事实。"
                            }
                        },
                        {
                            "text": "Ein Zoll <w>entspricht</w> ungefähr zweieinhalb Zentimetern im metrischen System.",
                            "target_lang_translations": {
                                "en": "One inch <w>corresponds to</w> roughly two and a half centimeters in the metric system.",
                                "ru": "Один дюйм <w>соответствует</w> примерно двум с половиной сантиметрам в метрической системе.",
                                "nl": "Een inch <w>komt overeen met</w> ongeveer tweeënhalve centimeter in het metrieke stelsel.",
                                "pl": "Jeden cal <w>odpowiada</w> około dwóm i pół centymetra w systemie metrycznym.",
                                "fr": "Un pouce <w>correspond à</w> environ deux centimètres et demi dans le système métrique.",
                                "it": "Un pollice <w>corrisponde a</w> circa due centimetri e mezzo nel sistema metrico.",
                                "cs": "Jeden palec <w>odpovídá</w> v metrickém systému zhruba dvěma a půl centimetrům.",
                                "tr": "Bir inç, metrik sistemde yaklaşık iki buçuk santimetreye <w>denk gelir</w>.",
                                "es": "Una pulgada <w>equivale a</w> aproximadamente dos centímetros y medio en el sistema métrico.",
                                "zh": "一英寸在公制中大约<w>相当于</w>两点五厘米。"
                            }
                        }
