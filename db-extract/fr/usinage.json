        "fr-extract.jsonl": [
            {
                "entry_id": "22690324-cd63-3108-9e97-bbd25515198c",
                "word": "usinage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "84918114-ac91-4e28-b124-b9d41bdb8024",
                        "entry_id": "22690324-cd63-3108-9e97-bbd25515198c",
                        "tags": [
                            "plural"
                        ],
                        "form": "usinages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "370fa4c6-a246-306f-a153-076b368d0a2b",
                        "entry_id": "22690324-cd63-3108-9e97-bbd25515198c",
                        "glosses": [
                            "Opération ou ensemble d’opérations consistant à enlever de la matière à une pièce brute à l’aide d’outils coupants, dans le but d’obtenir une forme ou des dimensions précises."
                        ],
                        "tags": [
                            "Génie mécanique"
                        ],
                        "examples": [
                            {
                                "example_id": "df73d8dc-d7ef-45f5-968a-ffd6830405e8",
                                "sense_id": "370fa4c6-a246-306f-a153-076b368d0a2b",
                                "text": "Atelier d’usinage des culasses."
                            },
                            {
                                "example_id": "cf91f73e-bd90-43c6-bac3-cb302445b308",
                                "sense_id": "370fa4c6-a246-306f-a153-076b368d0a2b",
                                "text": "Une opération d’usinage (ou une phase d’usinage), est une étape de l’élaboration d'une pièce finie à partir d’un brut de forge, de fonderie ou de laminage."
                            },
                            {
                                "example_id": "22daa69d-84fa-40b9-b563-a2d5db6d0fb7",
                                "sense_id": "370fa4c6-a246-306f-a153-076b368d0a2b",
                                "text": "Les pièces de quincaillerie les plus rudimentaires, réalisées en acier, avaient déjà une précision d’usinage de l’ordre du 1/10 de millimètre."
                            },
                            {
                                "example_id": "25eadba9-9b28-4672-b31e-426dd8d043ad",
                                "sense_id": "370fa4c6-a246-306f-a153-076b368d0a2b",
                                "text": "Il y a autant de types d’usinages que de procédés de fabrication, de machines-outils spécialisées, par exemple :"
                            }
                        ]
                    },
                    {
                        "sense_id": "92e7c626-9806-3846-9650-5f53c1d06e0c",
                        "entry_id": "22690324-cd63-3108-9e97-bbd25515198c",
                        "glosses": [
                            "Résultat ou état d’une pièce après avoir subi ces opérations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e65301a-0d76-4803-9fdd-9954c98e45ff",
                                "sense_id": "92e7c626-9806-3846-9650-5f53c1d06e0c",
                                "text": "Dans les entreprises de l'industrie des accessoires on a utilisé le système suivant à 6 décimales pour la symbolisation des matières selon la qualité, l’état d’usinage, les dimensions."
                            },
                            {
                                "example_id": "fd000ef3-7aec-4fb6-9d38-2a8af3c7cd61",
                                "sense_id": "92e7c626-9806-3846-9650-5f53c1d06e0c",
                                "text": "Il rend ainsi hommage au travail des hommes, dont les premiers usinages furent les silex taillés échangés dans tous les lieux habités."
                            }
                        ]
                    },
                    {
                        "sense_id": "24d31984-7301-3651-b9c9-05b1f22099de",
                        "entry_id": "22690324-cd63-3108-9e97-bbd25515198c",
                        "glosses": [
                            "Période de transmission des traditions (PTT)."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8336342-73eb-46dd-a23e-8225a1c77513",
                        "source_entry_id": "22690324-cd63-3108-9e97-bbd25515198c",
                        "source_sense_description": "action d’usiner",
                        "target_lang_word": "Verarbeitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verarbeitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc350752-d61a-3584-aad9-4bfa8d5e82dc",
                                        "entry_id": "c04fefca-9ca8-3ba2-932a-87155b994de9",
                                        "glosses": [
                                            "Verwertung, Umformung von etwas in ein Produkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99cbe6b0-7953-4459-af16-084032b8ee90",
                                                "sense_id": "cc350752-d61a-3584-aad9-4bfa8d5e82dc",
                                                "text": "Bei der Verarbeitung von Lebensmitteln müssen hohe Hygienestandards eingehalten werden."
                                            },
                                            {
                                                "example_id": "09d27f46-0a18-425f-b2a9-a319e54dc2db",
                                                "sense_id": "cc350752-d61a-3584-aad9-4bfa8d5e82dc",
                                                "text": "„Die digitale Verarbeitung von Informationen ermöglicht dem Traditionsunternehmen neue Geschäftsideen – im Kerngeschäft mit Druckmaschinen, aber auch darüber hinaus.“"
                                            },
                                            {
                                                "example_id": "7798f0fd-b390-44e3-b68d-36c6fc2b6de5",
                                                "sense_id": "cc350752-d61a-3584-aad9-4bfa8d5e82dc",
                                                "text": "„Wer durch Verarbeitung oder Umbildung eines oder mehrerer Stoffe eine neue bewegliche Sache herstellt, erwirbt das Eigentum an der neuen Sache, sofern nicht der Wert der Verarbeitung oder der Umbildung erheblich geringer ist als der Wert des Stoffes. Als Verarbeitung gilt auch das Schreiben, Zeichnen, Malen, Drucken, Gravieren oder eine ähnliche Bearbeitung der Oberfläche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82400633-500a-3672-8630-a74cdf681aff",
                                        "entry_id": "c04fefca-9ca8-3ba2-932a-87155b994de9",
                                        "glosses": [
                                            "Art und Weise, in der etwas hergestellt, verarbeitet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92417d39-5e89-4d7c-bae1-6ad7a067bc00",
                                                "sense_id": "82400633-500a-3672-8630-a74cdf681aff",
                                                "text": "„Wer durch Verarbeitung oder Umbildung eines oder mehrerer Stoffe eine neue bewegliche Sache herstellt, erwirbt das Eigentum an der neuen Sache, sofern nicht der Wert der Verarbeitung oder der Umbildung erheblich geringer ist als der Wert des Stoffes. Als Verarbeitung gilt auch das Schreiben, Zeichnen, Malen, Drucken, Gravieren oder eine ähnliche Bearbeitung der Oberfläche.“"
                                            },
                                            {
                                                "example_id": "e467762c-4aac-429f-93bc-110632c004bc",
                                                "sense_id": "82400633-500a-3672-8630-a74cdf681aff",
                                                "text": "Dieses T-Shirt war billig, das sieht man an der schlechten Verarbeitung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
