                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37c941f9-566f-46b9-86e0-7cb61967d222",
                                "sense_id": "7189e490-5e24-32de-ad27-c81113a13525",
                                "text": "Volgens CNN zei een andere defensiefunctionaris dat topgeneraal Mark Milley sterk van mening was dat de situatie niet dermate ernstig was om de inzet van het leger te rechtvaardigen. Dat zette de deur open of voor de vraag een dergelijk presidentieel bevel wel legaal zou zijn."
                            },
                            {
                                "example_id": "0af1f5a7-b32e-4d92-bb6a-e8657833e957",
                                "sense_id": "7189e490-5e24-32de-ad27-c81113a13525",
                                "text": "De Amerikaanse autoriteiten tasten nog in het duister over de schending van het luchtruim die leidde tot het afgrendelen van het Witte Huis. Het gaat mogelijk om een drone, een verstoring in de atmosfeer of een zwerm vogels, zegt een defensiefunctionaris tegen CNN."
                            },
                            {
                                "example_id": "c2a17d9c-bd77-46bd-8b4e-3ca644a32b43",
                                "sense_id": "7189e490-5e24-32de-ad27-c81113a13525",
                                "text": "Het verhoor van Sondland gaat later verder, daarna worden de defensiefunctionaris Laura Cooper en staatssecretaris van Buitenlandse Zaken David Hale nog gehoord door de commissie."
                            }
                        ]
                    }
