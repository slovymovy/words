                ],
                "senses": [
                    {
                        "sense_id": "c957cf28-b202-33be-94b6-196b2057bfc1",
                        "entry_id": "ca98426b-165e-3e71-8a1d-370ba3710afd",
                        "glosses": [
                            "der Wohnbau einer mittelalterlichen Burg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9d3c4c9-6e8f-44f5-af7d-3f6128bd8d93",
                                "sense_id": "c957cf28-b202-33be-94b6-196b2057bfc1",
                                "text": "„Der Palas […] ist ein repräsentativer Saalbau einer mittelalterlichen Pfalz oder Burg zur Zeit der Romanik […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d6bd9f2-a985-322b-a496-7e96cfb33785",
                        "entry_id": "ca98426b-165e-3e71-8a1d-370ba3710afd",
                        "glosses": [
                            "im Jahr 1969 an der Staatlichen Lehr- und Versuchsanstalt für Wein- und Obstbau Weinsberg aus den Sorten Blaufränkisch (auch: Limberger) und der Rubintraube (auch: Teinturier du Cher) gezüchtete neue rote Rebsorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc89b83e-71a5-44ea-a130-c4ce26ef384c",
                                "sense_id": "4d6bd9f2-a985-322b-a496-7e96cfb33785",
                                "text": "„Die Rebsorte Palas besitzt einen dunklen, rubinroten Beerensaft, d.h. sie ist primär als Cuvéepartner zu den traditionellen Rotweinsorten […] gedacht.“"
                            },
                            {
                                "example_id": "55e3e760-2dfd-43de-82d2-3498f68be993",
                                "sense_id": "4d6bd9f2-a985-322b-a496-7e96cfb33785",
                                "text": "„[…] Doch diese Weinsorten sind nicht der tägliche Arbeitsinhalt von Dr. Bernd Hill. Seine neuen Zöglinge haben die Rufnamen Acolon, Cubin, Mitos, Palas, Dorio und Dorsa.“"
                            },
                            {
                                "example_id": "0f1ac8e1-e226-4731-b706-1f7428081afe",
                                "sense_id": "4d6bd9f2-a985-322b-a496-7e96cfb33785",
                                "text": "Der Palas ist sehr gut als Cuvéepartner oder als Deckrotwein geeignet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32f70d08-f615-4a8e-9fc1-246fa90902ff",
                        "source_entry_id": "ca98426b-165e-3e71-8a1d-370ba3710afd",
