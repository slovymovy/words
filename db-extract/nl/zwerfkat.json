                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc4fcb28-b911-4821-88e6-52231dc256b1",
                                "sense_id": "cec1b616-702b-3e6c-a2a8-b71d5b8c84e4",
                                "text": "Zwerfkatten leven onafhankelijk van de mens."
                            },
                            {
                                "example_id": "1b874a09-6ba6-418b-b8e8-abb1aa7c146e",
                                "sense_id": "cec1b616-702b-3e6c-a2a8-b71d5b8c84e4",
                                "text": "En het is waar, de laagste verdiepingen zijn vervallen en er wonen alleen knaagdieren en af en toe een zwerfkat - en in de winter is het er vol mensenlijven op zoek naar beschutting, maakt niet uit hoe het eruitziet — maar nu is het midden in de zomer en de armen van de stad zijn op straat te vinden, en Addie heeft de bovenste verdieping voor eigen gebruik geconfisqueerd."
                            }
                        ]
                    }
