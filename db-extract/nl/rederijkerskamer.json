                        "examples": [
                            {
                                "example_id": "295ce6e5-a16f-4288-8e46-777279556dc6",
                                "sense_id": "c9f45097-0c6c-3468-833e-7787a9cafdd8",
                                "text": "Toneelvereniging Rederijkerskamer Bilderdijk uit Markelo is er opnieuw in geslaagd een aantal jeugdigen te interesseren voor toneel."
