                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52942b7f-cb56-43e9-a4e1-fe758d3faac6",
                        "source_entry_id": "093c6f37-6499-3519-871b-b6bf111e0491",
                        "source_sense_id": "2d7d75f8-bd85-38d5-a1ad-8ecb79fb7492",
                        "target_lang_word": "clangour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clangour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81c6cd7b-6b5f-3e08-881f-c38f2e0cb417",
                                        "entry_id": "597abdf4-1bd0-3acd-b595-6d10651ff9d3",
                                        "glosses": [
                                            "A loud, repeating clanging sound; a loud racket; a din."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d6321d1-ca7d-4a2e-84ca-096ce23c9744",
                                                "sense_id": "81c6cd7b-6b5f-3e08-881f-c38f2e0cb417",
                                                "text": "When every least commander’s will, best soldiers had obey’d, / And both the hosts were rang’d for fight, the Trojans would have fray’d / The Greeks with noises; crying out, in coming rudely on / At all parts, like the cranes that fill with harsh confusion / Of brutish clangour all the air; […]"
                                            },
                                            {
                                                "example_id": "caa5f58b-2569-42e6-85c7-5c28f05bec09",
                                                "sense_id": "81c6cd7b-6b5f-3e08-881f-c38f2e0cb417",
                                                "text": "1920, D. H. Lawrence, Women in Love, Chapter XXIV: Death and Love,\nAnd always, as the dark, inchoate eyes turned to him, there passed through Gerald's bowels a burning stroke of revolt, that seemed to resound through his whole being, threatening to break his mind with its clangour, and making him mad."
                                            },
                                            {
                                                "example_id": "4d3348b4-e418-4912-bb4b-1d6976e3cbd1",
                                                "sense_id": "81c6cd7b-6b5f-3e08-881f-c38f2e0cb417",
                                                "text": "H. G. Wells' stark short story \"The Cone\" tells of a man's macabre revenge worked out in the clangour of a great steel works and railway lines and sidings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clangour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e3c9bad-cdd3-35c3-a7c2-07ab0f524b0b",
                                        "entry_id": "9cdd9b12-4f0b-3e01-afc3-12066ba80c3a",
                                        "glosses": [
                                            "To make a clanging sound."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "993bbf11-55f2-4431-803b-4a6d6c39648e",
                                                "sense_id": "9e3c9bad-cdd3-35c3-a7c2-07ab0f524b0b",
                                                "text": "It clangoured through the house like a bell in a tomb."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fccbb99-fa77-4c08-822c-afe3fdd0ad5c",
                        "source_entry_id": "093c6f37-6499-3519-871b-b6bf111e0491",
                        "source_sense_id": "2d7d75f8-bd85-38d5-a1ad-8ecb79fb7492",
                        "target_lang_word": "tinkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f5db54d-524c-3a60-b23e-d87ad873ba73",
                                        "entry_id": "09593351-69b2-380c-b862-e833b3e59995",
                                        "glosses": [
                                            "To make light metallic sounds, rather like a very small bell."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff73bf8c-95df-4d71-8963-36ebb7c5e313",
                                                "sense_id": "6f5db54d-524c-3a60-b23e-d87ad873ba73",
                                                "text": "The glasses tinkled together as they were placed on the table."
                                            },
                                            {
                                                "example_id": "d9a6ca77-59cd-4a4c-9fda-713b06f34ee6",
                                                "sense_id": "6f5db54d-524c-3a60-b23e-d87ad873ba73",
                                                "text": "The sprightly horse / Moves to the music of his tinkling bells."
                                            },
                                            {
                                                "example_id": "39b98900-983d-406b-b5e2-dc09ea0bb404",
                                                "sense_id": "6f5db54d-524c-3a60-b23e-d87ad873ba73",
                                                "text": "With a sound like tinkling bells, far off in a land of shepherds hidden by some hill, the waters of many fountains turned again home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f076eed1-0eac-36a6-a390-3aabeba63623",
                                        "entry_id": "09593351-69b2-380c-b862-e833b3e59995",
                                        "glosses": [
                                            "To cause to tinkle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b45d8032-77ca-3bbb-824f-9522750c443d",
                                        "entry_id": "09593351-69b2-380c-b862-e833b3e59995",
                                        "glosses": [
                                            "To indicate, signal, etc. by tinkling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d06bbef5-e805-4785-856d-2993cfc7f46f",
                                                "sense_id": "b45d8032-77ca-3bbb-824f-9522750c443d",
                                                "text": "The butler tinkled dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c708549-588c-35bd-a7b6-3e205a2809f8",
                                        "entry_id": "09593351-69b2-380c-b862-e833b3e59995",
                                        "glosses": [
                                            "To hear, or resound with, a small, sharp sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04dfb2e1-7376-4e2c-a44f-c99acdbb5bcc",
                                                "sense_id": "5c708549-588c-35bd-a7b6-3e205a2809f8",
                                                "text": "And his ears tinkled, and the colour fled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc7a2423-bdd1-3c33-a37b-1f29c3b227e7",
                                        "entry_id": "09593351-69b2-380c-b862-e833b3e59995",
                                        "glosses": [
                                            "To urinate."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4672f238-6b06-3cef-b295-63b8d341cb14",
                                        "entry_id": "083701f0-31c5-3e76-8c2b-ffbf3de99aa4",
                                        "glosses": [
                                            "A light metallic sound, resembling the tinkling of bells or wind chimes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef08cd9-0e3b-40df-8899-f4702aa11bf0",
                                                "sense_id": "4672f238-6b06-3cef-b295-63b8d341cb14",
                                                "text": "The Man's Wife heard the tinkle-tinkle of little stones and loose earth falling off the roadway, and the sliding roar of the man and horse going down."
                                            },
                                            {
                                                "example_id": "05179d30-972a-49d6-8615-989c5cb6f5bc",
                                                "sense_id": "4672f238-6b06-3cef-b295-63b8d341cb14",
                                                "text": "She laughed, her voice a tinkle in the silence of the circular chamber."
                                            },
                                            {
                                                "example_id": "65d10fc8-ef60-435b-a296-850c9987fddd",
                                                "sense_id": "4672f238-6b06-3cef-b295-63b8d341cb14",
                                                "text": "At the very moment he cried out, David realised that what he had run into was only the Christmas tree. . . . There were no sounds of any movement upstairs: no shouts, no sleepy grumbles, only a gentle tinkle from the decorations as the tree had recovered from the collision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3914eed-caa2-3e3d-9b14-dd22644cd2ba",
                                        "entry_id": "083701f0-31c5-3e76-8c2b-ffbf3de99aa4",
                                        "glosses": [
                                            "A telephone call."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6209ffe1-d221-4557-b273-b9cc028354a5",
                                                "sense_id": "d3914eed-caa2-3e3d-9b14-dd22644cd2ba",
                                                "text": "Give me a tinkle when you arrive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af51f1c2-50c7-3ec7-b1b6-6a93ddac87d0",
                                        "entry_id": "083701f0-31c5-3e76-8c2b-ffbf3de99aa4",
                                        "glosses": [
                                            "An act of urination."
                                        ],
