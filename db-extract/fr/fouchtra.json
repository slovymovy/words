                            {
                                "example_id": "f145abef-006e-4dca-af7c-530422641e03",
                                "sense_id": "54100486-ee52-3999-b586-658e7ef294c3",
                                "text": "Monsieur le sait bien. Voilà huit jours que cela dure. − Mais non, fouchtra ! Je ne le chais pas."
                            },
                            {
                                "example_id": "7a41b514-ee1a-4d04-ada4-489d15d4065a",
                                "sense_id": "54100486-ee52-3999-b586-658e7ef294c3",
                                "text": "L’apparition chante :\nChé la bourra, la la\nOui la bourra, fouchtra !"
                            }
                        ]
                    }
                ],
