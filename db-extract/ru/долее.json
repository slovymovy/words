                        "sense_id": "f43dda81-ba00-3301-99f8-49d571f6dffe",
                        "entry_id": "aef2c1ff-f9e7-3622-bbad-24d6faedf878",
                        "glosses": [
                            "устар. сравн. ст. к прил. долгий; длиннее"
                        ],
