                        "examples": [
                            {
                                "example_id": "392c16a1-6a0e-48c3-95be-b6e9489d7512",
                                "sense_id": "976e2984-eaa2-3b13-a123-1556e90a9b2a",
                                "text": "„Mit einer Scherbe habe er am Kaninchenloch gebuddelt, um das Häslein herauszuholen.“"
                            },
                            {
                                "example_id": "642d57fd-2f9b-4064-8f49-1731a205b160",
                                "sense_id": "976e2984-eaa2-3b13-a123-1556e90a9b2a",
                                "text": "„So ritt er denn einem Dorfe zu, durch das seine Straße führte, und streichelte zuweilen das Häslein auf seinem Arme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
