                "senses": [
                    {
                        "sense_id": "d510a3b4-8891-3e59-95fb-8b79d30c665f",
                        "entry_id": "a5a1df19-1d63-3646-be67-a159c5a69388",
                        "glosses": [
                            "Staatenbund des Vereinigten Königreichs mit einigen seiner ehemaligen Kolonien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d917773-5766-4087-8094-45ecbaf0b1b5",
                                "sense_id": "d510a3b4-8891-3e59-95fb-8b79d30c665f",
                                "text": "„Diese ursprüngliche Rechtseinheit findet ihren Ausdruck immer noch – wenngleich auch in zunehmend geringerem Ausmaß – in der Institution des Judicial Committee of the Privy Council, das u.a. Funktionen der Appellationsgerichtsbarkeit für den Commonwealth wahrnahm und dies für einige Staaten auch heute noch tut.“"
                            },
                            {
                                "example_id": "8192707f-bd3b-40ad-aa0f-d98709ca76bd",
                                "sense_id": "d510a3b4-8891-3e59-95fb-8b79d30c665f",
                                "text": "„Mit der wachsenden Eigenständigkeit einer Reihe von Dominions (Indien, Australien, Neuseeland, Kanada, Irland) wurde das British Empire in den Commonwealth of Nations umgewandelt.“"
                            },
                            {
                                "example_id": "98c9563f-f84f-4503-ba77-02381bf66b4b",
                                "sense_id": "d510a3b4-8891-3e59-95fb-8b79d30c665f",
                                "text": "„Der Commonwealth of Nations, meist kurz Commonwealth, ist eine Vereinigung unabhängiger Staaten (2009: 53 Mitglieder), die historisch aus dem Vereinigten Königreich und seinen ehemaligen Kolonien, dem Britischen Empire, hervor gegangen ist.“"
                            },
                            {
                                "example_id": "a30128ee-e380-4414-899c-fbac38cb6b77",
                                "sense_id": "d510a3b4-8891-3e59-95fb-8b79d30c665f",
                                "text": "„Dennoch reagierte die internationale Staatengemeinschaft auf die Atomtests von 1998 kritisch: Von 1999 bis 2004 wurde Pakistan aus dem Commonwealth ausgeschlossen; die USA und die EU erließen Sanktionen, die erst mit Beginn des «Kriegs gegen den Terrorismus» wieder gelockert wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a783eb2-f2e5-4943-af77-2b001966807b",
                        "source_entry_id": "a5a1df19-1d63-3646-be67-a159c5a69388",
                        "source_sense_id": "d510a3b4-8891-3e59-95fb-8b79d30c665f",
                        "source_sense_description": "Staatenbund des Vereinigten Königreichs mit einigen seiner ehemaligen Kolonien",
                        "target_lang_word": "Commonwealth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Commonwealth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c154fd7b-2979-3daa-b3a1-5cf11a9407c0",
                                        "entry_id": "77411f4a-acca-3ad1-800c-593a6e26f335",
                                        "glosses": [
                                            "The Commonwealth of Nations, a loose confederation of nations based around the former British Empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a68fd46-85cc-413f-a23f-48e629547966",
                                                "sense_id": "c154fd7b-2979-3daa-b3a1-5cf11a9407c0",
                                                "text": "Mozambique joined the Commonwealth in 1995, although it had not been a part of the British Empire."
                                            },
                                            {
                                                "example_id": "bb36b510-4dc8-4df4-9b37-b5bba4b018b0",
                                                "sense_id": "c154fd7b-2979-3daa-b3a1-5cf11a9407c0",
                                                "text": "Malaysia, Singapore and Brunei, being former British colonies, are the only Southeast Asian member countries of the Commonwealth."
                                            },
                                            {
                                                "example_id": "10b268cb-4489-4bf9-bf31-58e784680f03",
                                                "sense_id": "c154fd7b-2979-3daa-b3a1-5cf11a9407c0",
                                                "text": "As a Commonwealth citizen, you are eligible to vote in United Kingdom elections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f67762c1-03a3-34e3-aa2d-cdf13033d989",
                                        "entry_id": "77411f4a-acca-3ad1-800c-593a6e26f335",
                                        "glosses": [
                                            "The Commonwealth of England (1649–1653); the Commonwealth of England, Scotland and Ireland (1653–1660)."
                                        ],
                                        "tags": [
                                            "British",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a3608fd-a758-470b-9ef0-e8144db78edb",
                                                "sense_id": "f67762c1-03a3-34e3-aa2d-cdf13033d989",
                                                "text": "Near-synonyms: Protectorate; Interregnum"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "457f75f0-1053-317b-90db-de76ec8b9344",
                                        "entry_id": "77411f4a-acca-3ad1-800c-593a6e26f335",
                                        "glosses": [
                                            "Australia, the Commonwealth of Australia, often referring to its federal government."
