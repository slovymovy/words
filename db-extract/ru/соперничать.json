                ],
                "translations": [
                    {
                        "translation_id": "4541c551-81d8-41b9-b8e6-4e5f703a403f",
                        "source_entry_id": "6df3fff1-09d9-331f-9314-f24514f0c451",
                        "target_lang_word": "rival",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rival",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1835233-f27e-3df1-a008-9c4202e34b8e",
                                        "entry_id": "e2f18c84-d4ae-3ca9-96a3-855435e1ec2b",
                                        "glosses": [
                                            "A competitor (person, team, company, etc.) with the same goal as another, or striving to attain the same thing. Defeating a rival may be a primary or necessary goal of a competitor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4415a4d4-cdd2-4371-aa26-7e36bb3f9943",
                                                "sense_id": "a1835233-f27e-3df1-a008-9c4202e34b8e",
                                                "text": "Chris is my biggest rival in the 400-metre race."
                                            },
                                            {
                                                "example_id": "0ed25a17-784c-4afe-9922-f03ec124ed18",
                                                "sense_id": "a1835233-f27e-3df1-a008-9c4202e34b8e",
                                                "text": "Every day is like survival / You're my lover, not my rival"
                                            },
                                            {
                                                "example_id": "ec3eed7d-c5ea-4dc2-b9ac-9a426db7a44a",
                                                "sense_id": "a1835233-f27e-3df1-a008-9c4202e34b8e",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about […], or offering services that let you[…] \"share the things you love with the world\" and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "694c054a-2854-3bb9-b1c3-16535fc745dd",
                                        "entry_id": "e2f18c84-d4ae-3ca9-96a3-855435e1ec2b",
                                        "glosses": [
                                            "Someone or something with similar claims of quality or distinction as another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e9047ae-4d80-4894-8398-36ac95d7eb6d",
                                                "sense_id": "694c054a-2854-3bb9-b1c3-16535fc745dd",
                                                "text": "As a social historian, he has no rival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a997d8a4-04c2-348a-a6c7-798f848d4f05",
                                        "entry_id": "e2f18c84-d4ae-3ca9-96a3-855435e1ec2b",
                                        "glosses": [
                                            "One having a common right or privilege with another; a partner."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d0bd42-04b8-441c-ab05-75419d76d0d0",
                                                "sense_id": "a997d8a4-04c2-348a-a6c7-798f848d4f05",
                                                "text": "If you do meet Horatio and Marcellus, / The rivals of my watch, bid them make haste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rival",
