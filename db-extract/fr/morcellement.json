        "fr-extract.jsonl": [
            {
                "entry_id": "474fff4c-edaa-3108-b833-b350c05d4226",
                "word": "morcellement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a13ddde-ba5f-4acb-b0cf-221186b7239f",
                        "entry_id": "474fff4c-edaa-3108-b833-b350c05d4226",
                        "tags": [
