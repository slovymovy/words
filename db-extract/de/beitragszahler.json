                        "sense_id": "8942ae4b-1970-3435-a964-ce1347af37c3",
                        "entry_id": "3e7149a2-0e8c-3ee7-ab04-6da4e95b2418",
                        "glosses": [
                            "jemand, der regelmäßig Geldbeträge an eine Versicherung, für die Mitgliedschaft in einem Verein oder Ähnliches bezahlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31706243-bc2b-43fe-867a-1b2ee1aaf9db",
                                "sense_id": "8942ae4b-1970-3435-a964-ce1347af37c3",
                                "text": "„Es ist ein Gemeinplatz, dass Menschen, seien sie Steuer- oder Beitragszahler, ungern sehen, wie andere es sich auf ihre Kosten bequem machen.“"
                            },
                            {
                                "example_id": "a31afb23-2090-4074-b870-5a7662381296",
                                "sense_id": "8942ae4b-1970-3435-a964-ce1347af37c3",
                                "text": "„Als Rentenbezugsdauer bezeichnet man in Deutschland die Zeit, in der ein Beitragszahler der gesetzlichen Rentenversicherung eine Rente erhält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
