                "forms": [],
                "senses": [
                    {
                        "sense_id": "8caa8bdc-9bba-3899-ad09-386517c723cb",
                        "entry_id": "4c168d0e-9867-3bae-9dc7-cf91254d46b4",
                        "glosses": [
