                "senses": [
                    {
                        "sense_id": "0d08b035-8bc6-3e72-99b4-ca2a5f770497",
                        "entry_id": "6d20725c-3480-37cd-8be2-f457a3f82d2a",
                        "glosses": [
                            "im italienischen Piemont gelegene Großstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fa218a3-973b-4521-9eb9-901f670ae5a3",
                                "sense_id": "0d08b035-8bc6-3e72-99b4-ca2a5f770497",
                                "text": "„Ein Amokläufer hat im norditalienischen Dorf Bogogno bei Novara drei Menschen erschossen und neun weitere verletzt.“"
                            },
                            {
                                "example_id": "6cb6ddff-9631-4a54-9097-3c5649130b61",
                                "sense_id": "0d08b035-8bc6-3e72-99b4-ca2a5f770497",
                                "text": "„Mit seinem kleinen Einkommen lebte er in Bologna angenehmer als in Novara, wo das Leben viel teurer war und ihn alles anödete; seine Verwandten waren ihm lästig, die Freundschaften platt und die Unwissenheit allgemein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
