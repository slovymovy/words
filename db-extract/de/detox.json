                "senses": [
                    {
                        "sense_id": "f9389658-e829-35af-93d8-241a4fca889a",
                        "entry_id": "b36b85b1-4a71-38a9-a3af-4621ecd8ac0e",
                        "glosses": [
                            "Entgiftung"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c23cbb65-ef6f-45b2-9f7f-9821c7bbcc0d",
                                "sense_id": "f9389658-e829-35af-93d8-241a4fca889a",
                                "text": "„Das Schöne an Detox ist zudem, dass wir dieses Reinigungsprogramm individuell in unseren Alltag einbauen können.“"
                            },
                            {
                                "example_id": "ab281766-071e-4ca5-9e84-28667b4c02f0",
                                "sense_id": "f9389658-e829-35af-93d8-241a4fca889a",
                                "text": "„Es freut mich, dass Sie Detox ausprobieren wollen! Ich liebe es, meinen Mitmenschen dabei zu helfen, den Körper von Altem zu befreien und mit neuer, sprudelnder Energie aufzuladen.“"
                            },
                            {
                                "example_id": "44d23aba-bd59-4b8d-8fda-391387bfee26",
                                "sense_id": "f9389658-e829-35af-93d8-241a4fca889a",
                                "text": "„Seit meiner 20jährigen Praxiserfahrung habe ich noch nie einen einzigen Klienten getroffen, der ein Detox richtig durchgeführt hat.“"
                            },
                            {
                                "example_id": "0d994a6c-4e81-4176-ba8f-3e280b52afe6",
                                "sense_id": "f9389658-e829-35af-93d8-241a4fca889a",
                                "text": "„Das ganze am besten ohne viel Zeitaufwand, komplizierte Diäten, Kalorienrechner, Entschlackungspulver oder ekelhafte Shakes. Mit ‚Detox hoch 2‘ ist genau das machbar, und zwar in nur einer Woche!“"
                            },
                            {
                                "example_id": "ba108580-429c-49c1-b461-a9dc767e1914",
                                "sense_id": "f9389658-e829-35af-93d8-241a4fca889a",
                                "text": "„Unnötig bis unwirksam lautet das Urteil von Thomas Zilker über Detox, Leiter der Toxikologie an der TU München.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
