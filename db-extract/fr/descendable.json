                        "sense_id": "cb9e0253-52f7-3325-8282-cf97932d7254",
                        "entry_id": "35faa87d-9d96-3550-81dc-ea14eb05d89a",
                        "glosses": [
                            "Que l’on peut descendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f06c58e-7685-48af-a5c6-6c649cc71402",
                                "sense_id": "cb9e0253-52f7-3325-8282-cf97932d7254",
                                "text": "Même si l’autre est descendable, on n’a pas besoin de le descendre pour valoir quoi que ce soit."
                            },
                            {
                                "example_id": "4db396da-9ae5-42a1-9be5-7790b5693888",
                                "sense_id": "cb9e0253-52f7-3325-8282-cf97932d7254",
                                "text": "La période cyclonique, très pluvieuse, est celle où de petits groupes de kayakistes sont à l’affût du moindre bout de rivière descendable."
                            },
                            {
                                "example_id": "3515f404-cdda-464e-921f-2c2b7da8779f",
                                "sense_id": "cb9e0253-52f7-3325-8282-cf97932d7254",
                                "text": "Monter directement au-dessus du téléski sommital de la petite station du Granier (1000 m) jusqu’à ce que la pente devienne bien raide (par bon enneigement, la pente est descendable par un itinéraire astucieux, à bien repérer)."
                            }
                        ]
                    }
                ],
