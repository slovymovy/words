                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82f8c702-ce0b-42cb-b6d9-fa6917225f58",
                                "sense_id": "ab421072-e075-3d93-9f56-65d4a9e4f874",
                                "text": "Let op dat je het originele product koopt en géén nabootsing!"
                            }
                        ]
