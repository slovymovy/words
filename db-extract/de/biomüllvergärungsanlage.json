                "senses": [
                    {
                        "sense_id": "fb2e115a-e4f2-3ab2-be9c-cd799f40e5b1",
                        "entry_id": "3497e25f-059f-3aa9-82ef-0ffd668a2baf",
                        "glosses": [
                            "Anlage zur Vergärung von biologischem Abfall (z.B. Grünabfall und Biotonne) mit dem Ziel der Erzeugung von Biogas (Einspeisung in ein Gas-Kraftwerk) und dem Abfallprodukt hiernach, Pflanzerde zur Beetbepflanzung, für Begrünungsflächen oder zur Ausbringung auf Ackerfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef16b3f6-cc85-4430-ad35-5de8e8652b74",
                                "sense_id": "fb2e115a-e4f2-3ab2-be9c-cd799f40e5b1",
                                "text": "In einer Biomüllvergärungsanlage wird der angeliefert Biomüll zu Biogas und Pflanzerde vergoren."
                            },
                            {
                                "example_id": "54d94d02-a501-430e-93a0-fc02abcaddc2",
                                "sense_id": "fb2e115a-e4f2-3ab2-be9c-cd799f40e5b1",
                                "text": "„In der alten Kläranlage in der Flurstraße entstand die Biomüllvergärungsanlage.“"
                            },
                            {
                                "example_id": "f6bdc201-2e07-432e-bb31-8e981e870ed1",
                                "sense_id": "fb2e115a-e4f2-3ab2-be9c-cd799f40e5b1",
                                "text": "„Ein Megawatt steuert die Biomüllvergärungsanlage bei.“"
                            },
                            {
                                "example_id": "ffa75056-652c-415d-8fdb-1053cd668bde",
                                "sense_id": "fb2e115a-e4f2-3ab2-be9c-cd799f40e5b1",
                                "text": "„Bis Jahresende sei geplant, die neue Nachbehandlungsstufe der Biomüllvergärungsanlage in Betrieb zu nehmen.“"
                            },
                            {
                                "example_id": "5eb60c1e-65a1-4ca5-b14a-325fc309d8c5",
                                "sense_id": "fb2e115a-e4f2-3ab2-be9c-cd799f40e5b1",
                                "text": "„Die Stadt Pfaffenhofen hat sich noch auf keinen konkreten Standort für eine Biomüllvergärungsanlage festgelegt.“"
                            },
                            {
                                "example_id": "e10252e2-98ea-4241-8aac-8a551d69dfde",
                                "sense_id": "fb2e115a-e4f2-3ab2-be9c-cd799f40e5b1",
                                "text": "„Optimierung des Sequencing Batch Reactors einer Biomüllvergärungsanlage in der Phase des Probebetriebs.“"
                            },
                            {
                                "example_id": "571226cf-a7c1-4584-bbcc-8536b91550f6",
                                "sense_id": "fb2e115a-e4f2-3ab2-be9c-cd799f40e5b1",
                                "text": "„…, ob die Vergärung der nassen Abfälle prinzipiell möglich ist und wie viel Energie in Form von Biogas und mit welcher Qualität in Vergleich zur Vergärung von Biomüll in (Biomüllvergärungsanlagen) bzw. Restmüll (in MBAs) gewonnen wird.“"
                            },
                            {
                                "example_id": "00343211-0a27-40e6-ac37-f5c39b80e3d7",
                                "sense_id": "fb2e115a-e4f2-3ab2-be9c-cd799f40e5b1",
                                "text": "„Biomüllvergärungsanlage Flörsheim“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
