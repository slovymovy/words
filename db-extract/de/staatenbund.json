                    {
                        "sense_id": "bc4fdbad-1bf3-3810-871a-ed2632096766",
                        "entry_id": "1a5ff537-0cd9-3a54-bc48-ad64493810a6",
                        "glosses": [
                            "Bund zwischen mehreren Staaten"
