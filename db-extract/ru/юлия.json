                "senses": [
                    {
                        "sense_id": "ba788bee-c4eb-330c-ba9c-8160f0de4306",
                        "entry_id": "03622ab7-b6ea-3363-b21a-555905c7ea10",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d21b4361-445b-4c5d-9692-0e1f0277bf00",
                                "sense_id": "ba788bee-c4eb-330c-ba9c-8160f0de4306",
                                "text": "Жена его, Юлия Клари, дочь бордоского купца, ― ангел доброты."
                            },
                            {
                                "example_id": "0c29ca5c-458e-4b3d-b7e4-98fcc517a882",
                                "sense_id": "ba788bee-c4eb-330c-ba9c-8160f0de4306",
                                "text": "Княжна Юлия ходила слегка бледная, иногда украдкой утирала слезы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c10d384-b080-44a8-8399-d4164dfb307a",
                        "source_entry_id": "03622ab7-b6ea-3363-b21a-555905c7ea10",
                        "source_sense_id": "ba788bee-c4eb-330c-ba9c-8160f0de4306",
                        "source_sense_description": "Перевод",
                        "target_lang_word": "Yuliya",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0a3dc665-ccc7-47e0-abd2-531ed1fa65ac",
                        "source_entry_id": "03622ab7-b6ea-3363-b21a-555905c7ea10",
                        "source_sense_id": "ba788bee-c4eb-330c-ba9c-8160f0de4306",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Julia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Julia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d64d93f-609f-4dbe-b68a-4c44cd57cdfb",
                                                "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                                "text": "Salute Philologus & Iulia, Nereus, and his sister, and Olympas, and all the Saints which are with them."
                                            },
                                            {
                                                "example_id": "09289f31-c7bd-4809-8144-a7d3143a4159",
                                                "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                                "text": "\"Julia!\" when alone he would exclaim; \"what a sweet sounding and romantic name: Julia! what music and magic in its sound! 'tis a name worthy only the fairest and purest of creation!"
                                            },
                                            {
                                                "example_id": "ae793d68-b9a3-4e4f-ac9e-30557646b2d0",
                                                "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                                "text": "“Why, I mean,” I replied, recoiling, “I mean—in short—that—in other words—I didn't know your name was Julia.”"
                                            },
                                            {
                                                "example_id": "bdf262cd-cf64-4841-a535-ab428bdd43e0",
                                                "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                                "text": "\"Why did you name her Julia?\" Amy asked, letting the orange ice cream melt down the backs of her hands.\n\"Because it sounds dignified.\""
                                            },
                                            {
                                                "example_id": "45f33836-a7c8-4dcf-9c02-75705c8eb7e2",
                                                "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                                "text": "In an order issued Tuesday evening in the ongoing lawsuit Orr v. Trump, Massachusetts District Judge Julia Kobick expanded the preliminary injunction she issued in April, which required the State Department to issue passports that match the plaintiffs’ gender identities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1833133-945b-3668-b048-aa9d23924d81",
                                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                                        "glosses": [
                                            "89 Julia, a main belt asteroid; named for Saint Julia of Corsica."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eed35034-2bae-389a-812a-dc700f2478af",
                                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                                        "glosses": [
                                            "A village in central Poland."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c19bb966-ff03-36a1-a850-ceb1fd70dd78",
                                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                                        "glosses": [
                                            "A French surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06ba3227-e815-393c-92d0-0bd0d92c7705",
                                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                                        "glosses": [
                                            "A programming language suited for numerical analysis and scientific computing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848b7430-24be-4793-b89a-3a569ae9de34",
                                                "sense_id": "06ba3227-e815-393c-92d0-0bd0d92c7705",
                                                "text": "And then came Julia, a general purpose programming language designed according to the requirements of scientific and technical computing, providing performance comparable to C/C++, and with an environment productive enough for prototyping like the high-level dynamic language of Python."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
