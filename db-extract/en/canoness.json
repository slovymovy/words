                                "target_senses": [
                                    {
                                        "sense_id": "7515bead-8465-364a-b743-6804d55a2eac",
                                        "entry_id": "aa26f7de-ff67-3fec-bf92-fc2df717553b",
                                        "glosses": [
                                            "Celle qui possédait une prébende dans un chapitre de femmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44dddfb-f934-4bce-ab87-3a89495d3385",
                                                "sense_id": "7515bead-8465-364a-b743-6804d55a2eac",
                                                "text": "À cette époque peut-être, Samuel, mort à la peine, sera cloué sous la lame, comme il le disait en son bon temps, et la Fanfarlo, avec ses airs de chanoinesse, fera tourner la tête d’un jeune héritier."
                                            },
                                            {
                                                "example_id": "1a28543f-8c36-4b71-81d5-c3c14024ed8a",
                                                "sense_id": "7515bead-8465-364a-b743-6804d55a2eac",
                                                "text": "Chaque année, les chanoinesses élisaient entre elles la bâtonnière, dont les fonctions consistaient à porter les insignes du chapitre noble, dans les processions générales et à l’inauguration du souverain."
                                            },
                                            {
                                                "example_id": "645d2fc7-ad5a-483d-a7c0-86a8e4dcc12b",
                                                "sense_id": "7515bead-8465-364a-b743-6804d55a2eac",
                                                "text": "La chambre de Mme Élisabeth, chanoinesse de plusieurs ordres, était tout entière d’un gris d’acier désolant le regard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e4b160c-0200-354c-8b80-dcd47f7bb681",
                                        "entry_id": "aa26f7de-ff67-3fec-bf92-fc2df717553b",
                                        "glosses": [
                                            "Titre honorifique conféré à des laïques par des communautés religieuses étrangères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce8ac8a-7dca-4c12-9ebb-ef151c3b261b",
                                                "sense_id": "9e4b160c-0200-354c-8b80-dcd47f7bb681",
                                                "text": "Ce chapitre de chanoinesses, qui devait la former à la vie mystique, était une de ces institutions quarteronnes, ni tout à fait blanches, ni tout à fait noires, une métisse issue d’une religion profane et d’un laïquat pieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
