        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                    "sense_definition": "To intimidate, frighten, or domineer over someone, often forcing them to do something against their will.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_intimidate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not let them <w>bully</w> you into making a decision you regret.",
                            "target_lang_translations": {
                                "ru": "Не позволяй им <w>запугать</w> тебя и заставить принять решение, о котором ты пожалеешь.",
                                "nl": "Laat je niet <w>dwingen</w> om een beslissing te nemen waar je spijt van krijgt.",
                                "de": "Lass dich nicht dazu <w>schikanieren</w>, eine Entscheidung zu treffen, die du bereust."
                            }
                        },
                        {
                            "text": "He tried to <w>bully</w> the witness into silence.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>запугать</w> свидетеля, чтобы тот молчал.",
                                "nl": "Hij probeerde de getuige te <w>intimideren</w> om hem tot zwijgen te brengen.",
                                "de": "Er versuchte, den Zeugen durch <w>Einschüchterung</w> zum Schweigen zu bringen."
                            }
                        }
                    ],
