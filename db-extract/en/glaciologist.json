                                "target_senses": [
                                    {
                                        "sense_id": "3f52730d-d568-3792-882f-6f3816689f3f",
                                        "entry_id": "68fa97fa-97f7-3a47-8075-fe008a151faa",
                                        "glosses": [
                                            "Wissenschaftler, der sich mit der Glaziologie beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "122857b0-9c54-40e1-b003-4a6c8037025f",
                                                "sense_id": "3f52730d-d568-3792-882f-6f3816689f3f",
                                                "text": "„Nun ist es Glaziologen der ETH Zürich gelungen, für zwölf Schweizer Gletscher aus vorhandenen Daten die Veränderung des Eisvolumens nachzuzeichnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43426339-1265-471c-9b6c-8929c1b8b2d9",
