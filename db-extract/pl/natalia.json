                    {
                        "translation_id": "41598522-e2ba-4886-abb3-211cb075d59f",
                        "source_entry_id": "1428506e-660f-35b7-bfef-35163eced32f",
                        "source_sense_id": "53e78f89-21bb-3eb0-ac5c-ea65f98f0e60",
                        "target_lang_word": "Nathalie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nathalie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09288efa-5593-3f13-a17b-0709b1c9a0a2",
                                        "entry_id": "36553f0d-72cb-3a75-bb48-0e3c5b932ee2",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76e8529-e44e-4a9a-bb53-5e034f619dc0",
                                                "sense_id": "09288efa-5593-3f13-a17b-0709b1c9a0a2",
                                                "text": "Il se convainquit que si Nathalie n’était pas pourvue des attraits de Madame Pavin, elle en avait que des yeux avisés savaient peser et priser, plus clairvoyants que les siens qu’il urgeait de décataracter."
                                            },
                                            {
                                                "example_id": "1e7102c3-eef9-49c3-83a6-6a32fc6db627",
                                                "sense_id": "09288efa-5593-3f13-a17b-0709b1c9a0a2",
                                                "text": "Les tenants de la Terre plate s’affirment ! En 2019, une conseillère municipale de Gatineau, Nathalie Lemieux, dans un message, a écrit : « Qui a décidé que la Terre est ronde et pourquoi le croire lui ? »"
                                            },
                                            {
                                                "example_id": "46999fb8-9080-44e8-bc35-c56342bd6ef4",
                                                "sense_id": "09288efa-5593-3f13-a17b-0709b1c9a0a2",
                                                "text": "La place Rouge était vide\n Je lui pris son bras, elle a souri\n Il avait des cheveux blonds, mon guide\n Nathalie, Nathalie…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
