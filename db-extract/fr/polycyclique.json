                "senses": [
                    {
                        "sense_id": "756d3dc7-17b3-3bec-9114-99f7422ed5a6",
                        "entry_id": "bb98da0a-5721-3de3-bc71-3e5435e1ec0c",
                        "glosses": [
                            "Se dit des composés formés de plusieurs cycles d’atomes de carbone, avec parfois de l’azote, du soufre ou de l’oxygène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f075f51-0b17-4139-a23e-897e61058031",
                                "sense_id": "756d3dc7-17b3-3bec-9114-99f7422ed5a6",
                                "text": "On sépare les composés polycycliques en composés polycycliques aliphatiques et en composés polycycliques aromatiques."
                            },
                            {
                                "example_id": "badd3eab-9f21-446d-8682-469d890dea40",
                                "sense_id": "756d3dc7-17b3-3bec-9114-99f7422ed5a6",
                                "text": "[…] Si, en prime, la viande rouge est grillée, elle se charge en hydrocarbures aromatiques polycycliques qui sont de puissants cancérogènes."
                            },
                            {
                                "example_id": "86aa99f9-ac41-4aa3-92a1-77cd7afc6489",
                                "sense_id": "756d3dc7-17b3-3bec-9114-99f7422ed5a6",
                                "text": "L’opération de séchage indispensable pour éviter le noircissement des euilles apporte aussi sa ribambelle de contaminants. En l’occurrence, des hydrocarbures aromatiques polycycliques."
                            }
                        ]
                    }
                ],
