        "pl-extract.jsonl": [
            {
                "entry_id": "2ce5262e-75b3-3063-941e-faf1ab610b84",
                "word": "zasłużenie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "db4746f1-d161-3041-84d9-c196bf3ea59a",
                        "entry_id": "2ce5262e-75b3-3063-941e-faf1ab610b84",
                        "glosses": [
                            "zgodnie z czyimiś zasługami, słusznie, tak, jak się komuś należy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c7e777-4754-4bc7-8384-cbd33e80e2af",
                                "sense_id": "db4746f1-d161-3041-84d9-c196bf3ea59a",
                                "text": "Całkiem zasłużenie przyznano nam pierwsze miejsce."
                            },
                            {
                                "example_id": "8a2aee1e-c1a6-49f2-b76e-d805b241a562",
                                "sense_id": "db4746f1-d161-3041-84d9-c196bf3ea59a",
                                "text": "Został zasłużenie ukarany za swe niecne czyny."
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8df96451-bc6c-4c67-aa6c-3612f71367b9",
                        "source_entry_id": "2ce5262e-75b3-3063-941e-faf1ab610b84",
                        "source_sense_id": "db4746f1-d161-3041-84d9-c196bf3ea59a",
                        "target_lang_word": "deservedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deservedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c4a4099-b2a2-365a-b34b-53dd7205220c",
                                        "entry_id": "473880c3-20d0-36a7-bb67-423975c4467a",
                                        "glosses": [
                                            "In a way or to a degree that is deserved or merited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e70ef86-d2a8-4b92-ab94-baebbef7b81e",
                                                "sense_id": "6c4a4099-b2a2-365a-b34b-53dd7205220c",
                                                "text": "1847-48, William Makepeace Thackeray, Vanity Fair, 2008, Digireads.com Publishing, page 437,\nEmmy, he remembered, was at one time cruelly and deservedly jealous of Rebecca, […] ."
                                            },
                                            {
                                                "example_id": "f4150d8c-f3d0-4e9e-ac75-503bb58326dc",
                                                "sense_id": "6c4a4099-b2a2-365a-b34b-53dd7205220c",
                                                "text": "THE Jesuits have been condemned, and deservedly condemned, by the unanimous consent of the whole of Christendom."
                                            },
                                            {
                                                "example_id": "a8754c45-4f93-407b-8922-4530c8725361",
                                                "sense_id": "6c4a4099-b2a2-365a-b34b-53dd7205220c",
                                                "text": "1986, Facts on File, Editorials on File, Volume 17, Part 2, Infobase Publishing, page 949,\nThe vote for Scalia was unanimous, and deservedly so."
                                            },
                                            {
                                                "example_id": "e8ba1d63-ba2f-4e88-81ff-899ea801446a",
                                                "sense_id": "6c4a4099-b2a2-365a-b34b-53dd7205220c",
                                                "text": "Elsad Zverotic gave Montenegro hope with a goal with the last kick of the first half - and when Rooney was deservedly shown red by referee Wolfgang Stark, England were placed under pressure they could not survive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3f42c9d-91c5-4c29-b4e0-3533a5bd48d0",
                        "source_entry_id": "2ce5262e-75b3-3063-941e-faf1ab610b84",
                        "source_sense_id": "db4746f1-d161-3041-84d9-c196bf3ea59a",
                        "target_lang_word": "justly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "justly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "480d0f42-325f-3eec-9eb3-649b4df1cf26",
                                        "entry_id": "673e195d-4bb9-396f-a507-ca2accdc3237",
                                        "glosses": [
                                            "In a just or fair manner; rightfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fdcea92-28e7-4d8a-9445-49980099386e",
                                                "sense_id": "480d0f42-325f-3eec-9eb3-649b4df1cf26",
                                                "text": "His valor, wisdom, and justice made him justly popular, but caused him to be regarded with suspicion at Rome."
                                            },
                                            {
                                                "example_id": "d45cc367-5b84-41d1-b2b9-bde6f369569d",
                                                "sense_id": "480d0f42-325f-3eec-9eb3-649b4df1cf26",
                                                "text": "Mention must be made of the Valdres Folk Museum, situated just outside the town—one of those fascinating open-air museums for which Scandinavia is justly famed, to which have been transplanted a number of ancient buildings, such as farmhouses and storehouses, full of appropriate furniture, costumes and other exhibits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06386027-b66a-3935-9d60-13d0504ec42d",
                                        "entry_id": "673e195d-4bb9-396f-a507-ca2accdc3237",
                                        "glosses": [
                                            "With a just or fair use of language; with good reason, properly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1997e5aa-b073-4876-ba67-06c95c2fa49e",
                                                "sense_id": "06386027-b66a-3935-9d60-13d0504ec42d",
                                                "text": "But the city on the River Clyde can justly claim to have turned the tide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5982e073-52ca-39c0-9734-fdf0af3a8610",
                                        "entry_id": "673e195d-4bb9-396f-a507-ca2accdc3237",
                                        "glosses": [
                                            "With great precision; accurately, exactly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b7e8398-00a3-4e11-8b0f-7464487149ad",
                                                "sense_id": "5982e073-52ca-39c0-9734-fdf0af3a8610",
                                                "text": "It is a pleasant imagination to conceive a spirit iustly ballanced betweene two equall desires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc1879ad-9921-417f-b5fc-8e601c33accf",
                        "source_entry_id": "2ce5262e-75b3-3063-941e-faf1ab610b84",
                        "source_sense_id": "db4746f1-d161-3041-84d9-c196bf3ea59a",
                        "target_lang_word": "verdientermaßen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdientermaßen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bda7a1e-20b6-34d0-8e3a-10f657a266a1",
                                        "entry_id": "d6ce18da-26c8-36d1-9b00-2128c39d168c",
                                        "glosses": [
                                            "der erbrachten Leistung angemessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4be20bd-d60f-4b59-a234-259d72d37096",
                                                "sense_id": "8bda7a1e-20b6-34d0-8e3a-10f657a266a1",
                                                "text": "Die Mannschaft gewann verdientermaßen."
                                            },
                                            {
                                                "example_id": "1f0ddcdb-2ea2-48ba-ab4e-c192852e7169",
                                                "sense_id": "8bda7a1e-20b6-34d0-8e3a-10f657a266a1",
                                                "text": "Ihr wurde verdientermaßen der Friedensnobelpreis verliehen."
                                            },
                                            {
                                                "example_id": "87e6fd26-c44b-4de9-8b5d-521f765ab44a",
                                                "sense_id": "8bda7a1e-20b6-34d0-8e3a-10f657a266a1",
                                                "text": "Seine Leistungen waren unterdurchschnittlich, weshalb ihm verdientermaßen die Prämie vorenthalten wurde."
                                            },
                                            {
                                                "example_id": "8d8e0567-c3d0-4af8-ade1-19145ef5de96",
                                                "sense_id": "8bda7a1e-20b6-34d0-8e3a-10f657a266a1",
                                                "text": "\"Geldpolitiker sind verdientermaßen Helden.\" Raghuram Rajan"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
