                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bac2cdb-6620-4f3b-a93f-c2faa7d6c3b0",
                                "sense_id": "ffc455aa-ad65-3e2c-ae0c-93d454d04229",
                                "text": "„Die mit silbernen Palmen geschmückte Bühne in der Mitte des Hauptraums strahlte.“"
                            },
                            {
                                "example_id": "815c06df-3a58-4eab-9cb7-76d1d4f5a521",
                                "sense_id": "ffc455aa-ad65-3e2c-ae0c-93d454d04229",
                                "text": "„Der mit Zedernholz getäfelte und reichlich mit Gold verzierte Hauptraum mit dem Schrein war rund 30 Meter lang, etwa 10 Meter breit und 15 Meter hoch.“"
                            },
                            {
                                "example_id": "96357528-76f5-433a-82b7-3221590ae33e",
                                "sense_id": "ffc455aa-ad65-3e2c-ae0c-93d454d04229",
                                "text": "„Sie befanden sich im Hauptraum der Festung.“"
                            }
                        ],
