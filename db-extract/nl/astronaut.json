                                "sense_id": "9ef06830-6fff-36b1-be6e-2db3b9ec9770",
                                "text": "De astronaut bereidt zich voor op een wandeling in de ruimte.",
                                "translation": "The astronaut is preparing for a spacewalk.",
                                "english": "The astronaut is preparing for a spacewalk."
                            },
                            {
                                "example_id": "7ecd11af-3ccd-466a-8167-55b888be3ebb",
                                "sense_id": "9ef06830-6fff-36b1-be6e-2db3b9ec9770",
                                "text": "Als kind droomde hij ervan om astronaut te worden.",
                                "translation": "As a child, he dreamt of becoming an astronaut.",
                                "english": "As a child, he dreamt of becoming an astronaut."
                            },
                            {
                                "example_id": "1dab17ed-79f9-421d-8cc9-006665dd9132",
                                "sense_id": "9ef06830-6fff-36b1-be6e-2db3b9ec9770",
                                "text": "De training van een astronaut is intensief en uitdagend.",
                                "translation": "The training of an astronaut is intensive and challenging.",
                                "english": "The training of an astronaut is intensive and challenging."
                            }
                        ]
