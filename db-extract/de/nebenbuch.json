                "senses": [
                    {
                        "sense_id": "6c24b1a1-da53-3910-ac90-32e8bb13a9b1",
                        "entry_id": "5194b00c-4ead-3db4-b810-3eceed5d4ded",
                        "glosses": [
                            "„Hilfsbücher, Geschäftsbücher für Kontrollbuchungen, Vormerkungen usw.“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1986a02-80f7-4798-842d-034f9f1c9373",
                                "sense_id": "6c24b1a1-da53-3910-ac90-32e8bb13a9b1",
                                "text": "„Das Nebenbuch ergänzt in Form von Dateien einige Sachkonten des Hauptbuchs. Beispiele sind das Kontokorrentbuch, welches die Forderungen und Verbindlichkeiten erfasst oder auch das Anlagebuch, das die Sachanlagen eines Unternehmens enthält. Andere Nebenbücher sind das Wechselbuch, das Lohn- und Gehaltsbuch, sowie das Lagerbuch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
