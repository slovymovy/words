                                    }
                                ]
                            },
                            {
                                "target_word": "марты́шка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "453a18e2-ef69-3479-b54e-20ab9feacd6e",
                                        "entry_id": "b31f8481-ce0f-3a56-b0b6-bfaf87ba365a",
                                        "glosses": [
                                            "жарг., мол. девушка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb1a2de7-f368-4c46-9b85-d983129e17f6",
                                                "sense_id": "453a18e2-ef69-3479-b54e-20ab9feacd6e",
                                                "text": "Бери свою мартышку и ко мне."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "марты́шка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6df0ee16-4520-3471-9f46-1741b01040dc",
                                        "entry_id": "ef013d20-34ba-34d2-9a73-7c8058676417",
                                        "glosses": [
                                            "рег. народное название водоплавающей птицы семейства чаек, обитающей по берегам водоёмов и питающейся рыбой; крачка; мартын"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1922f0-d76b-4a31-b5da-f61f1197f9d0",
                                                "sense_id": "6df0ee16-4520-3471-9f46-1741b01040dc",
                                                "text": "Мартыном, или мартышкой, на средней Волге зовут птицу-рыболова, чайку."
                                            },
                                            {
                                                "example_id": "c1adff09-e339-49c3-885c-16625b356c87",
                                                "sense_id": "6df0ee16-4520-3471-9f46-1741b01040dc",
                                                "text": "Дикие курочки, зобастые дупеля, красавцы бекасы, турухтаны, кулики-перевозчики, мартышки, чайки, дикие и домашние утки — весь этот сброд от зари до зари кричал на все голоса .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
