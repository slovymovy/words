        "de-extract.jsonl": [
            {
                "entry_id": "79e60c8e-f201-34ba-95cd-d285659ef17b",
                "word": "penitence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "62d0a24f-6238-32d3-a31d-9a944f534c5a",
                        "entry_id": "79e60c8e-f201-34ba-95cd-d285659ef17b",
                        "glosses": [
                            "Reue"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7d07cc93-ea8a-3554-a4a0-b8d05ed08c7d",
                        "entry_id": "79e60c8e-f201-34ba-95cd-d285659ef17b",
                        "glosses": [
                            "Buße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c0fc57c-a9de-4afe-813f-6ea5e197af7d",
                                "sense_id": "7d07cc93-ea8a-3554-a4a0-b8d05ed08c7d",
                                "text": "„During Lent, many of the faithful commit to fasting or giving up certain types of luxuries as a form of penitence.“",
                                "translation": "Während der Fastenzeit verpflichten sich viele Gläubige dazu, zu fasten oder gewisse Arten von Luxus aufzugeben als eine Form von Buße."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0f93713-a4eb-4546-9476-03c297a41852",
                        "source_entry_id": "79e60c8e-f201-34ba-95cd-d285659ef17b",
                        "source_sense_id": "62d0a24f-6238-32d3-a31d-9a944f534c5a",
                        "source_sense_description": "Reue",
                        "target_lang_word": "Reue",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reue",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                        "entry_id": "ce319bfd-d95e-3ddd-9306-a0796cbdee30",
                                        "glosses": [
                                            "Bedauern über die eigene Tat, Selbstschuldbewusstsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779f4f74-ea0c-4b9a-9c96-6d1cc1293ed3",
                                                "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                                "text": "„Nur, ich hatte nichts zu bereuen, gar nichts, und ich würde also Reue heucheln müssen.“"
                                            },
                                            {
                                                "example_id": "85ee8b74-f222-484d-af86-8563007a5abe",
                                                "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                                "text": "Voll Reue über seine Tat, entschuldigte er sich."
                                            },
                                            {
                                                "example_id": "034967b0-028b-419f-bde8-b45ed8f08d28",
                                                "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                                "text": "„Reue überkam ihn.“"
                                            },
                                            {
                                                "example_id": "30e7a599-362f-4f92-b5b1-ed0f84e82793",
                                                "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                                "text": "„Die Augenblicke der Reue sind recht traurig.“"
                                            },
                                            {
                                                "example_id": "6ac254da-8682-48d0-a0ff-1f26e4dd9772",
                                                "sense_id": "fd80fda7-d1f1-3efe-bf84-30e0d41c19c6",
                                                "text": "„Die Reue war Tag und Nacht bei mir, bis meine Frau einen viel besseren Mann geheiratet hatte, als ich jemals war oder sein konnte, und ich wusste, dass sie glücklich war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8662d0fa-0374-3ab1-b830-b7d9a20a7865",
                                        "entry_id": "ce319bfd-d95e-3ddd-9306-a0796cbdee30",
                                        "glosses": [
                                            "ein Milderungsgrund bei der Strafbemessung"
                                        ],
                                        "tags": [
                                            "Justiz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3014f6ce-0226-472a-b277-d3e7029977ce",
                                                "sense_id": "8662d0fa-0374-3ab1-b830-b7d9a20a7865",
                                                "text": "Er zeigte tätige Reue, wodurch die Strafe gering ausfallen konnte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "396f365d-8a12-407f-ba07-eb9f475c7c30",
                        "source_entry_id": "79e60c8e-f201-34ba-95cd-d285659ef17b",
                        "source_sense_id": "7d07cc93-ea8a-3554-a4a0-b8d05ed08c7d",
                        "source_sense_description": "Religion: Buße",
                        "target_lang_word": "Buße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6859f25-727f-31fe-9b10-6894400e01f6",
                                        "entry_id": "8d948c81-728a-3565-a234-9942c6a0ec15",
                                        "glosses": [
                                            "Bereuen; (dadurch entstandene) Besserung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b0b52d-d0a5-4be1-a2c0-6b1ecb887dca",
                                                "sense_id": "b6859f25-727f-31fe-9b10-6894400e01f6",
                                                "text": "„Auf die weitere Wirkungsgeschichte des Fegefeuers als eines Schwellenraumes der Buße und Reinigung nimmt gerade Dantes Darstellung dieses Bereiches enormen Einfluss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb500c15-4226-3ace-af90-cad1c35be868",
                                        "entry_id": "8d948c81-728a-3565-a234-9942c6a0ec15",
                                        "glosses": [
                                            "rechtliche Sanktion gegenüber einer Übertretungen; schweizerisch auch amtlich für Geldbuße"
                                        ],
                                        "tags": [
                                            "law"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d11a027-d834-4fe6-bee3-db9333cb0109",
                                                "sense_id": "fb500c15-4226-3ace-af90-cad1c35be868",
                                                "text": "„Das Fahrverbot an der Langstrasse löste innert eines Monats 17 000 Bussen aus.“"
                                            },
                                            {
                                                "example_id": "d20ce41a-3f61-4a55-9877-aa8625ff98dc",
                                                "sense_id": "fb500c15-4226-3ace-af90-cad1c35be868",
                                                "text": "„Weisung der Finanzdirektion über Bussen wegen Verletzung von Verfahrenspflichten im Verfahren betreffend die Einkommens- und Vermögenssteuern, die Gewinn- und Kapitalsteuern sowie die Quellensteuern“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0b8c6772-da40-30df-9a90-de7160cbd855",
                                        "entry_id": "8d948c81-728a-3565-a234-9942c6a0ec15",
                                        "glosses": [
                                            "Umkehr des Menschen zu Gott, von dem er sich durch die Sünde entfernt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08947dc5-8f5f-4cf7-b6ad-f80aecf94f31",
                                                "sense_id": "0b8c6772-da40-30df-9a90-de7160cbd855",
                                                "text": "„Man griff die reizende Schöne auf, sperrte sie ein, weckte ihr Schuldbewußtsein und veranlaßte sie zu einer Generalbeichte; die Buße sollte bis zu ihrem Lebensende dauern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
