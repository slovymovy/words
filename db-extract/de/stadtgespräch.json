                                "sense_id": "41c5b743-1ad8-3e8b-85d9-3d6d4dd0c9c2",
                                "text": "Der Vorfall war wochenlang Stadtgespräch.",
                                "translation": "The incident was the talk of the town for weeks.",
                                "english": "The incident was the talk of the town for weeks."
                            },
                            {
