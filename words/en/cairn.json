{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8c7c9210-cfd7-321c-bf26-d18b8e31e49a",
                    "sense_definition": "A mound of rough stones built as a landmark, memorial, or trail marker.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stone_mound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hikers followed the trail marked by a small <w>cairn</w> at every turn.",
                            "target_lang_translations": {
                                "ru": "Туристы шли по тропе, отмеченной небольшим <w>туром</w> на каждом повороте."
                            }
                        },
                        {
                            "text": "At the summit, they added another stone to the ancient <w>cairn</w>.",
                            "target_lang_translations": {
                                "ru": "На вершине они добавили ещё один камень в древний <w>каирн</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stone cairn",
                        "build a cairn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пирамида или курган из необработанных камней, сложенный в качестве ориентира, памятника или указателя тропы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тур",
                                "target_lang_sense_clarification": "каменная пирамидка-ориентир в горах или на тропе"
                            },
                            {
                                "target_lang_word": "каирн",
                                "target_lang_sense_clarification": "каменная насыпь, памятный или межевой знак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "138a8a1b-ec2e-31f2-b415-bf9fc87b79b6",
                    "sense_definition": "A prehistoric mound of stones erected as a burial monument.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stone_mound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists excavated the prehistoric burial <w>cairn</w> on the windswept hill.",
                            "target_lang_translations": {
                                "ru": "Археологи раскопали доисторический погребальный <w>каирн</w> на продуваемом ветрами холме."
                            }
                        },
                        {
                            "text": "The ancient tribe placed their chieftain inside a stone <w>cairn</w>.",
                            "target_lang_translations": {
                                "ru": "Древнее племя упокоило своего вождя внутри каменного <w>кургана</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burial cairn",
                        "chambered cairn"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "historically associated with the British Isles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древняя каменная насыпь над погребением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каирн",
                                "target_lang_sense_clarification": "древнее каменное погребальное сооружение"
                            },
                            {
                                "target_lang_word": "каменный курган",
                                "target_lang_sense_clarification": "насыпь из камней над захоронением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c5b55f8-b16a-3867-a78e-03dcb215f38f",
                    "sense_definition": "A cairn terrier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took her energetic <w>cairn</w> for a long walk across the fields.",
                            "target_lang_translations": {
                                "ru": "Она взяла своего энергичного <w>керн-терьера</w> на долгую прогулку по полям."
                            }
                        },
                        {
                            "text": "The little <w>cairn</w> barked excitedly when the postman arrived.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>керн</w> радостно залаял, когда пришёл почтальон."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for cairn terrier"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Керн-терьер (порода собак)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "керн-терьер",
                                "target_lang_sense_clarification": "порода собак"
                            },
                            {
                                "target_lang_word": "керн",
                                "target_lang_sense_clarification": "разговорное сокращение от керн-терьер"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}