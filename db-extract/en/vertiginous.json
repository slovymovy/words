                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b03204c9-f03b-41d8-9475-337f089e6ddd",
                                "sense_id": "c73b4b19-acd7-3bfa-9280-1f5fc8bbcd71",
                                "text": "GPT-4 didn’t give me an existential crisis. But it exacerbated the dizzy and vertiginous feeling I’ve been getting whenever I think about A.I. lately."
                            }
                        ]
                    },
                    {
                        "sense_id": "275e0a8b-9995-3339-ba28-d02fa37dbea3",
                        "entry_id": "d4fd699f-bf28-3d61-a325-7369e52c1b8e",
                        "glosses": [
                            "Pertaining to vertigo (in all its meanings).",
                            "Inducing a feeling of giddiness, vertigo, dizziness or of whirling."
                        ],
