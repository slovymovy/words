                "senses": [
                    {
                        "sense_id": "6d14b5c8-187c-3b2f-b6e0-b384b5872093",
                        "entry_id": "ffccbedd-fcf1-3a22-87c2-919582d4169a",
                        "glosses": [
                            "A mess, a mese: a meal."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5d8edde4-4463-4a3c-9f5b-82a0221aa82e",
                                "sense_id": "6d14b5c8-187c-3b2f-b6e0-b384b5872093",
                                "text": "I want my mease of milk when I go to my work."
                            },
                            {
                                "example_id": "8e47480b-79ae-4b44-9673-3ee970a999c6",
                                "sense_id": "6d14b5c8-187c-3b2f-b6e0-b384b5872093",
                                "text": "they shal have [...] every mease of two dishes, one with pottage & boiled meate, the other roste (if it be no fasting day.) And if it be a fish daye, then they shal have two like meases of white meate & fish."
                            }
                        ]
                    }
                ],
