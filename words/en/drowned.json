                {
                    "sense_id": "c7cb7699-93dd-39e2-9f42-18384187ebd7",
                    "sense_definition": "Simple past and past participle of <w>drown</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tragically, the young man <w>drowned</w> in the lake while swimming alone.",
                            "target_lang_translations": {
                                "ru": "Трагично, но молодой человек <w>утонул</w> в озере, когда плавал в одиночестве.",
                                "nl": "Tragisch genoeg <w>verdronk</w> de jonge man in het meer terwijl hij alleen aan het zwemmen was."
                            }
                        },
                        {
                            "text": "The loud noise of the construction work <w>drowned</w> out our conversation.",
                            "target_lang_translations": {
                                "ru": "Громкий шум строительных работ <w>заглушил</w> наш разговор.",
                                "nl": "Het harde lawaai van de bouwwerkzaamheden <w>overstemde</w> ons gesprek."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drowned out",
                        "drowned in"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Простая форма прошедшего времени и причастие прошедшего времени от глагола <w>drown</w>.",
                        "nl": "De verleden tijd en het voltooid deelwoord van het werkwoord 'verdrinken' (sterven door onderdompeling in water) of 'overstemmen' (bij geluid)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утонул",
                                "target_lang_sense_clarification": "погиб в воде (сам)"
                            },
                            {
                                "target_lang_word": "заглушил",
                                "target_lang_sense_clarification": "перекрыл другой звук (о шуме)"
                            },
                            {
                                "target_lang_word": "утопил",
                                "target_lang_sense_clarification": "заставил утонуть; погрузил в воду"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verdronk",
                                "target_lang_sense_clarification": "enkelvoud verleden tijd van verdrinken"
                            },
                            {
                                "target_lang_word": "verdronken",
                                "target_lang_sense_clarification": "meervoud verleden tijd of voltooid deelwoord van verdrinken"
                            },
                            {
                                "target_lang_word": "overstemde",
                                "target_lang_sense_clarification": "verleden tijd van overstemmen (geluid)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a64c8050-0c2e-3cc8-bf7e-2acfaaf511c6",
                    "sense_definition": "That has died by drowning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue team recovered the <w>drowned</w> body from the river early this morning.",
                            "target_lang_translations": {
                                "ru": "Спасательная команда извлекла <w>утонувшее</w> тело из реки рано утром.",
                                "nl": "Het reddingsteam haalde het <w>verdronken</w> lichaam vanochtend vroeg uit de rivier."
                            }
                        },
                        {
                            "text": "A memorial was built for the <w>drowned</w> sailors of the shipwreck.",
                            "target_lang_translations": {
                                "ru": "В память об <w>утонувших</w> моряках с погибшего корабля установили мемориал.",
                                "nl": "Er werd een monument opgericht voor de <w>verdronken</w> zeelieden van het schipbreuk."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drowned rat",
                        "drowned man"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умерший в результате утопления.",
                        "nl": "Iemand of iets dat is gestorven door verdrinking."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утонувший",
                                "target_lang_sense_clarification": "погибший в воде"
                            },
                            {
                                "target_lang_word": "утопленный",
                                "target_lang_sense_clarification": "умерщвленный в воде"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verdronken",
                                "target_lang_sense_clarification": "gestorven door onderdompeling in water"
                            }
                        ]
                    }
                }
            ]
        }
    ]
