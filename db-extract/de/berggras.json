                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6496b769-c935-49ff-bd66-3e2690d03e08",
                                "sense_id": "0716e29a-b9a3-30e5-98d7-ee6f15195650",
                                "text": "„Er dachte daran, wie sie die Felle auf den Wagen luden, die Ochsen anschirrten, die vom Nichtstun und dem saftigen Berggras fett zu werden begannen, und wie sie zum Rückweg durch die Berge aufbrachen, über die weite Prärie, zurück nach Butcher’s Crossing.“"
                            }
                        ],
