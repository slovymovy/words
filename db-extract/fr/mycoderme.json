                        "entry_id": "2343cb30-06b1-3736-ad27-e33f069c1276",
                        "glosses": [
                            "Levure qui forme un voile à la surface des liquides alcoolisés, et transforme l’alcool en acide acétique, le vin en vinaigre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6345f25e-f389-4b4f-b148-8862ffa29e52",
                                "sense_id": "a8d3d2a7-676a-32fc-9558-c46a48dda44e",
                                "text": "La dénomination de mycoderme est donnée indistinctement aux champignons inférieurs et aux microbes qui se disposent sous l’apparence d’un voile ou d’une membrane à la surface d’un milieu nutritif solide ou liquide."
                            },
                            {
                                "example_id": "0ef489a7-00d3-42cf-8a0b-b1299ded4bcb",
                                "sense_id": "a8d3d2a7-676a-32fc-9558-c46a48dda44e",
                                "text": "Le lait peut […] renfermer […] d'autres espèces de mycodermes."
                            }
                        ]
                    }
