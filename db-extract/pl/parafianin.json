                    }
                ],
                "translations": [
                    {
                        "translation_id": "00349d9d-d403-4b86-88e3-3d204e10c735",
                        "source_entry_id": "415553ec-b520-3005-ab03-dcb7e5383d31",
                        "source_sense_id": "bfd50c19-d149-309e-a064-3fd504a0efcb",
                        "target_lang_word": "parishioner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parishioner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b34ebf30-19c1-363b-a3b8-c70b53845b3f",
                                        "entry_id": "faeeebc9-feac-3db7-9249-f97cddd1ccab",
                                        "glosses": [
                                            "A member of a parish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04e34321-e9fb-4049-b4da-4962bf5e637a",
                                                "sense_id": "b34ebf30-19c1-363b-a3b8-c70b53845b3f",
                                                "text": "“Reverend Judith!” he announced cheerfully. “What a lovely surprise. How super to see you! What are you standing at the door for? Come in! Come in!”\n“Thank you, thank you. I do like to pop around and see as many of my parishioners as possible,” said Reverend Judith as she followed the pair into the kitchen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8380c774-1a99-4e7e-9215-b4bf3961e3c7",
                        "source_entry_id": "415553ec-b520-3005-ab03-dcb7e5383d31",
                        "source_sense_id": "bfd50c19-d149-309e-a064-3fd504a0efcb",
                        "target_lang_word": "paroissien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paroissien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ef758e7-f9a0-35c8-9206-9d906b7ceca8",
                                        "entry_id": "0a93559c-6392-3f38-821d-bb2923c35e0f",
                                        "glosses": [
                                            "Relatif à Paroy-sur-Saulx, commune française située dans le département de la Haute-Marne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "455ec5c4-6c2f-38ae-b4dc-3f915a601d08",
                                        "entry_id": "0a93559c-6392-3f38-821d-bb2923c35e0f",
                                        "glosses": [
                                            "Relatif à Paroy-sur-Tholon, commune française située dans le département de l’Yonne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "paroissien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6499229-12b6-35cc-9bac-5aa928fd144b",
                                        "entry_id": "981c9643-af01-3682-9d64-b2c64dadbc42",
                                        "glosses": [
                                            "Personne qui fait partie d’une paroisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf87dae5-5059-4b92-b837-afd579d81d38",
                                                "sense_id": "d6499229-12b6-35cc-9bac-5aa928fd144b",
                                                "text": "Elle était très pieuse, et elle l’avait connu dans des œuvres de charité, touchée de son zèle, édifiée par le renom de jeune saint que lui faisaient ses paroissiennes de Neuilly."
                                            },
                                            {
                                                "example_id": "2a4179cd-80be-44b7-8fd2-4d27250d29bb",
                                                "sense_id": "d6499229-12b6-35cc-9bac-5aa928fd144b",
                                                "text": "[…] toutefois comme il ne voulait pas abandonner dans les eaux de la tribulation le jeune paroissien de son confrère, il lui donna quelques salutaires encouragements."
                                            },
                                            {
                                                "example_id": "6a4ddfe3-3f82-41b2-a235-91996e1cd938",
                                                "sense_id": "d6499229-12b6-35cc-9bac-5aa928fd144b",
                                                "text": "Le Christianisme romain tend alors à n’être qu’un formalisme rituel, pour lequel l’idéal du fidèle devient le bon paroissien qui pratique et qui croit sans discussion."
                                            },
                                            {
                                                "example_id": "fc05601d-0521-47a5-bcb8-4efc03dd2f9e",
                                                "sense_id": "d6499229-12b6-35cc-9bac-5aa928fd144b",
                                                "text": "…Offenserais-je le Très-Haut si à la messe dimanche prochain, j’ai pour mes paroissiens une intention particulière ?"
                                            },
                                            {
                                                "example_id": "64aab0ef-1e6d-4e82-8466-45ddb66ee729",
                                                "sense_id": "d6499229-12b6-35cc-9bac-5aa928fd144b",
                                                "text": "D'autre part, Péchenard écrit que le pasteur de Gespunsart, « à cause de son attachement aux erreurs jansénistes » fut dénoncé par ses paroissiens à l'autorité diocésaine. Il fut donc interdit par l'archevêque de Mailly."
                                            },
                                            {
                                                "example_id": "e6c38ae1-03eb-4892-af57-b42de58200a8",
                                                "sense_id": "d6499229-12b6-35cc-9bac-5aa928fd144b",
                                                "text": "Le plus important devenait, pour Marie, son intégration dans sa nouvelle paroisse, faire connaissance tant avec les grenouilles de bénitiers qu'avec les paroissiens plus ou moins occasionnels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a09b7e1-3524-363d-a70a-b95c759ffc58",
                                        "entry_id": "981c9643-af01-3682-9d64-b2c64dadbc42",
                                        "glosses": [
                                            "Individu quelconque."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a0ce91b-fe76-417d-b899-ab6c7ba63bec",
                                                "sense_id": "8a09b7e1-3524-363d-a70a-b95c759ffc58",
                                                "text": "Il paraît que M. Truchet, de Paris, doit de l’argent à M. Andrez, de Nantes, qui est débiteur de mon père pour un M. Chalumeau, de Saint-Nazaire ; il y a encore un autre paroissien dans l’affaire ; mais il résulte de toutes ces explications que c’est au bureau des Messageries de Paris, que je recevrai de la main de M. Truchet la somme de quarante francs."
                                            },
                                            {
                                                "example_id": "a4f185d7-720b-4f4d-b246-d564bc762fe8",
                                                "sense_id": "8a09b7e1-3524-363d-a70a-b95c759ffc58",
                                                "text": "– Eh ben ! d’où qu’il sort, ce paroissien-là ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paroissien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a33f511-4d61-39e4-bd4f-76400da3a6ef",
                                        "entry_id": "e9415ab9-d5dc-3066-b2dc-b26cc5f2b729",
                                        "glosses": [
                                            "Livre de prières dont on se sert principalement pour suivre l’office qui se dit à l’église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "110b9c2b-8663-47d4-80a6-4f8ea4d2da74",
                                                "sense_id": "2a33f511-4d61-39e4-bd4f-76400da3a6ef",
                                                "text": "Maître Arnoton, ses grandes lunettes d’acier sur le nez, cherche dans son paroissien où diantre on peut bien en être."
                                            },
                                            {
                                                "example_id": "047e7e29-cf10-44fa-ad7c-889016937a45",
                                                "sense_id": "2a33f511-4d61-39e4-bd4f-76400da3a6ef",
                                                "text": "Sur la table, des paquets de graines et un livre : Le Bon Jardinier… sur la cheminée, un paroissien dont les pages sont jaunies, et un petit carnet où sont copiées différentes recettes pour préparer l’encaustique, la bouillie bordelaise, et des dosages de nicotine, de sulfate de fer… Pas une lettre nulle part ; pas même un livre de comptes."
                                            },
                                            {
                                                "example_id": "69308a5f-ec16-428e-a96b-ee501dec94c6",
                                                "sense_id": "2a33f511-4d61-39e4-bd4f-76400da3a6ef",
                                                "text": "Le dimanche, elle manquait rarement la messe. L’hiver, elle y menait sa chaufferette, l’été son ombrelle ; en toutes saisons un gros paroissien noir et son chien Domino, qui fut tour à tour un bâtard de loulou et de fox, noir et blanc, puis un barbet jaune."
                                            },
                                            {
                                                "example_id": "139ce6c3-d625-4ac1-8cd5-b6a5915519ee",
                                                "sense_id": "2a33f511-4d61-39e4-bd4f-76400da3a6ef",
                                                "text": "Ce qu’on ne savait pas, c’est que, pour concevoir son calvaire, Gilbert avait relu l’Évangile dans les vieux paroissiens de sa mère."
                                            },
                                            {
                                                "example_id": "f98d4be7-b5ed-432d-bb7f-3412ad5805ad",
                                                "sense_id": "2a33f511-4d61-39e4-bd4f-76400da3a6ef",
                                                "text": "[La verrière] ondulait en une pluie flamboyante et fantastique, […] comme si c’était dans la nef de quelque grotte irisée de sinueuses stalactites que je suivais mes parents, qui portaient leur paroissien."
                                            },
                                            {
                                                "example_id": "40f54265-55a2-4828-a4c5-56cbef2e004a",
                                                "sense_id": "2a33f511-4d61-39e4-bd4f-76400da3a6ef",
                                                "text": "Lire chaque semaine les mêmes prières dans son paroissien, subir le même ennui rituel du sermon jouait le rôle d’une purification probatoire au plaisir de manger du poulet et des gâteaux du pâtissier, d’aller à la séance de cinéma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
