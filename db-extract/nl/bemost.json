                "senses": [
                    {
                        "sense_id": "6b9b33a8-1091-35a0-878b-896626f25cd2",
                        "entry_id": "b6635ef6-f61d-3d75-86c7-8212f0090ba5",
                        "glosses": [
                            "met mos bedekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b4b0915-0117-47a7-8082-0114a7e2da4d",
                                "sense_id": "6b9b33a8-1091-35a0-878b-896626f25cd2",
                                "text": "Die vaak bemoste loofbomen groeien op bergheuvels die nog ouder zijn dan de Alpen. Ze zijn doorsneden met spannende, vrijwel geheel onverharde wandelpaden. Zo fantastisch bewegwijzerd dat het onmogelijk is te verdwalen. Want de wandelpaden worden aangelegd met dezelfde pünktlichkeit als waarmee de Duitsers hun Mercedes, BMW, Audi en VW maken."
                            },
                            {
                                "example_id": "9d136754-1895-426c-a968-54e536bfe167",
                                "sense_id": "6b9b33a8-1091-35a0-878b-896626f25cd2",
                                "text": "Je zou kunnen denken dat schoonheid is wat de geest ervan maakt, maar alles is schoonheid: vrouwen die offermandjes maken, vissers tot hun middel in de zee, bemoste beelden, bootjes. Vijftig foto’s zijn zo gemaakt."
                            }
                        ]
                    }
