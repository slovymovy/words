                ],
                "senses": [
                    {
                        "sense_id": "d3ced7cf-9e62-3f5d-a843-bfa10b345cc2",
                        "entry_id": "f3aa1364-70c1-397e-af2f-eaeb9491c1c1",
                        "glosses": [
                            "A person who lives in a mountainous area."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "01f9c2f6-2d06-41a9-8078-84447e469e62",
                                "sense_id": "d3ced7cf-9e62-3f5d-a843-bfa10b345cc2",
                                "text": "[…] in the Countrey of Attica there were as many factions as there were diuerse sorts of the territorie: for the Mountainers were Democraticall; those of the champion countrey, Oligarchical; and they that dwelt neer the sea, desired a middle kind of gouernement […]"
                            },
                            {
                                "example_id": "cc716bb6-87d9-42bd-9102-1b4d54d06d69",
                                "sense_id": "d3ced7cf-9e62-3f5d-a843-bfa10b345cc2",
                                "text": "He also sent Embassadors to the Mountainers of the Pyrenes, & to the Gaules, to obtaine a quiet passage:"
                            },
                            {
                                "example_id": "4c0ffca3-9b55-42c3-ad01-b7b6c3eac61b",
                                "sense_id": "d3ced7cf-9e62-3f5d-a843-bfa10b345cc2",
                                "text": "Vossius […] makes the highest MOUNTAIN there not to exceed Ten Furlongs; Which, saith Vossius, it is scarce possible for any one to reach, unless he be a Mountainer born; any other will scarce be able to ascend above Six Furlongs perpendicular;"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
