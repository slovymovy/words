                ],
                "senses": [
                    {
                        "sense_id": "1bf61024-709b-374d-9525-8809f07aa06f",
                        "entry_id": "4a78fcda-0191-30f4-993f-bf3bc6f54699",
                        "glosses": [
                            "als Zeichen des Dankes für die Rettung aus einer Notlage oder mit der Bitte um Erfüllung eines bestimmten Wunsches gestiftete, separate Kapelle oder abgeteilter Raum in etwas; zumeist einem Heiligen gewidmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "377ae022-65ca-4403-a08a-afc4910e2938",
                                "sense_id": "1bf61024-709b-374d-9525-8809f07aa06f",
                                "text": "„Erst knapp 10 Jahre nach dem Tod von König Ludwig II. wurde oberhalb der Todesstelle, nahe Berg, die Votivkapelle zum Gedenken errichtet.“"
                            },
                            {
                                "example_id": "1ba84faf-d089-48ae-a858-d9f9c6c9015a",
                                "sense_id": "1bf61024-709b-374d-9525-8809f07aa06f",
                                "text": "„Votivkapelle mit der gekrönten Statue im Dom zu Linz.“"
                            },
                            {
                                "example_id": "303a7c32-d047-4222-9a21-ed1382b03c9f",
                                "sense_id": "1bf61024-709b-374d-9525-8809f07aa06f",
                                "text": "„Diese Votivkapelle aus dem XI. Jahrhundert ist der Kirchenpatronin des Fürstentums und der Prinzenfamilie gewidmet.“"
                            },
                            {
                                "example_id": "2e527e94-f0e1-43b9-82be-97bb545e37ee",
                                "sense_id": "1bf61024-709b-374d-9525-8809f07aa06f",
                                "text": "„Über romanischem Karnergewölbe steht eine spätgotische Votivkapelle Maria Heil der Kranken.“"
                            },
                            {
                                "example_id": "ef726b07-3930-4897-a848-abf084072313",
                                "sense_id": "1bf61024-709b-374d-9525-8809f07aa06f",
                                "text": "„Der Höhepunkt dieser Spazierfahrt zu den Kirchen unserer Umgebung ist die kleine Votivkapelle St. Maria und Georg in Hoflach.“"
                            },
                            {
                                "example_id": "0862946c-f1dd-44dd-b0ab-42097e013926",
                                "sense_id": "1bf61024-709b-374d-9525-8809f07aa06f",
                                "text": "„In Valgrisenche kann man einige Votivkapellen betrachten und besichtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
