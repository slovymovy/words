                "senses": [
                    {
                        "sense_id": "c07f0c21-1fa0-3091-8338-aa4f107e6178",
                        "entry_id": "7d19b525-d300-3fb3-858b-dae1c6c6a747",
                        "glosses": [
                            "hokje in winkel waar je kleding kunt passen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19461ef0-a08b-4f3b-9237-3ed75d4c247e",
                                "sense_id": "c07f0c21-1fa0-3091-8338-aa4f107e6178",
                                "text": "\"Nu begrijp ik dat je je oude kleren zat was\", meldt mijn meewinkelende vriendin opgewekt als ik in nóg een passend prairiepakje uit een pashok kom. En mijn man vraagt bij thuiskomst hoe ik zo bruin heb kunnen worden, in de winter in Londen. Want ik zie er zo gezond uit. Of heb ik iets met mijn haar gedaan? Nee, gewoon nieuwe kleren."
                            }
                        ]
                    }
