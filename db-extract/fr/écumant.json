                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e9ac3bc8-bbea-3c4c-91ae-fa00a389f1d5",
                        "entry_id": "42fb6f1f-001a-303e-a551-ce363809b142",
                        "glosses": [
                            "Participe présent de écumer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "440430fc-3338-4be0-b4a9-04dfca3b5be9",
                                "sense_id": "e9ac3bc8-bbea-3c4c-91ae-fa00a389f1d5",
                                "text": "Là, il se mit à se contorsionner, à trémuler et à trembler convulsivement, bavant, écumant et poussant toujours son cri de bête."
                            }
                        ]
                    }
