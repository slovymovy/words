                ],
                "senses": [
                    {
                        "sense_id": "25f4ecea-4ed4-36a4-aa73-7610b02fc1eb",
                        "entry_id": "7c64363a-f05f-3b48-b18c-82d8c25c8409",
                        "glosses": [
                            "Se créer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af5b8cd-e6bd-4bad-961b-a2b68fc666e0",
                                "sense_id": "25f4ecea-4ed4-36a4-aa73-7610b02fc1eb",
                                "text": "L’Homme est quelque chose qui doit s’autocréer; l’Homme n’existe pas encore réellement."
                            },
                            {
                                "example_id": "654f73d9-3a10-467f-b9a9-64c652ae4a1b",
                                "sense_id": "25f4ecea-4ed4-36a4-aa73-7610b02fc1eb",
                                "text": "Parce qu’il y a une loi de la gravité, l’univers peut s’autocréer à partir du néant."
                            },
                            {
                                "example_id": "34fa2667-beb3-4df2-aaa4-15f6d8b4cde3",
                                "sense_id": "25f4ecea-4ed4-36a4-aa73-7610b02fc1eb",
                                "text": "Rien n’a le pouvoir de s’autocréer, pas même Dieu."
                            }
                        ]
                    }
