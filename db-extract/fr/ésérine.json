                ],
                "senses": [
                    {
                        "sense_id": "3cbc9f45-138f-3b07-b3ee-6e83e13d226b",
                        "entry_id": "dcde6e26-7d13-3456-a396-49a919a27433",
                        "glosses": [
                            "Alcaloïde extrait de la fève de Calabar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a262623-419c-4df6-be05-a9115ea23e41",
                                "sense_id": "3cbc9f45-138f-3b07-b3ee-6e83e13d226b",
                                "text": "L’ésérine provoque un myosis, un spasme de l’accommodation, une chute de la pression intra-oculaire, une hyperhémie de la conjonctive et une lacrymation. D’une manière générale, l’ésérine favorise la transmission neuromusculaire, ce qui se traduit par l’apparition de fasciculations."
                            }
                        ]
                    }
                ],
                "translations": [
