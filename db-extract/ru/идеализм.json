                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8584e3fe-920e-48b7-ba22-5c22062662b4",
                                                "sense_id": "5d23e954-4112-30a3-94ae-0997fa52a512",
                                                "text": "Il suo idealismo lo porta spesso a cacciarsi nei guai"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb6a394e-dab4-300f-922e-494fff04be7e",
                                        "entry_id": "e5466ab3-6742-3531-b1e0-f3503ceae479",
                                        "glosses": [
                                            "corrente filosofica tedesca, i cui esponenti principali sono Fichte, Schelling e Hegel, che afferma che l'Io (o lo Spirito) è il principio unico di tutto e non c'è nulla al di fuori di esso"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b27ced9a-0b4c-4741-85af-71e391bf01bd",
                        "source_entry_id": "37512271-9be0-320f-9d23-2dbea4eebacf",
                        "target_lang_word": "Idealismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Idealismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa37637e-b258-3c80-9a4c-78003642b304",
                                        "entry_id": "43f0116e-b303-38dd-a333-8081f7f82115",
                                        "glosses": [
                                            "die Verwirklichung von ethischen Idealen unbeachtet persönlicher Belange"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b62be47f-660a-4c56-94e2-5e04dffb0d55",
                                                "sense_id": "fa37637e-b258-3c80-9a4c-78003642b304",
                                                "text": "„In der antideutschen Variante dieses Idealismus buchstabiert sich dieser Gegensatz in deutschen Kollektivismus und US-amerikanischen Individualismus aus, wobei letzterer positiv, ersterer negativ konnotiert wird.“"
                                            },
                                            {
                                                "example_id": "4127c4ad-afd2-4a97-90c8-780047f67d6f",
                                                "sense_id": "fa37637e-b258-3c80-9a4c-78003642b304",
                                                "text": "„Ich begann etwas von dem Idealismus zu erkennen, mit dem das Männlein arbeitete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9191575f-54c4-349e-a8e6-557c51b97e61",
                                        "entry_id": "43f0116e-b303-38dd-a333-8081f7f82115",
                                        "glosses": [
                                            "philosophische Systeme in denen der Geist, die Vernunft oder das Bewusstsein primär das eigentlich Wirkliche sind, die Materie ist sekundär und eine Erscheinungsform derselben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a90a5236-6162-4f0e-96a1-ba9a0217c05e",
                                                "sense_id": "9191575f-54c4-349e-a8e6-557c51b97e61",
                                                "text": "„Der Gegensatz von Realismus und Idealismus ist nicht nur für die unterschiedliche Fassung der Darstellungsfunktion von Belang, sondern auch für die Bestimmung der Kommunikationsfunktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4934567c-5e31-3b53-9bc4-8ff9975aa785",
                                        "entry_id": "43f0116e-b303-38dd-a333-8081f7f82115",
                                        "glosses": [
                                            "die Wiedergabe idealer, nicht realer Erscheinungen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9438a869-213b-4e96-9a5f-eceb0e3958ca",
                        "source_entry_id": "37512271-9be0-320f-9d23-2dbea4eebacf",
