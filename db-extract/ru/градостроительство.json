                "senses": [
                    {
                        "sense_id": "2b34dbee-a0ac-3410-a544-d901b21aa74a",
                        "entry_id": "fb884103-3b3e-361f-ba3a-f61df85e1d2d",
                        "glosses": [
                            "теория и практика планировки и застройки городов, деятельность градостроителей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90297117-1950-49f8-a43d-ab3552525a58",
                                "sense_id": "2b34dbee-a0ac-3410-a544-d901b21aa74a",
                                "text": "Наша любимая столица будет лучшим образцом градостроительства для других городов нашего необъятного отечества."
                            },
                            {
                                "example_id": "37d48cf7-fd83-430b-a502-333e7038d41b",
                                "sense_id": "2b34dbee-a0ac-3410-a544-d901b21aa74a",
                                "text": "Один иp важнейших принципов современного советского градостроительства ― раздельное размещение жилых массивов и предприятий."
                            },
                            {
                                "example_id": "59ad631c-e99a-4823-a611-963ca9d57d72",
                                "sense_id": "2b34dbee-a0ac-3410-a544-d901b21aa74a",
                                "text": "В градостроительстве мы чего-то все-таки добились."
                            }
                        ]
                    }
                ],
