                "senses": [
                    {
                        "sense_id": "31f4d3a2-0596-3f53-8a69-ec2676ffa00e",
                        "entry_id": "ac1f9b02-b96c-383b-a84e-5215e3ae6812",
                        "glosses": [
                            "woning waar voor ruimteverwarming weinig of geen fossiele energie nodig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6673b4c-dd82-4932-a6f7-0548110d4941",
                                "sense_id": "31f4d3a2-0596-3f53-8a69-ec2676ffa00e",
                                "text": "Nick Spikkert (28) en zijn vriendin Susanne Granneman (29) zijn twee van de bewoners die afgelopen november in hun energieneutrale huurwoning (passiefhuis) trokken aan de Welemanstraat."
                            },
                            {
                                "example_id": "660479fd-2d07-4ad4-85f7-8b38bf03ec81",
                                "sense_id": "31f4d3a2-0596-3f53-8a69-ec2676ffa00e",
                                "text": "Een passiefhuis onderscheidt zich door de bijzondere combinatie van een hoogwaardig en aangenaam binnenklimaat en een laag energieverbruik. Het pand aan de Stationslaan in Vroomshoop is georiënteerd op het zuiden. De koudebruggen en kieren zijn voorkomen. Daarnaast zijn er hoge isolatiewaarden toegepast en er wordt efficiënt geventileerd en verwarmd. Voor ruimteverwarming is nauwelijks nog fossiele energie nodig."
                            },
                            {
                                "example_id": "582ab659-5f32-42f6-9cf5-a41f20a7c472",
                                "sense_id": "31f4d3a2-0596-3f53-8a69-ec2676ffa00e",
                                "text": "Het jonge stel heeft het huis aan de Harfsensesteeg grotendeels zelf gebouwd. Het gaat om een zogenaamd passiefhuis, gebouwd met vooral ecologische materialen zoals houtskelet, houtvezelisolatie en afvalpapier. Het huis is aardgasvrij."
                            },
                            {
                                "example_id": "89cffb4b-a9fc-4ded-853b-6e65739d68c8",
                                "sense_id": "31f4d3a2-0596-3f53-8a69-ec2676ffa00e",
                                "text": "Een passiefhuis richt zich op maximale vraagbeperking resulterend in een maximale vraag voor ruimteverwarming en koeling van 15 kWh/m2 per jaar en een maximaal primair energieverbruik (incl. elektrische huishoudelijke apparaten) van minder dan 120 kWh/m2 per jaar."
                            }
                        ]
                    }
