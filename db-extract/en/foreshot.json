                                        "sense_index_json": "\"4b\""
                                    },
                                    {
                                        "sense_id": "e56e05fb-594e-39dd-ba6a-b96622399580",
                                        "entry_id": "7c4b0064-da6b-338c-9fa3-cd3918583246",
                                        "glosses": [
                                            "Das erste Destillat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5136b515-2c49-4b27-b28d-93e520f7a3a2",
                                                "sense_id": "e56e05fb-594e-39dd-ba6a-b96622399580",
                                                "text": "Man muss berücksichtigen, dass am Anfang der Destillation, dem sogenannten Vorlauf, eventuell auch Methanol destilliert."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "bfc3a4ff-7fb5-3ed6-8b4b-ade062075e20",
                                        "entry_id": "7c4b0064-da6b-338c-9fa3-cd3918583246",
