                                        "examples": [
                                            {
                                                "example_id": "a9918ade-132c-4348-84e7-9b29fe9552bb",
                                                "sense_id": "4e907c1d-0e83-3520-b2a5-5471403f8cd0",
                                                "text": "Le DJing est un art qui demande beaucoup d’entraînement pour arriver à maîtriser les fondamentaux techniques, et pour Mixer convenablement en public !"
                                            },
                                            {
                                                "example_id": "95185ea3-b4cb-4be5-9537-1f15f49c1b43",
                                                "sense_id": "4e907c1d-0e83-3520-b2a5-5471403f8cd0",
                                                "text": "En outre, quand on parle de rap comme d’une branche musicale du hip-hop, il faudrait comprendre que le DJing est à prendre aussi en compte, même s’il n’est pas expressément évoqué ici."
                                            },
                                            {
                                                "example_id": "c5dfdd73-223b-463a-abf3-d16fc475378f",
                                                "sense_id": "4e907c1d-0e83-3520-b2a5-5471403f8cd0",
                                                "text": "Dans la culture hip-hop, le DJing fait lui référence à l’art de sélectionner et de diffuser de la musique sur des platines à destination d’un public."
                                            }
                                        ]
                                    }
