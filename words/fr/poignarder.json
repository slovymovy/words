            "senses": [
                {
                    "sense_id": "586bcddd-e87f-37f7-be32-9053b4c20a86",
                    "sense_definition": "Frapper, blesser ou tuer quelqu'un à coups de poignard ou avec une arme blanche.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agression_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agresseur a tenté de <w>poignarder</w> le passant avant de s'enfuir dans la nuit."
                        },
                        {
                            "text": "Le suspect a été arrêté après avoir <w>poignardé</w> un homme dans la rue hier soir."
                        }
                    ],
                    "synonyms": [
                        "suriner"
                    ],
                    "common_phrases": [
                        "poignarder à mort",
                        "se faire poignarder"
                    ]
                },
                {
                    "sense_id": "bec40a45-4d51-3a95-813e-8109b208d1b6",
                    "sense_definition": "Causer une extrême douleur morale ou une immense peine à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "douleur_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette terrible nouvelle est venue lui <w>poignarder</w> le cœur en plein milieu de la fête."
                        },
                        {
                            "text": "Ne lui parlez pas de cet échec, cela reviendrait à le <w>poignarder</w> une seconde fois."
                        }
                    ],
                    "common_phrases": [
                        "poignarder le cœur",
                        "poignarder en plein cœur"
                    ]
                }
            ]
        }
    ]
