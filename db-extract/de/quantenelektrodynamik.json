                        "target_lang_word": "électrodynamique quantique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électrodynamique quantique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28e0561d-096e-3134-a293-1dc0402f192d",
                                        "entry_id": "f19acf75-2251-3c75-b1c5-b39f71c6748b",
                                        "glosses": [
                                            "Théorie qui décrit les interactions entre la matière et la lumière."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21caee94-d337-446e-9aac-11d5d37c6fe2",
                                                "sense_id": "28e0561d-096e-3134-a293-1dc0402f192d",
                                                "text": "Ainsi naquit, aux environs de 1929, une nouvelle théorie, la théorie quantique de l’interaction matière-lumière, à laquelle on a donné l’horrible nom d’électrodynamique quantique."
                                            },
                                            {
                                                "example_id": "fa6ccab2-9220-4bee-9607-b69b054065fa",
                                                "sense_id": "28e0561d-096e-3134-a293-1dc0402f192d",
                                                "text": "[Majorana] Surtout, il travaille avec acharnement à l’élaboration d’une électrodynamique quantique, le sujet théorique le plus en pointe du moment, celui-là même qu’il avait évoqué à Copenhague avec Victor Weisskopf : il s’agit de proposer une formulation quantique des lois de l’électromagnétisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
