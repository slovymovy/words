                ],
                "senses": [
                    {
                        "sense_id": "dc035028-6e9d-3e41-9d17-89819cacf5cf",
                        "entry_id": "2a86617c-3596-3bac-baed-fea86769c8fe",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26022966-fe4b-4033-ad21-26a91ddbee41",
                                "sense_id": "dc035028-6e9d-3e41-9d17-89819cacf5cf",
                                "text": "Frau Lauterbach ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1e08585b-71ba-4040-bbd8-4c97429483fb",
                                "sense_id": "dc035028-6e9d-3e41-9d17-89819cacf5cf",
                                "text": "Herr Lauterbach wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "00c2099b-d970-4221-802f-4222844c8d8f",
                                "sense_id": "dc035028-6e9d-3e41-9d17-89819cacf5cf",
                                "text": "Die Lauterbachs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d26a37e7-1428-4f6f-b160-be7cb3546291",
                                "sense_id": "dc035028-6e9d-3e41-9d17-89819cacf5cf",
                                "text": "Der Lauterbach trägt nie die Schals, die die Lauterbach ihm strickt."
                            },
                            {
                                "example_id": "ad8a7e52-e610-476b-b066-4b2e9cd458b3",
                                "sense_id": "dc035028-6e9d-3e41-9d17-89819cacf5cf",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lauterbach kommt, geht der Herr Lauterbach.“"
                            },
                            {
                                "example_id": "c671f10b-fb50-4eeb-a74c-1b5e3cb92e64",
                                "sense_id": "dc035028-6e9d-3e41-9d17-89819cacf5cf",
                                "text": "Lauterbach kommt und geht."
                            },
                            {
                                "example_id": "a561c3e6-7749-4d50-a720-a5b44e97f5b4",
                                "sense_id": "dc035028-6e9d-3e41-9d17-89819cacf5cf",
                                "text": "Lauterbachs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
