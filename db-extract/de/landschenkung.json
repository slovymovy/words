                        "examples": [
                            {
                                "example_id": "d9c2ff89-ef19-42f7-9632-f9a4e3466b1e",
                                "sense_id": "8a7610bc-b7f2-37c5-bbee-8c8e21324499",
                                "text": "„Brahmanen wurden sozusagen «berufen» und mit genau dokumentierten Landschenkungen versehen.“"
                            },
                            {
                                "example_id": "c4b4476e-d3b4-4742-bb1d-3ba52ef0e6a3",
                                "sense_id": "8a7610bc-b7f2-37c5-bbee-8c8e21324499",
                                "text": "„Alle würden für ihre Leistungen mit Landschenkungen oder anderen Formen von Vermögen reich und gerecht belohnt werden, daher war es für alle Brüder von Vorteil, den einen zu unterstützen, der am ehesten ein geeigneter Anführer zu werden versprach.“"
                            }
