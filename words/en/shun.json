{
    "word_family": [
        "shunning"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6931ff11-ff61-3267-bc04-21114ac30d4d",
                    "sense_definition": "To persistently avoid or ignore someone or something, often as a social rejection.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people <w>shun</w> the spotlight to maintain their privacy.",
                            "target_lang_translations": {
                                "nl": "Veel mensen <w>vermijden</w> de schijnwerpers om hun privacy te behouden."
                            }
                        },
                        {
                            "text": "The community decided to <w>shun</w> the individual who broke their trust.",
                            "target_lang_translations": {
                                "nl": "De gemeenschap besloot de persoon die hun vertrouwen had geschaad te <w>negeren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ostracize",
                        "avoid",
                        "ignore"
                    ],
                    "antonyms": [
                        "embrace",
                        "welcome"
                    ],
                    "common_phrases": [
                        "shun publicity",
                        "shun company"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand of iets hardnekkig vermijden of negeren, vaak als een vorm van sociale uitsluiting."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vermijden",
                                "target_lang_sense_clarification": "Algemeen woord voor het uit de weg gaan van personen of situaties."
                            },
                            {
                                "target_lang_word": "negeren",
                                "target_lang_sense_clarification": "Iemand bewust geen aandacht schenken."
                            },
                            {
                                "target_lang_word": "uitsluiten",
                                "target_lang_sense_clarification": "Iemand uit een groep of gemeenschap weren."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bf05b5d-3518-3743-863c-22e870a95422",
                    "sense_definition": "To successfully escape or stay away from a difficult or unpleasant situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>shun</w> the responsibility of the project by delegating it.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde de verantwoordelijkheid voor het project te <w>ontlopen</w> door het te delegeren."
                            }
                        },
                        {
                            "text": "They managed to <w>shun</w> the difficult task by leaving early.",
                            "target_lang_translations": {
                                "nl": "Ze slaagden erin de moeilijke taak te <w>ontwijken</w> door vroeg te vertrekken."
                            }
                        }
                    ],
                    "synonyms": [
                        "evade",
                        "escape"
                    ],
                    "common_phrases": [
                        "shun responsibility"
                    ],
                    "target_lang_definitions": {
                        "nl": "Succesvol ontsnappen aan of wegblijven van een moeilijke of onaangename situatie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontwijken",
                                "target_lang_sense_clarification": "Iets lastigs of een confrontatie uit de weg gaan."
                            },
                            {
                                "target_lang_word": "ontlopen",
                                "target_lang_sense_clarification": "Zich onttrekken aan een verplichting of onaangename taak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96ce364b-f96d-3d79-acb9-f4baab6b4ecb",
                    "sense_definition": "To hide or screen something from view.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick curtains <w>shun</w> the bright morning light from the room.",
                            "target_lang_translations": {
                                "nl": "De dikke gordijnen <w>schermen</w> het felle ochtendlicht uit de kamer af."
                            }
                        },
                        {
                            "text": "He used a large screen to <w>shun</w> the messy desk from his guests.",
                            "target_lang_translations": {
                                "nl": "Hij gebruikte een groot scherm om het rommelige bureau voor zijn gasten te <w>verbergen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hide",
                        "screen",
                        "conceal"
                    ],
                    "antonyms": [
                        "reveal",
                        "expose"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets aan het zicht onttrekken of afschermen (verouderd gebruik)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afschermen",
                                "target_lang_sense_clarification": "Iets fysiek uit het zicht houden."
                            },
                            {
                                "target_lang_word": "verbergen",
                                "target_lang_sense_clarification": "Iets onzichtbaar maken voor anderen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34697204-021e-34a4-bf55-cfcd8581f518",
                    "sense_definition": "To push or shove someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd began to <w>shun</w> him toward the exit.",
                            "target_lang_translations": {
                                "nl": "De menigte begon hem naar de uitgang te <w>duwen</w>."
                            }
                        },
                        {
                            "text": "He had to <w>shun</w> the heavy door to get it open.",
                            "target_lang_translations": {
                                "nl": "Hij moest tegen de zware deur <w>stoten</w> om hem open te krijgen."
                            }
                        }
                    ],
                    "synonyms": [
                        "push",
                        "shove"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely obsolete."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand of iets duwen of stoten (verouderd gebruik)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "duwen",
                                "target_lang_sense_clarification": "Kracht uitoefenen om iets of iemand te verplaatsen."
                            },
                            {
                                "target_lang_word": "stoten",
                                "target_lang_sense_clarification": "Een korte, krachtige duw geven."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}