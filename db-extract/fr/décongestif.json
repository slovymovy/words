                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9cb7560-dd24-4aff-9f1b-d5e43dcfb961",
                                "sense_id": "3a1ff1cd-05be-333b-8e22-6fd083c7c2de",
                                "text": "Une autre option est de tamponner la narine affectée avec une gaze ou de la ouate trempée dans un décongestif topique."
                            },
                            {
                                "example_id": "59700a9f-25af-4cb1-8158-400edb58f86e",
                                "sense_id": "3a1ff1cd-05be-333b-8e22-6fd083c7c2de",
                                "text": "Les tests de toxicologie ont montré la présence de barbituriques, de caféine, d’un médicament contre l'anxiété (Ativan), d’un anti-opioïde ainsi que d’un décongestif."
                            }
                        ]
