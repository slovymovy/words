                        "glosses": [
                            "Terme affectif donné généralement à un enfant."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2769c993-e442-40fe-b10b-5bec89083877",
                                "sense_id": "6ddd3d56-ad84-3f98-8a7e-5243336cf8bb",
                                "text": "Tout va se remettre en place aussitôt, reprendre forme, ce n’était rien, qu’est-ce que c’était ? un vilain rêve, de folles idées, mais qu’est-ce qu’il a encore, mon poussinet, mon grand nigaud... assise sur le bord de mon lit et moi blotti contre elle."
                            }
                        ]
                    },
