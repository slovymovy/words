                                "example_id": "991e4dc7-957b-48b3-9ffc-7beb758bed05",
                                "sense_id": "d2720599-520e-390d-a70e-77d11a7c91bb",
                                "text": "Tout à son projet d’agriculture alternative, Mark avait d’abord défini des règles ultrastrictes, inspirées par ses amis Amish."
                            },
                            {
                                "example_id": "da07f962-f5be-4113-b39e-fa10821e93d8",
                                "sense_id": "d2720599-520e-390d-a70e-77d11a7c91bb",
                                "text": "Et puis quitter la religion catholique si riche, fastueuse et cérémonieuse pour celle judaïque ultrastricte, triste et intransigeante, je ne te comprends pas."
                            }
                        ]
