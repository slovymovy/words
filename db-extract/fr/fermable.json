                "senses": [
                    {
                        "sense_id": "f5a4e391-535b-36c3-bcc2-5c0b42df36d6",
                        "entry_id": "4beb6601-e984-325a-a4dc-406504566174",
                        "glosses": [
                            "Qui peut être fermé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e0bd0aa-d126-4bc7-b966-a11ad12d176d",
                                "sense_id": "f5a4e391-535b-36c3-bcc2-5c0b42df36d6",
                                "text": "Une des portes d’entrée, fermable en dedans, est en ogive, mais sans aucune des moulures qui caractérisent ce style."
                            },
                            {
                                "example_id": "69add853-33cc-4719-8eb2-04d3b52b7899",
                                "sense_id": "f5a4e391-535b-36c3-bcc2-5c0b42df36d6",
                                "text": "Chacun a sa chambre, appelée cubiculum, de 7 pieds sur 4 pieds, possédant un lit avec sommier et matelas, une petite fenêtre et un coffre pour les vêtements, chauffée par une bouche de chaleur, fermable à volonté."
                            },
                            {
                                "example_id": "84091da4-2768-47e4-88b0-1d003b2b3486",
                                "sense_id": "f5a4e391-535b-36c3-bcc2-5c0b42df36d6",
                                "text": "Les passagers voyageant au départ de l'UE ne peuvent prendre en cabine que des flacons ou tubes d'une contenance maximum de 100 ml, qui doivent tous tenir dans un sac fermable d'une capacité d'un litre maximum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "770cf22e-74b6-49b9-9b2f-8e71094825ce",
                        "source_entry_id": "4beb6601-e984-325a-a4dc-406504566174",
                        "source_sense_id": "f5a4e391-535b-36c3-bcc2-5c0b42df36d6",
                        "target_lang_word": "schließbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schließbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa811651-2969-37c6-bca5-4d4b14f4be25",
                                        "entry_id": "2e29fc9f-ee09-3f53-a25c-c34314f90835",
                                        "glosses": [
                                            "so beschaffen, dass es sich schließen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c39aeac5-7263-431e-a1d0-596843fa6e71",
                                                "sense_id": "aa811651-2969-37c6-bca5-4d4b14f4be25",
                                                "text": "Jetzt arbeite ich auf dem Bau. Muss Türen und Fenster schließbar machen."
                                            },
                                            {
                                                "example_id": "97848af7-c13f-4589-b192-8e74f6b4a31e",
                                                "sense_id": "aa811651-2969-37c6-bca5-4d4b14f4be25",
                                                "text": "Die beiden anderen Schlösser fanden sie unversehrt und mit den dazu gehörigen Schlüsseln schließbar."
                                            },
                                            {
                                                "example_id": "c3a331bc-5023-4905-990d-775bf177beb7",
                                                "sense_id": "aa811651-2969-37c6-bca5-4d4b14f4be25",
                                                "text": "Die vorhandenen Beschläge werden gang- und schließbar gemacht oder bei Bedarf ersetzt."
                                            },
                                            {
                                                "example_id": "ae9ff4c0-6ecc-4054-9ea0-16e1df755434",
                                                "sense_id": "aa811651-2969-37c6-bca5-4d4b14f4be25",
                                                "text": "Die CDU geht von 44 000 fehlenden Plätzen aus, hält die Lücke ohne neue Landesmittel nicht für schließbar."
                                            },
                                            {
                                                "example_id": "0aa4d8c2-950c-4dc5-8d91-336f7bcc1774",
                                                "sense_id": "aa811651-2969-37c6-bca5-4d4b14f4be25",
                                                "text": "Nur das kann doch gemeint sein: dass Orte wie Theater, Opernhäuser und Konzertsäle schließbar sind, weil sie in dieser Gesellschaft nichts mehr bedeuten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "703188c8-e7ba-4a1e-91ca-030b07722af9",
                        "source_entry_id": "4beb6601-e984-325a-a4dc-406504566174",
