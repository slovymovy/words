                        "examples": []
                    },
                    {
                        "sense_id": "f93c08a6-d6f7-30a6-a51a-58ed2dac9556",
                        "entry_id": "faff3795-9408-3837-b345-9b33ba76cea7",
                        "glosses": [
                            "A small, usually plastic, chamber pot used to toilet-train small children."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf434630-d86d-45fb-a231-37c1acf2fa78",
                                "sense_id": "f93c08a6-d6f7-30a6-a51a-58ed2dac9556",
                                "text": "If you just let him know you want him to go on the potty, or anything, he's miles away."
                            },
                            {
                                "example_id": "751ac13d-f6e3-4104-abb7-15b3457ecec1",
                                "sense_id": "f93c08a6-d6f7-30a6-a51a-58ed2dac9556",
                                "text": "Mothers very often make the baby and themselves unhappy by setting the child on the potty every hour."
                            }
                        ]
                    },
                    {
                        "sense_id": "465b9048-d84f-3067-be5f-a64864a75cce",
                        "entry_id": "faff3795-9408-3837-b345-9b33ba76cea7",
                        "glosses": [
                            "Any other device or place for urination or defecation: a toilet; a lavatory; a latrine; an outhouse."
                        ],
                        "tags": [
                            "childish",
                            "humorous"
                        ],
                        "examples": []
                    }
