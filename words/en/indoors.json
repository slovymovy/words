    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ecb6e659-bd6c-3512-a611-cd5461f07794",
                    "sense_definition": "Inside, into, or within a building.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "interior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stayed <w>indoors</w> all day to avoid the brutal heat.",
                            "target_lang_translations": {
                                "ru": "Мы весь день оставались <w>в помещении</w>, чтобы избежать ужасной жары."
                            }
                        },
                        {
                            "text": "When it started to rain, we quickly went <w>indoors</w>.",
                            "target_lang_translations": {
                                "ru": "Когда пошел дождь, мы быстро зашли <w>внутрь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "inside",
                        "within"
                    ],
                    "antonyms": [
                        "outdoors"
                    ],
                    "common_phrases": [
                        "stay indoors",
                        "go indoors",
                        "keep indoors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутри, в или в пределах здания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в помещении",
                                "target_lang_sense_clarification": "внутри здания"
                            },
                            {
                                "target_lang_word": "дома",
                                "target_lang_sense_clarification": "внутри жилого помещения"
                            },
                            {
                                "target_lang_word": "внутри",
                                "target_lang_sense_clarification": "в середине здания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f866caf3-0a43-3bc1-919d-de7bd619ab79",
                    "sense_definition": "The interior of a building or the space inside buildings generally.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer the <w>indoors</w> to the outdoors because I like air conditioning.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю <w>помещение</w> открытому воздуху, потому что люблю кондиционеры."
                            }
                        },
                        {
                            "text": "The great <w>indoors</w> can be just as exciting as nature if you have a good book.",
                            "target_lang_translations": {
                                "ru": "<w>Домашний уют</w> может быть таким же захватывающим, как и природа, если у тебя есть хорошая книга."
                            }
                        }
                    ],
                    "synonyms": [
                        "interior",
                        "inside"
                    ],
                    "antonyms": [
                        "outdoors"
                    ],
                    "common_phrases": [
                        "the great indoors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интерьер здания или пространство внутри зданий в целом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помещение",
                                "target_lang_sense_clarification": "внутреннее пространство"
                            },
                            {
                                "target_lang_word": "дом",
                                "target_lang_sense_clarification": "внутренняя среда в противопоставление улице"
                            }
                        ]
                    }
                }
            ]
        }
    ]
