                    {
                        "sense_id": "8b7975ff-9751-358a-ace2-2a1f6ac7df23",
                        "entry_id": "ddf4fba5-1424-3340-ba39-f38a1690e5b4",
                        "glosses": [
                            "A conference, especially one between enemies."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "38a0b76e-aedf-4146-ba45-02833632ffbb",
                                "sense_id": "8b7975ff-9751-358a-ace2-2a1f6ac7df23",
                                "text": "We yield on parley, but are stormed in vain."
                            },
                            {
                                "example_id": "f88d07c1-3159-439d-a467-c59425f6b923",
                                "sense_id": "8b7975ff-9751-358a-ace2-2a1f6ac7df23",
                                "text": "Without further parley Garland rode off up the hog's-back and the sheriff rode off down it [...]"
                            },
                            {
                                "example_id": "3a324378-25c9-4098-bcaa-945398abc299",
                                "sense_id": "8b7975ff-9751-358a-ace2-2a1f6ac7df23",
                                "text": "In the highest-level parley of leaders of the two countries since the accident, President Obama is to meet with Pakistan’s prime minister, Yousaf Raza Gilani, on Tuesday in Seoul, South Korea, after a nuclear security conference there, to discuss Afghanistan and other security issues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24a45b32-164c-4299-aa4a-cc8ce3c85030",
                        "source_entry_id": "ddf4fba5-1424-3340-ba39-f38a1690e5b4",
                        "source_sense_id": "8b7975ff-9751-358a-ace2-2a1f6ac7df23",
                        "source_sense_description": "conference, especially one between enemies",
                        "target_lang_word": "pourparlers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pourparlers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d492e42f-b548-3904-94e3-b5258129421f",
                                        "entry_id": "7cf6eec1-dc95-3d32-92e0-a43d9f1c49ff",
                                        "glosses": [
                                            "Conversation, conférence entre deux ou plusieurs parties pour arriver à un accord ou traiter d’affaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ce8cbea-3b3b-45cc-b0f4-737c8b3c69b5",
                                                "sense_id": "d492e42f-b548-3904-94e3-b5258129421f",
                                                "text": "En 1945 commencèrent au Chili, des pourparlers au termes desquels les États-Unis étaient censés établir des missions spéciales pour régulariser les relations militaires entre les deux pays."
                                            },
                                            {
                                                "example_id": "765c237d-d25d-4998-b13b-5e7e3c71cca7",
                                                "sense_id": "d492e42f-b548-3904-94e3-b5258129421f",
                                                "text": "Ce ne fut que dans la nuit du samedi au dimanche, après trois jours de pourparlers, que l’orgueil de l’abbé Maslon plia devant la peur du maire qui se changeait en courage."
                                            },
                                            {
                                                "example_id": "5bbf02cf-42fc-4349-9a7d-fdce86a47b29",
                                                "sense_id": "d492e42f-b548-3904-94e3-b5258129421f",
                                                "text": "Il y eut une agitation sur l’estrade, de longs chuchotements, des pourparlers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "374a7961-2f0d-4a4c-8d87-c3690108dfef",
                        "source_entry_id": "ddf4fba5-1424-3340-ba39-f38a1690e5b4",
                        "source_sense_id": "8b7975ff-9751-358a-ace2-2a1f6ac7df23",
                        "source_sense_description": "conference, especially one between enemies",
                        "target_lang_word": "Unterredung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterredung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                        "entry_id": "270d535b-2006-3005-849c-00a0b09c02d0",
                                        "glosses": [
                                            "ein meist förmliches, offizielles Gespräch mit einer Person oder einigen Personen über eine wichtige Angelegenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef0eb804-8c1c-4c7f-a460-a0bf296522b6",
                                                "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                                "text": "Der Abteilungsleiter bittet die Sachbearbeiterin zu einer Unterredung."
                                            },
                                            {
                                                "example_id": "45077950-6fc1-4553-9dfd-6072dbc91e5b",
                                                "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                                "text": "In den ersten Märztagen 1976 hatten wir, Kohl und ich, in meiner Wohnung in Bonn eine Unterredung, in der wir die Lage und den Vertragstext noch einmal analysierten."
                                            },
                                            {
                                                "example_id": "4ddc37e3-1a9b-47d1-a55b-0edf257c6b88",
                                                "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                                "text": "Ich konnte nicht ahnen, dass ich kaum drei Monate später eine recht ungewöhnliche Unterredung mit seinem Nachfolger haben sollte und für kurze Zeit in seinem Arbeitszimmer im Vatikan eingeschlossen war."
                                            },
                                            {
                                                "example_id": "ca4e4e2e-42ae-4453-9c35-8d920d5c8d20",
                                                "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                                "text": "„Aus dem Gefühl heraus, daß hier unsere Unterredung stocke, schlug ich Herrn Jackopp vor, zu Herrn Rösselmann zu gehen, denn ich war gespannt, was dieser Herr zu dieser Neuerung so alles zu sagen hätte.“"
                                            },
                                            {
                                                "example_id": "ebb2980d-f0c3-41ca-91a3-fb6d011097d0",
                                                "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                                "text": "„Nach dieser Unterredung mit Pierre fuhr Anna Michailowna wieder zu Rostows und legte sich schlafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
