                                "target_senses": [
                                    {
                                        "sense_id": "70676c38-1c84-3b09-9818-4caf31337c02",
                                        "entry_id": "242b79d6-a158-3162-b246-6f06380da341",
                                        "glosses": [
                                            "A type of native gown worn in parts of Central Asia, historically awarded as a robe of honor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a153cd7b-8104-447c-a249-dee119c3850f",
                                                "sense_id": "70676c38-1c84-3b09-9818-4caf31337c02",
                                                "text": "Russian faces and dress have almost entirely disappeared and in their places are the enormous fur caps, long khalats, daggers and pistols of the swarthy Daghestan mountaineers and the black stupid faces of the Kalmuck Tartars."
                                            },
                                            {
                                                "example_id": "aafe9255-c7f5-49c7-9e1d-5c6764a3ec75",
                                                "sense_id": "70676c38-1c84-3b09-9818-4caf31337c02",
                                                "text": "The khalat was held in place with a girdle; among the upper classes, the richness of the buckle gave a clue to the rank of the wearer."
                                            },
                                            {
                                                "example_id": "7613b5d6-62c6-46b7-aa05-49cc290c4f3e",
                                                "sense_id": "70676c38-1c84-3b09-9818-4caf31337c02",
                                                "text": "Guards armed with scimitars and wearing long, brightly coloured khalats, or silk coats, stood at its gates, while an excited crowd of Khivans lined the way to see the giant figure of the Englishman pass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0daa6f0-1ad1-3c15-90bb-4fba5fd680ac",
                                        "entry_id": "242b79d6-a158-3162-b246-6f06380da341",
                                        "glosses": [
                                            "A long, close-fitting coat with shawl collars and pockets, worn by Ashkenazi Jewish men in Eastern Europe until the early 20th century"
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
