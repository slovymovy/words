    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e68bf403-1f90-3600-8fd1-df5e3627e00a",
                    "sense_definition": "Свободное рабочее место в штате организации.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "работа",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компания открыла новую <w>вакансию</w> для опытного программиста.",
                            "target_lang_translations": {
                                "en": "The company has opened a new <w>vacancy</w> for an experienced programmer."
                            }
                        },
                        {
                            "text": "На эту <w>вакансию</w> претендует много квалифицированных специалистов.",
                            "target_lang_translations": {
                                "en": "Many qualified specialists are applying for this <w>vacancy</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "открытая вакансия",
                        "занять вакансию"
                    ],
                    "target_lang_definitions": {
                        "en": "An unoccupied job position or role within an organization."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vacancy",
                                "target_lang_sense_clarification": "An unoccupied position or job."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ea50a75-28f0-318e-bf98-74e06d6e3d6a",
                    "sense_definition": "Перерыв в работе учебных заведений или учреждений.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "отдых",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Во время летних <w>вакансий</w> студенты разъезжались по домам.",
                            "target_lang_translations": {
                                "en": "During the summer <w>vacations</w>, students would go home."
                            }
                        },
                        {
                            "text": "Учебные <w>вакансии</w> длились почти три месяца.",
                            "target_lang_translations": {
                                "en": "The academic <w>holidays</w> lasted for almost three months."
                            }
                        }
                    ],
                    "synonyms": [
                        "каникулы"
                    ],
                    "antonyms": [
                        "будни"
                    ],
                    "common_phrases": [
                        "летние вакансии"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Устаревшее значение."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A break or holiday period in educational institutions or establishments (dated)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vacation",
                                "target_lang_sense_clarification": "A period of time away from work or school."
                            },
                            {
                                "target_lang_word": "holiday",
                                "target_lang_sense_clarification": "A period of rest or break from school or work."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fccb4b3-2494-31dd-b61f-6e9d5fd9eb33",
                    "sense_definition": "Отсутствие атома или иона в узле кристаллической решетки.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "наука",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Точечная <w>вакансия</w> влияет на электрические свойства кристалла.",
                            "target_lang_translations": {
                                "en": "A point <w>vacancy</w> affects the electrical properties of the crystal."
                            }
                        },
                        {
                            "text": "Миграция атомов происходит через свободные <w>вакансии</w> в решетке.",
                            "target_lang_translations": {
                                "en": "Atom migration occurs through free <w>vacancies</w> in the lattice."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A defect in a crystal lattice caused by the absence of an atom or ion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vacancy",
                                "target_lang_sense_clarification": "A defect in a crystal caused by the absence of an atom in a lattice."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}