                "senses": [
                    {
                        "sense_id": "ad8d432d-4542-34c9-8d63-aa9c40d67a21",
                        "entry_id": "ad32474d-4df3-3d2f-b63a-2b8702e5dcda",
                        "glosses": [
                            "vol met de neiging zich te verbergen voor anderen, verlegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae54fa32-7d39-4514-b8dd-0850b4a19886",
                                "sense_id": "ad8d432d-4542-34c9-8d63-aa9c40d67a21",
                                "text": "De beschaamde ouders wilden niet onderkennen dat hun jonge dochter zwanger was."
                            },
                            {
                                "example_id": "5731c829-6ab5-4a5c-b4f9-2f89ef41bd1e",
                                "sense_id": "ad8d432d-4542-34c9-8d63-aa9c40d67a21",
                                "text": "Hoewel zijn collega's volwassen mannen waren, hadden ze een manier om over vrouwen te praten die hem even neerslachtig als beschaamd maakte."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "93949ad1-3d91-3742-8281-d28abc919867",
                "word": "beschaamd",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3d42fe13-a565-3490-a204-a59e122b09c4",
                        "entry_id": "93949ad1-3d91-3742-8281-d28abc919867",
                        "glosses": [
                            "vol met de neiging zich te verbergen voor anderen, verlegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84703372-cab7-47d3-8cbe-61f2ee00343c",
                                "sense_id": "3d42fe13-a565-3490-a204-a59e122b09c4",
                                "text": "Ze keek beschaamd voor zich uit toen een passerende verpleger zijn hoofd haar kant op draaide."
                            },
                            {
                                "example_id": "9b9a9f6e-edd5-4c98-9a02-8f3d52a66941",
                                "sense_id": "3d42fe13-a565-3490-a204-a59e122b09c4",
                                "text": "Ik lach hard om het gesprek een beetje lucht te geven. Joy sist beschaamd. Zij houdt maar heel selectief van mijn lach."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0729c2b8-844e-4da1-88d9-01861fa70355",
                        "source_entry_id": "93949ad1-3d91-3742-8281-d28abc919867",
                        "source_sense_id": "3d42fe13-a565-3490-a204-a59e122b09c4",
                        "source_sense_description": "vol met de neiging zich te verbergen voor anderen",
                        "target_lang_word": "verschämt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschämt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dbe2277-f554-3c3c-b4d4-f6ef72b4bbf6",
                                        "entry_id": "563dc1d2-7f50-32e0-81f7-29d167d4a732",
                                        "glosses": [
                                            "sich ein wenig schämend; ein wenig Scham empfindend und verlegen; schüchtern und zaghaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f47e263-b776-4a30-adb4-869935b4a049",
                                                "sense_id": "3dbe2277-f554-3c3c-b4d4-f6ef72b4bbf6",
                                                "text": "Dennoch begegneten wir mehreren Fällen von „verschämter Armut“, also Rentnern, die lieber unterhalb des Existenzminimums leben, als Sozialhilfe zu beantragen."
                                            },
                                            {
                                                "example_id": "137381d9-61b4-4556-9269-3f8f1ad2c28f",
                                                "sense_id": "3dbe2277-f554-3c3c-b4d4-f6ef72b4bbf6",
                                                "text": "Fast ein wenig verschämt wirken die knapp 600 Protestierer, die sich vor der Bühne versammeln."
                                            },
                                            {
                                                "example_id": "3497a970-9133-4ad7-ac4a-b751e36f8095",
                                                "sense_id": "3dbe2277-f554-3c3c-b4d4-f6ef72b4bbf6",
                                                "text": "Die Studie benennt sie relativ klar: Es sind der Klerikalismus, so übrigens auch der Papst, und der verschämte Umgang mit der Sexualität."
                                            },
                                            {
                                                "example_id": "cf3bbd68-4234-45a2-ad79-353f7fae7075",
                                                "sense_id": "3dbe2277-f554-3c3c-b4d4-f6ef72b4bbf6",
                                                "text": "Da wurde diese Frau, die doch so ganz ohne jedes Schamgefühl gewesen war, nachdem sie den Bissen gegessen hatte, zur verschämtesten Frau und die, welche unter den Frauen Medinas mehr Anstand besaß als sie alle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5a012c4-f674-413b-a0c0-580c9ba503b6",
                        "source_entry_id": "93949ad1-3d91-3742-8281-d28abc919867",
                        "source_sense_id": "3d42fe13-a565-3490-a204-a59e122b09c4",
                        "source_sense_description": "vol met de neiging zich te verbergen voor anderen",
                        "target_lang_word": "ashamed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ashamed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44c9e207-d1b9-39e0-8ae1-1d88f5a0208a",
                                        "entry_id": "b5a4daff-056b-3b55-b920-f779252810c4",
                                        "glosses": [
                                            "Feeling shame or guilt."
                                        ],
                                        "tags": [
                                            "of someone in trouble and undergoing punishment for doing something wrong"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36b4cc6f-74ff-4eed-8731-5a7cdf801963",
                                                "sense_id": "44c9e207-d1b9-39e0-8ae1-1d88f5a0208a",
                                                "text": "They ſhal be turned backe : they ſhal be greatly aſhamed, that truſt in grauẽ images, and ſay to the molten images, Ye are our gods."
                                            },
                                            {
                                                "example_id": "d8764bac-4f0c-4446-8c18-1427603ee5c5",
                                                "sense_id": "44c9e207-d1b9-39e0-8ae1-1d88f5a0208a",
                                                "text": "Good Sir pardon me, / I feel ſufficiently my follies penance, / And am aſham’d, that ſhame a thouſand ſorrows / Feed on continually, would I had never ſeen her, / Or with a clearer judgement look’d upon her, / She was too good for me, ſo heavenly good Sir, / Nothing but Heaven can love that ſoul ſufficiently, / Where I ſhall ſee her once again."
                                            },
                                            {
                                                "example_id": "46c4d445-682f-4a11-a5bc-ca72f709dbf1",
                                                "sense_id": "44c9e207-d1b9-39e0-8ae1-1d88f5a0208a",
                                                "text": "Be ashamed to die until you have won some victory for humanity."
                                            }
                                        ]
                                    }
                                ]
                            },
