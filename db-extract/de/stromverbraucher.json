                ],
                "senses": [
                    {
                        "sense_id": "4509e668-81a1-3d45-afe9-1aaf7a0c7361",
                        "entry_id": "59a80911-b44a-36c4-a9d8-3916e1ca178a",
                        "glosses": [
                            "Person, die elektrischen Strom konsumiert/verbraucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33b70721-88f0-4b98-a13b-59e88e42a99b",
                                "sense_id": "4509e668-81a1-3d45-afe9-1aaf7a0c7361",
                                "text": "„Die privaten Stromverbraucher bestimmen bis heute weitgehend autonom den zeitlichen Verlauf ihres Stromverbrauchs, und zwar unabhängig von der momentanen Situation der Stromproduktion und den Stromproduktionskosten.“"
                            },
                            {
                                "example_id": "761e1182-6010-45be-9282-920622dbbd80",
                                "sense_id": "4509e668-81a1-3d45-afe9-1aaf7a0c7361",
                                "text": "„Für industrielle Stromverbraucher in den neuen Bundesländern beträgt die Mehrbelastung durchschnittlich 1,5 Pfennige je Kilowattstunde.“"
                            },
                            {
                                "example_id": "1e8b96ec-5506-46df-b58f-79eec84438e1",
                                "sense_id": "4509e668-81a1-3d45-afe9-1aaf7a0c7361",
                                "text": "„Weitere Punkte in den geplanten Maßnahmenpaketen betreffen demnach die Abschaffung der EEG-Umlage zur Entlastung der Stromverbraucher sowie Klimaschutzverträge zur staatlichen Unterstützung des Umbaus der Industrie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6c56eee-7e92-3fbd-b1dc-df961d0f7044",
                        "entry_id": "59a80911-b44a-36c4-a9d8-3916e1ca178a",
                        "glosses": [
                            "etwas, das elektrischen Strom verbraucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62d781ce-358b-4ad2-99b7-c31f15af1f00",
                                "sense_id": "c6c56eee-7e92-3fbd-b1dc-df961d0f7044",
                                "text": "„Große Stromverbraucher sind Kompressorkühlschrank, Klimaanlage für den Aufbau, Fön, Mikrowelle, Toaster oder Senseobzw.“"
                            },
                            {
                                "example_id": "c1f8ca21-f6fc-4a4b-a039-41e4bc59ba30",
                                "sense_id": "c6c56eee-7e92-3fbd-b1dc-df961d0f7044",
                                "text": "„Wird dann der letzte Stromverbraucher ausgeschaltet, senkt das Gerät die Spannung von 220 Volt auf ungefähr 4 Volt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
