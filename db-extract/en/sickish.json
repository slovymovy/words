                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1afe405f-68ec-4169-9be7-8f6fa952e8f9",
                                "sense_id": "12f87b74-6bbc-3b75-a0af-cca4ef92652b",
                                "text": "[W]hen an unexpected bankruptcy was announced by Cluffe or Toole in the Club-room, it made his ear ring like a slap, and he felt sickish for half an hour after."
                            },
                            {
                                "example_id": "f8ec86f2-903a-4eb8-a865-0f19530a73a5",
                                "sense_id": "12f87b74-6bbc-3b75-a0af-cca4ef92652b",
                                "text": "His heart was thumping harder than ever, and it was impossible to tell if the sickish, pukey feeling deep down in his belly was relief or terror."
                            }
                        ]
                    }
