                "senses": [
                    {
                        "sense_id": "c85787b8-89c2-30d9-9a73-924b61c9be46",
                        "entry_id": "37bc277a-a49f-3503-a5e9-29625b5a96e1",
                        "glosses": [
                            "die Tatsache, dass etwas 75 % oder mehr der Stimmen auf sich vereint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b0daf1d-9c21-4b21-bd24-3c9460fd3438",
                                "sense_id": "c85787b8-89c2-30d9-9a73-924b61c9be46",
                                "text": "„Ein Aufsichtsratsmitglied einer Aktiengesellschaft beispielsweise kann von der Hauptversammlung mit Dreiviertelmehrheit abgewählt werden.“"
                            },
                            {
                                "example_id": "ed7555b4-a0ef-4457-b5e9-d3cb6d770d97",
                                "sense_id": "c85787b8-89c2-30d9-9a73-924b61c9be46",
                                "text": "Eine Dreiviertelmehrheit geht über die sogenannte „einfache Mehrheit“ hinaus."
                            },
                            {
                                "example_id": "e64c0dc5-5801-451d-8c41-c0b2e2270268",
                                "sense_id": "c85787b8-89c2-30d9-9a73-924b61c9be46",
                                "text": "Dreiviertelmehrheit bedeutet in diesem Fall drei Viertel der Stimmen aller Betriebsratsmitglieder."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
