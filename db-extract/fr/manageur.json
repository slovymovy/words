            {
                "entry_id": "3c3cc3f8-d77b-30eb-a818-c36870669d32",
                "word": "manageur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fbef5f12-fa7f-47bc-a4bf-ac47b828ccbe",
                        "entry_id": "3c3cc3f8-d77b-30eb-a818-c36870669d32",
                        "tags": [
                            "plural"
                        ],
                        "form": "manageurs"
                    },
                    {
                        "form_id": "b55dd24a-9a38-4c34-8204-2a8f0a78eadc",
                        "entry_id": "3c3cc3f8-d77b-30eb-a818-c36870669d32",
                        "tags": [
                            "feminine"
                        ],
                        "form": "manageuse"
                    },
                    {
                        "form_id": "96dfcb6e-69fa-4fe5-b99b-6a8f5588ef23",
                        "entry_id": "3c3cc3f8-d77b-30eb-a818-c36870669d32",
                        "tags": [
                            "feminine"
                        ],
                        "form": "manageure"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a5a54ad-cff9-3b22-8a4e-bd95bf699fa1",
                        "entry_id": "3c3cc3f8-d77b-30eb-a818-c36870669d32",
                        "glosses": [
                            "Personne qui exerce une fonction relevant du management."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8e6166a8-4b78-494b-85ac-042a0dd54a5c",
                                "sense_id": "4a5a54ad-cff9-3b22-8a4e-bd95bf699fa1",
                                "text": "Un dirigeant d’entreprise doit certes être un manageur, mais aussi un gestionnaire et un stratège."
                            },
                            {
                                "example_id": "f78c9a7f-cf33-4fd6-9a8b-106bd11cfba0",
                                "sense_id": "4a5a54ad-cff9-3b22-8a4e-bd95bf699fa1",
                                "text": "S’ils détestent les organisations pyramidales, les silos, les chefs control freak, ils veulent des manageurs qui fédèrent le collectif, en étant constructifs et attentifs à chacun."
                            }
                        ]
                    },
                    {
                        "sense_id": "79cf05a2-5f3f-3fd7-82b4-5802e2e636b6",
                        "entry_id": "3c3cc3f8-d77b-30eb-a818-c36870669d32",
                        "glosses": [
                            "Directeur sportif."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d7a17c28-e4bb-4f71-b4d6-5ad5c0d23522",
                                "sense_id": "79cf05a2-5f3f-3fd7-82b4-5802e2e636b6",
                                "text": "Nous retrouver ici a une forte portée symbolique, appuie le manageur général, Raphaël Ibañez."
                            },
                            {
                                "example_id": "8ee48fe5-dfa2-4c97-acd1-57bb3bf9c256",
                                "sense_id": "79cf05a2-5f3f-3fd7-82b4-5802e2e636b6",
                                "text": "Il y a également un avantage à voir cette paire émerger, selon Aubin Hueber, ancien demi de mêlée international et actuel manageur de Grenoble : « Il ne faut pas qu’on soit dépendants d’un ou deux joueurs, parce que les blessures, ça arrive souvent au rugby. Il faut prévoir l’imprévisible, comme disaient les All Blacks à propos des Français. »"
                            },
                            {
                                "example_id": "2138082e-f38e-4c1d-8b90-4c5e4d8964bf",
                                "sense_id": "79cf05a2-5f3f-3fd7-82b4-5802e2e636b6",
                                "text": "Claude Onesta, le manageur général de la haute performance à l’Agence nationale du sport, avait révélé en mars avoir identifié « 107 médailles potentielles »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b50bbbf2-b07f-4120-a8a6-30b08831e525",
                        "source_entry_id": "3c3cc3f8-d77b-30eb-a818-c36870669d32",
                        "target_lang_word": "manager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3333a928-571d-3722-80c0-800b894f030a",
                                        "entry_id": "b8869064-7871-3be0-b7dd-87ba32048942",
                                        "glosses": [
                                            "A person whose job is to manage something, such as a business, a restaurant, or a sports team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1389617e-c0b2-4532-ab36-dbce5a19cdfa",
                                                "sense_id": "3333a928-571d-3722-80c0-800b894f030a",
                                                "text": "Although they did not want to risk wasting money, faster-climbing managers did value generosity and fair-mindedness."
                                            },
                                            {
                                                "example_id": "e7fc4d11-ac2d-453c-b4dc-7a33627649da",
                                                "sense_id": "3333a928-571d-3722-80c0-800b894f030a",
                                                "text": "And it was a fitting victory for Liverpool as Anfield celebrated the 100th anniversary of the birth of their legendary Scottish manager Bill Shankly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad2e8a70-bd27-36be-b254-6f1f0a067173",
                                        "entry_id": "b8869064-7871-3be0-b7dd-87ba32048942",
                                        "glosses": [
                                            "The head coach."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4c98147-148e-3697-b391-8f9a80b9de09",
                                        "entry_id": "b8869064-7871-3be0-b7dd-87ba32048942",
                                        "glosses": [
                                            "An administrator, for a singer or group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81b9a79e-0a9b-3229-a117-631a07dd9e5a",
                                        "entry_id": "b8869064-7871-3be0-b7dd-87ba32048942",
                                        "glosses": [
                                            "A window or application whose purpose is to give the user the control over some aspect of the system."
                                        ],
                                        "tags": [],
