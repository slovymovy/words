                "senses": [
                    {
                        "sense_id": "5fa107d1-7dee-3231-9c5d-bb8f969ce9f8",
                        "entry_id": "dddaf5b1-0bb6-322a-aad0-cc2a3d3dd109",
                        "glosses": [
                            "Einstellung, sich weder für sichere noch unsichere Alternativen zu entscheiden"
                        ],
                        "tags": [
                            "Wirtschaftsjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "b2e142fc-1b8b-4c95-ad63-2292e03a1a04",
                                "sense_id": "5fa107d1-7dee-3231-9c5d-bb8f969ce9f8",
                                "text": "„Nichts desto trotz wird dadurch keine Risikoneutralität des Investors vorausgesetzt.“"
                            },
                            {
                                "example_id": "73f29cca-0bc4-46c0-806b-99ee0585ab2f",
                                "sense_id": "5fa107d1-7dee-3231-9c5d-bb8f969ce9f8",
                                "text": "„Je nachdem, ob Risikoneutralität vorliegt oder nicht, müssen unterschiedliche Optimierungstechniken eingesetzt werden.“"
                            },
                            {
                                "example_id": "5c70146b-f375-4664-8f9f-cbc1f4820824",
                                "sense_id": "5fa107d1-7dee-3231-9c5d-bb8f969ce9f8",
                                "text": "„Der Satz der Risikoneutralität spielt eine wichtige Rolle für die Bewertung von Optionen mit dem Binomialmodell.“"
                            },
                            {
                                "example_id": "fa37086d-cd85-4102-a5f5-c4ab885f7bde",
                                "sense_id": "5fa107d1-7dee-3231-9c5d-bb8f969ce9f8",
                                "text": "„Es erlaubt, den umgangssprachlichen Begriffen Risikoneutralität, Risikoabneigung (Risikoscheu) und Risikofreude als drei Erscheinungsformen von Risikoneigung einen präzisen, weil modellgestützten Sinn zu geben.“"
                            },
                            {
                                "example_id": "f957792e-cbad-440c-8312-dbef615e0f63",
                                "sense_id": "5fa107d1-7dee-3231-9c5d-bb8f969ce9f8",
                                "text": "„Neben den bereits diskutierten Annahmen der ökonomischen Kriminalitätstheorie werden zudem einige weitere Postulate eingeführt: So wird beispielsweise Risikoneutralität unterstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
