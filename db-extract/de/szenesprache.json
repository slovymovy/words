                        "glosses": [
                            "besondere Ausdrucksweise, wie sie in bestimmten Szenen/Milieus/Subkulturen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "689585a6-b29b-4906-bdef-5eaf11116119",
                                "sense_id": "ab6e0827-5b39-36f1-b9e4-4af63e9d9d6b",
                                "text": "„Zu letzteren gehören beispielsweise solche nach Berücksichtigung der gesprochenen Sprache sowie von Szene- oder bestimmten Fachsprachen.“"
                            },
                            {
                                "example_id": "5a530a75-22bd-4a21-9ae9-515d8388c82b",
                                "sense_id": "ab6e0827-5b39-36f1-b9e4-4af63e9d9d6b",
                                "text": "„In der Sprachwissenschaft gelten Szenesprachen als besonders glattes Terrain, weil sie sich mit atemberaubender Geschwindigkeit verändern und nur von Insidern wirklich beherrscht werden.“"
                            }
                        ],
