                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chirurgie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e012ab40-093f-3ad0-afb1-94accee34e79",
                                        "entry_id": "d2de39b5-c7dc-3189-8ae7-e34ba1ca33de",
                                        "glosses": [
                                            "Partie de l’art médical qui consiste à faire avec la main ou à l’aide d’instruments certaines opérations sur le corps de l’homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d14ae5-db6f-42d9-98a8-dead7517dd10",
                                                "sense_id": "e012ab40-093f-3ad0-afb1-94accee34e79",
                                                "text": "Il n’est presque rien de plus grossier, de plus bref que la chirurgie, quand elle se sépare de la médecine, quand celui qui tient le couteau ne sait point que ce couteau est un pis-aller, une défaite de l’ingéniosité thérapeutique. Les femmes sottes admirent cette charcuterie enragée où elles voient un spectacle de force."
                                            },
                                            {
                                                "example_id": "9114339e-3b4a-410b-8c4a-a95103e9c84c",
                                                "sense_id": "e012ab40-093f-3ad0-afb1-94accee34e79",
                                                "text": "Dans les dernières années, la chirurgie de l’épilepsie est apparue comme une solution possible dans le traitement des épilepsies partielles de l'enfant."
                                            },
                                            {
                                                "example_id": "12ec0cc4-9e01-40da-99f5-f6c1174310ab",
                                                "sense_id": "e012ab40-093f-3ad0-afb1-94accee34e79",
                                                "text": "La peau tendue par la chirurgie plissait bizarrement."
                                            }
                                        ]
