                ],
                "senses": [
                    {
                        "sense_id": "b28f20c5-1b58-3e27-863b-cefb79f9b6bc",
                        "entry_id": "27f4c318-64a9-3123-859e-17e293ad794d",
                        "glosses": [
                            "die Autökologie betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f46584-d6f6-4e0d-abf2-b9828a624452",
                                "sense_id": "b28f20c5-1b58-3e27-863b-cefb79f9b6bc",
                                "text": "„Für viele Arten liegt das synökologische Optimum weit vom autökologischen Optimum entfernt.“"
                            },
                            {
                                "example_id": "489227f3-7d1f-433a-87fe-cd9832abbf82",
                                "sense_id": "b28f20c5-1b58-3e27-863b-cefb79f9b6bc",
                                "text": "„Die Schulbienen bereichern den Schulalltag und leiten an zu planvollem Handeln zur Lösung komplexer Probleme, schaffen Verständnis für Lebenszusammenhänge und Lebensvorgänge, geben Einblick in autökologische (Wechselbeziehungen der Tiere untereinander) und demökologische (Abhängigkeit von anderen Populationen) Zusammenhänge und führen an Fragen der Lebensmittelproduktion und der gesunden Ernährung heran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
