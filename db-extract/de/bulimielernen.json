                "senses": [
                    {
                        "sense_id": "20804f3b-feba-3755-a3b0-d40e938ce570",
                        "entry_id": "f1933ad6-8558-3bc2-b027-aec7f8481a78",
                        "glosses": [
                            "innerhalb von kürzester Zeit Lernstoff aufnehmen, um ihn bei einer Prüfung nachweisen zu können, ihn danach aber schnell wieder vergessen"
                        ],
                        "tags": [
                            "Slang",
                            "Studentensprache"
                        ],
                        "examples": [
                            {
                                "example_id": "1e3eee54-734c-49ba-b9d0-ae63892c1bf4",
                                "sense_id": "20804f3b-feba-3755-a3b0-d40e938ce570",
                                "text": "„‚Das hat etwas von Bulimielernen: Wissen in sich reinstopfen und dann auf Kommando ausspucken‘, entgegnet sie.“"
                            },
                            {
                                "example_id": "6e512ccd-b0bf-4587-ae35-b82503687b0f",
                                "sense_id": "20804f3b-feba-3755-a3b0-d40e938ce570",
                                "text": "„Auch in Fernkursen dominiert also das Bulimielernen. Das Ziel der Teilnehmer ist meist, ein Zertifikat zu erlangen, das ihnen Türen in Wirtschaftsberufe öffnet.“"
                            },
                            {
                                "example_id": "879e04e9-1b07-4628-bbdf-93ee0f25a495",
                                "sense_id": "20804f3b-feba-3755-a3b0-d40e938ce570",
                                "text": "„»Seit Jahren werden die Schulen immer mehr zu Produktionsstätten abfragbaren Wissens umgebaut.« Daher konzentrierten sich Schüler zunehmend auf »Bulimielernen«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
