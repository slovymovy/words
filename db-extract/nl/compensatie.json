                                        "sense_id": "a3be1275-a761-34c5-a2ca-c92e94bec764",
                                        "entry_id": "11e62d0d-7d94-3fee-8fca-d44bda278802",
                                        "glosses": [
                                            "Abwicklung von Käufen und Verkäufen desselben Wertpapiers durch eine Bank, außerhalb der Börse"
                                        ],
