                        "glosses": [
                            "Qui concerne l’épicanthus, pli cutané allant de la paupière supérieure jusqu’au bord du nez."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "081e601e-925d-439c-83ef-70e74a296cac",
                                "sense_id": "09a6ff9a-3f71-3113-b574-8ebf36c2967d",
                                "text": "Ils ont établi que l’œil dit mongolique se compose de trois traits : l’obliquité de la fente palpébrale, le repli épicanthique et l’adiposité de la paupière supérieure."
                            },
                            {
                                "example_id": "957421e1-103a-4303-834c-a8437d093670",
                                "sense_id": "09a6ff9a-3f71-3113-b574-8ebf36c2967d",
                                "text": "Ses yeux verts étaient petits et le repli épicanthique des paupières supérieures lui donnait presque l’air d’un Asiatique."
                            }
                        ]
