                "senses": [
                    {
                        "sense_id": "73d9e5de-80e8-3698-90e0-a1919caf80aa",
                        "entry_id": "934cabbe-f142-34c3-9a59-815cd5779f41",
                        "glosses": [
                            "Amener un caractère réglementaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c42211-800a-4af2-be07-2a648511a5fd",
                                "sense_id": "73d9e5de-80e8-3698-90e0-a1919caf80aa",
                                "text": "Signalons que quand un texte législatif intervient hors du domaine de l’art. 34 C., le Gouvernement peut « réglementariser » le texte par décret pris après avis du Conseil d’État (art. 37 al. 2 C.)."
                            },
                            {
                                "example_id": "94ea920d-a26c-4f64-98b1-69a92e80e47a",
                                "sense_id": "73d9e5de-80e8-3698-90e0-a1919caf80aa",
                                "text": "De même, le projet de réglementariser la prostitution au Congo se révélera rapidement être un fiasco."
                            },
                            {
                                "example_id": "e21209f2-4ebd-47e4-b9f9-262b03155cd7",
                                "sense_id": "73d9e5de-80e8-3698-90e0-a1919caf80aa",
                                "text": "On peut penser que la structure actuelle des groupes japonais représente une formule transitoire et qu’elle tendra à se fixer et à se réglementariser."
                            }
                        ]
                    }
