                "senses": [
                    {
                        "sense_id": "e7190a73-846b-3427-87a7-8d86ed371173",
                        "entry_id": "bb1ed98d-011b-3360-875c-38b66fce6103",
                        "glosses": [
                            "ein beiderseits aus mehreren Knochen zusammengesetzter Teil des Skeletts der Wirbeltiere, der primär der Befestigung der Vorderextremitäten dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b58ec257-acda-4a4f-8e25-3445f3398551",
                                "sense_id": "e7190a73-846b-3427-87a7-8d86ed371173",
                                "text": "„Bei Fischen finden wir den Schultergürtel als eine Skelettspange, die mit dem Kopf in fester Verbindung steht. Sie bildet den hinteren Abschluß der Kiemenregion, bei Knochenfischen auch den Abschluß der einheitlichen Kiemenhöhle. … Die ältesten uns bekannten Landwirbeltiere, die Stegocephalier, haben keine Kiemen mehr. Damit fällte die Rolle des Schultergürtels als Abschluß einer Kiemenhöhle weg, und es bleibt nur die Aufgabe als Träger der paarigen Gliedmaßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
