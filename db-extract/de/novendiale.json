                "senses": [
                    {
                        "sense_id": "c3b716b8-1eb5-38f0-b23d-69e839c6c169",
                        "entry_id": "8b48897e-2108-3cc5-afe0-e0609b14d7f2",
                        "glosses": [
                            "neuntägige Trauerzeit nach dem Tode eines Papstes"
                        ],
                        "tags": [
                            "Katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "b0421ccb-f711-4a60-a8ad-a7dbfb097c40",
                                "sense_id": "c3b716b8-1eb5-38f0-b23d-69e839c6c169",
                                "text": "„Die Bulle von Gregor X. legte einige Punkte des Konklaves fest:“ […] „dass nach Ende des Novendiale und der Messe zum Heiligen Geist, die am zehnten Tag gesungen wird, die Kardinäle mit jeweils einem Diener oder, wenn notwendig, mehr in den Palast, in dem der Papst starb, eingeschlossen werden sollen. Niemand soll das Konklave verlassen, außer wenn er krank ist, oder hinzukommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd2ad30e-78db-3771-ad66-11174ac7387c",
                        "entry_id": "8b48897e-2108-3cc5-afe0-e0609b14d7f2",
                        "glosses": [
                            "Opfer, das nach einer neuntägigen Trauerzeit nach dem Tode eines Menschen bei den antiken Römern dargebracht wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70c84f6b-4f67-4f91-924e-957d67c77ae1",
                                "sense_id": "fd2ad30e-78db-3771-ad66-11174ac7387c",
                                "text": "„Am neunten Tage wurde ein Opfer, Novendiale genannt, errichtet, mit welchem die Trauerfeierlichkeiten sich endeten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
