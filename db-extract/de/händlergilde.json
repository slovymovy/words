                        "tags": [],
                        "examples": [
                            {
                                "example_id": "161c9860-390a-48b3-989c-fc1a74fd0345",
                                "sense_id": "9ab152cc-9cb0-3978-b8d7-e67a57d95f14",
                                "text": "„Die Cholas hatten gute Beziehungen zu großen Händlergilden, die im Überseehandel aktiv waren, und nahmen durch die Kontrolle des Handels wohl mehr ein als durch die Besteuerung der Landwirtschaft.“"
                            },
                            {
                                "example_id": "a0feac71-1360-4cfe-9e1a-3a9188e4f6ff",
                                "sense_id": "9ab152cc-9cb0-3978-b8d7-e67a57d95f14",
                                "text": "„Ansehen verlieh auch die Mitgliedschaft in einer Handwerker- oder Händlergilde; ihr Vorsitz garantierte eine herausgehobene Stellung, die Zugang zu besonderen Gütern mit sich brachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
