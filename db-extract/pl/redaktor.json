                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Redakteur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6df576d5-ae77-3916-b0bd-13bf9c5fd93a",
                                        "entry_id": "5ad3a883-2290-35cd-9352-cbfd7c500559",
                                        "glosses": [
                                            "Person, die in den Medien (Fernsehen, Presse, Rundfunk, Verlage) Manuskripte abfasst, überarbeitet und verbessert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cadd5791-dc69-468f-9ef9-541a86086bd6",
                                                "sense_id": "6df576d5-ae77-3916-b0bd-13bf9c5fd93a",
                                                "text": "„Künftig werden sicher nur Führungskräfte in den Redaktionen sitzen, also Redakteure, die das Blatt machen, es aber nicht füllen“, sagt Manfred Bausch (Experte der Bundesarbeitsagentur)."
                                            },
                                            {
                                                "example_id": "038688d9-7aca-4928-99f0-27b000e1953c",
                                                "sense_id": "6df576d5-ae77-3916-b0bd-13bf9c5fd93a",
                                                "text": "„Der Redakteur war inzwischen gegangen und hatte uns sein Büro überlassen.“"
                                            },
                                            {
                                                "example_id": "05156369-3149-4f93-85bb-25fe7abe8f46",
                                                "sense_id": "6df576d5-ae77-3916-b0bd-13bf9c5fd93a",
                                                "text": "„Als die Redakteure der Sendung erfuhren, daß Matilda nicht mehr da war, wollten sie Helena helfen, ihre gute Tat zu vollbringen, und schlugen ihr vor, sie solle das Zimmer doch einem anderen Mädchen geben, das ebenfalls die Kriterien erfüllte.“"
                                            },
                                            {
                                                "example_id": "a8d9d9ca-e136-4971-a71b-61de5d7d850d",
                                                "sense_id": "6df576d5-ae77-3916-b0bd-13bf9c5fd93a",
                                                "text": "„Und die Redakteure bildeten sich im Kunstfliegen aus, und je jüdischer einer hieß, desto raußerer flog er raus.“"
                                            },
                                            {
                                                "example_id": "a6f57b0f-6b99-4c13-bd33-f781e147f622",
                                                "sense_id": "6df576d5-ae77-3916-b0bd-13bf9c5fd93a",
                                                "text": "„Frank Thies, zehn Jahre jünger als Walter von Molo, Theaterkritiker, Redakteur, seit den Zwanzigerjahren erfolgreicher Romanautor, nach 1933 unvermindert aktiv, 1936 mit dem Buch »Tsushima«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
