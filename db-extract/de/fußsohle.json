                ],
                "senses": [
                    {
                        "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                        "entry_id": "40745089-05a0-3ce9-a68f-4313cce1f030",
                        "glosses": [
                            "die Unterseite des Fußes, mit der man beim Gehen auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14b44c69-a2a1-45b0-b074-e89abc875917",
                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                "text": "Meine Fußsohle ist von Blasen übersät."
                            },
                            {
                                "example_id": "d6d9170c-1e4e-4b85-ac17-a5637c8ca50b",
                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                "text": "Von der langen Wanderung tun mir die Fußsohlen weh."
                            },
                            {
                                "example_id": "a3cd0160-5cfb-46d4-a6e6-790b1e7a85dd",
                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                "text": "„Lamm begann es zu schwindeln, und mich strengte das Anziehen der Fußspitze immer mehr an, und ich fühlte das Blut an der Fußsohle klopfen.“"
                            },
                            {
                                "example_id": "1dfc1ce3-1812-47e7-9d8b-583763d4ceb4",
                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                "text": "„Bei jedem Schritt klatschten die Badeschlappen an seine Fußsohlen.“"
                            },
                            {
                                "example_id": "72ed5686-1227-4434-a350-564ec327e905",
                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                "text": "„Die Slipper klatschen beim Gehen gegen ihre Fußsohlen.“"
                            },
                            {
                                "example_id": "342f8939-8636-4828-9771-c9b728d65e39",
                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                "text": "„Man kann Jón Hreggvidssons Fußsohlen von unten sehen, wie er da oben auf dem Dach sitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a8fd200-4068-4a33-a88f-dce22a21f320",
                        "source_entry_id": "40745089-05a0-3ce9-a68f-4313cce1f030",
                        "source_sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                        "source_sense_description": "die Unterseite des Fußes, mit der man beim Gehen auftritt",
                        "target_lang_word": "plante du pied",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plante du pied",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca10fd2d-a643-32f7-a709-f012f0a6308e",
                                        "entry_id": "ebab114a-53dc-3faf-a6c6-30ed104bcf9b",
                                        "glosses": [
                                            "Partie inférieure ou ventrale du pied, en contact avec le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19d2176f-0e1a-467a-9060-0c72b00eff4a",
                                                "sense_id": "ca10fd2d-a643-32f7-a709-f012f0a6308e",
                                                "text": "Il faut distinguer deux parties dans le soulier : la semelle qui doit garnir la plante du pied, du talon à l’extrémité des orteils; l’empeigne qui est destinée à recouvrir tout ou partie de la surface supérieure du pied."
                                            },
                                            {
                                                "example_id": "32084f91-9dda-4336-84af-e16ca499a3d2",
                                                "sense_id": "ca10fd2d-a643-32f7-a709-f012f0a6308e",
                                                "text": "L’enseignement de Magdeleine était toujours baroque ; elle m’expliqua que le plaisir dépendait des goûts de chacun : son amie Nini exigeait que son partenaire lui embrassât ou lui chatouillât la plante des pieds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
