                                            {
                                                "example_id": "94dc372a-8f02-4b81-8280-d2b55958ce60",
                                                "sense_id": "caa7d089-fff4-3fef-b09f-80e617edefbc",
                                                "text": "On a vu à Copenhague des Lapons regreter leurs montagnes de glace, & sécher de langueur & de chagrin, de ce qu’on leur refusoit la permission d’y retourner."
                                            },
                                            {
                                                "example_id": "040c31cf-2cbe-4acf-8e90-b5f8e1937b90",
                                                "sense_id": "caa7d089-fff4-3fef-b09f-80e617edefbc",
                                                "text": "Le 22, au point du jour, la cité entière, entassée sur les quais du port et sur les côtes voisines, guettait d’un œil avide et colère le steamer qui amenait à Copenhague la députation du meeting de Rendsbourg."
                                            }
                                        ]
                                    },
