                                        "examples": []
                                    },
                                    {
                                        "sense_id": "255812be-9407-361d-90c5-e064c8d18199",
                                        "entry_id": "1d31fe28-ea2f-35c2-b965-b156a2d3b9a2",
                                        "glosses": [
                                            "Se cacher ; s’abriter."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0db897b0-b2ee-4899-a0b6-81eb92d95094",
                                                "sense_id": "255812be-9407-361d-90c5-e064c8d18199",
                                                "text": "Les maîtres d’école prétendent que ce qu’on écrit se fourre plus avant dans la cervelle que ce qu’on apprend par cœur, et que c’est pour ça qu’ils font faire des devoirs aux enfants, au lieu de se contenter de leur faire réciter des leçons."
                                            },
                                            {
                                                "example_id": "84741f4c-4609-4f47-bd1d-0a0db294b95f",
                                                "sense_id": "255812be-9407-361d-90c5-e064c8d18199",
                                                "text": "Et nous, dès que les pierres commencèrent à rouler en avant de nous, nous nous fourrâmes dans un trou et nous attendîmes la fin de l’orage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5297c217-d749-3a4d-b011-58bea3129030",
                                        "entry_id": "1d31fe28-ea2f-35c2-b965-b156a2d3b9a2",
                                        "glosses": [
                                            "Se mettre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a20f5e6c-0ed8-4a35-9bb3-657345b7aa8b",
                                                "sense_id": "5297c217-d749-3a4d-b011-58bea3129030",
                                                "text": "Les maîtres d’école prétendent que ce qu’on écrit se fourre plus avant dans la cervelle que ce qu’on apprend par cœur, et que c’est pour ça qu’ils font faire des devoirs aux enfants, au lieu de se contenter de leur faire réciter des leçons."
                                            },
                                            {
                                                "example_id": "95e071f8-a17f-4c79-a514-d9bdf1844842",
                                                "sense_id": "5297c217-d749-3a4d-b011-58bea3129030",
                                                "text": "Et nous, dès que les pierres commencèrent à rouler en avant de nous, nous nous fourrâmes dans un trou et nous attendîmes la fin de l’orage."
                                            },
                                            {
                                                "example_id": "664bde6c-b413-42ec-b3ef-deef24515f40",
                                                "sense_id": "5297c217-d749-3a4d-b011-58bea3129030",
                                                "text": "Où me suis-je fourré ? Dans quel embarras me suis-je mis ? Dans quel piège suis-je tombé ?"
                                            },
                                            {
                                                "example_id": "782a7987-a3e9-423f-8a93-184bdc5f9bd0",
                                                "sense_id": "5297c217-d749-3a4d-b011-58bea3129030",
                                                "text": "Se fourrer jusqu’au cou dans une mauvaise affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a09ec869-afac-3b0f-b69d-e5285461fcc8",
                                        "entry_id": "1d31fe28-ea2f-35c2-b965-b156a2d3b9a2",
                                        "glosses": [
                                            "S’installer."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7b7e84d-0cb7-4138-9788-522c27ab6d52",
                                                "sense_id": "a09ec869-afac-3b0f-b69d-e5285461fcc8",
                                                "text": "Chercher quelque trou à se fourrer, où se fourrer, chercher quelque emploi, quelque condition, et peiner à en trouver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "396bc415-574b-328c-87b5-1808d9be6309",
                                        "entry_id": "1d31fe28-ea2f-35c2-b965-b156a2d3b9a2",
                                        "glosses": [
                                            "Se tromper."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6df6e84-2db4-4b9d-b889-e4bc754caaf6",
                                                "sense_id": "396bc415-574b-328c-87b5-1808d9be6309",
                                                "text": "L'ingénieur s'est fourré dans ses calculs."
                                            }
