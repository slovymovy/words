                        "cross_references": [
                            {
                                "target_word": "composteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00521012-405c-3a59-8d58-e943e2b4ff7c",
                                        "entry_id": "7a35d98f-7c0e-329d-8563-5b8c4af6bdb2",
                                        "glosses": [
                                            "Instrument sur lequel le compositeur arrange les lettres, pour former des lignes toujours égales, d’après la longueur déterminée."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c24df289-3696-4683-bcac-846609d70494",
                                                "sense_id": "00521012-405c-3a59-8d58-e943e2b4ff7c",
                                                "text": "La distance qui se trouve sur le composteur entre sa tête et la tête de la coulisse inférieure, fixe la longueur de chaque ligne; et c’est ce qu’on nomme la Justification."
                                            },
                                            {
                                                "example_id": "98f4f151-767d-468d-9449-2b3fa7afe4d9",
                                                "sense_id": "00521012-405c-3a59-8d58-e943e2b4ff7c",
                                                "text": "Pritchard quitta son habit, retroussa les manches de sa chemise, et prenant un composteur, il composa l’article de Benoît."
                                            },
                                            {
                                                "example_id": "c5f43237-64d7-4221-b3ab-3b171f5751ee",
                                                "sense_id": "00521012-405c-3a59-8d58-e943e2b4ff7c",
                                                "text": "On place ces caractères dans un composteur, exactement comme se fait la composition typographique ; la dépêche ainsi composée peut être vérifiée et même imprimée sur une bande de papier que l’on peut joindre à l’original; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a348628-cf60-34d8-8b71-6265030c22f5",
                                        "entry_id": "7a35d98f-7c0e-329d-8563-5b8c4af6bdb2",
                                        "glosses": [
                                            "Appareil qui valide, qui composte les billets de train, les tickets de loterie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899557b7-2c35-4597-bb30-f3fece5cbb5f",
                                                "sense_id": "3a348628-cf60-34d8-8b71-6265030c22f5",
                                                "text": "Une étude récente a démontré que les chances de valider son billet de train dès la première introduction dans le composteur sont de 1 sur 200 000 et qu’en moyenne, […]."
                                            },
                                            {
                                                "example_id": "e4cbcbd4-e516-4e9a-aed7-4e580f63b187",
                                                "sense_id": "3a348628-cf60-34d8-8b71-6265030c22f5",
                                                "text": "La SNCB n’utilise pas de composteurs automatiques réservés à la clientèle, cela évite sans doute la confusion contrôlés contrôleurs, pas bêtes les Belges !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b29dba6-858e-3df2-833a-356bb53dbf9d",
                                        "entry_id": "7a35d98f-7c0e-329d-8563-5b8c4af6bdb2",
                                        "glosses": [
                                            "Cuve dans laquelle l’on met les débris végétaux à composter."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cec4e268-043d-463b-8b39-c367780ec2bd",
                                                "sense_id": "6b29dba6-858e-3df2-833a-356bb53dbf9d",
                                                "text": "On verse sur le tas ou dans le composteur tous les déchets végétaux du jardin en évitant le branchage d’un trop gros diamètre."
                                            },
                                            {
                                                "example_id": "b0185be3-c4c5-4f54-b258-1b50cca1365e",
                                                "sense_id": "6b29dba6-858e-3df2-833a-356bb53dbf9d",
                                                "text": "Une bonne circulation de l’air au sein du tas et surtout du bac de compostage est primordiale. En remplissant votre composteur de déchets végétaux, ajoutez régulièrement des branchages sur une dizaine de centimètres."
                                            },
                                            {
                                                "example_id": "3d064f85-aa5b-4dbe-9204-f0b4b81ec4fb",
                                                "sense_id": "6b29dba6-858e-3df2-833a-356bb53dbf9d",
                                                "text": "Depuis plusieurs années déjà, nous livrons gratuitement des lombricomposteurs et installons aussi des composteurs collectifs dans les cours d’immeubles ou à l’échelle de quartiers, là où des Parisiens se montrent intéressés, commence Colombe Brossel, adjointe à la maire, chargée du tri et de la réduction des déchets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
