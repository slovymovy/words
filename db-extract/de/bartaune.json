                "senses": [
                    {
                        "sense_id": "33fecee3-5695-36a4-8760-06e7fee03618",
                        "entry_id": "be6957e4-bc83-3737-b8fd-e2d4081a284f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "998711dc-c27d-4c58-8d43-60d346a4217c",
                                "sense_id": "33fecee3-5695-36a4-8760-06e7fee03618",
                                "text": "„In der Gaststätte ‚Zum Rauchfang‘ in der Nähe des Kasseler Auestadions fragte er den damaligen Wirt Hartmut Bartaune, wo er denn in Kassel Fußball spielen könne.“"
                            },
                            {
                                "example_id": "b7e8ad09-b98e-4dd3-bfcf-f8d8b20236d0",
                                "sense_id": "33fecee3-5695-36a4-8760-06e7fee03618",
                                "text": "„‚Um die Grasnarbe stark zu machen, düngen wir den Rasen zweimal jährlich mit organischem Dünger‘, berichtet Ivonne Bartaune, Sachgebietsleiterin Grünunterhaltung/Forst der Stadt.“"
                            },
                            {
                                "example_id": "b41a0a5b-d64e-48eb-bbed-87a65342b54a",
                                "sense_id": "33fecee3-5695-36a4-8760-06e7fee03618",
                                "text": "„‚Sein jahrzehntelanges, ehrenamtliches Engagement sollte in besonderer Weise gewürdigt werden, denn Hartmut Kost ist ein Mensch, der es mehr als verdient hat.‘, so Markus Bartaune, der ihn für diese Auszeichnung vorgeschlagen hatte.“"
                            },
                            {
                                "example_id": "6df6887d-087b-453c-8bad-7eb2873dc303",
                                "sense_id": "33fecee3-5695-36a4-8760-06e7fee03618",
                                "text": "„Initiator zur Wiederbegründung in den 60er Jahren war der spätere Vorsitzende Horst Bartaune aus Grevenbroich, der heute noch dem Verein angehört.“, so Markus Bartaune, der ihn für diese Auszeichnung vorgeschlagen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
