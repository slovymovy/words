                ],
                "senses": [
                    {
                        "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                        "entry_id": "cb0f3e9d-bfcb-3b7e-88da-1f95c7260f48",
                        "glosses": [
                            "Funktionärin einer Gewerkschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde0357a-5a3e-4a12-926e-51e240928726",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„Statt dessen boten sie dem Unternehmen an, zwei Stunden pro Woche länger ohne Lohnausgleich zu arbeiten, berichtet die Gewerkschaftsfunktionärin Wiebke Ehl.“"
                            },
                            {
                                "example_id": "3baae8e4-2543-410a-bc34-8df26f318df1",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„Nach einem halben Jahr kehrte Loáisiga zurück, arbeitete auf der Plantage und wurde nebenher von der LandarbeiterInnengewerkschaft [sic] ATC zur Gewerkschaftsfunktionärin ausgebildet.“"
                            },
                            {
                                "example_id": "a929c251-b579-4d87-87a1-7bc3ac625d49",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„Emmrich, viele DDR-Jahre SED-Mitglied und Gewerkschaftsfunktionärin, lobte noch vor zwei Jahren in einem Gespräch die Kinderbetreuung der DDR als vorbildlich, die Ganztagsschule mit Hort.“"
                            },
                            {
                                "example_id": "caf58e64-1b9e-48de-a8fa-19a19fc2c667",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„Reinders ist seit Jahren Gewerkschaftsfunktionärin, Krause arbeitete viele Jahre bei den Stadtwerken Güstrow.“"
                            },
                            {
                                "example_id": "5987ed2c-6630-4e66-89dc-4bc877d8f7fb",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„Während des Rundgangs nahm sich die ehemalige Gewerkschaftsfunktionärin und Diplom-Chemikerin immer wieder Zeit für die Beschäftigten und fragte nach den Arbeitsbedingungen.“"
                            },
                            {
                                "example_id": "fcdb2f1f-c7c2-480f-82f9-c77be461eba2",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„‚Eher überwiegt bei der Mehrheit der dringende Wunsch, möglichst schnell Geld zu verdienen, um die Schulden für die Flucht zurückzuzahlen oder die Familien in der Heimat zu unterstützen‘, sagte die ehemalige Gewerkschaftsfunktionärin.“"
                            },
                            {
                                "example_id": "153a2cc4-09f5-4320-8537-bb15a66fcab0",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„Erst Einzelhandelskauffrau, dann Gewerkschaftsfunktionärin, nun Bundestagsabgeordnete und SPD-Landeschefin – wie es denn zu dieser Biografie gekommen sei, wollte Knauer von der temperamentvollen Politikerin wissen.“"
                            },
                            {
                                "example_id": "134bc604-b32f-48d6-a6b3-139a0e906157",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„Als jetzige Sprecherin des Landratsamtes des Ilm-Kreises und Gewerkschaftsfunktionärin im Deutschen Journalistenverband hat sie bis zum vergangenen Jahr als Redakteurin in Lokalzeitungsredaktionen gearbeitet.“"
                            },
                            {
                                "example_id": "3cfafc4e-0f67-4406-b8b4-c7e43785798d",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„Der Fall der von Ausweisung bedrohten Ärztin und ehrenamtlichen Gewerkschaftsfunktionärin Banu Büyükavci hat nun den Stadtrat beschäftigt.“"
                            },
                            {
                                "example_id": "d208591d-dad4-449c-89dc-6dd0c31400a5",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„Unter anderem werden Jan-Willem Waterböhr vom Stadtarchiv, Klaus Rees von den Bielefelder Grünen und die ehemalige Gewerkschaftsfunktionärin und Grünen-Politikerin Annelie Buntenbach in Wortbeiträgen die \"Relevanz von Straßenumbenennungen und den Schwierigkeiten im Umgang mit solchen Relikten einer antidemokratischen Gesinnung\" erörtern.“"
                            },
                            {
                                "example_id": "2326d116-f906-49d5-b706-38106b340475",
                                "sense_id": "91793786-1ea9-318f-b590-adafe7fce1ac",
                                "text": "„Benner begann 1997 ihre Karriere als Gewerkschaftsfunktionärin – in Frankfurt/Main war sie für Jugendarbeit und IT-Unternehmen zuständig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
