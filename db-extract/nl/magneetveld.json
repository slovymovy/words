                                "target_senses": [
                                    {
                                        "sense_id": "e9b1eb27-5243-3048-8124-7d17dbf90254",
                                        "entry_id": "23c34f64-d42c-37ad-8284-ec4a20963449",
                                        "glosses": [
                                            "stan przestrzeni z siłami oddziałującymi na poruszające się ładunki elektryczne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5d9279f-1215-461b-b6b1-c1001acb9d9c",
                                                "sense_id": "e9b1eb27-5243-3048-8124-7d17dbf90254",
