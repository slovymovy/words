                ],
                "senses": [
                    {
                        "sense_id": "cce59a8d-cfac-38c3-a756-d12501273d54",
                        "entry_id": "4393de72-3993-3906-9f9a-56353b375bad",
                        "glosses": [
                            "S’imprégner de culture vaudoue, faire comme les pratiquants de la religion vaudoue."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6e38b1d6-642e-4d5d-8f9e-ef71b5141bee",
                                "sense_id": "cce59a8d-cfac-38c3-a756-d12501273d54",
                                "text": "Ce sont des Américains qui débarquent en Haïti par pleins avions pour vaudouiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f49bc63-6d77-3f2d-9356-9ab8be2187a0",
                        "entry_id": "4393de72-3993-3906-9f9a-56353b375bad",
                        "glosses": [
                            "Adapter à la religion vaudoue."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d81ed52f-0ad1-4775-a2db-1bfa053ccc35",
                                "sense_id": "7f49bc63-6d77-3f2d-9356-9ab8be2187a0",
                                "text": "Le processus syncrétique dans le Vaudou nous avait paru être un passage continuel des valeurs et croyances vaudouesques dans les objets, les symboles, les comportements et les institutions du Christianisme, pour les vaudouiser et leur donner une signification acceptable."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7856e69-0686-3c2f-949b-10c0d4eaab0d",
                        "entry_id": "4393de72-3993-3906-9f9a-56353b375bad",
                        "glosses": [
                            "Envoûter, jeter un sort à quelqu’un à la façon vaudoue."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "77652bb4-37b4-45f5-bbc3-547d8224d8d7",
                                "sense_id": "c7856e69-0686-3c2f-949b-10c0d4eaab0d",
                                "text": "J’étais tellement occupée à te changer les idées et à trouver des formules pour vaudouiser ce salaud de Philippe…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77d7630e-de23-4370-9e48-1f62a0a570e2",
                        "source_entry_id": "4393de72-3993-3906-9f9a-56353b375bad",
                        "target_lang_word": "voodoo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voodoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aa7a4db-94f3-3bdf-8487-e937cdc26474",
                                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                                        "glosses": [
                                            "Any of a group of related religious practices found chiefly in and around the Caribbean, particularly in Haiti and Louisiana."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59b0eccc-7005-4d99-9b13-bd3b7101e0e5",
                                                "sense_id": "3aa7a4db-94f3-3bdf-8487-e937cdc26474",
                                                "text": "You cannot understand Haitian Vodou as it is practised today without first knowing something about the culture from which it sprang, and the ways history has shaped religion, and vice versa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69ba231a-200b-3492-836e-a64c2fcd52e8",
                                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                                        "glosses": [
                                            "The spiritual beliefs of the Ewe/Fon of West Africa, practiced chiefly in Benin and in the south of Togo."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26b47cbc-aa14-35dc-8c70-cd2aecd949d0",
                                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                                        "glosses": [
                                            "Any sort of magical or irrational approach to a problem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdc47e8a-5d2d-46ed-a5df-2723fc9ede2f",
                                                "sense_id": "26b47cbc-aa14-35dc-8c70-cd2aecd949d0",
                                                "text": "I want a real explanation, not this statistical voodoo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61d9d31e-e120-3084-97fa-c70d0fcde5dc",
                                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                                        "glosses": [
                                            "One who practices voodoo; a native sorcerer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fa26685-3ad7-4f4a-a4bc-975dfb0538e0",
                                                "sense_id": "61d9d31e-e120-3084-97fa-c70d0fcde5dc",
                                                "text": "So a reporter of the Boston Herald (U.S.) has 'interviewed' a few local Voodoos. He has seen a dance round a boiling pot, seen some tomfoolery with spiders, and heard a lot of superstitious stories."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voodoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a851d6ee-f061-3554-bc4c-3b46c771edb5",
                                        "entry_id": "f71a051d-3ceb-3faa-84bb-563f268b7e40",
                                        "glosses": [
                                            "To bewitch someone or something using voodoo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bca3023-cb01-4dc5-973d-ff0981f28532",
                                                "sense_id": "a851d6ee-f061-3554-bc4c-3b46c771edb5",
                                                "text": "He claimed his neighbor had voodooed him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
