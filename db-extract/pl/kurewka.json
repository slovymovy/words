                "senses": [
                    {
                        "sense_id": "6b67f9df-7dd3-3365-bea9-d99b9c7ccd33",
                        "entry_id": "1d50faa0-4a86-305c-9827-b504a6680b4c",
                        "glosses": [
                            "od: kurwa"
                        ],
                        "tags": [
                            "diminutive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "9a4c2df6-bbb4-4a0d-8959-0a053eb4b6ff",
                                "sense_id": "6b67f9df-7dd3-3365-bea9-d99b9c7ccd33",
                                "text": "Jak ja bym jego nie zastrzelił, to tu teraz byś nie siedział, ino tam u niego z dziurą w głowie, obok tej kurewki, co żeśmy ją dla przestrachu odstrzelili"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73ec621c-f0e4-4cb3-aa27-f38589950ed4",
                        "source_entry_id": "1d50faa0-4a86-305c-9827-b504a6680b4c",
                        "source_sense_id": "6b67f9df-7dd3-3365-bea9-d99b9c7ccd33",
                        "target_lang_word": "whoreling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whoreling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "beb8d03e-1834-385c-98ec-490aa08abb51",
                                        "entry_id": "6155f56c-ed6b-3e15-aac6-46a229b864ed",
                                        "glosses": [
                                            "A young or diminutive whore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda855ac-6847-4a3d-86f4-fc679ba9ac17",
                                                "sense_id": "beb8d03e-1834-385c-98ec-490aa08abb51",
                                                "text": "“[...] Nafai even went and prayed——” “So I heard, but then, so did Mebbekew, Wetchik's son by that miserable little whoreling Kilvishevex—” “And the Oversoul spoke to Nafai and woke him up, and brought him outside to meet me in the traveler's room."
                                            },
                                            {
                                                "example_id": "ee655495-06ae-462d-8eaf-82af3d605e63",
                                                "sense_id": "beb8d03e-1834-385c-98ec-490aa08abb51",
                                                "text": "The whole, long, thick, meaty shaft of it quivered as if eager to dispel my mouth. Odor assailed me, too – my brother, like so many soldiers, not being overly fastidious in matters of personal hygiene. \"All right, my little whoreling,\" he commanded, [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
