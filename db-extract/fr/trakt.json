                        "entry_id": "35c5eccc-ddc4-35a0-941c-ffa052e1f4cc",
                        "glosses": [
                            "Ancienne route qui reliait Moscou à la Sibérie, principale voie commerciale et de communication avant l’ouverture du Transsibérien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ce3f1b-07b9-406a-a26f-1d8c1ed7f09a",
                                "sense_id": "bd3ae042-f6e7-3afa-8299-8d9158037133",
                                "text": "Les hommes d’affaires sont en avion, ils ont franchi en dix heures la distance Moscou-Irkoutsk, là où Michel Strogoff, pourtant pressé, avait mis soixante-dix-neuf jours à cheval ou en voiture. Ils n’ont vu ni le trakt, ni les fleuves, ni la taïga."
                            }
                        ]
                    }
