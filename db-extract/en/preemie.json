                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a59f4d-e26c-4635-bba0-11aedccee15e",
                                                "sense_id": "9cda2567-db71-30bd-ba1c-205bbf82d041",
                                                "text": "У матери от шока начались преждевременные роды, и появился на свет я ― семимесячный недоносок, который никак, по всем законам, не мог, не должен был выжить."
                                            }
                                        ]
                                    },
