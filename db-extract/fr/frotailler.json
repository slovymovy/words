                ],
                "senses": [
                    {
                        "sense_id": "2f49f889-2af0-3868-8ef8-b889052c82ad",
                        "entry_id": "71e0b8e8-525e-3ed6-95dc-1b74c5d7cda0",
                        "glosses": [
                            "Frotter approximativement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e55f8af-6991-4b03-8b5d-6be1b54467cf",
                                "sense_id": "2f49f889-2af0-3868-8ef8-b889052c82ad",
                                "text": "Seulement là-dessus follement clair et tout zébré de bigarrures jaunes, il ne s’agissait plus de frotailler le chapeau de paille […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "aabaed7e-6fbf-30de-8393-396daf99546e",
                        "entry_id": "71e0b8e8-525e-3ed6-95dc-1b74c5d7cda0",
                        "glosses": [
                            "ou Se frotter sensuellement."
                        ],
                        "tags": [
                            "intransitive",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b0f29747-68ad-41a3-ae5e-98a09861ee92",
                                "sense_id": "aabaed7e-6fbf-30de-8393-396daf99546e",
                                "text": "[…] mais aussi bien je n’avais aucune envie de flirter, de sortir en bandes, d’avoir comme certaines des « copains » ou des chevaliers servants pour frotailler dans les coins : clopiner avec précaution jusqu’au mariage ou la majorité, m’amuser en restant épousable ne m’intéressait pas."
                            }
                        ]
                    }
