                                        "sense_id": "cdc7d1aa-8f1a-3abc-9b82-ada1e91534b5",
                                        "entry_id": "dd5fb2de-df1d-3a48-b9db-85237c05a272",
                                        "glosses": [
                                            "In or via the part of a commercial passenger airplane reserved for those paying the lower standard fares."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d6d14f2-1431-4c60-a16f-b849c80d581e",
                                                "sense_id": "cdc7d1aa-8f1a-3abc-9b82-ada1e91534b5",
                                                "text": "Numerous web sites have tips on how to fly economy."
