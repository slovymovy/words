                        "examples": [
                            {
                                "example_id": "f3169119-4907-40d2-b0c8-3398a46ec9e0",
                                "sense_id": "bd1f89c0-b143-3de7-88ae-86f57cbfc903",
                                "text": "Treibriemen werden anhand ihrer Form unterschieden."
                            },
                            {
                                "example_id": "eac9e7ab-12ec-4938-a0a1-0e3f3068bbd7",
                                "sense_id": "bd1f89c0-b143-3de7-88ae-86f57cbfc903",
                                "text": "Die Legende des Damenstrumpfes, der als Ersatz für einen gerissenen Treibriemen verwendet wird, ist uralt."
                            },
                            {
                                "example_id": "2f279b03-8b76-4af0-a99f-0c039705f03a",
                                "sense_id": "bd1f89c0-b143-3de7-88ae-86f57cbfc903",
                                "text": "„Lederne Treibriemen liefen von einem Dach zum andern, und mitten im Misthaufen arbeitete eine eiserne Pumpe.“"
                            }
                        ],
