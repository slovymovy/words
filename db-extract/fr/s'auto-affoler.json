                "senses": [
                    {
                        "sense_id": "5765c61d-92cb-3f69-85f4-d7a199c18a40",
                        "entry_id": "fefdcdac-49b3-398b-a30a-72bede2beda9",
                        "glosses": [
                            "S’affoler pour des raisons qui ne viennent que de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28820f02-fd8e-4b03-8e1e-580e270e874b",
                                "sense_id": "5765c61d-92cb-3f69-85f4-d7a199c18a40",
                                "text": "Le Mammouth cogite, le Mammouth réfléchit, et à long terme, le Mammouth finit tôt ou tard par s'auto-affoler."
                            },
                            {
                                "example_id": "9e964e81-c2f0-4363-a2bb-544c54b6eac7",
                                "sense_id": "5765c61d-92cb-3f69-85f4-d7a199c18a40",
                                "text": "Je suis trop calme de nature et j'ai besoin de m'\"auto-affoler\" en écrivant 'URGENT' sur toutes mes notes."
                            },
                            {
                                "example_id": "85c6b1f2-220c-46ae-a3b6-0c8c7346981b",
                                "sense_id": "5765c61d-92cb-3f69-85f4-d7a199c18a40",
                                "text": "Mais on ne dit rien ni l'une, ni l'autre pour ne pas s'auto-affoler parce qu'une chose est sûre : on ne fermera pas un œil de la nuit…"
                            }
                        ]
                    }
