                    {
                        "form_id": "c54c9a2a-277f-4995-a804-3de235aab05c",
                        "entry_id": "4fe1f67a-e62b-3ed3-8c32-6e452f9af4cd",
                        "tags": [
                            "accusative",
                            "plural"
