                    },
                    {
                        "sense_id": "2542a1fa-c1ba-372f-8132-ee783ad64b6c",
                        "entry_id": "816fbcf7-72bc-396b-a353-11d2f60b178d",
                        "glosses": [
                            "składający się z trzech elementów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d8cde57-7bf8-4102-b6bb-a06b7d315128",
                                "sense_id": "2542a1fa-c1ba-372f-8132-ee783ad64b6c",
                                "text": "Triadyczna teoria znaku (Ch. Peirce) narodziła się z inspiracji filozoficznych w obrębie pragmatyzmu. Znak jest relacją, która łączy trzy elementy: przedmiot, reprezentamen i interpretant"
                            },
                            {
                                "example_id": "da7703c7-bd9b-474d-bf1c-dda01f3677c9",
                                "sense_id": "2542a1fa-c1ba-372f-8132-ee783ad64b6c",
                                "text": "Wśród przedstawień są posągi Buddy, bodhisattw oraz duże triadyczne stele, gdzie postaci Buddy, stojącemu na tle mandorli, po obu stronach towarzyszą bodhisattwy"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
