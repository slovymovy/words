                        "entry_id": "7f55bb7a-b758-3c85-b06c-462b07cffa1f",
                        "glosses": [
                            "grote groep mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e823c4d-d0b1-41d9-9bb0-a2dc1564b060",
                                "sense_id": "5a2ac8d6-2f30-388a-af2b-5bb279e20f89",
                                "text": "Het komt er in allebei de werelden op neer dat je onder druk jezelf moet zijn. Of je nu een rol speelt, een speech houdt, of teksten zingt, je moet er onder die omstandigheden voor zorgen dat het echt is, dat je het meent. Dat wil niet zeggen dat ik niet zenuwachtig was voor de audities, hoor. Je staat daar toch voor een kordon mensen en je moet leveren wat zij vragen."
                            }
                        ]
