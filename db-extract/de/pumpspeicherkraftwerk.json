                ],
                "senses": [
                    {
                        "sense_id": "22fd4955-2f0c-3769-9c60-4effa6ab329a",
                        "entry_id": "d019a647-dac5-3374-b639-4758d16d364b",
                        "glosses": [
                            "Kraftwerk, das generell nachts mithilfe von Pumpen Wasser in höher gelegene Speicherbecken befördert, um tagsüber bei höherem Strombedarf aus der Bewegung des dann herunterströmenden Wassers Energie zu gewinnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f94f050c-b163-408b-864f-5b13e92db43d",
                                "sense_id": "22fd4955-2f0c-3769-9c60-4effa6ab329a",
                                "text": "„Im südlichen Schwarzwald soll für 1,6 Milliarden Euro ein Pumpspeicherkraftwerk mit zwei Seen gebaut werden.“"
                            },
                            {
                                "example_id": "c5cbb9b8-056d-4b88-8a9c-63eb24127660",
                                "sense_id": "22fd4955-2f0c-3769-9c60-4effa6ab329a",
                                "text": "„Nicht voran geht es beim geplanten Bau des weltweit ersten unterirdischen Pumpspeicherkraftwerkes im Harz.“"
                            },
                            {
                                "example_id": "41cd81b2-c214-4fff-bc00-3a0dd4c6591b",
                                "sense_id": "22fd4955-2f0c-3769-9c60-4effa6ab329a",
                                "text": "„Der Ausbau erneuerbarer Energien erfordert zum Ausgleich von Lastspitzen moderne Pumpspeicherkraftwerke.“"
                            },
                            {
                                "example_id": "fdbd0371-9cf2-4287-ba37-8a085cc26b0d",
                                "sense_id": "22fd4955-2f0c-3769-9c60-4effa6ab329a",
                                "text": "„Doch es geht auch anders: Und zwar mit auf den Grund der Meere abgesenkten Pumpspeicherkraftwerken, bei denen das Meer selbst als oberes Speicherreservoir dient, während ein abgetauchter Hohlkörper die Rolle des Unterbeckens übernimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
