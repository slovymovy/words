                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c635e275-f521-433f-a87b-e206cf00d881",
                                "sense_id": "bc722014-9fe6-3bc2-9127-acdbae559f51",
                                "text": "„Das war ein Opa mit Schiebermütze, der beim Laufen immer seine Trainingshose hochzog, wobei ich einmal seinen blanken Arsch sehen konnte.“"
                            },
                            {
                                "example_id": "4d76ca92-5970-49f7-9130-c8f185c5436e",
                                "sense_id": "bc722014-9fe6-3bc2-9127-acdbae559f51",
                                "text": "„Bobby zog sich die Schiebermütze und ein verschlissenes Baumwollhemd des alten Mannes an, das so groß war, dass seine Hände kaum bis zu den Ellenbogen reichten.“"
                            },
                            {
                                "example_id": "79a61b96-e46e-46bf-b2da-a154908fe71c",
                                "sense_id": "bc722014-9fe6-3bc2-9127-acdbae559f51",
                                "text": "„Kurt sah sich um. Männer mit einfachen Joppen und Schiebermützen neben Herren mit gestärktem Kragen und Melone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
