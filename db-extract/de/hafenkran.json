                        "glosses": [
                            "Kran, der in einem Hafen aufgestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76f5d6af-5890-4fe8-b500-4388ef5fc180",
                                "sense_id": "de3996b2-cd14-3f9e-82c3-4d0ac0d95ddd",
                                "text": "„Hier blinken die gelben Warnlichter der Hafenkräne schon seit über 40 Jahren rund um die Uhr.“"
                            },
                            {
                                "example_id": "f790b496-efbc-4a92-8f41-fad3ae2d7328",
                                "sense_id": "de3996b2-cd14-3f9e-82c3-4d0ac0d95ddd",
                                "text": "„Die schwarzen Gestänge der Hafenkräne sind mit ihrer unteren Hälfte in Nebelwatte gepackt wie zierliches Spielzeug, das vor Bruch geschützt werden soll.“"
                            }
                        ],
