                    {
                        "sense_id": "23a14790-5114-3f29-9988-c598155f457a",
                        "entry_id": "488d5a8e-bd4d-3bab-a5b0-ecccb2a6fac3",
                        "glosses": [
                            "ozdobny dywan, gobelin z motywem figuratywnym zawieszany na ścianie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fb9b7c3-90bf-480f-bbff-4fcbfa23effb",
                                "sense_id": "23a14790-5114-3f29-9988-c598155f457a",
                                "text": "Arrasy wawelskie nazywane też bywają arrasami Jagiellońskimi lub arrasami Zygmuntowskimi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00e20fb7-31bc-45d3-8814-042fc4e37e9b",
                        "source_entry_id": "488d5a8e-bd4d-3bab-a5b0-ecccb2a6fac3",
                        "source_sense_id": "23a14790-5114-3f29-9988-c598155f457a",
                        "target_lang_word": "arras",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arras",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a040754e-4189-3c31-bd64-9025d78537ff",
                                        "entry_id": "bea64677-4775-3e52-b518-8a94b14794ee",
                                        "glosses": [
                                            "A tapestry or wall hanging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b35eb514-e362-48c4-b1fe-71d766af0520",
                                                "sense_id": "a040754e-4189-3c31-bd64-9025d78537ff",
                                                "text": "At such a time I'll loose my daughter to him: / Be you and I behind an arras then"
                                            },
                                            {
                                                "example_id": "e0b074b6-0d80-4e01-877a-97b2d4202b51",
                                                "sense_id": "a040754e-4189-3c31-bd64-9025d78537ff",
                                                "text": "And with their conſorts chaſte at night they ſleep / On ſtatelieſt couches with rich arras ſpread."
                                            },
                                            {
                                                "example_id": "fa5ca12e-4ddf-4071-8ec4-183d02e20b1b",
                                                "sense_id": "a040754e-4189-3c31-bd64-9025d78537ff",
                                                "text": "The room was hung with coarſe arras, which concealed the cloſet; […]"
                                            },
                                            {
                                                "example_id": "6edf7cc0-d426-43bf-8437-c4ab201f059a",
                                                "sense_id": "a040754e-4189-3c31-bd64-9025d78537ff",
                                                "text": "Dozens of walls were covered with arrases like acts of homage, recognition, or flattery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
