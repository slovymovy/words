                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4d84419-d78d-4897-b333-a0be2cb91079",
                                "sense_id": "f915e35d-1dd3-3478-bc0c-736e3a1201a5",
                                "text": "„Jeder archäologische Fund – und das sind in den seltensten Fällen wirkliche Kunstwerke – ist ein kleines Dokument, das dem Altertumswissenschaftler hilft, einen Teil der Menschheitsgeschichte zu erhellen.“"
                            },
                            {
                                "example_id": "6f86da72-26c1-4a12-9645-9c1e8cd74934",
                                "sense_id": "f915e35d-1dd3-3478-bc0c-736e3a1201a5",
                                "text": "„Regelmäßig fördern Altertumswissenschaftler neue Funde zu Tage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
