                                "target_senses": [
                                    {
                                        "sense_id": "6eee3f9d-aa9b-3606-92b2-b3088938f1c3",
                                        "entry_id": "8382a35c-9871-3cb3-8efd-cdcfce78e6fb",
                                        "glosses": [
                                            "vysoký člověk"
                                        ],
                                        "tags": [
