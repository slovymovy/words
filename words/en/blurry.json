{
    "word_family": [
        "blur",
        "blurriness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ab45fd82-f9b9-3551-9b30-e253d29a71a2",
                    "sense_definition": "Not clear, crisp, or focused; having indistinct or fuzzy edges.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without my glasses, the text on the screen is completely <w>blurry</w>.",
                            "target_lang_translations": {
                                "zh": "不戴眼镜的话，屏幕上的文字完全是<w>模糊</w>的。"
                            }
                        },
                        {
                            "text": "He took a <w>blurry</w> photograph of the running dog because the camera moved.",
                            "target_lang_translations": {
                                "zh": "由于相机晃动，他拍下了一张奔跑中的狗的<w>模糊</w>照片。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blurred",
                        "fuzzy",
                        "unfocused"
                    ],
                    "antonyms": [
                        "clear",
                        "sharp",
                        "focused"
                    ],
                    "common_phrases": [
                        "blurry vision",
                        "blurry photo",
                        "blurry image"
                    ],
                    "target_lang_definitions": {
                        "zh": "不清晰的，轮廓不分明的，模糊不清的（指视觉、照片等）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "指视觉、图像等看不清"
                            },
                            {
                                "target_lang_word": "模糊不清",
                                "target_lang_sense_clarification": "形容画面或景象很不清晰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cf3243e-758b-37a0-88cd-49f66f841c5d",
                    "sense_definition": "Difficult to distinguish, define, or understand clearly; lacking well-defined boundaries.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distinction between work and private life has become increasingly <w>blurry</w>.",
                            "target_lang_translations": {
                                "zh": "工作与个人生活之间的界限变得越来越<w>模糊</w>。"
                            }
                        },
                        {
                            "text": "My memory of what happened that night is still quite <w>blurry</w>.",
                            "target_lang_translations": {
                                "zh": "我对那天晚上发生的事情的记忆依然非常<w>模糊</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vague",
                        "indistinct",
                        "unclear"
                    ],
                    "antonyms": [
                        "distinct",
                        "well-defined"
                    ],
                    "common_phrases": [
                        "blurry line",
                        "blurry distinction",
                        "blurry boundary"
                    ],
                    "target_lang_definitions": {
                        "zh": "难以辨别或界定的；界限不明晰的，记忆或概念模糊的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "指界限、记忆等不明确"
                            },
                            {
                                "target_lang_word": "不明确",
                                "target_lang_sense_clarification": "指分界或区分不清晰"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}