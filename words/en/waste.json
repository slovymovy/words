{
    "word_family": [
        "wastage",
        "wasteful",
        "wasteland",
        "waster",
        "wastrel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33f43750-fdd3-3abd-867b-b211fda6f374",
                    "sense_definition": "The act of using something in a way that is not effective or necessary; extravagant consumption.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inefficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Buying that expensive gadget you never use was a complete <w>waste</w> of money.",
                            "target_lang_translations": {
                                "ru": "Покупка того дорогого гаджета, которым ты никогда не пользуешься, была полной <w>тратой</w> денег."
                            }
                        },
                        {
                            "text": "It is a <w>waste</w> of time to wait for a bus that is not coming.",
                            "target_lang_translations": {
                                "ru": "Ждать автобус, который не придет — это пустая <w>трата</w> времени."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waste of time",
                        "waste of money",
                        "waste of energy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт использования чего-либо неэффективным или ненужным образом; чрезмерное потребление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустая трата",
                                "target_lang_sense_clarification": "времени, денег или усилий"
                            },
                            {
                                "target_lang_word": "растрата",
                                "target_lang_sense_clarification": "неэффективное использование ресурсов"
                            },
                            {
                                "target_lang_word": "бесполезная трата",
                                "target_lang_sense_clarification": "чего-либо ценного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf81aaf5-7dd3-3e6d-b2d7-fc90385b3e40",
                    "sense_definition": "Useless materials, substances, or parts that are left over after something has been made or used.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "refuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory must find a safer way to dispose of its chemical <w>waste</w>.",
                            "target_lang_translations": {
                                "ru": "Завод должен найти более безопасный способ утилизации своих химических <w>отходов</w>."
                            }
                        },
                        {
                            "text": "We should all try to reduce the amount of household <w>waste</w> we produce.",
                            "target_lang_translations": {
                                "ru": "Мы все должны стараться сократить количество бытовых <w>отходов</w>, которые мы производим."
                            }
                        }
                    ],
                    "synonyms": [
                        "cack"
                    ],
                    "common_phrases": [
                        "hazardous waste",
                        "industrial waste",
                        "household waste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесполезные материалы, вещества или части, которые остаются после того, как что-то было сделано или использовано."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отходы",
                                "target_lang_sense_clarification": "промышленные или бытовые остатки"
                            },
                            {
                                "target_lang_word": "отбросы",
                                "target_lang_sense_clarification": "негодные остатки, мусор"
                            },
                            {
                                "target_lang_word": "утиль",
                                "target_lang_sense_clarification": "вторичное сырье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6adfda45-4a7c-3c59-a598-a0af085f467e",
                    "sense_definition": "A large area of land that is empty, uninhabited, or has been destroyed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers struggled to survive while crossing the frozen <w>wastes</w> of the Arctic.",
                            "target_lang_translations": {
                                "ru": "Исследователи изо всех сил пытались выжить, пересекая ледяные <w>пустоши</w> Арктики."
                            }
                        },
                        {
                            "text": "After the fire, the once beautiful forest became a desolate <w>waste</w>.",
                            "target_lang_translations": {
                                "ru": "После пожара некогда прекрасный лес превратился в безлюдную <w>пустошь</w>."
