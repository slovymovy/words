                                "target_senses": [
                                    {
                                        "sense_id": "29e090be-42cc-3589-a5d9-d1ab29118a35",
                                        "entry_id": "858fa448-34cd-3313-9c25-ee0372336760",
                                        "glosses": [
                                            "An addiction to ether intoxication."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf583b5b-fa3f-4350-b37f-f871d23c0525",
                                                "sense_id": "29e090be-42cc-3589-a5d9-d1ab29118a35",
                                                "text": "It accounts for the etheromania in certain countries in Ireland over a hundred years ago, the large-scale sniffing of shoemakers’ glue in the prison in Monterrey, Mexico, and for many other epidemics of intoxicant abuse by a large portion of the exposed population."
                                            },
                                            {
                                                "example_id": "edee602f-fc12-4e7c-99b7-55d01147cd12",
                                                "sense_id": "29e090be-42cc-3589-a5d9-d1ab29118a35",
                                                "text": "It is not considered as becoming in the female sex to consume large quantities of concentrated alcohol habitually, and for this reason women contribute a large contingent to etheromania."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
