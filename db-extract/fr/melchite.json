                                "target_senses": [
                                    {
                                        "sense_id": "9a4939e0-95a5-381c-9795-249924f29621",
                                        "entry_id": "29573979-0ca1-372d-bac3-12745ac4c955",
                                        "glosses": [
                                            "In 5th-century Syria and Egypt, a sobriquet applied to Chalcedonians by their opponents, denoting the Chalcedonians' fidelity to the Byzantine emperor."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc3763e9-1e1b-4b22-8d9d-2da81cbc195e",
                                                "sense_id": "9a4939e0-95a5-381c-9795-249924f29621",
                                                "text": "[...] increasingly a majority in the Egyptian Church as well as other strongholds of Miaphysitism denounced Chalcedonian Christians as ‘Dyophysites’ and sneered at them as ‘the emperor's people’ – Melchites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32163532-c4c5-33e4-86ff-fa862dac629e",
                                        "entry_id": "29573979-0ca1-372d-bac3-12745ac4c955",
                                        "glosses": [
                                            "A member of the Greek Orthodox Patriarchate of Alexandria, the Greek Orthodox Patriarchate of Antioch or the Greek Orthodox Patriarchate of Jerusalem; ellipsis of Orthodox Melkite."
                                        ],
                                        "tags": [
                                            "since the Great Schism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97c9c687-aa85-3df9-b402-faad82d8459c",
                                        "entry_id": "29573979-0ca1-372d-bac3-12745ac4c955",
                                        "glosses": [
                                            "A member of the Melkite Greek Catholic Church; ellipsis of Catholic Melkite."
                                        ],
                                        "tags": [
                                            "since 1724"
                                        ],
                                        "examples": []
                                    }
