                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27fe74b9-1723-45d8-a641-286e0cd30185",
                                "sense_id": "f1929184-9640-3871-b672-0ac46196587e",
                                "text": "В канон «Звёздного пути» входят «все события сериалов и фильмов». Соответственно, неканонично всё остальное: сопутствующие романы, комиксы, игры и мультфильмы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d88714fe-c0ed-4576-b2ad-d9816a91eab5",
                        "source_entry_id": "d9a320c9-b565-346b-9c4b-c7fb8c79e1ec",
                        "source_sense_description": "правило, традиционная, обязательная норма",
                        "target_lang_word": "canon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13a46e23-9279-3fac-91e8-0950e38779a5",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A generally accepted principle; a rule."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccc58dd6-2d8b-42a0-8170-ec949e0f01af",
                                                "sense_id": "13a46e23-9279-3fac-91e8-0950e38779a5",
                                                "text": "The trial must proceed according to the canons of law."
                                            },
                                            {
                                                "example_id": "e7bc6773-1e18-4034-9821-764c9b97047a",
                                                "sense_id": "13a46e23-9279-3fac-91e8-0950e38779a5",
                                                "text": "Or that the Everlasting had not fixed His canon 'gainst self-slaughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdad7c62-4e86-3591-be1b-65eed8035d89",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A generally accepted principle; a rule.",
                                            "A formally codified set of criteria deemed mandatory for a particular artistic style of figurative art."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e27188b-1adb-4d37-954a-c2d37faca8f5",
                                                "sense_id": "cdad7c62-4e86-3591-be1b-65eed8035d89",
                                                "text": "the Canon of Polykleitos"
                                            },
                                            {
                                                "example_id": "8c93c7ed-8f78-494b-a697-4c4e8cf1c0fc",
                                                "sense_id": "cdad7c62-4e86-3591-be1b-65eed8035d89",
                                                "text": "Despite the many advances made by modern scholars towards a clearer comprehension of the theoretical basis of the Canon of Polykleitos, the results of these studies show an absence of any general agreement upon the practical application of that canon in works of art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a6ba14-e287-3ae8-9453-1ea8492c01a2",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A group of literary works that are generally accepted as representing a field."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51dd692c-b353-4b90-8a74-4ffcdbefeb48",
                                                "sense_id": "60a6ba14-e287-3ae8-9453-1ea8492c01a2",
                                                "text": "Russo had been working as a salesman, selling Great Books of the Western World, hawking the canon to the rubes."
                                            },
                                            {
                                                "example_id": "618de230-61b3-4048-8dda-60d4081edac9",
                                                "sense_id": "60a6ba14-e287-3ae8-9453-1ea8492c01a2",
                                                "text": "the durable canon of American short fiction"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91be24a8-5f19-34e5-9b6f-541ce9fa7914",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "The works of a writer that have been accepted as authentic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a723dae8-681b-493a-a358-7e959525cf6d",
                                                "sense_id": "91be24a8-5f19-34e5-9b6f-541ce9fa7914",
                                                "text": "the entire Shakespearean canon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08bdc04f-d943-3c62-a636-dcf43c55d0fb",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A eucharistic prayer, particularly the Roman Canon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ee0b220-3482-3ef7-92a6-dbfb681dd236",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A religious law or body of law decreed by the church."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8e8f742-a52a-4191-b242-b00331a90101",
                                                "sense_id": "6ee0b220-3482-3ef7-92a6-dbfb681dd236",
                                                "text": "We must proceed according to canon law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b063e65-3496-329d-a3ac-c597128309db",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A catalogue of saints acknowledged and canonized in the Roman Catholic Church."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "462dd711-0717-3d5f-b40b-407d7cdee3fd",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "In monasteries, a book containing the rules of a religious order."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d586b45-8fe6-3e9c-b9e0-907fb9b02239",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A piece of music in which the same melody is played by different voices, but beginning at different times; a round."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33c3ad70-75e8-4264-8473-d9a94350f068",
                                                "sense_id": "9d586b45-8fe6-3e9c-b9e0-907fb9b02239",
                                                "text": "Pachelbel’s Canon has become very popular."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb5bf83-aa55-34ee-9212-425ac7f8d413",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A rent or stipend payable at some regular time, generally annual, e.g., canon frumentarius"
                                        ],
                                        "tags": [
                                            "Roman",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddeb559e-e2b3-4d6c-aa0a-01133193f5e5",
                                                "sense_id": "7bb5bf83-aa55-34ee-9212-425ac7f8d413",
                                                "text": "The lessees of public lands had to pay a perpetual rent or \"canon\" at some periodical time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "652ae90f-d623-34f8-a373-bcef67cd933b",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "Those sources, especially including literary works, which are considered part of the main continuity regarding a given fictional universe; (metonymic) these sources' content."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
