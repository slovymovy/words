                    {
                        "sense_id": "cb500b04-7128-3aad-b76f-0ee91cb5438c",
                        "entry_id": "74df9b93-f289-33bb-9945-9d2a98521cf3",
                        "glosses": [
                            "Phénomène créé par les conditions expérimentales, un effet indésirable ou parasite.",
                            "Aberration, altération dans des données produite par les limitations d’un procédé technique utilisé (pour l’acquisition, l’enregistrement, etc).",
                            "Élément indésirable ou défectueux (effet de blocs, bruit vidéo, etc.) et indépendant des réglages."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ae36d2a3-ff32-3780-a9dc-13d818695b76",
                        "entry_id": "74df9b93-f289-33bb-9945-9d2a98521cf3",
                        "glosses": [
                            "Phénomène créé par les conditions expérimentales, un effet indésirable ou parasite.",
                            "Fait psychique artificiel, produit par les techniques employées dans l’exploration de l’inconscient."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cd1f4b2c-0beb-3a1a-bb3f-8a1ed9ae8ecc",
                        "entry_id": "74df9b93-f289-33bb-9945-9d2a98521cf3",
                        "glosses": [
                            "Produit ayant subi une transformation, même minime, par l’être humain et qui se distingue ainsi d’un autre provoqué par un phénomène naturel."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9c9e965e-d16e-3cfa-adba-e6061cd1da97",
                        "entry_id": "74df9b93-f289-33bb-9945-9d2a98521cf3",
                        "glosses": [
                            "Produit ayant subi une transformation, même minime, par l’être humain et qui se distingue ainsi d’un autre provoqué par un phénomène naturel.",
                            "Objet fabriqué par l’être humain découvert lors de fouilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e5158c-3b37-4181-bd3f-3f32061c84a0",
                                "sense_id": "9c9e965e-d16e-3cfa-adba-e6061cd1da97",
                                "text": "Aujourd'hui, le poste de Goulding, devenu musée, déborde de souvenirs de cinémas et d’artefacts historiques."
                            },
                            {
                                "example_id": "b7bcea6c-2277-44e2-862d-d1f414883188",
                                "sense_id": "9c9e965e-d16e-3cfa-adba-e6061cd1da97",
                                "text": "Les investigations menées ont permis de découvrir et de saisir une quantité impressionnante d’ artéfacts archéologiques, témoins inestimables de l’histoire de notre canton. Parmi ces objets, on trouve notamment des objets de parure ainsi que divers outils datant de l’âge du Bronze (vers 2000 av. J.-C.) à aujourd’hui, plusieurs pièces de monnaie celtiques, romaines, médiévales, modernes et contemporaines de même que d’autres éléments qui, en raison de leur valeur historique, appartiennent au patrimoine commun et non à des intérêts privés."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b11dcfe-34cf-3086-9bdc-5d2f11d95392",
                        "entry_id": "74df9b93-f289-33bb-9945-9d2a98521cf3",
                        "glosses": [
                            "Produit ayant subi une transformation, même minime, par l’être humain et qui se distingue ainsi d’un autre provoqué par un phénomène naturel.",
                            "Relique, objet magique, unique et très puissant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01567c8f-beff-45a8-963d-0393818c036f",
                        "source_entry_id": "74df9b93-f289-33bb-9945-9d2a98521cf3",
                        "target_lang_word": "Artefakt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Artefakt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30ac8516-33c4-3cec-a6ee-eab276a5d332",
                                        "entry_id": "58b2f591-60cc-3363-9025-0bfb74c88b0e",
                                        "glosses": [
                                            "ein durch menschliche oder technische Einwirkung entstandenes Produkt oder Phänomen, in Abgrenzung zum unbeeinflussten oder natürlichen Phänomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed4ef39-97b1-461a-9223-1e70e3c141b4",
                                                "sense_id": "30ac8516-33c4-3cec-a6ee-eab276a5d332",
                                                "text": "Der sogenannte Naturschutz schützt meistens ein Artefakt, nämlich die vom Menschen geschaffene Kulturlandschaft."
                                            },
                                            {
                                                "example_id": "977b0887-e634-4f9c-823a-b620cd7ebf3e",
                                                "sense_id": "30ac8516-33c4-3cec-a6ee-eab276a5d332",
                                                "text": "„Die beschrifteten Artefakte Alteuropas sind mehrheitlich solche, die nicht für den alltäglichen Gebrauch bestimmt sind.“"
                                            },
                                            {
                                                "example_id": "30823ab3-e168-40e3-888b-cdf7011ff1e5",
                                                "sense_id": "30ac8516-33c4-3cec-a6ee-eab276a5d332",
                                                "text": "„Darwins Lehre von der natürlichen Zuchtwahl konnte sich mit Artefakten nicht befassen, weil diese per definitionem unnatürlich sind, ergo konnte sie auch die Mutter aller Artefakte nicht einbeziehen: das Wort.“"
                                            },
                                            {
                                                "example_id": "6a4b9c37-78c7-4058-890f-b53083ae8804",
                                                "sense_id": "30ac8516-33c4-3cec-a6ee-eab276a5d332",
                                                "text": "„Psychologen argumentierten anschließend, dass solche gedanklichen Artefakte bei Menschen, die sich in extrem dramatischen Ausnahmesituationen befänden, nicht außergewöhnlich seien.“"
                                            },
                                            {
                                                "example_id": "7e679bf2-9f55-4236-a80a-b8513bc0ca7d",
                                                "sense_id": "30ac8516-33c4-3cec-a6ee-eab276a5d332",
                                                "text": "„Doch nichts davon konnte das so offensichtlich hohe Alter vieler Artefakte in Amerika erklären.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b025b5dd-a76d-3d7e-a75e-49f3b4df2e6c",
                                        "entry_id": "58b2f591-60cc-3363-9025-0bfb74c88b0e",
                                        "glosses": [
                                            "eine Besonderheit in einem Präparat, die ursächlich auf die Präparationsmethode zurückzuführen ist und damit wissenschaftlich keinen allzu hohen Wert besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf89a6d-274c-4b20-846f-b84a3bea56b4",
                                                "sense_id": "b025b5dd-a76d-3d7e-a75e-49f3b4df2e6c",
                                                "text": "Die „Entdeckung“ der Mesosomen und ihre spätere Entlarvung als Artefakt wurde auch in der Wissenschaftsphilosophie diskutiert"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a60cf20-3909-4f25-be3b-07f3a617b6e2",
                        "source_entry_id": "74df9b93-f289-33bb-9945-9d2a98521cf3",
                        "target_lang_word": "artefact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artefact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "513ff988-ed02-351e-b2b1-a97a1580c113",
                                        "entry_id": "b7567f47-055a-3690-87da-28799bf06d6a",
                                        "glosses": [
                                            "British standard spelling of artifact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc549849-fc2d-4c70-994c-2b35e7ba6876",
                                                "sense_id": "513ff988-ed02-351e-b2b1-a97a1580c113",
                                                "text": "Palaeolithic implements have been recovered from 1953 in the Ordos and in Shansi. The most important site is Tingtsun in Hsiangfen county of the latter province. Here were found an abundant fossil fauna, three hominid teeth and over two thousand artefacts of a type more advanced than those of Pithecanthropus pekinensis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc4b6e18-a73b-44f2-b9ef-151bf5ae96cd",
                        "source_entry_id": "74df9b93-f289-33bb-9945-9d2a98521cf3",
                        "target_lang_word": "artifact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artifact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f46edd8-231c-3500-9b2c-f99e843446ae",
                                        "entry_id": "68b959b9-9b77-38c9-806b-9824b8a55620",
                                        "glosses": [
                                            "An object made or shaped by human hand or labor."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32da5b3b-fd58-483e-9d3f-17c34274c3c9",
                                                "sense_id": "6f46edd8-231c-3500-9b2c-f99e843446ae",
                                                "text": "Given increasing investment in an IT (information technology) artifact (i.e., online service website), it is becoming important to retain existing customers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3586ef1e-002d-3f47-b240-56aa5025f2ca",
                                        "entry_id": "68b959b9-9b77-38c9-806b-9824b8a55620",
                                        "glosses": [
                                            "An object made or shaped by some agent or intelligence, not necessarily of direct human origin."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "332f6ca4-2275-30df-bd58-946970dd4a3d",
                                        "entry_id": "68b959b9-9b77-38c9-806b-9824b8a55620",
                                        "glosses": [
                                            "Something viewed as a product of human agency or conception rather than an inherent element."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ea78f7b-f7dc-46e9-b0fb-b858376ec254",
                                                "sense_id": "332f6ca4-2275-30df-bd58-946970dd4a3d",
                                                "text": "The very act of looking at a naked model was an artifact of male supremacy."
                                            },
                                            {
                                                "example_id": "35740d74-d7c8-4ee1-8152-132037e82ca8",
                                                "sense_id": "332f6ca4-2275-30df-bd58-946970dd4a3d",
                                                "text": "Overall the signage at NIE has the appearance being a top-down artefact driven by institutional policy with English set as the default language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f56a05f-5c0f-3913-9a40-b50de82c4eba",
                                        "entry_id": "68b959b9-9b77-38c9-806b-9824b8a55620",
                                        "glosses": [
                                            "A finding or structure in an experiment or investigation that is not a true feature of the object under observation, but is a result of external action, the test arrangement, or an experimental error."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d455aff4-6052-41d1-a77c-b0062948b746",
                                                "sense_id": "1f56a05f-5c0f-3913-9a40-b50de82c4eba",
                                                "text": "The spot on his lung turned out to be an artifact of the X-ray process."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7f2d189-7869-3fb7-81e8-523aa90da6bb",
                                        "entry_id": "68b959b9-9b77-38c9-806b-9824b8a55620",
                                        "glosses": [
                                            "An object, such as a tool, ornament, or weapon of archaeological or historical interest, especially such an object found at an archaeological excavation."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4db01ee0-81a0-40c5-b0f7-e5fbfe454561",
                                                "sense_id": "c7f2d189-7869-3fb7-81e8-523aa90da6bb",
                                                "text": "The dig produced many Roman artifacts."
                                            },
                                            {
                                                "example_id": "13c6d20c-1aa7-46c8-a906-9ad257cdb767",
                                                "sense_id": "c7f2d189-7869-3fb7-81e8-523aa90da6bb",
                                                "text": "Holy shit! It is fascinating when a country’s culture seeps even into their math lessons, although it’s not really surprising. As a British child, our math questions were “if Johnny has two artifacts and Dinesh has two artifacts, then how many artifacts is Johnny about to have?” The answer, of course, “all the artifacts, Dinesh’s family can come visit them in a British museum whenever they’re in town.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b03bf2f6-49e2-3b08-a6bf-acc54d1dbe1a",
                                        "entry_id": "68b959b9-9b77-38c9-806b-9824b8a55620",
                                        "glosses": [
                                            "An appearance or structure in protoplasm due to death, the method of preparation of specimens, or the use of reagents, and not present during life."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff28653c-3a9c-3fc6-a8c2-492a2134811a",
                                        "entry_id": "68b959b9-9b77-38c9-806b-9824b8a55620",
                                        "glosses": [
                                            "A perceptible distortion that appears in an audio or video file or an image as a result of applying a lossy compression or other inexact processing algorithm or of physical interference in an acquisition process."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe31e0bf-35d3-41c4-9a06-0786e33cbd6f",
                                                "sense_id": "ff28653c-3a9c-3fc6-a8c2-492a2134811a",
                                                "text": "This JPEG image has been so highly compressed that it has unsightly artifacts, making it unsuitable for the cover of our magazine."
                                            },
                                            {
                                                "example_id": "1ba9369b-f053-4888-bb6c-e70d740fa165",
                                                "sense_id": "ff28653c-3a9c-3fc6-a8c2-492a2134811a",
                                                "text": "The opacity in his chest radiograph turned out to be an artifact due to the film."
                                            },
                                            {
                                                "example_id": "151f3223-5477-4709-9b3f-bb9b776bae3c",
                                                "sense_id": "ff28653c-3a9c-3fc6-a8c2-492a2134811a",
