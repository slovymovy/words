                                        "glosses": [
                                            "Of or relating to Boris Yeltsin (Russian: Бори́с Е́льцин; 1931–2007), Russian politician and the first President of the Russian Federation, serving from 1991 to 1999."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
