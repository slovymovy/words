                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54529f66-b2a3-462c-be14-710a5f6a7b1a",
                                "sense_id": "8efb008f-83de-3f19-b268-c9c70485d7cc",
                                "text": "Nach langen Verhandlungen einigten sich die Verhandlungsteilnehmer auf eine Fristverlängerung für die Kreditrückzahlung."
                            },
                            {
                                "example_id": "6a18df0e-70c4-404d-9983-a1ab62247eee",
                                "sense_id": "8efb008f-83de-3f19-b268-c9c70485d7cc",
                                "text": "„Auch die Nachrichtenagentur Reuters berichtete unter Berufung auf einen Vertreter der Staatengemeinschaft, dass über eine Fristverlängerung bis nächstes Jahr nachgedacht werde.“"
                            }
                        ],
