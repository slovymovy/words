    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "179c8ecd-da89-393d-9aa6-f12b1c2c9205",
                    "sense_definition": "The part of a process or system that is too slow or cumbersome, causing delays in the overall progress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lack of staff in the shipping department has become a major <w>bottleneck</w> for our online sales."
                        },
                        {
                            "text": "We need to identify the <w>bottleneck</w> in the production line to improve our efficiency this quarter."
                        }
                    ],
                    "synonyms": [
                        "blockage",
                        "holdup",
                        "snag"
                    ],
                    "common_phrases": [
                        "production bottleneck",
                        "major bottleneck",
                        "identify the bottleneck"
                    ]
                },
                {
                    "sense_id": "f120d9f5-1518-3923-8dd0-667d6e85d16a",
                    "sense_definition": "A narrowing of a road or path that causes traffic to slow down or stop.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction work on the bridge created a notorious <w>bottleneck</w> that delayed commuters for hours."
                        },
                        {
                            "text": "Drivers are advised to avoid the city center due to a traffic <w>bottleneck</w> caused by an accident."
                        }
                    ],
                    "synonyms": [
                        "congestion",
                        "jam",
                        "narrowing"
                    ],
                    "common_phrases": [
                        "traffic bottleneck",
                        "notorious bottleneck",
                        "road bottleneck"
                    ]
                },
                {
                    "sense_id": "45e397c0-10c1-3375-b534-6be4816ecb09",
                    "sense_definition": "The narrow top part of a bottle, just below the opening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "container_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gripped the <w>bottleneck</w> firmly before trying to pull out the stubborn cork."
                        },
                        {
                            "text": "The label was wrapped neatly around the <w>bottleneck</w> of the expensive wine."
                        }
                    ],
                    "synonyms": [
                        "neck"
                    ],
                    "common_phrases": [
                        "glass bottleneck"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8189304-c543-37bd-9666-2becbe71b67c",
                    "sense_definition": "To slow down or impede progress by creating a point of congestion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slowing_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden lane closure <w>bottlenecked</w> the traffic for several miles during rush hour."
                        },
                        {
                            "text": "Inefficient software can <w>bottleneck</w> the entire computer system regardless of how fast the processor is."
                        }
                    ],
                    "synonyms": [
                        "obstruct",
                        "hinder",
                        "clog"
                    ],
                    "antonyms": [
                        "expedite",
                        "facilitate"
                    ],
                    "common_phrases": [
                        "bottleneck the traffic",
                        "bottleneck the process"
                    ]
                },
                {
                    "sense_id": "d66de4d4-8352-3f9a-b3a4-7f48ae807e4d",
                    "sense_definition": "To become narrow or congested, resulting in a delay.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slowing_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The highway <w>bottlenecks</w> at the merge point, causing daily delays for local residents."
                        },
                        {
                            "text": "Workflows often <w>bottleneck</w> at the final approval stage if only one manager is available."
                        }
                    ],
                    "synonyms": [
                        "narrow",
                        "constrict"
                    ],
                    "antonyms": [
                        "widen"
                    ],
                    "common_phrases": [
                        "bottleneck at the merge"
                    ]
                }
            ]
        }
    ]
