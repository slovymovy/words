                    "target_lang_definitions": {
                        "nl": "Snel op en neer bewegen of schokkerige bewegingen maken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wippen",
                                "target_lang_sense_clarification": "snel op en neer bewegen"
                            },
                            {
                                "target_lang_word": "wiebelen",
                                "target_lang_sense_clarification": "onrustig bewegen"
                            },
                            {
                                "target_lang_word": "schokken",
                                "target_lang_sense_clarification": "schokkerig bewegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d9d9932-2707-3aff-be45-0bef3a1c1ce5",
