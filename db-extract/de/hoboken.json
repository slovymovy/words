                "senses": [
                    {
                        "sense_id": "0339201f-06e5-3997-9ebe-5be53c5db28e",
                        "entry_id": "0a5843fd-3937-37f3-9f16-75cf19aef935",
                        "glosses": [
                            "Stadt im US-Bundesstaat New Jersey"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45aff1c7-5a89-4fbc-bca1-aee046fc468e",
                                "sense_id": "0339201f-06e5-3997-9ebe-5be53c5db28e",
                                "text": "„Ihr Vater hatte auf der anderen Seite des Flusses in Hoboken einen neuen Job gefunden und kam nur an Wochenenden und oft nicht einmal dann nach Hause.“"
                            },
                            {
                                "example_id": "f79de2e2-ed47-449b-8b04-3c7f2d78c2c9",
                                "sense_id": "0339201f-06e5-3997-9ebe-5be53c5db28e",
                                "text": "„Einmal war sie angeblich unter den verrotteten Bootsanlegern in der Nähe von Hoboken gesehen worden.“"
                            },
                            {
                                "example_id": "fb2cec9b-69ca-46f5-ac6e-8a0543fcf46b",
                                "sense_id": "0339201f-06e5-3997-9ebe-5be53c5db28e",
                                "text": "„Er kehrte der Stadt den Rücken und ließ sich nach einer Zwischenstation in Konstantinopel 1904 in Hoboken im amerikanischen Bundesstaat New Jersey nieder, wo er als Rabbiner wirkte und zahlreiche Bücher schrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
