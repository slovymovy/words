                "senses": [
                    {
                        "sense_id": "5b51325d-5420-31c5-b4dd-41c530997f04",
                        "entry_id": "c46a09ca-6672-3f74-bb7e-fc2e1798f7d4",
                        "glosses": [
                            "Fachsprache der Drucker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a28cee7e-75e9-4b52-9b2b-ca8ef4b937fd",
                                "sense_id": "5b51325d-5420-31c5-b4dd-41c530997f04",
                                "text": "„Das Alter des Sonderwortschatzes der Druckersprache ist im einzelnen schwer festzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "772c1499-b912-3396-b6ef-03eb0d7618a9",
                        "entry_id": "c46a09ca-6672-3f74-bb7e-fc2e1798f7d4",
                        "glosses": [
                            "in den einzelnen Druckorten nach Erfindung des Buchdrucks herausgebildete Sprachform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e438d0-2500-4182-95a8-4c94e89cfed1",
                                "sense_id": "772c1499-b912-3396-b6ef-03eb0d7618a9",
                                "text": "„Sie vermitteln einen Eindruck davon, daß die Druckersprachen zunächst noch landschaftlich gebunden waren, besonders deutlich der Kölner Druck von 1499 (…); aber andererseits lassen sie doch auch ein hohes Maß von Übereinstimmung erkennen.“"
                            },
                            {
                                "example_id": "4596b098-242a-4e97-8567-c1efc3f4e477",
                                "sense_id": "772c1499-b912-3396-b6ef-03eb0d7618a9",
                                "text": "„An der Ausbreitung überlandschaftlicher Schreib- und Verkehrssprachen waren die Druckoffizinen im 16. Jh. so stark beteiligt, daß neben den Bezeichnungen »Kanzleisprachen« und »Geschäftssprachen« auch der Ausdruck »Druckersprachen« berechtigt erscheint.“"
                            },
                            {
                                "example_id": "ab1b3783-18b6-4dd7-80d9-597418daf159",
                                "sense_id": "772c1499-b912-3396-b6ef-03eb0d7618a9",
                                "text": "„Rechtschreibung, Lautstand und Formengebung differieren immer noch erheblich, Kanzlei- und Druckersprachen verschiedener regionaler Prägung gehen immer noch nebeneinander her.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
