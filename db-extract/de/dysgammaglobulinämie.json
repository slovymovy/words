                "senses": [
                    {
                        "sense_id": "d284fb7f-40d5-303a-b359-4c8ea17e8b1f",
                        "entry_id": "17630815-f65b-3b7f-9d1c-5813db3b3ffe",
                        "glosses": [
                            "Störung der Zusammensetzung der Gammaglobuline im Blutplasma"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f6b3791-0e58-410d-905a-8b2f44c0d674",
                                "sense_id": "d284fb7f-40d5-303a-b359-4c8ea17e8b1f",
                                "text": "„Eine Dysgammaglobulinämie entwickelt sich bei 31% der männlichen XLP-Patienten, kann sich aber auch in einigen Fällen ohne erfolgte EBV-Infektion manifestieren (Brandau et al. 1999).“"
                            },
                            {
                                "example_id": "5939b42a-1241-4950-b7e9-c3c057d78189",
                                "sense_id": "d284fb7f-40d5-303a-b359-4c8ea17e8b1f",
                                "text": "„Seit 1965 wird am Institut eine erbliche Dysgammaglobulinämie des Huhnes (Gallus domesticus) untersucht, die in einer im Hause entwickelten Hühnerlinie gehäuft auftritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
