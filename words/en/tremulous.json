    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "60b53a86-159a-3701-a189-0614cb3ba37e",
                    "sense_definition": "Characterized by trembling, quivering, or shaking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man spoke in a <w>tremulous</w> voice because he was very cold.",
                            "target_lang_translations": {
                                "cs": "Stařec mluvil <w>chvějivým</w> hlasem, protože mu byla velká zima."
                            }
                        },
                        {
                            "text": "Sunlight created <w>tremulous</w> patterns on the water as the wind blew.",
                            "target_lang_translations": {
                                "cs": "Sluneční světlo vytvářelo na vodě <w>chvějivé</w> vzorce, jak foukal vítr."
                            }
                        }
                    ],
                    "synonyms": [
                        "quaking",
                        "shivering",
                        "shaky",
                        "trembly",
                        "tremulant"
                    ],
                    "common_phrases": [
                        "tremulous voice",
                        "tremulous hands"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyznačující se třesením, chvěním nebo otřesy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "třesoucí se",
                                "target_lang_sense_clarification": "obecné vyjádření fyzického chvění"
                            },
                            {
                                "target_lang_word": "chvějivý",
                                "target_lang_sense_clarification": "často používané pro hlas nebo světlo"
                            },
                            {
                                "target_lang_word": "rozechvělý",
                                "target_lang_sense_clarification": "vyjadřuje stav způsobený emocemi nebo zimou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f83978d8-0408-39cf-84e2-cb5e3c0d2720",
                    "sense_definition": "Feeling or showing a lack of confidence; timid or hesitant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a <w>tremulous</w> inquiry about whether she had passed the difficult exam.",
                            "target_lang_translations": {
                                "cs": "S <w>nejistým</w> dotazem se ptala, zda složila tu těžkou zkoušku."
                            }
                        },
                        {
                            "text": "He felt <w>tremulous</w> about starting his new job in a foreign country.",
                            "target_lang_translations": {
                                "cs": "Cítil se <w>bázlivě</w> z toho, že začíná novou práci v cizí zemi."
                            }
                        }
                    ],
                    "synonyms": [
                        "fearful",
                        "timorous",
                        "wavering"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pocit nebo projev nedostatku sebedůvěry; bázlivý nebo váhavý."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bázlivý",
                                "target_lang_sense_clarification": "vyjadřující strach nebo nejistotu"
                            },
                            {
                                "target_lang_word": "nejistý",
                                "target_lang_sense_clarification": "váhavý v rozhodování nebo projevu"
                            },
                            {
                                "target_lang_word": "plachý",
                                "target_lang_sense_clarification": "ostýchavý v sociálních situacích"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}