                        "glosses": [
                            "Nom vernaculaire de trois oiseaux de la famille des alaudidés qui comprend aussi les alouettes et les cochevis :"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8617612a-a576-4722-9fcd-4e07a07c1f62",
                                "sense_id": "6ae8169e-1f22-35f3-8190-61ee9cb398bc",
                                "text": "le sirli bifascié ou sirli du désert – Alaemon alaudipes, espèce commune de l’Afrique du Nord à l’Asie de l’Ouest en passant par le Moyen-Orient."
                            },
                            {
                                "example_id": "dc9f4977-7d9d-4d4b-a5c3-56fcc726b8f6",
                                "sense_id": "6ae8169e-1f22-35f3-8190-61ee9cb398bc",
                                "text": "le sirli de Witherby – Alaemon hamertoni"
                            },
                            {
                                "example_id": "e81fcd8f-72b4-413b-8db3-5d9016fb0ee2",
                                "sense_id": "6ae8169e-1f22-35f3-8190-61ee9cb398bc",
                                "text": "le sirli ricoti ou sirli de Dupont– Chersophilus duponti, menacé d'extinction en Espagne, seul pays européen accueillant la sous-espèce Chersophilus duponti duponti. L'autre sous-espèce Chersophilus duponti margaritae est rare en Algérie, Tunisie, Lybie et côtes ouest de l'Egypte."
                            }
                        ]
                    }
