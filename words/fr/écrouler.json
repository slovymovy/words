    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45cb5751-70e5-35ee-a6d7-21d9bf10951b",
                    "sense_definition": "Tomber en s'affaissant brusquement sous son propre poids, en parlant d'un bâtiment ou d'une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux bâtiment menaçait de s'<w>écrouler</w> depuis le passage de la dernière tempête."
                        },
                        {
                            "text": "Épuisé par cette longue randonnée en montagne, il s'est laissé <w>écrouler</w> sur le canapé."
                        }
                    ],
                    "synonyms": [
                        "s'effondrer",
                        "s'affaisser"
                    ],
                    "common_phrases": [
                        "s'écrouler de fatigue",
                        "menacer de s'écrouler"
                    ]
                },
                {
                    "sense_id": "5a5764df-4099-3ee5-b04b-35df85364846",
                    "sense_definition": "Subir une perte totale et soudaine de puissance ou de stabilité, en parlant d'un régime, d'un système ou d'un projet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En apprenant cette terrible nouvelle, tous ses beaux projets venaient de s'<w>écrouler</w>."
                        },
                        {
                            "text": "Après des années d'instabilité politique, le régime autoritaire a fini par s'<w>écrouler</w>."
                        }
                    ],
                    "synonyms": [
                        "s'effondrer",
                        "péricliter"
                    ],
                    "common_phrases": [
                        "voir ses espoirs s'écrouler"
                    ]
                },
                {
                    "sense_id": "7a459fd5-071f-3af8-8148-5bdc31d3de56",
                    "sense_definition": "Subir une baisse brutale et massive, en parlant d'une valeur financière, d'une monnaie ou de cours boursiers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'ouverture des marchés financiers, les actions de la banque ont commencé à s'<w>écrouler</w>."
                        },
                        {
                            "text": "La monnaie locale risque de s'<w>écrouler</w> si l'inflation continue d'augmenter si rapidement."
                        }
                    ],
                    "synonyms": [
                        "chuter",
                        "dégringoler",
                        "s'effondrer"
                    ],
                    "common_phrases": [
                        "s'écrouler à la bourse"
                    ]
                }
            ]
        }
    ]
}