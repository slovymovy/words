    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "361f7672-a14c-35bb-a641-cd965ab89702",
                "word": "beldame",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6a08297b-2247-42ee-b40b-f37786d7542a",
                        "entry_id": "361f7672-a14c-35bb-a641-cd965ab89702",
                        "tags": [
                            "plural"
                        ],
                        "form": "beldames"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba46aa3e-f7f3-3d3f-9974-afcc417045e5",
                        "entry_id": "361f7672-a14c-35bb-a641-cd965ab89702",
                        "glosses": [
                            "A grandmother."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8ee2c937-c7a8-4094-882f-8b8ac9bd573f",
                                "sense_id": "ba46aa3e-f7f3-3d3f-9974-afcc417045e5",
                                "text": "There he was welcom'd of that honeſt ſyre, / And of his aged Beldame homely well; / Who him beſought himſelfe to diſattyre, / And reſt himſelfe, till ſupper time befell."
                            },
                            {
                                "example_id": "8e078c94-1fdf-4619-b811-5ddb71f23b6c",
                                "sense_id": "ba46aa3e-f7f3-3d3f-9974-afcc417045e5",
                                "text": "Diſeaſed nature oftentimes breakes forth, / In ſtrange eruptions, oft the teeming earth / Is with a kind of collicke pincht and vext, / By the impriſoning of vnruly wind / Within her vvombe, vvhich for enlargement ſtriuing / Shakes the old Beldame earth, and topples down / Steeples and moſſegrovvn towers."
                            }
                        ]
                    },
                    {
                        "sense_id": "75fa3232-b39c-333c-a907-cfd9c050334f",
                        "entry_id": "361f7672-a14c-35bb-a641-cd965ab89702",
                        "glosses": [
                            "An old woman, particularly an ugly one."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "30f91459-09ab-45a6-9809-2a23d1553165",
                                "sense_id": "75fa3232-b39c-333c-a907-cfd9c050334f",
                                "text": "Justice is an old hobbling beldame, and I can't get her to keep pace with Generosity, for the soul of me."
                            },
                            {
                                "example_id": "97c431d2-6be8-4f10-bed1-0b5568447d56",
                                "sense_id": "75fa3232-b39c-333c-a907-cfd9c050334f",
                                "text": "[…] have a curiosity to hear my fortune told: therefore, Sam, order the beldame forward."
                            },
                            {
                                "example_id": "b139019a-c348-4db5-89b7-0466f83335db",
                                "sense_id": "75fa3232-b39c-333c-a907-cfd9c050334f",
                                "text": "Therefore, the teacher of to-day is not the graybeard and beldame, but the man and woman most newly filled with the gathered experience of the world."
                            },
                            {
                                "example_id": "5dec1aa1-ab4f-414c-98d6-33f9c6fed4ca",
                                "sense_id": "75fa3232-b39c-333c-a907-cfd9c050334f",
                                "text": "The tablets upon which the events of the day were recorded refer to enchantresses, and we can conclude that they were by no means restricted to ancient beldames."
                            },
                            {
                                "example_id": "b5c287a7-0793-4d8b-beab-b64f2615ba53",
                                "sense_id": "75fa3232-b39c-333c-a907-cfd9c050334f",
                                "text": "Among the large number of characters are [...] young boys and old knowledgeable beldames familiar with every lubricity, every love charm and potion."
                            },
                            {
                                "example_id": "73bd45dc-091a-41b9-9143-edb92321abd1",
                                "sense_id": "75fa3232-b39c-333c-a907-cfd9c050334f",
                                "text": "Suddenly the beldam shrieks as if she's been stuck with a dagger, long rasping insuck of breath: ‘Eeeeeeeee!’"
                            }
                        ]
                    }
                ],
