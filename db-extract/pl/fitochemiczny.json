                        "glosses": [
                            "dotyczący fitochemii, substancji roślinnych i procesów chemicznych zachodzacych w roślinach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7c087eb-a45c-4a1b-9231-55f8cf53edbf",
                                "sense_id": "f8a57c72-eadb-3b37-9a95-8162e4c625b3",
                                "text": "[…] ma charakter fitochemiczny, gdyż dotyczy nielotnych kwasów w leczniczej roślinie kozłek lekarski — Valeriana officinalis. Badacz wyosobnił z korzeni rośliny dwa związki, które poddał analizie."
                            }
                        ],
