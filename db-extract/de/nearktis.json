                        ],
                        "form": "der Nearktis"
                    },
                    {
                        "form_id": "979286c8-f76b-4a9a-a1ff-62e3f94fb74b",
                        "entry_id": "65199d5e-b0d0-332f-8863-a906ce5dcf8e",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Nearktis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2854b155-3695-33b2-b9a0-c566765570e2",
                        "entry_id": "65199d5e-b0d0-332f-8863-a906ce5dcf8e",
                        "glosses": [
                            "eine biogeografische Region, die fast das gesamte Nordamerika, Grönland und das Hochland von Mexiko umfasst"
                        ],
                        "tags": [
                            "Biogeografie"
                        ],
                        "examples": [
                            {
                                "example_id": "a4eaa40b-bd8b-401c-811d-3165bf36025e",
                                "sense_id": "2854b155-3695-33b2-b9a0-c566765570e2",
                                "text": "„Die Nearktis umfasst Nordamerika und Grönland.“"
                            },
                            {
                                "example_id": "371f12f1-f726-4e40-bf6b-2bf84274bde4",
                                "sense_id": "2854b155-3695-33b2-b9a0-c566765570e2",
                                "text": "„Die Gemeinsamkeiten zwischen der Paläarktis und Nearktis sind auf die ähnliche historische Entwicklung in den mittleren und hohen Breiten zurückzuführen.“"
                            },
                            {
                                "example_id": "8b840ab0-899a-42a6-8eb4-44086085d1cd",
                                "sense_id": "2854b155-3695-33b2-b9a0-c566765570e2",
                                "text": "„Auf die Nearktis beschränkt sind unter den Säugern mehrere Nagerfamilien, wie Biberhörnchen, Taschenratten und Gabelhorntiere (Antilocapridae), unter den Kriechtieren die Ringelschleichen, unter den Lurchen die Schwanzfrösche (Ascaphidae), sowie verschiedene Schwanzlurche (Urodelen).“"
                            },
                            {
                                "example_id": "31f5cf3c-037d-4af9-b047-b8ab31829101",
                                "sense_id": "2854b155-3695-33b2-b9a0-c566765570e2",
                                "text": "„In der Paläarktis brüten etwas mehr als 1000 Arten, in der Nearktis etwa 750 Arten.“"
                            },
                            {
                                "example_id": "c371931f-31ac-4b15-afa0-28e85a067482",
                                "sense_id": "2854b155-3695-33b2-b9a0-c566765570e2",
                                "text": "„Biogeographisch (Biogeographie) gehört Nordamerika zu einer Subregion der Holarktis, die als Nearktis bezeichnet wird und außer dem gesamten nordamerikanischen Kontinent alle arktischen Inseln sowie Neufundland und Grönland und im Süden noch das kühle Hochplateau von Mexiko umfaßt […].“"
                            },
                            {
                                "example_id": "57658876-04d1-431f-95fc-231146542f56",
                                "sense_id": "2854b155-3695-33b2-b9a0-c566765570e2",
                                "text": "„Die floristischen Unterschiede der Nearktis gegenüber Europa und Ost-Asien werden von Norden nach Süden fortschreitend immer deutlicher […].“"
                            },
                            {
                                "example_id": "d75289e1-0420-458a-879d-988209d14c93",
                                "sense_id": "2854b155-3695-33b2-b9a0-c566765570e2",
                                "text": "„Hinsichtlich der Vögel gehört die Nearktis mit ihren rund 800 Arten in Anbetracht ihrer Größe zu den relativ artenarmen Regionen […].“"
                            },
                            {
                                "example_id": "ef27225b-3d3f-44df-a290-441812632a11",
                                "sense_id": "2854b155-3695-33b2-b9a0-c566765570e2",
                                "text": "„Typisch für die Nearktis sind die Truthühner, die dort die auf die Alte Welt beschränkten Fasanen \"vertreten\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
