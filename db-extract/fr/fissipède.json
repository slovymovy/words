                        "glosses": [
                            "Qui a le pied divisé en plusieurs doigts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dafbc18-6704-45c5-922d-f97ebdb143e9",
                                "sense_id": "d787454c-aa5c-354a-ac6f-c0e2416898ba",
                                "text": "Le chien, le chat, le loup sont des animaux fissipèdes."
                            },
                            {
                                "example_id": "eebe98e5-fbff-4bc3-ad86-9a8333c39ac9",
                                "sense_id": "d787454c-aa5c-354a-ac6f-c0e2416898ba",
                                "text": "Substantivement, le chien est un fissipède."
                            },
                            {
                                "example_id": "1ea28afd-31b9-4ba9-a913-62d2368d593e",
                                "sense_id": "d787454c-aa5c-354a-ac6f-c0e2416898ba",
                                "text": "Par les extrémités il ne ressemble point a ceux qu'ils ont appelés solipèdes, puisqu'il a le pied divisé ; il ne ressemble point à ceux qu'ils ont appelés pieds fourchus, puisqu'il a réellement quatre doigts au-dedans, quoiqu'il n’en paraisse que deux à l'extérieur ; il ne ressemble point à ceux qu'ils ont appelés fissipèdes, puisqu'il ne marche que sur deux doigts, et que les deux autres ne sont ni développés, ni posés comme ceux des fissipèdes, ni même assez alongés pour qu'il puisse s'en servir."
                            }
                        ]
                    }
