{
    "word_family": [
        "sermonize",
        "sermonizer",
        "sermonic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00c8ae46-75eb-3b10-af6e-7c5cafbe6ad7",
                    "sense_definition": "A talk on a religious or moral subject, especially one given during a church service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest delivered an inspiring <w>sermon</w> about compassion and forgiveness.",
                            "target_lang_translations": {
                                "zh": "神父做了一场关于同情与宽恕的感人<w>讲道</w>。"
                            }
                        },
                        {
                            "text": "Many people stayed after the service to discuss the morning <w>sermon</w>.",
                            "target_lang_translations": {
                                "zh": "许多人在礼拜结束后留下来讨论早上的<w>布道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "homily",
                        "address"
                    ],
                    "common_phrases": [
                        "deliver a sermon",
                        "preach a sermon",
                        "Sunday sermon"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指礼拜时所作的）布道，讲道，讲道词"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讲道",
                                "target_lang_sense_clarification": "宗教仪式上的说教或布道"
                            },
                            {
                                "target_lang_word": "布道",
                                "target_lang_sense_clarification": "宗教宣讲"
                            },
                            {
                                "target_lang_word": "布道词",
                                "target_lang_sense_clarification": "布道所用的文辞或讲稿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdec74ea-8b19-36e5-8c06-7e5782a5d89a",
                    "sense_definition": "A long or tedious lecture of reproof or moral advice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scolding_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not want another <w>sermon</w> from his parents about responsibility.",
                            "target_lang_translations": {
                                "zh": "他不想再听父母关于责任的又一次<w>说教</w>。"
                            }
                        },
                        {
                            "text": "Her long <w>sermon</w> on punctuality made everyone in the room feel uncomfortable.",
                            "target_lang_translations": {
                                "zh": "她那番关于守时的长篇<w>大道理</w>让屋里的每个人都感到不自在。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lecture",
                        "harangue"
                    ],
                    "target_lang_definitions": {
                        "zh": "长篇大论的说教；训诫，训斥"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "说教",
                                "target_lang_sense_clarification": "冗长而令人厌烦的道德劝诫"
                            },
                            {
                                "target_lang_word": "大道理",
                                "target_lang_sense_clarification": "喋喋不休的长篇规劝"
                            },
                            {
                                "target_lang_word": "训话",
                                "target_lang_sense_clarification": "长篇责备或训诫"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91271d0f-a591-3369-8f04-63d6c6a7075b",
                    "sense_definition": "To deliver a religious or moral discourse to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher <w>sermoned</w> to the crowd about virtue and restraint.",
                            "target_lang_translations": {
                                "zh": "传教士向众人<w>讲道</w>，宣讲美德与克制。"
                            }
                        },
                        {
                            "text": "He often <w>sermoned</w> on the importance of honest labor.",
                            "target_lang_translations": {
                                "zh": "他经常就诚实劳动的意义向人<w>布道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "preach"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "布道，讲道（旧式或罕见用法）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讲道",
                                "target_lang_sense_clarification": "宣讲宗教或道德教义"
                            },
                            {
                                "target_lang_word": "布道",
                                "target_lang_sense_clarification": "进行宗教宣讲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f0683ee-9107-366c-810b-b0d744005160",
                    "sense_definition": "To lecture someone in an authoritative or reproving manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scolding_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stop trying to <w>sermon</w> me about my life choices.",
                            "target_lang_translations": {
                                "zh": "请别再试图就我的人生选择对我<w>说教</w>了。"
                            }
                        },
                        {
                            "text": "He began to <w>sermon</w> his assistant about punctuality and discipline.",
                            "target_lang_translations": {
                                "zh": "他开始就守时和纪律问题<w>训诫</w>起他的助手来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lecture",
                        "berate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "说教，训诫，训斥（某人）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "说教",
                                "target_lang_sense_clarification": "以居高临下的态度教训人"
                            },
                            {
                                "target_lang_word": "训诫",
                                "target_lang_sense_clarification": "严厉教导或责备"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}