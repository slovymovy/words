                "forms": [],
                "senses": [
                    {
                        "sense_id": "efbb68d6-b681-34ed-85fb-f526c1d3297a",
                        "entry_id": "0aa28f71-eac0-3991-87ac-2ec92573f637",
                        "glosses": [
                            "schuim van een bouillon afhalen met een schuimspaan zodat er een heldere vloeistof achterblijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "546b4055-ba34-490f-bd9b-72e4f6599576",
                                "sense_id": "efbb68d6-b681-34ed-85fb-f526c1d3297a",
                                "text": "Waarom moet je bij het trekken van bouillon afschuimen? Het grijze, onsmakelijke schuim dat omhoog komt bij het trekken van een vlees- of visbouillon is afkomstig van onoplosbare eiwitten. Deze maken de bouillon troebel. Afschuimen zorgt dus voor een helderder bouillon."
                            }
                        ]
                    }
                ],
