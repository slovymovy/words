                    {
                        "sense_id": "6dc3a14c-584c-3963-9d64-8808c7110276",
                        "entry_id": "d0d8d487-cb35-3527-b479-39ac0945854d",
                        "glosses": [
                            "afzetting op de bodem van in (stromend) water aanwezige vaste deeltjes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb56fc3-4394-44e4-93d6-2aa627f7af4e",
                                "sense_id": "6dc3a14c-584c-3963-9d64-8808c7110276",
                                "text": "Heden ten dage wordt slib niet veel meer gebruikt omdat mest beter zou zijn en veel slib tegenwoordig verontreinigd is, veelal met zware metalen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f2f0f6a-3746-43b1-bdb7-eddef3b1e8d9",
                        "source_entry_id": "d0d8d487-cb35-3527-b479-39ac0945854d",
                        "source_sense_id": "6dc3a14c-584c-3963-9d64-8808c7110276",
                        "target_lang_word": "Schlick",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4e37a35-024e-35b8-ae87-36f10a9d1bfa",
                                        "entry_id": "78f0e355-6e99-3351-bac5-e76258a9cda5",
                                        "glosses": [
                                            "Ablagerung des Meerwassers und des Wassers der Flüsse, in die mit der Flutwelle Meerwasser eindringt; die Wattengebiete bestehen aus starken Schlickschichten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0229346-0955-4314-b6fe-75425cc52c4d",
                                                "sense_id": "d4e37a35-024e-35b8-ae87-36f10a9d1bfa",
                                                "text": "Im Schlick sind neben organischen Substanzen Kalk, Magnesia, Kali, Phosphorsäure und Stickstoff enthalten."
                                            },
                                            {
                                                "example_id": "66de1923-b3f9-4eff-9bf5-6c83b7082760",
                                                "sense_id": "d4e37a35-024e-35b8-ae87-36f10a9d1bfa",
                                                "text": "„Einen solchen Anhänger haben Forscher jedenfalls im Schlick des Hafens gefunden.“"
                                            },
                                            {
                                                "example_id": "e1d26e8d-f531-4d98-b676-9fc311f9a8c2",
                                                "sense_id": "d4e37a35-024e-35b8-ae87-36f10a9d1bfa",
                                                "text": "„In Hooksiel durften Volker und ich eine Schlickschlacht machen, in Badehosen, und uns bis zum Gehtnichtmehr mit Schlick bekleistern.“"
                                            },
                                            {
                                                "example_id": "6ed590ce-c05c-459b-a61e-b72b7ffcfc6a",
                                                "sense_id": "d4e37a35-024e-35b8-ae87-36f10a9d1bfa",
                                                "text": "„Wer hätte je einen Vers auf Porree-, Kohl- und Rübenfelder gemacht, Pappeln und Kopfweiden, Kribben, Kiesel, Schlick und Mulm gepriesen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3abda97-31be-404c-8d92-6cbb27243c85",
                        "source_entry_id": "d0d8d487-cb35-3527-b479-39ac0945854d",
                        "source_sense_id": "6dc3a14c-584c-3963-9d64-8808c7110276",
                        "target_lang_word": "silt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc64c4e6-5526-3464-9c49-3709e22c5b0a",
                                        "entry_id": "a22749d5-80c5-37f8-ac32-7435a22546ab",
                                        "glosses": [
                                            "Mud or fine earth deposited from running or standing water."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad447376-193a-42fe-b610-2da1db21b935",
                                                "sense_id": "bc64c4e6-5526-3464-9c49-3709e22c5b0a",
                                                "text": "A large tube is then followed over several silt banks to surface after a total dive of 200 m in a large passage containing an active streamway – The San Agustin Way. 5 m before the passage surfaces another line junction is passed, ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6305a8ad-9faf-30cb-8f68-bf26d7686ac8",
                                        "entry_id": "a22749d5-80c5-37f8-ac32-7435a22546ab",
                                        "glosses": [
                                            "Any material with similar physical characteristics, regardless of its origins or transport."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16509149-b498-394d-90fd-50fd0228c5e8",
                                        "entry_id": "a22749d5-80c5-37f8-ac32-7435a22546ab",
                                        "glosses": [
                                            "A particle from 3.9 to 62.5 microns in diameter, following the Wentworth scale."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb39c63-fa93-4a83-aa84-e756941a6439",
                                                "sense_id": "16509149-b498-394d-90fd-50fd0228c5e8",
                                                "text": "Above the lower headcut, phreatophytic mesquite and little leaf sumac hug the banks, drawing pendulate water from the silts remaining from former marsh deposits and sending long taproots into channel stores."
                                            },
                                            {
                                                "example_id": "bc45a7f2-3e13-46ea-8394-bd171a9fe345",
                                                "sense_id": "16509149-b498-394d-90fd-50fd0228c5e8",
                                                "text": "The gravels, initially deposited by surf-zone processes during the Pleistocene low stands in this area were drowned by quartzose sands, and then the prodeltaic silts and clays deposited by the seaward prograding-feather edge of the Holocene Orange Delta were subsequently integrated into the delta-front by bioturbation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f87e4325-fa90-3835-9346-2d83e1f508cd",
                                        "entry_id": "1b489f3d-ea9f-3670-8ea5-91793c2d51f8",
                                        "glosses": [
                                            "To clog or fill with silt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aec30444-d497-3d75-a2bb-7fe601532367",
                                        "entry_id": "1b489f3d-ea9f-3670-8ea5-91793c2d51f8",
                                        "glosses": [
                                            "To become clogged with silt."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3601c0e-797b-4a0f-a09d-89475734a411",
                                                "sense_id": "aec30444-d497-3d75-a2bb-7fe601532367",
                                                "text": "Subject to flooding by the six small rivers coming together just west of the city, the main river below the city has long been shallow and subject to silting. The Communists have both maintained the earlier pattern of dredging the river, and have built a bypass flood canal around the city on the south side to relieve flood pressures. Though dredging can keep the river navigable for small ships, a new artificial port, Sinkang, able to take 10,000 ton ships at all times, was created at T'ang-ku. This is kept open for about two months during winter by icebreakers."
                                            },
                                            {
                                                "example_id": "6537ed8f-a5ff-4378-9d05-02981fa56622",
                                                "sense_id": "aec30444-d497-3d75-a2bb-7fe601532367",
                                                "text": "They are city-dwellers, men whose lives pass in the shadows of buildings, whose lungs are silted with coalsmoke, and few will ever cross the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e24e5220-4a0b-30db-9ae3-069c1003de76",
                                        "entry_id": "1b489f3d-ea9f-3670-8ea5-91793c2d51f8",
                                        "glosses": [
                                            "To flow through crevices; to percolate."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a7beca0-4656-4462-bdba-40763d6a0294",
                        "source_entry_id": "d0d8d487-cb35-3527-b479-39ac0945854d",
                        "source_sense_id": "6dc3a14c-584c-3963-9d64-8808c7110276",
                        "target_lang_word": "limon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd9f8be-e79d-339a-887b-f0d6f0010425",
                                        "entry_id": "94506e81-00f4-3fb9-a795-42f3c1f6a0d3",
                                        "glosses": [
                                            "Alluvion, terre charriée par un cours d’eau et qui se dépose sur ses rives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aee5794b-606d-43fa-aea1-5f9e0d5b3d4c",
                                                "sense_id": "fdd9f8be-e79d-339a-887b-f0d6f0010425",
                                                "text": "La variété dite Anguille noire ne sortirait pas de la vase et du limon, tandis que l’Anguille blonde rechercherait les eaux plus claires et les fonds caillouteux."
                                            },
                                            {
                                                "example_id": "16e13eaf-610c-44fc-b261-6084318e466d",
                                                "sense_id": "fdd9f8be-e79d-339a-887b-f0d6f0010425",
                                                "text": "La vallée du Nil a été, en grande partie, formée par les apports successifs de limon que le fleuve y dépose à l’époque de ses crues périodiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb1d1d4e-f576-344d-8c33-e1c92120a480",
                                        "entry_id": "94506e81-00f4-3fb9-a795-42f3c1f6a0d3",
                                        "glosses": [
                                            "Alluvion, terre charriée par un cours d’eau et qui se dépose sur ses rives.",
                                            "Glaise, argile."
                                        ],
                                        "tags": [
                                            "Biblical",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722cd049-1270-45b7-a01c-2d695ae7f751",
                                                "sense_id": "eb1d1d4e-f576-344d-8c33-e1c92120a480",
                                                "text": "Nous sommes tous pétris du même limon, Dieu nous a tous faits semblables."
                                            },
                                            {
                                                "example_id": "d5e4acba-b87e-40bb-a34c-c30cfcd7b098",
                                                "sense_id": "eb1d1d4e-f576-344d-8c33-e1c92120a480",
                                                "text": "La matiere de chair est elle pas plus belle\n(Dont ce corps feminin fut basti sans modelle\nSuivant le sainct vouloir du vray Jupin tout bon)\nQue n’est celle qui fut formee du limon ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf1685be-d3a1-3a9e-a758-1dd09cb54afc",
                                        "entry_id": "94506e81-00f4-3fb9-a795-42f3c1f6a0d3",
                                        "glosses": [
                                            "Sol léger et apte à produire dans les conditions actuelles de culture."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d29e4464-fa4e-3e11-9d86-324810e2a80f",
                                        "entry_id": "94506e81-00f4-3fb9-a795-42f3c1f6a0d3",
                                        "glosses": [
                                            "Dépôt apporté par les cours d’eau ou par le vent, constitué de particules très fines de roches, mêlées à des débris organiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d25da69a-caf8-4924-bedd-b619935a38ae",
                                                "sense_id": "d29e4464-fa4e-3e11-9d86-324810e2a80f",
                                                "text": "Pendant de longs siècles, la maison resta bien fragile. A peine différente d'une cabane de bois dans les forêts, bicoque de limon très souvent, elle brûlait ou elle fondait pour un rien."
                                            },
                                            {
                                                "example_id": "e7e07291-5fd0-41df-ac03-f4143407aae4",
                                                "sense_id": "d29e4464-fa4e-3e11-9d86-324810e2a80f",
                                                "text": "Le lœss est un limon éolien, souvent calcaire, aussi appelé limon de plateau, qui s’est déposé pendant une période glaciaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a15801e5-99f5-3970-9517-a9823be07508",
                                        "entry_id": "94506e81-00f4-3fb9-a795-42f3c1f6a0d3",
                                        "glosses": [
                                            "Ramassis, tourbe de gens méprisables et vils."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9572e8b5-72df-41df-ba71-ebb07a750215",
                                                "sense_id": "a15801e5-99f5-3970-9517-a9823be07508",
                                                "text": "Rougissant de la supériorité du nombre et des ignobles troupes qu’ils semblaient commander, entrevoyant, peut-être pour la première fois, les funestes conséquences de leurs jeux politiques, et voyant quel était le limon qu’ils venaient de remuer, ils se divisèrent pour se retirer, enfonçant leurs chapeaux larges sur leurs yeux, jetant leurs manteaux sur leurs épaules, et redoutant le jour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "limon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c249755-89ee-3291-bc47-04f53f8e57df",
                                        "entry_id": "b53918d5-fd36-3376-9cd0-cdddcd4fa674",
                                        "glosses": [
                                            "Chacune des deux longues pièces de bois fixées à l’avant d’une voiture, entre lesquelles on attelle un animal de trait, et dont l’ensemble constitue la limonière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f65fe866-c4a1-4e44-9aeb-8c213cbabdac",
                                                "sense_id": "3c249755-89ee-3291-bc47-04f53f8e57df",
                                                "text": "A ce moment arriva une autre charrette que conduisait, assise sur le limon, une fillette rentrant au village."
                                            },
                                            {
                                                "example_id": "15f73c2e-bf9b-49e9-bad3-7e9de73eb705",
                                                "sense_id": "3c249755-89ee-3291-bc47-04f53f8e57df",
                                                "text": "Il y en avait perchés sur des bittes, agrippés aux mâts d’éclairage, en équilibre sur des charrettes dételées dont les limons oscillaient dangereusement sous le poids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dbc166a-5a32-3941-9cf8-536aca1f0765",
                                        "entry_id": "b53918d5-fd36-3376-9cd0-cdddcd4fa674",
                                        "glosses": [
                                            "Pièce de bois ou de pierre qui supporte l’extrémité des marches d’un escalier du côté opposé au mur, et sur laquelle on fixe la balustrade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "limon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f280807-4706-326b-b882-350da4e9ad30",
                                        "entry_id": "25ee2d44-26b6-3726-a5e3-a63a07ec5488",
                                        "glosses": [
                                            "Fruit du limonier, citron vert (Citrus aurantiifolia), analogue au citron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97e94e7-1963-494e-83cc-c53e363e2af1",
                                                "sense_id": "0f280807-4706-326b-b882-350da4e9ad30",
                                                "text": "Le droit est dû sur les vinaigres, jus de limon, cidres et poirés qui viennent du dehors, au moment de l’importation, et sur les vinaigres de bière et les vinaigres artificiels du pays, lors de la déclaration prescrite par les articles 62 , 65 et 67 de la présente loi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6894fed3-bbaf-38b1-931d-d96ad57221bf",
                                        "entry_id": "25ee2d44-26b6-3726-a5e3-a63a07ec5488",
                                        "glosses": [
                                            "Synonyme de citron."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0317050-96f8-4379-a510-9bd1af42c66d",
                                                "sense_id": "6894fed3-bbaf-38b1-931d-d96ad57221bf",
                                                "text": "Ils riaient, disaient des riens, jouaient, mordaient aux limons, aux oranges, aux pastèques amassés près d’eux sur des assiettes peintes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
