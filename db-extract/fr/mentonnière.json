                "senses": [
                    {
                        "sense_id": "f77e25f1-1cac-34ca-a515-05a6bcbaaea4",
                        "entry_id": "a628fb6e-21eb-39a1-a4dd-c1e7d892dc0f",
                        "glosses": [
                            "beaver (lower part of a helmet)"
                        ],
                        "tags": [
                            "feminine",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1780857b-4a65-4645-8aa6-f2b4471c057d",
                                "sense_id": "f77e25f1-1cac-34ca-a515-05a6bcbaaea4",
                                "text": "« Et je dis aussi que bien que ce soit un armet, ce n’est pas un armet entier. ¶ – Non certes, s’écria don Quichotte, car il lui manque une moitié, qui est la mentonnière. »",
                                "translation": "\"And I say that as much as it is a helmet, it is not an entire helmet\" ¶ \"Certainly not,\" exclaimed Don Quixote, \"as it is missing a half, which is the beaver.\"",
                                "english": "\"And I say that as much as it is a helmet, it is not an entire helmet\" ¶ \"Certainly not,\" exclaimed Don Quixote, \"as it is missing a half, which is the beaver.\""
                            }
                        ]
                    },
