                    {
                        "translation_id": "510121ec-7d18-4a59-b554-1b3e756afb11",
                        "source_entry_id": "98462283-8104-3d3e-b064-91a1a5571387",
                        "source_sense_id": "4d050bcb-9250-36f1-bb09-8f44ba9f9ab2",
                        "target_lang_word": "anglikán",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "91690456-4c53-4702-95c2-12c8384de204",
                        "source_entry_id": "98462283-8104-3d3e-b064-91a1a5571387",
                        "source_sense_id": "4d050bcb-9250-36f1-bb09-8f44ba9f9ab2",
                        "target_lang_word": "anglican",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anglican",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf7001b1-a173-3759-a6c0-374f4dce890a",
                                        "entry_id": "2e0bba37-128d-30c5-936c-a831245372c6",
                                        "glosses": [
                                            "Qui appartient ou qui est relatif à l’anglicanisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e810c5c6-45fe-4e71-a191-3fa7c37326a0",
                                                "sense_id": "bf7001b1-a173-3759-a6c0-374f4dce890a",
                                                "text": "Il n'y a pas de corporation ecclésiastique qui ait plus asservi aux circonstances ses doctrines et sa conduite que le haut clergé anglican."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anglican",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d7099d2-df31-3e93-a158-be000663a021",
                                        "entry_id": "d8a5c6f0-255e-3766-82f9-c13018851f50",
                                        "glosses": [
                                            "Substantif de l’adjectif, en parlant des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70881a1c-0b52-4038-93f0-b9d5601d9563",
                                                "sense_id": "8d7099d2-df31-3e93-a158-be000663a021",
                                                "text": "Cet homme fut John Wesley. Au début de sa vie il avait été, à Oxford, un anglican latitudinaire et qui tenait la foi pour un consentement rationnel."
                                            },
                                            {
                                                "example_id": "6f65fb2e-affb-4f32-9190-e17d98e0dd72",
                                                "sense_id": "8d7099d2-df31-3e93-a158-be000663a021",
                                                "text": "La situation est semblable pour Frank Scot, un anglican qui désire s’enquébécoiser et devenir François Sicotte."
                                            },
                                            {
                                                "example_id": "d59101bf-7c41-4853-b031-4a3b1f4ab08c",
                                                "sense_id": "8d7099d2-df31-3e93-a158-be000663a021",
                                                "text": "Que sa dénomination dérive d’un nom commun ou d’un nom propre, l’adepte ne prend jamais de majuscule initiale. L’adhérent, le disciple, le fidèle, le membre pas davantage. Toutes les catégories sont concernées (religion, philosophie, littérature, arts, politique, etc.) : un anglican, sept bouddhistes, trois catholiques, un dadaïste, deux existentialistes, un gnostique, un hindou, deux impressionnistes, trois jansénistes, quelques kharidjites, soixante laxistes, trois marxistes, quatre nudistes, deux oulipistes, dix presbytériennes, un quiétiste, un rexiste, des saint-simoniens, deux trotskistes, dix ultras, une voltairienne, un wahhabite, un zoroastrien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bae26446-0bfb-48bb-bc3e-f01406e4d52f",
                        "source_entry_id": "98462283-8104-3d3e-b064-91a1a5571387",
                        "source_sense_id": "4d050bcb-9250-36f1-bb09-8f44ba9f9ab2",
                        "target_lang_word": "anglicano",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "32bbbe92-e35f-4a3d-a3fe-a97af50a0aef",
                        "source_entry_id": "98462283-8104-3d3e-b064-91a1a5571387",
                        "source_sense_id": "4d050bcb-9250-36f1-bb09-8f44ba9f9ab2",
                        "target_lang_word": "Anglikaner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anglikaner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "475a8010-a81c-3119-8c7f-82e0baf8ce81",
                                        "entry_id": "f5a262a9-217a-3030-8258-634870d7c7e7",
                                        "glosses": [
                                            "Angehöriger der englischen Kirche oder einer ihrer Tochterkirchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9fe8c1c-bf3d-4de8-a113-2fdaf9c4885d",
                                                "sense_id": "475a8010-a81c-3119-8c7f-82e0baf8ce81",
                                                "text": "Sein Großvater war Anglikaner."
                                            },
                                            {
                                                "example_id": "e727a68d-6f77-42b5-bb32-7e377115dcff",
                                                "sense_id": "475a8010-a81c-3119-8c7f-82e0baf8ce81",
                                                "text": "„In Großbritannien stehen rund sechs Millionen Katholiken etwa 25 Millionen Anglikanern gegenüber.“"
                                            },
                                            {
                                                "example_id": "1bb10305-ec0a-4824-a836-841bc32156fd",
                                                "sense_id": "475a8010-a81c-3119-8c7f-82e0baf8ce81",
                                                "text": "„Die eine geriet 1948 mit ihrem Liebhaber Peter Fitzwilliam in einen Gewittersturm, nachdem sie den Zorn ihrer tiefkatholischen Mutter heraufbeschworen hatte, indem sie einen Anglikaner geheiratet hatte; der andere starb 1944, als sein Bomber auf dem Weg zu einer heroischen, selbstmörderischen Geheimmission über England explodierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
