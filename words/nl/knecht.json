{
    "word_family": [
        "knechtschap",
        "knechten",
        "boerenknecht",
        "meesterknecht",
        "stalknecht"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90cd0166-248e-36fb-a3d6-4f40c45d2960",
                    "sense_definition": "Een persoon die een ander helpt bij het uitvoeren van werkzaamheden, vaak in een ondergeschikte rol.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "helper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman nam een jonge <w>knecht</w> aan om hem te helpen in de werkplaats.",
                            "target_lang_translations": {
                                "en": "The carpenter hired a young <w>apprentice</w> to help him in the workshop."
                            }
                        },
                        {
                            "text": "Zonder de hulp van zijn trouwe <w>knecht</w> zou de boer het werk nooit op tijd afkrijgen.",
                            "target_lang_translations": {
                                "en": "Without the help of his loyal <w>farmhand</w>, the farmer would never finish the work on time."
                            }
                        }
                    ],
                    "synonyms": [
                        "bediende",
                        "dienaar"
                    ],
                    "antonyms": [
                        "baas",
                        "meester"
                    ],
                    "common_phrases": [
                        "trouwe knecht"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who assists another in performing tasks, often in a subordinate role."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "helper",
                                "target_lang_sense_clarification": "general assistant"
                            },
                            {
                                "target_lang_word": "hand",
                                "target_lang_sense_clarification": "manual worker or assistant"
                            },
                            {
                                "target_lang_word": "assistant",
                                "target_lang_sense_clarification": "person helping with work"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be231ede-6ebd-3ac4-8754-8a9c029976d3",
                    "sense_definition": "Een wielrenner die in dienst rijdt van een kopman om deze te helpen een wedstrijd te winnen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>knecht</w> reed de hele dag op kop van het peloton om de ontsnapping te controleren.",
                            "target_lang_translations": {
                                "en": "The <w>domestique</w> rode at the front of the peloton all day to control the breakaway."
                            }
                        },
                        {
                            "text": "Zelfs een goede <w>knecht</w> krijgt soms de kans om voor eigen succes te gaan.",
                            "target_lang_translations": {
                                "en": "Even a good <w>support rider</w> sometimes gets the chance to go for their own success."
                            }
                        }
                    ],
                    "antonyms": [
                        "kopman"
                    ],
                    "common_phrases": [
                        "rijden als knecht"
                    ],
                    "target_lang_definitions": {
                        "en": "A cyclist who rides in service of a team leader to help them win a race."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "domestique",
                                "target_lang_sense_clarification": "cycling support rider"
                            },
                            {
                                "target_lang_word": "helper",
                                "target_lang_sense_clarification": "support rider in a race"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "673389e7-2776-3160-b110-d44f9cfc86cd",
                    "sense_definition": "Een mannelijke huisbediende die persoonlijke diensten verricht voor een werkgever.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In historische romans heeft de rijke edelman vaak een persoonlijke <w>knecht</w> die hem overal volgt.",
                            "target_lang_translations": {
                                "en": "In historical novels, the wealthy nobleman often has a personal <w>manservant</w> who follows him everywhere."
                            }
                        },
                        {
                            "text": "De <w>knecht</w> opende de deur en nam de jassen van de gasten aan.",
                            "target_lang_translations": {
                                "en": "The <w>servant</w> opened the door and took the guests' coats."
                            }
                        }
                    ],
                    "synonyms": [
                        "bediende",
                        "dienaar",
                        "dienstbode"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Wordt tegenwoordig minder vaak gebruikt in deze specifieke context."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A male domestic worker who performs personal services for an employer."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "servant",
                                "target_lang_sense_clarification": "household worker"
                            },
                            {
                                "target_lang_word": "manservant",
                                "target_lang_sense_clarification": "male personal attendant"
                            },
                            {
                                "target_lang_word": "valet",
                                "target_lang_sense_clarification": "personal male servant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "967d5ee5-474a-3b65-a3e9-a40221d99562",
                    "sense_definition": "Iemand die zich onderdanig gedraagt en kritiekloos de bevelen van een machtiger persoon opvolgt.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "subservient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd door de oppositie weggezet als een gewillige <w>knecht</w> van het regime.",
                            "target_lang_translations": {
                                "en": "He was dismissed by the opposition as a willing <w>lackey</w> of the regime."
                            }
                        },
                        {
                            "text": "De dictator omringde zich met <w>knechten</w> die nooit durfden tegen te spreken.",
                            "target_lang_translations": {
                                "en": "The dictator surrounded himself with <w>henchmen</w> who never dared to contradict him."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gewillige knecht"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who behaves submissively and uncritically follows the orders of a more powerful person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "henchman",
                                "target_lang_sense_clarification": "loyal follower, often of a criminal or dictator"
                            },
                            {
                                "target_lang_word": "lackey",
                                "target_lang_sense_clarification": "subservient follower"
                            },
                            {
                                "target_lang_word": "minion",
                                "target_lang_sense_clarification": "unimportant follower of a powerful person"
                            },
                            {
                                "target_lang_word": "stooge",
                                "target_lang_sense_clarification": "person used by another to do unpleasant work"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f75c8b87-b5db-3608-86df-039659387e0d",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van het werkwoord <w>knechten</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>knecht</w> mijn tegenstanders door ze alle vrijheid te ontnemen.",
                            "target_lang_translations": {
                                "en": "I <w>subjugate</w> my opponents by depriving them of all freedom."
                            }
                        },
                        {
                            "text": "Als ik de bevolking <w>knecht</w>, zal er uiteindelijk verzet ontstaan.",
                            "target_lang_translations": {
                                "en": "If I <w>enslave</w> the population, resistance will eventually arise."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm van het werkwoord knechten."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of the verb 'to enslave' or 'to subjugate'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enslave",
                                "target_lang_sense_clarification": "to make someone a slave"
                            },
                            {
                                "target_lang_word": "subjugate",
                                "target_lang_sense_clarification": "to bring under control"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95b98611-8287-3e77-9656-f0e14cd4e6e2",
                    "sense_definition": "De gebiedende wijs van het werkwoord <w>knechten</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Knecht</w> hen niet, maar geef hen de ruimte om zichzelf te ontwikkelen.",
                            "target_lang_translations": {
                                "en": "Do not <w>oppress</w> them, but give them the space to develop themselves."
                            }
                        },
                        {
                            "text": "Amerika is een maffiastaat geworden, die universiteiten, media en rechtbanken <w>knecht</w> en afperst.",
                            "target_lang_translations": {
                                "en": "America has become a mafia state that <w>subjugates</w> and extorts universities, media, and courts."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Gebiedende wijs van het werkwoord knechten."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative mood of the verb 'to enslave' or 'to subjugate'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enslave",
                                "target_lang_sense_clarification": "command to make someone a slave"
                            },
                            {
                                "target_lang_word": "subjugate",
                                "target_lang_sense_clarification": "command to bring under control"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}