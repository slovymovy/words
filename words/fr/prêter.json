{
    "word_family": [
        "prêt",
        "prêteur",
        "prêteuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7126ef3d-0e0b-367f-9dd7-7d462a2b38a3",
                    "sense_definition": "Mettre temporairement un bien ou de l'argent à la disposition de quelqu'un, à charge de restitution.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emprunt_restitution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu me <w>prêter</w> de l'argent pour payer mon billet de train ?"
                        },
                        {
                            "text": "Elle a gentiment accepté de <w>prêter</w> un livre rare à son camarade."
                        }
                    ],
                    "antonyms": [
                        "emprunter"
                    ],
                    "common_phrases": [
                        "prêter de l'argent",
                        "prêter à intérêt"
                    ]
                },
                {
                    "sense_id": "ef05d97a-060f-39aa-b8fd-517dfb6a75ef",
                    "sense_definition": "Accorder ou apporter quelque chose d'abstrait, comme son attention, son écoute ou son aide.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "donner_accorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves doivent <w>prêter</w> attention aux explications données par le professeur."
                        },
                        {
                            "text": "Les voisins sont venus lui <w>prêter</w> main-forte pour déplacer cette lourde armoire."
                        }
                    ],
                    "synonyms": [
                        "accorder",
                        "donner"
                    ],
                    "common_phrases": [
                        "prêter attention",
                        "prêter l'oreille",
                        "prêter main-forte",
                        "prêter serment"
                    ]
                },
                {
                    "sense_id": "ffbfa494-0dd1-3b3f-a1ad-3595850ba3d4",
                    "sense_definition": "Attribuer ou supposer chez autrui des intentions, des propos ou des sentiments particuliers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On lui <w>prête</w> souvent de mauvaises intentions alors qu'il cherche simplement à aider."
                        },
                        {
                            "text": "Le journaliste a évité de lui <w>prêter</w> des propos qu'il n'avait jamais tenus."
                        }
                    ],
                    "synonyms": [
                        "attribuer",
                        "imputer"
                    ],
                    "common_phrases": [
                        "prêter des intentions",
                        "prêter des propos"
                    ]
                },
                {
                    "sense_id": "13a7a2a5-4536-3a1b-93c1-7fa3437211a9",
                    "sense_definition": "Donner matière ou occasion à une réaction, une interprétation ou un malentendu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette formulation ambiguë risque de <w>prêter</w> à confusion lors de la signature."
                        },
                        {
                            "text": "La maladresse comique de la scène ne manquait pas de <w>prêter</w> à rire."
                        }
                    ],
                    "synonyms": [
                        "susciter"
                    ],
                    "common_phrases": [
                        "prêter à confusion",
                        "prêter à rire",
                        "prêter à sourire"
                    ]
                },
                {
                    "sense_id": "8ce83812-f5da-3849-b218-0b3857b61b80",
                    "sense_definition": "Se révéler adapté, convenable ou favorable à un usage ou une activité déterminée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "se_preter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vaste clairière ombragée se <w>prête</w> parfaitement à l'organisation d'un pique-nique."
                        },
                        {
                            "text": "Le climat méditerranéen se <w>prête</w> admirablement à la culture des oliviers."
                        }
                    ],
                    "synonyms": [
                        "convenir"
                    ],
                    "common_phrases": [
                        "se prêter bien à"
                    ]
                },
                {
                    "sense_id": "6ad9b112-7a9f-3a0c-ab0d-4edcaa444fa8",
                    "sense_definition": "Accepter par complaisance de participer à quelque chose ou de s'y soumettre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "se_preter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'invité a accepté avec bonne humeur de se <w>prêter</w> au jeu des questions."
                        },
                        {
                            "text": "L'écrivain refuse catégoriquement de se <w>prêter</w> à cette mise en scène médiatique."
                        }
                    ],
                    "synonyms": [
                        "consentir",
                        "participer"
                    ],
                    "common_phrases": [
                        "se prêter au jeu"
                    ]
                }
            ]
        }
    ]
}