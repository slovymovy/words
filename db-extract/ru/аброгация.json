                                            {
                                                "example_id": "8b79cfef-2892-4d33-b8a2-469edb0d3051",
                                                "sense_id": "a581820b-593a-3cd7-af3d-e996470d1fc5",
                                                "text": "Die vollständige Abrogation des Gesetzes 122 führte zu einer riesigen Freude in der Bevölkerung."
                                            },
                                            {
                                                "example_id": "3a849fb8-62bd-47e9-a962-1747c5d815d4",
                                                "sense_id": "a581820b-593a-3cd7-af3d-e996470d1fc5",
                                                "text": "Die Abrogation durch das neue Gesetz wurde notwendig, da sich die Gesellschaft verändert hatte."
                                            }
