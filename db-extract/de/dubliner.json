                "senses": [
                    {
                        "sense_id": "cc642f7e-bbff-3fb6-8e2b-1131b7d8c977",
                        "entry_id": "daebe7f2-362d-3520-8722-e2c620774c38",
                        "glosses": [
                            "sich auf Dublin beziehend, aus Dublin kommend, zu Dublin gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f7226f4-698f-448b-8f13-8ad315b5028b",
                                "sense_id": "cc642f7e-bbff-3fb6-8e2b-1131b7d8c977",
                                "text": "„›Herrgott noch mal, hängst du an der Nabelschnur, oder was? Ist Graham deine Mami? Da er schon mal in England war, um dir die Windeln zu wechseln, hat er beschlossen, mit der Fähre nach Irland überzusetzen und das Land seiner Vorfahren zu besuchen. Wahrscheinlich steht er in diesem Moment im Dubliner Zoo, alles klar?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45bf3011-02ba-417d-b41f-87c30edbe789",
                        "source_entry_id": "daebe7f2-362d-3520-8722-e2c620774c38",
                        "source_sense_id": "cc642f7e-bbff-3fb6-8e2b-1131b7d8c977",
                        "source_sense_description": "aus Dublin kommend",
                        "target_lang_word": "dublinois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dublinois",
