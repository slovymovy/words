                "senses": [
                    {
                        "sense_id": "b36bff58-4b49-3753-a0d9-c9ff70f49130",
                        "entry_id": "b11cba4b-4a2c-3ccc-8082-b85b8df38483",
                        "glosses": [
                            "een verklaring die wordt afgegeven door een arts, en waarmee deze verklaart dat een bepaalde persoon is overleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ff250d9-2d14-4c5c-bcef-54e77a12320d",
                                "sense_id": "b36bff58-4b49-3753-a0d9-c9ff70f49130",
                                "text": "Ze herhaalde wat Stan had gezegd over hoe Joe was gestorven, en de arts was het met haar oordeel eens en zei dat hij haar een overlijdensverklaring zou sturen zodra het weer het toeliet."
                            },
                            {
                                "example_id": "aca9c47f-20ec-4209-989a-0498dc46f2a0",
                                "sense_id": "b36bff58-4b49-3753-a0d9-c9ff70f49130",
                                "text": "Rob Smit zou op 30 april zijn overleden, zo heeft de curator vernomen. \"Ik wist dat Smit problemen had met de bloedvaten.\" Een bloedprop in de hersenen zou de failliete ondernemer uiteindelijk fataal zijn geworden. Een overlijdensverklaring opgemaakt op de Filipijnen is voor Weenink niet voldoende. \"Wat dat betreft is de Filipijnen natuurlijk een knakenland.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13ed0b12-6bb1-43d6-a7d0-8da4c2de08eb",
                        "source_entry_id": "b11cba4b-4a2c-3ccc-8082-b85b8df38483",
                        "source_sense_id": "b36bff58-4b49-3753-a0d9-c9ff70f49130",
                        "source_sense_description": "een verklaring die wordt afgegeven door een arts, en waarmee deze verklaart dat een bepaalde persoon is overleden",
                        "target_lang_word": "Totenschein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totenschein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96263a3e-43ed-3637-be13-87a6e1e138ab",
                                        "entry_id": "56ec2951-e490-30c5-968d-549e6d152f0e",
                                        "glosses": [
                                            "eine durch einen Arzt ausgestellte Bescheinigung über den Tod einer Person, in der auch die Todesursache angegeben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fba925d-9927-4444-b8d5-3693224b9fc3",
                                                "sense_id": "96263a3e-43ed-3637-be13-87a6e1e138ab",
                                                "text": "Der Arzt stellt den Totenschein sofort nach der Leichenschau aus."
                                            },
                                            {
                                                "example_id": "b74daa65-b8a6-4657-92a2-3b491b949cd9",
                                                "sense_id": "96263a3e-43ed-3637-be13-87a6e1e138ab",
                                                "text": "„Fehlen Anhaltspunkte für einen nicht natürlichen Tod, und bestehen Zweifel an einem natürlichen Tod, so muß auf dem Totenschein vermerkt werden, daß die Todesart nicht aufgeklärt ist.“"
                                            },
                                            {
                                                "example_id": "2c1b562e-fd4f-44f4-953e-9ad42a25c8b9",
                                                "sense_id": "96263a3e-43ed-3637-be13-87a6e1e138ab",
                                                "text": "„Das Datum und die Umstände seines Todes sind auf dem Totenschein verzeichnet.“"
                                            },
                                            {
                                                "example_id": "06b9b410-ba80-429b-9a1e-a02c4be960c2",
                                                "sense_id": "96263a3e-43ed-3637-be13-87a6e1e138ab",
                                                "text": "„Niemals wurde ein Totenschein ausgestellt.“"
                                            },
                                            {
                                                "example_id": "57916f75-aef2-4ff7-bd5a-e19cdce696d7",
                                                "sense_id": "96263a3e-43ed-3637-be13-87a6e1e138ab",
                                                "text": "„Einige Wochen später wurde uns der Totenschein gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
