                            {
                                "example_id": "a001228d-cce6-4b8a-bed5-c6d4f546b54e",
                                "sense_id": "1cc82057-54ce-3df6-bf24-de834b0b239d",
                                "text": "Het gebrom werd luider, en de stofwolk onthulde een motard op een oude, zwartgelakte Harley Davidson. Hij parkeerde voor het terras, zette zijn helm af en kwam schuchter op hen toe: een oudere man in een zwart leren pak - rimpels, rossig haar, lichtblauwe ogen."
                            }
                        ]
                    },
