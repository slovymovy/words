                    },
                    {
                        "translation_id": "5b685652-a4a4-42cd-9380-cf09c066c941",
                        "source_entry_id": "b60a07cb-f149-37d2-b2e0-83a268f5f322",
                        "source_sense_id": "43531fa9-3777-33e4-ab6b-120ddef8c60e",
                        "source_sense_description": "koelen, bevochtigen of schoonmaken met een vochtige spons",
                        "target_lang_word": "sponge down",
