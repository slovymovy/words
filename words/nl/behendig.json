                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deftly",
                                "target_lang_sense_clarification": "in a quick, neat, and skillful way"
                            },
                            {
                                "target_lang_word": "skillfully",
                                "target_lang_sense_clarification": "with skill and expertise"
                            },
                            {
                                "target_lang_word": "nimbly",
                                "target_lang_sense_clarification": "in a nimble and agile manner"
                            },
                            {
                                "target_lang_word": "adroitly",
                                "target_lang_sense_clarification": "in a clever or skillful way"
                            }
