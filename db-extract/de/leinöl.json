                "senses": [
                    {
                        "sense_id": "898073bf-b3dc-3d27-bdc2-1d6c28c22e2c",
                        "entry_id": "7d874ac1-f748-3fc6-9753-3cdfebe15a83",
                        "glosses": [
                            "aus den Samen des Flachses gewonnenes Pflanzenöl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44562384-ede0-409e-ba4c-51086d2f4af1",
                                "sense_id": "898073bf-b3dc-3d27-bdc2-1d6c28c22e2c",
                                "text": "Leinöl wird zur Herstellung von Linoleum verwendet."
                            },
                            {
                                "example_id": "887cd5b6-e81b-49b3-a174-85ea43ed5041",
                                "sense_id": "898073bf-b3dc-3d27-bdc2-1d6c28c22e2c",
                                "text": "„Wem Leinöl zu bitter ist, dem empfiehlt die Kochbuchautorin, Leindotteröl zu probieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e012e2b-b729-4a95-8257-6d0b3afc40a8",
                        "source_entry_id": "7d874ac1-f748-3fc6-9753-3cdfebe15a83",
                        "source_sense_id": "898073bf-b3dc-3d27-bdc2-1d6c28c22e2c",
                        "source_sense_description": "aus den Samen des Flachses gewonnenes Pflanzenöl",
                        "target_lang_word": "huile de lin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huile de lin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1f0cece-4e08-38ef-a96f-2bb50485118e",
                                        "entry_id": "7e217aaa-fbbe-3293-b30d-f72e35a9f250",
                                        "glosses": [
                                            "Huile siccative tirée des graines du lin cultivé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e970d4ad-cf9a-4fb6-8f92-b59ebeb66c38",
                                                "sense_id": "b1f0cece-4e08-38ef-a96f-2bb50485118e",
                                                "text": "Mastic des vitriers. — Préparation et emploi. On prépare ce mastic de la manière suivante : « On prend du blanc d’Espagne en poudre, bien sec ; […] ; on verse de nouvelle huile de lin jusqu’à ce que le blanc soit tout à fait réduit en pâte ; […]."
                                            },
                                            {
                                                "example_id": "b9305b8f-fac8-4cbd-b056-5e2a44cb1d23",
                                                "sense_id": "b1f0cece-4e08-38ef-a96f-2bb50485118e",
                                                "text": "Je les enduisis d’huile de lin ocrée qui, en les rendant imperméables, les préservait de l’humidité des tropiques […]."
                                            },
                                            {
                                                "example_id": "ed52284e-e75e-4c89-a664-f2f18ae5db13",
                                                "sense_id": "b1f0cece-4e08-38ef-a96f-2bb50485118e",
                                                "text": "Les huiles de chenevis, presque toujours à des prix plus élevés que les huiles de lin, sont ordinairement fraudées avec ces dernières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
