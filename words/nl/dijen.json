                    "sense_definition": "in omvang toenemen of groter worden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "groei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stad bleef maar <w>dijen</w> door de constante stroom van nieuwe inwoners.",
                            "target_lang_translations": {
                                "en": "The city just kept <w>expanding</w> due to the constant flow of new residents.",
                                "ru": "Город продолжал <w>разрастаться</w> из-за постоянного потока новых жителей."
                            }
                        },
                        {
                            "text": "Zijn buik begon na de vakantie behoorlijk uit te <w>dijen</w>.",
                            "target_lang_translations": {
                                "en": "His belly started to <w>expand</w> considerably after the holiday.",
                                "ru": "Его живот начал прилично <w>увеличиваться</w> после отпуска."
                            }
                        }
                    ],
                    "synonyms": [
