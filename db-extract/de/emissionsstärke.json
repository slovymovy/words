                ],
                "senses": [
                    {
                        "sense_id": "a885512d-a640-3d75-b7a3-dfbfcf897a40",
                        "entry_id": "492de7bf-5995-3356-94f1-c16fa6da1085",
                        "glosses": [
                            "Grad/Maß für die Emission"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0725cc2c-ccb4-4aaf-b8fd-67bdc9e712ee",
                                "sense_id": "a885512d-a640-3d75-b7a3-dfbfcf897a40",
                                "text": "„Vergangene Vulkanausbrüche haben gezeigt, dass Emissionsstärken in dieser Größenordnung nicht ungewöhnlich sind.“"
                            },
                            {
                                "example_id": "f1d26faa-ab4d-4b96-9930-b5ca567423f2",
                                "sense_id": "a885512d-a640-3d75-b7a3-dfbfcf897a40",
                                "text": "„Wir haben die Emissionsstärke der Maschinen so weit isoliert, wie es technisch möglich ist, und fliegen mit minimaler Energie.“"
                            },
                            {
                                "example_id": "e13f9d3c-50d9-4b4c-8982-89c84009d1d5",
                                "sense_id": "a885512d-a640-3d75-b7a3-dfbfcf897a40",
                                "text": "„Leider stößt dies in den meisten Fällen auf Schwierigkeiten, da die Emissionsstärke der Quellen oft unbekannt ist.“"
                            },
                            {
                                "example_id": "1eb31c17-149c-4d8b-8a8c-91941256ad4d",
                                "sense_id": "a885512d-a640-3d75-b7a3-dfbfcf897a40",
                                "text": "„Entsprechend den Emissionsstärken sowie den Lebensdauern der Spurengase ergeben sich räumlich als auch zeitlich starke Variationen der Konzentrationen einzelner Verbindungen.“"
                            },
                            {
                                "example_id": "a06fd7d9-7fa7-4be3-a831-7dd179794f4a",
                                "sense_id": "a885512d-a640-3d75-b7a3-dfbfcf897a40",
                                "text": "„Die Emissionsstärken der wesentlichen Luftschadstoffe NO₂, PM₁₀ und C₆H₆ lassen sich in ähnlicher Weise ermitteln, wie es bereits unter 8|3|4 für den Luftschadstoff CO beschrieben wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
