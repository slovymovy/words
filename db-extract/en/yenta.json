                        "glosses": [
                            "A woman who meddles in the business of others; a busybody; a female gossipmonger."
                        ],
                        "tags": [
                            "Jewish"
                        ],
                        "examples": [
                            {
                                "example_id": "c9325cfd-ee87-4ec0-9fa6-faad64f4ea91",
                                "sense_id": "5861be74-191d-38b6-90d5-8bfb62d844a6",
                                "text": "Please don't tell your girlfriend what I said; she's a yenta!"
                            },
                            {
                                "example_id": "339231c4-2395-4b75-aea3-6a61ef928542",
                                "sense_id": "5861be74-191d-38b6-90d5-8bfb62d844a6",
                                "text": "And you had to marry that yenta West Side broad from a family of ward politicians and punchboard gamblers of candy-store kikes and sewer inspectors."
                            }
                        ]
                    }
