                                        "glosses": [
                                            "ein angedachtes Vorgehen für den zeitlichen Ablauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1e7f4a4-3564-4459-a865-8f489097f4f0",
                                                "sense_id": "145dc428-6710-3ed1-9615-71128e60dc08",
                                                "text": "Wir müssen den Zeitplan einhalten!"
                                            },
