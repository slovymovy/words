                    }
                ],
                "senses": [
                    {
                        "sense_id": "af19d1a7-6476-3871-be92-87f67674cd96",
                        "entry_id": "2f8d5007-a173-3ca2-966c-da21ef7ede20",
                        "glosses": [
                            "срезать пилой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29800ac2-e21a-407f-b624-7ac98548d87b",
                                "sense_id": "af19d1a7-6476-3871-be92-87f67674cd96",
                                "text": "Ни один коротышка не смог бы сорвать орех руками — их надо было пилить пилой. Грибы тоже пилили пилой. Спилят гриб под самый корень, потом распилят его на части и тащат по кусочкам домой."
                            }
                        ]
                    },
                    {
                        "sense_id": "a02ce1ab-6da6-320f-954b-8c334c953ea6",
                        "entry_id": "2f8d5007-a173-3ca2-966c-da21ef7ede20",
                        "glosses": [
                            "сгладить, сравнять напильником неровности на поверхности чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34a917df-1a2c-45c0-921c-908e918aaa6d",
                        "source_entry_id": "2f8d5007-a173-3ca2-966c-da21ef7ede20",
                        "source_sense_description": "срезать пилой",
                        "target_lang_word": "absägen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absägen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69353a30-c350-3c60-91a9-0a8776757d8e",
                                        "entry_id": "8d093ad4-cd49-32ba-8483-612bd0b5bdad",
                                        "glosses": [
                                            "mit einer Säge abtrennen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88d60c21-c238-46fc-8eae-d077b40456ee",
                                                "sense_id": "69353a30-c350-3c60-91a9-0a8776757d8e",
                                                "text": "Der Gärtner sägt einige abgestorbene Äste vom Baum ab."
                                            },
                                            {
                                                "example_id": "f9a9abe7-c874-424f-a421-8166bad94104",
                                                "sense_id": "69353a30-c350-3c60-91a9-0a8776757d8e",
                                                "text": "„Deshalb habe der Baumpfleger entschieden, die sechs Bäume ganz unten abzusägen.“"
                                            },
                                            {
                                                "example_id": "a60dca05-5304-4f16-be99-750e844793bf",
                                                "sense_id": "69353a30-c350-3c60-91a9-0a8776757d8e",
                                                "text": "„Er glaubt nicht, dass es ein politisches Motiv gegeben habe, die Skulptur abzusägen.“"
                                            },
                                            {
                                                "example_id": "7d4f4066-684b-4d55-a521-341daa46484e",
                                                "sense_id": "69353a30-c350-3c60-91a9-0a8776757d8e",
                                                "text": "„Ein unbekannter Täter hat zwölf Bäume aus einem Waldstück in der Nähe von Kindlas abgesägt und mitgenommen.“"
                                            },
                                            {
                                                "example_id": "0a0b8a8a-1d15-4063-936e-397887f0bceb",
                                                "sense_id": "69353a30-c350-3c60-91a9-0a8776757d8e",
                                                "text": "„Die Bäume, die demnächst abgesägt werden sollen, wurden bereits gelb markiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86553ece-1a49-3dc1-b6e7-8d0009b7e52a",
                                        "entry_id": "8d093ad4-cd49-32ba-8483-612bd0b5bdad",
                                        "glosses": [
                                            "jemanden bewusst aus einer Position drängen, jemanden gezielt scheitern lassen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4926d7d-9782-4f18-bdd2-59c0d0fe080d",
                                                "sense_id": "86553ece-1a49-3dc1-b6e7-8d0009b7e52a",
                                                "text": "Als der Abteilungsleiter unbequem wurde, sägten die Bosse ihn ab."
                                            },
                                            {
                                                "example_id": "ff943edb-bfa9-4d71-9224-bfc22554f8e2",
                                                "sense_id": "86553ece-1a49-3dc1-b6e7-8d0009b7e52a",
                                                "text": "Der Professor hat zahlreiche Studenten abgesägt."
                                            },
                                            {
                                                "example_id": "20f53a90-11b2-4a71-b9ba-c2ac8600c450",
                                                "sense_id": "86553ece-1a49-3dc1-b6e7-8d0009b7e52a",
                                                "text": "„Außerdem wurde er gerade als Kapitän bei Schalke abgesägt.“"
                                            },
                                            {
                                                "example_id": "241582a5-9037-464f-80d5-f45113908b85",
                                                "sense_id": "86553ece-1a49-3dc1-b6e7-8d0009b7e52a",
                                                "text": "„Sie erklärt sein Durchfallen noch: ‚Das lag auch an den Lehrern. Die haben ihn richtig abgesägt‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
