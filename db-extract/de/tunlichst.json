                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b817e5-7206-42b1-9ad4-afcfcf980923",
                                "sense_id": "378e9fd8-1bcc-39af-a796-56527aac460a",
                                "text": "Das sollten wir tunlichst vermeiden.",
                                "translation": "We should definitely avoid that.",
                                "english": "We should definitely avoid that."
                            },
                            {
                                "example_id": "2e59e85a-b3f1-4c76-8a36-375590e12bdb",
                                "sense_id": "378e9fd8-1bcc-39af-a796-56527aac460a",
                                "text": "Außerdem sollten die Begriffe Euro, EM 2024 oder Uefa auf Werbebannern oder Hinweisschildern tunlichst vermieden werden – die sind nämlich urheberrechtlich geschützt und würden eine weitere stattliche Gebühr nach sich ziehen.",
                                "translation": "Also, the terms \"Euro\", \"EM 2024\" or \"Uefa\" should definitely be avoided on banners or information signs - they are protected by copyright and can lead to a significant additional fee.",
                                "english": "Also, the terms \"Euro\", \"EM 2024\" or \"Uefa\" should definitely be avoided on banners or information signs - they are protected by copyright and can lead to a significant additional fee."
                            }
                        ]
