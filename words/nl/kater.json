                    "sense_definition": "het beroerde gevoel dat men heeft de dag nadat men te veel alcohol heeft gedronken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "welzijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het feestje van gisteravond werd hij wakker met een enorme <w>kater</w>.",
                            "target_lang_translations": {
                                "en": "After last night's party, he woke up with a huge <w>hangover</w>."
                            }
                        },
                        {
                            "text": "Hij probeerde zijn <w>kater</w> weg te drinken met veel water en een stevig ontbijt.",
                            "target_lang_translations": {
                                "en": "He tried to drink away his <w>hangover</w> with plenty of water and a hearty breakfast."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een enorme kater",
                        "een kater hebben"
                    ],
                    "target_lang_definitions": {
                        "en": "the miserable feeling one has the day after drinking too much alcohol"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hangover",
                                "target_lang_sense_clarification": "physical illness after drinking"
                            }
                        ]
