{
    "word_family": [
        "zamykać",
        "zamknięcie",
        "zamknięty",
        "niezamknięty",
        "zamek"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87f8726a-0b7b-37bf-b084-1ae9a1b6d05d",
                    "sense_definition": "sprawić, że coś przestaje być otwarte, zasłaniając lub przykrywając otwór",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fizyczne_zamknięcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Robercie, <w>zamknij</w> okno, bo jest zimno na dworze.",
                            "target_lang_translations": {
                                "ru": "Роберт, <w>закрой</w> окно, потому что на улице холодно."
                            }
                        },
                        {
                            "text": "Przeczytała ostatnią stronę powieści i powoli <w>zamknęła</w> książkę.",
                            "target_lang_translations": {
                                "ru": "Она дочитала последнюю страницу романа и медленно <w>закрыла</w> книгу."
                            }
                        }
                    ],
                    "synonyms": [
                        "przymknąć"
                    ],
                    "antonyms": [
                        "otworzyć"
                    ],
                    "common_phrases": [
                        "zamknąć okno",
                        "zamknąć drzwi",
                        "zamknąć książkę",
                        "zamknąć oczy"
                    ],
                    "target_lang_definitions": {
                        "ru": "прикрыть отверстие или соединить края чего-либо, сделав его закрытым"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "окно, дверь, книгу, глаза"
                            },
                            {
                                "target_lang_word": "сомкнуть",
                                "target_lang_sense_clarification": "глаза, веки, губы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6f41553-be6c-3294-aad7-eb82c6b5d479",
                    "sense_definition": "zabezpieczyć wejście lub pojemnik przed otwarciem za pomocą zamka lub klucza",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fizyczne_zamknięcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy <w>zamknąłeś</w> drzwi na oba zamki, wychodząc z domu?",
                            "target_lang_translations": {
                                "ru": "Ты <w>запер</w> дверь на оба замка, выходя из дома?"
                            }
                        },
                        {
                            "text": "Zawsze starannie <w>zamknij</w> walizkę przed oddaniem jej na lotnisku.",
                            "target_lang_translations": {
                                "ru": "Всегда тщательно <w>запирай</w> чемодан перед сдачей его в аэропорту."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaryglować"
                    ],
                    "antonyms": [
                        "otworzyć"
                    ],
                    "common_phrases": [
                        "zamknąć na klucz",
                        "zamknąć na kłódkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "зафиксировать вход или ёмкость с помощью замка или ключа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запереть",
                                "target_lang_sense_clarification": "на ключ, замок или щеколду"
                            },
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "на замок, на ключ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d044da48-e31f-3541-91f0-93b5baa66237",
                    "sense_definition": "przerwać lub zakończyć działalność instytucji, lokalu, sklepu bądź firmy",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zakończenie_działania",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziś muzeum <w>zamknięto</w> o godzinie siedemnastej z powodu remontu.",
                            "target_lang_translations": {
                                "ru": "Сегодня музей <w>закрыли</w> в семнадцать часов из-за ремонта."
                            }
                        },
                        {
                            "text": "Właściciel małej piekarni zdecydował, że wkrótce <w>zamknie</w> swój interes.",
                            "target_lang_translations": {
                                "ru": "Владелец небольшой пекарни решил, что скоро <w>закроет</w> свой бизнес."
                            }
                        }
                    ],
                    "synonyms": [
                        "zlikwidować"
                    ],
                    "antonyms": [
                        "otworzyć"
                    ],
                    "common_phrases": [
                        "zamknąć sklep",
                        "zamknąć firmę"
                    ],
                    "target_lang_definitions": {
                        "ru": "временно или окончательно прекратить деятельность заведения, предприятия или учреждения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "магазин, предприятие, организацию"
                            },
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "окончательно упразднить бизнес или фирму"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b77747e-5fc4-356f-97ac-f4b7b5bc6f49",
                    "sense_definition": "zakończyć działanie programu komputerowego, aplikacji lub systemu operacyjnego",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "informatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyłączeniem komputera upewnij się, że <w>zamknąłeś</w> przeglądarkę internetową.",
                            "target_lang_translations": {
                                "ru": "Перед выключением компьютера убедись, что ты <w>закрыл</w> интернет-браузер."
                            }
                        },
                        {
                            "text": "Program przestał odpowiadać, więc musiałem na siłę go <w>zamknąć</w>.",
                            "target_lang_translations": {
                                "ru": "Программа перестала отвечать, поэтому мне пришлось принудительно её <w>закрыть</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyłączyć"
                    ],
                    "antonyms": [
                        "uruchomić",
                        "otworzyć"
                    ],
                    "common_phrases": [
                        "zamknąć program",
                        "zamknąć aplikację",
                        "zamknąć kartę"
                    ],
                    "target_lang_definitions": {
                        "ru": "завершить работу компьютерной программы, вкладки или приложения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "программу, окно, вкладку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cf1e293-0a8c-3735-8be2-ebe6c4a58e6d",
                    "sense_definition": "doprowadzić sprawę, dyskusję lub etap do końca",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zakończenie_działania",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przewodniczący podziękował wszystkim za obecność i oficjalnie <w>zamknął</w> posiedzenie.",
                            "target_lang_translations": {
                                "ru": "Председатель поблагодарил всех за присутствие и официально <w>закрыл</w> заседание."
                            }
                        },
                        {
                            "text": "Musimy jak najszybciej <w>zamknąć</w> ten projekt, aby przejść do kolejnych zadań.",
                            "target_lang_translations": {
                                "ru": "Нам нужно как можно быстрее <w>закрыть</w> этот проект, чтобы перейти к следующим задачам."
                            }
                        }
                    ],
                    "synonyms": [
                        "zakończyć",
                        "sfinalizować"
                    ],
                    "antonyms": [
                        "otworzyć"
                    ],
                    "common_phrases": [
                        "zamknąć dyskusję",
                        "zamknąć temat",
                        "zamknąć posiedzenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "довести дело, тему или заседание до конца; подвести итог"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "тему, вопрос, проект, заседание"
                            },
                            {
                                "target_lang_word": "завершить",
                                "target_lang_sense_clarification": "окончить проект или обсуждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "235935eb-ad70-33b2-bc4c-0b6ac15f1a29",
                    "sense_definition": "pozbawić wolności, umieszczając w areszcie lub więzieniu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pozbawienie_wolności",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policjanci po długim śledztwie <w>zamknęli</w> niebezpiecznych handlarzy narkotyków.",
                            "target_lang_translations": {
                                "ru": "Полицейские после долгого расследования <w>посадили</w> опасных наркоторговцев."
                            }
                        },
                        {
                            "text": "Sąd uznał go za winnego i zdecydował, że <w>zamkną</w> go na pięć lat.",
                            "target_lang_translations": {
                                "ru": "Суд признал его виновным и решил, что его <w>закроют</w> на пять лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "aresztować",
                        "uwięzić"
                    ],
                    "antonyms": [
                        "wypuścić"
                    ],
                    "common_phrases": [
                        "zamknąć w więzieniu",
                        "zamknąć w areszcie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "w odniesieniu do aresztowania lub uwięzienia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "лишить свободы, поместив под стражу или в тюрьму"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "разг., посадить в тюрьму или под арест"
                            },
                            {
                                "target_lang_word": "посадить",
                                "target_lang_sense_clarification": "в тюрьму, под стражу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7151a9de-5063-31e3-b21a-eaeea627400e",
                    "sense_definition": "zatrzasnąć się lub ulec zamknięciu, przestając być otwartym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczne_zamknięcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pod wpływem silnego przeciągu drzwi wejściowe nagle <w>zamknęły</w> się z trzaskiem.",
                            "target_lang_translations": {
                                "ru": "От сильного сквозняка входная дверь неожиданно с грохотом <w>захлопнулась</w>."
                            }
                        },
                        {
                            "text": "Brama automatyczna powoli się <w>zamknęła</w>, gdy samochód opuścił posesję.",
                            "target_lang_translations": {
                                "ru": "Автоматические ворота медленно <w>закрылись</w>, когда машина покинула территорию."
                            }
                        }
                    ],
                    "synonyms": [
                        "zatrzasnąć się"
                    ],
                    "antonyms": [
                        "otworzyć się"
                    ],
                    "common_phrases": [
                        "drzwi się zamknęły"
                    ],
                    "target_lang_definitions": {
                        "ru": "перестать быть открытым; захлопнуться или сойтись (о створках, дверях)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрыться",
                                "target_lang_sense_clarification": "о дверях, окнах, воротах"
                            },
                            {
                                "target_lang_word": "захлопнуться",
                                "target_lang_sense_clarification": "резко закрыться с шумом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7266659f-9c50-3636-bfa7-5b45e2fecc94",
                    "sense_definition": "przestać mówić, zamilknąć lub uciszyć się",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mowa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zamknij</w> się wreszcie, bo już nie mogę słuchać twojego ciągłego narzekania!",
                            "target_lang_translations": {
                                "ru": "<w>Заткнись</w> наконец, я больше не могу слушать твоё постоянное нытьё!"
                            }
                        },
                        {
                            "text": "Kiedy nauczyciel wszedł do klasy, hałaśliwi uczniowie natychmiast się <w>zamknęli</w>.",
                            "target_lang_translations": {
                                "ru": "Когда учитель вошёл в класс, шумные ученики тут же <w>замолчали</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zamilknąć",
                        "uciszyć się"
                    ],
                    "common_phrases": [
                        "zamknąć się wreszcie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "zwrot dosadny lub niegrzeczny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "замолчать, перестать говорить (часто в грубой или резкой форме)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заткнуться",
                                "target_lang_sense_clarification": "груб., замолчать"
                            },
                            {
                                "target_lang_word": "замолчать",
                                "target_lang_sense_clarification": "прекратить говорить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7424555-4be9-3aba-91ec-ecdceda1ec7b",
                    "sense_definition": "odizolować się od otoczenia, nie ujawniając emocji ani myśli",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "psychologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po ostatnim niepowodzeniu całkowicie <w>zamknął</w> się w sobie i unikał rozmów.",
                            "target_lang_translations": {
                                "ru": "После последней неудачи он окончательно <w>замкнулся в себе</w> и избегал разговоров."
                            }
                        },
                        {
                            "text": "Zamiast szukać pomocy u przyjaciół, ona znów się <w>zamknęła</w> przed światem.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы искать помощи у друзей, она снова <w>закрылась</w> от мира."
                            }
                        }
                    ],
                    "antonyms": [
                        "otworzyć się"
                    ],
                    "common_phrases": [
                        "zamknąć się w sobie"
                    ],
                    "target_lang_definitions": {
                        "ru": "психологически обособиться, перестать идти на контакт и делиться переживаниями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замкнуться",
                                "target_lang_sense_clarification": "уйти в себя, отдалиться от окружающих"
                            },
                            {
                                "target_lang_word": "закрыться",
                                "target_lang_sense_clarification": "стать скрытным, эмоционально недоступным"
                            },
                            {
                                "target_lang_word": "уйти в себя",
                                "target_lang_sense_clarification": "погрузиться в свои переживания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94409733-f338-3515-9c00-fd33f5e86b5b",
                    "sense_definition": "znaleźć się na ostatniej pozycji zestawienia, listy bądź kolejki",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zakończenie_działania",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tę długą listę zakupów ostatecznie <w>zamknęła</w> puszka sardynek w oleju.",
                            "target_lang_translations": {
                                "ru": "Этот длинный список покупок в итоге <w>замкнула</w> банка сардин в масле."
                            }
                        },
                        {
                            "text": "Zawodnik z numerem siódmym <w>zamknął</w> stawkę biegu finałowego.",
                            "target_lang_translations": {
                                "ru": "Спортсмен под седьмым номером <w>замкнул</w> группу участников финального забега."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwieńczyć"
                    ],
                    "antonyms": [
                        "otworzyć"
                    ],
                    "common_phrases": [
                        "zamknąć listę",
                        "zamknąć stawkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "оказаться на последней позиции в списке, перечне или группе участников"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замкнуть",
                                "target_lang_sense_clarification": "список, шествие, группу участников"
                            },
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "список, перечень"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}