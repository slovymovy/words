                        "sense_id": "c9d1bc94-9a3c-3534-9331-60b73bf7a21c",
                        "entry_id": "96b2b825-0833-3aba-b2c7-50f87c1b67d8",
                        "glosses": [
                            "instrument dat een signaal afgeeft als iets van plaats verandert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76861040-c620-4b3c-90b7-6281b44110f0",
                                "sense_id": "c9d1bc94-9a3c-3534-9331-60b73bf7a21c",
                                "text": "Een bewegingssensor zorgt ervoor dat een bepaald object in werking treedt wanneer de sensor beweging ziet."
                            },
                            {
                                "example_id": "841a1e8d-36f9-4807-8e68-f747ac5150f4",
                                "sense_id": "c9d1bc94-9a3c-3534-9331-60b73bf7a21c",
                                "text": "Bewegingssensoren worden vaak gebruikt bij binnenverlichting. Hierdoor zal een lamp automatisch aan gaan wanneer er iemand de kamer binnen komt lopen."
                            },
                            {
                                "example_id": "fe42bd18-863a-4a6d-b64f-a552c6082120",
                                "sense_id": "c9d1bc94-9a3c-3534-9331-60b73bf7a21c",
                                "text": "Je kent ze vast wel, lampen die aangaan wanneer er iemand in de buurt van komt. Dit komt omdat er een bewegingssensor in de lamp is ingebouwd."
                            },
                            {
                                "example_id": "b9e7731e-562d-45dd-b986-28e48a4ff0d1",
                                "sense_id": "c9d1bc94-9a3c-3534-9331-60b73bf7a21c",
                                "text": "Microscopisch kleine bewegingssensors op het lichaam moeten atleten en coaches nieuwe inzichten geven in de juiste houding en beweging."
                            }
                        ]
                    }
                ],
