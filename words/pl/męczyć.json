{
    "word_family": [
        "zmęczenie",
        "zmęczony",
        "męka",
        "męczący"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7fb3c8a0-29b5-338b-b685-35f554f498c7",
                    "sense_definition": "powodować u kogoś utratę sił, wyczerpanie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zmęczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Długa praca przy komputerze bardzo <w>męczy</w> wzrok.",
                            "target_lang_translations": {
                                "ru": "Долгая работа за компьютером сильно <w>утомляет</w> зрение."
                            }
                        },
                        {
                            "text": "Ciągłe bieganie za dziećmi <w>męczy</w> rodziców.",
                            "target_lang_translations": {
                                "ru": "Постоянная беготня за детьми <w>утомляет</w> родителей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "męczyć wzrok",
                        "męczyć organizm"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать утомление, истощение или напряжение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утомлять",
                                "target_lang_sense_clarification": "вызывать чувство усталости"
                            },
                            {
                                "target_lang_word": "напрягать",
                                "target_lang_sense_clarification": "вызывать перенапряжение (например, зрения)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a571cd25-0537-3553-b232-89e495b421cc",
                    "sense_definition": "tracić siły, stawać się zmęczonym",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zmęczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szybko <w>męczę</w> się podczas biegania.",
                            "target_lang_translations": {
                                "ru": "Я быстро <w>устаю</w> во время бега."
                            }
                        },
                        {
                            "text": "Nigdy nie <w>męczę</w> się czytaniem książek.",
                            "target_lang_translations": {
                                "ru": "Я никогда не <w>устаю</w> от чтения книг."
                            }
                        }
                    ],
                    "common_phrases": [
                        "męczyć się szybko"
                    ],
                    "target_lang_definitions": {
                        "ru": "терять силы, становиться утомленным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уставать",
                                "target_lang_sense_clarification": "становиться утомленным"
                            },
                            {
                                "target_lang_word": "мучиться",
                                "target_lang_sense_clarification": "испытывать трудности или страдания при выполнении чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c915d6d-1617-3ad2-8e91-e37695101375",
                    "sense_definition": "nieustannie o coś prosić lub zwracać uwagę, irytować",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "irytacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie <w>męcz</w> mnie już tymi pytaniami.",
                            "target_lang_translations": {
                                "ru": "Не <w>донимай</w> меня больше этими вопросами."
                            }
                        },
                        {
                            "text": "Dzieci <w>męczą</w> rodziców o nową zabawkę.",
                            "target_lang_translations": {
                                "ru": "Дети <w>мучают</w> родителей просьбами о новой игрушке."
                            }
                        }
                    ],
                    "synonyms": [
                        "nękać"
                    ],
                    "common_phrases": [
                        "męczyć kogoś o coś"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "постоянно просить о чем-то или раздражать настойчивостью"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донимать",
                                "target_lang_sense_clarification": "надоедать, докучать"
                            },
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "раздражать настойчивыми просьбами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cb81f19-9c30-381c-ad04-cab27e9b3d1f",
                    "sense_definition": "zadawać komuś cierpienie fizyczne lub psychiczne",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cierpienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wspomnienia o przeszłości <w>męczą</w> go każdej nocy.",
                            "target_lang_translations": {
                                "ru": "Воспоминания о прошлом <w>мучают</w> его каждую ночь."
                            }
                        },
                        {
                            "text": "Nie pozwól, aby strach <w>męczył</w> cię po nocach.",
                            "target_lang_translations": {
                                "ru": "Не позволяй страху <w>мучить</w> тебя по ночам."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причинять кому-либо физические или душевные страдания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "причинять страдания"
                            },
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "сильно беспокоить, причинять душевную боль"
                            }
                        ]
                    },
                    "synonyms": [
                        "dręczyć"
                    ]
                }
            ]
        }
    ]
}