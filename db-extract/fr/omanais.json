                "senses": [
                    {
                        "sense_id": "fd7e4f04-3bb1-3c0b-893a-226a6e2c2bd5",
                        "entry_id": "aafcdc10-cedb-3189-b5db-eb0cf92dc2cd",
                        "glosses": [
                            "Habitant ou natif d’Oman ^([1]) ^([2])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc84ace-466f-41be-bfcc-8d11a27eda13",
                                "sense_id": "fd7e4f04-3bb1-3c0b-893a-226a6e2c2bd5",
                                "text": "Si tous les enfants vivant en Oman sont obligatoirement scolarisés, l’éducation n’est gratuite que pour les Omanais, tout comme les soins médicaux dispensés dans les hôpitaux, l’État omanais ne jouant le rôle d’État providence qu’envers ses propres citoyens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9027781-8304-45ad-88a0-7caca14007f1",
                        "source_entry_id": "aafcdc10-cedb-3189-b5db-eb0cf92dc2cd",
                        "source_sense_id": "fd7e4f04-3bb1-3c0b-893a-226a6e2c2bd5",
                        "target_lang_word": "Omaner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Omaner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14f66e3f-dcdf-3c71-850d-7b07cf2e2ae9",
                                        "entry_id": "4908328e-30fa-327e-98b1-7a49349a3c96",
                                        "glosses": [
                                            "Staatsbürger von Oman"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1098a28c-70bb-45dd-9006-54a60999f4a6",
                                                "sense_id": "14f66e3f-dcdf-3c71-850d-7b07cf2e2ae9",
                                                "text": "„Jahrhundertelang beherrschten die Omaner mit ihren Daus weite Teile des Arabischen und des Indischen Meeres.“"
                                            },
                                            {
                                                "example_id": "d7645fa1-1d38-4cd6-98ce-a0812bcf3421",
                                                "sense_id": "14f66e3f-dcdf-3c71-850d-7b07cf2e2ae9",
                                                "text": "„Weltoffen sind die Omaner stets gewesen. Von der Einführung der Sharia, der Moralgesetze des Koran, in die weltliche Justiz, wie Saudi-Arabien es vorexerziert hat, halten sie nichts.“"
                                            },
                                            {
                                                "example_id": "d85dac59-799e-49aa-8fa4-2c36ecd0c0df",
                                                "sense_id": "14f66e3f-dcdf-3c71-850d-7b07cf2e2ae9",
                                                "text": "„Etwa ab 1650 beherrschten die Omaner mit ihren Dhaus die arabische und vorderindischen Meere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
