                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9298a21-b1f3-4087-b6c3-691ca1e4875c",
                                "sense_id": "4d574a2d-3231-3ee2-b4f1-02e416c4881f",
