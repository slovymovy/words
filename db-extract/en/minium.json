                    {
                        "translation_id": "506d5696-5fdf-4157-93cf-497f07803823",
                        "source_entry_id": "53738106-f597-3fb1-a3ca-cbd22802160d",
                        "source_sense_description": "red lead",
                        "target_lang_word": "су́рик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "су́рик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "71dab449-cdb4-3c54-9b6d-8f7c0a5f7fcb",
                                        "entry_id": "cd0525fd-b6a9-3158-9406-ebe2fa6a7f52",
                                        "glosses": [
                                            "геол. минерал (Pb₃O₄), окись с закисью свинца, встречающаяся иногда в свинцовых рудах; желтовато-красный порошок, употребляющийся как краска для приготовления свинцового стекла, фаянсовой глазури и т. д."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d3be4d-aa62-465b-9e11-b09c5e24222a",
                                                "sense_id": "71dab449-cdb4-3c54-9b6d-8f7c0a5f7fcb",
                                                "text": "Одинаковое с свинцовой окисью санитарное значение имеет сурик (соединение свинцовой окиси с перекисью свинца), также употребляемый в упомянутых производствах."
                                            },
                                            {
                                                "example_id": "7ff19f68-be7e-4b43-9189-c5869212708e",
                                                "sense_id": "71dab449-cdb4-3c54-9b6d-8f7c0a5f7fcb",
                                                "text": "Для составления активной массы обычно применяют свинцовый сурик (перекись свинца) и свинцовый глет (окись свинца), причем для положительных пластин лучше применять массу с преобладанием сурика, для отрицательных же ― с преобладанием глета."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "167a6bc9-21b8-3536-a390-2bc8f06a5dd4",
                                        "entry_id": "cd0525fd-b6a9-3158-9406-ebe2fa6a7f52",
                                        "glosses": [
                                            "природная минеральная краска красно-оранжевого или красно-коричневого цвета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf256d5-3a28-4bf1-9b77-8b100a4ab59d",
                                                "sense_id": "167a6bc9-21b8-3536-a390-2bc8f06a5dd4",
                                                "text": "Карманы у него полны охры, синьки, сурика, медянки; не заплатив ни копейки, он опрометью выбегает из одной лавки и бежит в другую."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
