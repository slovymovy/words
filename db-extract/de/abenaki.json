                                "sense_id": "46655c0c-1db0-3cc5-bed3-c78b1153c939",
                                "text": "„Unter unsern Voyageurs befand sich ein Abenaki, Namens Pierre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
