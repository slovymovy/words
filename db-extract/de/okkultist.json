                "senses": [
                    {
                        "sense_id": "e52b7a1a-319d-30c3-a27b-720dc2218f8d",
                        "entry_id": "a5dfba90-f3c2-32a5-b562-2137195a247a",
                        "glosses": [
                            "Anhänger des Okkultismus, der Lehre von außer- oder übersinnlichen Kräften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3595c1dc-15b3-4bbd-9e24-e39bf712624a",
                                "sense_id": "e52b7a1a-319d-30c3-a27b-720dc2218f8d",
                                "text": "„Zu allen Zeiten beschäftigten sich Philosophen, Mystiker und Okkultisten mit dem inneren Aufbau der sichtbaren Welt, ihrer Abstufung und Beschaffenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fba489a-d3e2-45b0-a859-15c6622764d4",
                        "source_entry_id": "a5dfba90-f3c2-32a5-b562-2137195a247a",
                        "source_sense_id": "e52b7a1a-319d-30c3-a27b-720dc2218f8d",
                        "source_sense_description": "Anhänger des Okkultismus, der Lehre von außer- oder übersinnlichen Kräften",
                        "target_lang_word": "occultist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occultist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff6805b-b230-396f-b444-9239cd41b717",
                                        "entry_id": "651501de-d21b-305b-9bde-177bb28ff1b0",
                                        "glosses": [
                                            "A person who practises or studies occultism; a practitioner of, or person learned in, the occult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a49e8a3-9f2f-4702-aee7-27213cf801cb",
                                                "sense_id": "3ff6805b-b230-396f-b444-9239cd41b717",
                                                "text": "Albertus Magnus, the thirteenth century philosopher and occultist, states that coriander, valerian, and violet are love producing herbs."
                                            },
                                            {
                                                "example_id": "860c63db-1995-4a88-8f17-38b23247a727",
                                                "sense_id": "3ff6805b-b230-396f-b444-9239cd41b717",
                                                "text": "In the early 1930s, he fell under the spell of a wife-beating, alcoholic, Austrian occultist called Karl Maria Wiligut and a Dutch prehistorian called Herman Wirth, whose views further fed his fantastical illusions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
