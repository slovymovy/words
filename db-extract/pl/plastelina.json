                                "target_senses": [
                                    {
                                        "sense_id": "7d5af812-cb76-39ee-a350-2c53fbdc31e4",
                                        "entry_id": "6f19ac72-8c30-317f-882b-ec22b64ab767",
                                        "glosses": [
                                            "Modeling clay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72145126-b75e-4afa-8b34-f3e5badd1b76",
                                                "sense_id": "7d5af812-cb76-39ee-a350-2c53fbdc31e4",
                                                "text": "Models; how to make paper pulp models; salt and flour models; sand models; plasticine models; chalk and pencil models."
                                            },
                                            {
                                                "example_id": "210d9355-b4f8-402a-b2e1-f9db3ef72253",
                                                "sense_id": "7d5af812-cb76-39ee-a350-2c53fbdc31e4",
                                                "text": "Hermione Roddice suggested we should ask Gudrun to teach her to draw and to model in clay. You know Winnie is astonishingly clever with that plasticine stuff. Hermione declares she is an artist."
                                            },
                                            {
                                                "example_id": "90b11c8c-295d-49c9-be24-2f2c46875209",
                                                "sense_id": "7d5af812-cb76-39ee-a350-2c53fbdc31e4",
                                                "text": "Picture yourself on a train in a station / With plasticine porters with looking glass ties"
                                            }
                                        ]
                                    }
