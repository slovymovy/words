                    },
                    {
                        "translation_id": "841245a0-07fb-47fe-804c-6f8db9461ba9",
                        "source_entry_id": "a11ee47e-3ddc-30de-b443-9be5aef8bb9b",
                        "source_sense_id": "37e2127f-3d84-3c94-85c1-3d8e78d326ed",
                        "target_lang_word": "Adressant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adressant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a704ba92-1142-33f8-93cb-674364ba29ee",
                                        "entry_id": "3ab89a7e-263c-3040-ba35-5e9e3245bda5",
                                        "glosses": [
                                            "Person, die etwas sendet"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d31cc59b-aefa-48b9-9ebb-317fdbe747fe",
                                                "sense_id": "a704ba92-1142-33f8-93cb-674364ba29ee",
                                                "text": "„Der neue Vertrag wird abgeschlossen, indem der Adressant (Zar) dem Subjekt-Adressaten (Held) das Objekt der Suche (Zarentochter) anbietet.“"
                                            },
                                            {
                                                "example_id": "69fde5d9-b720-4a00-8ba6-cb91f47e0aa7",
                                                "sense_id": "a704ba92-1142-33f8-93cb-674364ba29ee",
                                                "text": "„Weitere Anzeichen dafür, daß der Adressant und somit der fiktive Autor dieses Briefs der Bodhisattva Avalokiteśvara ist, sind: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
