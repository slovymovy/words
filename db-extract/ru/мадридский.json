                    {
                        "translation_id": "761f0221-f46d-4aa0-9862-c875cc238a63",
                        "source_entry_id": "d495098d-9f9d-3292-89f7-ca15c1f02fd4",
                        "target_lang_word": "madrilenisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madrilenisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                        "entry_id": "83601af5-6809-3005-a41b-484434b1822b",
                                        "glosses": [
                                            "zur spanischen Hauptstadt Madrid oder seinen Bewohnern gehörig, sie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c67f3f5-5457-4606-96b1-41abe00441b2",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "In der madrilenischen Metrostation Legazpi wurde am Sonntag, den 11. November, ein 20-jähriger so genannter „Red Skin“ mutmaßlich von einem Neonazi mit einem Jagdmesser erstochen."
                                            },
                                            {
                                                "example_id": "875aa644-d277-4b15-bb12-e35d95fd8901",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "[Nuri Sahin wird] es angesichts des Überangebotes von Weltklasse im madrilenischen Mittelfeld schwer haben, einen Stammplatz zu ergattern."
                                            },
                                            {
                                                "example_id": "dc4a2202-5505-41f8-9383-467a700f23d8",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "Dreimal Real Madrid, einmal FC Barcelona: Die Champions League ist derzeit spanisch, zumeist madrilenisch."
                                            },
                                            {
                                                "example_id": "0d671772-9c7b-4467-8145-087c21242136",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "Madrilenische Tapas enthalten alle Köstlichkeiten der gesamten spanischen Küche, wie Meeresfrüchte, Schinken und Wurstwaren, eingelegte Gemüse, Kartoffelgerichte oder Käse."
                                            },
                                            {
                                                "example_id": "7275ff68-cd2b-4b18-81b8-79e842554365",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "So sehr das Buch eine gewisse soziale Allgemeingütigkeit beansprucht, bleibt es doch sehr spanisch, sehr madrilenisch sogar, in den geschilderten Lebensgewohnheiten, Umgangsformen und Familienstrukturen."
                                            },
                                            {
                                                "example_id": "bd2446ca-5011-4415-9428-772d9869e694",
                                                "sense_id": "b32f74a7-8ef9-3422-902f-e038deca1760",
                                                "text": "„Junger Mann, nicht nur das Schweigen des madrilenischen, nein, noch mehr das des japanischen Hofes beunruhigen mich ein wenig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
