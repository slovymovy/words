                        "examples": [
                            {
                                "example_id": "6f39ce3e-d353-4753-a7d5-40e219b0aa64",
                                "sense_id": "0cfa8986-4d3a-3692-8105-39e69283bdac",
                                "text": "It demanded taxes, which in a cashless society meant grain, cattle and, most tellingly, labor."
                            },
                            {
                                "example_id": "ab2e16c3-f92d-4b24-960d-f4d6d47b19f5",
                                "sense_id": "0cfa8986-4d3a-3692-8105-39e69283bdac",
                                "text": "Most tellingly, the recipe from Causes and Cures prescribes a vinegared wine but the recipe from Physica prescribes vinegar or wine, yet when the explanation of how the medicine works is given, in both passages it has been assumed that the ingredient of the Causes and Cures’ version (vinegared wine) not that of Physica (vinegar or wine) was used."
                            }
                        ]
                    }
