            {
                "entry_id": "5ea5ab34-bb5a-3867-847e-488611454306",
                "word": "belvedere",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "047c3aa7-1768-42f3-a26e-f5f578aefad9",
                        "entry_id": "5ea5ab34-bb5a-3867-847e-488611454306",
                        "tags": [
                            "plural"
                        ],
                        "form": "belvederes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81063be3-68bd-3103-978a-6a4636e2ba30",
                        "entry_id": "5ea5ab34-bb5a-3867-847e-488611454306",
                        "glosses": [
                            "A turret or other raised structure offering a pleasant view of the surrounding area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afaa9a32-5b43-4381-818d-3d2bba3c4863",
                                "sense_id": "81063be3-68bd-3103-978a-6a4636e2ba30",
                                "text": "“One evening,” she went on, “while Madame Orio was fast asleep in her little belvedere (it being the good old lady's habit to repair there to rest after a bottle or two of red Padua wine), Manette and Marton left the widow's house noiselessly in the Campo San Zobenigo, and made their way running towards the Piazza of St. Mark's.”"
                            },
                            {
                                "example_id": "7eb004a0-b9c5-453b-a4bd-f9a600e2a745",
                                "sense_id": "81063be3-68bd-3103-978a-6a4636e2ba30",
                                "text": "The most important thing, she reflected, as she stood on the balcony of the Mairie which formed a most useful belvedere over the town, was to make her appearance as commonplace and down at heel as possible […]."
                            },
                            {
                                "example_id": "9572e024-7ec1-47b5-b219-f30e627fd293",
                                "sense_id": "81063be3-68bd-3103-978a-6a4636e2ba30",
                                "text": "Three castellated (with battlements) towers stand sentry here, with one being particularly large. This is said to have been used by Rhodes as a belvedere, and (according to some sources) by railway staff for some time after opening."
                            }
                        ]
                    },
                    {
                        "sense_id": "81afc48a-ffc7-386f-92e2-2289d8866499",
                        "entry_id": "5ea5ab34-bb5a-3867-847e-488611454306",
                        "glosses": [
                            "Summer cypress (Bassia scoparia)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4c96033-584a-427f-aed9-926ced577207",
                        "source_entry_id": "5ea5ab34-bb5a-3867-847e-488611454306",
                        "source_sense_description": "raised structure offering a pleasant view of the surrounding area",
                        "target_lang_word": "belvedér",
