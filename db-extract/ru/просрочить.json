                ],
                "senses": [
                    {
                        "sense_id": "718a1f3d-b50f-3c8d-bf53-1486a8ca04ba",
                        "entry_id": "85a0c1da-4abb-3ad3-a113-fb4131a0b73d",
                        "glosses": [
                            "пропустить установленный срок чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4f0a1a5-98a8-45dd-b7c7-1a4950eef66d",
                                "sense_id": "718a1f3d-b50f-3c8d-bf53-1486a8ca04ba",
                                "text": "Видишь ли: ты завтра пойдешь… или нет, ты не пойдешь, ты здесь будешь писать, понимаешь? а я там узнаю, какое это дело, очень ли спешное или нет, нужно ли его к сроку или нет, и если просрочишь, так что может выйти из этого?"
                            },
                            {
                                "example_id": "552f4d60-e4d9-4dd2-b53c-623b9321850c",
                                "sense_id": "718a1f3d-b50f-3c8d-bf53-1486a8ca04ba",
                                "text": "Просрочил трое суток ― за трое суток и штраф по контракту…"
                            }
                        ]
                    }
