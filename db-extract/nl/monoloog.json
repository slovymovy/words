                                        "sense_id": "9be92747-0aef-3b2e-a616-f44d099c679c",
                                        "entry_id": "18530c1f-c634-38ea-831b-4beb50d0835c",
                                        "glosses": [
                                            "A long series of comic stories and jokes as an entertainment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d01d274-d395-3696-8bb2-9187467084e3",
                                        "entry_id": "18530c1f-c634-38ea-831b-4beb50d0835c",
                                        "glosses": [
                                            "A long, uninterrupted utterance that monopolizes a conversation."
                                        ],
                                        "tags": [],
