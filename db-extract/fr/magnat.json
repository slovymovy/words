        "fr-extract.jsonl": [
            {
                "entry_id": "5253d9c2-5127-3686-9e2d-0810da818d19",
                "word": "magnat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "54439801-34c7-4a36-acc2-4165ea7d713c",
                        "entry_id": "5253d9c2-5127-3686-9e2d-0810da818d19",
                        "tags": [
                            "plural"
                        ],
                        "form": "magnats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3b726b9-27f7-35f1-9cbe-cb327e5fcbc4",
                        "entry_id": "5253d9c2-5127-3686-9e2d-0810da818d19",
                        "glosses": [
                            "Grand du royaume, dans l’ancienne Pologne et l’ancienne Hongrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38f18691-7868-4506-9f29-0a318df5f620",
                                "sense_id": "a3b726b9-27f7-35f1-9cbe-cb327e5fcbc4",
                                "text": "Mais quand tout fut fini, les magnats accoururent des quatre coins de la Pologne, en qualité de sauveurs de la patrie. Les sauveurs sont la plaie des révolutions populaires."
                            },
                            {
                                "example_id": "6ccddd57-5c27-4a8a-a712-17976353b7ee",
                                "sense_id": "a3b726b9-27f7-35f1-9cbe-cb327e5fcbc4",
                                "text": "Son crâne rasé de près et ses longues moustaches tombantes donnaient à ce Français du Nord un faux air de magnat hongrois."
                            }
                        ]
                    },
                    {
                        "sense_id": "652da49a-9bec-32de-9402-013d24beeef0",
                        "entry_id": "5253d9c2-5127-3686-9e2d-0810da818d19",
                        "glosses": [
                            "Personne dominante ou importante ; VIP."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d69a181e-5d15-4049-b908-b53f1456508f",
                                "sense_id": "652da49a-9bec-32de-9402-013d24beeef0",
                                "text": "J’entends bien, encore une fois, qu’on me dénonce les grands magnats du vin, les féodaux du vignoble, ceux qui, séjournant à Paris ou dans les villes d’eaux se contentent de percevoir ici des revenus annuels se chiffrant par millions."
                            },
                            {
                                "example_id": "a65e8ddb-74aa-49db-a173-7efbb1582f0c",
                                "sense_id": "652da49a-9bec-32de-9402-013d24beeef0",
                                "text": "Face aux potentialités technologiques et aux moyens colossaux qui sont les leurs, un sentiment de toute-puissance prend ces magnats de la Silicon Valley."
                            },
                            {
                                "example_id": "07fe65bb-d674-448c-9ceb-797f2af03d3e",
                                "sense_id": "652da49a-9bec-32de-9402-013d24beeef0",
                                "text": "Elle s’est remariée en 2017 avec Michael Herd, un magnat du pétrole, avec qui elle a deux enfants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6575cf85-1f36-46b8-94b1-ffda32dbff0b",
                        "source_entry_id": "5253d9c2-5127-3686-9e2d-0810da818d19",
                        "source_sense_description": "Grand du royaume",
                        "target_lang_word": "Magnat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magnat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df48f91c-6af2-3fab-a688-0cf594ea52da",
                                        "entry_id": "3dfc38ec-1c34-3313-b23a-95c0a4c7164a",
                                        "glosses": [
                                            "Person mit großer wirtschaftlicher Macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45cf2f47-d323-43a4-8e85-ed4fc6baf646",
                                                "sense_id": "df48f91c-6af2-3fab-a688-0cf594ea52da",
                                                "text": "Es ist nicht immer einfach, sich als Politiker gegen die Magnaten aus Öl- und Automobilindustrie zu stellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2c6b14f-8fe6-3d5c-a103-adb4e1c31e23",
                                        "entry_id": "3dfc38ec-1c34-3313-b23a-95c0a4c7164a",
                                        "glosses": [
                                            "Adliger"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ea7281-52a4-4ddb-ba92-89ae2ad78f19",
                                                "sense_id": "f2c6b14f-8fe6-3d5c-a103-adb4e1c31e23",
                                                "text": "„Der größte Teil von ihnen fand jedoch neue Erwerbs- und Niederlassungsmöglichkeiten in den privaten Städten und auf den Ländereien, die die polnischen Magnaten in dieser Zeit gründeten.“"
                                            },
                                            {
                                                "example_id": "5f4b1333-8499-4724-b6b3-09e6900772dd",
                                                "sense_id": "f2c6b14f-8fe6-3d5c-a103-adb4e1c31e23",
                                                "text": "„Bei den polnischen Magnaten der Umgebung, bei den zum Hofe gehörenden Herren und beim Kaiser selbst hatte bereits eine Unzahl von Bällen und Festlichkeiten stattgefunden; im Juni verfiel einer der polnischen Generaladjutanten auf den Gedanken, sämtliche Generaladjutanten sollten gemeinsam dem Kaiser ein Diner und einen Ball geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9ed7447-5740-4f78-a4a8-5e9d4d9d15bc",
                        "source_entry_id": "5253d9c2-5127-3686-9e2d-0810da818d19",
                        "source_sense_description": "Grand du royaume",
                        "target_lang_word": "magnate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "359a496d-af5a-35c3-bcc1-507cab663c4d",
                                        "entry_id": "673a3d02-81bd-3f70-8957-d87c21933061",
                                        "glosses": [
                                            "Powerful industrialist; captain of industry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3b61bdf-2c06-4bea-99f7-77ac7e569e4d",
                                                "sense_id": "359a496d-af5a-35c3-bcc1-507cab663c4d",
                                                "text": "I have decided to become an oil magnate, after spending quite some time reading the dictionary definition of the word magnate."
                                            },
                                            {
                                                "example_id": "05baf57d-bfdf-42f5-b900-872d246fd462",
                                                "sense_id": "359a496d-af5a-35c3-bcc1-507cab663c4d",
                                                "text": "With a suitable amount of life experience under her belt, she sat down and conjured up the sexiest, most delicious Italian wine magnate she could imagine, had him make his biggest mistake, and gave him a wife on the run."
                                            },
                                            {
                                                "example_id": "a734716e-d360-4548-a003-edf1478cf126",
                                                "sense_id": "359a496d-af5a-35c3-bcc1-507cab663c4d",
                                                "text": "Sir Richard Branson is an English business magnate, best known as the founder of the multimillion-pound Virgin Group, which consists of more than four hundred companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d635752-4606-3e55-a83f-857c72fed4e3",
                                        "entry_id": "673a3d02-81bd-3f70-8957-d87c21933061",
                                        "glosses": [
                                            "A person of rank, influence or distinction in any sphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5a45aa-49e4-4aaf-99be-14630970c878",
                                                "sense_id": "2d635752-4606-3e55-a83f-857c72fed4e3",
                                                "text": "[…] but there is not an illiterate Justice of the Peace, or rural magnate in the form of a country squire, that would not detect such a man as an empirie at once, if he rested his claim to such an appointment on the score of his scholarship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12411fe7-73f7-33a4-b94f-9ee05d1a9b66",
                                        "entry_id": "673a3d02-81bd-3f70-8957-d87c21933061",
                                        "glosses": [
                                            "In medieval and early modern Italy, a member of a legally defined category of especially wealthy patrician families, often deprived of the right to political participation by republican governments."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de28d748-b2dc-42a1-81e0-f9bf6826047c",
                                                "sense_id": "12411fe7-73f7-33a4-b94f-9ee05d1a9b66",
                                                "text": "Those considered politically dangerous could be excluded from office by declaring them magnates, while cancellation of magnate status was a mark of favour, a means of political patronage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5efcf80-bb74-430a-a402-aee7e8f4cadf",
                        "source_entry_id": "5253d9c2-5127-3686-9e2d-0810da818d19",
                        "source_sense_description": "Grand du royaume",
                        "target_lang_word": "tycoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tycoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df73b58d-10fc-33d2-a2d0-7b77a55968d5",
                                        "entry_id": "f51a897f-c896-398a-b9d3-bc45cbe6ac73",
                                        "glosses": [
                                            "A wealthy and powerful business person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbe1c92c-ab24-49c8-8497-d4f4866aca20",
                                                "sense_id": "df73b58d-10fc-33d2-a2d0-7b77a55968d5",
                                                "text": "Dagobert had only one customer, an American who wore square, rimless glasses and a beige suit and looked like a Wall Street tycoon."
                                            },
                                            {
                                                "example_id": "05089fcf-1857-4944-962a-7e741f6cb286",
                                                "sense_id": "df73b58d-10fc-33d2-a2d0-7b77a55968d5",
                                                "text": "Chairman Yu is a tycoon who owns multiple hotel chains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7200cf0-01de-3c80-96c4-4024f2414bb7",
                                        "entry_id": "f51a897f-c896-398a-b9d3-bc45cbe6ac73",
                                        "glosses": [
                                            "A game involving the use of a base to generate bricks and cash (similar to an idle game or clicker game), which can then be used to purchase upgrades and expand. Common within the massively multiplayer online game platform Roblox."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b62f53b-d2e0-4488-9ead-041c9995598e",
                                                "sense_id": "c7200cf0-01de-3c80-96c4-4024f2414bb7",
                                                "text": "Tycoons / A game in which users build up some sort of business by earning money over time and then using that money on upgrades."
                                            },
                                            {
                                                "example_id": "ee9ce3e0-de2c-4818-8e96-35b39ca5484b",
                                                "sense_id": "c7200cf0-01de-3c80-96c4-4024f2414bb7",
                                                "text": "In most tycoons, you will find an automatic machine called a dropper, which is used for producing bricks."
                                            },
                                            {
                                                "example_id": "9f42fb9c-e6e3-4595-b84a-98ac8e80aae9",
                                                "sense_id": "c7200cf0-01de-3c80-96c4-4024f2414bb7",
                                                "text": "In my opinion, tycoons are great to create as your first game, but they take time to learn! The main tips are to keep the tycoon simple and stick with a theme."
                                            },
                                            {
                                                "example_id": "49da945a-a9f4-4df2-8bbc-b3a6664a325f",
                                                "sense_id": "c7200cf0-01de-3c80-96c4-4024f2414bb7",
                                                "text": "These experiences have fallen somewhat out of favor because once a tycoon is complete and all items are unlocked, there is not much of an incentive to continue playing. Updating these experiences can be a more difficult task, depending on how your tycoon is structured."
                                            },
                                            {
                                                "example_id": "bd635a41-7b40-4372-98d1-9884b65ab07f",
                                                "sense_id": "c7200cf0-01de-3c80-96c4-4024f2414bb7",
                                                "text": "“What should we play? Adopt Me, a tycoon, SCP, an obby?”"
                                            },
                                            {
                                                "example_id": "d233ce4c-f7cf-444c-914d-678cf5a63677",
                                                "sense_id": "c7200cf0-01de-3c80-96c4-4024f2414bb7",
                                                "text": "The next most common game that we see inside Roblox are Tycoons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa2a26a-72fd-351b-99b8-440788894f62",
                                        "entry_id": "f51a897f-c896-398a-b9d3-bc45cbe6ac73",
                                        "glosses": [
                                            "A Japanese shedding game"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da93dbe6-790d-3f2f-9d09-5220a4dfc512",
                                        "entry_id": "f51a897f-c896-398a-b9d3-bc45cbe6ac73",
                                        "glosses": [
                                            "A Japanese shedding game",
                                            "The name for the person in the top spot in that game"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
