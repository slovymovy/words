                "senses": [
                    {
                        "sense_id": "c7bb9bf8-6d2c-3bcc-be3f-4c1bdf38b370",
                        "entry_id": "ff9e589e-a250-3e7b-8216-4e45e2724e6e",
                        "glosses": [
                            "Schwarzteemischung mit Bergamotte-Aroma"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3231a746-d2c6-4840-b618-0fac8e94de6c",
                                "sense_id": "c7bb9bf8-6d2c-3bcc-be3f-4c1bdf38b370",
                                "text": "„Nino, der Pasta jeder Art nicht ausstehen konnte, stopfte sich den Rest eines Schoko-Croissants in den Mund und spülte mit einem Schluck Earl-Grey-Tee nach.“"
                            },
                            {
                                "example_id": "c2f6cf11-d766-47a1-a581-6536462501d3",
                                "sense_id": "c7bb9bf8-6d2c-3bcc-be3f-4c1bdf38b370",
                                "text": "„Das Sortiment der Waren erstreckt sich vom japanischen Camcorder über englische Unterwäsche, Earl-Grey-Tee, chinesische Seide, amerikanische Computerteile, afghanisches Heroin, pakistanischen Weizen, osteuropäische Kalaschnikows bis hin zu iranischem Petroleum - Zollgebühren oder Steuern werden nicht gezahlt.“"
                            },
                            {
                                "example_id": "5820a621-3f59-451b-a697-e980e48907ae",
                                "sense_id": "c7bb9bf8-6d2c-3bcc-be3f-4c1bdf38b370",
                                "text": "„Sie nahmen auf der Veranda Platz und tranken Earl-Grey-Tee aus hauchdünnen Porzellantassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
