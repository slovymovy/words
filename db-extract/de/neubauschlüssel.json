                        "entry_id": "e19808d2-3b8b-3ab9-9e2a-412832153232",
                        "glosses": [
                            "Werkzeug zum Öffnen von Türen ohne Türbeschlag und Türklinke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd5d13b-488d-4e95-950a-cbee64c47b70",
                                "sense_id": "158300a8-4f2a-3d0c-8823-ed30ec26b2e9",
                                "text": "Die Feuerwehr öffnete die Tür mit einem Neubauschlüssel."
                            },
                            {
                                "example_id": "a2d0e29b-05a1-4f90-a096-00f9d7bb405a",
                                "sense_id": "158300a8-4f2a-3d0c-8823-ed30ec26b2e9",
                                "text": "„Neubauschlüssel sind Universalwerkzeuge zum Öffnen von Türen, bei denen noch keine Türklinke angebracht ist.“"
                            },
                            {
                                "example_id": "b56fcd20-5e84-4352-bfb9-20658b46edfa",
                                "sense_id": "158300a8-4f2a-3d0c-8823-ed30ec26b2e9",
                                "text": "„An den Geräten sind jeweils eine so genannte Notfalltasche bestehend aus, Bandschlinge, Rettungsschere, Neubauschlüssel, Keile und Kreide angebracht und stehen den eingesetzten Trupps zur Verfügung.“"
                            }
                        ],
