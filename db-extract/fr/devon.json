                        "sense_id": "98070856-ce80-3550-a41c-7176dc6a0605",
                        "entry_id": "bfa02205-9bbd-37c7-9563-8730570251b0",
                        "glosses": [
                            "Comté situé dans l’Angleterre du Sud-Ouest, dont le chef-lieu est Exeter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3246d39c-6471-4cae-ab0f-f4b37c8b5e4c",
                                "sense_id": "98070856-ce80-3550-a41c-7176dc6a0605",
                                "text": "DEVON. s. m. Province ou Contrée d’Angleterre, qui a titre de Comté, & que les Anglois appellent Devon-Shire. Ce pays est borné au couchant par les Comtés de Sommerset & de Dorchester, & au levant par celui de Cornouailles. La mer de Bretagne le baigne au midi, & le Canal de Bristol au nord. Excester, ou Exon, en est la capitale."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a74606b-ba77-3498-bb4d-912bffd544ea",
                        "entry_id": "bfa02205-9bbd-37c7-9563-8730570251b0",
                        "glosses": [
                            "Île arctique du territoire canadien du Nunavut."
                        ],
                        "tags": [
                            "Îles"
                        ],
                        "examples": [
                            {
                                "example_id": "a521c2af-d17b-4c9d-871e-d62ea892337a",
                                "sense_id": "3a74606b-ba77-3498-bb4d-912bffd544ea",
                                "text": "L’un des plus grands moments a été la traversée d’une section de l’île Devon dans l’archipel arctique canadien."
                            }
                        ]
                    }
