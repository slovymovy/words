                        "glosses": [
                            "Indicates agreement and compliance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56aace05-1a73-40c0-b7bf-9119d96f4fdb",
                                "sense_id": "ae927215-b0a7-3144-aee2-242866e2d655",
                                "text": "Wilco, Bravo Six Three will take the north road. Bravo Six Four will take the south road, out."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c03635e-fa4e-40d3-9552-1d8fbcd507b9",
                        "source_entry_id": "f4df12e0-5b47-3f52-b62e-10c85de834f5",
                        "source_sense_id": "ae927215-b0a7-3144-aee2-242866e2d655",
                        "source_sense_description": "indication of agreement and compliance",
                        "target_lang_word": "了解",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "了解",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "927f750d-7192-33da-9d2e-a7e70eb73e35",
                                        "entry_id": "3c2f6bca-0650-3b1c-9d12-66b8709404c8",
                                        "glosses": [
                                            "物事の内容等が分かり、納得すること。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8144b05-cded-4115-b425-8d30f701c5f1",
                                                "sense_id": "927f750d-7192-33da-9d2e-a7e70eb73e35",
                                                "text": "吹い子の向うづらという句は罵詈の言語であるようだが、吾輩には了解が出来なかった。"
                                            },
                                            {
                                                "example_id": "02b869a4-5191-4275-ba22-b11253a16a56",
                                                "sense_id": "927f750d-7192-33da-9d2e-a7e70eb73e35",
                                                "text": "私のこの主張は大体において人々の了解を得ました。また了解を得られたことは至当のことであったと思います。"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "了解",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "e3c1ebdd-ab88-36ac-bb0f-25d616f87d2e",
                                        "entry_id": "db6610ca-8ea8-379e-acc0-b8ae9e44b60e",
                                        "glosses": [
                                            "〔何かの内容を〕分かり、納得する。"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80c5dc62-3d28-4bc4-ba95-c5349986206e",
                                                "sense_id": "e3c1ebdd-ab88-36ac-bb0f-25d616f87d2e",
                                                "text": "私は思はず息を呑んだ。さうして刹那に一切を了解した。"
                                            },
                                            {
                                                "example_id": "0ea57e10-4443-47b0-b6e4-5fba0ba6f770",
                                                "sense_id": "e3c1ebdd-ab88-36ac-bb0f-25d616f87d2e",
                                                "text": "私はその森源の言葉を了解することが出来なかった。何か奥歯に、ものの挟まったようないい方が、どうも私にはピンと来ないのだ。"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "了解",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b5d78f-daec-38d7-8e5e-b6d3bc4993dc",
                                        "entry_id": "27e8147d-261a-3702-b6f2-2f7e924016fc",
                                        "glosses": [
                                            "（ときに「了解した」「了解しました」などの形で）メッセージを受け取り、理解したことを表す。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f9bef7-c583-4e4a-9b05-1aa233197553",
                                                "sense_id": "a4b5d78f-daec-38d7-8e5e-b6d3bc4993dc",
                                                "text": "了解、警部補。ビートリスの所へ出向いて、警部補の見解を伝えましょう。"
                                            },
                                            {
                                                "example_id": "80a02659-3a2b-489a-9875-89c663466044",
                                                "sense_id": "a4b5d78f-daec-38d7-8e5e-b6d3bc4993dc",
                                                "text": "了解しました。いま軍人を捜索中です。直ちにオードリ地区へ出向いて、捜査します。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
