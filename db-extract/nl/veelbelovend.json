                                                "example_id": "4c40d278-a361-484a-94df-df8202cf5d8e",
                                                "sense_id": "649ebbf3-fa02-307a-9d58-1e3547779486",
                                                "text": "„Sein vielversprechender Erstling ‚Ein Bericht‘ erschien 1989 in der Reihe ‚Arche Noah‘ bei Suhrkamp.“"
                                            },
                                            {
                                                "example_id": "55cd47ec-0e79-4956-8c56-39652eb98bd6",
                                                "sense_id": "649ebbf3-fa02-307a-9d58-1e3547779486",
                                                "text": "„Während des Kriegs entwickelte sich der Schachanfänger zu einem vielversprechenden Talent.“"
                                            }
