                                "sense_id": "03c8db9f-9d7f-3bc8-bb57-de55d102e530",
                                "text": "Po sześciu latach od rozpoczęcia budowy statek w środę został ochrzczony."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
