                "senses": [
                    {
                        "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                        "entry_id": "0b2191a8-818e-3af5-8490-b4d553b29085",
                        "glosses": [
                            "eine Reihe von Disziplinen betreffend/umfassend; Fachgrenzen übersteigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9de943-26e0-4853-8003-b77b8039ba76",
                                "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                "text": "„Lange Zeit haben fächerübergreifende Projekte den Sportunterricht eher selten einbezogen […].“"
                            },
                            {
                                "example_id": "e777c600-61fa-46f5-ac5f-815009ae1bbe",
                                "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                "text": "„Fächerübergreifende Themenbereiche ergeben sich für den Unterricht am häufigsten dadurch, dass ein Fach sich bei einer Fragestellung in kritischer Selbsteinschätzung mit seinen methodischen Möglichkeiten bzw. in seiner Materialerfahrung überfordert sieht.“"
                            },
                            {
                                "example_id": "089524c6-026f-4b4c-9a4a-5d79ee8f44ed",
                                "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                "text": "„Interdisziplinäres Lernen und fächerübergreifende Projekte dürften dazu fast besser geeignet sein als ein zusätzliches Schulfach.“"
                            },
                            {
                                "example_id": "f03ae382-4066-4f8d-8c68-f69aa135a9fe",
                                "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                "text": "„Von den Natur-, Ingenieur-, Sozial- und Geisteswissenschaften bis zur Lehrerbildung setzt die Universität schon immer auf fächerübergreifende Zusammenarbeit.“"
                            },
                            {
                                "example_id": "6fd4b58c-e455-41ee-b774-b20d3aec2cba",
                                "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                "text": "„Fachübergreifende Themen wie Finanzkrise, Fachkräftemangel, Migration oder ethisches Handeln erfordern interdisziplinäre Kenntnisse, um umfassend erforscht werden zu können.“"
                            }
