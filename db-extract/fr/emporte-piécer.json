                "senses": [
                    {
                        "sense_id": "d8b24b9a-3234-3bcc-b490-7fe99ae6d9dd",
                        "entry_id": "af44da26-be88-3587-a0b7-5bc79c64998c",
                        "glosses": [
                            "Créer des formes dans une pâte avec un emporte-pièce."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "66228265-89a7-4a05-905f-74b52c3056d5",
                                "sense_id": "d8b24b9a-3234-3bcc-b490-7fe99ae6d9dd",
                                "text": "C’est une idée dont le résultat final est très joli, c’est un peu long de tout emporte-piécer et de créer le côté bicolore, du coup la participation de petites mains aide bien et c’est tellement génial de pâtisser en famille."
                            },
                            {
                                "example_id": "db93a17d-437b-4c80-9252-52a87816b90c",
                                "sense_id": "d8b24b9a-3234-3bcc-b490-7fe99ae6d9dd",
                                "text": "On essaie de ne pas dénaturer le produit. Je ne veux plus parer ou emporte-piécer."
                            }
                        ]
                    }
