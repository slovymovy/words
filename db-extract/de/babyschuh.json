                "senses": [
                    {
                        "sense_id": "2d8abd78-f97e-33b7-aa03-f28c972011d5",
                        "entry_id": "55173a17-4afc-3ac1-897e-c7ed177f2335",
                        "glosses": [
                            "speziell für Säuglinge gefertigter Schuh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc22f57-acec-4c8b-8457-1e8379a616c2",
                                "sense_id": "2d8abd78-f97e-33b7-aa03-f28c972011d5",
                                "text": "„Auch wenn Ihr Baby noch nicht selber läuft - diese Babyschuhe halten seine kleinen Füßchen trotzdem schön warm.“"
                            },
                            {
                                "example_id": "924955cf-58eb-48ad-8086-1bc2cd28ac1c",
                                "sense_id": "2d8abd78-f97e-33b7-aa03-f28c972011d5",
                                "text": "„Selbst gestrickte Babyschuhe so weit das Auge reicht, in allen Farben und Mustern stehen sie dicht nebeneinander auf den Tischen des Konferenzraums im Agaplesion Diakonieklinikum Hamburg.“"
                            }
                        ],
