                "senses": [
                    {
                        "sense_id": "a439e9d6-f007-3cc5-8bb0-b5206181f020",
                        "entry_id": "080cd52f-bfff-33b9-9988-4aa9747865a4",
                        "glosses": [
                            "zeer verfijnd, smakelijk en kostbaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd09b48-ff05-4414-8fe8-40cdfe8349e4",
                                "sense_id": "a439e9d6-f007-3cc5-8bb0-b5206181f020",
                                "text": "In augustus 1939 proeft een verslaggeefster van het Algemeen Handelsblad bij Sacramento een ‘delicieus Mexicaansch schoteltje’ dat chili con carne heet."
                            },
                            {
                                "example_id": "28c3991a-ef8a-4b2b-b97f-319f7721031f",
                                "sense_id": "a439e9d6-f007-3cc5-8bb0-b5206181f020",
                                "text": "Zo is er in de eerste helft van het jaar vergeleken met 2012 maar liefst 10 procent minder besteed aan olijfolie uit de eerste koude persing, de basis voor menig delicieus Italiaans gerecht."
                            },
                            {
                                "example_id": "1090072d-bf0b-4621-845b-c9470799f23a",
                                "sense_id": "a439e9d6-f007-3cc5-8bb0-b5206181f020",
                                "text": "‘Kings of the city’ neigde in zijn gesofisticeerde aanpak logischerwijs naar Steely Dan, maar vooral ‘Poor thing’ en het delicieus slaperige ‘The Blue Time’ pakten het publiek in."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55bea2ee-3e0b-41e4-98e9-9a58b545de88",
                        "source_entry_id": "080cd52f-bfff-33b9-9988-4aa9747865a4",
                        "source_sense_id": "a439e9d6-f007-3cc5-8bb0-b5206181f020",
                        "target_lang_word": "luscious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luscious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16d81042-3ed0-370e-ab9d-b6dc817cfd3b",
                                        "entry_id": "d0fdbec0-bbdb-32b0-b4a3-e0acfe012cb8",
                                        "glosses": [
                                            "Sweet and pleasant; delicious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25fe1bce-c997-46a1-a27e-6df11c8bb1a9",
                                                "sense_id": "16d81042-3ed0-370e-ab9d-b6dc817cfd3b",
                                                "text": "Her lips were like two luscious beefsteaks."
                                            },
                                            {
                                                "example_id": "6b693511-8863-4db9-90c3-bf16e8f3cbe6",
                                                "sense_id": "16d81042-3ed0-370e-ab9d-b6dc817cfd3b",
                                                "text": "There were lovely patches of greensward all about, with stately trees bearing rich and luscious fruits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa69b4f8-3433-3a76-aebe-3c98ddcd014b",
                                        "entry_id": "d0fdbec0-bbdb-32b0-b4a3-e0acfe012cb8",
                                        "glosses": [
                                            "Sexually appealing; seductive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492a9395-5982-4b1d-b4bb-7db18eb758dd",
                                                "sense_id": "aa69b4f8-3433-3a76-aebe-3c98ddcd014b",
                                                "text": "With one hand he gently disclosed the lips of that luscious mouth of nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a08fe009-5e32-36d6-9b13-afd1453eda01",
                                        "entry_id": "d0fdbec0-bbdb-32b0-b4a3-e0acfe012cb8",
                                        "glosses": [
                                            "Obscene."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3151e90d-e436-4ca0-b5ef-1a281ed53eb1",
                                                "sense_id": "a08fe009-5e32-36d6-9b13-afd1453eda01",
                                                "text": "Hitherto I had been indebted only to the girls of the house for the corruption of my innocence: their luscious talk, in which modesty was far from respected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
