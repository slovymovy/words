                    }
                ],
                "senses": [
                    {
                        "sense_id": "8aacc53a-c65d-3bfb-ab26-e3241afdfcb3",
                        "entry_id": "28ebb5ab-832f-3f94-ae1d-3b824bac71f1",
                        "glosses": [
                            "Réaction chimique au cours de laquelle se produit un transfert d’électrons entre l’oxydant, qui capte un ou plusieurs électrons, et le réducteur, qui perd un ou plusieurs électrons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "921ec93b-a316-4f14-bbbf-60ec0d93cab7",
                                "sense_id": "8aacc53a-c65d-3bfb-ab26-e3241afdfcb3",
                                "text": "L’oxygène est l’oxydant le plus courant dans le milieu environnant et c’est lui qui est la plupart du temps responsable du potentiel d’oxydoréduction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cecef3d6-8347-40c6-b2e0-b38219a2e52d",
                        "source_entry_id": "28ebb5ab-832f-3f94-ae1d-3b824bac71f1",
                        "source_sense_id": "8aacc53a-c65d-3bfb-ab26-e3241afdfcb3",
                        "source_sense_description": "réaction chimique",
                        "target_lang_word": "Redoxreaktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Redoxreaktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a94ee67-52d7-3316-a4c4-d5e23bcdeb7e",
                                        "entry_id": "093d8612-ace9-3ed8-a723-be849c1fa11f",
                                        "glosses": [
                                            "chemische Reaktion, bei der sowohl eine Oxidation (Elektronenabgabe) als auch eine Reduktion (Elektronenaufnahme) stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e91cdab-100c-41df-b94b-0c0fe66ef321",
                                                "sense_id": "5a94ee67-52d7-3316-a4c4-d5e23bcdeb7e",
                                                "text": "Eine Redoxreaktion ist zum Beispiel die Reaktion von Wasser mit Magnesium: Magnesium wird oxidiert und das Wasser wird reduziert."
                                            },
                                            {
                                                "example_id": "9cf11b5b-6aaa-4115-9ae4-14613e89e2d0",
                                                "sense_id": "5a94ee67-52d7-3316-a4c4-d5e23bcdeb7e",
                                                "text": "„Redoxreaktionen sind in der Chemie von großer Bedeutung, da viel Stoffwechsel- und Verbrennungsvorgänge darauf basieren.“"
                                            },
                                            {
                                                "example_id": "3019fe7f-c3ea-4128-bd2f-38aee1f04782",
                                                "sense_id": "5a94ee67-52d7-3316-a4c4-d5e23bcdeb7e",
                                                "text": "„Der bei dieser Redoxreaktion frei werdende Sauerstoff reagierte zunächst mit anorganischen Substanzen wie Eisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
