                            {
                                "example_id": "a68e9e09-0227-4327-adb1-3db053fda2b3",
                                "sense_id": "20171084-2d3d-3e98-b9a7-aa51f9e4b40c",
                                "text": "The sound […] rebounds again and verberates the skies."
                            },
                            {
                                "example_id": "265c1107-1b48-44db-aeb5-1da82af93d6d",
                                "sense_id": "20171084-2d3d-3e98-b9a7-aa51f9e4b40c",
                                "text": "You shall be verberated, and reverberated, my exact piece of stolidity"
                            },
                            {
                                "example_id": "a379f468-b920-4d1c-9f4f-a90554c74b41",
                                "sense_id": "20171084-2d3d-3e98-b9a7-aa51f9e4b40c",
                                "text": "Full well I heed the verberating chime,\nWhich comes like music on the ear to tell\nIt is the anticipated trysting time"
                            }
                        ]
