                "senses": [
                    {
                        "sense_id": "88e19534-55a9-317b-8c52-592638fedd5a",
                        "entry_id": "438783fa-c5cc-3334-946c-ff4a2ec7cf84",
                        "glosses": [
                            "de toon van een melodie of van een akkoord, die min of meer duidelijk op de naast gelegen hogere of lagere halve toon is gericht; zo streeft de zevende, de hoogste toon van een toonladder sterk naar de grondtoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc4e81db-34e0-44b8-a748-c58ce114d911",
                                "sense_id": "88e19534-55a9-317b-8c52-592638fedd5a",
                                "text": "De op één na laatste toon van een melodie is vaak een leidtoon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5a28c20-cacd-42e2-96a6-f1715f87d2b0",
                        "source_entry_id": "438783fa-c5cc-3334-946c-ff4a2ec7cf84",
                        "source_sense_id": "88e19534-55a9-317b-8c52-592638fedd5a",
                        "target_lang_word": "Leitton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leitton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a06a79ba-45ca-322b-a8cf-a07c39645cdd",
                                        "entry_id": "f1d5601f-fecf-33f2-bd40-187e9fb8a1c3",
                                        "glosses": [
                                            "Ton, der im Zusammenhang der gehörten Melodie die Erwartung erzeugt, dass ihm ein weiterer, bestimmter, passender Ton (der Zielton) folgt; der Ton, der hin zu einer Auflösung fuhrt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eca32e93-fe96-4c12-8540-0831060876de",
                                                "sense_id": "a06a79ba-45ca-322b-a8cf-a07c39645cdd",
                                                "text": "„Es gibt in jeder Tonleiter gewisse Töne, die, wenn man in der Melodie unter gewissen Umständen auf sie stößt, ohne Beleidigung des Ohres in keine andere als in die unmittelbar darüber oder darunter liegende Stufe treten können. Diese Töne nennt Sulzer Leittöne, weil sie das Ohr auf gewisse andere Töne hinleiten oder das Gefühl derselben im Voraus erwecken.“"
                                            },
                                            {
                                                "example_id": "38ea138f-b730-4a68-be7b-17dbba3e8750",
                                                "sense_id": "a06a79ba-45ca-322b-a8cf-a07c39645cdd",
                                                "text": "„Prototyp eines Leittons ist der siebte Ton einer Durtonleiter (z. B. das h in C-Dur), der als Leitton zur achten Stufe (Tonika) führt.“"
                                            },
                                            {
                                                "example_id": "89f1557d-dacd-4313-9600-e1ed745f1cf1",
                                                "sense_id": "a06a79ba-45ca-322b-a8cf-a07c39645cdd",
                                                "text": "Der Leitton in a-Moll heißt gis."
                                            },
                                            {
                                                "example_id": "e5e36ba0-15b7-40af-9398-f5ec0b512f7c",
                                                "sense_id": "a06a79ba-45ca-322b-a8cf-a07c39645cdd",
                                                "text": "Wagners Musik ist bekannt dafür, dass alle Töne der Skala spontan chromatisch erhöht werden können, um als Leittöne zu fungieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
