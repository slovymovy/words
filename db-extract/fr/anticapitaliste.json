        "fr-extract.jsonl": [
            {
                "entry_id": "4c263ab1-e3a1-3305-81f2-f68547584a09",
                "word": "anticapitaliste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7bae60a7-d504-44a8-b56c-beb020c66560",
                        "entry_id": "4c263ab1-e3a1-3305-81f2-f68547584a09",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "anticapitalistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7a430bd-89c5-315a-a978-b0f8c4e7e0e2",
                        "entry_id": "4c263ab1-e3a1-3305-81f2-f68547584a09",
                        "glosses": [
                            "Relatif à l'anticapitalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8729a0-5b24-41e9-933e-d7a8d36bd6f8",
                                "sense_id": "e7a430bd-89c5-315a-a978-b0f8c4e7e0e2",
                                "text": "Cette alliance des « partis ouvriers » avec des formations « bourgeoises ou petite-bourgeoises » allaient les empêcher de prendre les mesures énergiques et « anticapitalistes » que réclamait la situation économique et sociale du pays."
                            },
                            {
                                "example_id": "b52c9c7a-c082-42a3-920a-7444d6a22aaa",
                                "sense_id": "e7a430bd-89c5-315a-a978-b0f8c4e7e0e2",
                                "text": "Cette écologie que l’on peut qualifier de prométhéenne « entre directement en conflit avec les courants anticapitalistes et ceux opposés à la vision d’un progrès uniquement porté par la science, la technique et la croissance économique »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3456534-6b3f-48a6-8859-9056e1645f96",
                        "source_entry_id": "4c263ab1-e3a1-3305-81f2-f68547584a09",
                        "source_sense_id": "e7a430bd-89c5-315a-a978-b0f8c4e7e0e2",
                        "target_lang_word": "anticapitalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anticapitalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6274523b-b66d-3615-ae31-fe11b17b79ec",
                                        "entry_id": "c3510d56-5108-31fd-abdc-fee112586148",
                                        "glosses": [
                                            "One who opposes capitalism or subscribes to anticapitalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a6d312-ee68-4291-9037-ae9402de455b",
                                                "sense_id": "6274523b-b66d-3615-ae31-fe11b17b79ec",
                                                "text": "Most of my rich friends hate anticapitalists."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anticapitalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f51f0b8-b352-306e-ad60-df2b982c8130",
                                        "entry_id": "81362343-5ddd-3826-be7c-3c0554cc47a4",
                                        "glosses": [
                                            "Against or opposed to capitalism; characterized by or involving such opposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e882ef56-a8a4-4d8c-8864-2d118bf2a980",
                                                "sense_id": "2f51f0b8-b352-306e-ad60-df2b982c8130",
                                                "text": "The enthusiasm is not universal. In January, a school board in Missoula County, Mont., decided that screening the video treaded on academic freedom after a parent complained that its message was anticapitalist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54996d90-c98c-4d9a-9905-e80c15a077ac",
                        "source_entry_id": "4c263ab1-e3a1-3305-81f2-f68547584a09",
                        "source_sense_id": "e7a430bd-89c5-315a-a978-b0f8c4e7e0e2",
                        "target_lang_word": "anticapitalista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anticapitalista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e604d7fb-9dcc-3d52-a4e1-42fbf139aa58",
                                        "entry_id": "9563eee2-eb51-3fde-adda-72c6eadf7c74",
                                        "glosses": [
                                            "Que pertenece o concierne al anticapitalismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "481de8d0-6cd6-4cbd-bd99-551a6e77a3c7",
                                                "sense_id": "e604d7fb-9dcc-3d52-a4e1-42fbf139aa58",
                                                "text": "La admonición mayor, sin embargo, fue otra. Se realizó en Argentina el tercer encuentro mundial de movimientos populares, organizado por la Santa Sede. Como siempre, en tales ocasiones, en el mensaje de saludo Francisco desenfundó su repertorio antiliberal y anticapitalista."
                                            }
                                        ],
