                                            {
                                                "example_id": "d21beb28-878a-49fe-a281-dbcbcac79cee",
                                                "sense_id": "7a927ab6-7ce0-3cee-833f-baa665758c0b",
                                                "text": "A bit young to be so cynical and so superior, you may think. My reply is that you should fucking well have been there, and felt it for yourself."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fucking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf7bd7d2-9aaf-3fa3-9c3a-c3a685231f0d",
                                        "entry_id": "3edaded5-2966-3902-a8c2-75b813d54b86",
                                        "glosses": [
                                            "Alternative form of -fucking-, used when the infix is put between two words."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "morpheme",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35accf20-7a27-40a6-a8af-8b4c480d2258",
                                                "sense_id": "cf7bd7d2-9aaf-3fa3-9c3a-c3a685231f0d",
                                                "text": "New Fucking York."
                                            },
                                            {
                                                "example_id": "a38a89e2-b1c0-444e-9925-7613b7a0c7f8",
                                                "sense_id": "cf7bd7d2-9aaf-3fa3-9c3a-c3a685231f0d",
                                                "text": "She had been, as I say, drinking all afternoon and she suddenly howled, “Ten o’clock! It’s ten o’fucking clock! Why doesn’t he come? Why in God’s name doesn’t he come?” Something along those lines."
                                            },
                                            {
                                                "example_id": "a6c552ba-b806-4908-b437-3e0116308609",
                                                "sense_id": "cf7bd7d2-9aaf-3fa3-9c3a-c3a685231f0d",
                                                "text": "[…] I think that life's too long to bother with suing Andrew fucking Lloyd Webber."
                                            },
                                            {
                                                "example_id": "1b5d266c-dac4-428f-85d8-e3ef510dd76f",
                                                "sense_id": "cf7bd7d2-9aaf-3fa3-9c3a-c3a685231f0d",
                                                "text": "If you wanted some background information on me, Holden, all you had to do was ask. I would have gladly volunteered it. You didn't have to go playing Hercule fucking Poirot!"
                                            },
                                            {
                                                "example_id": "19257286-acb1-4539-b954-75c8e1a29853",
                                                "sense_id": "cf7bd7d2-9aaf-3fa3-9c3a-c3a685231f0d",
                                                "text": "Far out, man. Far fucking out!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74fa5c1e-9226-4442-b627-b6a6f208207c",
                        "source_entry_id": "2667df84-a1d7-3b5f-8ece-3b7c5634c7a2",
                        "source_sense_id": "555ee66e-665f-385a-bcb1-b2d73795024a",
