                "entry_id": "c2ce2172-213f-3275-a0a6-4f79c8b02a34",
                "word": "shilling",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5e9ebcf2-6085-428b-ae81-5755d069b43d",
                        "entry_id": "c2ce2172-213f-3275-a0a6-4f79c8b02a34",
                        "tags": [
