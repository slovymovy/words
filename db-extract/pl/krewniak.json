                                    {
                                        "sense_id": "7a045291-9103-3afc-998d-b2cd993dc51a",
                                        "entry_id": "44126496-ebca-3281-b1a8-4f130562a9dc",
                                        "glosses": [
                                            "Person, die aufgrund von Abstammung oder Gesetz zu einer Familie gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b326ff62-bcf6-4792-a978-ccc11a644f07",
                                                "sense_id": "7a045291-9103-3afc-998d-b2cd993dc51a",
                                                "text": "Ich habe keinen lebenden Verwandten mehr."
                                            },
                                            {
                                                "example_id": "e71895d9-f6c7-410b-b296-7ad4a86d550c",
                                                "sense_id": "7a045291-9103-3afc-998d-b2cd993dc51a",
                                                "text": "Ist das dein Verwandter? Ich frage, weil er genauso aussieht, wie dein Bruder."
                                            },
                                            {
                                                "example_id": "b3b295c1-742e-4306-b7fb-0769da4d209b",
                                                "sense_id": "7a045291-9103-3afc-998d-b2cd993dc51a",
                                                "text": "Sind diese ganzen Leute deine Verwandten?"
                                            },
                                            {
                                                "example_id": "cbede3c3-4906-45f1-b94c-f077fabd979e",
                                                "sense_id": "7a045291-9103-3afc-998d-b2cd993dc51a",
                                                "text": "Zur Hochzeit waren nur die allernächsten Verwandten eingeladen."
                                            },
                                            {
                                                "example_id": "f0b647dc-fdc8-4905-ab3d-ef40666aea20",
                                                "sense_id": "7a045291-9103-3afc-998d-b2cd993dc51a",
                                                "text": "Ein Praktikum in München hätte für mich den großen Vorteil, dass Unterkunft und Verpflegung dort bei Verwandten sichergestellt ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
