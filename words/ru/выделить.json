{
    "word_family": [
        "выделение",
        "выделяться",
        "выделительный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42021605-d3b7-3e78-b8d6-74c654f69eea",
                    "sense_definition": "Предоставить часть имеющихся ресурсов (денег, времени, места) для конкретной цели или конкретному лицу.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компания <w>выделила</w> значительный бюджет на развитие новых технологий.",
                            "target_lang_translations": {
                                "en": "The company <w>allocated</w> a significant budget for the development of new technologies.",
                                "de": "Das Unternehmen hat ein beträchtliches Budget für die Entwicklung neuer Technologien <w>bereitgestellt</w>."
                            }
                        },
                        {
                            "text": "Я постараюсь <w>выделить</w> тебе несколько минут после обеда.",
                            "target_lang_translations": {
                                "en": "I will try to <w>spare</w> a few minutes for you after lunch.",
                                "de": "Ich werde versuchen, dir nach dem Mittagessen ein paar Minuten <w>freizumachen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "предоставить",
                        "назначить",
                        "отвести"
                    ],
                    "antonyms": [
                        "отнять",
                        "лишить"
                    ],
                    "common_phrases": [
                        "выделить деньги",
                        "выделить время",
                        "выделить средства",
                        "выделить место"
                    ],
                    "target_lang_definitions": {
                        "en": "To provide a portion of available resources (money, time, space) for a specific purpose or person.",
                        "de": "Einen Teil der verfügbaren Ressourcen (Geld, Zeit, Platz) für einen bestimmten Zweck oder eine bestimmte Person bereitstellen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "allocate",
                                "target_lang_sense_clarification": "resources, budget, or funds"
                            },
                            {
                                "target_lang_word": "allot",
                                "target_lang_sense_clarification": "time or a specific share"
                            },
                            {
                                "target_lang_word": "set aside",
                                "target_lang_sense_clarification": "reserve for a specific use"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bereitstellen",
                                "target_lang_sense_clarification": "allgemein für Ressourcen oder Mittel"
                            },
                            {
                                "target_lang_word": "zuweisen",
                                "target_lang_sense_clarification": "offiziell zuteilen, z.B. Budget oder Aufgaben"
                            },
                            {
                                "target_lang_word": "freimachen",
                                "target_lang_sense_clarification": "Zeit oder Platz zur Verfügung stellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cccf7985-96fc-3237-a3e4-d59a047b8cd6",
                    "sense_definition": "Сделать что-либо более заметным, отличить от окружающего; акцентировать внимание на чём-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель попросил учеников <w>выделить</w> главную мысль в тексте.",
                            "target_lang_translations": {
                                "en": "The teacher asked the students to <w>highlight</w> the main idea in the text.",
                                "de": "Der Lehrer bat die Schüler, den Hauptgedanken im Text <w>hervorzuheben</w>."
                            }
                        },
                        {
                            "text": "Дизайнер решил <w>выделить</w> заголовок ярко-красным цветом.",
                            "target_lang_translations": {
                                "en": "The designer decided to <w>highlight</w> the header with bright red color.",
                                "de": "Der Designer entschied sich, die Überschrift in leuchtendem Rot <w>hervorzuheben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "подчеркнуть",
                        "отметить",
                        "акцентировать"
                    ],
                    "antonyms": [
                        "скрыть",
                        "затушевать"
                    ],
                    "common_phrases": [
                        "выделить главное",
                        "выделить цветом",
                        "выделить жирным",
                        "выделить интонацией"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something more noticeable or distinct from its surroundings; to focus attention on something.",
                        "de": "Etwas deutlicher oder auffälliger machen; die Aufmerksamkeit auf etwas lenken."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "highlight",
                                "target_lang_sense_clarification": "make visually prominent or emphasize a point"
                            },
                            {
                                "target_lang_word": "emphasize",
                                "target_lang_sense_clarification": "stress the importance of something"
                            },
                            {
                                "target_lang_word": "distinguish",
                                "target_lang_sense_clarification": "mark as different or distinct"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hervorheben",
                                "target_lang_sense_clarification": "etwas optisch oder inhaltlich betonen"
                            },
                            {
                                "target_lang_word": "betonen",
                                "target_lang_sense_clarification": "die Wichtigkeit von etwas unterstreichen"
                            },
                            {
                                "target_lang_word": "markieren",
                                "target_lang_sense_clarification": "etwas kenntlich machen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6df002ae-62c1-3ba4-9fba-d44740ec9011",
                    "sense_definition": "Отметить элемент интерфейса, текст или файл на компьютере для выполнения с ним какой-либо команды.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Чтобы скопировать предложение, нужно сначала его <w>выделить</w>.",
                            "target_lang_translations": {
                                "en": "To copy the sentence, you first need to <w>select</w> it.",
                                "de": "Um den Satz zu kopieren, muss man ihn zuerst <w>markieren</w>."
                            }
                        },
                        {
                            "text": "Попробуй <w>выделить</w> все файлы в папке и перенести их на диск.",
                            "target_lang_translations": {
                                "en": "Try to <w>select</w> all the files in the folder and move them to the disk.",
                                "de": "Versuche, alle Dateien im Ordner zu <w>markieren</w> und sie auf das Laufwerk zu verschieben."
                            }
                        }
                    ],
                    "synonyms": [
                        "выбрать",
                        "отметить"
                    ],
                    "common_phrases": [
                        "выделить текст",
                        "выделить файл",
                        "выделить всё",
                        "выделить курсором"
                    ],
                    "target_lang_definitions": {
                        "en": "To mark an interface element, text, or file on a computer to perform a command on it.",
                        "de": "Ein Element in einer Benutzeroberfläche, Text oder eine Datei am Computer markieren, um einen Befehl darauf auszuführen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "select",
                                "target_lang_sense_clarification": "choose an item in a computer interface"
                            },
                            {
                                "target_lang_word": "highlight",
                                "target_lang_sense_clarification": "visually mark text or icons"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "markieren",
                                "target_lang_sense_clarification": "Text oder Dateien auswählen"
                            },
                            {
                                "target_lang_word": "auswählen",
                                "target_lang_sense_clarification": "ein Element zur Bearbeitung selektieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "221f6c5f-54c5-384b-9269-88d661230e9d",
                    "sense_definition": "Выработать и испустить во внешнюю среду (о биологических или химических процессах: жидкость, газ, энергию).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При химической реакции раствор может <w>выделить</w> большое количество тепла.",
                            "target_lang_translations": {
                                "en": "During a chemical reaction, the solution can <w>release</w> a large amount of heat.",
                                "de": "Bei einer chemischen Reaktion kann die Lösung eine große Menge Wärme <w>freisetzen</w>."
                            }
                        },
                        {
                            "text": "Некоторые растения способны <w>выделить</w> особые вещества для защиты от насекомых.",
                            "target_lang_translations": {
                                "en": "Some plants are capable of <w>secreting</w> special substances for protection against insects.",
                                "de": "Einige Pflanzen sind in der Lage, spezielle Stoffe zum Schutz vor Insekten <w>abzusondern</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "испустить",
                        "выработать",
                        "источать"
                    ],
                    "antonyms": [
                        "поглотить",
                        "впитать"
                    ],
                    "common_phrases": [
                        "выделить тепло",
                        "выделить энергию",
                        "выделить газ",
                        "выделить кислород"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce and emit into the external environment (regarding biological or chemical processes: liquid, gas, energy).",
                        "de": "Etwas produzieren und an die Umgebung abgeben (bei biologischen oder chemischen Prozessen: Flüssigkeit, Gas, Energie)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "secrete",
                                "target_lang_sense_clarification": "biological substances"
                            },
                            {
                                "target_lang_word": "release",
                                "target_lang_sense_clarification": "energy, heat, or gas"
                            },
                            {
                                "target_lang_word": "emit",
                                "target_lang_sense_clarification": "discharge or give off"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "freisetzen",
                                "target_lang_sense_clarification": "Energie, Wärme oder Gase abgeben"
                            },
                            {
                                "target_lang_word": "absondern",
                                "target_lang_sense_clarification": "biologische Stoffe oder Sekrete"
                            },
                            {
                                "target_lang_word": "ausstoßen",
                                "target_lang_sense_clarification": "Gase oder Stoffe emittieren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}