{
    "word_family": [
        "noodlottig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64e21f64-960c-39d6-8c1c-c837a83942d6",
                    "sense_definition": "een onvermijdelijke macht die de loop van de gebeurtenissen in het leven van een mens bepaalt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bestemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sommige mensen geloven dat hun hele leven al door het <w>noodlot</w> is bepaald.",
                            "target_lang_translations": {
                                "en": "Some people believe that their entire life has already been determined by <w>fate</w>."
                            }
                        },
                        {
                            "text": "Hij weigerde te geloven in een blind <w>noodlot</w> en nam liever zelf beslissingen.",
                            "target_lang_translations": {
                                "en": "He refused to believe in blind <w>fate</w> and preferred to make his own decisions."
                            }
                        }
                    ],
                    "synonyms": [
                        "lot"
                    ],
                    "common_phrases": [
                        "blind noodlot"
                    ],
                    "target_lang_definitions": {
                        "en": "an inevitable power that determines the course of events in a person's life"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fate",
                                "target_lang_sense_clarification": "the power that predetermines events"
                            },
                            {
                                "target_lang_word": "destiny",
                                "target_lang_sense_clarification": "a predetermined state or future"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd2fbd2a-9b5c-3101-8c08-11385675f7ef",
                    "sense_definition": "een zeer ongelukkige of rampzalige gebeurtenis die iemand overkomt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ongeluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens hun vakantie in de bergen sloeg het <w>noodlot</w> toe door een zware storm.",
                            "target_lang_translations": {
                                "en": "During their holiday in the mountains, <w>disaster</w> struck due to a heavy storm."
                            }
                        },
                        {
                            "text": "Het was een vreselijk <w>noodlot</w> dat de jonge atleet zijn carrière moest beëindigen.",
                            "target_lang_translations": {
                                "en": "It was a terrible <w>fate</w> that the young athlete had to end his career."
                            }
                        }
                    ],
                    "synonyms": [
                        "pech"
                    ],
                    "common_phrases": [
                        "noodlot sloeg toe"
                    ],
                    "target_lang_definitions": {
                        "en": "a very unfortunate or disastrous event that happens to someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fate",
                                "target_lang_sense_clarification": "a tragic or unfortunate outcome"
                            },
                            {
                                "target_lang_word": "misfortune",
                                "target_lang_sense_clarification": "bad luck or a disastrous event"
                            },
                            {
                                "target_lang_word": "tragedy",
                                "target_lang_sense_clarification": "a very sad or disastrous event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f2a8f0a-69c4-3606-be5b-ea94b0988d7d",
                    "sense_definition": "een onafwendbare en meestal tragische afloop van iemands leven of een situatie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bestemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaat wist dat hij zijn <w>noodlot</w> tegemoet ging op het slagveld.",
                            "target_lang_translations": {
                                "en": "The soldier knew he was heading toward his <w>doom</w> on the battlefield."
                            }
                        },
                        {
                            "text": "Zij probeerde haar <w>noodlot</w> te bezweren door heel voorzichtig te zijn.",
                            "target_lang_translations": {
                                "en": "She tried to avert her <w>fate</w> by being very careful."
                            }
                        }
                    ],
                    "common_phrases": [
                        "noodlot tegemoet gaan",
                        "noodlot bezweren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in literaire of dramatische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an unavoidable and usually tragic end to someone's life or a situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fate",
                                "target_lang_sense_clarification": "one's eventual, often tragic, end"
                            },
                            {
                                "target_lang_word": "doom",
                                "target_lang_sense_clarification": "a terrible and unavoidable fate"
                            },
                            {
                                "target_lang_word": "destiny",
                                "target_lang_sense_clarification": "one's ultimate end or lot in life"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}