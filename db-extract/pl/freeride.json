                        "sense_id": "d13585c8-03ab-3189-8108-238cabcb5141",
                        "entry_id": "3eb1d2cd-038d-3839-93ee-6e905b9147d1",
                        "glosses": [
                            "nieformalna dyscyplina sportów ekstremalnych"
                        ],
