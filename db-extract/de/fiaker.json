                "senses": [
                    {
                        "sense_id": "0fd8df8c-85ec-3e47-999e-48aea37f0cf1",
                        "entry_id": "1dd942e9-7c16-337f-a8b6-1a1dfa4be272",
                        "glosses": [
                            "fiacre (horse-drawn taxicab)"
                        ],
                        "tags": [
                            "historical",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a146922b-62a8-49ef-93f3-e779dece2c7b",
                                "sense_id": "0fd8df8c-85ec-3e47-999e-48aea37f0cf1",
                                "text": "Plötzlich war jener Fiaker herangerast, ein offenes Gefährt, und darin lehnte blasiert ein Herrchen, vielleicht neunzehn, vielleicht zwanzig Jahre alt, die Spuren der Ausschweifung in den Zügen, die Finger voller Ringe, Brillantnadel im Schlips, mit Lackschuhen, gebügelter Hose, Spazierstöckchen, Glacéhandschuhen, die ganze Welt in der Tasche, doch sie verachtend."
                            }
                        ]
                    },
                    {
                        "sense_id": "19f2d634-c2c8-3f59-bd4b-c69d4b05262e",
                        "entry_id": "1dd942e9-7c16-337f-a8b6-1a1dfa4be272",
                        "glosses": [
                            "cabby, cabdriver of such a cab"
                        ],
                        "tags": [
                            "broadly",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "893b978c-89f5-4da2-8c75-e46fc3b08bf4",
                                "sense_id": "19f2d634-c2c8-3f59-bd4b-c69d4b05262e",
                                "text": "Da geht's nur allweil trapp, trapp, trapp / Wann's nachher so recht schießen, da spür' i's in mir drin, / Dass i die rechte Pratzen hab', dass i Fiaker bin"
                            }
                        ]
                    },
