                        "glosses": [
                            "keiner anerkannten religiösen Gemeinschaft angehöriger Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de32792c-4a1b-452f-8949-83c5d3435574",
                                "sense_id": "76325f73-70e5-30c6-8c46-d986fab8a355",
                                "text": "„Ein klar konturiertes Bild Konfessionsloser in Ostdeutschland hat dieser kleine Durchgang durch jüngere Forschungsarbeiten nicht erbracht.“"
                            },
                            {
                                "example_id": "6e91103e-c2a1-439d-aacd-7adf2fb25ac2",
                                "sense_id": "76325f73-70e5-30c6-8c46-d986fab8a355",
                                "text": "„Der diesbezügliche Diskurs wird durch die Ergebnisse der Befragung Konfessionsloser im Rahmen der fünften Kirchenmitgliedschaftsuntersuchung wohl nicht grundstürzend verändert: […]“"
                            }
                        ],
