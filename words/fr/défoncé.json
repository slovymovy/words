                    "frequency": "Low",
                    "semantic_group_id": "detruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la vieille cave humide, ils ont découvert un vieux tonneau <w>défoncé</w>."
                        },
                        {
                            "text": "La police a inspecté la porte <w>défoncée</w> au fond du couloir."
