                                "target_senses": [
                                    {
                                        "sense_id": "8b90e0a5-31ac-3f50-b5a0-c19b3558fca1",
                                        "entry_id": "73737227-f2c0-36f2-9b0e-cac2fce65faf",
                                        "glosses": [
                                            "etwas abstreiten, das über einen geäußert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c732c61-24a0-4a2b-a0d4-17e1da690e44",
                                                "sense_id": "8b90e0a5-31ac-3f50-b5a0-c19b3558fca1",
                                                "text": "Trotz aller Beweise leugnete er, die Tat begangen zu haben."
                                            },
                                            {
                                                "example_id": "47b00ef5-6170-4e6b-9961-9f06b94996d3",
                                                "sense_id": "8b90e0a5-31ac-3f50-b5a0-c19b3558fca1",
                                                "text": "„Vor diesem Hintergrund wäre es dem Beschwerdeführer auch nicht zumutbar, seinen Glauben in Form eines Widerrufs zu leugnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "309e807c-7883-3d16-9e91-9b6f9e57dbd5",
                                        "entry_id": "73737227-f2c0-36f2-9b0e-cac2fce65faf",
                                        "glosses": [
                                            "Offenkundiges wider besseres Wissen bestreiten, als unwahr hinstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e52234-f353-4735-a61f-4f7810ae5c4e",
                                                "sense_id": "309e807c-7883-3d16-9e91-9b6f9e57dbd5",
                                                "text": "Es gibt immer noch Personen, die den Holocaust leugnen."
                                            },
                                            {
                                                "example_id": "cca5c207-6e8a-4243-9dbf-a9b0cd44dcdf",
                                                "sense_id": "309e807c-7883-3d16-9e91-9b6f9e57dbd5",
                                                "text": "Es hat niemand geleugnet, dass deine Schwester eine tüchtige Frauensperson ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8e73e782-18e7-376a-ada5-9928b8b7b5e1",
                                        "entry_id": "73737227-f2c0-36f2-9b0e-cac2fce65faf",
                                        "glosses": [
                                            "etwas in Abrede stellen, das nach einer von demjenigen, der von „leugnen“ spricht, vorausgesetzten Lehre, Weltanschauung oder ähnlichen Überzeugung oder nach allgemeiner Anschauung existiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93148519-f7bf-481a-a509-a8e748f2bc3b",
                                                "sense_id": "8e73e782-18e7-376a-ada5-9928b8b7b5e1",
                                                "text": "Die Existenz Gottes wird vielfach geleugnet."
                                            },
                                            {
                                                "example_id": "4f3d2263-92f5-40a8-92f9-109e697b5a58",
                                                "sense_id": "8e73e782-18e7-376a-ada5-9928b8b7b5e1",
                                                "text": "In diesem Staat leugnet man die Grundrechte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
