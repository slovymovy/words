                        ],
                        "form": "die Regulationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47b793f8-ffa0-367e-bc5a-662e8601b2ca",
                        "entry_id": "4adc1a4f-19c3-387d-a63a-0cfba363ee1d",
                        "glosses": [
                            "Steuerung, Kontrollieren eines Prozesses oder von Störungen; Maßnahme, um bestimmte Vorgänge, Zustände zu beeinflussen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e16f27ee-6cfe-4e02-971c-3fcf66ef861b",
                                "sense_id": "47b793f8-ffa0-367e-bc5a-662e8601b2ca",
                                "text": "„Durch Regulation des Herzschlags und der Gefäße kann er den Blutdruck anpassen.“"
                            },
                            {
                                "example_id": "6d7a3eed-8bac-4e2d-a3e7-4a332f02dbb9",
                                "sense_id": "47b793f8-ffa0-367e-bc5a-662e8601b2ca",
                                "text": "„Der Konsum von Alkohol beeinträchtigt die Regulation des Blutzuckers und erhöht das Risiko für eine Unterzuckerung.“"
                            },
                            {
                                "example_id": "a1ffa9b0-9eea-438c-90b7-783a74eb3ca4",
                                "sense_id": "47b793f8-ffa0-367e-bc5a-662e8601b2ca",
                                "text": "„All das Auf und Ab hat seinen Grund im eigentlichen Zweck des Edersees: der Regulation des Wasserstands auf der Oberweser und ursprünglich auch im Mittellandkanal.“"
                            },
                            {
                                "example_id": "6a2379cf-7f7d-4a36-b6c2-4cf7b572476c",
                                "sense_id": "47b793f8-ffa0-367e-bc5a-662e8601b2ca",
                                "text": "„Sie trägt wesentlich zur Regulation des Klimas bei, da sie die Kohlendioxidaufnahme der Ozeane aus der Atmosphäre antreibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
