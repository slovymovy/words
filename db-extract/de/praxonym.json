                "senses": [
                    {
                        "sense_id": "e148c52a-2edd-34aa-8c53-5697d3bedd8b",
                        "entry_id": "dec08f27-9964-3e28-b62f-4643a2dea6ac",
                        "glosses": [
                            "Eigenname eines Ereignisses"
                        ],
                        "tags": [
                            "Sprachwissenschaft",
