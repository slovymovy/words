                "translations": [
                    {
                        "translation_id": "37d15b0f-7607-4689-96db-68bde1b36041",
                        "source_entry_id": "61627426-4f6f-3c3c-bd6a-733dba3b0ed4",
                        "source_sense_description": "surname",
                        "target_lang_word": "Schrödinger",
