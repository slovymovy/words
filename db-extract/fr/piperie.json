                "senses": [
                    {
                        "sense_id": "6e421af4-eed6-36b5-92e8-940f52bc4833",
                        "entry_id": "1dbb25ec-ba34-310b-8996-baf279b2a31f",
                        "glosses": [
                            "Tromperie au jeu."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a556d9ff-fe04-459a-acc8-16c8c4b1c560",
                                "sense_id": "6e421af4-eed6-36b5-92e8-940f52bc4833",
                                "text": "Il faut qu’il y ait de la piperie."
                            },
                            {
                                "example_id": "b49f3d0b-2b00-4b11-a508-2c34b08b7244",
                                "sense_id": "6e421af4-eed6-36b5-92e8-940f52bc4833",
                                "text": "Cela n’a pu se faire sans piperie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffa56d6b-c8be-33d3-8389-a260491564a7",
                        "entry_id": "1dbb25ec-ba34-310b-8996-baf279b2a31f",
                        "glosses": [
                            "Toute sorte de tromperie, de fourberie."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9a4e5ab2-3185-4cd6-a5f5-740d4972314e",
                                "sense_id": "ffa56d6b-c8be-33d3-8389-a260491564a7",
                                "text": "Mordi, Monsieur, reprit le Piémontais, je ne m’inquiète pas de la piperie, moi, et si l’hôte me fournit une volaille moins bien rôtie que celle de son enseigne, je le mets à la broche lui-même […]."
                            },
                            {
                                "example_id": "7207824e-a577-4c0f-82d8-71de33a01b90",
                                "sense_id": "ffa56d6b-c8be-33d3-8389-a260491564a7",
                                "text": "Florestan ne douta pas du succès de sa piperie."
                            },
                            {
                                "example_id": "0291ccc3-7b13-4a41-91dc-3cddb476023e",
                                "sense_id": "ffa56d6b-c8be-33d3-8389-a260491564a7",
                                "text": "Les premiers troubles de la jeunesse la trouvèrent démunie, sans défense contre le mal, sans protection contre les sophismes et les piperies du monde."
                            }
                        ]
                    }
