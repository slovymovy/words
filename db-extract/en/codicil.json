                                "target_senses": [
                                    {
                                        "sense_id": "588b03d6-e9c5-32cb-b24d-36a6cc30e596",
                                        "entry_id": "4db18d86-a336-3aec-b655-005050d81d4e",
                                        "glosses": [
                                            "toevoegsel"
                                        ],
                                        "tags": [],
