                    },
                    {
                        "translation_id": "6df444d9-8454-42ce-9495-b079d8371a3d",
                        "source_entry_id": "2b9d73be-269d-3940-ab36-d9e3e149f614",
                        "source_sense_id": "18c78299-9fb2-3706-afaa-70171840b3fa",
                        "source_sense_description": "fachsprachlich: Vorgang, bei dem ein Bauwerk verkleinert oder beseitigt wird",
                        "target_lang_word": "démolition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démolition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24866d52-3617-3833-b77a-3283515a7881",
                                        "entry_id": "d7cb0e5e-1f57-375b-82cc-aac4e95b3db7",
                                        "glosses": [
                                            "Action de démolir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fa966b-ac14-440c-b18e-9aa613432f3f",
                                                "sense_id": "24866d52-3617-3833-b77a-3283515a7881",
                                                "text": "Le but de notre bon entrepreneur de démolition, c’est toujours d’apprendre à se désétonner."
                                            },
                                            {
                                                "example_id": "9c3d0f5d-6c9f-462a-bdb0-56ab484b227f",
                                                "sense_id": "24866d52-3617-3833-b77a-3283515a7881",
                                                "text": "L'histoire de la vénérologie à Cochin, ou plutôt à l’hôpital Ricord n'est pas simple à établir car une grande partie des archives de cet hôpital a disparu, probablement au début du siècle lors de sa démolition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6df2d0b0-6598-3602-81e8-718792a99f15",
                                        "entry_id": "d7cb0e5e-1f57-375b-82cc-aac4e95b3db7",
                                        "glosses": [
                                            "Matériaux qui restent de ce qu’on démolit."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e71e51ed-ccef-40e0-bd96-f7a999ef5cb8",
                                                "sense_id": "6df2d0b0-6598-3602-81e8-718792a99f15",
                                                "text": "Les démolitions de cet édifice ont été bien vendues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b83e4c67-9cde-3c9a-98d2-272a3b4a413e",
                                        "entry_id": "d7cb0e5e-1f57-375b-82cc-aac4e95b3db7",
                                        "glosses": [
                                            "Destruction physique ou morale d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf4f02a-cb70-4a33-a21f-6a76eec0a0ca",
                                                "sense_id": "b83e4c67-9cde-3c9a-98d2-272a3b4a413e",
                                                "text": "On assiste à une démolition en règle du ministre."
                                            },
                                            {
                                                "example_id": "7a2e0caf-cfdb-4382-8c0a-ec1649a78742",
                                                "sense_id": "b83e4c67-9cde-3c9a-98d2-272a3b4a413e",
                                                "text": "Mais La Rouquerie poussa les hauts cris : « cent francs, un âne vendu sans garantie ! C’était se moquer du monde. » Et le malheureux Palikare eut à subir une démolition en règle, du bout du nez aux sabots. « Vingt francs, c’était tout ce qu’il valait ; et encore…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b36828b-4675-363f-85c5-fefbaa74b002",
                                        "entry_id": "d7cb0e5e-1f57-375b-82cc-aac4e95b3db7",
                                        "glosses": [
                                            "Destruction méthodique d’arguments, d’un raisonnement etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "733394d0-421a-44f7-9a6c-11d5321446f8",
                                                "sense_id": "6b36828b-4675-363f-85c5-fefbaa74b002",
                                                "text": "Il s’est livré à une démolition impitoyable du créationnisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "695e1d75-a45f-43a2-b3ca-85d34aabf41a",
                        "source_entry_id": "2b9d73be-269d-3940-ab36-d9e3e149f614",
                        "source_sense_id": "18c78299-9fb2-3706-afaa-70171840b3fa",
                        "source_sense_description": "fachsprachlich: Vorgang, bei dem ein Bauwerk verkleinert oder beseitigt wird",
                        "target_lang_word": "démantèlement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démantèlement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e8df029-e841-37ca-84e0-3ba5c2c1f096",
                                        "entry_id": "859cdba8-89eb-3544-bd66-05be9e973e4a",
                                        "glosses": [
                                            "Action de démanteler ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a05a1f-c73e-4a45-82e1-01b85a5277a3",
                                                "sense_id": "1e8df029-e841-37ca-84e0-3ba5c2c1f096",
                                                "text": "Les alluvions anciennes […] sont essentiellement formées d’un sable quartzeux dans la masse duquel on rencontre du gravier et des cailloux roulés de nature variable : porphyre pétrosiliceux, brèche, granite à amphibole des Ballons, porphyrites et quartzites, celles-ci provenant du démantèlement des poudingues de grès."
                                            },
                                            {
                                                "example_id": "ca893d37-391f-4a72-b225-ca42f6a52636",
                                                "sense_id": "1e8df029-e841-37ca-84e0-3ba5c2c1f096",
                                                "text": "Le démantèlement et la mise sous surveillance serrée de la FAF sont un avertissement aux islamistes algériens et vont encore couper les politiques en exil du terrain algérien et accentuer le morcellement du mouvement « fissiste »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37a72b27-e6fb-33bb-9349-23335ac34143",
                                        "entry_id": "859cdba8-89eb-3544-bd66-05be9e973e4a",
                                        "glosses": [
                                            "Ensemble des opérations techniques réalisées dans une installation nucléaire après son arrêt définitif, qui comprennent le démontage des équipements, l’assainissement des locaux et des équipements, la démolition de structures de génie civil et l’évacuation des déchets produits."
                                        ],
                                        "tags": [
                                            "Nucléaire",
                                            "Déconstruction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c597e0e-9c44-43f5-9b64-4c813fe7ec31",
                                                "sense_id": "37a72b27-e6fb-33bb-9349-23335ac34143",
                                                "text": "Les tours de passe-passe comptable pour masquer les coûts cachés du nucléaire se poursuivent. En effet, sans crier gare, EDF semble bien vouloir changer ses engagements en matière de démantèlement de centrales nucléaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b216835-397a-3f31-82b9-cd4d8d337879",
                                        "entry_id": "859cdba8-89eb-3544-bd66-05be9e973e4a",
                                        "glosses": [
                                            "Déconstruciton d'une organisation u d'un organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c545f543-eaed-4c20-9b5a-f11b9e2c3b25",
                                                "sense_id": "7b216835-397a-3f31-82b9-cd4d8d337879",
                                                "text": "Il s’agit du démantèlement systématique des institutions de santé publique, du silence des experts et de la dangereuse politisation de la science."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
