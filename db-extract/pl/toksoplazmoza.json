                                "target_senses": [
                                    {
                                        "sense_id": "15c0926f-6e4d-3c31-8ac5-0a08a67c83ce",
                                        "entry_id": "5773e946-b751-372a-992c-cdd7bf746055",
                                        "glosses": [
                                            "Krankheit, die von Tieren (speziell Katzen) auf den Menschen übertragen wird, und besonders für noch ungeborene Kinder von schwangeren Frauen gefährlich sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08363fcb-86a8-4d8c-8e25-4ad6e2e7ef14",
                                                "sense_id": "15c0926f-6e4d-3c31-8ac5-0a08a67c83ce",
                                                "text": "Erst in den 1960er Jahren begriff man, dass Toxoplasmose durch den Kot von Katzen übertragen werden kann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3101bbab-d91c-4c98-a65f-1e19af53d672",
                        "source_entry_id": "40ea4d5d-fc1e-36bb-84ef-58bf65b892e3",
                        "source_sense_id": "2c8cff48-18e6-3d7a-bd23-73e5b78fee99",
                        "target_lang_word": "токсоплазмо́з",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "токсоплазмо́з",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7d0aee5f-fa9b-3081-b80a-6b7f4999d355",
                                        "entry_id": "12dc2550-5413-3287-9764-5734f4491116",
                                        "glosses": [
                                            "мед. протозойное заболевание, возбудителем которого является облигатный внутриклеточный паразит Toxoplasma gondii (тип Sporozoa, класс Coccidea), жизненный цикл которого проходит с участием окончательного и промежуточного хозяев, где окончательными хозяевами служат представители семейства кошачьих, а промежуточным — многие виды млекопитающих и птиц"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68edd349-6444-4d39-96a0-264778218f07",
                                                "sense_id": "7d0aee5f-fa9b-3081-b80a-6b7f4999d355",
                                                "text": "Токсоплазмоз – антропозооноз, источник заражения – кошки. Инфицирование здорового человека обычно приводит к носительству. Опасно заражение, происходящее вовремя беременности, так как инфицирование во внутриутробном периоде приводит к формированию множественных пороков. У взрослых токсоплазмоз развивается при иммунодефиците. В головном мозге формируются цилиарные гранулемы,способные кальцифицироваться и некротизироваться."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
