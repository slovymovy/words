                "senses": [
                    {
                        "sense_id": "d11c11fa-37e5-3079-a406-a89b0a21b4dd",
                        "entry_id": "36a30bb8-2831-3d69-bbb6-99295e0a9c8c",
                        "glosses": [
                            "A mountain nymph; an anthropomorphic appearance of the spirit of a mountain."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "575e310b-7171-4e58-8d18-349a870f7010",
                                "sense_id": "d11c11fa-37e5-3079-a406-a89b0a21b4dd",
                                "text": "The imprisoned ringlets are emancipated; 'fresh as the oread from the forest fountain,' you descend—you breathe the incense of the chocolate—not more I hope—and grow conversational and confidential over the green tea, which, with a fragrance beyond all the violets of April, rises to your lip, 'giving and taking odours.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26e7bf0f-98b3-4a69-9535-2043a6fb2d00",
                        "source_entry_id": "36a30bb8-2831-3d69-bbb6-99295e0a9c8c",
                        "source_sense_id": "d11c11fa-37e5-3079-a406-a89b0a21b4dd",
                        "source_sense_description": "mythology: minor mountain deity",
                        "target_lang_word": "oréade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oréade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "731f35bc-f1d4-3764-b546-7e37cfd31f00",
                                        "entry_id": "0c03c274-63e7-31b0-b3c7-402bb691b053",
                                        "glosses": [
                                            "Nymphe ou divinité des montagnes et des grottes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e941e468-7cd8-4adc-afc2-6a3065606003",
                                                "sense_id": "731f35bc-f1d4-3764-b546-7e37cfd31f00",
                                                "text": "— Je n’ai que le temps de m’habiller pour le dîner.\nEt elle s’échappa devant les lions de pierre, laissant à son ami une vision de naïade ou d’oréade."
                                            },
                                            {
                                                "example_id": "785372f4-1120-4676-9e68-b66af720e114",
                                                "sense_id": "731f35bc-f1d4-3764-b546-7e37cfd31f00",
                                                "text": "Il avait suffi que ce mécanisme monstrueux l’effleurât pour la lui ravir, pour faire d’elle sa captive, et dans le meilleur des cas une oréade."
                                            },
                                            {
                                                "example_id": "f70e01d9-4e66-4fa0-b226-0f8f4481f386",
                                                "sense_id": "731f35bc-f1d4-3764-b546-7e37cfd31f00",
                                                "text": "Sur le chemin du village, je vis une jeune fille qui marchait dans la lumière. Elle avait le visage d'une sainte et les hanches d'une oréade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "569fdaab-047f-46f7-89d2-ddb0bae7204a",
                        "source_entry_id": "36a30bb8-2831-3d69-bbb6-99295e0a9c8c",
                        "source_sense_id": "d11c11fa-37e5-3079-a406-a89b0a21b4dd",
                        "source_sense_description": "mythology: minor mountain deity",
                        "target_lang_word": "Oreade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oreade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1852c51-37fe-3016-a133-83c78de95dbd",
                                        "entry_id": "4c15af4d-72b0-3b60-9ed0-f399f4f82f27",
                                        "glosses": [
                                            "Bergnymphe der altgriechischen Mythologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b814e47-9d97-4b5f-8e27-8adfbc62247f",
                                                "sense_id": "a1852c51-37fe-3016-a133-83c78de95dbd",
                                                "text": "„Eine der bekanntesten Oreaden ist Echo. Die Göttin Hera beraubte sie der Sprache und ließ ihr lediglich die Fähigkeit, die letzten an sie gerichteten Wörter zu wiederholen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
