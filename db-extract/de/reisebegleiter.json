                ],
                "senses": [
                    {
                        "sense_id": "434e2ccf-51f4-326a-a373-26c13131daf5",
                        "entry_id": "cf5337e9-7953-3568-a672-a474108d6020",
                        "glosses": [
                            "(männliche^☆) Person, die andere Personen während der Dauer einer Reise begleitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aff1ac8-dc1d-47ac-a722-12501fe1ef18",
                                "sense_id": "434e2ccf-51f4-326a-a373-26c13131daf5",
                                "text": "„Ideale Reisebegleiter sind jene Menschen, mit denen man auch im Alltag über einen längeren Zeitraum ganz gut auskommt.“"
                            },
                            {
                                "example_id": "dd14e535-9a6d-44d1-97db-b0995b2da695",
                                "sense_id": "434e2ccf-51f4-326a-a373-26c13131daf5",
                                "text": "„Bei dem Vorfall wurde niemand verletzt, die Chauffeure, Reisebegleiter und Schüler kamen mit dem Schrecken davon.“"
                            },
                            {
                                "example_id": "01be3978-f370-439d-9179-0eb04911d1b5",
                                "sense_id": "434e2ccf-51f4-326a-a373-26c13131daf5",
                                "text": "„750 Kilometer Luftlinie trennen die beiden Orte, die Reise birgt viele Gefahren, und so engagiert Tobit, der Vater des Tobias, den Mann Asarja als Reisebegleiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
