                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "München",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac5ddac3-a65b-3d40-839e-9736ff2c4370",
                                        "entry_id": "3232534f-f3ad-3067-90d3-b0995546f2a4",
                                        "glosses": [
                                            "Stadt in Deutschland, die Hauptstadt von Bayern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7efb81d-8c91-476f-8f1c-c1eb23d9c4c8",
                                                "sense_id": "ac5ddac3-a65b-3d40-839e-9736ff2c4370",
                                                "text": "München liegt an der Isar."
                                            },
                                            {
                                                "example_id": "1fb24ad9-e7eb-4349-b35c-9d787cec5e14",
                                                "sense_id": "ac5ddac3-a65b-3d40-839e-9736ff2c4370",
                                                "text": "„In der Stadt München herrscht warmgemäßigtes Klima mit vergleichsweise kalten Wintern.“"
                                            },
                                            {
                                                "example_id": "8ee262df-9cb8-4490-b20a-b7c132e9faa8",
                                                "sense_id": "ac5ddac3-a65b-3d40-839e-9736ff2c4370",
                                                "text": "„Wenn ich statt nach München nach Köln gekommen wäre, hätte er mich nicht fortgelassen.“"
                                            },
                                            {
                                                "example_id": "60668541-5972-46a8-962f-05d254b978db",
                                                "sense_id": "ac5ddac3-a65b-3d40-839e-9736ff2c4370",
                                                "text": "das München der 1920er Jahre, in dem München Ludwigs I."
                                            }
                                        ],
