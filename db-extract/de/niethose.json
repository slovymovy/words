                ],
                "senses": [
                    {
                        "sense_id": "ca4fa72d-0c29-3ea2-a599-d2d0843c7f86",
                        "entry_id": "835d84fe-055a-3d23-b0a3-b2ad516c9fd9",
                        "glosses": [
                            "Hose aus blauem Baumwollstoff mit Nieten"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "31f0e2f2-e657-40c2-8aba-ec73e40b94de",
                                "sense_id": "ca4fa72d-0c29-3ea2-a599-d2d0843c7f86",
                                "text": "„Ich hatte meine Niethosen an, dazu Wildlederschuhe und einen dicken schwarzen Rollkragenpullover, hinter mir am Haken hing mein gesteppter Dederonanorak.“"
                            },
                            {
                                "example_id": "01768e7f-758b-42d8-9f9f-0f77470ce999",
                                "sense_id": "ca4fa72d-0c29-3ea2-a599-d2d0843c7f86",
                                "text": "„Onkel Kuhnert hat mir ein Paar Gummistiefel vorgekramt, die prima zu meinen Niethosen passen.“"
                            },
                            {
                                "example_id": "fdd7ef47-a2cd-436b-8e45-fe01cf2f70de",
                                "sense_id": "ca4fa72d-0c29-3ea2-a599-d2d0843c7f86",
                                "text": "„Marina sah so aus wie im vergangenen Sommer: das Gesicht braun gebrannt, schwarz die Haare, weiß die Bluse, und an den Beinen trug sie die verwaschene Niethose.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
