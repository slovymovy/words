                "senses": [
                    {
                        "sense_id": "08604843-a2e7-3c26-83a6-3acfe84c9a25",
                        "entry_id": "e94d7bf8-cb19-3c4e-86e3-5405748021e7",
                        "glosses": [
                            "niet door een gistingsproces bereid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f49413f-6543-4672-a5cb-04d19fa1f1ae",
                                "sense_id": "08604843-a2e7-3c26-83a6-3acfe84c9a25",
                                "text": "Maar ook hier begint langzamerhand de klad in te komen, sinds de Romeinse curie onlangs vergunning heeft gegeven om in bepaalde omstandigheden in plaats van miswijn ongegist druivensap te gebruiken. In het hart van de Bordeauxstreek is er nu ook een dominee die de wijn voor het avondmaal is gaan vervangen door druivensap."
                            },
                            {
                                "example_id": "cc20fe2f-cfc9-44cb-b5dc-d72bb140d218",
                                "sense_id": "08604843-a2e7-3c26-83a6-3acfe84c9a25",
                                "text": "Het grote verschil tussen dijonmosterd en gewone mosterd is, dat bij de productie geen 'gewone' azijn wordt gebruikt in combinatie met de mosterdzaadjes, maar het ongegiste sap van wijndruiven."
                            },
                            {
                                "example_id": "d249091a-90dc-4f37-82e7-be90fd777ff8",
                                "sense_id": "08604843-a2e7-3c26-83a6-3acfe84c9a25",
                                "text": "Ook tussen rooms-katholieken en protestanten bestaan verschillende woorden voor hetzelfde voorwerp. Zo spreken lutheranen over een ouweldoos. Voor rooms-katholieken is dat een hostiedoos, omdat het woord ouwel voor het schijfje ongegist tarwemeel dat tijdens de mis wordt geheiligd, voor hen wat oneerbiedig klinkt."
                            }
                        ]
                    }
