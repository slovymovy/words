        "fr-extract.jsonl": [
            {
                "entry_id": "5aa7d3d5-18cc-32d0-b98c-4c3b17a9597b",
                "word": "intolérable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8c2636fa-5f8d-470f-aca0-b95c26b899ee",
                        "entry_id": "5aa7d3d5-18cc-32d0-b98c-4c3b17a9597b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "intolérables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7514fd0-a10b-34e4-b3a8-8dd90411f499",
                        "entry_id": "5aa7d3d5-18cc-32d0-b98c-4c3b17a9597b",
                        "glosses": [
                            "Qu’on ne saurait tolérer ; inadmissible, inacceptable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "967ddf44-a519-4f61-9e4d-8e03f6377792",
                                "sense_id": "a7514fd0-a10b-34e4-b3a8-8dd90411f499",
                                "text": "Le trafic des indulgences, qui devenait toujours plus intolérable, ne causa pas moins de préjudice à la cour romaine. Les pontifes français […] dispensèrent, à un prix excessif, toutes sortes de permissions scandaleuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "d423ace2-4e90-3874-89af-3a9dfdd71f61",
                        "entry_id": "5aa7d3d5-18cc-32d0-b98c-4c3b17a9597b",
                        "glosses": [
                            "Qu’on ne peut supporter ou endurer ; Qui est insupportable."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "b24f65eb-1e18-45cd-b8e7-c21beb3cbbf6",
                                "sense_id": "d423ace2-4e90-3874-89af-3a9dfdd71f61",
                                "text": "Depuis vingt-quatre ans, M. B… souffrait d'une sinusite frontale qui avait nécessité onze opérations!! Malgré tout la sinusite persistait, accompagnée de douleurs intolérables."
                            },
                            {
                                "example_id": "ed166070-1ebe-4a73-b66e-783870e323ed",
                                "sense_id": "d423ace2-4e90-3874-89af-3a9dfdd71f61",
                                "text": "De nouveau, ce fut le silence. Mais elle savait à présent qu’elle n’était pas seule. Elle retenait elle aussi, inutilement, sa respiration. Une angoisse comme jamais elle n’en avait ressenti l’étreignait. Elle allait mourir dans quelques instants ; elle en avait l’intolérable certitude ;"
                            },
                            {
                                "example_id": "d658846f-c505-40e7-8a68-37264ace76df",
                                "sense_id": "d423ace2-4e90-3874-89af-3a9dfdd71f61",
                                "text": "Elle débuta par une de ses citations préférées d'Oscar Wilde – « La mode est une forme de laideur si intolérable que nous devons en changer tous les six mois » – et enchaîna avec une de ses plaisanteries bien rôdées : […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7db7f0e-a8a4-4964-ab83-9a8734a50ea8",
                        "source_entry_id": "5aa7d3d5-18cc-32d0-b98c-4c3b17a9597b",
                        "target_lang_word": "unerträglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unerträglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "727d6031-0c56-3fe9-bd4b-a6451bed5f8b",
                                        "entry_id": "e0c2cccb-d40b-35b1-94c9-a71ce737a44c",
                                        "glosses": [
                                            "dergestalt, dass es nicht ausgehalten werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ed1187-e3a3-495e-8bd3-a7b3ce324875",
                                                "sense_id": "727d6031-0c56-3fe9-bd4b-a6451bed5f8b",
                                                "text": "Die Schmerzen nach der Operation waren anfangs unerträglich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d849c2e8-3e05-3c65-aaa8-ec4f6e6bb8a9",
                                        "entry_id": "e0c2cccb-d40b-35b1-94c9-a71ce737a44c",
                                        "glosses": [
                                            "auf andere abstoßend wirkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dd6e437-7fba-4c76-b7cc-6d50346908b1",
                                                "sense_id": "d849c2e8-3e05-3c65-aaa8-ec4f6e6bb8a9",
                                                "text": "Er ist ein unerträglicher Mensch."
                                            },
                                            {
                                                "example_id": "21edc29c-807e-42b7-b5f5-d29047bab7cc",
                                                "sense_id": "d849c2e8-3e05-3c65-aaa8-ec4f6e6bb8a9",
                                                "text": "„Einige Wochen lang konnte ich mich noch so weit beherrschen, die Katze weder zu schlagen noch sonstwie absichtlich schlecht zu behandeln, aber allmählich – mit jedem Tage mehr – sah ich sie nur noch mit unaussprechlichem Abscheu und floh bei ihrem unerträglichen Anblick so entsetzt davon wie vor dem Gifthauch der Pestilenz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "784609f6-101a-400e-aa26-e5c387618481",
                        "source_entry_id": "5aa7d3d5-18cc-32d0-b98c-4c3b17a9597b",
