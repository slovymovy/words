                                    {
                                        "sense_id": "b01654cc-9272-3d24-b9f3-e231aa5374d6",
                                        "entry_id": "04dcd22e-b799-3255-bd82-69d8dafc7b24",
                                        "glosses": [
                                            "A mongrel dog (or sometimes cat); an animal of mixed breed or uncertain origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "315f0671-7bfa-4251-bdc1-cfe8d1b378a3",
                                                "sense_id": "b01654cc-9272-3d24-b9f3-e231aa5374d6",
                                                "text": "Mr. Beerbelly, Beerbelly / Get these mutts away from me / You know, I don't find this stuff amusing anymore"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb08aefe-12ce-3464-85cf-0d22f3d4e2e7",
                                        "entry_id": "04dcd22e-b799-3255-bd82-69d8dafc7b24",
                                        "glosses": [
                                            "A person of mixed racial or ethnic ancestry."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "humorous",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0d97929-a6c1-4280-bad9-6ce05d1eaa8b",
                                                "sense_id": "cb08aefe-12ce-3464-85cf-0d22f3d4e2e7",
                                                "text": "Soon, we will no longer be an outpost of Europe, but a nation of mutts, a nation with hundreds of fluid ethnicities from around the world, intermarrying and intermingling. Americans of European descent are already a minority among 5-year-olds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "387d4f9c-31e4-3b30-a541-04a675bced61",
                                        "entry_id": "04dcd22e-b799-3255-bd82-69d8dafc7b24",
                                        "glosses": [
                                            "An idiot, a stupid person."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf1f8e6a-0625-45ba-ab16-4ee96841d83f",
                                                "sense_id": "387d4f9c-31e4-3b30-a541-04a675bced61",
                                                "text": "Mother fuckin' mutt! You, you fucking piece of shit!"
                                            },
                                            {
                                                "example_id": "559e44c3-9640-4780-b279-c59a3b074424",
                                                "sense_id": "387d4f9c-31e4-3b30-a541-04a675bced61",
                                                "text": "“He’s so blatantly stupid. He’s a punk. He’s a dog. He’s a pig. A con. A bullshit artist. A mutt who doesn’t know what he’s talking about,” he said, among many other things, in a video."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37cb5812-f17c-38b0-9eb8-7eac1e65ad4d",
                                        "entry_id": "04dcd22e-b799-3255-bd82-69d8dafc7b24",
                                        "glosses": [
                                            "A person from the United States, in reference to sense 2."
                                        ],
