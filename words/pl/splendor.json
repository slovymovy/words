{
    "word_family": [
        "splendorny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2184383-8808-3812-b647-a038b32abcfc",
                    "sense_definition": "Wspaniały wygląd, przepych lub okazałość czegoś.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "świetność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cały <w>splendor</w> królewskiego dworu zachwycał przybyłych gości.",
                            "target_lang_translations": {
                                "ru": "Все <w>великолепие</w> королевского двора восхищало прибывших гостей."
                            }
                        },
                        {
                            "text": "Wnętrze pałacu emanowało dawnym <w>splendorem</w> i bogactwem.",
                            "target_lang_translations": {
                                "ru": "Интерьер дворца излучал былое <w>великолепие</w> и богатство."
                            }
                        }
                    ],
                    "synonyms": [
                        "przepych",
                        "okazałość",
                        "świetność"
                    ],
                    "common_phrases": [
                        "cały splendor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Великолепный внешний вид, роскошь или пышность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роскошь",
                                "target_lang_sense_clarification": "богатство и пышность обстановки"
                            },
                            {
                                "target_lang_word": "великолепие",
                                "target_lang_sense_clarification": "впечатляющая красота и пышность"
                            },
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "внешняя яркость и пышность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6453ddc8-e139-3edc-987e-561341816bf4",
                    "sense_definition": "Doznawany przez kogoś zaszczyt, honor lub przywilej.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "zaszczyt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To dla mnie wielki <w>splendor</w> móc wystąpić przed taką publicznością.",
                            "target_lang_translations": {
                                "ru": "Для меня большая <w>честь</w> выступить перед такой публикой."
                            }
                        },
                        {
                            "text": "Przyjęcie nagrody było dla niego największym <w>splendorem</w> w karierze.",
                            "target_lang_translations": {
                                "ru": "Получение награды стало для него величайшей <w>честью</w> в карьере."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaszczyt",
                        "honor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Честь, почет или привилегия, оказываемые кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честь",
                                "target_lang_sense_clarification": "особое уважение и почет"
                            },
                            {
                                "target_lang_word": "почет",
                                "target_lang_sense_clarification": "высокое уважение и признание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}