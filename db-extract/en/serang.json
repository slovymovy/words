                        "examples": [
                            {
                                "example_id": "56c65903-77a5-48ae-b6e3-36c57b450dd2",
                                "sense_id": "0260e55e-9c11-3fc9-ade0-b3641c02be24",
                                "text": "The discovery that the substance in his mouth was of vegetable origin came as no great reassurance to Zachary: once, when the serang spat a stream of blood-red juice over the rail, he noticed the water below coming alive with the thrashing of shark's fins."
                            },
                            {
                                "example_id": "31d0f0f5-2ef0-416f-b2ef-46bf7015f67d",
                                "sense_id": "0260e55e-9c11-3fc9-ade0-b3641c02be24",
                                "text": "The serang or his deputy could serve as a rebel leader or as a point of protest; there were even times when isolated Europeans joined the rebel cause."
                            }
                        ]
