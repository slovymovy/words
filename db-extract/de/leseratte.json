                    {
                        "form_id": "d3e67647-06c1-4e1d-b44c-51c99209b869",
                        "entry_id": "c92e26b3-0b41-37dc-98ab-fef5b9972933",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Leseratten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                        "entry_id": "c92e26b3-0b41-37dc-98ab-fef5b9972933",
                        "glosses": [
                            "Person, die sehr gern und viel liest"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "6a4c9219-33e7-4c7d-8682-4d19a883ef9e",
                                "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                "text": "Sie ist erst in der dritten Klasse und schon eine richtige Leseratte."
                            },
                            {
                                "example_id": "e836b2a9-ed73-4cc3-a434-4a2753da5767",
                                "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                "text": "„Erst da spaltete sich die Versammlung; in Färinger, die gerne sangen, und in Isländer, die als ausgesprochene Leseratten viel lieber den Text vom Blatt ablasen und sich völlig über dem kopierten Liederbuch vergaßen.“"
                            },
                            {
                                "example_id": "cd327366-835f-4dc5-a862-ad345d978d3e",
                                "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                "text": "„Seit Schultagen ist sie eine Leseratte, ihr Haus ist vollgestopft mit tschechischen Büchern.“"
                            },
                            {
                                "example_id": "40b97dec-8576-40ad-9609-ceb0116afa50",
                                "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                "text": "„Vielleicht waren diese Abende ein kleines bisschen ausschlaggebend dafür, dass die Leseratten geworden sind.“"
                            },
                            {
                                "example_id": "040aeb54-b83b-4a6d-9631-df8744e7eeb4",
                                "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                "text": "„Nein, aus dem wird nie eine Leseratte werden, die Trumpfkarte in mütterlichen Konkurrenzkämpfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7a10313-e066-4f9f-ba9c-a342137922c8",
                        "source_entry_id": "c92e26b3-0b41-37dc-98ab-fef5b9972933",
                        "source_sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                        "source_sense_description": "umgangssprachlich, scherzhaft: Person, die sehr gern und viel liest",
                        "target_lang_word": "bookworm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bookworm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efc81015-142f-3904-a505-3567970ee482",
                                        "entry_id": "dcc83b75-7ca7-3a71-9bef-aba35ed01187",
                                        "glosses": [
                                            "Any of various insects that infest books."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cbb5f02-0f57-34f0-b7c4-bd4e115a06bb",
                                        "entry_id": "dcc83b75-7ca7-3a71-9bef-aba35ed01187",
                                        "glosses": [
                                            "An avid book reader."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95bb8eda-c339-4711-939e-034f4b543698",
                                                "sense_id": "6cbb5f02-0f57-34f0-b7c4-bd4e115a06bb",
                                                "text": "“This,” remarked the sedate observer beside me, “is a bookworm,—one of those men who are born to gnaw dead thoughts. His clothes, you see, are covered with the dust of libraries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6883c11a-872b-4de1-9c65-6f916ada3437",
                        "source_entry_id": "c92e26b3-0b41-37dc-98ab-fef5b9972933",
                        "source_sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                        "source_sense_description": "umgangssprachlich, scherzhaft: Person, die sehr gern und viel liest",
                        "target_lang_word": "rat de bibliothèque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rat de bibliothèque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac103326-4ed5-3fe4-9ecf-3bb3a116a628",
                                        "entry_id": "1796cb5f-d287-3653-b8f5-dd7be38345a8",
                                        "glosses": [
                                            "Personne qui fréquente très souvent les bibliothèques ; personne qui passe son temps à lire et à compulser des ouvrages."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e9e19cb-c029-42c3-b739-a8c765ae9c02",
                                                "sense_id": "ac103326-4ed5-3fe4-9ecf-3bb3a116a628",
                                                "text": "[…] Je pensais à Sénèque ;\nMais c’est un vrai pédant, rat de bibliothèque,\nQui croit qu’à l’éloquence il dresse un monument\nEn entassant des mots, poussière sans ciment."
                                            },
                                            {
                                                "example_id": "7f25cf2b-a22d-4fa0-b859-8621ad0a3f4b",
                                                "sense_id": "ac103326-4ed5-3fe4-9ecf-3bb3a116a628",
                                                "text": "On constate ensuite que cet Otto Lidenbrock dissimule sous les apparences d’un rat de bibliothèque un formidable aventurier rompu à toutes les performances physiques et prêt à toutes les audaces."
                                            },
                                            {
                                                "example_id": "cd6a63ce-e07d-4b5b-84c2-8f0750f62d95",
                                                "sense_id": "ac103326-4ed5-3fe4-9ecf-3bb3a116a628",
                                                "text": "Il aurait pu, ainsi, se contenter d’être un rat de bibliothèque. Mais, passionné de littérature (il est chroniqueur au « Monde des livres ») et lui-même écrivain, il se pique de raconter l’histoire autrement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fafbbaea-f61e-48c5-92f0-663dd6630aa4",
                        "source_entry_id": "c92e26b3-0b41-37dc-98ab-fef5b9972933",
                        "source_sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                        "source_sense_description": "umgangssprachlich, scherzhaft: Person, die sehr gern und viel liest",
                        "target_lang_word": "bouquineur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouquineur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57ed909f-a198-35b8-a0ea-2a5563481e41",
                                        "entry_id": "00e39b04-9aaf-33ca-9e46-291d965662f5",
                                        "glosses": [
                                            "Celui qui bouquine."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b9e3620-2d71-4940-8c3c-2962dd759f87",
                                                "sense_id": "57ed909f-a198-35b8-a0ea-2a5563481e41",
                                                "text": "C’est un bouquineur."
                                            },
                                            {
                                                "example_id": "5b310eca-4616-4797-8130-da505632852a",
                                                "sense_id": "57ed909f-a198-35b8-a0ea-2a5563481e41",
                                                "text": "Mais les quais de la Seine exercent encore un autre attrait sur moi : j’y complète mes très graves études sur les bouquineurs et les pêcheurs à la ligne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouquineur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d88a75c8-24b1-349c-88d4-797dc1f28c4b",
                                        "entry_id": "4e53b232-de80-38c4-9460-a3618b8b2111",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc777e3d-4303-4f5e-93ce-7e9875761aa2",
                                                "sense_id": "d88a75c8-24b1-349c-88d4-797dc1f28c4b",
                                                "text": "Il est le saint patron de cette confrérie de lecteurs pour qui la littérature naît dans les pages de ces revues attendant qu’une main amie les tire de la poussière d’une boite bouquineuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
