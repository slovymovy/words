                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c533497-0225-3422-8dc8-c4e1ce25ad43",
                        "entry_id": "01c09d9d-50c1-391d-8c29-0d6817ad1588",
                        "glosses": [
                            "орнитол. название некоторых болотных птиц семейства цапель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8c5b748-5caa-4b28-8c79-b39ff714316d",
                                "sense_id": "4c533497-0225-3422-8dc8-c4e1ce25ad43",
                                "text": "Заметив лодку, выпь забилась в траву, вытянула шею и, подняв голову кверху, замерла на месте."
                            },
                            {
                                "example_id": "47edf714-538f-4fc5-941d-196ecc577d5f",
                                "sense_id": "4c533497-0225-3422-8dc8-c4e1ce25ad43",
                                "text": "Сторож, отчаянно боровшийся с дремотой, обрадовался возможности поговорить и долго, обстоятельно объяснял Антону, что ревёт водяной бугай, по-учёному выпь, угрюмая болотная птица, крик её слышно за километры… Выпь снова испустила пугающий вопль. Должно быть, поняв его как вызов, Бой приподнял башку и глубоким басом бухнул в ответ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddfde6ca-0784-46b2-8136-328d89e5c728",
                        "source_entry_id": "01c09d9d-50c1-391d-8c29-0d6817ad1588",
                        "source_sense_id": "4c533497-0225-3422-8dc8-c4e1ce25ad43",
                        "target_lang_word": "bittern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bittern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8711913-b2fa-334d-98db-b0ced7c1b7c3",
                                        "entry_id": "736a64db-8ea9-3979-8619-8925b5f94647",
                                        "glosses": [
                                            "Several bird species in the Botaurinae subfamily of the heron family Ardeidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcbe8578-ccdb-45ae-98fb-cea5c863832d",
                                                "sense_id": "b8711913-b2fa-334d-98db-b0ced7c1b7c3",
                                                "text": "It is a great rock or cliff on the loneliest part of the mountains, and […] is known by the name of the Garden Rock. Near the foot of it is a small lake, the haunt of the solitary bittern, with water-snakes basking in the sun on the leaves of the pond-lilies which lie on the surface."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bittern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "186d580e-c05f-3ccd-a0b0-39c3df7e838a",
                                        "entry_id": "67b3dbae-2af6-3e48-a540-9c9474caf3de",
                                        "glosses": [
                                            "The liquor remaining after halite (common salt) has been harvested from saline water (brine)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
