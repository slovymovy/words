                    },
                    {
                        "translation_id": "efa95255-881e-4210-971e-362a4e7a29b6",
                        "source_entry_id": "ab89d9ab-fcf8-3b4b-a190-462aeac386c5",
                        "source_sense_id": "dfbead6b-f681-351a-9d18-d1ddd090eab3",
                        "target_lang_word": "goanna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goanna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81068c7c-ded5-395c-997a-5c9e396e277e",
                                        "entry_id": "ca40f749-a746-3979-aa0a-701b06d9e3d6",
                                        "glosses": [
                                            "Any of various monitor lizards native to Australia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c80f7e0-3cb6-4c1a-89a4-9b0f1748b42e",
                                                "sense_id": "81068c7c-ded5-395c-997a-5c9e396e277e",
                                                "text": "Four goannas ran up the tree, and the animals of the bush had preyed so very lavishly on the remains of mortality that the thorax and other parts of the neck, together with various portions of flesh from the body, were missing."
                                            },
                                            {
                                                "example_id": "08d33521-185c-454e-a7e5-e5845f952cab",
                                                "sense_id": "81068c7c-ded5-395c-997a-5c9e396e277e",
                                                "text": "Hello! There's a goanna; that's a good sized one; but nothing to the one that I tumbled over when I was coming from the Big River."
                                            },
                                            {
                                                "example_id": "eb3b9f9b-01c4-4e05-9f56-c48a68cc4a11",
                                                "sense_id": "81068c7c-ded5-395c-997a-5c9e396e277e",
                                                "text": "I'll think of how the kids come alive walking around sandplains / reading tracks, looking for goannas, digging up witchetty grubs / collecting berries, branches of bush medicines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bac77cd-79a3-3c6a-91b8-79741eb6b44a",
                                        "entry_id": "ca40f749-a746-3979-aa0a-701b06d9e3d6",
                                        "glosses": [
                                            "A piano."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcfdc688-e330-4d3e-8531-ce0d12d664b3",
                        "source_entry_id": "ab89d9ab-fcf8-3b4b-a190-462aeac386c5",
