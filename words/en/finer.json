    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2bf352e2-dcb0-3b46-a856-b90cb4692bbe",
                    "sense_definition": "comparative form of <w>fine</w>: more fine",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This silk is much <w>finer</w> than the cotton fabric we used before.",
                            "target_lang_translations": {
                                "ru": "Этот шелк намного <w>более тонкий</w>, чем хлопковая ткань, которую мы использовали раньше."
                            }
                        },
                        {
                            "text": "The artist used a <w>finer</w> brush to paint the small details on the portrait.",
                            "target_lang_translations": {
                                "ru": "Художник использовал <w>более тонкую</w> кисть, чтобы прорисовать мелкие детали на портрете."
                            }
                        }
                    ],
                    "synonyms": [
                        "thinner",
                        "delicater",
                        "superior"
                    ],
                    "antonyms": [
                        "coarser"
                    ],
                    "common_phrases": [
                        "finer detail",
                        "finer quality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень прилагательного «fine»: более тонкий, более изящный, более качественный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более тонкий",
                                "target_lang_sense_clarification": "о текстуре, нитях или деталях"
                            },
                            {
                                "target_lang_word": "более изящный",
                                "target_lang_sense_clarification": "об эстетических качествах"
                            },
                            {
                                "target_lang_word": "более качественный",
                                "target_lang_sense_clarification": "о высоком уровне исполнения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca84fa22-ec94-36b5-8013-94e7e7d6232c",
                    "sense_definition": "One who fines or purifies.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "purification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal <w>finer</w> worked carefully to remove all impurities from the gold.",
                            "target_lang_translations": {
                                "ru": "Металлургический <w>очиститель</w> тщательно работал, чтобы удалить все примеси из золота."
                            }
                        },
                        {
                            "text": "In the old refinery, the <w>finer</w> was responsible for the final stage of processing.",
                            "target_lang_translations": {
                                "ru": "На старом нефтеперерабатывающем заводе <w>рафинировщик</w> отвечал за финальную стадию обработки."
                            }
                        }
                    ],
                    "synonyms": [
                        "refiner",
                        "purifier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто занимается очисткой или рафинированием материалов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очиститель",
                                "target_lang_sense_clarification": "специалист по очистке материалов"
                            },
                            {
                                "target_lang_word": "рафинировщик",
                                "target_lang_sense_clarification": "рабочий на производстве по очистке металлов или масел"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
