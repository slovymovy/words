                "senses": [
                    {
                        "sense_id": "14633d52-62b8-31c9-bc71-e28c63f46feb",
                        "entry_id": "d15d2f27-6716-3f8a-aa5b-e77b6ed4f0ba",
                        "glosses": [
                            "вставлять что-либо куда-либо посредством плетения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af3b5dc-4740-484f-b77e-f1b0af5dd87d",
                                "sense_id": "14633d52-62b8-31c9-bc71-e28c63f46feb",
                                "text": "Она так хотела иметь косу, чтобы вплетать в неё вишнёвую ленту."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5e59d59-4ada-354a-a0d2-edb903396eff",
                        "entry_id": "d15d2f27-6716-3f8a-aa5b-e77b6ed4f0ba",
                        "glosses": [
                            "перен. вставлять что-либо (часто вымышленное) в рассказ, повествование"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "689e7af5-2881-492b-ad1d-09f5d1a8d6e7",
                                "sense_id": "a5e59d59-4ada-354a-a0d2-edb903396eff",
                                "text": "Валиев не вплетал в ткань повествования ярких эпизодов, не старался выставить себя героем, изъяснялся просто и лаконично."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef19886d-ca7c-313b-90cb-fa59fb7944a8",
                        "entry_id": "d15d2f27-6716-3f8a-aa5b-e77b6ed4f0ba",
                        "glosses": [
                            "перен. впутывать, делать замешанным во что-либо, причастным к чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a3e0c40-638e-4cd8-a160-ee03849b69af",
                                "sense_id": "ef19886d-ca7c-313b-90cb-fa59fb7944a8",
                                "text": "Давайте не будем хотя бы Деда Мороза и Снегурочку вплетать в политические игры."
                            }
                        ]
                    }
                ],
