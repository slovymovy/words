                "forms": [],
                "senses": [
                    {
                        "sense_id": "106be6e4-c88e-376b-8b47-56139d183d6f",
                        "entry_id": "1b2d2955-c4d0-3aa9-843e-0b5cba1e3f8c",
                        "glosses": [
                            "Mockery; derision."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d28e23e-d9d9-4f52-8d03-1c72cbd0a2b9",
                                "sense_id": "106be6e4-c88e-376b-8b47-56139d183d6f",
                                "text": "[…] And flattery tipt with nauseous fleer,\nAnd guilty shame, and servile fear,\nEnvy, and cruelty, and pride,\nWill in your tainted heart preside."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
