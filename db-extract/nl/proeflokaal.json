                        "glosses": [
                            "horecagelegenheid waar de nadruk ligt op het proeven van een bepaalde soort drank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "539a9177-c1a3-463b-824b-e5ff4c106151",
                                "sense_id": "18bb6ef9-481e-3874-b85c-59cdbf0f40e7",
                                "text": "In proeflokaal België kun je veel verschillende soorten Belgisch bier uitproberen."
                            },
                            {
                                "example_id": "4b4ca88a-131a-46ff-ac60-7c3c2bd14f4a",
                                "sense_id": "18bb6ef9-481e-3874-b85c-59cdbf0f40e7",
                                "text": "‘Hendrick daagt je uit!’, staat er op de kaart. En de gerechten klinken inderdaad spannend: zelfgemaakte eendenham met gefermenteerde bloemkool, rouleaux van makreel met jus van gepofte knoflook en geschaafde makreel, spareribs met gefrituurde zuurkool, eendenstoof met gefermenteerde pompoen en krokante tortilla. Bijzonder leuk is ook dat er bij elk gerecht niet alleen een bijpassende wijnsuggestie wordt gedaan (14,50 euro voor drie gangen) maar ook een bijpassend bier wordt aangeraden, uit het inpandige proeflokaal. (15,50 euro)."
                            }
                        ]
                    }
