        "fr-extract.jsonl": [
            {
                "entry_id": "a1c26a03-3fcd-37bd-adc2-a34ed722e01e",
                "word": "chemineau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "98d35dc1-2335-453b-8f90-bc0164d49754",
                        "entry_id": "a1c26a03-3fcd-37bd-adc2-a34ed722e01e",
                        "tags": [
                            "plural"
                        ],
                        "form": "chemineaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40eb6d91-7b36-362f-8dd5-5df02a516812",
                        "entry_id": "a1c26a03-3fcd-37bd-adc2-a34ed722e01e",
                        "glosses": [
                            "Ouvrier qui parcourt les campagnes."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "de6b5343-5909-459a-a02d-9195a7cd2a60",
                                "sense_id": "40eb6d91-7b36-362f-8dd5-5df02a516812",
                                "text": "Comme le chemineau chemine, le trottin trottine."
                            },
                            {
                                "example_id": "f7f86b46-0910-4129-a5fd-ba4c4d9b3d56",
                                "sense_id": "40eb6d91-7b36-362f-8dd5-5df02a516812",
                                "text": "Notre voisin, enrhumé et doux, secoué d’éternuements en série, ne manquait pas de déguiser ses cerisiers en vieux chemineaux et coiffait ses groseilliers de gibus poilus."
                            },
                            {
                                "example_id": "2f02fb99-7879-4d1c-89b7-bf68cf724b3e",
                                "sense_id": "40eb6d91-7b36-362f-8dd5-5df02a516812",
                                "text": "Il est à moitié mort de fatigue et de froid, car il a voyagé pendant plusieurs jours à la manière d’un chemineau, avec un paquet de hardes et des outils sur l’épaule."
                            }
                        ]
                    },
                    {
                        "sense_id": "48f0e7a6-f293-3dbe-9075-d32e7e773988",
                        "entry_id": "a1c26a03-3fcd-37bd-adc2-a34ed722e01e",
                        "glosses": [
                            "Vagabond, rôdeur, qui vit de petites besognes, d’aumônes ou de larcins."
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "deb6183e-5715-45e6-aca6-0169c2f21165",
                                "sense_id": "48f0e7a6-f293-3dbe-9075-d32e7e773988",
                                "text": "— Faut pas être fier tout de même, pour se contenter des restes des chemineaux et des camps volants, qui roulent le long du canal."
                            },
                            {
                                "example_id": "848f1d1d-b91b-4ed1-aea0-d7776d5e654e",
                                "sense_id": "48f0e7a6-f293-3dbe-9075-d32e7e773988",
                                "text": "Il ferma la porte avec fracas et ils l’entendirent distinctement dire à sa femme en se servant du mot dont on désigne les chemineaux :\n– C’est un roulant avec sa roulante."
                            },
                            {
                                "example_id": "d29d02a1-5c22-418b-8213-c22ec6538c92",
                                "sense_id": "48f0e7a6-f293-3dbe-9075-d32e7e773988",
                                "text": "Un chemineau, éconduit à la nuit tombante par notre cuisinière, refusait de s’éloigner, glissait son gourdin entre les battants de la porte d’entrée, jusqu’à l’arrivée de mon père…"
                            },
                            {
                                "example_id": "7d61ab7d-9bd9-4310-90bf-942c2815cbb2",
                                "sense_id": "48f0e7a6-f293-3dbe-9075-d32e7e773988",
                                "text": "Dans l’antichambre, l’homme mal rasé, au veston sale, me dévisagea, comme un chien de garde soupçonneux regarde passer un chemineau."
                            },
                            {
                                "example_id": "a351969e-f27f-4fa5-ac7a-3f5593f826d7",
                                "sense_id": "48f0e7a6-f293-3dbe-9075-d32e7e773988",
                                "text": "Le plus crasseux des chemineaux se sentirait atteint dans sa dignité d’homme si quelque aubergiste des plaines lui proposait pareil logement. Mais, pour nous autres, c’est tout simplement un palais où nous pénétrons avec ravissement. Tel est le miracle des hautes altitudes."
                            }
                        ]
                    }
                ],
