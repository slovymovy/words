{
    "word_family": [
        "suggestion",
        "suggestible",
        "suggestive",
        "autosuggestion"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79df55d5-4e5d-3194-b591-8331c3b998f0",
                    "sense_definition": "To mention an idea, plan, or person for other people to consider.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "propose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like to <w>suggest</w> a different approach to solving this problem.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы <w>предложить</w> другой подход к решению этой проблемы."
                            }
                        },
                        {
                            "text": "Can you <w>suggest</w> a good restaurant for our dinner tonight?",
                            "target_lang_translations": {
                                "ru": "Можете <w>посоветовать</w> хороший ресторан для нашего ужина сегодня вечером?"
                            }
                        }
                    ],
                    "synonyms": [
                        "propose",
                        "bring up"
                    ],
                    "common_phrases": [
                        "suggest a solution",
                        "suggest a restaurant",
                        "suggest an alternative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предложить идею, план или кандидатуру человека на рассмотрение другим людям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предложить",
                                "target_lang_sense_clarification": "выдвинуть идею или план"
                            },
                            {
                                "target_lang_word": "посоветовать",
                                "target_lang_sense_clarification": "дать рекомендацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e850d307-a804-340b-9955-d5e97ac4c555",
                    "sense_definition": "To cause someone to think about something or to show that something is likely to be true.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indicate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Recent studies <w>suggest</w> that drinking coffee might have health benefits.",
                            "target_lang_translations": {
                                "ru": "Недавние исследования <w>указывают</w> на то, что употребление кофе может быть полезным для здоровья."
                            }
                        },
                        {
                            "text": "The evidence <w>suggests</w> a link between the two events.",
                            "target_lang_translations": {
                                "ru": "Улики <w>свидетельствуют</w> о связи между этими двумя событиями."
                            }
                        }
                    ],
                    "synonyms": [
                        "evoke",
                        "hint"
                    ],
                    "common_phrases": [
                        "evidence suggests",
                        "studies suggest",
                        "data suggests"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наводить на мысль о чем-либо или указывать на то, что что-то, вероятно, является правдой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указывать",
                                "target_lang_sense_clarification": "свидетельствовать о чем-либо"
                            },
                            {
                                "target_lang_word": "говорить о том, что",
                                "target_lang_sense_clarification": "давать основания полагать"
                            },
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "подтверждать вероятность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ec6f51e-5724-3c2d-bcc2-2000f2721cd9",
                    "sense_definition": "To communicate an idea or feeling without saying it directly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you <w>suggesting</w> that I am not telling the truth?",
                            "target_lang_translations": {
                                "ru": "Вы <w>намекаете</w> на то, что я говорю неправду?"
                            }
                        },
                        {
                            "text": "His tone of voice seemed to <w>suggest</w> that he was unhappy with the decision.",
                            "target_lang_translations": {
                                "ru": "Его тон, казалось, <w>говорил</w> о том, что он недоволен решением."
                            }
                        }
                    ],
                    "synonyms": [
                        "imply",
                        "insinuate",
                        "allude"
                    ],
                    "common_phrases": [
                        "suggest that",
                        "strongly suggest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать мысль или чувство косвенно, не говоря об этом прямо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намекать",
                                "target_lang_sense_clarification": "давать понять косвенно"
                            },
                            {
                                "target_lang_word": "подразумевать",
                                "target_lang_sense_clarification": "иметь в виду без прямого упоминания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "117fe8a1-74df-36f1-b461-80d91363456b",
                    "sense_definition": "To tempt someone to do something wrong or evil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain tried to <w>suggest</w> wicked thoughts to the young prince.",
                            "target_lang_translations": {
                                "ru": "Злодей пытался <w>внушить</w> коварные мысли молодому принцу."
                            }
                        },
                        {
                            "text": "He was easily <w>suggested</w> into committing the crime by his peers.",
                            "target_lang_translations": {
                                "ru": "Сверстники легко <w>подстрекнули</w> его на совершение преступления."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is primarily found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонять кого-либо к совершению чего-то дурного или злого (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внушать",
                                "target_lang_sense_clarification": "вселять дурные мысли"
                            },
                            {
                                "target_lang_word": "подстрекать",
                                "target_lang_sense_clarification": "склонять к преступлению"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}