{
    "word_family": [
        "microchip",
        "woodchip",
        "chipper",
        "chipping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ea45036-63ba-308d-b382-ed31ab3a431a",
                    "sense_definition": "A thin, crisp, fried slice of potato, often eaten as a snack.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_us",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He opened a bag of potato <w>chips</w> while watching the movie.",
                            "target_lang_translations": {
                                "ru": "Он открыл пакет картофельных <w>чипсов</w> во время просмотра фильма.",
                                "zh": "他看电影时打开了一袋<w>薯片</w>。"
                            }
                        },
                        {
                            "text": "We served tortilla <w>chips</w> with spicy salsa at the party.",
                            "target_lang_translations": {
                                "ru": "Мы подали кукурузные <w>чипсы</w> с острой сальсой на вечеринке.",
                                "zh": "我们在派对上提供了玉米<w>薯片</w>和辣味莎莎酱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crisp",
                        "potato chip"
                    ],
                    "common_phrases": [
                        "potato chips",
                        "tortilla chips",
                        "corn chips",
                        "bag of chips"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America, Australia, New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий, хрустящий, обжаренный ломтик картофеля, который часто едят как закуску.",
                        "zh": "一种薄而脆的油炸马铃薯片，常作为零食食用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чипсы",
                                "target_lang_sense_clarification": "закуска"
                            },
                            {
                                "target_lang_word": "чипс",
                                "target_lang_sense_clarification": "один ломтик"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "薯片",
                                "target_lang_sense_clarification": "零食"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b44ed30-74b1-3fa4-97e4-2084627b00ee",
                    "sense_definition": "A long, deep-fried strip of potato, usually eaten hot as a meal or side dish.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_uk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fish and <w>chips</w> is a traditional and popular British dish.",
                            "target_lang_translations": {
                                "ru": "Рыба с <w>картофелем фри</w> — традиционное и популярное британское блюдо.",
                                "zh": "炸鱼<w>薯条</w>是一道传统且受欢迎的英国菜。"
                            }
                        },
                        {
                            "text": "She ordered a burger with a side of <w>chips</w>.",
                            "target_lang_translations": {
                                "ru": "Она заказала бургер с порцией <w>картофеля фри</w>.",
                                "zh": "她点了一个汉堡，配了一份<w>炸薯条</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fry",
                        "French fry"
                    ],
                    "common_phrases": [
                        "fish and chips",
                        "hot chips",
                        "steak and chips"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom, Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный обжаренный брусочек картофеля, который обычно едят горячим как основное блюдо или гарнир.",
                        "zh": "一种长条状的油炸马铃薯，通常作为热食或配菜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картофель фри",
                                "target_lang_sense_clarification": "блюдо"
                            },
                            {
                                "target_lang_word": "жареная картошка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炸薯条",
                                "target_lang_sense_clarification": "食物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ef5e4db-8af0-347f-b727-50ea65734100",
                    "sense_definition": "A very small piece of silicon containing a set of electronic circuits.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new computer <w>chip</w> processes data much faster than the old one.",
                            "target_lang_translations": {
                                "ru": "Новый компьютерный <w>чип</w> обрабатывает данные намного быстрее старого.",
                                "zh": "这款新的电脑<w>芯片</w>处理数据的速度比旧款快得多。"
                            }
                        },
                        {
                            "text": "Engineers are designing a smaller <w>chip</w> for mobile devices.",
                            "target_lang_translations": {
                                "ru": "Инженеры разрабатывают более компактную <w>микросхему</w> для мобильных устройств.",
                                "zh": "工程师们正在为移动设备设计更小的<w>芯片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "microchip",
                        "integrated circuit"
                    ],
                    "common_phrases": [
                        "computer chip",
                        "silicon chip",
                        "memory chip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленький кусочек кремния, содержащий набор электронных схем.",
                        "zh": "一种包含电子电路的微小硅片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чип",
                                "target_lang_sense_clarification": "электроника"
                            },
                            {
                                "target_lang_word": "микросхема",
                                "target_lang_sense_clarification": "компонент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "芯片",
                                "target_lang_sense_clarification": "电子元件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61415a7a-b267-3e64-b4c6-9bfba619786d",
                    "sense_definition": "A damaged area on a surface where a small piece has been broken off.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damage_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a noticeable <w>chip</w> in the rim of my favorite mug.",
                            "target_lang_translations": {
                                "ru": "На ободке моей любимой кружки заметный <w>скол</w>.",
                                "zh": "我最喜欢的马克杯杯沿上有一个明显的<w>缺口</w>。"
                            }
                        },
                        {
                            "text": "The car had a small <w>chip</w> in the paint from a flying stone.",
                            "target_lang_translations": {
                                "ru": "На краске автомобиля был маленький <w>скол</w> от отлетевшего камня.",
                                "zh": "车漆上有一个被飞石砸出的<w>缺口</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chip in the paint",
                        "chip in the glass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поврежденный участок на поверхности, где откололся небольшой кусочек.",
                        "zh": "物体表面因破损而缺掉的一小块区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скол",
                                "target_lang_sense_clarification": "на поверхности"
                            },
                            {
                                "target_lang_word": "щербина",
                                "target_lang_sense_clarification": "на краю или лезвии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺口",
                                "target_lang_sense_clarification": "表面破损"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aac9166b-0f9b-3b93-8b6d-2d153e980ea0",
                    "sense_definition": "A small piece of hard material that has been broken off from a larger piece.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ground was covered in wood <w>chips</w> after they cut down the tree.",
                            "target_lang_translations": {
                                "ru": "Земля была покрыта древесными <w>щепками</w> после того, как срубили дерево.",
                                "zh": "树被砍倒后，地上铺满了木<w>碎片</w>。"
                            }
                        },
                        {
                            "text": "Be careful not to step on the sharp <w>chips</w> of glass.",
                            "target_lang_translations": {
                                "ru": "Осторожно, не наступи на острые <w>осколки</w> стекла.",
                                "zh": "小心别踩到尖锐的玻璃<w>碎片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fragment",
                        "shard",
                        "splinter",
                        "flake"
                    ],
                    "common_phrases": [
                        "wood chips",
                        "paint chips",
                        "chocolate chip",
                        "ice chips"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой кусочек твердого материала, отколовшийся от большего куска.",
                        "zh": "从较大物体上破碎下来的小块硬质材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щепка",
                                "target_lang_sense_clarification": "дерево"
                            },
                            {
                                "target_lang_word": "осколок",
                                "target_lang_sense_clarification": "стекло, камень"
                            },
                            {
                                "target_lang_word": "обломок",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碎片",
                                "target_lang_sense_clarification": "破碎的小块"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4adacef1-cf4d-32d6-963a-d250aa8ef84d",
                    "sense_definition": "A small plastic disc used to represent money in gambling or games.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "token",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He placed a stack of red <w>chips</w> on the table to make his bet.",
                            "target_lang_translations": {
                                "ru": "Он положил стопку красных <w>фишек</w> на стол, чтобы сделать ставку.",
                                "zh": "他把一叠红色的<w>筹码</w>放在桌上进行下注。"
                            }
                        },
                        {
                            "text": "After the game, she exchanged her <w>chips</w> for cash.",
                            "target_lang_translations": {
                                "ru": "После игры она обменяла свои <w>фишки</w> на наличные.",
                                "zh": "游戏结束后，她把<w>筹码</w>兑换成了现金。"
                            }
                        }
                    ],
                    "synonyms": [
                        "token",
                        "counter"
                    ],
                    "common_phrases": [
                        "poker chips",
                        "casino chips",
                        "bargaining chip",
                        "blue chip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой пластиковый диск, используемый вместо денег в азартных играх.",
                        "zh": "博彩或游戏中用来代表钱币的小塑料圆片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фишка",
                                "target_lang_sense_clarification": "игровой жетон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "筹码",
                                "target_lang_sense_clarification": "游戏代币"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e433a41-0f44-389f-a2cb-8061620a712a",
                    "sense_definition": "A shot in sports like golf or soccer where the ball is hit high into the air for a short distance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The golfer played a perfect <w>chip</w> onto the green.",
                            "target_lang_translations": {
                                "ru": "Гольфист выполнил идеальную <w>подсечку</w> на грин.",
                                "zh": "高尔夫球手打出了一个完美的<w>挑球</w>，球落在了果岭上。"
                            }
                        },
                        {
                            "text": "His <w>chip</w> over the goalkeeper landed softly in the net.",
                            "target_lang_translations": {
                                "ru": "Его <w>навесной удар</w> через вратаря мягко опустился в сетку.",
                                "zh": "他越过守门员的<w>挑球</w>轻柔地落入了网中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chip shot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удар в спорте (гольф, футбол), при котором мяч высоко подбрасывается в воздух на небольшое расстояние.",
                        "zh": "体育运动中将球高高挑起并使其短距离落地的击球方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсечка",
                                "target_lang_sense_clarification": "технический прием"
                            },
                            {
                                "target_lang_word": "навесной удар",
                                "target_lang_sense_clarification": "тип удара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑球",
                                "target_lang_sense_clarification": "运动技术"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47985927-7acd-3520-9fc5-b85a92a18267",
                    "sense_definition": "To break a small piece off the edge or surface of an object, or to be broken in this way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damage_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful when washing the dishes so you do not <w>chip</w> the glasses.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, когда моешь посуду, чтобы не <w>отколоть</w> края у стаканов.",
                                "zh": "洗碗时要小心，以免把玻璃杯<w>磕碰</w>出缺口。"
                            }
                        },
                        {
                            "text": "The nail polish started to <w>chip</w> only a day after she applied it.",
                            "target_lang_translations": {
                                "ru": "Лак для ногтей начал <w>откалываться</w> всего через день после нанесения.",
                                "zh": "指甲油涂上才一天就开始<w>磕碰</w>脱落了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chip a tooth",
                        "chip the paint",
                        "chip easily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отламывать небольшой кусочек от края или поверхности предмета, или ломаться таким образом.",
                        "zh": "使物体边缘或表面破损，或物体本身发生破损。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откалывать",
                                "target_lang_sense_clarification": "что-то"
                            },
                            {
                                "target_lang_word": "откалываться",
                                "target_lang_sense_clarification": "самому"
                            },
                            {
                                "target_lang_word": "щербиться",
                                "target_lang_sense_clarification": "покрываться сколами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磕碰",
                                "target_lang_sense_clarification": "导致破损"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f3fe098-de60-3aa2-afa4-38f8b54cb504",
                    "sense_definition": "To contribute money or help towards a shared cause or activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We all decided to <w>chip</w> in five dollars for the teacher's gift.",
                            "target_lang_translations": {
                                "ru": "Мы все решили <w>скинуться</w> по пять долларов на подарок учителю.",
                                "zh": "我们决定每人<w>凑钱</w>五美元给老师买礼物。"
                            }
                        },
                        {
                            "text": "If everyone helps to <w>chip</w> in, we can finish the work quickly.",
                            "target_lang_translations": {
                                "ru": "Если каждый поможет <w>внести вклад</w>, мы сможем быстро закончить работу.",
                                "zh": "如果每个人都帮忙<w>凑钱</w>（或出力），我们就能很快完成工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contribute"
                    ],
                    "common_phrases": [
                        "chip in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вносить деньги или помощь в общее дело.",
                        "zh": "为共同的事业或活动捐钱或提供帮助。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скидываться",
                                "target_lang_sense_clarification": "деньгами (разг.)"
                            },
                            {
                                "target_lang_word": "вносить вклад",
                                "target_lang_sense_clarification": "участвовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凑钱",
                                "target_lang_sense_clarification": "共同出资"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2741ed2a-59f8-3e25-b93a-96b19624bcb1",
                    "sense_definition": "To kick or hit a ball so that it goes high into the air and lands a short distance away.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>chip</w> the ball over the defender's head.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>перебросить</w> мяч через голову защитника.",
                                "zh": "他成功地将球<w>挑射</w>过防守队员的头顶。"
                            }
                        },
                        {
                            "text": "The player tried to <w>chip</w> the goalkeeper but missed the goal.",
                            "target_lang_translations": {
                                "ru": "Игрок попытался <w>перебросить</w> вратаря, но не попал в ворота.",
                                "zh": "球员试图<w>挑射</w>过守门员，但没能进球。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chip the ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударять по мячу так, чтобы он взлетел высоко в воздух и приземлился на небольшом расстоянии.",
                        "zh": "踢球或击球使其高高飞起并落在不远处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перебрасывать",
                                "target_lang_sense_clarification": "через препятствие"
                            },
                            {
                                "target_lang_word": "подсекать",
                                "target_lang_sense_clarification": "мяч"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑射",
                                "target_lang_sense_clarification": "运动动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546cec20-f9d7-33c2-b4b1-3d1d88ff3b61",
                    "sense_definition": "To cut or chop something into small pieces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine is used to <w>chip</w> wood into mulch for the garden.",
                            "target_lang_translations": {
                                "ru": "Эта машина используется, чтобы <w>измельчать</w> древесину в мульчу для сада.",
                                "zh": "这台机器用于将木头<w>切碎</w>成花园用的覆盖物。"
                            }
                        },
                        {
                            "text": "They had to <w>chip</w> away the ice that had formed on the windshield.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>отбивать</w> лед, образовавшийся на лобовом стекле.",
                                "zh": "他们不得不把挡风玻璃上结的冰<w>切碎</w>（敲掉）。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chip away"
