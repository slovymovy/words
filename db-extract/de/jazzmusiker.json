                                        "sense_id": "0a10a269-12e7-3558-81cc-7bd3a352dedc",
                                        "entry_id": "50959b4c-a114-3d43-81d2-f6bd4e47a339",
                                        "glosses": [
                                            "A male member of a jazz band."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "601865d6-601d-48e5-8fb3-e5d117321159",
                                                "sense_id": "0a10a269-12e7-3558-81cc-7bd3a352dedc",
                                                "text": "I was cut out to be a jazzman the way the righteous are chosen for the church."
                                            }
                                        ]
                                    }
                                ]
