                "senses": [
                    {
                        "sense_id": "6a0ee6b3-a508-39c4-8048-de10e83a2468",
                        "entry_id": "9e9be6a7-a1e0-356a-852d-6cefd79a3e7b",
                        "glosses": [
                            "Gesamtheit der zur Herstellung von Kleidungsstücken benötigten Materialien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cdac8ad-e8de-49c4-bd00-b56049a17fb9",
                                "sense_id": "6a0ee6b3-a508-39c4-8048-de10e83a2468",
                                "text": "„Schneiderzugehöre und Futterwaren haben mit den Oberstoffen gemeinsame Bezugsquellen.“"
                            },
                            {
                                "example_id": "72136ab1-d6ff-4a70-94ca-18b8b175cc4a",
                                "sense_id": "6a0ee6b3-a508-39c4-8048-de10e83a2468",
                                "text": "„Er ist auch beim Schwager, der mit Schneiderzugehör handelt, angestellt.“"
                            },
                            {
                                "example_id": "e1d97c3a-3a0b-4807-81d2-2c921e30a4f8",
                                "sense_id": "6a0ee6b3-a508-39c4-8048-de10e83a2468",
                                "text": "„Damenkleidermacher kaufen am billigsten Mull, Tarlatane, Crepe-lisse, Atlasse, Seidenstoffe, das neueste in Posamentrie sowie alle Gattungen Schneiderzugehör bei Anton Bönisch, Wien, WII., Kirchengasse Nr. 16.“"
                            },
                            {
                                "example_id": "2117a9c1-bec9-4ee0-a563-b9e53b84aeb9",
                                "sense_id": "6a0ee6b3-a508-39c4-8048-de10e83a2468",
                                "text": "„Dann wurde das dem Siegmund Engelstein gehörende Geschäft mit Schneiderzugehör am Allerheiligen-Platz ausgeplündert und ihm hierdurch ein Schaden von rund 70.320 K zugefügt.“"
                            },
                            {
                                "example_id": "cee145b0-169f-4e93-bdbb-2cd8746d57b0",
                                "sense_id": "6a0ee6b3-a508-39c4-8048-de10e83a2468",
                                "text": "„Diese Arbeitsmittel sind das Schneiderzugehör und das Schuhmacherzugehör.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
