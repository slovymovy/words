                "senses": [
                    {
                        "sense_id": "9412c31f-8152-3aa2-bbcf-967038e48536",
                        "entry_id": "7c53c1f6-cd8d-305b-ae73-9477e57cf7d3",
                        "glosses": [
                            "indirektes, lichtelektrisches und trockenes Vervielfältigungsverfahren"
                        ],
                        "tags": [
                            "Druckwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "51a930b9-4a70-4683-8354-4d19f9dbd43a",
                                "sense_id": "9412c31f-8152-3aa2-bbcf-967038e48536",
                                "text": "„Monitore benutzen die aus der Elektrodynamik kommende Kathodenstrahlröhre bzw. die Flüssigkristall-Technik (LCD, englisch Liquid Crystal Display) aus der Physik der kondensierten Materie, und Laserdrucker beruhen auf der Xerographie, die wiederum auf der Photosensibilisierung und der Elektrostatik basiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dab1dfc5-fbc7-392e-a563-d267388b87c7",
                        "entry_id": "7c53c1f6-cd8d-305b-ae73-9477e57cf7d3",
                        "glosses": [
                            "Erzeugnis, das durch Anwendung der Xerographie^([1]) hergestellt wurde"
                        ],
                        "tags": [
                            "Druckwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "95ad881a-eb51-41bd-a4e7-64d852217723",
                                "sense_id": "dab1dfc5-fbc7-392e-a563-d267388b87c7",
                                "text": "„Unter Beachtung des Urheberrechts, des Bestandsschutzes und der Vorlageform können Mikrofilme, Xerographien, Folien, Mikrofilm - oder Mikrofiche-Rückvergrößerungen sowie Fotoabzüge und Overheadfolien hergestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
