                "translations": [
                    {
                        "translation_id": "76ac7f66-0604-474a-8f7f-c35745a1b498",
                        "source_entry_id": "3eddc01e-9cc8-380e-8073-cc903b6069dd",
                        "source_sense_id": "d11b1067-20a8-319b-9be4-d30f328de0a9",
                        "target_lang_word": "ileus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ileus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d686a4fd-0240-397d-9eff-c6cb337403e7",
                                        "entry_id": "2adfdbb3-b6fb-3d83-bb28-282b267c5155",
                                        "glosses": [
                                            "Disruption of the normal propulsive ability of the gastrointestinal tract, due to failure of peristalsis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2220ed16-d0a4-3d1f-9bdc-cc53e6a5212c",
                                        "entry_id": "2adfdbb3-b6fb-3d83-bb28-282b267c5155",
                                        "glosses": [
                                            "Disruption of the normal propulsive ability of the gastrointestinal tract from any cause."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f50020a-4886-460d-b12a-0f67fea87a3b",
                                                "sense_id": "2220ed16-d0a4-3d1f-9bdc-cc53e6a5212c",
                                                "text": "1796, Erasmus Darwin, Zoonomia, Volume II: Classes of Diseases, IV: Diseases of Association, Ordo III: Retrograde Associate Motions, Genus II: Catenated with sensitive motions,\nThe perpetual vomiting in ileus is caused in like manner by the defective excitement of the sensorial power of association by the bowel, which is torpid during the intervals of pain; and the stomach sympathizes with it."
                                            },
                                            {
                                                "example_id": "1f75df1b-be33-465d-b06e-1652e48084ab",
                                                "sense_id": "2220ed16-d0a4-3d1f-9bdc-cc53e6a5212c",
                                                "text": "When ileus comes on in a case of strangury, they prove fatal in seven days, unless, fever supervening, there be a copious discharge of urine."
                                            },
                                            {
                                                "example_id": "3560e3cd-9d9b-4814-987d-9f2893f19433",
                                                "sense_id": "2220ed16-d0a4-3d1f-9bdc-cc53e6a5212c",
                                                "text": "You must expect to lose from 40% to 60% of all acute post operative ileuses, and about 20% of your sub-acute cases."
                                            },
                                            {
                                                "example_id": "8875c3f6-8ce1-4cb5-85e2-2a6884ebc49d",
                                                "sense_id": "2220ed16-d0a4-3d1f-9bdc-cc53e6a5212c",
                                                "text": "Thus, ileus also has potential detrimental effects in sterile peritonitis by providing a source and mechanism for entry of bacteria into the peritoneal cavity.\nOther factors commonly encountered in animals with peritonitis may also predispose to adynamic ileus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
