                        "examples": [
                            {
                                "example_id": "dc971dec-2851-4845-9494-de4e6ee0af19",
                                "sense_id": "95dcf74a-fe04-308b-86c1-1d3f3704f17b",
                                "text": "„Fleisch mit Mandelsplittern kommt auf die andere Hälfte des Tellers, an die Neun-Uhr-Position.“"
                            },
                            {
                                "example_id": "3bafd28d-2540-4f43-9996-714fa7e72c1c",
                                "sense_id": "95dcf74a-fe04-308b-86c1-1d3f3704f17b",
                                "text": "„Der alte Mann nahm den Tiegel vom Feuer, rührte mit einem Holzlöffel kräftig in dem Gebräu und streute ein paar dünne Mandelsplitter über die Flüssigkeit.“"
                            }
                        ],
