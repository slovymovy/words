                "senses": [
                    {
                        "sense_id": "006f1fb8-f2dc-3798-8b29-049030f4bbec",
                        "entry_id": "1c3c7c0c-024c-3ba3-aab7-094f1690d2d2",
                        "glosses": [
                            "aus der Ferne wahrgenommener Donner"
