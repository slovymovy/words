                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7975feac-0432-43b6-a3e7-8fc825be3426",
                                                "sense_id": "01826f2a-5c91-31a6-961a-a763438b30e7",
                                                "text": "I peeled (the skin from) a banana and ate it hungrily."
                                            },
                                            {
                                                "example_id": "40783e87-c155-4994-8202-d7aa8dcb4bee",
                                                "sense_id": "01826f2a-5c91-31a6-961a-a763438b30e7",
                                                "text": "We peeled the old wallpaper off in strips where it was hanging loose."
                                            }
                                        ]
                                    },
                                    {
