                        "territoire inconnu"
                    ]
                },
                {
                    "sense_id": "f2193ce0-bb89-32f3-a0e5-1fcb05d7d257",
                    "sense_definition": "Zone ou bassin de vie habité par une population et caractérisé par des réalités sociales ou économiques communes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement cherche à redynamiser l'économie locale dans les <w>territoires</w> ruraux."
                        },
                        {
                            "text": "L'accès aux services publics reste difficile pour les résidents de ces <w>territoires</w> isolés."
                        }
                    ],
                    "common_phrases": [
