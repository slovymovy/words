    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d578913e-5e7b-31d9-8116-f4db483c7f2d",
                    "sense_definition": "Heurter violemment un autre véhicule ou un obstacle lors d'un accident de la circulation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "collision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur imprudent a <w>tamponné</w> la voiture arrêtée devant lui au feu rouge."
                        },
                        {
                            "text": "Un camion a perdu le contrôle sur la chaussée mouillée et a <w>tamponné</w> une barrière."
                        }
                    ],
                    "synonyms": [
                        "percuter",
                        "heurter",
                        "emboutir"
                    ],
                    "antonyms": [
                        "éviter"
                    ],
                    "common_phrases": [
                        "tamponner un véhicule",
                        "tamponner une voiture"
                    ]
                },
                {
                    "sense_id": "4fab40f1-b7d7-3f08-a13c-36056ad3ec4f",
                    "sense_definition": "Toucher ou essuyer doucement une plaie ou une partie du corps avec un tampon de coton ou de gaze.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière <w>tamponne</w> délicatement la plaie avec une compresse stérile pour arrêter le saignement."
                        },
                        {
                            "text": "Elle a pris un mouchoir propre pour <w>tamponner</w> son front humide de sueur."
                        }
                    ],
                    "synonyms": [
                        "éponger"
                    ],
                    "common_phrases": [
                        "tamponner la plaie",
                        "tamponner le front"
                    ]
                },
                {
                    "sense_id": "a6e7b601-ca8b-3f7b-bf13-4aa218f776de",
                    "sense_definition": "Boucher ou fermer une ouverture à l'aide d'un tampon.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fermeture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vigneron doit <w>tamponner</w> hermétiquement le tonneau pour préserver la qualité du vin."
                        },
                        {
                            "text": "Avant de ranger les flacons, veillez à bien <w>tamponner</w> le goulot avec du liège."
                        }
                    ],
                    "synonyms": [
                        "boucher",
                        "obturer"
                    ],
                    "antonyms": [
                        "déboucher",
                        "ouvrir"
                    ]
                },
                {
                    "sense_id": "114b33d9-2e19-3db9-901f-e22880c6377c",
                    "sense_definition": "Maintenir constant ou réguler le pH d'une solution chimique ou d'un milieu biologique grâce à une substance tampon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce système biologique permet de <w>tamponner</w> l'acidité produite pendant un effort musculaire intense."
                        },
                        {
                            "text": "Le chimiste ajoute un sel spécifique pour <w>tamponner</w> la solution avant la mesure."
                        }
                    ],
                    "common_phrases": [
                        "tamponner une solution",
                        "tamponner l'acidité"
                    ]
                },
                {
                    "sense_id": "157dea79-ad35-381c-af75-6ee6e6b13431",
                    "sense_definition": "Entrer en contact avec une personne cible dans le but d'en faire un informateur pour un service d'espionnage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "renseignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'officier sous couverture a tenté de <w>tamponner</w> un diplomate étranger lors d'une réception officielle."
                        },
                        {
                            "text": "Le service de renseignement cherche à <w>tamponner</w> des experts ayant accès à des données secrètes."
                        }
                    ],
                    "synonyms": [
                        "recruter",
                        "approcher"
                    ],
                    "common_phrases": [
                        "tamponner une cible",
                        "tamponner une source"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "jargon du renseignement"
                        }
                    ]
                }
            ]
        }
    ]
