                "senses": [
                    {
                        "sense_id": "4ee36c76-5f5e-3d49-9ef0-e97dfa1f68e5",
                        "entry_id": "389e68fe-ba8b-3805-afb5-ad2d1c19c567",
                        "glosses": [
                            "Zuschreibung menschlicher Eigenschaften (zu Nichtmenschlichem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a51fec-f7a2-453c-acc1-93712028a489",
                                "sense_id": "4ee36c76-5f5e-3d49-9ef0-e97dfa1f68e5",
                                "text": "Wenn ein Eingeborenenstamm einem Vulkan bei dessen Ausbruch eine böse Gesinnung unterstellt, ist das Anthropomorphismus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39dbfcdc-eeb5-3e76-ab02-53c3719a2da8",
                        "entry_id": "389e68fe-ba8b-3805-afb5-ad2d1c19c567",
                        "glosses": [
                            "Zuschreibung menschlicher Eigenschaften zu (einem) Gott"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5aeb8b89-693f-49c5-9057-ea049d51d44c",
                                "sense_id": "39dbfcdc-eeb5-3e76-ab02-53c3719a2da8",
                                "text": "Philo argumentiert, dass die Schwäche der Analogie zwischen einem Hause und dem Universum so schwach sei, dass an Cleanthes Anthropomorphismus erhebliche Zweifel erwüchsen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd86a6df-0515-41c8-9fde-2c14b85933ab",
                        "source_entry_id": "389e68fe-ba8b-3805-afb5-ad2d1c19c567",
                        "source_sense_id": "4ee36c76-5f5e-3d49-9ef0-e97dfa1f68e5",
                        "source_sense_description": "Zuschreibung menschlicher Eigenschaften (zu Nichtmenschlichem)",
                        "target_lang_word": "anthropomorphism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropomorphism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1235369-c41d-339d-8f37-61f3e46a2050",
                                        "entry_id": "31b35d51-2ab1-32a6-b341-c14e29129f4d",
                                        "glosses": [
                                            "The attribution of human characteristics and behavior to something not human."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1db94cd-8b95-47e5-ace7-29fb1b05fae7",
                                                "sense_id": "c1235369-c41d-339d-8f37-61f3e46a2050",
                                                "text": "Literature is full of examples of anthropomorphism, especially in children’s stories, from The Wind in the Willows to Watership Down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b729e54-f98f-3039-99be-64bae797d8ec",
                                        "entry_id": "31b35d51-2ab1-32a6-b341-c14e29129f4d",
                                        "glosses": [
                                            "The attribution of human characteristics to divine entities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10a0caf0-42f9-4c7f-a072-2bc406d00af5",
                        "source_entry_id": "389e68fe-ba8b-3805-afb5-ad2d1c19c567",
                        "source_sense_id": "4ee36c76-5f5e-3d49-9ef0-e97dfa1f68e5",
                        "source_sense_description": "Zuschreibung menschlicher Eigenschaften (zu Nichtmenschlichem)",
                        "target_lang_word": "anthropomorphisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropomorphisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e35c5f0-e63d-3fc5-92b7-30b83762de03",
                                        "entry_id": "99f96ffb-87db-3bc5-826e-351296161663",
                                        "glosses": [
                                            "Tendance à concevoir les divinités ou les animaux à l’image des êtres humains et à leur prêter de ce fait des comportements et des sentiments humains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc327a8-f137-423c-a26c-deb6788a6409",
                                                "sense_id": "9e35c5f0-e63d-3fc5-92b7-30b83762de03",
                                                "text": "Renouvier s’attaque au concept d’un Dieu impersonnel. Il essaie de montrer qu’un anthropomorphisme épuré est encore le meilleur remède contre l'athéisme, et que tous les panthéismes et tous les monismes où Dieu n'est qu'un nom de l’Absolu, inconditionné, infini, partant contradictoire et inconcevable, sont autant d’athéismes déguisés."
                                            },
                                            {
                                                "example_id": "8836146d-133a-43f7-a783-367462ec914f",
                                                "sense_id": "9e35c5f0-e63d-3fc5-92b7-30b83762de03",
                                                "text": "Le vétérinaire de l’abattoir nous rétorqua que nous faisions de l’anthropomorphisme lorsque nous lui dimes^([sic]) que vu l’état dans lequel elle se trouvait, la vache devait beaucoup souffrir. Il nous a alors rétorqué que si elle souffrait, elle l’aurait déjà dit ! Ma collègue réagit intelligemment en lui faisant remarquer : « Là, c’est vous qui faites de l’anthropomorphisme ! »"
                                            },
                                            {
                                                "example_id": "edf40104-340b-4e39-b978-456419ff5bea",
                                                "sense_id": "9e35c5f0-e63d-3fc5-92b7-30b83762de03",
                                                "text": "Par ailleurs, cet amoureux du minuscule — tel le microscopique oribate producteur d’humus — pratique sans complexe l’anthropomorphisme […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bce17e5-49ff-36c9-8990-aec4fbde07dc",
                                        "entry_id": "99f96ffb-87db-3bc5-826e-351296161663",
                                        "glosses": [
                                            "Attribution, dans certaines religions et en particulier les polythéismes grecs et romains, d’une forme humaine et de sentiments humains aux phénomènes de la nature qui devenaient par suite autant de divinités."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31e13120-ee35-3860-aa2c-3afa4f8dae02",
                                        "entry_id": "99f96ffb-87db-3bc5-826e-351296161663",
                                        "glosses": [
                                            "Faire ressembler Allah dans Son essence aux créatures et non spécifiquement aux humains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
