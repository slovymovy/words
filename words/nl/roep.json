                {
                    "sense_id": "e296086f-444e-305d-b79d-0b2c6d807d8e",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>roepen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>roep</w> mijn vrienden omdat het eten klaar is.",
                            "target_lang_translations": {
                                "ru": "Я <w>зову</w> своих друзей, потому что еда готова.",
                                "en": "I <w>call</w> my friends because the food is ready.",
                                "fr": "J'<w>appelle</w> mes amis parce que le repas est prêt."
                            }
                        },
                        {
                            "text": "Als ik hulp nodig heb, <w>roep</w> ik jou meteen.",
                            "target_lang_translations": {
                                "ru": "Если мне понадобится помощь, я сразу тебя <w>позову</w>.",
                                "en": "If I need help, I <w>call</w> you immediately.",
                                "fr": "Si j'ai besoin d'aide, je t'<w>appelle</w> tout de suite."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
