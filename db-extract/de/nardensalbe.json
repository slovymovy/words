                        "sense_id": "49aaa530-a3f9-334b-abce-377868b6b24e",
                        "entry_id": "96299e10-4605-3519-aa98-aaa2cd3e4c2e",
                        "glosses": [
                            "Salbe aus der Narde-Pflanze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "436bf3cc-f1f1-446a-8a91-53152884a390",
                                "sense_id": "49aaa530-a3f9-334b-abce-377868b6b24e",
                                "text": "Wer kann sich schon rühmen, seine Füße mit Nardensalbe einzureiben."
                            },
                            {
                                "example_id": "f08d850e-5514-4576-9fed-1f42baf393d9",
                                "sense_id": "49aaa530-a3f9-334b-abce-377868b6b24e",
                                "text": "„Markus und Johannes betonten ausdrücklich, daß es echte Nardensalbe war.“"
                            },
                            {
                                "example_id": "d31ef928-781e-4958-a38e-12984d9c6896",
                                "sense_id": "49aaa530-a3f9-334b-abce-377868b6b24e",
                                "text": "„Wir wollen betrachten, wir wollen betrachten, wir wollen betrachten, den Nahmen Jesu / 1) als eine ausgebreitete / 2) als eine ausgeschüttete / 3) als eine köstliche Nardensalbe.“"
                            },
                            {
                                "example_id": "f93aa895-f501-4f1c-bde4-09a1d57fb391",
                                "sense_id": "49aaa530-a3f9-334b-abce-377868b6b24e",
                                "text": "„Nachdem man daher den Körper durch die Hiera gereinigt hat, bediene man sich eines Umschlages aus Nardensalbe, Mastix, Datteln und rohen Quitten “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
