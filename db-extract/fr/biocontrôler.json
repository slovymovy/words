                "senses": [
                    {
                        "sense_id": "31cbf2e5-f81a-397d-8ed9-cda81c509265",
                        "entry_id": "931b6fe4-f82e-318a-8742-a38301daf289",
                        "glosses": [
                            "Lutter contre des organismes nuisibles aux cultures en utilisant des organismes biologiques pour remplacer les pesticides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2807328a-95b4-4a70-b5df-8be440cde50b",
                                "sense_id": "31cbf2e5-f81a-397d-8ed9-cda81c509265",
                                "text": "Espaces verts, cultures potagères, cultures sous serres, élevage, arbres et arbustes : quelles que soient leurs formations et leurs expériences, chacun y trouvera l’ensemble des solutions pour mieux «biocontrôler» leurs cultures."
                            },
                            {
                                "example_id": "d05f5978-434e-4b19-a2e3-80e096123de2",
                                "sense_id": "31cbf2e5-f81a-397d-8ed9-cda81c509265",
                                "text": "Un nouveau site pour \"biocontrôler\" vos cultures."
                            },
                            {
                                "example_id": "62ae37c2-6c1a-4c36-90c9-926f44d4c118",
                                "sense_id": "31cbf2e5-f81a-397d-8ed9-cda81c509265",
                                "text": "Le but étant de déterminer la capacité des vers de terre à biocontrôler un pathogène de blé : le piétin échaudage."
                            }
                        ]
                    }
