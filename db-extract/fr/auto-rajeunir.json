                    },
                    {
                        "form_id": "7326c36d-40ee-4ea5-88df-f0727520f688",
                        "entry_id": "c9e70b37-0c02-3d68-b504-e8629aee3a59",
                        "tags": [],
                        "form": "autorajeunir"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "630dd32d-7ee0-3b3c-b41e-1dffc5780b67",
                        "entry_id": "c9e70b37-0c02-3d68-b504-e8629aee3a59",
                        "glosses": [
                            "Rajeunir par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98cfb2ce-b261-4b79-a73a-c6c804096da2",
                                "sense_id": "630dd32d-7ee0-3b3c-b41e-1dffc5780b67",
                                "text": "Warios, toi qui comprend^([sic]) comment fonctionne la vie et qui peut^([sic]) s'auto-rajeunir, peux-tu m'expliquer pourquoi on vieillit alors?"
                            },
                            {
                                "example_id": "f4e122bf-f34e-4dc3-8290-bb00aaf4b897",
                                "sense_id": "630dd32d-7ee0-3b3c-b41e-1dffc5780b67",
                                "text": "Contrairement à d'autres tissus humains, comme la peau, qui pousse en continu et auto-rajeunit, les structures dentaires ne peuvent généralement pas se réparer et nécessitent un entretien régulier pour conserver leur santé et leur vitalité."
                            },
                            {
                                "example_id": "5365913f-994e-4be0-bd4a-5b594eb4c480",
                                "sense_id": "630dd32d-7ee0-3b3c-b41e-1dffc5780b67",
                                "text": "Grâce au jeûne, le corps s'auto-guérit, s'auto-répare et s'auto-rajeunit!"
                            }
                        ]
                    }
                ],
