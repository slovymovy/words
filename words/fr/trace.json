    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86eb0752-321e-3a60-91f2-66ac1893e179",
                    "sense_definition": "Marque ou empreinte laissée sur le sol ou sur une surface par le passage d'une personne, d'un animal ou d'un véhicule.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "empreinte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien a suivi la <w>trace</w> du renard jusqu'à l'entrée du bois."
                        },
                        {
                            "text": "Nous pouvons observer une <w>trace</w> de pas bien nette dans la neige fraîche."
                        }
                    ],
                    "synonyms": [
                        "empreinte",
                        "piste"
                    ],
                    "common_phrases": [
                        "suivre la trace",
                        "perdre la trace",
                        "trace de pas"
                    ]
                },
                {
                    "sense_id": "bfa0cd05-df16-33c3-b546-87dd39829961",
                    "sense_definition": "Marque visible qui résulte d'une action physique, d'un contact ou de l'usure.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "marque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le café chaud a laissé une <w>trace</w> sombre sur la nappe blanche."
                        },
                        {
                            "text": "Le voleur a nettoyé la poignée pour ne laisser aucune <w>trace</w> de ses doigts."
                        }
                    ],
                    "synonyms": [
                        "marque",
                        "tache"
                    ],
                    "common_phrases": [
                        "laisser une trace",
                        "sans laisser de trace"
                    ]
                },
                {
                    "sense_id": "0cdfc4f1-5fb8-3f70-9645-86d5808863b0",
                    "sense_definition": "Effet persistant, souvenir ou séquelle qu'un événement marquant laisse dans l'esprit ou dans l'histoire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "marque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette terrible crise économique a laissé une <w>trace</w> durable dans la société."
                        },
                        {
                            "text": "Les années passées à l'étranger ont laissé une forte <w>trace</w> dans sa mémoire."
                        }
                    ],
                    "synonyms": [
                        "séquelle",
                        "souvenir",
                        "vestige"
                    ],
                    "common_phrases": [
                        "laisser des traces"
                    ]
                },
                {
                    "sense_id": "3d9143ec-bf2d-37a7-b7b8-466c8efd26b2",
                    "sense_definition": "Quantité infime, à peine perceptible ou décelable d'une substance dans un mélange.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le laboratoire a détecté une légère <w>trace</w> de poison dans le verre."
                        },
                        {
                            "text": "Ce biscuit aux amandes peut contenir des <w>traces</w> d'arachide."
                        }
                    ],
                    "synonyms": [
                        "soupçon",
                        "brin"
                    ],
                    "common_phrases": [
                        "à l'état de trace"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccb483df-acd9-3e8d-939d-cc10d4d2a638",
                    "sense_definition": "Troisième personne du singulier du présent de l'indicatif du verbe <w>tracer</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "forme_verbale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte <w>trace</w> un trait droit sur le plan avec sa règle."
                        },
                        {
                            "text": "Le coureur <w>trace</w> son chemin à travers la forêt malgré les obstacles."
                        }
                    ],
                    "synonyms": [
                        "dessine",
                        "marque"
                    ],
                    "antonyms": [
                        "efface"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "troisième personne du singulier de l'indicatif présent"
                        }
                    ]
                }
            ]
        }
    ]
