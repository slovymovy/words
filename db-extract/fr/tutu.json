                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e12e6848-0c33-4dbd-a604-798fb7ba8e0a",
                                                "sense_id": "02041a41-5394-339b-96f1-b0f8c2b576d5",
                                                "text": "Mikołaj przyniósł paczki. W mojej paczce, oprócz rodzynek w czekoladzie, znalazłem orzechy, czekoladę i gitarę."
                                            }
                                        ],
