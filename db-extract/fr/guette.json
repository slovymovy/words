                    {
                        "sense_id": "d234d639-07a3-3bf3-b890-7c4af69cfe40",
                        "entry_id": "8f7d0b98-3117-34aa-834f-54afc0c98f35",
                        "glosses": [
                            "Guetteuse, veilleuse de nuit."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "6ac75553-56c9-4e1f-a578-539aa6c56c71",
                                "sense_id": "d234d639-07a3-3bf3-b890-7c4af69cfe40",
                                "text": "Suisse. À Lausanne, perché au sommet de la cathédrale, un veilleur de nuit qu'on appelle le « guet » crie les heures de 22 h à 2 h du matin. 365 jours par an depuis 1405. Pour la première fois, une femme, Cassandre Berdoz, va devenir « guette »."
                            }
                        ]
                    }
