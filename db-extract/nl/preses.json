                        "sense_id": "cf3d3a77-8b64-3b4d-be47-20331aa1a490",
                        "entry_id": "4bf37331-5f5f-3a68-83b8-d42b0c649dc7",
                        "glosses": [
                            "voorzitter van een vereniging (vaak van een studentenvereniging of bij kerkelijke vergaderingen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57afbff1-619e-4345-9c09-dfaac44fca82",
                                "sense_id": "cf3d3a77-8b64-3b4d-be47-20331aa1a490",
                                "text": "De preses opende de vergadering met een ferme tik van de voorzittershamer en heette iedereen van harte welkom."
                            },
                            {
                                "example_id": "39172761-a2b3-4702-8cf3-d946482f4345",
                                "sense_id": "cf3d3a77-8b64-3b4d-be47-20331aa1a490",
                                "text": "“De Koninklijke Belgische Voetbalbond gaat voluit voor Euro 2020 en het Eurostadion. We zijn erg verheugd vast te stellen dat België nog steeds het plan A blijft voor UEFA, maar het is nu vijf voor twaalf”, zegt KBVB-preses Gérard Linard in een reactie. “De Koninklijke Belgische Voetbalbond en UEFA vragen bijgevolg aan de verschillende betrokken partijen om hun verantwoordelijkheden op te nemen in het belang van het Belgisch voetbal, onze supporters en het imago van ons land en onze hoofdstad.”"
                            },
                            {
                                "example_id": "670d7723-6ed7-41b5-8d4d-53f5a04f3933",
                                "sense_id": "cf3d3a77-8b64-3b4d-be47-20331aa1a490",
                                "text": "Nieuwe preses Het Ravijn in Nijverdal: Aico Kampman is sinds deze week de nieuwe voorzitter van zwem- en poloclub Het Ravijn. Hij volgt Alex Volkers in deze functie op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d7dadb5-390a-46a2-89cf-89f278be7b15",
                        "source_entry_id": "4bf37331-5f5f-3a68-83b8-d42b0c649dc7",
                        "source_sense_id": "cf3d3a77-8b64-3b4d-be47-20331aa1a490",
                        "source_sense_description": "voorzitter van een vereniging",
                        "target_lang_word": "chairman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chairman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f694f5a-f0cb-3a32-83f1-c1819b732576",
                                        "entry_id": "de637a9e-c890-37fd-8ad3-7c9a3af31247",
                                        "glosses": [
                                            "A person presiding over a meeting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ffb29ef-c674-3eb8-9e4a-345ffa3c0795",
                                        "entry_id": "de637a9e-c890-37fd-8ad3-7c9a3af31247",
                                        "glosses": [
                                            "The head of a corporate or governmental board of directors, a committee, or other formal entity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "949fc820-d2f8-436b-a74b-350e332f5ca4",
                                                "sense_id": "5ffb29ef-c674-3eb8-9e4a-345ffa3c0795",
                                                "text": "When I got ready to leave, why, Chairman Mao came down to the plane. Chairman Mao gave me some Chinese rugs and told me that I was the only prisoner of war that had ever come through there from North China."
                                            },
                                            {
                                                "example_id": "d1b17af7-6a6e-4738-960e-345ae381a92f",
                                                "sense_id": "5ffb29ef-c674-3eb8-9e4a-345ffa3c0795",
                                                "text": "Unsurprisingly, the Group was highly critical of the BTC's organisation and finances, and this prompted Marples to bring forward the Transport Act 1962, which created BR as a standalone entity with its own Board, headed by a full-time chairman. Beeching accepted this latter position, and initially became the BTC chairman in June 1961."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1f81b7-e66c-376a-a872-d001430b336a",
                                        "entry_id": "de637a9e-c890-37fd-8ad3-7c9a3af31247",
                                        "glosses": [
                                            "Someone whose job is to carry people in a portable chair, sedan chair, or similar conveyance."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efe76a8b-7d5e-4238-aa8c-aedf36117ffa",
                                                "sense_id": "fc1f81b7-e66c-376a-a872-d001430b336a",
                                                "text": "Mr Western entered; but not before a small wrangling bout had passed between him and his chairmen; for the fellows, who had taken up their burden at the Hercules Pillars, had conceived no hopes of having any future good customer in the squire […]"
                                            },
                                            {
                                                "example_id": "87404a8e-7697-42e8-887e-54a330264338",
                                                "sense_id": "fc1f81b7-e66c-376a-a872-d001430b336a",
                                                "text": "Mr. Winkle, catching sight of a lady's face at the window of the sedan, turned hastily round, plied the knocker with all his might and main, and called frantically upon the chairman to take the chair away again."
                                            }
                                        ]
                                    }
                                ]
