                        "entry_id": "236a1f1a-5c30-339b-a735-2ac79c3ac425",
                        "glosses": [
                            "The quality of being unthrifty."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c03bda2e-dc83-4368-9bc7-90a84ecdea66",
                                "sense_id": "83fe4c4a-82a0-3d0d-85f3-d864cba352b6",
                                "text": "Many a one here is born to a fair estate; and is stripped of it, whether by the just disherison of his offended Father, or else by the power or circumvention of an adversary, or by his own mis-government and unthriftiness."
                            },
                            {
                                "example_id": "104b3e72-5870-4e02-a85f-5590d016921e",
                                "sense_id": "83fe4c4a-82a0-3d0d-85f3-d864cba352b6",
                                "text": "The worst faults of Miss Sheppard's worst style are reproduced here, joined to an unthriftiness in which she had no part nor lot."
                            },
                            {
                                "example_id": "5206cccf-afa5-4275-8fd9-cf4ff1537fcc",
                                "sense_id": "83fe4c4a-82a0-3d0d-85f3-d864cba352b6",
                                "text": "It was dishonest to the occupier himself, because it put in his way the worst temptation to unthriftiness."
                            }
                        ]
                    }
