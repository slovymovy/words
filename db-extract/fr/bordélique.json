                                        "entry_id": "087dfab5-b90a-35c6-b075-fa41801acb5a",
                                        "glosses": [
                                            "A character having a chaotic alignment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
