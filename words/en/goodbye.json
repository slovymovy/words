{
    "word_family": [
        "bye",
        "bye-bye"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "59a76262-64b8-35a2-ab78-d159e7d06fc2",
                    "sense_definition": "A formula used to another person or persons when the speaker, writer, or person addressed is departing.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "farewell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have to go now, so <w>goodbye</w> and have a safe trip.",
                            "target_lang_translations": {
                                "ru": "Мне пора идти, так что <w>до свидания</w> и счастливого пути."
                            }
                        },
                        {
                            "text": "She waved and said <w>goodbye</w> to her friends as the train pulled away.",
                            "target_lang_translations": {
                                "ru": "Она помахала рукой и сказала <w>пока</w> своим друзьям, когда поезд тронулся."
                            }
                        }
                    ],
                    "synonyms": [
                        "farewell",
                        "bye",
                        "bye-bye",
                        "so long",
                        "see you",
                        "adieu"
                    ],
                    "antonyms": [
                        "hello"
                    ],
                    "common_phrases": [
                        "say goodbye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формула вежливости, используемая при расставании с человеком или группой людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "до свидания",
                                "target_lang_sense_clarification": "стандартная вежливая форма"
                            },
                            {
                                "target_lang_word": "пока",
                                "target_lang_sense_clarification": "разговорная форма"
                            },
                            {
                                "target_lang_word": "прощай",
                                "target_lang_sense_clarification": "при расставании надолго или навсегда"
                            },
                            {
                                "target_lang_word": "всего доброго",
                                "target_lang_sense_clarification": "вежливое пожелание при уходе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ec35c7c-79d5-309b-8053-0e0f3461b1f5",
                    "sense_definition": "An utterance of <w>goodbye</w>, the wishing of farewell to someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "farewell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long and emotional <w>goodbye</w> at the airport, he finally boarded his flight.",
                            "target_lang_translations": {
                                "ru": "После долгого и эмоционального <w>прощания</w> в аэропорту он наконец сел в самолет."
                            }
                        },
                        {
                            "text": "They shared a quick <w>goodbye</w> before heading to their separate offices.",
                            "target_lang_translations": {
                                "ru": "Они быстро <w>попрощались</w>, прежде чем разойтись по своим офисам."
                            }
                        }
                    ],
                    "synonyms": [
                        "farewell",
                        "parting"
                    ],
                    "common_phrases": [
                        "quick goodbye",
                        "final goodbye",
                        "tearful goodbye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слова или действия, сопровождающие расставание; само прощание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прощание",
                                "target_lang_sense_clarification": "процесс или слова при расставании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd784202-035c-35e8-bddc-8a1c42691c7b",
                    "sense_definition": "To say <w>goodbye</w>; to wish somebody farewell on parting.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "farewell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire evening <w>goodbyeing</w> every single guest at the party.",
                            "target_lang_translations": {
                                "ru": "Он провел весь вечер, <w>прощаясь</w> с каждым гостем на вечеринке."
                            }
                        },
                        {
                            "text": "It is polite to <w>goodbye</w> your host before you leave the event.",
                            "target_lang_translations": {
                                "ru": "Вежливо <w>попрощаться</w> с хозяином, прежде чем покинуть мероприятие."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прощаться с кем-либо, произносить слова прощания при уходе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прощаться",
                                "target_lang_sense_clarification": "говорить слова прощания"
                            },
                            {
                                "target_lang_word": "раскланиваться",
                                "target_lang_sense_clarification": "вежливо прощаться перед уходом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}