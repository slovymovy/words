                        "glosses": [
                            "ein Vertreter der hauptsächlich im Karbon und Perm verbreiteten Samenfarne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d145c38-ec37-4702-88db-f24cf463ed26",
                                "sense_id": "76cd2375-559c-3e09-90cc-53a538b09100",
                                "text": "„Übergangsformen aus dem Pflanzenreich sind die hauptsächlich im Karbon und Perm verbreiteten Pteridospermen (Samenfarne), die zwischen den Pteridophyten und den Gymnospermen vermitteln.“"
                            },
                            {
                                "example_id": "cd285c53-6459-406c-a8ad-3890b70d4e73",
                                "sense_id": "76cd2375-559c-3e09-90cc-53a538b09100",
                                "text": "„Die Pteridosperme Lyginodendron mit ihren in einem Kreis angeordneten Bündel ist auch der Prototypus der Cycadeen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
