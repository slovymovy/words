                                    {
                                        "sense_id": "a121375a-55d1-3049-a4cb-fbdb452b3125",
                                        "entry_id": "5fc3b6fe-7000-3750-baa5-8929dba1bad0",
                                        "glosses": [
                                            "Elaborado con las manos, sin utilizar máquinas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "758449b5-a2e5-41ff-8ffc-a42da239e69b",
                                                "sense_id": "a121375a-55d1-3049-a4cb-fbdb452b3125",
                                                "text": "Ahora que me acuerdo, no me has dicho nada de este collar. Es nuevo, hecho a mano, con semillas de diversas plantas, todas medicinales, así como algo magnéticas"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
