                ],
                "senses": [
                    {
                        "sense_id": "d289ac51-93b0-3bde-99be-d477f6f37edb",
                        "entry_id": "6772423c-f192-37b0-8baa-0eac3be75a49",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f3fb69-9737-4ac0-9a44-453004307d41",
                                "sense_id": "d289ac51-93b0-3bde-99be-d477f6f37edb",
                                "text": "Frau Schlotterbeck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "45c0064d-4492-487f-91ee-67bf66081d66",
                                "sense_id": "d289ac51-93b0-3bde-99be-d477f6f37edb",
                                "text": "Herr Schlotterbeck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8ff64673-b5d4-484e-8187-d3f1296a57d2",
                                "sense_id": "d289ac51-93b0-3bde-99be-d477f6f37edb",
                                "text": "Die Schlotterbecks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a2101d9a-51af-44d6-813d-b20582aae9b2",
                                "sense_id": "d289ac51-93b0-3bde-99be-d477f6f37edb",
                                "text": "Der Schlotterbeck trägt nie die Schals, die die Schlotterbeck ihm strickt."
                            },
                            {
                                "example_id": "0f34197e-4b11-4fe6-b82f-573f98ea5b45",
                                "sense_id": "d289ac51-93b0-3bde-99be-d477f6f37edb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schlotterbeck kommt, geht der Herr Schlotterbeck.“"
                            },
                            {
                                "example_id": "962e7db2-b403-46d6-98f0-10952a23cedf",
                                "sense_id": "d289ac51-93b0-3bde-99be-d477f6f37edb",
                                "text": "Schlotterbeck kommt und geht."
                            },
                            {
                                "example_id": "8d386b74-4034-486c-a8d8-42a14aa663d0",
                                "sense_id": "d289ac51-93b0-3bde-99be-d477f6f37edb",
                                "text": "Schlotterbecks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
