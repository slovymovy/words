                        "form": "стре́хами"
                    },
                    {
                        "form_id": "a98a809f-e096-4e98-9fe4-388ead14b8ab",
                        "entry_id": "f3ecdb74-b3fb-3c27-937e-b6d587d4f10d",
                        "tags": [
                            "singular",
                            "prepositional"
                        ],
                        "form": "стрехе́"
                    },
                    {
                        "form_id": "df41d0aa-d47d-492d-9b35-c1bffb7556f1",
                        "entry_id": "f3ecdb74-b3fb-3c27-937e-b6d587d4f10d",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "стре́хах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f8096c9-bdcb-3374-9c0d-322a70e462de",
                        "entry_id": "f3ecdb74-b3fb-3c27-937e-b6d587d4f10d",
                        "glosses": [
                            "строит. свисающий нижний край крыши"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c609944-fa49-4587-973a-11cf07d4f51b",
                                "sense_id": "1f8096c9-bdcb-3374-9c0d-322a70e462de",
                                "text": "Он не был на родине уже два года и подкатил на санях под ворота с резной стрехою — как снег на голову; никто его не ждал."
                            },
                            {
                                "example_id": "b4d6041c-2bc5-4361-8500-109add44d000",
                                "sense_id": "1f8096c9-bdcb-3374-9c0d-322a70e462de",
                                "text": "Эх, минувшие времена… проснёшься — неокрепшие птенчики свиристят под стрехой крыши, ветерочки с листвой балуются, и все тебе приятно… даже муха, ибо и на ней почил отблеск творца!"
                            },
                            {
                                "example_id": "fd8c2abf-c158-41ff-a2a4-5720227320db",
                                "sense_id": "1f8096c9-bdcb-3374-9c0d-322a70e462de",
                                "text": "Солома на стрехе задралась. Из-под неё, как черные пули, залпом вылетели воробьи."
                            }
                        ]
                    },
                    {
                        "sense_id": "35d0295e-665e-3789-92ec-1dfde31b2c43",
                        "entry_id": "f3ecdb74-b3fb-3c27-937e-b6d587d4f10d",
                        "glosses": [
                            "крыша, кровля избы, хаты (обычно соломенная)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e77eb9dd-d75d-4156-9ad3-9063fafbc0cc",
                                "sense_id": "35d0295e-665e-3789-92ec-1dfde31b2c43",
                                "text": "Взлез я на свой тарантас и тихонько… тихонько, чтоб никто не слыхал, стал обдирать солому в стрехе, проделал дырку и вылез наружу."
                            },
                            {
                                "example_id": "03f35f28-2a92-4655-b2a4-de103ca1895c",
                                "sense_id": "35d0295e-665e-3789-92ec-1dfde31b2c43",
                                "text": "Лёжа на сене, я долго наблюдал игру света и тени на покосившейся стене сарая, по стрехам и прогнившим драницам, точно солнечные лучи делали самую тщательную ревизию недвижимой собственности Спирьки."
                            },
                            {
                                "example_id": "2cf0d439-d07a-48a5-9e34-80166edfef66",
                                "sense_id": "35d0295e-665e-3789-92ec-1dfde31b2c43",
                                "text": "Из затенённого сарая с нависшею соломенною стрехой тихо вылетали переливчатые трели дудки, а навстречу им из открытых окон усадьбы, сверкавшей сквозь листву буков отражением лунного света, неслись певучие, полные аккорды фортепиано."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a88c78a-8519-43a0-a1ec-de6fa09a95bb",
                        "source_entry_id": "f3ecdb74-b3fb-3c27-937e-b6d587d4f10d",
                        "source_sense_description": "свисающий нижний край крыши",
                        "target_lang_word": "eaves",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eaves",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                        "entry_id": "ab7b6d70-d59f-3565-b9c3-e6b87b5499b4",
                                        "glosses": [
                                            "The underside of a roof that extends beyond the external walls of a building."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c395de3c-d797-4e01-a277-6819fd921660",
                                                "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                                "text": "Him that you term'd Sir, the good old Lord Gonzallo, / His teares runs downe his beard like winters drops / From eaues of reeds: […]"
                                            },
                                            {
                                                "example_id": "23d479e1-fa86-4cfc-9acc-2f256d89c89f",
                                                "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                                "text": "Thus night oft ſee me in thy pale career, / Till civil-ſuited morn appeer, / […] / Or uſher'd with a ſhower ſtill, / When the guſt hath blown his fill, / Ending on the ruſsling Leaves, / With minute drops from off the Eaves."
                                            },
                                            {
                                                "example_id": "e0f63a99-e467-4ffa-8371-f0aa511617c0",
                                                "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                                "text": "By my window bowered round with leaves, / And down my cheeks the quick tears ran / Like twinkling rain-drops from the eaves, / When warm spring showers are passing o'er: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "862bbbf9-051d-3012-a351-f26fcc9ccfd3",
                                        "entry_id": "ab7b6d70-d59f-3565-b9c3-e6b87b5499b4",
                                        "glosses": [
                                            "Something that extends over or projects beyond."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe62c57b-0624-47e8-98dc-9d35a81c2ba7",
                                                "sense_id": "862bbbf9-051d-3012-a351-f26fcc9ccfd3",
                                                "text": "But after many strains and heaves / He got up to the Saddle eaves."
                                            },
                                            {
                                                "example_id": "4648dd4e-fb97-439c-a218-5154273ad044",
                                                "sense_id": "862bbbf9-051d-3012-a351-f26fcc9ccfd3",
                                                "text": "The mystic glory swims away; / From off my bed the moonlight dies; / And closing eaves of wearied eyes / I sleep till dusk is dipt in gray: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eaves",
                                "target_lang_code": "en",
                                "target_senses": [
