                "senses": [
                    {
                        "sense_id": "31fe95eb-59f2-32ea-a06d-da86f6b490c1",
                        "entry_id": "4466a1c4-eeed-3e1a-bd74-2f29a1cf16ed",
                        "glosses": [
                            "so beschaffen, dass etwas entzogen wurde, insbesondere ein Recht oder Status"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "510e88f3-b4d2-4d4f-a668-2d2eedd6da27",
                                "sense_id": "31fe95eb-59f2-32ea-a06d-da86f6b490c1",
                                "text": "„Wer einen Doktortitel trägt, hat viele lange Nächte in dunklen Laboren oder vor dem heimischen Rechner hinter sich. So zumindest war die allgemeine Vorstellung bis zu den Skandalen um die aberkannten Doktortitel von Karl-Theodor zu Guttenberg und Annette Schavan.“"
                            },
                            {
