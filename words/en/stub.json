                    "sense_definition": "The remaining part of the docked tail of a dog.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remnants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer wagged its little <w>stub</w> of a tail excitedly.",
                            "target_lang_translations": {
                                "ru": "Боксер взволнованно вилял своим маленьким <w>обрубком</w> хвоста.",
