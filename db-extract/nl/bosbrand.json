                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2ed5906-5758-3427-9161-9ddf85b9136b",
                        "entry_id": "c58987bc-79ef-3d5c-bf22-9fbc82348261",
                        "glosses": [
                            "brand van of in een bos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "925d7a05-2b4f-4f13-bdf4-8949ae9929da",
                                "sense_id": "e2ed5906-5758-3427-9161-9ddf85b9136b",
                                "text": "Vorig jaar hadden we op Tenerife weer veel last van bosbranden aangestoken door pyromanen."
                            },
                            {
                                "example_id": "3013afe1-6ef6-41ce-b734-29d91c5ed28c",
                                "sense_id": "e2ed5906-5758-3427-9161-9ddf85b9136b",
                                "text": "Door snel ingrijpen van de brandweer is een grote bosbrand in het Almelose Nijreesbos dinsdagmiddag voorkomen."
                            },
                            {
                                "example_id": "2ab22488-ac38-4705-b187-7ea2bd1528c3",
                                "sense_id": "e2ed5906-5758-3427-9161-9ddf85b9136b",
                                "text": "Er zijn ieder jaar bosbranden in het Amazonegebied. Vooral in deze tijd van het jaar. Maar dit jaar zijn er heel veel branden."
                            },
                            {
                                "example_id": "175e1f8e-04e6-4998-b819-dd78f4d8f76f",
                                "sense_id": "e2ed5906-5758-3427-9161-9ddf85b9136b",
                                "text": "Door de extreme hitte neemt ook de kans op bosbranden toe. Vanuit Lytton is de rook te zien van een bosbrand op een bergflank. Ook de brandweerploegen hebben veel last van de hitte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25964283-d350-418b-ac0d-c3dff97dde80",
                        "source_entry_id": "c58987bc-79ef-3d5c-bf22-9fbc82348261",
                        "source_sense_id": "e2ed5906-5758-3427-9161-9ddf85b9136b",
                        "source_sense_description": "brand van of in een bos",
                        "target_lang_word": "Waldbrand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waldbrand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                        "entry_id": "c2a83071-02cb-3bad-bb0b-e5b4d11c9938",
                                        "glosses": [
                                            "in einem Wald um sich greifendes Feuer größeren (zumeist vernichtenden) Ausmaßes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fce6b89-bcf0-4eaa-95df-a02812a66dea",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Im Unterschied zu den vergangenen Jahren sind Brandenburgs Forste bislang von größeren Waldbränden weitgehend verschont. 164 überwiegend kleinere Waldbrände auf einer Gesamtfläche von 44 Hektar registrierte das Umweltministerium in der ersten Jahreshälfte.“"
                                            },
                                            {
                                                "example_id": "56bc4987-587e-4924-8536-5e3922944ba1",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„In dieser Gegend, in der seit drei Jahren Trockenheit herrscht und riesige Waldbrände wüten, mischen sich Katastrophenangst und Technikvertrauen.“"
                                            },
                                            {
                                                "example_id": "1d059ec8-e6fa-49e5-870a-4136608f4622",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Ein Waldbrand, der am Mittwoch im Militärlager Carpiagne - auf halber Strecke zwischen Cassis und Marseille - ausbrach und zwei Nächte und einen Tag lang wütete: 1.100 Hektar Heideland und Pinienwald sowie mehrere Häuser und Hütten wurden zerstört. “"
                                            },
                                            {
                                                "example_id": "df0bcc32-a511-42e0-8006-9385b6a67460",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Die Feuerwehr hat die nördlich der griechischen Hauptstadt Athen tobenden Waldbrände auch am Sonntagmorgen noch nicht unter Kontrolle gebracht.“"
                                            },
                                            {
                                                "example_id": "e7f87421-b025-4b48-a345-518862721369",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Waldbrände gehören in westlichen Regionen der USA und Kanadas mittlerweile zum Alltag. Jahr um Jahr brennen dort Millionen von Quadratkilometern an Waldgebiet.“"
                                            },
                                            {
                                                "example_id": "b07dcdd1-a8f7-43e4-bc24-0afa487c7b8d",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„In der Gemeinde Seillans zwischen Fayence und Draguignan hat sich am Montag ein Waldbrand entfacht und etwa 10 Hektar Wald vernichtet.“"
                                            },
                                            {
                                                "example_id": "7b9c5aa5-646c-47b2-9ee4-1b71bbb087b0",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Waldbrände entstehen unter natürlichen Bedingungen durch Blitzschlag, vulkanische Aktivitäten und Selbstentzündung.[…]Weitere Ursachen für Waldbrand in Deutschland sind vor allem:",
                                                "translation": "* Militärübungen[…]“"
                                            },
                                            {
                                                "example_id": "957d7f48-bc9b-4b24-b943-13044fde50ee",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Bei Linienflügen von Frankfurt nach Santiago de Chile via São Paulo gelang es den Wissenschaftlern erstmalig Abluftfahnen von großflächigen Waldbränden mit erhöhten Quecksilberkonzentrationen zu beobachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
