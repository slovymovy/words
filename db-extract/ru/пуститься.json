                                "sense_id": "f286f12c-9d10-3ede-b0ab-abdf7eafab4e",
                                "text": "пусти́ться бежа́ть",
                                "translation": "to break into a run; start running",
                                "english": "to break into a run; start running"
                            },
                            {
                                "example_id": "02a69102-4217-4742-937a-eb95f706e6c8",
                                "sense_id": "f286f12c-9d10-3ede-b0ab-abdf7eafab4e",
                                "text": "пусти́ться в риско́ванное предприя́тие",
                                "translation": "to let oneself in for a risky undertaking",
                                "english": "to let oneself in for a risky undertaking"
                            }
                        ]
                    },
                    {
                        "sense_id": "4f48b925-0c48-3218-bc5e-820d3f0597e7",
                        "entry_id": "fa1eeb78-f51a-3213-b3ee-80607c7dd370",
