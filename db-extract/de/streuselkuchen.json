                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c254a4-53ea-4e45-9b1a-649733b89ceb",
                                "sense_id": "6f86eb53-d2ec-3ffb-9ae2-b13a1c617114",
                                "text": "Wie viel kostet der Streuselkuchen?"
                            },
                            {
                                "example_id": "471b1893-2c5c-46af-9ba4-f04f274df1ac",
                                "sense_id": "6f86eb53-d2ec-3ffb-9ae2-b13a1c617114",
                                "text": "Ich liebe die Streuselkuchen mit Kirschfüllung."
                            },
                            {
                                "example_id": "0a825a22-3afe-4b0f-91e8-142abb524935",
                                "sense_id": "6f86eb53-d2ec-3ffb-9ae2-b13a1c617114",
                                "text": "„Jeden Sonntagnachmittag verbringt er dort mit einer Thermosflasche Kaffee, einem Klappsessel und einem Paket Streuselkuchen genießerische Stunden und beobachtet, wie der Efeu wächst.“"
                            }
                        ],
