                "senses": [
                    {
                        "sense_id": "a81d6169-640e-3377-926f-fee376262fd5",
                        "entry_id": "6dcbd8a1-6856-3a61-ac15-9ad86127d27b",
                        "glosses": [
                            "vom Sprecher weg fallen"
                        ],
                        "tags": [
                            "veraltet; bairisch",
                            "südalemannisch"
                        ],
                        "examples": [
                            {
                                "example_id": "20b861aa-4cc7-4f87-a680-dea8f5daa686",
                                "sense_id": "a81d6169-640e-3377-926f-fee376262fd5",
                                "text": "„Fiel abhin in das Meeresgrund / Daraus er nicht mehr schwimmen kund.“"
                            },
                            {
                                "example_id": "ec063f17-7796-4949-a8c1-9151c2aedddc",
                                "sense_id": "a81d6169-640e-3377-926f-fee376262fd5",
                                "text": "„Letzts Johr san mir in oana Wocha vier Glasl owegfolln!“"
                            },
                            {
                                "example_id": "73ffb9ae-8843-4814-a4c1-3c49cbd8eb95",
                                "sense_id": "a81d6169-640e-3377-926f-fee376262fd5",
                                "text": "„Schuld bin ich selbst, wär ich net auffigstiegn, wär ich net abigfalln.“"
                            },
                            {
                                "example_id": "2b191df8-657f-40e3-8825-4e5c88533fee",
                                "sense_id": "a81d6169-640e-3377-926f-fee376262fd5",
                                "text": "„Mi hats am Fuaß dawischt und üba d’Böschung abi ghaut — nana, vo selba oda wegn an Alkohol bin i net abigfalln —, dann hams mi ins Kranknhaus bracht, […]“"
                            },
                            {
                                "example_id": "ba33aea2-2f40-4720-a7f3-0a28decf5462",
                                "sense_id": "a81d6169-640e-3377-926f-fee376262fd5",
                                "text": "„Jetzat nur ned obefoin!“"
                            },
                            {
                                "example_id": "f05c9603-2e69-48df-847f-db13f775a646",
                                "sense_id": "a81d6169-640e-3377-926f-fee376262fd5",
                                "text": "„Und schießt, daß's weit in Berg'n hallt, Und 's Gambsei stürzt und abi fallt, […]“"
                            },
                            {
                                "example_id": "4b5e970a-4a8f-4fd8-bc9b-0160ce833cbf",
                                "sense_id": "a81d6169-640e-3377-926f-fee376262fd5",
                                "text": "„I hob ja eh ned viel gsuffa, weil mir's meiste owegfolln is!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
