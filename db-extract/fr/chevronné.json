                                        "glosses": [
                                            "een verschil in aanmerking nemen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d74545-5076-4e49-8401-beaeb564f6be",
                                                "sense_id": "00984e00-f0de-3494-9fc3-0de548efe6ef",
                                                "text": "In de wet werden drie gevallen onderscheiden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "123ea360-9b44-3e97-9993-f84da66807d4",
                                        "entry_id": "8c8505a4-61ae-3f14-b67e-b83c8ed0bccf",
                                        "glosses": [
                                            "een verschil waarnemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ab6036c-db95-4e36-9612-80e8807616eb",
                                                "sense_id": "123ea360-9b44-3e97-9993-f84da66807d4",
                                                "text": "Geur is kennelijk een belangrijk overlevingszintuig en ik kon van verre al onderscheiden van welke dieren de uitwerpselen waren die ergens lagen."
                                            },
                                            {
                                                "example_id": "bbb29fb8-ae64-40bb-977e-30c09d1f0eb0",
                                                "sense_id": "123ea360-9b44-3e97-9993-f84da66807d4",
                                                "text": "Oorlogswinter speelt zich af in het gebied van zijn jeugd, de noordkant van de Veluwe. Terlouw groeide daar als zoon van een predikant op in een zwaar calvinistisch milieu. Hij schetste de bezetting als een tijd van lijden en onrecht, waarin goed en fout niet altijd helder te onderscheiden waren, maar waarin wel morele keuzes moesten worden gemaakt."
                                            },
                                            {
                                                "example_id": "af9365a8-d7bd-47bc-924d-c8a2287d2a11",
                                                "sense_id": "123ea360-9b44-3e97-9993-f84da66807d4",
                                                "text": "Aan de randen van het schilderij heerste een complete duisternis, alsof de dichtheid van de buizen daar zo hoog was dat je niets meer kon onderscheiden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d3cb2cd-803b-3306-aec8-bd40e54e251d",
                                        "entry_id": "8c8505a4-61ae-3f14-b67e-b83c8ed0bccf",
                                        "glosses": [
                                            "iemands bijzonder gedrag erkennen, bijvoorbeeld middels een medaille"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd3b018c-3e02-43a2-8407-8ced61bad9d8",
                                                "sense_id": "0d3cb2cd-803b-3306-aec8-bd40e54e251d",
                                                "text": "Hij werd met een ridderorde onderscheiden."
                                            }
                                        ]
                                    },
