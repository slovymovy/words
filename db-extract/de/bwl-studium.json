                        "examples": [
                            {
                                "example_id": "502707af-8102-4e8d-9baf-eda10ab161af",
                                "sense_id": "3cac811a-2e66-346c-84a9-c91720090f84",
                                "text": "„Doch je weiter das BWL-Studium in Mainz voranschritt, desto mehr bekam es den Charakter einer betrieblichen Ausbildung.“"
                            },
                            {
                                "example_id": "feea8349-ec07-40f2-bbb1-67e6d3d2d194",
                                "sense_id": "3cac811a-2e66-346c-84a9-c91720090f84",
                                "text": "„[W]er glaube, im BWL-Studium ohne Mathe und im Publizistik-Studium ohne Statistik durchzukommen, irre.“"
                            },
                            {
                                "example_id": "47fac050-63d5-465b-ad61-9d7bb3bbdbc8",
                                "sense_id": "3cac811a-2e66-346c-84a9-c91720090f84",
                                "text": "„Auf die Idee, Modedesign zu studieren, kam Willms noch während ihres BWL-Studiums.“"
                            }
                        ],
