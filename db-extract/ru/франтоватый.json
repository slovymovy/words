                ],
                "senses": [
                    {
                        "sense_id": "2bc29836-38ef-3a21-9d38-f76103efe73a",
                        "entry_id": "5a96f59e-7d9e-3044-915a-bfe831822a63",
                        "glosses": [
                            "разг., неодобр. проявляющий пристрастие к нарядной, модной, эффектной одежде, к модным вещам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d8d5f73-cead-4590-8d92-a74ccbc3e780",
                                "sense_id": "2bc29836-38ef-3a21-9d38-f76103efe73a",
                                "text": "Старик не ответил, словно и не слышал, но рядом со стариком стоял франтоватый, неприятный господин, маленького роста, лысый, с очень нервным и подвижным лицом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a147b9c-443c-4657-a2f5-cc447929d1b2",
                        "source_entry_id": "5a96f59e-7d9e-3044-915a-bfe831822a63",
                        "source_sense_id": "2bc29836-38ef-3a21-9d38-f76103efe73a",
                        "target_lang_word": "dandyish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dandyish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d846957-54da-35c7-9791-45612ae3bdbe",
                                        "entry_id": "d3161a56-b0ec-31a7-b821-ed428cfec75e",
                                        "glosses": [
                                            "Characteristic of or resembling the style of a dandy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "526b078f-902a-4bce-bfb5-7cc7152a7b62",
                                                "sense_id": "9d846957-54da-35c7-9791-45612ae3bdbe",
                                                "text": "The latter was a stranger to him but in the darkness, by the aid of the glowing cigarette tips, he could make out a pale dandyish face over which a smile was travelling slowly, a tall overcoated figure and a hard hat."
                                            },
                                            {
                                                "example_id": "748e1b38-2ba0-4de8-a324-582c5e37ac9a",
                                                "sense_id": "9d846957-54da-35c7-9791-45612ae3bdbe",
                                                "text": "His clothes were sombre, clean but not immaculate, pressed, but yesterday perhaps not today. In short, neither slovenly nor dandyish."
                                            },
                                            {
                                                "example_id": "16c0a16a-a199-4061-875f-6bd9d9a8ebb4",
                                                "sense_id": "9d846957-54da-35c7-9791-45612ae3bdbe",
                                                "text": "As he crossed the drawing room he acknowledged himself with a flattered smile in a mirror. He was wearing a wing collar, and something dandyish in him, some memory of the licence and discipline of being in a play, lifted his mood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
