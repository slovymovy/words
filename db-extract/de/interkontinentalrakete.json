                ],
                "senses": [
                    {
                        "sense_id": "0d6c3861-7781-3b79-a577-a71ee6664707",
                        "entry_id": "d700d159-700e-37be-ad09-8df2926e9914",
                        "glosses": [
                            "Rakete mit einer besonders großen Reichweite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "062fd9f6-a97b-45ee-b2fc-7f405bf088f5",
                                "sense_id": "0d6c3861-7781-3b79-a577-a71ee6664707",
                                "text": "„Die Reparatur des mit Interkontinentalraketen bestückbaren U-Bootes werde mehrere Monate dauern, kündigte der für Verteidigung zuständige Vize-Regierungschef Dmitri Rogosin an.“"
                            },
                            {
                                "example_id": "82f0186a-2bd8-4b8a-ba4d-414bd8e2a642",
                                "sense_id": "0d6c3861-7781-3b79-a577-a71ee6664707",
                                "text": "„Seegestützte Interkontinentalraketen stellten die Fähigkeit zum Zweitschlag sicher, sollte der Gegner versuchen, mit einem Überraschungsschlag die landgestützten Systeme auszuschalten.“"
                            },
                            {
                                "example_id": "b0ec0692-f4cb-43e2-b5e1-bf01cf8adbf9",
                                "sense_id": "0d6c3861-7781-3b79-a577-a71ee6664707",
                                "text": "„Die jetzt dafür verwendeten Raketen könnten sogar in Interkontinentalraketen mit großer Reichweite umgewandelt werden, doch die Umwandlung ist nicht leicht, denn Trägersysteme müssen flexibel und mobil sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
