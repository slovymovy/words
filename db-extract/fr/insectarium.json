                    },
                    {
                        "translation_id": "2ef125d7-124f-4e0c-9ad1-586c38d13a4f",
                        "source_entry_id": "49501a35-afe0-357f-a541-b33be92902c9",
                        "source_sense_description": "espace confiné qui permet d’étudier le mode de vie des insectes",
                        "target_lang_word": "insectario",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
