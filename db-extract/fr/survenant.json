            {
                "entry_id": "420f3960-8887-3358-a54e-ed2993afb2c3",
                "word": "survenant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "56e24053-4c92-4aed-80cd-75ff725c4849",
                        "entry_id": "420f3960-8887-3358-a54e-ed2993afb2c3",
                        "tags": [
