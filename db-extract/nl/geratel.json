        "nl-extract.jsonl": [
            {
                "entry_id": "11691fa7-09d6-3a04-840c-d7bea3c2d94c",
                "word": "geratel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c7d05d42-9bae-3710-a6e1-2226012d5d57",
                        "entry_id": "11691fa7-09d6-3a04-840c-d7bea3c2d94c",
                        "glosses": [
                            "een aanhoudend, ritmisch, luid, snel tikkend geluid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e012bc8d-f873-4c47-908a-a5922409357b",
                                "sense_id": "c7d05d42-9bae-3710-a6e1-2226012d5d57",
                                "text": "Volgens omwonenden aan de Benkoelenstraat is de bewoner van het huis een jonge man die regelmatig Luxxx bezoekt. Buurtbewoner Jan ten Brinke (62) hoorde rond 3:15 uur de schoten. Hij vermoedt vanwege het 'kenmerkende geratel' dat het om een AK47 Kalasjnikov gaat."
                            },
                            {
                                "example_id": "81427db0-c84a-4fd9-8caf-d05c275e800f",
                                "sense_id": "c7d05d42-9bae-3710-a6e1-2226012d5d57",
                                "text": "Hier schiet je niet op een stuk papier; je traint hier met een doelwit dat beweegt en terugschiet. Er is harde muziek, veel knipperend licht, soms het geratel van het machinegeweer waarmee Oliva in de lucht vuurt om de concentratie van de schutters te testen."
                            },
                            {
                                "example_id": "7999aa08-316b-4426-ad10-7cfa55ef70d3",
                                "sense_id": "c7d05d42-9bae-3710-a6e1-2226012d5d57",
                                "text": "Op z'n 90ste is dat optimisme nog altijd ongebroken. Gerard Staal gaf 40 jaar in zijn woonplaats Odijk een eigen krant uit (Het Trefpunt), was uitgever en journalist tegelijk en werd een bindende figuur in het sociale leven. \"Hij had een nooit aflatende honger naar nieuws. Wat er in de grote wereld en dichtbij huis gebeurde: daar leefde hij van. Het geluid van mijn jeugd is het geratel van een typemachine.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "e290230d-e737-3e3c-94c8-da242a9c7bcd",
                        "entry_id": "11691fa7-09d6-3a04-840c-d7bea3c2d94c",
                        "glosses": [
                            "aanhoudend druk, luid en snel praten"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ef7f27b-0c55-4685-8e4d-b1d530f91bb6",
                        "source_entry_id": "11691fa7-09d6-3a04-840c-d7bea3c2d94c",
                        "source_sense_id": "c7d05d42-9bae-3710-a6e1-2226012d5d57",
                        "target_lang_word": "burble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25f232aa-734c-3b2d-af93-aacf12390905",
                                        "entry_id": "55115894-faa8-38d5-a51a-b6b7348a39b2",
                                        "glosses": [
                                            "A bubbling, gurgling sound, as of a creek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b88442f-1d3b-4a5c-a0c4-c2e10ab317d4",
                                                "sense_id": "25f232aa-734c-3b2d-af93-aacf12390905",
                                                "text": "Marta's gander was a magnificent snow-white bird: the object of terror to foxes, children and dogs. She had reared him as a gosling; and whenever he approached, he would let fly a low contented burble and sidle his neck around her thighs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c839f06c-ae91-3837-a5f5-3abb020f26e7",
                                        "entry_id": "55115894-faa8-38d5-a51a-b6b7348a39b2",
                                        "glosses": [
                                            "A gush of rapid speech."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91041d70-314e-47f0-a10a-8c18ae872d9c",
                                                "sense_id": "c839f06c-ae91-3837-a5f5-3abb020f26e7",
                                                "text": "He could hear the music in the distance, and the burble and laughter from the library, and a high ringing in his own ears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c49964a1-6702-379f-9299-1c67741fa510",
                                        "entry_id": "55115894-faa8-38d5-a51a-b6b7348a39b2",
                                        "glosses": [
                                            "The turbulent boundary layer about a moving streamlined body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "burble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f57277ac-9233-30c5-adab-cbb170091420",
                                        "entry_id": "288a4fe1-7f55-3c0e-821d-4245f176680d",
                                        "glosses": [
                                            "To bubble; to gurgle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "051bd25f-95c7-35dc-90e0-cac9f8e32c49",
                                        "entry_id": "288a4fe1-7f55-3c0e-821d-4245f176680d",
                                        "glosses": [
                                            "To babble; to speak in an excited rush."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f74fac2-547e-43d0-9648-e700a03a1742",
                                                "sense_id": "051bd25f-95c7-35dc-90e0-cac9f8e32c49",
                                                "text": "She burbled on, as if I cared to listen."
                                            },
                                            {
                                                "example_id": "9be03b0d-c37d-4d24-8b68-f22d87a35317",
                                                "sense_id": "051bd25f-95c7-35dc-90e0-cac9f8e32c49",
                                                "text": "\"No, Jo, it wasn't one bit crowded, there was room enought ^([sic]) for everyone,\" she burbled on. \"And we were there, and all these other wymeen too, of all shapes, sizes, and colors...\""
                                            },
                                            {
                                                "example_id": "43d707b1-5bc5-4bf3-91d7-d90fc0607102",
                                                "sense_id": "051bd25f-95c7-35dc-90e0-cac9f8e32c49",
                                                "text": "“No way this one’s going to miss us this time,” burbles one bebooted doomsdayer to another."
                                            }
                                        ]
                                    }
                                ]
                            },
