                ],
                "senses": [
                    {
                        "sense_id": "034fed41-e5ff-3e14-bf02-10af503308ee",
                        "entry_id": "10e4172d-13df-30b5-9a0f-9a2fb2c63539",
                        "glosses": [
                            "Verpackung für Schuhe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79d88562-e7a2-4fc3-a0ee-53d34854fc91",
                                "sense_id": "034fed41-e5ff-3e14-bf02-10af503308ee",
                                "text": "Als sie vom Einkaufen zurückkamen, warf sie den Schuhkarton in den Müll."
                            },
                            {
                                "example_id": "c86158e4-9692-4aca-a9fd-f7e8725555c3",
                                "sense_id": "034fed41-e5ff-3e14-bf02-10af503308ee",
                                "text": "„Das Einzige, wovon ich mich seit Jahrzehnten nicht trennen kann, ist ein Schuhkarton mit Briefen, ein paar Fotos und Kirschkernen, die ich an einem heißen Nachmittag im Sommer mit Clara ausgespuckt hatte.“"
                            },
                            {
                                "example_id": "a4a6ed7e-00a1-439a-91ea-b7f0c3c933a7",
                                "sense_id": "034fed41-e5ff-3e14-bf02-10af503308ee",
                                "text": "„Sie warf ihre Handtasche auf den Stuhl, auf dem noch ein Schuhkarton von der Frau mit dem hellblauen Mantel lag – und die Frau mit dem hellblauen Mantel nahm kopfschüttelnd ihren Karton und ging hinter ihrem Mann her, der zwischen den Tischen stand und dem Serviermädchen die Zeche bezahlte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3106ec18-6ecc-4d38-8b72-dd8c9e3a0e46",
                        "source_entry_id": "10e4172d-13df-30b5-9a0f-9a2fb2c63539",
                        "source_sense_id": "034fed41-e5ff-3e14-bf02-10af503308ee",
                        "source_sense_description": "Verpackung für Schuhe",
                        "target_lang_word": "shoebox",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shoebox",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc36f2a-7b1e-301f-afa5-a0fe13a8e4cb",
                                        "entry_id": "1e333ffe-32bd-36fc-9950-6e19be87e9d4",
                                        "glosses": [
                                            "The box in which shoes are sold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61a8b5b3-62ec-4317-baa0-f20c9256c182",
                                                "sense_id": "8cc36f2a-7b1e-301f-afa5-a0fe13a8e4cb",
                                                "text": "In one shoebox he had a whole collection of seeds he had saved from last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85c2a7bd-9f24-3597-828e-03654fe50b7a",
                                        "entry_id": "1e333ffe-32bd-36fc-9950-6e19be87e9d4",
                                        "glosses": [
                                            "A small, cramped residence or similar space."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e4f5d1a-5aaf-47a4-801e-f18e55e0f74e",
                                                "sense_id": "85c2a7bd-9f24-3597-828e-03654fe50b7a",
                                                "text": "She wondered how come Ho had a garden when everyone she knew lived in shoeboxes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
