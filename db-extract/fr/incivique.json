                "senses": [
                    {
                        "sense_id": "aa44e9cc-05b1-3971-8646-7152d4a92477",
                        "entry_id": "6c82c90d-a004-3e50-92e8-b2c1074af19e",
                        "glosses": [
                            "Personne qui n’est pas civique, qui n’est pas un bon citoyen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5236182-d021-4420-91f7-7348f4600182",
                                "sense_id": "aa44e9cc-05b1-3971-8646-7152d4a92477",
                                "text": "D’après ce que je lis ici, tu n’es pas venu pour rechercher un incivique quelconque."
                            },
                            {
                                "example_id": "1eeeda96-c75a-417b-865d-04a5f91db73b",
                                "sense_id": "aa44e9cc-05b1-3971-8646-7152d4a92477",
                                "text": "Dans son rappel des faits, celui-ci a dit que l’attaque simultanée du site GLM –qui comprend l’une des résidences du chef de l’État– et de la base logistique du camp Kokolo était l’œuvre des inciviques venus de l’extérieur du pays et auxquels s’étaient joints des complices basés à Kinshasa."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b92e738-a3ca-3fd4-86e9-591fbade6ea3",
                        "entry_id": "6c82c90d-a004-3e50-92e8-b2c1074af19e",
                        "glosses": [
                            "Pendant la Seconde Guerre mondiale, collaborateur nazi"
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "137c8dcb-5d43-4c50-83b4-0085f035d879",
                                "sense_id": "7b92e738-a3ca-3fd4-86e9-591fbade6ea3",
                                "text": "Après la libération de la Belgique, les collaborateurs, les « inciviques » furent comme partout en Europe poursuivis et châtiés."
                            }
                        ]
                    }
                ],
