                                        "sense_id": "d2aebc38-2e65-3b61-86e0-2bcab98fa8ce",
                                        "entry_id": "f4991595-74ef-3502-ac9f-6f944d98987a",
                                        "glosses": [
                                            "Vorgang der Verfügbarmachung eines Mediums der breiten Masse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddd8437d-fb21-492d-b79a-323fb0f59253",
                                                "sense_id": "d2aebc38-2e65-3b61-86e0-2bcab98fa8ce",
                                                "text": "„An diverse Lokalblätter verschickte der Mörder verschlüsselte Bekennerschreiben, deren Veröffentlichung er mit der Androhung neuer Morde erpresste.“"
                                            },
                                            {
                                                "example_id": "6425ed89-9e8c-4a4f-9ab2-fa48d72aa9e1",
                                                "sense_id": "d2aebc38-2e65-3b61-86e0-2bcab98fa8ce",
                                                "text": "„Seit der Veröffentlichung meines ersten Buches war mir ein Kritiker treu geblieben.“"
                                            },
                                            {
                                                "example_id": "6ecc89a0-9956-49ed-9568-09c4e5969650",
                                                "sense_id": "d2aebc38-2e65-3b61-86e0-2bcab98fa8ce",
                                                "text": "„Mit der Veröffentlichung des Wörterbuchs und der Grammatik hatte er endlich seine Pflicht den Briten gegenüber erfüllt und war nun frei.“"
                                            },
                                            {
                                                "example_id": "3f16c198-7538-44ea-88e4-16d025061e77",
                                                "sense_id": "d2aebc38-2e65-3b61-86e0-2bcab98fa8ce",
                                                "text": "„Die Veröffentlichung jiddischer Bücher wurde dadurch beträchtlich erschwert.“"
                                            },
                                            {
                                                "example_id": "8264a7dc-11b7-4247-925b-9216b34fa34e",
                                                "sense_id": "d2aebc38-2e65-3b61-86e0-2bcab98fa8ce",
                                                "text": "„Im Jahr 2007 bezahlte die Deutsche Bahn 1,3 Millionen Euro für bahnfreundliche Veröffentlichungen, bei denen der Auftraggeber nicht erkennbar war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "655da998-4966-38c4-ba58-07d87b41e681",
                                        "entry_id": "f4991595-74ef-3502-ac9f-6f944d98987a",
                                        "glosses": [
                                            "gemäß ^([1]) veröffentlichtes Medium selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900ea4b6-fca1-4a2a-b7ee-5943bebd5e12",
                                                "sense_id": "655da998-4966-38c4-ba58-07d87b41e681",
                                                "text": "„Während die Extrembergsteiger sowohl in ihren Veröffentlichungen als auch in ihren Auskünften bei meinen Befragungen eine große Offenheit und ein hohes Reflexionsniveau gegenüber diesen Problemstellungen beweisen, offenbart sich bei vielen anderen Risikogruppen noch ein erheblicher Nachholbedarf an Selbstkritik und Bereitschaft, das Gefahrenpotenzial der eigenen Sportart unvoreingenommen objektivieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "c2135a33-0fda-44d9-938c-f7c177dcf326",
                                                "sense_id": "655da998-4966-38c4-ba58-07d87b41e681",
                                                "text": "Wer sich auf eine ausgeschriebene Professorenstelle bewerben will, braucht dazu unter anderem eine Reihe von Veröffentlichungen."
                                            },
                                            {
                                                "example_id": "bbbe7d97-7558-4d20-aeff-0a17307966e2",
                                                "sense_id": "655da998-4966-38c4-ba58-07d87b41e681",
                                                "text": "„Er zog einen Stapel Veröffentlichungen aus der Schublade und knallte sie vor den verblüfften Bauunternehmern auf den Tisch.“"
                                            },
                                            {
                                                "example_id": "26321181-c8a1-4cfa-b539-9822adc16d1f",
                                                "sense_id": "655da998-4966-38c4-ba58-07d87b41e681",
                                                "text": "„Das war nur ein Teil der Veröffentlichungen, die er in diesen Jahren herausbrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
