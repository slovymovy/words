        "désarranger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33297772-ae76-3f27-a48f-8980470c8e01",
                    "sense_definition": "Disposer des objets ou des éléments dans un ordre convenable ou harmonieux.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant l'arrivée des invités, nous devons <w>arranger</w> les chaises autour de la table."
                        },
                        {
                            "text": "Elle prend le temps d'<w>arranger</w> soigneusement ses livres sur les étagères de sa chambre."
                        }
                    ],
                    "common_phrases": [
                        "arranger la pièce",
                        "arranger les affaires"
                    ]
                },
                {
                    "sense_id": "e679a3ac-5586-3f57-97d2-3abaf4a7b046",
                    "sense_definition": "Convenir à quelqu'un, lui être commode ou avantageux.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "commodite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si nous décalons la réunion à demain matin, cela m'<w>arrange</w> beaucoup."
                        },
                        {
                            "text": "Cette nouvelle date ne l'<w>arrange</w> pas du tout en raison d'un autre rendez-vous."
                        }
                    ],
                    "common_phrases": [
                        "arranger les deux parties",
                        "arranger tout le monde"
                    ]
                },
                {
                    "sense_id": "c4f49598-7aaf-3e52-a917-5c13b89d90ce",
                    "sense_definition": "Régler, réparer ou résoudre une difficulté, un problème ou un différend.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas pour cette erreur, je vais <w>arranger</w> la situation rapidement."
                        },
                        {
                            "text": "Le technicien a réussi à <w>arranger</w> le problème de connexion en quelques minutes."
                        }
                    ],
                    "common_phrases": [
                        "arranger un problème",
                        "arranger la situation",
                        "arranger les choses"
                    ]
                },
                {
                    "sense_id": "fec753e7-3021-39ef-a116-0f5bd2c93e08",
                    "sense_definition": "Préparer, organiser ou planifier un événement, une rencontre ou un projet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre directeur a proposé d'<w>arranger</w> un entretien avec le nouveau client dès lundi."
                        },
                        {
                            "text": "Ils ont réussi à <w>arranger</w> une petite fête surprise pour l'anniversaire de Paul."
                        }
                    ],
                    "common_phrases": [
                        "arranger un rendez-vous",
                        "arranger une rencontre"
                    ]
                },
                {
                    "sense_id": "dfd99e88-9b63-3648-901d-4d4322a3966c",
                    "sense_definition": "Évoluer vers une issue favorable ou trouver une solution satisfaisante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Garde espoir, je suis convaincu que tout va s'<w>arranger</w> dans les prochains jours."
                        },
                        {
                            "text": "Après plusieurs jours de pluie continue, le temps s'<w>arrange</w> enfin cet après-midi."
                        }
                    ],
                    "common_phrases": [
                        "s arranger avec le temps"
                    ]
                },
                {
                    "sense_id": "c0e74fd9-4adb-3e1c-af00-390950370cd3",
                    "sense_definition": "Prendre les mesures nécessaires ou se débrouiller de façon à parvenir à un but.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "S'il te plaît, <w>arrange</w>-toi pour arriver à l'heure à notre rendez-vous."
                        },
                        {
                            "text": "Nous devons nous <w>arranger</w> pour partager les frais de transport équitablement."
                        }
                    ],
                    "common_phrases": [
                        "s arranger pour faire"
                    ]
                },
                {
                    "sense_id": "b501b142-bb0a-3410-b8bd-d3f90fdc03b0",
                    "sense_definition": "Trouver un terrain d'entente ou régler un litige à l'amiable avec quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au lieu d'aller au tribunal, ils ont préféré s'<w>arranger</w> à l'amiable."
                        },
                        {
                            "text": "Tu devrais t'<w>arranger</w> directement avec le propriétaire pour les réparations."
                        }
                    ],
                    "common_phrases": [
                        "s arranger à l amiable",
                        "s arranger avec quelqu un"
                    ]
                },
                {
                    "sense_id": "679ae99b-99f4-3614-bc95-28a44d93cdf5",
                    "sense_definition": "S'accommoder d'une situation ou s'en contenter faute de mieux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture de location est assez petite mais nous nous en <w>arrangerons</w> sans problème."
                        },
                        {
                            "text": "Même si les conditions sont difficiles, il sait toujours s'<w>arranger</w> de ce qu'il a."
                        }
                    ],
                    "common_phrases": [
                        "s arranger de la situation"
                    ]
                },
                {
                    "sense_id": "5058395c-853b-3009-ad1b-4d039dfaa4fd",
                    "sense_definition": "Modifier ou déformer des faits ou un récit pour servir ses propres intérêts.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tendance à <w>arranger</w> la vérité afin d'éviter les reproches de son chef."
                        },
                        {
                            "text": "Le témoin a visiblement <w>arrangé</w> les faits pour protéger son collègue."
                        }
                    ],
                    "common_phrases": [
                        "arranger la vérité",
                        "arranger les faits"
                    ]
                },
                {
                    "sense_id": "60d9a872-34d1-3b69-a279-3a771b3afed4",
                    "sense_definition": "Adapter ou transcrire une composition musicale pour d'autres instruments ou voix.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le compositeur a décidé d'<w>arranger</w> cette pièce classique pour un quatuor à cordes."
                        },
                        {
                            "text": "Ce morceau traditionnel a été <w>arrangé</w> pour orchestre symphonique l'année dernière."
                        }
                    ],
                    "common_phrases": [
                        "arranger pour orchestre",
                        "arranger un morceau"
                    ]
                },
                {
                    "sense_id": "30febca6-f099-3268-9d5f-fd5912f94878",
                    "sense_definition": "Mettre dans un état déplorable, maltraiter physiquement ou abîmer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boxeur a sévèrement <w>arrangé</w> son adversaire lors des premières reprises."
                        },
                        {
                            "text": "Cette violente averse de grêle a complètement <w>arrangé</w> la carrosserie de ma voiture."
                        }
                    ],
                    "common_phrases": [
                        "arranger le portrait"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé de manière ironique ou menaçante"
                        }
                    ]
                },
                {
                    "sense_id": "7306859a-4e3b-30c1-86ee-df9a3848adc3",
                    "sense_definition": "Bâtir, édifier ou construire un ensemble ou un bâtiment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette région, les paysans avaient coutume d'<w>arranger</w> leurs granges de pierres sèches."
                        },
                        {
                            "text": "Les maçons s'apprêtent à <w>arranger</w> une nouvelle remise au fond du jardin."
                        }
                    ],
                    "synonyms": [
                        "construire"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "usité principalement dans certains parlers régionaux"
                        }
                    ]
                }
            ]
        }
    ]
