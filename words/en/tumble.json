                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clothes were left in a <w>tumble</w> on the bedroom floor.",
                            "target_lang_translations": {
                                "zh": "衣服被扔在卧室地板上，成了<w>杂乱的一堆</w>。"
                            }
                        },
                        {
                            "text": "We found the old toys in a <w>tumble</w> inside the dusty attic box.",
                            "target_lang_translations": {
                                "zh": "我们发现旧玩具在满是灰尘的阁楼箱子里堆成<w>杂乱的一堆</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heap",
                        "pile"
                    ],
                    "target_lang_definitions": {
                        "zh": "杂乱无章的一堆。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "杂乱的一堆",
                                "target_lang_sense_clarification": "指乱糟糟堆在一起的一堆东西"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a48102d2-be77-33ef-b4e2-1afe2db953a1",
                    "sense_definition": "An act of sexual intercourse.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sex",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poem describes a secret <w>tumble</w> in the garden.",
                            "target_lang_translations": {
                                "zh": "这首诗描写了花园里一次秘密的<w>交欢</w>。"
                            }
                        },
                        {
                            "text": "They had a quick <w>tumble</w> before the guests arrived for dinner.",
                            "target_lang_translations": {
                                "zh": "客人来吃晚饭前，他们匆匆<w>交欢</w>了一次。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intercourse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Euphemistic or literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一次性行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "交欢",
                                "target_lang_sense_clarification": "委婉、较旧式的说法"
                            },
                            {
                                "target_lang_word": "偷欢",
                                "target_lang_sense_clarification": "强调秘密或不正当的性关系时可用"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
