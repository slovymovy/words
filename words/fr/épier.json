    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a82ec42-f627-389a-a5cc-63979c6d851d",
                    "sense_definition": "Observer secrètement et avec attention les actions de quelqu'un ou ce qui se passe quelque part.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Caché derrière les rideaux du salon, le vieil homme <w>épiait</w> tous les passants dans la rue."
                        },
                        {
                            "text": "La police a passé plusieurs jours à <w>épier</w> les moindres faits et gestes du suspect."
                        }
                    ],
                    "synonyms": [
                        "espionner",
                        "guetter",
                        "surveiller"
                    ],
                    "common_phrases": [
                        "épier les moindres gestes"
                    ]
                },
                {
                    "sense_id": "4371c540-cda8-3880-9575-34f7736c19f6",
                    "sense_definition": "Attendre avec vigilance le moment ou l'occasion propice pour agir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prédateur immobile dans les hautes herbes <w>épie</w> l'occasion parfaite pour bondir sur sa proie."
                        },
                        {
                            "text": "Elle attendait patiemment en silence et <w>épiait</w> le moment idéal pour poser sa question délicate."
                        }
                    ],
                    "synonyms": [
                        "guetter"
                    ],
                    "common_phrases": [
                        "épier l'occasion",
                        "épier le moment favorable"
                    ]
                },
                {
                    "sense_id": "db8a82d6-d91a-39d0-b9d5-e641aff7cbca",
                    "sense_definition": "Former ou développer des épis, en parlant des céréales et des graminées.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce aux températures clémentes du printemps, le blé a commencé à <w>épier</w> plus tôt que prévu."
                        },
                        {
                            "text": "L'agriculteur surveille attentivement la période où les céréales <w>épient</w> dans ses grands champs."
                        }
                    ],
                    "common_phrases": [
                        "commencer à épier"
                    ]
                }
            ]
        }
    ]
