                "senses": [
                    {
                        "sense_id": "249cd7e4-0797-3f9e-80df-8f697c5a46d4",
                        "entry_id": "8efd019f-844a-3faf-b176-04e30ea53d5e",
                        "glosses": [
                            "добиться чего-нибудь хлопотами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82c0dee4-1e17-4437-bddc-597b5e9c92d0",
                                "sense_id": "249cd7e4-0797-3f9e-80df-8f697c5a46d4",
                                "text": "Я спрошу, не может ли брат мой через кого-либо в городе выхлопотать какую-нибудь должность."
                            },
                            {
                                "example_id": "2464a4c2-94ba-4bf5-9c50-e58dc7590cca",
                                "sense_id": "249cd7e4-0797-3f9e-80df-8f697c5a46d4",
                                "text": "Оттого-то в пьющей компании они и стараются всегда как будто выхлопотать себе оправдание, а если можно, то даже и уважение."
                            }
                        ]
                    }
