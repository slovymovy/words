                ],
                "senses": [
                    {
                        "sense_id": "3596e4e7-9a8a-3542-9b25-d24b31f17dc7",
                        "entry_id": "10a9625b-3abb-3a10-9f1c-9b928f133ee0",
                        "glosses": [
                            "персонаж итальянской комедии дель арте, весёлый и наивный слуга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d789fa3-833a-4c63-adf4-873dd682aa4e",
                                "sense_id": "3596e4e7-9a8a-3542-9b25-d24b31f17dc7",
                                "text": "Арлекин и Пьеро упали на колени, умоляли пощадить несчастного Буратино."
                            },
                            {
                                "example_id": "680b620a-1a92-47cd-998b-1f230066a28a",
                                "sense_id": "3596e4e7-9a8a-3542-9b25-d24b31f17dc7",
                                "text": "Когда Чабров в костюме Арлекина (чёрные и золотые шашки) выходил на сцену, от одного его появления по залу проходила искра."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62c979ce-1c79-4ae7-a3ae-b39d6dc286ba",
                        "source_entry_id": "10a9625b-3abb-3a10-9f1c-9b928f133ee0",
                        "source_sense_id": "3596e4e7-9a8a-3542-9b25-d24b31f17dc7",
                        "target_lang_word": "Harlequin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harlequin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "122a8adb-185e-3205-bd18-1ea708bd155e",
                                        "entry_id": "0e014cf1-aca0-3bb4-9936-f2dbd2371c8f",
                                        "glosses": [
                                            "The best-known of the zanni or comic servant characters from the Italian commedia dell'arte, associated with the city of Bergamo."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a93a3f29-dcab-3f3f-ac6c-ef376ba2acf4",
                                        "entry_id": "0e014cf1-aca0-3bb4-9936-f2dbd2371c8f",
                                        "glosses": [
                                            "A type of eyeglass frame design inspired by Venetian Harlequin masks, more commonly known as cat-eye."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8fd7021-79a6-465d-8c01-884382c1f81f",
                        "source_entry_id": "10a9625b-3abb-3a10-9f1c-9b928f133ee0",
                        "source_sense_id": "3596e4e7-9a8a-3542-9b25-d24b31f17dc7",
                        "target_lang_word": "Arlequín",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8f5e85f9-7c25-4f48-a960-957c39193686",
                        "source_entry_id": "10a9625b-3abb-3a10-9f1c-9b928f133ee0",
                        "source_sense_id": "3596e4e7-9a8a-3542-9b25-d24b31f17dc7",
                        "target_lang_word": "Arlecchino",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "de7dce22-4ab6-46d4-932c-951b8e922142",
                        "source_entry_id": "10a9625b-3abb-3a10-9f1c-9b928f133ee0",
                        "source_sense_id": "3596e4e7-9a8a-3542-9b25-d24b31f17dc7",
                        "target_lang_word": "Harlekin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harlekin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c65af90f-9f79-32f6-90b5-54cd7869e134",
                                        "entry_id": "d55e90f4-9668-3869-852f-ff8439a912aa",
                                        "glosses": [
                                            "komische Bühnenfigur, ein Spaßvogel, Possenreißer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f33768-2030-4c1a-83ec-9ebcbec13434",
                                                "sense_id": "c65af90f-9f79-32f6-90b5-54cd7869e134",
                                                "text": "Ein Harlekin trägt oft eine dunkle Halbmaske und ein buntes Gewand mit Rautenmuster."
                                            },
                                            {
                                                "example_id": "cd298e34-054e-469b-a05c-1fd0f6e734bf",
                                                "sense_id": "c65af90f-9f79-32f6-90b5-54cd7869e134",
                                                "text": "„Auf der Bühne bewegen sich die Figuren der klassischen Commedia dell'Arte, purzeln Columbine, Pierrot und Harlekin vor liebevoll hingetuschten Kulissen durch eine Handlung ohne Worte.“"
                                            },
                                            {
                                                "example_id": "ec628484-bfc7-4618-8514-393be5aaabad",
                                                "sense_id": "c65af90f-9f79-32f6-90b5-54cd7869e134",
                                                "text": "„Harlekine sprangen ums Feuer und schnitten Grimassen.“"
                                            },
                                            {
                                                "example_id": "ea30a2ae-1edd-4eef-b2aa-35c3037152a2",
                                                "sense_id": "c65af90f-9f79-32f6-90b5-54cd7869e134",
                                                "text": "„Nur etwas tat ich den Schauspielern zu Gefallen; ich verfaßte ein komisch-tragisches Stück, in dem ich zwei Personen einführte, die den Harlekin spielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3d12e6a-51fd-482b-b0ba-e8c5660041c8",
                        "source_entry_id": "10a9625b-3abb-3a10-9f1c-9b928f133ee0",
