                                                "sense_id": "1ca1ad2f-5296-3bec-8cc4-dde25504a5f4",
                                                "text": "This expansion requires the original game board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37b9621d-dd0a-39f2-9b55-cd9899b73d43",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "That which is expanded; expanse; extended surface."
