                ],
                "senses": [
                    {
                        "sense_id": "f1fbd9d1-6e16-3a1d-9bb0-3b75fb0caf5d",
                        "entry_id": "8e86cdb0-e468-314a-bdfd-700bf8883385",
                        "glosses": [
                            "страд. прич. прош. вр. от разрядить; лишенный заряда (об огнестрельном оружии, военной технике и т. п.)"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "136efbbe-5070-4850-807e-3dd886fb6f99",
                                "sense_id": "f1fbd9d1-6e16-3a1d-9bb0-3b75fb0caf5d",
                                "text": "Разряженное ружье."
                            },
                            {
                                "example_id": "19cb36a8-b939-4cf9-8818-ca736560e0cc",
                                "sense_id": "f1fbd9d1-6e16-3a1d-9bb0-3b75fb0caf5d",
                                "text": "Шанданьяк отшвырнул прочь разряженный пистолет, сжал оставшийся обеими руками, и не сознавая, что делает, пересек палубу и с расстояния не более пятнадцати футов выстрелил Френду в живот."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ad3ce6a-2646-31fa-8e30-d7d92168ecdc",
                        "entry_id": "8e86cdb0-e468-314a-bdfd-700bf8883385",
                        "glosses": [
                            "статив., физ. лишённый тока, зарядки, требующий подзарядки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b580efcf-c4cf-4924-a2eb-322c1b1f3f23",
                                "sense_id": "7ad3ce6a-2646-31fa-8e30-d7d92168ecdc",
                                "text": "Разряженная батарея."
                            }
                        ]
                    },
                    {
                        "sense_id": "59807c59-d9e0-3ca6-99af-609d8ddd33fb",
                        "entry_id": "8e86cdb0-e468-314a-bdfd-700bf8883385",
                        "glosses": [
                            "редк. прост. то же, что разреженный; редкий (о воздухе, атмосфере)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49a5b9ae-51b9-4f8d-ad90-1df851c5d3f0",
                                "sense_id": "59807c59-d9e0-3ca6-99af-609d8ddd33fb",
                                "text": "Шар свалился на песок. … Так он и будет лежать — совершенно неподвижно, засасывая и сжимая в себе разряженный марсианский воздух, а потом вдруг разом выпустит его с оглушительным свистом и ракетой перелетит метров на десять — пятнадцать."
                            },
                            {
                                "example_id": "d3060d45-f165-48b1-a7d4-6f4cd2f1e99a",
                                "sense_id": "59807c59-d9e0-3ca6-99af-609d8ddd33fb",
                                "text": "Лучи солнца вновь пронзили разряженный воздух и упали на гонимую ветром мелкую рябь беспредельного моря."
                            }
                        ]
                    }
                ],
