                "senses": [
                    {
                        "sense_id": "a5ea0015-07bb-3b3f-91d0-a89618043b6a",
                        "entry_id": "95241186-806c-302a-a9d4-150ed3279df4",
                        "glosses": [
                            "Riche et grande demeure italienne ou corse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a65db26e-c895-4efd-ac0c-270730cd74b2",
                                "sense_id": "a5ea0015-07bb-3b3f-91d0-a89618043b6a",
                                "text": "Immédiatement après le palais Rezzonico, vient le palazzino Camerazza que signale au regard l’enseigne d’un magasin d’antiquités."
                            },
                            {
                                "example_id": "af075fa4-2639-4edc-ad18-78b1de3bb0ce",
                                "sense_id": "a5ea0015-07bb-3b3f-91d0-a89618043b6a",
                                "text": "La municipalité de Rome a acquis ce petit palais afin de pouvoir exécuter le nouveau Corso Vittore Emanuele. Mais elle n’a pas acheté ce palazzino pour le démolir, elle veut au contraire le restaurer dans l’intérêt de l’art et en vue de l’embellissement de la ville, et à cet effet elle a ouvert un concours."
                            },
                            {
                                "example_id": "205cfcd5-cf79-4d61-95ba-1ca1e79cdcf6",
                                "sense_id": "a5ea0015-07bb-3b3f-91d0-a89618043b6a",
                                "text": "Les autres stagiaires qui séjournaient au palazzino le virent, avec stupéfaction, empaqueter ses affaires, passer sous la Madone bleue et les porter dans l’aile interdite habitée par l’héritier de la très vieille famille américaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "728ae9d8-b7f9-3e0c-ad2d-e8b153d045a7",
                        "entry_id": "95241186-806c-302a-a9d4-150ed3279df4",
                        "glosses": [
                            "Grande et riche demeure."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c0a77377-1a04-4fa7-93d8-98f68e06888f",
                                "sense_id": "728ae9d8-b7f9-3e0c-ad2d-e8b153d045a7",
                                "text": "Pourquoi l’affreux intrus de tout à l’heure l’a-t-il contrainte, pistolet au poing, à lui faire visiter, de la cave aux combles, le palazzino ?"
                            }
                        ]
                    }
