                    {
                        "translation_id": "93ae984d-54ba-4a77-93b6-f391155637dd",
                        "source_entry_id": "4b0eecda-2901-3c06-88f9-cac34f25ab80",
                        "source_sense_id": "0cb2e59b-e5c1-3c67-8571-a90e1bdba80e",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Unabhängigkeitsbewegung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unabhängigkeitsbewegung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b528e99-4813-35a0-8f72-241ccaa98053",
                                        "entry_id": "4027ce49-8256-3af5-88f2-579fb0a38dbc",
                                        "glosses": [
                                            "Bestreben einer Kolonie/eines Landes/eines Volkes nach Unabhängigkeit von der herrschenden Macht, deren Oberhoheit als Unrecht empfunden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16deab5f-d649-4caf-b0d9-41feec4b93a5",
                                                "sense_id": "5b528e99-4813-35a0-8f72-241ccaa98053",
                                                "text": "„Er ist nur fünf Jahre älter als der König, war Führer der Unabhängigkeitsbewegung und ist der erste freigewählte Regierungschef seines Landes.“"
                                            },
                                            {
                                                "example_id": "b209bb8d-ce4d-4aab-b559-f52a69d1abff",
                                                "sense_id": "5b528e99-4813-35a0-8f72-241ccaa98053",
                                                "text": "„So entstehen bald überall Unabhängigkeitsbewegungen gegen die Fremdherrschaft.“"
                                            },
                                            {
                                                "example_id": "e45c2223-b076-42e3-85a0-d69b9ea4cef5",
                                                "sense_id": "5b528e99-4813-35a0-8f72-241ccaa98053",
                                                "text": "„In Afrika haben sie etwa im Sudan, in Ghana, Marokko und Tunesien Verhandlungen mit Unabhängigkeitsbewegungen aufgenommen.“"
                                            },
                                            {
                                                "example_id": "cbe6ed13-fc35-4ab2-9c5f-f6649c6e33ff",
                                                "sense_id": "5b528e99-4813-35a0-8f72-241ccaa98053",
                                                "text": "„Seit etwa 1920 hatte die Unabhängigkeitsbewegung, unter Führung von Mahatma Gandhi, friedlich für nationale Selbstbestimmung gekämpft, mit einer zähen, fantasievollen Politik des zivilen Widerstands.“"
                                            },
                                            {
                                                "example_id": "60006660-0ea3-49d5-8776-9957bfca0cb6",
                                                "sense_id": "5b528e99-4813-35a0-8f72-241ccaa98053",
                                                "text": "„Am Morgen hatte die Wahlkommission die Ergebnisse der ersten demokratischen Wahlen verkündet, und ihr Albtraum war Wirklichkeit geworden: Der als Kommunist und Terrorist verhasste Robert Mugabe und seine bewaffnete Unabhängigkeitsbewegung hatten die Wahlen haushoch gewonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
