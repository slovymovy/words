{
    "word_family": [
        "wonder",
        "wonderbaarlijk",
        "bewonderen",
        "verwondering",
        "wonderkind"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aa1ea792-8517-3dd7-b2ae-7c5453d4b14c",
                    "sense_definition": "verbazingwekkend of bewonderenswaardig op een manier die bijna onmogelijk lijkt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbazingwekkend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind keek met <w>wonderlijke</w> ogen naar de prachtige vuurwerkshow. ",
                            "target_lang_translations": {
                                "en": "The child looked at the beautiful fireworks show with <w>wondering</w> eyes."
                            }
                        },
                        {
                            "text": "Zij maakte een <w>wonderlijke</w> transformatie door en kwam als een sterke vrouw tevoorschijn.",
                            "target_lang_translations": {
                                "en": "She underwent a <w>miraculous</w> transformation and emerged as a strong woman."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonderbaarlijk"
                    ],
                    "common_phrases": [
                        "een wonderlijke transformatie",
                        "wonderlijke ogen"
                    ],
                    "target_lang_definitions": {
                        "en": "amazing or admirable in a way that seems almost impossible"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miraculous",
                                "target_lang_sense_clarification": "seeming like a miracle"
                            },
                            {
                                "target_lang_word": "wonderful",
                                "target_lang_sense_clarification": "inspiring delight or admiration"
                            },
                            {
                                "target_lang_word": "amazing",
                                "target_lang_sense_clarification": "causing great surprise or wonder"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b49f4fd2-5a27-388e-bf21-75caa93ce6df",
                    "sense_definition": "vreemd, merkwaardig of ongewoon op een manier die de nieuwsgierigheid prikkelt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vreemd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens hun verre reis kwamen ze allerlei <w>wonderlijke</w> dingen tegen.",
                            "target_lang_translations": {
                                "en": "During their long journey, they encountered all kinds of <w>wondrous</w> things."
                            }
                        },
                        {
                            "text": "Het is een <w>wonderlijke</w> samenloop van omstandigheden dat ze elkaar precies daar ontmoetten.",
                            "target_lang_translations": {
                                "en": "It is a <w>strange</w> coincidence that they met each other exactly there."
                            }
                        }
                    ],
                    "synonyms": [
                        "opmerkelijk"
                    ],
                    "antonyms": [
                        "normaal",
                        "gewoon"
                    ],
                    "common_phrases": [
                        "een wonderlijke samenloop",
                        "wonderlijke dingen"
                    ],
                    "target_lang_definitions": {
                        "en": "strange, remarkable, or unusual in a way that piques curiosity"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wondrous",
                                "target_lang_sense_clarification": "inspiring a feeling of wonder or delight"
                            },
                            {
                                "target_lang_word": "strange",
                                "target_lang_sense_clarification": "unusual or surprising"
                            },
                            {
                                "target_lang_word": "curious",
                                "target_lang_sense_clarification": "strange and unusual"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "431b21d0-71cc-3cb2-ae88-a2858e907541",
                    "sense_definition": "op een opvallende of ongebruikelijke manier afwijkend van wat men verwacht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vreemd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude machines waren op een <w>wonderlijke</w> manier weer tot leven gewekt voor de toeristen.",
                            "target_lang_translations": {
                                "en": "The old machines had been brought back to life for the tourists in a <w>remarkable</w> way."
                            }
                        },
                        {
                            "text": "Het voelde vreemd om mijn gezondheid volledig in handen van deze <w>wonderlijke</w> techniek te leggen.",
                            "target_lang_translations": {
                                "en": "It felt strange to place my health entirely in the hands of this <w>peculiar</w> technology."
                            }
                        }
                    ],
                    "synonyms": [
                        "abnormaal",
                        "opmerkelijk"
                    ],
                    "antonyms": [
                        "normaal",
                        "gewoon"
                    ],
                    "common_phrases": [
                        "op een wonderlijke manier",
                        "wonderlijke techniek"
                    ],
                    "target_lang_definitions": {
                        "en": "deviating from what is expected in a striking or unusual way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peculiar",
                                "target_lang_sense_clarification": "strange or odd; unusual"
                            },
                            {
                                "target_lang_word": "singular",
                                "target_lang_sense_clarification": "exceptionally good or unusual"
                            },
                            {
                                "target_lang_word": "remarkable",
                                "target_lang_sense_clarification": "worthy of attention; striking"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}