                    {
                        "form_id": "a40c78c6-2dad-4a99-b871-d3e31f27f0ab",
                        "entry_id": "b1016380-4884-3bb1-af44-68d48b051bef",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "сварга́нивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8d91670-0e2d-3d41-929d-a0e0187aa271",
                        "entry_id": "b1016380-4884-3bb1-af44-68d48b051bef",
                        "glosses": [
                            "прост. сделать, изготовить или подготовить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a672d7-d9f8-452d-b8a5-c280a07c57f8",
                                "sense_id": "c8d91670-0e2d-3d41-929d-a0e0187aa271",
                                "text": "По осени беспременно надо свадьбу сварганить, надоело без хозяйки в доме."
                            },
                            {
                                "example_id": "7d9c1553-0cbf-41f5-8f43-862a5ac25180",
                                "sense_id": "c8d91670-0e2d-3d41-929d-a0e0187aa271",
                                "text": "Гуго хотел ездить ближе и не хотел трястись на мужицкой двуколёске, а сварганил себе нечто вроде колесницы: это было простое кресло с пружинной подушкой, поставленное на раму, укреплённую на передке старых дрожек."
                            },
                            {
                                "example_id": "180970b7-d048-4fc8-910c-3d21702c7423",
                                "sense_id": "c8d91670-0e2d-3d41-929d-a0e0187aa271",
                                "text": "Она из этой картошки в воскресенье такой супец сварганила, что ем уже третью неделю и всё равно жив."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7f4eac0-77df-4629-a0cd-b1272d784e22",
                        "source_entry_id": "b1016380-4884-3bb1-af44-68d48b051bef",
                        "source_sense_id": "c8d91670-0e2d-3d41-929d-a0e0187aa271",
                        "target_lang_word": "knock off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knock off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e8f1dad-0377-36ff-963c-421634dd04bf",
                                        "entry_id": "fa924028-cb54-31f9-bdb4-4a2768cd65e6",
                                        "glosses": [
                                            "To halt one's work or other activity."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655147a4-0369-457c-b801-f23489f58370",
                                                "sense_id": "4e8f1dad-0377-36ff-963c-421634dd04bf",
                                                "text": "I think I'll knock off for the evening and go to bed."
                                            },
                                            {
                                                "example_id": "5017be4e-4b05-4ee1-9cb6-b1c1b4a8be90",
                                                "sense_id": "4e8f1dad-0377-36ff-963c-421634dd04bf",
                                                "text": "Remember that this news was brought by the last steamer. That explains the stoppage of all communication, and the arrival of no more ships. We knocked off work a few days ago, and we're just waiting to see when things are to start afresh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb47c941-ffdd-372b-95f8-c1cde72c2977",
                                        "entry_id": "fa924028-cb54-31f9-bdb4-4a2768cd65e6",
                                        "glosses": [
                                            "To kill."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1932e79-95c1-4672-861e-0f6c4aa6b370",
                                                "sense_id": "bb47c941-ffdd-372b-95f8-c1cde72c2977",
                                                "text": "The mobsters hired the guy to knock off their enemies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "420667ec-cc06-3697-b4bb-0f0b03d21732",
                                        "entry_id": "fa924028-cb54-31f9-bdb4-4a2768cd65e6",
                                        "glosses": [
                                            "To kill.",
                                            "To defeat."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dd78900-912b-48fe-a87d-564defb675b1",
                                                "sense_id": "420667ec-cc06-3697-b4bb-0f0b03d21732",
                                                "text": "The Hammers knocked off Arsenal on the strength of a 78th-minute tally from Jarrod Bowen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b93df630-3a52-3707-a966-999bce7c0266",
                                        "entry_id": "fa924028-cb54-31f9-bdb4-4a2768cd65e6",
                                        "glosses": [
                                            "To remove, as a discount or estimate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f10f6487-2ce4-42ce-9326-e152f8fe88ae",
                                                "sense_id": "b93df630-3a52-3707-a966-999bce7c0266",
                                                "text": "They agreed to knock off 20% of the price."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6342afb-e4f0-3c89-8eac-dcfbf20e8e86",
                                        "entry_id": "fa924028-cb54-31f9-bdb4-4a2768cd65e6",
                                        "glosses": [
                                            "To rob."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f906859-70a4-4963-aed6-20234c5e44e0",
                                                "sense_id": "a6342afb-e4f0-3c89-8eac-dcfbf20e8e86",
                                                "text": "They decided to knock off a liquor store downtown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5de90ad-772d-3530-a1ee-f69e92499253",
                                        "entry_id": "fa924028-cb54-31f9-bdb4-4a2768cd65e6",
                                        "glosses": [
                                            "To make a copy of, as of a design."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "165d68df-38c6-4e33-b7ba-6f0ebddd1047",
                                                "sense_id": "c5de90ad-772d-3530-a1ee-f69e92499253",
                                                "text": "They send people to the shows in Milan for \"ideas\", which means knocking off the designs they guess would sell."
                                            },
                                            {
                                                "example_id": "16bfcbbf-523d-475c-af3a-4dddf404022c",
                                                "sense_id": "c5de90ad-772d-3530-a1ee-f69e92499253",
                                                "text": "Whipping up a healthy breakfast has never been easier. Neither has knocking off your fave Starbucks snack either, thanks to this TikTok-approved egg bite maker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f02ee022-71ff-3bdd-80ed-43137753b259",
                                        "entry_id": "fa924028-cb54-31f9-bdb4-4a2768cd65e6",
                                        "glosses": [
                                            "To assign (an item) to a bidder at an auction, indicated by knocking on the counter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5270f515-878d-3b21-b500-2e70b175eab9",
                                        "entry_id": "fa924028-cb54-31f9-bdb4-4a2768cd65e6",
                                        "glosses": [
                                            "To have sex with (a woman)."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang",
                                            "transitive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0792e4fc-4e56-4322-8ffd-d2a28818b8d1",
                                                "sense_id": "5270f515-878d-3b21-b500-2e70b175eab9",
                                                "text": "I took her down to Basin Street and to a movie, then took her to my room and knocked her off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "538fb50f-3f11-32f9-b78d-07c1e97e0e85",
                                        "entry_id": "fa924028-cb54-31f9-bdb4-4a2768cd65e6",
                                        "glosses": [
                                            "To accomplish hastily."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "789bc6ab-8d29-4847-b7e7-1a20f234ec3d",
                                                "sense_id": "538fb50f-3f11-32f9-b78d-07c1e97e0e85",
                                                "text": "I knocked off a couple of quick sketches before the design meeting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31758656-bdde-3fae-9fe8-7d29e1a27c73",
                                        "entry_id": "fa924028-cb54-31f9-bdb4-4a2768cd65e6",
                                        "glosses": [
                                            "To remove (something or someone) by hitting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd4334b-db89-40df-a64d-17c53ee5b0de",
                                                "sense_id": "31758656-bdde-3fae-9fe8-7d29e1a27c73",
                                                "text": "He was knocked off his bike."
                                            },
                                            {
                                                "example_id": "b981fd73-0132-45d0-a218-b7b33da06d28",
                                                "sense_id": "31758656-bdde-3fae-9fe8-7d29e1a27c73",
                                                "text": "It now appears that the locomotive did not blow up, as was commonly stated at the time, but that the aeroplane flew so low as to come into contact with the dome of the engine, knocking it off. It was the combination of the impact and the uprush of steam that so disturbed the equilibrium of the raider as to cause it to crash."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "knock off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9526032-a1d3-3556-868a-2d0d414a4379",
                                        "entry_id": "eee855c8-8182-3579-8c28-28f9bf44322b",
                                        "glosses": [
                                            "Nonstandard form of knockoff."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
