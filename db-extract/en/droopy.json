                        "target_lang_word": "tombant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tombant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "555de047-4589-3836-823e-4eaa34be6442",
                                        "entry_id": "7bb6d176-51b5-32e4-aea8-e50ead083029",
                                        "glosses": [
                                            "Qui tombe, qui pend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fd60502-13bc-4b94-880a-600adcce662d",
                                                "sense_id": "555de047-4589-3836-823e-4eaa34be6442",
                                                "text": "Les tiges de cette plante sont grêles et tombantes."
                                            },
                                            {
                                                "example_id": "45412c48-22aa-4a5b-b866-b1620127d446",
                                                "sense_id": "555de047-4589-3836-823e-4eaa34be6442",
                                                "text": "La paupière gauche était tombante, recouvrait presque tout le globe de l’œil."
                                            },
                                            {
                                                "example_id": "4e3aab91-154e-42b8-ab63-85e6d0c3ee37",
                                                "sense_id": "555de047-4589-3836-823e-4eaa34be6442",
                                                "text": "Ils achevaient maintenant leur vie de manière paisible, ils n’étaient pas les derniers à l’heure de l’apéritif, et promenaient avec bonhomie leurs fesses tombantes, leurs seins redondants et leurs bites inactives du bar à la plage, de la plage au bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f22d29d2-50f5-38e3-a909-afec202f38b8",
                                        "entry_id": "7bb6d176-51b5-32e4-aea8-e50ead083029",
                                        "glosses": [
                                            "Qualifie des cheveux longs qu’on laisse pendre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7d14fa0-5b31-35bd-b64e-408e6a9c288b",
                                        "entry_id": "7bb6d176-51b5-32e4-aea8-e50ead083029",
                                        "glosses": [
                                            "Qui décline, en parlant du jour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75b4900-199e-4cb3-a851-bf609c1f65ca",
                                                "sense_id": "e7d14fa0-5b31-35bd-b64e-408e6a9c288b",
                                                "text": "Seuls les professionnels ont tout loisir, du prime matin au soir tombant, d’inspecter cinq mille — voire dix mille crins."
                                            },
                                            {
                                                "example_id": "db04a2dc-4150-43c6-a07b-de78c463bb03",
                                                "sense_id": "e7d14fa0-5b31-35bd-b64e-408e6a9c288b",
                                                "text": "Il rentra de la chasse à la nuit tombante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24bd0ffd-94b8-3bf6-a66e-adb535eb2cb3",
                                        "entry_id": "7bb6d176-51b5-32e4-aea8-e50ead083029",
                                        "glosses": [
                                            "Se dit des armes (javelots, flèches, épées…) qui sont représentés pointe en bas contrairement à l’ordinaire. Pour les autres meubles, on dira plutôt renversé ou versé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ec1f83-e6da-494b-ae60-70e77c3d92b7",
                                                "sense_id": "24bd0ffd-94b8-3bf6-a66e-adb535eb2cb3",
                                                "text": "Parti : au premier d’or à la moucheture d’hermine de sable en chef et au rencontre de vache du même en pointe, au second d’azur à la moucheture d’hermine d’argent en chef et au rencontre de vache du même en pointe ; à la croix latine alésée d’argent, chargée d’un glaive tombant de sable, brochant sur le tout, qui est de Plouider → voir illustration « glaive tombant »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tombant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d0d4ffd-3cba-3b0d-97c0-d6caa4b8682a",
                                        "entry_id": "f64ea1cd-91e1-3656-adeb-0b6f7a038de6",
                                        "glosses": [
                                            "Manière dont tombe un drapé, une étoffe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d19b978e-50d3-4ba3-96f2-30aa6006db71",
                                                "sense_id": "7d0d4ffd-3cba-3b0d-97c0-d6caa4b8682a",
                                                "text": "Ce rideau a un beau tombant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6422665c-add3-343f-a8cb-94e8125d4e66",
