                                "example_id": "21f1a93e-ab7d-419a-98c8-d31dd8afcef7",
                                "sense_id": "bdc0c596-8f88-3cb6-9ef7-532d03a64b57",
                                "text": "„Ein Freund ist ebenfalls auf Wohnungssuche.“"
                            },
                            {
                                "example_id": "bf31aca0-d90a-4e53-aeb3-a357dafb50c4",
                                "sense_id": "bdc0c596-8f88-3cb6-9ef7-532d03a64b57",
                                "text": "„Dieser positive Einfluss auf eine erfolgreiche Wohnungssuche war auch bei dem Tischler- und Gastronomie-Azubi erkennbar.“"
