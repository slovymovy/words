                    {
                        "translation_id": "3217d61a-d6f1-4ff9-891a-5f8e96f140b1",
                        "source_entry_id": "8fdfab26-92ea-3042-9634-62c73e08bb14",
                        "source_sense_description": "herb wolfsbane",
                        "target_lang_word": "Eisenhut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eisenhut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "790ca324-1b1b-3255-93e4-1acdf550754b",
                                        "entry_id": "50ff5bb1-2c7c-3145-9eba-888f699bb1ed",
                                        "glosses": [
                                            "Pflanze mit helmförmigen Blüten aus der Gattung Aconitum aus der Familie der Hahnenfußgewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a60722ed-f513-4619-aa37-cc4987438962",
                                                "sense_id": "790ca324-1b1b-3255-93e4-1acdf550754b",
                                                "text": "Der Eisenhut ist eine der giftigsten Pflanzen Deutschlands."
                                            },
                                            {
                                                "example_id": "091ed0b1-c326-4e5c-8b13-133121e38fbe",
                                                "sense_id": "790ca324-1b1b-3255-93e4-1acdf550754b",
                                                "text": "Eisenhut ist sehr giftig."
                                            },
                                            {
                                                "example_id": "7b47ce50-d1cc-439a-91bb-b56a5af873a9",
                                                "sense_id": "790ca324-1b1b-3255-93e4-1acdf550754b",
                                                "text": "„Der Eisenhut (Aconitum napellus) enthält das hoch konzentrierte Pflanzengift Aconitin. Kinder, die mit den Blüten des Eisenhutes spielen, sind bereits in Gefahr, da das Gift über die Haut aufgenommen werden kann.“"
                                            },
                                            {
                                                "example_id": "7eaa78ab-f152-4ec1-bb75-5458e2043bda",
                                                "sense_id": "790ca324-1b1b-3255-93e4-1acdf550754b",
                                                "text": "„Der Blaue Eisenhut ist bei uns selten geworden. Er ist in seinem Bestand bedroht und steht unter Naturschutz.“"
                                            },
                                            {
                                                "example_id": "b93d8dd7-0c9a-4791-9850-38fe010e1338",
                                                "sense_id": "790ca324-1b1b-3255-93e4-1acdf550754b",
                                                "text": "„Hochwachsende Stauden wie Eisenhut, Sonnenhut oder Stauden-Sonnenblumen können bei starkem Wind und Regen abknicken.“"
                                            },
                                            {
                                                "example_id": "7b769094-f463-4862-840c-521275345f9e",
                                                "sense_id": "790ca324-1b1b-3255-93e4-1acdf550754b",
                                                "text": "[Wildblumenwiese:] „Attraktive Wildstauden sind beispielsweise Steppen-Salbei, Wiesen-Schafgarbe, Blauer Eisenhut, Fingerhut und Wiesen-Margerite.“"
                                            },
                                            {
                                                "example_id": "2a0cfe94-331d-4ef8-99b0-f89d9313420d",
                                                "sense_id": "790ca324-1b1b-3255-93e4-1acdf550754b",
                                                "text": "„Ein halbschattiger Standort ist ideal für den sehr giftigen Eisenhut, der - je nach Sorte - von Juli bis Oktober blüht.“"
                                            },
                                            {
                                                "example_id": "80d4d121-5544-47cb-8306-3aaf07d4733a",
                                                "sense_id": "790ca324-1b1b-3255-93e4-1acdf550754b",
                                                "text": "„Als schneckenresistent gelten auch Astilben, Akelei, Ballonblumen, Bergenien, Eisenhut, Frauenmantel, Maiglöckchen, Pfingstrosen und Storchschnabel.“"
                                            },
                                            {
                                                "example_id": "eb291fc7-f479-49dd-92d6-5eee3dffc3ec",
                                                "sense_id": "790ca324-1b1b-3255-93e4-1acdf550754b",
                                                "text": "„Faszinierend ist auch, dass Wildbienen Blüten anfliegen können, die die Honigbienen oder andere Wildbienenarten auf Grund ihres Körperbaus nicht erreichen. Dazu gehören zum Beispiel Blüten mit Nektar in tiefen Kronröhren, wie zum Beispiel Rotklee, Eisenhut und Rittersporn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce0c3322-8f1c-3609-9cfe-452ff0457aea",
                                        "entry_id": "50ff5bb1-2c7c-3145-9eba-888f699bb1ed",
                                        "glosses": [
                                            "mittelalterlicher Helmtyp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9db133d-52a4-49aa-a95c-5c5edd856549",
                                                "sense_id": "ce0c3322-8f1c-3609-9cfe-452ff0457aea",
                                                "text": "Eisenhüte haben die Form eisernen Hutes mit Krempe."
                                            },
                                            {
                                                "example_id": "a41cb7a3-90ea-438f-ac60-3f2ea9d2f8f8",
                                                "sense_id": "ce0c3322-8f1c-3609-9cfe-452ff0457aea",
                                                "text": "„Gegen Ende des 15. Jahrhunderts in der Zeit des Reformators Ulrich Zwingli entstand der Eisenhut, der den Träger im Streit gegen Nachbarn schützte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
