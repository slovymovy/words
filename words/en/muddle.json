    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ca18546-2bb2-3372-9a9b-662ea0deb216",
                    "sense_definition": "To mix things together in a disorderly way, or to confuse thoughts or facts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Young children tend to <w>muddle</w> their words when trying to speak too quickly."
                        },
                        {
                            "text": "Be careful not to <w>muddle</w> these two concepts because they mean entirely different things."
                        }
                    ],
                    "synonyms": [
                        "confuse",
                        "jumble",
                        "mix up"
                    ],
                    "antonyms": [
                        "clarify"
                    ],
                    "common_phrases": [
