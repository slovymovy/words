                    {
                        "sense_id": "9cf5da84-3d14-3032-82db-8efe2b04b01c",
                        "entry_id": "40bdc48d-4a76-3036-a417-7d22415bfd01",
                        "glosses": [
                            "A type of visorless helmet, of 15th-century Italian design, including a T or Y shaped opening for the eyes and mouth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55bdb9b1-2a05-48eb-bc7a-1a5aa89cd7ca",
                                "sense_id": "9cf5da84-3d14-3032-82db-8efe2b04b01c",
                                "text": "Medium helmets weighing about six pounds occur in visored bassinets, salades, barbutes, armets and certain burganets."
                            },
                            {
                                "example_id": "4f5eea8e-26cf-454a-b341-e216b119539d",
                                "sense_id": "9cf5da84-3d14-3032-82db-8efe2b04b01c",
                                "text": "Men and women laced their arming caps and donned their helmets—tall bassinets, practical kettle hats, or sturdy barbutes. Soldiers always rode out armed from head to foot—but only a novice or an overeager squire rode in his helmet or gauntlets."
                            },
                            {
                                "example_id": "af4a639e-0fe7-479a-a20d-756f9af91ed8",
                                "sense_id": "9cf5da84-3d14-3032-82db-8efe2b04b01c",
                                "text": "In place of the visor, the barbute enclosed most of the face, leaving only relatively small openings for the eyes, nose, and mouth. Some barbutes, such as the one shown, appear to have been modeled on ancient Greek helmets."
                            }
                        ]
                    }
