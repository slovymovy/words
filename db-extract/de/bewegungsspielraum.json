                "senses": [
                    {
                        "sense_id": "ced0ee72-e746-3fc3-b989-e0238201333f",
                        "entry_id": "ef49aa14-b3a3-351c-93ec-4a7ebfeacbf9",
                        "glosses": [
                            "Raum, in dem sich eine Bewegung (ohne Einschränkungen) vollziehen lässt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f0920301-bdcf-3ee7-9748-f058501f084a",
                        "entry_id": "ef49aa14-b3a3-351c-93ec-4a7ebfeacbf9",
                        "glosses": [
                            "(meistens durch verschiedene Gegebenheiten begrenzter) Raum, innerhalb dessen jemand (in einer bestimmten Situation) Entscheidungen treffen oder Handlungen durchführen kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "013707d6-6caf-3382-b5db-06308ae4610b",
                        "entry_id": "ef49aa14-b3a3-351c-93ec-4a7ebfeacbf9",
                        "glosses": [
                            "physiologischer Bereich, in dem sich eine Körperstruktur wie ein Gelenk oder Muskel normal bewegen kann, ohne dass es zu Schäden oder Überlastungen kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2ca1075-585c-412e-a896-5871cd4ef104",
                                "sense_id": "013707d6-6caf-3382-b5db-06308ae4610b",
                                "text": "„Das Krongelenk ist ein Sattelgelenk, das wenig Bewegungsspielraum zulässt (low-motion-joint), jedoch hohen Kräften ausgesetzt ist (high-energy-joint).“"
                            },
                            {
                                "example_id": "14d411d4-bcc1-4430-8db0-e5a18695cf12",
                                "sense_id": "013707d6-6caf-3382-b5db-06308ae4610b",
                                "text": "„Torsion bedeutet ‚Drehung‘ bzw. ‚Verdrehung‘. Wird der physiologische Bewegungsspielraum einer Körperstruktur dabei überschritten, spricht man auch von einer Distorsion.“"
                            },
                            {
                                "example_id": "641bb193-f699-4027-8724-34f9483385eb",
                                "sense_id": "013707d6-6caf-3382-b5db-06308ae4610b",
                                "text": "Die Prothese muss deshalb den diversen Muskelbändern einen Bewegungsspielraum lassen, wie beispielsweise dem Zungenbändchen oder den Lippen- und Wangenbändchen."
                            },
                            {
                                "example_id": "a78f239c-a801-4019-b674-50db1971372a",
                                "sense_id": "013707d6-6caf-3382-b5db-06308ae4610b",
                                "text": "„Endometrioseherde im Douglas-Raum können durch Vernarbung zu Adhäsionen zwischen Rektum und Gebärmutter führen. Der dadurch eingeschränkte Bewegungsspielraum der Gebärmutter kann bei der Frau Schmerzen beim Geschlechtsverkehr (Dyspareunie) hervorrufen, da der Penis des Mannes im Schnitt meist länger ist als die Vagina und den Uterus beim Geschlechtsverkehr mitbewegt.“"
                            },
                            {
                                "example_id": "d87d9fe0-7bd8-4923-8b81-b3faec05647f",
                                "sense_id": "013707d6-6caf-3382-b5db-06308ae4610b",
                                "text": "„Für die Augenmuskeln werden dabei die sogenannten Tenon-Pforten (‚Pulleys‘) gebildet. Sie ermöglichen einen gewissen Bewegungsspielraum in Zugrichtung des Muskels, unterbinden jedoch Querverschiebungen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "87f26ff7-a93e-37ca-89d6-7cde48cf43f1",
                        "entry_id": "ef49aa14-b3a3-351c-93ec-4a7ebfeacbf9",
                        "glosses": [
                            "Raum, in dem sich ein Fahrzeug sicher bewegen kann, ohne dass die Gefahr besteht, mit anderen Fahrzeugen, Hindernissen oder der Straßenbegrenzung zu kollidieren"
                        ],
                        "tags": [
                            "Straßenverkehr"
                        ],
                        "examples": [],
                        "sense_index_json": "\"4\""
                    }
