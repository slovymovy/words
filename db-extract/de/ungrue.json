                "senses": [
                    {
                        "sense_id": "8f1551d5-88d6-3839-9451-e181e9cf012a",
                        "entry_id": "e8e62257-b703-35d9-ad8b-c4585ff22326",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff82200-bf3d-488d-beb5-008075b24825",
                                "sense_id": "8f1551d5-88d6-3839-9451-e181e9cf012a",
                                "text": "Ungrue kommt und geht."
                            },
                            {
                                "example_id": "733bed3a-76a3-424e-9617-097a808cd957",
                                "sense_id": "8f1551d5-88d6-3839-9451-e181e9cf012a",
                                "text": "Ungrues kamen, sahen und siegten."
                            },
                            {
                                "example_id": "38a75f55-f077-4615-a7d8-3012b53fef29",
                                "sense_id": "8f1551d5-88d6-3839-9451-e181e9cf012a",
                                "text": "Frau Ungrue ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b88ac13b-b129-4e6f-b02b-f16f82e69cfe",
                                "sense_id": "8f1551d5-88d6-3839-9451-e181e9cf012a",
                                "text": "Herr Ungrue wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e242d0dc-69bb-4fb0-8d0b-880e15390350",
                                "sense_id": "8f1551d5-88d6-3839-9451-e181e9cf012a",
                                "text": "Die Ungrues fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "930a9650-8474-4b00-b6ab-dd71f27dfaf8",
                                "sense_id": "8f1551d5-88d6-3839-9451-e181e9cf012a",
                                "text": "Der Ungrue trägt nie die Schals, die die Ungrue ihm strickt."
                            },
                            {
                                "example_id": "b4685260-ea98-4e79-a286-445b76839653",
                                "sense_id": "8f1551d5-88d6-3839-9451-e181e9cf012a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ungrue kommt, geht der Herr Ungrue.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
