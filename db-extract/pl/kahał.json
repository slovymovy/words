                                        "sense_id": "3764bded-41e0-309b-9528-170a946c514a",
                                        "entry_id": "bc28c7b0-c2db-3b4b-9197-272c0aaadaa0",
                                        "glosses": [
                                            "The local governing body of a former European Jewish community, administering religious, legal and communal affairs."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "343ad8a3-e454-35c4-8c92-b510a3d8aa97",
                                        "entry_id": "bc28c7b0-c2db-3b4b-9197-272c0aaadaa0",
                                        "glosses": [
                                            "A congregation."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23aead04-bf09-4169-bf53-1b5d03d68923",
                        "source_entry_id": "e1f13e70-5abf-36f3-97a4-2190db2efd41",
                        "source_sense_id": "ad6a1ec8-9644-39e0-befe-65f5937e0ce3",
                        "target_lang_word": "qahal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qahal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf9e0625-fd19-37b5-a9bc-69c16ca53be3",
                                        "entry_id": "8ee8d6eb-19a3-370c-b300-4dff8da6b066",
                                        "glosses": [
                                            "A theocratic organizational structure in ancient Israelite society; congregation, assembly."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "805ded3b-65eb-4aff-b514-f9ddb9dad7e3",
                                                "sense_id": "bf9e0625-fd19-37b5-a9bc-69c16ca53be3",
                                                "text": "When Solomon's temple is consecrated, the qahal of Israel gathers to be blessed (1 Kgs. 8:14), and when Ezra intervenes with drastic means to preserver the restored Israel, it is the qahal that acts before God (Ezra 10:12-14)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "623ccb64-fc3b-3894-ae24-75b846b4963f",
                                        "entry_id": "8ee8d6eb-19a3-370c-b300-4dff8da6b066",
                                        "glosses": [
                                            "Alternative form of kahal (local governing body of a former European Jewish community)"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e964cd2-2f03-4f4b-968a-78c4bfdbd38b",
                                                "sense_id": "623ccb64-fc3b-3894-ae24-75b846b4963f",
                                                "text": "Other examples could be mentioned, such as the fact that although Jewish communities were initially permitted to retain their local self-government in the form of the qahal, they could not keep their broader, empire-wide institutions, which had long existed in the Polish-Lithuanian Commonwealth, as these did not fit in with the desired enlightened-absolutist social order."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c27fc24-e3fc-4348-be0d-258cd97f8a99",
                        "source_entry_id": "e1f13e70-5abf-36f3-97a4-2190db2efd41",
                        "source_sense_id": "ad6a1ec8-9644-39e0-befe-65f5937e0ce3",
                        "target_lang_word": "Kehillah",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kehillah",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af2c57e6-8a85-3469-a79d-3d2e2bdb7f2a",
                                        "entry_id": "8110baf5-87c8-31e8-a77a-6a2af6b8e9f6",
                                        "glosses": [
                                            "jüdische Gemeinde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d86194e2-4bf3-4ad7-8ab8-04bb8979788d",
                                                "sense_id": "af2c57e6-8a85-3469-a79d-3d2e2bdb7f2a",
                                                "text": "„In nur einhundert Jahren wurde die Leipziger Kehillah zur sechstgrößten in ganz Deutschland und zur größten in Sachsen, 1925 hatte sie rund 13.000 Mitglieder.“"
                                            },
                                            {
                                                "example_id": "05bdfdda-f546-427e-a935-c6c1bbd4cf9f",
                                                "sense_id": "af2c57e6-8a85-3469-a79d-3d2e2bdb7f2a",
                                                "text": "„Es gibt nur wenige, die sich in ähnlicher Weise um unsere Gemeinde, unser spirituelles, aber auch um das materielle Wohl unserer Kehillah verdient machten.“"
                                            },
                                            {
                                                "example_id": "31767433-d6dc-4320-8182-4e38f1860485",
                                                "sense_id": "af2c57e6-8a85-3469-a79d-3d2e2bdb7f2a",
                                                "text": "„Ausweisungen aus den Reichsstädten und Herzogtümern zerstörten funktionierende und vollgültige Kehillot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
