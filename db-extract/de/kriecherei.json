                "senses": [
                    {
                        "sense_id": "8ede4ebb-d238-3db0-b9ff-978c282426a5",
                        "entry_id": "f95cb694-9bf0-3f59-9c9c-25a7edbe9e85",
                        "glosses": [
                            "unterwürfige, kriecherische Schmeichelei"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "ff202e7b-dc97-4586-ad90-94c9f5dc81e1",
                                "sense_id": "8ede4ebb-d238-3db0-b9ff-978c282426a5",
                                "text": "„Das mag vielleicht wie übellaunige Kriecherei klingen, tatsächlich aber hatte er damit völlig recht.“"
                            },
                            {
                                "example_id": "284dc3e7-54c3-430b-9187-5b43dc91d1ab",
                                "sense_id": "8ede4ebb-d238-3db0-b9ff-978c282426a5",
                                "text": "„Er bemerkte, dass alle miteinander tuschelten und mit den Augen auf ihn deuteten, und zwar mit einer Scheu, in der schon etwas von serviler Kriecherei lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a41554e-05b4-4a24-8bed-5178450c2fbb",
                        "source_entry_id": "f95cb694-9bf0-3f59-9c9c-25a7edbe9e85",
                        "source_sense_id": "8ede4ebb-d238-3db0-b9ff-978c282426a5",
                        "source_sense_description": "abwertend: unterwürfige, kriecherische Schmeichelei",
                        "target_lang_word": "lizusostwo",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lizusostwo",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "3ccdd467-dba2-3b68-9a50-34a4d6cca7e6",
                                        "entry_id": "fd1bc537-55ff-3412-9205-82c3fd0b7d68",
                                        "glosses": [
                                            "postawa schlebiająca komuś, kto jest wyżej postawiony, dla pozyskania jego względów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1295e5a-5dcc-4405-98b1-c92f48ee2e5f",
                                                "sense_id": "3ccdd467-dba2-3b68-9a50-34a4d6cca7e6",
                                                "text": "Fałszywe jest mniemanie, że gmach lizusostwa wznosi tylko jedna osoba. Jest on dziełem wspólnym podlizującego i podlizywanego"
                                            },
                                            {
                                                "example_id": "19b699e0-137d-4ac3-a0f7-e7e110f37ef2",
                                                "sense_id": "3ccdd467-dba2-3b68-9a50-34a4d6cca7e6",
                                                "text": "Dzong Il bywał zwykle sercem i duszą tego rodzaju imprez, przechwalał się i opowiadał sprośne żarty, pouczał orkiestrę, delektując się lizusostwem i uległością swoich sługusów, którzy przypadali do jego nóg na każde skinienie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
