                            },
                            {
                                "target_lang_word": "изголодавшийся",
                                "target_lang_sense_clarification": "истощенный длительным отсутствием еды"
                            },
                            {
                                "target_lang_word": "ужасно голодный",
                                "target_lang_sense_clarification": "разговорное выражение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "am Verhungern",
                                "target_lang_sense_clarification": "sehr starker Hunger, oft umgangssprachlich"
                            },
                            {
                                "target_lang_word": "ausgehungert",
                                "target_lang_sense_clarification": "sehr hungrig, oft nach einer längeren Zeit ohne Nahrung"
                            },
                            {
                                "target_lang_word": "riesigen Hunger haben",
                                "target_lang_sense_clarification": "umgangssprachliche Ausdrucksweise für extremen Hunger"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "efb2aa6c-8878-3edb-b612-dd9f66a0e01a",
                    "sense_definition": "Present participle and gerund of <w>starve</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long siege ended up <w>starving</w> the enemy forces into submission.",
                            "target_lang_translations": {
                                "ru": "Длительная осада закончилась тем, что вражеские войска <w>заморили голодом</w> до подчинения.",
                                "de": "Die lange Belagerung endete damit, dass die feindlichen Truppen <w>ausgehungert</w> und zur Kapitulation gezwungen wurden."
                            }
                        },
                        {
                            "text": "He is <w>starving</w> for some attention after being alone for so long.",
                            "target_lang_translations": {
                                "ru": "Он <w>жаждет</w> внимания после того, как так долго был один.",
                                "de": "Er <w>dürstet</w> nach etwas Aufmerksamkeit, nachdem er so lange allein war."
                            }
                        }
                    ],
                    "common_phrases": [
                        "starving to death"
                    ],
