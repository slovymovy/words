                "senses": [
                    {
                        "sense_id": "8024710b-ad9a-3eb6-82bd-cc26f925bc75",
                        "entry_id": "a13bfb0f-da89-3c0d-9ceb-91b533fa5064",
                        "glosses": [
                            "strahlenförmig angeordnetes aerodynamisches, flächiges, flügelförmiges Einzelteil eines Rotors"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0f8ce3a-8f07-4759-b7b7-ad8e183ce36b",
                                "sense_id": "8024710b-ad9a-3eb6-82bd-cc26f925bc75",
                                "text": "„Nach einer Zwangspause im Frühjahr entpuppte sich ‚Growian‘ als überdimensionaler Rasensprenger – gefrorenes Kondenswasser hatte die Kunststoffversiegelung des Rotorblattes gesprengt und für Regen porös gemacht.“"
                            },
                            {
                                "example_id": "c8db7ae2-7fa8-4fba-adf7-bba370dc0b81",
                                "sense_id": "8024710b-ad9a-3eb6-82bd-cc26f925bc75",
                                "text": "„Die Anströmgeschwindigkeit ändert sich daher für das Rotorblatt ständig, je nachdem ob es vor- oder rückläuft.“"
                            },
                            {
                                "example_id": "3a4af13b-6d02-462a-add7-6f9f28bd7a2a",
                                "sense_id": "8024710b-ad9a-3eb6-82bd-cc26f925bc75",
                                "text": "„Die Anzahl der Rotorblätter einer Windkraftanlage hat nur geringen Einfluß auf die mechanische Rotorleistung: Rotoren mit geringer Blattzahl drehen schneller und gleichen so ihren Nachteil der kleineren Blattfläche fast wieder aus.“"
                            },
                            {
                                "example_id": "ad63a791-8bdf-411d-8787-182806d5865a",
                                "sense_id": "8024710b-ad9a-3eb6-82bd-cc26f925bc75",
                                "text": "„Auch bei stationären Windmühlen ist es schließlich so, dass das Endstück eines Rotorblatts den größten Teil an Energie erbringt, hat Jose Zayas, Leiter der Windenergieforschung am Sandia National Laboratory in New Mexico berechnet.“"
                            },
                            {
                                "example_id": "0cf40cf8-4cc5-4642-8afc-b63417ca0960",
                                "sense_id": "8024710b-ad9a-3eb6-82bd-cc26f925bc75",
                                "text": "„Ein abgestürzter und halb verkohlter Hubschrauber lag mit hängenden Rotorblättern da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
