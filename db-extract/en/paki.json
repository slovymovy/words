                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d2c401bf-e441-3a6c-9ddc-ad88c0db623d",
                        "entry_id": "d5612c67-0155-3bc7-bd50-a967d509ad5e",
                        "glosses": [
                            "Anyone whose origins are perceived to be from South Asia or the Indian subcontinent."
                        ],
                        "tags": [
                            "Canada",
                            "UK",
                            "broadly",
                            "ethnic",
                            "offensive",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "57ca29b2-8e88-4268-8fc4-dea0c8dd9a5b",
                                "sense_id": "d2c401bf-e441-3a6c-9ddc-ad88c0db623d",
                                "text": "Their byword is Aggro (Aggravation) and their crucial enemies are hippies, homosexuals and Pakis (Pakistanis or Indians)."
                            },
                            {
                                "example_id": "e6cd92b7-d265-4f65-82ed-ff932aa98ed6",
                                "sense_id": "d2c401bf-e441-3a6c-9ddc-ad88c0db623d",
                                "text": "In these telephone calls and recorded messages the respondent, who held strong views on immigration and asylum policy and the provision of public support to immigrants and applicants for asylum, ranted and shouted and made reference to \"Wogs\", \"Pakis\", \"Black bastards\" and […] \"Niggers\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "49ce76c1-3752-32d9-858f-bcae9ba59284",
                        "entry_id": "d5612c67-0155-3bc7-bd50-a967d509ad5e",
                        "glosses": [
                            "Ellipsis of Paki shop."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "abbreviation",
                            "alt-of",
                            "ellipsis",
                            "ethnic",
                            "offensive",
                            "slur"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce7000c7-a0e8-4215-b91e-53917af21058",
                        "source_entry_id": "d5612c67-0155-3bc7-bd50-a967d509ad5e",
                        "source_sense_description": "a Pakistani",
                        "target_lang_word": "pakos",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pakos",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55947298-6dca-3e0f-8a30-bddab972df76",
                                        "entry_id": "74eb40c0-e49b-3bfe-9f7b-ba4d19769e9a",
                                        "glosses": [
                                            "Pakistanais."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "vulgar"
                                        ],
                                        "note": "Le terme est considéré raciste",
                                        "examples": [
                                            {
                                                "example_id": "0c71d64d-6755-4a24-9c5c-0e109cb16151",
                                                "sense_id": "55947298-6dca-3e0f-8a30-bddab972df76",
                                                "text": "Ici des Londoniens aseptisés à l’air conditionné ; là les “pakos” et Afghans disputant un passage vers la fenêtre de l'autocar à quelques poules et casseroles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24ffe857-c311-3738-8d9a-b08df7a054eb",
                                        "entry_id": "74eb40c0-e49b-3bfe-9f7b-ba4d19769e9a",
                                        "glosses": [
                                            "Commerçant pakistanais."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d27501b7-921b-4077-901f-4dd10c538de9",
                                                "sense_id": "24ffe857-c311-3738-8d9a-b08df7a054eb",
                                                "text": "On passe chez le Pakos pour acheter de la bière et du vin bon marché. Personne n’a l’âge légal pour ça, mais Terry et Gent ont l’air d’avoir vingt-cinq ans, alors aucun problème pour se faire servir."
                                            },
                                            {
                                                "example_id": "42851d49-c9b3-45c4-8949-017b6e66cb2e",
                                                "sense_id": "24ffe857-c311-3738-8d9a-b08df7a054eb",
                                                "text": "Je l’ai remarqué parce qu'il transpirait beaucoup, dirait la Pakos à la caisse (la cousine du boulanger Batool, pour ce qu’en sait Brady) à la police. Et aussi parce qu’il achetait du poison à rongeurs. Celui à la strychnine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0a4c402-b1ba-4583-a983-23ed635e367f",
                        "source_entry_id": "d5612c67-0155-3bc7-bd50-a967d509ad5e",
                        "source_sense_description": "a Pakistani",
                        "target_lang_word": "paki",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paki",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd51c72b-091a-3568-b28a-7ef86b6599ef",
                                        "entry_id": "33bb35fd-3c0f-35fb-b160-376172df0ac3",
                                        "glosses": [
                                            "Pakistanais."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dd9cb44-102b-4fa0-88a1-120eeecca31a",
                                                "sense_id": "fd51c72b-091a-3568-b28a-7ef86b6599ef",
                                                "text": "Aussi incompréhensible qu'un paki qui vend le saté\nIl faut l'admettre c'est Jackie Brown raté"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac60ac70-63e8-351c-9597-6a6d6ceecc8b",
                                        "entry_id": "33bb35fd-3c0f-35fb-b160-376172df0ac3",
                                        "glosses": [
                                            "Haschisch en provenance du Pakistan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f206d67f-38a9-451e-a631-de1270cb21db",
                                                "sense_id": "ac60ac70-63e8-351c-9597-6a6d6ceecc8b",
                                                "text": "L'oseille ne m'aura pas, mes amis prennent à la tonne\n3 balles le litron d'paki, ça vient direct de Nador"
                                            },
                                            {
                                                "example_id": "bf22c396-8230-410d-9f16-28b6893fbc66",
                                                "sense_id": "ac60ac70-63e8-351c-9597-6a6d6ceecc8b",
                                                "text": "Juste un peu de son, un peu de chauffage, un p'tit joint d'paki\nJ'suis dans ma gamberge j'pense à mon poto qu'est parti"
                                            },
                                            {
                                                "example_id": "521a7eff-d26d-40a6-9dff-da234eb0c20a",
                                                "sense_id": "ac60ac70-63e8-351c-9597-6a6d6ceecc8b",
                                                "text": "Fiston y'a pas d'henné dans mon paki"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d32027a-dfd1-4577-873b-6b89d66e7ba7",
                        "source_entry_id": "d5612c67-0155-3bc7-bd50-a967d509ad5e",
                        "source_sense_description": "a Pakistani",
                        "target_lang_word": "pakpak",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pakpak",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69e14a3b-93fc-3200-8c6a-50c51eb60b29",
                                        "entry_id": "02bdc62c-059e-3da3-a35a-ed7baf59d3ea",
                                        "glosses": [
                                            "Variante orthographique de pak-pak."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "offensive"
                                        ],
                                        "note": "Ce terme est considéré raciste",
                                        "examples": [
                                            {
                                                "example_id": "63a13587-3491-44f8-8446-2141e606989b",
                                                "sense_id": "69e14a3b-93fc-3200-8c6a-50c51eb60b29",
                                                "text": "Métis, j'vends du marron comme un pakpak"
                                            },
                                            {
                                                "example_id": "09ec42fc-4b8a-4aef-a67d-f4a1480530b1",
                                                "sense_id": "69e14a3b-93fc-3200-8c6a-50c51eb60b29",
                                                "text": "Tu sens qu'ça blague pas, partouze des morceaux d'barbaque\nTu jettes des fleurs quand tu comprends pas façon pakpak"
                                            },
                                            {
                                                "example_id": "d1e73d38-b20f-44f7-88ed-109385e4c846",
                                                "sense_id": "69e14a3b-93fc-3200-8c6a-50c51eb60b29",
                                                "text": "— Rien, Ravi. Elles étaient toutes jeunes et charmantes. Simplement, elles n'étaient pas mon genre.\n— Tu veux dire qu'il n'y en a aucune dans ce putain de pays qui t'ait jamais tapé dans l'œil ? Franchement, tu es un pakpak bien difficile, mon pote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81af42b4-0753-4b3a-82a8-8f4c3ea0ab7a",
                        "source_entry_id": "d5612c67-0155-3bc7-bd50-a967d509ad5e",
                        "source_sense_description": "a Pakistani",
