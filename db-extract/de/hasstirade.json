                "senses": [
                    {
                        "sense_id": "539859d8-ff33-3f0d-8c0b-fdd80693c57d",
                        "entry_id": "507ba572-e2a7-3970-a4c3-0a11042309da",
                        "glosses": [
                            "abwertender, von Hass geleiteter Wortschwall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be9c4138-f3df-42e6-b5a6-b4f599a07ff1",
                                "sense_id": "539859d8-ff33-3f0d-8c0b-fdd80693c57d",
                                "text": "In seiner Wut ließ er sich zu Hasstiraden hinreißen."
                            },
                            {
                                "example_id": "05c122fa-0324-4526-8968-42100577eefc",
                                "sense_id": "539859d8-ff33-3f0d-8c0b-fdd80693c57d",
                                "text": "„Die anschließenden Hasstiraden kann man damit kaum erklären.“"
                            },
                            {
                                "example_id": "9f20c525-8f87-4953-bb42-c0d777c8d1d5",
                                "sense_id": "539859d8-ff33-3f0d-8c0b-fdd80693c57d",
                                "text": "„Ilja Ehrenburg feuerte die Rotarmisten mit Hasstiraden zum Töten an.“"
                            },
                            {
                                "example_id": "4da436f5-1d5d-4f29-8ccf-ef40e6ec8945",
                                "sense_id": "539859d8-ff33-3f0d-8c0b-fdd80693c57d",
                                "text": "„Die Hasstiraden des Pöbels waren nicht seine Sache.“"
                            },
                            {
                                "example_id": "4ccf480a-1efc-427c-82d4-1b0b156dff19",
                                "sense_id": "539859d8-ff33-3f0d-8c0b-fdd80693c57d",
                                "text": "„Jünger hat kein nennenswertes Engagement vorzuweisen, das ihn als Demokrat ausweisen würde: Die Kriegsbücher und die in Richtung Tendenzliteratur gehenden antirepublikanischen Hasstiraden der 1920er Jahre scheinen dafür weitgehend ungeeignet.“"
                            },
                            {
                                "example_id": "02479c2b-34c5-4214-aa19-0baa1109b773",
                                "sense_id": "539859d8-ff33-3f0d-8c0b-fdd80693c57d",
                                "text": "„Die Laissez-faire-Haltung der Zardari-Regierung trug zuletzt zu einem Klima weiterer Radikalisierung bei. So ziehen extremistische Prediger durch die Städte Pakistans, um sich bei Großveranstaltungen in Hasstiraden gegen Schiiten und Ahmadis zu ergehen oder den Dschihad gegen Indien und den Westen zu predigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
