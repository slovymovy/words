            {
                "entry_id": "4c2d5ee0-6ca9-3cb2-a61d-cbc6b6388b3f",
                "word": "lamaneur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c1a48b29-4906-4f7a-92f5-60f22fa8da51",
                        "entry_id": "4c2d5ee0-6ca9-3cb2-a61d-cbc6b6388b3f",
                        "tags": [
                            "plural"
                        ],
                        "form": "lamaneurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25c37d00-9d8c-355a-b01a-e621a8e96cea",
                        "entry_id": "4c2d5ee0-6ca9-3cb2-a61d-cbc6b6388b3f",
                        "glosses": [
                            "Pilote qui connaît particulièrement l’entrée d’un port et qui y réside pour conduire les navires à l’entrée et à la sortie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58ce7ab3-1909-4e59-8701-df41b55ee16a",
                                "sense_id": "25c37d00-9d8c-355a-b01a-e621a8e96cea",
                                "text": "Le lamaneur qui entreprendra, étant ivre, de piloter un vaisseau, sera condamne en cent sous d’amende, et interdit pour un mois du pilotage."
                            },
                            {
                                "example_id": "3c726e62-7a98-4b10-9e7a-dbf31ab7485d",
                                "sense_id": "25c37d00-9d8c-355a-b01a-e621a8e96cea",
                                "text": "Les lamaneurs de la Rochelle auront le droit exclusif de piloter tous les navires qui sortiront de ce port, soit pour aller en rade de l’île de Ré, ou à la mer."
                            },
                            {
                                "example_id": "f67b70db-39dc-44fb-8203-99792e43c84f",
                                "sense_id": "25c37d00-9d8c-355a-b01a-e621a8e96cea",
                                "text": "Alors, les lamaneurs s'agiteraient en un ballet bien réglé pour amarrer le bateau aux énormes bittes de fonte ancrées au sol."
                            }
                        ]
                    },
                    {
                        "sense_id": "494f11ba-0de6-3ebe-830c-9604dba2099b",
                        "entry_id": "4c2d5ee0-6ca9-3cb2-a61d-cbc6b6388b3f",
                        "glosses": [
                            "Puissance qui guide les pensées ou les comportements."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bd9c13a4-6c15-4d95-93a8-a63c9529fcce",
                                "sense_id": "494f11ba-0de6-3ebe-830c-9604dba2099b",
                                "text": "L’Imitation, lamaneur silencieux et masqué du bateau de nos jours."
                            }
                        ]
                    }
                ],
