                ],
                "senses": [
                    {
                        "sense_id": "1d8b874e-5162-3943-bb1d-d4614933a7e0",
                        "entry_id": "0e9f9550-d59a-330b-8775-111006fb46b1",
                        "glosses": [
                            "einem Thron ähnelnd, wie ein Thron aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdbb8068-5548-4e10-9fce-f9b7e2809d8b",
                                "sense_id": "1d8b874e-5162-3943-bb1d-d4614933a7e0",
                                "text": "„Dieses Wesen hier saß auf einem großen thronartigen Podest, das mit mir unbekannten - möglicherweise chinesischen - Schriftzeichen überzogen war.“"
                            },
                            {
                                "example_id": "a56ed223-1e87-4e76-a811-8a699b728fe0",
                                "sense_id": "1d8b874e-5162-3943-bb1d-d4614933a7e0",
                                "text": "„Und so kam es, dass sie sich auf dem thronartigen Stuhl wiederfand, vor einem Schreibtisch, auf dem drei Personen bequem hätten schlafen können.“"
                            },
                            {
                                "example_id": "5b96a194-4c1c-4e73-8266-59d3ba7d4b8f",
                                "sense_id": "1d8b874e-5162-3943-bb1d-d4614933a7e0",
                                "text": "„Eine grauhaarige Frau posierte auf einem thronartigen Stuhl, der mit kobaltblauem Stoff bezogen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
