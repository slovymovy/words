                            {
                                "target_lang_word": "高傲",
                                "target_lang_sense_clarification": "自视甚高，目中无人"
                            },
                            {
                                "target_lang_word": "自大",
                                "target_lang_sense_clarification": "自以为了不起"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12370e8c-63c8-3580-81e9-166ac9749b58",
                    "sense_definition": "Personne qui fait preuve d'insolence ou d'effronterie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne faites pas attention aux remarques de cet <w>insolent</w>.",
                            "target_lang_translations": {
                                "en": "Don't pay attention to the remarks of this <w>smart aleck</w>.",
                                "ru": "Не обращайте внимания на замечания этого <w>наглеца</w>.",
                                "de": "Achten Sie nicht auf die Bemerkungen dieses <w>Frechdachses</w>.",
                                "es": "No hagan caso a las observaciones de este <w>insolente</w>.",
                                "zh": "别把这个<w>刺头</w>的话放在心上。"
                            }
                        },
                        {
                            "text": "Cette petite <w>insolente</w> a claqué la porte au nez de ses parents.",
                            "target_lang_translations": {
                                "en": "This little <w>cheeky monkey</w> slammed the door in her parents' faces.",
                                "ru": "Эта маленькая <w>нахалка</w> хлопнула дверью перед носом у родителей.",
                                "de": "Diese kleine <w>Rotzgöre</w> hat ihren Eltern die Tür vor der Nase zugeknallt.",
                                "es": "Esta pequeña <w>descarada</w> dio un portazo en las narices de sus padres.",
                                "zh": "这个小<w>刺头</w>竟当着父母的面狠狠摔上了门。"
                            }
                        }
