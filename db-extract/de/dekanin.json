                                        "entry_id": "d4577cd5-ee01-354a-a2ef-f2100984fd2c",
                                        "glosses": [
                                            "A senior official in a college or university, who may be in charge of a division or faculty (for example, the dean of science) or have some other advisory or disciplinary function (for example, the dean of students)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e366e0f3-cf04-4d5d-8f01-a1cbf85cfb18",
                                                "sense_id": "312d3599-c70b-38b5-a743-fd0d03adf723",
                                                "text": "Lucretius versus the Lake Poets ' Nature I loved ; and next to Nature , Art . '\nDean , adult education may seem silly .\nWhat of it though ? I got some willy - nilly\nThe other evening at your college deanery .\nAnd grateful for it ( Let's not be facetious!)[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aa3016d-548c-3d1b-a4cd-b8d35c57260b",
                                        "entry_id": "d4577cd5-ee01-354a-a2ef-f2100984fd2c",
                                        "glosses": [
                                            "A dignitary or presiding officer in certain church bodies, especially an ecclesiastical dignitary, subordinate to a bishop, in charge of a chapter of canons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59c1b114-c8c2-3a3b-b800-0b8a82fbf309",
                                        "entry_id": "d4577cd5-ee01-354a-a2ef-f2100984fd2c",
                                        "glosses": [
                                            "The senior member of some group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
