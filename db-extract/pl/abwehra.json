                        "entry_id": "3d857d47-4895-337c-8592-dbfa82dcbc51",
                        "glosses": [
                            "niemiecki wywiad i kontrwywiad działający przed i w trakcie drugiej wojny światowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "373580ba-5cca-4feb-85ee-761c138213ad",
                                "sense_id": "c150a5fa-a78c-3c88-ab6e-9c307b1e4890",
                                "text": "Hans Kloss, w którego postać wcielił się Stanisław Mikulski, był podwójnym agentem, polskiego wywiadu i Abwehry."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
