                    }
                ],
                "senses": [
                    {
                        "sense_id": "5740cc07-a692-32ec-84ae-564184afe9ae",
                        "entry_id": "8916d67f-674b-3b3e-8b42-0fb321b81cde",
                        "glosses": [
                            "imię żeńskie Anna"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "e0a9a384-3c97-4211-a0c3-824f3ce73ace",
                                "sense_id": "5740cc07-a692-32ec-84ae-564184afe9ae",
                                "text": "Ania ma kota. To kot Ani."
                            },
                            {
                                "example_id": "d13e939e-6185-4fb3-9aad-e2f0a1f6fe80",
                                "sense_id": "5740cc07-a692-32ec-84ae-564184afe9ae",
                                "text": "Kupiłem Ani bukiecik fiołków."
                            },
                            {
                                "example_id": "602a1a66-5f04-424f-bf77-5cd03eaa765e",
                                "sense_id": "5740cc07-a692-32ec-84ae-564184afe9ae",
                                "text": "Nie chciałam jednak, Aniu, aby mię uważał za trzpiotkę"
                            },
                            {
                                "example_id": "cc058f13-dad3-496d-ad6b-1669c67c7451",
                                "sense_id": "5740cc07-a692-32ec-84ae-564184afe9ae",
                                "text": "One wszystkie mają na drugie imię Ania."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ead3dc4e-684a-4b8b-9f1e-7f490659ff06",
                        "source_entry_id": "8916d67f-674b-3b3e-8b42-0fb321b81cde",
                        "source_sense_id": "5740cc07-a692-32ec-84ae-564184afe9ae",
                        "target_lang_word": "Annie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Annie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9634ee72-3562-34be-bba2-c8b99b08f77d",
                                        "entry_id": "d074f9a3-7d22-3b25-997d-8a1c17aa3ae1",
                                        "glosses": [
                                            "A diminutive of the female given name Ann. Also, a popular given name in the 19th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46431f42-2513-4710-a628-3f5e6d8e9d52",
                                                "sense_id": "9634ee72-3562-34be-bba2-c8b99b08f77d",
                                                "text": "Maxwelton braes are bonnie / Where early fa's the dew; / An' it's there that Annie Laurie / Gi'ed me her promise true."
                                            },
                                            {
                                                "example_id": "2be86cfa-1e8f-4022-8831-8f7eebf4ff26",
                                                "sense_id": "9634ee72-3562-34be-bba2-c8b99b08f77d",
                                                "text": "I never thought of the most brilliant and elegant women in England quite so charming as she really is, till I heard her call her younger sister \"Annie\". It seemed to remove at once the almost repellent quality which belongs to extreme polish, - gave a genial warmth to her brightness, became her like a smile. - - - If she had called her sister Anna-Maria according to the register, I should have admired, and feared, and shunned her to my dying day."
                                            },
                                            {
                                                "example_id": "875b72df-7926-4782-8f2a-07abd21b07c5",
                                                "sense_id": "9634ee72-3562-34be-bba2-c8b99b08f77d",
                                                "text": "\"I want you to stop calling yourself by that silly name, Annie,\" Mrs. Marshall-Gill said clearly. \"It's inappropriate and ridiculous and I don't like it. It may even be dishonest, I don't know. At any rate, you're to stop it at once. I looked up your registration, and your name is Annie, a solid, Christian name. You'll do well to abide by it.\"\n\"I don't like Annie,\" Jewel said.\n\"It suits your face,\" Mrs. Marshall-Gill said. A titter ran around the listening room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ece43f01-0b8d-38d8-978e-3940efb89031",
                                        "entry_id": "d074f9a3-7d22-3b25-997d-8a1c17aa3ae1",
                                        "glosses": [
                                            "A female orphan."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
