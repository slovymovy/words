{
    "word_family": [
        "six",
        "sixteen",
        "sixty",
        "sixthly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                    "sense_definition": "The ordinal form of the number six.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "order_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is the <w>sixth</w> time I have called you today.",
                            "target_lang_translations": {
                                "ru": "Я звоню тебе сегодня уже в <w>шестой</w> раз.",
                                "zh": "这是我今天第<w>六</w>次给你打电话了。"
                            }
                        },
                        {
                            "text": "She finished in <w>sixth</w> place in the race.",
                            "target_lang_translations": {
                                "ru": "Она заняла <w>шестое</w> место в гонке.",
                                "zh": "她在比赛中获得了第<w>六</w>名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "6th"
                    ],
                    "common_phrases": [
                        "sixth sense",
                        "sixth grade",
                        "sixth floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порядковое числительное, соответствующее числу шесть.",
                        "zh": "表示顺序的第六个。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шестой",
                                "target_lang_sense_clarification": "порядковое числительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第六",
                                "target_lang_sense_clarification": "序数词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a681994-e98a-3374-837a-53f61b2d3d65",
                    "sense_definition": "The person or thing in the sixth position.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "order_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was the <w>sixth</w> to arrive at the party.",
                            "target_lang_translations": {
                                "ru": "Он пришёл на вечеринку <w>шестым</w>.",
                                "zh": "他是第<w>六个</w>到达聚会的人。"
                            }
                        },
                        {
                            "text": "I am the <w>sixth</w> in line for tickets.",
                            "target_lang_translations": {
                                "ru": "Я <w>шестой</w> в очереди за билетами.",
                                "zh": "我是排队买票的第<w>六个</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the sixth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, находящийся на шестой позиции.",
                        "zh": "处于第六位的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шестой",
                                "target_lang_sense_clarification": "тот, кто на шестом месте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第六个",
                                "target_lang_sense_clarification": "指代处于第六位置的人或物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21b4e259-e79a-3ebe-876f-e23be5810730",
                    "sense_definition": "One of six equal parts of a whole.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fraction_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ate a <w>sixth</w> of the pizza for lunch.",
