                                    {
                                        "sense_id": "4cffa8d8-6cb3-3eea-863b-d3a754542a0c",
                                        "entry_id": "2547a9b5-d6c2-34bd-968c-ca469dfd2c83",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45f95bd0-2609-45c5-82ab-14dd0093ac6d",
                                                "sense_id": "4cffa8d8-6cb3-3eea-863b-d3a754542a0c",
                                                "text": "Frau Bernd ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "7c65e6aa-ae36-491a-9508-6ea2dfc5075b",
                                                "sense_id": "4cffa8d8-6cb3-3eea-863b-d3a754542a0c",
                                                "text": "Herr Bernd wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "bd07b873-0c8b-4672-821d-cc3d382f1e3a",
                                                "sense_id": "4cffa8d8-6cb3-3eea-863b-d3a754542a0c",
                                                "text": "Die Bernds fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "27dcfa8d-8d2e-4a9a-a87d-873ca693c5ce",
                                                "sense_id": "4cffa8d8-6cb3-3eea-863b-d3a754542a0c",
                                                "text": "Der Bernd trägt nie die Schals, die die Bernd ihm strickt."
                                            },
                                            {
                                                "example_id": "330d136e-6b37-464e-8445-71c0aafa94d1",
                                                "sense_id": "4cffa8d8-6cb3-3eea-863b-d3a754542a0c",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bernd kommt, geht der Herr Bernd.“"
                                            },
                                            {
                                                "example_id": "6da5e789-e157-4cfd-b87b-d8aca03aa407",
                                                "sense_id": "4cffa8d8-6cb3-3eea-863b-d3a754542a0c",
                                                "text": "Bernd kommt und geht."
                                            },
                                            {
                                                "example_id": "0202196b-6b53-4b13-89e2-ff28bb8ff83b",
                                                "sense_id": "4cffa8d8-6cb3-3eea-863b-d3a754542a0c",
                                                "text": "Bernds kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
