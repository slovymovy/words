                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abbreviations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The AI model used a <w>CoT</w> prompting technique to solve the math problem.",
                            "target_lang_translations": {
                                "pl": "Model AI użył techniki promptowania <w>CoT</w> (łańcucha myśli), aby rozwiązać zadanie matematyczne.",
