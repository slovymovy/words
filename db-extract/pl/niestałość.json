                    },
                    {
                        "translation_id": "85962810-03b6-4507-b6a6-1bff0613f215",
                        "source_entry_id": "e01d396a-d629-3b33-a397-1a17610e2218",
                        "source_sense_id": "cc74134c-12cc-3f23-84c4-7d8652c129e5",
                        "target_lang_word": "inconstancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconstancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cdb7e2f-a5b9-30d7-abd0-03a452ac8246",
                                        "entry_id": "4a5b3c7d-0776-3c1f-b989-33b28cd9c306",
                                        "glosses": [
                                            "Lack of constancy; lack of consistency in thought, emotion or action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce0b96f9-e8e8-4d32-aac1-8a06c7ce1e20",
                                                "sense_id": "0cdb7e2f-a5b9-30d7-abd0-03a452ac8246",
                                                "text": "Although she loved him for many years, his inconstancy eventually drove her to another."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14449448-13f0-4035-8008-4945234eb5fa",
                        "source_entry_id": "e01d396a-d629-3b33-a397-1a17610e2218",
                        "source_sense_id": "cc74134c-12cc-3f23-84c4-7d8652c129e5",
                        "target_lang_word": "instabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8277ecdb-b363-3789-a4b8-06bb6379cb60",
                                        "entry_id": "10fce1b5-9fbe-3daa-9cd5-50fe47634baa",
                                        "glosses": [
                                            "Défaut de stabilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d816ff4d-7752-4ed9-acc2-e23758a568c6",
                                                "sense_id": "8277ecdb-b363-3789-a4b8-06bb6379cb60",
                                                "text": "Déjà difficile à percer pour des raisons techniques – instabilité géologique et séismicité connue des autorités –, le tunnel de Bolu inquiète les usagers."
                                            },
                                            {
                                                "example_id": "0aa1d78f-51f8-4a56-8810-d09f826a04a9",
                                                "sense_id": "8277ecdb-b363-3789-a4b8-06bb6379cb60",
                                                "text": "Vingt secondes avaient suffi pour que le cisailleur hisse sur son épaule la masse inerte des cent quinze chevaux et s’active d’une démarche de Frankenstein accentuée par l’instabilité du ponton vers le quai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28255e96-3379-3d8f-a36e-08d80905f965",
                                        "entry_id": "10fce1b5-9fbe-3daa-9cd5-50fe47634baa",
                                        "glosses": [
                                            "Caractère changeant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af4d11d6-0f86-4084-934c-d424bd2f0f49",
                                                "sense_id": "28255e96-3379-3d8f-a36e-08d80905f965",
                                                "text": "« C’est l’exécutif qui crée le désordre et l’instabilité » rétorque-t-elle, en pointant la politique « ultralibérale et autoritaire » d’Emmanuel Macron, « compatible avec une institutionnalisation de l’extrême droite »."
                                            },
                                            {
                                                "example_id": "3813d5f4-36a2-412d-a1e3-9d1ee03bcb77",
                                                "sense_id": "28255e96-3379-3d8f-a36e-08d80905f965",
                                                "text": "Les instabilités psycho-émotionnelles ainsi que les réactions violentes diminuent fortement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f74d70-bd9d-3f3b-8312-7e7bbb9f02ea",
                                        "entry_id": "10fce1b5-9fbe-3daa-9cd5-50fe47634baa",
                                        "glosses": [
                                            "Incapacité de certains sujets à se fixer dans les mêmes idées, les mêmes sentiments."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cf84ce3-c0e6-41ef-90dc-72a98314f51e",
                        "source_entry_id": "e01d396a-d629-3b33-a397-1a17610e2218",
                        "source_sense_id": "cc74134c-12cc-3f23-84c4-7d8652c129e5",
                        "target_lang_word": "inconstance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconstance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3205956c-cafe-331f-8421-269f44d75f7f",
                                        "entry_id": "af4aa8fc-0c11-3c7b-ae17-1e7f2e654fbc",
                                        "glosses": [
                                            "Facilité à changer d’opinion, de résolution, de passion, de conduite, de sentiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd613a2f-9d35-44cb-9e33-d5d8d74e22f7",
                                                "sense_id": "3205956c-cafe-331f-8421-269f44d75f7f",
                                                "text": "Les voilà qui m'entourent ; les voilà qui me contemplent ; les voilà qui me disent en leurs provocations : « Jeune dieu d'Amour, enseigne aux nymphes bocagères la mollesse et le désir, l’inconstance et la passion , le sourire et le sérieux. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                        "entry_id": "af4aa8fc-0c11-3c7b-ae17-1e7f2e654fbc",
                                        "glosses": [
                                            "Faculté, capacité à changer, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5b7961-12be-422f-92dc-af08e9e07fe4",
                                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                                "text": "L’inconstance du temps, des saisons."
                                            },
                                            {
                                                "example_id": "44ca7ce4-bed4-4b60-a856-40a10de8cde2",
                                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                                "text": "L’inconstance des vents, de la mer."
                                            },
                                            {
                                                "example_id": "516bc9a3-2e33-4182-9e00-01cd0dffee4a",
                                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                                "text": "L’inconstance de la fortune."
                                            },
                                            {
                                                "example_id": "698b92af-883c-444b-bd48-474917ad074d",
                                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                                "text": "L’inconstance des choses humaines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
