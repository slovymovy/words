                "senses": [
                    {
                        "sense_id": "37cc6331-e761-3b3f-8761-4715d2683c5c",
                        "entry_id": "f951639e-b099-352d-8023-c5cd66e14941",
                        "glosses": [
                            "Féminin singulier de musicien."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "44d33dde-f16c-4c82-90c9-771789483855",
                                "sense_id": "37cc6331-e761-3b3f-8761-4715d2683c5c",
                                "text": "On peut dire que, par un beau matin, notre Nation s’est avisée de vouloir figurer parmi les Nations Musiciennes."
                            },
                            {
                                "example_id": "7e4c14bb-7181-491a-87bb-8f7d5856e386",
                                "sense_id": "37cc6331-e761-3b3f-8761-4715d2683c5c",
                                "text": "Elles avaient une admirable intelligence et l’âme toute musicienne."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e64851e8-be6b-3dd6-b46d-ca16ef74ba0f",
