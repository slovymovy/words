{
    "word_family": [
        "tegemoetkoming"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d874563d-5b9d-30a1-a511-4ee8cbf4ff4a",
                    "sense_definition": "iemand een concessie doen of aan iemands wensen of behoeften voldoen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concessie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directie besloot om aan de eisen van de stakers <w>tegemoet</w> te <w>komen</w>.",
                            "target_lang_translations": {
                                "en": "The management decided to <w>meet</w> the demands of the strikers."
                            }
                        },
                        {
                            "text": "We hopen met deze nieuwe regeling aan uw wensen <w>tegemoet</w> te <w>komen</w>.",
                            "target_lang_translations": {
                                "en": "We hope to <w>accommodate</w> your wishes with this new regulation."
                            }
                        }
                    ],
                    "synonyms": [
                        "compenseren",
                        "inwilligen",
                        "voldoen"
                    ],
                    "antonyms": [
                        "dwarsbomen",
                        "weigeren"
                    ],
                    "common_phrases": [
                        "aan wensen tegemoetkomen",
                        "aan eisen tegemoetkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a concession to someone or to meet someone's wishes, needs, or demands."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "meet",
                                "target_lang_sense_clarification": "wishes, needs, or demands"
                            },
                            {
                                "target_lang_word": "accommodate",
                                "target_lang_sense_clarification": "someone's wishes or needs"
                            },
                            {
                                "target_lang_word": "concede to",
                                "target_lang_sense_clarification": "make a concession to someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "011ac3fa-e895-3a53-a2ba-cc6a8f5243e4",
                    "sense_definition": "fysiek nader tot iemand of iets komen door in diens richting te lopen of te bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ik het station verliet, zag ik mijn vriend al snel <w>tegemoetkomen</w>.",
                            "target_lang_translations": {
                                "en": "When I left the station, I soon saw my friend <w>coming towards</w> me."
                            }
                        },
                        {
                            "text": "De fietser <w>kwam</w> mij met hoge snelheid op het fietspad <w>tegemoet</w>.",
                            "target_lang_translations": {
                                "en": "The cyclist <w>came towards</w> me at high speed on the bike path."
                            }
                        }
                    ],
                    "synonyms": [
                        "naderen",
                        "tegemoetlopen"
                    ],
                    "antonyms": [
                        "weglopen"
                    ],
                    "common_phrases": [
                        "iemand tegemoetkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically approach someone or move towards them from the opposite direction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come towards",
                                "target_lang_sense_clarification": "physically approach someone"
                            },
                            {
                                "target_lang_word": "approach",
                                "target_lang_sense_clarification": "move towards someone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}