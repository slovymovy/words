                        "entry_id": "3161dd1d-92b7-3265-bcf0-090a6264175b",
                        "glosses": [
                            "The state or condition of being usable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5678e9de-a8c2-372b-9f5a-6b9d850714eb",
                        "entry_id": "3161dd1d-92b7-3265-bcf0-090a6264175b",
                        "glosses": [
                            "The degree to which an object, device, software application, etc. is easy to use with no specific training."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "89f86c16-0a76-4c81-97ae-d335be9ea43a",
                                "sense_id": "5678e9de-a8c2-372b-9f5a-6b9d850714eb",
                                "text": "The template was repiloted by the same four surgeons and recovery ward nurses to see if opinions and the usability of the template had improved, with the eventual aim of computerising the template."
                            },
                            {
                                "example_id": "0a75aaf0-cec3-4338-b22e-1aa4f1d986b3",
                                "sense_id": "5678e9de-a8c2-372b-9f5a-6b9d850714eb",
                                "text": "The ability to learn how to use a system (learnability) is also a major subcharacteristic of usability."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c95a7e1-35d7-44c4-91e8-9456082c866d",
                        "source_entry_id": "3161dd1d-92b7-3265-bcf0-090a6264175b",
