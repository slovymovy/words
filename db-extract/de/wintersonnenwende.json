                                "target_senses": [
                                    {
                                        "sense_id": "ac46c56f-d615-3c28-89a3-10b6ec122e8d",
                                        "entry_id": "024dfba6-8344-37aa-b011-7ce9ce8c947a",
                                        "glosses": [
                                            "二十四節氣之一，在每年公曆12月21日或22日、23日，該日太陽直射南回歸線"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcd12dbe-3638-4dcb-b55b-83457fd6fffe",
                                                "sense_id": "ac46c56f-d615-3c28-89a3-10b6ec122e8d",
                                                "text": "冬至快樂"
                                            },
                                            {
                                                "example_id": "460f2647-205e-4e68-8c19-a28af5f7b16c",
                                                "sense_id": "ac46c56f-d615-3c28-89a3-10b6ec122e8d",
                                                "text": "冬至快乐"
                                            },
                                            {
                                                "example_id": "505c5763-16d2-4d6d-87f4-cc1a98b6c0d5",
                                                "sense_id": "ac46c56f-d615-3c28-89a3-10b6ec122e8d",
                                                "text": "冬至到而葭灰飛，立秋至而梧葉落",
                                                "translation": "冬至一到，燒蘆葦的灰燼就到處飄飛；立秋一到，梧桐的樹葉就掉落滿地。"
                                            },
                                            {
                                                "example_id": "234a6c6f-26a4-42a9-83f7-33ec99b964a3",
                                                "sense_id": "ac46c56f-d615-3c28-89a3-10b6ec122e8d",
                                                "text": "冬至到而葭灰飞，立秋至而梧叶落",
                                                "translation": "冬至一到，燒蘆葦的灰燼就到處飄飛；立秋一到，梧桐的樹葉就掉落滿地。"
                                            }
                                        ]
                                    }
                                ]
                            }
