                                "sense_id": "2ec072ea-7300-3e35-8664-2129ca01e288",
                                "text": "Ik kneep."
                            },
                            {
                                "example_id": "7de6f06b-6dda-4274-a50d-975b2c084433",
                                "sense_id": "2ec072ea-7300-3e35-8664-2129ca01e288",
                                "text": "Jij kneep."
                            },
                            {
                                "example_id": "ca99c2aa-7aa3-46e6-b1e3-ac60d1c85888",
                                "sense_id": "2ec072ea-7300-3e35-8664-2129ca01e288",
                                "text": "Hij, zij, het kneep."
                            },
                            {
                                "example_id": "d76d9648-eaa6-4774-9450-4233eac4497a",
                                "sense_id": "2ec072ea-7300-3e35-8664-2129ca01e288",
                                "text": "Ze pakte mijn hand en kneep er even in."
                            },
                            {
                                "example_id": "6051296a-b816-411d-a0cd-71ff5a68393b",
                                "sense_id": "2ec072ea-7300-3e35-8664-2129ca01e288",
                                "text": "En waar het nu bij uw man om gaat,' zei Omer, tervijl hij bemoedigend in mijn vingers kneep en naar me glimlachte, 'is dat we samen gaan onderzoeken welke storm hem omverduwde."
                            }
                        ]
                    }
