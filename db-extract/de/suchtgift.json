                ],
                "senses": [
                    {
                        "sense_id": "1ae840b5-12d1-34d0-b97f-1e6bb7a6234e",
                        "entry_id": "50705c7a-39d5-3fcc-b54b-42a0c4873828",
                        "glosses": [
                            "schädliche zur Abhängigkeit führende Substanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ea77a38-24ef-4201-85db-6402e1766c7c",
                                "sense_id": "1ae840b5-12d1-34d0-b97f-1e6bb7a6234e",
                                "text": "„Bei einem sehr starken Konsum von Suchtgift kann dieser Wert aber auch nach einer längerer Abstinenz noch im Haar eingelagert sein (bei Kokain sogar bis zu zwölf Monaten).“"
                            },
                            {
                                "example_id": "b164b1f3-25ef-458e-8812-8efa1772caad",
                                "sense_id": "1ae840b5-12d1-34d0-b97f-1e6bb7a6234e",
                                "text": "„Als Suchtgifte unterliegen dem Suchtmittelgesetz und dieser Verordnung sämtliche in den Anhängen I bis V angeführten Stoffe und Zubereitungen.“"
                            },
                            {
                                "example_id": "753df56c-3665-4b26-932e-351a987c9bd1",
                                "sense_id": "1ae840b5-12d1-34d0-b97f-1e6bb7a6234e",
                                "text": "„Schon die Wahl der Begriffe, mit denen diese Substanzen bezeichnet werden – Droge, Betäubungsmittel, Rauschgift, Genussmittel, Suchtgift usw. – kann eine Bewertung implizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
