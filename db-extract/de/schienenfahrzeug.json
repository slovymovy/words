                    {
                        "sense_id": "02f9ea95-33ca-3337-9fca-9b8ce7a129ed",
                        "entry_id": "185dda54-d57b-3eb0-bbf6-ee578633a888",
                        "glosses": [
                            "Fahrzeug, das auf einer oder mehreren Schienen fährt; schienengebundenes Fahrzeug"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "88388e80-dee9-4df7-b4c7-17083326eefe",
                                "sense_id": "02f9ea95-33ca-3337-9fca-9b8ce7a129ed",
                                "text": "„Das 1942 von Ernst Stadler als Konstruktionsbüro in Zürich gegründete Unternehmen hat lange in kleinem Rahmen Schienenfahrzeuge konstruiert, vor allem Einzelanfertigungen wie Industrielokomotiven für Fabriken, Gruben oder Kraftwerkstollen.“"
                            },
                            {
                                "example_id": "d5cd6d72-47de-400a-a1a0-31c7f476c252",
                                "sense_id": "02f9ea95-33ca-3337-9fca-9b8ce7a129ed",
                                "text": "„Thyssen-Krupp baut in Australien das größte Schienenfahrzeug der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
