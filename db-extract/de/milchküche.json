                "senses": [
                    {
                        "sense_id": "25401692-dbf4-3a59-a8f9-b6101b59bba9",
                        "entry_id": "95d6a3ab-28ab-32c2-8a79-cf26e13cffde",
                        "glosses": [
                            "Versorgungseinrichtung für Neugeborene im Krankenhaus zur Aufbereitung von Muttermilch, Zubereitung von Fertigmilch und Herstellung von Diätnahrung."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce8e5c0d-7c6b-424f-b050-e2c3ef23555e",
                                "sense_id": "25401692-dbf4-3a59-a8f9-b6101b59bba9",
                                "text": "In Kliniken sollten nach Auffassung des BfR für die Herstellung von Säuglingsnahrung möglichst Milchküchen eingerichtet werden, in denen umfassende hygienische Anforderungen berücksichtigt werden."
                            },
                            {
                                "example_id": "bb5c16c2-3443-4334-8d5a-5c816639b5fb",
                                "sense_id": "25401692-dbf4-3a59-a8f9-b6101b59bba9",
                                "text": "Die Milchküche dient der hygienisch einwandfreien Zubereitung der Säuglingsnahrung. Der Zutritt zur Milchküche ist ausschließlich dem Personal vorbehalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "def8a0e5-eeae-3e12-b2ce-3196737db303",
                        "entry_id": "95d6a3ab-28ab-32c2-8a79-cf26e13cffde",
                        "glosses": [
                            "Küche, in der ausschließlich Milchgerichte zubereitet werden"
                        ],
                        "tags": [
                            "Judentum"
                        ],
                        "examples": [
                            {
                                "example_id": "78804267-9c4e-42ea-848a-15cfe9a66c0b",
                                "sense_id": "def8a0e5-eeae-3e12-b2ce-3196737db303",
                                "text": "Orthodoxe Juden haben zwei Küchen, eine Fleisch- und eine Milchküche."
                            }
                        ],
                        "sense_index_json": "\"2\""
