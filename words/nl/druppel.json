                            },
                            {
                                "target_lang_word": "key fob",
                                "target_lang_sense_clarification": "a small security hardware device with built-in authentication"
                            },
                            {
                                "target_lang_word": "tag",
                                "target_lang_sense_clarification": "an RFID device used for identification or access"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "магнитный ключ",
                                "target_lang_sense_clarification": "электронный ключ для доступа"
                            },
                            {
                                "target_lang_word": "брелок",
                                "target_lang_sense_clarification": "устройство для бесконтактного доступа"
                            },
                            {
                                "target_lang_word": "чип",
                                "target_lang_sense_clarification": "разговорное название электронного ключа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80413430-c989-3918-8eb8-45024e6b2e51",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>druppelen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>druppel</w> voorzichtig wat medicijn in het glas water.",
                            "target_lang_translations": {
                                "en": "I carefully <w>drop</w> some medicine into the glass of water.",
                                "ru": "Я осторожно <w>капаю</w> немного лекарства в стакан воды."
                            }
                        },
                        {
                            "text": "Elke ochtend <w>druppel</w> ik de planten met een beetje vloeibare voeding.",
                            "target_lang_translations": {
                                "en": "Every morning I <w>drip</w> a little liquid food onto the plants.",
                                "ru": "Каждое утро я <w>поливаю</w> растения по капле небольшим количеством жидкой подкормки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'to drip' or 'to drop'",
                        "ru": "форма первого лица единственного числа настоящего времени глагола 'druppelen' (капать)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drip",
                                "target_lang_sense_clarification": "to let liquid fall in small amounts"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "to administer liquid in drops"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "капаю",
                                "target_lang_sense_clarification": "добавлять жидкость по каплям"
