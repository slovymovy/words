        "fr-extract.jsonl": [
            {
                "entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                "word": "effronterie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f5d935be-8347-42aa-990e-f6f06f1425c5",
                        "entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                        "tags": [
                            "plural"
                        ],
                        "form": "effronteries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "746bda6a-f9bf-3195-83f1-5ec246315e13",
                        "entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                        "glosses": [
                            "Caractère, attitude de celui qui est effronté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e68b0ec-4f9d-4e50-8cfe-a8617cc77068",
                                "sense_id": "746bda6a-f9bf-3195-83f1-5ec246315e13",
                                "text": "… nous entendions la respiration des chèvres. Il y en eut même quelques-unes qui pénétrèrent dans notre logis et qui s’y installèrent malgré nous, avec l’effronterie drôle propre à leur espèce."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                        "entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                        "glosses": [
                            "Manière d’agir, de parler de celui qui est effronté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d937d83-3eef-4a81-bdbe-411f80e49838",
                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                "text": "M. Clausel prit la parole, et il eut l’effronterie de déclarer qu’aussitôt que la Chambre serait prorogée, il imprimerait un Mémoire à ce sujet."
                            },
                            {
                                "example_id": "fe79b30b-cdfb-4867-8a8f-a810a730e67f",
                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                "text": "(…) une vieille dame en chapeau jaune, à mine basse de pourvoyeuse, et deux mineures, deux fillettes de treize ou quatorze ans, déhanchées, d’une effronterie gênante."
                            },
                            {
                                "example_id": "6ef282ee-21f9-4b8a-911a-6aac34ed815d",
                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                "text": "Culotté le corvidé ! qui n'hésitait pas à tirer les plumes de la queue du convive pour le forcer à s'éloigner. Vite lassé par tant d’effronterie, l'aigle noir s'est brutalement retourné, bec grand ouvert, ailes déployées, au comble de l'irritation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d92f5bc-e5a8-403a-909c-7445ac582302",
                        "source_entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                        "target_lang_word": "effrontery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effrontery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6b82e40-b39c-372b-9d52-cd395564b080",
                                        "entry_id": "b5e2cad2-f376-3682-a344-d5679cf825f6",
                                        "glosses": [
                                            "Insolent and shameless audacity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e019c65-511a-463e-9e39-ac6fc8a7a202",
                                                "sense_id": "d6b82e40-b39c-372b-9d52-cd395564b080",
                                                "text": "We even had the effrontery to suggest that he should leave the country."
                                            },
                                            {
                                                "example_id": "c6ddab72-e348-464b-920d-39c348e70a9d",
                                                "sense_id": "d6b82e40-b39c-372b-9d52-cd395564b080",
                                                "text": "Let not the Englishman in Scotland believe that the undoffed hat, the curt reply, the apparent assumption of equality, all spring from deliberate effrontery, and are wholly beyond the reach of southern influence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8da981c8-bf7e-3535-b02d-dd06d86d6db3",
                                        "entry_id": "b5e2cad2-f376-3682-a344-d5679cf825f6",
                                        "glosses": [
                                            "An act of insolent and shameless audacity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aecc440d-8d0f-47bf-9dc1-acdeb0f1c12c",
                                                "sense_id": "8da981c8-bf7e-3535-b02d-dd06d86d6db3",
                                                "text": "Any refusal to salute the president shall be counted as an effrontery."
                                            },
                                            {
                                                "example_id": "071359e0-b124-4214-a470-669626ec2676",
                                                "sense_id": "8da981c8-bf7e-3535-b02d-dd06d86d6db3",
                                                "text": "All was going as planned until the bag hit a snag and failed to surround the entire nest. This effrontery was too much. The wasps exploded off the nest at me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "616fd117-aacc-4fc7-ad4a-9d0d778d05d2",
                        "source_entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
