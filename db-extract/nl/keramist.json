                        ],
                        "examples": [
                            {
                                "example_id": "79d4cb83-5e1e-4d50-93a9-049ba39d4d16",
                                "sense_id": "9f77c437-ff2c-3d2f-a7f7-e5ef47482d7e",
                                "text": "De Hengelose keramist Wim Bouwman (59) heeft vanaf vandaag een expositie rond de thema's liefde, erotiek en dood in de bibliotheek in winkelcentrum Hogewal."
                            },
                            {
                                "example_id": "99bd9790-2190-4c11-9a8e-4d0fcf65060b",
                                "sense_id": "9f77c437-ff2c-3d2f-a7f7-e5ef47482d7e",
                                "text": "Op basis van de 1.200 ingeleverde formulieren zijn zes schilders, fotograaf, keramist, glas-in-lood kunstenaar en twee textielkunstenaars uitgenodigd om hun talenten te laten zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cac8198c-e4f2-486d-8126-11f1e7099a06",
                        "source_entry_id": "0fe19009-c91d-35f6-ac99-ce1c8c90ce5b",
                        "source_sense_id": "9f77c437-ff2c-3d2f-a7f7-e5ef47482d7e",
                        "target_lang_word": "ceramist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
