                        "entry_id": "fc275e96-bf1e-3337-bfa0-910f2c078fe7",
                        "glosses": [
                            "Open land that has an acidic peaty soil and is mostly covered with heather or bracken."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a1904495-9dff-49b3-b5fd-2ff93035d2b8",
                                "sense_id": "97f0e605-fd82-31f4-b689-51ab5f78e9a1",
                                "text": "The completely-industrialised outskirts of Newcastle gradually give place to rural surroundings, and the Tyne becomes a moorland river with a boulder-strewn bed."
                            },
                            {
                                "example_id": "eb113184-1363-4a27-bdea-ac36b3158951",
                                "sense_id": "97f0e605-fd82-31f4-b689-51ab5f78e9a1",
                                "text": "Troutbeck station, 10 miles from Keswick, in the heart of wild moorland, is the most isolated on the line."
                            }
                        ]
                    }
                ],
                "translations": [
