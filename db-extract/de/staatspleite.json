                        "sense_id": "8e0ed359-5858-3dfa-b07a-a8769c7e67e7",
                        "entry_id": "f8ef78a5-25f6-321a-a2c3-4309a0b1ad37",
                        "glosses": [
                            "Unfähigkeit eines Staates, seinen Zahlungsverpflichtungen nachzukommen"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "d26e5ecd-8a60-4480-bb71-07c5719509fe",
                                "sense_id": "8e0ed359-5858-3dfa-b07a-a8769c7e67e7",
                                "text": "„Russland wird im Jahre 2015 nicht bankrottgehen. Aber wenn der Ölpreis auf dem jetzigen geringen Niveau verharrt, dann ist eine Staatspleite in ein paar Jahren wahrscheinlich.“"
                            },
                            {
                                "example_id": "235f14cc-660d-429b-91d0-e4a89fc707b7",
                                "sense_id": "8e0ed359-5858-3dfa-b07a-a8769c7e67e7",
                                "text": "„Nach Einschätzung des Präsidenten des deutschen Ifo-Instituts, Hans-Werner Sinn, kann Griechenland eine neue Staatspleite nur abwenden, wenn es aus der Eurozone ausscheidet.“"
                            }
                        ],
