        "pl-extract.jsonl": [
            {
                "entry_id": "06b8f606-7c69-321b-8ed6-63c1e2ca5a89",
                "word": "powolnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "91a141c0-14f4-3220-8f5a-4468c5324d2e",
                        "entry_id": "06b8f606-7c69-321b-8ed6-63c1e2ca5a89",
                        "glosses": [
                            "w sposób powolny, wolno"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab0442f9-bed8-44ec-86b4-036e67bfef18",
                                "sense_id": "91a141c0-14f4-3220-8f5a-4468c5324d2e",
                                "text": "Jaskra jest schorzeniem podstępnym, przebiegającym powolnie, ale w sposób absolutnie nieodwracalny"
                            },
                            {
                                "example_id": "9f471433-ac81-4ddc-8992-80a519be2e97",
                                "sense_id": "91a141c0-14f4-3220-8f5a-4468c5324d2e",
                                "text": "- Dziękuję pani za ratunek - poszukałem jej dłoni, lecz ona powolnie, ale stanowczo cofnęła rękę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "133d07c1-9f15-40fe-8677-02685d7b789a",
                        "source_entry_id": "06b8f606-7c69-321b-8ed6-63c1e2ca5a89",
                        "source_sense_id": "91a141c0-14f4-3220-8f5a-4468c5324d2e",
                        "target_lang_word": "languidly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languidly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                        "entry_id": "63dca619-e523-3d40-9d25-1ba3bbec3228",
                                        "glosses": [
                                            "In a languid manner, without force or effort, in a manner requiring little energy or exertion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cb5828e-1a37-4fad-bd0b-c905da4aff5a",
                                                "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                                "text": "He languidly waved his limp wrist, glad to see us, but not wanting to expend the energy to let us know that."
                                            },
                                            {
                                                "example_id": "c656122d-86b5-4e15-a071-128cf96ac1fe",
                                                "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                                "text": "Under the strain of this continually impending doom and by the sleeplessness to which I now condemned myself, ay, even beyond what I had thought possible to man, I became, in my own person, a creature eaten up and emptied by fever, languidly weak both in body and mind, and solely occupied by one thought: the horror of my other self."
                                            },
                                            {
                                                "example_id": "a91621e0-5e48-4969-b799-32eed81591fc",
                                                "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                                "text": "“It is your best work, Basil, the best thing you have ever done,” said Lord Henry, languidly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f63884d7-38ec-4eb4-9337-1c616a86bac0",
                        "source_entry_id": "06b8f606-7c69-321b-8ed6-63c1e2ca5a89",
                        "source_sense_id": "91a141c0-14f4-3220-8f5a-4468c5324d2e",
                        "target_lang_word": "ponderously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponderously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f7a6670-24cb-3916-b51d-b69b42427990",
                                        "entry_id": "b7cfd883-4de9-30ea-8653-1905fbb01c4b",
                                        "glosses": [
                                            "In a ponderous manner; very slowly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "577b0d65-623f-46be-943f-7531539f4548",
                                                "sense_id": "6f7a6670-24cb-3916-b51d-b69b42427990",
                                                "text": "Sir Ernest Heavywether rose ponderously."
                                            },
                                            {
                                                "example_id": "b9d95dce-08b8-4f42-8d69-822f15b7e870",
                                                "sense_id": "6f7a6670-24cb-3916-b51d-b69b42427990",
                                                "text": "Rooney and his team-mates started ponderously, as if sensing the enormity of the occasion, but once Scholes began to link with Ryan Giggs in the middle of the park, the visitors increased the tempo with Sunderland struggling to keep up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35372821-5ba0-3272-ab9b-45c4ed7d87bb",
                                        "entry_id": "b7cfd883-4de9-30ea-8653-1905fbb01c4b",
                                        "glosses": [
                                            "With the appearance of great weight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12fc76f7-83da-4ec9-8514-70c980cc5831",
                                                "sense_id": "35372821-5ba0-3272-ab9b-45c4ed7d87bb",
                                                "text": "A narrow and deserted street in deep shadow, high houses, innumerable windows with Venetian blinds, a dead silence, grass sprouting between the stones, imposing carriage archways right and left, immense double doors standing ponderously ajar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f74d6de0-d8de-4329-b123-846817339ae1",
                        "source_entry_id": "06b8f606-7c69-321b-8ed6-63c1e2ca5a89",
