                        "glosses": [
                            "Of, relating to, or resembling a robot; mechanical, lacking emotion or personality, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a930363-b34c-4c7e-9583-8b80d66c32cc",
                                "sense_id": "b8a000c5-dd0e-3c61-9c37-f3e68d92bf82",
                                "text": "You'd cut your own nose off before you'd let me get the credit for solving robotic telepathy."
                            },
                            {
                                "example_id": "43931dc0-f422-4b88-8a5e-d413c66f752d",
                                "sense_id": "b8a000c5-dd0e-3c61-9c37-f3e68d92bf82",
                                "text": "In Vice President Al Gore's campaign to change his robotic image, nothing may have helped more than the big smooch."
                            },
                            {
                                "example_id": "8a73f2d2-78f1-4386-a54c-872084abb6bd",
                                "sense_id": "b8a000c5-dd0e-3c61-9c37-f3e68d92bf82",
                                "text": "President Donald Trump’s presidential memorandum ordering an investigation of Joe Biden’s cognitive decline and his use of the autopen […] is also nonsensical fan service, amplifying addled MAGA conspiracy theories that contend, with a straight face, that Biden was really a robotic clone."
                            }
                        ]
