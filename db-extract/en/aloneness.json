                "entry_id": "692a31f7-e871-37a7-989d-78b2d15e08fd",
                "word": "aloneness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e63b6e61-a4b3-4c8e-9eca-5f5e586f9f6b",
                        "entry_id": "692a31f7-e871-37a7-989d-78b2d15e08fd",
                        "tags": [
                            "plural"
                        ],
                        "form": "alonenesses"
