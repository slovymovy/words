                "translations": [
                    {
                        "translation_id": "f3e24476-e11d-4ca1-adb8-770b5bc05341",
                        "source_entry_id": "4f5044f1-e2f7-39ae-b256-37bd4905c584",
                        "source_sense_id": "31e566ca-813c-36b6-b18a-a1692b8dfc70",
                        "target_lang_word": "trier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1241af77-5536-3724-b01d-dc9d7e9f5bd4",
                                        "entry_id": "7a4a48c9-82d5-3bbc-963e-656b77ec73ea",
                                        "glosses": [
                                            "Séparer ce que l'on souhaite garder et ce que l'on souhaite jeter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af297e6-122c-4cd4-82f5-cba90d3e6ba4",
                                                "sense_id": "1241af77-5536-3724-b01d-dc9d7e9f5bd4",
                                                "text": "Trier des pois, des lentilles."
                                            },
                                            {
                                                "example_id": "95854a4f-672c-4050-bf9b-140f1e461849",
                                                "sense_id": "1241af77-5536-3724-b01d-dc9d7e9f5bd4",
                                                "text": "Les deux sœurs, au surplus, […] lui jetaient les pois ou les lentilles dans la cendre pour qu’elle eût à rester là encore à les trier une fois de plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff129496-016a-36ff-83c1-b5e4057739f0",
                                        "entry_id": "7a4a48c9-82d5-3bbc-963e-656b77ec73ea",
                                        "glosses": [
                                            "Choisir dans un ensemble, séparer du reste, répartir suivant la qualité, le genre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b4ea0a0-1a84-44a8-b6d2-93862bbc3d6f",
                                                "sense_id": "ff129496-016a-36ff-83c1-b5e4057739f0",
                                                "text": "Trier des raisins."
                                            },
                                            {
                                                "example_id": "3d6cf7ee-1540-41a4-bd81-b9826772949f",
                                                "sense_id": "ff129496-016a-36ff-83c1-b5e4057739f0",
                                                "text": "Trier des chiffons."
                                            },
                                            {
                                                "example_id": "1a4eb3aa-3188-4456-9bc4-cfdc58dcd9ae",
                                                "sense_id": "ff129496-016a-36ff-83c1-b5e4057739f0",
                                                "text": "Les libraires ont trié les meilleurs livres de cette bibliothèque."
                                            },
                                            {
                                                "example_id": "4f0d4545-3e23-4c97-8a8a-6e98b64669ea",
                                                "sense_id": "ff129496-016a-36ff-83c1-b5e4057739f0",
                                                "text": "Les enfants venaient de sortir. Mère-Grand et Marie étaient montées trier du vieux linge."
                                            },
                                            {
                                                "example_id": "a5774fe1-97ed-482f-9396-e28d98628365",
                                                "sense_id": "ff129496-016a-36ff-83c1-b5e4057739f0",
                                                "text": "Parfois elle acceptait de jouer avec les autres, parfois elle restait là, à trier dans sa tête, expliquait-elle, mais elle ne précisait jamais quoi, ou seulement d’un geste vague désignait l’alentour. Lucile triait les cris, les rires, les pleurs, les allées et venues, le bruit et le mouvement perpétuels dans lesquels elle vivait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee5dd40-d299-3261-91a5-24ccec48a108",
                                        "entry_id": "7a4a48c9-82d5-3bbc-963e-656b77ec73ea",
                                        "glosses": [
                                            "(notamment dans le domaine de l’informatique) Classer, ranger selon un ordre déterminé, alphabétique, numérique, par numéro, par date…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0208aa-8eeb-4c37-ae1c-b22a6787bed9",
                                                "sense_id": "aee5dd40-d299-3261-91a5-24ccec48a108",
                                                "text": "J’ai trié mes livres. Maintenant je trouve un livre plus rapidement."
                                            },
                                            {
                                                "example_id": "1b73f4e7-141a-43bd-9568-76a6d5ce593a",
                                                "sense_id": "aee5dd40-d299-3261-91a5-24ccec48a108",
                                                "text": "Tu ne tries pas ton tableau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
