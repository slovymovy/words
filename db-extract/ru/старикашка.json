                "senses": [
                    {
                        "sense_id": "3b3eebc2-8f92-334c-95bc-00e6fbe6efc3",
                        "entry_id": "0a74eb25-60ff-3e82-8277-d1a1dec949eb",
                        "glosses": [
                            "pejorative of стари́к (starík): geezer"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "14d5c7cc-75de-4363-b528-1ec337ffe92a",
                                "sense_id": "3b3eebc2-8f92-334c-95bc-00e6fbe6efc3",
                                "text": "гря́зный старика́шка",
                                "translation": "dirty old man",
                                "english": "dirty old man"
                            },
                            {
                                "example_id": "daa5da8a-75ca-48c6-9b1e-f1bf78f2fc26",
                                "sense_id": "3b3eebc2-8f92-334c-95bc-00e6fbe6efc3",
                                "text": "Чрез полчаса дом был заперт, и помешанный старикашка похаживал один по комнатам, в трепетном ожидании, что вот-вот раздадутся пять условных стуков, изредка заглядывая в темные окна и ничего в них не видя, кроме ночи.",
                                "translation": "Half an hour later the house was locked, and the crazy old man was wandering along through the rooms in excited expectation of hearing every minute the five knocks agreed upon. Now and then he peered out into the darkness, seeing nothing.",
                                "english": "Half an hour later the house was locked, and the crazy old man was wandering along through the rooms in excited expectation of hearing every minute the five knocks agreed upon. Now and then he peered out into the darkness, seeing nothing."
                            }
                        ]
                    }
