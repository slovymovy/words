                "senses": [
                    {
                        "sense_id": "af33913e-19db-3f66-bc2f-0a893f482375",
                        "entry_id": "8bba1197-37ec-35c8-b6cf-a44dc3bd4202",
                        "glosses": [
                            "советск. разг. частный торговец, занимающийся незаконной скупкой и продажей валюты или вещей (обычно у иностранцев)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a2cdd8d-198e-49a1-8cd0-44a41fe2da35",
                                "sense_id": "af33913e-19db-3f66-bc2f-0a893f482375",
                                "text": "У Центрального телеграфа толпились фарцовщики в ожидании иностранцев."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8832f921-7a62-4615-9cca-d97ac33a30f2",
                        "source_entry_id": "8bba1197-37ec-35c8-b6cf-a44dc3bd4202",
                        "source_sense_id": "af33913e-19db-3f66-bc2f-0a893f482375",
                        "target_lang_word": "black marketeer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "black marketeer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8aaf89a-b4de-3daf-bf1c-4d7c43fe1675",
                                        "entry_id": "04e6d355-de27-3165-b8cc-7cb57e791c8d",
                                        "glosses": [
                                            "Someone selling black market goods or trading on the black market."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a22264-27d7-468e-82ef-2f52e079bc60",
                                                "sense_id": "a8aaf89a-b4de-3daf-bf1c-4d7c43fe1675",
                                                "text": "There was a constant come-and-go of prisoners of every description: drug peddlers, thieves, bandits, black marketeers, drunks, prostitutes."
                                            },
                                            {
                                                "example_id": "335730a9-3d20-4d6f-9eef-29f83fa8bdfe",
                                                "sense_id": "a8aaf89a-b4de-3daf-bf1c-4d7c43fe1675",
                                                "text": "He got in on the postwar reconstruction of crime, along lines borrowed from gangland and Communism. He probably set out as a currency black marketeer, working through Switzerland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaae61f9-0c28-4f91-9f64-30f9019a634e",
                        "source_entry_id": "8bba1197-37ec-35c8-b6cf-a44dc3bd4202",
                        "source_sense_id": "af33913e-19db-3f66-bc2f-0a893f482375",
                        "target_lang_word": "marketeer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marketeer",
