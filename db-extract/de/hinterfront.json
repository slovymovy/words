                ],
                "senses": [
                    {
                        "sense_id": "41a15a2a-be93-36b6-bb5d-724b73a3dddd",
                        "entry_id": "9cbdcbc6-640e-322f-b756-ad3edade6cfc",
                        "glosses": [
                            "die Rückseite eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00654dd0-19bc-4f3a-889f-c0f75a5c56ee",
                                "sense_id": "41a15a2a-be93-36b6-bb5d-724b73a3dddd",
                                "text": "„Ihr Haus in der Fleischerstraße grenzt mit der Hinterfront unmittelbar an die Häuser in der Schulgasse.“"
                            },
                            {
                                "example_id": "7e5222f5-501c-4ee9-b410-893522f22c2c",
                                "sense_id": "41a15a2a-be93-36b6-bb5d-724b73a3dddd",
                                "text": "„Währenddessen begannen die in die Rathausstraße abgedrängten Demonstranten an der Hinterfront des Rathauses, die Fenster zu zerschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dfd21a20-09cd-324b-a9b0-9c2d5074af38",
                        "entry_id": "9cbdcbc6-640e-322f-b756-ad3edade6cfc",
                        "glosses": [
                            "der Rücken eines Menschen"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "9df37101-06ba-425a-8aa8-0ff2c855c480",
                                "sense_id": "dfd21a20-09cd-324b-a9b0-9c2d5074af38",
                                "text": "„Er kehrte stillschweigend dem rasselnden Spektakelmacher die Hinterfront zu, schwang die Ponchohälfte, die hinten herabhing, nach vorne.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
