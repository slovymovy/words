                        "form": "dem Mithraismus"
                    },
                    {
                        "form_id": "8a8904ac-05bc-407d-8187-be55c4119583",
                        "entry_id": "770e898a-6cb2-3287-a099-cc35acb5744f",
                        "tags": [
                            "accusative",
