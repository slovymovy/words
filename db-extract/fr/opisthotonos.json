                        "glosses": [
                            "Contraction de muscles entraînant un renversement du corps en arrière comme dans le tétanos ou dans la cowdriose."
                        ],
                        "tags": [
                            "Nosologie",
                            "Muscles"
                        ],
                        "examples": [
                            {
                                "example_id": "a56554a9-9c86-439b-94f3-55652239835d",
                                "sense_id": "74ccabd1-3f62-33ce-982d-a81ac6b162b7",
                                "text": "La seconde sorte de convulsion est dite en grec opisthotonos, qui se fait lorsque tout le corps, col et teste, se retirent en la partie posterieure."
                            },
                            {
                                "example_id": "98b546e2-51a7-4e79-b639-16f5c7824075",
                                "sense_id": "74ccabd1-3f62-33ce-982d-a81ac6b162b7",
                                "text": "Toutefois l’opisthotonos, qui représente l’effort moteur maximum de l’ensemble de la musculature, ainsi que les mouvements cloniques (trépignements, frétillements) restent, la vie durant, la forme réactionnelle d’agitation cérébrale portée à son comble."
                            }
                        ]
                    }
