                                    {
                                        "sense_id": "2381f3a3-0fa8-3ea6-8f5f-ab04a10aefe2",
                                        "entry_id": "7f715fdb-8b67-39b3-b745-3e4b3886d29f",
                                        "glosses": [
                                            "middel om het oorspronkelijke te vervangen"
                                        ],
                                        "tags": [
                                            "minderwaardig"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d041d25a-4523-41f9-a972-73b563142e7e",
                                                "sense_id": "2381f3a3-0fa8-3ea6-8f5f-ab04a10aefe2",
                                                "text": "Dat is als cichorei in oorlogstijd: lekker voor even, maar ersatz bij gebrek aan echte koffie."
                                            },
                                            {
                                                "example_id": "e9dc8209-33e7-4ca7-bb4b-2451fd4567ff",
                                                "sense_id": "2381f3a3-0fa8-3ea6-8f5f-ab04a10aefe2",
                                                "text": "In het dagelijks leven organiseert Gabrielle feesten en evenementen, alles wat ‘verleidt, straalt en net zo hard weer verdwijnt als dat het gekomen is’. Ze verdient haar geld met alles wat ‘een geur van vluchtigheid achterlaat, een ersatz van een andere wereld’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a2eb1a6-84f8-42c1-8b90-03d660c7e583",
                        "source_entry_id": "0728eff2-4dcc-376b-bb30-4e53062a3608",
