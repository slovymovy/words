{
    "word_family": [
        "goofy",
        "goofball"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73721d18-23e7-3c33-8c13-41b5f82bf354",
                    "sense_definition": "A minor mistake or error",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I made a silly <w>goof</w> in that last calculation.",
                            "target_lang_translations": {
                                "nl": "Ik maakte een dom <w>foutje</w> in die laatste berekening."
                            }
                        },
                        {
                            "text": "It was just a small <w>goof</w> that we can easily fix.",
                            "target_lang_translations": {
                                "nl": "Het was slechts een klein <w>foutje</w> dat we makkelijk kunnen herstellen."
                            }
                        }
                    ],
                    "synonyms": [
                        "mistake",
                        "blunder",
                        "slip"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een kleine fout of vergissing."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "blunder",
                                "target_lang_sense_clarification": "Een domme of onhandige fout."
                            },
                            {
                                "target_lang_word": "foutje",
                                "target_lang_sense_clarification": "Een klein, onbeduidend foutje."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2f1d6c8-b89f-3d35-b289-060ea82902e0",
                    "sense_definition": "A person who acts in a silly or foolish way",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your little brother is a total <w>goof</w> when he is around his friends.",
                            "target_lang_translations": {
                                "nl": "Je broertje is een echte <w>gek</w> als hij bij zijn vrienden is."
                            }
                        },
                        {
                            "text": "Stop being such a <w>goof</w> and help me finish this work.",
                            "target_lang_translations": {
                                "nl": "Doe niet zo <w>dwaas</w> en help me dit werk afmaken."
                            }
                        }
                    ],
                    "synonyms": [
                        "fool",
                        "clown"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die zich dwaas of onnozel gedraagt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gek",
                                "target_lang_sense_clarification": "Iemand die zich grappig of dwaas gedraagt."
                            },
                            {
                                "target_lang_word": "clown",
                                "target_lang_sense_clarification": "Iemand die grappen maakt en zich dwaas gedraagt."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9631d0f-5ed2-3610-911d-42ee06ed23c1",
                    "sense_definition": "To make a mistake",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is my fault because I <w>goofed</w> on the report.",
                            "target_lang_translations": {
                                "nl": "Het is mijn schuld omdat ik <w>geblunderd</w> heb in het rapport."
                            }
                        },
                        {
                            "text": "We <w>goofed</w> and bought the wrong type of wax for the project.",
                            "target_lang_translations": {
                                "nl": "We <w>gingen de mist in</w> en kochten het verkeerde type was voor het project."
                            }
                        }
                    ],
                    "synonyms": [
                        "err",
                        "blunder"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een fout maken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "blunderen",
                                "target_lang_sense_clarification": "Een domme fout maken."
                            },
                            {
                                "target_lang_word": "de mist in gaan",
                                "target_lang_sense_clarification": "Een fout maken of falen."
                            }
                        ]
                    },
                    "common_phrases": [
                        "goof up"
                    ]
                },
                {
                    "sense_id": "6750c6c1-30ac-361b-bd33-14efe93e568e",
                    "sense_definition": "To spend time doing silly or unproductive things",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were just <w>goofing</w> around in the park all afternoon.",
                            "target_lang_translations": {
                                "nl": "We waren de hele middag in het park gewoon wat aan het <w>klooien</w>."
                            }
                        },
                        {
                            "text": "Stop <w>goofing</w> and focus on your studies.",
                            "target_lang_translations": {
                                "nl": "Stop met <w>lummelen</w> en concentreer je op je studie."
                            }
                        }
                    ],
                    "synonyms": [
                        "mess around",
                        "fool around"
                    ],
                    "common_phrases": [
                        "goof around"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tijd besteden aan dwaze of onproductieve dingen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "klooien",
                                "target_lang_sense_clarification": "Onproductief bezig zijn of rommelen."
                            },
                            {
                                "target_lang_word": "lummelen",
                                "target_lang_sense_clarification": "Nietsnutten of doelloos rondhangen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}