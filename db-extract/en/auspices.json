                    {
                        "translation_id": "9d898484-7b1c-44be-8245-0fc496bae562",
                        "source_entry_id": "7d4eb097-834f-3d24-8370-d3c7fbbcc3ed",
                        "source_sense_id": "a92a5e33-2dd9-33b3-a3ba-f69f039666d3",
                        "source_sense_description": "patronage or protection",
                        "target_lang_word": "Obhut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Obhut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9337eb8-0e67-30a0-8ce3-54fb341ec325",
                                        "entry_id": "5719eac2-95a0-3ab9-b76d-168a97e4fc79",
                                        "glosses": [
                                            "beschützende Aufsicht über jemanden"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b54a31ed-5cf4-4382-ac10-8a8cae1206fd",
                                                "sense_id": "d9337eb8-0e67-30a0-8ce3-54fb341ec325",
                                                "text": "Nachdem die Eltern der Kinder starben, nahm die Tante sie in ihre Obhut."
                                            },
                                            {
                                                "example_id": "32f724b2-4bcf-4b8a-99c5-35e159df99b4",
                                                "sense_id": "d9337eb8-0e67-30a0-8ce3-54fb341ec325",
                                                "text": "„Viele dieser Frauen mussten ihre eigenen Kinder in der Heimat zurücklassen und in die Obhut von Verwandten, manchmal sogar Fremden geben.“"
                                            },
                                            {
                                                "example_id": "74411e83-ec6b-477d-a29b-07eed9fce1bc",
                                                "sense_id": "d9337eb8-0e67-30a0-8ce3-54fb341ec325",
                                                "text": "„Er hasste seinen geldgierigen Onkel, der ihn nach dem Tod der Eltern in Obhut genommen hatte…“"
                                            },
                                            {
                                                "example_id": "69c17e4a-c6c9-4e05-a255-c8eb53ec329b",
                                                "sense_id": "d9337eb8-0e67-30a0-8ce3-54fb341ec325",
                                                "text": "„Lassehn bleibt allein, und sofort wird ihm bewußt, wie weit er sich schon in Kloses Obhut begeben hat, daß er sich bei ihm schon fast ein wenig geborgen fühlt.“"
                                            },
                                            {
                                                "example_id": "bbb9b9db-c90e-4cd9-bddd-74c5e870a7f6",
                                                "sense_id": "d9337eb8-0e67-30a0-8ce3-54fb341ec325",
                                                "text": "„Der Pfarrer ließ mich in der Obhut des Rektors.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e8e9346f-a724-32ec-b7b6-e028ef56fc18",
                                        "entry_id": "5719eac2-95a0-3ab9-b76d-168a97e4fc79",
                                        "glosses": [
                                            "Aufsicht über jemanden oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dece8bcf-319f-4c62-ad86-3d2f11d2c179",
                                                "sense_id": "e8e9346f-a724-32ec-b7b6-e028ef56fc18",
                                                "text": "Der Kustos nahm die Sammlung unter seine Obhut."
                                            },
                                            {
                                                "example_id": "24b57503-f048-4efc-9bbf-4be2f0801c34",
                                                "sense_id": "e8e9346f-a724-32ec-b7b6-e028ef56fc18",
                                                "text": "„Der Hintergrund war der, dass die Kollekte eines gesamten Monats auf Abwege geraten war, während sie sich in der Obhut des Setzers befand.“"
                                            },
                                            {
                                                "example_id": "ee8da9f6-8e4a-4900-b602-b0ab148b9a3f",
                                                "sense_id": "e8e9346f-a724-32ec-b7b6-e028ef56fc18",
                                                "text": "„Die Mühle ließen sie in der Obhut geschickter junger Leute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b19b1b93-696b-4e7a-b642-c1c114271a01",
                        "source_entry_id": "7d4eb097-834f-3d24-8370-d3c7fbbcc3ed",
                        "source_sense_id": "a92a5e33-2dd9-33b3-a3ba-f69f039666d3",
                        "source_sense_description": "patronage or protection",
                        "target_lang_word": "Ägide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ägide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "922cded6-7a74-3a85-881b-7ca624154aa6",
                                        "entry_id": "21c010dc-ea63-391c-a3ff-540f0b8882cc",
                                        "glosses": [
                                            "fürsorgliche Anleitung und Schutz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efd1fd09-5cab-4fc2-87aa-2d62eb63dc32",
                                                "sense_id": "922cded6-7a74-3a85-881b-7ca624154aa6",
                                                "text": "Unter seiner Ägide gelang ihnen alles."
                                            },
                                            {
                                                "example_id": "d02b9c85-9944-48c8-b6cb-07a1e62d18fc",
                                                "sense_id": "922cded6-7a74-3a85-881b-7ca624154aa6",
                                                "text": "„Leicht ist das Leben unter sowjetischer Ägide dabei keineswegs.“"
                                            },
                                            {
                                                "example_id": "facbd905-023f-4730-8b28-dd9a733d282f",
                                                "sense_id": "922cded6-7a74-3a85-881b-7ca624154aa6",
                                                "text": "„Sie war so eine reine Regierungsagentur geworden, die aber immerhin noch Dividende an die Aktionäre der Gesellschaft zahlte. Diese Anomalie wurde 1858 beendet, als der britische Staat unter der Ägide Königin Viktorias Indien übernahm.“"
                                            },
                                            {
                                                "example_id": "8b18237a-0fc4-4e9f-96d5-224e66e7f0fa",
                                                "sense_id": "922cded6-7a74-3a85-881b-7ca624154aa6",
                                                "text": "„Darüber hinaus perfektionierte er die Kontrolle des Militärs über die Regierung mit Hilfe eines neu geschaffenen Nationalen Sicherheitsrats unter der Ägide des Präsidenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d104162a-a719-4e1d-b517-33f331a4b41e",
                        "source_entry_id": "7d4eb097-834f-3d24-8370-d3c7fbbcc3ed",
