                        "glosses": [
                            "Diskussion, die sich zeitlich sehr lange ausdehnt oder als überlang ausgedehnt empfunden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c82dce4c-658a-48bd-b4b0-254de152bff5",
                                "sense_id": "1656b2dc-13f4-3ecc-b662-3ba23071fab8",
                                "text": "In schlecht geplanten und geleiteten Sitzungen kommt es oft zu ausufernden Endlosdiskussionen."
                            },
                            {
                                "example_id": "9e404ac6-4ea1-4c6e-9a9f-8688749e7867",
                                "sense_id": "1656b2dc-13f4-3ecc-b662-3ba23071fab8",
                                "text": "„Durch die Impulsivität kann es zu unbeabsichtigten Verletzungen und Endlosdiskussionen kommen und ADHS-ler sind wahre Meister in Diskussionen, weil sie kämpfen können bis zum Umfallen und immer Recht haben wollen.“"
                            }
                        ],
