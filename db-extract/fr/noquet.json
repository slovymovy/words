                    {
                        "sense_id": "0ab5a40b-bd4c-3c30-9280-01c30527848e",
                        "entry_id": "1562b792-4a33-31db-a822-86d35699860d",
                        "glosses": [
                            "Bande de plomb ou d’autre métal souple, qu’on met dans les noues (angles rentrants) ou sur les arêtiers (angles sortants) des toits d’ardoise ou de tuile, pour assurer la continuité de l’étanchéité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a62040f-a617-4b74-8952-1fc52d6538ff",
                                "sense_id": "0ab5a40b-bd4c-3c30-9280-01c30527848e",
                                "text": "Noquet droit en zinc."
                            },
                            {
                                "example_id": "7d7f04b7-8746-463e-90c6-c20e56f3db5a",
                                "sense_id": "0ab5a40b-bd4c-3c30-9280-01c30527848e",
                                "text": "Fourniture et pose d’un noquet en zinc pour raccordement de la couverture en ardoises sur rives latérales, sur mur ou souche de cheminée, y compris fixations. A reprendre tranchi, bande de solin et solin."
                            },
                            {
                                "example_id": "75358503-c5bd-4484-858c-597f062a8c7d",
                                "sense_id": "0ab5a40b-bd4c-3c30-9280-01c30527848e",
                                "text": "À partir de la fin du XIXᵉ siècle, un noquet en zinc le recouvre couramment pour éviter toute infiltration."
                            }
                        ]
                    }
