                "senses": [
                    {
                        "sense_id": "6f9cecf6-8934-3ffa-8022-1357c72c3e10",
                        "entry_id": "b9eb354a-7f14-33d4-9462-0a1d9e2086e3",
                        "glosses": [
                            "Goût fumé"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c378cc-3ea9-4235-a62a-0dc1610fa8f2",
                                "sense_id": "6f9cecf6-8934-3ffa-8022-1357c72c3e10",
                                "text": "En Europe, le goût fumé existe dans de nombreuses saveurs de chips. Toutefois, il pourrait représenter un risque pour la santé selon des experts, qui remettent en cause son existence. (...) La mention « arôme de fumée » doit être mentionnée."
                            }
                        ]
                    },
                    {
                        "sense_id": "e11094c9-e114-3c27-9ea2-bbabeebb18b8",
                        "entry_id": "b9eb354a-7f14-33d4-9462-0a1d9e2086e3",
                        "glosses": [
                            "Qui a été soumis à la fumée pour assurer une meilleure conservation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3661ad66-2e69-4b20-aa84-0bef86eced90",
                                "sense_id": "e11094c9-e114-3c27-9ea2-bbabeebb18b8",
                                "text": "Il n'en avait pas mangé depuis des années, ils achetaient du mouton fumé ou du salami."
                            }
                        ]
                    },
                    {
                        "sense_id": "22c45e02-faf4-3e64-9333-1232ce07179a",
                        "entry_id": "b9eb354a-7f14-33d4-9462-0a1d9e2086e3",
                        "glosses": [
                            "Qualifie un verre teinté pour protéger les yeux d'une lumière excessive."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e6ff0235-d958-463d-b8c1-f1ed3cae41c4",
                                "sense_id": "22c45e02-faf4-3e64-9333-1232ce07179a",
                                "text": "Le vieux professeur qui portait des verres fumés parlait du développement de la Chine future."
                            },
                            {
                                "example_id": "6c521376-135e-469a-b7e2-abf5fe9c0ebb",
                                "sense_id": "22c45e02-faf4-3e64-9333-1232ce07179a",
                                "text": "La réverbération sur le sable obligeait à porter des lunettes fumées."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cc38d39-1f4f-3705-9ad1-0ae97025101b",
                        "entry_id": "b9eb354a-7f14-33d4-9462-0a1d9e2086e3",
                        "glosses": [
                            "Ruiné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3beb58f9-ecc8-4fe8-a2de-cf2e583c1ae0",
                                "sense_id": "1cc38d39-1f4f-3705-9ad1-0ae97025101b",
                                "text": "J’ai joué au poker toute la nuit, je suis complètement fumé."
                            }
                        ]
                    }
