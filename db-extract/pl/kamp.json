                "senses": [
                    {
                        "sense_id": "c84b6094-7905-366b-a30e-9520c777f068",
                        "entry_id": "ed8505fa-3479-3012-9221-35b565751f6f",
                        "glosses": [
                            "estetyka, konwencja stylistyczna, przypisująca rzeczom wartość ponieważ są w złym guście lub ich wymowy ironicznej"
                        ],
                        "tags": [],
                        "examples": [
