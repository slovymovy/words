                },
                {
                    "sense_id": "9b78995b-750b-3483-9695-8f32f449c42f",
                    "sense_definition": "свойство быть твердым, стойким или сильным",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для строительства моста важна <w>крепость</w> используемых материалов.",
                            "target_lang_translations": {
                                "de": "Für den Bau der Brücke ist die <w>Festigkeit</w> der verwendeten Materialien entscheidend."
                            }
                        },
                        {
                            "text": "Его <w>крепость</w> духа помогла ему пережить трудные времена.",
                            "target_lang_translations": {
                                "de": "Seine <w>Stärke</w> des Geistes half ihm, schwere Zeiten zu überstehen."
                            }
