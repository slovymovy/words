                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8f92d0e-33ae-44f2-b51f-8a95b8e01b5d",
                                                "sense_id": "89ebe7c0-057c-364d-83bd-1352ac18a752",
                                                "text": "Te jego błazeństwa już mnie nie bawią."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "628aad69-4749-4746-bb93-4c166aa35a0c",
