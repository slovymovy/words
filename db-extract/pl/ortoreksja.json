                        "entry_id": "dc54fdde-f7e5-3d04-9591-9799e7c69cb6",
                        "glosses": [
                            "obsesja na punkcie spożywania zdrowej żywności"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "e7d682c4-17c3-402e-8fb2-e98951351d61",
                                "sense_id": "0fe4f8cd-7f39-317d-a164-f3e07c4dc0d9",
                                "text": "Co więcej, dla niektórych zdrowe odżywianie staje się prawdziwą obsesją, którą należy leczyć. Do takich osób należał Amerykanin, doktor Steven Bratman. W 1997 roku stworzył termin „ortoreksja\" na określenie przypadłości, na którą cierpiał."
                            }
                        ],
