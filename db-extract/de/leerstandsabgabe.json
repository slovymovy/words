                "senses": [
                    {
                        "sense_id": "4c89d134-5502-3db8-bf63-bcdde3910a25",
                        "entry_id": "873129cd-be4a-3457-8fc0-12caf599d0bd",
                        "glosses": [
                            "Steuer für unvermietete Räumlichkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d323cd8-69b8-45b5-8576-471cfb2b95f5",
                                "sense_id": "4c89d134-5502-3db8-bf63-bcdde3910a25",
                                "text": "„Demnach sei auch eine Leerstandsabgabe kein Thema.“"
                            },
                            {
                                "example_id": "9d9c03b2-6d97-4461-b950-d0810b0b3be3",
                                "sense_id": "4c89d134-5502-3db8-bf63-bcdde3910a25",
                                "text": "„Finanzstadträtin Renate Brauner (SPÖ) kündigte am Donnerstag in der Fragestunde des Wiener Landtages an, eine Leerstandsabgabe zu prüfen.“"
                            },
                            {
                                "example_id": "2e115aea-69bd-457a-857f-4d93c1b2e1e8",
                                "sense_id": "4c89d134-5502-3db8-bf63-bcdde3910a25",
                                "text": "„[Die Wohnungsleerstand-Erhebung] war gemacht worden, um zu klären, ob eine Leerstandsabgabe (theoretisch – juristisch wäre es schwierig) sinnvoll sei: Ludwig kommt zum Schluss, dass eine solche nicht nötig ist.“"
                            },
                            {
                                "example_id": "4f81ed8b-7b33-4062-8904-aadf2f5eb1f1",
                                "sense_id": "4c89d134-5502-3db8-bf63-bcdde3910a25",
                                "text": "„Einen Bedarf für eine Leerstandsabgabe sieht man daher derzeit nicht.“"
                            },
                            {
                                "example_id": "367a1779-1910-4f46-83fe-89804d2eae39",
                                "sense_id": "4c89d134-5502-3db8-bf63-bcdde3910a25",
                                "text": "„Prüfung der Möglichkeit zur Einführung einer Leerstandssteuer bzw. Leerstandsabgabe für gewerbliche Objekte in der Wolfenbütteler Innenstadt“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
