                    },
                    {
                        "translation_id": "2bda3d8d-330b-41ff-bcf8-bd64b14701d8",
                        "source_entry_id": "e7015215-241e-35c6-b13d-e6eea2ec6edb",
                        "source_sense_description": "salt or ester of glutamic acid",
