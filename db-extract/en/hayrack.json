                    {
                        "translation_id": "2b09fd3c-47b4-4e7c-82aa-fef3a45a71f8",
                        "source_entry_id": "cbc7dfbd-69c6-36ea-9b8c-7937069d2f2d",
                        "source_sense_id": "7d0234f2-6c6e-314f-a7d9-8027d19c7ca8",
