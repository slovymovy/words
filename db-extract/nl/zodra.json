                "senses": [
                    {
                        "sense_id": "7036267f-b2f3-3f24-804e-3bbd22de61ac",
                        "entry_id": "3712f81a-84e6-3a52-9e16-bc38b32267b2",
                        "glosses": [
                            "geeft aan welke gebeurtenis eerst moe(s)t plaatsvinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a69554f6-7137-4677-80aa-2b6f420f5e3b",
                                "sense_id": "7036267f-b2f3-3f24-804e-3bbd22de61ac",
                                "text": "Zodra hij vrijgelaten werd, vatte hij zijn criminele loopbaan weer op."
                            },
                            {
                                "example_id": "1ecda3fe-a448-40d8-9ab8-a3f22e1dbb9d",
                                "sense_id": "7036267f-b2f3-3f24-804e-3bbd22de61ac",
                                "text": "En zodra het dag werd, stuurden die Pedro, die altijd voor de paarden zorgde, naar de slaapkamer van de Sint: `Sinterklaas, Sinterklaas, we kunnen niet naar Holland."
                            },
                            {
                                "example_id": "f28ec911-c2d1-4674-a339-a4fa1f7dba2e",
                                "sense_id": "7036267f-b2f3-3f24-804e-3bbd22de61ac",
                                "text": "Ik maakte vóór mijn trip vaak de grap dat ik zodra mijn oudste dochter ontspoorde direct naar huis zou komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c10af441-51d6-4f0c-bd77-e7ad56455cc8",
                        "source_entry_id": "3712f81a-84e6-3a52-9e16-bc38b32267b2",
                        "source_sense_id": "7036267f-b2f3-3f24-804e-3bbd22de61ac",
                        "source_sense_description": "geeft aan welke gebeurtenis eerst moe(s)t plaatsvinden",
                        "target_lang_word": "sobald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sobald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "294bb025-199c-3c62-9d45-329c22ce3c1b",
                                        "entry_id": "d645e7ef-c469-37fb-bcd3-3a4377206b2e",
                                        "glosses": [
                                            "in dem Moment, wenn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab963a06-90fe-4ebe-94e5-2b4ea440cae5",
                                                "sense_id": "294bb025-199c-3c62-9d45-329c22ce3c1b",
                                                "text": "Ich werde mich melden, sobald ich kann."
                                            },
                                            {
                                                "example_id": "276006a5-aef4-4b52-bf0e-b43dbfa8e738",
                                                "sense_id": "294bb025-199c-3c62-9d45-329c22ce3c1b",
                                                "text": "„Am liebsten würde Hans Krenn ja jede Wachauer Marille einzeln auffangen, sobald sie reif vom Baum fällt. Denn die Marille, so sagt der begnadete Schnapsbrenner aus dem südlichen Waldviertel, ‚ist eine wahre Diva‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0251d973-7c14-48e9-a0f8-6611ad8fd6de",
                        "source_entry_id": "3712f81a-84e6-3a52-9e16-bc38b32267b2",
                        "source_sense_id": "7036267f-b2f3-3f24-804e-3bbd22de61ac",
                        "source_sense_description": "geeft aan welke gebeurtenis eerst moe(s)t plaatsvinden",
                        "target_lang_word": "as soon as",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "as soon as",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47e9e00f-39ed-3d96-a00b-23247bd2217f",
                                        "entry_id": "1d227acc-efa4-33aa-8df4-4c18958ae205",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see as, soon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02dbe1b2-4227-4ab5-853a-1cfcffac4bcd",
                                                "sense_id": "47e9e00f-39ed-3d96-a00b-23247bd2217f",
                                                "text": "I came as soon as I could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee58d11f-db64-3b52-9a75-78eafdec95c4",
                                        "entry_id": "1d227acc-efa4-33aa-8df4-4c18958ae205",
                                        "glosses": [
                                            "At the moment when; immediately (after); instantly; directly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c76189-f7f9-4424-8bcf-d9b701a3f5a7",
                                                "sense_id": "ee58d11f-db64-3b52-9a75-78eafdec95c4",
                                                "text": "As soon as he arrived, everyone gasped."
                                            },
                                            {
                                                "example_id": "446e3301-7bdb-40c1-8f08-bad81966d820",
                                                "sense_id": "ee58d11f-db64-3b52-9a75-78eafdec95c4",
                                                "text": "[…] that eye which watches guilt\n⁠And goodness, and hath power to see\n⁠Within the green the moulder’d tree,\nAnd towers fall’n as soon as built— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddd6a9b9-6b31-362b-9337-d772ae286e3e",
                                        "entry_id": "1d227acc-efa4-33aa-8df4-4c18958ae205",
                                        "glosses": [
                                            "Used to indicate that the first action mentioned is as likely as, or is preferred to, the second action mentioned."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53c3572d-2f51-46f9-9035-e9482bf05e8b",
                                                "sense_id": "ddd6a9b9-6b31-362b-9337-d772ae286e3e",
                                                "text": "I'd jump out the window as soon as not."
                                            },
                                            {
                                                "example_id": "1d598cdc-c666-4bb8-b12a-aa7e846b16db",
                                                "sense_id": "ddd6a9b9-6b31-362b-9337-d772ae286e3e",
                                                "text": "He was a bad guy. He would hit you with a chunk of pipe as soon as look at you."
                                            },
                                            {
                                                "example_id": "fc64e9fb-30b5-4d61-b184-7eb1bd02dd66",
                                                "sense_id": "ddd6a9b9-6b31-362b-9337-d772ae286e3e",
                                                "text": "\"[T]hey are the worst of the worst and they will shoot you just as soon as say Hello.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "as soon as",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d252d22-b467-3890-bcfb-a0f1e77f0b83",
                                        "entry_id": "3831166d-0a67-3c9d-93de-97e84bb5c132",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see as, soon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42025f99-6423-41f5-b3b9-8c4e04b7d947",
                                                "sense_id": "6d252d22-b467-3890-bcfb-a0f1e77f0b83",
                                                "text": "He might arrive as soon as three o'clock."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4efcb539-a2bf-4020-a04f-8f02eecbcfa1",
                        "source_entry_id": "3712f81a-84e6-3a52-9e16-bc38b32267b2",
                        "source_sense_id": "7036267f-b2f3-3f24-804e-3bbd22de61ac",
                        "source_sense_description": "geeft aan welke gebeurtenis eerst moe(s)t plaatsvinden",
                        "target_lang_word": "как только",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "как только",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2740b10b-6b51-333d-b758-240c26627485",
                                        "entry_id": "2c0c9459-3970-30be-a4ff-a768ea4c120f",
                                        "glosses": [
                                            "едва, лишь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ada0790d-53d3-4638-9dc9-333bbb82f828",
                                                "sense_id": "2740b10b-6b51-333d-b758-240c26627485",
                                                "text": "Вячеслав Илларионович ужасный охотник до прекрасного пола и, как только увидит у себя в уездном городе на бульваре хорошенькую особу, немедленно пустится за нею вслед, но тотчас же и захромает, ― вот что замечательное обстоятельство."
                                            },
                                            {
                                                "example_id": "78a5d79a-f267-4f4d-95fe-8df004c6c760",
                                                "sense_id": "2740b10b-6b51-333d-b758-240c26627485",
                                                "text": "Ведь как только раздалась команда: свистать всех наверх, поворот оверштаг ― словно электрическая искра пробежала по всем."
                                            },
                                            {
                                                "example_id": "da90ea9b-4140-410b-870d-072e40a45b17",
                                                "sense_id": "2740b10b-6b51-333d-b758-240c26627485",
                                                "text": "Мы поженимся, как только… как только мне исполнится 18 лет."
                                            },
                                            {
                                                "example_id": "108c608b-ca1e-4318-9367-f379be0c672c",
                                                "sense_id": "2740b10b-6b51-333d-b758-240c26627485",
                                                "text": "Как только я упал на прибрежную гальку, я очнулся и понял, что парень меня всё-таки спас."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
