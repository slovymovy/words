                "senses": [
                    {
                        "sense_id": "de47ba42-8189-3e05-9b54-b9844fc861b0",
                        "entry_id": "6a4a3773-c4d0-3582-b5e1-58d4e1e5897e",
                        "glosses": [
                            "Donner un caractère judaïque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970f1ce0-817e-41ea-91d1-536a4f6ce8a1",
                                "sense_id": "de47ba42-8189-3e05-9b54-b9844fc861b0",
                                "text": "Israël utilisera l’extension de la section non orthodoxe pour mener des fouilles archéologiques et « judaïciser le lieu saint », a-t-il affirmé."
                            },
                            {
                                "example_id": "9b50017e-6c3f-4563-af06-f10a850a736f",
                                "sense_id": "de47ba42-8189-3e05-9b54-b9844fc861b0",
                                "text": "Grégoire trouve donc juste d’accuser Eunome de judaïciser et de se débarrasser complètement du Fils et du Saint Esprit en niant leur substantialité divine."
                            },
                            {
                                "example_id": "4d94fef1-2a5a-4dd3-a192-d8bede4121cf",
                                "sense_id": "de47ba42-8189-3e05-9b54-b9844fc861b0",
                                "text": "En avançant en âge, Daniel, bien qu’« athée », dit se judaïciser chaque jour un peu plus."
                            }
                        ]
                    }
