        "fr-extract.jsonl": [
            {
                "entry_id": "d76479c3-72cc-3cbf-be8c-8c8a97fe619c",
                "word": "immariable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0b89a86c-6087-4696-a3fd-b702c17bf6dd",
                        "entry_id": "d76479c3-72cc-3cbf-be8c-8c8a97fe619c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "immariables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39e1f0f2-3f97-3186-8caa-d4212053c6c1",
                        "entry_id": "d76479c3-72cc-3cbf-be8c-8c8a97fe619c",
                        "glosses": [
                            "Qui ne peut se marier. Que l’on ne peut épouser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a7e38bb-a54d-4cf3-af20-146e393663ed",
                                "sense_id": "39e1f0f2-3f97-3186-8caa-d4212053c6c1",
                                "text": "– T’épouser ? t’épouser, toi ! mais tu es folle, mais tu ne t’es pas regardée dans une glace, mais tu es immariable, laide, idiote !."
                            },
                            {
                                "example_id": "492c046a-176f-426d-9320-4f61c7b85dbd",
                                "sense_id": "39e1f0f2-3f97-3186-8caa-d4212053c6c1",
                                "text": "… mais elle songea, que Marion Saxancour n’ayant rien, le Chevalier serait obligé de l’avantager ; et en prudente Collatérale, elle préféra de lui procurer une Demoiselle de condition, immariable, mais qui avait du bien, parce qu’il était inutile de l’avantager."
                            },
                            {
                                "example_id": "6246ff3d-fe03-4dab-af97-4a488638a4b4",
                                "sense_id": "39e1f0f2-3f97-3186-8caa-d4212053c6c1",
                                "text": "Immariable à cause de sa pauvreté, Hélène accepte le duc d’Orléans, que d’autres motifs ont rendu aussi immariable qu’elle. Le 30 mai 1837, ces deux impossibilités conjugales s’unissent à Fontainebleau."
                            }
                        ]
                    },
                    {
                        "sense_id": "96bdafc6-ef2d-39fa-b6ac-6e6247a68ada",
                        "entry_id": "d76479c3-72cc-3cbf-be8c-8c8a97fe619c",
                        "glosses": [
                            "Euphémisme de laid."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3812ea41-3ef3-47d4-b831-8691acfbaad7",
                                "sense_id": "96bdafc6-ef2d-39fa-b6ac-6e6247a68ada",
                                "text": "Cette fille est immariable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b603bb8-c1f6-4e1a-aa0b-6d974f1dd895",
                        "source_entry_id": "d76479c3-72cc-3cbf-be8c-8c8a97fe619c",
                        "target_lang_word": "unmarriable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmarriable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21042c45-9bbd-3f90-bec7-0ba41ba4c1d8",
                                        "entry_id": "980e88c5-a63b-3309-9888-96a01905e9a0",
                                        "glosses": [
                                            "Not marriable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
