                                        ],
                                        "examples": [
                                            {
                                                "example_id": "756196e7-c965-4fa6-953f-4b2733b497f3",
                                                "sense_id": "c9a34df6-f941-3abd-b677-a284f00b3a68",
                                                "text": "Abtreiben bedeutet, Butter oder Eier und Zucker (ohne Hitze) so lange mit einem Rührlöffel in einem Geschirr rühren, bis die Masse dick wird und Blasen wirft."
                                            },
                                            {
