                        "glosses": [
                            "Qui est de l’ordre de la création avant le péché originel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "718d31e6-a3d2-42d5-9082-5181983ebe94",
                                "sense_id": "14fe1256-2607-382d-9e80-b40ebc31a963",
                                "text": "Les théologiens font une distinction entre le surnaturel, qui est l'ordre de la grâce (cela désigne l'ensemble des phénomènes extraordinaires venant de Dieu, telles que les visions, les révélations, les miracles, etc.) et le préternaturel, qui est de l'ordre du créé, cet état dans lequel vivaient Adam et Ève avant le péché."
                            }
                        ]
                    }
