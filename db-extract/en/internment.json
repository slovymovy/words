                                        "glosses": [
                                            "Action d’interner une personne ou état d’une personne internée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a3fc75b-8637-43ae-9754-a892d6c9077d",
                                                "sense_id": "62e10b53-435a-395e-9154-4dd02f296a12",
                                                "text": "L’internement est exécuté dans un établissement fermé et ne sera levé que lorsque on peut considérer que l’interné se conduira correctement en liberté."
                                            }
