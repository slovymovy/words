                                                "sense_id": "a07bfee5-0dde-36b1-b5a7-b24985848b5a",
                                                "text": "Nach Süden hin beginnt eine hügelige Landschaft."
                                            },
                                            {
                                                "example_id": "aef3ba13-e3d1-46e4-a096-03580ac65cd0",
                                                "sense_id": "a07bfee5-0dde-36b1-b5a7-b24985848b5a",
                                                "text": "Hinter dem Waldesrand wurde der Weg hügelig."
                                            },
                                            {
                                                "example_id": "81e8bddf-2dad-4f21-90bb-bccf8d633edf",
                                                "sense_id": "a07bfee5-0dde-36b1-b5a7-b24985848b5a",
                                                "text": "„Quer durch hügelige Landschaften – Julia Scherzer fährt Triebwagen und schwere Loks bei den ÖBB. Zuvor absolvierte sie eine Ausbildung zur Schlosserin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
