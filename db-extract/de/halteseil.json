                                        "entry_id": "a3154b4e-c5fd-35af-820c-ed977b1230b6",
                                        "glosses": [
                                            "Arête non incluse dans un cycle, mais qui relie deux de ses sommets."
                                        ],
                                        "tags": [
                                            "Théorie des graphes"
                                        ],
                                        "examples": []
                                    },
                                    {
