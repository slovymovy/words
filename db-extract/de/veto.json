                "senses": [
                    {
                        "sense_id": "e1361b4e-dbfe-307b-8120-17315ad83524",
                        "entry_id": "2a5632bc-6c2e-31df-98e7-327ed92e0135",
                        "glosses": [
                            "Einspruch, der einen geplanten Beschluss verhindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b94b09-a14a-4b51-8077-497a5eb7af4d",
                                "sense_id": "e1361b4e-dbfe-307b-8120-17315ad83524",
                                "text": "Wer kein Vetorecht hat, kann auch nicht mit Erfolg sein Veto einlegen."
                            },
                            {
                                "example_id": "c36b2c08-7973-4615-bb94-02063a526f02",
                                "sense_id": "e1361b4e-dbfe-307b-8120-17315ad83524",
                                "text": "„Die FDA hatte sich mit der Entscheidung dem Veto ihres eigenen wissenschaftlichen Beratungsgremiums widersetzt.“"
                            },
                            {
                                "example_id": "88b86403-71b1-4d42-b9c4-836e1161e6a4",
                                "sense_id": "e1361b4e-dbfe-307b-8120-17315ad83524",
                                "text": "„Einer öffentlichen Heirat, auch unter diesen Bedingungen, hätte wenigstens das Veto der Mutter im Wege gestanden, also wollte Wieland sie vor ein fait accompli stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94caa4af-5611-4b85-84a3-42eaea23a2ba",
                        "source_entry_id": "2a5632bc-6c2e-31df-98e7-327ed92e0135",
                        "source_sense_id": "e1361b4e-dbfe-307b-8120-17315ad83524",
                        "source_sense_description": "Einspruch, der einen geplanten Beschluss verhindert",
                        "target_lang_word": "否决（否決）",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6d71e9b0-d850-48c9-a9f3-9a7d2ef4cb85",
                        "source_entry_id": "2a5632bc-6c2e-31df-98e7-327ed92e0135",
                        "source_sense_id": "e1361b4e-dbfe-307b-8120-17315ad83524",
                        "source_sense_description": "Einspruch, der einen geplanten Beschluss verhindert",
                        "target_lang_word": "veto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d232fa6f-a535-3667-b85c-d3aaf2ae756f",
                                        "entry_id": "186fd2a0-09b6-36bd-b45c-633cdda53e1f",
                                        "glosses": [
                                            "A political right to disapprove of (and thereby stop) the process of a decision, a law etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b496cb96-fc09-3092-98f5-7067ab5a36af",
                                        "entry_id": "186fd2a0-09b6-36bd-b45c-633cdda53e1f",
                                        "glosses": [
                                            "An invocation of that right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db236698-21bb-4443-bacd-50f4abd62117",
                                                "sense_id": "b496cb96-fc09-3092-98f5-7067ab5a36af",
                                                "text": "I called Haig in and told him that I wanted to veto the agricultural appropriations bill we had discussed in the Cabinet meeting on Tuesday, because I did not want Ford to have to do it on his first day as President. Haig brought the veto statement in, and I signed it. It was the last piece of legislation I acted on as President."
                                            },
                                            {
                                                "example_id": "9d5905aa-79cd-4f53-8a34-e0f3e77fc1a8",
                                                "sense_id": "b496cb96-fc09-3092-98f5-7067ab5a36af",
                                                "text": "The failure on Wednesday to overturn Mr. Cooper’s veto was among the most dramatic consequences of Democratic legislative victories in North Carolina last November, which broke Republican supermajorities in both chambers and made it easier for Mr. Cooper’s vetos to survive."
                                            },
                                            {
                                                "example_id": "c59e0548-6530-4131-bd6d-c8517471d05a",
                                                "sense_id": "b496cb96-fc09-3092-98f5-7067ab5a36af",
                                                "text": "Now, Republican legislators cannot afford to lose a single seat, in either chamber, if they want to continue to override his vetoes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf3827a2-0efa-3303-9dfb-c2091b2734c7",
                                        "entry_id": "186fd2a0-09b6-36bd-b45c-633cdda53e1f",
                                        "glosses": [
                                            "An authoritative prohibition or negative; a forbidding; an interdiction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b0c8009-f02a-42e6-83ee-d9a178ce2e05",
                                                "sense_id": "bf3827a2-0efa-3303-9dfb-c2091b2734c7",
                                                "text": "This contemptuous veto of her husband's on any intimacy with her family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44120765-4a48-36e9-b0e6-0dbc74343365",
                                        "entry_id": "186fd2a0-09b6-36bd-b45c-633cdda53e1f",
                                        "glosses": [
                                            "A technique or mechanism for discarding what would otherwise constitute a false positive in a scientific experiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb0760b4-7088-4e5a-bcd5-e5a384a8a24e",
                                                "sense_id": "44120765-4a48-36e9-b0e6-0dbc74343365",
                                                "text": "An outer detector (OD) region will act as both a passive shield for low energy backgrounds and an active veto for cosmic ray muons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "veto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48d48424-3089-3271-9ce6-85930516ba1f",
                                        "entry_id": "c2e11ed3-6765-3947-b2cd-3a0c7041064f",
                                        "glosses": [
                                            "To use a veto against."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b69623c-fbbb-42bf-8e4e-1cac7dbcfcb8",
                                                "sense_id": "48d48424-3089-3271-9ce6-85930516ba1f",
                                                "text": "The president vetoed the bill."
                                            },
                                            {
                                                "example_id": "c244c378-7efc-4e94-b7e8-9b7bafc5f863",
                                                "sense_id": "48d48424-3089-3271-9ce6-85930516ba1f",
                                                "text": "The railway was in fact shifted in 1937 a little to the west, over a distance of a quarter-mile, to make room for the by-pass at this point, but complete abandonment was firmly vetoed because of the proved strategic value of the line."
                                            },
                                            {
                                                "example_id": "24fb3430-b0c0-45cc-86b6-76ccc500e439",
                                                "sense_id": "48d48424-3089-3271-9ce6-85930516ba1f",
                                                "text": "Perhaps more notably, they also expect 25 percent of all Spac acquisitions to be vetoed by shareholders in 2008 — which will force those Spacs to liquidate."
                                            },
                                            {
                                                "example_id": "c257dee9-7f60-45c6-91e4-ae5ed5a1af14",
                                                "sense_id": "48d48424-3089-3271-9ce6-85930516ba1f",
                                                "text": "Just a week after vetoing a ban on gender-affirming care for minors, Gov. Mike DeWine of Ohio issued an executive order on Friday banning gender-transition surgeries for anyone under 18 at state hospitals or ambulatory clinics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5edc694f-1ce1-3968-963c-d683aee843a6",
                                        "entry_id": "c2e11ed3-6765-3947-b2cd-3a0c7041064f",
                                        "glosses": [
                                            "To countermand."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "807f0889-f0ab-4d84-80ed-d2df50e79857",
                                                "sense_id": "5edc694f-1ce1-3968-963c-d683aee843a6",
                                                "text": "Mom and Dad vetoed our menu preferences for the holiday meal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
