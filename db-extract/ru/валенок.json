                ],
                "senses": [
                    {
                        "sense_id": "5aba8ffc-2225-3c06-bec2-84b5f220df10",
                        "entry_id": "f77950db-56a3-30f1-a0fa-54fc94cab97b",
                        "glosses": [
                            "парный зимний тёплый сапог, изготовленный валянием, свалянный из шерсти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82b3ef6f-e66d-48c4-a598-f6ad048879c6",
                                "sense_id": "5aba8ffc-2225-3c06-bec2-84b5f220df10",
                                "text": "В домах в это время закрывают ставни: во тьме слышен скрип по снегу валенков, хлопанье ставней и стук кулака в железный болт."
                            },
                            {
                                "example_id": "09bf9851-fd77-45f2-a9f6-b5aba258fb29",
                                "sense_id": "5aba8ffc-2225-3c06-bec2-84b5f220df10",
                                "text": "Переобулся Иван Леонтьич из валенков в сапоги, одел сюртук и сел к самовару .."
                            },
                            {
                                "example_id": "4804dcf9-4a0f-4d9f-a9b1-53008d982e60",
                                "sense_id": "5aba8ffc-2225-3c06-bec2-84b5f220df10",
                                "text": "Цепь мокрых следов от его валенок протянулась через весь зал к одному из ожидавших его вдали пустых столов."
                            },
                            {
                                "example_id": "8192d760-b84e-410b-aa01-f3f2ab2e3964",
                                "sense_id": "5aba8ffc-2225-3c06-bec2-84b5f220df10",
                                "text": "Она делала большие глаза и причитала, но он был строг и неумолим, и даже топнул ножкой, обутой в валенок с галошей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ed298bf-4b2b-4a01-aa52-7f5c97993bca",
