                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "schoonmaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sop</w> jij de ramen ook aan de buitenkant?",
                            "target_lang_translations": {
                                "en": "Do you also <w>wash</w> the windows on the outside?"
                            }
                        },
                        {
                            "text": "Waarom <w>sop</w> jij de vloer met zo veel water?",
                            "target_lang_translations": {
                                "en": "Why do you <w>scrub</w> the floor with so much water?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second person singular present tense of 'to scrub with soapy water'."
                    },
                    "translations": {
