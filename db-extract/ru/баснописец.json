                                    {
                                        "sense_id": "e5db09f2-2bf8-3a8d-9e57-83f41e909ed4",
                                        "entry_id": "49dfd223-4a26-3594-a37f-2cc6d9032f9a",
                                        "glosses": [
                                            "A person who writes or tells fables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254390ea-f3b9-4444-bba3-bf100bd6f53c",
                                                "sense_id": "e5db09f2-2bf8-3a8d-9e57-83f41e909ed4",
                                                "text": "That great fabulist and philosopher Aesop illustrated it by his fable of the bundle of sticks[…]"
                                            },
                                            {
                                                "example_id": "1e6105b2-6039-4fb5-bc52-b747081fa055",
                                                "sense_id": "e5db09f2-2bf8-3a8d-9e57-83f41e909ed4",
                                                "text": "La Fontaine, the French fabulist, has a tale, La Mandargore, dealing with the erotic impact of the root."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d8d3c6-02a8-363b-8c64-0ea1d4c80cd4",
                                        "entry_id": "49dfd223-4a26-3594-a37f-2cc6d9032f9a",
                                        "glosses": [
                                            "A liar."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45b794c0-254f-43c0-bb7c-7da1ae4f37b7",
                                                "sense_id": "29d8d3c6-02a8-363b-8c64-0ea1d4c80cd4",
                                                "text": "The Infowars fabulist has been funneling millions out of his empire while claiming bankruptcy, the Sandy Hook families suing him say."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
