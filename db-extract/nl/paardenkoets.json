                            {
                                "example_id": "638c38e3-69de-4901-a65c-9518f1d45103",
                                "sense_id": "442c25b5-0e95-3c55-8da0-00198f7816c8",
                                "text": "Dora was een jaar of zes, zeven toen ze met Pasen in de tuin een paardenkoets van Playmobil vond die ze al heel lang wilde hebben."
                            },
                            {
                                "example_id": "2b23f7f4-2568-4f3d-b347-5301be4ab01d",
                                "sense_id": "442c25b5-0e95-3c55-8da0-00198f7816c8",
                                "text": "Queen Elizabeth en Prins Philip komen aan in een paardenkoets"
                            },
                            {
                                "example_id": "ed97474d-353b-492c-ad29-ef95e8f298d7",
                                "sense_id": "442c25b5-0e95-3c55-8da0-00198f7816c8",
                                "text": "De gasten arriveren per paardenkoets en krijgen dezelfde 'bloedverrijkende' maaltijd voorgezet als in het verhaal; kip met paprika's. \"Ik wil dat het allemaal heel realistisch wordt en opnieuw het mooie verhaal vertellen dat in dit prachtige land is ontstaan\", zegt Dacre Stoker."
                            }
                        ]
