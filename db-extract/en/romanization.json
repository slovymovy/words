                    {
                        "translation_id": "ed0b70aa-64bd-4b9f-9146-6fca80e3d6ab",
                        "source_entry_id": "3055aeb7-9f97-35ad-88d6-65c4d5ddb26e",
                        "source_sense_description": "putting text into the Latin (Roman) alphabet",
                        "target_lang_word": "Romanisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
