                },
                {
                    "sense_id": "92c039cb-380b-393b-a4d5-6021cf7bdd01",
                    "sense_definition": "a railway employee in charge of a train",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "railway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train <w>guard</w> blew his whistle to signal that the doors were closing.",
                            "target_lang_translations": {
                                "ru": "Поездной <w>кондуктор</w> дал свисток, сигнализируя о закрытии дверей."
                            }
                        },
                        {
                            "text": "Passengers can ask the <w>guard</w> for assistance during the journey.",
                            "target_lang_translations": {
                                "ru": "Пассажиры могут обратиться к <w>проводнику</w> за помощью во время поездки."
                            }
                        }
