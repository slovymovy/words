                                                "sense_id": "5069a703-d4cc-3b75-b803-0e3a2fffb710",
                                                "text": "Die Maschine war kaputt und produzierte nur noch Ausschuss."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "237cb583-9b58-3751-ab65-a13b84e43aaa",
                                        "entry_id": "e29ee1f5-746c-34fe-a184-69012f34a407",
                                        "glosses": [
                                            "die Stelle, an der ein Geschoss einen Körper, den es durchdrang, wieder verlassen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cb6f6fd-f37f-4932-82cb-e98426693d09",
                                                "sense_id": "237cb583-9b58-3751-ab65-a13b84e43aaa",
                                                "text": "Am Bein meines Opas ist noch der Ausschuss zu sehen, den er seit dem Krieg hat."
