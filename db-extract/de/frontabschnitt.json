                "senses": [
                    {
                        "sense_id": "15b2c5f4-0fcc-39a9-9e1b-7679bec53cb3",
                        "entry_id": "2486f315-7158-3fea-b41a-7d9ca56cc87d",
                        "glosses": [
                            "begrenzter Bereich der Front, der vordersten Kampflinie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0fc6e56-bd8c-47d4-905e-b5e43bebfbb7",
                                "sense_id": "15b2c5f4-0fcc-39a9-9e1b-7679bec53cb3",
                                "text": "„Ihm war, als wäre er aus einem zerschossenen Frontabschnitt in ein Stück geretteten Friedens zurückversetzt worden.“"
                            },
                            {
                                "example_id": "bac7d7cd-58e8-48d4-a35d-019232df9390",
                                "sense_id": "15b2c5f4-0fcc-39a9-9e1b-7679bec53cb3",
                                "text": "„Sie gab sich Mühe, Schefold richtig zu schildern; wie immer Dincklage auch politisch eingestellt war, als Offizier mußte es ihm unangenehm sein, zu erfahren, daß es eine undichte Stelle in seinem Frontabschnitt gab, und jemanden, der sie benutzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
