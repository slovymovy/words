                                    {
                                        "sense_id": "52d20384-454c-38a3-aa46-d29fb654522c",
                                        "entry_id": "a02ce48a-fa40-3485-9586-178fb7e25090",
                                        "glosses": [
                                            "A form of psychic energy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3d716e5-1e59-4154-800e-8c4023f925d2",
                                                "sense_id": "52d20384-454c-38a3-aa46-d29fb654522c",
                                                "text": "‘Come, lad,’ he said. ‘We will take tea together and speak of the noumenon, the psi and other more heterogenous phenomena.’"
                                            },
                                            {
                                                "example_id": "3ec8d129-242b-4625-8e59-8c023a735a3e",
                                                "sense_id": "52d20384-454c-38a3-aa46-d29fb654522c",
                                                "text": "When an event is classified as a psi phenomenon, it is claimed that all known channels for the apparent interaction have been eliminated."
                                            },
                                            {
                                                "example_id": "c954e913-aabb-4fa5-a9a2-c2a147074379",
                                                "sense_id": "52d20384-454c-38a3-aa46-d29fb654522c",
                                                "text": "It traces the growth of homo gestalt with the uniting of six lovely outcasts of society who have psi powers and come together as a hive mind, thus creating a gestalt super-being."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29cdc653-6563-3fba-9204-6c22d6327f78",
                                        "entry_id": "9a8328a0-e035-380e-ba85-f15a2ceb58e2",
                                        "glosses": [
                                            "Pound per square inch (an imperial unit of pressure)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39701586-330f-4da8-bfe1-54d20e203298",
                                                "sense_id": "29cdc653-6563-3fba-9204-6c22d6327f78",
                                                "text": "Each turbogenerator consisted of a steam turbine, powered by 900 psi of superheated steam, that was coupled by a set of reduction gears to a General Electric marine alternating-current generator operating at 1,800 rpm. Each generator had a capacity of 2,000 kilowatts of three-phase power at 450 volts and 60 hertz. The main 450-volt switchboard was energized by the two turbogenerators. The emergency switchboard, in the emergency generator room, was fed from the main switchboard through an electrical tie."
                                            },
                                            {
                                                "example_id": "5876b177-d2b9-4fa6-9d1c-59d29bc60559",
                                                "sense_id": "29cdc653-6563-3fba-9204-6c22d6327f78",
                                                "text": "For M2, this is typically around 3250 MPa (471,000 psi) when tempered at 300°F (149°C)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
