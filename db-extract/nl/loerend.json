                            {
                                "example_id": "3c0e08c2-c41f-4065-8197-1220e0b6aba6",
                                "sense_id": "d7d74dd7-c12f-337e-9561-227f264118da",
                                "text": "Loerende mannen en een belabberde beveiliging. Dat zag Naomi op het feest in club Roxy, waarna twee Nederlandse meiden zijn verkracht. Afgelopen vrijdag is het duo vermoedelijk in de club gedrogeerd. Die avond was ook Naomi er. 'Ik voelde me een prooi.'"
                            },
                            {
                                "example_id": "3ea31ea6-64dc-4b8e-8d76-fb60291c0480",
                                "sense_id": "d7d74dd7-c12f-337e-9561-227f264118da",
                                "text": "Martinez zelf had overigens niets gemerkt van loerende medescholieren, maar een aantal van hen zou haar hebben uitgelachen toen ze naar het toilet ging."
                            }
                        ]
                    }
