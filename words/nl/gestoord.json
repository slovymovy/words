                    "frequency": "Middle",
                    "semantic_group_id": "mentale toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ben je helemaal <w>gestoord</w> geworden om zoiets gevaarlijks te doen?",
