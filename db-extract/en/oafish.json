                        "glosses": [
                            "rüpelhaft, tölpelig, einfältig, dumm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ba6f2fa-08b7-4174-ac25-5e5e188d6cb5",
                                "sense_id": "612b3c97-5780-3954-acc5-de29a6162ebd",
                                "text": "\"“Please remember,” the oafish interrogator cuts in, “you have thirty minutes to talk.“\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28d83907-513e-4b7e-bbf7-8f4e65bc7df5",
                        "source_entry_id": "459bc0e9-5f71-3e13-91db-fe9fc42a9941",
                        "source_sense_id": "612b3c97-5780-3954-acc5-de29a6162ebd",
                        "source_sense_description": "rüpelhaft, tölpelig, einfältig, dumm",
                        "target_lang_word": "rüpelhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rüpelhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                        "entry_id": "d4e303bc-27c1-3aed-a73c-e7f8dcd7d1a1",
                                        "glosses": [
                                            "ohne Benehmen, ohne Manieren, frech, wie ein Rüpel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "689171be-9cab-4f10-a93c-062775df6e05",
                                                "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                                "text": "Lehrer: „Dein rüpelhaftes Benehmen wird an dieser Schule keinesfalls akzeptiert. Entweder Du änderst Dich oder Du fliegst!“"
                                            },
                                            {
                                                "example_id": "e04b8d27-69be-47b4-bf89-2d8ea87fabe6",
                                                "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                                "text": "Viele Autofahrer in Deutschland sehen Radfahrer, die auf der falschen Seite des Radfahrweges fahren, als rüpelhaft an."
                                            },
                                            {
                                                "example_id": "0aa01f47-4ed5-4490-8653-06b7a56f4469",
                                                "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                                "text": "\"Chinesische Touristen genießen allerdings einen zweifelhaften Ruf: Sie gelten als laut und rüpelhaft."
                                            },
                                            {
                                                "example_id": "00963f02-e742-4274-84b7-964d10488285",
                                                "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                                "text": "Der junge Herr legt allerdings seltsam rüpelhafte Manieren an den Tag, die die Einwohner von Grünwiesel für \"vornehm und modern\" halten. Der Höhepunkt der Flegeleien ist ein Stadt-Konzert, das zum Desaster ausartet: Der Neffe wird als Orang-Utan enttarnt, die Bürger haben sich zum Affen machen lassen."
                                            },
                                            {
                                                "example_id": "d85e15b0-2727-4376-8749-d2ec2dc2ab92",
                                                "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                                "text": "[Der österreichische Künstler] Alfred Hrdlicka war ein ungemütlicher Zeitgenosse, gerne rüpelhaft und barsch, oft unausstehlich selbstgerecht. Sein Größenwahn schien keine Grenzen zu kennen, allenfalls Michelangelo ließ er neben sich gelten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24ba2540-560b-4514-afcf-f80683c3c3c1",
                        "source_entry_id": "459bc0e9-5f71-3e13-91db-fe9fc42a9941",
                        "source_sense_id": "612b3c97-5780-3954-acc5-de29a6162ebd",
