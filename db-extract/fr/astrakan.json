                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrakhan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9426f0b-64a1-3192-8996-922e7fe7bf01",
                                        "entry_id": "ed2f400e-d863-3e75-8baf-b027ce9d58bd",
                                        "glosses": [
                                            "Closely-curled black or grey fleece of very young karakul lambs from Astrakhan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbcd48e9-1acd-36bb-9bb2-e68b92e3fb0f",
                                        "entry_id": "ed2f400e-d863-3e75-8baf-b027ce9d58bd",
                                        "glosses": [
                                            "Cloth resembling the above mentioned fur, often made from wool and mohair and used for trimmings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1a40214-498e-4a2b-ac12-5cddd02e0006",
                                                "sense_id": "dbcd48e9-1acd-36bb-9bb2-e68b92e3fb0f",
                                                "text": "Our new acquaintance very deliberately coiled up the tube of his hookah, and produced from behind a curtain a very long befrogged topcoat with Astrakhan collar and cuffs."
                                            },
                                            {
                                                "example_id": "1132d42f-54c8-435b-9fed-49d76893dc63",
                                                "sense_id": "dbcd48e9-1acd-36bb-9bb2-e68b92e3fb0f",
                                                "text": "Heavy bands of astrakhan were slashed across the sleeves and fronts of his double-breasted coat […]"
                                            },
                                            {
                                                "example_id": "857b5d81-260d-4e1a-9cb2-b909b6035277",
                                                "sense_id": "dbcd48e9-1acd-36bb-9bb2-e68b92e3fb0f",
                                                "text": "He was dressed in a long green overcoat with mock astrakhan cuffs and collar and wore on his head an oval fur cap."
                                            },
                                            {
                                                "example_id": "7f37ee7f-0cd7-46af-b19b-82f983088ddf",
                                                "sense_id": "dbcd48e9-1acd-36bb-9bb2-e68b92e3fb0f",
                                                "text": "He was dressed in uniform—a black uniform trimmed with gray astrakhan."
                                            },
                                            {
                                                "example_id": "9c1954e8-1db5-40a0-9fd6-9a5e313a9a9e",
                                                "sense_id": "dbcd48e9-1acd-36bb-9bb2-e68b92e3fb0f",
                                                "text": "Was the cavalry officer slim and elegant, and dressed in astrakhan?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "964019e8-4891-4b7e-82fc-530f7e210a25",
