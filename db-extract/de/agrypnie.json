                        "glosses": [
                            "Schlaflosigkeit, welche über einen längeren Zeitraum anhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b01a1ea-5c87-4852-9600-3419cd7936d1",
                                "sense_id": "eda7a9c0-6005-3b0d-a75b-0036efca98d5",
                                "text": "„Telemann möchte sich zum Fürsprech jener Minderheit aufschwingen, die an akuten oder chronischen Schlafstörungen (Agrypnie) leidet: Melancholiker, Examenskandidaten, bangende Ehefrauen, Mißbraucher von Genußmitteln, dazu die stattliche Anzahl derer, die zum Abendbrot Schweres gegessen haben.“"
                            }
                        ],
