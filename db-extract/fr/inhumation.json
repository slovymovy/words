        "fr-extract.jsonl": [
            {
                "entry_id": "59ee8cc1-6cd2-374e-9a6b-f9a6eda5536c",
                "word": "inhumation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fec76cc7-d4e7-4b82-bbe9-6952c69f0afc",
                        "entry_id": "59ee8cc1-6cd2-374e-9a6b-f9a6eda5536c",
                        "tags": [
                            "plural"
                        ],
                        "form": "inhumations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aad340c8-bd43-3ac8-80e0-2a4fe03265db",
                        "entry_id": "59ee8cc1-6cd2-374e-9a6b-f9a6eda5536c",
                        "glosses": [
                            "Action d’inhumer."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "note": "Il se dit surtout dans la langue administrative",
                        "examples": [
                            {
                                "example_id": "51cc1342-fde5-4da1-8c65-fab63be931d3",
                                "sense_id": "aad340c8-bd43-3ac8-80e0-2a4fe03265db",
                                "text": "Dans la même tombe, les deux modes de sépulture sont représentés, l’inhumation et la crémation."
                            },
                            {
                                "example_id": "d46689a7-2868-4e52-b8aa-b7afd28c3f69",
                                "sense_id": "aad340c8-bd43-3ac8-80e0-2a4fe03265db",
                                "text": "Le terrain consacré à l’inhumation des morts est cinq fois plus étendu que l’espace nécessaire pour y déposer le nombre présumé des morts qui peuvent y être enterrés chaque année."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2fd3629-83dc-42d1-8993-982dd52ba090",
                        "source_entry_id": "59ee8cc1-6cd2-374e-9a6b-f9a6eda5536c",
                        "source_sense_id": "aad340c8-bd43-3ac8-80e0-2a4fe03265db",
                        "target_lang_word": "Bestattung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bestattung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78b0e41c-aaff-3b0a-809b-fe3122fae0e9",
                                        "entry_id": "f081e6fb-d581-3098-87b9-14c4b4fccb00",
                                        "glosses": [
                                            "feierliches Begräbnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c11e8bc6-96d1-4add-add6-2d740ee5314d",
                                                "sense_id": "78b0e41c-aaff-3b0a-809b-fe3122fae0e9",
                                                "text": "Die Bestattung war im Ortsfriedhof."
                                            },
                                            {
                                                "example_id": "364458e1-3471-4f68-abf3-3a53df800bf7",
                                                "sense_id": "78b0e41c-aaff-3b0a-809b-fe3122fae0e9",
                                                "text": "„Auch an dieser Bestattung nahmen die beiden nicht teil.“"
                                            },
                                            {
                                                "example_id": "4c07ccc9-09f2-4028-b893-f5394cdfa925",
                                                "sense_id": "78b0e41c-aaff-3b0a-809b-fe3122fae0e9",
                                                "text": "„Da in der Barockzeit die Bestattungen immer prunkvoller wurden (dies äußerte sich auch bei Hof [beispielsweise Prunksarg Molls für Maria Theresia und Franz Stephan in der Kapuzinergruft]), verfügte Joseph II., die Bestattungen zu vereinfachen; auch sein eigener Sarg in der Kapuzinergruft ist äußerst schlicht.“"
                                            },
                                            {
                                                "example_id": "89d3d2ee-25d8-43b3-a490-31506db0cadb",
                                                "sense_id": "78b0e41c-aaff-3b0a-809b-fe3122fae0e9",
                                                "text": "„Am wahrscheinlichsten ist eine Funktion im Rahmen des Grabkultes: Vielleicht wurden hier bei den Feierlichkeiten zur Bestattung Gaben für den Verstorbenen oder für die Götter niedergelegt.“"
                                            },
                                            {
                                                "example_id": "c7fc4f61-c0e9-4717-bf5b-cefaf224ee36",
                                                "sense_id": "78b0e41c-aaff-3b0a-809b-fe3122fae0e9",
                                                "text": "„Eine regelrechte Konjunktur erlebte die weltliche Bestattung nach dem ersten Weltkrieg durch die Gründung von Feuerbestattungskassen innerhalb der sozialdemokratischen und kommunistischen Arbeiterbewegung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c5dde31-52b1-4eb0-ab43-1fbf20375d61",
                        "source_entry_id": "59ee8cc1-6cd2-374e-9a6b-f9a6eda5536c",
                        "source_sense_id": "aad340c8-bd43-3ac8-80e0-2a4fe03265db",
                        "target_lang_word": "burial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5eda4b-2c44-3eeb-9dae-9f6729dc3be5",
                                        "entry_id": "e5dd8c4b-236e-35be-984a-1b718e79bf19",
                                        "glosses": [
                                            "The act of burying; interment; placing remains into the earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "027a1b24-0068-4a22-a6d0-45a77cbddb43",
                                                "sense_id": "fc5eda4b-2c44-3eeb-9dae-9f6729dc3be5",
                                                "text": "His whole family was present at his burial."
                                            },
                                            {
                                                "example_id": "9e0e37eb-fc94-424b-8271-9f037bffeefc",
                                                "sense_id": "fc5eda4b-2c44-3eeb-9dae-9f6729dc3be5",
                                                "text": "The mourners listened as the priest performed the burial service of long-time parishioner Wendy Stuart."
                                            },
                                            {
                                                "example_id": "ae75cfba-8744-4e80-9667-c5f9dd5fffa7",
                                                "sense_id": "fc5eda4b-2c44-3eeb-9dae-9f6729dc3be5",
                                                "text": "A dreary year for the Squadron, this 1819, when officers and men fell sick by the shipload and were sent home by the tenderful, when Lemon Valley Hospital was supplemented by the one at High Peak, when Court-Martials were held at the rate of one a fortnight, burials thrice a week, and surveys on foul provisions every other day!"
                                            },
                                            {
                                                "example_id": "60db26b1-1add-4e85-983b-35835634c1fb",
                                                "sense_id": "fc5eda4b-2c44-3eeb-9dae-9f6729dc3be5",
                                                "text": "However, many Cromlechs and Dolmins are carelessly called \"Druid's circles\", when in reality they were the burial places of ancient chieftains and their households[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4c40bf4-cfc9-4130-80bf-14f03f4d8861",
                        "source_entry_id": "59ee8cc1-6cd2-374e-9a6b-f9a6eda5536c",
                        "source_sense_id": "aad340c8-bd43-3ac8-80e0-2a4fe03265db",
                        "target_lang_word": "inhumación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4f581b11-f5b6-4f5e-af88-ce503107f000",
                        "source_entry_id": "59ee8cc1-6cd2-374e-9a6b-f9a6eda5536c",
                        "source_sense_id": "aad340c8-bd43-3ac8-80e0-2a4fe03265db",
