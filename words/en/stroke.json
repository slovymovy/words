                },
                {
                    "sense_id": "2231c6bf-f135-325d-a10d-89725fd54b5d",
                    "sense_definition": "An act of hitting a ball with a racket, bat, or club in sports.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He won the point with a powerful <w>stroke</w>.",
                            "target_lang_translations": {
                                "ru": "Он выиграл очко мощным <w>ударом</w>.",
                                "zh": "他凭借一次强有力的<w>击球</w>赢得了这一分。"
                            }
                        },
                        {
                            "text": "Her tennis <w>strokes</w> are very accurate.",
                            "target_lang_translations": {
                                "ru": "Её теннисные <w>удары</w> очень точны.",
                                "zh": "她的网球<w>击球</w>非常精准。"
                            }
                        }
