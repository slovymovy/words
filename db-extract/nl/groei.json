                            {
                                "example_id": "27d50c77-d50e-4d7c-b49c-def57b89a844",
                                "sense_id": "9b3b584a-d2b7-3884-84f8-783e97c12567",
                                "text": "De groei van deze planten is opmerkelijk.",
                                "translation": "The growth of these plants is remarkable.",
                                "english": "The growth of these plants is remarkable."
                            },
                            {
                                "example_id": "0752120e-a0f1-4814-b0e2-4cbfd22d3656",
                                "sense_id": "9b3b584a-d2b7-3884-84f8-783e97c12567",
                                "text": "Planten hebben water en zonlicht nodig voor hun groei.",
                                "translation": "Plants need water and sunlight for their growth.",
                                "english": "Plants need water and sunlight for their growth."
                            },
                            {
                                "example_id": "597967e6-8b81-4b41-9905-29dc00a6c840",
                                "sense_id": "9b3b584a-d2b7-3884-84f8-783e97c12567",
                                "text": "De stad heeft een snelle groei doorgemaakt in de afgelopen decennia.",
                                "translation": "The city has experienced rapid growth over the past decades.",
                                "english": "The city has experienced rapid growth over the past decades."
                            }
                        ]
                    }
