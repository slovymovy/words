                "senses": [
                    {
                        "sense_id": "2f12154d-dfbc-31e0-8de4-95eeecc2da9f",
                        "entry_id": "a5ab7710-54b0-34ba-a905-031fdb8ad37b",
                        "glosses": [
                            "Faire perdre son caractère moléculaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50b8985a-459a-4785-aacd-b1e74a371d94",
                                "sense_id": "2f12154d-dfbc-31e0-8de4-95eeecc2da9f",
                                "text": "Quand bien même, n’importe qui aurait été perturbé par le fait de se faire démoléculariser pour la première fois."
                            },
                            {
                                "example_id": "4017536d-2cc3-40b8-8131-04ebb7ee9d7d",
                                "sense_id": "2f12154d-dfbc-31e0-8de4-95eeecc2da9f",
                                "text": "Je me joue de la matière, je peux démoléculariser n’importe qui en le touchant, en l’aspirant, et me nourrir de tout l’hydrogène que sa mort libère."
                            }
                        ]
                    }
