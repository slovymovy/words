                                    {
                                        "sense_id": "9b77b74f-8d0a-3a66-841c-e10ce5455ccc",
                                        "entry_id": "fa2208c7-6086-3946-9037-402c4c87b2df",
                                        "glosses": [
                                            "hart, rau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceafbb17-0003-454f-a653-2aa9b6861d00",
                                                "sense_id": "9b77b74f-8d0a-3a66-841c-e10ce5455ccc",
                                                "text": "Die beiden r in diesen Wörtern kratzen mir durch die Seele, und es ist sicher ein Barbar gewesen, der die sanften Ideen von Zärtlichkeit mit einem Buchstaben zerstört hat, der einzig und allein für das raue, harsche, harte und grausame gemacht ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b8eca4e-bda1-39eb-8753-ae01dfa17dcf",
                                        "entry_id": "fa2208c7-6086-3946-9037-402c4c87b2df",
                                        "glosses": [
                                            "rau, eisig"
                                        ],
                                        "tags": [
                                            "Wetter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d62321a-37cb-497b-a49e-0f72340fff04",
                                                "sense_id": "3b8eca4e-bda1-39eb-8753-ae01dfa17dcf",
                                                "text": "Die Herbststürme wüten harsch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dcfeaf71-3dbf-31c9-9b8b-7ef9e7b3804e",
                                        "entry_id": "fa2208c7-6086-3946-9037-402c4c87b2df",
                                        "glosses": [
                                            "struppig"
                                        ],
                                        "tags": [
                                            "Haar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc19e652-6de6-4e2c-9fa2-c061ca288c08",
                                                "sense_id": "dcfeaf71-3dbf-31c9-9b8b-7ef9e7b3804e",
                                                "text": "Er hat dickes, harsches Haar."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cd965af5-b760-33d9-8ec0-b1b99b44e59e",
                                        "entry_id": "fa2208c7-6086-3946-9037-402c4c87b2df",
                                        "glosses": [
                                            "Euter: hart und mit Milch gefüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5c550be-1394-45f8-9616-1ed8020fb78d",
                                                "sense_id": "cd965af5-b760-33d9-8ec0-b1b99b44e59e",
                                                "text": "Sie begann das harsche strotzende Euter abzumelken."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "34bd66e2-a84a-344a-aefc-5525d0ef5d6e",
                                        "entry_id": "fa2208c7-6086-3946-9037-402c4c87b2df",
                                        "glosses": [
                                            "rau, barsch, unwirsch"
                                        ],
                                        "tags": [
                                            "Sprache",
                                            "Handlung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7382ee4-1773-400a-b111-582225924651",
                                                "sense_id": "34bd66e2-a84a-344a-aefc-5525d0ef5d6e",
                                                "text": "Deine Aussage war harsch."
                                            },
                                            {
                                                "example_id": "a8fe6f5d-943a-4490-8417-92a2fd30e64e",
                                                "sense_id": "34bd66e2-a84a-344a-aefc-5525d0ef5d6e",
                                                "text": "„Dass auch er selbst mit harschen Kommentaren die Stimmung anheizt, will er nicht gelten lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
