                "senses": [
                    {
                        "sense_id": "d6bc1f78-0189-39eb-9c24-f965011a6720",
                        "entry_id": "c85b16e9-9511-30c9-a771-fe64b5a59a79",
                        "glosses": [
                            "het geluid van iets dat zachtjes aan het koken is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7532a1e-7f27-4e2c-b8a8-37adde863808",
                                "sense_id": "d6bc1f78-0189-39eb-9c24-f965011a6720",
                                "text": "Ik hoorde het gepruttel van de koffiemachine, rook het heerlijke koffiearoma en wist dat het dus weer pauze was."
                            },
                            {
                                "example_id": "0a188cf6-d791-4ea7-ac8c-4918fd54baa2",
                                "sense_id": "d6bc1f78-0189-39eb-9c24-f965011a6720",
                                "text": "Hij creëert minimal-klanken die aanzwellen tot een dreigende storm en weer terugvallen tot fluisterzacht gepruttel. De trefzekerheid, gebracht met een duivelse grijns, werkte hypnotiserend."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4599837-533e-321e-af7e-15120cd6b692",
                        "entry_id": "c85b16e9-9511-30c9-a771-fe64b5a59a79",
                        "glosses": [
                            "het zachtjes uiten van kwaadheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36402695-d273-486b-bf2b-c626c36e268e",
                                "sense_id": "c4599837-533e-321e-af7e-15120cd6b692",
                                "text": "De docent trok zich niets aan van het gepruttel van de leerlingen die vonden dat ze te veel huiswerk opgekregen hadden."
                            },
                            {
                                "example_id": "fb5d2b85-d4dc-4ca8-87ee-5b671517ba73",
                                "sense_id": "c4599837-533e-321e-af7e-15120cd6b692",
                                "text": "Meestal gaat dat voorstel gepaard met rumoer, soms ook met geruzie, soms met alleen wat gepruttel."
                            }
                        ]
                    }
                ],
