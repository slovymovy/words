                                "target_senses": [
                                    {
                                        "sense_id": "9e70ecf2-e200-3a5e-abfe-126d84547478",
                                        "entry_id": "b04e1dae-d24b-3b29-a0f9-cea53b300b79",
                                        "glosses": [
                                            "A state of unconsciousness from which one may not wake up, usually induced by some form of trauma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd27994a-d3e3-4910-9436-e08e19fc9749",
                                                "sense_id": "9e70ecf2-e200-3a5e-abfe-126d84547478",
                                                "text": "go into a coma"
                                            },
                                            {
                                                "example_id": "1929a936-7f66-4579-9057-bc40f306da00",
                                                "sense_id": "9e70ecf2-e200-3a5e-abfe-126d84547478",
                                                "text": "slip into a coma"
                                            },
                                            {
                                                "example_id": "9ef74ff0-0863-4513-bea7-cd4bb65fc629",
                                                "sense_id": "9e70ecf2-e200-3a5e-abfe-126d84547478",
                                                "text": "come out of a coma"
                                            },
                                            {
                                                "example_id": "10ed85da-571c-4d8c-b042-26999801b579",
                                                "sense_id": "9e70ecf2-e200-3a5e-abfe-126d84547478",
                                                "text": "An a aphrodisiac, it results in santonin poisoning, followed by coma and death."
                                            },
                                            {
                                                "example_id": "119cad0c-7c13-4518-9497-b34957f5c5eb",
                                                "sense_id": "9e70ecf2-e200-3a5e-abfe-126d84547478",
                                                "text": "I wonder if a person who comes out of a coma feels refreshed and well rested."
                                            }
                                        ]
                                    }
                                ]
                            },
