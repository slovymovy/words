                    },
                    {
                        "form_id": "de53d39b-5f19-47ab-9362-23cb29354ce1",
                        "entry_id": "4eda5d9b-59b4-30cc-b9c8-5f0b96fc568c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "hypertrophiées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d41b39ea-e97b-3b7d-a72d-40fe42d810ca",
                        "entry_id": "4eda5d9b-59b4-30cc-b9c8-5f0b96fc568c",
                        "glosses": [
                            "Qui est atteint d’hypertrophie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0db10cf0-13a7-4eab-9592-59110e2d33aa",
                                "sense_id": "d41b39ea-e97b-3b7d-a72d-40fe42d810ca",
                                "text": "Les plaques de Peyer hypertrophiées siègent au niveau de la dernière portion de l’intestin grêle, au voisinage de la valvule iléo-cæcale."
                            }
                        ]
                    },
                    {
                        "sense_id": "6293c03c-173e-3b99-aeb7-02034967398f",
                        "entry_id": "4eda5d9b-59b4-30cc-b9c8-5f0b96fc568c",
                        "glosses": [
                            "Grossi exagérément."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8f9173b8-b7e5-4709-8977-f0db301a45e7",
                                "sense_id": "6293c03c-173e-3b99-aeb7-02034967398f",
                                "text": "Dans ce contexte, les imposants jardins du Versailles louis-quatorzien n’en seraient qu’un des exemples modernes les plus tardifs et hypertrophiés."
                            },
                            {
                                "example_id": "ed508a27-8493-432c-9032-5d4e629f37e8",
                                "sense_id": "6293c03c-173e-3b99-aeb7-02034967398f",
                                "text": "Trump aura incarné jusqu’au bout un ego hypertrophié – d’ailleurs, on l’oublie, mais sa campagne, plus que mauvaise, portait davantage sur sa personne que sur un programme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07b64d1b-e322-4e16-a4ca-64988b2ed796",
                        "source_entry_id": "4eda5d9b-59b4-30cc-b9c8-5f0b96fc568c",
                        "target_lang_word": "гипертрофированный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гипертрофированный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "af168105-4871-37f8-a9da-f420bd853644",
                                        "entry_id": "0d7fcb86-8220-36c7-a492-6e4150fd87ed",
                                        "glosses": [
                                            "мед. увеличенный в объёме вследствие болезни, усиленной работы и т. п."
                                        ],
                                        "tags": [
                                            "о каком-либо органе или ткани"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f799d5c-a8f5-42eb-8e8b-6ad80548de70",
                                                "sense_id": "af168105-4871-37f8-a9da-f420bd853644",
                                                "text": "При четвёртой степени вирилизации — гипертрофированный клитор напоминает нормальный половой член с пенильной уретрой, а при пятой — не отличается от полового члена мальчика."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f04f5e8-e811-3018-b60f-1cb402c1dc29",
                                        "entry_id": "0d7fcb86-8220-36c7-a492-6e4150fd87ed",
                                        "glosses": [
                                            "книжн. характеризующийся гипертрофией, чрезмерно преувеличенный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "247df608-e980-4fcc-805b-21c1d51a2efd",
                                                "sense_id": "4f04f5e8-e811-3018-b60f-1cb402c1dc29",
                                                "text": "То давление на науку, которое было произведено, очень скверно отозвалось на ней, исказив действительный образ науки, введя в чистую науку работу по специально-техническим заданиям, создав некоторый саморекламирующий дух и создав научные институты гипертрофированных размеров, совмещающие науку и технику, понизив ее уровень, и в некоторых случаях почти полностью уничтожив чистую научную работу."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "гипертрофированный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e01b913a-10e7-36b7-8b3d-b27fcb89545b",
                                        "entry_id": "b927580c-6427-39a7-be32-e4b284604005",
                                        "glosses": [
                                            "страд. прич. прош. вр. от гипертрофировать"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e41033-ac77-4e21-abd5-05e7ecccf733",
                                                "sense_id": "e01b913a-10e7-36b7-8b3d-b27fcb89545b",
                                                "text": "При эхотомографии установлено, что печень гипертрофирована, эхоструктура её гомогенная, в правой доле определяется гипоэхогенное образование, которое тянется до купола печени и сообщается с плеврой или легким."
                                            },
                                            {
                                                "example_id": "2c07c516-dce8-456e-a434-95e233c66eea",
                                                "sense_id": "e01b913a-10e7-36b7-8b3d-b27fcb89545b",
                                                "text": "Гиперактивность левого желудочка достигает средней степени, он расширен и гипертрофирован."
                                            },
                                            {
                                                "example_id": "96b73980-a5da-42b1-a156-fbd65fcc6aa8",
                                                "sense_id": "e01b913a-10e7-36b7-8b3d-b27fcb89545b",
                                                "text": "— У таких типов, как он, самолюбие гипертрофировано."
                                            },
                                            {
                                                "example_id": "e1d12375-254d-443c-8512-ec252d2408f6",
                                                "sense_id": "e01b913a-10e7-36b7-8b3d-b27fcb89545b",
                                                "text": "Совесть у него была тоже «ненормальная», гипертрофированная."
                                            },
                                            {
                                                "example_id": "a1af874b-dd27-4a6e-a31f-d512a119d3c2",
                                                "sense_id": "e01b913a-10e7-36b7-8b3d-b27fcb89545b",
                                                "text": "Тебя мог захватить и какой-нибудь дурак барон. Безо всякого злого умысла, просто от скуки и гипертрофированного гостеприимства."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
