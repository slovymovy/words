                        "entry_id": "c40e399a-4f25-389d-b41f-4836fbf9aaa9",
                        "glosses": [
                            "Wissenschaftsdisziplin, die sich mit der Erforschung afrikanischer Sprachen und Kulturen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd36a0f-994c-498c-aaab-e73e23875ce4",
                                "sense_id": "7f841b74-6594-3f4f-bf3e-3ab763390be8",
                                "text": "„Seit seiner Gymnasialzeit beschäftigt sich der in Karlsruhe Geborene mit sozialen und politischen Fragen, studierte in Köln Germanistik, Anglistik, Romanistik und Afrikawissenschaft.“"
                            },
                            {
                                "example_id": "e6ee4611-2b58-4f42-977c-994f10f49717",
                                "sense_id": "7f841b74-6594-3f4f-bf3e-3ab763390be8",
                                "text": "„Die Autorin arbeitet als Literaturwissenschaftlerin am Seminar für Afrikawissenschaften der Humboldt-Universität Berlin.“"
                            }
                        ],
