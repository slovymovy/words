                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bada5979-87f7-4c8a-ba85-f0e34361be95",
                                "sense_id": "4064bbbc-7a1b-3f64-8828-401ebe25b9ef",
                                "text": "„Als die satten Möwen ihre Mahlzeit beenden und die Fischskelette und augenlosen Schädel wie Omen des einstigen Todes des Gewässers zurücklassen, bemerkt Katie, dass der Fuchs zittert.“"
                            },
                            {
                                "example_id": "317afcdf-baef-40b1-bd7c-df6fe352864c",
                                "sense_id": "4064bbbc-7a1b-3f64-8828-401ebe25b9ef",
                                "text": "„Das Fischskelett. Seit sie zum ersten Mal einen Buntstift in der Hand hatte, malt sie nichts anderes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
