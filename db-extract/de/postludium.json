                ],
                "translations": [
                    {
                        "translation_id": "156789f3-ae7f-44c2-b89a-2f98ae5c16b2",
                        "source_entry_id": "bd74ad9d-162e-3b34-9786-e584d67d8b7d",
                        "source_sense_id": "a5d99885-96f6-38ec-af33-04e13de2bb60",
                        "source_sense_description": "musikalisches Nachspiel",
                        "target_lang_word": "postlude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postlude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3a44f1c-2f5b-354c-8593-1ecbeac7d285",
                                        "entry_id": "5aeb52c4-09bb-3f63-8a98-701c0ee3582f",
                                        "glosses": [
                                            "The final part of a piece; especially music played (normally on the organ) at the end of a church service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21136d06-9a70-496b-ae63-ad7db5ba8e70",
                                                "sense_id": "f3a44f1c-2f5b-354c-8593-1ecbeac7d285",
                                                "text": "In the Sibelian world of song, then, postludes would inevitably sound redundant or extraneous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72cff4b4-b365-3fe1-b969-9d05e9c5853d",
                                        "entry_id": "5aeb52c4-09bb-3f63-8a98-701c0ee3582f",
                                        "glosses": [
                                            "A concluding passage of text or speech; an epilogue or afterword."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b95ffdc6-53c5-47c8-a173-10f565ce44e6",
                                                "sense_id": "72cff4b4-b365-3fe1-b969-9d05e9c5853d",
                                                "text": "This was Nabokov’s postlude to Lolita, where he relates the book’s genesis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "postlude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5359eafd-4a66-3c6d-93c6-e3a9c65637c4",
                                        "entry_id": "34503af4-5fb3-33f1-bfc7-43bf89a60aa6",
                                        "glosses": [
                                            "To form a postlude (to); to end with a postlude."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ba3e40d-e357-4c9e-b167-388f7573c3b4",
                                                "sense_id": "5359eafd-4a66-3c6d-93c6-e3a9c65637c4",
                                                "text": "Mercifully never preceded by a drum-roll or postluded by a curtsey for applause, each poem seemed to arise from the surrounding prose, which Courtenay was successfully endeavouring to make sound as if it was being thought up on the spot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e14234db-1002-4f5b-a64a-b7ce1908d115",
                        "source_entry_id": "bd74ad9d-162e-3b34-9786-e584d67d8b7d",
                        "source_sense_id": "a5d99885-96f6-38ec-af33-04e13de2bb60",
                        "source_sense_description": "musikalisches Nachspiel",
                        "target_lang_word": "postlude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postlude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb9e390a-49dd-30c1-8ec2-bad0caca09fa",
                                        "entry_id": "3909c82e-b9e7-3059-ba15-fb3558f3a2ba",
                                        "glosses": [
                                            "Conclusion écrite ou improvisée d’une œuvre musicale. → voir coda"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31eb4449-c241-4f91-a0c3-122e747d410b",
                                                "sense_id": "eb9e390a-49dd-30c1-8ec2-bad0caca09fa",
                                                "text": "Voici un enregistrement très réussi de Prélude, fugue et postlude d’Arthur Honegger."
                                            },
                                            {
                                                "example_id": "e91bf406-8e9d-4464-9028-7c989bf0f716",
                                                "sense_id": "eb9e390a-49dd-30c1-8ec2-bad0caca09fa",
                                                "text": "Le postlude qui conclut est quant à lui très aride, dans les harmoniques suraigus des deux violons, avec la résonance du piano dans son registre grave et les imitations de fer-blanc, comme au départ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe4ee3b-61b8-36f5-aa94-034852ac9520",
                                        "entry_id": "3909c82e-b9e7-3059-ba15-fb3558f3a2ba",
                                        "glosses": [
                                            "Libération de l'accès à une ressource critique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeb49658-0e27-42c1-933b-a4812ce9c9a5",
                                                "sense_id": "1fe4ee3b-61b8-36f5-aa94-034852ac9520",
                                                "text": "Pour ce faire, la section critique est précédée par un prélude et est suivie par un postlude qui assurent cette propriété d'exclusion mutuelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
