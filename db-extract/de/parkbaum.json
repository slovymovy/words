                        "glosses": [
                            "Baum, der in einem Park steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fef3162-ef72-47e2-ba88-132a51a3c421",
                                "sense_id": "b28adb3f-8563-3bcb-aba0-91aa7daf2e3e",
                                "text": "„Der kühle Atem des Meeres, der durch die Parkbäume wehte, strömte in den Raum.“"
                            },
                            {
                                "example_id": "4272c814-1aca-4c05-9f72-14dfcab377e0",
                                "sense_id": "b28adb3f-8563-3bcb-aba0-91aa7daf2e3e",
                                "text": "„Dann aber nahm auch er die Mitte des Flusses und folgte den übrigen, deren Tete schon unter dem Schatten der Parkbäume verschwunden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
