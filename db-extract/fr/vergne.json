                "forms": [],
                "senses": [
                    {
                        "sense_id": "f3ee4420-5c49-3d5e-9ab6-0130f96852b2",
                        "entry_id": "b24e05f3-9521-3145-b147-650e07ff2b9e",
                        "glosses": [
