                                    {
                                        "sense_id": "af8a564d-9e78-3f87-b6a9-fbe7646b2a3d",
                                        "entry_id": "58621af2-4d2d-3fb4-8147-c4f77c7e892d",
                                        "glosses": [
                                            "jemand, der sich mit Schlittschuhen auf dem Eis fortbewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e29dd745-193c-4d8c-bc96-6bef5859a382",
                                                "sense_id": "af8a564d-9e78-3f87-b6a9-fbe7646b2a3d",
                                                "text": "Einer der Schlittschuhläufer ist gestürzt und hat sich dabei leicht verletzt."
                                            },
                                            {
                                                "example_id": "83386e5c-b46b-4906-bc43-c907d6278b16",
                                                "sense_id": "af8a564d-9e78-3f87-b6a9-fbe7646b2a3d",
                                                "text": "„Seit Montag aber können Schlittschuhläufer über die Terrasse des Bikini-Hauses am Zoo flitzen – mit Blick auf die Gedächtniskirche und den Weihnachtsmarkt auf dem Breitscheidplatz.“"
                                            },
                                            {
                                                "example_id": "1e9e905e-35db-46b3-b5ad-1f4290865a2f",
                                                "sense_id": "af8a564d-9e78-3f87-b6a9-fbe7646b2a3d",
                                                "text": "„Die Holländer waren unübersehbar begeisterte Schlittschuhläufer und auf den Winterbildern jener Zeit, so auch auf diesem des Amsterdamers Aert van der Neer (1603 bis 1677) geben sich Arm und Reich, Jung und Alt, Anfänger und Könner dem kalten Vergnügen hin.“"
                                            }
                                        ],
