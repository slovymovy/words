                    "frequency": "Low",
                    "semantic_group_id": "pavement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After driving on rough dirt roads for several hours, we were relieved to reach the smooth <w>bitumen</w>."
                        },
                        {
                            "text": "The narrow track finally gave way to wide <w>bitumen</w> near the edge of the town."
                        }
                    ],
                    "common_phrases": [
                        "on the bitumen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Australia and New Zealand"
