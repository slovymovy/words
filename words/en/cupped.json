{
    "word_family": [
        "cup",
        "cupping",
        "cupful"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "720de3a2-445f-3d40-a056-5a601af2adc5",
                    "sense_definition": "simple past and past participle of <w>cup</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cup_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gently <w>cupped</w> the injured bird in her hands.",
                            "target_lang_translations": {
                                "ru": "Она осторожно <w>держала</w> раненую птицу <w>в сложенных ладонях</w>."
                            }
                        },
                        {
                            "text": "He <w>cupped</w> his hands around his mouth to shout across the street.",
                            "target_lang_translations": {
                                "ru": "Он <w>прижал ладони ко</w> рту, чтобы крикнуть через улицу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cupped his hands",
                        "cupped her hands"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "форма прошедшего времени и причастие прошедшего времени от глагола cup; сложить ладони чашечкой или бережно держать в ладонях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложил ладони",
                                "target_lang_sense_clarification": "придать ладоням форму чашечки"
                            },
                            {
                                "target_lang_word": "держал в ладонях",
                                "target_lang_sense_clarification": "бережно обхватить руками"
                            },
                            {
                                "target_lang_word": "прижал ладони",
                                "target_lang_sense_clarification": "прикрыть руками (ко рту, ушам и т. д.)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e0d34bfb-9f1a-342d-9e2b-1a582aaf2fb5",
                    "sense_definition": "Formed into the curved shape of a cup; concave.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cup_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She drank cold water straight from her <w>cupped</w> hands.",
                            "target_lang_translations": {
                                "ru": "Она пила холодную воду прямо из <w>сложенных лодочкой</w> ладоней."
                            }
                        },
                        {
                            "text": "The fallen leaves formed a <w>cupped</w> basin that collected rainwater.",
                            "target_lang_translations": {
                                "ru": "Опавшие листья образовали <w>чашеобразное</w> углубление, в котором собиралась дождевая вода."
                            }
                        }
                    ],
                    "synonyms": [
                        "concave",
                        "hollowed"
                    ],
                    "antonyms": [
                        "convex",
                        "flat"
                    ],
                    "common_phrases": [
                        "cupped hands",
                        "cupped palms"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложенный или изогнутый в форме чашечки; вогнутый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложенный лодочкой",
                                "target_lang_sense_clarification": "о ладонях"
                            },
                            {
                                "target_lang_word": "сложенный чашечкой",
                                "target_lang_sense_clarification": "о ладонях или руках"
                            },
                            {
                                "target_lang_word": "чашеобразный",
                                "target_lang_sense_clarification": "имеющий форму чаши или углубления"
                            },
                            {
                                "target_lang_word": "вогнутый",
                                "target_lang_sense_clarification": "о форме углубления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}