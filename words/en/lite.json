                {
                    "sense_id": "fe5fdb51-e4e2-350e-8d6d-9ce656cd2398",
                    "sense_definition": "A version of a product, especially software, that has fewer features or is simpler than the full version.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "product_version",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can download the <w>lite</w> version of the app for free to see if you like it.",
                            "target_lang_translations": {
