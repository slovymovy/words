                "senses": [
                    {
                        "sense_id": "17c7d49f-cfa6-3d79-ba71-bcf04cf36704",
                        "entry_id": "411f31f6-d2db-3e6e-b414-ce5e4a76c97f",
                        "glosses": [
                            "Donner un caractère énorme à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fdfc8a5-5f0c-4710-a6b9-0fc4773fb808",
                                "sense_id": "17c7d49f-cfa6-3d79-ba71-bcf04cf36704",
                                "text": "Mais c'est typique ici et ce sur de très nombreux sujets que les gens en font trop et vont énormiser les choses!"
                            },
                            {
                                "example_id": "4be6e16a-8686-4fba-8cae-65a1b049794b",
                                "sense_id": "17c7d49f-cfa6-3d79-ba71-bcf04cf36704",
                                "text": "Je ne l'ai taillé qu'une seule fois pour \"l'énormiser\"."
                            },
                            {
                                "example_id": "8dbf1ad2-f8c4-4779-a77b-191bcf731b7c",
                                "sense_id": "17c7d49f-cfa6-3d79-ba71-bcf04cf36704",
                                "text": "Comme la technologie humaine que l'on nomme le « moi », a pu battre la campagne, s'énormiser, se diversifier indéfiniment, il voit d’un sale œil que l’on puisse venir lui grignoter ses parts de gâteaux."
                            }
                        ]
                    }
