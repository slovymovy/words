                        "form": "die Plots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "821cebbf-22e3-3be6-ac22-04d6ab984589",
                        "entry_id": "dafe684a-8b27-36d2-8d77-4d3d416f3229",
                        "glosses": [
                            "Handlung einer Geschichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb853a0c-3a3b-4693-945f-e789f9b172e8",
                                "sense_id": "821cebbf-22e3-3be6-ac22-04d6ab984589",
                                "text": "Jedem ist der Plot des Dramas bekannt."
                            },
                            {
                                "example_id": "6055d3b0-32bc-418e-b3f4-fd6c07679001",
                                "sense_id": "821cebbf-22e3-3be6-ac22-04d6ab984589",
                                "text": "„Die Nachtschwärmer kann den Plot, also die Prosodie der Ereignisse, die Zuckungen der Umstände, die düsteren Prozessionen ins Ungewisse.“"
                            },
                            {
                                "example_id": "d6219381-b1b3-4a01-8159-30d7017cd168",
                                "sense_id": "821cebbf-22e3-3be6-ac22-04d6ab984589",
                                "text": "„Bei diesen Themen und diesem Plot könnte man annehmen, es handle sich um ein realistisches Drama nach der Art des Naturalismus oder um ein psychologisches und sozialkritisches Stück des ausgehenden 19. Jahrhunderts Schnitzler'scher Provenienz.“"
                            },
                            {
                                "example_id": "bd3256bb-5c8e-47a6-9d8b-5e8edadcd5f6",
                                "sense_id": "821cebbf-22e3-3be6-ac22-04d6ab984589",
                                "text": "„Er entwickelte ihre Plots mit Fantasie weiter.“"
                            },
                            {
                                "example_id": "9b6f693e-723f-4454-954c-024c15f80b1d",
                                "sense_id": "821cebbf-22e3-3be6-ac22-04d6ab984589",
                                "text": "„Am nächsten Tag fuhren wir bei schönem Wetter durch die Côte d'Or nach Paris, die Luft war frisch gewaschen und die Hügel und Felder und Weingärten alle wie neu, und Scott war ganz aufgeräumt und glücklich und gesund und erzählte mir die Plots sämtlicher Bücher von Michael Arlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52b3ca33-3e1b-333e-a3e7-a0bc125dfd3e",
                        "entry_id": "dafe684a-8b27-36d2-8d77-4d3d416f3229",
                        "glosses": [
                            "grafische Darstellung"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "96f89f26-908d-4c04-9a59-e59f550d7464",
                                "sense_id": "52b3ca33-3e1b-333e-a3e7-a0bc125dfd3e",
                                "text": "Mit mehreren Stiften sind auch bunte Plots darstellbar."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
