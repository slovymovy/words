                        "examples": [
                            {
                                "example_id": "11d3e0da-84f3-4682-9951-199206852bed",
                                "sense_id": "900f3333-e0ba-3e96-be5e-aa5c77469957",
                                "text": "Verkoper Rolf van der Hoeven van Altena Classics uit het Overijsselse Ane knikt. Hij ziet het gebeuren. Om overeind te blijven tussen zoveel glanzend plaatwerk maken potentiële kopers meestal wat fotootjes. Wanneer ze later op de dag nog eens langs de stand lopen, weet Van der Hoeven dat het tijd is toe te slaan. Dat doe je niet met gratis matjes of een setje winterbanden, maar met een zo goed mogelijk verhaal bij de auto."
                            },
                            {
                                "example_id": "10affe0e-52f7-4c7a-82e8-0c95f1ae328c",
                                "sense_id": "900f3333-e0ba-3e96-be5e-aa5c77469957",
                                "text": "De pakketten bestaan uit carrosseriedelen die de Citroën Jumper op een HY doen lijken. Dat betekent dat er een opzetneus beschikbaar is, veel geribbeld plaatwerk en andere lichtunits.de Telegraaf REMCO SLUMP"
                            }
