{
    "word_family": [
        "insolence",
        "insolemment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "103454c4-7d5c-3f53-9fa6-1fece1a33cff",
                    "sense_definition": "Qui manque ouvertement de respect avec effronterie ou audace envers une autorité ou les convenances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a puni cet élève <w>insolent</w> qui refusait d'écouter les consignes.",
                            "target_lang_translations": {
                                "en": "The teacher punished this <w>insolent</w> pupil who refused to listen to the instructions.",
                                "ru": "Учитель наказал этого <w>дерзкого</w> ученика, который отказывался слушать указания.",
                                "de": "Der Lehrer hat diesen <w>frechen</w> Schüler bestraft, der sich weigerte, den Anweisungen zu folgen.",
                                "es": "El profesor castigó a este alumno <w>insolente</w> que se negaba a escuchar las instrucciones.",
                                "zh": "老师惩罚了这个<w>无礼</w>的学生，他拒绝听从指示。"
                            }
                        },
                        {
                            "text": "Il lui a répondu sur un ton <w>insolent</w> qui a choqué toute la classe.",
                            "target_lang_translations": {
                                "en": "He answered back in an <w>insolent</w> tone that shocked the whole class.",
                                "ru": "Он ответил ему <w>дерзким</w> тоном, который шокировал весь класс.",
                                "de": "Er antwortete ihm in einem <w>frechen</w> Ton, der die ganze Klasse schockierte.",
                                "es": "Le contestó con un tono <w>insolente</w> que chocó a toda la clase.",
                                "zh": "他用一种<w>无礼</w>的语气回答他，全班都为之震惊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "effronté",
                        "impertinent",
                        "irrespectueux"
                    ],
                    "antonyms": [
                        "respectueux",
                        "poli",
                        "déférent"
                    ],
                    "common_phrases": [
                        "ton insolent",
                        "air insolent",
                        "regard insolent"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing open disrespect or defiance toward authority or social norms.",
                        "ru": "Открыто проявляющий неуважение к власти или общепринятым нормам с вызывающей дерзостью.",
                        "de": "Offen respektlos gegenüber Autoritäten oder gesellschaftlichen Regeln, oft mit Dreistigkeit.",
                        "es": "Que falta abiertamente al respeto con descaro o atrevimiento hacia una autoridad o las normas sociales.",
                        "zh": "公然不尊重权威或社会规范，态度放肆、无礼。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rude",
                                "target_lang_sense_clarification": "casual, everyday discourteous behaviour"
                            },
                            {
                                "target_lang_word": "insolent",
                                "target_lang_sense_clarification": "defiant toward teachers or superiors"
                            },
                            {
                                "target_lang_word": "impertinent",
                                "target_lang_sense_clarification": "cheeky, disrespectful remarks"
                            }
                        ],
                        "ru": [
