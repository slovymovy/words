                                    {
                                        "sense_id": "2083767c-9b94-3b76-bb24-3f67e6e244f0",
                                        "entry_id": "d85d77c2-05fa-3980-ab47-c234f0d9ae6e",
                                        "glosses": [
                                            "A tubular protruding organ for laying eggs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d651a51-64da-4ef8-8e3d-85f289054962",
                                                "sense_id": "2083767c-9b94-3b76-bb24-3f67e6e244f0",
                                                "text": "I'm fascinated by a splendid European wasp - Rhyssa persuasoria (sabre wasp). […] It has a remarkable ovipositor. That's the multi-function \"hypodermic needle\" at the end of the abdomen, and, in this instance, it doubles the length of the wasp to about 8cm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
