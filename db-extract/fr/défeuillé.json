                ],
                "senses": [
                    {
                        "sense_id": "38f33878-012a-3e2e-b053-27e7ec39e131",
                        "entry_id": "907fc3da-b1cb-3b94-a319-c4b5c760a7d0",
                        "glosses": [
                            "Qui a perdu ses feuilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79a654cb-282f-4dca-9b59-f4e6c0917ac9",
                                "sense_id": "38f33878-012a-3e2e-b053-27e7ec39e131",
                                "text": "La campagne, encore verte et riante, mais défeuillée en partie et déjà presque déserte, offrait partout l’image de la solitude et des approches de l’hiver."
                            },
                            {
                                "example_id": "90ffb7bd-8075-4d70-a6c9-c94fe8fd59a9",
                                "sense_id": "38f33878-012a-3e2e-b053-27e7ec39e131",
                                "text": "Des arbres fruitiers en éventail sur des fils de fer, ou bien en espalier, s’étalaient à la grande lumière, un peu défeuillés, là seulement pour le fruit."
                            },
                            {
                                "example_id": "594f61a2-a780-4ebb-880b-7c117ffb83c6",
                                "sense_id": "38f33878-012a-3e2e-b053-27e7ec39e131",
                                "text": "Sous les arbres à demi défeuillés, des statues de nymphes frissonnaient dans l’ombre humide, semée de pâles lumières."
                            },
                            {
                                "example_id": "e8306697-cba0-4494-b95d-afafed494d7a",
                                "sense_id": "38f33878-012a-3e2e-b053-27e7ec39e131",
                                "text": "Enfin, ils purent aborder dans une sorte de golfe où s’était arrondie une petite prairie rousse portant quelques noisetiers défeuillés et des touffes de buis."
                            }
                        ]
                    }
