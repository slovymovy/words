        "fr-extract.jsonl": [
            {
                "entry_id": "e033ab92-e848-30b1-ba39-0172921a91fa",
                "word": "scarlatine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "df26ae71-d955-4552-95c3-407a1919131c",
                        "entry_id": "e033ab92-e848-30b1-ba39-0172921a91fa",
                        "tags": [
                            "plural"
                        ],
                        "form": "scarlatines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1cd4e9d-99fc-3f62-bd49-ab38fb7ab552",
                        "entry_id": "e033ab92-e848-30b1-ba39-0172921a91fa",
                        "glosses": [
                            "Maladie infectieuse dont un des principaux symptômes est une éruption cutanée d’aspect granité et rouge écarlate."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "578d3474-8cf9-473f-9a5c-a187dfbe5f6c",
                                "sense_id": "c1cd4e9d-99fc-3f62-bd49-ab38fb7ab552",
                                "text": "Une éruption caractéristique couvrit le corps du bébé. C’était une scarlatine d’espèce maligne, qui devait nécessairement amener une inflammation interne."
                            },
                            {
                                "example_id": "0e2db078-59d5-49eb-8e26-1be2f8feff9f",
                                "sense_id": "c1cd4e9d-99fc-3f62-bd49-ab38fb7ab552",
                                "text": "— Depuis sa petite scarlatine. Il ne consentait à boire ses potions que si je les lui présentais moi-même…\n— Ah ! M. Hyacinthe a eu la scarlatine ? s’inquiétait Mlle Caroline.\n— Oui… à l’âge de sept ans…"
                            },
                            {
                                "example_id": "eeb780d0-8700-40ce-a9bb-1cc77b84da9c",
                                "sense_id": "c1cd4e9d-99fc-3f62-bd49-ab38fb7ab552",
                                "text": "[…] je te répondrai que l’on n’a jamais prétendu non plus, avec le seul secours du bon sens, guérir la coqueluche ou la scarlatine."
                            },
                            {
                                "example_id": "f53f72fc-41c0-483c-aec9-55bb3a0cd9fc",
                                "sense_id": "c1cd4e9d-99fc-3f62-bd49-ab38fb7ab552",
                                "text": "La scarlatine est une angine streptococcique accompagnée d'une éruption cutanée due à la sécrétion de toxine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9ca623e-ef64-4dc3-8c46-059e7fd5401d",
                        "source_entry_id": "e033ab92-e848-30b1-ba39-0172921a91fa",
                        "source_sense_id": "c1cd4e9d-99fc-3f62-bd49-ab38fb7ab552",
                        "source_sense_description": "arabe marocaine:حصبة لالمنية",
                        "target_lang_word": "Scharlach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scharlach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c8d55e-441d-313e-ae9d-f6fd364582d6",
                                        "entry_id": "4f9c6f4a-48c2-3e84-b9dd-f47e57b6bef7",
                                        "glosses": [
                                            "hellrote Farbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c16fb0e9-983e-4519-842b-007ef366aedc",
                                                "sense_id": "c6c8d55e-441d-313e-ae9d-f6fd364582d6",
                                                "text": "In meiner Palette fehlt noch Scharlach."
                                            },
                                            {
                                                "example_id": "d7a5a20c-2c54-4e57-91d6-5a0d728fc461",
                                                "sense_id": "c6c8d55e-441d-313e-ae9d-f6fd364582d6",
                                                "text": "„Ein paar goldene Ohrringe und Bracelets von demselben Metalle, Halbstiefeln von Scharlach und der Alligatorhaut vollendeten das zierliche Äußere dieser interessanten Gestalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ada2f195-b974-3e27-bbf8-34473616f45f",
                                        "entry_id": "4f9c6f4a-48c2-3e84-b9dd-f47e57b6bef7",
                                        "glosses": [
                                            "rot gefärbter Stoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138d77db-8b26-4dbd-9c8d-6c1fcb736c3f",
                                                "sense_id": "ada2f195-b974-3e27-bbf8-34473616f45f",
                                                "text": "„Ein paar goldene Ohrringe und Bracelets von demselben Metalle, Halbstiefeln von Scharlach und der Alligatorhaut vollendeten das zierliche Äußere dieser interessanten Gestalt.“"
                                            },
                                            {
                                                "example_id": "7c970203-592e-4939-903d-7bae62505cdd",
                                                "sense_id": "ada2f195-b974-3e27-bbf8-34473616f45f",
                                                "text": "Manche Bürgerkleider waren noch in Scharlach."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Scharlach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a30b1d6d-16ba-3d58-ba86-09252a0d42b7",
                                        "entry_id": "508a695b-6c5a-387b-bd1a-edaac67b33f0",
                                        "glosses": [
                                            "fiebrige Krankheit mit rotem Hautausschlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab7820e-5401-45b2-852f-874e7f685de1",
                                                "sense_id": "a30b1d6d-16ba-3d58-ba86-09252a0d42b7",
                                                "text": "Für Kleinkinder ist Scharlach eine gefährliche Krankheit."
                                            },
                                            {
                                                "example_id": "d727368b-f0dd-4b8c-9700-8abbb828ae98",
                                                "sense_id": "a30b1d6d-16ba-3d58-ba86-09252a0d42b7",
                                                "text": "„Die Abgabe von Lebensmitteln aus Verkaufsstätten, Häusern oder erforderlichenfalls aus einzelnen Ortsgebieten, in denen Scharlach, Diphtherie, Abdominaltyphus, Paratyphus, Ruhr, Flecktyphus, Blattern, Asiatische Cholera, Pest oder Ägyptische Augenentzündung aufgetreten ist, kann untersagt oder von bestimmten Vorsichten abhängig gemacht werden.“"
                                            },
                                            {
                                                "example_id": "8e2fd5be-34b8-4ed0-bebc-311949744029",
                                                "sense_id": "a30b1d6d-16ba-3d58-ba86-09252a0d42b7",
                                                "text": "„Der wichtigste Grund, auch heute noch Penicillin zu benutzen, sind die Komplikationen bei Scharlach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a0a3fad-d2f6-4584-9140-34c986126e6a",
                        "source_entry_id": "e033ab92-e848-30b1-ba39-0172921a91fa",
                        "source_sense_id": "c1cd4e9d-99fc-3f62-bd49-ab38fb7ab552",
                        "source_sense_description": "arabe marocaine:حصبة لالمنية",
                        "target_lang_word": "scarlet fever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scarlet fever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6b58e00-c5cb-3717-a214-edc0614eae73",
                                        "entry_id": "246e8144-c57b-31e3-990c-9570c03cf553",
                                        "glosses": [
                                            "A streptococcal infection, mainly occurring among children, and characterized by a red skin rash, sore throat and fever."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc2cca52-e757-4f71-b602-2c2df442d719",
                                                "sense_id": "d6b58e00-c5cb-3717-a214-edc0614eae73",
                                                "text": "\"I am sure,\" replied Mrs. Palmer, \"if it were not wicked, I should be glad that you had the scarlet fever; I am so much happier since I knew you..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d7dc28e-270a-3d4f-aa5f-26d7eab8eaeb",
                                        "entry_id": "246e8144-c57b-31e3-990c-9570c03cf553",
                                        "glosses": [
                                            "Romantic attraction to soldiers in preference to other people."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe11ee2-24b5-4569-bb2b-89d66227301e",
                                                "sense_id": "6d7dc28e-270a-3d4f-aa5f-26d7eab8eaeb",
                                                "text": "Soldiers are notorious for hunting up these women, especially nurse-maids and those that in the execution of their duty walk in the Parks, when they may easily be accosted. Nurse-maids feel flattered by the attention that is lavished upon them, and are always ready to succumb to the “scarlet fever.” A red coat is all powerful with this class, who prefer a soldier to a servant, or any other description of man they come in contact with."
                                            },
                                            {
                                                "example_id": "33ec3513-850d-42c0-867c-26ecdd340bb9",
                                                "sense_id": "6d7dc28e-270a-3d4f-aa5f-26d7eab8eaeb",
                                                "text": "According to Henry Mayhew, it was here that housemaids and nursemaids walking in the park to and from their place of work often first encountered “the all powerful red coat” and “succumbed to Scarlet Fever.” Soldiers were by no means unaware of the impact their dashing uniforms and well-groomed military air could have on young women, and deployed these features to their advantage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
