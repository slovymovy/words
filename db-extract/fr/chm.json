                        "glosses": [
                            "Centre héliomarin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5446b91-85bb-4555-b824-286aed7df5b0",
                                "sense_id": "4c9e0f16-c5e3-385d-bd0c-d14a71fe2c99",
                                "text": "Placé au sud de la commune de Vendays-Montalivet, sur le littoral du Médoc à 85 kilomètres au nord-ouest de Bordeaux, le centre héliomarin de Vendays-Montalivet (dit CHM ou « Monta ») est depuis 1950 le plus ancien centre de vacances naturiste familial du monde."
                            },
                            {
                                "example_id": "b5134f37-f480-4e0f-badf-3b7dde36f03f",
                                "sense_id": "4c9e0f16-c5e3-385d-bd0c-d14a71fe2c99",
                                "text": "L’histoire du CHM de Montalivet – Monta pour les intimes – commence en 1949 lorsque quelques naturistes, menés par Albert Lecocq, sont autorisés à louer un terrain incendié dans la forêt, entre Montalivet et le Pin-Sec."
                            },
                            {
                                "example_id": "86a74756-c2ec-440d-b9ce-671d7ec74c96",
                                "sense_id": "4c9e0f16-c5e3-385d-bd0c-d14a71fe2c99",
                                "text": "Le CHM de Vallauris est un établissement de rééducation spécialisé dans la prise en charge des affections de l’appareil locomoteur et neurologiques ainsi que des amputations."
                            }
                        ]
                    }
