                                        "glosses": [
                                            "tot vervelens toe herhalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb67b973-2b89-4568-977c-754e7d3f9db1",
                                                "sense_id": "a89fa9bc-0df2-316d-b8d7-e05520199f45",
                                                "text": "Het is een goede zaak dat een genrefilmer in tijden van het grote herkauwen in Hollywood de lat bewust hoger legt en de intelligentie van zijn publiek niet onderschat, maar Triangle zit zo gekunsteld in elkaar dat de personages zetstukken in het schaakspel van de maker blijven."
                                            }
