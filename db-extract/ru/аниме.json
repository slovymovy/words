                ],
                "senses": [
                    {
                        "sense_id": "ecbb2649-6469-39ee-92b9-03c576b34fc3",
                        "entry_id": "95e53415-ed9e-3f63-b7a2-f75b12c2973c",
                        "glosses": [
                            "возникший в Японии жанр мультипликации, отличающийся характерной графичной манерой отрисовки персонажей и фонов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c07d4893-8e82-4b00-b462-ea04c878f9b3",
                                "sense_id": "ecbb2649-6469-39ee-92b9-03c576b34fc3",
                                "text": "Японец Ясуси Ватанабэ, изучающий историю аниме, обнаружил в своей коллекции один из ранних мультфильмов Уолта Диснея о кролике Освальде."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44a4a820-cbfe-4d91-abac-eecdb83f36da",
                        "source_entry_id": "95e53415-ed9e-3f63-b7a2-f75b12c2973c",
                        "source_sense_id": "ecbb2649-6469-39ee-92b9-03c576b34fc3",
                        "target_lang_word": "anime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc950ff6-4eb4-3ed6-b521-1eaa07b2104a",
                                        "entry_id": "029ca58e-fe7f-3617-9429-cf1ea91f696d",
                                        "glosses": [
                                            "An artistic style originating in, and associated with, Japanese animation, and that has also been adopted by a comparatively low number of animated works from other countries."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0021c21-52ac-4047-bf1e-222f5e892ca8",
                                                "sense_id": "fc950ff6-4eb4-3ed6-b521-1eaa07b2104a",
                                                "text": "I can draw an anime version of you, if you want."
                                            },
                                            {
                                                "example_id": "55a91e34-8f2a-4067-bcd1-6c813bf61ead",
                                                "sense_id": "fc950ff6-4eb4-3ed6-b521-1eaa07b2104a",
                                                "text": "Touching on themes as disparate as sex, death, science fiction and romance, manga and anime catered to all ages and tastes. Commercial hits like “Pokémon” and “Dragon Ball Z,” meanwhile, projected a new image of Japan to the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "364725a2-c9db-3522-a5a4-434cb59493f1",
                                        "entry_id": "029ca58e-fe7f-3617-9429-cf1ea91f696d",
                                        "glosses": [
                                            "An animated work that originated in Japan, regardless of the artistic style."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c2dceb3-d74c-4c85-b2e0-583b3e251f98",
                                                "sense_id": "364725a2-c9db-3522-a5a4-434cb59493f1",
                                                "text": "Gotta get in tune with Sailor Moon / 'Cause that cartoon has got the boom anime babes / That make me think the wrong thing"
                                            },
                                            {
                                                "example_id": "107ff09f-b08d-4d71-b722-f3330abf6440",
                                                "sense_id": "364725a2-c9db-3522-a5a4-434cb59493f1",
                                                "text": "After three months of successful sales in manga form, it was made into an anime for television."
                                            },
                                            {
                                                "example_id": "d924d599-c243-4efc-88fd-bc3323352757",
                                                "sense_id": "364725a2-c9db-3522-a5a4-434cb59493f1",
                                                "text": "Usually the manga comes first, though it may be an offshoot of a novel, and an anime may be inspired by a video game."
                                            },
                                            {
                                                "example_id": "48fa7250-522d-4d3c-9224-3dbf7444605e",
                                                "sense_id": "364725a2-c9db-3522-a5a4-434cb59493f1",
                                                "text": "These anime prepared the way for Otaku no video, a two-part Original Video Animation (OVA)."
                                            },
                                            {
                                                "example_id": "a34f1fbe-b537-4895-9ad4-c106ee3d9876",
                                                "sense_id": "364725a2-c9db-3522-a5a4-434cb59493f1",
                                                "text": "Originally found in the opening dialogue sequence from the 1989 Japanese space shoot’em up game “Zero Wing,” this awkward translation of the phrase “all of your bases are under our control” swept across gaming message boards and forums in the late 1990s, giving rise to one of the first epic-scale “Photoshop memes” based on poorly translated quotes from Japanese video games and animes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e653caec-6108-3fd9-aa9f-6851295c91aa",
                                        "entry_id": "029ca58e-fe7f-3617-9429-cf1ea91f696d",
                                        "glosses": [
                                            "An animated work, regardless of the country of origin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "proscribed",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "anime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11e64021-26a3-3cfa-8c48-9ac499fba81d",
