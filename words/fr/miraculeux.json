            "senses": [
                {
                    "sense_id": "69886cd0-f4b1-3b1e-af6a-8f014dedf9ab",
                    "sense_definition": "Qui est tout à fait extraordinaire, inespéré ou providentiel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur est sorti indemne de cet accident grâce à un sauvetage <w>miraculeux</w>."
                        },
                        {
                            "text": "Après des mois de traitement difficile, le patient a connu une guérison <w>miraculeuse</w>."
                        }
                    ],
                    "synonyms": [
                        "extraordinaire",
                        "inespéré",
                        "providentiel"
                    ],
                    "antonyms": [
                        "ordinaire",
                        "prévisible"
                    ],
                    "common_phrases": [
                        "guérison miraculeuse",
                        "pêche miraculeuse",
                        "sauvetage miraculeux"
                    ]
                },
                {
                    "sense_id": "f20a2433-6aeb-3590-bd51-f561cf171a84",
                    "sense_definition": "Qui s'est produit par miracle, en dehors des lois naturelles ou par intervention divine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surnaturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'Église examine avec prudence chaque événement qualifié de fait <w>miraculeux</w>."
                        },
                        {
                            "text": "Les pèlerins racontent de nombreuses apparitions <w>miraculeuses</w> dans ce sanctuaire isolé."
                        }
                    ],
                    "synonyms": [
                        "prodigieux",
                        "surnaturel"
                    ],
                    "antonyms": [
                        "naturel"
                    ],
                    "common_phrases": [
                        "apparition miraculeuse",
                        "fait miraculeux"
                    ]
                },
                {
                    "sense_id": "c427b22e-1764-39b9-bf1e-97753c7c7125",
                    "sense_definition": "Qui a le pouvoir ou la vertu d'opérer des miracles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surnaturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La croyante portait toujours une médaille <w>miraculeuse</w> autour du cou pour la protéger."
                        },
                        {
                            "text": "De nombreux malades viennent boire l'eau de cette source réputée <w>miraculeuse</w>."
                        }
                    ],
                    "synonyms": [
                        "thaumaturge"
                    ],
                    "common_phrases": [
                        "eau miraculeuse",
                        "médaille miraculeuse",
                        "source miraculeuse"
                    ]
                }
            ]
