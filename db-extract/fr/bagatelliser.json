        "fr-extract.jsonl": [
            {
                "entry_id": "f4fa01a8-01c2-39eb-b575-6255360a8bd3",
                "word": "bagatelliser",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "178b4377-a278-3c91-9873-1e75fa6e7779",
                        "entry_id": "f4fa01a8-01c2-39eb-b575-6255360a8bd3",
                        "glosses": [
                            "Prendre à la légère, minimiser, trivialiser, ne pas accorder d’importance à quelque chose."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dad07377-145f-43be-b1db-56bf2b9cc13a",
                                "sense_id": "178b4377-a278-3c91-9873-1e75fa6e7779",
                                "text": "Elle adopte alors la tendance de tout \"bagatelliser\", qu’elle a critiquée au début de son livre."
                            },
                            {
                                "example_id": "8e434ccb-0cda-403d-baf8-4628485552c1",
                                "sense_id": "178b4377-a278-3c91-9873-1e75fa6e7779",
                                "text": "La calvitie est souvent le résultat de processus génétiques, de stress, de maladie ou d’alimentation. La plupart des hommes bagatellisent ce problème en voyant leurs premiers cheveux tomber. C’est seulement lorsque le problème devient vraiment visible à cause de trous dans la chevelure, ou en cas de diminution de la densification de la chevelure, que les hommes se décident à lutter contre le problème."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9c6dd2e-b860-4ec5-b4b4-5b21a4d10fad",
                        "source_entry_id": "f4fa01a8-01c2-39eb-b575-6255360a8bd3",
                        "source_sense_id": "178b4377-a278-3c91-9873-1e75fa6e7779",
                        "target_lang_word": "bagatellisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bagatellisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                        "entry_id": "251f4f29-eeeb-388d-865c-2c0038635d20",
                                        "glosses": [
                                            "(eine Sache) als Bagatelle ansehen, behandeln, darstellen, als geringfügig und unbedeutend hinstellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42893af2-77fe-4c95-81fe-44d6a9d4781c",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "Man sollte die Tatsache, dass die Einkommen sich immer weiter auseinanderentwickeln, nicht bagatellisieren."
                                            },
                                            {
                                                "example_id": "377a86a1-461d-459c-9f96-fa34af244956",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Es fällt gewiß niemanden ein, die Verfaſſungsänderung in dem großen ruſſiſchen Reich bagatelliſieren zu wollen.“"
                                            },
                                            {
                                                "example_id": "3a262c0d-e95f-4a52-aa1e-cbcf127de7d5",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Mit ernsten Gesichtern bagatellisierten die Amerikaner: Moskau hat schon öfters in Teheran protestiert.“"
                                            },
                                            {
                                                "example_id": "174bc4c2-ac0d-4f27-b1e9-65c7e7427bc1",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Aber Birfacker muß doch wieder dazwischenfahren: Bagatellisieren Sie die Angelegenheit nicht, ich habe meine Erfahrungen, und ich habe mir erlaubt, Ihnen darzustellen, wie der Fall gesehen werden muß.“"
                                            },
                                            {
                                                "example_id": "8da31ef4-b169-4e43-bed1-4f2d820dd95a",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Aus Gründen, die auf der Hand liegen, brachten die republikanische Regierung und die Kommunistische Partei damals diese Version unter die Leute: beide waren daran interessiert, den Konflikt zwischen Anarchisten und Kommunisten zu bagatellisieren.“"
                                            },
                                            {
                                                "example_id": "c9b4f610-7d70-4f04-ae68-49aa3a137470",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Ich bin mir völlig im klaren über die vielen Unterschiede, die zwischen den einzelnen osteuropäischen Staaten, zum Beispiel zwischen Polen und der Tschechoslowakei, bestehen. Ich bagatellisiere diese Unterschiede nicht – ihnen habe ich es zu verdanken, daß ich leben kann.“"
                                            },
                                            {
                                                "example_id": "93020876-4548-4500-b78f-34e89c82cf47",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Aber Wallmann fürchtet vor allem den Vorwurf, er bagatellisiere und verharmlose die Probleme.“"
                                            },
                                            {
                                                "example_id": "11d5ca3c-eddb-4e68-98b5-1b50d48eaa4a",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Schlimm genug das Ganze, aber noch lange kein Grund, die jetzt immer dreister auftretenden Neonazis zu bagatellisieren.“"
                                            },
                                            {
                                                "example_id": "aa078a7f-b823-4773-b527-3e2db008126f",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Ein früher Hinweis darauf, daß der Inhalt schon bald Gegenstand öffentlicher Erörterungen geworden war, hätte ausgesehen, als wolle ich die Leckage bagatellisieren.“"
                                            },
                                            {
                                                "example_id": "b827b84b-f9a0-4b67-8b88-f25671e4220d",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Und so ist es um das Verfahren gegen den RAF-Aussteiger Peter-Jürgen Boock still geworden, nachdem dieser öffentlich eingestanden hat, daß er seine Beteiligung an den mit mehreren Morden verbundenen Anschlägen gegen Jürgen Ponto und Hanns-Martin Schleyer wahrheitswidrig bagatellisiert hatte.“"
                                            },
                                            {
                                                "example_id": "61c3abc8-cce3-44a8-b26a-d1e23ee36020",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Selbst mir gegenüber bagatellisiert sie ihre Gebrechen und will auch mich auf keinen Fall bemitleiden.“"
                                            },
                                            {
                                                "example_id": "3498508f-f0b9-4ee2-aff8-31ccdf5e3c7c",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Die Bestrebungen der Verfassungsbehörden, die Vorfälle offensichtlich zu bagatellisieren, lassen mich ernsthaft an der Arbeit dieser Behörden zweifeln.“"
                                            },
                                            {
                                                "example_id": "e35132f5-ead2-4084-a890-7ff40e97a887",
                                                "sense_id": "5e18c739-5025-3024-871b-e170ef954d87",
                                                "text": "„Die Verwendung demokratischer Phrasen im Munde eines mit dem europäischen Faschismus Sympathisierenden soll vielmehr den Eindruck erwecken, der Unterschied zwischen Faschismus und Demokratie sei gar nicht so groß, wie behauptet wird, oder, genauer, er bestehe in Wirklichkeit gar nicht. Der Agitator versucht ja ständig, diese Differenz zu bagatellisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
