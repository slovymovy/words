                        "examples": [
                            {
                                "example_id": "4496b170-012a-4582-b84c-ed5cc9b1e376",
                                "sense_id": "4749b151-c592-3a57-b7c8-92a31408985d",
                                "text": "Jij met je jarenlange heroïneverslaving, die drie keer per dag gevoed moest worden, hebt oneindig veel minder troep gemaakt."
                            },
                            {
                                "example_id": "b50bf93d-819a-46b1-ba08-43a769c27bd6",
                                "sense_id": "4749b151-c592-3a57-b7c8-92a31408985d",
                                "text": "Twaalf jaar lang was het leven van Rick Melcher (55) een ware hel. Wat begon als een simpele voetblessure eindigde voor hem in een nachtmerrie. Om zijn blessure te behandelen kreeg hij methadon voorgeschreven van de huisarts. Hij raakte verslaafd aan het medicijn en kwam in een spiraal terecht die uiteindelijk leidde tot heroïneverslaving."
                            }
                        ]
