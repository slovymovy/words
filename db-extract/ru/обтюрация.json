                "senses": [
                    {
                        "sense_id": "f92f443b-5135-3c71-9462-e75783007854",
                        "entry_id": "195cf4cc-185f-3ae9-ac86-0712fb684420",
                        "glosses": [
                            "воен. предотвращение прорыва пороховых газов между стенками канала ствола и гильзой или снарядом в огнестрельном оружии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "199960e6-810e-4660-8e74-e5f69549a520",
                                "sense_id": "f92f443b-5135-3c71-9462-e75783007854",
                                "text": "Считается, что полигональная нарезка обеспечивает лучшую обтюрацию пороховых газов."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3e4f8f3-fbea-3aec-9143-3a80d7769673",
                        "entry_id": "195cf4cc-185f-3ae9-ac86-0712fb684420",
                        "glosses": [
                            "уплотнительная манжета на отверстии гидрокостюма или его части"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f98189-a266-4aed-8891-956b676b21db",
                                "sense_id": "b3e4f8f3-fbea-3aec-9143-3a80d7769673",
                                "text": "Мягкая неопреновая обтюрация на руках и ногах не даст лишней воде проникнуть под костюм."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae579317-4cd7-321a-aa20-3ed1655dd610",
                        "entry_id": "195cf4cc-185f-3ae9-ac86-0712fb684420",
                        "glosses": [
                            "герметичность части гидрокостюма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d15970a8-d789-4070-ada1-68bf683768cd",
                                "sense_id": "ae579317-4cd7-321a-aa20-3ed1655dd610",
                                "text": "Обтюрация улучшается при помощи круговых липучек на запястье."
                            }
                        ]
                    }
