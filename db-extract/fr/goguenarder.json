                                "target_senses": [
                                    {
                                        "sense_id": "607316fe-9aed-3f9e-b9d9-12813e5cf2ee",
                                        "entry_id": "f6d7e6f0-ddd5-315f-8b90-4b4965c37065",
                                        "glosses": [
