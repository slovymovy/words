    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5e184ae-81fe-3234-99db-dd72d1abfbeb",
                    "sense_definition": "Een bedrag aan geld dat men aan iets besteedt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "financiën",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Om de kosten te drukken, zullen de <w>uitgaven</w> deze maand moeten zakken.",
                            "target_lang_translations": {
                                "en": "To reduce costs, <w>spending</w> will have to decrease this month.",
                                "ru": "Чтобы снизить расходы, <w>траты</w> в этом месяце должны будут сократиться."
                            }
                        },
                        {
                            "text": "Zijn maandelijkse <w>uitgave</w> aan huur is de grootste kostenpost in zijn budget.",
                            "target_lang_translations": {
                                "en": "His monthly <w>expenditure</w> on rent is the largest item in his budget.",
                                "ru": "Его ежемесячный <w>расход</w> на аренду — самая большая статья расходов в его бюджете."
                            }
                        }
                    ],
                    "antonyms": [
                        "inkomst"
                    ],
                    "common_phrases": [
                        "maandelijkse uitgave",
                        "onvoorziene uitgave"
                    ],
                    "target_lang_definitions": {
                        "en": "An amount of money spent on something.",
                        "ru": "Сумма денег, потраченная на что-либо."
                    },
                    "translations": {
