            "senses": [
                {
                    "sense_id": "167c80f1-020e-3d33-92b8-b6864900f45c",
                    "sense_definition": "Manifester son mécontentement ou sa mauvaise humeur en marmonnant entre ses dents.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grommeler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme ne cesse de <w>bougonner</w> dès que la météo devient pluvieuse."
                        },
                        {
                            "text": "Il est parti en colère en <w>bougonnant</w> des paroles incompréhensibles."
                        }
                    ],
                    "synonyms": [
                        "grommeler",
                        "marmonner",
                        "ronchonner",
                        "rouspéter"
                    ],
                    "antonyms": [
                        "se réjouir"
                    ],
                    "common_phrases": [
                        "bougonner entre ses dents",
                        "continuer de bougonner"
                    ]
                },
                {
                    "sense_id": "8597f4b2-ed84-398a-b9e2-8f04e38c02ae",
                    "sense_definition": "Bouder ou montrer un air renfrogné et mécontent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bouder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis ce matin, l'enfant <w>bougonne</w> sur sa chaise sans dire un seul mot."
                        },
                        {
                            "text": "Au lieu de coopérer avec le groupe, il <w>bougonne</w> tout seul dans son coin."
                        }
                    ],
                    "synonyms": [
                        "bouder",
                        "maugréer"
                    ],
                    "common_phrases": [
                        "bougonner dans son coin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "bc1d6dd1-8c78-3f89-addb-4a2aa83e6ffc",
                    "sense_definition": "Adresser des reproches à quelqu'un, quereller vivement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reprocher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maître d'apprentissage <w>bougonna</w> l'artisan sans ménagement pour cette maladresse évidente."
                        },
                        {
                            "text": "Elle craignait toujours qu'on ne vienne la <w>bougonner</w> dès qu'elle rentrait chez elle."
                        }
                    ],
                    "synonyms": [
                        "gronder",
                        "quereller",
                        "réprimander"
                    ],
                    "antonyms": [
                        "féliciter",
                        "louer"
                    ],
                    "traits": [
