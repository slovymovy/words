                        "examples": [
                            {
                                "example_id": "a5533746-0226-4ada-b6be-42538f238952",
                                "sense_id": "5781a8ff-9950-3f2c-a6f8-2caa6e73abb9",
                                "text": "‘De bagatellisering past in een bredere ontkenning van racisme in Nederland. We grijpen alles aan om het maar niet over racisme te hebben.’"
                            },
                            {
                                "example_id": "56c31321-6918-4b3a-9494-58f0c3bcf70d",
                                "sense_id": "5781a8ff-9950-3f2c-a6f8-2caa6e73abb9",
                                "text": "Steeds? Sinds begin 2015 schreef Trouw meestal over hoofddoeken, niet hoofddoekjes.. Hoofddoekjes kwam 26 keer voor. Medewerkers en vooral redacteuren bedienden zich er 18 keer van. Daarnaast stond het 8 maal in citaten, meestal van PVV'ers, zelden tot bagatellisering van Wilders 'kopvodden' geneigd."
                            },
                            {
                                "example_id": "bd4cbb7e-19ef-40a7-96e7-7652a723055b",
                                "sense_id": "5781a8ff-9950-3f2c-a6f8-2caa6e73abb9",
                                "text": "Het valt op dat ook het meest sociale type al snel tot drie à vier eenzaamheidspunten komt, en op een minder dagje tot acht of negen. Bijna iedereen kent het gevoel, zegt onderzoeker Gerine Lodder. Dat maakt het probleem ‘herkenbaar’, en tegelijk vatbaar voor bagatellisering."
                            }
                        ]
