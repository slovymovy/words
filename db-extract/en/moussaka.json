                                "target_senses": [
                                    {
                                        "sense_id": "838d8161-50f4-38ea-8737-bd48ace91e87",
                                        "entry_id": "55133717-1643-3208-814a-a499242e8478",
                                        "glosses": [
                                            "zapiekanka z bakłażanów, mielonego mięsa i ziemniaków znana z kuchni bałkańskiej i tureckiej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90ee09a1-3626-4c1c-8231-3726d86bec62",
                                                "sense_id": "838d8161-50f4-38ea-8737-bd48ace91e87",
                                                "text": "Kiedy jest okazja do świętowania, jak zdanie egzaminu czy ukończenie eseju, schodzą, żeby zjeść musakę, okrę, taramosalatę, łatę jagnięcą czy ośmiornicę przy drewnianych, lakierowanych stołach, które wyglądają, jakby przyniesiono je tu prosto ze starego żaglowca"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb619109-790b-43f3-b18e-fc63dd652085",
                        "source_entry_id": "7acc8226-45ae-3882-90c5-177b8bd3aeb6",
                        "source_sense_id": "e2f58075-bc95-33ce-a678-f5b64330fbd6",
