            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9e25955-910a-3c03-8cb7-185ef4cfb77f",
                    "sense_definition": "Participe passé masculin singulier du verbe <w>agiter</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>agité</w> la main pour saluer ses amis qui partaient en vacances d'été.",
                            "target_lang_translations": {
                                "en": "He <w>waved</w> his hand to greet his friends who were leaving for their summer holidays.",
                                "ru": "Он <w>помахал</w> рукой, приветствуя друзей, которые уезжали в летний отпуск.",
                                "de": "Er <w>winkte</w> mit der Hand, um seine Freunde zu verabschieden, die in den Sommerurlaub fuhren.",
                                "es": "<w>Agitó</w> la mano para saludar a sus amigos, que se marchaban de vacaciones de verano.",
                                "zh": "他<w>挥动</w>着手，向即将去度暑假的朋友们道别。"
                            }
                        },
                        {
                            "text": "Le vent violent a <w>agité</w> les branches des arbres durant tout l'après-midi.",
                            "target_lang_translations": {
                                "en": "The strong wind <w>shook</w> the branches of the trees all afternoon.",
                                "ru": "Сильный ветер всю вторую половину дня <w>трепал</w> ветви деревьев.",
                                "de": "Der starke Wind <w>schüttelte</w> den ganzen Nachmittag über die Zweige der Bäume.",
                                "es": "El viento fuerte <w>agitó</w> las ramas de los árboles durante toda la tarde.",
                                "zh": "整个下午，狂风都在<w>摇动</w>树枝。"
                            }
                        }
                    ],
                    "synonyms": [
                        "remué",
                        "secoué"
                    ],
                    "common_phrases": [
                        "avoir agité la main",
                        "avoir agité le drapeau"
                    ],
                    "target_lang_definitions": {
                        "en": "Masculine singular past participle of the verb agiter, meaning to shake, stir or wave.",
                        "ru": "Причастие прошедшего времени мужского рода единственного числа от глагола, означающего трясти, встряхивать или махать.",
                        "de": "Maskuline Singularform des Partizips Perfekt von agiter, bedeutet schütteln, rühren oder winken.",
                        "es": "Forma masculina singular del participio pasado de agitar, que significa mover o sacudir algo de un lado a otro.",
                        "zh": "动词的阳性单数过去分词形式，表示摇动、挥动或搅动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shake",
                                "target_lang_sense_clarification": "to move back and forth"
                            },
                            {
                                "target_lang_word": "wave",
                                "target_lang_sense_clarification": "to move a hand or flag"
                            },
                            {
                                "target_lang_word": "agitate",
                                "target_lang_sense_clarification": "formal, to shake or stir vigorously"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "махать",
                                "target_lang_sense_clarification": "рукой или флагом"
                            },
                            {
                                "target_lang_word": "трясти",
                                "target_lang_sense_clarification": "из стороны в сторону"
                            },
                            {
                                "target_lang_word": "встряхивать",
                                "target_lang_sense_clarification": "резкими движениями"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schütteln",
                                "target_lang_sense_clarification": "hin und her bewegen"
                            },
                            {
                                "target_lang_word": "winken",
                                "target_lang_sense_clarification": "mit Hand oder Fahne"
                            },
                            {
                                "target_lang_word": "rühren",
                                "target_lang_sense_clarification": "Flüssigkeit umrühren"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "agitar",
                                "target_lang_sense_clarification": "saludar moviendo la mano"
                            },
                            {
                                "target_lang_word": "sacudir",
                                "target_lang_sense_clarification": "de un lado a otro"
                            },
                            {
                                "target_lang_word": "remover",
                                "target_lang_sense_clarification": "líquidos o sustancias"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挥动",
                                "target_lang_sense_clarification": "挥舞手臂或旗帜"
                            },
                            {
                                "target_lang_word": "摇动",
                                "target_lang_sense_clarification": "来回晃动"
                            },
                            {
                                "target_lang_word": "搅动",
                                "target_lang_sense_clarification": "搅拌液体或使其翻动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1310ea2b-8b16-3101-a376-7cc734d3d0b9",
                    "sense_definition": "Personne qui présente un comportement violent, désordonné ou incontrôlable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les infirmiers ont dû maîtriser un <w>agité</w> qui criait dans les couloirs de l'hôpital.",
                            "target_lang_translations": {
                                "en": "The nurses had to restrain an <w>agitated</w> man who was shouting in the hospital corridors.",
                                "ru": "Медбратьям пришлось скрутить <w>буяна</w>, который кричал в коридорах больницы.",
                                "de": "Die Pfleger mussten einen <w>Randalierer</w> bändigen, der in den Gängen des Krankenhauses schrie.",
                                "es": "Los enfermeros tuvieron que reducir a un <w>energúmeno</w> que gritaba por los pasillos del hospital.",
                                "zh": "护士们不得不制服一个在医院走廊里大喊大叫的<w>闹事者</w>。"
                            }
                        },
                        {
                            "text": "Ce jeune homme se comporte comme un véritable <w>agité</w> dès qu'on ose le contredire.",
                            "target_lang_translations": {
                                "en": "This young man behaves like a real <w>hothead</w> as soon as anyone dares to contradict him.",
                                "ru": "Этот молодой человек ведёт себя как настоящий <w>дебошир</w>, стоит только кому-то осмелиться ему возразить.",
                                "de": "Dieser junge Mann benimmt sich wie ein echter <w>Krawallmacher</w>, sobald man es wagt, ihm zu widersprechen.",
                                "es": "Este joven se comporta como un verdadero <w>exaltado</w> en cuanto alguien se atreve a contradecirle.",
                                "zh": "只要有人敢反驳他，这个年轻人就表现得像个十足的<w>闹事者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forcené",
                        "perturbateur"
                    ],
                    "common_phrases": [
                        "salle des agités"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who behaves violently, in a disorderly way or uncontrollably.",
                        "ru": "Человек, который ведёт себя буйно, беспорядочно или неконтролируемо.",
                        "de": "Person, die sich gewalttätig, ungeordnet oder unkontrolliert verhält.",
                        "es": "Persona que se comporta de forma violenta, desordenada o fuera de control.",
                        "zh": "指举止暴力、混乱或难以控制的人。"
                    },
