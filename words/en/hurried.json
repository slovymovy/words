{
    "word_family": [
        "hurry",
        "hurriedly",
        "hurriedness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1ec1dd72-c07a-3fcd-8910-d831bb1506d6",
                    "sense_definition": "Done in a hurry; rushed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>hurried</w> exit after realizing he was late for the meeting.",
                            "target_lang_translations": {
                                "tr": "Toplantıya geç kaldığını fark edince <w>aceleyle</w> çıktı."
                            }
                        },
                        {
                            "text": "The <w>hurried</w> meal was not very enjoyable because we had to leave quickly.",
                            "target_lang_translations": {
                                "tr": "Hemen gitmemiz gerektiği için <w>acele</w> yenen yemek pek keyifli değildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "rushed",
                        "hasty",
                        "quick"
                    ],
                    "antonyms": [
                        "leisurely",
                        "unhurried"
                    ],
                    "common_phrases": [
                        "hurried exit",
                        "hurried meal"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aceleyle yapılmış, hızlı, telaşlı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "acele",
                                "target_lang_sense_clarification": "Bir işin hızlı ve telaşlı yapıldığını belirtir."
                            },
                            {
                                "target_lang_word": "telaşlı",
                                "target_lang_sense_clarification": "Acele ve düzensiz bir durumu ifade eder."
                            },
                            {
                                "target_lang_word": "hızlı",
                                "target_lang_sense_clarification": "Zaman kısıtlı olduğunda yapılan işler için kullanılır."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e198db57-dfe9-3537-ac76-60e6352e8dab",
                    "sense_definition": "Simple past and past participle of <w>hurry</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>hurried</w> to the station to catch the last train home.",
                            "target_lang_translations": {
                                "tr": "Eve giden son trene yetişmek için istasyona <w>acele etti</w>."
                            }
                        },
                        {
                            "text": "They have <w>hurried</w> through their work all morning to finish on time.",
                            "target_lang_translations": {
                                "tr": "Zamanında bitirmek için bütün sabah işlerini <w>aceleyle</w> yaptılar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hurried to",
                        "hurried through"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb hurry."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Hurry fiilinin geçmiş zaman ve geçmiş zaman ortacı hali; acele etmek, çabuk davranmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "acele etti",
                                "target_lang_sense_clarification": "Geçmiş zamanda bir yere yetişmek için hızlı hareket etmek."
                            },
                            {
                                "target_lang_word": "koşturdu",
                                "target_lang_sense_clarification": "Bir işi bitirmek için hızlı ve yoğun çaba sarf etmek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
