                                                "sense_id": "751c7038-7bbb-3e85-9a73-ec745b5a50da",
                                                "text": "De bezorgde moeder moet altijd weten waar de kinderen zijn."
                                            },
                                            {
                                                "example_id": "c75db56c-068c-4f31-b016-59ad0b76c165",
                                                "sense_id": "751c7038-7bbb-3e85-9a73-ec745b5a50da",
                                                "text": "'Gaat het wel met je?' vraag ik bezorgd."
                                            }
                                        ]
                                    }
                                ]
                            },
