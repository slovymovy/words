                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d59cb9a5-40c5-49e0-a675-b87be1a896e0",
                                "sense_id": "150f9564-8359-37d3-8bd0-8fd135308ebd",
                                "text": "Dans les couloirs de la prison, j'ai reconnu un entrant Mohamed Sefta, adel de la Mahakma d'Alger (la justice musulmane)."
                            },
                            {
                                "example_id": "3dd8d94b-3bf5-4863-9924-5575ac79d262",
                                "sense_id": "150f9564-8359-37d3-8bd0-8fd135308ebd",
                                "text": "Cette activité dans le monde judiciaire n’est pas nouvelle : Mohammed Lakhdar a d’abord été adel, c'est-à-dire greffier, à la Mahakma de Tébessa en 1937, avant de devenir interprète judiciaire à la Justice de Paix de la même ville."
                            }
                        ]
