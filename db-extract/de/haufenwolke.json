                "senses": [
                    {
                        "sense_id": "502c5642-59a4-3196-a27d-88b33a651370",
                        "entry_id": "13bec669-869e-33aa-8b2b-219bb6b5c784",
                        "glosses": [
                            "große, dichte Wolken am Himmel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1311c4b-743c-4a2c-ad06-c134f154af8b",
                                "sense_id": "502c5642-59a4-3196-a27d-88b33a651370",
                                "text": "Der Himmel war voller Haufenwolken."
                            },
                            {
                                "example_id": "734b1769-df97-4a31-87d4-2a54bf392bca",
                                "sense_id": "502c5642-59a4-3196-a27d-88b33a651370",
                                "text": "„Auf dem Horizont im Westen lagen niedrige Haufenwolken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "169d6776-7ce3-4f98-9725-cabdbcaeb521",
                        "source_entry_id": "13bec669-869e-33aa-8b2b-219bb6b5c784",
                        "source_sense_id": "502c5642-59a4-3196-a27d-88b33a651370",
                        "source_sense_description": "große, dichte Wolken am Himmel",
                        "target_lang_word": "cumulus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cumulus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26e3d8ff-40c4-310e-a9d5-b9d7aeb21139",
                                        "entry_id": "1dd2aad1-726b-3563-aa91-eddf80ce7820",
                                        "glosses": [
                                            "Amas de nuages dont la partie supérieure est arrondie et présente des reflets blancs, tandis que la partie inférieure est sombre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc451684-c6e1-41af-9eeb-940a651a2055",
                                                "sense_id": "26e3d8ff-40c4-310e-a9d5-b9d7aeb21139",
                                                "text": "Le ciel est huit dixième couvert par cumulus et cumulo-nimbus, et un vent de S.-S.-E. à S.-E. de 60 kilomètres-heure augmente notre vitesse jusqu’à 240 kilomètres-heure."
                                            },
                                            {
                                                "example_id": "22892b9a-2420-42c8-9e16-35d1122058dc",
                                                "sense_id": "26e3d8ff-40c4-310e-a9d5-b9d7aeb21139",
                                                "text": "Enfin les niveaux de base des cumulus d’été sont beaucoup plus élevés que dans les plaines."
                                            },
                                            {
                                                "example_id": "fe404986-9d3b-4bb7-948e-19bf2e2a296c",
                                                "sense_id": "26e3d8ff-40c4-310e-a9d5-b9d7aeb21139",
                                                "text": "Une lune de Gustave Doré semblait bondir de nuage en nuage, plonger derrière des cumulus ourlés de feu d’où elle sortait nue, éclatante, un peu bossue."
                                            },
                                            {
                                                "example_id": "70043bb8-7cac-42eb-a163-f4e7533865ff",
                                                "sense_id": "26e3d8ff-40c4-310e-a9d5-b9d7aeb21139",
                                                "text": "La rigueur des sagittaires fléchant un cumulus soudé au ciel et dominant depuis des heures son double empêtré dans la rivière […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17df408d-58f0-3057-8b04-e56ad46ea281",
                                        "entry_id": "1dd2aad1-726b-3563-aa91-eddf80ce7820",
                                        "glosses": [
                                            "Nom déposé du premier chauffe-eau électrique à accumulation inventé en 1915 par le suisse Frédéric Sauter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3a5a599-cdab-473f-aa78-a3679f7b93ce",
                                                "sense_id": "17df408d-58f0-3057-8b04-e56ad46ea281",
                                                "text": "Dans cet appartement l’eau chaude est produite par un cumulus."
                                            },
                                            {
                                                "example_id": "7ab2fc25-bd51-4453-84c0-394e26a31259",
                                                "sense_id": "17df408d-58f0-3057-8b04-e56ad46ea281",
                                                "text": "Mais à l’extension de l’électricité réellement indispensable, s’ajouta vite l’installation non moins urgente d’un service d’eau qui ne pouvait fonctionner que sur pompe immergée avec, cela allait de soi, un réservoir de filtrage et de pression, sans oublier le cumulus de taille suffisante pour assurer l’eau chaude à un évier moderne et à une salle de bains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38f56fe9-37bb-4b5b-9fd8-d0aa83ce65fb",
                        "source_entry_id": "13bec669-869e-33aa-8b2b-219bb6b5c784",
                        "source_sense_id": "502c5642-59a4-3196-a27d-88b33a651370",
                        "source_sense_description": "große, dichte Wolken am Himmel",
                        "target_lang_word": "stapelwolk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stapelwolk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
                                        "entry_id": "f3c71e1f-9e0b-3c90-9725-7d01187acbdb",
                                        "glosses": [
                                            "scherp afgegrensde, bloemkoolachtige wolken van het geslacht Cumulus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b57ffe7-ecb7-4290-a36d-2bdf74e755a2",
                                                "sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
                                                "text": "Forse stapelwolken joegen in een wedloop met de trein door de hoge, diepblauwe lucht, van station tot station Barendrecht, Zwijndrecht, Dordrecht, Zwaluwe, Langeweg, Breda. Hij bleef in zijn gedachten opgesloten zitten, getroost door de nabijheid van zijn zoon, totdat de trein bij de grens aankwam en opnieuw stilhield."
                                            },
                                            {
                                                "example_id": "5d1b47de-679c-430b-abdd-5c95bf94216a",
                                                "sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
                                                "text": "Het was een mooie dag. Een paar stapelwolken. Op de telefoondraden langs de weg zaten de eerste zwaluwen. In Saint Léonard liepen zelfs al toeristen rond. Opvallend veel stelletjes die meer oog schenen te hebben voor elkaar dan voor de historische gevels."
                                            },
                                            {
                                                "example_id": "4f942090-981d-47b3-a9c5-78b80494adad",
                                                "sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
                                                "text": "VANDAAG wordt het vrij zonnig met stapelwolken, maar op de meeste plaatsen blijft het droog."
                                            },
                                            {
                                                "example_id": "a608dcdb-74f1-4208-8f76-373242d11395",
                                                "sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
                                                "text": "Nadat de mist is opgelost is het zowel vandaag als morgen prima nazomerweer. Vandaag loopt het kwik op naar 17 tot 19 graden, morgen wordt het met 17 tot 21 graden iets warmer. De zon schijnt in sommige regio's flink, elders zijn er enkele stapelwolken. Het blijft vrijwel droog, alleen het noordoosten blijft gevoelig voor een enkele bui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
