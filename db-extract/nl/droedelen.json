                "senses": [
                    {
                        "sense_id": "fcf46cc6-627a-35ef-859d-7c134c46e505",
                        "entry_id": "5ead4c1e-6f35-3bd5-875c-c03a1cf3ec5b",
                        "glosses": [
                            "een simpel tekeningetje maken dat pas begrijpelijk is na een grappige verklaring"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "105cacea-d5d7-4da3-b0aa-72137e79df97",
                                "sense_id": "fcf46cc6-627a-35ef-859d-7c134c46e505",
                                "text": "Het droedelen is een uitvinding van de Amerikaanse heer Roger Price, en het laat zich omschrijven als het maken van dóódsimpele, meestal slechte tekeningetjes waar geen enkel talent voor is vereist, die dan vervolgens van een onthutsend-eenvoudige verklaring worden voorzien."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf7b4cab-8e08-36de-b49b-6ad918cf6de0",
                        "entry_id": "5ead4c1e-6f35-3bd5-875c-c03a1cf3ec5b",
                        "glosses": [
                            "schetsen of tekenen zonder duidelijk doel, door iemand wiens gedachtes elders zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4eba3e0-9352-401e-a62e-f20766a2d432",
                                "sense_id": "cf7b4cab-8e08-36de-b49b-6ad918cf6de0",
                                "text": "Rama (1964), opgeleid als schilder, heeft gelukkig wel meer gedaan dan droedelen."
                            }
                        ]
                    }
