                ],
                "senses": [
                    {
                        "sense_id": "98a66f46-a39b-392f-9435-2dd7a9a721f2",
                        "entry_id": "910f5610-7ef6-34bc-acc0-a4049d1ce348",
                        "glosses": [
                            "familiär gebundene Personen, die als Flüchtlinge unterwegs sind und unter Umständen nach einer Neuansiedlung streben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "077991f5-6dc4-423d-9cb5-cec22a1bf66f",
                                "sense_id": "98a66f46-a39b-392f-9435-2dd7a9a721f2",
                                "text": "„Über das Projekt „Mentoren/-innen für Flüchtlingsfamilien“ übernehmen Freiwillige für ein halbes Jahr eine Mentorenschaft für neu nach Köln zugewiesene Flüchtlingsfamilien.“"
                            },
                            {
                                "example_id": "36d0e7f9-5b51-47cb-9a3d-b5af4a429841",
                                "sense_id": "98a66f46-a39b-392f-9435-2dd7a9a721f2",
                                "text": "„Die Ausstattung der Wohnung für die Flüchtlingsfamilie haben Bärbel und Hans Günter Steinkemper vorher mit dem Sozialamt abgestimmt, das nicht nur eine Unterkunft, sondern auch die Einrichtung besorgen muss.“"
                            },
                            {
                                "example_id": "f7d80ec5-04c1-4b23-a11e-8b411c92633c",
                                "sense_id": "98a66f46-a39b-392f-9435-2dd7a9a721f2",
                                "text": "„Ein ehemaliger Top-Manager beherbergt in seiner Villa an der Berliner Stadtgrenze eine Flüchtlingsfamilie. Sie zahlt für eine eingegliederte Wohnung Miete - einen Euro im Monat.“"
                            },
                            {
                                "example_id": "6bc0f506-4743-4a0b-bcb1-38e4121b3bed",
                                "sense_id": "98a66f46-a39b-392f-9435-2dd7a9a721f2",
                                "text": "„In Brandenburg an der Havel haben Brandstifter eine Flüchtlingsfamilie aus Inguschetien attackiert. Nur durch Glück wurde eine Katastrophe verhindert.“"
                            },
                            {
                                "example_id": "8d197a61-4b3c-469c-b9fd-45b7bf477db4",
                                "sense_id": "98a66f46-a39b-392f-9435-2dd7a9a721f2",
                                "text": "„Eine evangelische Gemeinde hat einer Flüchtlingsfamilie Kirchenasyl (Ruhrbarone berichteten) gewährt. Nun werden sie von den Dortmunder Neonazis der Partei Die Rechte gejagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
