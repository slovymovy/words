                ],
                "senses": [
                    {
                        "sense_id": "afd5d1fe-8fea-3cbc-8465-db0fa8e50610",
                        "entry_id": "27171f75-b57c-3158-96f9-18782a1df8be",
                        "glosses": [
                            "Ehemann der Tochter"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "b466b4c4-08c4-424b-b569-4d7909a59952",
                                "sense_id": "afd5d1fe-8fea-3cbc-8465-db0fa8e50610",
                                "text": "„Mit solchen Gedanken hatte sich sein Eidam auch herumzuschlagen, aber am meisten Sorge machte ihm doch das, was vor ihm lag.“"
                            },
                            {
                                "example_id": "2f3cb96c-bfe2-45b7-85f7-5b026520397f",
                                "sense_id": "afd5d1fe-8fea-3cbc-8465-db0fa8e50610",
                                "text": "„Den Geschäftsführer Fu nannte sie Meister Fu, Tschen Djing-dji redete sie mit Eidam an.“"
                            },
                            {
                                "example_id": "bf43cd90-5e4c-4221-bffa-e18fd967b138",
                                "sense_id": "afd5d1fe-8fea-3cbc-8465-db0fa8e50610",
                                "text": "„Welcher Familienvater hätte sich nicht ihn als Eidam, welche Haustochter hätte sich nicht ihn als Gatten gewünscht?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "746fc50a-c16a-3255-97d6-6197df4856c4",
                        "entry_id": "27171f75-b57c-3158-96f9-18782a1df8be",
                        "glosses": [
                            "derjenige Mann, der in die Familie einheiratet und damit am Erbe der Tochter teilnimmt"
                        ],
                        "tags": [
                            "ursprüngliche Bedeutung"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
