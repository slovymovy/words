                                    {
                                        "sense_id": "5cf70624-e21c-34f0-b042-eb05d86670ef",
                                        "entry_id": "4d6a2307-e17e-3cc8-bf68-9062c1729fba",
                                        "glosses": [
                                            "Strand oder Badestelle zum Baden ohne Bekleidung oder nach freier Wahl; eigentlich Freikörperkulturstrand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "684220c5-2ae7-4716-a5ef-4575210af171",
                                                "sense_id": "5cf70624-e21c-34f0-b042-eb05d86670ef",
                                                "text": "Wer prüde ist, sollte nicht an den FKK-Strand gehen."
                                            },
                                            {
                                                "example_id": "a6557636-0b87-4c27-9069-68e87dfbfd61",
                                                "sense_id": "5cf70624-e21c-34f0-b042-eb05d86670ef",
                                                "text": "„In der Sommerhitze erfahre ich am FKK-Strand am Wannsee sehr viel darüber, wie die Deutschen zu ihrem Körper, zur Erotik, zur Freiheit stehen.“"
                                            },
                                            {
                                                "example_id": "adf7c511-ee3b-49ba-b5e5-0d16ec3e7f22",
                                                "sense_id": "5cf70624-e21c-34f0-b042-eb05d86670ef",
                                                "text": "„Vom Hochufer habe man einen schönen Blick auf den FKK-Strand.“"
                                            },
                                            {
                                                "example_id": "7514c5d7-4cf4-4435-a8ea-3f07563c04d6",
                                                "sense_id": "5cf70624-e21c-34f0-b042-eb05d86670ef",
                                                "text": "„Am FKK-Strand notiert sich so was automatisch.“"
                                            }
                                        ],
