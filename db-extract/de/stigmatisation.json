                                "example_id": "193794db-2fb1-424e-b465-3d92ddaf2270",
                                "sense_id": "1f37cb82-fc9e-33ed-b0d3-b05a647b639a",
                                "text": "Der erste anerkannte Fall von Stigmatisation ist der des Franz von Assisi (1181/82–1226)."
                            },
                            {
                                "example_id": "55f6d2f8-b4c8-4279-8e9e-842359076657",
                                "sense_id": "1f37cb82-fc9e-33ed-b0d3-b05a647b639a",
                                "text": "Stigmatisation ist „kein eindeutiges Zeichen für die Heiligkeit oder echte mystische Begnadung.“"
                            },
                            {
                                "example_id": "c2acfa26-247f-45c1-bb6d-726266ccf8c2",
                                "sense_id": "1f37cb82-fc9e-33ed-b0d3-b05a647b639a",
                                "text": "„Stigmatisationen sind seit der Leidensmystik des Mittelalters bekannt.“"
                            }
                        ],
