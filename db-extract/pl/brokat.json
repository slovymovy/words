                        "cross_references": []
                    },
                    {
                        "translation_id": "20ba21ec-0d75-4b58-8322-27eca240ffcc",
                        "source_entry_id": "2c6faa00-8c1b-3800-bf3c-113bb2b83f4a",
                        "source_sense_id": "bb8779c0-64b6-3b1d-8e8e-9e79c0f2fbe2",
                        "target_lang_word": "Brokat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brokat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f145131e-1d04-3db0-8e25-ee780982a2aa",
                                        "entry_id": "f5085ae4-3f94-309b-a83f-db05a8ae256f",
                                        "glosses": [
                                            "schweres Gewebe aus Seide, mit Muster, in das Metallfäden eingewebt sind"
                                        ],
                                        "tags": [
                                            "Textilwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b36f95c-3038-4fd6-b6d7-785dc58b0388",
                                                "sense_id": "f145131e-1d04-3db0-8e25-ee780982a2aa",
                                                "text": "Die Dekorateurin fand die Vorhänge aus Brokat kitschig."
                                            },
                                            {
                                                "example_id": "5a90d207-00f0-4ced-b888-0fcab72c97ed",
                                                "sense_id": "f145131e-1d04-3db0-8e25-ee780982a2aa",
                                                "text": "„Vor dem dunkelroten Brokat der Wände standen lebensgroße Wachsfiguren aus dem alten Panoptikum in der Friedrichstraße.“"
                                            },
                                            {
                                                "example_id": "a7931bb2-1b84-4405-bfe5-90373ffc6f0b",
                                                "sense_id": "f145131e-1d04-3db0-8e25-ee780982a2aa",
                                                "text": "„Alles war voller alter Möbel, verstaubtem Brokat und schweren Teppichen.“"
                                            },
                                            {
                                                "example_id": "51fcb071-a11f-43a5-8a06-215badadfcd4",
                                                "sense_id": "f145131e-1d04-3db0-8e25-ee780982a2aa",
                                                "text": "„Frau Mondtraut erhielt aber zwei dunkelrote, langärmelige Jacken aus Brokat mit buntem Untergrunde und vier blumenverzierte Gewänder.“"
                                            },
                                            {
                                                "example_id": "45c55387-ae8a-4eb5-8fe6-1589f90d4592",
                                                "sense_id": "f145131e-1d04-3db0-8e25-ee780982a2aa",
                                                "text": "„Sie schlängelte sich vorbei am Klavier und den mit Brokat bezogenen Sofas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
