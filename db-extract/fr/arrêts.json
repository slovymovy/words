            {
                "entry_id": "e584a377-3971-3e8b-abf8-bb53d1ce67cb",
                "word": "arrêts",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1f3043c0-db68-30b3-a6c6-dfdc37d2d396",
                        "entry_id": "e584a377-3971-3e8b-abf8-bb53d1ce67cb",
                        "glosses": [
                            "Défense qui est faite à un officier de sortir de chez lui, ou de s’éloigner d’un lieu déterminé."
                        ],
                        "tags": [
                            "Discipline"
                        ],
                        "examples": [
                            {
                                "example_id": "8c99e918-e9f2-49c6-9e1f-4e86de2de8eb",
                                "sense_id": "1f3043c0-db68-30b3-a6c6-dfdc37d2d396",
                                "text": "On l’a mis aux arrêts."
                            },
                            {
                                "example_id": "55c642f7-f74b-42db-9179-58925e8023ee",
                                "sense_id": "1f3043c0-db68-30b3-a6c6-dfdc37d2d396",
                                "text": "Il est aux arrêts dans sa chambre."
                            },
                            {
                                "example_id": "391f7c7a-692b-4efb-973f-81b8c6ee8fb9",
                                "sense_id": "1f3043c0-db68-30b3-a6c6-dfdc37d2d396",
                                "text": "Il sera puni pour n’avoir pas gardé ses arrêts, pour avoir rompu les arrêts."
                            },
                            {
                                "example_id": "b9c5a203-23ad-4e0e-93b7-3cf48d8730bf",
                                "sense_id": "1f3043c0-db68-30b3-a6c6-dfdc37d2d396",
                                "text": "On a levé les arrêts, il peut sortir."
                            },
                            {
                                "example_id": "1522a6a9-295a-4385-9005-dfc3ffc88dbf",
                                "sense_id": "1f3043c0-db68-30b3-a6c6-dfdc37d2d396",
                                "text": "Dans une demi-heure, je veux vous retrouver dans votre chambre, aux arrêts de rigueur… Je vous préviens que je ferai mon rapport, et que c’est un coup à vous faire casser."
                            }
                        ]
                    }
