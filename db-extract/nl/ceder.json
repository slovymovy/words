                                    {
                                        "sense_id": "9f86df53-19eb-3e0c-9b21-c38d7616cfbc",
                                        "entry_id": "3676f0d1-7c7d-3f71-88d3-08336b6dee6e",
                                        "glosses": [
                                            "A coniferous tree of the genus Cedrus in the family Pinaceae."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00d781cf-fb3b-37d0-aea0-2f410e067c31",
                                        "entry_id": "3676f0d1-7c7d-3f71-88d3-08336b6dee6e",
                                        "glosses": [
                                            "A coniferous tree of the family Cupressaceae, especially of the genera Juniperus, Cupressus, Calocedrus, or Thuja."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41639320-11c0-4ab2-b8a8-a3cab1bcd520",
                                                "sense_id": "00d781cf-fb3b-37d0-aea0-2f410e067c31",
                                                "text": "There had been dry seasons, accumulations of dust, wind-blown seeds, and cedars rose wonderfully out of solid rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05e7cbb7-9a29-352e-adf4-5e7f09cbde56",
                                        "entry_id": "3676f0d1-7c7d-3f71-88d3-08336b6dee6e",
                                        "glosses": [
                                            "A flowering tree of the family Meliaceae, especially of the genera Cedrela or Toona."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a4e0307-92ac-3fd8-907a-054f6cc7a57e",
                                        "entry_id": "3676f0d1-7c7d-3f71-88d3-08336b6dee6e",
                                        "glosses": [
                                            "The aromatic wood from a Cedrus tree, or from any of several not closely related trees."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cb90db7-b345-454f-977e-bc037b735065",
                        "source_entry_id": "ef38593e-7ad1-3d1f-b8a7-5fbb4d9348e0",
                        "source_sense_id": "6fac94f2-6768-3786-a92f-36710e36601a",
                        "source_sense_description": "benaming voor bomen uit het geslacht Cedrus",
                        "target_lang_word": "cèdre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cèdre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "537c78e3-a03a-31dd-85a5-cfa9c7f3ee42",
                                        "entry_id": "dcf25a59-3038-3626-a36a-913e5b285c08",
                                        "glosses": [
                                            "Espèce d’arbre du genre Cedrus, conifère de grande taille de la famille des Pinacées, aux branches horizontales en plans superposés et à cônes globuleux et dressés, souvent utilisé pour l’ornementation et dont le bois passe pour incorruptible."
                                        ],
                                        "tags": [
                                            "Europe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7d1e0b3-bbbb-44aa-b6b0-3cccffe270c6",
                                                "sense_id": "537c78e3-a03a-31dd-85a5-cfa9c7f3ee42",
                                                "text": "Monsieur Adolphe, dit la femme du fabricant à son petit commis blond, allez commander une boîte de cèdre chez le tabletier."
                                            },
                                            {
                                                "example_id": "5c64c8f8-fb98-4876-b3d5-41fb636b1035",
                                                "sense_id": "537c78e3-a03a-31dd-85a5-cfa9c7f3ee42",
                                                "text": "À l’intérieur, son plafond est de style mudéjar, à caissons de bois de cèdre incrusté d’ivoire."
                                            },
                                            {
                                                "example_id": "dacb40b6-2032-4a13-adfc-d9e2b4e5a025",
                                                "sense_id": "537c78e3-a03a-31dd-85a5-cfa9c7f3ee42",
                                                "text": "Le bois du cèdre, arbre sacré, fut très tôt destiné aux édifices religieux… Pratiquement incorruptible, il défie le temps dans les constructions qui le mettent en œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19c31b8e-6f71-3671-8cef-4487f138340f",
                                        "entry_id": "dcf25a59-3038-3626-a36a-913e5b285c08",
                                        "glosses": [
                                            "Nom parfois donné à des arbres ayant une quelconque ressemblance avec les arbres du genre Cedrus, comme par exemple le cèdre d’Espagne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7104aff-71a6-370f-a42b-e111232b84ab",
                                        "entry_id": "dcf25a59-3038-3626-a36a-913e5b285c08",
                                        "glosses": [
                                            "Espèce de conifères du genre Thuja sp. et en particulier Thuja occidentalis."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64ad590f-e45f-4be1-be25-be0161960ada",
                                                "sense_id": "d7104aff-71a6-370f-a42b-e111232b84ab",
                                                "text": "Nous venions d’admirer une forêt de cèdres à Chicoutimi ; et cependant il n’y a pas de cèdre au-dessus du 45ᵉ parallèle, c’est à dire : il n’y en a pas au Canada , excepté dans l’Anticosti ! C'est à en perdre la tête, vraiment."
                                            },
                                            {
                                                "example_id": "de1b5230-be5a-450a-b3eb-0869ac53f5df",
                                                "sense_id": "d7104aff-71a6-370f-a42b-e111232b84ab",
                                                "text": "Les forêts millénaires de cèdres et de pruches de la Colombie-Britannique pourraient cependant faire figure d’exceptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10035b55-a0a0-355a-a032-69767d2ffaba",
                                        "entry_id": "dcf25a59-3038-3626-a36a-913e5b285c08",
                                        "glosses": [
                                            "Synonyme de acajou-amer (Cedrela odorata)."
                                        ],
                                        "tags": [
                                            "Haïti"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6185face-4482-3a65-9cfe-44fc83bbb32f",
                                        "entry_id": "dcf25a59-3038-3626-a36a-913e5b285c08",
                                        "glosses": [
                                            "Bois de cèdre."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59f8b983-ec4a-4802-94f8-8416e7809368",
                                                "sense_id": "6185face-4482-3a65-9cfe-44fc83bbb32f",
                                                "text": "Le chariot de cèdre, aux moyeux d’argent, roule ;\nEt le peuple, saisi de peur, s’est prosterné\nAu passage du couple abhorré qui le foule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
