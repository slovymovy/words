                "senses": [
                    {
                        "sense_id": "f42a06fb-48d0-3aa8-8ee4-e815f287c773",
                        "entry_id": "1603da01-62c4-30f3-a581-35f2f94c07a4",
                        "glosses": [
                            "das Mitteilen (in mündlicher oder schriftlicher Form) seines Standpunktes (zu einem bestimmten Thema, einer bestimmten Sache)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f3064dd-fa06-45b8-af8f-56b03a5d7f2d",
                                "sense_id": "f42a06fb-48d0-3aa8-8ee4-e815f287c773",
                                "text": "„Unter Bedingungen von Pressefreiheit und freier Meinungsäußerung kann man die Auseinandersetzung um Themen der öffentlichen Meinung auch in der Presse verfolgen.“"
                            },
                            {
                                "example_id": "f3d39e91-bc2e-460f-a87c-8086ca31f0e5",
                                "sense_id": "f42a06fb-48d0-3aa8-8ee4-e815f287c773",
                                "text": "„Andere Länder sind in Sachen freie Meinungsäußerung noch nicht so weit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
