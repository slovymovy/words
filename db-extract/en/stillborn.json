            {
                "entry_id": "f2b85c19-1a23-3119-8bb1-89d347b3b9d6",
                "word": "stillborn",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1b8ba07b-adef-4b52-8ee2-517201aa616f",
                        "entry_id": "f2b85c19-1a23-3119-8bb1-89d347b3b9d6",
                        "tags": [
                            "plural"
                        ],
                        "form": "stillborns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40cc19b8-7fc8-3491-8374-c286dc215b0d",
                        "entry_id": "f2b85c19-1a23-3119-8bb1-89d347b3b9d6",
                        "glosses": [
                            "A baby that is born dead."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b88594d5-cdca-4ab7-8b60-aeed81b2acce",
                                "sense_id": "40cc19b8-7fc8-3491-8374-c286dc215b0d",
                                "text": "About 35% of stillborns are discovered to have major structural anomalies by chromosomal studies and autopsy findings."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2a7fa76-d3b3-4d6b-a934-b2bd11c93551",
                        "source_entry_id": "f2b85c19-1a23-3119-8bb1-89d347b3b9d6",
                        "source_sense_id": "40cc19b8-7fc8-3491-8374-c286dc215b0d",
                        "source_sense_description": "stillborn",
                        "target_lang_word": "Totgeburt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totgeburt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d68d1b3-55ce-3a06-9842-e8c39f535948",
                                        "entry_id": "3fee09d0-2c5a-3da0-b807-e6d779e05b5f",
                                        "glosses": [
                                            "Geburt eines toten Lebewesens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e29ed93-951b-496f-89d7-d6a95dc64b47",
                                                "sense_id": "5d68d1b3-55ce-3a06-9842-e8c39f535948",
                                                "text": "„Petra Lennig hat gehörigen Respekt vor den 1000 Menschenpräparaten. Wer hier arbeitet, muss die Fantasie zügeln\", sagt die 44-jährige Museumsdirektorin. Vorbei sind die Zeiten, in denen arme Eltern ihre missgebildete Totgeburt vom Apotheker in einem Glas mit Weingeist aufsetzen ließen und für Geld auf dem Jahrmarkt zeigten. Der Ultraschall macht selten, was nicht nur der Pöbel schon immer sehen wollte.“"
                                            },
                                            {
                                                "example_id": "ad188a7c-5ff6-44c0-b52f-087e94b436f0",
                                                "sense_id": "5d68d1b3-55ce-3a06-9842-e8c39f535948",
                                                "text": "„Die Tierpfleger im Wuppertaler Zoo sind derzeit auf einer Achterbahn der Gefühle: Innerhalb von vier Tagen begrüßten sie nun einen zweiten neugeborenen Elefanten, während es bei den Gorillas eine Totgeburt gab.“"
                                            },
                                            {
                                                "example_id": "502844ce-9206-4ea2-85a4-e75701badcb0",
                                                "sense_id": "5d68d1b3-55ce-3a06-9842-e8c39f535948",
                                                "text": "„In der Nachrichtenkolumne mit der Überschrift »Die vier Enden der Erde« wurde von einer ägyptischen Bauersfrau berichtet, die Sechslinge zur Welt gebracht hatte - alles Totgeburten.“"
                                            },
                                            {
                                                "example_id": "3a769fa9-321c-4c51-836b-76746bcd8587",
                                                "sense_id": "5d68d1b3-55ce-3a06-9842-e8c39f535948",
                                                "text": "„Der Schwäche schwangerer Frauen wegen schnellte die Zahl der Totgeburten in die Höhe, und zahlreiche Deutsche starben an Tuberkulose, was sicher auch am extremen Kohlenmangel lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e4918a6-61ab-3182-8614-4fabdaa15b86",
                                        "entry_id": "3fee09d0-2c5a-3da0-b807-e6d779e05b5f",
                                        "glosses": [
                                            "ein totgeborenes Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50a184e6-cf8f-4a12-92aa-df813ad81d77",
                                                "sense_id": "4e4918a6-61ab-3182-8614-4fabdaa15b86",
                                                "text": "„Der Schwäche schwangerer Frauen wegen schnellte die Zahl der Totgeburten in die Höhe, und zahlreiche Deutsche starben an Tuberkulose, was sicher auch am extremen Kohlenmangel lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0db940a8-d77d-3ff2-88ec-d5c153a8a880",
                                        "entry_id": "3fee09d0-2c5a-3da0-b807-e6d779e05b5f",
                                        "glosses": [
                                            "vom Beginn an gescheitertes Projekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e738b2f7-a79a-4a83-be28-1538bca6206d",
                                                "sense_id": "0db940a8-d77d-3ff2-88ec-d5c153a8a880",
                                                "text": "„Denn ohne das ‚Mitnehmen‘ der Bürger war die Gemeinschaftsstraße von Beginn an eine Totgeburt.“"
                                            },
                                            {
                                                "example_id": "e8c74306-1568-4d83-8d43-f905222c2fa1",
                                                "sense_id": "0db940a8-d77d-3ff2-88ec-d5c153a8a880",
                                                "text": "„In der vorgeschlagenen Kronzeugenregelung sieht Rechtsanwälte-Präsident Gerhard Benn-Ibler allerdings eine ‚Totgeburt‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
