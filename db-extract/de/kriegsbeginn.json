                ],
                "senses": [
                    {
                        "sense_id": "7b232461-8de0-3066-ab6e-bc18ac7ef711",
                        "entry_id": "67b38de9-7913-3562-9a57-d3dd0f1c46aa",
                        "glosses": [
                            "Zeitpunkt des Beginns eines Krieges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ed303f0-1770-4686-9e1d-ba6cad04d6af",
                                "sense_id": "7b232461-8de0-3066-ab6e-bc18ac7ef711",
                                "text": "„Warum ausgerechnet kurz nach Kriegsbeginn am 1. Oktober 1939 offiziell Liniensignale zur Einführung kamen, bleibt im Dunkeln.“"
                            },
                            {
                                "example_id": "08889a92-f299-4ddd-94fe-7677d2d1a156",
                                "sense_id": "7b232461-8de0-3066-ab6e-bc18ac7ef711",
                                "text": "„Das deutsche Militär sorgte leider schon ab Kriegsbeginn 1914 für eine vorher nicht für möglich gehaltene Barbarisierung des Krieges.“"
                            },
                            {
                                "example_id": "b2d9500a-748a-4dfc-9802-97523fd611c5",
                                "sense_id": "7b232461-8de0-3066-ab6e-bc18ac7ef711",
                                "text": "„1914 erreichen russische Truppen bereits 24 Stunden nach Kriegsbeginn Tollmingkehmen.“"
                            },
                            {
                                "example_id": "b332fce6-fc59-4705-9bce-0e9764089fb8",
                                "sense_id": "7b232461-8de0-3066-ab6e-bc18ac7ef711",
                                "text": "„Gleich nach Kriegsbeginn richtet die britische Marine eine Seeblockade zwischen den Shetland-Inseln und Südnorwegen sowie im Ärmelkanal bei Dover ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
