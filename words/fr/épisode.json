    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79b01459-b155-3e13-affb-388fec3b8cb9",
                    "sense_definition": "Partie ou émission distincte faisant partie d'une série télévisée, radiophonique ou d'un feuilleton.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "audiovisuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons regardé le dernier <w>épisode</w> de notre série préférée hier soir."
                        },
                        {
                            "text": "Ce nouvel <w>épisode</w> apporte enfin des réponses aux questions laissées en suspens."
                        }
                    ],
                    "synonyms": [
                        "volet"
                    ],
                    "common_phrases": [
                        "dernier épisode",
                        "prochain épisode",
                        "épisode pilote"
                    ]
                },
                {
                    "sense_id": "2facce3f-1185-3663-b7e0-ccee75985ac6",
                    "sense_definition": "Événement circonscrit dans le temps qui fait partie d'un ensemble d'actions ou d'une histoire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evenement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>épisode</w> douloureux de son enfance a profondément marqué sa personnalité."
                        },
                        {
                            "text": "Le voyage a été interrompu par un curieux <w>épisode</w> survenu à la frontière."
                        }
                    ],
                    "synonyms": [
                        "incident",
                        "péripétie",
                        "événement"
                    ],
                    "common_phrases": [
                        "épisode douloureux",
                        "triste épisode"
                    ]
                },
                {
                    "sense_id": "8420742f-8b6b-3ef5-8da4-45666eb579e4",
                    "sense_definition": "Manifestation temporaire de symptômes ou phase aiguë au cours d'une maladie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient a souffert d'un <w>épisode</w> fébrile soudain au milieu de la nuit."
                        },
                        {
                            "text": "Après plusieurs mois de rémission, elle a traversé un nouvel <w>épisode</w> dépressif."
                        }
                    ],
                    "synonyms": [
                        "crise",
                        "poussée",
                        "accès"
                    ],
                    "common_phrases": [
                        "épisode dépressif",
                        "épisode fébrile"
                    ]
                },
                {
                    "sense_id": "5532af06-d0a7-3195-abd1-45ec1869ffbf",
                    "sense_definition": "Action ou récit secondaire inséré dans l'intrigue principale d'une œuvre littéraire ou artistique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur a enrichi son roman d'un <w>épisode</w> secondaire qui éclaire le passé du héros."
                        },
                        {
                            "text": "Cet <w>épisode</w> poétique ralentit l'action dramatique mais renforce la beauté du texte."
                        }
                    ],
                    "synonyms": [
                        "digression"
                    ]
                }
            ]
        }
    ]
