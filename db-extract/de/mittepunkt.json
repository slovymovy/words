                "senses": [
                    {
                        "sense_id": "dc6481c5-6d02-3a09-bafc-9f59ed8ca980",
                        "entry_id": "a04e0536-0d82-3835-a74e-82d8c4822d3b",
                        "glosses": [
                            "Schriftzeichen in Form eines Punktes, das deutlich über der Grundlinie, üblicherweise etwa auf halber Großbuchstabenhöhe liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ea0111f-9bce-4e8b-ba91-237767b82792",
                                "sense_id": "dc6481c5-6d02-3a09-bafc-9f59ed8ca980",
                                "text": "„Als Multiplikationszeichen wird entweder der Kleinbuchstabe x, das Malkreuz × oder der Halbhochpunkt (Mittepunkt) verwendet, vorausgesetzt, die Rechnung beinhaltet lediglich Zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04c98298-4612-4887-9475-2a30e68a2a9d",
                        "source_entry_id": "a04e0536-0d82-3835-a74e-82d8c4822d3b",
                        "source_sense_id": "dc6481c5-6d02-3a09-bafc-9f59ed8ca980",
                        "target_lang_word": "point médian",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "point médian",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5718af2f-65d1-3d2f-89ba-48982c26b150",
                                        "entry_id": "670e55c7-1920-3d30-b402-39f3ea7950e0",
                                        "glosses": [
                                            "Signe typographique semblable au point mais placé au-dessus de la ligne de base et représenté par ·."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f323129e-cf8f-480b-9e4f-69fe341a45af",
                                                "sense_id": "5718af2f-65d1-3d2f-89ba-48982c26b150",
                                                "text": "Le point médian sert aussi de diacritique dans l’orthographe actuelle du catalan."
                                            },
                                            {
                                                "example_id": "8031bfd1-cafa-44ad-bde8-215124aefd77",
                                                "sense_id": "5718af2f-65d1-3d2f-89ba-48982c26b150",
                                                "text": "Un seul sujet, dans les batailles actuelles, les rassemble sans l’ombre d’une hésitation : le point médian. Hommes ou femmes, conservateurs ou progressistes, ils rejettent énergiquement cette nouvelle graphie selon laquelle, dans un groupe comprenant des mots masculins et féminins, les genres sont emboîtés (exemple : des instituteur·trice·s)."
                                            },
                                            {
                                                "example_id": "3c0afe67-2121-4963-9bf3-4fec6f85328a",
                                                "sense_id": "5718af2f-65d1-3d2f-89ba-48982c26b150",
                                                "text": "La recherche d’abréviations pour les termes ayant un radical commun conduit depuis trente ans à des expérimentations, certaines heureuses (le point médian, véritable trouvaille), d’autres moins (l’abréviation est satisfaisante dans étudiant·e ou collégien·ne, elle est à oublier dans acteur·trice ; et un point suffit dans les mots au pluriel : content·es)."
                                            },
                                            {
                                                "example_id": "2bdfcfc1-4c24-4c07-aaf9-c02074f1e410",
                                                "sense_id": "5718af2f-65d1-3d2f-89ba-48982c26b150",
                                                "text": "Pourtant, la France a décidé de focaliser les débats sur un outil de reféminisation particulier, qui ne correspond qu’à une très petite minorité des usages : le point médian (« les chercheur.euses »)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b4e9a9f-a092-3d58-b4cd-257929ad0f80",
                                        "entry_id": "670e55c7-1920-3d30-b402-39f3ea7950e0",
                                        "glosses": [
                                            "Signe de ponctuation archaïque de l’alphabet grec et de l’alphabet copte placé à la mi-hauteur des lettres (⸳), indiquant une pause mais plus bas que le point haut à la hauteur de lettre (· ou ·)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b7f9834-581d-47cb-9870-70cd38933d9d",
                                                "sense_id": "5b4e9a9f-a092-3d58-b4cd-257929ad0f80",
                                                "text": "A la base, trois valeurs fondamentales, venues tout droit des Grecs d’Alexandrie : point en haut, point médian, point en bas, marquant respectivement les ponctuations forte, moyenne et faible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
