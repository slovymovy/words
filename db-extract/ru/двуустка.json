                    },
                    {
                        "translation_id": "267adf87-ce54-45e5-a51c-e073d4cb1915",
                        "source_entry_id": "50590551-bd73-349f-8977-90f8c7225e36",
                        "source_sense_id": "0a3f0395-157c-36b3-975b-5da564e087b4",
