    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1620b21f-1133-35b1-89bd-f5bb872577ed",
                    "sense_definition": "A cone-bearing seed plant with vascular tissue, usually a tree.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest was filled with tall <w>conifers</w> that stayed green throughout the winter.",
                            "target_lang_translations": {
                                "ru": "Лес был полон высоких <w>хвойных деревьев</w>, которые оставались зелеными всю зиму."
                            }
                        },
                        {
                            "text": "Many birds build their nests in the branches of a large <w>conifer</w>.",
                            "target_lang_translations": {
                                "ru": "Многие птицы вьют свои гнезда на ветвях большого <w>хвойного дерева</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "evergreen conifer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение, размножающееся семенами в шишках, обычно дерево с игольчатыми листьями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвойное дерево",
                                "target_lang_sense_clarification": "общее название для деревьев хвойных пород"
                            },
                            {
                                "target_lang_word": "хвойное растение",
                                "target_lang_sense_clarification": "ботанический термин для всех растений этого класса"
                            }
                        ]
                    }
                }
            ]
        },
