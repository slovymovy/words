                "senses": [
                    {
                        "sense_id": "e83440ba-7145-3235-af05-c88e9f4e4255",
                        "entry_id": "517f1006-8602-33a5-95ce-076661d8b161",
                        "glosses": [
                            "Donner un caractère arythmique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2daae9fe-74d6-466e-b1a4-e3261d8378b1",
                                "sense_id": "e83440ba-7145-3235-af05-c88e9f4e4255",
                                "text": "Que voulez-vous la vie m'est tellement palpitante qu'elle ne cesse de m'arythmiser."
                            },
                            {
                                "example_id": "97b1ad93-f7a7-4c37-95ff-3996e2c1004d",
                                "sense_id": "e83440ba-7145-3235-af05-c88e9f4e4255",
                                "text": "Perfusé de ses messages du jour il arythmise dans un concert d'avertisseurs sonores."
                            },
                            {
                                "example_id": "5cd77d1b-257a-4495-b3f2-a8cae47bc1d9",
                                "sense_id": "e83440ba-7145-3235-af05-c88e9f4e4255",
                                "text": "Cette ambiance me rend ouf, chaque fois, mon cœur s'arythmise, un coup dans le zag et un coup dans le zig et vice versa."
                            }
                        ]
                    }
