{
    "word_family": [
        "direct",
        "direction",
        "director",
        "directive",
        "directorial",
        "directorate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48ddd51b-ec26-3239-a450-6c66e2331ecb",
                    "sense_definition": "A list of names, addresses, or other contact information, usually arranged alphabetically.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I looked up the plumber's number in the local <w>directory</w>.",
                            "target_lang_translations": {
                                "ru": "Я нашел номер сантехника в местном <w>справочнике</w>.",
                                "zh": "我在当地的<w>名录</w>里查到了水管工的电话号码。"
                            }
                        },
                        {
                            "text": "The company <w>directory</w> helps employees find contact details for their colleagues.",
                            "target_lang_translations": {
                                "ru": "<w>Справочник</w> компании помогает сотрудникам найти контактные данные коллег.",
                                "zh": "公司<w>名录</w>方便员工查找同事的联系方式。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "telephone directory",
                        "business directory",
                        "online directory",
                        "staff directory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список имен, адресов или другой контактной информации, обычно расположенный в алфавитном порядке.",
                        "zh": "包含姓名、地址或其他联系信息的列表，通常按字母顺序排列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спра́вочник",
                                "target_lang_sense_clarification": "книга или список с информацией"
                            },
                            {
                                "target_lang_word": "катало́г",
                                "target_lang_sense_clarification": "упорядоченный перечень"
                            },
                            {
                                "target_lang_word": "указа́тель",
                                "target_lang_sense_clarification": "алфавитный список"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "名录",
                                "target_lang_sense_clarification": "包含人员或机构信息的列表"
                            },
                            {
                                "target_lang_word": "指南",
                                "target_lang_sense_clarification": "提供信息或联系方式的参考书"
                            },
                            {
                                "target_lang_word": "电话簿",
                                "target_lang_sense_clarification": "专门用于查找电话号码的列表"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "000f8b58-24ed-3cae-9242-469db02bd44d",
                    "sense_definition": "A virtual container in a computer's file system where files and other directories are stored.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should save the installation files in a separate <w>directory</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует сохранить установочные файлы в отдельный <w>каталог</w>.",
                                "zh": "你应该把安装文件保存在一个单独的<w>目录</w>里。"
                            }
                        },
                        {
                            "text": "The program could not find the specified <w>directory</w> on the hard drive.",
                            "target_lang_translations": {
                                "ru": "Программа не смогла найти указанную <w>директорию</w> на жестком диске.",
                                "zh": "程序无法在硬盘上找到指定的<w>目录</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "folder"
                    ],
                    "common_phrases": [
                        "root directory",
                        "current directory",
                        "file directory",
                        "parent directory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Виртуальный контейнер в файловой системе компьютера, где хранятся файлы и другие каталоги.",
                        "zh": "计算机文件系统中用于存储文件和其他目录的虚拟容器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катало́г",
                                "target_lang_sense_clarification": "структура данных"
                            },
                            {
                                "target_lang_word": "па́пка",
                                "target_lang_sense_clarification": "объект интерфейса"
                            },
                            {
                                "target_lang_word": "директо́рия",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目录",
                                "target_lang_sense_clarification": "计算机文件系统中的存储单元"
                            },
                            {
                                "target_lang_word": "文件夹",
                                "target_lang_sense_clarification": "图形用户界面中表示目录的图标"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ce353b6-574a-32fc-bb84-b146da90e010",
                    "sense_definition": "A governing body or group of people who jointly hold executive power.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The revolutionary <w>directory</w> struggled to maintain control over the region.",
                            "target_lang_translations": {
                                "ru": "Революционная <w>директория</w> с трудом удерживала контроль над регионом.",
                                "zh": "革命<w>督政府</w>在维持对该地区的控制方面举步维艰。"
                            }
                        },
                        {
                            "text": "Historians analyzed the decisions made by the ruling <w>directory</w>.",
                            "target_lang_translations": {
                                "ru": "Историки проанализировали решения, принятые правящей <w>директорией</w>.",
                                "zh": "历史学家分析了执政<w>督政府</w>所做的决策。"
                            }
                        }
                    ],
                    "synonyms": [
                        "directorate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Руководящий орган или группа людей, совместно обладающих исполнительной властью.",
                        "zh": "共同行使行政权力的管理机构或团体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "директо́рия",
                                "target_lang_sense_clarification": "форма правления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "督政府",
                                "target_lang_sense_clarification": "特指法国大革命时期的行政机构"
                            },
                            {
                                "target_lang_word": "执行委员会",
                                "target_lang_sense_clarification": "行使行政权力的管理团体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1d1535d2-de15-3939-b9c0-2cc413bfe54f",
                    "sense_definition": "Serving to direct, instruct, or guide.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee issued a <w>directory</w> notice to all staff members.",
                            "target_lang_translations": {
                                "ru": "Комитет выпустил <w>руководящее</w> уведомление для всех сотрудников.",
                                "zh": "委员会向全体员工发布了一份<w>指导性</w>通知。"
                            }
                        },
                        {
                            "text": "The rules were considered <w>directory</w> rather than mandatory.",
                            "target_lang_translations": {
                                "ru": "Эти правила считались <w>рекомендательными</w>, а не обязательными.",
                                "zh": "这些规则被认为是<w>建议性</w>的，而非强制性的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий для руководства, наставления или указания.",
                        "zh": "用于指导、指示或引导的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекомендательный",
                                "target_lang_sense_clarification": "не обязательный к исполнению"
                            },
                            {
                                "target_lang_word": "руководящий",
                                "target_lang_sense_clarification": "дающий указания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指导性的",
                                "target_lang_sense_clarification": "提供方向或建议的"
                            },
                            {
                                "target_lang_word": "建议性的",
                                "target_lang_sense_clarification": "非强制性的，仅供参考的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}