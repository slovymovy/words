                                        "sense_id": "0b15745a-36b4-3649-963b-561087c73604",
                                        "entry_id": "df4c0b8c-c4b4-3198-b651-522ff6f44516",
                                        "glosses": [
                                            "Tasty, attractive to the palate."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64ce9af1-7d6b-47fc-bf94-f1839368e201",
                                                "sense_id": "0b15745a-36b4-3649-963b-561087c73604",
                                                "text": "The fine restaurant presented an array of savory dishes; each was delicious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e654925-36a5-341f-b9ba-0539030db4b7",
                                        "entry_id": "df4c0b8c-c4b4-3198-b651-522ff6f44516",
                                        "glosses": [
                                            "Salty and/or spicy, but not sweet."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bb0426f-70e1-4fb4-8c32-55076370342b",
                                                "sense_id": "2e654925-36a5-341f-b9ba-0539030db4b7",
                                                "text": "The mushrooms, meat, bread, rice, peanuts and potatoes were all good savory foods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5589a88-6d08-38be-bc34-b69b52724c0e",
                                        "entry_id": "df4c0b8c-c4b4-3198-b651-522ff6f44516",
                                        "glosses": [
                                            "Umami."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e18c556-89c1-4918-97c5-243e5949a87c",
                                                "sense_id": "a5589a88-6d08-38be-bc34-b69b52724c0e",
                                                "text": "The savory rabbit soup contrasted well with the sweet cucumber sandwiches with jam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7345eb37-e484-3088-90c5-1798834e6729",
                                        "entry_id": "df4c0b8c-c4b4-3198-b651-522ff6f44516",
                                        "glosses": [
                                            "Morally or ethically acceptable."
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf3ae51c-27d9-4408-a717-d539dc98e164",
                                                "sense_id": "7345eb37-e484-3088-90c5-1798834e6729",
                                                "text": "Readers are to be warned that quotations in this chapter contain some not so savory language."
                                            },
                                            {
                                                "example_id": "f94d50d3-9008-4843-884e-faa60d568885",
                                                "sense_id": "7345eb37-e484-3088-90c5-1798834e6729",
                                                "text": "The ruthless practices of the Ontario Film Censor Board are by now the laughing stock of most of the world. Scenes that contain more flesh or affection than they find savoury are simply hacked out of the film before it is released."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "savory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b20f20b-4c17-3d08-a08a-1f476616876e",
                                        "entry_id": "95f3862f-e4b2-3f2d-8fad-a4e3b4812ead",
                                        "glosses": [
