                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf168376-838c-4e2a-92c0-71e56a49ec4f",
                                "sense_id": "51a4c96e-e9d5-38ae-b3a4-25fb12ef8dbb",
                                "text": "Peu à peu le maître et le bailli sentaient monter en eux un malaise, leurs phrases se mitaient de silences, bientôt ils se turent en s’entre-regardant."
                            },
                            {
                                "example_id": "bcd87d0f-d86b-48fd-8daa-339b33cb9cee",
                                "sense_id": "51a4c96e-e9d5-38ae-b3a4-25fb12ef8dbb",
                                "text": "Just et Colombe frissonnèrent et, s’entre-regardant, ils lurent chacun dans les yeux de l’autre la même perplexité quant à la signification de cette émotion."
                            }
                        ]
                    }
