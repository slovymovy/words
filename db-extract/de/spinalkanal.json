                "senses": [
                    {
                        "sense_id": "85ca92c6-674e-3cc4-a631-c0a94846c69a",
                        "entry_id": "49d0d8b5-afb3-3847-800f-1ce20a918181",
                        "glosses": [
                            "von den Halswirbeln bis zum Kreuzbein verlaufender Kanal innerhalb der Wirbelsäule, in dem das Rückenmark liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11406ff2-69fb-4122-a59c-f9593c77a7b1",
                                "sense_id": "85ca92c6-674e-3cc4-a631-c0a94846c69a",
                                "text": "„Eine Operation an den Bandscheiben ist nur dann unausweichlich, wenn bestimmte neurologische Ausfallerscheinungen auftreten. […] Bei dem Eingriff wird der in den Spinalkanal verlagerte gelartige Bandscheibenteil entfernt, um die eingeengten Nerven zu entlasten.“"
                            },
                            {
                                "example_id": "1f046840-3e5e-4a35-85a6-f5e61e84eedc",
                                "sense_id": "85ca92c6-674e-3cc4-a631-c0a94846c69a",
                                "text": "„Knochenstrukturen oder Bänder, die Druck auf Nerven oder den Spinalkanal ausüben, müssen gegebenenfalls operativ entfernt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
