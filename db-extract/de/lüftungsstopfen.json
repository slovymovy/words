                "senses": [
                    {
                        "sense_id": "3acf34f8-e08f-3697-a652-1a66beb60ceb",
                        "entry_id": "6a513eb1-8cb7-36bd-b315-b7149047f955",
                        "glosses": [
                            "mechanisches oder von Hand gesteuertes, dicht schließendes, Verschlusselement einer Lüftungsöffnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745bdd0b-8885-421e-a400-b17003aa87d4",
                                "sense_id": "3acf34f8-e08f-3697-a652-1a66beb60ceb",
                                "text": "„Sein IP65-Isolierstoffgehäuse mit Lüftungsstopfen verfügt über einen abschließbaren Sperrkranz und Anschlussbuchsen MC3 oder MC4 oder Kabelverschraubungen für zwei Strings bzw. Abgangsleitungen.“"
                            },
                            {
                                "example_id": "cf889510-0bd6-4091-b6c5-7b7f8342442b",
                                "sense_id": "3acf34f8-e08f-3697-a652-1a66beb60ceb",
                                "text": "„Ein derartiger Lüftungsstopfen wird für die Be- und/ oder Entlüftung von insbesondere pneumatischen Antriebsgehäusen verwendet.“"
                            },
                            {
                                "example_id": "b3fc8c37-7dfc-458f-bda5-6ac8fd99e8cc",
                                "sense_id": "3acf34f8-e08f-3697-a652-1a66beb60ceb",
                                "text": "„Zu diesem Zweck ist der Lüftungsstopfen in ein rückstellkammerseitiges Gewindeloch im Membrangehäuse eingeschraubt.“"
                            },
                            {
                                "example_id": "37c825df-d375-4647-aaea-4a38ffc67c66",
                                "sense_id": "3acf34f8-e08f-3697-a652-1a66beb60ceb",
                                "text": "„Der Lüftungsstopfen wird am Kompaktheizkörper auf der entgegengesetzten Seite des Thermostatventiles oben in den Heizkörper geschraubt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
