                ],
                "senses": [
                    {
                        "sense_id": "45fa691f-2107-3ff6-a625-1276799b8f4d",
                        "entry_id": "36ec04d0-2a0c-3129-85d5-e25839c94b93",
                        "glosses": [
                            "Begriff aus der Sprachtypologie, der bedeutet, dass die Morpheme im Wort regelmäßig aneinandergereiht werden."
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "f0bb2b71-c9e4-4d3a-8f04-00dde9e54a0a",
                                "sense_id": "45fa691f-2107-3ff6-a625-1276799b8f4d",
                                "text": "Das Präteritum „rett-et-e“ zeigt eine Morphemfolge, die als Beispiel für Agglutination dienen kann. Bei starken Verben ist das Präteritum – z.B.: sang – kein Beispiel für Agglutination, da hier die Morpheme „Präteritum“ und „Person“ nicht getrennt aufeinander folgen."
                            },
                            {
                                "example_id": "ac6c06c7-4fe9-4f80-a04f-1d7b182fd3c9",
                                "sense_id": "45fa691f-2107-3ff6-a625-1276799b8f4d",
                                "text": "Eine Sprache, die Wörter vorwiegend mit dem Mittel der Agglutination bildet, wird agglutinierende Sprache genannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0995f68-51d0-3626-9fda-0e8dbb904e8c",
                        "entry_id": "36ec04d0-2a0c-3129-85d5-e25839c94b93",
                        "glosses": [
                            "Zusammenballung von Krankheitserregern und roten Blutkörperchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b94e4307-1db7-4fa1-985e-a6e25eb508eb",
                                "sense_id": "d0995f68-51d0-3626-9fda-0e8dbb904e8c",
                                "text": "„Agglutination ist bedeutsam bei Organtransplantationen und Bluttransfusionen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1743a153-d493-4a99-8549-d3841f82c271",
                        "source_entry_id": "36ec04d0-2a0c-3129-85d5-e25839c94b93",
                        "source_sense_id": "45fa691f-2107-3ff6-a625-1276799b8f4d",
                        "source_sense_description": "Begriff der bedeutet, dass die Morpheme im Wort regelmäßig aneinandergereiht werden",
                        "target_lang_word": "agglutination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agglutination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93e6d96d-97da-370b-8c88-46eeefdaf893",
                                        "entry_id": "82b48e3f-8e06-33f4-8823-321ea73d188a",
                                        "glosses": [
                                            "The act of uniting by glue or other tenacious substance; the state of being thus united; adhesion of parts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd41b536-a814-33bd-bfa9-91a952991d50",
                                        "entry_id": "82b48e3f-8e06-33f4-8823-321ea73d188a",
                                        "glosses": [
                                            "Combination in which root words are united with little or no change of form or loss of meaning. See agglutinative."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d51be31b-f9f5-3b41-b289-115d829ee9d4",
                                        "entry_id": "82b48e3f-8e06-33f4-8823-321ea73d188a",
                                        "glosses": [
                                            "The clumping together of red blood cells or bacteria, usually in response to a particular antibody."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c95be667-cdfb-42eb-8359-9015c8f39617",
                                                "sense_id": "d51be31b-f9f5-3b41-b289-115d829ee9d4",
                                                "text": "It may resemble the factor 5 in Salmonella, a heat-labile determinant on the endotoxin molecule which, because of its superficial location, blocks the agglutination reaction of the deeper heat-stable O antigens in the same way as do the Vi and K antigens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b585815-2663-4810-bad4-f0406a1f3cb6",
                        "source_entry_id": "36ec04d0-2a0c-3129-85d5-e25839c94b93",
                        "source_sense_id": "45fa691f-2107-3ff6-a625-1276799b8f4d",
                        "source_sense_description": "Begriff der bedeutet, dass die Morpheme im Wort regelmäßig aneinandergereiht werden",
                        "target_lang_word": "agglutination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agglutination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e342efd-f966-3c91-9613-8ab5e469964f",
                                        "entry_id": "7d3361c6-fdc4-34f2-8bc8-e16b6b1761d7",
                                        "glosses": [
                                            "Action d’agglutiner, de s’agglutiner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebec5558-93fb-4ef4-8f65-8ff986d4d065",
                                                "sense_id": "9e342efd-f966-3c91-9613-8ab5e469964f",
                                                "text": "Le présent mémoire examine l’agglutination d’hématies tannées traitées par deux antigènes successivement."
                                            },
                                            {
                                                "example_id": "2f48b0bd-45e7-4e3c-839c-98c8b2b95f2e",
                                                "sense_id": "9e342efd-f966-3c91-9613-8ab5e469964f",
                                                "text": "L’association d’un déficit en FvW et d’une thrombocytopénie évoque soit la présence de multimères anormaux du FvW qui agglutinent les plaquettes circulantes (type 2B), soit une anomalie du récepteur plaquettaire favorisant l’agglutination alors que le FvW est normal (pseudo-von Willebrand)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7266c9b-1ae0-375f-9cf9-cf5a90e85b83",
                                        "entry_id": "7d3361c6-fdc4-34f2-8bc8-e16b6b1761d7",
                                        "glosses": [
                                            "Procédé qui consiste à former des mots nouveaux ou des formes de mots nouvelles en leur adjoignant des éléments qui avaient d’abord une existence indépendante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76d07f39-5227-4c3f-a8f9-517a0f6497d1",
                                                "sense_id": "b7266c9b-1ae0-375f-9cf9-cf5a90e85b83",
                                                "text": "C’est par agglutination que l’ierre est devenu lierre et qu’un ombril est devenu un nombril."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db34bf70-8bc5-3edc-9940-8c7194ab3a25",
                                        "entry_id": "7d3361c6-fdc4-34f2-8bc8-e16b6b1761d7",
                                        "glosses": [
                                            "Groupement en amas distincts de molécules porteurs d’antigène, en suspension dans un liquide, qui survient lorsqu’on ajoute à ce liquide l’anticorps correspondant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
