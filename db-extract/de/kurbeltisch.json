                ],
                "senses": [
                    {
                        "sense_id": "944942da-d23f-39d3-bc5f-79819b555bbd",
                        "entry_id": "1361372e-9d2a-3685-a8fa-05c5d18264ae",
                        "glosses": [
                            "ein Tisch, dessen Plattenhöhe durch Kurbeln verändert werden kann"
                        ],
                        "tags": [
                            "Mobiliar"
                        ],
                        "examples": [
                            {
                                "example_id": "8a07bac4-348f-4ed8-bda5-69d3dd7a2480",
                                "sense_id": "944942da-d23f-39d3-bc5f-79819b555bbd",
                                "text": "„Das größte Geschenk war vorne an den Kurbeltisch gelehnt, eine Carrerabahn für Volker und mich, mit Autos und Kurven und allem Pipapo.“"
                            },
                            {
                                "example_id": "a3750866-9b88-4541-9aff-44387b3c45f0",
                                "sense_id": "944942da-d23f-39d3-bc5f-79819b555bbd",
                                "text": "„In Potsdam demonstriert das Potsdam-Institut für Klimafolgenforschung in einer Computersimulation, wie sich der Klimawandel in rund 40 Jahren auf Wetter und Vegetation in Europa auswirken könnte; und der GeoCampus Lankwitz der FU Berlin simuliert mithilfe eines Kurbeltischs die Entstehung neuer Ozeane durch tektonische Plattenverschiebungen.“"
                            },
                            {
                                "example_id": "3e7a85bf-712d-45a6-bd44-0d4866a4a11f",
                                "sense_id": "944942da-d23f-39d3-bc5f-79819b555bbd",
                                "text": "„Fans imitieren Fußball, indem sie sich an Filz- und Kurbeltischen messen.“"
                            },
                            {
                                "example_id": "aa26e88d-388b-445c-b1b7-dbe8e0ea66c8",
                                "sense_id": "944942da-d23f-39d3-bc5f-79819b555bbd",
                                "text": "„Bei elektrisch betriebenen Steh-Sitz-Tischen, Gasfeder- oder Kurbeltischen werden Funktionsstörungen ausschließlich durch den nachweislich autorisierten WINI-Kundendienst korrigiert.“"
                            },
                            {
                                "example_id": "4b7b540d-0d10-444a-9196-2ee865135811",
                                "sense_id": "944942da-d23f-39d3-bc5f-79819b555bbd",
                                "text": "„Zusammen mit der Angst, die der Mensch kurz nach dem schlimmsten Krieg aller Zeiten vor sich selber hatte, führte das zu einem psychologisch nachvollziehbaren Bedürfnis nach niedlichen, vertrauten und gern auch sinnlosen Dingen: Kurbeltische, Schlagermusik, Minigolf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
