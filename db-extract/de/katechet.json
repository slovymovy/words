                                "target_senses": [
                                    {
                                        "sense_id": "b5d9676a-4091-3892-924d-519782cf6023",
                                        "entry_id": "9c450342-5a27-3a30-bbea-394acceb05bc",
                                        "glosses": [
                                            "Celui qui enseigne le catéchisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af3f5598-3480-4bd1-98cd-a207e880fabf",
                                                "sense_id": "b5d9676a-4091-3892-924d-519782cf6023",
                                                "text": "C’est le catéchiste de la paroisse."
                                            },
                                            {
                                                "example_id": "e626f6ce-be1a-43af-b34b-d19e0e05ca5f",
                                                "sense_id": "b5d9676a-4091-3892-924d-519782cf6023",
                                                "text": "Quelques chefs catholiques aidaient activement les catéchistes dans leur territoire, leur donnant logement et champs à cultiver, voire même en construisant pour eux une chapelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2beef87f-cecc-30a6-b0b4-7eb7af02492a",
                                        "entry_id": "9c450342-5a27-3a30-bbea-394acceb05bc",
                                        "glosses": [
                                            "Celui qui enseigne une religion, une doctrine, à des néophytes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b563d4e-bb8d-4fd5-8420-2eb46ae6e059",
                                                "sense_id": "2beef87f-cecc-30a6-b0b4-7eb7af02492a",
                                                "text": "…les Mongols de la Tartarie, libres de tout lien religieux, l’embrassèrent avec une telle avidité, qu’il eût été impossible au bout de quelques années, dit M. Rémusat, de distinguer les catéchistes des néophytes."
                                            }
                                        ]
                                    }
                                ]
                            }
