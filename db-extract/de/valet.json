                                    },
                                    {
                                        "sense_id": "87402fda-8542-39fd-acf2-d07effc5995f",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A female chaperone who accompanies a man, and is usually not married to him."
                                        ],
