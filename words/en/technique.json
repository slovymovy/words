        "technicality",
        "technically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d07d576f-3269-3dea-b14d-c2f908c8c171",
                    "sense_definition": "A method of achieving something or carrying something out, especially one requiring some skill or knowledge.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist uses a special <w>technique</w> to mix the paints on the canvas.",
                            "target_lang_translations": {
                                "ru": "Художник использует особую <w>технику</w> для смешивания красок на холсте.",
                                "zh": "这位艺术家使用一种特殊的<w>技巧</w>在画布上调和颜料。"
                            }
                        },
                        {
                            "text": "We learned a simple relaxation <w>technique</w> to help reduce stress during exams.",
                            "target_lang_translations": {
                                "ru": "Мы изучили простую <w>технику</w> расслабления, чтобы снизить стресс во время экзаменов.",
                                "zh": "我们学习了一种简单的放松<w>方法</w>，以帮助减轻考试期间的压力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "method",
                        "approach",
                        "procedure",
                        "system",
                        "way",
                        "strategy"
                    ],
                    "common_phrases": [
                        "relaxation technique",
                        "marketing technique",
                        "surgical technique",
                        "teaching technique"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ выполнения чего-либо, особенно требующий определённых навыков или знаний",
                        "zh": "完成某事或执行某项任务的方法，尤指需要一定技能或知识的方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "техника",
                                "target_lang_sense_clarification": "совокупность приёмов"
                            },
                            {
                                "target_lang_word": "метод",
                                "target_lang_sense_clarification": "способ действия"
                            },
                            {
                                "target_lang_word": "приём",
                                "target_lang_sense_clarification": "отдельный способ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "技巧",
                                "target_lang_sense_clarification": "指完成某项工作的巧妙方法或手段"
                            },
                            {
                                "target_lang_word": "方法",
                                "target_lang_sense_clarification": "指为达到某种目的而采取的途径"
                            },
                            {
                                "target_lang_word": "手法",
                                "target_lang_sense_clarification": "指处理问题或进行创作的特定方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1dbefa4-a35c-35e1-a332-acc1b4a3ada0",
                    "sense_definition": "Practical ability in some given field or practice, often as opposed to creativity or imaginative skill.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tennis player has excellent <w>technique</w>, but he lacks speed on the court.",
                            "target_lang_translations": {
                                "ru": "У этого теннисиста отличная <w>техника</w>, но ему не хватает скорости на корте.",
                                "zh": "这位网球运动员的<w>技术</w>非常出色，但在球场上缺乏速度。"
                            }
                        },
                        {
                            "text": "She needs to improve her vocal <w>technique</w> if she wants to sing opera professionally.",
                            "target_lang_translations": {
                                "ru": "Ей нужно улучшить свою вокальную <w>технику</w>, если она хочет профессионально петь в опере.",
                                "zh": "如果她想成为职业歌剧演员，就需要提高她的声乐<w>技术</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "skill",
                        "proficiency",
                        "execution"
                    ],
                    "antonyms": [
                        "incompetence",
                        "clumsiness"
                    ],
                    "common_phrases": [
                        "poor technique",
                        "good technique",
                        "improve technique",
                        "vocal technique"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практическое мастерство в определённой области, качество исполнения",
                        "zh": "在特定领域或实践中的实际操作能力，通常指执行的质量或熟练程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "техника",
                                "target_lang_sense_clarification": "мастерство исполнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "技术",
                                "target_lang_sense_clarification": "指在艺术、体育或专业领域中的操作技能"
                            },
                            {
                                "target_lang_word": "功底",
                                "target_lang_sense_clarification": "指在某项技艺上长期积累的扎实基础"
                            }
                        ]
                    }
                }
            ]
        }
    ]
