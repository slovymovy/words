    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e94a202d-1784-39e4-bab9-1f4f53bdb510",
                "word": "interfaith",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5975986f-9109-3c2a-8a96-21766fb65af0",
                        "entry_id": "e94a202d-1784-39e4-bab9-1f4f53bdb510",
                        "glosses": [
                            "Involving members of different religions."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "70eb3662-264a-479b-996b-a9b198d3a8dc",
                                "sense_id": "5975986f-9109-3c2a-8a96-21766fb65af0",
                                "text": "The interfaith service had Jews, Roman Catholics and Lutherans all in attendance."
                            },
                            {
                                "example_id": "ba0a1085-e757-460a-894c-ec81fb024cf8",
                                "sense_id": "5975986f-9109-3c2a-8a96-21766fb65af0",
                                "text": "Of the interfaith couples I spoke to, far fewer are choosing Christianity instead of Judaism as the primary religion for their homes and families."
                            },
                            {
                                "example_id": "51537987-23c8-4fa9-aa5e-d09a4c8918a2",
                                "sense_id": "5975986f-9109-3c2a-8a96-21766fb65af0",
                                "text": "Kaplan-Miller said she first joined the Sisterhood of Salaam Shalom, an interfaith organization that was founded by a Muslim and a Jewish woman in suburban New Jersey, shortly after the 2016 election."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b63039ff-7c54-481f-b5ab-096b8ba1f9d1",
                        "source_entry_id": "e94a202d-1784-39e4-bab9-1f4f53bdb510",
                        "source_sense_id": "5975986f-9109-3c2a-8a96-21766fb65af0",
                        "source_sense_description": "involving members of different religions",
                        "target_lang_word": "religionsübergreifend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b5a1c95c-f952-4a43-8701-b040e099f7d0",
                        "source_entry_id": "e94a202d-1784-39e4-bab9-1f4f53bdb510",
                        "source_sense_id": "5975986f-9109-3c2a-8a96-21766fb65af0",
                        "source_sense_description": "involving members of different religions",
                        "target_lang_word": "interreligiös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interreligiös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                        "entry_id": "fa8ca9da-bebe-3299-8ed0-b1ad596727fa",
                                        "glosses": [
                                            "die Beziehungen, Gemeinsamkeiten und Unterschiede verschiedener Religionen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e0a3c90-6b97-41d4-b079-6a51a391d74e",
                                                "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                                "text": "„Der interreligiöse Dialog ist en vogue. In Bern beten seit 2014 Aleviten, Buddhisten, Christen, Hindus und Muslime unter einem Dach.“"
                                            },
                                            {
                                                "example_id": "f8ca4bf5-5588-4b6b-ad4d-bb8ee6810d94",
                                                "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                                "text": "„Zum Abschluss des Interreligiösen Treffens in Assisi haben die Vertreter von neun Religionsgemeinschaften zum Frieden aufgerufen.“ [Anmerkung / Rechtschreibung: interreligiös wird als Adjektiv klein geschrieben]"
                                            },
                                            {
                                                "example_id": "45639d74-60ba-4f21-9fa7-d3b00166e061",
                                                "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                                "text": "„»Wir meinen, dass die Würde ein interreligiös und interkulturell verständlicher Begriff ist. Er ist ein Kriterium, das in der christlich-jüdischen Tradition, in der wir in Europa stehen, sehr gut verankert ist.«“"
                                            },
                                            {
                                                "example_id": "f6c23de7-a92b-4c1b-8f36-ed276360e0e8",
                                                "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                                "text": "„Als einen Weg zur Versöhnung betrachten gerade Religionsvertreter, den interreligiösen Dialog voranzutreiben. So unterstützt etwa die deutsche Konrad-Adenauer-Stiftung in Sarajewo Projekte, die den interreligiösen Dialog fördern.“"
                                            },
                                            {
                                                "example_id": "15fad0b8-6bee-4cfd-abd4-31f3af381b70",
                                                "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                                "text": "„»[…] wir müssen […] Kommunen oder Wohlfahrtsverbände davon überzeugen, Pflegeeinrichtungen interkulturell oder interreligiös zu erweitern.«“"
                                            },
                                            {
                                                "example_id": "1322ecc0-0e45-4b3f-9cbb-babb9ed98a29",
                                                "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                                "text": "„»Ein islamisches Schulbuch muss interreligiös ausgerichtet sein, weil dies zum Selbstverständnis des Islams gehört – vor allem des Islams in einem Einwanderungsland.«“"
                                            },
                                            {
                                                "example_id": "0702bd87-39a3-47a8-aada-c2f0653167b9",
                                                "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                                "text": "„Das interreligiöse Experiment [Anmerkung: eines christlich-muslimischen Kindergartens] ist aber auch unter Muslimen umstritten […]“"
                                            },
                                            {
                                                "example_id": "ae5c6625-473b-4bf5-ac30-c92350d2f64e",
                                                "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                                "text": "„Gotteshaus für Christen, Juden und Muslime: Das interreligiöse Projekt House of One nimmt Gestalt an: Der Bund will zehn Millionen Euro beisteuern, wenn Partner für die Kofinanzierung für das Haus am Berliner Petriplatz gefunden werden.“"
                                            },
                                            {
                                                "example_id": "01b1415a-ac40-4e16-bffb-16895d16c190",
                                                "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                                "text": "„Die drei großen Religionsgemeinschaften in Deutschland wollen das Hochschulleben stärker mitgestalten. Deshalb wurde am Donnerstag in Frankfurt ein erstes interreligiöses Positionspapier zur Rolle der Religionen an Hochschulen unterzeichnet.“"
                                            },
                                            {
                                                "example_id": "985cad20-8be6-4244-aa39-a03747642492",
                                                "sense_id": "3855acf6-2955-36be-baad-d1b9c67e99b7",
                                                "text": "„Rund 900 Christen, Muslime, Hindus, Buddhisten, Juden und andere Religionsvertreter aus mehr als 100 Ländern haben sich vom 20. - 23. August in Lindau zur 10. Weltversammlung der Organisation \"Religions for Peace\" getroffen. Es ist das größte interreligiöse Treffen der Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
