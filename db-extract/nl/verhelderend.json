                            {
                                "example_id": "49655b22-2d58-41e4-8db2-dd27cb53fdb1",
                                "sense_id": "68153924-efae-3f85-b5cd-12b9298bd8d9",
                                "text": "“Het beviel goed. Omdat hij wat ouder was en dus ook meer levenservaring had dan ik, had ik wel meer de neiging om hem te interviewen in plaats van in discussie te gaan. Dat was echter ook verhelderend: hij legde bijvoorbeeld uit waarom hij vindt dat het nu erg goed gaat met Nederland vergeleken met twintig of dertig jaar geleden.”"
                            }
                        ]
                    }
