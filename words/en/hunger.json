{
    "word_family": [
        "hungry",
        "hungrily"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7bbec11-c6c0-3118-8ede-bbe2e18011e8",
                    "sense_definition": "A need or compelling desire for food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_need",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ate the sandwich quickly to satisfy his <w>hunger</w>.",
                            "target_lang_translations": {
                                "ru": "Он быстро съел бутерброд, чтобы утолить <w>голод</w>.",
                                "zh": "他很快地吃掉了三明治以满足他的<w>饥饿</w>感。"
                            }
                        },
                        {
                            "text": "Many people in the region suffer from <w>hunger</w> and poverty.",
                            "target_lang_translations": {
                                "ru": "Многие люди в этом регионе страдают от <w>голода</w> и нищеты.",
                                "zh": "该地区的许多人正遭受<w>饥饿</w>和贫困的折磨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appetite"
                    ],
                    "antonyms": [
                        "satiety",
                        "satiation"
                    ],
                    "common_phrases": [
                        "satisfy hunger",
                        "pangs of hunger",
                        "die of hunger",
                        "hunger strike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потребность в еде или сильное желание есть.",
                        "zh": "对食物的生理需求或强烈的进食欲望。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "го́лод",
                                "target_lang_sense_clarification": "ощущение потребности в еде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "饥饿",
                                "target_lang_sense_clarification": "指生理上对食物的需求"
                            },
                            {
                                "target_lang_word": "饿",
                                "target_lang_sense_clarification": "指感到饥饿的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6799d3c6-5c05-3939-ab13-57d07c0e6a86",
                    "sense_definition": "Any strong desire or need for something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strong_desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete has a real <w>hunger</w> for success.",
                            "target_lang_translations": {
                                "ru": "У молодого спортсмена настоящая <w>жажда</w> успеха.",
                                "zh": "这位年轻运动员对成功有着真正的<w>渴望</w>。"
                            }
                        },
                        {
                            "text": "Her <w>hunger</w> for knowledge led her to read every book in the library.",
                            "target_lang_translations": {
                                "ru": "Её <w>жажда</w> знаний заставила её прочитать каждую книгу в библиотеке.",
                                "zh": "她对知识的<w>渴求</w>促使她读遍了图书馆里的每一本书。"
                            }
                        }
                    ],
                    "synonyms": [
                        "craving",
                        "desire",
                        "yearning",
                        "thirst"
                    ],
                    "common_phrases": [
                        "hunger for power",
                        "hunger for success",
                        "spiritual hunger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное желание или потребность в чём-либо.",
                        "zh": "对某事物的强烈渴望或需求。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жа́жда",
                                "target_lang_sense_clarification": "перен. сильное желание чего-либо"
                            },
                            {
                                "target_lang_word": "го́лод",
                                "target_lang_sense_clarification": "перен. острая нехватка чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "渴望",
                                "target_lang_sense_clarification": "指对某种目标或事物的强烈愿望"
                            },
                            {
                                "target_lang_word": "渴求",
                                "target_lang_sense_clarification": "指迫切地追求或需求"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c9a1e71-9f3d-3c67-addd-db2f6d49eae5",
                    "sense_definition": "To have a strong desire or craving for something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strong_desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans <w>hungered</w> for a victory after a long losing streak.",
                            "target_lang_translations": {
                                "ru": "Болельщики <w>жаждали</w> победы после долгой череды поражений.",
                                "zh": "在经历了一连串的失败后，球迷们<w>渴望</w>一场胜利。"
                            }
                        },
                        {
                            "text": "After years of silence, the public <w>hungered</w> for the truth.",
                            "target_lang_translations": {
                                "ru": "После долгих лет молчания общественность <w>жаждала</w> правды.",
                                "zh": "在多年的沉默之后，公众<w>渴求</w>真相。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crave",
                        "yearn",
                        "long",
                        "desire"
                    ],
                    "common_phrases": [
                        "hunger for",
                        "hunger after"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно желать или жаждать чего-либо.",
                        "zh": "对某事物有强烈的欲望或渴求。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жа́ждать",
                                "target_lang_sense_clarification": "страстно хотеть чего-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "渴望",
                                "target_lang_sense_clarification": "指内心深处强烈的愿望"
                            },
                            {
                                "target_lang_word": "渴求",
                                "target_lang_sense_clarification": "指迫切地想要得到某物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a809396-c2ad-3e0e-8c5f-86b87576f8b2",
                    "sense_definition": "To be in need of food.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_need",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refugees <w>hungered</w> for days before the supplies arrived.",
                            "target_lang_translations": {
                                "ru": "Беженцы <w>голодали</w> несколько дней, прежде чем прибыли припасы.",
                                "zh": "在补给到达之前，难民们已经<w>挨饿</w>了好几天。"
                            }
                        },
                        {
                            "text": "If your enemy <w>hungers</w>, you should feed him.",
                            "target_lang_translations": {
                                "ru": "Если твой враг <w>голодает</w>, ты должен накормить его.",
                                "zh": "如果你的敌人<w>挨饿</w>，你应该给他食物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "starve"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Modern English usually prefers 'to be hungry' or 'to starve'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать нужду в пище.",
                        "zh": "处于缺乏食物的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голода́ть",
                                "target_lang_sense_clarification": "испытывать голод, недоедать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挨饿",
                                "target_lang_sense_clarification": "指因缺乏食物而忍受饥饿"
                            },
                            {
                                "target_lang_word": "饥饿",
                                "target_lang_sense_clarification": "指长期处于缺乏食物的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}