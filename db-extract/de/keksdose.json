                        "examples": [
                            {
                                "example_id": "d23e07b6-ca58-407d-8ca4-b3600b94073a",
                                "sense_id": "36c88804-0f05-3b6e-ae87-dc1c600743a6",
                                "text": "Gib mir mal die Keksdose, sagte die Mutter."
                            },
                            {
                                "example_id": "55bbd516-bd3c-4a2c-9d21-ccc54a8d9afe",
                                "sense_id": "36c88804-0f05-3b6e-ae87-dc1c600743a6",
                                "text": "Eine gute Keksdose schützt die Kekse vor Feuchtigkeit."
                            },
                            {
                                "example_id": "cb76d986-0e29-4236-af29-eef276c14706",
                                "sense_id": "36c88804-0f05-3b6e-ae87-dc1c600743a6",
                                "text": "„Das bisschen, was sie gespart und unter ihren Deckchen oder in Keksdosen versteckt hatte, klauten ihr mit einer griechischen Variante des Enkeltricks auch noch dreiste Ganoven.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
