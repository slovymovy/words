                "senses": [
                    {
                        "sense_id": "4fd7632c-20dc-3b2f-8d28-926aa4ad4f94",
                        "entry_id": "bc446752-862b-3803-913d-58c697d2f268",
                        "glosses": [
                            "bewegingen en spanningen in de korst van planeten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "746c4d9a-7f2e-44d5-a685-6f176143d56f",
                                "sense_id": "4fd7632c-20dc-3b2f-8d28-926aa4ad4f94",
                                "text": "De tektoniek van Nederland wordt gekenmerkt door horsten en slenken."
                            }
                        ]
                    },
                    {
                        "sense_id": "abdbe6a7-07a6-3874-bfd5-0317e404b6e1",
                        "entry_id": "bc446752-862b-3803-913d-58c697d2f268",
                        "glosses": [
