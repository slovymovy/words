                        "glosses": [
                            "A term of address for a toad."
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "3bd82099-3993-4f98-a034-c82943d3f52e",
                                "sense_id": "0da5cb1f-8615-3966-9b7e-8d6c44092778",
                                "text": "The toad, which is an efficient bug hunter in the garden, is said by the Ohio Farmer to eat honey bees with an equal relish, and bee keepers are advised to arrange the lighting boards of the hives in such a manner as not to be accessible to his toadship."
                            },
                            {
                                "example_id": "67b53677-f6e4-4d8f-9548-9a4a08b7463a",
                                "sense_id": "0da5cb1f-8615-3966-9b7e-8d6c44092778",
                                "text": "[H]e had, in fact, happened to discover his toadship just in the act of making his annual toilet. The old skin wrinkled up more and more, till it was completely divided into two halves; the toad pulled out first one foot, then another, just as a boy pulls his arm out of a jacket, until at last the feat was accomplished."
                            }
                        ]
                    }
