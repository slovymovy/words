                "senses": [
                    {
                        "sense_id": "7a636f1d-e642-30bd-8555-6786b2cd6851",
                        "entry_id": "0fd61d51-3201-3c9e-a4ee-4d58e4fe0e32",
                        "glosses": [
                            "город и законодательная столица ЮАР, порт на юге Африки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d47bd471-5b52-449c-a3d1-47ad708353c4",
                                "sense_id": "7a636f1d-e642-30bd-8555-6786b2cd6851",
                                "text": "Бурные воды сороковых широт помиловали нас и не задали нам крепкой штормовой трёпки, но всё же к моменту прихода в Кейптаун я порядочно устал."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e714255-2e6e-34d9-8e0c-2fd1c06d8375",
                        "entry_id": "0fd61d51-3201-3c9e-a4ee-4d58e4fe0e32",
                        "glosses": [
                            "городской округ в Западно-Капской провинции ЮАР"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dc3f685d-8357-3fbd-854d-61e1b1a7eb13",
                        "entry_id": "0fd61d51-3201-3c9e-a4ee-4d58e4fe0e32",
                        "glosses": [
                            "аэропорт в Кейптауне [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf753fb-d2b7-4f6d-b910-8701a2e0d88e",
                                "sense_id": "dc3f685d-8357-3fbd-854d-61e1b1a7eb13",
                                "text": "В 2009 году Международный аэропорт Кейптаун получил премию Skytrax за лучший аэропорт в Африке."
                            }
                        ]
                    },
                    {
                        "sense_id": "adb0e72b-7502-392a-814f-8ebdd76fce4c",
                        "entry_id": "0fd61d51-3201-3c9e-a4ee-4d58e4fe0e32",
                        "glosses": [
                            "футбольный стадион в Кейптауне [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02f7271c-d2a7-4f3b-8776-e699e5ba830f",
                                "sense_id": "adb0e72b-7502-392a-814f-8ebdd76fce4c",
                                "text": "Стадион Кейптаун построен на месте старого стадиона Грин Пойнт, полностью разрушенного в 2007 году."
                            }
                        ]
                    }
                ],
