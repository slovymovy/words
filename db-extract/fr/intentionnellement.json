                                "target_senses": [
                                    {
                                        "sense_id": "359af1fb-971e-3921-aeb3-1f7e3e0907e6",
                                        "entry_id": "6b938de4-edea-3140-9bfd-fbb57b410516",
                                        "glosses": [
                                            "mit Absicht, Vorsatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9466afe-37a8-4239-b9f5-9771353bdf62",
                                                "sense_id": "359af1fb-971e-3921-aeb3-1f7e3e0907e6",
                                                "text": "„H. musste wegen vorsätzlichen Verstoßes gegen seine ärztlichen Berufspflichten 12000 Euro Buße zahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bde3abb9-c7cc-473b-aa7e-f222f5e50d6a",
                        "source_entry_id": "64537562-b60e-3b21-8846-b40fb37184d0",
                        "source_sense_id": "21d2b975-3166-3302-978c-bd18585337de",
                        "target_lang_word": "consciously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consciously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd842693-56c4-3c74-97f9-86eb48b1e9a8",
                                        "entry_id": "947be9cb-be1e-32ef-829c-8ce1922c2bd6",
                                        "glosses": [
                                            "In a conscious manner; knowingly, volitionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3622032-cb01-496e-a6d7-5027ff54c176",
                                                "sense_id": "cd842693-56c4-3c74-97f9-86eb48b1e9a8",
                                                "text": "History is almost always distorted by those who write it. It may be consciously changed as in the censorship of certain items, or it may be a reflection of the writer's lack of perception."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bebe3e93-99f2-4745-aa0f-cf33b633849c",
                        "source_entry_id": "64537562-b60e-3b21-8846-b40fb37184d0",
                        "source_sense_id": "21d2b975-3166-3302-978c-bd18585337de",
                        "target_lang_word": "deliberately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deliberately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                        "entry_id": "42cfed69-0936-3a52-820c-dc009339b4db",
                                        "glosses": [
                                            "Intentionally, or after deliberation; not accidentally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab75e1f-1903-43d3-a918-c83055f70cee",
                                                "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                                "text": "He deliberately broke that, didn't he?"
                                            },
                                            {
                                                "example_id": "fed1fd58-a2d6-4855-972a-93f84ff009f0",
                                                "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                                "text": "Major funding for this book was made possible by deliberately starving a family of four in Tennessee."
                                            },
                                            {
                                                "example_id": "3c4bf725-812b-4daf-a095-03ece4419ba7",
                                                "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                                                "text": "“As a result, OCR found that the district’s pattern of inconsistent responses to reports it received of sexual harassment – infrequently responding under Title IX or not responding at all – rose to the level that the district’s response to some families’ sexual harassment reports was deliberately indifferent to students’ civil rights,” a news release from DOE reads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9793113-f44f-33ad-a757-951c6e41f58c",
                                        "entry_id": "42cfed69-0936-3a52-820c-dc009339b4db",
                                        "glosses": [
                                            "Taking one's time, slowly and carefully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12512be0-345b-4ad3-91eb-9079027ca084",
                                                "sense_id": "f9793113-f44f-33ad-a757-951c6e41f58c",
                                                "text": "After being called upon, he strode deliberately up to the blackboard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51bea3bc-e5dd-4f56-9777-87cfcbd5b15f",
                        "source_entry_id": "64537562-b60e-3b21-8846-b40fb37184d0",
                        "source_sense_id": "21d2b975-3166-3302-978c-bd18585337de",
