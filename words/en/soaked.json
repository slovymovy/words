{
    "word_family": [
        "soak",
        "soaker",
        "soaking"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7f82e827-85f4-3d7d-af21-378651b83710",
                    "sense_definition": "Extremely wet or drenched with a liquid",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wetness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We forgot our umbrellas and got <w>soaked</w> to the skin during the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Мы забыли зонты и <w>промокли</w> до нитки под сильным дождем."
                            }
                        },
                        {
                            "text": "After falling into the pool, his clothes were completely <w>soaked</w> and heavy.",
                            "target_lang_translations": {
                                "ru": "После падения в бассейн его одежда стала совершенно <w>мокрой</w> и тяжелой."
                            }
                        }
                    ],
                    "synonyms": [
                        "drenched",
                        "saturated",
                        "sodden",
                        "wet",
                        "soaking"
                    ],
                    "antonyms": [
                        "dry",
                        "parched"
                    ],
                    "common_phrases": [
                        "soaked to the skin",
                        "completely soaked",
                        "soaked through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно мокрый или пропитанный жидкостью"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промокший",
                                "target_lang_sense_clarification": "насквозь под дождем или водой"
                            },
                            {
                                "target_lang_word": "пропитанный",
                                "target_lang_sense_clarification": "насквозь влагой или жидкостью"
                            },
                            {
                                "target_lang_word": "вымокший",
                                "target_lang_sense_clarification": "сильно намокший"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e948bd26-2c46-31dd-835e-5a2e2311c3dd",
                    "sense_definition": "Affected by drinking too much alcohol",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He arrived at the party already <w>soaked</w> and could barely stand up straight.",
                            "target_lang_translations": {
                                "ru": "Он пришел на вечеринку уже <w>пьяным</w> и едва мог стоять прямо."
                            }
                        },
                        {
                            "text": "The old sailor spent his evenings getting <w>soaked</w> at the local tavern.",
                            "target_lang_translations": {
                                "ru": "Старый моряк проводил вечера, <w>напиваясь</w> в местной таверне."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "sodden"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage for being drunk"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии сильного алкогольного опьянения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяный",
                                "target_lang_sense_clarification": "в стельку"
                            },
                            {
                                "target_lang_word": "напившийся",
                                "target_lang_sense_clarification": "до беспамятства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09468ea5-b5e2-38c3-b366-eaf6248aa998",
                    "sense_definition": "Having been physically attacked or beaten up",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully got <w>soaked</w> by the older boys after school yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера после школы старшие ребята <w>избили</w> хулигана."
                            }
                        },
                        {
                            "text": "He looked like he had been <w>soaked</w> in a street fight with several bruises on his face.",
                            "target_lang_translations": {
                                "ru": "Он выглядел так, будто его <w>отделали</w> в уличной драке: на лице было несколько синяков."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "regional or specific group slang for being beaten"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергшийся физическому нападению или избиению"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избитый",
                                "target_lang_sense_clarification": "в драке"
                            },
                            {
                                "target_lang_word": "отделанный",
                                "target_lang_sense_clarification": "разговорный сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "84a68026-5ab2-3026-af98-a60bc2ae41a9",
                    "sense_definition": "The past tense and past participle of <w>soak</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>soaked</w> the dirty dishes in warm soapy water for an hour.",
                            "target_lang_translations": {
                                "ru": "Она на час <w>замочила</w> грязную посуду в теплой мыльной воде."
                            }
                        },
                        {
                            "text": "The rain <w>soaked</w> the ground, making the garden soil very muddy.",
                            "target_lang_translations": {
                                "ru": "Дождь <w>пропитал</w> землю, сделав почву в саду очень грязной."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «замачивать» или «пропитывать»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замочил",
                                "target_lang_sense_clarification": "положил в воду"
                            },
                            {
                                "target_lang_word": "пропитал",
                                "target_lang_sense_clarification": "сделал влажным насквозь"
                            }
                        ]
                    }
                }
            ]
        }
