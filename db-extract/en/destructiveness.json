                "senses": [
                    {
                        "sense_id": "149f3c16-1d00-39fe-b6f1-11d19739e896",
                        "entry_id": "77057ec0-f532-35cc-8125-0154f6be674f",
                        "glosses": [
                            "The state or quality of being destructive."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fcf47ec1-d92e-4e70-92f1-7407a525d6d9",
                                "sense_id": "149f3c16-1d00-39fe-b6f1-11d19739e896",
                                "text": "Would Helen’s face-seductiveness have wrought as much destructiveness,\nWould Antony have followed Cleopatra like a lamb,\nUnless those ladies’ vanities for snaring male humanities\nHad been associated with a quantum suff. of glam.?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e8b73b9-5a9d-4d8d-a4b3-838696921a87",
                        "source_entry_id": "77057ec0-f532-35cc-8125-0154f6be674f",
                        "source_sense_id": "149f3c16-1d00-39fe-b6f1-11d19739e896",
                        "source_sense_description": "the state or quality of being destructive",
                        "target_lang_word": "destructivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destructivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6496c6cc-8007-3210-b682-57d2fc519ad7",
                                        "entry_id": "24a928e8-c7fb-3e78-90b3-b9044244daa3",
                                        "glosses": [
                                            "Penchant à détruire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbc0f0cb-df56-423f-b477-3a337d158f59",
                                                "sense_id": "6496c6cc-8007-3210-b682-57d2fc519ad7",
                                                "text": "Une fois déconstruite, cette tendance nous apparut comme le résultat d’un mécanisme d’identification projective par lequel des parties d’elle-même, en l’occurrence des parties mauvaises, issues de sa destructivité, étaient inconsciemment projetées à l’extérieur, et faisaient retour sur un mode persécutoire."
                                            },
                                            {
                                                "example_id": "0902c7a9-9a89-416a-84ec-d039907623e5",
                                                "sense_id": "6496c6cc-8007-3210-b682-57d2fc519ad7",
                                                "text": "Les théoriciens du trauma reprochent à ceux du conflit d’ignorer la réalité extérieure et en particulier violence et destructivité dans les relations humaines et leur importance dans la genèse des maladies psychiques, et de déplacer toute faute sur l’individu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
