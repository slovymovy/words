                ],
                "senses": [
                    {
                        "sense_id": "c7eb7225-2beb-3074-af13-10599153f9cc",
                        "entry_id": "2df9ea3a-f05b-34d5-bb44-b43366283a4a",
                        "glosses": [
                            "Essayer de donner à ses acheteurs l’impression d’être des favorisés, en donnant un caractère tendant vers le luxe à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3992380f-e64e-4837-b72d-199402183210",
                                "sense_id": "c7eb7225-2beb-3074-af13-10599153f9cc",
                                "text": "Bien sûr, toutes ces facéties ont un but : augmenter le prix de la bouteille d’Evian. « Premiumiser » la marque, comme martèlent les spécialistes."
                            },
                            {
                                "example_id": "06889d7a-24e2-41f0-9320-bb4ce62146c0",
                                "sense_id": "c7eb7225-2beb-3074-af13-10599153f9cc",
                                "text": "J'ai voulu revisiter la bonbonne, la premiumiser et la moderniser."
                            },
                            {
                                "example_id": "7211cc74-e40c-43a4-98b3-758315e54fe7",
                                "sense_id": "c7eb7225-2beb-3074-af13-10599153f9cc",
                                "text": "De quoi premiumiser le produit grand public et donner au consommateur un statut de privilégié."
                            },
                            {
                                "example_id": "cbce34f9-0ac9-4974-8bde-0e3f1095b055",
                                "sense_id": "c7eb7225-2beb-3074-af13-10599153f9cc",
                                "text": "PS: nous allons de ce pas nous premiumiser."
                            }
                        ]
                    }
