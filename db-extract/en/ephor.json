    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0f0f5c2c-bc83-3077-b0db-9b4bd7e1d9e2",
                "word": "ephor",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5dda92f7-6f55-4d1d-a6c6-eddb97b8d62c",
                        "entry_id": "0f0f5c2c-bc83-3077-b0db-9b4bd7e1d9e2",
                        "tags": [
                            "plural"
                        ],
                        "form": "ephors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9bf91021-e88e-3ec0-b0aa-ea3fc0521b6f",
                        "entry_id": "0f0f5c2c-bc83-3077-b0db-9b4bd7e1d9e2",
                        "glosses": [
                            "One of the five annually-elected senior magistrates in various Dorian states, especially in ancient Sparta, where they oversaw the actions of Spartan kings."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "96d46ea3-6f39-4ca2-a437-a9d80486f6f4",
                                "sense_id": "9bf91021-e88e-3ec0-b0aa-ea3fc0521b6f",
                                "text": "Agesilaus was fined by the Ephories, because he had drawne the hearts and good wills of al his fellow-citizens unto himselfe alone."
                            },
                            {
                                "example_id": "99a313a3-487a-45c8-87a6-e24b069fd45c",
                                "sense_id": "9bf91021-e88e-3ec0-b0aa-ea3fc0521b6f",
                                "text": "Then one of his servants came and told him the news, as he sat in council with the Ephors; whereat, remembering when it was that the woman became his wife, he counted the months upon his fingers, and having so done, cried out with an oath, \"The boy cannot be mine.\" This was said in the hearing of the Ephors; but they made no account of it at the time."
                            },
                            {
                                "example_id": "6a93251a-ad60-4609-bcd9-62ec433d8026",
                                "sense_id": "9bf91021-e88e-3ec0-b0aa-ea3fc0521b6f",
                                "text": "Originally associated with the social system, the agoge (see CAH III.I², 742), the ephors rose to some constitutional importance when the senior ephor became the eponymous official of the year in 754, perhaps in connexion with the oaths made at the beginning of the year and renewed each month between the kings and the ephors:[…]."
                            },
                            {
                                "example_id": "01c9bce4-2322-4539-964c-d861d9c2a88d",
                                "sense_id": "9bf91021-e88e-3ec0-b0aa-ea3fc0521b6f",
                                "text": "For basic duties, the ephors convened both the Spartan boulê of kings and elders and the assemblies. In times of war, the ephors were responsible for mustering troops, determining what age groups of soldiers would be sent out to battle, and determining how many would be sent."
                            },
                            {
                                "example_id": "5ecdb3eb-48e4-4203-8a5d-095c3276c95a",
                                "sense_id": "9bf91021-e88e-3ec0-b0aa-ea3fc0521b6f",
                                "text": "Moreover, as he^([Cleomenes]) was laying his plans, he was given a sign that he had divine sanction—an ephor told him that he had had a dream in which the ephors’ chairs had been removed and a divine voice told him that this was best for Sparta."
                            }
                        ]
                    },
                    {
                        "sense_id": "66da3edb-274e-35e1-9f97-e7c978c641af",
                        "entry_id": "0f0f5c2c-bc83-3077-b0db-9b4bd7e1d9e2",
                        "glosses": [
                            "A superintendent or curator."
                        ],
                        "tags": [
                            "in modern Greece"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "113f9f2c-bdad-447b-ab95-52fb6d69bda4",
                        "source_entry_id": "0f0f5c2c-bc83-3077-b0db-9b4bd7e1d9e2",
                        "source_sense_description": "superintendent",
                        "target_lang_word": "éphore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éphore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "871d5617-ca11-3fa1-86df-19c749adad1a",
                                        "entry_id": "9923d6f6-ad15-3870-b51d-5e2e9b8ae5a4",
                                        "glosses": [
                                            "Magistrat lacédémonien (de Sparte) établi pour contrebalancer l’autorité des rois et de la gérousie."
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45334eda-ae33-447d-a0e2-8a96074e1313",
                                                "sense_id": "871d5617-ca11-3fa1-86df-19c749adad1a",
                                                "text": "Les éphores étaient au nombre de cinq et élus pour une année."
                                            },
                                            {
                                                "example_id": "3ff8e506-f19b-4143-95c5-6c63f5268165",
                                                "sense_id": "871d5617-ca11-3fa1-86df-19c749adad1a",
                                                "text": "Il y avait des éphores à Sparte, mais aussi à Théra et Cyrène."
                                            },
                                            {
                                                "example_id": "c30bcb11-aaf9-4cf5-b925-d7552ce31d27",
                                                "sense_id": "871d5617-ca11-3fa1-86df-19c749adad1a",
                                                "text": "La puissance des éphores pourrait aussi être affectée par leurs conflits avec les rois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10091c7e-18fa-3bdb-a4ee-ea1eb39a7466",
                                        "entry_id": "9923d6f6-ad15-3870-b51d-5e2e9b8ae5a4",
                                        "glosses": [
                                            "Directeur d'une circonscription archéologique dans la Grèce contemporaine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
