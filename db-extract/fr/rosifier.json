                        "glosses": [
                            "Faire devenir rose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac1d9f86-0ec2-4ee3-9911-4506a1472dbf",
                                "sense_id": "51e9bd45-4c4b-364f-a693-61436b970c05",
                                "text": "Quel dommage d'amuser les femmes avec une si éclatante palette, d'autant que la saturation des étoffes force l'artiste à rosifier les visages, à émailler les chairs ;"
                            },
                            {
                                "example_id": "4f4501e8-2f70-4235-913e-faa15d7fa239",
                                "sense_id": "51e9bd45-4c4b-364f-a693-61436b970c05",
                                "text": "Et sur ces mots, ledit Apothéose se mit à gonfler, ses contours à se préciser, sa peau à se rosifier jusqu'à ce que tu puisses distinguer fort nettement des traits."
                            }
                        ]
                    }
