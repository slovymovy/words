                "senses": [
                    {
                        "sense_id": "14c25761-173b-34df-8c33-d2e10afee358",
                        "entry_id": "3d526e78-9f56-306e-87b2-8050e8fa6775",
                        "glosses": [
                            "natürlicher Vorgang der Ionisation von Luft durch die Sonne"
                        ],
                        "tags": [],
