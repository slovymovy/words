        "ru-extract.jsonl": [
            {
                "entry_id": "cc47e729-aa39-3cc2-a686-61a36229f09b",
                "word": "видать",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a0d5376-c9d2-35bf-8a5c-4698f97f3c60",
                        "entry_id": "cc47e729-aa39-3cc2-a686-61a36229f09b",
                        "glosses": [
                            "· можно видеть, рассмотреть; видно"
                        ],
                        "tags": [
                            "безл. в знач. сказ."
                        ],
                        "examples": [
                            {
                                "example_id": "381f5b7e-289d-4c4f-afb5-ebbdd115baf2",
                                "sense_id": "3a0d5376-c9d2-35bf-8a5c-4698f97f3c60",
                                "text": "Ничего не видать."
                            }
                        ]
                    },
                    {
                        "sense_id": "6dcb4c1b-6c03-3325-b248-3897ecfe862c",
                        "entry_id": "cc47e729-aa39-3cc2-a686-61a36229f09b",
                        "glosses": [
                            "· очевидно, по-видимому, должно быть"
                        ],
                        "tags": [
                            "parenthetic"
                        ],
                        "examples": [
                            {
                                "example_id": "87cec104-5a35-41bb-80e0-582be1bb2059",
                                "sense_id": "6dcb4c1b-6c03-3325-b248-3897ecfe862c",
                                "text": "Хозяин отбивается, но, видать, она его не очень-то садит — учёная."
                            },
                            {
                                "example_id": "040c22bb-6cad-498c-8382-4aecd20b7b18",
                                "sense_id": "6dcb4c1b-6c03-3325-b248-3897ecfe862c",
                                "text": "Девка, видать, не его судьбы: от парня нос воротила, а сама на тамошнего самолучшего бойца глаза пялила."
                            },
                            {
                                "example_id": "98a9f02e-3051-437e-8c8e-4cfd3df373c8",
                                "sense_id": "6dcb4c1b-6c03-3325-b248-3897ecfe862c",
                                "text": "Жизнь, видать, странно и глупо так устроена, что в данную минуту мы принимаем решение под воздействием чего-то, а затем поражаемся собственной слепоте, но уже не поправить ничего…"
                            }
                        ]
                    }
                ],
                "translations": [],
