                    "frequency": "Middle",
                    "semantic_group_id": "tort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les employés estiment que ce nouvel accord va <w>léser</w> leurs droits fondamentaux."
                        },
                        {
                            "text": "L'acheteur s'est senti profondément <w>lésé</w> après avoir découvert les défauts cachés du véhicule."
                        }
                    ],
                    "synonyms": [
                        "faire tort",
                        "prétériter"
                    ],
                    "common_phrases": [
