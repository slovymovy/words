                                        "entry_id": "ba0fd4be-8884-3b30-9581-7d25a814e1a1",
                                        "glosses": [
                                            "The area by and around the sea; including the beach, promenade or cliffs"
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82cd250c-7424-4b85-819b-f51bbc60bacd",
                                                "sense_id": "c1c77285-bf6c-38fe-af7d-2931aa729365",
                                                "text": "This summer, I'm going to the seaside at Weymouth - I'm very excited about it!"
                                            },
                                            {
                                                "example_id": "1ee6bc3d-4bee-4b87-8791-2f18f848aa6e",
                                                "sense_id": "c1c77285-bf6c-38fe-af7d-2931aa729365",
                                                "text": "I do like to be beside the seaside!\nOh, I do like to be beside the sea!\nI do like to stroll along the prom, prom, prom,\nWhile the brass bands play Tiddely-om-pom-pom!"
                                            },
                                            {
                                                "example_id": "6d1d436f-0294-48cb-944a-4eeacc0a578d",
                                                "sense_id": "c1c77285-bf6c-38fe-af7d-2931aa729365",
                                                "text": "James never cared much for the sea-side, but developed a passionate love for the Westmoreland mountains, getting to know most of them as an energetic fell walker, preferring this to rock climbing."
                                            },
                                            {
                                                "example_id": "f6fe625e-da0d-4587-b7e8-fe7a29d66625",
                                                "sense_id": "c1c77285-bf6c-38fe-af7d-2931aa729365",
                                                "text": "The arrival of the railway turned this isolated fishing village into a popular seaside destination for Victorians who came to breathe fresh sea air, clear their lungs or take the waters."
                                            }
                                        ]
                                    }
