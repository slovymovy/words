            {
                "entry_id": "7e3b7d87-4832-33ba-8ad5-7b843e1bf252",
                "word": "liao",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "429b9a1a-e3e5-32bb-9f93-321e6bded83d",
                        "entry_id": "7e3b7d87-4832-33ba-8ad5-7b843e1bf252",
                        "glosses": [
                            "Meats, vegetables, and other ingredients added to an otherwise plain dish."
                        ],
                        "tags": [
                            "Singapore",
                            "colloquial",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e5d587bf-e50a-4eda-83f1-d17f3cb51b9a",
                                "sense_id": "429b9a1a-e3e5-32bb-9f93-321e6bded83d",
                                "text": "Bak Chor Mee, less mee, Auntie. No extra liao today."
                            },
                            {
                                "example_id": "46813b3c-0075-4df0-b637-86f4828604a3",
                                "sense_id": "429b9a1a-e3e5-32bb-9f93-321e6bded83d",
                                "text": "Had this hearty bowl of bak chor mee today at Blk 58 New Upper Changi Road market. […] This is the $5 bowl with extra liao. […]"
                            },
                            {
                                "example_id": "b3f43cdc-3666-4cdb-b5d3-f36cfe712cac",
                                "sense_id": "429b9a1a-e3e5-32bb-9f93-321e6bded83d",
                                "text": "But for all the eggs and liao (ingredients) you have, it isn’t gao (strong)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "134ec3d8-96ec-3e7a-b4de-a9f187970f2a",
                "word": "liao",
                "pos": "particle",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fa74ae9a-7f38-3c3f-8bc8-cd8cbb55fc2a",
                        "entry_id": "134ec3d8-96ec-3e7a-b4de-a9f187970f2a",
                        "glosses": [
                            "Indicates action completion, or more generally, perfective aspect."
                        ],
                        "tags": [
                            "Manglish",
                            "Singlish"
                        ],
                        "examples": [
                            {
                                "example_id": "b238d9e0-0795-4d14-85f9-4757a4975771",
                                "sense_id": "fa74ae9a-7f38-3c3f-8bc8-cd8cbb55fc2a",
                                "text": "I run 4 laps liao.",
                                "translation": "I just ran 4 laps.",
                                "english": "I just ran 4 laps."
                            },
                            {
                                "example_id": "352b9113-279f-4862-9e05-456226f7443e",
                                "sense_id": "fa74ae9a-7f38-3c3f-8bc8-cd8cbb55fc2a",
                                "text": "You decorate the cake liao?",
                                "translation": "Have you decorated the cake yet?",
                                "english": "Have you decorated the cake yet?"
                            },
                            {
                                "example_id": "43df4528-4355-44ec-a49e-6dd2f81174f1",
                                "sense_id": "fa74ae9a-7f38-3c3f-8bc8-cd8cbb55fc2a",
                                "text": "I’ve been working for six months liao.",
                                "translation": "I’ve been working for six months already.",
                                "english": "I’ve been working for six months already."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9847f88-0f23-37c8-a1b4-434138029e36",
                        "entry_id": "134ec3d8-96ec-3e7a-b4de-a9f187970f2a",
                        "glosses": [
                            "Marks a change in state, more or less in the same manner as the inchoative aspect (see usage notes)."
                        ],
                        "tags": [
                            "Manglish",
                            "Singlish"
                        ],
                        "examples": [
                            {
                                "example_id": "ec2fb0d3-1fb2-44ab-858e-1c951ca30662",
                                "sense_id": "a9847f88-0f23-37c8-a1b4-434138029e36",
                                "text": "It’s going to rain liao.",
                                "translation": "It’s going to start raining soon.",
                                "english": "It’s going to start raining soon."
                            },
                            {
                                "example_id": "1a59861f-9bd7-4704-83bd-ab3e2bfd164e",
                                "sense_id": "a9847f88-0f23-37c8-a1b4-434138029e36",
                                "text": "Reach liao, give me a call.",
                                "translation": "Give me a call when you’ve reached.",
                                "english": "Give me a call when you’ve reached."
                            },
                            {
                                "example_id": "dc13591b-b6b1-416f-b124-c5dd51e882a8",
                                "sense_id": "a9847f88-0f23-37c8-a1b4-434138029e36",
                                "text": "Damn shag liao, need to go back and sleep.",
                                "translation": "I’m really tired now, I need to go back and sleep.",
                                "english": "I’m really tired now, I need to go back and sleep."
                            },
                            {
                                "example_id": "21d565a2-a881-4d42-acc6-5652cdb98cbb",
                                "sense_id": "a9847f88-0f23-37c8-a1b4-434138029e36",
                                "text": "It was a weekday and I asked for a bowl of hokkien mee. The old lady told me “No more liao, you came too late”. Ok fine, it was my fault on getting here too late."
                            },
                            {
                                "example_id": "5b2ca49b-5cbf-4f8d-8c43-4941812159c9",
                                "sense_id": "a9847f88-0f23-37c8-a1b4-434138029e36",
                                "text": "“Of course I’m sympathetic […] But you’re dead liao mah. Your parents also were suffering. Angry for what now?”"
                            },
                            {
                                "example_id": "2496ec77-d7d2-4f60-97ea-cd0ea5e22bc4",
                                "sense_id": "a9847f88-0f23-37c8-a1b4-434138029e36",
                                "text": "McKing then asks, “Will there be a tree of sadness?”\n“No?” I utter, begrudgingly and slightly confused.\n“Cured liao lor,” he says."
                            }
                        ]
                    },
                    {
                        "sense_id": "dff1ccaa-2a46-3084-b989-403884eb4dd7",
                        "entry_id": "134ec3d8-96ec-3e7a-b4de-a9f187970f2a",
                        "glosses": [
                            "Marks a change in state, more or less in the same manner as the inchoative aspect (see usage notes).",
                            "Used to emphasize that something has to be done now."
                        ],
                        "tags": [
                            "Manglish",
                            "Singlish"
                        ],
                        "examples": [
                            {
                                "example_id": "99ebb6f8-c28f-43d0-b3c4-ffcac7a66d55",
                                "sense_id": "dff1ccaa-2a46-3084-b989-403884eb4dd7",
                                "text": "Go liao!",
                                "translation": "What are you waiting for? It’s time to go!",
                                "english": "What are you waiting for? It’s time to go!"
                            }
                        ]
                    }
