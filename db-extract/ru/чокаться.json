                "senses": [
                    {
                        "sense_id": "48f31e07-e9c2-3d90-b8a8-d4e9ef6d7ddb",
                        "entry_id": "7547a616-3a17-3c20-acaf-d7bbee41a5b0",
                        "glosses": [
                            "слегка соударяться бокалами, рюмками и т.п. при совместном питье вина (в знак приветствия, поздравления и т.п.)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8527e78e-d290-3dc4-9400-dc9be2c252ff",
                        "entry_id": "7547a616-3a17-3c20-acaf-d7bbee41a5b0",
                        "glosses": [
                            "перен. разг. сходить с ума"
                        ],
                        "tags": [],
