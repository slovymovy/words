                        "tags": [],
                        "examples": [
                            {
                                "example_id": "192a11eb-871b-4cda-851b-ca0306dccc05",
                                "sense_id": "65ee515f-062a-3697-b0ad-b5850c68b0a9",
                                "text": "„1905 operierte nämlich die erste regelmäßige Kraftpostlinie in Bayern zwischen Bad Tölz und Lenggries.“"
                            },
                            {
                                "example_id": "7858f33a-79ab-4c50-9692-1b568ede7117",
                                "sense_id": "65ee515f-062a-3697-b0ad-b5850c68b0a9",
                                "text": "„Die Straßenzüge tragen dem modernen Autoverkehr weitgehendst Rechnung, sodaß selbst die Postdirektionen allerorts ständige Kraftpostlinien einlegen konnten; die neuen Straßenzüge sind größtenteils staubfrei angelegt.“"
                            }
                        ],
