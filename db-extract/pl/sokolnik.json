                                        "entry_id": "00b80209-0f52-314f-ae50-f1b2ddd2d616",
                                        "glosses": [
                                            "Relatif à Faucon-du-Caire, commune française située dans le département des Alpes-de-Haute-Provence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
