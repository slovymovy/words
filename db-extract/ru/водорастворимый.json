                                        "examples": [
                                            {
                                                "example_id": "9c45f701-b774-4eb9-8b3f-7da51b252f8d",
                                                "sense_id": "64bc5f0e-ecd8-3e8b-94e7-d9ef9bac7f4b",
                                                "text": "Nous employons ici systématiquement comme liquide de contraste des solutions triiodées hydrosolubles de faible concentration (25 % à 35 % max.)."
                                            },
                                            {
                                                "example_id": "dcc00bf3-0254-44f4-9ed8-386fcb01ee5c",
                                                "sense_id": "64bc5f0e-ecd8-3e8b-94e7-d9ef9bac7f4b",
                                                "text": "Ainsi, les médicaments liposolubles quittent plus rapidement le sang pour pénétrer dans les tissus que les substances hydrosolubles."
                                            }
