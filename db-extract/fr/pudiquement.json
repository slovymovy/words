        "fr-extract.jsonl": [
            {
                "entry_id": "2fc91472-d22b-393c-843b-785e9de07f9d",
                "word": "pudiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "06a4f1e4-1018-3258-804e-4a47cfcc981c",
                        "entry_id": "2fc91472-d22b-393c-843b-785e9de07f9d",
                        "glosses": [
                            "D’une manière pudique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f65659-cbeb-4714-a7d3-1e0c13e6b20f",
                                "sense_id": "06a4f1e4-1018-3258-804e-4a47cfcc981c",
                                "text": "Piacam-piacam, elle s’en retourna jusqu’à la lisière du bosquet, et, à l’ombre, elle s’assit sur les talons, les mains croisées sur le ventre, sa jupe bariolée pendant pudiquement entre ses genoux luisants."
                            },
                            {
                                "example_id": "3a5801ea-2afd-4d91-992f-214bf67b8502",
                                "sense_id": "06a4f1e4-1018-3258-804e-4a47cfcc981c",
                                "text": "Parmi les départs, relativement fréquents étaient donc ceux qui se faisaient, non pas en direction du domicile des intéressés, mais vers ce bâtiment pudiquement baptisé « réserve » qui, caché par un rideau d’arbres au fond du parc, faisait office de dépositoire mortuaire avant l’enlèvement des corps par les familles."
                            },
                            {
                                "example_id": "fb7eb301-d986-430b-8bb1-547f8c0e4254",
                                "sense_id": "06a4f1e4-1018-3258-804e-4a47cfcc981c",
                                "text": "Claude Riendeau, lui, est un ex-flic devenu voleur à main armée, usurier, trafiquant de coke et « détaillant » d’armes, comme il aime dire pudiquement."
                            }
                        ]
                    }
                ],
