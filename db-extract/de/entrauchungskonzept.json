                "senses": [
                    {
                        "sense_id": "809ff993-40bd-36e1-9fd6-63dcda91c0e3",
                        "entry_id": "679cab9d-66b5-3dea-9813-4a09497b1c67",
                        "glosses": [
                            "klar umrissener Plan zur Lösung eines rauchschutztechnischen Problems, vor allem im Zusammenhang mit der mechanischen Entrauchung über Lüftung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25ce620-7008-4dd0-8c83-56b5e273ad9d",
                                "sense_id": "809ff993-40bd-36e1-9fd6-63dcda91c0e3",
                                "text": "„Für ein funktionierendes Entrauchungskonzept, muss unter Einbindung des Personals ein Personalbedarf während der Betriebszeiten unter Berücksichtigung von Urlaub, Krankheit und einer zusätzlichen Ausfallquote berücksichtigt werden.“"
                            },
                            {
                                "example_id": "2318575b-8970-4322-b963-3987bd2331c7",
                                "sense_id": "809ff993-40bd-36e1-9fd6-63dcda91c0e3",
                                "text": "„Durch funktionelle moderne Entrauchungskonzepte kann die Gefahr für Personen auf ein Minimum reduziert, das Ausmass der Sachschäden beschränkt und die Dauer möglicher Betriebsunterbrüche bedeutend verkürzt werden.“"
                            },
                            {
                                "example_id": "7fe370d0-fa01-405a-afc8-714d812dc749",
                                "sense_id": "809ff993-40bd-36e1-9fd6-63dcda91c0e3",
                                "text": "„Entrauchungskonzepte sind als Dokumentation in Berichtsform der Kantonalen Feuerpolizei vor Baubeginn zur Genehmigung einzureichen.“"
                            },
                            {
                                "example_id": "46c85296-bf88-45b2-8694-754e49bba988",
                                "sense_id": "809ff993-40bd-36e1-9fd6-63dcda91c0e3",
                                "text": "„Das Ergebnis sämtlicher Entrauchungskonzepte hängt von der Wahl des richtigen Modells und dem verantwortungsbewussten Ansatz der Eingangsparameter ab.“"
                            },
                            {
                                "example_id": "07157232-2674-4374-821c-c431ec993d2c",
                                "sense_id": "809ff993-40bd-36e1-9fd6-63dcda91c0e3",
                                "text": "„Die Bildung von Rauchabschnitten muß auf der Basis eines Entrauchungskonzeptes erfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
