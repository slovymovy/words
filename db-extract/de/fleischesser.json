                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d1d97b-0e60-4637-84fa-b7a7deb75b56",
                                "sense_id": "2eebd3ec-27f0-3f15-811e-e09662a03cb3",
                                "text": "„Er ist Vegetarier, aber seine Eltern sind brutale Fleischesser.“"
                            },
                            {
                                "example_id": "79b033e6-b20a-4741-898a-641bb102e3f1",
                                "sense_id": "2eebd3ec-27f0-3f15-811e-e09662a03cb3",
                                "text": "„Doch in einem Punkt könnten sich diese Eiszeitmenschen von unseren Vorfahren unterschieden haben: Sie waren möglicherweise doch fast reine Fleischesser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
