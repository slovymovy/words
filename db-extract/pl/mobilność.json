                                "target_senses": [
                                    {
                                        "sense_id": "d4710a5f-98de-34d1-815e-e28ed920c107",
                                        "entry_id": "223c5b06-92af-3df8-95be-8ab412e81375",
                                        "glosses": [
                                            "The ability to move; capacity for movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85834318-3091-4da2-bc40-9c2b40beba56",
                                                "sense_id": "d4710a5f-98de-34d1-815e-e28ed920c107",
                                                "text": "I find the enduring existence of high heels both a frustrating mystery and a testament to the triumph of women’s neuroses over their mobility."
                                            },
                                            {
                                                "example_id": "b2c9a6dd-c1c9-4f85-9786-5061c7c7933d",
                                                "sense_id": "d4710a5f-98de-34d1-815e-e28ed920c107",
                                                "text": "In the late 19th and early 20th century, the festive season was also a period of great mobility before, during and after Christmas Day. But the railways kept working."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0acf118e-248e-3a3a-a696-d55cef735ced",
                                        "entry_id": "223c5b06-92af-3df8-95be-8ab412e81375",
                                        "glosses": [
                                            "A tendency to sudden change; mutability, changeableness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84ae2301-d928-3bc9-9724-2d0b0745dc10",
                                        "entry_id": "223c5b06-92af-3df8-95be-8ab412e81375",
                                        "glosses": [
                                            "The ability of a military unit to move or be transported to a new position."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04e09abc-1999-3af3-ba2c-01de512b7104",
                                        "entry_id": "223c5b06-92af-3df8-95be-8ab412e81375",
                                        "glosses": [
                                            "The degree to which particles of a liquid or gas are in movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "755e886d-cb1c-3587-bf31-a9f426f69997",
                                        "entry_id": "223c5b06-92af-3df8-95be-8ab412e81375",
                                        "glosses": [
                                            "The ability of people to move between different social levels or professional occupations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31c06821-ff7e-4935-bb28-06ecc01f1b2c",
                                                "sense_id": "755e886d-cb1c-3587-bf31-a9f426f69997",
                                                "text": "The difficulty of rising up the economic ladder is reflected in the decline in mobility in the United States. […] The frustration over the lack of mobility is particularly acute for those without college degrees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5498db4a-7dea-44e1-a095-2a160a0767ca",
                        "source_entry_id": "d6cf9b11-0cac-35f0-9329-80c16cace314",
