                "senses": [
                    {
                        "sense_id": "2e4ac27d-1795-3a51-929a-0f45159724c1",
                        "entry_id": "cc0dedc6-e662-361d-81d2-716aef4b5f28",
                        "glosses": [
                            "ein Tier betreffende Votivgabe durch einen Votanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29d9156-99eb-4f8c-9c62-a4699b950b07",
                                "sense_id": "2e4ac27d-1795-3a51-929a-0f45159724c1",
                                "text": "„Geopfert hat man ihm Ketten aus Eisen oder in Eisen geschmiedete Votivgaben (Tiervotive: Rinder, Ziegen …).“"
                            },
                            {
                                "example_id": "b0c7130f-4bdb-49ac-9b18-329a65b7575c",
                                "sense_id": "2e4ac27d-1795-3a51-929a-0f45159724c1",
                                "text": "„Als letztes handgeschnitztes Tiervotiv bilde ich ein sehr primitives Schwein ab, Abb. 5, Fig. 2, das recht plump und ungelenk wirkt.“"
                            },
                            {
                                "example_id": "1801cb23-e4c2-4f2d-a07d-c44cc9ea1e29",
                                "sense_id": "2e4ac27d-1795-3a51-929a-0f45159724c1",
                                "text": "„Tiervotive wie dieses Pferdchen sollten im 8.- vorchristlichen Jahrhundert die Bitten der Stifter um das Wohlergehen ihrer Herden gewährleisten und dienten vielleicht mit ihrer strukturierten Basisplatte auch als Stempelsiegel und damit der Kennzeichnung von Identität und Eigentum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
