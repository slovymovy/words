        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a97ec765-d92c-3602-8b4f-d65036562b13",
                    "sense_definition": "Absent, missing, or hard to find for a period of time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "missing_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My boss has been <w>MIA</w> all morning, so I cannot ask for approval.",
                            "target_lang_translations": {
                                "ru": "Мой начальник <w>пропал</w> на все утро, поэтому я не могу получить одобрение.",
                                "pl": "Mój szef <w>zniknął</w> na cały ranek, więc nie mogę poprosić o zatwierdzenie."
                            }
                        },
                        {
                            "text": "Sorry I went <w>MIA</w> last week; I was sick and didn't check my phone.",
                            "target_lang_translations": {
                                "ru": "Извини, что я <w>пропал</w> на прошлой неделе; я болел и не проверял телефон.",
