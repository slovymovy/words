                                "target_senses": [
                                    {
                                        "sense_id": "55e9a54b-bfa1-36d3-8abe-0e79fc570c00",
                                        "entry_id": "70c2a636-9f4a-39c2-bcbe-9531189f2ea4",
                                        "glosses": [
                                            "The state of being productive, fertile, or efficient."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0174c964-c471-335a-a25f-8d5d2ecb9153",
                                        "entry_id": "70c2a636-9f4a-39c2-bcbe-9531189f2ea4",
                                        "glosses": [
                                            "The rate at which goods or services are produced by a standard population of workers; those workers' degree of efficiency."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1345adfc-8c1e-4133-8926-29271f23ced3",
                                                "sense_id": "0174c964-c471-335a-a25f-8d5d2ecb9153",
                                                "text": "You can see the computer age everywhere but in the productivity statistics."
                                            },
                                            {
                                                "example_id": "94b68de1-65de-43ae-be8c-2a72b90d6787",
                                                "sense_id": "0174c964-c471-335a-a25f-8d5d2ecb9153",
                                                "text": "Productivity growth has disappointed across the western world since the 2008 financial crisis. But the UK has notched a significantly worse performance than many of its peers on this metric of output for each hour of work – which is a vital driver of economic growth, wages and living standards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eddef40-ff0b-3f82-948f-d3e7657b2c95",
                                        "entry_id": "70c2a636-9f4a-39c2-bcbe-9531189f2ea4",
                                        "glosses": [
                                            "The rate at which crops are grown on a standard area of land."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0c15290-2463-3b52-8095-69ced3ecd9a3",
                                        "entry_id": "70c2a636-9f4a-39c2-bcbe-9531189f2ea4",
                                        "glosses": [
                                            "The ability to form new words using established patterns and discrete linguistic elements, such as the derivational affixes -ness and -ity; the degree to which such formation happens."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c3aa240-abef-4f1c-aa09-754ca1032ad6",
                        "source_entry_id": "083252e9-f10d-3100-b366-f80c9093e67d",
                        "source_sense_id": "fb0a74b7-29a5-3fc2-b82c-47ca4b897d3f",
                        "target_lang_word": "productivité",
