                "senses": [
                    {
                        "sense_id": "b26b2d93-7578-3752-86f8-11a3600e2883",
                        "entry_id": "93f3edd6-5199-3b0f-841d-47289a7ee32b",
                        "glosses": [
                            "Variante orthographique, parfois rencontrée, de reverrouiller (verrouiller à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd5c5f0a-e748-4baa-93fb-738b5712f7a4",
                                "sense_id": "b26b2d93-7578-3752-86f8-11a3600e2883",
                                "text": "C’est la personne qui revint ici vers onze heures, qui ouvrit la porte de la chambre de l’infirmière à l’aide d’une clef dont elle seule pouvait se servir, qui traversa ladite chambre, tira le verrou et entra chez Miles Despard en portant une tasse contenant du poison sous le couvert d’un médicament qu’il était dans son rôle de faire absorber au malade, qui repassa ensuite dans l’autre chambre, re-verrouilla la porte de communication et se retrouva enfin dans le couloir après avoir refermé l’autre porte avec sa clef…"
                            },
                            {
                                "example_id": "5f49a5dd-e135-48e8-aa67-a45d4ddec9fb",
                                "sense_id": "b26b2d93-7578-3752-86f8-11a3600e2883",
                                "text": "Et le crâne en feu, la peur au ventre, re-verrouiller ses fers sur sa cheville, extraire son propre plan sous la planche à laver, y enfourner la clé."
                            },
                            {
                                "example_id": "34c3a7af-ba50-4cd2-8fdb-fa81ed55dbe4",
                                "sense_id": "b26b2d93-7578-3752-86f8-11a3600e2883",
                                "text": "Dé-flasher son kernel, ou re-verrouiller son Xperia V ?"
                            }
                        ]
                    }
                ],
