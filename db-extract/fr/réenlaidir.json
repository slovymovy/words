                "senses": [
                    {
                        "sense_id": "23764df6-047d-37d3-9ae6-edea6ecee0a8",
                        "entry_id": "3c17c9e5-8f10-3162-861c-2d7c1954e76f",
                        "glosses": [
                            "Enlaidir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "575c2890-c6b0-47e1-b55d-d5511faf1eb4",
                                "sense_id": "23764df6-047d-37d3-9ae6-edea6ecee0a8",
                                "text": "Et pourtant, que de drames dans cette demeure qui, de belle, devint laide, avant de se réenlaidir à nouveau, faute de soins, tel un visage oublié à qui l’on ne fait même plus l’aumône des quelques soins d’usage."
                            },
                            {
                                "example_id": "ed0f2dad-bf12-49e2-95a0-5be85d11f44e",
                                "sense_id": "23764df6-047d-37d3-9ae6-edea6ecee0a8",
                                "text": "Ils doivent vraiment passer du temps à choisir les cliché les plus raté, et passer éventuellement un coup de toshop pour réenlaidir le tout au cas où ce serait encore trop potable..."
                            }
                        ]
                    }
