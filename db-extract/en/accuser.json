                                "target_senses": [
                                    {
                                        "sense_id": "814ca9ea-379d-32ef-a8da-17dbef7aa007",
                                        "entry_id": "6234e2f6-0723-33d6-9bba-9f36486f8059",
                                        "glosses": [
                                            "Féminin singulier de accusateur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0119e7ff-5b34-440b-91cf-9e66dd0018a2",
                                                "sense_id": "814ca9ea-379d-32ef-a8da-17dbef7aa007",
                                                "text": "[…] qu’une pensée accusatrice appelle aujourd’hui le parti de la violence, en opposition au parti de la légalité, objet de toutes les prédilections de la royauté nouvelle."
                                            }
