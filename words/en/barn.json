        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ddb3a1b3-d1d8-3dd9-8f56-fbc0b080dc70",
                    "sense_definition": "A building, often found on a farm, used for storage or keeping animals such as cattle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer keeps his tractor in the large red <w>barn</w>.",
                            "target_lang_translations": {
                                "ru": "Фермер держит свой трактор в большом красном <w>сарае</w>.",
                                "zh": "农夫把拖拉机停在那座红色的大<w>谷仓</w>里。",
                                "cs": "Farmář parkuje svůj traktor ve velké červené <w>stodole</w>."
                            }
                        },
                        {
                            "text": "We stored the hay in the <w>barn</w> to keep it dry during the winter.",
                            "target_lang_translations": {
                                "ru": "Мы сложили сено в <w>амбар</w>, чтобы оно оставалось сухим зимой.",
                                "zh": "我们把干草存入<w>谷仓</w>，以确保它们在冬天保持干燥。",
                                "cs": "Seno jsme uskladnili ve <w>stodole</w>, aby zůstalo přes zimu v suchu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "red barn",
                        "barn door",
                        "dairy barn",
                        "pole barn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание, часто встречающееся на ферме, используемое для хранения или содержания животных, например, крупного рогатого скота.",
                        "zh": "通常位于农场，用于存放农作物或饲养牲畜的建筑物。",
                        "cs": "Hospodářská budova, často na farmě, sloužící k uskladnění úrody nebo ustájení zvířat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сарай",
                                "target_lang_sense_clarification": "хозяйственная постройка"
                            },
                            {
                                "target_lang_word": "амбар",
                                "target_lang_sense_clarification": "строение для хранения зерна"
                            },
                            {
                                "target_lang_word": "коровник",
                                "target_lang_sense_clarification": "помещение для скота"
                            }
                        ],
                        "zh": [
