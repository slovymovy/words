                ],
                "senses": [
                    {
                        "sense_id": "80ed94ea-31f4-3fe5-9b8a-fa1143158ee6",
                        "entry_id": "932bc1f6-baa4-37d1-b2c3-402ba349c439",
                        "glosses": [
                            "zumeist (männliche) Person, die ständig und überall in maßloser Weise ihr Handy benutzt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "d1e98a31-08c2-4f2d-a5c9-1305bb245e62",
                                "sense_id": "80ed94ea-31f4-3fe5-9b8a-fa1143158ee6",
                                "text": "„In Italien gibt es nunmehr 26,3 Millionen Handyaner - Europarekord in absoluten Zahlen; prozentual sind nur die Skandinavier mobiler.“"
                            },
                            {
                                "example_id": "f224b16c-787e-472a-af54-ff5e33d7125f",
                                "sense_id": "80ed94ea-31f4-3fe5-9b8a-fa1143158ee6",
                                "text": "„In Skandinavien beispielsweise sorgen niedrige Tarife für Handymania und akute Erreichbarkeit der Handyaner: Zwei und mehr Geräte pro Person sind in Nordeuropa keine Seltenheit mehr.“"
                            },
                            {
                                "example_id": "2145400e-05ff-47e9-b3af-f20b7ac33617",
                                "sense_id": "80ed94ea-31f4-3fe5-9b8a-fa1143158ee6",
                                "text": "„Eine Trennung von penetranten Handyanern und Leuten, die ihre Ruhe haben wollen (in Italien ist diesbezüglich bereits ein Gesetz in Vorbereitung), also wie bei Rauchern und Nichtrauchern, halten die ÖBB für nicht nötig.“"
                            },
                            {
                                "example_id": "0c9d3156-6db4-4de9-a891-732b08046727",
                                "sense_id": "80ed94ea-31f4-3fe5-9b8a-fa1143158ee6",
                                "text": "„Dies geht aus der Befragung von 1024 ‚Handyanern‘ hervor, die am Dienstag von der Telekom-Austria-Tochter Mobilkom und dem Marktforschungsunternehmen GfK vorgestellt wurde.“"
                            },
                            {
                                "example_id": "46410f57-9f17-489b-b9d2-1f47d4c20f1a",
                                "sense_id": "80ed94ea-31f4-3fe5-9b8a-fa1143158ee6",
                                "text": "„Deshalb an dieser Stelle noch einmal die klare Ansage an alle manischen Handyaner: Ich habe mittlerweile gelernt, meine Zeitung im Bus zu lesen, auch wenn ständig eure Geräte piepsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
