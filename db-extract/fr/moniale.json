                    {
                        "form_id": "1a0d7d80-ad59-44dd-b54a-95c324f38a3c",
                        "entry_id": "2ee9f188-903b-3418-88a1-7b60716053dd",
                        "tags": [
                            "masculine"
                        ],
                        "form": "moine"
