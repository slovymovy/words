                "senses": [
                    {
                        "sense_id": "db6cae4c-6f00-39b7-9372-17cd25ca6f6c",
                        "entry_id": "6c1ff5ba-9e25-347e-9e9b-05658680adf7",
                        "glosses": [
                            "die Verhaftung einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c66272b5-5c44-4347-bd44-a1195dee88e0",
                                "sense_id": "db6cae4c-6f00-39b7-9372-17cd25ca6f6c",
                                "text": "„In Kiel verbreitete sich das Gerücht über die Inhaftierung der Meuterer in Windeseile unter den unzufriedenen Marineangehörigen.“"
                            },
                            {
                                "example_id": "643fca02-0e5d-407c-b1d7-d6dba66e9d54",
                                "sense_id": "db6cae4c-6f00-39b7-9372-17cd25ca6f6c",
                                "text": "„Sie begründeten ihren Eintritt in den Ersten Weltkrieg mit der Inhaftierung mehrerer Mitglieder ihrer Gruppe, die 1914 für deutsche Zirkusse gearbeitet hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a054bd9b-e415-4714-a86a-457684b9cb79",
                        "source_entry_id": "6c1ff5ba-9e25-347e-9e9b-05658680adf7",
                        "source_sense_id": "db6cae4c-6f00-39b7-9372-17cd25ca6f6c",
