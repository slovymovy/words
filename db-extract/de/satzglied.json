                    }
                ],
                "senses": [
                    {
                        "sense_id": "84cc6533-1c1a-3e9b-a5fd-2d15719c2dfb",
                        "entry_id": "04701e34-79d6-3651-ae41-a4f54b8b489d",
                        "glosses": [
                            "einzelnes Wort oder Wortgruppe, die zusammengehört und eine grammatische Funktion im Satz ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6cfbd85-f337-40f3-8d4a-e348f9e90c75",
                                "sense_id": "84cc6533-1c1a-3e9b-a5fd-2d15719c2dfb",
                                "text": "In dem Satz \"Der Junge läuft sehr schnell\" sind die Wörter/ Wortgruppen \"Der Junge\", \"läuft\" und \"sehr schnell\" jeweils ein Satzglied. Satzglieder sind Wortgruppen, die gemeinsam im Satz umgestellt und ersetzt werden können."
                            },
                            {
                                "example_id": "de270cda-6c08-4f88-ba44-9447e848a77c",
                                "sense_id": "84cc6533-1c1a-3e9b-a5fd-2d15719c2dfb",
                                "text": "„Ein Satzglied ist eine Einheit des Satzes, die allein die Position vor dem finiten Verb besetzen kann.“"
                            },
                            {
                                "example_id": "d124831a-a0a4-476d-99e9-aa6062b3a0e7",
                                "sense_id": "84cc6533-1c1a-3e9b-a5fd-2d15719c2dfb",
                                "text": "Manchmal werden Satzglieder nicht nach der Art, sondern nur nach ihrer Funktion im Satz klassifiziert."
                            },
                            {
                                "example_id": "cc8646f8-1bd8-484b-b28d-65620d6ac999",
                                "sense_id": "84cc6533-1c1a-3e9b-a5fd-2d15719c2dfb",
                                "text": "„Weil die dass-Sätze Inhalte von notwendigen Satzgliedern wiedergeben, nennt man sie auch Inhaltssätze.“"
                            },
                            {
                                "example_id": "1c35112e-afe4-4535-989d-ef16411552d6",
                                "sense_id": "84cc6533-1c1a-3e9b-a5fd-2d15719c2dfb",
                                "text": "„Die Bausteine der Sätze sind die Satzglieder, die nach den Regeln der Satzlehre die Satzmuster bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
