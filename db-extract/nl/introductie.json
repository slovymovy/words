                                    {
                                        "sense_id": "f5e35b05-1a7f-3142-b249-9232002a3e48",
                                        "entry_id": "d4ac6551-6e61-3879-9ed4-a5d100ede57c",
                                        "glosses": [
                                            "Bekanntmachen eines Neulings mit einem Thema"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e1332e3-4426-4da4-88a4-2799c7d191e9",
                                                "sense_id": "f5e35b05-1a7f-3142-b249-9232002a3e48",
                                                "text": "Nach seiner Einstellung erhielt der Page eine Einführung in sein Aufgabengebiet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f873ced-0a63-3e68-b158-46d7090cca2d",
                                        "entry_id": "d4ac6551-6e61-3879-9ed4-a5d100ede57c",
                                        "glosses": [
                                            "Kurzform für Bücher, Vorträge oder Ähnliches, die ^([1]) bewerkstelligen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "569d7d58-a07b-4f15-b4bd-45d71b79c52d",
                                                "sense_id": "2f873ced-0a63-3e68-b158-46d7090cca2d",
                                                "text": "Das Buch ist eine kurzweilige Einführung in die Physik."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "06d0dc8f-6b8d-31df-846b-d42cfbdaf43f",
                                        "entry_id": "d4ac6551-6e61-3879-9ed4-a5d100ede57c",
                                        "glosses": [
                                            "formelle Bekanntmachung einer Person mit anderen Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d600a64-fdb9-4672-beb0-2084bff7813d",
                                                "sense_id": "06d0dc8f-6b8d-31df-846b-d42cfbdaf43f",
                                                "text": "Erst kurz vor der Hochzeit hatte der Bräutigam Gelegenheit zur Einführung seiner Frau in seinen großen Bekanntenkreis."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b7cf453b-5794-386d-a72a-6561811081dd",
                                        "entry_id": "d4ac6551-6e61-3879-9ed4-a5d100ede57c",
                                        "glosses": [
                                            "Übernahme und Einsatz von Neuerungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e57bd4-1224-433d-9d55-0715229609f1",
                                                "sense_id": "b7cf453b-5794-386d-a72a-6561811081dd",
                                                "text": "Die Einführung der neuen Software erfolgte unternehmensweit."
                                            },
                                            {
                                                "example_id": "4aeb7f60-8e47-48b0-a082-4e5aa6beeb8f",
                                                "sense_id": "b7cf453b-5794-386d-a72a-6561811081dd",
                                                "text": "In den letzten 50 Jahren ist die Lebensqualität der Deutschen infolge der Einführung von modernen technischen Geräten in den Haushalt stark gestiegen."
                                            },
                                            {
                                                "example_id": "96660941-165f-4726-b9aa-c6741ce1ee08",
                                                "sense_id": "b7cf453b-5794-386d-a72a-6561811081dd",
                                                "text": "„Und Honecker war es auch, der 1952 die Einführung des Schießunterrichts, des Fallschirmspringens und des Motorfliegens bei der FDJ verkündete.“"
                                            },
                                            {
                                                "example_id": "610fbbf3-e02b-48be-9ac9-c1fddd5dc876",
                                                "sense_id": "b7cf453b-5794-386d-a72a-6561811081dd",
                                                "text": "„Seit der Einführung des Matrixcodes ist eine Stempelung der Marken nicht mehr unbedingt erforderlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7e760057-418b-3342-8ba1-c07b3d72156b",
                                        "entry_id": "d4ac6551-6e61-3879-9ed4-a5d100ede57c",
                                        "glosses": [
                                            "Instanziierung von neuen Regeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "095050ca-d3ff-462e-bb4a-3d165a30f0ad",
                                                "sense_id": "7e760057-418b-3342-8ba1-c07b3d72156b",
                                                "text": "Die Einführung der Prohibition stieß auf Widerstand."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a86912a0-271e-30c6-8ed6-d3e5d2f23f6c",
                                        "entry_id": "d4ac6551-6e61-3879-9ed4-a5d100ede57c",
                                        "glosses": [
                                            "Bekanntmachen eines neuen Produktes auf einem Handelsplatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b30fa8-1d9c-47fb-b8b2-b63675eb156e",
                                                "sense_id": "a86912a0-271e-30c6-8ed6-d3e5d2f23f6c",
                                                "text": "Die Einführung des neuen Produktes erfolgte weltweit."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "8a4d1d3a-1106-3c90-960d-045ac3846146",
                                        "entry_id": "d4ac6551-6e61-3879-9ed4-a5d100ede57c",
                                        "glosses": [
                                            "Führung zum Beispiel zum Einsetzen oder Befüllen"
