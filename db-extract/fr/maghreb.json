                "senses": [
                    {
                        "sense_id": "1f5b9033-03c9-3c18-b7ff-8d90a8ceb9eb",
                        "entry_id": "d614fec2-8378-3706-bf3f-e8881bc42e9b",
                        "glosses": [
                            "Partie occidentale de l’Afrique du Nord, comprenant l’Algérie, la Tunisie, le Maroc, la Libye et parfois la Mauritanie."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "0ede013c-3052-436a-8736-52b9d080d563",
                                "sense_id": "1f5b9033-03c9-3c18-b7ff-8d90a8ceb9eb",
                                "text": "45% des tissus des collections du groupe sont tricotés et découpés en France, la confection étant sous-traitée au Maghreb, en Roumanie ou en Asie."
                            },
                            {
                                "example_id": "3435e6cc-f4e1-4f9e-9058-234614616796",
                                "sense_id": "1f5b9033-03c9-3c18-b7ff-8d90a8ceb9eb",
                                "text": "Or le Maghreb s’assèche et la Côte d’Azur et la Provence se « maghrébisent » (voir chapitre 1)."
                            },
                            {
                                "example_id": "0d526b0a-0d02-40bc-85a8-17ea9ec52d49",
                                "sense_id": "1f5b9033-03c9-3c18-b7ff-8d90a8ceb9eb",
                                "text": "Le Maghreb s’est « méditerranisé, sinon berbérisé » sur le plan anthropologique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "020cf9e8-18ab-4c35-bc7f-159f41ef9996",
                        "source_entry_id": "d614fec2-8378-3706-bf3f-e8881bc42e9b",
                        "source_sense_id": "1f5b9033-03c9-3c18-b7ff-8d90a8ceb9eb",
                        "target_lang_word": "Maghreb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maghreb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b6b7aba-d2fa-3736-911d-c616477b5f36",
                                        "entry_id": "61f34eea-112e-3306-8800-7c3947558fbf",
                                        "glosses": [
                                            "westlicher Teil der arabischen Welt, der insbesondere Tunesien, den Norden Algeriens und Marokko umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1fb6f9-f1fb-4b60-83c6-9416774566ce",
                                                "sense_id": "7b6b7aba-d2fa-3736-911d-c616477b5f36",
                                                "text": "Im Maghreb wird ein besonderes Arabisch gesprochen."
                                            },
                                            {
                                                "example_id": "22fbb0c2-4e3f-43ac-8fff-b847c833bc10",
                                                "sense_id": "7b6b7aba-d2fa-3736-911d-c616477b5f36",
                                                "text": "„Als die Länder des Maghreb dann ihre Unabhängigkeit erlangten, wurde beschlossen, der arabischen Sprache wieder den Platz einzuräumen, den sie vor der Kolonisierung innegehabt hatte.“"
                                            },
                                            {
                                                "example_id": "c25060fb-1147-4873-8dbe-2a2fd19c6d7b",
                                                "sense_id": "7b6b7aba-d2fa-3736-911d-c616477b5f36",
                                                "text": "„Diese großen Autoren sind also Teil unseres kulturellen Erbes. Sie sollten zur Pflichtlektüre an den Gymnasien des Maghreb gehören, im Original oder in französischer und arabischer Übersetzung.“"
                                            },
                                            {
                                                "example_id": "a7f8b76c-2e88-40c4-9ef0-5239951637f5",
                                                "sense_id": "7b6b7aba-d2fa-3736-911d-c616477b5f36",
                                                "text": "„\"C'est voulu!\" - \"Das ist Absicht!\" In der Kabylei hört man das - auf Französisch - in den letzten Jahren immer öfter. Dem Staat wird unterstellt, er habe die neuen Phänomene - das Bandenunwesen, den Drogenhandel, die Prostitution - begünstigt und die Al-Qaida-Gruppen in den Maghreb gelockt, um die Bevölkerung gefügig zu machen: Sie soll die Rückkehr der Gendarmerie akzeptieren, die nach dem Schwarzen Frühling von 2001 abgezogen wurde.“"
                                            },
                                            {
                                                "example_id": "85807b0f-878b-47b4-939d-d1bae7dfc80e",
                                                "sense_id": "7b6b7aba-d2fa-3736-911d-c616477b5f36",
                                                "text": "„Das Kerngebiet des heutigen Maghreb besteht aus den Ländern Algerien, Marokko und Tunesien, wobei Teile Libyens und Mauretaniens gelegentlich dazugerechnet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
