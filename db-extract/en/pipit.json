                    },
                    {
                        "translation_id": "2db0361f-1844-4f9b-9678-8074b4fce38c",
                        "source_entry_id": "d3162ae1-d151-3864-8098-0f935de80cbe",
                        "source_sense_id": "2728e556-812f-3580-b49a-64491942f463",
