                "translations": [
                    {
                        "translation_id": "5bbcf0e7-ddfd-4c4d-bcc6-577387dfb82a",
                        "source_entry_id": "f65c5945-4ace-34b1-824d-cbbdcd8b946e",
                        "source_sense_id": "808b4898-886c-3609-9784-5488af949f92",
                        "source_sense_description": "een les met als doel, het aanleren van een taal",
                        "target_lang_word": "Sprachkurs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachkurs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                        "entry_id": "ab8638e0-2e82-3045-aba3-da9f6729eade",
                                        "glosses": [
                                            "über eine bestimmte Zeit regelmäßig stattfindender Unterricht in einer Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "870ce9fa-8efe-41c0-b7c6-2deb6e41333c",
                                                "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                                "text": "„In solchen Momenten zeigt sich, dass Sprachkurse, auch wenn sie noch so intensiv sind, nie ausreichen, um die kleinen Tücken im Alltag eines binationalen Pärchens zu bewältigen."
                                            },
                                            {
                                                "example_id": "2754c8db-02be-4fce-86cd-eb08c16a6d94",
                                                "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                                "text": "„Die Nachfrage nach Sprachkursen ist groß.“"
                                            },
                                            {
                                                "example_id": "b27b9d2c-4e34-4ddb-8b06-66cf56b66284",
                                                "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                                "text": "„Unsere Eltern belegten einen Sprachkurs nach dem anderen, sie lernten unaufhörlich Vokabeln, sie waren irritiert, wenn sie merkten, dass die deutschen Nachbarn Dativ statt Genitiv benutzten, und schauten daheim in ihren Lehrbüchern nach.“"
                                            },
                                            {
                                                "example_id": "2be12797-6482-44b5-a990-39232e23e756",
                                                "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                                "text": "„Demnach boten viele Fremdsprachenabteilungen gezwungenermaßen Sprachkurse für die nicht in geistes- beziehungsweise sozialwissenschaftlichen Studiengängen immatrikulierten Studierenden an, damit die Einschreibezahlen und auch die Einnahmen gesteigert werden konnten.“"
                                            },
                                            {
                                                "example_id": "5f13cbe6-577a-480b-8ca9-2d2d71646026",
                                                "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                                "text": "„Ich will nach Paris reisen, an den französischen Sprachkursen der Sorbonne teilnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71d3f91a-d65b-4467-bee3-00f85df8baab",
                        "source_entry_id": "f65c5945-4ace-34b1-824d-cbbdcd8b946e",
                        "source_sense_id": "808b4898-886c-3609-9784-5488af949f92",
                        "source_sense_description": "een les met als doel, het aanleren van een taal",
                        "target_lang_word": "Sprachunterricht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachunterricht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d53bd39-6d26-39ff-9d3f-bd61af341385",
                                        "entry_id": "9c69dadc-3a60-36f4-bc9f-ee339caa1118",
                                        "glosses": [
                                            "Unterricht in einer oder mehreren Sprachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43fdb0a2-d716-4ce7-98ef-79eea9ae8f9d",
                                                "sense_id": "4d53bd39-6d26-39ff-9d3f-bd61af341385",
                                                "text": "„Von den Wegbereitern dieses Unterrichts seien Thomasius und Francke angeführt, weil sie jene beiden Richtungen präsentieren, die die Entwicklung des deutschen Sprachunterrichts im 18. Jahrhundert bestimmt haben.“"
                                            },
                                            {
                                                "example_id": "94528f5c-0945-4b62-bd33-7fcb7421c90b",
                                                "sense_id": "4d53bd39-6d26-39ff-9d3f-bd61af341385",
                                                "text": "„Zu Lämmerts akademischen Mentoren gehörte Richard Alewyn, ein prominenter Remigrant, der im Exil keine seiner Qualifikation entsprechende Stellung finden konnte und sich mit Sprachunterricht an einem Mädchencollege durchgebracht hatte…“"
                                            },
                                            {
                                                "example_id": "f18faa32-b444-4473-aed5-ee5cd08d1553",
                                                "sense_id": "4d53bd39-6d26-39ff-9d3f-bd61af341385",
                                                "text": "„Das lernt man schon im Sprachunterricht.“"
                                            },
                                            {
                                                "example_id": "71864f42-cc2a-4d87-83fa-62f77dda3679",
                                                "sense_id": "4d53bd39-6d26-39ff-9d3f-bd61af341385",
                                                "text": "„Die Frage, ob es sich um progressive Tendenzen in der Sprachentwicklung oder Sprachverfall handelt und inwieweit diese Erscheinungen ihren Platz im Sprachunterricht finden sollten, wurde dann zur Diskussion gestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
