                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Auch der Konsul sei inzwischen Taxifahrer geworden, erzählt er uns lachend.“"
                                            },
                                            {
                                                "example_id": "f3315127-9c1f-4f3b-b5d5-28c0bf6c5066",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Als die beiden Taxifahrer die Halle betraten, ging plötzlich alles so schnell, daß Perlmann, der doch die Stunden gezählt hatte, sich ganz unvorbereitet vorkam.“"
                                            },
                                            {
                                                "example_id": "f6b1a490-28ba-4445-b527-90f39b9cedd5",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Die Frau stieg aus und der Taxifahrer half ihr, die Kartons zu tragen.“"
                                            },
                                            {
                                                "example_id": "26076fde-ba99-428c-9ed3-92385254e062",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Sisi bedankte sich beim Taxifahrer und krabbelte müde aus dem Mercedes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
