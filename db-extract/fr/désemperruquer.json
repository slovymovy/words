                        "glosses": [
                            "Enlever sa perruque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6f0521-f7a6-4892-ad4e-7b5220fe3f4e",
                                "sense_id": "37a9315e-e5c2-3b2e-9a97-74b1b3e1ac6e",
                                "text": "Traits communs : la liberté prise avec une biographie et l’histoire, une familiarité, qui est preuve de reconnaissance et d’amour, avec un génie qu’on désemperruque et désenrubanne pour lui restituer une humanité qui parle au cœur : c’était un comédien comme nous autres, c’était un homme avec ses passions heureuses ou contrariées comme vous tous."
                            },
                            {
                                "example_id": "c2fc3ea7-fdc9-416d-a777-19f8ea7b4278",
                                "sense_id": "37a9315e-e5c2-3b2e-9a97-74b1b3e1ac6e",
                                "text": "Nul mieux que lui ne sait « désemperruquer » certaines musiques du passé."
                            },
                            {
                                "example_id": "b82e6f35-b574-4cf9-90f0-b9cb6cdc2aa0",
                                "sense_id": "37a9315e-e5c2-3b2e-9a97-74b1b3e1ac6e",
                                "text": "Une oie et une pintade,\nBêtes qu’on sait éduquées,\nSans cesse, se reluquaient,\nJusqu’à risquer l’algarade\nEt se désemperruquer."
                            }
                        ]
                    }
