                        ],
                        "examples": [
                            {
                                "example_id": "fb1482ab-373f-4d51-9239-6c8ca8e99f19",
                                "sense_id": "e0277e7e-a9d0-3131-8197-b72057ce77bb",
                                "text": "I am not a Polack. People from Poland are Poles. They are not Polacks. But what I am is one hundred percent American. I'm born and raised in the greatest country on this earth and I'm proud of it. And don't you ever call me a Polack.",
                                "translation": "Nejsem Pšonek. Lidi z Polska jsou Poláci, ne Pšonci. Ale já jsem stoprocentní Američan. Narodil jsem se a vyrostl v nejlepší zemi na světě a jsem na to hrdý. Už si nikdy nedovoluj mě nazvat Pšonek."
                            }
                        ]
                    }
