                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f1397f-d7f2-4146-a599-69d51a89c429",
                                                "sense_id": "f400137a-a534-3977-b3cb-9f8c1b9d39e5",
                                                "text": "„Angeblich habe ein deutscher Astronom die Bahn eines neuen Wandelsterns berechnet.“"
                                            }
                                        ],
