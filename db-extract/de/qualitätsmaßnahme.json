                "senses": [
                    {
                        "sense_id": "42aa53a5-2319-34d8-9bad-acdd51417016",
                        "entry_id": "fdc52d38-e01c-3543-825f-3857657a3354",
                        "glosses": [
                            "bestimmte Maßnahme, die zur Sicherung der Qualität von etwas (zum Beispiel einer Ware oder Dienstleistung) ergriffen werden sollte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "842f0a35-c128-403d-8078-110b092151ab",
                                "sense_id": "42aa53a5-2319-34d8-9bad-acdd51417016",
                                "text": "„Niedergelassene Ergotherapeuten verpflichten sich, sich an Qualitätsmaßnahmen zu beteiligen.“"
                            },
                            {
                                "example_id": "92504f00-76eb-468d-a328-068da211748a",
                                "sense_id": "42aa53a5-2319-34d8-9bad-acdd51417016",
                                "text": "„Sie sollten vorab eine Konsequenzanalyse durchführen, ehe Sie mit der Umsetzung Ihrer Qualitätsmaßnahmen beginnen.“"
                            },
                            {
                                "example_id": "c16c2c1e-7f54-4b43-9753-4402246f1f7a",
                                "sense_id": "42aa53a5-2319-34d8-9bad-acdd51417016",
                                "text": "„Institutionen des Gesundheitswesens sind gesetzlich verpflichtet Qualitätsarbeit durch die Einführung eines internen Qualitätsmanagements sowie der Teilnahme an externen Qualitätsmaßnahmen durchzuführen.“"
                            },
                            {
                                "example_id": "80922af0-94e7-4077-8ba7-9b4c992e9b93",
                                "sense_id": "42aa53a5-2319-34d8-9bad-acdd51417016",
                                "text": "„Die Rückversicherung, ob wir die Botschaft richtig gedeutet haben, ist eine Qualitätsmaßnahme, um unsere Kommunikation qualitativ zu verbessern.“"
                            },
                            {
                                "example_id": "44fb3b60-0bd4-4ebb-a134-287d6365ea40",
                                "sense_id": "42aa53a5-2319-34d8-9bad-acdd51417016",
                                "text": "„Hinzu kommen Festlegungen bezüglich der Organisation, der Planung, der Durchführung und der Lenkung von Prozessen, der geforderten Verfahren zur Umsetzung einzelner Qualitätsmaßnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
