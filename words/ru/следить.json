                    "sense_definition": "Контролировать соблюдение порядка, правил или правильность выполнения чего-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "control_and_monitoring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель строго <следит> за дисциплиной в классе.",
