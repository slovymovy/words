                "senses": [
                    {
                        "sense_id": "94b4fe38-8fcf-3b1a-92d0-c9314028e2e2",
                        "entry_id": "12d127b8-aa90-39ac-b06f-c7360735cab4",
                        "glosses": [
                            "meist scheibenförmiges Verbindungsteil aus Kunststoff an Kunststoffrohren, Kunststoffzylindern, Maschinenteilen und anderen Konstruktionselementen zur Abdichtung, Verbindung und Kupplung mittels Schrauben; lösbare Verbindung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a24d9c7-3094-4195-b012-b9426c7bbe9c",
                                "sense_id": "94b4fe38-8fcf-3b1a-92d0-c9314028e2e2",
                                "text": "„Dadurch eignen sich die Dichtungen vor allem zur umfassenden Standardisierung für Anwendungen wie Stahlflansche, Stahl-Email-Flansche und Kunststoffflansche.“"
                            },
                            {
                                "example_id": "25dd1be4-9178-436f-b3b4-45f23482e366",
                                "sense_id": "94b4fe38-8fcf-3b1a-92d0-c9314028e2e2",
                                "text": "„Der Schrumpfschlauch muss am Kunststoffflansch fest verbunden sein.“"
                            },
                            {
                                "example_id": "89847f9a-da8f-4c6c-b795-6e6e4bbc09ee",
                                "sense_id": "94b4fe38-8fcf-3b1a-92d0-c9314028e2e2",
                                "text": "„Zwischen den Stahlflansch und die Scheibe gehören Papier- oder Kunststoffflansche.“"
                            },
                            {
                                "example_id": "568580d6-4505-4412-b8b9-aea14d06bb4e",
                                "sense_id": "94b4fe38-8fcf-3b1a-92d0-c9314028e2e2",
                                "text": "„Die Filterpatronen werden mit Metallflansch oder Kunststoffflansch hergestellt und besitzen einen Innenstützkorb.“"
                            },
                            {
                                "example_id": "d97423f7-7431-4a6b-a608-112d911477ff",
                                "sense_id": "94b4fe38-8fcf-3b1a-92d0-c9314028e2e2",
                                "text": "„Sie gilt nicht für Kunststoffflansche, Emailleflansche, Flanschverbindungen ohne Schrauben und auch nicht für Kompaktflanschverbindungen ohne Dichtung oder mit Flüssigkeitsdichtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
