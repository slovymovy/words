                ],
                "senses": [
                    {
                        "sense_id": "a1451375-0585-323b-b3f5-6de595bad754",
                        "entry_id": "73852d84-dc33-37cb-8daf-59134fd076e2",
                        "glosses": [
                            "Belastungsgrenze, bei der der Körper beginnt, mehr Laktat (Milchsäure) zu produzieren, als er gleichzeitig abbauen kann; Schwelle, die den Übergang von aerober (sauerstoffgestützter) Energiegewinnung zu überwiegend anaerober (sauerstoffunabhängiger) Energiegewinnung markiert"
                        ],
                        "tags": [
                            "Sportmedizin",
                            "Leistungsdiagnostik"
                        ],
                        "examples": [
                            {
                                "example_id": "4e916d66-df65-4482-8a9b-ae385c29d794",
                                "sense_id": "a1451375-0585-323b-b3f5-6de595bad754",
                                "text": "„Die anaerobe Schwelle, auch als aerob-anaerobe Schwelle oder Laktatschwelle bezeichnet, ist eine Schwellwert, welcher beim Sport erhoben wird.“"
                            },
                            {
                                "example_id": "0280888f-4208-4a88-ae74-2657cff04111",
                                "sense_id": "a1451375-0585-323b-b3f5-6de595bad754",
                                "text": "„Trainieren Sie effizient: Trainieren Sie so effizient wie nie und profitieren Sie von Werten zu Laktatschwelle, VO2max und optional zu Ihrer Laufeffizienz; Dank der erweiterten Performance Analyse können Sie stets Ihren Leistungsfortschritt verfolgen“"
                            },
                            {
                                "example_id": "f0f93e3c-48a4-4f19-93a5-6057a6b7beb2",
                                "sense_id": "a1451375-0585-323b-b3f5-6de595bad754",
                                "text": "„Die Erweiterte Ausdauerdiagnostik beinhaltet eine in Stufen ansteigende Belastung auf dem Laufband, um die Laktatschwellen, maximale Sauerstoffaufnahme und ventilatorische Schwellen und maximale Herzfrequnz zu ermitteln.“"
                            },
                            {
                                "example_id": "2cff517b-3d6f-4dc1-8afd-252baee2c99e",
                                "sense_id": "a1451375-0585-323b-b3f5-6de595bad754",
                                "text": "„Wir untersuchen für Dich in dem DNA-Test Fitness beispielsweise die Laktatschwelle oder die aerobe Kapazität, die anzeigen, ob Du schnell ermüdest oder Dich regelrecht auspowern kannst.“"
                            },
                            {
                                "example_id": "dccb2bdc-6707-4e5d-be04-117739344df2",
                                "sense_id": "a1451375-0585-323b-b3f5-6de595bad754",
                                "text": "„Es gibt zwei Stoffwechselanker, die die drei Zonen definieren, nämlich Laktatschwelle 1 (LT1) und Laktatschwelle 2 (LT2).“"
                            },
                            {
                                "example_id": "cfc63972-d92e-4fec-a27e-846bd9002882",
                                "sense_id": "a1451375-0585-323b-b3f5-6de595bad754",
                                "text": "„Nach einer 12-wöchigen Einnahme von Cs-4 stieg die Laktatschwelle der gesunden älteren Menschen um 10,5 % und ihre Atemschwelle um 8,5 %.“"
                            },
                            {
                                "example_id": "0df7302d-dff7-47d5-b446-8c91a82eb376",
                                "sense_id": "a1451375-0585-323b-b3f5-6de595bad754",
                                "text": "„Knapp 80 Prozent des Ausdauertrainings erfolgt mit einer Intensität unterhalb der Laktatschwelle 1 (LT 1, aerobe Schwelle).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
