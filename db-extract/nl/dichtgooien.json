                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39a6f6f6-ae8a-3e31-ad6f-0168c8bca71b",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To become tearful as a result of strong emotion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33a94a53-dde4-3329-af65-38103f0ccaef",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To annoy, or displease, by taunting, or by excessive nagging."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83b8b5a0-4e6d-462e-be88-96646e5a92d5",
                                                "sense_id": "33a94a53-dde4-3329-af65-38103f0ccaef",
                                                "text": "The teachers that taught me weren't cool. / You're holding me down, / Turning me 'round, / Filling me up with your rules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a49624b-288c-3a9b-aed7-d0fcd2765b10",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To satisfy the hunger of (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "571021b1-2206-44d3-85c7-1b84326793ef",
                                                "sense_id": "4a49624b-288c-3a9b-aed7-d0fcd2765b10",
                                                "text": "Thanks for the chocolate cake – it really filled me up!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70ac5e45-34d3-34f8-916e-2f12148ca6b3",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To satisfy one's hunger; to stop being hungry."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efcbfaa4-e31f-42ee-84cf-2bc9e25c4112",
                                                "sense_id": "70ac5e45-34d3-34f8-916e-2f12148ca6b3",
                                                "text": "We've scoured these science and tapped the top experts to help you learn how to do just that. Use these seven simple strategies, and you'll fill up without filling out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dea98732-dbe4-3816-a78e-6f61d406a83b",
