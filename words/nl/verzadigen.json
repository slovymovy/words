                        "voldoen",
                        "stillen"
                    ],
                    "antonyms": [
                        "uithongeren"
                    ],
                    "common_phrases": [
                        "de honger verzadigen"
                    ],
                    "target_lang_definitions": {
                        "en": "To give someone a feeling of satisfaction by fully meeting a need or hunger."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "satisfy",
                                "target_lang_sense_clarification": "to fulfill a need or desire"
                            },
                            {
                                "target_lang_word": "satiate",
                                "target_lang_sense_clarification": "to satisfy a hunger or appetite fully"
                            },
                            {
                                "target_lang_word": "fill",
                                "target_lang_sense_clarification": "to make full with food"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8c42473-79a9-3acf-9a9a-0c78fb7fd1a0",
                    "sense_definition": "een toestand bereiken waarin niets meer kan worden opgenomen of toegevoegd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limiet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De markt voor smartphones lijkt momenteel volledig <w>verzadigd</w> te zijn.",
                            "target_lang_translations": {
                                "en": "The market for smartphones currently seems to be completely <w>saturated</w>."
                            }
                        },
                        {
                            "text": "Je kunt de oplossing <w>verzadigen</w> door meer zout toe te voegen tot het niet meer oplost.",
                            "target_lang_translations": {
                                "en": "You can <w>saturate</w> the solution by adding more salt until it no longer dissolves."
                            }
                        }
                    ],
                    "synonyms": [
                        "doordrenken",
                        "impregneren"
                    ],
                    "common_phrases": [
                        "een verzadigde markt"
                    ],
                    "target_lang_definitions": {
                        "en": "To reach a state in which nothing more can be absorbed or added."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "saturate",
                                "target_lang_sense_clarification": "to soak or fill completely so that no more can be added"
                            },
                            {
                                "target_lang_word": "soak",
                                "target_lang_sense_clarification": "to make thoroughly wet"
                            }
                        ]
                    }
                }
            ]
        }
    ]
