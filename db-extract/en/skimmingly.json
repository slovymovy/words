                        "examples": [
                            {
                                "example_id": "b5df605a-65d0-4d7e-88bb-d7618c51599f",
                                "sense_id": "38f7d920-48fb-3382-9703-98cde9f305af",
                                "text": "Whether sleeping, quarrelling, or playing, whether curious, frightened, or angry, its interest is continuously humorous, but the Adelie penguin in the water is another thing; as it darts to and fro a fathom or two below the surface, as it leaps porpoise-like into the air or swims skimmingly over the rippling surface of a pool, it excites nothing but admiration."
                            },
                            {
                                "example_id": "86211c16-e8a4-47f8-bcfc-5a9ddd6b2de2",
                                "sense_id": "38f7d920-48fb-3382-9703-98cde9f305af",
                                "text": "Yesterday, beside preaching a sermon more than half new, and attending a funeral (out of the society), I read skimmingly more than half Nichol's \"Architecture of the Heavens.\""
                            }
                        ]
                    }
