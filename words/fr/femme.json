                    "target_lang_definitions": {
                        "en": "A person joined to another by marriage, especially a woman in relation to her husband.",
                        "ru": "Женщина, состоящая в браке с мужчиной; супруга.",
                        "nl": "Vrouw die met een man is getrouwd, ook echtgenote genoemd.",
