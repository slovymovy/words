                "translations": [
                    {
                        "translation_id": "2a6a441b-5c00-4033-9bb4-607636e8752d",
                        "source_entry_id": "f175de11-6503-3ae2-8fda-8a52846441d5",
                        "source_sense_id": "736796e7-d7b3-3864-977f-0c4ea8112cbe",
                        "target_lang_word": "playboy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "playboy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c1ff3da-7150-374b-bfaf-585e87b966a7",
                                        "entry_id": "1176c21d-8093-3f88-b043-7aabca741737",
                                        "glosses": [
                                            "A single man, especially a wealthy one, who devotes himself to a life of leisure and pleasure, often sexual, without commitments or responsibilities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b67ca153-5094-4f49-a0d4-a77dee6bc338",
                                                "sense_id": "7c1ff3da-7150-374b-bfaf-585e87b966a7",
                                                "text": "Exclusive nightclubs are out of style with me / 'Cause I don't associate with high society / I don't hang around playboy millionaires / I'm just an ordinary guy you left behind"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb2adb99-063d-4c5e-aed4-8dae30b53efc",
                        "source_entry_id": "f175de11-6503-3ae2-8fda-8a52846441d5",
                        "source_sense_id": "736796e7-d7b3-3864-977f-0c4ea8112cbe",
                        "target_lang_word": "playboy",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e12fd53d-2c8d-4835-8f24-44bbd9f9990d",
                        "source_entry_id": "f175de11-6503-3ae2-8fda-8a52846441d5",
                        "source_sense_id": "736796e7-d7b3-3864-977f-0c4ea8112cbe",
                        "target_lang_word": "Playboy",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Playboy",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11fbf4ef-9fe4-3e97-ad60-dec6088c81c3",
                                        "entry_id": "1b91a141-4116-3fc9-bb5e-2ff7b83adc26",
                                        "glosses": [
                                            "Mann, der finanziell unabhängig ist und seinen Vergnügungen nachgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ac7d601-f043-4847-8bc2-89c9dda37f64",
                                                "sense_id": "11fbf4ef-9fe4-3e97-ad60-dec6088c81c3",
                                                "text": "Gunther Sachs war der Inbegriff eines Playboys."
                                            },
                                            {
                                                "example_id": "a6e4064a-fb9c-41b6-8cdb-2ac05ce88a9f",
                                                "sense_id": "11fbf4ef-9fe4-3e97-ad60-dec6088c81c3",
                                                "text": "Ein echter Playboy fährt Porsche oder Jaguar, vielleicht einen Rolls, und er logiert in erstklassigen Hotels."
                                            },
                                            {
                                                "example_id": "5afbf7f9-80ea-4953-8b7b-ccbd1add59f7",
                                                "sense_id": "11fbf4ef-9fe4-3e97-ad60-dec6088c81c3",
                                                "text": "„Als er nun durch die Hochzeit mit meiner Großmutter zu einem reichen Ehemann geworden war, spielte er den Playboy und fand im Spielcasino seinen liebsten Aufenthaltsort.“"
                                            },
                                            {
                                                "example_id": "936f0747-6d47-451c-9d5d-2f73a06b17bf",
                                                "sense_id": "11fbf4ef-9fe4-3e97-ad60-dec6088c81c3",
                                                "text": "„Der sie liebende Mann ist nicht Rennfahrer, sondern ihr Arzt (David Niven), und ein Playboy und Rennfahrer (Richard Conte), der für viel Herzensverwirrung sorgt, ist auch da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
