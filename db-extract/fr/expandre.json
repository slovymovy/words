                "senses": [
                    {
                        "sense_id": "29bc652e-6af5-3ef3-9648-196fdbcb44f9",
                        "entry_id": "d064565f-4b53-390d-bd16-e726ee464b4b",
                        "glosses": [
                            "Gonfler, allonger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dde276e-cbe7-4b95-8af3-4d4adf0acde4",
                                "sense_id": "29bc652e-6af5-3ef3-9648-196fdbcb44f9",
                                "text": "Les composants piézoélectriques se contractent ou s’expandent quand un courant est appliqué ; le cristal de quartz en est un exemple naturel."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a910f6f-670f-3552-b490-3b37eac89b45",
                        "entry_id": "d064565f-4b53-390d-bd16-e726ee464b4b",
                        "glosses": [
                            "Expanser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cee97c7-6879-4305-ab3e-8bee3eb35c89",
                                "sense_id": "9a910f6f-670f-3552-b490-3b37eac89b45",
                                "text": "On peut expandre les parois latérales d’une pièce dans une matrice en deux demi-coquilles à l’aide d’un corps, supposé fluide, à l’intérieur."
                            }
                        ]
                    }
