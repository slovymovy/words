                        "glosses": [
                            "Geldbetrag, den ein Verein von dem Verein erhält, zu dem ein Sportler trotz eines noch laufenden Vertrages wechselt (Spielertransfer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a1f1106-c28a-4725-bdf5-1c2cdb82ef70",
                                "sense_id": "a9892aee-d7fc-3b58-91bd-99c63e1aa1fe",
                                "text": "„Der Wechsel von Thomas Delaney von Werder Bremen zum BVB ist perfekt. Die Ablösesumme soll 20 Millionen Euro betragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
