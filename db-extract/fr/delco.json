                        "entry_id": "eb8e81c8-5a37-362b-a428-7ae1e8b95e7e",
                        "glosses": [
                            "Allumeur d’un moteur à explosion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b513534a-02a8-4930-b7bf-deb0174bd88a",
                                "sense_id": "ae3fbc3b-d015-3f1b-8ef0-3daf43687862",
                                "text": "Relié à l’arbre à cames, le Delco produit une impulsion électrique par le contact sur une vis platinée qui sert à faire jaillir une étincelle à la bougie d’allumage."
                            },
                            {
                                "example_id": "358e56dc-943e-4e1a-93a2-68050b413554",
                                "sense_id": "ae3fbc3b-d015-3f1b-8ef0-3daf43687862",
                                "text": "Vers 5 heures du matin, il s’est mis à taper sur le Delco avec un gros marteau et ma nuit a été terminée."
                            }
                        ]
                    }
                ],
