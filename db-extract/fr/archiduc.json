        "fr-extract.jsonl": [
            {
                "entry_id": "3b057be1-736d-34b3-8986-48a449fb11d4",
                "word": "archiduc",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b48b5973-4df4-456f-95b4-db513dee1a14",
                        "entry_id": "3b057be1-736d-34b3-8986-48a449fb11d4",
                        "tags": [
                            "plural"
                        ],
                        "form": "archiducs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "650a588a-e69e-3855-b0ca-be8827190ce9",
                        "entry_id": "3b057be1-736d-34b3-8986-48a449fb11d4",
                        "glosses": [
                            "Titre de dignité des princes et des princesses de l’ancienne maison d’Autriche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5558a5b6-7d08-4bf6-a9f1-83432c605cba",
                                "sense_id": "650a588a-e69e-3855-b0ca-be8827190ce9",
                                "text": "Graz était la capitale de la Styrie, ce lui fut une occasion nouvelle d’étaler son érudition, parlant des Babenberg, prédécesseurs des Habsbourg, et de cet archiduc Johann qui aima tant Anna Plochi, la fille du maître de poste d’Aussee."
                            },
                            {
                                "example_id": "7bf7a034-b4db-4434-af5a-07985e23a14e",
                                "sense_id": "650a588a-e69e-3855-b0ca-be8827190ce9",
                                "text": "L’archiduc Jean Salvator était prêt malgré tout, au nom de leur amitié à lui apporter son soutien, mais encore fallait-il que l’empereur le rétablisse dans son grade et commandement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5ceacab-4801-4056-9b17-221073eb9fb3",
                        "source_entry_id": "3b057be1-736d-34b3-8986-48a449fb11d4",
                        "source_sense_id": "650a588a-e69e-3855-b0ca-be8827190ce9",
                        "target_lang_word": "Erzherzog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzherzog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4dd55c0-78e2-3698-b965-b36098385dae",
                                        "entry_id": "2779ec87-6fed-397e-830d-8a712b820068",
                                        "glosses": [
                                            "erblicher Adelstitel, der vom jeweiligen Herrscher in Österreich seit Mitte des 14. Jahrhunderts und von allen Prinzen seit dem 15. Jahrhundert bis Anfang des 20. Jahrhunderts geführt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10414d49-43b5-4e37-acd1-90bb1a4c799f",
                                                "sense_id": "f4dd55c0-78e2-3698-b965-b36098385dae",
                                                "text": "„… die Bezeichnung »Erzherzog« wurde zwar nicht ausdrücklich anerkannt, aber geduldet; sie sollte zum Ausdruck bringen, dass der so Titulierte über mehrere Herzogtümer herrschte, so wie zum Beispiel einem Erzbischof mehrere Bistümer unterstehen.“"
                                            },
                                            {
                                                "example_id": "7c841d48-89b9-44ca-9ead-a35a6e5615ab",
                                                "sense_id": "f4dd55c0-78e2-3698-b965-b36098385dae",
                                                "text": "„Erzherzog Eugen war der letzte Deutschmeister (von 1894 bis 1923) und Gründer eines Waisenhauses im niederösterreichischen Unterdambach, das heute nicht mehr existiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7da0c2f8-6b4d-3612-bdc4-ac746322e948",
                                        "entry_id": "2779ec87-6fed-397e-830d-8a712b820068",
                                        "glosses": [
                                            "Person, die [1] als Titel führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6721318a-3f2d-4d0e-b321-c70bfdfb7ece",
                                                "sense_id": "7da0c2f8-6b4d-3612-bdc4-ac746322e948",
                                                "text": "„Zwischen 1807 und 1836 errichtete [Kornhäusel] viele Bauten in Baden, darunter […] 1820-1823 für Erzherzog Carl die Weilburg im Helenental (zerstört).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c728f95d-1491-4829-99d4-1ec441adeffd",
                        "source_entry_id": "3b057be1-736d-34b3-8986-48a449fb11d4",
