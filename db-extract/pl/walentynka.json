                        "translation_id": "2e3103f3-0fd0-477c-a6b8-e2ae8ec7812c",
                        "source_entry_id": "66991027-b0af-3ce6-8c65-207e529db642",
                        "source_sense_id": "702d861e-6b2d-33c2-b634-e44810779ae6",
                        "target_lang_word": "valentine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
