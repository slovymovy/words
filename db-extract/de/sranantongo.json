                "senses": [
                    {
                        "sense_id": "961e96c2-fd50-35a1-96d1-c3c28d6c1e3e",
                        "entry_id": "ef9795f7-c6cf-3bf6-a6a6-3b77e475e12c",
                        "glosses": [
                            "Kreolsprache, die in Suriname gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7d3952f-f0df-4963-b8d2-c25c7570a6f7",
                                "sense_id": "961e96c2-fd50-35a1-96d1-c3c28d6c1e3e",
                                "text": "„Sranantongo – die Kurzform lautet Sranan – ist die Umgangssprache.“"
                            },
                            {
                                "example_id": "94b62a2d-5118-48a1-b9ff-74677700e752",
                                "sense_id": "961e96c2-fd50-35a1-96d1-c3c28d6c1e3e",
                                "text": "„Die meisten dieser Gruppen gediehen in der neuen Welt, wenigstens biologisch, und die Kommunikation zwischen Chinesen, Indern, Javanern und Kreolen fand in Sranantongo statt, das dadurch große Chancen hatte, die nationale Muttersprache zu werden, wenn Niederländisch und Englisch ihm nicht in immer steigendem Maße Konkurrenz gemacht hätten.“"
                            },
                            {
                                "example_id": "de972c16-4dee-49c2-bbcf-4dad2b18891e",
                                "sense_id": "961e96c2-fd50-35a1-96d1-c3c28d6c1e3e",
                                "text": "„Die Sprachen der niederländischen Kolonien Afrikaans, Papiamentu (niederländische Antillen), Sranantongo (Surinam) und Bahasa Indonesia (die moderne indonesische Variante des Malaiischen) haben vieles aus der Sprache der Kolonisatoren übernommen.“"
                            },
                            {
                                "example_id": "e7a82766-24af-4da4-82b0-7cdf8e181a58",
                                "sense_id": "961e96c2-fd50-35a1-96d1-c3c28d6c1e3e",
                                "text": "„Auch die gebräuchlichen Artnamen in Englisch, Niederländisch und Sranantongo (offizielle Sprache Surinams) sind angeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
