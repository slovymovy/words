    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "107eae13-ee8e-32c5-a9ab-a7378986758e",
                    "sense_definition": "Made or created by the process of weaving threads or fibers together.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "textile_construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>woven</w> fabric is very durable and resistant to tearing.",
                            "target_lang_translations": {
                                "fr": "Le tissu <w>tissé</w> est très durable et résistant à la déchirure."
                            }
                        },
                        {
                            "text": "She bought a beautiful <w>woven</w> basket at the local market.",
                            "target_lang_translations": {
                                "fr": "Elle a acheté un magnifique panier <w>tressé</w> au marché local."
                            }
                        }
                    ],
                    "synonyms": [
                        "textile",
                        "interlaced"
                    ],
                    "common_phrases": [
                        "woven fabric",
                        "woven basket"
                    ],
                    "target_lang_definitions": {
                        "fr": "Fabriqué ou créé par le processus d'entrelacement de fils ou de fibres."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tissé",
                                "target_lang_sense_clarification": "Adjectif décrivant un matériau fabriqué par tissage."
                            },
                            {
                                "target_lang_word": "tressé",
                                "target_lang_sense_clarification": "Utilisé pour des objets comme des paniers ou des fibres entrelacées."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d007919e-b613-3825-ba05-a12773a93345",
                    "sense_definition": "Combined or joined together in an intricate or complex way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author has <w>woven</w> many historical facts into her fictional story.",
                            "target_lang_translations": {
                                "fr": "L'auteure a <w>tissé</w> de nombreux faits historiques dans son récit de fiction."
                            }
                        },
                        {
                            "text": "His speech was a <w>woven</w> tapestry of personal memories and political ideas.",
                            "target_lang_translations": {
                                "fr": "Son discours était une tapisserie <w>tissée</w> de souvenirs personnels et d'idées politiques."
                            }
                        }
                    ],
                    "synonyms": [
                        "intertwined",
                        "interconnected"
                    ],
                    "common_phrases": [
                        "woven together"
                    ],
                    "target_lang_definitions": {
                        "fr": "Combiné ou assemblé de manière complexe ou élaborée."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "entremêlé",
                                "target_lang_sense_clarification": "Se dit d'éléments mélangés de façon complexe."
                            },
                            {
                                "target_lang_word": "tissé",
                                "target_lang_sense_clarification": "Utilisé au sens figuré pour décrire une structure complexe d'idées ou de faits."
                            }
                        ]
                    }
                }
            ]
        },
        {
