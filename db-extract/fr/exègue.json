                    {
                        "sense_id": "003d0500-91ff-34fb-9079-4cdb090883a1",
                        "entry_id": "5af55719-c8f3-3cda-b59b-f42de5bb8de2",
                        "glosses": [
                            "À parts égales, en parlant du produit des troupeaux que se partageaient le propriétaire et l’éleveur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8989b40b-eb84-486d-bd9b-831cb81877ef",
                                "sense_id": "003d0500-91ff-34fb-9079-4cdb090883a1",
                                "text": "Le partage du croît du bétail était dénommé exègue ; procéder au partage se disait exéguer ou faire l’exègue."
                            },
                            {
                                "example_id": "fa6a11f4-4459-4cda-93b7-f11d977ec1fd",
                                "sense_id": "003d0500-91ff-34fb-9079-4cdb090883a1",
                                "text": "Le cheptel connu, dans les anciens usages de la Bresse, sous la dénomination de commande, et d’après lequel, l’estimation étant faite à l’exègue, soit à prix réduit, l’excédant du bétail se partageait par moitié entre le bailleur et le preneur."
                            },
                            {
                                "example_id": "59518b59-efa0-4c8a-8460-bf50cfd50625",
                                "sense_id": "003d0500-91ff-34fb-9079-4cdb090883a1",
                                "text": "À l’exègue : À prix réduit."
                            },
                            {
                                "example_id": "ed4fd900-259c-48b6-b82f-0658297a62eb",
                                "sense_id": "003d0500-91ff-34fb-9079-4cdb090883a1",
                                "text": "Que l’estimation de 1850 a été faite à prix considérablement réduit ou d’exègue […] il acceptait cet état comme représentant, non la valeur réelle, à prix de foire, du cheptel, mais sa valeur à prix d’exègue."
                            }
                        ]
                    }
