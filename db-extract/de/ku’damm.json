                    {
                        "sense_id": "37dfc258-3b00-3b07-acf5-71ec84673860",
                        "entry_id": "8c431c55-8b06-3009-afef-5261f431c709",
                        "glosses": [
                            "kurz für Kurfürstendamm; Hauptverkehrsstraße in der deutschen Hauptstadt Berlin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c24bb8-0ddd-4af6-9a16-4219d912cf6f",
                                "sense_id": "37dfc258-3b00-3b07-acf5-71ec84673860",
                                "text": "„Ursprünglich angelegt als Reitweg für den Kurfürsten Joachim den Zweiten entwickelte sich der Ku’damm über die Jahrhunderte zum Prachtboulevard.“"
                            },
                            {
                                "example_id": "d99a8b4d-8b32-4bb4-8985-3100425e22c3",
                                "sense_id": "37dfc258-3b00-3b07-acf5-71ec84673860",
                                "text": "„Abends tastete er sich über die Trümmer des stockfinsteren Ku’damms zu den Treffpunkten der jungen Leute.“"
                            },
                            {
                                "example_id": "84d09f13-1ba7-44fd-95aa-939cbc50c819",
                                "sense_id": "37dfc258-3b00-3b07-acf5-71ec84673860",
                                "text": "„Vor allem rund um den Ku’damm, die mondäne Einkaufs- und Flaniermeile, kamen die Gäste aus dem Orient in bürgerlichen Familien unter, ihre Untermiete rettete manche Familie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
