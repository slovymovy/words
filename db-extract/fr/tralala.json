            {
                "entry_id": "43e209af-b80c-32dd-b31f-4015a46dfede",
                "word": "tralala",
                "pos": "onomatopoeia",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "99a5afdb-c57c-3c22-ac18-490b487582f7",
                        "entry_id": "43e209af-b80c-32dd-b31f-4015a46dfede",
                        "glosses": [
                            "Onomatopée qui sert de refrain, qui remplace des paroles sur un air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe25317-4951-4132-b1d6-671e127e94a8",
                                "sense_id": "99a5afdb-c57c-3c22-ac18-490b487582f7",
                                "text": "Tralala lalalaire\nTralala lala,\n(Chanté à Mongicourt.)\nMoi, j’sais pas les paroles\nAlors je chant’ l’air !"
                            },
                            {
                                "example_id": "d28b3300-7cdb-43b3-b859-d2ec72e20bce",
                                "sense_id": "99a5afdb-c57c-3c22-ac18-490b487582f7",
                                "text": "Tra la la, vive maman ! s’est écrié Riquet en exécutant une danse de Peau-Rouge, tandis que moi, je riais toute seule."
                            }
                        ]
                    },
                    {
                        "sense_id": "dceaf29e-a4b6-3f1a-b0d2-105b70e2c141",
                        "entry_id": "43e209af-b80c-32dd-b31f-4015a46dfede",
                        "glosses": [
                            "S’emploie aussi pour exprimer l’incrédulité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b4e550c-0558-463c-ae6e-1325c59cccac",
                                "sense_id": "dceaf29e-a4b6-3f1a-b0d2-105b70e2c141",
                                "text": "Tralala, je ne crois rien de ce que vous me dites."
                            }
                        ]
                    }
