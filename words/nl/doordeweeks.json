                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op <w>doordeweekse</w> dagen is het hier altijd erg druk in de trein.",
                            "target_lang_translations": {
                                "en": "On <w>weekday</w> days, the train is always very crowded here.",
                                "pl": "W dni <w>powszednie</w> w pociągu jest tutaj zawsze bardzo tłoczno."
                            }
                        },
                        {
                            "text": "De winkel heeft een speciale <w>doordeweekse</w> aanbieding voor vaste klanten.",
                            "target_lang_translations": {
                                "en": "The shop has a special <w>midweek</w> offer for regular customers.",
                                "pl": "Sklep ma specjalną ofertę <w>w środku tygodnia</w> dla stałych klientów."
                            }
