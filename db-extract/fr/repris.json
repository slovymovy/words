                "senses": [
                    {
                        "sense_id": "4eec1f4b-7b0f-3f86-8722-0e659cc617c1",
                        "entry_id": "fe8bc9a8-2ce9-3089-8a54-60eb3b18a60b",
                        "glosses": [
                            "Qui a été pris à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "543bdb65-cc4d-46b1-a66e-aa223faf4b9e",
                                "sense_id": "4eec1f4b-7b0f-3f86-8722-0e659cc617c1",
                                "text": "L’entrainement de l’équipe repris paiera."
                            },
                            {
                                "example_id": "aa3b980f-a6c9-40e5-8453-10072ff6ac5a",
                                "sense_id": "4eec1f4b-7b0f-3f86-8722-0e659cc617c1",
                                "text": "Les combats repris dans les zones rebelles augurent le pire."
                            },
                            {
                                "example_id": "085006f8-142b-4c3d-ad67-034b24abd568",
                                "sense_id": "4eec1f4b-7b0f-3f86-8722-0e659cc617c1",
                                "text": "Ensuite, ce fut un petit chemin couvert, un de ces délicieux chemins d’amoureux, ombragés comme des berceaux, qu’il put suivre assez longtemps, à l’abri des regards, repris d’espoir."
                            },
                            {
                                "example_id": "9eb1ed62-04d9-4cf5-9fac-952701014cbd",
                                "sense_id": "4eec1f4b-7b0f-3f86-8722-0e659cc617c1",
                                "text": "Hermine, reprise de souci, répondait : « Non, pas de sucre… merci…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
