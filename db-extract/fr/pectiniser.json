                "senses": [
                    {
                        "sense_id": "54b9254a-9f33-3c85-b9c8-b10d9392dfc1",
                        "entry_id": "929a7947-b22c-3314-aebe-c38657c11a32",
                        "glosses": [
                            "Additionner de pectine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11456340-a7ef-428f-9968-7fae71ef0ab1",
                                "sense_id": "54b9254a-9f33-3c85-b9c8-b10d9392dfc1",
                                "text": "Le procédé consiste à passer les matières dans une solution concentrée d'hydroxide de cuivre-ammonium, à une vitesse qui permette de pectiniser et gélatiniser l'extérieur des fibres constituant le papier ou l'étoffe, sans les désagréger, de façon que la matière conserve assez de cohésion pour pouvoir être séchée sur tes cylindres d'un séchoir à papier à la manière ordinaire..."
                            },
                            {
                                "example_id": "81039f4c-085f-4e8a-9c1c-8a8ee1aa9c43",
                                "sense_id": "54b9254a-9f33-3c85-b9c8-b10d9392dfc1",
                                "text": "Maturation : 2°, mais demandant à être brassée de bonne heure à cause de sa tendance à se pectiniser."
                            }
                        ]
                    }
                ],
