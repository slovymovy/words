                "senses": [
                    {
                        "sense_id": "bfccc8dd-219c-33b1-83eb-e42e659d4c51",
                        "entry_id": "ce6904f7-f6af-3337-abc2-4fe02ddde38b",
                        "glosses": [
                            "Alternative form of guarantee."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "9b4acef5-2d23-4459-bbd1-fc1ebb68c97b",
                                "sense_id": "bfccc8dd-219c-33b1-83eb-e42e659d4c51",
                                "text": "His imperial majesty likewise guaranties to the king of Prussia the perpetual possession of upper Silesia; and the king guaranties to the emperour the perpetual possession of upper Austria, as soon as he shall have occupied it by conquest.\""
                            },
                            {
                                "example_id": "ffd4688d-621d-4923-a522-38f6139aaada",
                                "sense_id": "bfccc8dd-219c-33b1-83eb-e42e659d4c51",
                                "text": "They are classified as “loans” because they involve traditional market-rate loans, but with one important additional feature: Their payments are guarantied by a financially powerful third party."
                            },
                            {
                                "example_id": "db24b932-9001-482e-b58a-16abe2480746",
                                "sense_id": "bfccc8dd-219c-33b1-83eb-e42e659d4c51",
                                "text": "Real-time systems require a predictable behaviour in terms of guarantied deadlines."
                            }
                        ]
                    }
