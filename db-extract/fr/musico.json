                    },
                    {
                        "form_id": "c850ef55-c902-45f8-af9b-7a75a47508bd",
                        "entry_id": "520abb30-b6dc-3c03-8725-4838f37d2ff0",
                        "tags": [],
                        "form": "musicot"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4424f69b-db5c-366c-83b7-79d58ffa01c2",
                        "entry_id": "520abb30-b6dc-3c03-8725-4838f37d2ff0",
                        "glosses": [
                            "Cabaret que l'on trouvait au Pays-Bas, où le petit peuple et les matelots allaient boire, fumer, fréquenter les prostituées, entendre de la musique, etc."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "faca26fa-af20-4976-9511-460e6e5e9b12",
                                "sense_id": "4424f69b-db5c-366c-83b7-79d58ffa01c2",
                                "text": "Tout près du passage, je vois deux lanternes rouges et vertes, et j’entends une musique infernale qui m’indique suffisamment les musicos."
                            }
                        ]
                    },
                    {
                        "sense_id": "af954c0c-68d1-332d-a413-e07c5a6b6fc0",
                        "entry_id": "520abb30-b6dc-3c03-8725-4838f37d2ff0",
                        "glosses": [
                            "Musicien."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0f259e57-9502-451d-bfda-a3b1a3814f5b",
                                "sense_id": "af954c0c-68d1-332d-a413-e07c5a6b6fc0",
                                "text": "Près d’eux, des musicos jouaient au zanzibar."
                            },
                            {
                                "example_id": "f4371932-11be-404b-8844-8af9cf57a5b6",
                                "sense_id": "af954c0c-68d1-332d-a413-e07c5a6b6fc0",
                                "text": "Les musicos, sur leur estrade, envoient des tangos, des valses, des pasos, des rumbas, un petit slow pour les amoureux. Ils sont trois ou quatre, toujours dans le tas un accordéon, des fois deux, mais toujours au moins un, un dégourdi à la batterie et un ou deux autres zinzins de moindre importance, généralement à vent."
                            },
                            {
                                "example_id": "2198050c-bd1a-4d83-b711-160f8db5b30e",
                                "sense_id": "af954c0c-68d1-332d-a413-e07c5a6b6fc0",
                                "text": "Parmi les musicos convoqués se trouvait Éric Legnini, jazzman hutois reconnu aussi comme réalisateur artistique sur la place parisienne."
                            },
                            {
                                "example_id": "34eac1a5-4edc-4dfd-b310-75db5d861d2a",
                                "sense_id": "af954c0c-68d1-332d-a413-e07c5a6b6fc0",
                                "text": "Elle avait ensuite joué de la sonnette jusqu'aux aurores, pistant jusqu'au fond de leurs squats les potes d'Hélène — des musicos et des punks à chien pour la plupart."
                            }
                        ]
                    }
                ],
