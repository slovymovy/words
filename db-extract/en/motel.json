                                        "entry_id": "e5ca494d-a59a-3b72-bae9-fe4280ca8c45",
                                        "glosses": [
                                            "gebouw met aan elkaar geschakelde kamers met de deuren aan een parkeerplaats of gemeenschappelijke ruimte"
