                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fa84596-88fe-441c-9d9c-6405a58a2e78",
                        "source_entry_id": "efc19a29-9762-3dfc-b3af-3344866d844b",
                        "source_sense_id": "b7a3a95d-3725-3e38-b950-7a946fc4b416",
                        "target_lang_word": "octogone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "octogone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3536b5-6734-300b-b3a5-1e80d2c546f4",
                                        "entry_id": "3a29cc43-cdfb-33e9-b447-698e2bc7719e",
                                        "glosses": [
                                            "Qui a huit angles et huit côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c40678c-2720-4256-b1c4-e5c425bff9df",
                                                "sense_id": "fd3536b5-6734-300b-b3a5-1e80d2c546f4",
                                                "text": "Les vitraux de plomb disjoints laissaient tomber les verres octogones des croisées qui semblaient éborgnées."
                                            },
                                            {
                                                "example_id": "a3dc3bc8-b0cf-4758-851a-599453864ab0",
                                                "sense_id": "fd3536b5-6734-300b-b3a5-1e80d2c546f4",
                                                "text": "Son église à flèche octogone flanquée de quatre clochetons du onzième siècle (on en peut voir une pareille à Étampes, elle n’est pas encore abattue)"
                                            },
                                            {
                                                "example_id": "d5a233fc-b51d-46fe-b8ee-94cbcb9efc7f",
                                                "sense_id": "fd3536b5-6734-300b-b3a5-1e80d2c546f4",
                                                "text": "Une galerie d’arcades à deux étages supportée par des colonnes trapues s’appuyant sur une tourelle octogone, fait le trait d’union entre Frédéric IV et Othon-Henri."
                                            },
                                            {
                                                "example_id": "6df5ef3b-b79e-465f-9c16-6115c2f8c029",
                                                "sense_id": "fd3536b5-6734-300b-b3a5-1e80d2c546f4",
                                                "text": "Les fonts de Bertoncourt, près de Rethel, sont postérieurs à ceux dont nous venons de parler; […]. La cuve, octogone, repose sur un fût cylindrique dont la base est ornée d'un tore aplati, avec fleurs de lis aux angles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "octogone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "860d36d9-67b6-38cd-83a4-ef91bdbaa364",
                                        "entry_id": "b33e2c1a-fbed-30ed-91bc-c820fa88a1a4",
                                        "glosses": [
                                            "Polygone de huit côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b19024d3-a733-4bec-8e4c-2b6b0859ee74",
                                                "sense_id": "860d36d9-67b6-38cd-83a4-ef91bdbaa364",
                                                "text": "Un octogone régulier."
                                            },
                                            {
                                                "example_id": "38afa31d-2578-429f-8d7f-9959c1f4887c",
                                                "sense_id": "860d36d9-67b6-38cd-83a4-ef91bdbaa364",
                                                "text": "On y voit un tracé de dissolution du calcaire qui délimite une suface protégée et indique la position du retrait du parement de l’assise supérieure et une partie du cercle circonscrit à l’octogone du piédestal qui a permis de centrer celui-ci sur la corniche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df76a45c-01c4-36cf-91d0-c971f0410266",
                                        "entry_id": "b33e2c1a-fbed-30ed-91bc-c820fa88a1a4",
                                        "glosses": [
                                            "Ring des arts martiaux mixtes."
                                        ],
