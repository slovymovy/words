                        "glosses": [
                            "Habitant de la Louisiane francophone, descendant des Acadiens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f13cdd52-2ea9-4c71-ac13-2afec1765b46",
                                "sense_id": "238f0e35-29f0-34cb-90c7-d18c92da5fcd",
                                "text": "Ils étaient Acadiens lorsqu’ils sont arrivés en Louisiane à la fin du XVIIIᵉ siècle, après le Grand Dérangement. Depuis, ils sont devenus tour à tour Cadins, Cadjins, Cajuns, Acadjins, Kajuns, Canajins, selon la langue et l’identité de ceux qui les désignent."
                            }
                        ]
