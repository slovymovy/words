                        "glosses": [
                            "Moine qui, à la demande de son supérieur, a été ordonné prêtre, dans les Églises orthodoxes et les Églises catholiques d’Orient,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc91e054-56da-496a-9b1b-07733e3b1b6d",
                                "sense_id": "674f11f5-a806-3f91-bf1a-d0ff885d3e22",
                                "text": "De ces moniales, il ne reste que aujourd’hui que Christophora et soeur Anne, 85 ans, installées dans la ferme accolée à l’abbaye et rejointes plusieurs mois par an par un hiéromoine."
                            }
                        ]
                    }
                ],
