                    {
                        "sense_id": "27abcb3d-81f3-3c06-9ae1-a7e76672761b",
                        "entry_id": "0e8329ca-1e4d-3ce3-a3d5-bcf818646457",
                        "glosses": [
                            "Qui ne représente qu'une faible part, moins de la moitié d'un tout donné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c7a1d86-53b9-4827-8877-59aad106ce7f",
                                "sense_id": "27abcb3d-81f3-3c06-9ae1-a7e76672761b",
                                "text": "Le groupe qui soutient cette idée est minoritaire parmi la population du pays."
