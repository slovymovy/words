                "translations": [
                    {
                        "translation_id": "b44bcd2d-4ca1-4216-946d-4cb5db70c862",
                        "source_entry_id": "6cdf1507-3cbd-320b-8097-0b66a43d627c",
                        "source_sense_id": "8269b011-f267-3733-9577-fa6ea154ee23",
                        "target_lang_word": "apprehension",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apprehension",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "551bf0a7-8813-3c05-bab4-44e0ff13f498",
                                        "entry_id": "6198c337-41b0-3b35-8b84-9b529223497d",
                                        "glosses": [
                                            "The physical act of seizing or taking hold of (something); seizing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "798f3e2e-978d-4685-9800-32ba5347698a",
                                                "sense_id": "551bf0a7-8813-3c05-bab4-44e0ff13f498",
                                                "text": "The wing would have been a severe obstruction to apprehension of an object on the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52418ebe-07cf-38eb-bb9c-c50c28a932ab",
                                        "entry_id": "6198c337-41b0-3b35-8b84-9b529223497d",
                                        "glosses": [
                                            "The act of seizing or taking by legal process; arrest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "add9b87e-5679-42ce-83a4-2c6258b2dba5",
                                                "sense_id": "52418ebe-07cf-38eb-bb9c-c50c28a932ab",
                                                "text": "The warrant had been issued for his apprehension on the charge of rioting."
                                            },
                                            {
                                                "example_id": "b42b09d0-2573-449c-bf82-28e146228997",
                                                "sense_id": "52418ebe-07cf-38eb-bb9c-c50c28a932ab",
                                                "text": "When he told us that a large reward was offered by Sir Leicester Dedlock for the murderer's apprehension, I did not in my first consternation understand why; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ea1531-d8cf-3eed-9a77-fed606a13358",
                                        "entry_id": "6198c337-41b0-3b35-8b84-9b529223497d",
                                        "glosses": [
                                            "Perception; the act of understanding using one's intellect without affirming, denying, or passing any judgment"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eecfe95-ca51-46bd-8286-a3e8732d6997",
                                                "sense_id": "48ea1531-d8cf-3eed-9a77-fed606a13358",
                                                "text": "We live on, and in living we lose the apprehension of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f083a58f-f8e9-36de-9aae-a5fe76158748",
                                        "entry_id": "6198c337-41b0-3b35-8b84-9b529223497d",
                                        "glosses": [
                                            "Opinion; conception; sentiment; idea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19bdceab-67d1-42e4-8513-023c59a652a8",
                                                "sense_id": "f083a58f-f8e9-36de-9aae-a5fe76158748",
                                                "text": "We think we get a kind of vague apprehension of what London means from the top of a 'bus better than anywhere else."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15e2a543-7a83-3d3b-9daf-d214fb5dc049",
                                        "entry_id": "6198c337-41b0-3b35-8b84-9b529223497d",
                                        "glosses": [
                                            "The faculty by which ideas are conceived or by which perceptions are grasped; understanding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "557dc003-34fe-4a52-8bfe-1f5ce60c0a56",
                                                "sense_id": "15e2a543-7a83-3d3b-9daf-d214fb5dc049",
                                                "text": "Strangers of limited information and dull apprehension were sometimes observed not to know what a Powler was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d6e8a1a-182e-38b7-a38c-e6db858e5507",
                                        "entry_id": "6198c337-41b0-3b35-8b84-9b529223497d",
                                        "glosses": [
                                            "Anticipation, especially of unfavorable things such as dread or fear or the prospect of something unpleasant in the future."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d99db94-f8fe-4eb8-8233-88ea735805a5",
                                                "sense_id": "1d6e8a1a-182e-38b7-a38c-e6db858e5507",
                                                "text": "Every circumstance which evinced the savage nature of the beings at whose mercy I was, augmented the fearful apprehensions that consumed me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
