                                        "sense_id": "139e6e4b-d20f-37f6-88c4-911f87e0b0d3",
                                        "entry_id": "9e0ac04b-a554-369a-b76e-d6b87676f2f0",
                                        "glosses": [
                                            "A one-piece stretch garment worn by very young children."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "787d32d5-93dc-42a6-b4e3-1efeb4a1ee42",
                                                "sense_id": "139e6e4b-d20f-37f6-88c4-911f87e0b0d3",
                                                "text": "Like Marsha, his hair was tinged a faint rusty red. Sound asleep in a chair in the corner was a small girl, perhaps three, in a rumpled playsuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff23aac1-f756-3151-a867-77c1d5feffd6",
                                        "entry_id": "9e0ac04b-a554-369a-b76e-d6b87676f2f0",
                                        "glosses": [
                                            "A one-piece item of clothing for women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f70af3f-ecb1-4ceb-9a01-9b59af8e56ee",
                                                "sense_id": "ff23aac1-f756-3151-a867-77c1d5feffd6",
                                                "text": "To some, the very word \"playsuit\", with its frolicsome associations, will induce the conviction that this is not an item of clothing to be seen alive in. But playsuits are the natural second stage of the shorts revolution."
                                            },
                                            {
                                                "example_id": "3d4b3d5a-50d8-4e4f-a120-c484b259e25e",
                                                "sense_id": "ff23aac1-f756-3151-a867-77c1d5feffd6",
                                                "text": "The playsuit combines shorts, a skirt, and a backless bodice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcaa4b8d-12f2-30f5-8731-547d5dda9aa1",
                                        "entry_id": "9e0ac04b-a554-369a-b76e-d6b87676f2f0",
