                                            {
                                                "example_id": "b498b805-f60b-4ac6-b005-496961de5bff",
                                                "sense_id": "f0dd61ea-83ba-3852-929a-0cba26b175b0",
                                                "text": "L’alimentazione fornisce energia al corpo e teoricamente non si dovrebbe mangiare più di ciò che si consuma"
