                ],
                "senses": [
                    {
                        "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                        "entry_id": "ea1d2ae9-9ca1-3488-ae7f-da7cb3489abd",
                        "glosses": [
                            "ein Spieler des Sportes Fußball"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd9df20-b588-480b-a26c-b2c467f90d73",
                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                "text": "Mein Nachbar ist ein begeisterter Fußballer."
                            },
                            {
                                "example_id": "358ab6ae-94a5-4e98-aa0a-95c251366d1a",
                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                "text": "„Der ehemalige österreichische Fußballer Ernst Ogris ist im Alter von 49 Jahren in Wien nach kurzer Krankheit gestorben.“"
                            },
                            {
                                "example_id": "a2f36b88-d6c9-438a-8f46-cde4312215d1",
                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                "text": "„Der Fall Maradona ist den Italienern noch bekannt, weil dem Fußballer einst ein Diamantohrring und zwei goldene Rolex-Uhren beschlagnahmt wurden, um einen Teil seiner Steuerschuld zu tilgen.“"
                            },
                            {
                                "example_id": "3eb9e2f3-264a-4323-b793-d2e7d320bf4b",
                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                "text": "„Viele Fußballer versuchen sich dann entsprechend der in ihnen vermuteten Einsicht möglichst geschwollen auszudrücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
