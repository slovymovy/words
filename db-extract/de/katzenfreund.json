                "senses": [
                    {
                        "sense_id": "cb51d5f4-3e9c-378c-8a46-6e6b94662e1c",
                        "entry_id": "36a39142-417b-3145-9bc2-325ae246bf06",
                        "glosses": [
                            "(männliche) Person, die große Sympathien für Katzen hegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b877b8e-98a8-4f97-be3b-2611f30d97c1",
                                "sense_id": "cb51d5f4-3e9c-378c-8a46-6e6b94662e1c",
                                "text": "Da Guntbert in der näheren Umgebung als großer Katzenfreund bekannt ist, werden ständig herrenlose Katzen zu ihm gebracht."
                            },
                            {
                                "example_id": "8ca7a2d0-cd7c-4f20-b72c-69f30f8f0e71",
                                "sense_id": "cb51d5f4-3e9c-378c-8a46-6e6b94662e1c",
                                "text": "Unsere Nachbarn sind überhaupt keine Katzenfreunde."
                            },
                            {
                                "example_id": "a826a054-fc2b-471b-802f-eab23398e382",
                                "sense_id": "cb51d5f4-3e9c-378c-8a46-6e6b94662e1c",
                                "text": "Die große Auswahl in unserem Geschäft für Tierbedarf wird nicht nur die Herzen der Katzenfreunde höherschlagen lassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
