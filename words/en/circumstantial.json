{
    "word_family": [
        "circumstance",
        "circumstantially",
        "circumstantiality"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8c77af51-cfd3-34da-a44e-84db1ef49ce3",
                    "sense_definition": "Pointing indirectly toward someone's guilt or a conclusion of fact through inference rather than direct observation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecution built their case around <w>circumstantial</w> evidence that placed the suspect near the scene.",
                            "target_lang_translations": {
                                "nl": "Het Openbaar Ministerie bouwde de zaak op rond <w>indirect</w> bewijs dat de verdachte in de buurt van de plaats delict plaatste."
                            }
                        },
                        {
                            "text": "Although the proof was entirely <w>circumstantial</w>, the jury found the sequence of events convincing.",
                            "target_lang_translations": {
                                "nl": "Hoewel het bewijs volledig <w>indirect</w> was, vond de jury de opeenvolging van gebeurtenissen overtuigend."
                            }
                        }
                    ],
                    "common_phrases": [
                        "circumstantial evidence"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zijdelings wijzend op iemands schuld of een conclusie op basis van afleiding en vermoedens in plaats van directe waarneming."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "indirect",
                                "target_lang_sense_clarification": "met name bij bewijs"
                            },
                            {
                                "target_lang_word": "op aanwijzingen gebaseerd",
                                "target_lang_sense_clarification": "niet direct bewezen"
                            },
                            {
                                "target_lang_word": "circumstantieel",
                                "target_lang_sense_clarification": "formeel juridisch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd7f9c13-684d-3a45-9ebf-f100dd02ff24",
                    "sense_definition": "Pertaining to or dependent on specific external circumstances rather than fundamental or essential qualities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incidental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their sudden financial success was largely <w>circumstantial</w> rather than the result of a deliberate plan.",
                            "target_lang_translations": {
                                "nl": "Hun plotselinge financiële succes was grotendeels <w>omstandigheidsgebonden</w> in plaats van het resultaat van een bewust plan."
                            }
                        },
                        {
                            "text": "The committee decided to overlook the <w>circumstantial</w> differences and focus on shared core values.",
                            "target_lang_translations": {
                                "nl": "De commissie besloot de <w>bijkomstige</w> verschillen over het hoofd te zien en zich te concentreren op gedeelde kernwaarden."
                            }
                        }
                    ],
                    "synonyms": [
                        "accidental",
                        "coincidental",
                        "contingent",
                        "incidental",
                        "secondary"
                    ],
                    "antonyms": [
                        "essential",
                        "necessary"
                    ],
                    "target_lang_definitions": {
                        "nl": "Samenhangend met of afhankelijk van toevallige of externe omstandigheden in plaats van wezenlijke eigenschappen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omstandigheidsgebonden",
                                "target_lang_sense_clarification": "bepaald door de situatie"
                            },
                            {
                                "target_lang_word": "toevallig",
                                "target_lang_sense_clarification": "door de omstandigheden bepaald"
                            },
                            {
                                "target_lang_word": "bijkomstig",
                                "target_lang_sense_clarification": "niet essentieel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ab284f1-422b-305b-b152-3eb14e6708ec",
                    "sense_definition": "Containing or presenting full and precise details; highly particular.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "detail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a remarkably <w>circumstantial</w> report describing every single event of that morning.",
                            "target_lang_translations": {
                                "nl": "Ze gaf een opmerkelijk <w>omstandig</w> verslag waarin elke afzonderlijke gebeurtenis van die ochtend werd beschreven."
                            }
                        },
                        {
                            "text": "The witness provided a <w>circumstantial</w> account that helped detectives reconstruct the crime.",
                            "target_lang_translations": {
                                "nl": "De getuige gaf een <w>uitvoerige</w> verklaring die de rechercheurs hielp het misdrijf te reconstrueren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "circumstantial account"
                    ],
                    "target_lang_definitions": {
                        "nl": "Volledige en nauwkeurige details bevattend; zeer uitvoerig of gedetailleerd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omstandig",
                                "target_lang_sense_clarification": "zeer gedetailleerd en uitgebreid"
                            },
                            {
                                "target_lang_word": "uitvoerig",
                                "target_lang_sense_clarification": "met veel details"
                            },
                            {
                                "target_lang_word": "gedetailleerd",
                                "target_lang_sense_clarification": "tot in de kleinste bijzonderheden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b820780-e3c9-3cc6-a298-b1524f381016",
                    "sense_definition": "Full of ceremony, pomp, or formal display.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pomp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambassador was welcomed with a lavish and <w>circumstantial</w> reception at the palace.",
                            "target_lang_translations": {
                                "nl": "De ambassadeur werd op het paleis verwelkomd met een weelderige en <w>ceremoniële</w> ontvangst."
                            }
                        },
                        {
                            "text": "They observed all the <w>circumstantial</w> rituals required for the coronation ceremony.",
                            "target_lang_translations": {
                                "nl": "Ze namen alle <w>plechtige</w> rituelen in acht die vereist waren voor de kroningsceremonie."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Gekenmerkt door veel ceremonie, plechtigheid of formeel vertoon."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "plechtig",
                                "target_lang_sense_clarification": "formeel en ceremonieel"
                            },
                            {
                                "target_lang_word": "ceremonieus",
                                "target_lang_sense_clarification": "vol uiterlijk vertoon"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b0376468-f634-3252-8ffa-871fec75a14c",
                    "sense_definition": "A secondary, minor, or incidental detail or condition associated with a main subject.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "incidental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosophers argued about core doctrines rather than the mere <w>circumstantials</w> of faith.",
                            "target_lang_translations": {
                                "nl": "De filosofen debatteerden over kerndoctrines in plaats van over louter de <w>bijkomstigheden</w> van het geloof."
                            }
                        },
                        {
                            "text": "Do not lose sight of the central issue while debating these minor <w>circumstantials</w>.",
                            "target_lang_translations": {
                                "nl": "Verlies de hoofdkwestie niet uit het oog tijdens het debatteren over deze kleine <w>bijkomstigheden</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "essential"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Chiefly used in the plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een ondergeschikt, niet-essentieel detail of bijkomstige omstandigheid (meestal meervoud)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bijkomstigheid",
                                "target_lang_sense_clarification": "ondergeschikt detail"
                            },
                            {
                                "target_lang_word": "detail",
                                "target_lang_sense_clarification": "kleinigheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdeb64ea-beef-3af5-8f05-0378f269c287",
                    "sense_definition": "An accompanying circumstance or nonessential adjunct.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "incidental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every minor <w>circumstantial</w> of the event was carefully recorded in the official archives.",
                            "target_lang_translations": {
                                "nl": "Elke kleine <w>bijomstandigheid</w> van de gebeurtenis werd zorgvuldig vastgelegd in de officiële archieven."
                            }
                        },
                        {
                            "text": "He treated each odd <w>circumstantial</w> as an important clue in his investigation.",
                            "target_lang_translations": {
                                "nl": "Hij behandelde elk vreemd <w>detail</w> als een belangrijke aanwijzing in zijn onderzoek."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely encountered in contemporary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een begeleidende omstandigheid of niet-wezenlijk bijverschijnsel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bijomstandigheid",
                                "target_lang_sense_clarification": "begeleidende factor"
                            },
                            {
                                "target_lang_word": "toevalligheid",
                                "target_lang_sense_clarification": "toevallig aspect"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}