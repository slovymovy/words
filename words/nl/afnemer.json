{
    "word_family": [
        "afname",
        "afnemen",
        "leverancier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee369df1-0df6-37d0-8ef2-2ad728b4b543",
                    "sense_definition": "Een persoon of organisatie die goederen of diensten koopt van een verkoper of leverancier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "klant_koper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Onze grootste <w>afnemer</w> heeft deze week een grote bestelling geplaatst.",
                            "target_lang_translations": {
                                "en": "Our largest <w>customer</w> placed a big order this week."
                            }
                        },
                        {
                            "text": "De fabriek levert direct aan de <w>afnemer</w> om kosten te besparen.",
                            "target_lang_translations": {
                                "en": "The factory delivers directly to the <w>customer</w> to save costs."
                            }
                        }
                    ],
                    "synonyms": [
                        "klant",
                        "koper",
                        "cliënt"
                    ],
                    "common_phrases": [
                        "grootste afnemer",
                        "vaste afnemer"
                    ],
                    "target_lang_definitions": {
                        "en": "A person or organization that buys goods or services from a seller or supplier."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "customer",
                                "target_lang_sense_clarification": "general buyer of goods or services"
                            },
                            {
                                "target_lang_word": "buyer",
                                "target_lang_sense_clarification": "person or entity purchasing goods"
                            },
                            {
                                "target_lang_word": "client",
                                "target_lang_sense_clarification": "recipient of professional services or products"
                            },
                            {
                                "target_lang_word": "offtaker",
                                "target_lang_sense_clarification": "buyer of produced goods or commodities"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "368b66f9-5bd8-3642-9398-802f32d7bbc7",
                    "sense_definition": "Iemand die beroepsmatig verantwoordelijk is voor de inkoop en het aanschaffen van goederen of diensten binnen een organisatie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inkoper_beroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als <w>afnemer</w> bij een groot bedrijf onderhandel je dagelijks over prijzen.",
                            "target_lang_translations": {
                                "en": "As a <w>buyer</w> at a large company, you negotiate prices daily."
                            }
                        },
                        {
                            "text": "De <w>afnemer</w> controleert de kwaliteit van de geleverde grondstoffen zorgvuldig.",
                            "target_lang_translations": {
                                "en": "The <w>purchaser</w> carefully checks the quality of the delivered raw materials."
                            }
                        }
                    ],
                    "synonyms": [
                        "inkoper"
                    ],
                    "common_phrases": [
                        "professionele afnemer"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone professionally responsible for purchasing goods or services within an organization."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purchaser",
                                "target_lang_sense_clarification": "professional purchasing agent"
                            },
                            {
                                "target_lang_word": "buyer",
                                "target_lang_sense_clarification": "professional procurement buyer"
                            },
                            {
                                "target_lang_word": "procurement officer",
                                "target_lang_sense_clarification": "person responsible for organizational purchasing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}