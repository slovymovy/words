            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01cb4f21-6630-3655-80e7-0a4d4ca96722",
                    "sense_definition": "Wyrażenie niezadowolenia lub pretensji wobec czyjegoś zachowania.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reproach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie mam do ciebie żadnego <w>wyrzutu</w> w tej sprawie.",
                            "target_lang_translations": {
                                "ru": "У меня нет к тебе никаких <w>упрёков</w> по этому делу."
                            }
                        },
                        {
                            "text": "Czuł wielki <w>wyrzut</w> sumienia po tym, co powiedział.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал сильные <w>угрызения</w> совести после того, что сказал."
                            }
                        }
                    ],
                    "synonyms": [
                        "pretensja",
                        "żal",
                        "zarzut"
                    ],
                    "common_phrases": [
                        "wyrzut sumienia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение недовольства или претензий по поводу чьего-либо поведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упрёк",
                                "target_lang_sense_clarification": "выражение недовольства поведением"
                            },
                            {
                                "target_lang_word": "претензия",
                                "target_lang_sense_clarification": "выражение недовольства или требование"
                            },
                            {
                                "target_lang_word": "угрызение совести",
                                "target_lang_sense_clarification": "в контексте 'wyrzut sumienia'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6172cb2-4102-32b5-9f92-895cc674c255",
                    "sense_definition": "Zmiana na skórze w postaci małej grudki lub krosty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "skin_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na twarzy pojawił się bolesny <w>wyrzut</w>.",
                            "target_lang_translations": {
                                "ru": "На лице появилось болезненное <w>высыпание</w>."
                            }
                        },
                        {
                            "text": "Lekarz przepisał maść na ten skórny <w>wyrzut</w>.",
                            "target_lang_translations": {
                                "ru": "Врач прописал мазь от этого кожного <w>высыпания</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "krosta",
                        "pryszcz",
                        "wykwit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение на коже в виде маленького бугорка или прыща."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высыпание",
                                "target_lang_sense_clarification": "медицинский термин для кожных проявлений"
                            },
                            {
                                "target_lang_word": "сыпь",
                                "target_lang_sense_clarification": "общее название кожных высыпаний"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f5f24b4-329c-3e8c-bf4c-5319c76fa3cc",
                    "sense_definition": "Gwałtowne rzucenie lub wyrzucenie czegoś w określonym kierunku.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Silny <w>wyrzut</w> piłki pozwolił zdobyć punkt.",
                            "target_lang_translations": {
                                "ru": "Сильный <w>бросок</w> мяча позволил заработать очко."
                            }
                        },
                        {
                            "text": "Mechanizm zapewnia szybki <w>wyrzut</w> rakiety.",
                            "target_lang_translations": {
                                "ru": "Механизм обеспечивает быстрый <w>выброс</w> ракеты."
                            }
                        }
                    ],
                    "synonyms": [
                        "rzut",
                        "machnięcie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий бросок или выбрасывание чего-либо в определенном направлении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросок",
                                "target_lang_sense_clarification": "резкое движение или метание"
                            },
                            {
                                "target_lang_word": "выброс",
                                "target_lang_sense_clarification": "процесс выбрасывания чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
