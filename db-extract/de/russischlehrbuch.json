                "senses": [
                    {
                        "sense_id": "ca902561-8df2-3ff7-a323-3a80b0416cc0",
                        "entry_id": "b34991ab-63e6-301f-9d35-88ea2ae17547",
                        "glosses": [
                            "Buch, das dazu dient, das Erlernen des Russischen zu ermöglichen, entweder im Selbststudium oder im Unterricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41a4d6ae-0a7a-4a02-b901-8762d44d8e1d",
                                "sense_id": "ca902561-8df2-3ff7-a323-3a80b0416cc0",
                                "text": "„Er schwenkte ein dickes Russischlehrbuch, das er irgendwo aufgetrieben hatte.“"
                            },
                            {
                                "example_id": "770d8de0-64ab-4377-981f-e2533a8e665c",
                                "sense_id": "ca902561-8df2-3ff7-a323-3a80b0416cc0",
                                "text": "„Im Russischlehrbuch ‚Konetschno!‘ begleiten Lena und Ira die Schüler von Kapitel zu Kapitel.“"
                            },
                            {
                                "example_id": "d9b24616-2396-4c8a-a7f6-47b97d8c0d66",
                                "sense_id": "ca902561-8df2-3ff7-a323-3a80b0416cc0",
                                "text": "„Sie besaßen keine Lehrbücher – außer dem Russischlehrbuch von Steinitz – und mussten mitschreiben.“"
                            },
                            {
                                "example_id": "811fbf95-859b-4768-b024-f220a5c2f0a7",
                                "sense_id": "ca902561-8df2-3ff7-a323-3a80b0416cc0",
                                "text": "„Im Rahmen der Dissertation werden die finnischen und deutschen Russischlehrbücher untersucht, die nach dem Zusammenbruch des sozialistischen Gesellschaftssystems der UdSSR und in den folgenden Jahren zu Beginn des 21. Jahrhunderts herausgegeben worden sind.“"
                            },
                            {
                                "example_id": "9463bd70-1546-499e-baf9-5e33df452da0",
                                "sense_id": "ca902561-8df2-3ff7-a323-3a80b0416cc0",
                                "text": "„Arnd Peiffer hat Russischlehrbücher nach Sibirien mitgebracht, was haben Sie im Reisegepäck?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
