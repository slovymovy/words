                        "glosses": [
                            "Se répandre en battologies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8f3d6e-b9be-45bf-b0c9-30f541a82801",
                                "sense_id": "4515a26a-a45e-3525-88cf-7dccd2a0a63b",
                                "text": "Mais on peut penser que lorsque Tyard conseille au fidèle de ne pas se préoccuper de la longueur de sa prière — on ne prie jamais assez — et de rechercher avant tout la simplicité, il parle de son propre chef et selon sa propre perception ; de même lorsqu’il reprend à son propre compte le précepte biblique de ne pas « battologiser »."
                            }
                        ]
