{
    "word_family": [
        "sailor",
        "sailing",
        "sailboat",
        "sailcloth",
        "sailfish",
        "sailmaker",
        "sailplane",
        "unsailable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15241b9e-bc9b-3c61-8006-a74dd7200190",
                    "sense_definition": "To begin a voyage by water; to depart from a port.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "maritime-travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large cruise ship will <w>sail</w> for Australia tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Большой круизный лайнер <w>отправится</w> в Австралию завтра утром."
                            }
                        },
                        {
                            "text": "They decided to <w>set</w> <w>sail</w> before the weather turned bad.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>поднять паруса</w>, пока погода не испортилась."
                            }
                        }
                    ],
                    "common_phrases": [
                        "set sail",
                        "sail for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начать морское путешествие; отправиться из порта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отплывать",
                                "target_lang_sense_clarification": "отправляться из порта"
                            },
                            {
                                "target_lang_word": "выходить в море",
                                "target_lang_sense_clarification": "начинать плавание"
                            },
                            {
                                "target_lang_word": "поднимать паруса",
                                "target_lang_sense_clarification": "готовиться к отплытию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b9222f6-5baf-3b35-85ea-21340b0af981",
                    "sense_definition": "To travel or ride in a boat, especially one powered by wind.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "maritime-travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We love to <w>sail</w> around the islands during our summer vacation.",
                            "target_lang_translations": {
                                "ru": "Мы обожаем <w>плавать</w> вокруг островов во время летнего отпуска."
                            }
                        },
                        {
                            "text": "It is very relaxing to <w>sail</w> across the lake on a quiet afternoon.",
                            "target_lang_translations": {
                                "ru": "Очень приятно <w>плыть</w> по озеру тихим днем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sail across",
                        "sail around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать или передвигаться на лодке, особенно на парусной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плыть",
                                "target_lang_sense_clarification": "передвигаться по воде"
                            },
                            {
                                "target_lang_word": "ходить под парусом",
                                "target_lang_sense_clarification": "управлять парусным судном"
                            },
                            {
                                "target_lang_word": "плавать",
                                "target_lang_sense_clarification": "совершать водную прогулку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ac31712-e3cf-3462-93d2-795627d5c60e",
                    "sense_definition": "To move smoothly, easily, or gracefully through the air or over a surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "smooth-movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle began to <w>sail</w> through the air with its wings spread wide.",
                            "target_lang_translations": {
                                "ru": "Орел начал <w>парить</w> в воздухе, широко расправив крылья."
                            }
                        },
                        {
                            "text": "The ball <w>sailed</w> over the fence and into the neighbor's yard.",
                            "target_lang_translations": {
                                "ru": "Мяч <w>перелетел</w> через забор и упал в соседский двор."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sail through the air",
                        "sail over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавно, легко или грациозно двигаться по воздуху или по поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парить",
                                "target_lang_sense_clarification": "плавно лететь"
                            },
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "двигаться легко и плавно"
                            },
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "быстро и плавно перемещаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53f05fd7-7dc8-33e6-a442-2343ce0a7bd7",
                    "sense_definition": "To walk or move in a confident, proud, or imposing manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smooth-movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>sailed</w> into the office and started giving orders immediately.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>вплыл</w> в офис и сразу начал раздавать указания."
                            }
                        },
                        {
                            "text": "She <w>sailed</w> past the guards without even looking at them.",
                            "target_lang_translations": {
                                "ru": "Она гордо <w>прошла</w> мимо охраны, даже не взглянув на них."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sail into",
                        "sail past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти или двигаться уверенно, гордо или величественно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шествовать",
                                "target_lang_sense_clarification": "идти важно и торжественно"
                            },
                            {
                                "target_lang_word": "вплывать",
                                "target_lang_sense_clarification": "плавно и уверенно входить"
                            },
                            {
                                "target_lang_word": "проплывать",
                                "target_lang_sense_clarification": "гордо проходить мимо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86d6ee8a-4ac4-3a12-861f-dec4057fe752",
                    "sense_definition": "A large piece of strong fabric attached to a boat to catch the wind and move the vessel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nautical-parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors worked together to raise the main <w>sail</w> as the wind picked up.",
                            "target_lang_translations": {
                                "ru": "Матросы дружно работали, чтобы поднять грот-<w>парус</w>, когда ветер усилился."
                            }
                        },
                        {
                            "text": "A small hole in the <w>sail</w> can make the boat much slower.",
                            "target_lang_translations": {
                                "ru": "Маленькая дырка в <w>парусе</w> может сильно замедлить лодку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hoist the sail",
                        "main sail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой кусок прочной ткани, прикрепленный к лодке для улавливания ветра и движения судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парус",
                                "target_lang_sense_clarification": "основное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38120305-553a-344b-92ef-499777e35589",
                    "sense_definition": "A short trip or excursion taken in a boat.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "maritime-travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather is perfect today, so let's go for a <w>sail</w>.",
                            "target_lang_translations": {
                                "ru": "Сегодня отличная погода, так что давай <w>прокатимся</w> под парусом."
                            }
                        },
                        {
                            "text": "We enjoyed a lovely afternoon <w>sail</w> along the coast.",
                            "target_lang_translations": {
                                "ru": "Нам очень понравилась чудесная дневная <w>прогулка</w> вдоль побережья."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for a sail",
                        "afternoon sail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая поездка или прогулка на лодке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогулка под парусом",
                                "target_lang_sense_clarification": "экскурсия на лодке"
                            },
                            {
                                "target_lang_word": "плавание",
                                "target_lang_sense_clarification": "недолгий выход в море"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b81ac13-0185-32f7-a77a-3ee6fedc3942",
                    "sense_definition": "The flat blade or arm of a windmill that catches the wind.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical-parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wooden <w>sails</w> of the old windmill turned slowly in the breeze.",
                            "target_lang_translations": {
                                "ru": "Деревянные <w>крылья</w> старой мельницы медленно вращались на ветру."
                            }
                        },
                        {
                            "text": "A storm damaged one of the <w>sails</w>, stopping the mill from grinding grain.",
                            "target_lang_translations": {
                                "ru": "Шторм повредил одно из <w>крыльев</w>, и мельница перестала молоть зерно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "windmill sail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лопасть или крыло ветряной мельницы, улавливающее ветер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крыло",
                                "target_lang_sense_clarification": "лопасть мельницы"
                            },
                            {
                                "target_lang_word": "маховое крыло",
                                "target_lang_sense_clarification": "деталь мельницы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b14a3d5f-401f-3d0d-8790-56509c8d4ec0",
                    "sense_definition": "A sailing vessel or ship; often used collectively to count ships.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maritime-travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lookout reported that twenty <w>sail</w> were visible on the horizon.",
                            "target_lang_translations": {
                                "ru": "Наблюдатель доложил, что на горизонте видно двадцать <w>парусов</w>."
                            }
                        },
                        {
                            "text": "The fleet consisted of over fifty <w>sail</w> of various sizes.",
                            "target_lang_translations": {
                                "ru": "Флот состоял из более чем пятидесяти <w>судов</w> разного размера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ten sail"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used when counting ships"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Парусное судно или корабль; часто используется как собирательное существительное для счета судов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парусник",
                                "target_lang_sense_clarification": "судно"
                            },
                            {
                                "target_lang_word": "единица флота",
                                "target_lang_sense_clarification": "при счете кораблей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}