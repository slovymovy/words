                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5589de8a-891b-4572-ab6f-f78232926bc8",
                                "sense_id": "69312598-fa86-36f2-b46b-7394d8e8385b",
                                "text": "Тут Гумберт Выворотень грезил и волхвовал—и алое солнце желания и решимости (из этих двух и создаётся живой мир!) поднималось всё выше, между тем как на чередующихся балконах чередующиеся сибариты поднимали бокал за прошлые и будущие ночи."
                            }
                        ]
                    }
