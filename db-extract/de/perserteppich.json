                ],
                "senses": [
                    {
                        "sense_id": "9240c3f3-70d3-3018-8176-e0c0180e5752",
                        "entry_id": "89abb9e4-a1ca-3167-821f-84345e4ef64b",
                        "glosses": [
                            "handgeknüpfter Orientteppich, der aus Persien kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "450188b2-161e-40cb-b074-b96bc1993585",
                                "sense_id": "9240c3f3-70d3-3018-8176-e0c0180e5752",
                                "text": "„Sie sucht den dunklen Perserteppich ab, auf dem die Münze verschwunden ist.“"
                            },
                            {
                                "example_id": "12ddf198-f185-467c-8c1d-618fb7657bf4",
                                "sense_id": "9240c3f3-70d3-3018-8176-e0c0180e5752",
                                "text": "„Ich würde am liebsten ganze Tage und Nächte auf den Perserteppichen herumkugeln.“"
                            },
                            {
                                "example_id": "ec49cc97-3fb4-4602-93b8-1908473a2028",
                                "sense_id": "9240c3f3-70d3-3018-8176-e0c0180e5752",
                                "text": "„Dies grosse, durch eine bogenüberspannte Säulenreihe in zwei Hälften geteilte, ganz mit Perserteppichen ausgeschlagene Zimmer war Pierre wohlbekannt.“"
                            },
                            {
                                "example_id": "c9fa8019-8d30-4ed8-bd44-4c0187b2d7db",
                                "sense_id": "9240c3f3-70d3-3018-8176-e0c0180e5752",
                                "text": "„Nach dem letzten Kampf fiel sie auf den Perserteppich, der das Parkett bedeckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
