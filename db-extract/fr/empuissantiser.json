                "senses": [
                    {
                        "sense_id": "6185ab41-d717-319d-8543-f6665f159ff8",
                        "entry_id": "0badc37e-5dbb-33b3-a0f1-328cc3612a5e",
                        "glosses": [
                            "Donner de la puissance à quelque chose, à quelqu'un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c1e714-1353-467c-9174-451531d2f252",
                                "sense_id": "6185ab41-d717-319d-8543-f6665f159ff8",
                                "text": "Il faut donc croire que les « valeurs», dont les conservateurs font l'axe de leurs « combats culturels », peuvent être, convenablement empuissantisées, au principe d'affections capables de l'emporter sur des affections plus immédiates."
                            },
                            {
                                "example_id": "b8930bdd-f20c-4204-80cc-98e43e005ffa",
                                "sense_id": "6185ab41-d717-319d-8543-f6665f159ff8",
                                "text": "Il appelle les créations artistiques des « machines affectantes », capables d'« empuissantiser les idées ».."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c025109b-d34b-4214-935e-5b697e1ca722",
                        "source_entry_id": "0badc37e-5dbb-33b3-a0f1-328cc3612a5e",
                        "source_sense_id": "6185ab41-d717-319d-8543-f6665f159ff8",
                        "target_lang_word": "empower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42d96ee9-ede6-3dfe-b504-0ce837a6246b",
                                        "entry_id": "9285936d-a309-3300-a514-8b5e6836b68c",
                                        "glosses": [
                                            "To give permission, power, or the legal right to do something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1cf2411-c64e-4667-9429-1827bb87018f",
                                                "sense_id": "42d96ee9-ede6-3dfe-b504-0ce837a6246b",
                                                "text": "Regulations have been made under the Civil Aviation Acts of 1949, 1980 and 1982 which empower Inspectors of Accidents to do these things."
                                            },
                                            {
                                                "example_id": "8da716d3-aac2-406d-81df-4c3d8f7a9b23",
                                                "sense_id": "42d96ee9-ede6-3dfe-b504-0ce837a6246b",
                                                "text": "Once on site, inspectors are empowered to exercise wide-ranging legal powers - including the right to enter railway property or land adjoining it; to make written, electronic or photographic records; to seize equipment, remove or retain samples; and to be given access to records and recording equipment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d38067c-4019-3cc8-b9de-60a8bbc1efb5",
                                        "entry_id": "9285936d-a309-3300-a514-8b5e6836b68c",
                                        "glosses": [
                                            "To give someone more confidence and/or strength to do something, often by enabling them to increase their control over their own life or situation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7e0230b-90ff-4a0f-9776-aba4231a760d",
                                                "sense_id": "1d38067c-4019-3cc8-b9de-60a8bbc1efb5",
                                                "text": "John found that starting up his own business empowered him greatly in social situations."
                                            },
                                            {
                                                "example_id": "7e934e1b-210f-4156-aac3-7ac02a73de24",
                                                "sense_id": "1d38067c-4019-3cc8-b9de-60a8bbc1efb5",
                                                "text": "Musically, what originally attracted me to dance was its shamanist aspects, using natural magic to change people's neurological states and to psychologically empower them."
                                            },
                                            {
                                                "example_id": "22f0c829-e1b0-4de9-9230-fc2eb05d2e64",
                                                "sense_id": "1d38067c-4019-3cc8-b9de-60a8bbc1efb5",
                                                "text": "This side of the training is effective in empowering employees to make better decisions on site, and helps to improve employee retention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
