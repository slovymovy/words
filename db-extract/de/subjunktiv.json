                    },
                    {
                        "translation_id": "f95441d0-4638-4965-b1ce-dec6da5721da",
                        "source_entry_id": "9fbbb84c-512b-3d12-b885-f45f6a6c791c",
                        "source_sense_id": "c85d343d-f849-3b8d-94dc-268d06657358",
                        "source_sense_description": "Linguistik, Modus: Ausdruck einer Aktion oder eines Zustandes, der hypothetisch und in einer alternativen Wirklichkeit möglich ist",
                        "target_lang_word": "сослагательное наклонение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сослагательное наклонение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8a41c7b8-3f1c-32b5-a515-0fd618163db2",
                                        "entry_id": "d7f79afa-faa1-3344-b3b6-4bb70e6c1b19",
                                        "glosses": [
                                            "лингв. наклонение, обозначающее действие, которое говорящий мыслит как желаемое или возможное"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a3dbdd0-eeee-49f3-8631-00c5604cea77",
                                                "sense_id": "8a41c7b8-3f1c-32b5-a515-0fd618163db2",
                                                "text": "Безайс с воодушевлением проспрягал глагол «ходить» в прошедшем и будущем времени и даже в сослагательном наклонении: «я ходил, я буду ходить, я ходил бы»."
                                            },
                                            {
                                                "example_id": "cb6a2e50-fc58-4737-8d6d-7cf6fa4822be",
                                                "sense_id": "8a41c7b8-3f1c-32b5-a515-0fd618163db2",
                                                "text": "Он, кажется, никогда не говорил, даже в детстве Андрея, «ты обязательно должен это сделать». Сослагательное наклонение ― вот язык Арсения Николаевича. «Тебе бы следовало сесть за книги…» «Я предложил бы обществу поехать на море…» В таком роде общался старый «доброволец» с окружающими."
                                            },
                                            {
                                                "example_id": "cffeb9b3-5b26-42ae-a9a8-2b50075b89e8",
                                                "sense_id": "8a41c7b8-3f1c-32b5-a515-0fd618163db2",
                                                "text": "В этой условной конструкции обозначается невыполнимое условие, и в обеих её частях употреблены аналитические формы сослагательного наклонения, лишённые временного значения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9c2a14a-b975-3e16-9e00-ed5592929881",
                                        "entry_id": "d7f79afa-faa1-3344-b3b6-4bb70e6c1b19",
                                        "glosses": [
                                            "перен. о праздных мечтах, о чём-либо несбывшемся"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0c00927-11f8-4b05-8404-826de10eb76b",
                                                "sense_id": "d9c2a14a-b975-3e16-9e00-ed5592929881",
                                                "text": "Он словно жил за другого человека в сослагательном наклонении: ясно видел, каким этот человек мог бы стать ― и не стал."
                                            },
                                            {
                                                "example_id": "53a6176b-7006-4f68-b903-3d4d598c5e65",
                                                "sense_id": "d9c2a14a-b975-3e16-9e00-ed5592929881",
                                                "text": "Но история не знает оправданий и не терпит сослагательного наклонения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fcffd74-88e4-4082-8127-089119615273",
                        "source_entry_id": "9fbbb84c-512b-3d12-b885-f45f6a6c791c",
                        "source_sense_id": "c85d343d-f849-3b8d-94dc-268d06657358",
                        "source_sense_description": "Linguistik, Modus: Ausdruck einer Aktion oder eines Zustandes, der hypothetisch und in einer alternativen Wirklichkeit möglich ist",
                        "target_lang_word": "subjuntivo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subjuntivo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3ed2e14e-5884-357f-9a35-281ee5fc41a7",
                                        "entry_id": "8e23426d-2b0e-3ec6-b84c-7c295a5bdb1b",
                                        "glosses": [
                                            "Modo verbal que sugiere una actitud subjetiva del hablante respecto a lo expresado por el verbo, la cual incluye posibilidad, expectativa, contingencia o deseo en contextos que varían de lengua en lengua. Sus contrapartes en español son el modo indicativo y el modo imperativo."
                                        ],
                                        "tags": [
                                            "normalmente solo se emplea en oración subordinada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d17842ff-20b5-4078-b547-71e079dbb627",
                                                "sense_id": "3ed2e14e-5884-357f-9a35-281ee5fc41a7",
                                                "text": "deseo de una persona sobre otra: Mi madre quiere que estudie medicina."
                                            },
                                            {
                                                "example_id": "2e83dd3c-6794-4788-8bfc-76bb2ade238f",
                                                "sense_id": "3ed2e14e-5884-357f-9a35-281ee5fc41a7",
                                                "text": "duda: No creo que llegue a tiempo."
                                            },
                                            {
                                                "example_id": "7937e5bf-170a-4cd6-8fda-a1c6c1a73a30",
                                                "sense_id": "3ed2e14e-5884-357f-9a35-281ee5fc41a7",
                                                "text": "impresiones subjetivas: es probable que llueva, es interesante que haya vida."
                                            },
                                            {
                                                "example_id": "7880791a-de63-4f7a-9cb9-f1105745077c",
                                                "sense_id": "3ed2e14e-5884-357f-9a35-281ee5fc41a7",
                                                "text": "una situación hipotética: descansaremos cuando haya paz mundial; si hubiera paz mundial descansaríamos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
