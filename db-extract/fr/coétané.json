                "senses": [
                    {
                        "sense_id": "f893fb81-5a8d-37d0-a20e-384c79c1c121",
                        "entry_id": "43d58698-2f9a-3213-aeee-0afff6eecca4",
                        "glosses": [
                            "Qui est né en même temps, qui a le même âge."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "239c0421-b622-4513-8cc2-f3861ddb2c28",
                                "sense_id": "f893fb81-5a8d-37d0-a20e-384c79c1c121",
                                "text": "… & la melodie bien resonnante des Epithalames qu’eussent chanté en son mariage ses compagnes coëtanées, filles vierges à marier, …"
                            },
                            {
                                "example_id": "7a8dabc8-27e5-4f95-9f57-42ff896eea91",
                                "sense_id": "f893fb81-5a8d-37d0-a20e-384c79c1c121",
                                "text": "… ce mélange se fit dans les temps modernes de la nature, puisqu’il suppose l’existence au moins coétanée de plusieurs minéraux, tels que le fer ou autres qui colorent souvent l’intérieur de ces verres, sans parler de tant de mines dont ils sont la gangue."
                            },
                            {
                                "example_id": "56b87a47-3b03-4f70-9f24-ca63689b0fda",
                                "sense_id": "f893fb81-5a8d-37d0-a20e-384c79c1c121",
                                "text": "Un sens non pas seulement contemporain ou coëtané mais antérieur à tous les autres , qui est le premier formé , le premier en activité, qui s’exerce déjà quand les autres n’existent pas encore, …"
                            }
                        ]
                    },
                    {
                        "sense_id": "798dabbd-be21-3354-a753-822f6c7f170f",
                        "entry_id": "43d58698-2f9a-3213-aeee-0afff6eecca4",
                        "glosses": [
                            "Qualifie les fleurs et les feuilles qui apparaissent en même temps."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "07a43f4f-529c-46ca-9843-dbc08a7c0acf",
                                "sense_id": "798dabbd-be21-3354-a753-822f6c7f170f",
                                "text": "Ces plantes, jusqu’à présent mal observées, diffèrent surtout par la forme de leurs feuilles presque toujours coétanées."
                            },
                            {
                                "example_id": "13ddc696-2b59-4243-8249-42fe25354b97",
                                "sense_id": "798dabbd-be21-3354-a753-822f6c7f170f",
                                "text": "Les fleurs ou les feuilles coétanées apparaissent les unes avec les autres."
                            }
                        ]
                    }
