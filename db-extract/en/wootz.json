                        "glosses": [
                            "A type of steel from India, much admired for making sword blades."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad053861-0dc4-4ad2-9443-54e3e79a9579",
                                "sense_id": "1970b8ee-791e-3326-a2ee-31b81664cd6e",
                                "text": "The celebrated wootz or steel of India, made in little cakes of only about two pounds weight, possesses qualities which no European steel can surpass."
                            },
                            {
                                "example_id": "186c40b8-7953-4eaf-be76-8051cb039aec",
                                "sense_id": "1970b8ee-791e-3326-a2ee-31b81664cd6e",
                                "text": "The ferrum Indicum of the Classics may still be represented by the famous Wootz or Wutz, the 'natural Indian steel,' still so much prized for Sword-blades in Persia and Afghanistan."
                            }
                        ]
                    }
