                        "form": "die Prärien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28112dc1-4692-36a0-bd8a-b11d781a88ad",
                        "entry_id": "44626f9e-f2d6-307f-9316-158cde521ba5",
                        "glosses": [
                            "Graslandschaft in Nordamerika"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "fd25136f-36e0-4d79-858e-ff1b7aa3846e",
                                "sense_id": "28112dc1-4692-36a0-bd8a-b11d781a88ad",
                                "text": "Im Western reiten die Männer stundenlang durch die Prärie."
                            },
                            {
                                "example_id": "dd93d68e-5e4b-41da-a08d-d4c6133b7506",
                                "sense_id": "28112dc1-4692-36a0-bd8a-b11d781a88ad",
                                "text": "„Albertas Landschaft wird von der Prärie dominiert, die sich im Osten bis nach Manitoba ausdehnt.“"
                            },
                            {
                                "example_id": "a96c0800-d02b-4b39-bd4c-8e3ea39e3dfb",
                                "sense_id": "28112dc1-4692-36a0-bd8a-b11d781a88ad",
                                "text": "Die nordamerikanischen Prärien sind sehr junge Ökosysteme, sie entstanden nach dem Ende der letzten Eiszeit vor 10-12.000 Jahren."
                            },
                            {
                                "example_id": "fc519542-1853-44b5-b441-ff52da52381b",
                                "sense_id": "28112dc1-4692-36a0-bd8a-b11d781a88ad",
                                "text": "„Aus Aufzeichnungen spanischer Behörden ist bekannt, dass vor 1650 kein einziger Mustang in der Prärie lebte.“"
                            },
                            {
                                "example_id": "1889bafd-e5a4-4a77-8abb-a9c668dcfc96",
                                "sense_id": "28112dc1-4692-36a0-bd8a-b11d781a88ad",
                                "text": "„Das langsam wärmer werdende Klima lockte immer mehr Indianer aus der Prärie in den Norden, wo sie sich hauptsächlich in den wildreichen Waldgebieten aufhielten, feste Jagdgewohnheiten entwickelten und Ansiedlungen gründeten.“"
                            },
                            {
                                "example_id": "7260e7b4-e514-4a96-80eb-d5af28323d0a",
                                "sense_id": "28112dc1-4692-36a0-bd8a-b11d781a88ad",
                                "text": "„Die ersten Pferdezuchten der Prärie bauten Apachen und Jumano im Süden und Südwesten auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
