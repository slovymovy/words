                {
                    "sense_id": "c356c59b-975d-3edd-a98d-026b70216b0b",
                    "sense_definition": "Avoir une réalité objective ou conceptuelle, être réel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certains enfants se demandent si les monstres <w>existent</w> réellement dans notre monde."
                        },
                        {
                            "text": "Cette ancienne institution a cessé d'<w>exister</w> après la décision du gouvernement."
                        }
                    ],
                    "synonyms": [
                        "être"
                    ],
                    "common_phrases": [
                        "cesser d'exister"
                    ]
                },
                {
                    "sense_id": "c8bbe943-376d-3302-83ec-3955d5c3310a",
                    "sense_definition": "Se trouver, être présent ou disponible à un endroit déterminé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>existe</w> plusieurs solutions simples pour résoudre efficacement ce problème technique."
                        },
                        {
                            "text": "Il n'<w>existe</w> aucun doute sérieux sur l'honnêteté de ce témoin."
                        }
                    ],
                    "common_phrases": [
