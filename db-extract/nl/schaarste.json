                    }
                ],
                "translations": [
                    {
                        "translation_id": "6624e6ba-e186-4abe-b536-8ddf99866fa5",
                        "source_entry_id": "3ab46ac4-5206-375d-9506-da1822663626",
                        "source_sense_id": "f25bf15e-86e5-3882-a13b-c0c74148b082",
                        "source_sense_description": "eerste betekenisomschrijving",
                        "target_lang_word": "Mangel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mangel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f33ae8e-aa09-379b-a6ff-e5f7dd4e09cf",
                                        "entry_id": "d92891a9-035e-3324-8d88-0e9725f57bba",
                                        "glosses": [
                                            "unzureichende Menge oder unzureichendes Ausmaß von etwas"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e6390da-6172-4bfb-a9c5-efde05b3bd73",
                                                "sense_id": "1f33ae8e-aa09-379b-a6ff-e5f7dd4e09cf",
                                                "text": "Aus Mangel an Geld konnte er sich das nicht leisten."
                                            },
                                            {
                                                "example_id": "56006631-8249-44fb-be2d-3fde7202202f",
                                                "sense_id": "1f33ae8e-aa09-379b-a6ff-e5f7dd4e09cf",
                                                "text": "„Die meisten Witze über die wirtschaftliche Situation in der DDR suchten die im täglichen Leben empfundenen Mängel zu beschreiben und mit Witz zu verarbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab2eb16d-b84f-3ead-bc39-28510b64157e",
                                        "entry_id": "d92891a9-035e-3324-8d88-0e9725f57bba",
                                        "glosses": [
                                            "Fehler, Unvollkommenheit bei einer Sache"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91acb638-61cb-4027-9272-e4b9a8c07109",
                                                "sense_id": "ab2eb16d-b84f-3ead-bc39-28510b64157e",
                                                "text": "Das Fernsehgerät hatte mehrere Mängel und musste zur Reparatur."
                                            },
                                            {
                                                "example_id": "0c7771ae-fae6-4f90-aeb1-c037a45b751d",
                                                "sense_id": "ab2eb16d-b84f-3ead-bc39-28510b64157e",
                                                "text": "„Das Heimspiel des Fußball-Zweitligisten VfL Osnabrück gegen Schalke 04 am Samstag droht wegen baulicher Mängel an der Dachkonstruktion des Stadions auszufallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9f00236b-1373-32bd-b37f-aa233b9c161b",
                                        "entry_id": "d92891a9-035e-3324-8d88-0e9725f57bba",
                                        "glosses": [
                                            "Fehler beziehungsweise das Fehlen von zugesicherten Eigenschaften einer Sache oder eines Rechts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1a5c5d3-6de2-4460-8468-b05f15edc029",
                                                "sense_id": "9f00236b-1373-32bd-b37f-aa233b9c161b",
                                                "text": "Das Gerät war von Werk aus defekt, und der Mangel wurde endlich vom Gericht anerkannt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mangel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97b2f811-b0ee-3fd3-a7f4-abdf14518ea4",
                                        "entry_id": "5e96a814-7fc5-381d-a05c-b9a785aa4eb6",
                                        "glosses": [
                                            "Gerät mit zwei oder mehr Rollen zum Flachwalzen von etwas, zum Auswringen nasser Wäsche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7034f420-8dbe-4ab9-8c89-b43608e7f566",
                                                "sense_id": "97b2f811-b0ee-3fd3-a7f4-abdf14518ea4",
                                                "text": "Nachdem die Wäsche gewaschen wurde, wurde diese in der Mangel ausgewrungen und zum Trocknen aufgehängt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc98625d-9022-3d70-8416-64fc4a79b60d",
                                        "entry_id": "5e96a814-7fc5-381d-a05c-b9a785aa4eb6",
                                        "glosses": [
                                            "Maschine mit einer Rolle und einer Anpressmulde zum thermischen Glätten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e100a31-769d-496a-831e-6446be6b5c34",
                                                "sense_id": "dc98625d-9022-3d70-8416-64fc4a79b60d",
                                                "text": "Sie hatten keine eigene Mangel und mussten ihre Bettwäsche in der Reinigung mangeln lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2a28103-0486-4cf8-9bdd-c8f937c20587",
                        "source_entry_id": "3ab46ac4-5206-375d-9506-da1822663626",
                        "source_sense_id": "f25bf15e-86e5-3882-a13b-c0c74148b082",
                        "source_sense_description": "eerste betekenisomschrijving",
                        "target_lang_word": "scarcity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scarcity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "988c8b0d-71eb-30b1-9ab4-5006bdb76195",
                                        "entry_id": "900ff5df-9147-34b1-b27f-59cdd317069e",
                                        "glosses": [
                                            "The condition of something being scarce or deficient."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3982c30e-ddb3-49cc-a866-6c375b992c35",
                                                "sense_id": "988c8b0d-71eb-30b1-9ab4-5006bdb76195",
                                                "text": "Praise […] owes its value only to its scarcity."
                                            },
                                            {
                                                "example_id": "d9f25d97-5756-4df5-8213-7724dff56ed0",
                                                "sense_id": "988c8b0d-71eb-30b1-9ab4-5006bdb76195",
                                                "text": "To understand the events of the next fifty years, then, one must understand environmental scarcity, cultural and racial clash, geographic destiny, and the transformation of war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fab8938d-493d-337f-9e70-80d44f557411",
                                        "entry_id": "900ff5df-9147-34b1-b27f-59cdd317069e",
                                        "glosses": [
                                            "An inadequate amount of something; a shortage."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95f7d80c-c3be-465a-a869-cec0b0b50576",
                                                "sense_id": "fab8938d-493d-337f-9e70-80d44f557411",
                                                "text": "a scarcity of grain"
                                            },
                                            {
                                                "example_id": "8ebad11f-bd79-402b-9cf5-a0a8cbbac891",
                                                "sense_id": "fab8938d-493d-337f-9e70-80d44f557411",
                                                "text": "The crucial and intersecting challenges of scarcities, both emerging and intensifying, will consume China’s custodians over the next decade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86b11772-3036-4fbc-a5c8-1a55341d6e94",
                        "source_entry_id": "3ab46ac4-5206-375d-9506-da1822663626",
                        "source_sense_id": "f25bf15e-86e5-3882-a13b-c0c74148b082",
                        "source_sense_description": "eerste betekenisomschrijving",
                        "target_lang_word": "disette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b75556a-e8cb-30f2-80bd-287038a77c30",
                                        "entry_id": "66fd4dd7-780b-36b6-879a-4b3d850bb1c2",
                                        "glosses": [
                                            "Manque de certaines choses utiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1648572d-61b3-4a92-8af3-4ebf405152fe",
                                                "sense_id": "1b75556a-e8cb-30f2-80bd-287038a77c30",
                                                "text": "La destruction de ces forêts est un grand mal pour le pays, non seulement à cause de la disette des combustibles, mais à cause de celle des pâturages."
                                            },
                                            {
                                                "example_id": "e44f6355-2d9f-413e-86ac-43de624a65fd",
                                                "sense_id": "1b75556a-e8cb-30f2-80bd-287038a77c30",
                                                "text": "Or les objets qu'ils voudraient acheter sont plus chers que les produits qu'ils vendent. Et ils sont en quantité insuffisante. Par exemple, il y a souvent disette d'étoffes de laine et de coton."
                                            },
                                            {
                                                "example_id": "37c54432-bd3d-410c-934b-413a942fe1e5",
                                                "sense_id": "1b75556a-e8cb-30f2-80bd-287038a77c30",
                                                "text": "Même dans ses jours de disette, quand la tante lui refusait de l’argent pour acheter des journaux à images, il arrivait à mon oncle de colorier des livres."
                                            },
                                            {
                                                "example_id": "c4be0939-2e22-40d5-aaad-7bc1a1cc27ee",
                                                "sense_id": "1b75556a-e8cb-30f2-80bd-287038a77c30",
                                                "text": "Nous souffrons d’une disette d’hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59431681-1c19-36d3-aec2-bb412e7afadc",
                                        "entry_id": "66fd4dd7-780b-36b6-879a-4b3d850bb1c2",
                                        "glosses": [
                                            "Manque des choses nécessaires à l’alimentation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2392d3e1-bfd9-4615-ab22-531c9067546e",
                                                "sense_id": "59431681-1c19-36d3-aec2-bb412e7afadc",
                                                "text": "Dans tout pays où la nature fournit avec prodigalité aux besoins des hommes, la disette ne peut être imputée qu’aux vices de l’administration ou des lois elles-mêmes; …."
                                            },
                                            {
                                                "example_id": "f30cfa46-c6cc-4f7f-8641-42a5aec15780",
                                                "sense_id": "59431681-1c19-36d3-aec2-bb412e7afadc",
                                                "text": "Il fallait faire marcher en hâte une armée que la disette affaiblissait, et dont l’arriere-garde pouvoit être accablée par l’armée française."
                                            },
                                            {
                                                "example_id": "a7087696-c888-4c15-86ad-3c608966378d",
                                                "sense_id": "59431681-1c19-36d3-aec2-bb412e7afadc",
                                                "text": "On n’a pas suffisamment compris, semble-t-il, que le prix du blé en temps de disette dépend beaucoup moins de sa rareté que de l’obstination que chacun met à vouloir en consommer autant que d’habitude."
                                            },
                                            {
                                                "example_id": "3e479c09-1675-429b-88f1-40c76773b15c",
                                                "sense_id": "59431681-1c19-36d3-aec2-bb412e7afadc",
                                                "text": "Turgot échoua […] ; en décrétant la liberté absolue du commerce des grains, il excita une inquiétude générale, suivie presqu’aussitôt d’une disette réelle ou factice. Il y eut dans plusieurs provinces des émeutes pour le pain, et à Paris les magasins de blé et les boutiques des boulangers furent pillés."
                                            },
                                            {
                                                "example_id": "6fe2886f-0e2d-485a-a3ab-653a7ef699bf",
                                                "sense_id": "59431681-1c19-36d3-aec2-bb412e7afadc",
                                                "text": "Même dans ses jours de disette, quand la tante lui refusait de l’argent pour acheter des journaux à images, il arrivait à mon oncle de colorier des livres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a6be6a1-075c-3374-a0cf-92c7bea2c664",
                                        "entry_id": "55ae182c-e80e-35ab-ab14-8387350beb74",
                                        "glosses": [
                                            "Variété ancienne de betterave. [note : ce mot s'emploie encore en, Bourgogne et en Lorraine dans le sens de betterave fourragère]  ^([1])"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b21e04-5a62-4a9b-a7f8-68a4e366a653",
                                                "sense_id": "2a6be6a1-075c-3374-a0cf-92c7bea2c664",
                                                "text": "Si la racine de disette étoit une betterave, les cultivateurs sémeroient-ils si distinctement l'une & l'autre ?"
                                            },
                                            {
                                                "example_id": "0efa1216-042c-4154-a492-5f3f23d83bb6",
                                                "sense_id": "2a6be6a1-075c-3374-a0cf-92c7bea2c664",
                                                "text": "Des expériences directes faites par M. Vialat de Castelnaudary (Aude), lui ont prouvé que la disette, ou betterave champêtre, peut donner p.100 au moins deux livres de sucre brut."
                                            },
                                            {
                                                "example_id": "d2748314-c97a-4aa7-9071-6c5967a4ec4a",
                                                "sense_id": "2a6be6a1-075c-3374-a0cf-92c7bea2c664",
                                                "text": "La betterave est une plante originaire du midi de l'Europe, dont il existe un grand nombre d'espèces. L'espèce la plus anciennement connue est la disette, qui est cultivée pour la nourriture des bestiaux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0acf7827-b308-3f7d-905c-bb155da3950f",
                                        "entry_id": "b62f7893-9f12-31de-b091-d75f71f717da",
                                        "glosses": [
                                            "Commérage, ragot (dans le Berry)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07d13b04-9d81-430a-9ab2-4345ad36c72d",
                                                "sense_id": "0acf7827-b308-3f7d-905c-bb155da3950f",
                                                "text": "Ses desseins à l’égard de cette enfant, qu’il décrassait, instruisait et formait avec des soins d’autant plus touchants qu’on le croyait incapable de tendresse, furent diversement interprétés par la caqueteuse bourgeoisie de la ville, dont les disettes accréditaient, comme à propos de la naissance de Max et d’Agathe, de fatales erreurs."
                                            },
                                            {
                                                "example_id": "c3913a58-a24c-49f7-876c-9b3108ef2ff9",
                                                "sense_id": "0acf7827-b308-3f7d-905c-bb155da3950f",
                                                "text": "Animée par ses disettes, la ville d’Issoudun pressentait un combat entre ces personnages qui, remarquez-le, se méprisaient mutuellement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe9c321a-8bb5-43cb-bf5c-bb1853ea2ea3",
