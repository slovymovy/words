                ],
                "senses": [
                    {
                        "sense_id": "391a4908-10f5-3d89-9f40-705931e810c1",
                        "entry_id": "ae78818a-f00d-37d4-9636-f0e8b2a6b8c4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7040b7e3-1c48-44ed-b284-bd8d0bd86691",
                                "sense_id": "391a4908-10f5-3d89-9f40-705931e810c1",
                                "text": "Frau Schaidle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9fa6996f-b4b7-4505-9736-0a3336051bf0",
                                "sense_id": "391a4908-10f5-3d89-9f40-705931e810c1",
                                "text": "Herr Schaidle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0cedc1de-d985-4924-8496-765b938c958c",
                                "sense_id": "391a4908-10f5-3d89-9f40-705931e810c1",
                                "text": "Die Schaidles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a208f00f-7bb1-4382-af2e-464fbdd2387d",
                                "sense_id": "391a4908-10f5-3d89-9f40-705931e810c1",
                                "text": "Der Schaidle trägt nie die Pullover, die die Schaidle ihm strickt."
                            },
                            {
                                "example_id": "fda55c33-3f44-452e-bf71-fbfcbd297970",
                                "sense_id": "391a4908-10f5-3d89-9f40-705931e810c1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schaidle kommt, geht der Herr Schaidle.“"
                            },
                            {
                                "example_id": "b739c1fa-26b2-438e-88be-91980474d462",
                                "sense_id": "391a4908-10f5-3d89-9f40-705931e810c1",
                                "text": "Schaidle kommt und geht."
                            },
                            {
                                "example_id": "fd951553-1cbe-46b1-b013-90ebe8c62f43",
                                "sense_id": "391a4908-10f5-3d89-9f40-705931e810c1",
                                "text": "Schaidles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
