                ],
                "senses": [
                    {
                        "sense_id": "7a945e0d-8f8b-34b8-b091-43c44b55d9da",
                        "entry_id": "a74f4bb6-6bb1-3a7f-8e95-84c5b91cd2f2",
                        "glosses": [
                            "Sekt, schäumender Wein"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "22e679e5-6745-4785-ad13-a54117b8a553",
                                "sense_id": "7a945e0d-8f8b-34b8-b091-43c44b55d9da",
                                "text": "Ist es egal, ob man Prosecco als Puffbrause oder Schlüpferstürmer bezeichnet? Antwort: Im Prinzip ja."
                            },
                            {
                                "example_id": "c4242cfa-5a86-4f0e-996c-8f8ac3be2e0d",
                                "sense_id": "7a945e0d-8f8b-34b8-b091-43c44b55d9da",
                                "text": "„Habt ihr denn auch einen kleinen Stimmungsaufheller für uns oder müssen uns Andy und ich die Restpfütze von eurer süßen Puffbrause teilen?“"
                            },
                            {
                                "example_id": "1c5aebde-d2dc-4d06-8431-e5b8e5413659",
                                "sense_id": "7a945e0d-8f8b-34b8-b091-43c44b55d9da",
                                "text": "Gibt es hier eigentlich Kölsch? Diese Puffbrause ist eigentlich nicht so mein Ding."
                            },
                            {
                                "example_id": "708ba6cd-5015-46ec-ad26-3f97fdc9a8e0",
                                "sense_id": "7a945e0d-8f8b-34b8-b091-43c44b55d9da",
                                "text": "Nicht nur die Puffbrause, die es immer wieder von den Gästen gab und die ich schon nach kurzer Zeit nur noch Pissbrause nannte, weil sie mich immer wieder auf die Keramik zwang."
                            },
                            {
                                "example_id": "67353154-0c33-4b44-bd43-05110da05e5a",
                                "sense_id": "7a945e0d-8f8b-34b8-b091-43c44b55d9da",
                                "text": "Er hatte bislang nur Kommilitoninnen gekannt, die ausschließlich Sekt oder Champagner tranken, im misogynen Männerjargon herablassend ‚Puffbrause' genannt oder die allenfalls an Cocktails Gefallen fanden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
