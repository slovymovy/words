                "senses": [
                    {
                        "sense_id": "ef2ad9e0-60d8-368f-93d6-f71747bf92d9",
                        "entry_id": "5ce5299d-9ab6-3108-b8f6-59f6b359b6ff",
                        "glosses": [
                            "Ziel der Idee, etwas zu öffnen, wiederzueröffnen; der Weg hin zu einer vollständigen Aufhebung von Einschränkungen der Kontakt- oder Nutzungsmöglichkeiten"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "2e57a463-5611-4724-b8f6-a9d187a61b7e",
                                "sense_id": "ef2ad9e0-60d8-368f-93d6-f71747bf92d9",
                                "text": "„Dass sich die Volksrepublik China als Veranstalter der Vierten Weltfrauenkonferenz von 1995 anbot, ist ein herausragendes Beispiel dieser Öffnungsstrategie.“"
                            },
                            {
                                "example_id": "61d057ef-72df-4cb2-8668-db90b2ae07cf",
                                "sense_id": "ef2ad9e0-60d8-368f-93d6-f71747bf92d9",
                                "text": "„Er fragt danach, ob eine an den Menschenrechten ausgerichtete interkulturelle Öffnungsstrategie und der damit verbundenen Personalqualifizierung nicht wesentlich fundierter und einwanderungsgerechter wäre.“"
                            },
                            {
                                "example_id": "3fb89a8e-5ade-467e-869b-8f7d11a1b1a0",
                                "sense_id": "ef2ad9e0-60d8-368f-93d6-f71747bf92d9",
                                "text": "„Am Montag, 18. Mai 2020, um 11:30 Uhr, informieren Gesundheitsminister Rudi Anschober und ExpertInnen [sic] des Beraterstabs der Coronavirus-Taskforce über Pro und Contra zur Öffnungsstrategie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
