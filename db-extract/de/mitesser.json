                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff32fa50-e7e6-4f50-a87e-1b9c0f1cb803",
                                                "sense_id": "9e6da720-4980-3945-aa9a-a6beb13748b8",
                                                "text": "See there! A son is born\nAnd we pronounce him fit to fight\nThere are blackheads on his shoulders\nAnd he pees himself in the night."
                                            },
                                            {
                                                "example_id": "d4a6de31-4d68-4a39-a077-b700d4a32c9b",
                                                "sense_id": "9e6da720-4980-3945-aa9a-a6beb13748b8",
                                                "text": "Wallace sees a cluster of tiny blackheads at the corner of his nose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8318a711-19b7-365b-913c-31fe935041a2",
                                        "entry_id": "6807d65e-e593-3eaa-8d95-118553cba705",
                                        "glosses": [
                                            "A form of histomoniasis in poultry, characterized by cyanotic discoloration on the bird's head."
