                "senses": [
                    {
                        "sense_id": "83a1c0dd-3769-3fc0-8062-24d584946611",
                        "entry_id": "ce9a3b1e-e5ec-33e4-9e09-6dced160c6ba",
                        "glosses": [
                            "Schrank, in dem Geschirr aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c404dac-3e5e-4975-9978-02e101783a0d",
                                "sense_id": "83a1c0dd-3769-3fc0-8062-24d584946611",
                                "text": "„Denn meistens kann man sich arrangieren, was Möbel, Lampen und Konsorten angeht, wildes Tohuwabohu im Geschirrschrank kann aber keine Frau ertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36109d75-2486-4a83-8819-473b2af0c1d1",
                        "source_entry_id": "ce9a3b1e-e5ec-33e4-9e09-6dced160c6ba",
                        "source_sense_id": "83a1c0dd-3769-3fc0-8062-24d584946611",
                        "source_sense_description": "Schrank, in dem Geschirr aufbewahrt wird",
                        "target_lang_word": "buffet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buffet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37932c08-6598-3876-8a9d-dc2dc0640836",
                                        "entry_id": "b8dbd343-05bf-3c69-92bd-07b75ba69aa4",
                                        "glosses": [
                                            "A counter or sideboard from which food and drinks are served or may be bought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "856ffc74-aa8c-45c6-add7-3899a3ed09cc",
                                                "sense_id": "37932c08-6598-3876-8a9d-dc2dc0640836",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98efe00c-d0d1-3fa8-adac-9be275050dc8",
                                        "entry_id": "b8dbd343-05bf-3c69-92bd-07b75ba69aa4",
                                        "glosses": [
                                            "Food laid out in this way, to which diners serve themselves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d469ccc-e0b4-4dcf-93f6-71e5a3190fe2",
                                                "sense_id": "98efe00c-d0d1-3fa8-adac-9be275050dc8",
                                                "text": "We'll be serving supper buffet style."
                                            },
                                            {
                                                "example_id": "3cf5ce83-af27-4303-acce-50a06a0aefc2",
                                                "sense_id": "98efe00c-d0d1-3fa8-adac-9be275050dc8",
                                                "text": "\"We got a big buffet coming up soon. Bacon, eggs, fresh fruit you wouldn't believe.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5861591b-0a72-3621-b482-034a5d230368",
                                        "entry_id": "b8dbd343-05bf-3c69-92bd-07b75ba69aa4",
                                        "glosses": [
                                            "A small low stool; a hassock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "buffet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03aae59f-d211-3c6f-9b1d-aa828d04cf1c",
                                        "entry_id": "dbb4483c-8e8f-39eb-8442-de4e2c93bfcb",
                                        "glosses": [
                                            "A blow or cuff with or as if with the hand, or by any other solid object or the wind."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c6db8a-d380-4d89-9071-46a6ecc4bb6d",
                                                "sense_id": "03aae59f-d211-3c6f-9b1d-aa828d04cf1c",
                                                "text": "On his cheek a buffet fell."
                                            },
                                            {
                                                "example_id": "5d888391-4c05-4b9d-8370-08f8d47b3751",
                                                "sense_id": "03aae59f-d211-3c6f-9b1d-aa828d04cf1c",
                                                "text": "October 30, 1795, Edmund Burke, letter to Lord Auckland\nthose planks of tough and hardy oak that used for years to brave the buffets of the Bay of Biscay"
                                            },
                                            {
                                                "example_id": "c2174529-eff0-4782-8fb0-4dda721f61ba",
                                                "sense_id": "03aae59f-d211-3c6f-9b1d-aa828d04cf1c",
                                                "text": "Kipper stood blinking, as I had sometimes seen him do at the boxing tourneys in which he indulged when in receipt of a shrewd buffet on some tender spot like the tip of the nose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b05e1d-e9d3-3eae-a805-18eddd2d82c9",
                                        "entry_id": "dbb4483c-8e8f-39eb-8442-de4e2c93bfcb",
                                        "glosses": [
                                            "The vibration of an aircraft when flying in or approaching a stall, caused by separation of airflow from the aircraft's wings."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bac5ee9-264e-4485-8e70-6a71201cc588",
                                                "sense_id": "d5b05e1d-e9d3-3eae-a805-18eddd2d82c9",
                                                "text": "The aircraft configuration was such that there was little or no warning of the stall onset. The inboard slats were extended, and therefore, the flow separation from the stall would be limited to the outboard segment of the left wing and would not be felt by the left horizontal stabilizer. There would be little or no buffet. The DFDR also indicated that there was some turbulence, which could have masked any aerodynamic buffeting. Since the roll to the left began at V₂ + 6 and since the pilots were aware that V₂ was well above the aircraft's stall speed, they probably did not suspect that the roll to the left indicated a stall. In fact, the roll probably confused them, especially since the stickshaker had not activated."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "buffet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e63f99-eb7c-3d37-95aa-83eab0592fe2",
                                        "entry_id": "aa7a0971-1b48-3834-bf4d-002f1dff0098",
                                        "glosses": [
                                            "To strike with a buffet; to cuff; to slap."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad560f3b-6977-487a-9aa8-2ecbbaf7ef22",
                                                "sense_id": "e4e63f99-eb7c-3d37-95aa-83eab0592fe2",
                                                "text": "They spit in his face and buffeted him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bb5744f-b692-3544-956a-b769bee15a34",
                                        "entry_id": "aa7a0971-1b48-3834-bf4d-002f1dff0098",
                                        "glosses": [
                                            "To aggressively challenge, denounce, or criticise."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e5c143f-8506-47e7-833b-1b54b9e5e4dc",
                                                "sense_id": "3bb5744f-b692-3544-956a-b769bee15a34",
                                                "text": "Is Burns obscure because he was gay and therefore ignorable until the Gay Rights Movement began? Or does he largely deserve his neglect? An answer requires that one examine not only Burns' books, but also the critical environment in which he was much buffeted — which, we are told, drove him to an early grave."
                                            },
                                            {
                                                "example_id": "17b1311f-6203-49c7-bbc8-85b98cac341b",
                                                "sense_id": "3bb5744f-b692-3544-956a-b769bee15a34",
                                                "text": "Buffeted by criticism of his policy on Europe, battered by rebellion in the ranks over his bill to legalize same-sex marriage and wounded by the perception that he is supercilious, contemptuous and out of touch with mainstream Conservatism, Mr. Cameron earlier this week took the highly unusual step of sending a mass e-mail (or, as he called it, “a personal note”) to his party’s grass-roots members."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb0e9eea-11a8-3b9b-a1a0-bcb2cb51ed0f",
                                        "entry_id": "aa7a0971-1b48-3834-bf4d-002f1dff0098",
                                        "glosses": [
                                            "To affect as with blows; to strike repeatedly; to strive with or contend against."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "482d029c-9721-4bb1-bcf4-dd6c085150b9",
                                                "sense_id": "cb0e9eea-11a8-3b9b-a1a0-bcb2cb51ed0f",
                                                "text": "to buffet the billows"
                                            },
                                            {
                                                "example_id": "ab0d2074-1a20-4dda-b3cc-99220fb89d2c",
                                                "sense_id": "cb0e9eea-11a8-3b9b-a1a0-bcb2cb51ed0f",
                                                "text": "The sudden hurricane in thunder roars, / Buffets the bark, and whirls it from the shores."
                                            },
                                            {
                                                "example_id": "a3823b89-80af-4ea7-9efb-7850e1dee782",
                                                "sense_id": "cb0e9eea-11a8-3b9b-a1a0-bcb2cb51ed0f",
                                                "text": "[...] I buffetted heat and mosquetoes, and got the hay all up [...]"
                                            },
                                            {
                                                "example_id": "0942a342-f514-44e4-b9a8-5818acd2d656",
                                                "sense_id": "cb0e9eea-11a8-3b9b-a1a0-bcb2cb51ed0f",
                                                "text": "You are lucky fellows who can live in a dreamland of your own, instead of being buffeted about the world—"
                                            },
                                            {
                                                "example_id": "902efc8b-2721-421d-9ca1-40ab722d5318",
                                                "sense_id": "cb0e9eea-11a8-3b9b-a1a0-bcb2cb51ed0f",
                                                "text": "Atlantic gales constantly buffet Morwenstow, whose seven hamlets together constitute Cornwall's most northerly parish. The village is dotted with trees moulded into weird shapes by the wind, and above the trees rise the vicarage chimneystacks resembling miniature church towers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f06e89-af36-3842-8f2b-3411b13dbe64",
                                        "entry_id": "aa7a0971-1b48-3834-bf4d-002f1dff0098",
                                        "glosses": [
                                            "To deaden the sound of (bells) by muffling the clapper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7204480c-32ae-3bbb-a17e-fe91acf4f446",
                                        "entry_id": "aa7a0971-1b48-3834-bf4d-002f1dff0098",
                                        "glosses": [
                                            "To struggle, contend; also in figurative or extended use: to move as if driven by force."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69990262-fc18-46d3-b76e-668a213a64de",
                                                "sense_id": "7204480c-32ae-3bbb-a17e-fe91acf4f446",
                                                "text": "Again the chirpy tone did nothing to pacify the woman holding on to her ankles. Soon Zoe was buffeting back and forward through the hole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a07077cd-bd5e-4768-a4c8-4de731232c1b",
                        "source_entry_id": "ce9a3b1e-e5ec-33e4-9e09-6dced160c6ba",
                        "source_sense_id": "83a1c0dd-3769-3fc0-8062-24d584946611",
                        "source_sense_description": "Schrank, in dem Geschirr aufbewahrt wird",
                        "target_lang_word": "buffet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buffet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d408d97b-fc0c-3b8a-be08-51f092a5e7a9",
                                        "entry_id": "44c16865-5510-3616-953a-47d3a42d97c0",
                                        "glosses": [
                                            "Meuble massif composé de tiroirs, placards et étagères, qui sert à entreposer l’argenterie, la vaisselle ou le linge de table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "069f8f7c-0c1d-4208-b41f-986da18d66a4",
                                                "sense_id": "d408d97b-fc0c-3b8a-be08-51f092a5e7a9",
                                                "text": "Sur le buffet, rien qu’une chaîne hi-fi et un flacon d’ambre solaire entamé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4163d992-d7d6-302c-bf03-7fb0a8f2545a",
                                        "entry_id": "44c16865-5510-3616-953a-47d3a42d97c0",
                                        "glosses": [
                                            "Table où sont proposés des plats en libre-service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fdc9c53-64d9-4fa6-93ec-0e996262eea3",
                                                "sense_id": "4163d992-d7d6-302c-bf03-7fb0a8f2545a",
                                                "text": "Il n’y avait pas de souper à ce bal, mais il y avait un buffet très bien garni."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f32bbb6a-4bf2-330d-8f7d-89c08c2a7921",
                                        "entry_id": "44c16865-5510-3616-953a-47d3a42d97c0",
                                        "glosses": [
                                            "Réception où les convives se servent eux-mêmes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "155c59fa-1e96-4c00-b590-bd6e1da999e9",
                                                "sense_id": "f32bbb6a-4bf2-330d-8f7d-89c08c2a7921",
                                                "text": "J’organise un buffet campagnard le week-end prochain"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3105126d-460b-3490-bb07-15ee765a8d33",
                                        "entry_id": "44c16865-5510-3616-953a-47d3a42d97c0",
                                        "glosses": [
                                            "Ensemble d'idées ou de concepts hétéroclites parmi lesquels tout intéressé pourra choisir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49aaa330-092e-4ced-98b6-0cab4b31512e",
                                                "sense_id": "3105126d-460b-3490-bb07-15ee765a8d33",
                                                "text": "… la culture québécoise, oui, mais une parmi d'autres sans statut particulier au buffet des identités culturelles au Québec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac1728da-29d6-3f9b-b2aa-8564da290a0f",
                                        "entry_id": "44c16865-5510-3616-953a-47d3a42d97c0",
                                        "glosses": [
                                            "Snack, bar restaurant installé dans les gares de chemins de fer où les voyageurs trouvent soit un repas préparé, soit des provisions à emporter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8752169e-2b62-47dc-8d25-a87e9890aaf9",
                                                "sense_id": "ac1728da-29d6-3f9b-b2aa-8564da290a0f",
                                                "text": "Ce train n’a pas de wagon-restaurant ; et nous dînons (mal) dans un buffet enrichi de stucs multissimicolores, dont le Palladio se fût attristé sans doute, ou diverti."
                                            },
                                            {
                                                "example_id": "1c7fd793-5ab9-4939-b5ad-e56e6e50d2ed",
                                                "sense_id": "ac1728da-29d6-3f9b-b2aa-8564da290a0f",
                                                "text": "En débarquant à Toulouse, je me trouvais devant la gare assez hésitant. Une canette au buffet et me voici quand même déambulant à travers les rues."
                                            },
                                            {
                                                "example_id": "67377103-b8d6-418f-b1c9-5472fbb2f7c7",
                                                "sense_id": "ac1728da-29d6-3f9b-b2aa-8564da290a0f",
                                                "text": "En Suède, chaque station [de chemin de fer] contient un buffet, et un Suédois ne saurait passer devant un buffet sans en franchir le seuil, dût-il intercaler un dîner et un souper entre une demi-douzaine de déjeuners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f75ee3d5-d910-36ec-8891-39b262e602df",
                                        "entry_id": "44c16865-5510-3616-953a-47d3a42d97c0",
                                        "glosses": [
                                            "Menuiserie où sont renfermées les orgues ou un jeu d’orgue en particulier. Ou petit orgue tout entier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90ae37ab-08c1-4e7f-a32a-33a708193176",
                                                "sense_id": "f75ee3d5-d910-36ec-8891-39b262e602df",
                                                "text": "Il y a quelque chose à refaire au buffet de cet orgue."
                                            },
                                            {
                                                "example_id": "2bd13a86-1634-4476-b321-e326334f748d",
                                                "sense_id": "f75ee3d5-d910-36ec-8891-39b262e602df",
                                                "text": "Le buffet du grand jeu est très ancien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "540ddcd5-283b-3bb5-ab54-11109c65a23a",
                                        "entry_id": "44c16865-5510-3616-953a-47d3a42d97c0",
                                        "glosses": [
                                            "Table de pierre ou de marbre qui supporte plusieurs bassins en gradins où l’eau descend en nappes, en cascades, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1783237-37c6-3b03-a5a6-06bb524fc620",
                                        "entry_id": "44c16865-5510-3616-953a-47d3a42d97c0",
                                        "glosses": [
                                            "Ventre, torse."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7f51525-cdea-418e-842d-eeaa1b94f576",
                                                "sense_id": "f1783237-37c6-3b03-a5a6-06bb524fc620",
                                                "text": "Et estimez-vous heureux d’être pas considéré comme déserteur ! Là, ça serait le peloton tout de suite. Douze balles dans le buffet ! Ça vous aurait dressé, bon Dieu !"
                                            },
                                            {
                                                "example_id": "e1f2e3d6-3667-4104-b7e4-f6c6966fe1f6",
                                                "sense_id": "f1783237-37c6-3b03-a5a6-06bb524fc620",
                                                "text": "Le temps de réaliser, Pradelle était sur lui, un coup d’épaule dans le buffet et le soldat a chuté dans un trou d’obus et roulé jusqu’au fond."
                                            },
                                            {
                                                "example_id": "674fe038-4e3c-4444-975d-09e8d8330378",
                                                "sense_id": "f1783237-37c6-3b03-a5a6-06bb524fc620",
                                                "text": "– Un peu de tenue, pédé, ou c’est moi qui t’arrache la jugulaire d’un coup de dents avant que ces sous-merdes t’envoient une balle dans le buffet ! grogna-t-il avec rage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "buffet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0da3586c-8657-3d85-b72a-a94a4c272df5",
                                        "entry_id": "00e84dc5-c270-324a-b3ad-26be74eebc2b",
                                        "glosses": [
                                            "Partie du casque qui protège les joues."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d86b83c3-6237-4eff-938a-b7ce9b66e5a8",
                        "source_entry_id": "ce9a3b1e-e5ec-33e4-9e09-6dced160c6ba",
