                        "entry_id": "a01c3980-7776-3c3a-a9db-b17db50f80cb",
                        "glosses": [
                            "Ce qu'on tient de ses chefs, de ses pères."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3d8c0f22-082b-4e16-948c-0ffd112632ba",
                                "sense_id": "4f270f70-46f4-31be-bfdb-0cfcdfb7c7e0",
                                "text": "Et rendre sa chevance à lui-même sacrée."
                            }
                        ]
                    },
                    {
                        "sense_id": "e91f2378-73b2-3b1e-98ee-662e35ff84ed",
                        "entry_id": "a01c3980-7776-3c3a-a9db-b17db50f80cb",
                        "glosses": [
                            "Le bien qu’on a."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "83eab1eb-7419-49aa-9015-0e9149df5017",
                                "sense_id": "e91f2378-73b2-3b1e-98ee-662e35ff84ed",
                                "text": "[…] riche de toutes sortes de biens, redondante de grâce, de chevance et de joie de vivre."
                            },
                            {
                                "example_id": "b27a829c-986a-4c2b-9d8b-d12854b8c253",
                                "sense_id": "e91f2378-73b2-3b1e-98ee-662e35ff84ed",
                                "text": "Excursion par un bateau-omnibus à l’île Fænoe, à l’embouchure du fiord. Parcouru le nord de cette île, chevance magnifique d’un seul personnage."
                            },
                            {
                                "example_id": "17ea39e5-e421-4f3d-86c1-9e6ad2322f28",
                                "sense_id": "e91f2378-73b2-3b1e-98ee-662e35ff84ed",
                                "text": "Que de chevance il me faudra dépenser pour payer rançon !"
                            },
                            {
                                "example_id": "dcc1c2f2-35d2-4063-8abb-084f4d6084f8",
                                "sense_id": "e91f2378-73b2-3b1e-98ee-662e35ff84ed",
                                "text": "Des miens le mendre, je dis voir, / De me désavouer s'avance, / Oubliant naturel devoir / Par faute d'un peu de chevance."
                            },
                            {
                                "example_id": "ddf8c3ca-668e-46f1-b9c6-4e2a65854892",
                                "sense_id": "e91f2378-73b2-3b1e-98ee-662e35ff84ed",
                                "text": "Madeleine avait son grenier à elle, où je voulus voir serrer sa brune chevance, en partageant sa joie."
                            }
                        ]
                    }
