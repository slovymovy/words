                        ],
                        "form": "carks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "01bc3310-957c-3e53-96c7-ac09597c93f7",
                        "entry_id": "a44e2f90-eca8-3093-9640-28feeff4e257",
                        "glosses": [
                            "A noxious or corroding worry."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7e03360e-c5e9-4c9c-b644-9eef7b557c55",
                                "sense_id": "01bc3310-957c-3e53-96c7-ac09597c93f7",
                                "text": "His heauie head, deuoide of carefull carke, / Whose sences all were straight benumbd and starke."
                            },
                            {
                                "example_id": "1a7c3185-56cf-4078-abb6-57d621ec4eb8",
                                "sense_id": "01bc3310-957c-3e53-96c7-ac09597c93f7",
                                "text": "Fling cark and care aside."
                            },
                            {
                                "example_id": "25b60e07-0128-4f21-b803-cf77a0782186",
                                "sense_id": "01bc3310-957c-3e53-96c7-ac09597c93f7",
                                "text": "Freedom from the cares of money and the cark of fashion."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a9aa0cb-8586-3b13-967b-72d27a663729",
                        "entry_id": "a44e2f90-eca8-3093-9640-28feeff4e257",
                        "glosses": [
                            "The state of being filled with worry."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
