            {
                "entry_id": "95a9e1b7-ec42-34f2-b178-04e19777c2a5",
                "word": "barbiturique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "07de4d80-4c2d-4f65-b2f1-f352217c3770",
                        "entry_id": "95a9e1b7-ec42-34f2-b178-04e19777c2a5",
                        "tags": [
                            "plural"
                        ],
                        "form": "barbituriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8de2b8e-71d1-38f7-8426-bf1bf307f1a3",
                        "entry_id": "95a9e1b7-ec42-34f2-b178-04e19777c2a5",
                        "glosses": [
                            "Médicament agissant comme dépresseur du système nerveux central, et dont le spectre d’activité s’étend du sédatif à l’anesthésie. Certains sont aussi utilisés comme anti-convulsifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ac3e14-0ef9-40da-9d15-20ad7c44733d",
                                "sense_id": "a8de2b8e-71d1-38f7-8426-bf1bf307f1a3",
                                "text": "On lui a prescrit des barbituriques."
                            },
                            {
                                "example_id": "b52d6303-ecf9-48ae-8288-3be264bf5ed4",
                                "sense_id": "a8de2b8e-71d1-38f7-8426-bf1bf307f1a3",
                                "text": "L’utilisation des barbituriques fut très répandue dans la première moitié du XXᵉ siècle."
                            },
                            {
                                "example_id": "cd0d120c-40ad-4bdd-95a1-cfb582cf796f",
                                "sense_id": "a8de2b8e-71d1-38f7-8426-bf1bf307f1a3",
                                "text": "Il avait pris un comprimé de barbiturique. Généralement cette médication bénigne lui calmait les nerfs et le préparait au repos."
                            },
                            {
                                "example_id": "58d77655-998c-4e84-b089-b9f094fe65af",
                                "sense_id": "a8de2b8e-71d1-38f7-8426-bf1bf307f1a3",
                                "text": "Elle est remplie de sodium de thiopental, un barbiturique."
                            },
                            {
                                "example_id": "02c15297-6a7c-4fb5-8611-7f9a2c9eedf6",
                                "sense_id": "a8de2b8e-71d1-38f7-8426-bf1bf307f1a3",
                                "text": "Je passai du même coup à la salle de bains pour reprendre triple dose de barbiturique."
                            }
                        ]
                    }
                ],
