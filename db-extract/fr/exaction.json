        "fr-extract.jsonl": [
            {
                "entry_id": "476f7140-69bc-313f-bc11-c33e0ba5e8ef",
                "word": "exaction",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2144f3c2-6540-470b-9138-6eb57248e095",
                        "entry_id": "476f7140-69bc-313f-bc11-c33e0ba5e8ef",
                        "tags": [
                            "plural"
                        ],
                        "form": "exactions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0b54de0-fc7e-332d-a3a1-7da352e85ead",
                        "entry_id": "476f7140-69bc-313f-bc11-c33e0ba5e8ef",
                        "glosses": [
                            "Action par laquelle une personne ou une autorité exige par intimidation une contribution qui n’est pas due ou des droits supérieurs à ce qui est dû."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e6dac1-c893-4c94-9a0d-6db1e99fece2",
                                "sense_id": "c0b54de0-fc7e-332d-a3a1-7da352e85ead",
                                "text": "Qu’il dise la rançon à laquelle il fixe notre liberté, et elle sera payée, pourvu que cette exaction soit en rapport avec nos moyens."
                            },
                            {
                                "example_id": "414af884-e4ca-4953-8a24-1470cb484fb3",
                                "sense_id": "c0b54de0-fc7e-332d-a3a1-7da352e85ead",
                                "text": "Ils sont jaloux et envieux, et soumettent à des exactions rigoureuses les marchands étrangers qui traversent leur pays."
                            },
                            {
                                "example_id": "9c72d512-2240-441d-8c33-229d50f503ca",
                                "sense_id": "c0b54de0-fc7e-332d-a3a1-7da352e85ead",
                                "text": "Les pirates des prairies eux-mêmes, gens de sac et de corde, rebut de la civilisation, qui ne vivent que de rapines et d’exactions, n’osaient s’attaquer à lui […]."
                            },
                            {
                                "example_id": "d902d259-9223-4186-9701-c5359fa9fb4f",
                                "sense_id": "c0b54de0-fc7e-332d-a3a1-7da352e85ead",
                                "text": "La cause de ces insurrections est presque toujours la même : les exactions, les extorsions et mille autres injustices commises par les caïds (gouverneurs) qui, ayant acheté leur poste, ne songent qu'à rentrer dans leurs fonds et à s'enrichir aux dépens de leurs administrés."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdf05cc2-71b4-3fa3-9077-ea482081b345",
                        "entry_id": "476f7140-69bc-313f-bc11-c33e0ba5e8ef",
                        "glosses": [
                            "Actes de violences, rapines exercés contre des populations."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "bdc7634a-78c3-40a4-95aa-e96d1872b5ff",
                                "sense_id": "fdf05cc2-71b4-3fa3-9077-ea482081b345",
                                "text": "En 1145, un légat pontifical prêcha contre eux. Eudes et sa troupe d'« éonites » gagnèrent alors la Gascogne, puis la Champagne, où leurs exactions attirèrent en 1148 une vive réaction de Samson, archevêque de Reims : […]."
                            },
                            {
                                "example_id": "70054da3-027b-464e-bc5e-3fe45a30d7a3",
                                "sense_id": "fdf05cc2-71b4-3fa3-9077-ea482081b345",
                                "text": "Il en est de même des victimes des attentats et des exactions qui ont marqué la période qui a suivi les accords d’Évian le 18 mars jusqu’à la déclaration d’indépendance de l’Algérie le 5 juillet, et parfois au-delà."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f532e76-f499-4b84-9a20-3162e5dc571d",
                        "source_entry_id": "476f7140-69bc-313f-bc11-c33e0ba5e8ef",
                        "target_lang_word": "Gräueltat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gräueltat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26063d07-a85b-32c0-bacd-0c4cd7676cd9",
                                        "entry_id": "a7de6f1a-f28a-3914-b3fa-b7653fa6d133",
                                        "glosses": [
                                            "abscheuliche, von abnormaler oder illegaler Grausamkeit geprägte Tat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86c44045-af17-47fd-b7da-e3a0ac78a81e",
                                                "sense_id": "26063d07-a85b-32c0-bacd-0c4cd7676cd9",
                                                "text": "Die Nationalsozialisten verübten Gräueltaten an den Juden."
                                            },
                                            {
                                                "example_id": "852cf6b3-9fa2-45de-9524-6cf290deba0f",
                                                "sense_id": "26063d07-a85b-32c0-bacd-0c4cd7676cd9",
                                                "text": "„Im Herbst 1945 löst der polnische Sicherheitsdienst den Lagerkommandanten wegen begangener Gräueltaten an deutschen Internierten ab.“"
                                            },
                                            {
                                                "example_id": "0bbc4fd7-2504-4ff5-ad26-645945c4e1ef",
                                                "sense_id": "26063d07-a85b-32c0-bacd-0c4cd7676cd9",
                                                "text": "„Neuer Bericht über eine Gräueltat in Syrien: Rebellen sollen einem Zwölfjährigen den Kopf abgeschnitten haben. Es existiert ein Video.“"
                                            },
                                            {
                                                "example_id": "b868bc3e-10b9-44ff-8f20-ec50845619ef",
                                                "sense_id": "26063d07-a85b-32c0-bacd-0c4cd7676cd9",
                                                "text": "„Doch er war weder der Erste noch der Einzige, der solche Gräueltaten beging.“"
                                            },
                                            {
                                                "example_id": "cbda4a8d-72c7-4f6a-8f2f-86a0d66badce",
                                                "sense_id": "26063d07-a85b-32c0-bacd-0c4cd7676cd9",
                                                "text": "„Seit Jahrzehnten streiten beide Länder um Reparationen für die Zerstörungen der Kriegsjahre und die Gräueltaten der Besatzer.“"
                                            },
                                            {
                                                "example_id": "e625dbeb-e7f9-45b6-aef0-89872a78e5d8",
                                                "sense_id": "26063d07-a85b-32c0-bacd-0c4cd7676cd9",
                                                "text": "„In keinem entsprechenden Buch für öffentliche Bildungseinrichtungen finden die Gräueltaten der pakistanischen Armee oder Zulfikar Ali Bhuttos Widerstand gegenüber einer Koalition mit der ostpakistanischen Awami-Liga 1971 Erwähnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffb0009d-4e19-4bb5-9e96-a925502a40eb",
                        "source_entry_id": "476f7140-69bc-313f-bc11-c33e0ba5e8ef",
                        "target_lang_word": "Schandtat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schandtat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                        "entry_id": "5419e003-417c-39e5-94de-2cc6d1b391dd",
                                        "glosses": [
                                            "grauenvolle Tat, abscheuliches Verbrechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443b2ba1-f89c-4602-9b38-3e0a7d8c82ff",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„Hohe Vertreter französischer Muslime und Juden sind sich einig: Die Schandtat eines Einzelnen dürfe die Beziehung zwischen den Religionen nicht belasten.“"
                                            },
                                            {
                                                "example_id": "bf0d09a2-86ce-458f-8d96-0370a630aff5",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„Bressac verübt seine Schandtaten nicht mehr an der Tante, sondern an der Mutter.“"
                                            },
                                            {
                                                "example_id": "d14d2ea3-c78a-47db-aeb7-7428158fec03",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„Ich habe nicht die Schwäche, zwischen meiner Schandtat und diesem Unglück einen Zusammenhang, wie etwa Ursache und Wirkung, suchen zu wollen.“"
                                            },
                                            {
                                                "example_id": "5d4c10ec-1592-4d23-8e26-4cc465494dc0",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„In London schrieben Schriftsteller mit Wurzeln in den früheren Kolonien über die Schandtaten des Empires.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "951b2db4-e7b8-3780-aeaa-4c28b2356630",
                                        "entry_id": "5419e003-417c-39e5-94de-2cc6d1b391dd",
                                        "glosses": [
                                            "kleineres Vergehen, unvernünftige Aktion"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd59a8e7-3e96-4ecf-aa40-49f8e52f7b5c",
                                                "sense_id": "951b2db4-e7b8-3780-aeaa-4c28b2356630",
                                                "text": "Jedes Jahr las der Nikolaus meine Schandtaten aus einem goldenen Buch vor und ich gelobte Besserung für das nächste Jahr."
                                            },
                                            {
                                                "example_id": "87ca19bd-360d-497c-92d8-dbdd334aaf0c",
                                                "sense_id": "951b2db4-e7b8-3780-aeaa-4c28b2356630",
                                                "text": "„Wenn ich – und diese Möglichkeit hätte bestanden – acht Tage früher angekommen wäre, hätte mir die zärtliche Lucia alles gebeichtet, und ich hätte diese Schandtat verhindert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
