                        "entry_id": "22d7469b-b04a-3cbb-ad01-119b3931faa5",
                        "glosses": [
                            "ein Sport, der nur mit und in einer Sportmannschaft betrieben werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28dfc87d-e7d8-49c1-b8fe-582608abf918",
                                "sense_id": "48c319c9-1682-3762-b64f-2f5ebda70070",
                                "text": "„Beim Mannschaftssport trägt in der Regel die gesamte Mannschaft einheitliche Trikots.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d24e7f27-0d94-4b37-8dd8-a0f53d6ec61e",
                        "source_entry_id": "22d7469b-b04a-3cbb-ad01-119b3931faa5",
                        "source_sense_id": "48c319c9-1682-3762-b64f-2f5ebda70070",
                        "source_sense_description": "ein Sport, der nur mit und in einer Sportmannschaft betrieben werden kann",
                        "target_lang_word": "team sport",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "team sport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87a42441-cdc3-3818-884b-d18ae5803626",
                                        "entry_id": "6f4b5a94-1d8d-3277-b84e-229f7e7f37ca",
                                        "glosses": [
                                            "A sport played by two competing teams."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4319ef90-efbb-4965-b5f8-8fcaaf3af2ee",
                                                "sense_id": "87a42441-cdc3-3818-884b-d18ae5803626",
                                                "text": "This impression is underscored by the high level of minority representation in our major team sports."
                                            },
                                            {
                                                "example_id": "03683cca-2e77-4724-906f-3ad1107c1fda",
                                                "sense_id": "87a42441-cdc3-3818-884b-d18ae5803626",
                                                "text": "But he was required to do a team sport, so he compromised by choosing track, which ironically involved the biggest team of the season."
                                            },
                                            {
                                                "example_id": "2575a6b3-fbc7-4f29-82bc-a94e9a8931e2",
                                                "sense_id": "87a42441-cdc3-3818-884b-d18ae5803626",
                                                "text": "And I looked forward to the other nine games of the greatest team sport devised by man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82da0b07-e2d0-3b40-96aa-1a22c7d2e163",
                                        "entry_id": "6f4b5a94-1d8d-3277-b84e-229f7e7f37ca",
                                        "glosses": [
                                            "All sports involving competing teams, collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ee31da6-420a-4c12-88d3-cae911bc1e02",
                                                "sense_id": "82da0b07-e2d0-3b40-96aa-1a22c7d2e163",
                                                "text": "In addition to personality differences between athletes and non-athletes, personality differences were also observed between team sport athletes and individual sport athletes."
                                            },
                                            {
                                                "example_id": "bc0f7a4d-6721-4236-8dcd-1c730e2cdf63",
                                                "sense_id": "82da0b07-e2d0-3b40-96aa-1a22c7d2e163",
                                                "text": "The representational aspect of team sport adds to this."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
