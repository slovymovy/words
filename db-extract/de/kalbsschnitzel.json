                "senses": [
                    {
                        "sense_id": "381e7085-1075-30ed-91f5-9d496055ab6a",
                        "entry_id": "e47e05a5-63b0-379b-a99b-15ab4437f782",
                        "glosses": [
                            "Schnitzel, zubereitet aus dem Fleisch eines Kalbes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95372d61-7cc6-4a67-9f4d-2e18c56848bd",
                                "sense_id": "381e7085-1075-30ed-91f5-9d496055ab6a",
                                "text": "„In Wien tauchte der Zusatz \"Wiener\" beim Schnitzel immer häufiger gegen Ende des 19. Jahrhunderts in Kochbüchern auf und bezeichnete meist ein simples Kalbsschnitzel.“"
                            },
                            {
                                "example_id": "6625d93d-a48a-44d9-85b0-b3da07a6bddd",
                                "sense_id": "381e7085-1075-30ed-91f5-9d496055ab6a",
                                "text": "„Im «Bellavista» mit seinen bodentiefen Fenstern gönnen sich Professoren auch einmal Kalbsschnitzel mit Weisswein-Risotto für 38 Fr.“"
                            },
                            {
                                "example_id": "1b5c33fb-6e02-4f24-b7c0-934c1c5e1f13",
                                "sense_id": "381e7085-1075-30ed-91f5-9d496055ab6a",
                                "text": "„Würstel machte man aus Krebsen, aus Hecht, aus Karpfen, falsche Kalbsschnitzel aus gebratenen Fischen, um möglichst nicht auf den gewohnten Genuss verzichten zu müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
