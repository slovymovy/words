                "senses": [
                    {
                        "sense_id": "3ebe98d4-3514-356c-904b-6c71ecda392b",
                        "entry_id": "78676b08-ba2d-3eb1-8985-9dc9c87bd626",
                        "glosses": [
                            "An object (especially a ring) formerly used to impress a picture into the sealing wax of a document as a proof of its origin."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "9102a1ab-e6ce-4b2b-9d70-08d7e8788e84",
                                "sense_id": "3ebe98d4-3514-356c-904b-6c71ecda392b",
                                "text": "I had my fathers Signet in my Purse, / Which was the Modell of that Danish Seale:"
                            },
                            {
                                "example_id": "b9a3d263-7182-42b0-bdd1-8415af24e68e",
                                "sense_id": "3ebe98d4-3514-356c-904b-6c71ecda392b",
                                "text": "To carry pure death in an earring, a casket,\nA signet, a fan-mount, a filigree basket!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05d21be4-4b35-41f3-965f-d0aec622c612",
                        "source_entry_id": "78676b08-ba2d-3eb1-8985-9dc9c87bd626",
                        "source_sense_id": "3ebe98d4-3514-356c-904b-6c71ecda392b",
