            {
                "entry_id": "97bb3e0c-21a8-33f1-b6d4-e20a89361e57",
                "word": "dégraissage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b2b6217-f303-4cdf-9e78-b6b048b7d3b1",
                        "entry_id": "97bb3e0c-21a8-33f1-b6d4-e20a89361e57",
                        "tags": [
                            "plural"
                        ],
                        "form": "dégraissages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a4f825f-50ce-3a54-bc10-f1b0ba44351d",
                        "entry_id": "97bb3e0c-21a8-33f1-b6d4-e20a89361e57",
                        "glosses": [
                            "Action de dégraisser les laines, les étoffes de laine, ou de tout autre matériau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a169010-07fb-48d3-a02e-2b265d96767e",
                                "sense_id": "2a4f825f-50ce-3a54-bc10-f1b0ba44351d",
                                "text": "La solution d'ammoniaque est utilisée dans l'industrie pour le dégraissage, la fabrication des sels ammoniacaux."
                            },
                            {
                                "example_id": "94d1e3dd-e3b0-42b1-9955-a8f476b7109a",
                                "sense_id": "2a4f825f-50ce-3a54-bc10-f1b0ba44351d",
                                "text": "Le dégraissage se pratique tant dans l'industrie de transformation des métaux (après usinage à froid ou a chaud, avant ou après traitement thermique, avant soudage ou brasage-diffusion...) …."
                            },
                            {
                                "example_id": "8cdea853-ec8b-4e3c-836c-81e63f6dc8aa",
                                "sense_id": "2a4f825f-50ce-3a54-bc10-f1b0ba44351d",
                                "text": "Le dégraissage est une opération qui a pour but d'enlever à la laine dessuintée la partie du suint insoluble à l'eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "a59ba495-3d1b-3cf6-ac63-41bce3cb2c2e",
                        "entry_id": "97bb3e0c-21a8-33f1-b6d4-e20a89361e57",
                        "glosses": [
                            "Opération consistant à séparer et éliminer les graisses et huiles flottantes contenues dans les eaux usées."
                        ],
                        "tags": [
                            "Assainissement",
                            "Traitement de l’eau"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f50ea239-1e25-3c7a-9ba9-b3ad728dbc69",
                        "entry_id": "97bb3e0c-21a8-33f1-b6d4-e20a89361e57",
                        "glosses": [
                            "Nettoyage à sec."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b47aca6a-0bad-4ab3-bdab-ecbb25f52d35",
                                "sense_id": "f50ea239-1e25-3c7a-9ba9-b3ad728dbc69",
                                "text": "Tenez, par exemple, j'ai fait une tache à la veste de mon costume. Ça ne vaut pas la peine de la donner au dégraissage. D'abord c'est un coup de six cents francs et ensuite, les vêtements, une fois dégraissés, n'ont pas la même tenue."
                            }
                        ]
                    },
                    {
                        "sense_id": "463cc39c-d73e-3f75-896c-fcca5ab24a90",
                        "entry_id": "97bb3e0c-21a8-33f1-b6d4-e20a89361e57",
                        "glosses": [
                            "Diminution du personnel par licenciement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5a83b1c7-eb89-4953-9ae2-cecfd31aa747",
                                "sense_id": "463cc39c-d73e-3f75-896c-fcca5ab24a90",
                                "text": "De l’éjection pour faute grave au dégraissage économique, tous les cas de figure sont prévus."
                            },
                            {
                                "example_id": "b3e58305-3a6f-4cf0-a1d5-d166bae10a57",
                                "sense_id": "463cc39c-d73e-3f75-896c-fcca5ab24a90",
                                "text": "Alarmé par ce dégraissage à la hussarde, Gabriel me supplia de cesser mes provocations, qui risquaient de me brouiller avec mes derniers soutiens, tandis que Bourges jugea utile d'augmenter mes doses de valérianate."
                            }
                        ]
                    }
                ],
