                "senses": [
                    {
                        "sense_id": "12b0e406-a691-3bc4-be9c-e9ff81c8c732",
                        "entry_id": "b010d4e4-0da1-3a8e-a23e-631addc8d05a",
                        "glosses": [
                            "Körpergegend zwischen After und äußerem Geschlechtsorgan (Scheide bei Frauen und Hoden bei Männern)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "814b325a-1960-491d-a843-78d9b66435c1",
                                "sense_id": "12b0e406-a691-3bc4-be9c-e9ff81c8c732",
                                "text": "„Das Perineum sowie der Bereich des Anus ist bei Männern in der Regel behaart, bei Frauen ist diese Behaarung unterschiedlich ausgeprägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e5f869f-b95b-4f5f-b5f9-32030193eb4a",
                        "source_entry_id": "b010d4e4-0da1-3a8e-a23e-631addc8d05a",
                        "source_sense_id": "12b0e406-a691-3bc4-be9c-e9ff81c8c732",
                        "source_sense_description": "Anatomie: Körpergegend zwischen After und äußerem Geschlechtsorgan",
                        "target_lang_word": "perineum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perineum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12cf8c0b-0083-38f8-adc1-53f23d0c270c",
                                        "entry_id": "113a5b05-fef7-367b-8820-2fec852d27bd",
                                        "glosses": [
                                            "The region between the genitalia and anus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "234de45e-6063-4ae5-9e29-771ade0d63f4",
                                                "sense_id": "12cf8c0b-0083-38f8-adc1-53f23d0c270c",
                                                "text": "He was attacked with complete retention of urine, after a debauch, and six weeks afterwards an abscess formed in the perineum, which eventually burst, leaving a fistulous opening, through which the urine continued to be discharged to the period of his admission into the Hospital."
                                            },
                                            {
                                                "example_id": "67589f98-284c-4af4-afd9-75f7c1ae1a62",
                                                "sense_id": "12cf8c0b-0083-38f8-adc1-53f23d0c270c",
                                                "text": "The prostate is surrounded by venous plexi and the perineum has a rich blood supply."
                                            },
                                            {
                                                "example_id": "3991be01-0c62-4507-99e0-8b08ff506664",
                                                "sense_id": "12cf8c0b-0083-38f8-adc1-53f23d0c270c",
                                                "text": "The perineum is diamond shaped and stretches from the pubic symphysis to the coccyx."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02edcb9c-7639-4f01-9043-52f04d4d6d20",
                        "source_entry_id": "b010d4e4-0da1-3a8e-a23e-631addc8d05a",
