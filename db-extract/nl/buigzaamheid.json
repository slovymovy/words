                                        "entry_id": "20d883b3-4a9d-30cc-9085-e7fd169297c3",
                                        "glosses": [
                                            "The quality of being supple; litheness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6356ad23-ddf1-4d31-89bb-efdaa79872e2",
                                                "sense_id": "bb86fb30-a3e7-39e8-be70-6f81f9f81fa8",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            }
                                        ]
                                    }
                                ]
