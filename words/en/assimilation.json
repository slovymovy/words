{
    "word_family": [
        "assimilate",
        "assimilative",
        "assimilator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0db00957-0283-386f-9d39-d78ede05ebed",
                    "sense_definition": "The process by which a minority group adopts the customs and attitudes of the dominant culture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cultural_integration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>assimilation</w> of immigrants into the local community often takes several generations.",
                            "target_lang_translations": {
                                "zh": "移民融入当地社区的<w>同化</w>过程往往需要几代人的时间。"
                            }
                        },
                        {
                            "text": "Cultural <w>assimilation</w> can sometimes lead to the loss of traditional languages and practices.",
                            "target_lang_translations": {
                                "zh": "文化<w>同化</w>有时会导致传统语言和习俗的丧失。"
                            }
                        }
                    ],
                    "synonyms": [
                        "integration",
                        "acculturation"
                    ],
                    "common_phrases": [
                        "cultural assimilation"
                    ],
                    "target_lang_definitions": {
                        "zh": "少数群体采纳主流文化习俗和态度的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同化",
                                "target_lang_sense_clarification": "指文化或民族上的融合。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "898b295e-2fe6-3cd1-add0-f9f914b70bf2",
                    "sense_definition": "The process of absorbing new information or ideas into an existing mental framework.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "learning_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>assimilation</w> of complex scientific concepts requires time and practice.",
                            "target_lang_translations": {
                                "zh": "对复杂科学概念的<w>吸收</w>需要时间和练习。"
                            }
                        },
                        {
                            "text": "Effective <w>assimilation</w> of new knowledge helps students build upon what they already know.",
                            "target_lang_translations": {
                                "zh": "有效地<w>吸收</w>新知识有助于学生在已有基础上进一步学习。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absorption",
                        "understanding"
                    ],
                    "common_phrases": [
                        "knowledge assimilation"
                    ],
                    "target_lang_definitions": {
                        "zh": "将新信息或新思想吸收进现有认知框架的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吸收",
                                "target_lang_sense_clarification": "指对知识或信息的消化与内化。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc7d5e94-17be-3e7c-b554-812747a662e0",
                    "sense_definition": "The biological process of converting nutrients into living tissue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biological_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proper digestion is essential for the efficient <w>assimilation</w> of nutrients by the body.",
                            "target_lang_translations": {
                                "zh": "良好的消化对于身体高效<w>吸收</w>营养至关重要。"
                            }
                        },
                        {
                            "text": "The body's <w>assimilation</w> of vitamins is improved when they are consumed with healthy fats.",
                            "target_lang_translations": {
                                "zh": "当维生素与健康脂肪一起摄入时，身体对它们的<w>吸收</w>会得到改善。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absorption",
                        "metabolism"
                    ],
                    "common_phrases": [
                        "nutrient assimilation"
                    ],
                    "target_lang_definitions": {
                        "zh": "生物体将营养物质转化为自身组织的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同化",
                                "target_lang_sense_clarification": "生物学中指将营养转化为自身物质的过程。"
                            },
                            {
                                "target_lang_word": "吸收",
                                "target_lang_sense_clarification": "指身体对营养成分的摄取。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "665f4137-e2ac-366c-beff-2ab19a68fe85",
                    "sense_definition": "A linguistic process where a speech sound changes to become more similar to a neighboring sound.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistic_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, the prefix in- often undergoes <w>assimilation</w> to become im- before words starting with b or p.",
                            "target_lang_translations": {
                                "zh": "在英语中，前缀 in- 在以 b 或 p 开头的单词前常发生<w>同化</w>而变为 im-。"
                            }
                        },
                        {
                            "text": "Phonetic <w>assimilation</w> explains why some words are pronounced differently than they are spelled.",
                            "target_lang_translations": {
                                "zh": "语音<w>同化</w>解释了为什么有些单词的发音与拼写不同。"
                            }
                        }
                    ],
                    "antonyms": [
                        "dissimilation"
                    ],
                    "common_phrases": [
                        "phonetic assimilation"
                    ],
                    "target_lang_definitions": {
                        "zh": "语音学中，一个音受邻音影响而变得相似的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同化",
                                "target_lang_sense_clarification": "语音学中指音变现象。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16ed900e-f705-3420-abc8-078cc5b7740b",
                    "sense_definition": "The general act of incorporating or becoming part of something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "general_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>assimilation</w> of smaller companies into the larger corporation was completed last year.",
                            "target_lang_translations": {
                                "zh": "将较小公司<w>并入</w>大型企业的流程已于去年完成。"
                            }
                        },
                        {
                            "text": "Successful <w>assimilation</w> of new policies requires clear communication from management.",
                            "target_lang_translations": {
                                "zh": "新政策的成功<w>整合</w>需要管理层进行清晰的沟通。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incorporation",
                        "integration"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物纳入或成为某物一部分的普遍行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "并入",
                                "target_lang_sense_clarification": "指合并或纳入整体。"
                            },
                            {
                                "target_lang_word": "整合",
                                "target_lang_sense_clarification": "指将不同部分结合成一个整体。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}