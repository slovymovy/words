{
    "word_family": [
        "ленивый",
        "ленивец",
        "лениться",
        "леность",
        "ленца"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d5eece2-1fba-320d-ac48-5e3bed5386d7",
                    "sense_definition": "Отсутствие желания работать или выполнять какие-либо действия; склонность к безделью.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "laziness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его <w>лень</w> мешает ему добиваться успехов в учёбе. ",
                            "target_lang_translations": {
                                "en": "His <w>laziness</w> prevents him from succeeding in his studies."
                            }
                        },
                        {
                            "text": "Внезапная <w>лень</w> одолела его, и он остался дома.",
                            "target_lang_translations": {
                                "en": "Sudden <w>laziness</w> overcame him, and he stayed home."
                            }
                        }
                    ],
                    "synonyms": [
                        "леность",
                        "праздность",
                        "неохота"
                    ],
                    "antonyms": [
                        "трудолюбие"
                    ],
                    "common_phrases": [
                        "напала лень",
                        "бороться с ленью"
                    ],
                    "target_lang_definitions": {
                        "en": "Lack of desire to work or perform any actions; inclination toward idleness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "laziness",
                                "target_lang_sense_clarification": "quality of being lazy"
                            },
                            {
                                "target_lang_word": "sloth",
                                "target_lang_sense_clarification": "habitual laziness or idleness"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3ed3ea47-acb7-3fc0-9460-0d9e83736a61",
                    "sense_definition": "Нет желания, неохота делать что-либо в данный момент.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "laziness_predicate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне сегодня <w>лень</w> учиться и делать домашнее задание. ",
                            "target_lang_translations": {
                                "en": "I'm <w>too lazy</w> to study and do my homework today."
                            }
                        },
                        {
                            "text": "Ей было <w>лень</w> вставать так рано утром.",
                            "target_lang_translations": {
                                "en": "She was <w>too lazy</w> to get up so early in the morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "неохота",
                        "влом"
                    ],
                    "common_phrases": [
                        "мне лень",
                        "лень вставать"
                    ],
                    "target_lang_definitions": {
                        "en": "Lack of desire, reluctance to do something at the current moment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "too lazy",
                                "target_lang_sense_clarification": "feeling unwilling to do something"
                            },
                            {
                                "target_lang_word": "don't feel like",
                                "target_lang_sense_clarification": "lacking inclination to do something"
                            }
                        ]
                    }
                }
            ]
        },
