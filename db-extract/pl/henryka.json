                    {
                        "translation_id": "ea435fc4-651a-406d-a66f-cfd2c59906fb",
                        "source_entry_id": "f30799fa-4d88-35c0-8521-a8c762f1a339",
                        "source_sense_id": "652f8b7a-7743-3471-b66d-e6f9b20afe3b",
                        "target_lang_word": "Henriette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Henriette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97b647cc-c6a1-3805-bde1-e998dd981ffc",
                                        "entry_id": "03c2f602-9b7a-3a4e-82c8-7d8ab577bd4a",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caf79a87-a4be-4ee6-8d6d-4d3495595d23",
                                                "sense_id": "97b647cc-c6a1-3805-bde1-e998dd981ffc",
                                                "text": "En apprenant que les Signol possédaient pour quelque dix ou douze mille francs de vignes et une petite maison assez logeable, le Parisien se hâta de mettre Henriette dans l’impossibilité d’être la femme d’un autre."
                                            },
                                            {
                                                "example_id": "8bf9cb6d-b064-4566-bbee-af517bdef25e",
                                                "sense_id": "97b647cc-c6a1-3805-bde1-e998dd981ffc",
                                                "text": "Après trois mois, je commençais à ne plus me contenter de la part qui m’était faite, et je caressais doucement la main d’Henriette en essayant de transborder ainsi les riches voluptés qui m’embrasaient."
                                            },
                                            {
                                                "example_id": "4bd53f85-ccbe-44d3-ad83-2c124a94d7a0",
                                                "sense_id": "97b647cc-c6a1-3805-bde1-e998dd981ffc",
                                                "text": "Vendredi 29 juillet, Henriette Jean, née Cahut, a fêté ses 95 ans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Henriette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85718ad3-71f3-3c96-8523-12f980ea7187",
                                        "entry_id": "7692b04e-6603-37f7-b32e-f711cbd53dd8",
                                        "glosses": [
                                            "Petite île russe de l’océan Arctique, situé dans l’archipel De Long au large de la Yakoutie-Sakha."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ee7bb3-330e-4680-a883-8e9524a5b7da",
                                                "sense_id": "85718ad3-71f3-3c96-8523-12f980ea7187",
                                                "text": "Alors l’intérêt du commandant et de son équipage se reporta sur ce rocher plus neuf, plus grand. De Long le baptisa île Henriette, du nom de la mère irlandaise de Bennett, mais aussi de la goélette avec laquelle le patron du Herald avait gagné la première transatlantique à la voile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
