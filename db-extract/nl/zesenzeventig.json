                        "examples": [
                            {
                                "example_id": "22371031-89e0-45a9-9732-f4d14986b396",
                                "sense_id": "eabcec50-af53-3d36-af46-99f7a40e842f",
                                "text": "Het is weer de zesenzeventig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "7a26b5cd-632c-41f2-969a-068b19ed17e6",
                                "sense_id": "eabcec50-af53-3d36-af46-99f7a40e842f",
                                "text": "Haar zevenenzeventigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zesenzeventig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "00e67bea-ed94-3867-a0f3-c6e05b530e37",
                        "entry_id": "0babc1e1-a148-3336-ad61-5a2c2c185def",
                        "glosses": [
