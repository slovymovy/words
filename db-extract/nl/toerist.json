                ],
                "senses": [
                    {
                        "sense_id": "338d3550-bee0-313a-8a04-35f55d295549",
                        "entry_id": "9c08ded2-c209-381c-a5b8-2968fc3e0df0",
                        "glosses": [
                            "Tourist"
                        ],
                        "tags": [],
