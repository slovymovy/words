    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "938ff4d8-4e8d-3857-814b-84d3aaa27f58",
                "word": "Rhodesia",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8e33475e-d433-313a-bc93-f7b51470f241",
                        "entry_id": "938ff4d8-4e8d-3857-814b-84d3aaa27f58",
                        "glosses": [
                            "A former country in Southern Africa, in what is now Zimbabwe, originally called Southern Rhodesia, named after its founder, Cecil Rhodes."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0999b7e3-eaea-4413-a5ba-d1df8a74b79f",
                                "sense_id": "8e33475e-d433-313a-bc93-f7b51470f241",
                                "text": "If you did that in Rhodesia, you could be punished with many years in prison."
                            },
                            {
                                "example_id": "b54ad6d5-6455-4056-8426-f8d9edd136c4",
                                "sense_id": "8e33475e-d433-313a-bc93-f7b51470f241",
                                "text": "After independence, Rhodesia changed its name to Zimbabwe, Nyasaland to Malawi, and Bechuanaland to Botswana."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a3c2015-cb93-3b4d-9bbb-490667e843f1",
                        "entry_id": "938ff4d8-4e8d-3857-814b-84d3aaa27f58",
                        "glosses": [
                            "A historical region of Southern Africa, the area now occupied by Zimbabwe and Zambia."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80a89e4e-8470-4ed1-a7fb-5c32d09153fb",
                        "source_entry_id": "938ff4d8-4e8d-3857-814b-84d3aaa27f58",
                        "source_sense_description": "historical name of Zimbabwe",
                        "target_lang_word": "Rhodesië",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhodesië",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b8649bf1-8874-3c8b-a403-bc3b80a636bf",
                                        "entry_id": "5f2fd49e-180c-3c79-b56d-918d265de8fc",
                                        "glosses": [
                                            "een voormalige Britse kolonie in Afrika vernoemd naar Cecil Rhodes dat later overging in Noord-Rhodesië, het huidige Zambia, en Zuid-Rhodesië, het huidige Zimbabwe"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4819bb89-f679-420c-a626-7228050de68d",
                        "source_entry_id": "938ff4d8-4e8d-3857-814b-84d3aaa27f58",
                        "source_sense_description": "historical name of Zimbabwe",
                        "target_lang_word": "Rhodésie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhodésie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76f6d1dd-4dfc-385e-a7e8-976698f0da68",
                                        "entry_id": "e1db1ab5-3526-3527-9109-0e36389c2b43",
                                        "glosses": [
                                            "Ancien nom du Zimbabwe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b6a9cc6-9fab-40a3-84c9-5752663d8944",
                                                "sense_id": "76f6d1dd-4dfc-385e-a7e8-976698f0da68",
                                                "text": "Elle met sur pied une force armée, recrute des colons blancs et fonde ce que l'on nomme la Rhodésie dès 1895."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ab0b9e5-27ec-4f18-9f4e-f8bbdd8b9a8c",
                        "source_entry_id": "938ff4d8-4e8d-3857-814b-84d3aaa27f58",
                        "source_sense_description": "historical name of Zimbabwe",
                        "target_lang_word": "Rhodesien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhodesien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0f31d33-c464-3240-955c-ceea6c2febce",
                                        "entry_id": "87dd6ee3-f603-34ca-8e97-068d285a758f",
                                        "glosses": [
                                            "ehemalige britische Kolonie, heute Simbabwe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18aa74be-e1c6-4af5-bf25-eac459c9b9da",
                                                "sense_id": "c0f31d33-c464-3240-955c-ceea6c2febce",
                                                "text": "„Seit der Gründung der britischen Kolonie Rhodesien durch ihren Namensgeber Cecil Rhodes im 19. Jahrhundert wanderten weiße Händler und Farmer aus Europa und Südafrika ein, die um die Mitte des 20. Jahrhunderts knapp fünf Prozent der Bevölkerung stellten.“"
                                            },
                                            {
                                                "example_id": "4c855eb3-81e5-4855-931e-02f5ea9503e9",
                                                "sense_id": "c0f31d33-c464-3240-955c-ceea6c2febce",
                                                "text": "„Nach der Unabhängigkeit wurde aus Rhodesien Simbabwe, Victoria wurde in Masvingo umbenannt, Pierres Eltern bearbeiteten weiter ihre Farm.“"
                                            },
                                            {
                                                "example_id": "46932c9d-d53e-4452-b796-e609b90145b7",
                                                "sense_id": "c0f31d33-c464-3240-955c-ceea6c2febce",
                                                "text": "„Als am Abend des 4. März 1980 die weißen Bewohner der Kolonie Rhodesien ihre Fernsehapparate anschalteten, erwarteten sie nichts Gutes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
