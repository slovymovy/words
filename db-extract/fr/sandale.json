                        "source_entry_id": "20b361a6-aed2-34ed-9d4e-efcedc337607",
                        "source_sense_id": "2774a5fb-952f-3200-8bad-a3ea1c768b80",
                        "source_sense_description": "die Sandale",
                        "target_lang_word": "Sandale",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sandale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                        "entry_id": "3e677e28-dd01-374f-8908-f9bad5b5fe84",
                                        "glosses": [
                                            "sehr einfacher Schuh, dessen Sohle von einer einfachen Riemenkonstruktion gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6dc5ed-00d2-4f28-aaa6-e4eaf5025e17",
                                                "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                                "text": "Ich habe mir diesen Sommer neue Sandalen gekauft."
                                            },
                                            {
                                                "example_id": "462cf28c-af57-4f0a-b344-cb5e4dd9f517",
                                                "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                                "text": "„Unsere Welt ist für die Birkenstocks gemacht, sagte ich mir am Abend, als ich endlich meine violetten Sandalen für immer ausziehen konnte.“"
                                            },
                                            {
                                                "example_id": "39e2990f-0984-4bbc-81c1-984393278b31",
                                                "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                                "text": "„Die Wände waren ihr lieber als die Sandalen, mit denen sie manchmal ebenfalls spielte.“"
                                            },
                                            {
                                                "example_id": "24f9cae6-4b11-4077-b6eb-aeb6e1781708",
                                                "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                                "text": "„Sein Blick ruhte auf ihren nackten Füßen in den Sandalen, und sie zuckten einen antwortenden Rhythmus.“"
                                            },
                                            {
                                                "example_id": "e051ffb6-0024-47c0-b363-5d5d28424a86",
                                                "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                                "text": "„Er hatte jetzt die Stiefel ausgezogen, lief in schlichten Sandalen und einem hellen Hemd umher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
