                "senses": [
                    {
                        "sense_id": "f3fed159-4b37-3dca-9b20-5c2ee6358862",
                        "entry_id": "6fbb4edc-e94b-3636-937d-a266a5544b56",
                        "glosses": [
                            "Rendre une étoffe ondée à la manière du tabis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2a82907-cbdf-4624-86c8-37086d2b7897",
                                "sense_id": "f3fed159-4b37-3dca-9b20-5c2ee6358862",
                                "text": "Tabiser du ruban, de la moire."
                            },
                            {
                                "example_id": "50b1581a-e819-4ebb-b3fe-b03ee3178e9e",
                                "sense_id": "f3fed159-4b37-3dca-9b20-5c2ee6358862",
                                "text": "Il n’y a de différence entre tabiser et moirer, que celle qui est occasionnée par la grosseur du grain de l’étoffe, c’est-à-dire, que, dans le tabis, le grain de l’étoffe n’étant pas considérable, les ondées se remarquent moins que dans le moiré, où le grain de l’étoffe est plus considérable."
                            }
                        ]
                    }
