                "senses": [
                    {
                        "sense_id": "4517bb38-331e-3cb5-ad2f-93ce318f6f13",
                        "entry_id": "54d1fdce-ab7a-3e96-9e26-75e6ffab4ccf",
                        "glosses": [
                            "Körper einer Zelle i. d. R. ohne Zellfortsätze und Zellkern"
                        ],
                        "tags": [
                            "Zellbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "bd718a40-fe32-4a66-983a-7539a19e64cd",
                                "sense_id": "4517bb38-331e-3cb5-ad2f-93ce318f6f13",
                                "text": "„Die Zelle ist ein sich selbst regulierendes und mit seiner Umgebung in ständigem Stoffaustausch und in einem Fließgleichgewicht stehendes System mit einem eigenen Stoffwechsel. Jede Zelle besteht aus dem Zellleib (= Zytosoma), der umgeben ist von der Zellmembran.“"
                            },
                            {
                                "example_id": "aba134e1-40f6-49d6-8560-6bc8b4a139b6",
                                "sense_id": "4517bb38-331e-3cb5-ad2f-93ce318f6f13",
                                "text": "„Die korrosive Effektivität der Affizierbarkeit von Zytoplasma und Zytosoma wird gar nicht oder nur schwach eliminiert.“"
                            },
                            {
                                "example_id": "e6b57958-3e2e-4922-8669-f11b363b3d1f",
                                "sense_id": "4517bb38-331e-3cb5-ad2f-93ce318f6f13",
                                "text": "„In Zusammenarbeit mit meiner Frau, die alle Tage mit ins Laboratorium geht, habe ich mich hauptsächlich mit der Morphologie der Beziehungen von Kern und Zytosoma beschäftigt.“"
                            },
                            {
                                "example_id": "2fc2daac-1d2d-47e1-af5f-72f916eb4f2a",
                                "sense_id": "4517bb38-331e-3cb5-ad2f-93ce318f6f13",
                                "text": "„Im weiteren Verlauf der intrazellulären Bewegung tritt dann eine Änderung des Zustandes dahingehend ein, daß an verschiedenen Orten im Zytosoma stärker lichtbrechende Körper auftreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
