                        "examples": [
                            {
                                "example_id": "228e93d2-ab26-4036-9edc-7ef1495e7481",
                                "sense_id": "b822d6e9-a4d8-3093-9c05-cdc74c536fdf",
                                "text": "Nazwa miasta Mikołów pochodzi najprawdopodobniej od imienia Mikołaj."
                            },
                            {
                                "example_id": "fb2adf23-b751-435e-9560-5012a69db43d",
                                "sense_id": "b822d6e9-a4d8-3093-9c05-cdc74c536fdf",
                                "text": "Katowice sąsiadują z Mikołowem i Tychami."
                            },
                            {
                                "example_id": "8338e335-25db-44e4-b031-7f6cb6a4b859",
                                "sense_id": "b822d6e9-a4d8-3093-9c05-cdc74c536fdf",
                                "text": "Piotrek pochodzi z Mikołowa."
                            }
                        ],
