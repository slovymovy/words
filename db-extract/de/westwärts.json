        "de-extract.jsonl": [
            {
                "entry_id": "1fb6d64f-31a8-3e96-99a4-693c842a2d19",
                "word": "westwärts",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b1b48efb-ddb5-3388-8e47-ec5cbf91ac1f",
                        "entry_id": "1fb6d64f-31a8-3e96-99a4-693c842a2d19",
                        "glosses": [
                            "in westliche Richtung, nach Westen hin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a99f9afa-9734-4044-a0a5-0faaecb26124",
                                "sense_id": "b1b48efb-ddb5-3388-8e47-ec5cbf91ac1f",
                                "text": "Unser Weg führte nur noch westwärts."
                            },
                            {
                                "example_id": "22cc7607-f8d0-4d00-b235-1cf9e28d2837",
                                "sense_id": "b1b48efb-ddb5-3388-8e47-ec5cbf91ac1f",
                                "text": "„Mit dem Partisanenführer Tito, der bereits große Teile Jugoslawiens beherrschte, hatte der sowjetische Diktator verabredet, daß die Rote Armee zu ihm und dann gemeinsam weiter westwärts durchstoßen werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "451f2b06-6550-462a-9645-830e518c80a1",
                        "source_entry_id": "1fb6d64f-31a8-3e96-99a4-693c842a2d19",
                        "source_sense_id": "b1b48efb-ddb5-3388-8e47-ec5cbf91ac1f",
                        "source_sense_description": "in westliche Richtung, nach Westen hin",
                        "target_lang_word": "westward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "westward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be17c873-3bbd-384b-bcb5-fde3245fc31d",
                                        "entry_id": "b56be6c2-c42e-3f82-9fb1-f69f7053155b",
                                        "glosses": [
                                            "Lying toward the west."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d93395b-95e5-4382-a744-ad88da7dbf32",
                                                "sense_id": "be17c873-3bbd-384b-bcb5-fde3245fc31d",
                                                "text": "[…] yond same star that’s westward from the pole"
                                            },
                                            {
                                                "example_id": "00668961-b3cd-4935-a32f-028322b0f240",
                                                "sense_id": "be17c873-3bbd-384b-bcb5-fde3245fc31d",
                                                "text": "[…] about a quarter of an hour before the time of sunset the westward clouds parted […]"
                                            },
                                            {
                                                "example_id": "c5378d47-382f-47a5-b7d2-ffc921208ba0",
                                                "sense_id": "be17c873-3bbd-384b-bcb5-fde3245fc31d",
                                                "text": "It stands high up on the westward slopes of the Alpilles […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b81ee6b-fd47-3b78-b2f2-324aea296a4b",
                                        "entry_id": "b56be6c2-c42e-3f82-9fb1-f69f7053155b",
                                        "glosses": [
                                            "Moving or oriented toward the west."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e383098d-a277-4af6-97bb-5b1c0710e55d",
                                                "sense_id": "9b81ee6b-fd47-3b78-b2f2-324aea296a4b",
                                                "text": "1783, Edward Gibbon, The History of the Decline and Fall of the Roman Empire, London: W. Strahan & T. Cadell, Volume 3, Chapter 17, p. 8,\nThose who steer their westward course through the middle of the Propontis, may at once descry the high lands of Thrace and Bithynia, and never lose sight of the lofty summit of Mount Olympus, covered with eternal snows."
                                            },
                                            {
                                                "example_id": "dcb09aec-8721-4bfa-a784-394f61db3332",
                                                "sense_id": "9b81ee6b-fd47-3b78-b2f2-324aea296a4b",
                                                "text": "Oh! ye wild black swans, ’twere a world of wonder\nFor a while to join in your westward flight,"
                                            },
                                            {
                                                "example_id": "0e0f9070-2873-4400-a5cb-f1e5fd3a25b4",
                                                "sense_id": "9b81ee6b-fd47-3b78-b2f2-324aea296a4b",
                                                "text": "They moved out on the westward road again."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "westward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f67866b0-78c8-3dc0-a1b5-9f61cb3d6909",
                                        "entry_id": "ccac89b6-1be9-335b-987f-7943c609bb03",
                                        "glosses": [
                                            "Toward the west."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa37b0d9-3d8c-49b6-8d2a-65f2c4c4f25a",
                                                "sense_id": "f67866b0-78c8-3dc0-a1b5-9f61cb3d6909",
                                                "text": "ride westward."
                                            },
                                            {
                                                "example_id": "853561ab-9634-4db1-b285-425cfafd4010",
                                                "sense_id": "f67866b0-78c8-3dc0-a1b5-9f61cb3d6909",
                                                "text": "Looke here my boies, see what a world of ground,\nLies westward from the midst of Cancers line,\nVnto the rising of this earthly globe,"
                                            },
                                            {
                                                "example_id": "e72883f2-1872-44c4-87fa-a34020490fb2",
                                                "sense_id": "f67866b0-78c8-3dc0-a1b5-9f61cb3d6909",
                                                "text": "Westward the course of empire takes its way;"
                                            },
                                            {
                                                "example_id": "67affd53-255b-4d0c-87dd-908b710cef89",
                                                "sense_id": "f67866b0-78c8-3dc0-a1b5-9f61cb3d6909",
                                                "text": "1857, John Henry Hopkins Jr., “We Three Kings” (Christmas carol),\nO star of wonder, star of night,\nStar with royal beauty bright,\nWestward leading, still proceeding,\nGuide us to thy perfect light."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "westward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47eb8856-e719-3303-9c1d-6c0ebb13288f",
                                        "entry_id": "d4ffdaa1-71f7-3a69-b908-0101fc158c00",
                                        "glosses": [
                                            "The western region or countries; the west."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e546cf85-0b1a-417e-be03-5bf2b9b04d14",
                                                "sense_id": "47eb8856-e719-3303-9c1d-6c0ebb13288f",
                                                "text": "I name this to explain what I said before, of Ships being embay’d and lost here: this is when, coming from the Westward, they omit to keep a good Offing, or are taken short by contrary Winds […]"
                                            },
                                            {
                                                "example_id": "c918b2fa-8293-42a9-9769-86f458227141",
                                                "sense_id": "47eb8856-e719-3303-9c1d-6c0ebb13288f",
                                                "text": "You will live quietly there till I come back from my next cruise to the westward."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43a1431f-117a-43ef-9f01-10ce98c5c5ff",
                        "source_entry_id": "1fb6d64f-31a8-3e96-99a4-693c842a2d19",
                        "source_sense_id": "b1b48efb-ddb5-3388-8e47-ec5cbf91ac1f",
                        "source_sense_description": "in westliche Richtung, nach Westen hin",
                        "target_lang_word": "westwards",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "westwards",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ba7d13b-6191-3211-92bc-1a3ef7f3cfc8",
                                        "entry_id": "53a0ade2-308c-3f09-99f6-a25992c33daa",
                                        "glosses": [
                                            "westward, towards the west"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a1d26ee-ec2d-4e0a-ab21-a57deca03b3c",
                                                "sense_id": "5ba7d13b-6191-3211-92bc-1a3ef7f3cfc8",
                                                "text": "The view westwards from here is extremely fine, with the striking flat-topped outline of Blencathra or Saddleback (2,847ft) the most dominant feature, and the Helvellyn range to the left."
                                            },
                                            {
                                                "example_id": "117d663f-7654-4c37-985f-227a2d2126fd",
                                                "sense_id": "5ba7d13b-6191-3211-92bc-1a3ef7f3cfc8",
                                                "text": "Basingstoke-Exeter will test this. From Salisbury westwards, it's largely single-track since British Rail downgraded it in 1967. There's a ten-mile loop between Templecombe and Yeovil, as well as shorter loops at Chard, Axminster and Honiton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
