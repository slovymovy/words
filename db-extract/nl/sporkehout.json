                        "entry_id": "7cde40c1-8bfe-330d-af45-dc726eae076a",
                        "glosses": [
                            "bepaald soort loofboom, Frangula alnus, die inheems is in de Benelux, tot 7 meter hoog kan worden en behoort tot de wegedoornfamilie (Rhamnaceae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d566e979-4196-49bd-b3e4-1aab2c176c69",
                                "sense_id": "f9c2ba2d-eb11-3f1f-802b-6d88c141e177",
                                "text": "De eieren worden afgezet op sporkehout of wegedoorn, en daarna fladderen de overwinteraars nog tot juni rond."
                            }
                        ]
                    }
