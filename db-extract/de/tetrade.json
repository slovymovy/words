                "senses": [
                    {
                        "sense_id": "ee674624-dd97-3718-adc1-9e42b045f352",
                        "entry_id": "048bf83f-e60a-358e-b420-43f4c354ed87",
                        "glosses": [
                            "ein Ganzes, das aus vier Unterbereichen/Teileinheiten/Komponenten besteht"
                        ],
                        "tags": [
                            "und andere Fachbereiche"
                        ],
                        "examples": [
                            {
                                "example_id": "34f3e638-6930-4999-89c3-5f923462b85a",
                                "sense_id": "ee674624-dd97-3718-adc1-9e42b045f352",
                                "text": "Philosophie: Man könnte sagen, die oberste Tetrade bestehe aus Bewusstsein, Gemüt, Geist und Wille."
                            },
                            {
                                "example_id": "fa5a43c4-6409-48eb-8c03-620b9e23b147",
                                "sense_id": "ee674624-dd97-3718-adc1-9e42b045f352",
                                "text": "Biologie: „Die neue Anordnung der vier Chromatiden trägt den Namen Tetrade (tetra bedeutet »vier«, die Tetrade ist also ein Viererpack).“"
                            },
                            {
                                "example_id": "5efdd363-5610-4dfe-9c96-9cb281edf4e2",
                                "sense_id": "ee674624-dd97-3718-adc1-9e42b045f352",
                                "text": "EDV: „Die 4-stelligen Dualzahlen werden üblicherweise als Tetrade (oder Halbbyte) bezeichnet.“"
                            },
                            {
                                "example_id": "c29e5471-6cc3-4b74-8f04-7519df96c47a",
                                "sense_id": "ee674624-dd97-3718-adc1-9e42b045f352",
                                "text": "Numerische Mathematik: „Im Oktalsystem wird eine Triade (= Dreierblock) und im Hexadezimalsystem eine Tetrade (= Viererblock) benötigt, um eine Ziffer des entsprechenden Zahlsystems im Binärcode zu repräsentieren.“"
                            },
                            {
                                "example_id": "268b4952-776d-4451-941b-564d575dd852",
                                "sense_id": "ee674624-dd97-3718-adc1-9e42b045f352",
                                "text": "Physik: „Ein Beispiel von physikalischen Tetraden sind die Elastizitätsmoduln aller Medien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
