                "senses": [
                    {
                        "sense_id": "781bdfda-0a6e-39a4-a481-7fd29b5a892a",
                        "entry_id": "eff06945-da18-3196-abeb-84cc37cb450b",
                        "glosses": [
                            "kleine Kamera auf einem beweglichen Arm zur nachfolgenden Projektion von schriftlichen oder bildlichen Aufzeichnungen mithilfe eines Videoprojektors („Beamers“)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ca91013-271e-42f5-a3c3-35e73495e934",
                                "sense_id": "781bdfda-0a6e-39a4-a481-7fd29b5a892a",
                                "text": "„Die vorgesehene Nutzung mit Dokumentenkamera und Visualizer, die frühere Tageslichtprojektoren ersetzt, ist aber vorerst noch nicht möglich.“"
                            },
                            {
                                "example_id": "776f1c69-cd65-4c77-854e-e8ee91fe1f9d",
                                "sense_id": "781bdfda-0a6e-39a4-a481-7fd29b5a892a",
                                "text": "„Anstatt Studenten an die Tafel zu holen, rechnen diese etwa Prüfungsaufgaben am Tisch unter dem Visualizer - der wirft das Geschriebene zwar an die ‚Tafel‘, für den Prüfling selbst lassen dadurch jedoch die Nervosität und der Prüfungsstress stark nach.“"
                            }
                        ],
