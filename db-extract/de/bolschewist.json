                        "translation_id": "7ae9d293-bbfa-487b-bcfd-1350bcee04b8",
                        "source_entry_id": "211d9847-a7fc-3846-a603-125f3d875ed3",
                        "source_sense_id": "f5384364-ddb2-343d-8d23-4c5c327ca571",
                        "source_sense_description": "Mitglied der revolutionären Fraktion der Sozialdemokratischen Arbeiterpartei Russlands",
                        "target_lang_word": "Bolshevik",
