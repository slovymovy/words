                                "target_senses": [
                                    {
                                        "sense_id": "bdeb4984-0fe3-314f-9a52-3df48ea33f3e",
                                        "entry_id": "44387693-7cd7-391e-8515-5ad8c41610fd",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 115"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ede7220-0d18-446d-b0d0-b7b21fb9e472",
                                                "sense_id": "bdeb4984-0fe3-314f-9a52-3df48ea33f3e",
                                                "text": "„Das Gremium hat folgendes beschlossen: Die Namen der Elemente Nihonium (Nh), Moscovium (Mc) und Oganesson (Og) werden unverändert ins Deutsche übernommen.“"
                                            },
                                            {
                                                "example_id": "dc2b8189-c7e2-4757-8134-0c99bbc24ca4",
                                                "sense_id": "bdeb4984-0fe3-314f-9a52-3df48ea33f3e",
                                                "text": "„In der Region Moskau befindet sich das Vereinigte Institut für Kernforschung, das mit seiner Einrichtung, dem Flerow-Labor für Kernreaktionen, maßgeblich an der Entdeckung des Moscovium beteiligt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80c4c8f6-c681-4d36-959b-bfa38e64ab9a",
                        "source_entry_id": "c6c67208-ede9-3c12-a900-9bb38da90dfc",
                        "source_sense_id": "40453b52-1157-3680-baf9-a7670a04946c",
                        "target_lang_word": "moscovium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moscovium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f990a15-c9ae-3656-b4d0-ade8e09e9188",
                                        "entry_id": "9eacf9ce-32a7-3709-9061-8e5e5a2deb90",
                                        "glosses": [
                                            "The chemical element with atomic number 115."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7d173d9-8ce5-4ae0-afbf-c3d92dcd8ab2",
                                                "sense_id": "6f990a15-c9ae-3656-b4d0-ade8e09e9188",
                                                "text": "In January 2016 the International Union of Pure and Applied Chemistry (IUPAC) announced the discovery of four new elements, so completing the seventh row of the periodic table. They have since been named as nihonium, Nh, muscovium^([sic]), Mc, tennessine, Ts, and organesson^([sic]), Og. The procedures for naming new elements are clearly laid out by IUPAC."
                                            },
                                            {
                                                "example_id": "8c4dc975-1e22-4de3-b430-ac3d12076587",
                                                "sense_id": "6f990a15-c9ae-3656-b4d0-ade8e09e9188",
                                                "text": "Researchers carefully choose the makeup of the beam and the target in hopes of producing a designer atom of the element desired. That’s how the four newest elements were created: nihonium (element 113), moscovium (115), tennessine (117) and oganesson (118) (SN Online: 11/30/16)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
