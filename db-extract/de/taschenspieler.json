                "senses": [
                    {
                        "sense_id": "3fcb7e00-6007-3093-be01-467f433a14e2",
                        "entry_id": "808a49b6-cfee-331d-95d9-77a88b660fdf",
                        "glosses": [
                            "Person, die mit großer Geschicklichkeit Tricks vorführt, bei denen zum Beispiel Dinge hervorgezaubert oder zum Verschwinden gebracht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a82d19ae-f5c4-4ed4-a4e4-3cfa2141aae3",
                                "sense_id": "3fcb7e00-6007-3093-be01-467f433a14e2",
                                "text": "„Er kam sich selbst vor wie ein Taschenspieler, der bei jedem seiner Kunststückchen fürchten muss, entlarvt zu werden.“"
                            },
                            {
                                "example_id": "9b15f49e-6bcd-432a-bd06-4f8123d4bf1a",
                                "sense_id": "3fcb7e00-6007-3093-be01-467f433a14e2",
                                "text": "„Madame Bordin saß regungslos da und riß die Augen auf wie bei Taschenspielern; Mélie lauschte hinter der Tür; Gorju sah ihnen in Hemdsärmeln durchs Fenster zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
