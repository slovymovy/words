    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04e0653a-86d0-398b-81d0-d168c31935e9",
                    "sense_definition": "Défaut moral ou mauvaise habitude persistante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moralite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeu d'argent est un dangereux <w>vice</w> qui peut détruire une famille entière."
                        },
                        {
                            "text": "Chacun a ses petits <w>vices</w>, comme fumer ou grignoter tard le soir."
                        }
                    ],
                    "synonyms": [
                        "défaut",
                        "travers"
                    ]
                },
                {
                    "sense_id": "f884e2eb-28bb-369f-b9a8-c42bc4ccb63e",
                    "sense_definition": "Disposition générale et habituelle au mal, opposée à la vertu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moralite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le roman met en scène l'éternel combat entre le <w>vice</w> et la vertu."
                        },
                        {
                            "text": "Il est tombé dans le <w>vice</w> après avoir rencontré de mauvaises fréquentations en ville."
                        }
                    ],
                    "synonyms": [
                        "immoralité"
                    ],
                    "antonyms": [
                        "vertu"
                    ],
                    "common_phrases": [
                        "tomber dans le vice"
                    ]
                },
                {
                    "sense_id": "1b98aeaf-2e76-350a-a7ed-54bc33a80bed",
                    "sense_definition": "Défaut ou imperfection grave qui rend une chose impropre à son usage normal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'acheteur a annulé la vente de la maison en raison d'un <w>vice</w> caché."
                        },
                        {
                            "text": "Le juge a rejeté la plainte à cause d'un important <w>vice</w> de forme."
                        }
                    ],
                    "synonyms": [
                        "défectuosité",
                        "imperfection"
                    ],
                    "common_phrases": [
                        "vice caché",
                        "vice de forme",
                        "vice de fabrication",
                        "vice de construction"
                    ]
                },
                {
                    "sense_id": "6e6ab1e5-0dfb-3e02-8fad-019ac9527451",
                    "sense_definition": "Débauche, libertinage ou recherche effrénée de plaisirs sensuels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moralite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce quartier était autrefois célèbre pour ses lieux de <w>vice</w> et de débauche."
                        },
                        {
                            "text": "Il mène une existence dissolue, croupissant dans le <w>vice</w> et les excès."
                        }
                    ],
                    "synonyms": [
                        "débauche",
                        "dépravation",
                        "libertinage"
                    ],
                    "common_phrases": [
                        "croupir dans le vice"
                    ]
                },
                {
                    "sense_id": "8ebb7cfe-317a-3776-90dc-694e2d9f1af1",
                    "sense_definition": "Goût dépravé ou perversion du comportement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moralite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prendre plaisir à faire souffrir autrui relève d'un pur <w>vice</w> psychologique."
                        },
                        {
                            "text": "Le détective tenta de comprendre les <w>vices</w> obscurs du criminel."
                        }
                    ],
                    "synonyms": [
                        "perversité",
                        "perversion"
                    ]
                }
            ]
        },
        {
