        "pl-extract.jsonl": [
            {
                "entry_id": "9dd3880f-dfa7-3131-9502-a3f5b8f9a584",
                "word": "interesująco",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5476ca85-04e0-35c8-b547-cdc153553426",
                        "entry_id": "9dd3880f-dfa7-3131-9502-a3f5b8f9a584",
                        "glosses": [
                            "w sposób zajmujący, ciekawie, pociągająco"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "937f21d1-22a0-404a-bb66-c1f7d451d4b1",
                                "sense_id": "5476ca85-04e0-35c8-b547-cdc153553426",
                                "text": "Wczoraj, para ta obsadzona była nader interesująco, gdyż grało ją dwoje aktorów bardzo młodych, którzy wnieśli na scenę świeżość tej młodości, umiejąc równocześnie, dzięki temperamentowi „aktorskich dzieci”, pokonać w znacznej mierze czyhające w takich razach niedoświadczenie i tremę"
                            },
                            {
                                "example_id": "fef89d65-d39b-4ae2-9979-f847ea55f0c0",
                                "sense_id": "5476ca85-04e0-35c8-b547-cdc153553426",
                                "text": "[Klementyna] Hoffmanowa miała wielki dar narracji. Mówiła nadzwyczaj interesująco, potoczyście, barwnie, okraszając relacje żartami, ciętym dowcipem"
                            },
                            {
                                "example_id": "b622a07f-608b-4022-8dfa-a6b87cff7eff",
                                "sense_id": "5476ca85-04e0-35c8-b547-cdc153553426",
                                "text": "Niektórym nauczycielom wydaje się, że prowadzą bardzo interesująco lekcje urozmaicając je dodatkowymi referatami, czy innymi pracami, które uczniowie muszą oczywiście zrobić w domu"
                            },
                            {
                                "example_id": "62238b4f-2357-48fe-ae3e-2fb285799f4e",
                                "sense_id": "5476ca85-04e0-35c8-b547-cdc153553426",
                                "text": "Chociaż budynek niezwykle interesująco wygląda na zewnątrz, to jednak największy podziw wywołuje bogactwo wnętrza — powiedział Marek Modrzejewski, starosta tczewski"
                            },
                            {
                                "example_id": "5b39b268-a6ce-481b-9527-8d1acf88835f",
                                "sense_id": "5476ca85-04e0-35c8-b547-cdc153553426",
                                "text": "Na piętrze znajduje się sala balowa z ozdobnym stropem. Obiekt interesująco prezentuje się nocą, gdyż posiada iluminację"
                            },
                            {
                                "example_id": "829d7f9c-e2d5-4358-9e17-66ec77710500",
                                "sense_id": "5476ca85-04e0-35c8-b547-cdc153553426",
                                "text": "Interesująco zapowiadają się pokazy szermierki z udziałem muszkieterów oraz walki rycerskie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
