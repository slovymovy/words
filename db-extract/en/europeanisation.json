                "senses": [
                    {
                        "sense_id": "5882f750-71be-39aa-a461-7d4c13097b50",
                        "entry_id": "bd5afcba-2c43-30fc-85bd-840838e21f85",
                        "glosses": [
                            "The process whereby the people and institutions of the countries of the European Union become more European and less national."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "becfcf54-6675-47d6-b6e8-da7f1322ca8d",
                        "source_entry_id": "bd5afcba-2c43-30fc-85bd-840838e21f85",
                        "source_sense_id": "5882f750-71be-39aa-a461-7d4c13097b50",
                        "source_sense_description": "assimilation",
                        "target_lang_word": "européanisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "européanisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67c760e0-8352-3396-94b7-c530c7e5be15",
                                        "entry_id": "97a17f5f-1962-34bf-aa30-cec52df53b1a",
                                        "glosses": [
                                            "Influence culturelle des métropoles européennes sur les cultures de leurs colonies. Adoption des pratiques culturelles européennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40244c21-1912-4802-a231-6800e9eeb719",
                                                "sense_id": "67c760e0-8352-3396-94b7-c530c7e5be15",
                                                "text": "L’européanisation des sociétés indigènes d'Amérique du Sud marqua le continent à jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b1587f5-ebb6-3cdb-9d41-516a6a1dd4c8",
                                        "entry_id": "97a17f5f-1962-34bf-aa30-cec52df53b1a",
                                        "glosses": [
                                            "Intégration des principes et des directives de la Communauté européenne ou de l'Union européenne au sein des États qui la composent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf24dd15-b4ab-42ad-bfba-997f59462248",
                                                "sense_id": "9b1587f5-ebb6-3cdb-9d41-516a6a1dd4c8",
                                                "text": "L’européanisation des services publics."
                                            },
                                            {
                                                "example_id": "1fa90774-044c-43f0-b7a7-aae6e9ab8e41",
                                                "sense_id": "9b1587f5-ebb6-3cdb-9d41-516a6a1dd4c8",
                                                "text": "On peut être en présence d’une européanisation des moyens des politiques publiques qu’ils soient juridiques ou matériels, comme l’européanisation de la politique de sécurité intérieure ou de la politique d’immigration."
                                            },
                                            {
                                                "example_id": "d39c64a9-494a-4d78-ac7e-e6a8db9d803c",
                                                "sense_id": "9b1587f5-ebb6-3cdb-9d41-516a6a1dd4c8",
                                                "text": "« L’ européanisation [des campagnes électorales] est nécessaire et positive », a déclaré Philipp Schulmeister, directeur des campagnes au Parlement européen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
