                        "cross_references": [
                            {
                                "target_word": "тубероза",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5e613fe6-d8f1-35a9-a34c-3db11c967855",
                                        "entry_id": "a12238b4-904e-3fe9-9ce5-fbb100726e5f",
                                        "glosses": [
                                            "многолетнее травянистое декоративное растение (лат. Polianthes tuberosa) семейства спаржевых с душистыми белыми, собранными в кисть цветками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f886a05-e6cc-4f88-8c22-1e70936760b0",
                                                "sense_id": "5e613fe6-d8f1-35a9-a34c-3db11c967855",
                                                "text": "Но всё-таки любимый мой цветок — тубероза. Он меня опьяняет, точно гашиш... Когда я слишком долго слышу его аромат, мной овладевают какие-то необъяснимые, чудные галлюцинации... Потом, конечно, наступает головная боль."
                                            },
                                            {
                                                "example_id": "bda8cec6-ac5e-4253-8b62-9054a3488faa",
                                                "sense_id": "5e613fe6-d8f1-35a9-a34c-3db11c967855",
                                                "text": "От её черного платья повеяло страшным ароматом туберозы, веянием благоуханного, холодного тления."
                                            },
                                            {
                                                "example_id": "6411ef0e-f0ff-49bf-886c-9a50f00cb780",
                                                "sense_id": "5e613fe6-d8f1-35a9-a34c-3db11c967855",
                                                "text": "Широко растопыренными пальцами он держал громадный букет одуряющих тубероз, преподнесенный женой английского губернатора."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
