                "senses": [
                    {
                        "sense_id": "38395030-dc86-3bd0-9076-d1e365989651",
                        "entry_id": "3ef79c2d-4c74-380f-b112-2ac3cb5ed567",
                        "glosses": [
                            "Faire perdre son caractère cérémoniel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ada58ac-d830-481a-8a8d-ef753456eb60",
                                "sense_id": "38395030-dc86-3bd0-9076-d1e365989651",
                                "text": "Toutefois cette capacité s’affaiblit dès les années 1730-1740, où la monarchie cherche d’une part à personnaliser les députations marchandes auprès d’elle (non plus avec des jurés élus temporaires, mais avec des conseillers viagers), ce qui est un moyen de les décérémonialiser, et d’autre part à déporter ce lien au commerce hors de la question des droits, de leur protection et reconduction."
                            },
                            {
                                "example_id": "baf40d2d-9e00-4523-9deb-c2607047b41d",
                                "sense_id": "38395030-dc86-3bd0-9076-d1e365989651",
                                "text": "Jamais il n'est question de hips, toujours de fraternité, de relation post-travail, de partage le plus possible décérémonialisé, et hop."
                            },
                            {
                                "example_id": "f3d07a6f-6ef0-4d32-ba27-f67e4ffcd7ad",
                                "sense_id": "38395030-dc86-3bd0-9076-d1e365989651",
                                "text": "Le despote éclairé providentiel accordant les libertés indispensables ou rénovant la religion dédogmatisée et décérémonialisée."
                            }
                        ]
                    }
                ],
