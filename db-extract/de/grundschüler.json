                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da2742e7-da53-4d92-bede-41fc7e82a22a",
                                "sense_id": "42de18b8-1765-3e9b-92ba-fddf52ea50e0",
                                "text": "Bereits als Grundschüler wies er Verhaltensauffälligkeiten auf, heute weiß man, dass er an einer Persönlichkeitsstörung leidet."
                            },
                            {
                                "example_id": "41ee13ba-9ba4-4fe5-9e36-2e3dd3243ce5",
                                "sense_id": "42de18b8-1765-3e9b-92ba-fddf52ea50e0",
                                "text": "„Ich glaube, das Lied ist nicht mehr politisch korrekt, heutige Grundschüler müssen es wohl nicht mehr singen.“"
                            }
                        ],
