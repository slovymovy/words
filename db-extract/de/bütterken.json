                        ],
                        "form": "die Bütterken"
                    },
                    {
                        "form_id": "70f495ac-f727-41ba-86ca-0c1976f3e917",
                        "entry_id": "44a1baf6-2863-3bf4-b96e-ad9dc22909e2",
                        "tags": [
                            "accusative",
