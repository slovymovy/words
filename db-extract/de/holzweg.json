                "senses": [
                    {
                        "sense_id": "22f098a0-1f62-3826-8a67-bb4ea44125a0",
                        "entry_id": "769be2f5-551b-3f30-ac16-aa700a9b69de",
                        "glosses": [
                            "ein Weg, der primär dem Abtransport von Holz dient und der häufig unvermittelt im Wald endet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94168107-4b5f-4769-9ace-67cbb9f46fcb",
                                "sense_id": "22f098a0-1f62-3826-8a67-bb4ea44125a0",
                                "text": "„In Todtnauberg wurde das Gespräch fast stets auf längeren Spaziergängen fortgeführt, […]. So führte er mich einen Waldweg, der abnahm und mitten im Wald an einer Stelle aufhörte, wo aus dichtem Moos Wasser austrat. Ich sagte: „Der Weg hört auf.“ Er sah mich pfiffig an und sagte: „Das ist der Holzweg. Er führt zu den Quellen.““"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ea59bdd-0a63-30ee-8dfd-09af86d37889",
                        "entry_id": "769be2f5-551b-3f30-ac16-aa700a9b69de",
                        "glosses": [
                            "irrige oder falsche Vorstellung, die zu keinem Ziel oder in eine Sackgasse führt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "2cff5528-383e-4e3d-a4d9-123fea5bfd0c",
                                "sense_id": "9ea59bdd-0a63-30ee-8dfd-09af86d37889",
                                "text": "„In Todtnauberg wurde das Gespräch fast stets auf längeren Spaziergängen fortgeführt, […]. So führte er mich einen Waldweg, der abnahm und mitten im Wald an einer Stelle aufhörte, wo aus dichtem Moos Wasser austrat. Ich sagte: „Der Weg hört auf.“ Er sah mich pfiffig an und sagte: „Das ist der Holzweg. Er führt zu den Quellen.““"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
