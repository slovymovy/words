                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reactie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn hond at mijn huiswerk op. — Ja, <w>vast</w>!",
                            "target_lang_translations": {
                                "en": "My dog ate my homework. — Yeah, <w>right</w>!"
                            }
                        },
                        {
                            "text": "Hij zegt dat hij miljonair is. — Ja, <w>vast</w>, dat geloof ik niet.",
                            "target_lang_translations": {
                                "en": "He says he is a millionaire. — Yeah, <w>sure</w>, I don't believe that."
                            }
