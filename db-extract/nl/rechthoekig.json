                                        "sense_id": "83206436-aa7d-31b3-9050-676074ccc44e",
                                        "entry_id": "e28e9aaf-7b3b-311a-ad50-264e3c168f21",
                                        "glosses": [
                                            "Exactly upright; extending in a straight line toward the centre of the earth, etc."
