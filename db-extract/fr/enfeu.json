                "senses": [
                    {
                        "sense_id": "640f60db-340d-3a38-a538-93c4dc82e02e",
                        "entry_id": "c3273d54-0205-31a0-8f2c-bb00050440c7",
                        "glosses": [
                            "Niche dans un édifice religieux abritant un tombeau, un sarcophage ou une scène funéraire."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "2af81bc6-e0d2-4741-ad38-00d2da69bb7f",
                                "sense_id": "640f60db-340d-3a38-a538-93c4dc82e02e",
                                "text": "Leurs funérailles [celles des élites] présentent un caractère ostentatoire évident : ce sont les seules à être enterrées dans des cercueils en plomb, dans des endroits stratégiques (chœur de l’église, sous le tableau miraculeux de la Vierge, etc.), avec des architectures funéraires particulières (enfeu, gisant, etc.)."
                            },
                            {
                                "example_id": "0f00864e-fc36-4fb3-be7e-133cc74a886f",
                                "sense_id": "640f60db-340d-3a38-a538-93c4dc82e02e",
                                "text": "Aucun texte ne précise si les gisants arrivèrent d’Italie avant que la décoration de l’enfeu ne soit commencée."
                            }
                        ]
                    }
                ],
