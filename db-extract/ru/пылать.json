                    {
                        "form_id": "b2abd895-f524-4bc2-a1e4-e6e9a4c92e05",
                        "entry_id": "1ded7e76-80f8-3d85-80ba-160b4620e438",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "пыла́вши"
                    },
                    {
                        "form_id": "8add9e05-945e-4d38-8def-9cff177e6087",
                        "entry_id": "1ded7e76-80f8-3d85-80ba-160b4620e438",
