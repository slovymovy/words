                        ]
                    },
                    {
                        "translation_id": "d7760854-c889-484d-acbd-80e5e709b267",
                        "source_entry_id": "af0d2801-2e6e-3294-8ca0-20959b1c839d",
                        "source_sense_id": "18c37b11-7378-39a4-bd37-3bc17eeea3ad",
                        "target_lang_word": "нюх",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нюх",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "46a1c528-8dd4-3a47-b1f8-ba90145a7450",
                                        "entry_id": "71aaff74-c612-355d-bff8-9af7ce3beb2f",
                                        "glosses": [
                                            "разг. то же, что обоняние"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a9f2cd-5e24-41b7-bc62-354b231d1ad7",
                                                "sense_id": "46a1c528-8dd4-3a47-b1f8-ba90145a7450",
                                                "text": "Одним из главных выдающихся качеств собаки является безупречный нюх."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cac26ba-58ba-38a0-a479-438638d5867d",
                                        "entry_id": "71aaff74-c612-355d-bff8-9af7ce3beb2f",
                                        "glosses": [
                                            "перен. интуиция; способность предчувствовать, предугадывать, распознавать что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3873ac0-f54b-4bc4-a29c-42a0a39bd9ce",
                                                "sense_id": "9cac26ba-58ba-38a0-a479-438638d5867d",
                                                "text": "Нюхом чую — там засада!"
                                            },
                                            {
                                                "example_id": "086e2a9d-b103-4f4c-bf7b-9bd380c94c34",
                                                "sense_id": "9cac26ba-58ba-38a0-a479-438638d5867d",
                                                "text": "Если вы работаете давно, то у вас уже должен появиться нюх на проблемы."
                                            },
                                            {
                                                "example_id": "97e23849-b96f-4520-8a02-308b657d50d2",
                                                "sense_id": "9cac26ba-58ba-38a0-a479-438638d5867d",
                                                "text": "Неразберихи, разброда было уже много и в начале рейда, карты, да и те допотопные, перекалькированные ещё с карт империалистической войны, были лишь у командиров соединений и полков, эскадронным карт не досталось. Они особо и не горевали, заверяя, что и по нюху всё «зроблят як трэба»."
                                            },
                                            {
                                                "example_id": "39db2ca3-69f8-45b2-9053-8c202cfeb364",
                                                "sense_id": "9cac26ba-58ba-38a0-a479-438638d5867d",
                                                "text": "Старая лиса с опытом и нюхом догадалась, конечно, что у «Мосберт холдингс» другой хозяин, дёргающий за нитки подставного Ли Тео Ленга."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
