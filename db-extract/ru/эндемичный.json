                                        "glosses": [
                                            "die Endemie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88bf328c-a74d-4c1a-998f-960d33d5defc",
                                                "sense_id": "f652d05b-c3cc-338f-b190-20e8258ffdea",
                                                "text": "[Coronapandmie 2022:] „»Wenn man konstatieren kann, dass Sars-CoV-2 ein endemisches Virus ist, dann werden wir damit so umgehen wie mit anderen Erkrankungen.«“"
                                            },
                                            {
                                                "example_id": "1d40d2b9-9edb-4bde-bb08-082f5d1a2f15",
                                                "sense_id": "f652d05b-c3cc-338f-b190-20e8258ffdea",
                                                "text": "Malaria ist in vielen Ländern Afrikas eine endemische Krankheit."
                                            },
                                            {
                                                "example_id": "3e6d7299-99cb-4e96-ba43-0e887133f9aa",
                                                "sense_id": "f652d05b-c3cc-338f-b190-20e8258ffdea",
                                                "text": "[COVID-19-Pandemie 01/2021:] „»Ich erwarte für dieses SARS-2-Virus schon – wie viele andere Wissenschaftler auch -, dass es endemisch wird, dass es also bleibt.«“"
                                            },
                                            {
                                                "example_id": "87d31b07-5e02-45a9-8922-0eb848b2f3dd",
                                                "sense_id": "f652d05b-c3cc-338f-b190-20e8258ffdea",
                                                "text": "[Coronapandmie 2022:] „»Bei endemischen Viren infiziert man sich erstmals in der Kindheit, da ist die Immunreaktion anders.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41d30136-eca9-3055-b122-af538ae37328",
                                        "entry_id": "20a7b174-7ea6-38d7-ad2e-008b0d2dc23e",
                                        "glosses": [
                                            "ausschließlich in einem bestimmten Gebiet vorkommend"
                                        ],
