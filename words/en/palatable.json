{
    "word_family": [
        "palate",
        "palatability"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "684d81b4-0f6c-3ba5-9c5f-d3769b1b760e",
                    "sense_definition": "Pleasing to the taste; tasty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For some, instant noodles make a <w>palatable</w>, if not especially nutritious, meal.",
                            "target_lang_translations": {
                                "ru": "Для некоторых лапша быстрого приготовления — это <w>вполне съедобная</w>, пусть и не особо питательная пища."
                            }
                        },
                        {
                            "text": "The chef prepared a <w>palatable</w> dish using only fresh and local ingredients.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил <w>вкусное</w> блюдо, используя только свежие местные продукты."
                            }
                        }
                    ],
                    "synonyms": [
                        "appetizing",
                        "delicious",
                        "tasty",
                        "savory"
                    ],
                    "antonyms": [
                        "unpalatable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятный на вкус; аппетитный или съедобный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкусный",
                                "target_lang_sense_clarification": "о еде или напитках"
                            },
                            {
                                "target_lang_word": "приятный на вкус",
                                "target_lang_sense_clarification": "доставляющий удовольствие вкусовым рецепторам"
                            },
                            {
                                "target_lang_word": "аппетитный",
                                "target_lang_sense_clarification": "вызывающий аппетит"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daee2c48-69fa-3f1a-80dc-0bab535b5b3f",
                    "sense_definition": "Tolerable or acceptable to someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "acceptability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The proposed agreement was <w>palatable</w> to both sides of the negotiation.",
                            "target_lang_translations": {
                                "ru": "Предложенное соглашение оказалось <w>приемлемым</w> для обеих сторон переговоров."
                            }
                        },
                        {
                            "text": "The new policy was not <w>palatable</w> to the employees who feared losing their jobs.",
                            "target_lang_translations": {
                                "ru": "Новые правила были <w>не по душе</w> сотрудникам, опасавшимся потерять работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "acceptable",
                        "tolerable",
                        "satisfactory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приемлемый, терпимый или устраивающий кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приемлемый",
                                "target_lang_sense_clarification": "подходящий, годный для принятия"
                            },
                            {
                                "target_lang_word": "терпимый",
                                "target_lang_sense_clarification": "сносный, допустимый"
                            },
                            {
                                "target_lang_word": "удобоваримый",
                                "target_lang_sense_clarification": "в переносном смысле: легкий для восприятия или принятия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}