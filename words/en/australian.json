                    "sense_id": "bac1334f-acaf-3a03-ab87-3e6a6b3b3ffd",
                    "sense_definition": "Relating to Australia, its people, or its culture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves the unique animals found in the <w>Australian</w> outback.",
                            "target_lang_translations": {
                                "ru": "Она любит уникальных животных, обитающих в <w>австралийском</w> аутбэке.",
                                "zh": "她很喜欢在<w>澳大利亚</w>内陆发现的独特动物。"
                            }
                        },
                        {
                            "text": "He speaks with a strong <w>Australian</w> accent.",
                            "target_lang_translations": {
                                "ru": "Он говорит с сильным <w>австралийским</w> акцентом.",
                                "zh": "他说话带着浓重的<w>澳大利亚</w>口音。"
                            }
                        }
