                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5b98500-c439-319a-a8af-9abadd4860aa",
                        "entry_id": "dc320065-6b0f-3021-9b8c-a38d4be594ac",
                        "glosses": [
                            "bekken met een ondoorlaatbare bodem waarin water opgeslagen kan worden"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "6d0871f1-a767-4409-86b1-f0e46444bf9f",
                                "sense_id": "c5b98500-c439-319a-a8af-9abadd4860aa",
                                "text": "Het bassin moet weer schoongemaakt worden."
                            },
                            {
                                "example_id": "a2c7d0b1-de51-4d46-bf48-9a26f5a70df9",
                                "sense_id": "c5b98500-c439-319a-a8af-9abadd4860aa",
                                "text": "In het zwakke licht uit één enkel raam vlak tegen het plafond zag ik een ondiep bassin vol water, maar de rest van de ruimte was donker."
                            },
                            {
                                "example_id": "e10e96b2-f504-4821-9926-ffd601b0e0a7",
                                "sense_id": "c5b98500-c439-319a-a8af-9abadd4860aa",
                                "text": "Jonge zeehonden: Ollie en Brandy zijn allebei nog jonge zeehonden. Ollie werd half januari gevonden op Schiermonnikoog, pas tien dagen oud, met een abces op zijn rug. Brandy kwam begin maart van Terschelling, met diepe wonden aan zijn flippers. Beiden waren na weken van verzorging gisteren weer fit genoeg om terug te keren naar zee. Ze werden uit hun bassin in Pieterburen gehaald, in kisten gedaan en naar Lauwersoog vervoerd. Vanaf daar voeren ze met de boot naar een zandplaat bij Schiermonnikoog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d79f4749-32ab-4acd-8ac5-90ec59fbcaee",
                        "source_entry_id": "dc320065-6b0f-3021-9b8c-a38d4be594ac",
                        "source_sense_id": "c5b98500-c439-319a-a8af-9abadd4860aa",
                        "source_sense_description": "bekken met een ondoorlaatbare bodem waarin water opgelagen kan worden",
                        "target_lang_word": "Bassin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bassin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc854f99-fa8c-3a1c-929b-2ee50ce35d7b",
                                        "entry_id": "de0eb1d9-6187-3524-8af9-12a4d4eee6fc",
                                        "glosses": [
                                            "künstlich angelegtes Wasserbecken oder Schwimmbecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a41d3a0-a43d-4671-90e7-e435e2861583",
                                                "sense_id": "fc854f99-fa8c-3a1c-929b-2ee50ce35d7b",
                                                "text": "Der Fürst legte hier einen großzügigen Garten mit einem Bassin an."
                                            },
                                            {
                                                "example_id": "22bb9e52-b3be-4371-b22b-7c29f2670132",
                                                "sense_id": "fc854f99-fa8c-3a1c-929b-2ee50ce35d7b",
                                                "text": "Im Bassin schwammen Enten und koteten ins Wasser."
                                            },
                                            {
                                                "example_id": "76bc35ec-4506-4d90-b803-0138a64f9548",
                                                "sense_id": "fc854f99-fa8c-3a1c-929b-2ee50ce35d7b",
                                                "text": "„Die Wasserversorgung der Tiere erfolgte in der Art, dass aus einem Wasserbassin im Wald Wasser mit Hilfe einer elektrischen Pumpe in ein weiteres Bassin gepumpt wurde.“"
                                            },
                                            {
                                                "example_id": "7cc702cf-700a-47b8-a976-dac5c7ea2c5d",
                                                "sense_id": "fc854f99-fa8c-3a1c-929b-2ee50ce35d7b",
                                                "text": "„Ich setze mich auf den Rand des Bassins im Jardin du Luxembourg, starre auf die hohen undurchsichtigen Fenster des Palais und tröste mich mit einem Schinkenbrot.“"
                                            },
                                            {
                                                "example_id": "14432c71-0564-442f-9f06-2a655e84ee5a",
                                                "sense_id": "fc854f99-fa8c-3a1c-929b-2ee50ce35d7b",
                                                "text": "„Er wanderte um das Bassin herum, an dem Pavillon vorbei, zu den Gefangenen zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c7248a1-d199-3dcb-a731-8b4a71ccbb11",
                                        "entry_id": "de0eb1d9-6187-3524-8af9-12a4d4eee6fc",
                                        "glosses": [
                                            "Becken, Bucht"
                                        ],
                                        "tags": [
                                            "geography",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8227c93-9dd0-4a1c-bfb7-be604e6f0937",
                                                "sense_id": "6c7248a1-d199-3dcb-a731-8b4a71ccbb11",
                                                "text": "„der Hafen war in dem natürlichen Bassin der Flußmündung angelegt worden“"
                                            },
                                            {
                                                "example_id": "85b747c7-2c18-47f3-98c1-d90674998002",
                                                "sense_id": "6c7248a1-d199-3dcb-a731-8b4a71ccbb11",
                                                "text": "„Er stieß auf einen Bach, der sich an einer Stelle zu einem Bassin staute, groß genug für ein Bad.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "758f282f-a7ea-4457-bfce-1aa8e707a73a",
                        "source_entry_id": "dc320065-6b0f-3021-9b8c-a38d4be594ac",
