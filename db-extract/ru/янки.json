                        "examples": [
                            {
                                "example_id": "38251f0d-c67e-4d98-b150-366bf27bdf0a",
                                "sense_id": "f68bc59a-ee52-3f03-85d7-b88528842129",
                                "text": "А янки в это время пусть чуточек потрепещут."
                            },
                            {
                                "example_id": "c8d8573e-f14d-4a3c-87bf-a3f1f0b87faa",
                                "sense_id": "f68bc59a-ee52-3f03-85d7-b88528842129",
                                "text": "Значит, ты альтруист, хоть и стопроцентный янки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79f2893c-0aa6-42fa-8dbb-5ca32bf00024",
                        "source_entry_id": "7cf76038-a142-3a31-bb28-fabd478f521e",
