                                        "examples": [
                                            {
                                                "example_id": "4afa7890-43a2-44ed-912e-4618746c3ddc",
                                                "sense_id": "e4f8ae2f-0bf4-3dc4-aba5-1b3151b86d2a",
                                                "text": "De toon “bis” klinkt in de getempereerde stemming gelijk aan de toon “c”."
