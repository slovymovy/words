                        "glosses": [
                            "To do hastily, imperfectly, or sloppily."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de195ad-ad3e-4556-8355-bfd6c146eabe",
                                "sense_id": "569f4fe0-92c7-3197-9593-cbfb7ece0a3b",
                                "text": "[…] he [Antonio] answered, do not so,\n Slubber not business for my sake, Bassanio,\n But stay the very riping of the time"
                            }
                        ]
                    },
                    {
                        "sense_id": "14a34619-53d6-3e52-80ec-800c75fb5f55",
                        "entry_id": "787b253b-7f4f-3423-9942-e07b20a1723f",
                        "glosses": [
                            "To daub; to stain; to cover carelessly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e11fc02-7d84-454d-89f2-fab9d778e6ce",
                                "sense_id": "14a34619-53d6-3e52-80ec-800c75fb5f55",
                                "text": "There is no art that hath more […] slubbered with aphorisming pedantry than the art of policy."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa89d546-9fb1-30fd-a811-ea72528f9ec5",
                        "entry_id": "787b253b-7f4f-3423-9942-e07b20a1723f",
                        "glosses": [
                            "To slobber."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4d0ef93-2a05-46ca-9076-995e7cb0c48e",
                                "sense_id": "fa89d546-9fb1-30fd-a811-ea72528f9ec5",
                                "text": "It grows colder, and grayer, and penguins cry in the night, and huge amphibians moan and slubber."
                            }
                        ]
                    }
