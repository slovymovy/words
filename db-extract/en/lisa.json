                    }
                ],
                "senses": [
                    {
                        "sense_id": "53eb07d6-de76-3ef0-a731-fef0e3784cc0",
                        "entry_id": "eb03b452-601e-3ca0-bec8-72da841377f1",
                        "glosses": [
                            "A female given name from Hebrew."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3060cfb5-d0bf-468a-96e3-63c64f87ed55",
                                "sense_id": "53eb07d6-de76-3ef0-a731-fef0e3784cc0",
                                "text": "You were born in the '70s? Were you named after Lisa on As the World Turns?"
                            },
                            {
                                "example_id": "d2029922-2311-443f-b6c2-6dcda676b5f3",
                                "sense_id": "53eb07d6-de76-3ef0-a731-fef0e3784cc0",
                                "text": "Elizabeth coloured.\n\"Oh, I don't want the doll called after me, if that is what you mean,\" she said, rather disdainfully.\n\"Nonsense, Lisa!\" laughed her father, \"you ought to consider yourself highly honoured to have such a handsome lady as this for your namesake.\""
                            },
                            {
                                "example_id": "ceefce15-a7b9-48d5-bad6-f2f66b991411",
                                "sense_id": "53eb07d6-de76-3ef0-a731-fef0e3784cc0",
                                "text": "Lisa is a better name. Claudia bangs, like the gong in the hall at Sotleigh. Bang - whoom! Lisa makes a nice silky noise, like streams or rain."
                            },
                            {
                                "example_id": "11462a63-823e-480f-9bfa-242a59dfe650",
                                "sense_id": "53eb07d6-de76-3ef0-a731-fef0e3784cc0",
                                "text": "Did I want to be burdened with a common name? Be the third Lisa and fourth Susan in my classroom? Darleen or Doreen or Maureen?\nI did."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47faa712-f112-4a9d-83a5-5bb11c9c78e3",
                        "source_entry_id": "eb03b452-601e-3ca0-bec8-72da841377f1",
                        "source_sense_id": "53eb07d6-de76-3ef0-a731-fef0e3784cc0",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Lise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lise",
