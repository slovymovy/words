                                        "glosses": [
                                            "Por antonomasia, cooperar a que alguno salga de una situación dificultosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83892fb6-dfe3-4d39-8ee8-e208d3851712",
                                                "sense_id": "075899fc-a128-31d6-9af6-6dc9a70f5213",
                                                "text": "Cómo el rey don Pedro se fue del reyno, buscando quien le ayudase, por quanto la mayor parte de los cavalleros de Castilla se alçavan contra él."
                                            }
