                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd3d01fa-dbc3-4c0c-b017-0f5e54143afd",
                        "source_entry_id": "40de74b6-05bd-33d8-adbd-6df8b0c2f210",
                        "source_sense_id": "2177b376-a793-3cca-8c09-2bf8e60c3c34",
                        "source_sense_description": "door dwang en drang",
                        "target_lang_word": "compulsory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compulsory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                        "entry_id": "166aa45c-4139-38f1-b071-16f15117683a",
                                        "glosses": [
                                            "Required; obligatory; mandatory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89febfa4-dae1-4fea-8814-61c2e498e9e0",
                                                "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                                "text": "Some might agree that membership in the firm is perhaps more compulsory than membership in a municipality, but balk at applying the analogy to the nation."
                                            },
                                            {
                                                "example_id": "af3d4646-9027-45a5-a7f7-98549f2dfb3b",
                                                "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                                "text": "The ten-dollar fee was compulsory."
                                            },
                                            {
                                                "example_id": "0c570d26-afd5-4e51-af29-920f7fab5782",
                                                "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                                "text": "They are entirely private concerns, established by individual teachers, and attendance upon them is no more compulsory than attendance on our dispensaries."
                                            },
                                            {
                                                "example_id": "e340a4f8-4e97-4dfc-a451-670fcd567519",
                                                "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            },
                                            {
                                                "example_id": "a8fae3ad-fbdf-44b2-ac9a-0fe86db1ae66",
                                                "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                                "text": "I haven't booked, so I don't have a clue as to whether the service will be busy or not. Supposedly, reservations are compulsory, but I want to find out what would happen if you just turn up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6223e2a-a6fc-3a1c-b399-7041d71d0b0d",
                                        "entry_id": "166aa45c-4139-38f1-b071-16f15117683a",
                                        "glosses": [
                                            "Having the power of compulsion; constraining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "127ac167-5cf6-4503-a1ee-b4a5fe743426",
                                                "sense_id": "b6223e2a-a6fc-3a1c-b399-7041d71d0b0d",
                                                "text": "Such compulsory measures are limited."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compulsory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11f8c977-62e5-3dda-9382-9d00cefa24dd",
                                        "entry_id": "6408f332-1e94-31da-8bab-52b6348805fc",
                                        "glosses": [
                                            "Something that is compulsory or required."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e5128d-fb71-41ec-91e5-0df474d58a15",
                                                "sense_id": "11f8c977-62e5-3dda-9382-9d00cefa24dd",
                                                "text": "Delobel and Schoenfelder failed to win the free dance, but they had built a big lead in the compulsories and the original dance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
