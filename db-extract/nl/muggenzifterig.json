                "senses": [
                    {
                        "sense_id": "46ffbe50-f893-359b-b550-095385ce60b3",
                        "entry_id": "8a785c24-4772-37ee-992d-82d869e03025",
                        "glosses": [
                            "al te zeurderig en precies"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93696d1-edb3-4623-ba80-94ae365a0fa5",
                                "sense_id": "46ffbe50-f893-359b-b550-095385ce60b3",
                                "text": "En nu was Cameron er. Elke dag wist hij het zekerder; hij zag zichzelf in zijn gebaren en houdingen, herkende de energie en de passie. En elke dag werd de knoop van frustratie strakker en verstilde hem. Zijn zoon, maar niet zijn zoon. Niet op te eisen en zich nu van hem afkerend, muggenzifterig en opstandig."
                            },
                            {
                                "example_id": "6fe364fb-b7c3-47a9-8f6a-1931bf29ac1f",
                                "sense_id": "46ffbe50-f893-359b-b550-095385ce60b3",
                                "text": "\"Ik heb ook wel eens gedacht: nu gaat het te ver, er worden op alle slakken zout gelegd. Maar die fase ben ik nu allang weer gepasseerd. De KNVB heeft bepaalde dingen aangepast en verbeterd. Het is nu minder muggenzifterig.\""
                            }
                        ]
                    }
                ],
