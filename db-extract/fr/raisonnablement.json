        "fr-extract.jsonl": [
            {
                "entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
                "word": "raisonnablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f3cd9c61-892e-34a6-9c0b-4a7c2346a8b6",
                        "entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
                        "glosses": [
                            "Avec raison, conformément à la raison, à l’équité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2aa1d2e-7bd1-444e-95fc-75579e0e2244",
                                "sense_id": "f3cd9c61-892e-34a6-9c0b-4a7c2346a8b6",
                                "text": "Parler raisonnablement."
                            },
                            {
                                "example_id": "8bc37d2a-f30a-451a-b60a-8be209be9632",
                                "sense_id": "f3cd9c61-892e-34a6-9c0b-4a7c2346a8b6",
                                "text": "Toutes ces choses [les mouvements instinctifs] se font si raisonnablement, que la raison en excède notre pouvoir et en surpasse notre industrie,"
                            }
                        ]
                    },
                    {
                        "sense_id": "2e7b4146-4f94-3109-9892-bcc408bf61ac",
                        "entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
                        "glosses": [
                            "Suffisamment, convenablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e021b756-994c-466d-8922-7dbc5036f18f",
                                "sense_id": "2e7b4146-4f94-3109-9892-bcc408bf61ac",
                                "text": "J'espère qu’elle se trouvera assez raisonnablement logée,"
                            },
                            {
                                "example_id": "301ca7ce-346c-4253-896e-873f0552e8cd",
                                "sense_id": "2e7b4146-4f94-3109-9892-bcc408bf61ac",
                                "text": "Karpos le jardinier : J'aime Dieu de tout mon cœur, et je vends mes légumes fort raisonnablement,"
                            },
                            {
                                "example_id": "3b4757e5-0856-4dc8-93ce-4b3de5abc8d1",
                                "sense_id": "2e7b4146-4f94-3109-9892-bcc408bf61ac",
                                "text": "Ce poulet nous fit dire mille choses très spirituelles que j’ai oubliées et je fus enchanté qu’on ne l’eût pas raisonnablement rôti."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d2daae3-48db-333b-ae7b-b59e2950fd0a",
                        "entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
                        "glosses": [
                            "Passablement, ou d’une manière au-dessus du médiocre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "563c82fa-af91-4c84-a284-b0fe42dbb9a7",
                                "sense_id": "8d2daae3-48db-333b-ae7b-b59e2950fd0a",
                                "text": "Il y avait une maison assez commode, un beau jardin et une cour raisonnablement grande, dans laquelle était une citerne profonde dont on ne se servait plus."
                            },
                            {
                                "example_id": "00d449ba-50ed-4535-ba7d-9fa5355b1512",
                                "sense_id": "8d2daae3-48db-333b-ae7b-b59e2950fd0a",
                                "text": "Comblé de trésors dont il ne savait que faire, et raisonnablement chargé de la haine publique,"
                            },
                            {
                                "example_id": "251fde83-a4c9-4f58-a90e-6f637681375a",
                                "sense_id": "8d2daae3-48db-333b-ae7b-b59e2950fd0a",
                                "text": "Comme la correspondance était très étendue et qu’on était en temps de guerre, je ne laissais pas que d’être occupé raisonnablement,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf07b0f2-abad-4c1c-95ff-9300252cc897",
                        "source_entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
                        "target_lang_word": "fairly well",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c672758b-aa43-4a79-b0b5-eba66ff3993c",
                        "source_entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
                        "target_lang_word": "in moderation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in moderation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8990e5e-8efc-36a4-a37f-b13b36431231",
                                        "entry_id": "fd2ee7d6-6fd3-309d-a399-99eb2f0a2960",
                                        "glosses": [
                                            "In moderate quantities or amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78e4d9ca-4ed6-4a1a-bffe-3dbd953b3ba6",
                                                "sense_id": "c8990e5e-8efc-36a4-a37f-b13b36431231",
                                                "text": "There's nothing wrong with drinking coffee in moderation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d55b013-aad7-496d-ae8e-bca96ebe0a1a",
                        "source_entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
                        "target_lang_word": "moderately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moderately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8fa12cdf-1103-3d23-8e3e-8e6b4c20ba41",
                                        "entry_id": "72d87672-b63a-302b-8bee-4a470aa8b6fd",
                                        "glosses": [
                                            "In a moderate manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aac1c947-05ca-4b6f-9545-463f7fa6a322",
                                                "sense_id": "8fa12cdf-1103-3d23-8e3e-8e6b4c20ba41",
                                                "text": "During the debate, they disagreed plainly, but moderately."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79ff1777-61d0-3ada-adfa-779093fec388",
                                        "entry_id": "72d87672-b63a-302b-8bee-4a470aa8b6fd",
                                        "glosses": [
                                            "To a moderate extent or degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "834b6900-33c9-44ae-a650-a9d926e51104",
                                                "sense_id": "79ff1777-61d0-3ada-adfa-779093fec388",
                                                "text": "They were at least moderately happy with their bonuses."
                                            },
                                            {
                                                "example_id": "4869b474-6130-43b0-a524-5e5c86162a2a",
                                                "sense_id": "79ff1777-61d0-3ada-adfa-779093fec388",
                                                "text": "All in all, Harris staked out a moderately center-left position, not too different from President Biden’s original Build Back Better agenda, which he was able to implement only in part because in an evenly divided Senate, Joe Manchin had an effective veto."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d474db1-646b-49b0-9136-29a8078db6f1",
                        "source_entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
