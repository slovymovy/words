                "word": "Eurafrique",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d04f8be1-e54e-3152-959a-ae4700c02e1e",
                        "entry_id": "2aa32847-ed66-3a73-b719-98f5cde91024",
                        "glosses": [
                            "Ancient continent combinant l’Europe et l’Afrique."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "3067124a-14b1-44b9-a74d-1990b09be969",
                                "sense_id": "d04f8be1-e54e-3152-959a-ae4700c02e1e",
                                "text": "On peut dire, en général, que les plus anciens vestiges humains ont été découverts dans les mêmes régions que les vestiges les plus anciens des races de singes les plus élevées, c’est-à-dire dans l’ouest de l’Europe et le nord de l’Afrique, dans l’ancien continent de l’Eurafrique, comme l’appelle Brinton, partie occidentale de ce que plusieurs géologues modernes ont appelée l’Eurasie."
                            }
                        ]
                    },
                    {
                        "sense_id": "a10d3c40-506f-38d3-9995-a42fe2e17098",
                        "entry_id": "2aa32847-ed66-3a73-b719-98f5cde91024",
                        "glosses": [
                            "Espace géopolitique crée par les États de l’Europe et leurs colonies en Afrique ou, aujourd’hui, les États d’Afrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a9249e5-bf54-4315-9a78-2d060e617e4e",
                                "sense_id": "a10d3c40-506f-38d3-9995-a42fe2e17098",
                                "text": "L’idée d’Eurafrique s’apparente à un « instrument de pacification européenne »."
                            },
                            {
                                "example_id": "fd8e98a2-2ccd-4ec9-b7f7-8f8733bf4fc1",
                                "sense_id": "a10d3c40-506f-38d3-9995-a42fe2e17098",
                                "text": "Ce que veut faire la France avec l’Afrique, c’est préparer l’avènement de l’Eurafrique, ce grand destin commun qui attend l’Europe et l’Afrique."
                            }
                        ]
                    }
                ],
