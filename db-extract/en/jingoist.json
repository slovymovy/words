                    {
                        "form_id": "a66878c7-c9dd-4173-a193-6a76e67e4b35",
                        "entry_id": "180f0f2a-518f-3b36-825d-3f7947dd6d7f",
                        "tags": [
                            "plural"
                        ],
                        "form": "jingoists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dfba1b94-0982-36fc-866f-e16b69a1307d",
                        "entry_id": "180f0f2a-518f-3b36-825d-3f7947dd6d7f",
                        "glosses": [
                            "One who advocates an aggressive nationalism; one who vociferously supports a nation's military aims."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "863511b0-343a-4efe-8b09-15346dff9595",
                                "sense_id": "dfba1b94-0982-36fc-866f-e16b69a1307d",
                                "text": "The term \"jingoist;\" or its equivalent, was applied to Washington and Henry, to Jefferson and Jackson. It was applied to James G. Blaine, the typical American of his time -- a man from beneath whose very toe-nails enough intellect might be scraped to make an hundred Clevelands or McKinleys. All were jingoes in their day and generation, because all preferred the title of sovereign to that of subject..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2582d4f7-316b-4f37-8518-b4324a9e4104",
                        "source_entry_id": "180f0f2a-518f-3b36-825d-3f7947dd6d7f",
                        "source_sense_id": "dfba1b94-0982-36fc-866f-e16b69a1307d",
                        "source_sense_description": "one who advocates an aggressive nationalism, one who vociferously supports a nation's military aims",
                        "target_lang_word": "Hurrapatriot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7af370a3-c49f-4b5d-88c5-a95bb54fe765",
                        "source_entry_id": "180f0f2a-518f-3b36-825d-3f7947dd6d7f",
                        "source_sense_id": "dfba1b94-0982-36fc-866f-e16b69a1307d",
                        "source_sense_description": "one who advocates an aggressive nationalism, one who vociferously supports a nation's military aims",
                        "target_lang_word": "Chauvinist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chauvinist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d924e65f-854c-31c2-8647-2ff60d2c487e",
                                        "entry_id": "06061deb-837d-309c-880d-5ee12ff38f6a",
                                        "glosses": [
                                            "jemand mit extrem sexistischer Einstellung beziehungsweise übersteigertem Männlichkeitsgefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69fc35ea-8e0b-4fc5-a2e0-9fcf7da152dc",
                                                "sense_id": "d924e65f-854c-31c2-8647-2ff60d2c487e",
                                                "text": "Manchen Frauen gegenüber gibt er sich als echter Chauvinist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3be3568-9d84-3161-8a64-0dfdc1454702",
                                        "entry_id": "06061deb-837d-309c-880d-5ee12ff38f6a",
                                        "glosses": [
                                            "jemand mit exzessivem/übersteigertem Patriotismus oder Nationalismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "667d9e96-f3ef-4591-a285-38a8a9b38878",
                                                "sense_id": "f3be3568-9d84-3161-8a64-0dfdc1454702",
                                                "text": "„Bei diesem Thema liebte er es übrigens, den Chauvinisten zu spielen; natürlich nicht aus Überzeugung, sondern aus Lust am größtmöglichen Umtriebe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "485296f5-6f2d-4147-a2f4-c143b0ffbed9",
                        "source_entry_id": "180f0f2a-518f-3b36-825d-3f7947dd6d7f",
                        "source_sense_id": "dfba1b94-0982-36fc-866f-e16b69a1307d",
                        "source_sense_description": "one who advocates an aggressive nationalism, one who vociferously supports a nation's military aims",
                        "target_lang_word": "Ultranationalist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ultranationalist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a661d131-73a3-3680-984d-00729a23bba6",
                                        "entry_id": "17c09f2a-9945-3946-a82c-a9bde7960ec5",
                                        "glosses": [
                                            "jemand, der in höchstem Maße nationalistisch gesinnt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f4bd0fe-a1db-4ba3-9066-00ff2a83d088",
                                                "sense_id": "a661d131-73a3-3680-984d-00729a23bba6",
                                                "text": "„Am polnischen Unabhängigkeitstag sind Zehntausende Ultranationalisten, Rechtsradikale und Neofaschisten durch Warschau marschiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20e753c4-c086-4af5-9783-a878c4c23d52",
                        "source_entry_id": "180f0f2a-518f-3b36-825d-3f7947dd6d7f",
                        "source_sense_id": "dfba1b94-0982-36fc-866f-e16b69a1307d",
                        "source_sense_description": "one who advocates an aggressive nationalism, one who vociferously supports a nation's military aims",
                        "target_lang_word": "ура́-патрио́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ура́-патрио́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a0a7da79-fd0e-3f53-bcee-78e29d7a76e9",
                                        "entry_id": "de16b8d6-490b-3008-a58e-9d6b748e11eb",
                                        "glosses": [
                                            "человек, выражающий свой патриотизм в виде шумных, настойчивых, демонстративных заверений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5a3f0c-6380-4f67-84eb-410658a77c0f",
                                                "sense_id": "a0a7da79-fd0e-3f53-bcee-78e29d7a76e9",
                                                "text": "Тогда, в пятидесятые, начало истории было под игом идеологии, впрочем, начало ― всегда прибежище спекулянтов и ура-патриотов."
                                            },
                                            {
                                                "example_id": "9035397f-6e94-47ad-a427-0f480534212d",
                                                "sense_id": "a0a7da79-fd0e-3f53-bcee-78e29d7a76e9",
                                                "text": "Но кричали они как ура-патриоты, как «идейные» сторонники национализма и шовинизма и его выразителей ― ликвидаторов и эсеров."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26b249d0-0a1b-370d-a8c7-0230724fa7e7",
                                        "entry_id": "de16b8d6-490b-3008-a58e-9d6b748e11eb",
                                        "glosses": [
                                            "человек, исповедующий агрессивный патриотизм, громогласно поддерживающий военные цели своей страны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d40779c-5a88-4769-96bd-ec570ca839c0",
                                                "sense_id": "26b249d0-0a1b-370d-a8c7-0230724fa7e7",
                                                "text": "Но втайне, про себя, любой москвич, любой ура-патриот из Охотного ряда знал, что нет в Сербии никаких англичан, что бьют плохо организованную, плохо вооружённую и растянутую по Мораве армию Черняева те самые турецкие генералы, о которых в России не было принято говорить всерьёз ещё со времён Румянцева-Задунайского."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
