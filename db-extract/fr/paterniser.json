                                        "examples": [
                                            {
                                                "example_id": "679b9ac4-724c-4578-9e59-cb49426ef971",
                                                "sense_id": "80c0630a-4b35-37b5-81b0-ea1411ec8dfa",
                                                "text": "To paternalize the government or make it more bureaucratic is in their judgment to repress private enterprise and to imitate the monarchical systems..."
                                            }
                                        ]
