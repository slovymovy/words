    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c7dcf7f4-403d-3a5f-8cd8-0625641cde19",
                "word": "unserviceable",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2ff048b7-9baf-3d24-9a43-95eeac4fc968",
                        "entry_id": "c7dcf7f4-403d-3a5f-8cd8-0625641cde19",
                        "glosses": [
                            "Unusable; of no use."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d24d23a7-6a92-423f-9489-7c0c7b49bc2e",
                                "sense_id": "2ff048b7-9baf-3d24-9a43-95eeac4fc968",
                                "text": "1591, Walter Raleigh, A Report of the Truth of the Fight about the Iles of Açores, this last Sommer betwixt the Reuenge, one of her Maiesties Shippes, and an Armada of the King of Spaine, London: William Ponsonbie; Riverside Press, 1902,\nAnd that which was most to our disaduantage, the one halfe part of the men of euerie shippe sicke, and vtterly vnseruiceable."
                            },
                            {
                                "example_id": "5099bae1-6ee6-44b7-af4b-bb7d627f9e9d",
                                "sense_id": "2ff048b7-9baf-3d24-9a43-95eeac4fc968",
                                "text": "First Soldier. [Reads] ‘First demand of him how many horse the duke is strong.’ What say you to that? / Parolles. Five or six thousand; but very weak and unserviceable: […]"
                            },
                            {
                                "example_id": "ff31e5a5-b59a-4eb2-9f50-325a929f029e",
                                "sense_id": "2ff048b7-9baf-3d24-9a43-95eeac4fc968",
                                "text": "The moſt in ſoule deiected; the moſt baſe, / And moſt vnſeruiceable weede, vnles / You by your heauenly Influence change his vilenes / Into a vertuall habit fit for vſe."
                            },
                            {
                                "example_id": "0b44ee1c-93b6-4239-a2cd-0937d7a7dc71",
                                "sense_id": "2ff048b7-9baf-3d24-9a43-95eeac4fc968",
                                "text": "[…] if a Man hath too mean an Opinion of himself, ’twill render him unserviceable both to God and Man."
                            },
                            {
                                "example_id": "8cedea4d-0bdd-4698-8238-240a36fc2cc0",
                                "sense_id": "2ff048b7-9baf-3d24-9a43-95eeac4fc968",
                                "text": "But things unserviceable in one way, may with advantage be applied in another, that is, if one have genius enough for the purpose.",
                                "translation": "Typee",
                                "english": "Typee"
                            },
                            {
                                "example_id": "cd800ec3-ae2e-4147-97f8-22619a043158",
                                "sense_id": "2ff048b7-9baf-3d24-9a43-95eeac4fc968",
                                "text": "[…] I expect she’ll ruin that dress driving over there in the dust and dew with it, and it looks most too thin for these damp nights. Organdy’s the most unserviceable stuff in the world anyhow, and I told Matthew so when he got it."
                            },
                            {
                                "example_id": "c32e39e4-756a-4f0a-9c51-81919bb16d34",
                                "sense_id": "2ff048b7-9baf-3d24-9a43-95eeac4fc968",
                                "text": "The '08' was acquired from Gemini Rail Services. It was heavily corroded, unserviceable due to a damaged crankshaft, and had been used to donate spares to other '08s'."
                            }
                        ]
                    },
                    {
                        "sense_id": "88470de1-7a11-310c-a450-a205446b2c4a",
                        "entry_id": "c7dcf7f4-403d-3a5f-8cd8-0625641cde19",
                        "glosses": [
                            "Of machinery, etc.: not working."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f55cdc4b-41f7-40ee-8479-0e5b162f32d6",
                                "sense_id": "88470de1-7a11-310c-a450-a205446b2c4a",
                                "text": "During 1936, revealed Pravda, the Gorky plant set itself the task of turning out 12,000 cars. The actual output was 2,500. In one day 24 of 47 cars turned out were tagged “unserviceable.”"
                            },
                            {
                                "example_id": "cf9ee14f-239d-475d-81c7-6f5ddc2ee28e",
                                "sense_id": "88470de1-7a11-310c-a450-a205446b2c4a",
                                "text": "[The war] just didn’t stop, till all the bombs were gone and all the aircraft were unserviceable."
                            }
                        ]
                    },
