                ],
                "senses": [
                    {
                        "sense_id": "7e9b8caa-738e-3309-a6de-ba9dbca7b10f",
                        "entry_id": "c11073d4-e283-3f28-ae80-5691e2f7b531",
                        "glosses": [
                            "Beeinflussung der Menschen durch gezielte sprachliche Maßnahmen wie Euphemismen, Verschleierung, Selektion von Information"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f9aed0-1e0a-4e01-b518-2e9f71fd83f6",
                                "sense_id": "7e9b8caa-738e-3309-a6de-ba9dbca7b10f",
                                "text": "Besonders Propagandasprache und Werbesprache werden verdächtigt, Sprachmanipulation zu bezwecken."
                            },
                            {
                                "example_id": "65bbc882-a071-4a5a-a4d4-05c5b189a88f",
                                "sense_id": "7e9b8caa-738e-3309-a6de-ba9dbca7b10f",
                                "text": "Gezielte Sprachregelungen dienen der Sprachmanipulation."
                            },
                            {
                                "example_id": "826eb6f1-7576-414f-a387-b28add0d7e1d",
                                "sense_id": "7e9b8caa-738e-3309-a6de-ba9dbca7b10f",
                                "text": "„Sprachmanipulation ist in der Regel sowohl Manipulation der Sprache als auch Manipulation durch Sprache.“"
                            },
                            {
                                "example_id": "b7da3e00-a72b-4f90-b70f-294c7b1b93f2",
                                "sense_id": "7e9b8caa-738e-3309-a6de-ba9dbca7b10f",
                                "text": "„Unter Sprachmanipulation versteht man im allgemeinen »den Versuch der Propaganda- oder Werbesprache, beim Rezipienten bzw. Empfänger bestimmte Bewußtseinsinhalte zu beeinflussen, zu wecken, zu verändern oder zu unterdrücken« (Bussmann ²1990, 709).“"
                            },
                            {
                                "example_id": "3b012eaa-f97b-4303-afee-54b76d46ef9b",
                                "sense_id": "7e9b8caa-738e-3309-a6de-ba9dbca7b10f",
                                "text": "„So witzig dies erscheinen mag: Sprachmanipulation welcher Art auch immer bedarf dringlich der Aufdeckung und Enttarnung, jedenfalls allgemeiner Deutlichmachung auch für die weitere, nicht so gewitzte Öffentlichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
