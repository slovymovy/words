                "senses": [
                    {
                        "sense_id": "90c27b0e-584f-323f-bbca-83b9642bb5d8",
                        "entry_id": "25d17abf-e7df-3837-b0ae-3d2d6d9cd4f6",
                        "glosses": [
                            "das semantische Merkmal, das nur zur Beschreibung der Bedeutung eines einzigen Wortes dient und dieses von anderen unterscheidet, bei der Beschreibung anderer Wörter aber nicht verwendet werden kann."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15d8db58-2f69-419d-b771-1938f1e3401f",
                                "sense_id": "90c27b0e-584f-323f-bbca-83b9642bb5d8",
                                "text": "Der Begriff Unterscheider stammt aus der generativen Semantik."
                            },
                            {
                                "example_id": "665edf96-f25f-45d1-bfcd-9156a3df4927",
                                "sense_id": "90c27b0e-584f-323f-bbca-83b9642bb5d8",
                                "text": "Das Wort „Hundepfeife“ kann man mit dem Unterscheider „produziert Laute, die nur für Hunde hörbar sind“ beschreiben, den man vermutlich für kein anderes deutsches Wort verwenden kann."
                            },
                            {
                                "example_id": "361ca29e-118c-4e06-9081-56b985657159",
                                "sense_id": "90c27b0e-584f-323f-bbca-83b9642bb5d8",
                                "text": "Hundsnurscher beschreibt Unterscheider wie folgt: „Das ‚letzte‘ Merkmal stellt theoretisch gesehen den Unterschied zwischen einem Formativ und seinem engsten Synonym dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
