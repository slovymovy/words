    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94ded00b-0eb2-35be-a3f2-04315960dec7",
                    "sense_definition": "geluk of fortuin",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>bof</w> om jou hier nog te treffen.",
                            "target_lang_translations": {
                                "fr": "Quelle <w>chance</w> de te croiser encore ici."
                            }
                        },
                        {
                            "text": "Het is echt een <w>bof</w> dat de trein precies op tijd vertrok.",
                            "target_lang_translations": {
                                "fr": "C'est vraiment une <w>veine</w> que le train soit parti pile à l'heure."
                            }
                        }
                    ],
                    "synonyms": [
                        "geluk",
                        "mazzel"
                    ],
                    "antonyms": [
                        "pech"
                    ],
                    "common_phrases": [
                        "wat een bof"
                    ],
                    "target_lang_definitions": {
                        "fr": "Chance ou bonne fortune."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "veine",
                                "target_lang_sense_clarification": "Chance, heureux hasard (familier)."
                            },
                            {
                                "target_lang_word": "chance",
                                "target_lang_sense_clarification": "Bonne fortune, opportunité favorable."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dd86341-30bc-3bd8-8c0e-0d44c9d39207",
                    "sense_definition": "besmettelijke infectieziekte die zorgt voor een dikke wang",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ziekte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben allebei de <w>bof</w> gehad.",
                            "target_lang_translations": {
                                "fr": "Ils ont tous les deux eu les <w>oreillons</w>."
                            }
                        },
                        {
                            "text": "Het kind is thuisgebleven omdat het de <w>bof</w> heeft.",
                            "target_lang_translations": {
                                "fr": "L'enfant est resté à la maison parce qu'il a les <w>oreillons</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de bof hebben"
                    ],
                    "target_lang_definitions": {
                        "fr": "Maladie infectieuse virale provoquant un gonflement des glandes parotides."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "oreillons",
                                "target_lang_sense_clarification": "Infection virale touchant les glandes salivaires."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ccb4225-4273-36e1-a5c0-628cb83ec34c",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>boffen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bof</w> dat ik vandaag vrij ben.",
                            "target_lang_translations": {
                                "fr": "J'<w>ai de la chance</w> d'être libre aujourd'hui."
                            }
                        },
                        {
                            "text": "Ik <w>bof</w> enorm met dit mooie weer.",
                            "target_lang_translations": {
                                "fr": "J'<w>ai énormément de chance</w> avec ce beau temps."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du verbe 'boffen' (avoir de la chance)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "avoir de la chance",
                                "target_lang_sense_clarification": "Expression verbale pour exprimer la bonne fortune."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdda5e41-266a-3827-a140-8c49426ee417",
