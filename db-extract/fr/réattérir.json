                        ],
                        "examples": [
                            {
                                "example_id": "a8e83238-3f2e-4aaf-9f01-fb5f128e46fc",
                                "sense_id": "34b34698-9484-3416-9964-47f83690c892",
                                "text": "Elle fait mentalement le vide puis se met à penser à des choses terre à terre, à son propriétaire qui s'impatiente de ne pas avoir encore touché le terme, à son travail du lendemain avec toute cette argenterie à faire briller, toutes ces petites choses bien concrètes qui permettent de réattérir sur le plancher des vaches lorsqu'on en a décollé trop vite."
                            },
                            {
                                "example_id": "5c69e255-5a2e-4059-aa46-bc338062bbbb",
                                "sense_id": "34b34698-9484-3416-9964-47f83690c892",
                                "text": "Mirumo 3 : fin du combat entre Mirumo et Shiyashi, où le suspens était à son comble, pour réattérir sur des histoires plus guillerettes, notamment le futur."
                            }
                        ]
                    }
