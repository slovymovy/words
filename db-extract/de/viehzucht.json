                        "cross_references": []
                    },
                    {
                        "translation_id": "ca832857-6672-4a7d-822b-2d1af956935f",
                        "source_entry_id": "27446adb-5412-31fa-b9a7-c837be7beaa1",
                        "source_sense_id": "92acee65-10ca-31b0-bf11-3f9b6021da0c",
                        "source_sense_description": "die kontrollierte Vermehrung und Aufzucht von Tieren",
                        "target_lang_word": "élevage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élevage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b15a68de-0fa5-3bd3-8457-5d65f5218a51",
                                        "entry_id": "ad03207e-f77b-3895-b934-a5b4f41f462b",
                                        "glosses": [
                                            "Action d’élever les animaux domestiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8a94c1-2fe5-4ca1-bcd4-13e9a910bf19",
                                                "sense_id": "b15a68de-0fa5-3bd3-8457-5d65f5218a51",
                                                "text": "Ensuite - lorsque, avec la découverte de l’élevage et de l’agriculture, un homme sut produire davantage qu'il ne lui fallait pour vivre - les vainqueurs trouvèrent plus commode de réduire les vaincus au servage et de les faire travailler pour eux."
                                            },
                                            {
                                                "example_id": "4ffee3b8-7f83-4e4b-ae93-9877ac8b9f9a",
                                                "sense_id": "b15a68de-0fa5-3bd3-8457-5d65f5218a51",
                                                "text": "Il faut, autant que possible élever les chevaux à l’écurie, l’élevage en liberté n’est pas, tant s’en faut, aussi économique que l’élevage à l’écurie."
                                            },
                                            {
                                                "example_id": "13df6ed6-de37-45b5-979e-fc62480daae5",
                                                "sense_id": "b15a68de-0fa5-3bd3-8457-5d65f5218a51",
                                                "text": "L’élevage des vers à soie « ne paie plus ». Voilà pourquoi, aujourd’hui, dans le Gard, on arrache les mûriers : on les remplace imprudemment par des vignes...."
                                            },
                                            {
                                                "example_id": "042aedb7-7d2a-4f69-893f-65197d9e0c56",
                                                "sense_id": "b15a68de-0fa5-3bd3-8457-5d65f5218a51",
                                                "text": "Ce que nous savons du genre d’élevage pratiqué nous incite à penser que la récupération du fumier était faible. Les 20 à 30 millions de moutons pacageaient presque toute l'année sur les landes ; une faible part pacageait les jachères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "723f2270-5825-3dfd-a9e7-4dd2ba9831a2",
                                        "entry_id": "ad03207e-f77b-3895-b934-a5b4f41f462b",
                                        "glosses": [
                                            "Troupeau de ces animaux domestiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa29797d-094f-4fea-9c71-fa1098ceb3a0",
                                                "sense_id": "723f2270-5825-3dfd-a9e7-4dd2ba9831a2",
                                                "text": "L’éleveur soigne son élevage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf73541-4d76-3add-b5bd-cd4c2ee7587e",
                                        "entry_id": "ad03207e-f77b-3895-b934-a5b4f41f462b",
                                        "glosses": [
                                            "Les bâtiments où loge ce troupeau."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56d53b8f-15d5-43a7-8fab-6f2325793845",
                                                "sense_id": "9bf73541-4d76-3add-b5bd-cd4c2ee7587e",
                                                "text": "L’entrée de l’élevage se trouve de l’autre côté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58e1d167-7745-3d01-844c-56ea29d4d144",
                                        "entry_id": "ad03207e-f77b-3895-b934-a5b4f41f462b",
                                        "glosses": [
                                            "Ensemble des techniques et des bonnes pratiques de la production d’animaux."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afab50c3-f0e4-4fdf-b83d-6c3e126924f9",
                                                "sense_id": "58e1d167-7745-3d01-844c-56ea29d4d144",
                                                "text": "Technicien, conseiller, professeur, d’élevage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59ae710b-1f0a-3b76-8bc0-65846bb77194",
                                        "entry_id": "ad03207e-f77b-3895-b934-a5b4f41f462b",
                                        "glosses": [
                                            "Métier des éleveurs de bestiaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24f6ddb6-11e6-458f-8873-8de1aeb0c523",
                                                "sense_id": "59ae710b-1f0a-3b76-8bc0-65846bb77194",
                                                "text": "Ce sont eux qui, dans l’élevage gâtineau, tiennent la vedette et la tiendront jusqu'au jour où les perfectionnements apportés aux méthodes culturales les feront reculer au point d'en amener la quasi-disparition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d02225cb-5490-37ca-9bed-85cd794a5b14",
                                        "entry_id": "ad03207e-f77b-3895-b934-a5b4f41f462b",
                                        "glosses": [
                                            "Action d’éduquer des enfants ou de jeunes individus."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ab63d72-5fde-4d3f-971d-d0b00cdd505e",
                                                "sense_id": "d02225cb-5490-37ca-9bed-85cd794a5b14",
                                                "text": "Sous la IIIᵉ république, les techniques d’élevage fabriquent en série de petits robots, respectueux des autorités, sexuellement refoulés, bon soldats, excellents travailleurs, anxieux, très portés au suicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d5539db-1718-3b6c-828b-bf0416797518",
                                        "entry_id": "ad03207e-f77b-3895-b934-a5b4f41f462b",
                                        "glosses": [
                                            "Une des étapes de la transformation de certains vins, après la macération et la fermentation, et avant l’assemblage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac6571cb-bc43-49b4-9638-1a3a2b2caefc",
                                                "sense_id": "0d5539db-1718-3b6c-828b-bf0416797518",
                                                "text": "II participa à la mise au point des techniques d'élevage des vins dans les fûts de chêne neufs …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
