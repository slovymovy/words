                    {
                        "translation_id": "193b4619-24a5-4723-ac89-c2ebaf941619",
                        "source_entry_id": "8f23587f-e9c4-3bba-91bd-22a0d175fe82",
                        "source_sense_id": "b42319f0-d544-3684-b86a-09182b15e5aa",
                        "target_lang_word": "германизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "германизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3fbd0481-ae15-3dbe-8a3b-58651b9252b0",
                                        "entry_id": "a7d30854-56b8-32b0-93a7-33090bf40a6c",
                                        "glosses": [
                                            "лингв. слово или выражение, заимствованное из немецкого языка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7891470a-b630-46a7-8b95-c715f61da512",
                                                "sense_id": "3fbd0481-ae15-3dbe-8a3b-58651b9252b0",
                                                "text": "Без пощады изгоняют из него все речения и обороты славянские и обогащают архитравами, колоннами, баронами, траурами, германизмами, галицизмами и барбаризмами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1fab09a-fbf9-340a-9488-5b3d072c502d",
                                        "entry_id": "a7d30854-56b8-32b0-93a7-33090bf40a6c",
                                        "glosses": [
                                            "филол. вид варваризма — оборот речи, выражение в каком-нибудь языке, составленное по образцу немецкого языка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "623c432b-710f-4ca3-b582-b90ce50055e2",
                                                "sense_id": "a1fab09a-fbf9-340a-9488-5b3d072c502d",
                                                "text": "Множество терминов я пустил впервые в русской печати, и мне некоторым подспорьем служили только учебники фармакологии, в том числе и перевод Эстерлена ― того же доктора Хана ― перевод местами очень плохой, с варварскими германизмами и с уродливыми переделками терминов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dfbfc65-625c-36c7-9141-e3582c69d44d",
                                        "entry_id": "a7d30854-56b8-32b0-93a7-33090bf40a6c",
                                        "glosses": [
                                            "книжн. немецкие идеи; немецкий способ мышления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d52e85-0cd9-4f6a-bad5-1631c83712b6",
                                                "sense_id": "3dfbfc65-625c-36c7-9141-e3582c69d44d",
                                                "text": "Германский дух, очень сильный дух, хочет в конце концов породить своеобразную германскую религию германизма, которая вступает в антагонизм с христианством."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c19052-42ab-3f86-934e-540ec3a5b1ca",
                                        "entry_id": "a7d30854-56b8-32b0-93a7-33090bf40a6c",
                                        "glosses": [
                                            "книжн. германофильство"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
