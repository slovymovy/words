                    {
                        "sense_id": "c600fa0e-f23d-34bb-a4b9-ecee278d5f90",
                        "entry_id": "e0985991-51c2-38b3-a26e-298a3db9468c",
                        "glosses": [
                            "een individueel voorbeeld ergens van"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beec6bee-0a6e-4824-97b8-34b54ce5cea7",
                                "sense_id": "c600fa0e-f23d-34bb-a4b9-ecee278d5f90",
                                "text": "Ik heb nog maar twee exemplaren van deze zeldzame munt gezien."
                            },
                            {
                                "example_id": "b23b6e44-92c3-486a-b8df-81500cc16569",
                                "sense_id": "c600fa0e-f23d-34bb-a4b9-ecee278d5f90",
                                "text": "Mijn moeder had in haar exemplaar geschreven 'Mijn meisje!' en ik stelde geamuseerd vast dat ze met balpen de ontbrekende e aan mijn naam toegevoegd."
                            },
                            {
                                "example_id": "b74ef0a9-39ef-478e-af2f-ac04663e054e",
                                "sense_id": "c600fa0e-f23d-34bb-a4b9-ecee278d5f90",
                                "text": "De gemeente beschrijft de mammoet als \"de compleetste gemummificeerde mammoetvondst ooit\". Volgens BBC News is het pas de tweede keer dat een bevroren wolharige mammoet is gevonden. Het eerste exemplaar werd in 2007 opgegraven in Siberië. Die vondst was zeker 42.000 jaar oud."
                            }
                        ]
                    }
                ],
