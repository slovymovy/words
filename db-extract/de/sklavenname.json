                "senses": [
                    {
                        "sense_id": "dcd8acb1-6802-3329-80ec-f1f12e6e806c",
                        "entry_id": "87444b5d-d909-3a01-ae96-d2e9f57f44f3",
                        "glosses": [
                            "Name, der einer versklaven Person gegeben wird, jemanden als Sklaven kennzeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a17e964-7270-4600-8caa-4808376472df",
                                "sense_id": "dcd8acb1-6802-3329-80ec-f1f12e6e806c",
                                "text": "„Die Jahre vergingen, und Tochterkind hatte einen neuen Namen, einen Sklavennamen, bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29ddf090-28e2-45e1-805f-7adf9751acd3",
                        "source_entry_id": "87444b5d-d909-3a01-ae96-d2e9f57f44f3",
                        "source_sense_id": "dcd8acb1-6802-3329-80ec-f1f12e6e806c",
                        "source_sense_description": "Name eines Sklaven",
                        "target_lang_word": "slave name",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slave name",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a101156-a95f-30eb-b7f6-bdb09bf4a372",
                                        "entry_id": "ffc57c6b-501a-307d-8003-cf20e980c01b",
                                        "glosses": [
                                            "A name or surname given to a person held in slavery, or passed down to their descendants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7ba8539-de2b-4143-affd-d0faa3838c4e",
                                                "sense_id": "6a101156-a95f-30eb-b7f6-bdb09bf4a372",
                                                "text": "They might not know which name to call—my slave name, Marie Laveau, or the unknown African name that should've been mine."
                                            },
                                            {
                                                "example_id": "613c5515-abfd-43ba-8abf-5cf5a43accbf",
                                                "sense_id": "6a101156-a95f-30eb-b7f6-bdb09bf4a372",
                                                "text": "His point is to let white people know you don't accept your slave name."
                                            },
                                            {
                                                "example_id": "3de7b6b9-c6c5-48a0-be25-efe0e9e4e9d7",
                                                "sense_id": "6a101156-a95f-30eb-b7f6-bdb09bf4a372",
                                                "text": "Shipp is my slave name. It's the name of the people who owned my family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "400b5149-4927-304d-9aa0-b1e231f197e6",
                                        "entry_id": "ffc57c6b-501a-307d-8003-cf20e980c01b",
                                        "glosses": [
                                            "Any name imposed on one by others rather than chosen by them for themselves (but generally excluding names bestowed by one's parents)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013532c3-3900-4568-a8a0-3001032fca59",
                                                "sense_id": "400b5149-4927-304d-9aa0-b1e231f197e6",
                                                "text": "'Woman' is my slave name; feminism will give me freedom to seek some other identity altogether."
                                            },
                                            {
                                                "example_id": "85260d46-7eff-4d25-9961-c98da30333e8",
                                                "sense_id": "400b5149-4927-304d-9aa0-b1e231f197e6",
                                                "text": "Muffy was my slave name. It's what all those Columbia math majors called me."
                                            },
                                            {
                                                "example_id": "0e646e7b-325d-4af6-b1c5-10cc950fd357",
                                                "sense_id": "400b5149-4927-304d-9aa0-b1e231f197e6",
                                                "text": "Call me Namron. You see Norman is my slave name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
