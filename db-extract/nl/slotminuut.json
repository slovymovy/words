                        "examples": [
                            {
                                "example_id": "6c48048c-2295-403e-8de0-d6c697d90123",
                                "sense_id": "8a6dc8a3-f0eb-3d5d-9c5d-a1d8d6a07d55",
                                "text": "De wedstrijd ging lange tijd gelijk op, met een 18-18 stand met nog twintig minuten op de klok. Kroatië hield de defensie daarna op slot en had aanvallend het vizier op scherp staan. Zo liepen de Kroatische vrouwen uit naar 25-18. In de slotminuut kwam Denemarken nog even terug, maar het feestje bij Kroatië was al begonnen."
                            },
                            {
                                "example_id": "7ec7d528-3187-4849-9a08-8c32e85033ba",
                                "sense_id": "8a6dc8a3-f0eb-3d5d-9c5d-a1d8d6a07d55",
                                "text": "Atlético Madrid heeft na drie competitieduels als enige club in de Primera División nog de maximale score. Thuis tegen laagvlieger SD Eibar boog het elftal een 2-0 achterstand om in een 3-2 overwinning. De winnende treffer van Thomas Partey viel in de slotminuut."
                            }
                        ]
                    }
