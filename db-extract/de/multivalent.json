                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc149f6d-8bdc-3593-b4d1-54775dec19a4",
                        "entry_id": "e153a3a4-328b-3884-96f5-4bf055587822",
                        "glosses": [
                            "aus Antikörpern gegen verschiedene Antigene gemischt"
                        ],
                        "tags": [
                            "von Impfstoffen"
                        ],
                        "examples": [
                            {
                                "example_id": "af29439a-ade8-47d2-8a0c-095ebc266ad9",
                                "sense_id": "dc149f6d-8bdc-3593-b4d1-54775dec19a4",
                                "text": "„In kombinierten, multivalenten Vakzinen wird jede Komponente vor dem Zusammenmischen auf Sterilität geprüft.“"
                            },
                            {
                                "example_id": "e0a2186e-c129-4fe9-a233-85de40dd691f",
                                "sense_id": "dc149f6d-8bdc-3593-b4d1-54775dec19a4",
                                "text": "„In den meisten Fällen wird man auf Verwendung eines heterogenen Impfstoffes angewiesen sein und dann nur multivalente Impfstoffe verwenden.“"
                            },
                            {
                                "example_id": "6ace9a37-86ae-4f3f-8122-b6b04688ac36",
                                "sense_id": "dc149f6d-8bdc-3593-b4d1-54775dec19a4",
                                "text": "„Versuche, multivalente Vakzine zur Vermeidung der chronischen Kolonisation herzustellen, haben zunächst bei relativ ungereinigten Vakzinen enttäuschende Ergebnisse gezeigt.“"
                            },
                            {
                                "example_id": "5ff6f729-ad64-4b61-8738-eff567780829",
                                "sense_id": "dc149f6d-8bdc-3593-b4d1-54775dec19a4",
                                "text": "„Falls diese Vektoren ein genügend groBes Genom haben, ist es möglich, Gene von mehreren Viren ins Vektorgenom einzusetzen und multivalente Impfstoffe gegen mehrere Krankheiten herzustellen.“"
                            },
                            {
                                "example_id": "1a3990ac-0e22-49bf-b290-9cb65e661f76",
                                "sense_id": "dc149f6d-8bdc-3593-b4d1-54775dec19a4",
                                "text": "„Gegen Infektionskrankheiten bei Chinchilla sind multivalente Impfstoffe in den USA und in Westdeutschland entwickelt worden, entsprechende Präparate aus der DDR-Produktion liegen nicht vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b4a7e004-30d8-368f-918e-123efb2fd49d",
                        "entry_id": "e153a3a4-328b-3884-96f5-4bf055587822",
                        "glosses": [
                            "mit einer Vielzahl von Ladungen"
                        ],
                        "tags": [
                            "von Ionen"
                        ],
                        "examples": [
                            {
                                "example_id": "eefc2816-94d1-4925-9483-9d80feedd36a",
                                "sense_id": "b4a7e004-30d8-368f-918e-123efb2fd49d",
                                "text": "„Multivalente Metalle reagieren im Sinne einer Redoxreaktion mit dem Hydroperoxid […].“"
                            },
                            {
                                "example_id": "5493e22f-c7e8-46bb-90db-20fb646cf925",
                                "sense_id": "b4a7e004-30d8-368f-918e-123efb2fd49d",
                                "text": "„Diese Eigenschaft wird durch die Bindung aller bisher getesteten multivalenten Metall-Ionen bei hohen Ionenstärken vermindert […].“"
                            },
                            {
                                "example_id": "1a675964-b383-45f5-af29-a34c09843f2e",
                                "sense_id": "b4a7e004-30d8-368f-918e-123efb2fd49d",
                                "text": "„Es sind Salze multivalenter Übergangsmetalle, also Metalle wie Eisen Fe, Mangan Mn oder Cobalt Co, die leicht zwischen mehreren Oxidationszahlen wechseln können (Fe²⁺/Fe³⁺, Co²⁺/Co³⁺) […].“"
                            },
                            {
                                "example_id": "f9354c9b-c2e0-4985-9b7d-9435db970c7b",
                                "sense_id": "b4a7e004-30d8-368f-918e-123efb2fd49d",
                                "text": "„Bei den Halogensalzen besitzen die multivalenten Kationen ein grösseres Kraftfeld, als die univalenten, so dass in einer multivalenten Verbindung ein Halogenatom weniger ‚gesättigt‘ erscheint, als in einer univalenten.“"
                            },
                            {
                                "example_id": "bcdf43d0-8fa0-49b3-a3b5-0ed9bf7a5d39",
                                "sense_id": "b4a7e004-30d8-368f-918e-123efb2fd49d",
                                "text": "„Es sei zum Schluß noch erwähnt, daß Ionenassoziationen die Geschwindigkeit von Ionenreaktionen stark beeinflussen, insbesondere, wenn multivalente Ionen zugegen sind, sei es als Reaktanden oder als scheinbar unbeteiligte »Zuschauer«.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "22049d5f-6cbf-393e-a9df-489fe0693323",
                        "entry_id": "e153a3a4-328b-3884-96f5-4bf055587822",
                        "glosses": [
                            "mit einer Vielzahl von Lösungen, Bedeutungen, Funktionen oder Ähnlichem"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "af74061c-160f-453b-9b96-7e17459fd969",
                                "sense_id": "22049d5f-6cbf-393e-a9df-489fe0693323",
                                "text": "„Es handelt sich um einen multivalenten Begriff.“"
                            },
                            {
                                "example_id": "3bfd961c-81a8-4617-95b4-a7c90ede11dc",
                                "sense_id": "22049d5f-6cbf-393e-a9df-489fe0693323",
                                "text": "„Schulische Bildung ist eine multivalente Ressource, die Optionen für die weitere Entwicklung eröffnet.“"
                            },
                            {
                                "example_id": "ce6a9e27-6254-4f18-90e1-2cbc9c744c8b",
                                "sense_id": "22049d5f-6cbf-393e-a9df-489fe0693323",
                                "text": "„Er konstatiert eine Überforderung der Schüler und hält einen multivalenten Lateinunterricht für unpraktizierbar.“"
                            },
                            {
                                "example_id": "b1fa6936-a60d-40fa-b661-c8d31e3f4220",
                                "sense_id": "22049d5f-6cbf-393e-a9df-489fe0693323",
                                "text": "„Das erzeugt einen multivalenten, meist widersprüchlichen Handlungsdruck auf das Arbeitsteam.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
