        "fr-extract.jsonl": [
            {
                "entry_id": "170ae948-29cd-369d-ba0b-278afb587468",
                "word": "pouët",
                "pos": "onomatopoeia",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3c549f1e-3d59-4c5e-adc3-b8d5f91c3333",
                        "entry_id": "170ae948-29cd-369d-ba0b-278afb587468",
                        "tags": [],
                        "form": "pouet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74e43396-180e-39a3-bf70-0455ca9b6cfc",
                        "entry_id": "170ae948-29cd-369d-ba0b-278afb587468",
                        "glosses": [
                            "Bruit d’instrument à vent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56ca1c19-f392-4863-b84b-df865183846c",
                                "sense_id": "74e43396-180e-39a3-bf70-0455ca9b6cfc",
                                "text": "Pouët ! Pouët ! Non, il ne faisait pas « Pouët ! Pouët ! », le klaxon de la voiture de mon frère. La voiture de mon frère était plus petite que le jardin de ma sœur. C'était une 4 CV Renault, la bagnole de Tarin mon frangin."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4cd316e-7cbb-33fd-99c9-ffac7625260b",
                        "entry_id": "170ae948-29cd-369d-ba0b-278afb587468",
                        "glosses": [
                            "Bruit produit par quelqu’un qui se mouche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a4b64a7-cd43-4350-bc83-41f1ebaf4f8b",
                                "sense_id": "d4cd316e-7cbb-33fd-99c9-ffac7625260b",
                                "text": "Il en pleure. Il tire son mouchoir de dessous les os, les clefs, les boulons, les ficelles, un mouchoir violet, à carreaux, grand comme un drap, il le roule en gros tampon, il se frotte les yeux à s’arracher les paupières, puis il se l’étale à plat sur la figure, il s’empoigne le nez à travers le mouchoir, il se mouche, pouët, les oiseaux se sauvent, c’est la panique, il se frotte le nez avec le mouchoir en boule, ça va mieux, le voilà reparti."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa356f3e-d8a6-4b3b-ba90-14a2e4e21578",
                        "source_entry_id": "170ae948-29cd-369d-ba0b-278afb587468",
                        "source_sense_description": "Bruit d’instrument à vent",
                        "target_lang_word": "toot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c912b321-0ec1-3098-80c4-d383405a2df9",
                                        "entry_id": "09bc58fc-b399-31c3-9e32-f38319dadb56",
                                        "glosses": [
                                            "The noise of a horn or whistle."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba8f9e37-21e0-4bcf-a513-ba9ed83cfab0",
                                                "sense_id": "c912b321-0ec1-3098-80c4-d383405a2df9",
                                                "text": "He gave a little toot of the horn, to get their attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9429646-3b92-33d3-adf4-59c8a6164378",
                                        "entry_id": "09bc58fc-b399-31c3-9e32-f38319dadb56",
                                        "glosses": [
                                            "A fart; flatus."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6eaa6c3-5cf4-3932-8325-fe1c7f581d87",
                                        "entry_id": "09bc58fc-b399-31c3-9e32-f38319dadb56",
                                        "glosses": [
                                            "Cocaine."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c349aee1-38d8-3572-8d51-999294f00ccd",
                                        "entry_id": "09bc58fc-b399-31c3-9e32-f38319dadb56",
                                        "glosses": [
                                            "A portion of cocaine that a person snorts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cd72798-1247-4192-9c56-dbf16195040c",
                                                "sense_id": "c349aee1-38d8-3572-8d51-999294f00ccd",
                                                "text": "So he took a toot. A couple of days later he did another, then another. Soon Harry was using more coke than he had done in his whole life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a06301e-f4ee-38bf-8efc-c24c160860f2",
                                        "entry_id": "09bc58fc-b399-31c3-9e32-f38319dadb56",
                                        "glosses": [
                                            "A spree of drunkenness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efce8a78-782a-3798-86c1-545ed7efb061",
                                        "entry_id": "09bc58fc-b399-31c3-9e32-f38319dadb56",
                                        "glosses": [
                                            "Rubbish; tat."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a32bd65-d6bb-4d4d-857a-bb1c1325522a",
                                                "sense_id": "efce8a78-782a-3798-86c1-545ed7efb061",
                                                "text": "I'm not paying fifty pounds for this load of old toot!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc1a511-e7cf-318c-aa6f-86ce441eb007",
                                        "entry_id": "09bc58fc-b399-31c3-9e32-f38319dadb56",
                                        "glosses": [
                                            "A message on the social networking software Mastodon."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf68d57b-ae8d-4d3d-af9c-fc2abc429af1",
                                                "sense_id": "5fc1a511-e7cf-318c-aa6f-86ce441eb007",
                                                "text": "As for layout, Mastodon feels a little like TweetDeck, with columns for your toots, toots from the people you follow, your mentions, and (unlike Twitter) a timeline of all public posts being shared by every user on the platform."
                                            },
                                            {
                                                "example_id": "46668fda-371e-4815-805a-bb5a0b16a2db",
                                                "sense_id": "5fc1a511-e7cf-318c-aa6f-86ce441eb007",
                                                "text": "Interestingly, Mastodon offers a bit more in that aspect for toots can be 500 characters long."
                                            },
                                            {
                                                "example_id": "0abaf963-9f5f-4f37-b2a9-8cd48d08cbac",
                                                "sense_id": "5fc1a511-e7cf-318c-aa6f-86ce441eb007",
                                                "text": "Mastodon users can send toots with 500 characters as opposed to Twitter's 140. But that's not the only difference. Individual toots can be marked as private, meaning you don't have to choose between a public or a private account like on Twitter."
                                            },
                                            {
                                                "example_id": "ad925791-2237-4433-8436-a42c939417bc",
                                                "sense_id": "5fc1a511-e7cf-318c-aa6f-86ce441eb007",
                                                "text": "So if I follow Nick, his toots (yep, they're called toots) will show up in wandering.shop's federated timeline."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7438018-1473-3fc2-977f-092fc213ff03",
                                        "entry_id": "53f30dc2-3eb0-3f1c-8349-53ba45416104",
                                        "glosses": [
                                            "To stand out, or be prominent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7212a65d-5752-46ac-a639-3943b3ef4526",
                                                "sense_id": "f7438018-1473-3fc2-977f-092fc213ff03",
                                                "text": "Now rise up, Master Huddypeke, Your tail toteth out behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "071c21e8-18f3-3efb-861e-c019d745ad6b",
                                        "entry_id": "53f30dc2-3eb0-3f1c-8349-53ba45416104",
                                        "glosses": [
                                            "To peep; to look narrowly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "606e53ef-3056-4f8f-b267-1763c89afb3a",
                                                "sense_id": "071c21e8-18f3-3efb-861e-c019d745ad6b",
                                                "text": "In the court, in the noblemen's houses, at every merchant's house, those Observants were spying, tooting, and looking, watching and prying, what they might hear or see against the see of Rome."
                                            },
                                            {
                                                "example_id": "ca472aef-7ee7-4278-b499-8184299093d3",
                                                "sense_id": "071c21e8-18f3-3efb-861e-c019d745ad6b",
                                                "text": "Long wandering up and downe the land, With bowe and bolts in either hand, For birds in bushes tooting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa506a0c-586d-3b59-baba-6ca71518001f",
                                        "entry_id": "53f30dc2-3eb0-3f1c-8349-53ba45416104",
                                        "glosses": [
                                            "To see; to spy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17e1e09c-91a6-3b41-b403-805ac3ef1d0d",
                                        "entry_id": "53f30dc2-3eb0-3f1c-8349-53ba45416104",
                                        "glosses": [
                                            "To produce the noise of a horn or whistle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c80b41-72fe-4014-a354-656cb1a24fbf",
                                                "sense_id": "17e1e09c-91a6-3b41-b403-805ac3ef1d0d",
                                                "text": "The island rang, as yet, with the tooting horns and rattling teams of mail-coaches."
                                            },
                                            {
                                                "example_id": "d4aa9fd4-cc70-470f-904c-a4f2a83eabc3",
                                                "sense_id": "17e1e09c-91a6-3b41-b403-805ac3ef1d0d",
                                                "text": "A horn tooted to the right, and I saw the black people run."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8cca578-6ef6-3406-8c1f-62b77e7f2ce5",
                                        "entry_id": "53f30dc2-3eb0-3f1c-8349-53ba45416104",
                                        "glosses": [
                                            "To cause a horn or whistle to produce a noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3208ae90-a245-41f7-8902-41161ce7182a",
                                                "sense_id": "c8cca578-6ef6-3406-8c1f-62b77e7f2ce5",
                                                "text": "\"In the morning, we get deer on the line. We tend not to 'toot' them because it seems that only makes them more likely to run across the track.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "194bc667-ab19-3d57-90a8-c1187f2793ec",
                                        "entry_id": "53f30dc2-3eb0-3f1c-8349-53ba45416104",
                                        "glosses": [
                                            "To flatulate."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "236f6533-f252-37e5-ba2e-9701df4a2ede",
                                        "entry_id": "53f30dc2-3eb0-3f1c-8349-53ba45416104",
                                        "glosses": [
                                            "Of a queen bee, to make a high-pitched sound during certain stages of development."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "345c0d84-4397-3cbc-ac10-947946efbd59",
                                        "entry_id": "53f30dc2-3eb0-3f1c-8349-53ba45416104",
                                        "glosses": [
                                            "To go on a drinking binge."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6af08507-d609-364d-a01a-6d5be5694f4a",
                                        "entry_id": "53f30dc2-3eb0-3f1c-8349-53ba45416104",
                                        "glosses": [
                                            "To snort (a recreational drug)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c42012d3-98ea-4420-b534-65957036a6ad",
                                                "sense_id": "6af08507-d609-364d-a01a-6d5be5694f4a",
                                                "text": "I had graduated from the simple tooting cocaine up my nose to smoking it, which was a completely different experience and animal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c955076-564d-3059-9888-8614d34f967a",
                                        "entry_id": "53f30dc2-3eb0-3f1c-8349-53ba45416104",
                                        "glosses": [
                                            "To post a message on a Mastodon instance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d6c7cfb-f5bc-4f03-80db-e943e83c66d1",
                                                "sense_id": "3c955076-564d-3059-9888-8614d34f967a",
                                                "text": "Only want to toot in the Animal Rights instance? You can create an account there and do that."
                                            },
                                            {
                                                "example_id": "f9560cbf-c65a-4c13-a28c-4436032556b2",
                                                "sense_id": "3c955076-564d-3059-9888-8614d34f967a",
                                                "text": "One alternative to Fist is Mastodon, which looks and behaves a bit like Twitter (you don’t tweet, you “toot”)."
                                            },
                                            {
                                                "example_id": "671ad036-6286-47d3-a609-2be6edad6d32",
                                                "sense_id": "3c955076-564d-3059-9888-8614d34f967a",
                                                "text": "Each instance has its own administrator and its own code of conduct, so make sure you read up before you toot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
