                ],
                "senses": [
                    {
                        "sense_id": "3729694b-5f4e-3636-866b-eed895158e2a",
                        "entry_id": "69876061-b47f-345e-8f5b-d43e6f73a653",
                        "glosses": [
                            "To use a fescue, or teach with a fescue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb0c0fd-5e7c-4385-8a6b-20991f98488c",
                                "sense_id": "3729694b-5f4e-3636-866b-eed895158e2a",
                                "text": "A minister that cannot be trusted to pray in his own words without being chewed to, and fescued to a formal injunction of his rote lesson, should as little be trusted to preach, besides the vain babble of praying over the same things immediately again ; for there is a large difference in the repetition of some pathetical ejaculation raised out of the sudden earnestness and vigour of the inflamed soul, (such as was that of Christ in the garden,) from the continual rehearsal of our daily orisons;"
                            }
                        ]
                    }
                ],
