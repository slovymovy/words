                                "example_id": "a13f2785-fe7a-4d53-872a-c9880647ac4b",
                                "sense_id": "9271daf4-8b36-30ae-8c30-dc898fd4302a",
                                "text": "„Butter im Tiegel zerlassen und den nunmehr weichen Giersch kurz darin braten.“"
                            },
                            {
                                "example_id": "e1d3273b-29fd-4ccb-8a5c-0901fe8e1030",
                                "sense_id": "9271daf4-8b36-30ae-8c30-dc898fd4302a",
                                "text": "„Die bewährteste Methode, Giersch in Zaum zu halten, ist nicht Ausjäten und Ausrupfen, sondern konsequentes Ernten der jungen Blätter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
