{
    "word_family": [
        "drinker",
        "drinkable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8bf67433-216f-3d08-9b96-1ceec20fb7a9",
                    "sense_definition": "The present participle and gerund of <w>drink</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>drinking</w> a glass of fresh orange juice.",
                            "target_lang_translations": {
                                "ru": "Она <w>пьёт</w> стакан свежего апельсинового сока.",
                                "zh": "她正在<w>喝</w>一杯新鲜的橙汁。"
                            }
                        },
                        {
                            "text": "They were <w>drinking</w> coffee in the kitchen this morning.",
                            "target_lang_translations": {
                                "ru": "Они <w>пили</w> кофе на кухне сегодня утром.",
                                "zh": "他们今天早上在厨房里<w>喝</w>咖啡。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола drink.",
                        "zh": "动词 drink 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пить",
                                "target_lang_sense_clarification": "глагол"
                            },
                            {
                                "target_lang_word": "выпивать",
                                "target_lang_sense_clarification": "глагол, процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喝",
                                "target_lang_sense_clarification": "饮用液体"
                            },
                            {
                                "target_lang_word": "饮用",
                                "target_lang_sense_clarification": "正式用法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ac922e5-0739-3c62-b7d0-1817b4ca82f5",
                    "sense_definition": "The act of consuming liquids, especially alcoholic beverages.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "alcohol_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy <w>drinking</w> can lead to serious health problems.",
                            "target_lang_translations": {
                                "ru": "Сильное <w>пьянство</w> может привести к серьезным проблемам со здоровьем.",
                                "zh": "长期<w>酗酒</w>会导致严重的健康问题。"
                            }
                        },
                        {
                            "text": "He decided to stop <w>drinking</w> for a month.",
                            "target_lang_translations": {
                                "ru": "Он решил бросить <w>пить</w> на месяц.",
                                "zh": "他决定戒<w>酒</w>一个月。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heavy drinking",
                        "binge drinking",
                        "underage drinking",
                        "social drinking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по потреблению жидкостей, особенно алкогольных напитков.",
                        "zh": "摄入液体的行为，尤指饮酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьянство",
                                "target_lang_sense_clarification": "чрезмерное употребление алкоголя"
                            },
                            {
                                "target_lang_word": "питьё",
                                "target_lang_sense_clarification": "процесс потребления жидкости"
                            },
                            {
                                "target_lang_word": "употребление алкоголя",
                                "target_lang_sense_clarification": "формальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喝酒",
                                "target_lang_sense_clarification": "饮酒行为"
                            },
                            {
                                "target_lang_word": "酗酒",
                                "target_lang_sense_clarification": "过度饮酒"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f00626e3-d0f7-3f65-845b-3a33df0768f7",
                    "sense_definition": "Safe and suitable for swallowing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to find a source of clean <w>drinking</w> water.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти источник чистой <w>питьевой</w> воды.",
                                "zh": "我们需要找到一个干净的<w>饮用</w>水源。"
                            }
                        },
                        {
                            "text": "The city ensures that the <w>drinking</w> water is safe for everyone.",
                            "target_lang_translations": {
                                "ru": "Город гарантирует, что <w>питьевая</w> вода безопасна для всех.",
                                "zh": "城市确保<w>饮用</w>水对每个人都是安全的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drinking water",
                        "drinking fountain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Безопасный и пригодный для питья.",
                        "zh": "安全且适合饮用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "питьевой",
                                "target_lang_sense_clarification": "о воде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "饮用",
                                "target_lang_sense_clarification": "用于修饰水"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4dcc94d-66fb-3799-ad39-f106925b4b71",
                    "sense_definition": "Designed or used for holding or consuming liquids.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She accidentally broke her favorite <w>drinking</w> glass.",
                            "target_lang_translations": {
                                "ru": "Она случайно разбила свой любимый стакан <w>для питья</w>.",
                                "zh": "她不小心打碎了她最喜欢的<w>饮用</w>玻璃杯。"
                            }
                        },
                        {
                            "text": "The child used a plastic <w>drinking</w> straw for his soda.",
                            "target_lang_translations": {
                                "ru": "Ребенок использовал пластиковую трубочку <w>для питья</w> своей газировки.",
                                "zh": "孩子用一根塑料<w>饮用</w>吸管喝汽水。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drinking glass",
                        "drinking straw",
                        "drinking vessel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный или используемый для хранения или потребления жидкостей.",
                        "zh": "设计用于盛放或饮用液体的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "для питья",
                                "target_lang_sense_clarification": "предназначение предмета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "饮用",
                                "target_lang_sense_clarification": "用于器具名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "314d659b-3534-36ef-8e30-a10ac0f7e7e1",
                    "sense_definition": "Relating to the consumption of alcohol.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alcohol_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to the pub with his old <w>drinking</w> companions.",
                            "target_lang_translations": {
                                "ru": "Он пошел в паб со своими старыми приятелями по <w>выпивке</w>.",
                                "zh": "他和老<w>酒</w>友一起去了酒吧。"
                            }
                        },
                        {
                            "text": "The group sang a loud and cheerful <w>drinking</w> song.",
                            "target_lang_translations": {
                                "ru": "Группа пела громкую и веселую <w>застольную</w> песню.",
                                "zh": "大家唱了一首响亮而欢快的<w>酒</w>歌。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drinking companion",
                        "drinking buddy",
                        "drinking song",
                        "drinking problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к потреблению алкоголя.",
                        "zh": "与饮酒相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застольный",
                                "target_lang_sense_clarification": "связанный с песнями, застольем"
                            },
                            {
                                "target_lang_word": "питейный",
                                "target_lang_sense_clarification": "связанный с заведениями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酒",
                                "target_lang_sense_clarification": "用于描述与酒相关的活动或物品"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}