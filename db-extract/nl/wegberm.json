                "senses": [
                    {
                        "sense_id": "b9b71b64-ebf5-3227-b0ce-3bb5aa813e5f",
                        "entry_id": "20b889db-4279-3ea5-aec5-0fcba3c0dd78",
                        "glosses": [
                            "de strook grond vlak naast een (verharde) weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af199700-3cc5-499e-8460-e01f0c2f4b1a",
                                "sense_id": "b9b71b64-ebf5-3227-b0ce-3bb5aa813e5f",
                                "text": "De auto is keurig opgeruimd en er worden geen sporen van een vette vreetpartij achtergelaten. De troep verdwijnt in het niets. Nou ja, in het niets. In de betrekkelijke leegte van een verlaten wegberm of een doodstille straat. En bij voorkeur in het donker."
                            },
                            {
                                "example_id": "7894c269-e48b-4afc-b930-519e071125ae",
                                "sense_id": "b9b71b64-ebf5-3227-b0ce-3bb5aa813e5f",
                                "text": "Maar vier jaar na de introductie van de in de wegberm te leggen betongoot, die hetzelfde geluiddempende effect heeft als het veel duurdere geluidsscherm, is er nog steeds geen sprake van grootschalige productie."
                            },
                            {
                                "example_id": "da282b9c-916d-4a35-a4d6-7f019d95e0cf",
                                "sense_id": "b9b71b64-ebf5-3227-b0ce-3bb5aa813e5f",
                                "text": "Volgens Patrick Rugebregt van de SWOV zijn al in 2013 aanbevelingen gedaan om het aantal dodelijke ongevallen op dergelijke wegen te verminderen. “Het helpt enorm als de wegberm verhard wordt met bijvoorbeeld grasbetonklinkers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7e8ee74-1947-4692-847a-bfdc8ee8f67d",
                        "source_entry_id": "20b889db-4279-3ea5-aec5-0fcba3c0dd78",
                        "source_sense_id": "b9b71b64-ebf5-3227-b0ce-3bb5aa813e5f",
