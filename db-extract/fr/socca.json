                        ],
                        "examples": [
                            {
                                "example_id": "65ec4f37-8e07-4867-9502-e827efd0e807",
                                "sense_id": "71d53eea-48f3-3ff2-91c6-946b18ce64b5",
                                "text": "Pour le déjeuner, ma mère avait cuisiné léger, une socca, une tarte niçoise à base de farine de pois chiches que l'on dégustait traditionnellement dans les ruelles de la vieille ville."
                            }
                        ]
                    }
