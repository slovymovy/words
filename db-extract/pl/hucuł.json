                    {
                        "sense_id": "5e169407-0e56-3795-94ff-4a3caa7c5280",
                        "entry_id": "8252785a-855a-3cd8-8d03-60ba9d33f527",
                        "glosses": [
                            "góral zamieszkujący Karpaty Wschodnie (tereny południowo-zachodniej Ukrainy)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86a336cc-470b-4210-8a96-d021313a9c9c",
                                "sense_id": "5e169407-0e56-3795-94ff-4a3caa7c5280",
                                "text": "Dla Hucuła nie ma życia, jak na połoninie • Gdy go losy w doły rzucą wnet z tęsknoty zginie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1db38a8-795b-488d-b9bd-051f3bcf8470",
