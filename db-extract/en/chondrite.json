                    },
                    {
                        "translation_id": "86a4ac33-e206-4b57-9f22-5d1e185aafcc",
                        "source_entry_id": "820bd4c3-8a19-3c03-9f05-9628767cd095",
                        "source_sense_id": "e17a2fc4-7419-3ef2-8e5c-89da553430d5",
                        "source_sense_description": "meteorite",
                        "target_lang_word": "chondrite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chondrite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "259e4ac9-7869-3255-bd7e-c1ef85f18b4e",
                                        "entry_id": "aaf84ddb-0c69-3b7a-9f8d-57bace8be8cc",
                                        "glosses": [
                                            "Sorte d'inflammation d'un cartilage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75780e37-a756-4c4f-aa41-0aa76d385a7e",
                                                "sense_id": "259e4ac9-7869-3255-bd7e-c1ef85f18b4e",
                                                "text": "Certains patients développent une chondrite ou une sténose; dans quelques cas, une laryngectomie est nécessaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bec048c-5119-31e5-a44a-e9352e6e2477",
                                        "entry_id": "aaf84ddb-0c69-3b7a-9f8d-57bace8be8cc",
                                        "glosses": [
                                            "Météorite pierreuse contenant des chondres (petites sphérules silicatées)."
                                        ],
                                        "tags": [
                                            "Astrochimie",
                                            "Planétologie",
                                            "Géochimie",
                                            "Muséologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d547ed8c-9e7a-4fb9-83c1-704b27313adf",
                                                "sense_id": "0bec048c-5119-31e5-a44a-e9352e6e2477",
                                                "text": "Chondrites carbonées."
                                            },
                                            {
                                                "example_id": "46e1ec3d-35ab-4839-9f07-02c3cf1778d4",
                                                "sense_id": "0bec048c-5119-31e5-a44a-e9352e6e2477",
                                                "text": "Des myriades de petits corps célestes, les chondrites (des astéroïdes primitifs), se sont agglomérés pour donner naissance à la planète. La chaleur accumulée lors de ce processus a fait fondre la roche sur plus de 1 000 kilomètres d’épaisseur pour former un océan de magma."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chondrite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "897739b9-9c1f-3d5d-8e7d-f022316d4e0d",
                                        "entry_id": "0292d453-a88c-38ae-ba73-ab190ec31ca4",
                                        "glosses": [
                                            "Qui est composé de chondrite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdc58f6c-69c2-4137-b8de-2a2a498ea235",
                                                "sense_id": "897739b9-9c1f-3d5d-8e7d-f022316d4e0d",
                                                "text": "Les météorites chondrites ou pierreuses représentent 80 % de celles qui percutent la Terre."
                                            },
                                            {
                                                "example_id": "5e442d4c-8390-4e7a-a836-cf89bd87324c",
                                                "sense_id": "897739b9-9c1f-3d5d-8e7d-f022316d4e0d",
                                                "text": "Pour tester cette hypothèse, les chercheurs ont analysé l'\"empreinte\" isotopique de morceaux de ces d’astéroïdes qui ont pris la forme de météorites chondrites carbonées riches en eau une fois parvenue à la surface terrestre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e9d49f5-098f-4446-983a-f43241b64587",
                        "source_entry_id": "820bd4c3-8a19-3c03-9f05-9628767cd095",
                        "source_sense_id": "e17a2fc4-7419-3ef2-8e5c-89da553430d5",
                        "source_sense_description": "meteorite",
                        "target_lang_word": "Chondrit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chondrit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34297918-321b-3b31-9a10-69c92d12a182",
                                        "entry_id": "c3534a08-84fe-3c6f-b85d-de725f28e434",
                                        "glosses": [
                                            "weitgehend aus Chondren aufgebauter Steinmeteorit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8413512f-09a4-401f-8763-bbe9cdbaa254",
                                                "sense_id": "34297918-321b-3b31-9a10-69c92d12a182",
                                                "text": "Auch Chondrite sind Kollisionsschutt, gehörten jedoch zu Himmelskörpern, die niemals aufschmolzen."
                                            },
                                            {
                                                "example_id": "b32a166f-62be-4d71-a826-a2544f1e6b5e",
                                                "sense_id": "34297918-321b-3b31-9a10-69c92d12a182",
                                                "text": "Schon bald erwies sich der Murchison-Meteorit als wahrer Schatz für die Forschung. Er gehört zu den primitiven kohligen Chondriten, die seit ihrer Entstehung im solaren Urnebel vor 4,56 Milliarden Jahren fast unverändert erhalten geblieben sind."
                                            },
                                            {
                                                "example_id": "a80ce52b-5906-47cc-b877-75c0cc4b96fd",
                                                "sense_id": "34297918-321b-3b31-9a10-69c92d12a182",
                                                "text": "Bischoff: „Gewöhnliche Chondrite, mit rund 70 Prozent die häufigste Klasse, enthalten hauptsächlich das Mineral Olivin. Neuschwanstein besitzt dagegen überhaupt kein Olivin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf8b2e3d-c47a-34a2-9897-fcc07b9c8bb9",
                                        "entry_id": "c3534a08-84fe-3c6f-b85d-de725f28e434",
                                        "glosses": [
                                            "pflanzlichen Fossilien ähnelnde Verzweigungen in Gesteinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce7fe474-39d2-4ec1-ac56-5db67c74e392",
                                                "sense_id": "bf8b2e3d-c47a-34a2-9897-fcc07b9c8bb9",
                                                "text": "Das ausgeschiedene Sediment ist heller, weil Verwertbares verdaut wurde; Chondriten werden diese Spuren genannt. Früher wurden sie als Seegrasabdrücke angesprochen, aufgrund ihrer Ähnlichkeit mit diesen Pflanzen."
                                            },
                                            {
                                                "example_id": "5889c80b-6b59-4b6c-aa51-8c2210591d95",
                                                "sense_id": "bf8b2e3d-c47a-34a2-9897-fcc07b9c8bb9",
                                                "text": "Die hier gefundenen fiederförmig geästeten Chondriten ähneln im Gegensatz zu den andersgeformten Chondriten der Oberkreide, den Unterkreideformen, was aus dem Wienerwald bestätigt werden kann."
                                            },
                                            {
                                                "example_id": "445899d9-6c81-431c-8361-1b7b69a5fe6e",
                                                "sense_id": "bf8b2e3d-c47a-34a2-9897-fcc07b9c8bb9",
                                                "text": "Auch andere bituminöse und pflanzliche Reste wie Fucoiden und Chondriten kann man in diesen Schichten finden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
