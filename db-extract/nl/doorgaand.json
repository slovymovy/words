                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e080a92c-361e-445f-9784-645c87e0dee3",
                                "sense_id": "254bba44-4721-3e59-92f9-9c4457b57d92",
                                "text": "Het woord passaat, waarschijnlijk een verkorting van passaatwind, is van 1637; in de 16e eeuw noemde men het nog eenparige of doorgaande wind."
                            }
                        ]
                    }
