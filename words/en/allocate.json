{
    "word_family": [
        "allocation",
        "allocator",
        "reallocate",
        "misallocate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e45e11b-b297-316d-ba51-007b5faa253c",
                    "sense_definition": "To distribute resources, money, or duties according to a specific plan or for a particular purpose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government must <w>allocate</w> funds to improve the local infrastructure and public transport.",
                            "target_lang_translations": {
                                "ru": "Правительство должно <w>выделить</w> средства на улучшение местной инфраструктуры и общественного транспорта."
                            }
                        },
                        {
                            "text": "It is difficult to <w>allocate</w> resources fairly when every department has such high demands.",
                            "target_lang_translations": {
                                "ru": "Трудно справедливо <w>распределить</w> ресурсы, когда у каждого отдела такие высокие требования."
                            }
                        }
                    ],
                    "synonyms": [
                        "assign",
                        "designate",
                        "appropriate"
                    ],
                    "common_phrases": [
                        "allocate funds",
                        "allocate resources",
                        "allocate budget"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределять ресурсы, деньги или обязанности в соответствии с определенным планом или для конкретной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распределять",
                                "target_lang_sense_clarification": "делить ресурсы или задачи между кем-либо"
                            },
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "предоставлять средства или ресурсы для определенной цели"
                            },
                            {
                                "target_lang_word": "ассигновать",
                                "target_lang_sense_clarification": "официально выделять денежные средства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c77a6ef-22d0-392a-b41c-9f40b1c0a7b7",
                    "sense_definition": "To set something aside for a specific future use or person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not eat the cake, as it is <w>allocated</w> for the dinner party tomorrow.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не ешьте торт, так как он <w>предназначен</w> для завтрашнего званого ужина."
                            }
                        },
                        {
                            "text": "The manager decided to <w>allocate</w> time each week for team-building exercises.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил <w>отводить</w> время каждую неделю на упражнения по тимбилдингу."
                            }
                        }
                    ],
                    "synonyms": [
                        "earmark",
                        "set aside",
                        "dedicate"
                    ],
                    "common_phrases": [
                        "allocate time",
                        "allocate space"
                    ],
                    "target_lang_definitions": {
                        "ru": "Откладывать или резервировать что-либо для конкретного использования в будущем или для определенного человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "предоставлять место или время"
                            },
                            {
                                "target_lang_word": "предназначать",
                                "target_lang_sense_clarification": "определять цель использования чего-либо"
                            },
                            {
                                "target_lang_word": "резервировать",
                                "target_lang_sense_clarification": "сохранять для будущего использования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d1b1b35-8e3b-3efc-8d4b-91530ed624ca",
                    "sense_definition": "To reserve a specific portion of computer memory for a program or process.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operating system will <w>allocate</w> memory to the application as soon as it starts.",
                            "target_lang_translations": {
                                "ru": "Операционная система <w>выделит</w> память приложению, как только оно запустится."
                            }
                        },
                        {
                            "text": "If the software fails to <w>allocate</w> memory properly, the entire system might crash.",
                            "target_lang_translations": {
                                "ru": "Если программному обеспечению не удастся правильно <w>выделить</w> память, вся система может выйти из строя."
                            }
                        }
                    ],
                    "antonyms": [
                        "deallocate",
                        "free"
                    ],
                    "common_phrases": [
                        "allocate memory",
                        "allocate storage"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резервировать определенную часть компьютерной памяти для программы или процесса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "о памяти в программировании"
                            },
                            {
                                "target_lang_word": "аллоцировать",
                                "target_lang_sense_clarification": "технический термин в IT"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b7c2deb0-5e9d-33c5-93ee-05317aee956e",
                    "sense_definition": "Being in a state of having been <w>allocated</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>allocate</w> shares were distributed among the founding members of the startup.",
                            "target_lang_translations": {
                                "ru": "<w>Распределенные</w> акции были разделены между основателями стартапа."
                            }
                        },
                        {
                            "text": "He checked the list of <w>allocate</w> items to ensure nothing was missing from the shipment.",
                            "target_lang_translations": {
                                "ru": "Он проверил список <w>выделенных</w> позиций, чтобы убедиться, что в поставке ничего не хватает."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии распределения или выделения (устаревшее использование)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распределенный",
                                "target_lang_sense_clarification": "о долях или предметах"
                            },
                            {
                                "target_lang_word": "выделенный",
                                "target_lang_sense_clarification": "о ресурсах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "254123cd-8d1b-3717-a5b0-83ef8a410d3c",
                    "sense_definition": "A legal document or writ that authorizes a payment, grant, or allowance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court issued an <w>allocate</w> to ensure the funds were paid to the rightful heir.",
                            "target_lang_translations": {
                                "ru": "Суд выдал <w>предписание</w>, чтобы гарантировать выплату средств законному наследнику."
                            }
                        },
                        {
                            "text": "The historical archives contain an old <w>allocate</w> signed by the king himself.",
                            "target_lang_translations": {
                                "ru": "В исторических архивах хранится старый <w>указ</w> о выплате, подписанный самим королем."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридический документ или приказ, санкционирующий выплату, грант или пособие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предписание",
                                "target_lang_sense_clarification": "о выплате"
                            },
                            {
                                "target_lang_word": "ордер",
                                "target_lang_sense_clarification": "на выдачу средств"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}