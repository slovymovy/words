                    {
                        "translation_id": "def2d41d-ea8d-4156-99e1-315b6c419e5a",
                        "source_entry_id": "ae8b6697-76eb-3cb1-a3a6-2e558063315f",
                        "source_sense_id": "f1a747a8-db07-34b2-94aa-b46f40dd808f",
                        "target_lang_word": "sealion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sealion",
