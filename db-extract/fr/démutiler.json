                "senses": [
                    {
                        "sense_id": "606fec86-aa15-333b-bbe6-b5ef39578ae8",
                        "entry_id": "11f4536a-46af-3b3d-8aab-286cedaadf41",
                        "glosses": [
                            "Annuler une mutilation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27145616-0b54-49d2-81e8-59d51b63b400",
                                "sense_id": "606fec86-aa15-333b-bbe6-b5ef39578ae8",
                                "text": "Mai a illustré sa structuration spécifique, donnant de la politique une image démutilée et désaliénée, séduisante à tous ceux qui lui croyaient un visage austère."
                            },
                            {
                                "example_id": "e37c2e86-6a47-4627-a590-289604bcb026",
                                "sense_id": "606fec86-aa15-333b-bbe6-b5ef39578ae8",
                                "text": "Les maintenant sont “désamputés” de ces rapports, et ainsi “démutilés”, ils ne se font plus simplement suite (constituant un l’un après l’autre), mais se comprennent comme chacun possédant dans sa suite part des précédents et des suivants."
                            },
                            {
                                "example_id": "fba5eaa5-b94d-470a-b485-741500e6c5d6",
                                "sense_id": "606fec86-aa15-333b-bbe6-b5ef39578ae8",
                                "text": "Démutile-toi."
                            }
                        ]
                    }
