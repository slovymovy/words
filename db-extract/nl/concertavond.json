                        "tags": [],
                        "examples": [
                            {
                                "example_id": "155fec43-fd06-49ba-aeda-b4bca96fcb89",
                                "sense_id": "9152fc5c-7977-3051-8e9a-84eae0d3dc6e",
                                "text": "Ronald Snijders krijgt de prijs in december uitgereikt tijdens een concertavond in Amsterdam. De prijs is vernoemd naar de bekende Nederlandse jazzlegende Boy Edgar (1915-1980)."
                            },
                            {
                                "example_id": "6093d25d-d4cd-42c8-bac6-a261eec16cff",
                                "sense_id": "9152fc5c-7977-3051-8e9a-84eae0d3dc6e",
                                "text": "Vanavond geeft de koning een staatsbanket ter ere van zijn Belgische gasten. Filip houdt morgen een concertavond in het Muziekgebouw aan ‘t IJ met het Nationaal Orkest van België en Ozark Henry."
                            },
                            {
                                "example_id": "38f92764-6b26-4444-bd75-8209235f53d0",
                                "sense_id": "9152fc5c-7977-3051-8e9a-84eae0d3dc6e",
                                "text": "De prijs bestaat uit een bedrag van 12.500 euro en een plastiek van Jan Wolkers. De uitreiking is op 9 juni in het Bimhuis in Amsterdam. Van Geel mag voor die gelegenheid zelf een concertavond samenstellen."
                            }
                        ]
                    }
