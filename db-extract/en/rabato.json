                        "glosses": [
                            "Stiff collar, wired or starched, worn in the 16th and 17th centuries; sometimes used as a support for the ruff."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c51ae9c-b32b-4a3f-80bb-59c1aa02d225",
                                "sense_id": "d0db819c-ffce-34d6-84a9-31cb178906bc",
                                "text": "Margaret: Troth, I think your other rabato were better.\nHero: No, pray thee, good Meg, I'll wear this.\nMargaret: By my troth's not so good; and I warrant your cousin will say so."
                            }
                        ]
