                                "target_senses": [
                                    {
                                        "sense_id": "8bddcdd2-7acd-34c0-965c-400663f658c8",
                                        "entry_id": "abd0c3cd-0700-38f8-8a08-6383efdd23db",
                                        "glosses": [
                                            "A general belief that bad things will happen."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b199bd-f3f6-454e-97c7-42bf30c4f44b",
                                                "sense_id": "8bddcdd2-7acd-34c0-965c-400663f658c8",
                                                "text": "T2 isn’t as good as T1: it is a little too long and unwinds a bit into caper sentimentality, broad comedy and self-mythologising. But it has the same punchy energy, the same defiant pessimism, and there’s nothing around like it. This sequel was a high-wire act, but Boyle has made it to the other side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5487bbe-8059-3b56-b9ce-f2ac760f6ff7",
                                        "entry_id": "abd0c3cd-0700-38f8-8a08-6383efdd23db",
                                        "glosses": [
                                            "The doctrine that this world is the worst of all possible worlds."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a8f3eb9-9d2a-3401-900b-f37bef55981c",
                                        "entry_id": "abd0c3cd-0700-38f8-8a08-6383efdd23db",
                                        "glosses": [
                                            "The condition of being pessimal."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70a2c329-2440-4162-a1f3-12d8bd4117ab",
                        "source_entry_id": "4922d706-a9b9-3d08-bd0c-a55641a70777",
                        "source_sense_id": "b5270ff1-7e85-3d11-8c7a-b74efd61a949",
                        "target_lang_word": "pessimisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pessimisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a146512-193d-320a-9e6b-cc2f71649e8f",
                                        "entry_id": "1a744678-e2d2-39ca-98c5-504ce5497be3",
                                        "glosses": [
                                            "Doctrine philosophique selon laquelle le mal l’emporte sur le bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "202a733e-2e64-4189-8a25-a29a93771986",
                                                "sense_id": "7a146512-193d-320a-9e6b-cc2f71649e8f",
                                                "text": "J’imagine que le pessimisme grec provient de tribus pauvres, guerrières et montagnardes, qui avaient un énorme orgueil aristocratique, mais dont la situation était par contre fort médiocre […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85cdb353-7fc1-39c8-b027-6a170eee3fb6",
                                        "entry_id": "1a744678-e2d2-39ca-98c5-504ce5497be3",
                                        "glosses": [
                                            "Opinion, état d’esprit, de ceux qui sont portés à croire que tout va mal."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b022459-d4bb-4a08-8488-6770ec8096d9",
                                                "sense_id": "85cdb353-7fc1-39c8-b027-6a170eee3fb6",
                                                "text": "Vous voulez sans doute dire, monsieur, que la vie est sans but? N'est-ce pas ce qu'on appelle le pessimisme?"
                                            },
                                            {
                                                "example_id": "4869faa8-0f50-4719-8ea5-a594c378cb84",
                                                "sense_id": "85cdb353-7fc1-39c8-b027-6a170eee3fb6",
                                                "text": "En dépit du mauvais pressentiment qui s'insinue en moi, je continue d'espérer. Il m'arrive parfois d'outrepasser mon pessimisme et de me retrouver « déçu en bien », comme disent les Suisses romands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
