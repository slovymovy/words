                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur trace un vecteur <w>normal</w> à la surface de la sphère pour expliquer le cours."
                        },
                        {
                            "text": "Cette droite est <w>normale</w> au plan horizontal en ce point précis."
                        }
                    ],
                    "common_phrases": [
