                "senses": [
                    {
                        "sense_id": "60a43ad7-9e52-3b9e-aa85-3afaebee116a",
                        "entry_id": "8baa6488-b219-3f1d-9d35-aae8a644f42f",
                        "glosses": [
                            "свойство или состояние по значению прилагательного ровный"
                        ],
                        "tags": [],
