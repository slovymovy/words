                        "glosses": [
                            "Longevous, long-lived."
                        ],
                        "tags": [
                            "obsolete",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "87040b5c-f42e-4184-8c23-cec38cfc6834",
                                "sense_id": "06f3651a-8edb-32f3-8959-a5beaf8d2627",
                                "text": "1673-4, Grew, Veget. Trunks, iii: According as the Tree is less or more Longæve."
                            },
                            {
                                "example_id": "701c0373-4bd6-41e2-9926-7ebe41a56fac",
                                "sense_id": "06f3651a-8edb-32f3-8959-a5beaf8d2627",
                                "text": "But the only use which that Philosopher makes of this Story is this, to prove that Demons having Bodies as well as men, (though of a different kind from them and much more longeve) yet were notwithstanding Mortal : […]"
                            },
                            {
                                "example_id": "1d5c0e5e-9826-4caa-b881-32fedda4b402",
                                "sense_id": "06f3651a-8edb-32f3-8959-a5beaf8d2627",
                                "text": "Whatever forms the average, strong, complete, sweet-blooded man or woman, the perfect longeve personality, / And helps its present life to health […]"
                            },
                            {
                                "example_id": "a54dc37b-275d-43a7-8e54-8c1b41fe8d4d",
                                "sense_id": "06f3651a-8edb-32f3-8959-a5beaf8d2627",
                                "text": "The most long-lived men can arrive up to one hundred years, while the medium and less longeve respectively can live up to eighty and sixty years."
                            }
                        ]
                    }
                ],
