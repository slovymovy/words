                "senses": [
                    {
                        "sense_id": "8a8ef8db-ea78-332a-8fdd-df9fbd39678c",
                        "entry_id": "66802059-f66e-3491-a672-86a0e4ec7c39",
                        "glosses": [
                            "To stop beating."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3f803829-8201-3864-b4b0-2a3f070fe00a",
                        "entry_id": "66802059-f66e-3491-a672-86a0e4ec7c39",
                        "glosses": [
                            "To die."
                        ],
                        "tags": [
                            "broadly",
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8a8c0e49-c477-3897-b974-6480b0f129fe",
                        "entry_id": "66802059-f66e-3491-a672-86a0e4ec7c39",
                        "glosses": [
                            "To kill."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "066d5906-e236-464f-981c-7ff7dfea4494",
                                "sense_id": "8a8c0e49-c477-3897-b974-6480b0f129fe",
                                "text": "If looks could kill, Mona's sharp gaze would have flatlined him in one second."
                            },
                            {
                                "example_id": "e9bef053-04b8-4a32-88df-23c833049b42",
                                "sense_id": "8a8c0e49-c477-3897-b974-6480b0f129fe",
                                "text": "After all she'd been through, she needed sleep and food to heal, not endure a lovemaking session that was so passionate that it had pretty much flatlined him as well."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc53e96a-379b-33bc-898f-dbf289fc8ef1",
                        "entry_id": "66802059-f66e-3491-a672-86a0e4ec7c39",
                        "glosses": [
                            "To remain at the same level, without development; or, to fall."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d1e0bd77-6b2e-4dc0-905d-17a8a94967f3",
                                "sense_id": "dc53e96a-379b-33bc-898f-dbf289fc8ef1",
                                "text": "The economy in Northern Ireland is flatlining and jobs are scarce."
                            },
                            {
                                "example_id": "835a2083-dddd-44f0-862f-a24450539fba",
                                "sense_id": "dc53e96a-379b-33bc-898f-dbf289fc8ef1",
                                "text": "But passenger numbers have since recovered to only 85% of pre-March 2020 levels, and growth has flatlined."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fdf0ae8-215d-346a-8cdd-c7748663f5ad",
                        "entry_id": "66802059-f66e-3491-a672-86a0e4ec7c39",
                        "glosses": [
                            "To experience significantly decreased rates of change compared to previous rates of change."
                        ],
                        "tags": [
                            "of a graph"
                        ],
                        "examples": [
                            {
                                "example_id": "bc6b003a-0261-4a00-8d8b-bc24ee5a6e44",
                                "sense_id": "0fdf0ae8-215d-346a-8cdd-c7748663f5ad",
                                "text": "Upon upload, the video got 1,000 views/day for the first week, then flatlined and started getting fewer than ten views/day."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a5395e2-7ae4-37c9-b33c-9786ec84e664",
                        "entry_id": "66802059-f66e-3491-a672-86a0e4ec7c39",
                        "glosses": [
                            "To fish using a flatline."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
