                            {
                                "example_id": "265683e1-d3e6-4d2a-ae5b-6d1e7507ca60",
                                "sense_id": "c08f326a-9b6b-35a4-b3b7-e386a04e3e0b",
                                "text": "Bei der Schiffstaufe war auch die Schiffseignerin anwesend."
                            },
                            {
                                "example_id": "88f6055e-432d-4bfa-8cc1-2301c3c45216",
                                "sense_id": "c08f326a-9b6b-35a4-b3b7-e386a04e3e0b",
                                "text": "„Während wir einerseits erfahren, was den wortkargen Schiffergehilfen mit der unbekannten Toten verband, werden wir andererseits Zeuge, wie er (zunächst) mit der verheirateten Schiffseignerin eine Affäre beginnt.“"
                            }
                        ],
