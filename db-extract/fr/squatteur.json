                    },
                    {
                        "form_id": "0920b899-d310-455c-8048-812ef3511659",
                        "entry_id": "a25236c1-9843-38f5-bc46-5f872f0aa94d",
                        "tags": [
                            "feminine"
                        ],
                        "form": "squatteuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32ba5199-a8e8-3106-926a-7a3cd06a9dea",
                        "entry_id": "a25236c1-9843-38f5-bc46-5f872f0aa94d",
                        "glosses": [
                            "Personne qui squatte, qui occupe de façon illégale un bâtiment, un terrain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8b6c6fc-98a9-4777-b4f0-dcf06c42de75",
                                "sense_id": "32ba5199-a8e8-3106-926a-7a3cd06a9dea",
                                "text": "Et de citer une réaction sincère à la question du nom : « Zadiste ? C'est quoi, cette étiquette de connard qu'on s'colle sur la tête ? Je vis ici, je suis squatteur, mais je veux plus qu'on m'appelle zadiste. » Être désigné, c'est en effet subir une forme de pouvoir."
                            },
                            {
                                "example_id": "5bc607b6-2176-4a73-8ef9-3d4bd8c36f07",
                                "sense_id": "32ba5199-a8e8-3106-926a-7a3cd06a9dea",
                                "text": "\"On va barricader bien comme il faut\", réagit immédiatement Elise Aubry, une squatteuse de 27 ans."
                            },
                            {
                                "example_id": "928f53ff-8421-4e48-83a9-be0031c574db",
                                "sense_id": "32ba5199-a8e8-3106-926a-7a3cd06a9dea",
                                "text": "Si le squatteur s’est « installé » en aménageant les lieux (changement des serrures, raccordements électriques, à l’eau ou au gaz…), le logement est devenu son propre domicile et il est protégé par le même texte que le propriétaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e3881e3-21e1-3bb0-be5f-a55567965453",
                        "entry_id": "a25236c1-9843-38f5-bc46-5f872f0aa94d",
                        "glosses": [
                            "Colon étasunien qui occupait illégalement une région de l'ouest des États-Unis."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ef947d8b-1d77-37a2-9251-e3b4b7bee4dc",
                        "entry_id": "a25236c1-9843-38f5-bc46-5f872f0aa94d",
                        "glosses": [
                            "Personne qui occupe longtemps un lieu où elle n’est pas désirée, parasite."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6c04aa97-c293-4445-86df-951b3a6377dc",
                                "sense_id": "ef947d8b-1d77-37a2-9251-e3b4b7bee4dc",
                                "text": "Ce Robert quel squatteur ! Je l’ai invité à passer une nuit chez moi parce qu’il savait pas où dormir et maintenant ça fait deux mois qu’il me dit qu’il « cherche » un appart’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85a895ec-c1cc-4752-a277-221801c628c9",
                        "source_entry_id": "a25236c1-9843-38f5-bc46-5f872f0aa94d",
                        "target_lang_word": "Hausbesetzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausbesetzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "062bf4d3-7217-300b-b085-8133d35a509e",
                                        "entry_id": "00162635-250d-34c5-95ff-b83effe0ef68",
                                        "glosses": [
                                            "Person, die (unrechtmäßig) in einem leer stehenden Haus wohnt und dies besetzt hält, ohne deren Eigentümer zu sein oder Miete zu bezahlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd16da61-3080-4af9-89df-b0d120ef5cb7",
                                                "sense_id": "062bf4d3-7217-300b-b085-8133d35a509e",
                                                "text": "Oft einigten sich die Hausbesetzer nachträglich mit den Hausbesitzern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff045c88-9ab3-4bd9-8b68-8b9fd973cd7d",
                        "source_entry_id": "a25236c1-9843-38f5-bc46-5f872f0aa94d",
                        "target_lang_word": "squatter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f5ac0ac-810b-3722-8021-3bb94bc1b189",
                                        "entry_id": "b3c3b3d6-2a2f-345b-9679-266f680b7456",
                                        "glosses": [
                                            "One who squats; one who sits down idly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31b5a350-d799-44ba-9c52-c76023aa01b2",
                                                "sense_id": "4f5ac0ac-810b-3722-8021-3bb94bc1b189",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera,[…]the chlorotic squatters on huge yachts, the speed-mad fugitives from the furies of ennui, the neurotic victims of mental cirrhosis, the jewelled animals whose moral code is the code of the barnyard—!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aca0a6d-a188-36fd-8740-756306d37cda",
                                        "entry_id": "b3c3b3d6-2a2f-345b-9679-266f680b7456",
                                        "glosses": [
                                            "One who occupies a building or land without title or permission.",
                                            "One who occupied Crown land."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acc67ee1-a530-4921-a2aa-248e6653b23e",
                                                "sense_id": "2aca0a6d-a188-36fd-8740-756306d37cda",
                                                "text": "While settlement in New South Wales was initially confined, many moved outside the boundaries to become squatters, eventually consolidating their originally illegal hold on the land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4941ae6-99cb-3b23-9821-9052ba240280",
                                        "entry_id": "b3c3b3d6-2a2f-345b-9679-266f680b7456",
                                        "glosses": [
                                            "One who occupies a building or land without title or permission.",
                                            "A poor vagrant; a hobo or beggar; one suffering from extreme poverty."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b4e3eb9-f940-37dd-9f25-328cf196f9fc",
                                        "entry_id": "b3c3b3d6-2a2f-345b-9679-266f680b7456",
                                        "glosses": [
                                            "A large-scale grazier and landowner."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f65f396-7daf-412a-a0dc-d35592584bb7",
                                                "sense_id": "9b4e3eb9-f940-37dd-9f25-328cf196f9fc",
                                                "text": "Down came the squatter, a'riding his thoroughbred, / Down came policemen, one, two and three. /'Whose is the jumbuck you've got in the tucker bag? / You'll come a-waltzing Matilda, with me.'"
                                            },
                                            {
                                                "example_id": "9f6bf28a-b0d0-47e5-9311-53322f66d5ed",
                                                "sense_id": "9b4e3eb9-f940-37dd-9f25-328cf196f9fc",
                                                "text": "Boldrewood was a squatter, a magistrate and a commissioner of goldfields and knew thoroughly the life he described in Robbery Under Arms (1888), the story of the bushranger Captain Starlight—first serialised in The Sydney Mail in 1881—and in his numerous other novels, which included The Squatter′s Dream (1890)."
                                            },
                                            {
                                                "example_id": "780f7539-ba1f-40db-abda-84811fb5261d",
                                                "sense_id": "9b4e3eb9-f940-37dd-9f25-328cf196f9fc",
                                                "text": "In Parliament, at least, the squatters were secure. ¶ In the early 1840s a severe depression threatened livelihoods in all the colonies except South Australia and many squatters resorted to slaughtering their sheep and boiling them down for tallow."
                                            },
                                            {
                                                "example_id": "87f1de98-dc12-46ab-9549-580ab827cb25",
                                                "sense_id": "9b4e3eb9-f940-37dd-9f25-328cf196f9fc",
                                                "text": "His dealings with squatter R. R. McBean and superintendents Hare and Nicolson amaze the 16-year-old, who has little experience with the wealthy privileged class."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4039e0-0461-38fd-95cc-89c7aac1572b",
                                        "entry_id": "b3c3b3d6-2a2f-345b-9679-266f680b7456",
                                        "glosses": [
                                            "A squat toilet."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56346016-0b57-48e7-96de-736e53e516dc",
                                                "sense_id": "3f4039e0-0461-38fd-95cc-89c7aac1572b",
                                                "text": "All of the toilets in both the men's and women's sides were squatters."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06c76a22-63de-30f9-84c7-9d4e3c377fc0",
                                        "entry_id": "1cebdfcd-7250-3226-8795-ebd767895269",
                                        "glosses": [
                                            "comparative form of squat: more squat"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "746c5b2d-45d6-47c6-a5fd-6f0397140b95",
                                                "sense_id": "06c76a22-63de-30f9-84c7-9d4e3c377fc0",
                                                "text": "Nearer at hand, to the left of a huge block (a telephone exchange) and over the top of another, lower, survivor of the blitz, rises the pinnacled tower of St. Alban's Church, and just to the left a glimpse can be obtained of the top of the squatter tower of St. Mary's Aldermanbury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
