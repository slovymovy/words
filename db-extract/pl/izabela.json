                    {
                        "translation_id": "271794b2-6b20-4303-b413-c994ca1a4f05",
                        "source_entry_id": "bf384927-eed2-32b5-abf7-e1fd59b9808d",
                        "source_sense_id": "33601eed-2fda-390f-8a74-552a4419f8ac",
                        "target_lang_word": "Isabelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Isabelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22021dc4-2138-3c53-b02b-86a107a7ca74",
                                        "entry_id": "8512586c-12da-35b3-903d-29dffa2b3393",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7417e15c-5fce-40ef-9655-4bfcfdc9f040",
                                                "sense_id": "22021dc4-2138-3c53-b02b-86a107a7ca74",
                                                "text": "Le Maire. — Ah ! c'est Mademoiselle Isabelle ! Bonjour, Mademoiselle Isabelle !"
                                            },
                                            {
                                                "example_id": "990dac77-d4f1-4c75-97b3-5415bff8eae4",
                                                "sense_id": "22021dc4-2138-3c53-b02b-86a107a7ca74",
                                                "text": "– Elle s’appelle donc Isabelle ? demanda ma mère.\n– Oui, mais sa mère l’appelle Babette.\n– Babette, dit la tante Rose, c’est Élisabeth.\n– Oui, dit ma mère. Isabelle, d’habitude, c’est Bébelle."
                                            },
                                            {
                                                "example_id": "c6c08737-03ae-4da4-9cf6-9727e65ef1a2",
                                                "sense_id": "22021dc4-2138-3c53-b02b-86a107a7ca74",
                                                "text": "Le deuxième long métrage de Laurent Larivière, À propos de Joan, présenté à la Berlinale cette année, met en lumière une Isabelle Huppert bouleversante."
                                            },
                                            {
                                                "example_id": "53ce0652-b954-4b1d-83af-3fd86b05a557",
                                                "sense_id": "22021dc4-2138-3c53-b02b-86a107a7ca74",
                                                "text": "Isabelle a les yeux bleus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
