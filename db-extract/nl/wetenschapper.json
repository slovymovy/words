                ],
                "senses": [
                    {
                        "sense_id": "518a9877-31d0-3193-b00a-a5422f261dc2",
                        "entry_id": "59e54ecd-096e-3bfa-99d5-2e6ba20db70f",
                        "glosses": [
                            "iemand die de wetenschap beoefent"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "3f972e24-4b34-465a-bcdc-0bf778adda1c",
                                "sense_id": "518a9877-31d0-3193-b00a-a5422f261dc2",
                                "text": "Er is in dat gebouw een conferentie van wetenschappers."
                            },
                            {
                                "example_id": "173209a8-4ac7-454e-a770-9a6761527f11",
                                "sense_id": "518a9877-31d0-3193-b00a-a5422f261dc2",
                                "text": "Het ritme van het lopen met soms wel 70.000 stappen per dag vormde een innerlijke kadans, waarvan sommige wetenschappers beweren dat er op deze manier een inventieve samenwerking ontstaat tussen de twee helften van je brein."
                            },
                            {
                                "example_id": "a83eda9d-0c8e-40a6-81c4-ba0d6f54e13e",
                                "sense_id": "518a9877-31d0-3193-b00a-a5422f261dc2",
                                "text": "Minister Kuipers van Volksgezondheid roept de sectoren in de samenleving op zich voor te bereiden op een nieuwe golf coronabesmettingen in het najaar. \"Maak je eigen plan\", zegt hij in een gesprek met NOS. Hij reageert daarmee op de kritiek die ziekenhuisdirecteuren, virologen en wetenschappers vanmorgen uitten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3730a995-3cc0-4208-8f4b-cfe749ee3aca",
                        "source_entry_id": "59e54ecd-096e-3bfa-99d5-2e6ba20db70f",
                        "source_sense_id": "518a9877-31d0-3193-b00a-a5422f261dc2",
                        "source_sense_description": "iemand die de wetenschap beoefent",
                        "target_lang_word": "Wissenschaftler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wissenschaftler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9e9b03a-df9b-301d-bcc7-cef391d7e9f1",
                                        "entry_id": "3d933b3f-9ec2-3fd1-bad8-e97f1fd0ba28",
                                        "glosses": [
                                            "Person mit wissenschaftlicher Ausbildung, die sich mit Wissenschaft beschäftigt"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Forschung",
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fb90964-5654-4d82-9b58-e71414270e0e",
                                                "sense_id": "e9e9b03a-df9b-301d-bcc7-cef391d7e9f1",
                                                "text": "Ratlos saß der Wissenschaftler über seinen Nachschlagewerken."
                                            },
                                            {
                                                "example_id": "e1eee00b-60c4-46b4-bf14-d905e3ce26dc",
                                                "sense_id": "e9e9b03a-df9b-301d-bcc7-cef391d7e9f1",
                                                "text": "Wissenschaftler sind sich mit Schulleitern und Lehrern einig, dass der Schulerfolg der Schüler nicht vom Schulkonzept, sondern in erster Linie davon abhängt, welche Lehrer und welche Schüler eine Schule hat."
                                            },
                                            {
                                                "example_id": "7b739b3c-1308-4c67-80fe-a5eded396132",
                                                "sense_id": "e9e9b03a-df9b-301d-bcc7-cef391d7e9f1",
                                                "text": "„Wissenschaftler und sonst wie Berufene lassen Guttenbergs Dissertation durch Suchmaschinen laufen und vermelden die Ergebnisse auf der Homepage GuttenPlag Wiki.“"
                                            },
                                            {
                                                "example_id": "24030132-4c98-4695-a903-53ac144d16fc",
                                                "sense_id": "e9e9b03a-df9b-301d-bcc7-cef391d7e9f1",
                                                "text": "Für die [Erd-]Erwärmung sei vor allem die Zunahme atmosphärischen Kohlendioxids verantwortlich, sagen die NASA- und NOAA-Wissenschaftler. Seit den 1960er Jahren stieg der CO2-Anteil von 315 ppm (Teilchen pro Million) auf etwa 400 ppm. Grund dafür ist vor allem die Verbrennung fossiler Rohstoffe."
                                            },
                                            {
                                                "example_id": "41570360-a357-4951-adac-694ab69a0703",
                                                "sense_id": "e9e9b03a-df9b-301d-bcc7-cef391d7e9f1",
                                                "text": "„Als Wissenschaftler muss er für eine empirische Betrachtungsweise eintreten, die Projektionen und Spekulationen vermeidet.“"
                                            },
                                            {
                                                "example_id": "9dc16173-e753-4189-bf5b-c015c71c13bd",
                                                "sense_id": "e9e9b03a-df9b-301d-bcc7-cef391d7e9f1",
                                                "text": "„Lediglich die nicht ganz so renommierten Wissenschaftler äußerten bei Fernsehauftritten manchmal Vermutungen, was gelegentlich zu heftigen Streitgesprächen vor laufender Kamera führte.“"
                                            },
                                            {
                                                "example_id": "2ee9dd3a-d33b-4fc4-8c5c-e1e623731a05",
                                                "sense_id": "e9e9b03a-df9b-301d-bcc7-cef391d7e9f1",
                                                "text": "„In der Forschung leisteten deutsche Juden Besonderes: Zwischen 1921 und 1931 waren fünf der 15 deutschen Nobelpreisträger jüdische Wissenschaftler, z. B. Albert Einstein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36172009-cc52-40a3-957d-be509e72b4be",
                        "source_entry_id": "59e54ecd-096e-3bfa-99d5-2e6ba20db70f",
                        "source_sense_id": "518a9877-31d0-3193-b00a-a5422f261dc2",
                        "source_sense_description": "iemand die de wetenschap beoefent",
                        "target_lang_word": "scientist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scientist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c4c7506-9ac6-3380-bf27-5c96c3659908",
                                        "entry_id": "b2c45f0d-6cf2-361d-bde6-f7fbac256a15",
                                        "glosses": [
                                            "One whose activities make use of the scientific method to answer questions regarding the measurable universe. A scientist may be involved in original research, or make use of the results of the research of others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbb67ca3-2343-4417-8e2a-10ef6e496599",
                                                "sense_id": "3c4c7506-9ac6-3380-bf27-5c96c3659908",
                                                "text": "As we cannot use physician for a cultivator of physics, I have called him a physicist. We need very much a name to describe a cultivator of science in general. I should incline to call him a Scientist. Thus we might say, that as an Artist is a Musician, Painter, or Poet, a Scientist is a Mathematician, Physicist, or Naturalist."
                                            },
                                            {
                                                "example_id": "6b1f4b58-aea1-4cf4-80b4-6970880e780f",
                                                "sense_id": "3c4c7506-9ac6-3380-bf27-5c96c3659908",
                                                "text": "Becoming more aware of the progress that scientists have made on behavioral fronts can reduce the risk that other natural scientists will resort to mystical agential accounts when they exceed the limits of their own disciplinary training."
                                            },
                                            {
                                                "example_id": "eb2c6408-533e-40f3-839c-b536627d3ffd",
                                                "sense_id": "3c4c7506-9ac6-3380-bf27-5c96c3659908",
                                                "text": "The US supreme court has ruled unanimously that natural human genes cannot be patented, a decision that scientists and civil rights campaigners said removed a major barrier to patient care and medical innovation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30c0997f-a079-4fc3-9c44-91ec5df9d9b5",
                        "source_entry_id": "59e54ecd-096e-3bfa-99d5-2e6ba20db70f",
                        "source_sense_id": "518a9877-31d0-3193-b00a-a5422f261dc2",
                        "source_sense_description": "iemand die de wetenschap beoefent",
                        "target_lang_word": "scholar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scholar",
