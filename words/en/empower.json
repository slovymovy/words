{
    "word_family": [
        "empowerment",
        "disempower",
        "power"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d38067c-4019-3cc8-b9de-60a8bbc1efb5",
                    "sense_definition": "To give someone more confidence or strength to do something, often by helping them increase control over their own life or situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "personal_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new training program aims to <w>empower</w> employees to make better decisions on site.",
                            "target_lang_translations": {
                                "ru": "Новая программа обучения направлена на то, чтобы <w>расширить возможности</w> сотрудников принимать более эффективные решения на местах."
                            }
                        },
                        {
                            "text": "Starting his own business helped <w>empower</w> individuals by giving them more control over their professional lives.",
                            "target_lang_translations": {
                                "ru": "Открытие собственного дела помогло <w>вселить уверенность</w> в людей, дав им больше контроля над своей профессиональной жизнью."
                            }
                        }
                    ],
                    "synonyms": [
                        "inspire"
                    ],
                    "antonyms": [
                        "disempower",
                        "dishearten",
                        "disspirit"
                    ],
                    "common_phrases": [
                        "empower individuals",
                        "empower employees"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать кому-либо больше уверенности или сил для совершения чего-либо, часто помогая им усилить контроль над собственной жизнью или ситуацией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширять возможности",
                                "target_lang_sense_clarification": "давать ресурсы и уверенность для действий"
                            },
                            {
                                "target_lang_word": "вдохновлять",
                                "target_lang_sense_clarification": "вселять уверенность и силы"
                            },
                            {
                                "target_lang_word": "давать право голоса",
                                "target_lang_sense_clarification": "помогать обрести влияние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42d96ee9-ede6-3dfe-b504-0ce837a6246b",
                    "sense_definition": "To give someone the official or legal authority or right to do something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations <w>empower</w> inspectors to enter the property and seize equipment if necessary.",
                            "target_lang_translations": {
                                "ru": "Новые правила <w>уполномочивают</w> инспекторов входить на территорию и изымать оборудование в случае необходимости."
                            }
                        },
                        {
                            "text": "The law is designed to <w>empower</w> the committee to make final decisions on the project.",
                            "target_lang_translations": {
                                "ru": "Закон призван <w>предоставить право</w> комитету принимать окончательные решения по проекту."
                            }
                        }
                    ],
                    "synonyms": [
                        "allow",
                        "let",
                        "permit"
                    ],
                    "antonyms": [
                        "ban",
                        "bar",
                        "forbid",
                        "prohibit"
                    ],
                    "common_phrases": [
                        "empower the committee",
                        "empower inspectors"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in legal or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять кому-либо официальные или законные полномочия или право на совершение определенных действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уполномочивать",
                                "target_lang_sense_clarification": "наделять официальными полномочиями"
                            },
                            {
                                "target_lang_word": "предоставлять право",
                                "target_lang_sense_clarification": "давать законную возможность действовать"
                            },
                            {
                                "target_lang_word": "наделять властью",
                                "target_lang_sense_clarification": "давать официальную власть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}