                    {
                        "form_id": "cf981507-f01b-4324-916b-e55f363d47cd",
                        "entry_id": "c6a9facb-bdaa-3a99-80f3-3bc4ef3d43e3",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Zusicherung"
                    },
                    {
                        "form_id": "9c4698f5-8819-4fa9-8d62-35ff8087b142",
                        "entry_id": "c6a9facb-bdaa-3a99-80f3-3bc4ef3d43e3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zusicherungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                        "entry_id": "c6a9facb-bdaa-3a99-80f3-3bc4ef3d43e3",
                        "glosses": [
                            "verbindliches Versprechen; das Bekräftigen, Zusagen von etwas, das gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b1ab37-74a3-48c6-a8c5-271222e9fcc1",
                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                "text": "„Die Zusicherung einer bestimmten Grundstücksgröße gilt als Zusicherung einer Eigenschaft.“"
                            },
                            {
                                "example_id": "f0198812-497c-4435-a317-92f5fc7792cd",
                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                "text": "„Für eine Kraftmaschine ist besonders die Zusicherung wichtig, daß sie für eine bestimmte Drehzahl die garantierte Leistung dauernd (ohne Betriebsstörung) abzugeben imstande ist.“"
                            },
                            {
                                "example_id": "cc41919d-4de4-4476-bc44-278022488411",
                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                "text": "„Lucia beruhigt die Patientin mit der Zusicherung, bis jener Tag eintreffe, werde zuvor reichlich viel Zeit vergehen.“"
                            },
                            {
                                "example_id": "1266376c-3ea0-4a7d-8247-aba71a64cc62",
                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                "text": "„Im Verlauf dieses Verfahrens hat die Kommission von den Ausführern der fraglichen Waren befriedigende Zusicherungen erhalten, die es ihr ermöglichen von der Einführung von Schutzmaßnahmen abzusehen.“"
                            },
                            {
                                "example_id": "a932cf13-1979-4bf4-bce1-b2deb544afe8",
                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                "text": "„Eine Nichterfüllung der Informationspflicht liegt auch bei Zusicherung des Verkäufers über eine Eigenschaft der Kaufsache vor, die tatsächlich nicht vorhanden ist.“"
                            },
                            {
                                "example_id": "a2163136-dd40-4d0f-aac9-6bcfe2c834ed",
                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                "text": "„Eine Zusicherung liegt vor, wenn der Verpächter zu erkennen gibt, dass er für den Bestand der betreffenden Eigenschaft und die Folgen ihres Fehlens einstehen will […].“"
                            },
                            {
                                "example_id": "31336045-202f-4bb1-adec-9de2a5f37984",
                                "sense_id": "734ed9ae-f184-3ef1-bd46-1b327f4ff97a",
                                "text": "„Waschanlagen sind austauschbar, die Zusicherung, ein sauberes Auto zu erhalten, allerdings nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
