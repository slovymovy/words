                "senses": [
                    {
                        "sense_id": "b78b6742-340d-31c2-8f31-b041fec9ef5f",
                        "entry_id": "b129b00f-bc72-3551-bd87-a8c6faa22f0f",
                        "glosses": [
                            "Megaptera novaeangliae Borowski, gatunek wieloryba z podrzędu fiszbinowców"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e979d393-8ff0-35af-81ce-cf90603a389d",
                        "entry_id": "b129b00f-bc72-3551-bd87-a8c6faa22f0f",
                        "glosses": [
                            "zwierzę z gatunku humbaków (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50ba06f-5416-4749-8474-d93346f58bb8",
                                "sense_id": "e979d393-8ff0-35af-81ce-cf90603a389d",
                                "text": "Humbaki charakteryzują się bardzo długimi płetwami piersiowymi."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f78b61f4-26d3-4669-bbf5-5cab08082d5c",
                        "source_entry_id": "b129b00f-bc72-3551-bd87-a8c6faa22f0f",
                        "source_sense_id": "b78b6742-340d-31c2-8f31-b041fec9ef5f",
                        "target_lang_word": "humpback",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humpback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84ec01c1-10f5-3051-bb40-d5e3d52093b5",
                                        "entry_id": "512f6272-33de-3fce-8d51-fd6bb3e0878c",
                                        "glosses": [
                                            "A humped back (deformity in humans caused by abnormal curvature of the upper spine)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d88a3d3-7b41-49fc-aa40-5b8bb09b0f2a",
                                                "sense_id": "84ec01c1-10f5-3051-bb40-d5e3d52093b5",
                                                "text": "In the Male Line, there happened an unlucky Accident in the Reign of Richard the Third; the eldest Son of Philip, then Chief of the Family, being born with an Hump-back and very high Nose."
                                            },
                                            {
                                                "example_id": "980d90bf-e96c-4941-bc88-84531ea51bb5",
                                                "sense_id": "84ec01c1-10f5-3051-bb40-d5e3d52093b5",
                                                "text": "[…] the Stone in my Fathers Body was so immense, that I’ve wonder’d it did not bunch up behind, and make him have a Hump-back, or at least overpoise him in walking, and drag him backward with its incredible weight."
                                            },
                                            {
                                                "example_id": "efd368b0-e859-40f8-8cf9-3455c6f130a0",
                                                "sense_id": "84ec01c1-10f5-3051-bb40-d5e3d52093b5",
                                                "text": "Diana Vernon, the most beautiful creature I ever beheld, in love with him, the bandy-legged, bull-necked, limping scoundrel!—Richard the Third in all but his hump-back!"
                                            },
                                            {
                                                "example_id": "7b2928bc-bf37-4d18-a104-7934649441a9",
                                                "sense_id": "84ec01c1-10f5-3051-bb40-d5e3d52093b5",
                                                "text": "[…] Mr. Jos had the honour of leading out the Countess of Schlusselback, an old lady with a hump back, but with sixteen good quarters of nobility and related to half the royal houses of Germany."
                                            },
                                            {
                                                "example_id": "6da4fb85-a317-4c4e-8e44-986ce21f57d1",
                                                "sense_id": "84ec01c1-10f5-3051-bb40-d5e3d52093b5",
                                                "text": "He saw Dmitri half rise from his chair so that the shadow of his humpback shifted on the whitewashed wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4256a61f-7773-38cf-a88f-a4a18032f1a3",
                                        "entry_id": "512f6272-33de-3fce-8d51-fd6bb3e0878c",
                                        "glosses": [
                                            "A humped back (deformity in humans caused by abnormal curvature of the upper spine).",
                                            "A hump or protuberance on the shoulders or back of an animal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be2c4852-803a-479e-a803-09bc4e4dfa1a",
                                                "sense_id": "4256a61f-7773-38cf-a88f-a4a18032f1a3",
                                                "text": "[…] the cows stood about with gloomy eyes and hump-backs, surly and dangerous […]"
                                            },
                                            {
                                                "example_id": "4b440eca-0892-466a-bcaf-bf2111f3d35b",
                                                "sense_id": "4256a61f-7773-38cf-a88f-a4a18032f1a3",
                                                "text": "On the bare hills one begins to see unfamiliar silhouettes of animals against the sky. […] the peaked humpbacks of gnu on a ridge […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5478758f-20c4-370f-9bb8-33f9d59279c3",
                                        "entry_id": "512f6272-33de-3fce-8d51-fd6bb3e0878c",
                                        "glosses": [
                                            "A humped back (deformity in humans caused by abnormal curvature of the upper spine).",
                                            "A rounded topographical feature, such as a mountain or hill."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26f7d2bb-773e-49bb-8cf2-868c7197b339",
                                                "sense_id": "5478758f-20c4-370f-9bb8-33f9d59279c3",
                                                "text": "1858, Royal B. Stratton, Captivity of the Oatman Girls, San Francisco: [for the author], Chapter 4, p. 134,\nOn either side were the high, irregularly sloped mountains, with their foot hills robed in the same bright green as the valley, and with their bald hump-backs and sharp peaks, treeless, verdureless, and desolate […]"
                                            },
                                            {
                                                "example_id": "0eb72a60-7535-4268-8638-e9ddd66f39fa",
                                                "sense_id": "5478758f-20c4-370f-9bb8-33f9d59279c3",
                                                "text": "The Goons kept appearing and disappearing in different places, always closer to them, as they worked their way over the humpback of the terrain."
                                            },
                                            {
                                                "example_id": "9619c55c-c2ea-4a77-b053-9cd2ecff51b0",
                                                "sense_id": "5478758f-20c4-370f-9bb8-33f9d59279c3",
                                                "text": "I could see clear out to the humpbacks of small islands along the great lake, where small banks of fog hung."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc0be603-79e2-33af-9aa4-e25898a20b44",
                                        "entry_id": "512f6272-33de-3fce-8d51-fd6bb3e0878c",
                                        "glosses": [
                                            "A person with a humpback; a person who suffers from kyphosis."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7861832-1e10-4dda-81b7-5ee44d6c9898",
                                                "sense_id": "dc0be603-79e2-33af-9aa4-e25898a20b44",
                                                "text": "[…] Tom’s more specific and kindly impressions gradually melted into the old background of suspicion and dislike toward him as a queer fellow, a humpback, and the son of a rogue."
                                            },
                                            {
                                                "example_id": "6334ff98-fb78-4991-9af8-d327e6c2e797",
                                                "sense_id": "dc0be603-79e2-33af-9aa4-e25898a20b44",
                                                "text": "[…] I stared up at the raw spots on his cheek and thought, there is no safety anywhere: a humpback, a cripple—they all have the trigger that sets love off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97c72658-c1c1-3d1d-a429-d87bc78d6853",
                                        "entry_id": "512f6272-33de-3fce-8d51-fd6bb3e0878c",
                                        "glosses": [
                                            "A humpback whale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c0eb719-dbc5-343e-8075-02fc2b35fa52",
                                        "entry_id": "512f6272-33de-3fce-8d51-fd6bb3e0878c",
                                        "glosses": [
                                            "A humpback salmon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "humpback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "836a9db2-24f0-36a6-a69e-f40c0e26ea24",
                                        "entry_id": "8ccb06c8-836e-3481-9a50-3f6b4e01a785",
                                        "glosses": [
                                            "To hunt humpback whales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4081081e-4787-4318-b099-ab1fbbcf5216",
                                                "sense_id": "836a9db2-24f0-36a6-a69e-f40c0e26ea24",
                                                "text": "The captain of the James Rodgers […] was an old hand at humpbacking […]"
                                            },
                                            {
                                                "example_id": "073fd63e-0ff9-4ceb-96f1-ee59d2730d90",
                                                "sense_id": "836a9db2-24f0-36a6-a69e-f40c0e26ea24",
                                                "text": "[…] the Alice Knowles […] did her whaling in the south Atlantic, by turns humpbacking off the African coast and cruising around Tristan in season."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
