                                                "sense_id": "46efa2ba-fb1a-3408-b8c5-8544f6eb792b",
                                                "text": "Newton ist tot."
                                            },
                                            {
                                                "example_id": "c8eb98bc-47b4-4e19-a84f-4af5e3745c41",
                                                "sense_id": "46efa2ba-fb1a-3408-b8c5-8544f6eb792b",
                                                "text": "„Man muß dabei bakterielle Zersetzung vollkommen ausschließen, denn es gibt Bakterien, die totes tierisches Gewebe zu lösen vermögen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
