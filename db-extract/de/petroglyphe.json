                "senses": [
                    {
                        "sense_id": "ce90a917-9e3e-3cc4-b1a0-d8f3a936143b",
                        "entry_id": "9290ab2c-cd01-32c3-a9c8-0b784ef693d0",
                        "glosses": [
                            "in Stein geritzte bildliche und grafische Darstellungen aus prähistorischer Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1bd855-5dd9-4546-afb8-2aa0a74a99a0",
                                "sense_id": "ce90a917-9e3e-3cc4-b1a0-d8f3a936143b",
                                "text": "„Als Sonnensteine werden drei Steine bezeichnet, die in Beckstedt bei Colnrade, Harpstedt und Horsten in Niedersachsen gefunden wurden. […] Die Steine zeigen die Petroglyphen konzentrischer Kreise auf der Vorderseite, die um einen vertieften Mittelpunkt verlaufen.“"
                            },
                            {
                                "example_id": "cc324df5-26c6-44c4-97a4-f6ce9ec1d84a",
                                "sense_id": "ce90a917-9e3e-3cc4-b1a0-d8f3a936143b",
                                "text": "„Doch auch die uralten Petroglyphen (Felsritzungen) der Fezzan und Tassili in Libyen und Algerien und die jungsteinzeitlichen Felsmalereien in Marokko gehören zu dem reichen Schatz an Inspirationen, dessen sich zeitgenössische Maler im Maghreb bedienen und in ihrer eigenen Kunst verarbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfe54b57-7239-4e38-bbbe-9de05ce49758",
                        "source_entry_id": "9290ab2c-cd01-32c3-a9c8-0b784ef693d0",
                        "source_sense_id": "ce90a917-9e3e-3cc4-b1a0-d8f3a936143b",
                        "source_sense_description": "in Stein geritzte bildliche und grafische Darstellungen aus prähistorischer Zeit",
                        "target_lang_word": "petroglyph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petroglyph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1afe8eb7-0fa4-3713-ae14-90261040cac9",
                                        "entry_id": "8df1c4a9-4c13-3a72-b5b8-f82ce3569e35",
                                        "glosses": [
                                            "A rock carving, especially one made in prehistoric times."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9de9c86-4e3d-4be9-8ef7-25ccd2dacc7e",
                                                "sense_id": "1afe8eb7-0fa4-3713-ae14-90261040cac9",
                                                "text": "The petroglyphs of Central Asia form a long sequence from the Neolithic onwards."
                                            },
                                            {
                                                "example_id": "6788382c-cea7-426d-9b0f-94c5256439e1",
                                                "sense_id": "1afe8eb7-0fa4-3713-ae14-90261040cac9",
                                                "text": "Ninety-six petroglyph sites were reported in the original study (DiazGranados 1993). The majority of the petroglyphs are worn."
                                            },
                                            {
                                                "example_id": "13594e9e-31da-482e-89e1-2ebde20f01a6",
                                                "sense_id": "1afe8eb7-0fa4-3713-ae14-90261040cac9",
                                                "text": "The islands of Tonga are not known for petroglyphs; however, one of the frontal stones of a langi called Mala'e Lahi on 'Uiha Island has one petroglyph of a human foot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
