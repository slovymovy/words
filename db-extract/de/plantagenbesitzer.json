                ],
                "senses": [
                    {
                        "sense_id": "12c4f552-03d9-3882-bb19-ab62affb9a46",
                        "entry_id": "f6b2afaa-053e-3803-95af-c9b9bb5f1fd3",
                        "glosses": [
                            "jemand, der eine Plantage besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5195fe6-02d5-4ea6-a4c6-587e60461c92",
                                "sense_id": "12c4f552-03d9-3882-bb19-ab62affb9a46",
                                "text": "„Die Einzigen von ihnen, die jemals ihren Fuß in die Stadt setzten, waren die schwarzen Diener und Dienerinnen, welche die Plantagenbesitzer von den karibischen Inseln mitbrachten, wenn sie Frankreich einen Besuch abstatteten.“"
                            },
                            {
                                "example_id": "cb7cd2ab-613b-4f6c-83e2-15289ddbcf54",
                                "sense_id": "12c4f552-03d9-3882-bb19-ab62affb9a46",
                                "text": "„Und chinesische Plantagenbesitzer sollen ihre Citrusbäume vor dem Kahlfraß bewahrt haben, indem sie Ameisen mit Bambusstangen den Weg von Baum zu Baum erleichterten.“"
                            },
                            {
                                "example_id": "dfe3b83c-84fa-4da1-859b-87a2f65b4cba",
                                "sense_id": "12c4f552-03d9-3882-bb19-ab62affb9a46",
                                "text": "„Das Ganze gipfelte 1878 in einer spontanen Rebellion, bei der innerhalb weniger Stunden große Teile von Frederiksted geplündert und in Brand gesteckt und viele Plantagenbesitzer gelyncht wurden.“"
                            },
                            {
                                "example_id": "2bb811c6-677f-4265-b749-2a1480155efb",
                                "sense_id": "12c4f552-03d9-3882-bb19-ab62affb9a46",
                                "text": "„Die Plantagenbesitzer im Süden aber wollten sich die billigen Arbeitskräfte nicht nehmen lassen.“"
                            },
                            {
                                "example_id": "fac9b1e1-100c-4278-85e2-913adef3a246",
                                "sense_id": "12c4f552-03d9-3882-bb19-ab62affb9a46",
                                "text": "„Bond kannte Jamaika gut, und so bat er darum, von dort aus geleitet und als Plantagenbesitzer ausstaffiert zu werden, dessen Vater sein Vermögen mit Tabak und Zucker gemacht hatte und dessen Sohn sich damit beschäftigte, dieses Geld an der Börse und in Spielkasinos wieder auszugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
