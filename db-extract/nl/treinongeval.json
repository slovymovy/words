                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b104b229-cc2c-4ff9-8f9d-a3a2521c6069",
                                "sense_id": "a9afe305-9b93-32ff-b904-0f5d590de8e4",
                                "text": "' Hij vervolgde: 'Ze verliet me voor een andere man en kwam toen om het leven bij een treinongeval."
                            },
                            {
                                "example_id": "9205728a-c612-449e-94c1-1cbd07bb97f1",
                                "sense_id": "a9afe305-9b93-32ff-b904-0f5d590de8e4",
                                "text": "Het Openbaar Ministerie gaat niemand strafrechtelijk vervolgen voor het dodelijke treinongeval bij Voorschoten van vorig jaar. Bij dat ongeluk kwam een kraanmachinist om het leven. Justitie concludeert dat er sprake is geweest van een ongeluk."
                            }
                        ]
