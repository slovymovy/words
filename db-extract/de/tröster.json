                        "examples": [
                            {
                                "example_id": "8077bdda-ead1-4673-a22c-1ce23fd0ded7",
                                "sense_id": "0680a299-1607-3c9d-8a34-5a30170f5df2",
                                "text": "„In einer bestimmten Zeit galten Bartender als die Tröster, Beichtväter und Gesprächspartner der einsamen Trinker.“"
                            },
                            {
                                "example_id": "39129ea5-4ba9-4aab-86e8-42137e8ae8e2",
                                "sense_id": "0680a299-1607-3c9d-8a34-5a30170f5df2",
                                "text": "„Die Jesuiten galten als Tröster junger reicher Witwen.“"
                            }
                        ],
