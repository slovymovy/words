                ],
                "senses": [
                    {
                        "sense_id": "9c942aab-54ad-3b66-b05a-710eb349cafc",
                        "entry_id": "f8e5b44b-1903-389a-8fd8-4759dc5c18c1",
                        "glosses": [
                            "iemand die langzaam, sloffend loopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12628cbb-d365-4062-818c-098553c81678",
                                "sense_id": "9c942aab-54ad-3b66-b05a-710eb349cafc",
                                "text": "\"StadswachtenOm het huidige tekort aan politie op te vangen richten burgemeesters steeds vaker een soort 'gemeentepolitie'op door stadswachten en andere opsporingsambtenaren aan te nemen. Driekwart vindt dat een zorgelijke ontwikkeling. \"Gesubsidieerde slenteraars\"en \"machtswellustelingen\"worden deze zogeheten boa's genoemd."
                            },
                            {
                                "example_id": "06e46ec5-02ab-4ffc-9a60-ee216dc90e37",
                                "sense_id": "9c942aab-54ad-3b66-b05a-710eb349cafc",
                                "text": "Deze vreemdeling, die de naam Josef Schwarz draagt, zegt hem twee paspoorten met visa voor de VS en twee tickets toe als de wanhopige slenteraar bereid is om gedurende de nacht naar zijn levensverhaal te luisteren."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa402368-0544-368b-bbe7-64ade99c70e4",
                        "entry_id": "f8e5b44b-1903-389a-8fd8-4759dc5c18c1",
                        "glosses": [
                            "iemand die heel langzaam is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "41855d29-0ce0-4cd0-9b31-123f4e1bef09",
                                "sense_id": "aa402368-0544-368b-bbe7-64ade99c70e4",
                                "text": "De zieltogende woonboulevards hopen op een druilerig Pasen. Want dan komen de klanten: de slenteraars, de twijfelaars en de kopers met een missie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "288d7797-4fd3-4926-823b-ecfacef4dac6",
                        "source_entry_id": "f8e5b44b-1903-389a-8fd8-4759dc5c18c1",
                        "source_sense_id": "9c942aab-54ad-3b66-b05a-710eb349cafc",
                        "target_lang_word": "lounger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lounger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c97bd29b-d007-34d6-8a93-e214ea0f987e",
                                        "entry_id": "145809cc-8cc1-330b-99cc-ff580ca69ea0",
                                        "glosses": [
                                            "One who lounges; an idler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d813e81f-36e7-4f8f-a9cb-84fbe37caa57",
                                                "sense_id": "c97bd29b-d007-34d6-8a93-e214ea0f987e",
                                                "text": "Three or four men noticed my condition; and, evidently setting it down to the results of over many pegs, charitably endeavoured to draw me apart from the rest of the loungers."
                                            },
                                            {
                                                "example_id": "05086733-46ba-46ca-8891-a72396afd416",
                                                "sense_id": "c97bd29b-d007-34d6-8a93-e214ea0f987e",
                                                "text": "These colors, falling upon the throng of monomachists and loungers much as we see the aureate beams of divine favor fall on hierarchs in art, lent them an appearance insubstantial and thaumaturgic, as though they had all been produced a moment before by the flourish of a cloth and would vanish into the air again at a whistle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "515f914a-0374-34a1-9796-1dc5a277c753",
                                        "entry_id": "145809cc-8cc1-330b-99cc-ff580ca69ea0",
                                        "glosses": [
                                            "A chair made for lounging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "415d73d5-d2e7-459a-9a38-69c2efe64746",
                                                "sense_id": "515f914a-0374-34a1-9796-1dc5a277c753",
                                                "text": "You shoulda heard me in the lounger / Telling people what they was"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
