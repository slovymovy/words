                        "sense_id": "161d8adf-6a5d-3d2c-bed7-66360828ff4f",
                        "entry_id": "d83ef904-60df-3026-bddd-b988d9d7ee34",
                        "glosses": [
                            "irracjonalny lęk przed słońcem lub światłem słonecznym"
