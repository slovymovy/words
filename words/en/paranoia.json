{
    "word_family": [
        "paranoid",
        "paranoiac"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fac27e70-0ed1-3326-85f0-92c0c990733d",
                    "sense_definition": "Extreme, irrational distrust of others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>paranoia</w> made him believe that his coworkers were constantly plotting against him.",
                            "target_lang_translations": {
                                "zh": "他的<w>偏执</w>让他认为同事们一直在密谋对付他。"
                            }
                        },
                        {
                            "text": "The sudden <w>paranoia</w> she felt in the empty building was completely unfounded.",
                            "target_lang_translations": {
                                "zh": "她在空荡荡的大楼里感到的那种突如其来的<w>多疑</w>完全是毫无根据的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suspicion",
                        "mistrust"
                    ],
                    "antonyms": [
                        "pronoia"
                    ],
                    "common_phrases": [
                        "suffer from paranoia"
                    ],
                    "target_lang_definitions": {
                        "zh": "对他人的极端、非理性的不信任感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "偏执",
                                "target_lang_sense_clarification": "指心理上的多疑或固执。"
                            },
                            {
                                "target_lang_word": "多疑",
                                "target_lang_sense_clarification": "指对人或事过分怀疑。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe97772b-2e1b-337a-ba8c-f53e74c7c069",
                    "sense_definition": "An obsolete medical term for a psychotic disorder now known as delusional disorder.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "distrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older psychiatric texts, the condition was often classified simply as <w>paranoia</w>.",
                            "target_lang_translations": {
                                "zh": "在较早的精神病学文献中，这种状况通常被简单地归类为<w>偏执狂</w>。"
                            }
                        },
                        {
                            "text": "Modern medicine has replaced the broad label of <w>paranoia</w> with more specific diagnostic criteria.",
                            "target_lang_translations": {
                                "zh": "现代医学已经用更具体的诊断标准取代了<w>偏执狂</w>这一笼统的标签。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Used in historical medical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种过时的医学术语，现指妄想障碍。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "偏执狂",
                                "target_lang_sense_clarification": "旧时医学对妄想性精神障碍的称呼。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}