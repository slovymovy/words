                        "glosses": [
                            "A cycle of texts to be read or chanted at liturgical services on particular weeks and movable feasts throughout the year; a book that contains this cycle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c28061-d341-4cf4-a929-b5f4968953a2",
                                "sense_id": "6100d700-f06d-3d5f-87b8-3da369fb82ce",
                                "text": "The third and final volume of the temporale employs a different stave height and was clearly written later."
                            },
                            {
                                "example_id": "8bd8e6e3-249b-4a41-b81d-f719d768ff82",
                                "sense_id": "6100d700-f06d-3d5f-87b8-3da369fb82ce",
                                "text": "In the Roman rite, this period of the year is known as ‘ordinary time’ and, like the Old Hispanic rite, mostly uses quotidian materials for the temporale."
                            }
                        ]
                    }
