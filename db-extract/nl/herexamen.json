                        "glosses": [
                            "herhaling van een examen als het eerste onvoldoende is geweest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cba27d0-d947-45bd-928c-99ca4b52edd6",
                                "sense_id": "07e6ef1c-29b2-3166-b250-5304dad6046a",
                                "text": "De vrees bestond dat er na een laag schooladvies voor sommige kinderen een race richting de eindtoets zou komen. In de periode tussen advies en toets zouden ouders alles op alles zetten om hun kroost klaar te stomen voor een ‘herexamen’, zodat met de Citoscore in de hand een hoger advies kon worden afgedwongen."
                            },
                            {
                                "example_id": "c1e0f332-e49f-4661-8522-3661755971de",
                                "sense_id": "07e6ef1c-29b2-3166-b250-5304dad6046a",
                                "text": "Het vak wiskunde is vorige week woensdag officieel afgesloten (de optie herexamen laten we nog even buiten beeld). Met die afsluiting begint dus ‘de rest’ van ons leven waarin we onze wiskundige vaardigheden kunnen gebruiken."
                            }
                        ]
                    }
