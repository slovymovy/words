        "fr-extract.jsonl": [
            {
                "entry_id": "15614983-88b9-3422-965c-21f0f732f986",
                "word": "bricolage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "187184b6-3078-46fd-ba40-e8eee77b4764",
                        "entry_id": "15614983-88b9-3422-965c-21f0f732f986",
                        "tags": [
