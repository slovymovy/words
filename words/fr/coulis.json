        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df25ffec-7907-363c-97b9-55789455030f",
                    "sense_definition": "Purée liquide ou sauce obtenue à partir d'un aliment cuit ou écrasé et passé au tamis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a versé un délicieux <w>coulis</w> de framboise sur son gâteau au chocolat."
                        },
                        {
                            "text": "Le chef prépare un <w>coulis</w> de tomate bien assaisonné pour accompagner les pâtes fraîches."
                        }
                    ],
                    "synonyms": [
                        "purée",
                        "sauce"
                    ],
                    "common_phrases": [
                        "coulis de fruits rouges",
                        "coulis de tomate",
                        "coulis de framboise"
                    ]
                },
                {
                    "sense_id": "47e37adf-3186-3737-b5fe-0596e589f1c1",
                    "sense_definition": "Matière liquide ou semi-liquide, comme du ciment ou du plâtre, injectée dans des interstices pour les combler.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maçon injecte un <w>coulis</w> de ciment afin de stabiliser les fondations de la bâtisse."
                        },
                        {
                            "text": "Ce <w>coulis</w> fluide permet de sceller parfaitement les joints entre les dalles."
                        }
                    ],
                    "synonyms": [
                        "mortier"
                    ],
                    "common_phrases": [
                        "coulis de ciment",
                        "coulis d'injection"
                    ]
                },
                {
                    "sense_id": "9b970625-da82-3524-83a5-d6381a51480b",
                    "sense_definition": "Mouvement d'air discret ou courant d'air qui s'infiltre par une fente étroite.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "air",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La flamme de la bougie tremblait au moindre <w>coulis</w> d'air venant de la fenêtre."
                        },
                        {
                            "text": "Un <w>coulis</w> glacial s'infiltrait sous la porte mal calfeutrée tout au long de la nuit."
                        }
                    ],
                    "synonyms": [
                        "courant d'air"
                    ],
                    "common_phrases": [
                        "coulis d'air"
                    ]
                },
                {
                    "sense_id": "e6b407c9-512f-30ff-9b80-a6ca689b7c5f",
                    "sense_definition": "Variante orthographique de <w>coolie</w>, désignant un porteur ou travailleur manuel en Asie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les voyageurs avaient engagé plusieurs <w>coulis</w> pour transporter le matériel à travers la montagne."
                        },
                        {
                            "text": "Dans ce récit d'époque, chaque <w>coulis</w> portait de lourdes charges sous une chaleur écrasante."
                        }
                    ],
                    "synonyms": [
                        "coolie"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "variante orthographique vieillie"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "78784807-41ad-3aed-ac32-e18c694524ce",
                    "sense_definition": "Qui s'infiltre par d'étroites ouvertures, principalement employé dans l'expression désignant un courant d'air froid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "air",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un vent <w>coulis</w> passait sous la porte de la chambre et glaçait la pièce."
                        },
                        {
                            "text": "Assise près de la baie vitrée, elle frissonnait à cause des vents <w>coulis</w> persistants."
                        }
                    ],
                    "common_phrases": [
                        "vent coulis"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usité presque uniquement dans l'expression vent coulis"
                        }
                    ]
                }
            ]
        }
    ]
