{
    "word_family": [
        "rehearsal",
        "rehearse"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a5d71ce4-552d-3b83-ae24-490119bc7322",
                    "sense_definition": "Contrived or dishonestly formulated so as to appear authentic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contrived",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not trust his <w>rehearsed</w> apology for the mistake.",
                            "target_lang_translations": {
                                "ru": "Я не верю его <w>заученным</w> извинениям за эту ошибку."
                            }
                        },
                        {
                            "text": "The politician gave a <w>rehearsed</w> speech that lacked any real emotion.",
                            "target_lang_translations": {
                                "ru": "Политик произнес <w>наигранную</w> речь, в которой не было настоящих эмоций."
                            }
                        }
                    ],
                    "synonyms": [
                        "contrived",
                        "artificial",
                        "staged"
                    ],
                    "antonyms": [
                        "spontaneous",
                        "genuine"
                    ],
                    "common_phrases": [
                        "rehearsed speech",
                        "rehearsed apology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственно созданный или неискренний, подготовленный заранее для того, чтобы казаться естественным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наигранный",
                                "target_lang_sense_clarification": "о поведении или эмоциях, которые выглядят фальшиво"
                            },
                            {
                                "target_lang_word": "заученный",
                                "target_lang_sense_clarification": "о речи или действиях, которые кажутся механическими"
                            },
                            {
                                "target_lang_word": "подготовленный",
                                "target_lang_sense_clarification": "в значении заранее спланированный, лишенный спонтанности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f6f49d0-ab69-3e73-9e39-a99412aff8a6",
                    "sense_definition": "Simple past and past participle of <w>rehearse</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actors <w>rehearsed</w> their lines all afternoon before the show.",
                            "target_lang_translations": {
                                "ru": "Актеры <w>репетировали</w> свои реплики весь день перед спектаклем."
                            }
                        },
                        {
                            "text": "She had <w>rehearsed</w> the presentation many times to ensure it went perfectly.",
                            "target_lang_translations": {
                                "ru": "Она много раз <w>отрабатывала</w> презентацию, чтобы убедиться, что все пройдет идеально."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rehearsed lines",
                        "rehearsed performance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «репетировать» или «отрабатывать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репетировал",
                                "target_lang_sense_clarification": "о подготовке к выступлению или спектаклю"
                            },
                            {
                                "target_lang_word": "отрабатывал",
                                "target_lang_sense_clarification": "о многократном повторении действий для достижения точности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}