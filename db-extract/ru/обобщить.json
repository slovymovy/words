                    }
                ],
                "senses": [
                    {
                        "sense_id": "68eb5793-8fb1-35c7-a3b2-4201c9e945ca",
                        "entry_id": "0340a5e8-f4e7-30de-a3eb-76db530e6709",
                        "glosses": [
                            "соединить вместе, объединить в нечто общее, целое, делая выводы из отдельных наблюдений, фактов, явлений; лишить индивидуальных черт, типизировать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f5f5ebb-66d8-434b-b40c-d128f350d9e1",
                                "sense_id": "68eb5793-8fb1-35c7-a3b2-4201c9e945ca",
                                "text": "Обобщить свои многолетние наблюдения над метеорологическими явлениями."
                            },
                            {
                                "example_id": "1e08a179-f08b-485d-88a4-578de530211c",
                                "sense_id": "68eb5793-8fb1-35c7-a3b2-4201c9e945ca",
                                "text": "Художник обобщил своеобразие натуры."
                            }
                        ]
                    },
                    {
                        "sense_id": "c139e268-0eb4-3d3d-9d9b-e18e644612d1",
                        "entry_id": "0340a5e8-f4e7-30de-a3eb-76db530e6709",
                        "glosses": [
                            "придать общее значение чему-либо частному, единичному, распространить суждение о единичном на множество объектов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e99fb89c-61b1-46ca-9221-1967b0a65a7d",
                                "sense_id": "c139e268-0eb4-3d3d-9d9b-e18e644612d1",
                                "text": "Обобщить частный случай."
                            },
                            {
                                "example_id": "52ce42b4-60ae-4927-ab95-4323f6ae2d12",
                                "sense_id": "c139e268-0eb4-3d3d-9d9b-e18e644612d1",
                                "text": "Обобщить единичное явление."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f52341c-3a15-3a88-b57e-8c4846b2dd62",
                        "entry_id": "0340a5e8-f4e7-30de-a3eb-76db530e6709",
                        "glosses": [
                            "объединить, соединить вместе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e761634b-8c0b-42dd-b939-652b0c29cbad",
                                "sense_id": "2f52341c-3a15-3a88-b57e-8c4846b2dd62",
                                "text": "— Надо сказать, что Сисмонди вполне перенял от Ад. Смита теорию трудовой стоимости и трёх видов дохода: ренты, прибыли и заработной платы. Он делает даже кое-где попытку обобщить два первые вида дохода в противоположность третьему…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "deceabc6-0c5a-4dac-b715-9c4ed6c52648",
                        "source_entry_id": "0340a5e8-f4e7-30de-a3eb-76db530e6709",
                        "source_sense_description": "соединить в целое",
                        "target_lang_word": "generalize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generalize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3de9b8a2-17c2-3ddb-8eac-ef319023b876",
                                        "entry_id": "7bfe2a1d-e523-3b43-89cb-2a9fd397e87e",
                                        "glosses": [
                                            "To speak in generalities, or in vague terms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "741f2067-8900-36e0-b264-dbf73323f76d",
                                        "entry_id": "7bfe2a1d-e523-3b43-89cb-2a9fd397e87e",
                                        "glosses": [
                                            "To infer or induce from specific cases to more general cases or principles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb7107d-9054-4034-b589-3655590140b4",
                                                "sense_id": "741f2067-8900-36e0-b264-dbf73323f76d",
                                                "text": "Copernicus generalized the celestial motions by merely referring them to the moon's motion. Newton generalized them still more by referring this last to the motion of a stone through the air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab1c7e02-5d8f-3168-8c41-5e42d0bd3af6",
                                        "entry_id": "7bfe2a1d-e523-3b43-89cb-2a9fd397e87e",
                                        "glosses": [
                                            "To spread throughout the body and become systemic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e46121c8-5aa9-3954-a577-71f65d378f87",
                                        "entry_id": "7bfe2a1d-e523-3b43-89cb-2a9fd397e87e",
                                        "glosses": [
                                            "To derive or deduce (a general concept or principle) from particular facts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f21bdb0a-410f-435e-a8bd-562036647ddf",
                                                "sense_id": "e46121c8-5aa9-3954-a577-71f65d378f87",
                                                "text": "A mere conclusion generalized from a great multitude of facts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5305aa6-8dd5-48c6-afa8-1f29182ef9ae",
                        "source_entry_id": "0340a5e8-f4e7-30de-a3eb-76db530e6709",
