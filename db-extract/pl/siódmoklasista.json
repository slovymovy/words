                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e66d7fc3-5fa0-4a20-9af3-96ab696eeab8",
                                "sense_id": "30420632-c50a-378d-b1d6-32c3e68d4a87",
                                "text": "Pamiętam, jak w pierwszej klasie wszystkie podkochiwałyśmy się w siódmoklasistach."
                            },
                            {
                                "example_id": "cd87cf62-feef-4540-bb0d-af8dba1b23ea",
                                "sense_id": "30420632-c50a-378d-b1d6-32c3e68d4a87",
                                "text": "Bohater książki Kornela Makuszyńskiego pt. „Szatan z siódmej klasy” jest siódmoklasistą, ale ma siedemnaście lat, gdyż jest uczniem przedwojennego gimnazjum."
                            }
                        ],
