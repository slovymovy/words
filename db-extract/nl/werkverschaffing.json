                        "examples": [
                            {
                                "example_id": "77215dc9-3f85-4fed-a878-5af048adc983",
                                "sense_id": "a6285271-c345-3f84-8439-74795ac2072e",
                                "text": "Dit boek doet een vurig pleidooi voor opleidingen en werkverschaffing in deze kampen en neemt afstand van het huidige mensonterende vluchtelingenbeleid."
                            },
                            {
                                "example_id": "15be0481-acf6-4f1f-b874-154ec6daf51f",
                                "sense_id": "a6285271-c345-3f84-8439-74795ac2072e",
                                "text": "Het is een cultuur binnen de politie om zo snel mogelijk uit het reguliere politiewerk zien weg te komen om je vervolgens aan te sluiten bij het overgrote deel dat zich hoofdzakelijk bezighoudt met verkapte werkloosheid of administratieve werkverschaffing en niet te vergeten mooie baantjes welke de politie in de loop der jaren zelf heeft gecreëerd."
                            }
