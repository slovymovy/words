                    {
                        "sense_id": "5c6edcb9-0664-351f-8ff3-f1a2b747a30a",
                        "entry_id": "af9a7717-8b13-310f-96e2-8cdc8614c1af",
                        "glosses": [
                            "The oceanic current forming the swift, warm, northward-flowing western quarter of the North Pacific Gyre."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "6ab43964-86be-41ce-8982-b2a208d70eac",
                                "sense_id": "5c6edcb9-0664-351f-8ff3-f1a2b747a30a",
                                "text": "Between Fatsisio and Mikura a current to the eastward is marked, called the Kuro Siwo Stream."
                            },
                            {
                                "example_id": "74655fcd-b571-4e2d-acfd-a86c24aa393b",
                                "sense_id": "5c6edcb9-0664-351f-8ff3-f1a2b747a30a",
                                "text": "Still less must we forget the mighty river in the sea—the Kuroshio, or “Black Current”—which, flowing northwards from the direction of Formosa and the Philippine Islands, warms the southern and south-eastern coasts of Japan much as the Gulf Stream warms the coasts of western Europe."
                            }
                        ]
                    }
