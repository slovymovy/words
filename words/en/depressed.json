                {
                    "sense_id": "490a9c6e-83d2-338f-aaf2-eebc76097d21",
                    "sense_definition": "Suffering from the damaging effects of an economic recession or poverty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government promised new funding for the <w>depressed</w> areas of the city.",
                            "target_lang_translations": {
                                "ru": "Правительство пообещало новое финансирование для <w>депрессивных</w> районов города.",
                                "zh": "政府承诺为该市经济<w>萧条</w>的地区提供新的资金。",
                                "es": "El gobierno prometió nuevos fondos para las zonas <w>deprimidas</w> de la ciudad.",
                                "tr": "Hükümet, şehrin <w>durgun</w> bölgeleri için yeni fon sözü verdi.",
                                "de": "Die Regierung versprach neue Gelder für die <w>wirtschaftsschwachen</w> Gebiete der Stadt."
                            }
                        },
                        {
                            "text": "Many small businesses struggled to survive in the <w>depressed</w> economy.",
                            "target_lang_translations": {
                                "ru": "Многие малые предприятия боролись за выживание в условиях <w>находящейся в упадке</w> экономики.",
                                "zh": "许多小企业在经济<w>低迷</w>的环境下艰难求生。",
                                "es": "Muchos pequeños negocios lucharon por sobrevivir en una economía <w>deprimida</w>.",
                                "tr": "Birçok küçük işletme, <w>durgun</w> ekonomide hayatta kalmak için mücadele etti.",
                                "de": "Viele kleine Unternehmen kämpften in der <w>depressiven</w> Wirtschaft ums Überleben."
                            }
                        }
                    ],
                    "common_phrases": [
                        "depressed area",
                        "depressed economy",
                        "depressed market"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переживающий экономический спад, бедность или кризис.",
                        "zh": "指经济状况不佳、贫困或处于衰退之中。",
                        "es": "Que sufre los efectos negativos de una recesión económica, pobreza o falta de desarrollo.",
                        "tr": "Ekonomik durgunluk, yoksulluk veya krizden etkilenen.",
                        "de": "Unter wirtschaftlichem Abschwung, Armut oder einer Krise leidend."
                    },
