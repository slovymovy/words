                        "examples": [
                            {
                                "example_id": "23a00d2a-6e8d-4b1c-a659-4e8c67ecc4d5",
                                "sense_id": "cbc4da83-6ae5-39e0-a684-c16d24223155",
                                "text": "Volgens Papadementriou is het ook belangrijk dat er een goed selectiesysteem komt. \"De vluchtelingen moeten goed bij de lokale bevolking passen.” Hij noemt het dan ook een langetermijnplan. “Je moet gaan selecteren wie waar geplaatst wordt. Waar gaan de Syriërs naartoe en waar zetten we de Afghanen neer? Dat selecteren duurt lang. De meeste vluchtelingen zullen eerst jaren dus in een vluchtelingenkamp zitten.\""
                            },
                            {
                                "example_id": "fe8a4be9-725c-4ce5-9122-09698d351387",
                                "sense_id": "cbc4da83-6ae5-39e0-a684-c16d24223155",
                                "text": "Ondanks de felle retoriek presenteerde geen van beide partijen een gedetailleerd langetermijnplan. Zowel de Conservatieven als Labour hebben beloofd flink te bezuinigen en het begrotingstekort terug te dringen. Maar geen van beide partijen durfde zo vlak voor de verkiezingen aan te geven waar de ergste pijn gaat vallen."
                            }
                        ]
                    }
