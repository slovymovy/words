        "fr-extract.jsonl": [
            {
                "entry_id": "a3788cb5-b01e-3e95-8b4f-624054408338",
                "word": "Célèbes",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0e95a19b-205c-3552-ad01-1fa940d80588",
                        "entry_id": "a3788cb5-b01e-3e95-8b4f-624054408338",
                        "glosses": [
                            "Quatrième île d’Indonésie par sa superficie, elle est en forme de K."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "171919c0-9c4e-4ec6-b62f-a279f7f71f8b",
                                "sense_id": "0e95a19b-205c-3552-ad01-1fa940d80588",
                                "text": "Pour achever de me déterminer, M. Merkus ajouta qu’on lui gardait à Manado deux beaux babiroussas adultes, et qu’il les remettrait à ma disposition si je voulais l’accompagner à Célèbes, et qu’en outre il mettrait sur pied toute la population du pays pour procurer aux naturalistes tous les objets d’histoire naturelle qu’ils jugeraient dignes de leur attention."
                            },
                            {
                                "example_id": "e2a7b566-e9d6-49fb-b936-e1aef0276930",
                                "sense_id": "0e95a19b-205c-3552-ad01-1fa940d80588",
                                "text": "Et pense que j’ai rencontré au large des Célèbes il y a dix ans, des caravelles arabes à la dérive, […]."
                            },
                            {
                                "example_id": "fedf11d6-8c4c-483f-8ed3-3767543ec7d1",
                                "sense_id": "0e95a19b-205c-3552-ad01-1fa940d80588",
                                "text": "Les Légumineuses sont assez abondantes : l’espèce la plus importante au point de vue commercial, Intsia bijuga, se rencontre notamment à Sumatra et aux Célèbes."
                            },
                            {
                                "example_id": "0eda4e20-7d8c-42d9-8f61-b58494b40b4b",
                                "sense_id": "0e95a19b-205c-3552-ad01-1fa940d80588",
                                "text": "Si nous examinons tous les autres peuples qui sont sous la zone torride au-delà de l’Afrique, nous nous confirmerons encore plus dans cette opinion : les habitants des Maldives, de Ceylan, de la pointe de la presqu’île de l’Inde, de Sumatra, de Malacca, de Bornéo, de Célèbes, des Philippines, etc., sont tous extrêmement bruns, sans être absolument noirs, parce que toutes ces terres sont des îles ou des presqu’îles […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c304a75-1cc8-40e7-adf9-9108771fb622",
                        "source_entry_id": "a3788cb5-b01e-3e95-8b4f-624054408338",
                        "source_sense_id": "0e95a19b-205c-3552-ad01-1fa940d80588",
                        "target_lang_word": "Sulawesi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sulawesi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd6aeee4-9e8c-3d43-982a-dfa11910672e",
                                        "entry_id": "b3ea13f2-9a9a-301e-9564-98814ea47ce2",
                                        "glosses": [
                                            "drittgrößte der Großen Sundainseln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b37b75a-7598-405b-972c-c8182ab93d70",
                                                "sense_id": "bd6aeee4-9e8c-3d43-982a-dfa11910672e",
                                                "text": "In Sulawesi wird, wie auch im Rest Indonesiens Bahasa Indonesia gesprochen."
                                            },
                                            {
                                                "example_id": "1d6d256c-ad8f-4aa0-8228-26f54bdc3b35",
                                                "sense_id": "bd6aeee4-9e8c-3d43-982a-dfa11910672e",
                                                "text": "Sulawesi wird im nördlichen Teil vom Äquator durchschnitten, was für das zentrale Bergland starke Niederschläge das ganze Jahr über bedeutet."
                                            },
                                            {
                                                "example_id": "075d2636-d909-446b-9bd1-57f2d4cab33d",
                                                "sense_id": "bd6aeee4-9e8c-3d43-982a-dfa11910672e",
                                                "text": "Auf Sulawesi lebten im Jahre 2005 zirka 16 Millionen Einwohner."
                                            },
                                            {
                                                "example_id": "1b6d25c9-75bc-4c56-bbc4-33ba26ddb20d",
                                                "sense_id": "bd6aeee4-9e8c-3d43-982a-dfa11910672e",
                                                "text": "In einer Höhle auf der indonesischen Insel Sulawesi finden Forscher die wohl älteste figurative Kunst der Welt."
                                            },
                                            {
                                                "example_id": "7085452a-05b9-41c3-9618-7538089b3bfc",
                                                "sense_id": "bd6aeee4-9e8c-3d43-982a-dfa11910672e",
                                                "text": "Nach Erdbeben und Tsunami sind Teile der indonesischen Insel Sulawesi vom Phänomen der Bodenverflüssigung betroffen gewesen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
