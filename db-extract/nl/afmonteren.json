                                        ]
                                    },
                                    {
                                        "sense_id": "14073ccf-eb29-3910-997a-f2b061bae9ec",
                                        "entry_id": "a5ebb127-df7d-3b20-a7de-3d3b35c20c81",
                                        "glosses": [
                                            "To reach orgasm."
