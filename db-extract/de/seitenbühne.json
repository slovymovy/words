                                "example_id": "e293636e-3175-4d46-8986-02283a8f5c21",
                                "sense_id": "90fe1037-273a-3a06-b815-5843af1bbe35",
                                "text": "Der Raumbereich einer Guckkastenbühne teilt sich in Vorbühne, Szenenfläche (Hauptspielfläche), Seitenbühnen und Hinterbühne auf."
                            },
                            {
                                "example_id": "9943399f-c8bd-48f7-b0e2-02cf91ba78eb",
                                "sense_id": "90fe1037-273a-3a06-b815-5843af1bbe35",
                                "text": "Während die Besucher eines Theaters gespannt das Geschehen auf der Hauptbühne verfolgen, herrscht auch auf den sogenannten Seitenbühnen reges Treiben."
                            }
