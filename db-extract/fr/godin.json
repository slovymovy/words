                            {
                                "example_id": "c8555578-1a80-4de0-9216-36ceae87c875",
                                "sense_id": "681b6c0a-82b6-3347-b954-f9394878e9d8",
                                "text": "Ce ne fut que le troisième jour qu’elle arriva avec des bûches. Le petit godin fuma, se mit à sentir fort le vernis et se calma."
                            }
                        ]
                    },
                    {
                        "sense_id": "675bab0d-eb8a-37e0-ac46-00c49d1b1d03",
                        "entry_id": "5abed8b0-25e1-3b96-b822-b46f207109cd",
                        "glosses": [
                            "Asticot, ver de terre."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "edf90c7f-4fca-420b-b658-f7db74fdb9fe",
                                "sense_id": "675bab0d-eb8a-37e0-ac46-00c49d1b1d03",
                                "text": "On va être comme deux godins dans le kiral. — Deux quoi ? — Deux asticots dans une grosse meule."
                            }
                        ]
                    }
