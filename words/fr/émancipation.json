            "pos": "noun",
            "senses": [
                {
                    "sense_id": "738d0474-ccca-342e-b48d-a0dd8ac6a48d",
                    "sense_definition": "Libération à l'égard d'une domination, de contraintes sociales ou de préjugés, permettant d'accéder à l'autonomie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liberation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>émancipation</w> des femmes a constitué une avancée majeure au cours du vingtième siècle."
                        },
                        {
                            "text": "Cette association soutient activement l'<w>émancipation</w> intellectuelle et citoyenne des jeunes de banlieue."
                        }
                    ],
                    "synonyms": [
                        "libération",
                        "affranchissement"
                    ],
                    "antonyms": [
                        "aliénation",
                        "assujettissement",
                        "soumission"
                    ],
                    "common_phrases": [
                        "émancipation des femmes",
                        "émancipation sociale",
                        "lutte pour l'émancipation"
                    ]
                },
                {
                    "sense_id": "1db5eb06-6ff7-3d61-8f79-ba5dc7f60f1f",
                    "sense_definition": "Acte juridique par lequel un mineur est soustrait à l'autorité parentale ou à la tutelle avant l'âge de la majorité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À seize ans, l'adolescent a obtenu son <w>émancipation</w> à la demande de ses parents."
                        },
                        {
                            "text": "Dès que son <w>émancipation</w> a été prononcée, il a pu gérer ses biens de façon autonome."
                        }
                    ],
                    "synonyms": [
                        "affranchissement"
                    ],
                    "antonyms": [
                        "tutelle"
                    ],
                    "common_phrases": [
                        "demande d'émancipation",
                        "acte d'émancipation",
                        "obtenir son émancipation"
                    ]
                },
                {
                    "sense_id": "04383ed7-338b-32fe-9c15-134e3e0becc0",
                    "sense_definition": "Affranchissement légal d'un esclave ou libération d'un état de servitude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "liberation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>émancipation</w> des esclaves dans les colonies françaises fut définitivement proclamée en 1848."
                        },
                        {
                            "text": "Plusieurs textes commémorent l'<w>émancipation</w> des personnes réduites en esclavage."
