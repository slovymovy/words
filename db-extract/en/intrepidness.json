                "translations": [
                    {
                        "translation_id": "56ec2407-7efa-4588-a405-68a5be2a3170",
                        "source_entry_id": "10e074dd-a6f5-31fa-8b92-d662341c32a5",
                        "source_sense_id": "4375307a-015c-3fb8-956b-44e15e376e8b",
                        "source_sense_description": "fearlessness",
                        "target_lang_word": "onverschrokkenheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onverschrokkenheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4a0bf676-8ef0-3133-b5e5-291d2d31ca5e",
                                        "entry_id": "4c2cb504-049b-3c5d-9b2b-478d6a4920cd",
                                        "glosses": [
                                            "de mate waarin iemand niet terugdeinst voor iets moeilijks of gevaarlijks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d85c4bb-c87f-48d6-a1c9-d23e59237b1f",
                                                "sense_id": "4a0bf676-8ef0-3133-b5e5-291d2d31ca5e",
                                                "text": "Deze tekenen waren: de missie van Lauriston, de overvloed aan proviand in Taroetino, de berichten die van alle kanten binnenkwamen over de laksheid en de wanordelijkheid van het Franse leger, het op sterkte brengen van onze troepen met rekruten, het goede weer en de langdurige rust voor de Russische soldaten, het ongeduld van de troepen dat bij rust gewoonlijk de kop opsteekt om af te maken waarvoor iedereen bijeen is gekomen, de nieuwsgierigheid naar wat er aan de hand was met het Franse leger dat al zolang uit het zicht verdwenen was, de onverschrokkenheid waarmee de Russische voorposten op zoek gingen naar de bij Taroetino gelegerde Fransen, de berichten over de eenvoudige overwinningen van boeren en partizanen op de Fransen, de ijverzucht die hierdoor werd opgewekt, de wraakgevoelens die in de ziel van een ieder aanwezig waren zolang de Fransen in Moskou waren en vooral ook het vage, maar in het bewustzijn van iedere soldaat aanwezige besef dat de krachtsverhoudingen nu veranderd waren en dat het overwicht nu aan onze zijde lag."
                                            },
                                            {
                                                "example_id": "8bed8943-2bbf-4da2-a008-8ba7dddc3b74",
                                                "sense_id": "4a0bf676-8ef0-3133-b5e5-291d2d31ca5e",
                                                "text": "Ang Rita Sherpa, de eerste bergbeklimmer die tien keer de Mount Everest op ging, is op 72-jarige leeftijd overleden. Hij was een van de eerste sherpa's die internationaal bekendheid verwierven vanwege hun buitengewone klimprestaties. Zijn onverschrokkenheid leverde hem in Nepal de bijnaam sneeuwluipaard op, waar hij werd gezien als nationale trots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24614464-438d-35e0-88ed-6179fc404d41",
                                        "entry_id": "4c2cb504-049b-3c5d-9b2b-478d6a4920cd",
                                        "glosses": [
                                            "iets moedigs, iets dappers"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6086ff3-b532-4e36-a65a-ffea7b4f907d",
                        "source_entry_id": "10e074dd-a6f5-31fa-8b92-d662341c32a5",
                        "source_sense_id": "4375307a-015c-3fb8-956b-44e15e376e8b",
                        "source_sense_description": "fearlessness",
                        "target_lang_word": "Unerschrockenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unerschrockenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "812be372-72a3-3797-970b-85e0f34b90ad",
                                        "entry_id": "a3f22181-5ff9-3b29-ad1c-ac1aa409a306",
                                        "glosses": [
                                            "Eigenschaft, unerschrocken zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a6f0e9-1445-4ca6-94bc-2d68cf6d7dd2",
                                                "sense_id": "812be372-72a3-3797-970b-85e0f34b90ad",
                                                "text": "„Sir Redvers scheine körperlich und seelisch erschöpft zu sein, er sei offensichtlich nicht mehr der Alte, oder vielmehr, nicht mehr der junge Buller, der dynamische Offizier, der sich mit seiner Unerschrockenheit ein Viktoriakreuz verdient hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eadaa29f-76e3-471c-a032-61c237dd465b",
                        "source_entry_id": "10e074dd-a6f5-31fa-8b92-d662341c32a5",
                        "source_sense_id": "4375307a-015c-3fb8-956b-44e15e376e8b",
                        "source_sense_description": "fearlessness",
                        "target_lang_word": "Verwegenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwegenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b9fe1e1-2c3e-307b-9556-9955a26445ce",
                                        "entry_id": "c4580ae5-5663-3ced-9d81-752dee6e70ab",
                                        "glosses": [
                                            "sehr mutige, Risiken eingehende, viel wagende Einstellung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c0e36ef-e5ca-4617-9490-aa4db2031a05",
                                                "sense_id": "5b9fe1e1-2c3e-307b-9556-9955a26445ce",
                                                "text": "„Bekanntheit erlangte Pappenheim sowohl durch seinen Ruf persönlicher Verwegenheit und großer Loyalität als auch seine militärische Unberechenbarkeit.“"
                                            },
                                            {
                                                "example_id": "58b61011-4edc-4b96-a598-6af3e901ab27",
                                                "sense_id": "5b9fe1e1-2c3e-307b-9556-9955a26445ce",
                                                "text": "„Seine Verwegenheit entprang also eher der Verzweiflung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a29c672-7e1d-38d9-89be-151cf44723d1",
                                        "entry_id": "c4580ae5-5663-3ced-9d81-752dee6e70ab",
                                        "glosses": [
                                            "sehr mutige, Risiken eingehende, gewagte Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10ca03aa-6f45-4ddf-89f1-16b79745fb82",
                                                "sense_id": "4a29c672-7e1d-38d9-89be-151cf44723d1",
                                                "text": "„Es ist unter dem Gesichtspunkt der Verwegenheit der Tat ohne Relevanz, ob ein Juwelier seine Ware außerhalb der Geschäftszeit im Tresor verwahrt oder nicht; […]“"
                                            },
                                            {
                                                "example_id": "fc67a786-56ae-48c9-aa72-cca5562f36f6",
                                                "sense_id": "4a29c672-7e1d-38d9-89be-151cf44723d1",
                                                "text": "„Einer Natter gleich zuckte das Schwert in seinen Händen, und wer ihm zu nahe kam, der büßte seine Verwegenheit mit einer mehr oder weniger tiefen Wunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e5573ae-7b6e-4497-a8e4-d36d606746f0",
                        "source_entry_id": "10e074dd-a6f5-31fa-8b92-d662341c32a5",
                        "source_sense_id": "4375307a-015c-3fb8-956b-44e15e376e8b",
                        "source_sense_description": "fearlessness",
                        "target_lang_word": "Kühnheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kühnheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ec38359-fdb8-36bc-aeb3-260eaa24324c",
                                        "entry_id": "27b96a3e-0ee0-3a39-9367-94d306f578a1",
                                        "glosses": [
                                            "furchtlose, wagemutige Einstellung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7dd4129-b614-496e-8035-39c875fe829a",
                                                "sense_id": "1ec38359-fdb8-36bc-aeb3-260eaa24324c",
                                                "text": "„Die Ablehnung des Wahlergebnisses hat er den Machthabern mit einer Kühnheit entgegengeschleudert, die in der Geschichte der Republik ohne Beispiel ist.“"
                                            },
                                            {
                                                "example_id": "ba407484-e255-4d57-a5e7-dcd484660792",
                                                "sense_id": "1ec38359-fdb8-36bc-aeb3-260eaa24324c",
                                                "text": "„Der wie seine Figuren, die gern einsilbige Namen wie Zürn, Halm oder Horn tragen, schwer unter Abhängigkeiten leidet, die der Einzelne nicht selbst beeinflussen kann. Ein Streiter, zitternd vor Kühnheit, wie eine seiner Lieblingswendungen lautet.“"
                                            },
                                            {
                                                "example_id": "d67b55ae-f262-4ffd-a3b7-6c9a367aba14",
                                                "sense_id": "1ec38359-fdb8-36bc-aeb3-260eaa24324c",
                                                "text": "„So glauben wir denn, daß ohne Kühnheit kein ausgezeichneter Feldherr zu denken ist, d.h. daß ein solcher nie aus einem Menschen werden kann, dem diese Kraft des Gemütes nicht angeboren ist, die wir also als die erste Bedingung einer solchen Laufbahn ansehen.“"
                                            },
                                            {
                                                "example_id": "367311b6-16a8-4273-889a-fd8d3d86039d",
                                                "sense_id": "1ec38359-fdb8-36bc-aeb3-260eaa24324c",
                                                "text": "„Mut ist mit Kühnheit und Tapferkeit mit Leidensfähigkeit ausgestattet; beide müssen die Signale der Angst einerseits zur Kenntnis nehmen und andererseits deren Einfluss in Grenzen halten.“"
                                            },
                                            {
                                                "example_id": "cc64522a-c273-4dc2-8273-8100ba9db76a",
                                                "sense_id": "1ec38359-fdb8-36bc-aeb3-260eaa24324c",
                                                "text": "„Von dem Erfolg bei Kursk befeuert, war das sowjetische Oberkommando mit Zuversicht und Kühnheit zur Offensive übergegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b786fd6-947d-3b91-9e5c-1f7eea5578ed",
                                        "entry_id": "27b96a3e-0ee0-3a39-9367-94d306f578a1",
                                        "glosses": [
                                            "gewagte, mutige Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e32bda-3df9-4dcb-9b51-7ed5ace69492",
                                                "sense_id": "1b786fd6-947d-3b91-9e5c-1f7eea5578ed",
                                                "text": "„Mut ist mit Kühnheit und Tapferkeit mit Leidensfähigkeit ausgestattet; beide müssen die Signale der Angst einerseits zur Kenntnis nehmen und andererseits deren Einfluss in Grenzen halten.“"
                                            },
                                            {
                                                "example_id": "cd69d4a5-aeb5-4b2a-9cb3-8665669ff5d5",
                                                "sense_id": "1b786fd6-947d-3b91-9e5c-1f7eea5578ed",
                                                "text": "„Von dem Erfolg bei Kursk befeuert, war das sowjetische Oberkommando mit Zuversicht und Kühnheit zur Offensive übergegangen.“"
                                            },
                                            {
                                                "example_id": "e544e655-4603-44e2-a37a-68e93c4527b7",
                                                "sense_id": "1b786fd6-947d-3b91-9e5c-1f7eea5578ed",
                                                "text": "Solche Kühnheiten heiße ich nicht gut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
