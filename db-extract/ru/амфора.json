                                    {
                                        "sense_id": "6a1da976-1bb8-36d5-8ed2-0b27abe74878",
                                        "entry_id": "de7727f5-7162-37f4-b5b1-54ed32287e30",
                                        "glosses": [
                                            "Vasija de cuello angosto con dos asas, útil para almacenar y transportar líquidos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3fb32a7-73a7-41ea-b1b3-7817bceb7048",
                                                "sense_id": "6a1da976-1bb8-36d5-8ed2-0b27abe74878",
                                                "text": "«Y allí bajaron cuatro Gigantes que en ánforas de barro traían las mieles de las flores»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
