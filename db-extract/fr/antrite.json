                        "glosses": [
                            "Inflammation d’un antre ainsi qu’une infection de la muqueuse de celui-ci uniquement dans le cas de l’antre mastoïdien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b9ce05-d9d7-40e0-9b55-55acf8f3b489",
                                "sense_id": "cbe959fc-d258-328f-9c55-0184d78960ff",
                                "text": "Une otite du nourrisson associée à une fièvre traînante, et parfois une stagnation pondérale, doit faire redouter une otite chronique avec menace d’antrite ou d’antro-mastoïdite."
                            },
                            {
                                "example_id": "32e69074-1753-4fd3-8c95-e040857edd2e",
                                "sense_id": "cbe959fc-d258-328f-9c55-0184d78960ff",
                                "text": "Les autres symptômes et la marche des mastoïdites suppurées demandent un examen spécial, suivant qu’il s’agit d’une antrite ou d’une cellulite mastoïdienne."
                            }
                        ]
