                ],
                "senses": [
                    {
                        "sense_id": "ef6c6874-696f-321b-8293-376a810389c3",
                        "entry_id": "15533ef4-c13e-35a1-a7dc-5a1c724daf87",
                        "glosses": [
                            "Forschungsbereich mit dem Ziel, wissenschaftliche Erkenntnisse und Methoden zu gewinnen für eine zeitgemäße Verkehrserziehung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b8810d1-8dee-45c8-a561-6f0b57e3d2fc",
                                "sense_id": "ef6c6874-696f-321b-8293-376a810389c3",
                                "text": "„In den vergangenen Jahrzehnten haben die hoch entwickelten europäischen Länder die Risiken der Motorisierung für ihre Bürger bekämpft, etwa mit Verkehrspädagogik.“"
                            },
                            {
                                "example_id": "d0b0dd88-3a21-47d0-b428-dc5358e5e467",
                                "sense_id": "ef6c6874-696f-321b-8293-376a810389c3",
                                "text": "„Zunächst steht die theoretische Schulung an, in der unter anderem die Verkehrsregeln, aber auch Verkehrspädagogik, Verkehrsverhaltenslehre und umweltbewusstes Fahren auf dem Plan stehen.“"
                            },
                            {
                                "example_id": "4c843c5d-fc37-4c0e-b036-d665a04af5eb",
                                "sense_id": "ef6c6874-696f-321b-8293-376a810389c3",
                                "text": "„Daß diese breite pädagogische Ablehnungsfront im Erziehungsbereich weitgehend übereinstimmend vermerkt wird, zeigt u.a. der „Erste Kongreß zur Verkehrspädagogik“ 1988 in Schwäbisch Gmünd, der unter dem Thema „Defizite der Verkehrspädagogik“ stand, für den Kongressbericht aber den positiveren, zukunftsweisenden Titel „Perspektiven der Verkehrspädagogik“ erhielt."
                            },
                            {
                                "example_id": "1c0f77e5-9f24-42e2-b0d7-9f21d9fd7629",
                                "sense_id": "ef6c6874-696f-321b-8293-376a810389c3",
                                "text": "„Die Verkehrspädagogik ist herausgefordert, basierend auf dem aktuellen Forschungsstand der Erziehungswissenschaft, […] Konzepte und Anregungen zu erarbeiten, die theoretisch stimmig und für die Praxis der vorschulischen Erziehung hilfreich sind.“"
                            },
                            {
                                "example_id": "004238c5-e751-47a0-8754-81ebe4108c6b",
                                "sense_id": "ef6c6874-696f-321b-8293-376a810389c3",
                                "text": "„Verkehrspädagogik wäre dann aufzufassen als Teil des Berufswissens von Lehrern und Erziehern, vielleicht auch von Fahrschullehrern, Polizisten, Juristen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
