    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f107df2-0cd9-3e00-8e72-d87dc789fba2",
                    "sense_definition": "Liste ordonnée des titres et des chapitres d'un livre ou d'un périodique, indiquant généralement les pages correspondantes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez consulter le <w>sommaire</w> au début du livre pour trouver ce chapitre."
                        },
                        {
                            "text": "Le journaliste présente les différents sujets au <w>sommaire</w> de cette édition."
                        }
                    ],
                    "synonyms": [
                        "table des matières"
                    ],
                    "common_phrases": [
                        "consulter le sommaire",
                        "au sommaire de ce numéro"
                    ]
                },
                {
                    "sense_id": "7a518378-c00d-3183-b2ea-85f79795c375",
