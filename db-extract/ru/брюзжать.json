                "senses": [
                    {
                        "sense_id": "dc3fd137-c750-358f-b03b-c8e06d71e3de",
                        "entry_id": "bbb8922a-faf8-3555-8c57-6cc5343e6b15",
                        "glosses": [
                            "to grumble, to growl, to grouch, to be peevish"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0bffdaa-1d9e-4966-b7d9-e2977f866a3e",
                                "sense_id": "dc3fd137-c750-358f-b03b-c8e06d71e3de",
                                "text": "Он брюзжа́л ужа́сно, осо́бенно за обе́дом, и все приё́мы его́ бы́ли соверше́нно деспоти́ческие.",
                                "translation": "He grumbled terribly, especially at dinner, and he was absolutely despotic in all his ways.",
                                "english": "He grumbled terribly, especially at dinner, and he was absolutely despotic in all his ways."
                            }
                        ]
                    }
                ],
