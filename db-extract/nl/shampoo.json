                        "entry_id": "5f88a937-617a-310b-8d9e-3a355ea0cabc",
                        "glosses": [
                            "product, meestal in vloeibare vorm, dat bedoeld is om het haar te wassen"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "47aa56e6-9571-4256-ab78-b5dc10a3e3b5",
                                "sense_id": "91b29290-2e6e-3281-b1f7-0c7088b1334c",
                                "text": "Heb jij de fles shampoo ergens gezien?"
                            },
                            {
                                "example_id": "965fe47e-3bc1-4746-8025-0a66b4252d28",
                                "sense_id": "91b29290-2e6e-3281-b1f7-0c7088b1334c",
                                "text": "Volledig gekleed stapte ik het bad in en spoot er shampoo bij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d2b6ac8-10f5-4e23-981d-6134a33f25bd",
                        "source_entry_id": "5f88a937-617a-310b-8d9e-3a355ea0cabc",
                        "source_sense_id": "91b29290-2e6e-3281-b1f7-0c7088b1334c",
                        "source_sense_description": "product, meestal in vloeibare vorm, dat bedoeld is om het haar te wassen.",
                        "target_lang_word": "Shampoo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shampoo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89f58efa-f6b1-3827-a9b0-1fc81c8b5b49",
                                        "entry_id": "b7f48d04-ccf4-3129-a303-713a6a42373d",
                                        "glosses": [
                                            "flüssiges Waschmittel für die Haare"
                                        ],
                                        "tags": [
                                            "Kosmetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4404f325-4103-4d82-8e4b-a544511fe22a",
                                                "sense_id": "89f58efa-f6b1-3827-a9b0-1fc81c8b5b49",
                                                "text": "Der Friseur wusch der Kundin das Haar mit wohlriechendem Shampoo."
                                            },
                                            {
                                                "example_id": "f16670fa-4308-4a1e-85d6-94a60885c003",
                                                "sense_id": "89f58efa-f6b1-3827-a9b0-1fc81c8b5b49",
                                                "text": "„Gedankenverloren schäume ich mir das Haar ein und spüle das Shampoo aus.“"
                                            },
                                            {
                                                "example_id": "6006f911-9b83-4df4-821c-4a2eb15f92d1",
                                                "sense_id": "89f58efa-f6b1-3827-a9b0-1fc81c8b5b49",
                                                "text": "„Dann gab es noch den Geruch von Amalias Shampoo, ein Duft, der mir so vertraut war wie ein Teil von mir.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1e8fa24-a575-4085-8d3d-03da4b105500",
                        "source_entry_id": "5f88a937-617a-310b-8d9e-3a355ea0cabc",
                        "source_sense_id": "91b29290-2e6e-3281-b1f7-0c7088b1334c",
