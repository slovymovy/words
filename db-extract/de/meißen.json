                                "example_id": "a2fb1df9-7585-48da-96d6-d533feaa7468",
                                "sense_id": "d74b0b31-9d6e-3360-8fc0-3ce397697985",
                                "text": "„Das wohl bekannteste Unternehmen Meißens ist die Staatliche Porzellan Manufaktur Meissen, welche handgefertigtes und kostbares Meißener Porzellan herstellt.“"
                            }
