                "senses": [
                    {
                        "sense_id": "e8374511-4c34-3d22-90e3-e60eaa52ff74",
                        "entry_id": "6e5e6ef3-9edb-3610-9c59-644077401742",
                        "glosses": [
                            "uitgave, druk van een boek, krant of ander informatiemedium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05bf9e7d-78b0-4afb-85d4-9e97ab2674d2",
                                "sense_id": "e8374511-4c34-3d22-90e3-e60eaa52ff74",
                                "text": "Turkije heeft woensdagavond de websites van de Europese en Amerikaanse edities van de krant Zaman geblokkeerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "22a74e4b-ff3e-3b07-8b45-45bdfe24b016",
                        "entry_id": "6e5e6ef3-9edb-3610-9c59-644077401742",
                        "glosses": [
                            "keer dat een evenement is georganiseerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b66495-5f41-445f-bfe9-f3afc951259c",
                                "sense_id": "22a74e4b-ff3e-3b07-8b45-45bdfe24b016",
                                "text": "Bar en Boos heeft de popquiz 2017 van Borne gewonnen. Daarmee voltooide de gedoodverfde titelkandidaat haar trilogie. Dit vijftal bleek de vorige twee edities ook al over de meeste kennis van de pophistorie te beschikken. „,We pakten punten met vragen over oude hits van Luv en BZN. Daarmee hebben we denk ik dit keer het verschil gemaakt”, jubelde de teamcaptain van het zegevierende vijftal."
                            },
                            {
                                "example_id": "6f1edfdb-ad67-447e-b90a-cd6deb594c5e",
                                "sense_id": "22a74e4b-ff3e-3b07-8b45-45bdfe24b016",
                                "text": "Dancefestival Mysteryland slaat editie van volgend jaar over Mysteryland, een van de grootste Nederlandse dancefestivals, gaat volgend jaar niet door."
                            },
                            {
                                "example_id": "cba1b769-109e-4318-978b-824bdc50704a",
                                "sense_id": "22a74e4b-ff3e-3b07-8b45-45bdfe24b016",
                                "text": "Volgende maand treden onder anderen Benwal, Eric Prydz, Hardwell en Sound Rush op tijdens de editie van dit jaar."
                            },
                            {
                                "example_id": "3772b168-1b3d-4493-9e9d-d6ebbbf46649",
                                "sense_id": "22a74e4b-ff3e-3b07-8b45-45bdfe24b016",
                                "text": "Sinds de jaren zeventig reisde Arend elke editie naar Frankrijk af, en na de dood van zijn vader had Casper dit gebruik voortgezet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "185fb012-be69-4f4e-aa7c-094ee8fb050f",
                        "source_entry_id": "6e5e6ef3-9edb-3610-9c59-644077401742",
                        "target_lang_word": "edition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "edition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f125e26-3417-343c-9aca-47935d9dfa9b",
                                        "entry_id": "03dc630b-4fcc-36aa-809b-b0b4fbfb6473",
                                        "glosses": [
                                            "A written work edited and published, as by a certain editor or in a certain manner, or at a certain time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be73f674-68aa-434a-92a8-f94332331d6b",
                                                "sense_id": "0f125e26-3417-343c-9aca-47935d9dfa9b",
                                                "text": "She wanted a copy of the Clericotes edition, but had to settle for the 1921 edition. She had never liked abridged editions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca449dc7-6d39-310d-8601-671d2f834aa1",
                                        "entry_id": "03dc630b-4fcc-36aa-809b-b0b4fbfb6473",
                                        "glosses": [
                                            "The whole number of copies of a work printed and published at one time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7576972-8538-480d-8213-3502c59c61ef",
                                                "sense_id": "ca449dc7-6d39-310d-8601-671d2f834aa1",
                                                "text": "The first edition was soon sold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba6c0a62-6136-33ca-b037-1db352f1e916",
                                        "entry_id": "03dc630b-4fcc-36aa-809b-b0b4fbfb6473",
                                        "glosses": [
                                            "An instance of the first or second sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be081bc-f396-4df3-89ab-af48ce4636d0",
                                                "sense_id": "ba6c0a62-6136-33ca-b037-1db352f1e916",
                                                "text": "What he had found was a particularly valuable first edition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78a545af-285e-34a7-a948-829c7132d559",
                                        "entry_id": "03dc630b-4fcc-36aa-809b-b0b4fbfb6473",
                                        "glosses": [
                                            "A particular instance of an event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f76490-446e-42dd-bd49-6034f1f2e19b",
                                                "sense_id": "78a545af-285e-34a7-a948-829c7132d559",
                                                "text": "The 2014 edition of the Tour de France started in Leeds, Yorkshire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "914ca86a-a117-48ab-a9c7-4e23229c2a12",
                        "source_entry_id": "6e5e6ef3-9edb-3610-9c59-644077401742",
                        "target_lang_word": "édition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "édition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                        "entry_id": "4e725fbf-b155-310f-b0f1-63c144103df8",
                                        "glosses": [
                                            "Impression, publication et diffusion d’une œuvre artistique (livre, musique, objet d’art, etc). soit qu’elle paraisse pour la première fois, soit qu’elle ait déjà été imprimée ; ou les séries successives des exemplaires qu’on imprime pour cette publication."
                                        ],
                                        "tags": [
                                            "Livre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aefab346-ef7d-4c0c-aaad-1863bab9bf6c",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "En 1887, dans la préface à la troisième édition du Sublime, Denis Poulot, industriel expérimenté, ancien maire du XIᵉ arrondissement et gambettiste, disait que les syndicats tueraient les grèves ; […]."
                                            },
                                            {
                                                "example_id": "d7912215-244b-4df1-b127-a0ebb1cf5281",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "L'Académie française, qui depuis 1694 a donné sept éditions de son Dictionnaire et commence à publier la huitième, donne au début de l'année 1932, la première édition de sa Grammaire rédigée en conformité des articles 24 et 26 de ses statuts des mois de mars et d'avril 1634."
                                            },
                                            {
                                                "example_id": "c49d2160-751e-4f3a-821f-a4bd72572630",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "Au verso du frontispice de la 1ʳᵉ édition on voit le portrait de l’auteur dans un médaillon, gravé par un anonyme."
                                            },
                                            {
                                                "example_id": "57cfce64-10c8-4313-a9ff-96efcbb0be36",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "Le saint Augustin de l’édition d’Erasme, de l’édition des bénédictins."
                                            },
                                            {
                                                "example_id": "af005b22-c561-49e6-830f-6a675ed9826f",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "Une belle édition. — Une édition fautive. — Mauvaise édition. — Édition correcte."
                                            },
                                            {
                                                "example_id": "6c8c7fd6-a3d1-4c16-834b-9c861e34bb37",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "Édition complète, savante, populaire, à tirage restreint; de luxe, à bon marché."
                                            },
                                            {
                                                "example_id": "7169779e-ab50-4947-bc4c-0da30bb7f5d3",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "Édition princeps (première édition) ; Édition ne varietur (édition définitive)."
                                            },
                                            {
                                                "example_id": "6862c3e3-7c1f-4948-b6d4-97e245b8cc86",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "Par type de marché : édition musicale, en ligne, internet, collector, phonographique, jeunesse, indépendante, limitée législative, numérique, universitaire."
                                            },
                                            {
                                                "example_id": "734584b0-3cdf-4398-8220-12b847dae000",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "Édition d'estampes."
                                            },
                                            {
                                                "example_id": "877beda1-7ebf-44eb-8abb-3c1730cd73b2",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "Édition de mobilier."
                                            },
                                            {
                                                "example_id": "c1112f37-ede1-4385-a618-365678509fc9",
                                                "sense_id": "a15b5233-f002-35d6-aea2-32a4f8eee76f",
                                                "text": "Édition de documentaires audiovisuels, de film, de DVD."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6914ef26-66e7-3d56-a15e-99e486528a99",
                                        "entry_id": "4e725fbf-b155-310f-b0f1-63c144103df8",
                                        "glosses": [
                                            "Totalité des exemplaires de tel ou tel ouvrage publié et mis en vente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21bee265-c4f6-49e1-8450-41773872bf9a",
                                                "sense_id": "6914ef26-66e7-3d56-a15e-99e486528a99",
                                                "text": "La première édition de ce livre fut vite épuisée."
                                            },
                                            {
                                                "example_id": "b981553d-0388-477c-aa2d-8e8d19993b7e",
                                                "sense_id": "6914ef26-66e7-3d56-a15e-99e486528a99",
                                                "text": "Toute l’édition fut saisie."
                                            },
                                            {
                                                "example_id": "d65bd7a8-b6c0-41b1-bdac-23afc78a848f",
                                                "sense_id": "6914ef26-66e7-3d56-a15e-99e486528a99",
                                                "text": "On dut mettre au pilon presque toute l’édition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e29843f4-77b8-315d-9988-f2b50060433f",
                                        "entry_id": "4e725fbf-b155-310f-b0f1-63c144103df8",
                                        "glosses": [
                                            "Par extension, l’industrie qui a pour objet la publication d’ouvrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a95ea267-74a7-4df3-8abb-9726c3d3ced8",
                                                "sense_id": "e29843f4-77b8-315d-9988-f2b50060433f",
                                                "text": "Tout se passe en fin de compte comme si le secteur de l’édition n’était qu’un secteur économique parmi d’autres, amputé de toute dimension culturelle."
                                            },
                                            {
                                                "example_id": "0319ceed-0363-453b-8cce-58e4c37c17e9",
                                                "sense_id": "e29843f4-77b8-315d-9988-f2b50060433f",
                                                "text": "Dans ce contexte, il est somme toute assez naturel de voir s’organiser à l’échelle internationale le monde de l’édition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68bda523-31a3-3b11-9b98-bc7a79075116",
                                        "entry_id": "4e725fbf-b155-310f-b0f1-63c144103df8",
                                        "glosses": [
                                            "Tirage spécifique de la même édition d’un ouvrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a39a716-9875-430e-902d-72a296d75c23",
                                                "sense_id": "68bda523-31a3-3b11-9b98-bc7a79075116",
                                                "text": "Dans l’édition courante, « L’Âne » est encore meilleur marché, mais l’éditeur tient à signaler, à l’usage des bibliophiles, la mise en vente d’une édition numérotée sur papier luxueux, et fort onéreuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b92e99-1279-3c05-90db-a82958d263d7",
                                        "entry_id": "4e725fbf-b155-310f-b0f1-63c144103df8",
                                        "glosses": [
                                            "Exemplaire faisant partie d’un tirage dans une édition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "242ca43e-be35-4f3f-b94b-9d6ca33d4516",
                                                "sense_id": "39b92e99-1279-3c05-90db-a82958d263d7",
                                                "text": "La Bibliothèque impériale possède l’édition de 1812, et j’ai tenu récemment dans mes mains l’exemplaire déposé à cette époque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27102542-2129-38a6-80b7-47dd7e2c2748",
                                        "entry_id": "4e725fbf-b155-310f-b0f1-63c144103df8",
                                        "glosses": [
                                            "Tirage strictement identique de l’édition du jour d’un quotidien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa640276-f3b7-4bd6-ac73-0dbe91d14ab6",
                                                "sense_id": "27102542-2129-38a6-80b7-47dd7e2c2748",
                                                "text": "Libération n’a pas eu le temps, dans sa première édition, de disposer des photographies montrant ces émotions. Cela sera en partie « rattrapé » dans l’édition suivante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71ff8b7a-75c8-3fae-946d-1295c3f3d1f5",
                                        "entry_id": "4e725fbf-b155-310f-b0f1-63c144103df8",
                                        "glosses": [
                                            "Les différents canaux de diffusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8fbcf40-685a-4741-a4a1-75ceeff6d63b",
                                                "sense_id": "71ff8b7a-75c8-3fae-946d-1295c3f3d1f5",
                                                "text": "Édition papier, édition web."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63681b46-ddab-35fb-8b61-87887b1c5d2c",
                                        "entry_id": "4e725fbf-b155-310f-b0f1-63c144103df8",
                                        "glosses": [
                                            "Par extension, émission de télévision donnant les actualités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c0b407-2c02-4642-aaa8-5a287d234793",
                                                "sense_id": "63681b46-ddab-35fb-8b61-87887b1c5d2c",
                                                "text": "De plus, celles-ci installaient leurs équipes dès 18 heures dans les quartiers réputés les plus « chauds », et attendaient le déclenchement des hostilités pour la diffusion des images dans l’édition de 20 heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d869936a-0b49-3dbc-8904-07ef867ddf30",
                                        "entry_id": "4e725fbf-b155-310f-b0f1-63c144103df8",
                                        "glosses": [
                                            "(Suivi d’une année) S’utilise pour préciser l’année en parlant d’une manifestation ayant lieu régulièrement, par exemple tous les ans ou tous les deux ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc1fdcec-5282-4410-afae-97d0744de0b8",
                                                "sense_id": "d869936a-0b49-3dbc-8904-07ef867ddf30",
                                                "text": "Cet auteur n’était pas présent à l’édition 2005 du Salon du livre."
                                            },
                                            {
                                                "example_id": "a4b9f9c9-7a75-42db-9dad-65730b7bc817",
                                                "sense_id": "d869936a-0b49-3dbc-8904-07ef867ddf30",
                                                "text": "Rendez-vous lors de l’édition 2014 pour la revanche !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
