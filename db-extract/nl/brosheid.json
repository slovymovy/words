                        "glosses": [
                            "de eigenschap om zonder veel te rekken te breken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0279db82-1c70-45c9-a949-ee80d953b7cc",
                                "sense_id": "2b78a84f-ea6c-31c5-8c74-1b9518a823c7",
                                "text": "De winnende brokken van Banketbakkerij Jacobs scoren op uitstraling uitmuntend. Maar ook de brosheid en smaak zijn van een geweldige kwaliteit. Een prachtig resultaat voor zo’n banketproduct."
                            },
                            {
                                "example_id": "9194fea0-28ad-4f53-a2e8-ac588332a9ae",
                                "sense_id": "2b78a84f-ea6c-31c5-8c74-1b9518a823c7",
                                "text": "Steeds vaker wordt brosheid gedefinieerd aan de hand van het lawaai dat de beschuit maakt in de mond van de proefpersoon die er met open mond in bijt. Volg het werk aan ‘toasted rusk rolls’ in de Journal of Texture Studies."
                            }
                        ]
                    }
