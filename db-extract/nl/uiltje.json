                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff9282f-fa5d-4a2d-9a39-ab21869404e2",
                                                "sense_id": "8b91d9da-2dc2-3ce6-b721-29c76ad81c0c",
                                                "text": "So that, dear lords, if I be left behind, / A moth of peace, and he go to the war, / The rites for which I love him are bereft me, / And I a heavy interim shall support / By his dear absence. Let me go with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "447ae21e-da7b-31cf-933b-0d1b6c04cc4c",
                                        "entry_id": "deb9c218-2a6a-32c3-b505-9d3ea9fbfff5",
                                        "glosses": [
                                            "A liver spot, especially an irregular or feathery one."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722b5732-79bd-4ab7-b9ff-485078f72480",
                                                "sense_id": "447ae21e-da7b-31cf-933b-0d1b6c04cc4c",
                                                "text": "To remove moth patches, wash the spots with a solution of common bicarbonate of soda and water several times a day, until the patches are removed, which will usually be in forty-eight hours."
                                            },
                                            {
                                                "example_id": "f228ce1e-1e06-4de6-8785-f0ad9db4746a",
                                                "sense_id": "447ae21e-da7b-31cf-933b-0d1b6c04cc4c",
                                                "text": "Craves for sour things, chalks and eggs, fatty people with light brown spots on the face or liver spots, moth patches on forehead and cheek."
                                            },
                                            {
                                                "example_id": "a6698017-388f-43be-8941-6f58acf7d823",
                                                "sense_id": "447ae21e-da7b-31cf-933b-0d1b6c04cc4c",
                                                "text": "There are signs of liver affections as weakness, yellow complexion, liver spots, and moth spot like a saddle over the nose."
                                            }
                                        ]
                                    }
