                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d0f8b2a-0552-4b9f-aa6f-7b48bd1b2aa4",
                                                "sense_id": "dc7b0733-1d74-36f8-ac7b-46d57fa2745f",
                                                "text": "In feite is het natuurlijk Joy's schuld dat wij hier zonder gids in de Siciliaanse Apennijnen ronddolen."
                                            }
                                        ]
                                    }
                                ]
