                ],
                "senses": [
                    {
                        "sense_id": "f24c3049-8ceb-36d2-8e81-802c9c2f2d58",
                        "entry_id": "f04a6d8e-211e-31fe-b490-acf60373a6fa",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d64f962-bb79-41f2-b31d-b29f364dccee",
                                "sense_id": "f24c3049-8ceb-36d2-8e81-802c9c2f2d58",
                                "text": "Frau Scholl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "03b75396-8dfa-42b3-a866-980ab5e07c6f",
                                "sense_id": "f24c3049-8ceb-36d2-8e81-802c9c2f2d58",
                                "text": "Herr Scholl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "860e7ed6-3fc6-49f4-a218-bf92c79eb837",
                                "sense_id": "f24c3049-8ceb-36d2-8e81-802c9c2f2d58",
                                "text": "Die Scholls fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "3e95ecf4-0e06-43fc-991f-d32370164abd",
                                "sense_id": "f24c3049-8ceb-36d2-8e81-802c9c2f2d58",
                                "text": "Der Scholl trägt nie die Pullover, die die Scholl ihm strickt."
                            },
                            {
                                "example_id": "46f079b1-9339-424f-9dec-e3381acf2cc9",
                                "sense_id": "f24c3049-8ceb-36d2-8e81-802c9c2f2d58",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scholl kommt, geht der Herr Scholl.“"
                            },
                            {
                                "example_id": "718fdd15-d891-4a22-9eff-6d64fb7c2b17",
                                "sense_id": "f24c3049-8ceb-36d2-8e81-802c9c2f2d58",
                                "text": "Scholl kommt und geht."
                            },
                            {
                                "example_id": "ef99e420-c301-4348-9637-e47de2250c95",
                                "sense_id": "f24c3049-8ceb-36d2-8e81-802c9c2f2d58",
                                "text": "Scholls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
