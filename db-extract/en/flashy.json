                    }
                ],
                "senses": [
                    {
                        "sense_id": "6408e24e-eafe-397c-bf38-1df809b3a9bd",
                        "entry_id": "b5703697-c93f-3949-9b07-780801db2476",
                        "glosses": [
                            "Showy; visually impressive, attention-getting, or appealing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a01a4c06-964c-4beb-8602-fa825c580624",
                                "sense_id": "6408e24e-eafe-397c-bf38-1df809b3a9bd",
                                "text": "The dancers wore flashy costumes featuring shiny sequins in many vibrant colors."
                            }
                        ]
                    },
                    {
                        "sense_id": "b94c963d-815e-3c91-8d3f-37efa7d9cd03",
                        "entry_id": "b5703697-c93f-3949-9b07-780801db2476",
                        "glosses": [
                            "Marked by frequent variations in water amount (compare flash flood)."
                        ],
                        "tags": [
                            "of a river"
                        ],
                        "examples": [
                            {
                                "example_id": "de7a60a6-8638-42d9-ae00-d003c733d338",
                                "sense_id": "b94c963d-815e-3c91-8d3f-37efa7d9cd03",
                                "text": "Flow criteria were used for classification […] The criteria chosen were […] (4) the rate of change of flow with time (logged serial correlation coefficients are 0.2 in flashy rivers, but up to 0.98 in stable ones); and (5) the velocity associated with average daily flows (this varies from 1.03 m/s in flashy rivers to 0.08 m/s in lowland ones)."
                            }
                        ]
                    },
                    {
                        "sense_id": "7785898d-e806-3ecd-b3b2-cf90e94c6efc",
                        "entry_id": "b5703697-c93f-3949-9b07-780801db2476",
                        "glosses": [
                            "Flashing; producing flashes."
                        ],
                        "tags": [
                            "dated",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "94e35ed5-def8-45e9-963c-ba7f8d958256",
                                "sense_id": "7785898d-e806-3ecd-b3b2-cf90e94c6efc",
                                "text": "a flashy light"
                            },
                            {
                                "example_id": "7e672896-0975-4563-9ddb-bb2f6cd17f69",
                                "sense_id": "7785898d-e806-3ecd-b3b2-cf90e94c6efc",
                                "text": "[…] the accustomed warmth pierced his marrow, and ran thrilling through his shaken bones; just as when at times, with forked thunder burst, a chinky stream of fire in flashy lightning shoots athwart the skies."
                            }
                        ]
                    },
                    {
                        "sense_id": "00530cec-32bc-384b-96db-cc4ce0836613",
                        "entry_id": "b5703697-c93f-3949-9b07-780801db2476",
                        "glosses": [
                            "Drunk; tipsy."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "0eecaa3e-d9ff-405a-bc18-3f8116dd7dcb",
                                "sense_id": "00530cec-32bc-384b-96db-cc4ce0836613",
                                "text": "Indeed, he was 'dithguthted' at his condition; and if upon the occasion just described he had allowed himself to be somewhat 'intoxicated with liquor,' I must aver that I do not recollect another instance in which this worthy little gentleman suffered himself to be similarly overtaken. Now and then a little 'flashy' he might be, but nothing more serious—and rely upon it, this was no common virtue in those days."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19e56657-064d-4041-9645-2d4674065c1e",
                        "source_entry_id": "b5703697-c93f-3949-9b07-780801db2476",
                        "source_sense_description": "showy; visually impressive, attention-getting, or appealing",
                        "target_lang_word": "tape-à-l’œil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tape-à-l’œil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                        "entry_id": "37fba0a2-e733-35c1-9be9-064ff36c0676",
                                        "glosses": [
                                            "Criard, tapageur, trop voyant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f89aa1d-4daa-4761-8a09-f527ca96bd0a",
                                                "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                                "text": "Un décor tape-à-l’œil."
                                            },
                                            {
                                                "example_id": "a6c45b41-d32c-4474-b760-01bdc62b608b",
                                                "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                                "text": "C’est un peu trop tape-à-l’œil comme couleur, tu ne trouves pas ?"
                                            },
                                            {
                                                "example_id": "b2e24481-3348-481f-ac70-24cfaab9898d",
                                                "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                                "text": "Ils s’étaient rencontrés, la plupart du temps, dans les bureaux tape-à-l’œil ou pseudo-fonctionnels des directeurs d’agence."
                                            },
                                            {
                                                "example_id": "28b7db18-3e05-4300-85aa-908a8bb751a7",
                                                "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                                "text": "J’y vais le matin, avant la ruée des touristes qui viennent voir les bateaux tape-à-l’oeil en plastique, portant des noms idiots affichés sur la poupe en vilaines lettres d’or souvent sur fond violet qui la nuit s’illuminent aux néons."
                                            },
                                            {
                                                "example_id": "8bfceae5-a7fb-4850-b43d-7bf439b2fdfb",
                                                "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                                "text": "Au lieu de mets tape-à-l’œil, caviar ou foie gras, les Cléry proposaient des classiques d’une simplicité déconcertante : un jambon de Parme tranché à la demande, une immense mozzarella dont on pouvait prélever une part que l’on arrosait soi-même d’huile d’olive, des artichauts à la romaine. Dominique admira cet art exemplaire du naturel et du chic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tape-à-l’œil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb09d4c8-b783-3114-8ec9-9f03ba5656a8",
                                        "entry_id": "f286b0f3-7d19-37a7-918a-237e50144f8f",
                                        "glosses": [
                                            "Apparence éblouissante mais trompeuse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f01ee8-b056-40eb-9830-9bd006b6bb6e",
                                                "sense_id": "cb09d4c8-b783-3114-8ec9-9f03ba5656a8",
                                                "text": "C’est du tape-à-l’œil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
