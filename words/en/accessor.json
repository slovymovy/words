{
    "word_family": [
        "access",
        "accessible",
        "accessibility",
        "inaccessible"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84f943d9-c5de-3dde-9d70-8f01e3f8a160",
                    "sense_definition": "Someone or something that accesses.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system identifies every <w>accessor</w> before granting entry to the secure database.",
                            "target_lang_translations": {
                                "zh": "系统在授予进入安全数据库的权限前，会识别每一位<w>访问者</w>。"
                            }
                        },
                        {
                            "text": "As a frequent <w>accessor</w> of the library archives, she knew exactly where to find the documents.",
                            "target_lang_translations": {
                                "zh": "作为图书馆档案的常客，她非常清楚在哪里能找到这些文件。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指访问某物的人或系统。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "访问者",
                                "target_lang_sense_clarification": "指进入或使用某系统、场所的人或程序。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7593445c-1860-3ae3-9cf2-0b604591cc9d",
                    "sense_definition": "A function that retrieves a value, usually without changing any data.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "programming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The class uses a simple <w>accessor</w> to return the private variable value.",
                            "target_lang_translations": {
                                "zh": "该类使用一个简单的<w>访问器</w>来返回私有变量的值。"
                            }
                        },
                        {
                            "text": "Always use a public <w>accessor</w> to read data safely from the object.",
                            "target_lang_translations": {
                                "zh": "请务必使用公共<w>访问器</w>来安全地读取对象中的数据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "getter"
                    ],
                    "antonyms": [
                        "mutator"
                    ],
                    "common_phrases": [
                        "public accessor",
                        "class accessor"
                    ],
                    "target_lang_definitions": {
                        "zh": "在编程中，指用于获取对象内部数据值而不修改数据的函数。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "访问器",
                                "target_lang_sense_clarification": "编程术语，指用于读取私有成员变量的函数。"
                            },
                            {
                                "target_lang_word": "获取器",
                                "target_lang_sense_clarification": "编程术语，即 getter，指专门用于获取属性值的函数。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}