                                                "example_id": "600ab009-843c-4ea8-8d18-0523252a92cd",
                                                "sense_id": "4585a12f-b9a8-39b0-80a2-efcbac561919",
                                                "text": "Nigdzie dzisiaj nie pójdziesz, będziesz siedzieć w domu i się uczyć."
                                            }
