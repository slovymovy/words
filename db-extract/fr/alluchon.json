                                            {
                                                "example_id": "e4af4151-fe9c-42fc-8520-3f287e0b5503",
                                                "sense_id": "0bc1eb73-91e3-371d-b4e7-da2dd2cc1fc7",
                                                "text": "Der Zahnarzt entfernte ihr drei Zähne."
                                            },
                                            {
                                                "example_id": "24c8f1af-f72e-45e9-81e0-846fc08dec99",
                                                "sense_id": "0bc1eb73-91e3-371d-b4e7-da2dd2cc1fc7",
                                                "text": "Das Kleinkind bekommt seine ersten Zähne."
                                            },
                                            {
                                                "example_id": "9b66d2b9-2e05-4768-89fa-35c0dcc507d5",
                                                "sense_id": "0bc1eb73-91e3-371d-b4e7-da2dd2cc1fc7",
                                                "text": "Zähne sind ein Teil des Gebisses."
                                            },
                                            {
                                                "example_id": "d782ff30-4168-4220-a58c-bd01ae356d6a",
                                                "sense_id": "0bc1eb73-91e3-371d-b4e7-da2dd2cc1fc7",
                                                "text": "Jemand hat ihm einen Zahn ausgeschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e327328a-ca45-3fe9-a979-cc9c8cf16a69",
                                        "entry_id": "1bd0aaeb-b236-3f73-9818-c03ed3a59b8b",
                                        "glosses": [
                                            "eine Zacke bei Gegenständen mit aneinandergereihten Spitzen (zum Beispiel Zahnrad oder Säge)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b66692e5-e361-4414-975b-4b1f34f7006e",
                                                "sense_id": "e327328a-ca45-3fe9-a979-cc9c8cf16a69",
                                                "text": "Pass auf, dass der Säge kein Zahn abbricht!"
                                            },
                                            {
                                                "example_id": "5d0abdc9-6c36-4820-a4c7-b4f514a2494c",
                                                "sense_id": "e327328a-ca45-3fe9-a979-cc9c8cf16a69",
                                                "text": "Der Zahnkranz besteht aus 30 Zähnen."
                                            },
                                            {
                                                "example_id": "d42b5640-e4d2-470f-8b37-5a9ee5954a20",
                                                "sense_id": "e327328a-ca45-3fe9-a979-cc9c8cf16a69",
                                                "text": "Das Sägeblatt hat geschränkte Zähne."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2a58eeee-d9fd-380f-aab6-3ebb12414f62",
                                        "entry_id": "1bd0aaeb-b236-3f73-9818-c03ed3a59b8b",
