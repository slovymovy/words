                            {
                                "example_id": "92f4bd0b-c56e-4e16-aede-bd3a8ba3da3a",
                                "sense_id": "47afeeb9-922c-3ff9-8392-a99f1a15b3fe",
                                "text": "Ma mère est déjà une raoultienne convaincue... J'ai beau lui dire qu'il y a pas de preuve pour l'instant, rien n'y fait."
                            },
                            {
                                "example_id": "aa234d51-4d37-461c-a098-2c7f4641de34",
                                "sense_id": "47afeeb9-922c-3ff9-8392-a99f1a15b3fe",
                                "text": "Vous êtes une raoultienne pur jus, qui mangez du Doliprane en étant habitée d'une foi aveugle en son efficacité contre le Covid-19, elle-même fondée sur une rumeur ?"
                            }
                        ]
