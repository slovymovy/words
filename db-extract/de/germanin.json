                "senses": [
                    {
                        "sense_id": "aa481ba5-adf5-3090-b049-f0d14fd5eeea",
                        "entry_id": "f2242aeb-ce73-307c-97c6-1b134c95016d",
                        "glosses": [
                            "eine Angehörige der Stämme der Germanen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbd37521-447a-4722-aa40-d40fe40394ea",
                                "sense_id": "aa481ba5-adf5-3090-b049-f0d14fd5eeea",
                                "text": "„Er hatte zwar bereits eine Frau, eine Germanin, aber er nahm die Keltin dazu, Noricum war wegen seiner Eisenvorkommen berühmt und gab einen guten Verbündeten ab.“"
                            },
                            {
                                "example_id": "d30b2321-94ec-4794-a001-a168789d9039",
                                "sense_id": "aa481ba5-adf5-3090-b049-f0d14fd5eeea",
                                "text": "„Auch die teutonischen Frauen beeindruckten die Sieger und prägten Roms Bild von den Germaninnen.“"
                            },
                            {
                                "example_id": "688d99fe-309d-4d87-adc5-91e186930cc6",
                                "sense_id": "aa481ba5-adf5-3090-b049-f0d14fd5eeea",
                                "text": "„Gastwirte boten einsamen Okkupanten neben warmen Speisen auch wärmende Germaninnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
