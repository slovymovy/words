                                            {
                                                "example_id": "dd3fab72-8b68-4585-8f20-6cb5688bc944",
                                                "sense_id": "9051f1c0-4c6c-3f1d-8a9a-31069b543c16",
                                                "text": "“How'd you like to be shoved in a blooming log?'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blooming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5d40f4f-64da-32bc-8beb-b0f4fc54dfa1",
                                        "entry_id": "8ee66f57-dc41-3211-808f-118cb3eedbad",
                                        "glosses": [
                                            "A euphemism for the intensifier bloody."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a44144d-a344-4f66-b7af-33697343cd01",
                                                "sense_id": "b5d40f4f-64da-32bc-8beb-b0f4fc54dfa1",
                                                "text": "My train's late again. Blooming typical."
                                            },
                                            {
                                                "example_id": "d04d6abe-d4ce-42fd-9911-3b4486d55811",
                                                "sense_id": "b5d40f4f-64da-32bc-8beb-b0f4fc54dfa1",
                                                "text": "“Well, all I can say is that if yer don't take yer dial outer the road I'll bloomin' well take an' bounce a gibber off yer crust.”"
                                            },
                                            {
                                                "example_id": "c8bb9ef8-03f1-4b55-94a3-0bee243671b7",
                                                "sense_id": "b5d40f4f-64da-32bc-8beb-b0f4fc54dfa1",
                                                "text": "It had been his intention to go to Wimbledon, but as he himself said: “Why be blooming well frizzled when you can hear all the results over the wireless. And results are all that concern me. […]”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blooming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43cc12a5-3675-3a0d-a096-661901af7f7b",
                                        "entry_id": "0dde4c6b-cddb-37ac-b459-c7ae18e702d7",
                                        "glosses": [
                                            "The act by which something blooms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
