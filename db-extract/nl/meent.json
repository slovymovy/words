                ],
                "senses": [
                    {
                        "sense_id": "20bd995d-e629-31d3-85e8-b261faf25cdf",
                        "entry_id": "1b22c2fb-47e5-376f-953b-9427545e5836",
                        "glosses": [
                            "weidegrond in gemeenschappelijk bezit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de866dfb-0a8d-4f23-9152-1e7afc1fdb24",
                                "sense_id": "20bd995d-e629-31d3-85e8-b261faf25cdf",
                                "text": "In voorbije eeuwen waren meenten een gewoon verschijnsel."
                            },
                            {
                                "example_id": "42bdcaf7-6b2f-4564-af85-f7acca383daf",
                                "sense_id": "20bd995d-e629-31d3-85e8-b261faf25cdf",
                                "text": "tot op heden komen succesvolle meenten in sommige gebieden voor, zoals in de Zwitserse Alpen, zonder dat hier overbegrazing of uitputting optreedt."
                            },
                            {
                                "example_id": "c44dae09-5c0d-4037-9bf2-3b90dc2c2572",
                                "sense_id": "20bd995d-e629-31d3-85e8-b261faf25cdf",
                                "text": "Ze kunnen alleen nog lelijke replica's maken van wat ze eerder hebben gemaakt, omdat iedereen meent te weten wie ze zijn en hoe ze zouden moeten zijn."
                            },
                            {
                                "example_id": "7aebad96-b521-4395-aeb1-7acbef3f2ba2",
                                "sense_id": "20bd995d-e629-31d3-85e8-b261faf25cdf",
                                "text": "Genzel meent nu ook doorslaggevend bewijs gevonden te hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
