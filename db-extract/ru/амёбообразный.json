                "senses": [
                    {
                        "sense_id": "f0dc07d5-7a1a-3150-93b1-c5676b8683c7",
                        "entry_id": "57142262-97a2-3f40-8714-a88b5d86d7be",
                        "glosses": [
                            "чем-либо напоминающий амёбу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db5eb86-cc12-4b77-96c4-7de87c9a72e7",
                                "sense_id": "f0dc07d5-7a1a-3150-93b1-c5676b8683c7",
                                "text": "Сквозь его полупрозрачную оболочку просвечивало переливающееся разными цветами спектра, в зависимости от испытываемых эмоций, закрученное веретеном амёбообразное тело, увенчанное конусом реснитчатой головки — вместилищем разума и зрительных анализаторов."
                            }
                        ]
                    },
                    {
                        "sense_id": "c193c16d-8427-3dbb-85b6-abe9d731311c",
                        "entry_id": "57142262-97a2-3f40-8714-a88b5d86d7be",
                        "glosses": [
                            "перен. неопределённый, лишённый чётких признаков, свойств"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cf57f10-2490-4e12-81e5-cf9cde4820e9",
                                "sense_id": "c193c16d-8427-3dbb-85b6-abe9d731311c",
                                "text": "А Александр — очень спокойный, уравновешенный, «амёбообразный»…"
                            }
                        ]
                    }
                ],
