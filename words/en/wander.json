{
    "word_family": [
        "wanderer",
        "wanderlust"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                    "sense_definition": "To move without purpose or specified destination; often in search of livelihood.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>wander</w> around the city center for a few hours.",
                            "target_lang_translations": {
                                "ru": "Мы решили пару часов <w>побродить</w> по центру города.",
                                "pl": "Postanowiliśmy przez kilka godzin <w>powłóczyć się</w> po centrum miasta."
                            }
                        },
                        {
                            "text": "The sheep were allowed to <w>wander</w> freely across the hills.",
                            "target_lang_translations": {
                                "ru": "Овцам разрешали свободно <w>бродить</w> по холмам.",
                                "pl": "Owcom pozwolono swobodnie <w>błąkać się</w> po wzgórzach."
                            }
                        }
                    ],
                    "synonyms": [
                        "roam",
                        "stroll",
                        "meander"
                    ],
                    "common_phrases": [
                        "wander around",
                        "wander off",
                        "wander about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ходить или двигаться без определенной цели или направления; часто в поисках средств к существованию.",
                        "pl": "Poruszać się bez określonego celu lub kierunku; często w poszukiwaniu środków do życia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "медленно ходить без определенного направления"
                            },
                            {
                                "target_lang_word": "блуждать",
                                "target_lang_sense_clarification": "ходить наугад, часто с оттенком потери пути"
                            },
                            {
                                "target_lang_word": "скитаться",
                                "target_lang_sense_clarification": "странствовать, не имея постоянного жилья"
                            },
                            {
                                "target_lang_word": "слоняться",
                                "target_lang_sense_clarification": "разг. ходить без дела, без цели"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "włóczyć się",
                                "target_lang_sense_clarification": "chodzić bez celu, często przez dłuższy czas"
                            },
                            {
                                "target_lang_word": "błąkać się",
                                "target_lang_sense_clarification": "chodzić bez celu, często z poczuciem zagubienia"
                            },
                            {
                                "target_lang_word": "tułać się",
                                "target_lang_sense_clarification": "przebywać w różnych miejscach, nie mając stałego schronienia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "132b2d13-cde1-3959-8821-99b01a5b7ca1",
                    "sense_definition": "Of the mind, to lose focus or clarity of argument or attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to listen, but my mind began to <w>wander</w> during the long lecture.",
                            "target_lang_translations": {
                                "ru": "Я пытался слушать, но во время длинной лекции мои мысли начали <w>блуждать</w>.",
                                "pl": "Próbowałem słuchać, ale podczas długiego wykładu moje myśli zaczęły <w>błądzić</w>."
                            }
                        },
                        {
                            "text": "If your attention starts to <w>wander</w>, you should take a short break.",
                            "target_lang_translations": {
                                "ru": "Если ваше внимание начинает <w>рассеиваться</w>, вам следует сделать короткий перерыв.",
                                "pl": "Jeśli twoja uwaga zaczyna się <w>rozpraszać</w>, powinieneś zrobić krótką przerwę."
                            }
                        }
                    ],
                    "synonyms": [
                        "drift"
                    ],
                    "common_phrases": [
                        "mind wanders",
                        "attention wanders"
                    ],
                    "target_lang_definitions": {
                        "ru": "О мыслях или внимании: терять сосредоточенность, перескакивать с предмета на предмет.",
                        "pl": "O myślach lub uwadze: tracić koncentrację, rozpraszać się."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блуждать",
                                "target_lang_sense_clarification": "о мыслях или взгляде: быть рассеянным, неустойчивым"
                            },
                            {
                                "target_lang_word": "рассеиваться",
                                "target_lang_sense_clarification": "о внимании: терять концентрацию"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "błądzić",
                                "target_lang_sense_clarification": "o myślach: być niespokojnym, nie skupiać się na jednym temacie"
                            },
                            {
                                "target_lang_word": "rozpraszać się",
                                "target_lang_sense_clarification": "tracić skupienie na wykonywanej czynności"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0a0449a-8a0d-3e71-96e9-d64aae5269f2",
                    "sense_definition": "To go somewhere indirectly or at varying speeds; to move in a curved path.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river seems to <w>wander</w> through the valley before reaching the sea.",
                            "target_lang_translations": {
                                "ru": "Кажется, что река <w>петляет</w> по долине, прежде чем достичь моря.",
                                "pl": "Rzeka zdaje się <w>wić</w> przez dolinę, zanim dotrze do morza."
                            }
                        },
                        {
                            "text": "The path tends to <w>wander</w> through the woods rather than going straight.",
                            "target_lang_translations": {
                                "ru": "Тропинка скорее <w>петляет</w> по лесу, чем идет прямо.",
                                "pl": "Ścieżka raczej <w>wije się</w> przez las, zamiast prowadzić prosto."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Извиваться, менять направление или скорость (о дороге, реке).",
                        "pl": "Poruszać się w sposób pośredni lub kręty (o drodze, rzece)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петлять",
                                "target_lang_sense_clarification": "делать петли, извиваться (о дороге, следах)"
                            },
                            {
                                "target_lang_word": "извиваться",
                                "target_lang_sense_clarification": "пролегать изгибами"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wić się",
                                "target_lang_sense_clarification": "biec krętą linią (o rzece, drodze)"
                            },
                            {
                                "target_lang_word": "meandrować",
                                "target_lang_sense_clarification": "biec krętymi zakolami (o rzece)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8adf0805-5672-341b-a1cd-a4ca31481815",
                    "sense_definition": "To stray; stray from one's course; err.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker began to <w>wander</w> from the main topic of the presentation.",
                            "target_lang_translations": {
                                "ru": "Докладчик начал <w>отклоняться</w> от главной темы презентации.",
                                "pl": "Mówca zaczął <w>zbaczać</w> z głównego tematu prezentacji."
                            }
                        },
                        {
                            "text": "We must not <w>wander</w> from our original principles.",
                            "target_lang_translations": {
                                "ru": "Мы не должны <w>отступать</w> от наших изначальных принципов.",
                                "pl": "Nie możemy <w>odstępować</w> od naszych pierwotnych zasad."
                            }
                        }
                    ],
                    "synonyms": [
                        "err"
                    ],
                    "common_phrases": [
                        "wander from the point",
                        "wander from the subject"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклоняться от темы, курса или принципов.",
                        "pl": "Zbaczać z kursu, odchodzić od tematu lub zasad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклоняться",
                                "target_lang_sense_clarification": "уходить в сторону от основной темы или курса"
                            },
                            {
                                "target_lang_word": "отступать",
                                "target_lang_sense_clarification": "отказываться от следования принципам"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zbaczać",
                                "target_lang_sense_clarification": "odchodzić od głównego tematu lub kierunku"
                            },
                            {
                                "target_lang_word": "odstępować",
                                "target_lang_sense_clarification": "rezygnować z przestrzegania zasad lub poglądów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1191d1-bd22-36d6-897d-6abca95ca5d9",
                    "sense_definition": "To commit adultery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was afraid that his partner might <w>wander</w> if he was away for too long.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что его партнерша может начать <w>гулять</w>, если он будет отсутствовать слишком долго.",
                                "pl": "Bał się, że jego partnerka może zacząć <w>zdradzać</w>, jeśli będzie go zbyt długo nie było."
                            }
                        },
                        {
                            "text": "She promised never to <w>wander</w> again after their reconciliation.",
                            "target_lang_translations": {
                                "ru": "После примирения она пообещала больше никогда не <w>изменять</w>.",
                                "pl": "Po ich pojednaniu obiecała, że już nigdy nie będzie <w>zdradzać</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used euphemistically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять партнеру; иметь связи на стороне.",
                        "pl": "Dopuszczać się zdrady małżeńskiej lub partnerskiej."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гулять",
                                "target_lang_sense_clarification": "разг. вести распутный образ жизни, изменять"
                            },
                            {
                                "target_lang_word": "изменять",
                                "target_lang_sense_clarification": "нарушать верность в браке или отношениях"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zdradzać",
                                "target_lang_sense_clarification": "naruszać wierność w związku"
                            },
                            {
                                "target_lang_word": "skakać w bok",
                                "target_lang_sense_clarification": "potoczne określenie na zdradę"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a3c3096-f526-3b2d-9d89-dce57ff0f5b7",
                    "sense_definition": "An act or instance of wandering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go for a <w>wander</w> around the old village.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>прогуляться</w> по старой деревне.",
                                "pl": "Postanowiliśmy wybrać się na <w>spacer</w> po starej wiosce."
                            }
                        },
                        {
                            "text": "He took a brief <w>wander</w> through the garden to clear his head.",
                            "target_lang_translations": {
                                "ru": "Он немного <w>побродил</w> по саду, чтобы проветрить голову.",
                                "pl": "Przeszedł się na chwilę po ogrodzie, żeby przewietrzyć głowę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for a wander",
                        "have a wander"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогулка или бесцельное хождение.",
                        "pl": "Akt lub czynność polegająca na spacerowaniu bez celu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогулка",
                                "target_lang_sense_clarification": "кратковременное хождение для отдыха"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wędrówka",
                                "target_lang_sense_clarification": "dłuższa piesza wycieczka"
                            },
                            {
                                "target_lang_word": "spacer",
                                "target_lang_sense_clarification": "krótkie wyjście dla przyjemności"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e62bea5-e84a-36e9-bb73-7db4d2700ea2",
                    "sense_definition": "Deviation from a correct or normal value.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer noticed a significant baseline <w>wander</w> in the signal data.",
                            "target_lang_translations": {
                                "ru": "Инженер заметил значительный <w>дрейф</w> изолинии в данных сигнала.",
                                "pl": "Inżynier zauważył znaczący <w>dryf</w> linii bazowej w danych sygnału."
                            }
                        },
                        {
                            "text": "Technical adjustments were made to correct the frequency <w>wander</w>.",
                            "target_lang_translations": {
                                "ru": "Были внесены технические корректировки для исправления <w>ухода</w> частоты.",
                                "pl": "Wprowadzono poprawki techniczne, aby skorygować <w>odchylenie</w> częstotliwości."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baseline wander"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклонение от нормы или заданного значения (технический термин).",
                        "pl": "Odchylenie od poprawnej lub normalnej wartości (termin techniczny)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрейф",
                                "target_lang_sense_clarification": "медленное смещение параметров сигнала"
                            },
                            {
                                "target_lang_word": "уход",
                                "target_lang_sense_clarification": "отклонение частоты или других величин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dryf",
                                "target_lang_sense_clarification": "powolne przesuwanie się wartości parametru"
                            },
                            {
                                "target_lang_word": "odchylenie",
                                "target_lang_sense_clarification": "różnica między wartością zmierzoną a wzorcową"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7a660c56-df6e-35bf-a80b-7e04992c43bd",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Wanders</w> is waiting for you in the lobby.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Вандерс</w> ждет вас в вестибюле.",
                                "pl": "Pan <w>Wanders</w> czeka na ciebie w lobby."
                            }
                        },
                        {
                            "text": "I have never met anyone with the last name <w>Wanders</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не встречал никого с фамилией <w>Вандерс</w>.",
                                "pl": "Nigdy wcześniej nie spotkałem nikogo o nazwisku <w>Wanders</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "pl": "Nazwisko."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вандерс",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Wanders",
                                "target_lang_sense_clarification": "transkrypcja nazwiska"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}