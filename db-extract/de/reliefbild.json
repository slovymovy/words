                "senses": [
                    {
                        "sense_id": "aee90c7c-4afd-3d8a-ac33-8c3a85318959",
                        "entry_id": "47ea25f8-7251-35f9-894b-08fb7d57d648",
                        "glosses": [
                            "als Relief ausgeführtes Bild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f47358b-f0cc-4fee-b287-7e5b7da043f5",
                                "sense_id": "aee90c7c-4afd-3d8a-ac33-8c3a85318959",
                                "text": "„Ich trat heran – und sah auf die helle Fläche eingedrückt das Reliefbild einer großen Katze. Der Abdruck war erstaunlich naturgetreu. Um den Hals des Tieres lag ein Strick.“"
                            },
                            {
                                "example_id": "53172d4b-b822-451a-9e15-833ec0b761af",
                                "sense_id": "aee90c7c-4afd-3d8a-ac33-8c3a85318959",
                                "text": "„Durch stürzendes Mauerwerk war das Opfer meiner Grausamkeit in die Masse des frisch aufgetragenen Bewurfs eingedrückt worden, und der Kalk dieses letzteren, in Verbindung mit der Brandglut und dem Ammoniak des Kadavers, hatte dann das Reliefbild so wunderbar geprägt, wie es nun zu sehen war..“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
