                                "target_senses": [
                                    {
                                        "sense_id": "099c85e3-26a0-39ce-b02c-349d6b7932c9",
                                        "entry_id": "a1b821ff-096d-3cd8-90a9-68164d96cf49",
                                        "glosses": [
                                            "Of or pertaining to a colony."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26378d34-fc30-3e50-85a3-d6800953f08f",
                                        "entry_id": "a1b821ff-096d-3cd8-90a9-68164d96cf49",
                                        "glosses": [
                                            "Of or pertaining to a period when a country or territory was a colony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea40d652-05ce-4e29-87a7-996308573b18",
                                                "sense_id": "26378d34-fc30-3e50-85a3-d6800953f08f",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
                                            },
                                            {
                                                "example_id": "ea2f80d9-3d46-4456-9bc5-3980e15ee5b9",
                                                "sense_id": "26378d34-fc30-3e50-85a3-d6800953f08f",
                                                "text": "India’s half-hour zone dates back to colonial rule of India and the era when ever-faster steamships and trains were shrinking the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "279f8563-0fd9-3637-bf5e-667caaab6c30",
                                        "entry_id": "a1b821ff-096d-3cd8-90a9-68164d96cf49",
                                        "glosses": [
                                            "Of or pertaining to the ideals of colonialism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c67100f-2f0a-3b69-aa47-ba67d7977c76",
                                        "entry_id": "a1b821ff-096d-3cd8-90a9-68164d96cf49",
                                        "glosses": [
                                            "Of or relating to the original Thirteen Colonies of the USA."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96bcc880-4e88-32a4-b386-7584cbd9026a",
                                        "entry_id": "a1b821ff-096d-3cd8-90a9-68164d96cf49",
                                        "glosses": [
                                            "Of or relating to the style of architecture prevalent at about the time of the Revolution."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d56e211-87a8-328e-92b8-889b5e8b811d",
                                        "entry_id": "a1b821ff-096d-3cd8-90a9-68164d96cf49",
                                        "glosses": [
                                            "Tending to form colonies (especially of cells)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "colonial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e286804b-316a-36ca-a493-c9b9c20b65f5",
                                        "entry_id": "bb536227-1e55-33e1-ad54-de655fe4f282",
                                        "glosses": [
                                            "A person from a country that is or was controlled by another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a66788-5695-4e42-80a1-a1f20cf55133",
                                                "sense_id": "e286804b-316a-36ca-a493-c9b9c20b65f5",
                                                "text": "None of them are, so to speak, idle men. Many of them are emigrants, not of the soil born and bred colonials."
                                            },
                                            {
                                                "example_id": "1fc6e3a6-e5b2-43cf-9839-1df974f1b9b9",
                                                "sense_id": "e286804b-316a-36ca-a493-c9b9c20b65f5",
                                                "text": "The rest of us had tea and finger sandwiches with members of the royal household, which was very elegant but hard on some of us ill-schooled colonials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37e98f4d-5a64-334a-ab75-5cdca27cf2ae",
                                        "entry_id": "bb536227-1e55-33e1-ad54-de655fe4f282",
                                        "glosses": [
                                            "A house that is built in a style reminiscent of the period of the colonization of New England."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
