{
    "word_family": [
        "birth",
        "day",
        "birthdate",
        "unbirthday"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d099b79-74ee-3fd6-89c9-0029cdb37049",
                    "sense_definition": "The anniversary of the day on which someone is born.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anniversary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I baked a chocolate cake for her <w>birthday</w>.",
                            "target_lang_translations": {
                                "ru": "Я испек шоколадный торт на её <w>день рождения</w>.",
                                "zh": "我为她的<w>生日</w>烤了一个巧克力蛋糕。"
                            }
                        },
                        {
                            "text": "We always sing happy <w>birthday</w> before eating the cake.",
                            "target_lang_translations": {
                                "ru": "Мы всегда поем «С днём <w>рождения</w>» перед тем, как есть торт.",
                                "zh": "我们在吃蛋糕前总是会唱《祝你<w>生日</w>快乐》。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "happy birthday",
                        "birthday party",
                        "birthday cake",
                        "birthday present",
                        "birthday card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Годовщина дня, в который родился человек.",
                        "zh": "一个人出生的周年纪念日。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "день рожде́ния",
                                "target_lang_sense_clarification": "основной термин"
                            },
                            {
                                "target_lang_word": "дню́ха",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生日",
                                "target_lang_sense_clarification": "通用词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "797b0d22-80d9-30d8-bf85-261a7403cae4",
                    "sense_definition": "A birthday party.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "celebration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you coming to my <w>birthday</w> this Saturday?",
                            "target_lang_translations": {
                                "ru": "Ты придешь на мой <w>день рождения</w> в эту субботу?",
                                "zh": "这周六你要来参加我的<w>生日派对</w>吗？"
                            }
                        },
                        {
                            "text": "We had a lot of fun at his <w>birthday</w> last year.",
                            "target_lang_translations": {
                                "ru": "Мы отлично повеселились на его <w>дне рождения</w> в прошлом году.",
                                "zh": "去年在他的<w>生日派对</w>上我们玩得很开心。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "invite to my birthday",
                        "at my birthday"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вечеринка или празднование в честь дня рождения.",
                        "zh": "为庆祝生日而举办的聚会或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "день рожде́ния",
                                "target_lang_sense_clarification": "праздник, вечеринка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生日派对",
                                "target_lang_sense_clarification": "指庆祝活动"
                            },
                            {
                                "target_lang_word": "生日会",
                                "target_lang_sense_clarification": "指庆祝活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0d60261-70c9-37dd-997f-37c647b1e9f0",
                    "sense_definition": "The date on which someone is born or something is created, more commonly called birthdate or date of birth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "date",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please write your full name and <w>birthday</w> on the form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, напишите свое полное имя и <w>дату рождения</w> в бланке.",
                                "zh": "请在表格上填写你的全名和<w>出生日期</w>。"
                            }
                        },
                        {
                            "text": "Do you know the exact <w>birthday</w> of the famous poet?",
                            "target_lang_translations": {
                                "ru": "Вы знаете точную <w>дату рождения</w> этого известного поэта?",
                                "zh": "你知道那位著名诗人的确切<w>出生日期</w>吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "date of birth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Календарная дата, когда кто-то родился (используется в документах).",
                        "zh": "一个人出生的具体日期，常用于正式文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да́та рожде́ния",
                                "target_lang_sense_clarification": "официально"
                            },
                            {
                                "target_lang_word": "день рожде́ния",
                                "target_lang_sense_clarification": "разговорный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出生日期",
                                "target_lang_sense_clarification": "正式用法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2803021-14e0-3250-b153-2bc14f08ca7d",
                    "sense_definition": "The anniversary of the day on which something is created.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anniversary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city celebrated its three hundredth <w>birthday</w> with fireworks.",
                            "target_lang_translations": {
                                "ru": "Город отпраздновал свой трехсотый <w>день рождения</w> фейерверком.",
                                "zh": "这座城市用烟花庆祝了它三百周年的<w>成立纪念日</w>。"
                            }
                        },
                        {
                            "text": "Our local library is celebrating its tenth <w>birthday</w> next month.",
                            "target_lang_translations": {
                                "ru": "Наша местная библиотека отмечает свой десятый <w>день рождения</w> в следующем месяце.",
                                "zh": "我们当地的图书馆下个月将庆祝它十周年的<w>成立纪念日</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "company birthday",
                        "official birthday"
                    ],
                    "target_lang_definitions": {
                        "ru": "Годовщина основания или создания чего-либо (города, компании).",
                        "zh": "某事物（如城市、公司）成立或创建的周年纪念日。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "день рожде́ния",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "годовщи́на",
                                "target_lang_sense_clarification": "юбилей основания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "周年纪念日",
                                "target_lang_sense_clarification": "指成立周年"
                            },
                            {
                                "target_lang_word": "成立纪念日",
                                "target_lang_sense_clarification": "指成立周年"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48663d98-51ae-3a26-b104-b3be9012b297",
                    "sense_definition": "To celebrate one's birthday.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are <w>birthdaying</w> in Las Vegas this year.",
                            "target_lang_translations": {
                                "ru": "В этом году они <w>отмечают день рождения</w> в Лас-Вегасе.",
                                "zh": "他们今年去拉斯维加斯<w>过生日</w>。"
                            }
                        },
                        {
                            "text": "She <w>birthdayed</w> quietly at home with her family.",
                            "target_lang_translations": {
                                "ru": "Она тихо <w>отметила день рождения</w> дома с семьей.",
                                "zh": "她和家人在家里安静地<w>过生日</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Verbing the noun 'birthday' is informal."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Праздновать свой день рождения.",
                        "zh": "庆祝某人的生日。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмеча́ть день рожде́ния",
                                "target_lang_sense_clarification": "глагольная фраза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过生日",
                                "target_lang_sense_clarification": "动词短语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
