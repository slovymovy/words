                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5ce7017-98ce-44a2-9430-10451fd3db22",
                        "source_entry_id": "d23f047a-59fb-3e00-9e6a-3771e7dfdddd",
                        "source_sense_id": "6bc86694-2cf6-395e-8524-e77a29364014",
                        "target_lang_word": "Konstantinopel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konstantinopel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2995a0e6-3051-3271-b3ca-ff12a9a126ce",
                                        "entry_id": "35903b80-4885-3162-b73a-48d2edbc6cb1",
                                        "glosses": [
                                            "ehemals bedeutende Stadt am Bosporus, Hauptstadt des Oströmischen Reichs. Heute Istanbul"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3fa873e-bd06-4779-9a85-11bfc1786bdb",
                                                "sense_id": "2995a0e6-3051-3271-b3ca-ff12a9a126ce",
                                                "text": "Konstantinopel war tausend Jahre Hauptstadt der Christenheit."
                                            },
                                            {
                                                "example_id": "99e967f6-d058-403d-9307-f13ea1769b1e",
                                                "sense_id": "2995a0e6-3051-3271-b3ca-ff12a9a126ce",
                                                "text": "„Die christlich gewordene Herrscherdynastie war dem Osten des Reiches stark verhaftet. Konstantinopel wurde ihr christlich geprägtes Symbol.“"
                                            },
                                            {
                                                "example_id": "96034d45-324d-4aaa-babb-b5ca584a3b98",
                                                "sense_id": "2995a0e6-3051-3271-b3ca-ff12a9a126ce",
                                                "text": "„Die Nordmänner erkunden mit ihnen die Ströme des heutigen Russland und der Ukraine, befahren das Schwarze Meer und laden in Konstantinopel Schätze an Bord.“"
                                            },
                                            {
                                                "example_id": "d66d43ef-5f81-49e9-9e97-fcbed7bd75cc",
                                                "sense_id": "2995a0e6-3051-3271-b3ca-ff12a9a126ce",
                                                "text": "„Ein anderer großer Strom, der Dnjepr, verbindet Russland zudem mit dem Schwarzen Meer - an dessen Gestaden Konstantinopel liegt, die Kapitale des reichen byzantinischen Imperiums.“"
                                            },
                                            {
                                                "example_id": "818126b8-aacb-4b32-9a35-c0ca67b70f24",
                                                "sense_id": "2995a0e6-3051-3271-b3ca-ff12a9a126ce",
                                                "text": "„Sie sagte mir lächelnd, wenn ich nach Konstantinopel ginge, könne es sehr leicht geschehen, daß sie mich nie mehr sehen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
