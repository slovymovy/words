                "senses": [
                    {
                        "sense_id": "f10c9c1d-68af-34d8-935c-af99b7f71565",
                        "entry_id": "ee149a46-07fa-3a6a-80d8-9b6794ae2855",
                        "glosses": [
                            "The state of being heathen."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "eb94d10d-8282-460d-a2ae-39641a3a99d6",
                                "sense_id": "f10c9c1d-68af-34d8-935c-af99b7f71565",
                                "text": "The priest argued to the king that unless clerics accompanied the colony ship, the colony would soon descend into heathendom and barbarity."
                            }
                        ]
                    },
                    {
                        "sense_id": "8aaca7c4-1045-3012-ab5b-0f3bba4d7c40",
                        "entry_id": "ee149a46-07fa-3a6a-80d8-9b6794ae2855",
                        "glosses": [
                            "From one religion's or creed's perspective, the rest of the world that does not follow that creed or religion."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "67cbbcd9-d309-4560-8e92-bb34629e07b3",
                                "sense_id": "8aaca7c4-1045-3012-ab5b-0f3bba4d7c40",
                                "text": "My aunt considered all of Europe to be heathendom, and refused to visit us in Amsterdam on religious grounds."
                            }
                        ]
                    },
                    {
                        "sense_id": "044991de-aaa2-3597-a3dd-426d38973a88",
                        "entry_id": "ee149a46-07fa-3a6a-80d8-9b6794ae2855",
                        "glosses": [
                            "Specifically, the non-Christian world; territories where Christianity is not the dominant religion."
                        ],
                        "tags": [
                            "dated",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "6a321eb3-fdcc-4712-bd8e-033d83e98537",
                                "sense_id": "044991de-aaa2-3597-a3dd-426d38973a88",
                                "text": "The Crusaders meant to wrest Jerusalem from heathendom, but they managed to pillage a number of lands in Christendom along the way."
                            }
                        ]
                    },
                    {
                        "sense_id": "b003215c-79b0-3316-8cb8-8d18b7cedc25",
                        "entry_id": "ee149a46-07fa-3a6a-80d8-9b6794ae2855",
                        "glosses": [
                            "The collection of people who follow Heathenry, a modern pagan faith inspired by the pre-Abrahamic religions of Germanic tribes, Anglo-Saxons and Norse peoples."
                        ],
                        "tags": [
                            "Germanic",
                            "capitalized",
                            "sometimes",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c4525fa1-a744-4736-b32f-45344bd94739",
                                "sense_id": "b003215c-79b0-3316-8cb8-8d18b7cedc25",
                                "text": "Ziegenbalg mentioned some major forms of heathendom (African, American, old European)[…]"
                            }
                        ]
                    }
                ],
