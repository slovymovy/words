                        "glosses": [
                            "Dispositif, appareil, matériel servant à élever des vers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b484a30-d8c6-4854-a255-2ca060e56bb4",
                                "sense_id": "24f9286b-b1b6-3119-b51e-fe8d722ccb91",
                                "text": "Au-devant de ce poulailler doivent être placés quelques mûriers, nue petite fontaine, un espace où les poules puissent gratter et pulvériser la terre, et une vermillière qui doit former leur aliment principal."
                            },
                            {
                                "example_id": "4c3880a9-1af7-49d1-8af5-163f0b121f64",
                                "sense_id": "24f9286b-b1b6-3119-b51e-fe8d722ccb91",
                                "text": "On a soin pour peupler la vermillière d'y mettre pour commencer un ou deux litres de beaux vers rouges récoltés dans le terreau."
                            },
                            {
                                "example_id": "8a58572d-e1fe-43a6-80f1-a34bdc64284a",
                                "sense_id": "24f9286b-b1b6-3119-b51e-fe8d722ccb91",
                                "text": "M. le comte Delamarre cite le procédé des vermillières que l'on obtient en, disposant des déchets de viande en stratification avec des feuilles."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef631fb8-9384-3853-a615-86d13a77626d",
                        "entry_id": "b192da6b-47bf-3d62-a6d6-2e000baf6dc0",
                        "glosses": [
                            "Champ où est cultivée la graine de vermeil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9b56d62-17c9-4182-80eb-a8afcb5ab5f2",
                                "sense_id": "ef631fb8-9384-3853-a615-86d13a77626d",
                                "text": "Défense d'introduire des troupeaux dans les vermillières."
                            },
                            {
                                "example_id": "ff14b422-24f8-49d9-9d7d-512944c7fd27",
                                "sense_id": "ef631fb8-9384-3853-a615-86d13a77626d",
                                "text": "Ainsi des dommages portés à une vermillière n'ont pas été indemnisés au motif qu'il ne s'agissait pas d'une récolte."
                            }
                        ]
