                                "target_senses": [
                                    {
                                        "sense_id": "3f1f168c-fcca-3fc7-b56e-34841306946b",
                                        "entry_id": "176cdc0a-d875-363e-afc3-500e7c29dec5",
                                        "glosses": [
                                            "Operation an einem lebenden Tier zu Versuchszwecken, früher auch an lebenden Menschen (an Gefangenen sowie in Konzentrationslagern)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fef75c6-b48c-4bd7-bb33-4b2a452c7d53",
                                                "sense_id": "3f1f168c-fcca-3fc7-b56e-34841306946b",
                                                "text": "Die Ärzte Alexandrias sahen – geprägt durch aristotelisches Gedankengut – in der Vivisektion den einzigen Weg zur Erkenntnis."
                                            },
                                            {
                                                "example_id": "1fa89fc3-1d86-421d-a2f3-8c2976c21025",
                                                "sense_id": "3f1f168c-fcca-3fc7-b56e-34841306946b",
                                                "text": "Seit 30 Jahren kämpfen wir gegen die Vivisektion, den Handel von Versuchstieren und gegen schädliche Arzneimittel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22c5eda7-0214-46ae-8343-85463c2c8f2c",
                        "source_entry_id": "d2683342-60fd-3daa-8053-7b9c542936b1",
