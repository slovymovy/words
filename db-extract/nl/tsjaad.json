                                                "sense_id": "62f77399-a5f0-3ebd-9f63-56786ac0fb92",
                                                "text": "„Der Tschad schließt den östlichen Teil des Tschadbeckens mit dem größten Teil des Tschadsees ein.“"
                                            },
                                            {
                                                "example_id": "306f1941-c239-425e-8d5e-d25f492b1570",
                                                "sense_id": "62f77399-a5f0-3ebd-9f63-56786ac0fb92",
                                                "text": "Im Tschad wohnen über 7 Millionen Menschen."
                                            },
