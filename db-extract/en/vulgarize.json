                "senses": [
                    {
                        "sense_id": "58930e42-f668-3481-8992-5460d766eb7b",
                        "entry_id": "39e8c826-00ed-3eae-9ca9-c4fdc6ce0fef",
                        "glosses": [
                            "To make vulgar.",
                            "To make commonplace, crass, lewd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a94cd545-a3e5-445b-8b79-4dc180a9ee17",
                                "sense_id": "58930e42-f668-3481-8992-5460d766eb7b",
                                "text": "With much labor we got our things up the steps, and then, looking back, took one last long survey of that strange land, soon I fear to be vulgarized, the prey of hunter and prospector, but to each of us a dreamland of glamour and romance, a land where we had dared much, suffered much, and learned much - our land, as we shall ever fondly call it."
                            },
                            {
                                "example_id": "74f34659-c83f-4693-a4cd-f815e81cefea",
                                "sense_id": "58930e42-f668-3481-8992-5460d766eb7b",
                                "text": "\"Yes,\" said Mr. Flushing. \"And in my opinion,\" he continued, \"the absence of population to which Hirst objects is precisely the significant touch. You must admit, Hirst, that a little Italian town even would vulgarise the whole scene, would detract from the vastness — the sense of elemental grandeur.\""
                            },
                            {
                                "example_id": "9b4a96a3-0000-4380-9501-5f63c5767c12",
                                "sense_id": "58930e42-f668-3481-8992-5460d766eb7b",
                                "text": "Words only vulgarize love and blunt its edge."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa0922f2-76cf-394c-887c-e3d2c8253c38",
                        "entry_id": "39e8c826-00ed-3eae-9ca9-c4fdc6ce0fef",
                        "glosses": [
                            "To make vulgar.",
                            "To convert (religious rites) so as to use the vulgate (language of the commoners)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
