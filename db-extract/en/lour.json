                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c49b681a-5285-388f-b61c-e474ccb1a72d",
                                        "entry_id": "47e58532-c90d-3463-a3d5-ce5ac2d4fcd3",
                                        "glosses": [
                                            "stahy mimického svalstva, zejména vraštěním obočí, vyjadřovat nelibost nebo špatnou náladu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6040a504-8ef0-4cb1-9f5b-aac9ec94587f",
                                                "sense_id": "c49b681a-5285-388f-b61c-e474ccb1a72d",
                                                "text": "Sovička mrzutá sedí a nedutá, jen se mračí; květy ji neblaží, slunce jí překáží, i zpěv ptačí."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "927dfbe5-4eeb-36ed-a1dc-2be3f62e0b8d",
                                        "entry_id": "47e58532-c90d-3463-a3d5-ce5ac2d4fcd3",
                                        "glosses": [
                                            "začínat být pokrytý tmavými oblaky"
                                        ],
                                        "tags": [
                                            "o obloze"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2317a27b-3ada-4ad1-9abd-6d5268466d5b",
                                                "sense_id": "927dfbe5-4eeb-36ed-a1dc-2be3f62e0b8d",
                                                "text": "V sobotu bude sice ještě tepleji, ale od jihozápadu se začne obloha mračit a na jihu místy zaprší."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
