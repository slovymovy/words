                        "glosses": [
                            "Aufzeichnungsgerät, Messinstrument zur Beurteilung der Leistung/Leistungsfähigkeit von Muskeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e90a53e-9a79-4be2-8204-4f5ca126cf63",
                                "sense_id": "befd179d-3ca2-3edf-8a98-f8757a569d54",
                                "text": "Die Arbeitsleistung der Muskeln des Langstreckenläufers wurde von dem Ergografen in der Sportmedizinischen Hochschule fein säuberlich aufgezeichnet."
                            },
                            {
                                "example_id": "4ed8212b-ee46-474c-a023-69256b18dc6b",
                                "sense_id": "befd179d-3ca2-3edf-8a98-f8757a569d54",
                                "text": "Mittels eines Ergografen erfolgt die Messung und die Aufzeichnung der körperlichen Leistungsfähigkeit anhand des Leistungsnachlassens bei Ermüdung oder anhand der Muskelkraft an Einzelmuskeln oder Muskelgruppen."
                            }
