{
    "word_family": [
        "unwounded",
        "wounding",
        "rewind",
        "unwind"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a03bf2f1-6268-34dc-87a9-f868f0cf81fe",
                    "sense_definition": "An injury, such as a cut, stab, or tear, to a part of the body.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor cleaned the deep <w>wound</w> on his arm to prevent infection.",
                            "target_lang_translations": {
                                "ru": "Врач промыл глубокую <w>ра́ну</w> на его руке, чтобы предотвратить инфекцию.",
                                "es": "El médico limpió la <w>herida</w> profunda en su brazo para prevenir una infección.",
                                "zh": "医生清理了他手臂上深可见骨的<w>伤口</w>以防止感染。"
                            }
                        },
                        {
                            "text": "He was lucky to escape the accident with only a minor flesh <w>wound</w>.",
                            "target_lang_translations": {
                                "ru": "Ему повезло, и он отделался в аварии лишь лёгкой поверхностной <w>ра́ной</w>.",
                                "es": "Tuvo suerte de salir del accidente solo con una <w>herida</w> superficial.",
                                "zh": "他很幸运，在事故中只受了点皮肉<w>伤</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "injury",
                        "lesion",
                        "cut",
                        "gash"
                    ],
                    "common_phrases": [
                        "flesh wound",
                        "stab wound",
                        "gunshot wound",
                        "open wound",
                        "deep wound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Телесное повреждение, такое как порез, укол или разрыв тканей.",
                        "es": "Daño físico, como un corte, una puñalada o un desgarro, en una parte del cuerpo.",
                        "zh": "身体部位受到的伤害，如割伤、刺伤或撕裂伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ра́на",
                                "target_lang_sense_clarification": "физическое повреждение"
                            },
                            {
                                "target_lang_word": "ране́ние",
                                "target_lang_sense_clarification": "процесс или результат повреждения"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "herida",
                                "target_lang_sense_clarification": "daño físico en el cuerpo"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伤口",
                                "target_lang_sense_clarification": "身体上的物理损伤"
                            },
                            {
                                "target_lang_word": "创伤",
                                "target_lang_sense_clarification": "较严重的身体损伤"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8b15a7b-cec7-3a65-bc94-86f0b9e7d4ec",
                    "sense_definition": "A hurt to a person's feelings, reputation, or pride.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_hurt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took a long time to recover from the <w>wound</w> of her betrayal.",
                            "target_lang_translations": {
                                "ru": "Потребовалось много времени, чтобы оправиться от <w>ра́ны</w>, нанесённой её предательством.",
                                "es": "Tomó mucho tiempo recuperarse de la <w>herida</w> de su traición.",
                                "zh": "他花了很长时间才从她背叛所带来的<w>创伤</w>中恢复过来。"
                            }
                        },
                        {
                            "text": "The criticism inflicted a deep <w>wound</w> on his ego.",
                            "target_lang_translations": {
                                "ru": "Критика нанесла глубокую <w>ра́ну</w> его самолюбию.",
                                "es": "La crítica infligió una profunda <w>herida</w> a su ego.",
                                "zh": "那番批评深深地<w>伤害</w>了他的自尊心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "insult",
                        "slight",
                        "blow",
                        "offense"
                    ],
                    "common_phrases": [
                        "old wounds",
                        "salt in the wound",
                        "heal old wounds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Боль, причинённая чувствам, репутации или самолюбию.",
                        "es": "Dolor causado a los sentimientos, la reputación o el orgullo de una persona.",
                        "zh": "对一个人的感情、名誉或自尊心造成的伤害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ра́на",
                                "target_lang_sense_clarification": "душевная боль"
                            },
                            {
                                "target_lang_word": "тра́вма",
                                "target_lang_sense_clarification": "психологическое потрясение"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "herida",
                                "target_lang_sense_clarification": "daño moral u ofensa"
                            },
                            {
                                "target_lang_word": "trauma",
                                "target_lang_sense_clarification": "impacto psicológico negativo"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创伤",
                                "target_lang_sense_clarification": "心理或情感上的伤害"
                            },
                            {
                                "target_lang_word": "伤害",
                                "target_lang_sense_clarification": "对感情或自尊的打击"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc3c66bf-69c0-35e7-947e-9b9c5e99a2ba",
                    "sense_definition": "The simple past and past participle of <w>wind</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>wound</w> the wool into a tight ball before knitting.",
                            "target_lang_translations": {
                                "ru": "Она <w>смота́ла</w> шерсть в тугой клубок перед вязанием.",
                                "es": "Ella <w>enrolló</w> la lana en una bola apretada antes de tejer.",
                                "zh": "织毛衣前，她把毛线<w>缠</w>成了一个紧实的球。"
                            }
                        },
                        {
                            "text": "The long path <w>wound</w> its way through the dark forest.",
                            "target_lang_translations": {
                                "ru": "Длинная тропа <w>извива́лась</w> через тёмный лес.",
                                "es": "El largo camino <w>serpenteaba</w> a través del bosque oscuro.",
                                "zh": "那条长长的小路在黑暗的森林中<w>蜿蜒</w>穿过。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wound up",
                        "wound down",
                        "wound around"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle of wind"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола wind.",
                        "es": "Pasado simple y participio pasado del verbo 'wind' (enrollar o serpentear).",
                        "zh": "动词 wind 的过去式和过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нама́тывать",
                                "target_lang_sense_clarification": "прошедшее время"
                            },
                            {
                                "target_lang_word": "извива́ться",
                                "target_lang_sense_clarification": "прошедшее время"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "enrolló",
                                "target_lang_sense_clarification": "pasado de enrollar"
                            },
                            {
                                "target_lang_word": "serpenteó",
                                "target_lang_sense_clarification": "pasado de serpentear"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缠绕",
                                "target_lang_sense_clarification": "指卷绕动作的过去式"
                            },
                            {
                                "target_lang_word": "蜿蜒",
                                "target_lang_sense_clarification": "指路径曲折延伸的过去式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eae432b0-a726-327e-9143-146412c6be69",
                    "sense_definition": "To hurt or injure someone by cutting, piercing, or tearing the skin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier was seriously <w>wounded</w> during the fierce battle.",
                            "target_lang_translations": {
                                "ru": "Солдат был тяжело <w>ра́нен</w> во время ожесточённого сражения.",
                                "es": "El soldado fue gravemente <w>herido</w> durante la feroz batalla.",
                                "zh": "那名士兵在激烈的战斗中受了重<w>伤</w>。"
                            }
                        },
                        {
                            "text": "The hunter accidentally <w>wounded</w> the deer but did not kill it.",
                            "target_lang_translations": {
                                "ru": "Охотник случайно <w>ра́нил</w> оленя, но не убил его.",
                                "es": "El cazador <w>hirió</w> accidentalmente al ciervo pero no lo mató.",
                                "zh": "猎人不小心<w>伤</w>到了那头鹿，但没把它打死。"
                            }
                        }
                    ],
                    "synonyms": [
                        "injure",
                        "hurt",
                        "lacerate",
                        "harm"
                    ],
                    "antonyms": [
                        "heal",
                        "cure"
                    ],
                    "common_phrases": [
                        "fatally wounded",
                        "seriously wounded",
                        "badly wounded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить физическую травму или увечье, разрезая или протыкая кожу.",
                        "es": "Causar daño físico a alguien cortando, perforando o desgarrando la piel.",
                        "zh": "通过切割、刺穿或撕裂皮肤来伤害某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ра́нить",
                                "target_lang_sense_clarification": "наносить рану"
                            },
                            {
                                "target_lang_word": "пора́нить",
                                "target_lang_sense_clarification": "нанести неглубокую рану"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "herir",
                                "target_lang_sense_clarification": "causar una lesión física"
                            },
                            {
                                "target_lang_word": "lesionar",
                                "target_lang_sense_clarification": "causar un daño o detrimento"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受伤",
                                "target_lang_sense_clarification": "遭受身体伤害"
                            },
                            {
                                "target_lang_word": "伤害",
                                "target_lang_sense_clarification": "造成身体上的创伤"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51b3e5cb-84a6-3bdf-b9a5-eedafb3939c1",
                    "sense_definition": "To hurt a person's feelings or pride.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_hurt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His harsh comments deeply <w>wounded</w> her pride.",
                            "target_lang_translations": {
                                "ru": "Его резкие комментарии глубоко <w>ра́нили</w> её гордость.",
                                "es": "Sus comentarios duros <w>hirieron</w> profundamente su orgullo.",
                                "zh": "他尖刻的评论深深地<w>刺伤</w>了她的自尊。"
                            }
                        },
                        {
                            "text": "She felt <w>wounded</w> by the rejection from her friends.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя <w>уязвлённой</w> отказом друзей.",
                                "es": "Ella se sintió <w>herida</w> por el rechazo de sus amigos.",
                                "zh": "朋友们的拒绝让她感到深受<w>伤害</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "offend",
                        "hurt",
                        "insult",
                        "grieve"
                    ],
                    "antonyms": [
                        "comfort",
                        "soothe"
                    ],
                    "common_phrases": [
                        "wounded pride",
                        "deeply wounded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять боль чувствам или гордости человека.",
                        "es": "Causar dolor a los sentimientos o al orgullo de una persona.",
                        "zh": "伤害某人的感情或自尊心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ра́нить",
                                "target_lang_sense_clarification": "причинять душевную боль"
                            },
                            {
                                "target_lang_word": "уязвля́ть",
                                "target_lang_sense_clarification": "задевать самолюбие"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "herir",
                                "target_lang_sense_clarification": "causar daño moral"
                            },
                            {
