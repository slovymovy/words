                        "glosses": [
                            "Tisch mit schräger Fläche zum Ablegen liturgischer Bücher, die zum Vorlesen dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34776a52-475d-419b-a511-4311a9c9f781",
                                "sense_id": "24d26215-cdde-3b32-94f7-621881542aa7",
                                "text": "„Aufrecht vor dem Chorpult stehend, psalmodiert er Bibelsprüche.“"
                            },
                            {
                                "example_id": "d799f34a-09d2-4b95-ad5c-e17e8c69b980",
                                "sense_id": "24d26215-cdde-3b32-94f7-621881542aa7",
                                "text": "„Unterdessen hatten die Kirchendiener ihren Ornat angelegt, und der Geistliche und der Diakon begaben sich zu dem Chorpult, das im Kirchenschiff stand.“"
                            }
