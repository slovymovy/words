                                        "examples": [
                                            {
                                                "example_id": "5589f333-2a8a-4a15-a913-3ec8a1dedf92",
                                                "sense_id": "e382f428-7e32-32ce-8b54-8e3dde926617",
                                                "text": "En Égypte, la beauté dans l’ornementation des livres fut réservée aux corans."
                                            },
                                            {
                                                "example_id": "6b494204-0eea-4cc8-a019-a28a58fd311f",
                                                "sense_id": "e382f428-7e32-32ce-8b54-8e3dde926617",
                                                "text": "Sur le seuil de sa hutte, Hassan a tendu un coran que nous avons tous embrassé avant de passer dessous."
                                            }
                                        ]
