                        "sense_id": "6d8ae08f-2a98-37d1-b237-5cc9a4b697d1",
                        "entry_id": "28fcee23-0118-3685-b355-05949bdb8d63",
                        "glosses": [
                            "действие по значению гл. напухать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "248f9d14-7220-457d-a168-0ece6b0b2a6d",
                                "sense_id": "6d8ae08f-2a98-37d1-b237-5cc9a4b697d1",
                                "text": "Нам сделали прививки, несмотря на недавнее повышение температуры и напухание лимфатических узлов."
                            }
                        ]
                    },
                    {
                        "sense_id": "857f3f83-fd99-3d12-b0a1-77ea39340c49",
                        "entry_id": "28fcee23-0118-3685-b355-05949bdb8d63",
                        "glosses": [
                            "результат такого действия, припухлость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc1c507-66a7-4c16-81bd-5ba396939774",
                                "sense_id": "857f3f83-fd99-3d12-b0a1-77ea39340c49",
                                "text": "Многие люди находят такой способ удивительно эффективным для уменьшения напухания и раздражения."
                            }
                        ]
                    }
                ],
