                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d7d838b-749e-3bb2-96d5-30f9ca5a7e27",
                                        "entry_id": "0cae1e68-476b-3ede-82fe-f00961e6bc4d",
                                        "glosses": [
                                            "Alternative spelling of semi-automatic."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b91d2a3-130b-4552-87da-512bfd0b49d1",
                                                "sense_id": "8d7d838b-749e-3bb2-96d5-30f9ca5a7e27",
                                                "text": "The measure would make California the first state to require that all new semiautomatic weapons be equipped with technology known as microstamping, which imprints microscopic markings as a gun fires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "semiautomatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc75cc2-1bde-3819-9f97-49172b20ee91",
                                        "entry_id": "3d9320f6-ce58-3c25-800e-0b857ada3af4",
                                        "glosses": [
                                            "Alternative spelling of semi-automatic."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8519c66-e8f3-42db-a83a-b572106c782d",
                                                "sense_id": "7bc75cc2-1bde-3819-9f97-49172b20ee91",
                                                "text": "Experts say that there is no clear link between semiautomatics and the number of shootings by the police, and that officers are likely to get higher-powered weapons rather than go back to traditional handguns."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe5198bd-cc6a-4372-90d2-edff6146a287",
