                        "sense_id": "4850b6ee-06b6-3cc3-adf9-620c76f6f375",
                        "entry_id": "01bdca21-afc7-3144-b766-37c6a55027e5",
                        "glosses": [
                            "Silbengipfel, Silbenkern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667fde59-8073-4ecc-913f-dd4ee9b8df58",
                                "sense_id": "4850b6ee-06b6-3cc3-adf9-620c76f6f375",
                                "text": "Vokale und Sonanten können den Nukleus bilden."
                            },
                            {
                                "example_id": "c5b64e26-a0ce-47c0-ace1-8fdf7c64dc3c",
                                "sense_id": "4850b6ee-06b6-3cc3-adf9-620c76f6f375",
                                "text": "„Die Silbenstruktur scheint folglich als eigene Einheit im mentalen Lexikon repräsentiert, wobei Versprecherstudien zeigen, dass der Silbenonset mit dem Silbenreim nicht so fest verbunden ist wie Nukleus und Coda untereinander (…).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
