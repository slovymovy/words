                                        "sense_id": "bbade666-493c-3db4-bea7-8ad036ab6ccb",
                                        "entry_id": "2a456c90-06e3-3798-9495-a904843c8b64",
                                        "glosses": [
                                            "czynienie czegoś aktualnym, uwspółcześnienie, modernizacja"
