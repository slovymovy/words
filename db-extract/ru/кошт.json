                "senses": [
                    {
                        "sense_id": "e34ad252-343c-3d60-96bf-d3e627fad57a",
                        "entry_id": "0e18aa28-f07e-331d-bdac-2afcefd364e9",
                        "glosses": [
                            "устар. расходы на содержание, пропитание, иждивение; средства на жизнь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c1e14f2-c1bc-4b90-a8af-256a1a0eea3e",
                                "sense_id": "e34ad252-343c-3d60-96bf-d3e627fad57a",
                                "text": "А коли тебе пришла такая охота, снаряжай поход своим коштом, зови охочих людей, а я мешать не стану."
                            },
                            {
                                "example_id": "e2b30c4b-052a-4528-b515-232583f99da8",
                                "sense_id": "e34ad252-343c-3d60-96bf-d3e627fad57a",
                                "text": "Прошение осталось без последствий: на казённый кошт было немало претендентов из обедневших дворянских семей."
                            }
                        ]
                    }
