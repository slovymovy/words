                "senses": [
                    {
                        "sense_id": "f0c7cc59-fc36-3721-891a-db747dfa8fcd",
                        "entry_id": "0b684b24-c0f7-3dd2-86cb-a49262d6ac52",
                        "glosses": [
                            "Schienenfahrzeug mit Eigenantrieb"
                        ],
                        "tags": [
                            "Eisenbahnwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "35cdd69c-a6a6-4428-bd8c-e3dcd785860a",
                                "sense_id": "f0c7cc59-fc36-3721-891a-db747dfa8fcd",
                                "text": "„Die letzte Pferdebahn hatte damit ihren Dienst quittiert, aber 24 Fahrzeuge fanden noch als Anhänger eine weitere Verwendung, zusammen mit den neu beschafften 27 Triebwagen.“"
                            },
                            {
                                "example_id": "ff271ad1-6be3-40bb-a6d6-e03aa20e0d92",
                                "sense_id": "f0c7cc59-fc36-3721-891a-db747dfa8fcd",
                                "text": "„Eben stieg Frau Amtsgerichtsrat Warkentin schwerfällig in den Triebwagen der Linie 11.“"
                            },
                            {
                                "example_id": "3556e39f-0c76-4b3d-94aa-08667fbcdd07",
                                "sense_id": "f0c7cc59-fc36-3721-891a-db747dfa8fcd",
                                "text": "„Krönung der Raserei war ein Triebwagen, der Fliegende Hamburger genannt, blau-elfenbeinern und, so schien es Roman, mit der Geschwindigkeit einer Kanonenkugel unterwegs.“"
                            },
                            {
                                "example_id": "4e4dbaf3-935f-4c9e-ba26-508af951a398",
                                "sense_id": "f0c7cc59-fc36-3721-891a-db747dfa8fcd",
                                "text": "„In Sande mußten wir auf den Triebwagen warten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
