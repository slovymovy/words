                                            {
                                                "example_id": "75147902-7ae6-470a-bbbb-d2ff6e01935d",
                                                "sense_id": "cf281811-b4a1-355f-bff0-13405302e867",
                                                "text": "„Sie nahm zweitausend Zechinen, ihre Diamanten und ihre Schmuckstücke mit der Absicht an sich, sie zu verkaufen, um sich eine Leibrente zu schaffen; mir übergab sie die Spielkasse, an der wir je zur Hälfte beteiligt waren.“"
                                            },
                                            {
                                                "example_id": "15cb10c5-a5ca-4c33-a247-ecaae005f5f5",
                                                "sense_id": "cf281811-b4a1-355f-bff0-13405302e867",
                                                "text": "„Er will es seinen Vermietern abkaufen, auf Leibrente, die entsprechenden Verträge sind vorbereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
