                            {
                                "example_id": "cd4c58ec-0e01-4497-83e2-6e653e36e38d",
                                "sense_id": "46d7eee9-1eb4-3731-bad0-c80e81b18833",
                                "text": "Dat werd met karrenvrachten tegelijk aangevoerd en dat gaf problemen bij de verwerking ervan."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4876e6c-50c0-37c4-9b15-a2f347efbe7b",
                        "entry_id": "3d723653-0fc5-3848-92ee-4ea9f2fd5b8c",
