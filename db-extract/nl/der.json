                "translations": [
                    {
                        "translation_id": "3ffd95dc-141a-4a25-b64c-9336de651dd1",
                        "source_entry_id": "b5a147e6-db48-3507-9e64-2af007293ee0",
                        "source_sense_id": "151b0a80-b49a-3150-99be-c91516d7b471",
                        "source_sense_description": "genitief meervoud van het bepaalde lidwoord de, het",
                        "target_lang_word": "der",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "der",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6122471a-a05d-3cdb-9bf3-d7c56f94f656",
                                        "entry_id": "729b6570-57e9-3514-8210-d3bdf3ee0e1e",
                                        "glosses": [
                                            "definiter Artikel (bestimmtes Geschlechtswort)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed9157a-bf95-4504-8ecf-6695a00e4314",
                                                "sense_id": "6122471a-a05d-3cdb-9bf3-d7c56f94f656",
                                                "text": "Der Mann ist hübsch."
                                            },
                                            {
                                                "example_id": "ee855c68-7b52-4551-a334-9fb6d9e4937d",
                                                "sense_id": "6122471a-a05d-3cdb-9bf3-d7c56f94f656",
                                                "text": "Die Frau hält das Kind an der Hand."
                                            },
                                            {
                                                "example_id": "61bc3859-db1e-42a0-9e79-9fa94b66435f",
                                                "sense_id": "6122471a-a05d-3cdb-9bf3-d7c56f94f656",
                                                "text": "Das Essen hat heute sehr lecker geschmeckt."
                                            },
                                            {
                                                "example_id": "83dc9634-a253-450f-be2a-e9ba0cf1e762",
                                                "sense_id": "6122471a-a05d-3cdb-9bf3-d7c56f94f656",
                                                "text": "Wir fuhren mit dem Auto durch die Stadt."
                                            },
                                            {
                                                "example_id": "87a973ac-0718-4bed-87c7-064330b1ae29",
                                                "sense_id": "6122471a-a05d-3cdb-9bf3-d7c56f94f656",
                                                "text": "Er entledigte sich der Mitwisserin."
                                            },
                                            {
                                                "example_id": "682afbb2-c16e-4715-b66e-ec7e6a845dfb",
                                                "sense_id": "6122471a-a05d-3cdb-9bf3-d7c56f94f656",
                                                "text": "Sie entledigte sich der Mitwisser."
                                            },
                                            {
                                                "example_id": "0dd2c05b-0a72-4d5d-8bab-b1483d09e30a",
                                                "sense_id": "6122471a-a05d-3cdb-9bf3-d7c56f94f656",
                                                "text": "Es tut der Frau im Herzen weh, dass der Ring gestohlen wurde."
                                            },
                                            {
                                                "example_id": "b09d3a0e-a3c4-4c8a-833c-1d4008aa100b",
                                                "sense_id": "6122471a-a05d-3cdb-9bf3-d7c56f94f656",
                                                "text": "„Und der wilde Knabe brach / ’s Röslein auf der Heiden;“ (Johann Wolfgang von Goethe, Heidenröslein)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "der",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68e901e0-4590-34fa-82e2-017e26d93b37",
