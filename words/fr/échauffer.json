                    "frequency": "Low",
                    "semantic_group_id": "agitation_colere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prends le temps de respirer avant de t'<w>échauffer</w> pour un simple désaccord sans importance."
