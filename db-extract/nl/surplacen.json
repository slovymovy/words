                "senses": [
                    {
                        "sense_id": "cb67ed5f-f85a-3868-9779-d33306c7df3e",
                        "entry_id": "515c2d52-aa5c-3412-a4ea-974d55b15179",
                        "glosses": [
                            "zich in evenwicht houden op een stilstaande fiets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "591d51c5-4733-400f-b9c3-dc8be8cba1b9",
                                "sense_id": "cb67ed5f-f85a-3868-9779-d33306c7df3e",
                                "text": "Om te surplacen heb je een goed evenwicht nodig... of zijwieltjes!"
                            }
                        ]
                    },
                    {
                        "sense_id": "6013cee4-fca5-3a91-8ac3-829b290a7caa",
                        "entry_id": "515c2d52-aa5c-3412-a4ea-974d55b15179",
                        "glosses": [
                            "zich balancerend laten voortbollen op de fiets zonder te trappen, meestal om de leiding nillens willens op te dringen aan de tegenstander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "596b7dd8-d7be-41f8-bc6b-d3843bf70364",
                                "sense_id": "6013cee4-fca5-3a91-8ac3-829b290a7caa",
                                "text": "Sommige sprinters zijn meesters in het surplacen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5175a051-d5ec-3cd3-821b-2a9b34459c0f",
                        "entry_id": "515c2d52-aa5c-3412-a4ea-974d55b15179",
                        "glosses": [
                            "passief zijn, de toestand laten zoals hij is zonder in te grijpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46af5530-6b61-42ed-9849-e54493c1439c",
                                "sense_id": "5175a051-d5ec-3cd3-821b-2a9b34459c0f",
                                "text": "Wie failliet gegaan is, kan ofwel surplacen en wegkwijnen in het verleden, ofwel handelen en opnieuw van nul beginnen."
                            }
                        ]
                    }
