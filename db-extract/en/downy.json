                        "entry_id": "712830a6-387d-3882-b34e-5dfc1f26bd68",
                        "glosses": [
                            "Having down, covered with a soft fuzzy coating as of small feathers or hair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "484b9de1-f9ac-4350-b481-8eac1a691701",
                                "sense_id": "d1f73da9-7f28-38ba-a072-80b6a6241400",
                                "text": "The chick's downy coat of feathers formed almost immediately to keep it warm."
                            }
                        ]
                    },
                    {
                        "sense_id": "bba21517-0478-33dc-891b-d8b5748c4532",
                        "entry_id": "712830a6-387d-3882-b34e-5dfc1f26bd68",
                        "glosses": [
                            "Sharp-witted, perceptive."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c992f75d-7f77-4efa-8932-ef6ddb9de8d8",
                                "sense_id": "bba21517-0478-33dc-891b-d8b5748c4532",
                                "text": "The right hon. Gentleman has much more claim to the adjective downy than I have, but he really cannot catch me with that one."
                            },
                            {
                                "example_id": "0e89a88a-f647-4be8-afe2-bf18e5672dbd",
                                "sense_id": "bba21517-0478-33dc-891b-d8b5748c4532",
                                "text": "I’m not clever, p’raps: but I am rather downy; and partial friends say I know what’s o’clock tolerably well."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa5c3367-97dc-326b-8b6f-381c66eaa2d5",
