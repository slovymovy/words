                                                "sense_id": "05ca311f-3875-3542-938e-b5bc667481dd",
                                                "text": "Een belangrijke vraag voor een toxicoloog is hoe giftige stoffen zich verspreiden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bfffb33-3b9b-4509-84db-65b37ce60d00",
