    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2fe970d3-dc58-39b8-af46-e59bb5277a97",
                "word": "basswood",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "153b468f-1d09-42ce-8c59-f15528c8349a",
