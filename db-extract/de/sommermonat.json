                    {
                        "translation_id": "f3eac22c-2a47-4c53-b283-700dbf55d730",
                        "source_entry_id": "e5cfc07b-fbab-3c4d-bbac-4c7919a315d7",
                        "source_sense_id": "191abb6d-7ed9-3855-a200-4f5817f74ee4",
                        "source_sense_description": "im Sommer liegender Monat; genaue Abgrenzung unterschiedlich",
                        "target_lang_word": "mois d'été",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0b888e2e-7f69-48a1-a502-a038fcb8af72",
                        "source_entry_id": "e5cfc07b-fbab-3c4d-bbac-4c7919a315d7",
                        "source_sense_id": "9a999acb-6394-3163-a076-5481084c66eb",
                        "source_sense_description": "veraltet: Juni",
                        "target_lang_word": "juin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f48d35b2-ca1b-3da4-8e61-d70330f1bebf",
                                        "entry_id": "33e306f9-ca4e-3139-8648-8040e6dea9f4",
                                        "glosses": [
                                            "Sixième mois de l’année du calendrier grégorien, qui compte 30 jours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0606b2b3-8d9d-44ca-b32c-5859e2c1d169",
                                                "sense_id": "f48d35b2-ca1b-3da4-8e61-d70330f1bebf",
                                                "text": "En juin 1585, il est de nouveau à Croixval; sa santé empire, et en octobre il prévoit qu’il s’en ira avec les feuilles."
                                            },
                                            {
                                                "example_id": "4b00d7d0-6c2c-45bf-b680-2035199854cf",
                                                "sense_id": "f48d35b2-ca1b-3da4-8e61-d70330f1bebf",
                                                "text": "[…], mais l’on n’était qu’en juin et, sauf pour les poires de moisson qui mûrissent en août, il fallait encore attendre longtemps avant de savourer concurremment les pommes du verger et la vengeance désirée."
                                            },
                                            {
                                                "example_id": "f1aadcad-1fd6-43c5-92df-14b2df09b497",
                                                "sense_id": "f48d35b2-ca1b-3da4-8e61-d70330f1bebf",
                                                "text": "La fenaison commence généralement dès les premiers jours de juin, époque à laquelle, dans les années sèches, beaucoup des Graminées sont arrivées à maturité; […]."
                                            },
                                            {
                                                "example_id": "1995519e-023e-4785-9c73-5a5ec908d8c0",
                                                "sense_id": "f48d35b2-ca1b-3da4-8e61-d70330f1bebf",
                                                "text": "La moisson de l’orge a lieu aux premiers jours de mai, celle du blé dans la seconde quinzaine de ce mois, celle du maïs au commencement de juin, et celle des légumineuses un peu plus tard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
