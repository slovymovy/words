                                        "glosses": [
                                            "A work consisting of multiple painted or carved panels joined together, often with hinges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "080d4d2b-f6f2-43f6-b46c-b343829ba8ca",
                                                "sense_id": "9dc9d1f0-e39e-3b9e-9a3c-b2f4438c7fe0",
                                                "text": "[...], a polyptych is a painting with more than one section – a diptych is a painting in two parts or sections, a triptych in three, and so on. Perhaps the most famous polyptych is the Ghent Altarpiece by the early Flemish painters Hubert and Jan van Eyck."
                                            }
                                        ]
