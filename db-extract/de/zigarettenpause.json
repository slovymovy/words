                    {
                        "sense_id": "12663df2-3837-33df-bb78-d414bb473129",
                        "entry_id": "38b295e4-f1b2-3042-9895-f4156aa9af5e",
                        "glosses": [
                            "Unterbrechung einer Tätigkeit, um eine Zigarette zu rauchen"
