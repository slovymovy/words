                        "tags": [],
                        "examples": [
                            {
                                "example_id": "938dc518-309b-4bd6-b6a7-c10cd5a0500d",
                                "sense_id": "a8a0b844-a3cc-3a80-83e6-936f10b92dfb",
                                "text": "De bolster werd na voltooiing van de afgraving vermengd met de onderliggende zandgrond."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab92a587-73af-3ef7-aeae-068d116d8e68",
