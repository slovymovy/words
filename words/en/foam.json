{
    "word_family": [
        "foamy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ece6c850-9a61-39ca-ab29-a1795ddf3e90",
                    "sense_definition": "A mass of small bubbles formed on the surface of a liquid, such as water, soap, or beer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bubbles_liquid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He blew the white <w>foam</w> off his beer before taking a sip.",
                            "target_lang_translations": {
                                "ru": "Он сдул белую <w>пену</w> со своего пива, прежде чем сделать глоток.",
                                "zh": "他喝了一口啤酒前，先吹掉了上面的白色<w>泡沫</w>。"
                            }
                        },
                        {
                            "text": "The waves crashed against the rocks, creating a thick layer of sea <w>foam</w>.",
                            "target_lang_translations": {
                                "ru": "Волны разбивались о скалы, создавая толстый слой морской <w>пены</w>.",
                                "zh": "海浪拍打着岩石，激起了一层厚厚的<w>泡沫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "froth",
                        "suds",
                        "lather",
                        "spume",
                        "head",
                        "bubbles"
                    ],
                    "common_phrases": [
                        "sea foam",
                        "shaving foam",
                        "foam party"
                    ],
                    "target_lang_definitions": {
                        "ru": "Масса мелких пузырьков, образующихся на поверхности жидкости, например, воды, мыла или пива.",
                        "zh": "液体表面形成的细小气泡聚集体，如水、肥皂或啤酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пена",
                                "target_lang_sense_clarification": "пузырьки на жидкости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泡沫",
                                "target_lang_sense_clarification": "液体表面的气泡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bb2347f-a3fe-38d6-8c9f-de5eb1984a91",
                    "sense_definition": "A soft, lightweight, and porous material used for packaging, insulation, or making furniture.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "solid_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This mattress is made of memory <w>foam</w> that adapts to your body shape.",
                            "target_lang_translations": {
                                "ru": "Этот матрас сделан из <w>пены</w> с эффектом памяти, которая подстраивается под форму вашего тела.",
                                "zh": "这款床垫由记忆<w>海绵</w>制成，能贴合你的身体曲线。"
                            }
                        },
                        {
                            "text": "We used spray <w>foam</w> to seal the gaps around the windows and keep the house warm.",
                            "target_lang_translations": {
                                "ru": "Мы использовали монтажную <w>пену</w>, чтобы заделать щели вокруг окон и сохранить тепло в доме.",
                                "zh": "我们用喷涂<w>泡沫</w>封住了窗户周围的缝隙，以保持室内温暖。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "memory foam",
                        "foam rubber",
                        "foam padding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий, легкий и пористый материал, используемый для упаковки, изоляции или изготовления мебели.",
                        "zh": "一种柔软、轻便且多孔的材料，用于包装、隔热或制作家具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поролон",
                                "target_lang_sense_clarification": "мягкий материал (мебель, губки)"
                            },
                            {
                                "target_lang_word": "пенопласт",
                                "target_lang_sense_clarification": "жесткий материал (упаковка)"
                            },
                            {
                                "target_lang_word": "пена",
                                "target_lang_sense_clarification": "общий термин (монтажная, с эффектом памяти)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泡沫塑料",
                                "target_lang_sense_clarification": "通用材料名称"
                            },
                            {
                                "target_lang_word": "海绵",
                                "target_lang_sense_clarification": "指家具填充物或软质材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f04541a6-85d3-34fc-85c5-84f1388293a1",
                    "sense_definition": "A collection of bubbles formed from saliva around the mouth, often caused by physical exertion, illness, or anger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bodily_fluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exhausted horse had flecks of white <w>foam</w> around its mouth.",
                            "target_lang_translations": {
                                "ru": "У измученной лошади были клочья белой <w>пены</w> вокруг рта.",
                                "zh": "那匹筋疲力尽的马嘴边带着点点<w>白沫</w>。"
                            }
                        },
                        {
                            "text": "The furious dog barked loudly with <w>foam</w> dripping from its jaws.",
                            "target_lang_translations": {
                                "ru": "Разъяренная собака громко лаяла, и с ее челюстей капала <w>пена</w>.",
                                "zh": "那只狂怒的狗大声吠叫，嘴边滴着<w>白沫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "froth"
                    ],
                    "common_phrases": [
                        "foam at the mouth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скопление пузырьков слюны вокруг рта, часто вызванное физическим напряжением, болезнью или гневом.",
                        "zh": "因体力消耗、疾病或愤怒而在嘴边形成的唾液气泡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пена",
                                "target_lang_sense_clarification": "слюна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白沫",
                                "target_lang_sense_clarification": "口中吐出的泡沫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d464a0f-26a6-3d69-9bdf-fe39836e45c7",
                    "sense_definition": "The sea or ocean.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sea_poetic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor longed to return home from his long journey across the <w>foam</w>.",
                            "target_lang_translations": {
                                "ru": "Моряк жаждал вернуться домой из долгого путешествия по <w>волнам</w>.",
                                "zh": "水手渴望结束漫长的航行，从<w>波涛</w>中回到家乡。"
                            }
                        },
                        {
                            "text": "Many ships have been lost beneath the rolling <w>foam</w> during winter storms.",
                            "target_lang_translations": {
                                "ru": "Многие корабли сгинули в бушующих <w>волнах</w> во время зимних штормов.",
                                "zh": "在冬季的风暴中，许多船只沉没在翻滚的<w>波涛</w>之下。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or poetic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Море или океан (поэтическое).",
                        "zh": "指代海洋（文学或诗意用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волны",
                                "target_lang_sense_clarification": "поэтическое"
                            },
                            {
                                "target_lang_word": "море",
                                "target_lang_sense_clarification": "поэтическое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波涛",
                                "target_lang_sense_clarification": "诗意指代海洋"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "975010f1-6109-30d3-a091-615966deceb1",
                    "sense_definition": "To form or produce a mass of small bubbles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bubbles_liquid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The champagne <w>foamed</w> out of the bottle when he popped the cork.",
                            "target_lang_translations": {
                                "ru": "Шампанское <w>запенилось</w>, выливаясь из бутылки, когда он выстрелил пробкой.",
                                "zh": "他拔开瓶塞时，香槟从瓶子里<w>冒</w>了出来。"
                            }
                        },
                        {
                            "text": "The river <w>foams</w> wildly as it rushes over the sharp rocks.",
                            "target_lang_translations": {
                                "ru": "Река дико <w>пенится</w>, несясь по острым камням.",
                                "zh": "河水冲过尖锐的岩石，激起狂野的<w>泡沫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "froth",
                        "fizz"
                    ],
                    "common_phrases": [
                        "foam up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать или производить массу мелких пузырьков.",
                        "zh": "形成或产生大量细小气泡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пениться",
                                "target_lang_sense_clarification": "о жидкости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起泡沫",
                                "target_lang_sense_clarification": "液体产生泡沫"
                            },
                            {
                                "target_lang_word": "冒泡",
                                "target_lang_sense_clarification": "液体沸腾或剧烈运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f88b9e8f-74b1-39ad-96c5-19cd354375e8",
                    "sense_definition": "To produce frothy saliva at the mouth, usually due to extreme anger, illness, or exhaustion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bodily_fluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so angry that he started to <w>foam</w> at the mouth while shouting.",
                            "target_lang_translations": {
                                "ru": "Он был так зол, что начал <w>брызгать слюной</w>, пока кричал.",
                                "zh": "他气得大喊大叫，甚至开始<w>口吐白沫</w>。"
                            }
                        },
                        {
                            "text": "The wild animal <w>foamed</w> and snapped at anyone who came near the cage.",
                            "target_lang_translations": {
                                "ru": "Дикий зверь <w>исходил пеной</w> и огрызался на всех, кто подходил к клетке.",
                                "zh": "那只野兽<w>口吐白沫</w>，向任何靠近笼子的人猛扑过去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "froth"
                    ],
                    "common_phrases": [
                        "foam at the mouth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять пенистую слюну изо рта, обычно из-за сильного гнева, болезни или истощения.",
                        "zh": "口吐白沫，通常因极度愤怒、疾病或精疲力竭所致。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исходить пеной",
                                "target_lang_sense_clarification": "о бешенстве или болезни"
                            },
                            {
                                "target_lang_word": "брызгать слюной",
                                "target_lang_sense_clarification": "о гневе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口吐白沫",
                                "target_lang_sense_clarification": "因病或极度愤怒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e9505e4-1249-3c84-a1d0-5201ac42b823",
                    "sense_definition": "To cover or fill a space with a foamy substance, often for insulation or fire safety.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "solid_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Firefighters had to <w>foam</w> the runway before the damaged plane could land.",
                            "target_lang_translations": {
                                "ru": "Пожарным пришлось <w>покрыть пеной</w> взлетно-посадочную полосу, прежде чем поврежденный самолет смог приземлиться.",
                                "zh": "在受损飞机降落前，消防员必须在跑道上<w>喷涂泡沫</w>。"
                            }
                        },
                        {
                            "text": "The workers <w>foamed</w> the walls to improve the building's thermal insulation.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>запенили</w> стены, чтобы улучшить теплоизоляцию здания.",
                                "zh": "工人们对墙体进行了<w>泡沫</w>填充，以改善建筑的隔热性能。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать или заполнять пространство пенистым веществом, часто для изоляции или пожарной безопасности.",
                        "zh": "用泡沫物质覆盖或填充空间，常用于隔热或消防安全。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запенивать",
                                "target_lang_sense_clarification": "заполнять пеной (щели)"
                            },
                            {
                                "target_lang_word": "покрывать пеной",
                                "target_lang_sense_clarification": "наносить слой пены"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喷涂泡沫",
                                "target_lang_sense_clarification": "覆盖表面"
                            },
                            {
                                "target_lang_word": "填充泡沫",
                                "target_lang_sense_clarification": "填补缝隙"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}