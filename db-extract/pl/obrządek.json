                ],
                "senses": [
                    {
                        "sense_id": "e11edd18-7397-30de-a235-9a670f5e9798",
                        "entry_id": "3c3430a0-4db9-3cf2-83a1-d2a40c471ab3",
                        "glosses": [
                            "porządek uroczystych obchodów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecc6867e-b7fb-4d0e-92f2-9f3a4b6cd60b",
                                "sense_id": "e11edd18-7397-30de-a235-9a670f5e9798",
                                "text": "- Była w nim jakaś ogromna siła. Żegnał syna, widać było, jak bardzo cierpi, ale spokojnie jak gospodarz pilnował obrządku - mówi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "deee4fc3-5a51-330c-93b3-8c5c287b0a79",
                        "entry_id": "3c3430a0-4db9-3cf2-83a1-d2a40c471ab3",
                        "glosses": [
                            "stały powtarzający się rytm prac gospodarskich"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "73489163-b06c-4914-9e90-8d0bfa38b740",
                                "sense_id": "deee4fc3-5a51-330c-93b3-8c5c287b0a79",
                                "text": "Będę wychodził z nim o świcie, trochę pomagał w obrządku."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "631b6e2c-e944-36e2-9cae-3e082f838df0",
                        "entry_id": "3c3430a0-4db9-3cf2-83a1-d2a40c471ab3",
                        "glosses": [
                            "ryt w ramach jednej rodziny liturgicznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8408b313-7048-41f6-ac84-334b3fcce7c6",
                                "sense_id": "631b6e2c-e944-36e2-9cae-3e082f838df0",
                                "text": "Dwóch księży jeździło po kraju i odprawiało ostatnie msze w obrządku ormiańskim."
                            },
                            {
                                "example_id": "3585dd91-01c9-4ab4-9cc5-d9397c11c5e2",
                                "sense_id": "631b6e2c-e944-36e2-9cae-3e082f838df0",
                                "text": "Pochowano go w atmosferze skandalu, bo choć ostentacyjnie podkreślał swoją konwersję, spoczął na cmentarzu katolickim, ceremonia pogrzebowa odbyła się w obrządku katolickim, a nad trumną rozgorzała walka o to, kto ma prowadzić kondukt - ksiądz czy pastor?"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "bc9d55d7-317a-3e21-bf19-6de725bcce5a",
                        "entry_id": "3c3430a0-4db9-3cf2-83a1-d2a40c471ab3",
                        "glosses": [
                            "publiczny akt religijny, również jego porządek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84f59390-1685-45c0-b8e1-b98fae760c5f",
                                "sense_id": "bc9d55d7-317a-3e21-bf19-6de725bcce5a",
                                "text": "Wzięli ślub według tradycyjnego obrządku żydowskiego."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "f93ad534-7c25-3b43-a45c-8844b6baed4f",
                        "entry_id": "3c3430a0-4db9-3cf2-83a1-d2a40c471ab3",
                        "glosses": [
                            "wyznanie w ramach jednej religii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef32a13c-de19-445a-aa86-d9b1c6087b7a",
                                "sense_id": "f93ad534-7c25-3b43-a45c-8844b6baed4f",
                                "text": "Bo już co do pogrzebów, to różnie bywało, i na cerkiewnym cmentarzu spoczywali zgodnie obok siebie ludzie dwóch obrządków, a jednej wiary"
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "6b0dcc3d-3d0b-3664-82b3-cfb567569d25",
                        "entry_id": "3c3430a0-4db9-3cf2-83a1-d2a40c471ab3",
                        "glosses": [
                            "rytuał"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "4da85b05-c89a-4272-9aab-d90c5fb0dce4",
                                "sense_id": "6b0dcc3d-3d0b-3664-82b3-cfb567569d25",
                                "text": "Picie kawy jest obrządkiem, który towarzyszy tu wszystkim kontaktom między ludźmi"
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    }
                ],
