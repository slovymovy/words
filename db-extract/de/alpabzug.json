                        "entry_id": "ed4c40ab-43a7-387c-8035-14d2491bf319",
                        "glosses": [
                            "das feierlich begangene Heimholen des Weideviehs Ende September von den Hochgebirgsweiden in den Stall"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
