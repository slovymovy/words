                                    },
                                    {
                                        "sense_id": "e612ddb2-c5fa-3111-b18b-1d81a2566803",
                                        "entry_id": "716f0cc2-8ef1-3bce-bff1-d6f46b68ada2",
                                        "glosses": [
                                            "An explicit or formal acknowledgment of ownership or authorship."
                                        ],
                                        "tags": [
