                        "target_lang_word": "but contre son camp",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "but contre son camp",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f7db5fa-fba5-3b32-a48d-7d5b7140364c",
                                        "entry_id": "e1491827-37fb-3479-ae30-66d2755f5cb1",
                                        "glosses": [
                                            "But marqué par un joueur dans ses propres buts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84078ecf-1a86-425d-9f6e-b5f5f7dd8656",
                                                "sense_id": "7f7db5fa-fba5-3b32-a48d-7d5b7140364c",
                                                "text": "La vidéo du but contre son camp le plus improbable de l’année nous vient d’Allemagne."
                                            },
                                            {
                                                "example_id": "a0ad64c8-0da4-4df0-9c3a-fd016d767355",
                                                "sense_id": "7f7db5fa-fba5-3b32-a48d-7d5b7140364c",
                                                "text": "Pour se donner une idée, l'édition 2021, la plus prolifique en termes de CSC, s'était terminée avec neuf buts contre son camp en 51 matchs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c8b5925-d71f-30c0-a7fd-0887aa612d24",
                                        "entry_id": "e1491827-37fb-3479-ae30-66d2755f5cb1",
                                        "glosses": [
                                            "Parole ou acte qui se retourne contre la personne à son origine ou le groupe auquel la personne appartient."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad99abc3-75c2-431a-aafa-909ba4408b3c",
                                                "sense_id": "4c8b5925-d71f-30c0-a7fd-0887aa612d24",
                                                "text": "Matteo Salvini, l’homme « qui a marqué un but contre son camp »"
                                            },
                                            {
                                                "example_id": "9aae04f8-0e63-4675-a8ae-d326010b6a56",
                                                "sense_id": "4c8b5925-d71f-30c0-a7fd-0887aa612d24",
                                                "text": "Je le reproche un peu à Fabien, j'ai l'impression qu'il marque des buts contre son camp, en approuvant ce que dit monsieur Darmanin alors qu'il est en guerre contre la Nupes, nous criminalise, nous stigmatise, et fait de même avec monsieur Cazeneuve"
                                            },
                                            {
                                                "example_id": "c426fc34-8db0-4bf6-9ea0-f05f6b89db12",
                                                "sense_id": "4c8b5925-d71f-30c0-a7fd-0887aa612d24",
                                                "text": "Législatives 2024 : le « but contre son camp » de Macron continue à stupéfier l’Allemagne"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
