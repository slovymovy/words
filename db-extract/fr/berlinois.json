                    {
                        "translation_id": "8f5e11df-f779-439d-ad82-f32d7cfacdea",
                        "source_entry_id": "8ca3f376-247e-3f99-a2b8-444815a6bef3",
                        "source_sense_id": "9781c798-2d4b-3a94-a786-3864d73534d4",
