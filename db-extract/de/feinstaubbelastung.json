                ],
                "senses": [
                    {
                        "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                        "entry_id": "56966332-4618-31e0-9757-918225453d00",
                        "glosses": [
                            "Belastung der Umwelt durch Feinstaub"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e661ef27-cebb-472f-8018-4faaeff3418e",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "Trotz der Citymaut blieb die Feinstaubbelastung konstant."
                            },
                            {
                                "example_id": "1f003f55-c7f4-4349-b532-332dc7aa2b63",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "„Langfristige Feinstaubbelastung kann zu Herz-Kreislauf-Erkrankungen und Lungenkrebs führen.“"
                            },
                            {
                                "example_id": "2aa3e60d-76a8-469e-bab9-0f8a7920b9b7",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "„Bahrain hat eine hohe Feinstaubbelastung.“"
                            },
                            {
                                "example_id": "8d9ce0fd-48bc-4103-b4a2-c55c90cf642e",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "„In Niedersachsen und Bremen hat es im vergangenen Jahr erneut nur wenige Tage mit hoher Feinstaubbelastung gegeben.“"
                            },
                            {
                                "example_id": "a1c054a0-2c6c-407b-8c43-d869805c48c6",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "„Die Feinstaubbelastung ist zurückgegangen - aber sie muss noch weiter sinken. Denn vor allem die allerkleinsten Partikel schädigen Atemwege und Lungen, verursachen Herz-Kreislauf-Erkrankungen und sogar Alzheimer.“"
                            },
                            {
                                "example_id": "e530276b-21fa-46f7-b068-9cdfb843a4ab",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "„In München registrierte die Überwachungsstation in der Prinzregentenstraße zum Jahreswechsel 2009/2010 eine Stunde nach Mitternacht eine Feinstaubbelastung von 1138 Mikrogramm pro Kubikmeter Luft. Tagsüber lag der Wert bei 17 Mikrogramm.“"
                            },
                            {
                                "example_id": "7f7e07c3-8bb8-48fd-8eec-c72901ae65d2",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "„Laut den Modellrechnungen des Epic übersteigt die Feinstaubbelastung in Bangladesch den Grenzwert der Weltgesundheitsorganisation um fast das 15-Fache.“"
                            },
                            {
                                "example_id": "ecbb22a0-bc2e-4dbf-82bc-787013e1860d",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "„In der indischen Hauptstadt Neu-Delhi, der \"am stärksten verschmutzten Megastadt der Welt\", liegt die Feinstaubbelastung sogar um mehr als das 25-fache über dem WHO-Grenzwert.“"
                            },
                            {
                                "example_id": "1a308159-af69-4fa4-9ea6-fbc5185a58fb",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "„Drastische Maßnahmen gegen die Feinstaubbelastung in chinesischen Städten haben eine unvorhergesehene Nebenwirkung: Die Belastung mit Ozon ist deutlich gestiegen.“"
                            },
                            {
                                "example_id": "81ff7bce-ae12-4c9d-9d77-b51cd23e94ef",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "„Würden weltweit die von der Weltgesundheitsorganisation (WHO) empfohlenen Grenzwerte für die Feinstaubbelastung der Luft eingehalten, könnte die durchschnittliche Lebenserwartung um über zwei Jahren steigen, heißt es in der Studie des Instituts für Energiepolitik an der Universität von Chicago (EPIC).“"
                            },
                            {
                                "example_id": "f201bd20-7985-49dc-b26d-2e14c6da80de",
                                "sense_id": "ccdb42df-9778-38cc-bfdb-ec98cf18c1b3",
                                "text": "„In geschlossenen Räumen sind der Rauch von Tabakwaren, Laserdruckern und Kopierern Quellen der Feinstaubbelastung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
