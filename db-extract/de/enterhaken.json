                                        "glosses": [
                                            "A type of hook attached to a line and designed to be thrown at a target (e.g. rigging of an enemy ship) for the purpose of catching hold of it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91317583-2efc-4b7a-b155-0a2abae73563",
