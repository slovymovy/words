{
    "word_family": [
        "bemannen",
        "onbemand"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "593659da-5de8-3fa8-bf3e-b220e8dac2dd",
                    "sense_definition": "de groep personen die werkt aan boord van een schip, vliegtuig of ander voertuig",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op een passagiersschip zijn de <w>bemanning</w> en de passagiers strikt gescheiden.",
                            "target_lang_translations": {
                                "en": "On a passenger ship, the <w>crew</w> and the passengers are strictly separated."
                            }
                        },
                        {
                            "text": "De kapitein gaf de <w>bemanning</w> de opdracht om de zeilen te hijsen.",
                            "target_lang_translations": {
                                "en": "The captain ordered the <w>crew</w> to hoist the sails."
                            }
                        },
                        {
                            "text": "De volledige <w>bemanning</w> van het vliegtuig werd geprezen voor de veilige landing.",
                            "target_lang_translations": {
                                "en": "The entire <w>crew</w> of the aircraft was praised for the safe landing."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemensing"
                    ],
                    "common_phrases": [
                        "volledige bemanning",
                        "bemanning aan boord"
                    ],
                    "target_lang_definitions": {
                        "en": "the group of people who work on board a ship, aircraft, or other vehicle"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crew",
                                "target_lang_sense_clarification": "of a ship or aircraft"
                            },
                            {
                                "target_lang_word": "personnel",
                                "target_lang_sense_clarification": "general staff on board"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3433310f-8315-3874-95b8-1e912a207e22",
                    "sense_definition": "het personeel dat nodig is om een apparaat, installatie of faciliteit te bedienen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>bemanning</w> van het ruimtestation voert dagelijks wetenschappelijke experimenten uit.",
                            "target_lang_translations": {
                                "en": "The <w>crew</w> of the space station carries out scientific experiments daily."
                            }
                        },
                        {
                            "text": "Er is extra <w>bemanning</w> nodig om deze complexe machine veilig te kunnen gebruiken.",
                            "target_lang_translations": {
                                "en": "Extra <w>staffing</w> is needed to use this complex machine safely."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemensing"
                    ],
                    "common_phrases": [
                        "minimale bemanning"
                    ],
                    "target_lang_definitions": {
                        "en": "the personnel required to operate a device, installation, or facility"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crew",
                                "target_lang_sense_clarification": "operating a facility or station"
                            },
                            {
                                "target_lang_word": "staffing",
                                "target_lang_sense_clarification": "the act of providing personnel"
                            },
                            {
                                "target_lang_word": "manning",
                                "target_lang_sense_clarification": "the personnel for a specific task"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}