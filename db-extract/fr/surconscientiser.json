                        "glosses": [
                            "Donner un caractère surconscient à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b42c15-49ab-4aba-ae6a-2108177db922",
                                "sense_id": "87cd2d87-fc46-3a8b-97da-da755b5954df",
                                "text": "L’idée d’imagination morale n’implique pas la seule attention aux événements surconscientisés : bien au contraire elle s’attache à qualifier un domaine d’actions impensées (ou de « représentations faibles [de l’action] ») circonscrit par l’intériorisation souvent « non consciente » de protocoles de conduite (Veyne 1995: 165, 186)."
                            },
                            {
                                "example_id": "e34aff59-5514-4c56-bd53-8af827a13c0d",
                                "sense_id": "87cd2d87-fc46-3a8b-97da-da755b5954df",
                                "text": "Je suis en train de tuer cette figure insalubre qui me délabre à surconscientiser l'inconscientisable."
                            }
                        ]
                    }
