                        "glosses": [
                            "Construction d'un pont généralement provisoire et à usage militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3556603a-b560-4ab9-ae5e-c0877b4b979c",
                                "sense_id": "e4dcc274-ba7f-30c0-a982-10f9effa4742",
                                "text": "Les travaux de pontage avancent d'heure en heure."
                            },
                            {
                                "example_id": "9516e556-91cb-4af6-b165-cf899f576001",
                                "sense_id": "e4dcc274-ba7f-30c0-a982-10f9effa4742",
                                "text": "J'y avais appris le maniement du bâton, du fusil et de la baïonnette, de l'épée et du sabre. Mais aussi, et c'était le plus important, l'exercice du pontage, c'est-à-dire la fabrication de ponts."
                            }
                        ]
                    },
                    {
                        "sense_id": "58b49703-512e-37eb-94fc-d8f2963706f8",
                        "entry_id": "c3ca1864-ca9f-3d80-82f7-626f4a4997c6",
                        "glosses": [
                            "Jonction chirurgicale de deux segments artériels par interposition d'un greffon ou d'un tube artificiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d8cbc05-495e-4817-b600-3047c7a14893",
                                "sense_id": "58b49703-512e-37eb-94fc-d8f2963706f8",
                                "text": "Avec ses pontages coronariens, l’ablation d’un lobe du poumon à cause d’un cancer et une multitude de tests et de rendez-vous, Guy a traversé pas mal plus que la pandémie depuis un peu moins de deux ans."
                            },
                            {
                                "example_id": "c5f3d47a-2806-4734-b952-22a16f012b87",
                                "sense_id": "58b49703-512e-37eb-94fc-d8f2963706f8",
                                "text": "Un pontage aortocoronarien."
                            }
                        ]
                    },
                    {
                        "sense_id": "94c82e7b-fd68-3faf-b489-04ffbd44f503",
                        "entry_id": "c3ca1864-ca9f-3d80-82f7-626f4a4997c6",
