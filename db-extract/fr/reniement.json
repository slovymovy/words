                "senses": [
                    {
                        "sense_id": "025121da-32ba-30a7-9c0b-4e0c2e99206d",
                        "entry_id": "7046fba6-892e-3587-854d-d14e33365c57",
                        "glosses": [
                            "Action de renier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c8ad082-d32c-4063-981d-21420e3ecef4",
                                "sense_id": "025121da-32ba-30a7-9c0b-4e0c2e99206d",
                                "text": "Le reniement de saint Pierre."
                            },
                            {
                                "example_id": "2d9aef4c-feb2-4425-84e3-0ce2cb7fb599",
                                "sense_id": "025121da-32ba-30a7-9c0b-4e0c2e99206d",
                                "text": "Le reniement d’une doctrine."
                            },
                            {
                                "example_id": "f11fd530-8cf3-46cc-8acf-b8743ca561b9",
                                "sense_id": "025121da-32ba-30a7-9c0b-4e0c2e99206d",
                                "text": "Les gens de son parti ne lui ont pas pardonné ses reniements."
                            },
                            {
                                "example_id": "9a37d17b-7a4a-4d5a-8cbd-1e6cc6cd1e49",
                                "sense_id": "025121da-32ba-30a7-9c0b-4e0c2e99206d",
                                "text": "Mon cœur se soulève de dégoût lorsque je lis certains noms au bas de certaines injures et que je vois si empressés au reniement ceux qui étaient si empressés à l’adulation."
                            },
                            {
                                "example_id": "ef41fe8e-26d5-4615-84e5-19488f00ddb8",
                                "sense_id": "025121da-32ba-30a7-9c0b-4e0c2e99206d",
                                "text": "— La perte de la foi n’est pas un reniement. Un séminariste qui quitte le séminaire, c’est la victime d’une erreur d’aiguillage.\n— Il est passé à l’ennemi, tu le sais bien."
                            },
                            {
                                "example_id": "85a4bdc5-65ca-4ec5-83f1-0b154cd4a65e",
                                "sense_id": "025121da-32ba-30a7-9c0b-4e0c2e99206d",
                                "text": "Jan n’en était pas à un reniement ou à un désaveu près."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ce9b524-d62b-48da-a87e-9672bf177c12",
                        "source_entry_id": "7046fba6-892e-3587-854d-d14e33365c57",
                        "source_sense_id": "025121da-32ba-30a7-9c0b-4e0c2e99206d",
                        "source_sense_description": "Action de renier",
                        "target_lang_word": "disavowal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disavowal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cee033ba-154e-3e61-9711-3620424d75c2",
                                        "entry_id": "dfe5dc60-06cd-3158-ba34-c0c3278e2174",
                                        "glosses": [
                                            "A denial of knowledge, relationship, or responsibility towards something or someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b8f8a7-b609-43cf-a072-d7030b179e14",
                                                "sense_id": "cee033ba-154e-3e61-9711-3620424d75c2",
                                                "text": "Whatever pleas may be urged for a disavowal of engagements formed by diplomatic functionaries in cases where by the terms of the engagements a mutual ratification is reserved, or where notice at the time may have been given of a departure from instructions, or in extraordinary cases essentially violating the principles of equity, a disavowal could not have been apprehended in a case where no such notice or violation existed, where no such ratification was reserved, and more especially where, as is now in proof, an engagement to be executed without any such ratification was contemplated by the instructions given, and where it had with good faith been carried into immediate execution on the part of the United nations."
                                            },
                                            {
                                                "example_id": "1478121a-e754-46d1-9b6e-df414bf5144a",
                                                "sense_id": "cee033ba-154e-3e61-9711-3620424d75c2",
                                                "text": "Last week, when House Speaker Nancy Pelosi rejected as “condescending” President Trump’s proposal for a more merit-based immigration policy, she provided a metaphor not just for the shattered condition of Washington’s governance of immigration, but also for the Democratic Party’s ideologically rigid disavowal of all principles of immigration constraint."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c2d3d9b-00de-4f1e-98d3-af348ce56107",
                        "source_entry_id": "7046fba6-892e-3587-854d-d14e33365c57",
                        "source_sense_id": "025121da-32ba-30a7-9c0b-4e0c2e99206d",
                        "source_sense_description": "Action de renier",
                        "target_lang_word": "repudiation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repudiation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad2c830-bc50-34c6-bdae-559b69c56e66",
                                        "entry_id": "db8c6722-be8e-30ff-a115-f899bf3207b0",
                                        "glosses": [
                                            "The act of refusing to accept; the act of repudiating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6d1d821-ab77-4bf7-ba4a-b4a83ed4a1f4",
                                                "sense_id": "8ad2c830-bc50-34c6-bdae-559b69c56e66",
                                                "text": "The young man's repudiation of the church's doctrines caused a conflict with his religious parents."
                                            },
                                            {
                                                "example_id": "8abeb6ff-c82e-45d9-996d-8396998d6a39",
                                                "sense_id": "8ad2c830-bc50-34c6-bdae-559b69c56e66",
                                                "text": "Santorum, in a comment regarding Senator John McCain's repudiation of torture, stated, \"He doesn't understand how enhanced interrogation works. I mean, you break somebody, and after they've broken they become cooperative\" (Summers 2011)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
