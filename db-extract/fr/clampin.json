                ],
                "senses": [
                    {
                        "sense_id": "1c8d2670-16c7-31c5-a898-4d8bf69d5be2",
                        "entry_id": "3eed2ca2-b8f4-33aa-ae3c-f7fe54f6b5c3",
                        "glosses": [
                            "Celui qui traine derrière un groupe et en ralentit la marche."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "92e435df-184f-36e7-9d31-ad97c67fa595",
                        "entry_id": "3eed2ca2-b8f4-33aa-ae3c-f7fe54f6b5c3",
                        "glosses": [
                            "Paresseux, cossard, fainéant, tire-au-flanc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85a69dc4-713e-4a2c-8cae-846875f61cfb",
                                "sense_id": "92e435df-184f-36e7-9d31-ad97c67fa595",
                                "text": "Il faut l’avoir à l’œil, ce clampin, si vous voulez que le travail avance !"
                            },
                            {
                                "example_id": "e9be6e11-f2ae-4850-bdae-0e8d51b19c73",
                                "sense_id": "92e435df-184f-36e7-9d31-ad97c67fa595",
                                "text": "Un jour mon sergent me bouscule pour me faire obéir plus vite ; il avait raison, car je faisais le clampin."
                            },
                            {
                                "example_id": "72adc07b-f058-4d06-a1bb-a267552faa61",
                                "sense_id": "92e435df-184f-36e7-9d31-ad97c67fa595",
                                "text": "Pinchard. — Eh bien ! qu’est-ce que t’as à rester là planté comme une borne, clampin."
                            }
                        ]
                    },
                    {
                        "sense_id": "43714003-331e-3344-bb62-20102d223e7c",
                        "entry_id": "3eed2ca2-b8f4-33aa-ae3c-f7fe54f6b5c3",
                        "glosses": [
                            "Personne quelconque ; quidam."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cf7d0402-354d-40ef-822d-91a1423b81d2",
                                "sense_id": "43714003-331e-3344-bb62-20102d223e7c",
                                "text": "N'importe quel clampin de bistrot, d’aède de comptoir a plus de talent et de sensibilité que ces bavasseurs glumeux, ces bouffons de l'art officiel, castrats du sérail de la bien-pensance, créatures de la gauche culturellement proprette."
                            }
                        ]
                    }
