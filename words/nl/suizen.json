    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f9b8e50-0259-310e-b9ad-e15638e28679",
                    "sense_definition": "een ruisend geluid voortbrengen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na die wilde avond bonkte en <w>suisde</w> mijn arme hoofd.",
                            "target_lang_translations": {
                                "en": "After that wild night, my poor head was pounding and <w>buzzing</w>."
                            }
                        },
                        {
                            "text": "De wind <w>suist</w> zachtjes door de kale takken van de bomen.",
                            "target_lang_translations": {
                                "en": "The wind <w>whistles</w> softly through the bare branches of the trees."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruisen"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce a soft, rushing or whistling sound."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to whoosh",
                                "target_lang_sense_clarification": "describing the sound of air or wind moving"
                            },
                            {
                                "target_lang_word": "to whistle",
                                "target_lang_sense_clarification": "describing a high-pitched sound made by wind"
                            },
                            {
                                "target_lang_word": "to buzz",
                                "target_lang_sense_clarification": "describing a persistent humming or rushing sound in the ears"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ecb2381-5141-3cfc-b746-af6ce3eb435a",
                    "sense_definition": "zich snel verplaatsen zodat er een ruisend geluid voortgebracht wordt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was op zijn snowboard van de helling <w>gesuisd</w>.",
                            "target_lang_translations": {
                                "en": "He had <w>whooshed</w> down the slope on his snowboard."
                            }
                        },
                        {
                            "text": "De auto <w>suisde</w> met hoge snelheid voorbij op de snelweg.",
                            "target_lang_translations": {
                                "en": "The car <w>whizzed</w> past at high speed on the highway."
                            }
                        }
                    ],
                    "synonyms": [
                        "flitsen",
                        "zoeven"
                    ],
                    "target_lang_definitions": {
                        "en": "To move very quickly while producing a rushing sound."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to whoosh",
                                "target_lang_sense_clarification": "moving rapidly with a rushing sound"
                            },
                            {
                                "target_lang_word": "to whiz",
                                "target_lang_sense_clarification": "moving very fast, often with a whistling sound"
                            },
                            {
                                "target_lang_word": "to zoom",
                                "target_lang_sense_clarification": "moving quickly, especially for vehicles"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}