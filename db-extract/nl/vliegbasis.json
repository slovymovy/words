                                        "sense_id": "820f7cde-009d-32e6-9be5-8283d82f4aff",
                                        "entry_id": "c95e34ee-3e8c-385f-9019-575a201cbf58",
                                        "glosses": [
                                            "nur für militärische Zwecke verwendeter Flugplatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b323eab-07c2-4f3d-a8d2-efb1d27b5b1f",
                                                "sense_id": "820f7cde-009d-32e6-9be5-8283d82f4aff",
                                                "text": "„Konkret ist die Rede vom Transport mit einem Militärflugzeug, das vom russisch kontrollierten Militärflugplatz Hmeimim in Syrien nach Sankt Petersburg geflogen sein soll.“"
