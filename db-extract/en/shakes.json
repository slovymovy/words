                        "sense_id": "13111c6c-ffda-35ac-8e2b-af0719561308",
                        "entry_id": "4e192a07-2601-34da-b1da-075890931795",
                        "glosses": [
                            "Delirium tremens; typically due to alcohol withdrawal."
                        ],
                        "tags": [
                            "plural",
                            "plural-only",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6b2d8ac7-8a10-30a5-94d6-e510ff015e67",
                        "entry_id": "4e192a07-2601-34da-b1da-075890931795",
                        "glosses": [
                            "A pattern of behavior including twitches, tics and spasms typical of withdrawal from addiction."
                        ],
                        "tags": [
                            "colloquial",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "e864a124-c418-4c9c-893b-89fddfed4907",
                                "sense_id": "6b2d8ac7-8a10-30a5-94d6-e510ff015e67",
                                "text": "[Recovering video game addicts] also have sleep disorders, the shakes and numbness in their hands. http://www.theregister.co.uk/2005/07/05/china_net_addicts/"
                            },
                            {
                                "example_id": "8ddd0ad7-90a4-467f-b7f1-8ac35fc22267",
                                "sense_id": "6b2d8ac7-8a10-30a5-94d6-e510ff015e67",
                                "text": "When researchers either stopped the diet or administered an opioid blocker, the rats showed signs common to drug withdrawal, such as teeth-chattering and the shakes. http://apu.sfn.org/index.cfm?pagename=brainBriefings_sugarAddiction"
                            }
                        ]
                    },
                    {
                        "sense_id": "b02f02a1-eb4b-3c31-ad44-91fa6b5d854e",
                        "entry_id": "4e192a07-2601-34da-b1da-075890931795",
                        "glosses": [
                            "A fit of trembling or shivering."
                        ],
                        "tags": [
                            "colloquial",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "dc3c67fb-c4e8-4617-8293-61cf1b00321a",
                                "sense_id": "b02f02a1-eb4b-3c31-ad44-91fa6b5d854e",
                                "text": "\"I remember having the shakes sometimes and thinking 'why am I doing this?', and then remembering the vision. Very few of us were extroverts and happy to go on stage."
                            }
                        ]
                    }
                ],
