                    "frequency": "High",
                    "semantic_group_id": "doradzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz dokładnie zbadał pacjenta i <w>zalecił</w> mu odpoczynek w łóżku przez kilka dni.",
                            "target_lang_translations": {
                                "ru": "Врач внимательно осмотрел пациента и <w>предписал</w> ему постельный режим на несколько дней."
                            }
                        },
                        {
                            "text": "Dyrektor szkoły <w>zalecił</w> nauczycielom ostrożność podczas organizowania wycieczki w góry.",
                            "target_lang_translations": {
                                "ru": "Директор школы <w>рекомендовал</w> учителям соблюдать осторожность при организации поездки в горы."
                            }
                        }
                    ],
                    "synonyms": [
