                                            {
                                                "example_id": "1cd6efc0-0c63-4953-affc-c2d40ef8d442",
                                                "sense_id": "2764ffdc-9215-331e-82b8-972917bb8ecc",
                                                "text": "Het was byna omringd van een open bosch van staatige pynbomen (Pinus palustris), door welke zig het uitgestrekte drasland vertoonde, …"
                                            },
                                            {
                                                "example_id": "667dd039-88b6-41dd-bdca-bfe62da1ee3e",
                                                "sense_id": "2764ffdc-9215-331e-82b8-972917bb8ecc",
                                                "text": "Nederland beschikt over veel drasland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4b4a248-35f7-3aea-a536-a4798ada8cef",
                                        "entry_id": "9cc429a9-e29b-357f-9580-5174f0993bf3",
                                        "glosses": [
                                            "een gebied dat voortdurend of bij afwisseling verzadigd of bedekt met water is en daardoor een herkenbaar eigen ecosysteem vormt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b42003ba-20ba-44cf-a0f6-ad46e74713bb",
                                                "sense_id": "a4b4a248-35f7-3aea-a536-a4798ada8cef",
                                                "text": "HET EUROPESE DRASLAND EN ZIJN PROBLEMEN Het drasland in de Unie neemt de meest uiteenlopende vormen aan: kustgebieden, estuaria en delta's, alluviale vlaktes, meren, moerassen, veengronden, lagunes... De wisselwerking tussen water, bodem en vegetatie leidt tot de vorming van zeer bijzondere, door een enorme biologische produktiviteit gekenmerkte ecosystemen die elk hun eigen functie hebben (hoogwaterregulering, kuststabilisatie, …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
