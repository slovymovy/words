                                        "sense_id": "1a47a271-5530-30ad-aa2c-4dcfc8b6e949",
                                        "entry_id": "a4708316-ad3a-3dc7-bb2d-e4137dd4cd33",
                                        "glosses": [
                                            "Autobús que utiliza la electricidad, tomándola de cables que van en el aire siguiendo su recorrido, por medio de dos pértigas o troles."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b70a1cf-398c-485d-a150-74c981be0645",
                        "source_entry_id": "f254db19-9233-3e12-98a8-c0c17d803c2a",
                        "source_sense_id": "bc8163d7-2901-3ff2-a2f2-f48be5ea38bb",
                        "target_lang_word": "Oberleitungsbus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oberleitungsbus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16a65c60-8ff4-3199-b7fe-419e94cd08f0",
                                        "entry_id": "317c2810-014d-376d-bd2f-50c371fbb1f7",
                                        "glosses": [
                                            "als Verkehrsmittel im öffentlichen Personennahverkehr eingesetzter Bus, der seine Antriebsenergie aus einer über der Fahrbahn aufgehängten elektrischen Leitung bezieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c17520e8-5908-4f82-a022-598db22e03de",
                                                "sense_id": "16a65c60-8ff4-3199-b7fe-419e94cd08f0",
                                                "text": "„Die Stadt Potsdam hält die Rückkehr zu Oberleitungsbussen für unwirtschaftlich.“"
                                            },
                                            {
                                                "example_id": "01f56c5e-8069-46d1-a641-00890e61b410",
                                                "sense_id": "16a65c60-8ff4-3199-b7fe-419e94cd08f0",
                                                "text": "„Die Zukunft wird dem Elektrobus gehören. Fragt sich nur: welchem? Dem Batteriebus, dem Oberleitungsbus oder dem Wasserstoffbus, der seinen Strom aus einer Brennstoffzelle bezieht?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6101b4f-21bf-470d-aeff-7e12b6c82141",
                        "source_entry_id": "f254db19-9233-3e12-98a8-c0c17d803c2a",
                        "source_sense_id": "bc8163d7-2901-3ff2-a2f2-f48be5ea38bb",
                        "target_lang_word": "Obus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Obus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9ae4304-e814-3dbf-aced-f83253f64411",
                                        "entry_id": "70dd9330-c5ae-33ee-8884-7bf22f207212",
                                        "glosses": [
                                            "über eine Oberleitung angetriebenes, als elektrisches Verkehrsmittel im öffentlichen Personennahverkehr eingesetztes vielsitziges, großes Kraftfahrzeug zur Beförderung einer größeren Anzahl von Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1af31fa-2819-42a7-b59f-b5f7f88e296d",
                                                "sense_id": "a9ae4304-e814-3dbf-aced-f83253f64411",
                                                "text": "„Vorteile der Oberleitungsomnibusse/Obusse gegenüber dem Dieselbus liegen in der stärkeren Beschleunigung, in der besseren Steigfähigkeit (in San Francisco befahren Obusse eine Steigung von 228 Promille), in der Emissionsfreiheit am Einsatzort, in der geringen Geräuschentwicklung, in der längeren Lebensdauer, in der geringeren/fehlenden Besteuerung und besonders bei steigenden Mineralölkosten an den relativ geringen Stromkosten, zunehmend auch mit der Möglichkeit der Rückspeisung von (Brems-)Strom in das Netz.“"
                                            },
                                            {
                                                "example_id": "662cb821-a568-4d95-ae4e-1491d23100db",
                                                "sense_id": "a9ae4304-e814-3dbf-aced-f83253f64411",
                                                "text": "„Ein wesentlicher Vorteil des Obusses gegenüber einer Umstellung auf Busse mit Verbrennungsmotor war - wie bei der Straßenbahn - die Energieversorgung aus der Verstromung heimischer Kohlevorkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1a17029-4c38-4932-8f11-a642f83fe4f8",
                        "source_entry_id": "f254db19-9233-3e12-98a8-c0c17d803c2a",
                        "source_sense_id": "bc8163d7-2901-3ff2-a2f2-f48be5ea38bb",
                        "target_lang_word": "Trolleybus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trolleybus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3c65283-f439-350e-b154-fd8d4e39de22",
                                        "entry_id": "5afa76cd-f3a6-3a4b-b47b-4209a44035af",
                                        "glosses": [
                                            "Bus mit Elektromotor, der seine Energie aus einer stromführenden Oberleitung nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de31d93b-46e0-4bcf-90f9-5a58002475ce",
                                                "sense_id": "a3c65283-f439-350e-b154-fd8d4e39de22",
                                                "text": "„Oberleitungsfahrzeuge haben in Form von Trolleybussen, auch mit Zusatzdiesel, längst ihre Funktionstüchtigkeit bewiesen.“"
                                            },
                                            {
                                                "example_id": "cae73996-afed-48e3-bbab-ac5460ac1a6c",
                                                "sense_id": "a3c65283-f439-350e-b154-fd8d4e39de22",
                                                "text": "„Ich sprang auf den nächstbesten Trolleybus, der daherkam, und ließ mich auf einen der hinteren Sitze fallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9431bbc7-97af-4c72-883c-84e372eb0278",
                        "source_entry_id": "f254db19-9233-3e12-98a8-c0c17d803c2a",
                        "source_sense_id": "bc8163d7-2901-3ff2-a2f2-f48be5ea38bb",
                        "target_lang_word": "троллейбус",
