                    }
                ],
                "translations": [
                    {
                        "translation_id": "da8b9e41-8770-45a1-ab4b-8f5c2410819e",
                        "source_entry_id": "c0e1596e-eb1e-3102-ba35-cd223882224b",
                        "source_sense_id": "3da57f9f-cdae-3a19-bf2c-a6930be4018a",
                        "target_lang_word": "pathetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pathetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd64667b-6412-3385-acef-840902490d23",
                                        "entry_id": "3bdad8c0-6ed9-348d-9db4-fe3eada51786",
                                        "glosses": [
                                            "Arousing pity, sympathy, or compassion; exciting pathos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfae5309-e80e-4065-9d32-5e595b47d08f",
                                                "sense_id": "fd64667b-6412-3385-acef-840902490d23",
                                                "text": "The child’s pathetic pleas for forgiveness stirred the young man’s heart."
                                            },
                                            {
                                                "example_id": "f475e025-2a1b-4c3c-8284-dd5d6f612ffe",
                                                "sense_id": "fd64667b-6412-3385-acef-840902490d23",
                                                "text": "We have now arrived at one of the most pathetic and glorious events in the history of Israel, one which sanctifies the Lamanite race with the powers of martyrdom, and, by the blood of the victims, washes its garments white from many a former sin."
                                            },
                                            {
                                                "example_id": "186a0163-fc52-4e71-949d-445730061cea",
                                                "sense_id": "fd64667b-6412-3385-acef-840902490d23",
                                                "text": "She held his hand in one of hers, but she too was dozing, and the two made a pretty, or rather a pathetic, picture."
                                            },
                                            {
                                                "example_id": "5ecbf392-1f13-4476-b454-0bb970696aeb",
                                                "sense_id": "fd64667b-6412-3385-acef-840902490d23",
                                                "text": "There was no hospital, or any accommodation for the sick men. Each mate nursed his fellow, and some strikingly pathetic touches of devotion were shown here and there amongst them."
                                            },
                                            {
                                                "example_id": "329f3d5d-a19e-4704-97eb-8950b3ae4ca2",
                                                "sense_id": "fd64667b-6412-3385-acef-840902490d23",
                                                "text": "[H]e was led away to a private sanitarium for mental disease, while in the newspapers appeared pathetic accounts of his mental breakdown and of the saintliness of his character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2b8d2f0-5988-3728-ac9a-05ae45c58e47",
                                        "entry_id": "3bdad8c0-6ed9-348d-9db4-fe3eada51786",
                                        "glosses": [
                                            "Arousing scorn or contempt, often due to miserable inadequacy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4de6eab4-b6b7-4947-a808-4a63bd4ecdf1",
                                                "sense_id": "b2b8d2f0-5988-3728-ac9a-05ae45c58e47",
                                                "text": "You can't even run two miles? That’s pathetic."
                                            },
                                            {
                                                "example_id": "a3ac1218-57d4-45e5-8ed6-d59164ed685a",
                                                "sense_id": "b2b8d2f0-5988-3728-ac9a-05ae45c58e47",
                                                "text": "You're almost 26 years old and you still can't hold a real job? That's pathetic."
                                            },
                                            {
                                                "example_id": "248ecf6b-c88d-4b5e-8ffd-2acdd6e6e73d",
                                                "sense_id": "b2b8d2f0-5988-3728-ac9a-05ae45c58e47",
                                                "text": "Well you'd better think of something because middle-aged tramps aren't cute, they're pathetic."
                                            },
                                            {
                                                "example_id": "553ff039-dfb0-465f-b71b-b45da2d0dd44",
                                                "sense_id": "b2b8d2f0-5988-3728-ac9a-05ae45c58e47",
                                                "text": "Look, I-I hate to sound like Billy Baldwin’s agent, but you can’t just copy everything that ALEC does! It’s pathetic!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "531e7f91-3947-30a7-842d-d19f94d817fa",
                                        "entry_id": "3bdad8c0-6ed9-348d-9db4-fe3eada51786",
                                        "glosses": [
                                            "Expressing or showing anger; passionate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4de1f29-08f4-447c-b60f-f7ccb7c8e799",
                                                "sense_id": "531e7f91-3947-30a7-842d-d19f94d817fa",
                                                "text": "On a certain Good Friday, in what year we are not told, an especially moving and pathetic sermon was preached in the Cathedral by Father John Texeda, upon the sufferings of our Lord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd1eea95-5ce2-32cb-8cd1-8269c671c9a8",
                                        "entry_id": "3bdad8c0-6ed9-348d-9db4-fe3eada51786",
                                        "glosses": [
                                            "Trochlear."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
