                            {
                                "target_word": "jammer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5652e3fe-94d9-38de-bddf-b79402ebf0ea",
                                        "entry_id": "9363500b-3a59-33b8-980f-f169258d83d5",
                                        "glosses": [
                                            "muzikant die met andere muzikanten onvoorbereid en improviserend samenspeelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4333438e-bc66-4f6e-b442-bf8ece71f886",
                                                "sense_id": "5652e3fe-94d9-38de-bddf-b79402ebf0ea",
                                                "text": "Vanaf circa zes uur is er nog ruim gelegenheid voor de jammers (met instrument of stem) om deze fantastische begeleiding eens “uit te proberen”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9df35b-cca0-35cd-8094-d5677c347120",
                                        "entry_id": "9363500b-3a59-33b8-980f-f169258d83d5",
                                        "glosses": [
                                            "apparaat dat elektromagnetische straling gebruikt om de werking van afluisterapparatuur, mobiele telefoons of wifi te blokkeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ab26b4-bafc-4ad7-8c10-0a1a422ea5af",
                                                "sense_id": "aa9df35b-cca0-35cd-8094-d5677c347120",
                                                "text": "Zodra de ‘jammer’ wordt aangezet valt de GSM uit en dat is ook de bedoeling, hij valt in zekere zin onder de Electronic Counter Measures die de mens ter beschikking staan om de medemens tot de orde te roepen. Maar bezit en gebruik van de jammer is in bijna heel de wereld volstrekt verboden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d676eca-6b65-3455-b368-31caaa99c979",
                                        "entry_id": "9363500b-3a59-33b8-980f-f169258d83d5",
                                        "glosses": [
                                            "apparaat dat elektromagnetische straling gebruikt om communicatie en wapens van de tegenstander te verstoren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a904244-6bf9-427d-9b65-52cad87d710a",
                                                "sense_id": "8d676eca-6b65-3455-b368-31caaa99c979",
                                                "text": "Lastig is natuurlijk dat de inzet van jammers als deze in Nederland in beginsel verboden is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
