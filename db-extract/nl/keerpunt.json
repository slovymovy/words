                "senses": [
                    {
                        "sense_id": "cd7863e1-ac8e-3b5c-9372-7883aae6bd39",
                        "entry_id": "35fd454a-7bb9-3733-ba3e-3e480e002460",
                        "glosses": [
                            "plaats waar men om moet of kan keren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a476c20-9b83-43bd-9066-83a319b8f538",
                                "sense_id": "cd7863e1-ac8e-3b5c-9372-7883aae6bd39",
                                "text": "Bij het laatste keerpunt in het water bij Odaiba, een kunstmatig eiland in de baai van Tokio, lag Sharon van Rouwendaal voor een op haar ongewone positie. Als vierde ging ze om de gele boei, op een armlengte achterstand van de Braziliaanse Ana Marcela Cunha. Het was een bewuste keuze geweest, zo zei de 27-jarige openwaterzwemster na de race tegen de NOS."
                            }
                        ]
                    },
                    {
                        "sense_id": "790a5f02-6231-3041-af46-2beff9c4f9fc",
                        "entry_id": "35fd454a-7bb9-3733-ba3e-3e480e002460",
                        "glosses": [
                            "moment waarop een ontwikkeling blijvend en ingrijpend van richting verandert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ce89010-f8d2-42d5-8fbb-6bd09331f06e",
                                "sense_id": "790a5f02-6231-3041-af46-2beff9c4f9fc",
                                "text": "Dit is een keerpunt in de wereldgeschiedenis. Rusland is vanaf nu een vijand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa030f56-c8d3-4fab-af57-c2c3dea4f108",
                        "source_entry_id": "35fd454a-7bb9-3733-ba3e-3e480e002460",
                        "target_lang_word": "Wendepunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wendepunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9431b78-4361-37cb-9478-36a40e7b7b6f",
                                        "entry_id": "3839ff52-5a95-37de-b4a2-96ab66ff3c5f",
                                        "glosses": [
                                            "die Stelle, an der gewendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61326a3b-0005-4492-a198-9664ac3ecdea",
                                                "sense_id": "c9431b78-4361-37cb-9478-36a40e7b7b6f",
                                                "text": "Am Wendepunkt konnte die Verfolgergruppe etliche Meter wettmachen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d10fddc-c53f-3220-ab2b-947fce242114",
                                        "entry_id": "3839ff52-5a95-37de-b4a2-96ab66ff3c5f",
                                        "glosses": [
                                            "Zeitpunkt, an dem sich etwas bedeutend verändert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "decb5eac-b1f8-4857-8f2e-e4555db5dfe0",
                                                "sense_id": "3d10fddc-c53f-3220-ab2b-947fce242114",
                                                "text": "Die Scheidung war ein Wendepunkt in ihrem Leben."
                                            },
                                            {
                                                "example_id": "2c42ee1a-b5d5-448c-9656-be280182828a",
                                                "sense_id": "3d10fddc-c53f-3220-ab2b-947fce242114",
                                                "text": "„Das ist der Wendepunkt in Timos Leben.“"
                                            },
                                            {
                                                "example_id": "32340579-d6d4-49ea-8e69-bd73c269074a",
                                                "sense_id": "3d10fddc-c53f-3220-ab2b-947fce242114",
                                                "text": "Er [der Zweite Prager Fenstersturz am 23.5.1618] markiert den Beginn des Dreißigjährigen Krieges und stellt einen wichtigen Wendepunkt in der Geschichte Europas dar."
                                            },
                                            {
                                                "example_id": "aede9a91-9f81-4765-8d92-a84d57051c77",
                                                "sense_id": "3d10fddc-c53f-3220-ab2b-947fce242114",
                                                "text": "„Die Wahl des neuen Ministerpräsidenten in Thüringen mit Unterstützung der radikalrechten AfD ist ein Wendepunkt in der deutschen Politik […].“"
                                            },
                                            {
                                                "example_id": "403d4212-d334-45e5-81bf-7516609cecbe",
                                                "sense_id": "3d10fddc-c53f-3220-ab2b-947fce242114",
                                                "text": "„Das Datum dieser Erfindung wird als Wendepunkt in die Geschichte der deutschen Touristik eingehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9e02f298-71a4-30a2-adee-40986d85be0a",
                                        "entry_id": "3839ff52-5a95-37de-b4a2-96ab66ff3c5f",
                                        "glosses": [
                                            "Punkt eines Funktionsgraphen mit der lokal größten oder kleinsten Steigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f13f5e4-0e48-4378-9c7e-a96f88ad612d",
                                                "sense_id": "9e02f298-71a4-30a2-adee-40986d85be0a",
                                                "text": "Die Graphen aller kubischen Funktionen sind punktsymmetrisch. Symmetriezentrum ist jeweils der (einzige) Wendepunkt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6991cd5b-35ac-31da-822a-9b84c742a403",
                                        "entry_id": "3839ff52-5a95-37de-b4a2-96ab66ff3c5f",
                                        "glosses": [
                                            "in der populären Darstellung wirtschaftlicher Zusammenhänge oft fälschlich für Extremwert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93fe296e-be70-450c-8880-930c7f465f45",
                                                "sense_id": "6991cd5b-35ac-31da-822a-9b84c742a403",
                                                "text": "„Die Rückrufaktionen haben den oberen Wendepunkt erreicht“, schätzt der Celerant-Berater Habeck"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "988e7307-8410-4ceb-9abf-633d82ba06de",
                        "source_entry_id": "35fd454a-7bb9-3733-ba3e-3e480e002460",
                        "target_lang_word": "turning point",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turning point",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ce36bd2-58b5-3bd8-8c43-fb14cbd89f00",
                                        "entry_id": "347edcd9-e897-362f-bd88-3ff63703ec17",
                                        "glosses": [
                                            "A decisive point at which a significant change or historical event occurs, or at which a decision must be made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3fd793-1a64-4fd5-8af9-951c1cd085ab",
                                                "sense_id": "2ce36bd2-58b5-3bd8-8c43-fb14cbd89f00",
                                                "text": "Another turning point, a fork stuck in the road / Time grabs you by the wrist, directs you where to go"
                                            },
                                            {
                                                "example_id": "33b891ef-4a4f-419e-bc9e-4076c156143a",
                                                "sense_id": "2ce36bd2-58b5-3bd8-8c43-fb14cbd89f00",
                                                "text": "Europe will be watching the final battle closely. A Hollande victory in the second round would be a turning point in European politics, a rare victory for the left in Europe, which has in recent years moved towards the right"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e0b7236-6a76-3ea4-b9af-88e1abc47037",
                                        "entry_id": "347edcd9-e897-362f-bd88-3ff63703ec17",
                                        "glosses": [
                                            "A maximum or minimum on a graph."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c4b8bc9-391f-3479-a8ff-042eae36794b",
                                        "entry_id": "347edcd9-e897-362f-bd88-3ff63703ec17",
                                        "glosses": [
                                            "A crossroads."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f41e486c-4221-3281-9d0d-9d02073f6158",
                                        "entry_id": "347edcd9-e897-362f-bd88-3ff63703ec17",
                                        "glosses": [
                                            "A T-junction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89e46ffd-8653-349d-bd36-58aa9fbbf6c7",
                                        "entry_id": "347edcd9-e897-362f-bd88-3ff63703ec17",
                                        "glosses": [
                                            "A place at which one changes their direction of travel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dbaa65b-ff46-4e05-9402-f550a2d4e517",
                                                "sense_id": "89e46ffd-8653-349d-bd36-58aa9fbbf6c7",
                                                "text": "Chicago was the turning point of my journey and I left there at midnight abroad ^([sic]) the \"Chicagoan,\" an express of the New York Central System."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c6c017c-c6be-4965-9591-e80f53094f97",
                        "source_entry_id": "35fd454a-7bb9-3733-ba3e-3e480e002460",
                        "target_lang_word": "tournant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tournant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6207af4-36a9-386c-91ab-b75e0dc4d995",
                                        "entry_id": "779e3768-dd1f-3523-ba9e-ab485bea5bce",
                                        "glosses": [
                                            "Endroit où un chemin, un cours d’eau, ou tout autre type de voie, change de direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baf03bac-1f7d-4e6f-9d17-60520bea67d4",
                                                "sense_id": "b6207af4-36a9-386c-91ab-b75e0dc4d995",
                                                "text": "L'endroit, que l'un de ces oiseaux fréquente le plus souvent, étant bien connu, c'est en général près d'un tournant d’eau, on y fiche un pieu pour y attacher et tendre le piège nommé sauterelle, avec quoi il est bientôt pris."
                                            },
                                            {
                                                "example_id": "73cd881c-1b30-4838-b1a7-6896632ff805",
                                                "sense_id": "b6207af4-36a9-386c-91ab-b75e0dc4d995",
                                                "text": "À certains tournants, quelques quinquets rougeoyaient indiquant le circuit que l’on décrivait dans ces atermoiements de lumière et d’ombre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dd706d9-94e1-3656-b98e-d238965b6967",
                                        "entry_id": "779e3768-dd1f-3523-ba9e-ab485bea5bce",
                                        "glosses": [
                                            "Fait de modifier sa trajectoire lors d’un déplacement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d2d8d79-ee05-40cb-9c23-55a5cec4959c",
                                                "sense_id": "6dd706d9-94e1-3656-b98e-d238965b6967",
                                                "text": "Ce chauffeur n’a pas bien pris son tournant, a mal pris son tournant."
                                            },
                                            {
                                                "example_id": "4c37f1ac-9bdf-45c6-8749-6b6d3710ecb9",
                                                "sense_id": "6dd706d9-94e1-3656-b98e-d238965b6967",
                                                "text": "À la prochaine intersection, faire un tournant à gauche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaca4ff3-3f49-3e88-b8ec-9d5a9264e784",
                                        "entry_id": "779e3768-dd1f-3523-ba9e-ab485bea5bce",
                                        "glosses": [
                                            "Moment capital, décisif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9737412a-371d-400c-b385-3964dcf7a91f",
                                                "sense_id": "aaca4ff3-3f49-3e88-b8ec-9d5a9264e784",
                                                "text": "— Ah ! c’est bien cela, cria-t-il, nous en sommes bien à ce tournant de la fin du siècle, dans la fatigue, dans l’énervement de l’effroyable masse de connaissances qu’il a remuées…"
                                            },
                                            {
                                                "example_id": "8f7eaf7c-0ebe-4949-9ff9-27895e93bb92",
                                                "sense_id": "aaca4ff3-3f49-3e88-b8ec-9d5a9264e784",
                                                "text": "En 2020, le marché du sex-toy devrait peser quelque 50 milliards d'euros, et c'est un excellent argument pour que le « green business » s'y intéresse. Ainsi huiles de massage bio, lubrifiants naturels à la sève d'arbre de kiwi, préservatifs « éthiques », dont le latex est issu de forêts indiennes gérées durablement, et ce dans le cadre du processus de commerce équitable : l'industrie du sexe sait donc prendre son tournant écologique !"
                                            },
                                            {
                                                "example_id": "14ef9c40-97d5-4a00-935b-2431f4009af9",
                                                "sense_id": "aaca4ff3-3f49-3e88-b8ec-9d5a9264e784",
                                                "text": "Ça dort à Québec concernant la culture, alors que nous nous trouvons à un tournant crucial."
                                            },
                                            {
                                                "example_id": "c203b735-614a-440d-9dd7-42b25a84a040",
                                                "sense_id": "aaca4ff3-3f49-3e88-b8ec-9d5a9264e784",
                                                "text": "Si l'historien tend à exagérer l'« innovationnisme » de la démocratie péricléenne, il permet néanmoins de repérer, par contraste, un tournant majeur : à partir de 411 et, plus encore, de 403, s'imposent un discours et des pratiques civiques valorisant le passé de façon obsédante […]."
                                            },
                                            {
                                                "example_id": "cfb10dd3-9cd2-42ac-bb00-add68622a9d7",
                                                "sense_id": "aaca4ff3-3f49-3e88-b8ec-9d5a9264e784",
                                                "text": "Nous avons tendance, parce que les séquences politiques et électorales sont ainsi faites, à considérer que ces séquences sont vraiment un tournant. Mais c'est plutôt notre attention qui se porte sur ces réseaux sociaux à ces moments-là. Et on s'en aperçoit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ece7ea4e-5626-323a-864c-e21e78e2cb5e",
                                        "entry_id": "779e3768-dd1f-3523-ba9e-ab485bea5bce",
                                        "glosses": [
                                            "Moyen détourné employé pour réussir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f0fb00e-0167-41c5-be2e-66891ac249e7",
                                                "sense_id": "ece7ea4e-5626-323a-864c-e21e78e2cb5e",
                                                "text": "Je prendrai un tournant pour arriver jusqu’à lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac769d58-8ee0-3e4d-b73c-4d0a4e3ddb80",
                                        "entry_id": "779e3768-dd1f-3523-ba9e-ab485bea5bce",
                                        "glosses": [
                                            "Tirage de la quatrième carte du tableau, après le flop et avant la rivière."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tournant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf62172-7402-3e46-9f78-bdc3f5bf7df0",
                                        "entry_id": "c4e3f53b-4096-3dd1-9b06-16c1ff5e1a36",
                                        "glosses": [
                                            "Participe présent de tourner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1590d37-0599-43d3-9c6e-a4d6a72e99c8",
                                                "sense_id": "9cf62172-7402-3e46-9f78-bdc3f5bf7df0",
                                                "text": "L’eau frangeait les ramures, alourdissait les fils d’araignée, imbibait les écorces gluantes, et des feuilles tombaient, çà et là, en tournant, dans le tranquille égouttement, dans le grand calme profond."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tournant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fae6cd8-b0eb-341e-ad5f-85de7a933f4c",
                                        "entry_id": "b41f02fc-9845-3cb7-859f-1a5d353ce0eb",
                                        "glosses": [
                                            "Qui tourne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06596f4c-77e1-4153-9acc-f614be1affde",
                                                "sense_id": "6fae6cd8-b0eb-341e-ad5f-85de7a933f4c",
                                                "text": "Il réussit à traverser sans accroc et à se glisser par un mouvement tournant dans la coulisse latérale […]."
                                            },
                                            {
                                                "example_id": "c9f21348-5150-4c33-a34d-0b559c6c51d6",
                                                "sense_id": "6fae6cd8-b0eb-341e-ad5f-85de7a933f4c",
                                                "text": "L’escalier tournant, à marches de bois vermoulues, gémissait et craquait sous nos pas."
                                            },
                                            {
                                                "example_id": "6e3b8581-7929-4975-a7e6-660b40ebebf7",
                                                "sense_id": "6fae6cd8-b0eb-341e-ad5f-85de7a933f4c",
                                                "text": "Quoiqu’elle le connût bien par ce que son père lui en avait raconté, elle s’était un peu perdue dans le dédale des rues tournantes."
                                            },
                                            {
                                                "example_id": "458eaa08-beb5-47f1-a73d-a89c50580993",
                                                "sense_id": "6fae6cd8-b0eb-341e-ad5f-85de7a933f4c",
                                                "text": "Il en va de même pour les lames de votre tondeuse à gazon ! Les lames tournantes qui se trouvent sous votre tondeuse finissent avec le temps par s’émousser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f624f43f-5aa6-3b1b-9386-a498e57ccc3b",
                                        "entry_id": "b41f02fc-9845-3cb7-859f-1a5d353ce0eb",
