            {
                "entry_id": "1b4a0c62-0be1-339d-a728-8cfd2fdf3314",
                "word": "Schwermut",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "91dbf68e-cca6-4766-a6b0-6c49d8f3aa3e",
                        "entry_id": "1b4a0c62-0be1-339d-a728-8cfd2fdf3314",
