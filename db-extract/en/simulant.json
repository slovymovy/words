                        "sense_id": "b0394dbc-eca4-352b-85b8-02d3cad583da",
                        "entry_id": "49f6939a-bb80-3a25-a814-70f902366458",
                        "glosses": [
                            "Something that simulates something else such as a gemstone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fff9ccfd-9c7d-43c5-9f1e-44c287c3ba87",
                                "sense_id": "b0394dbc-eca4-352b-85b8-02d3cad583da",
                                "text": "Due to its low cost and close visual likeness to diamond, cubic zirconia has remained the most gemologically and economically important diamond simulant since 1976."
                            },
                            {
                                "example_id": "bb4bca12-f5d2-4523-a155-8e5b919f21eb",
                                "sense_id": "b0394dbc-eca4-352b-85b8-02d3cad583da",
                                "text": "He could invent a fictional restaurant for you to bite your burger at but any fictional restaurant would be, like Nomenex, a worthless simulant or inconcinne imitation, a placebic generic."
                            },
                            {
                                "example_id": "9a905707-92d0-4959-907a-327e1251e78e",
                                "sense_id": "b0394dbc-eca4-352b-85b8-02d3cad583da",
                                "text": "The soil sample, called LZS-1, is the latest in a list of lunar regolith simulants of varying quality that have been developed to help Nasa and other space agencies around the world prepare for missions to the Moon."
                            }
                        ]
                    }
