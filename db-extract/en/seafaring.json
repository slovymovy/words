                        "entry_id": "00e7b4db-6921-31a8-9790-86fc5c970f8b",
                        "glosses": [
                            "Living one's life at sea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02de3251-52ca-4cb9-bd60-50d29c1b6345",
                                "sense_id": "fe08acc9-beb9-3a46-8253-7a89deb85f00",
                                "text": "There was absolutely nothing about the body to suggest that it might possibly in life have known a maritime experience. It was the body of a low type of man or a high type of beast. In neither instance would it have been of a seafaring race. Therefore I deduced that it was native to Caprona--that it lived inland, and that it had fallen or been hurled from the cliffs above."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ce2b9ee-7c5b-306c-af31-ef61a63c3c0d",
                        "entry_id": "00e7b4db-6921-31a8-9790-86fc5c970f8b",
                        "glosses": [
                            "Fit to travel on the sea; seagoing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55f75ca0-cfeb-4e32-a82e-5c14fdd2ec22",
                                "sense_id": "9ce2b9ee-7c5b-306c-af31-ef61a63c3c0d",
                                "text": "A rowing boat is not a seafaring craft."
                            }
                        ]
