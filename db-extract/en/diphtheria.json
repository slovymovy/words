                                        "sense_id": "5992c869-04ec-3f09-93ba-7e37b48ae6cd",
                                        "entry_id": "b898f4fe-b02c-35b2-a5d8-4daafc57939f",
                                        "glosses": [
                                            "infectieziekte gekenmerkt door een slijmvliesontsteking van onder andere de keel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95660ea9-8837-4fb0-b371-c3003574aba7",
                                                "sense_id": "5992c869-04ec-3f09-93ba-7e37b48ae6cd",
                                                "text": "Difterie was voordat vaccinatie algemeen gebruikelijk werd een van de meest voorkomende doodsoorzaken bij kinderen"
                                            }
                                        ]
                                    }
                                ]
                            }
