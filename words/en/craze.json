                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "02cc383f-7682-340b-806b-76903e588491",
                    "sense_definition": "To cause someone to become insane or to derange their intellect",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "make_insane",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise and lack of sleep began to <w>craze</w> the prisoners.",
                            "target_lang_translations": {
                                "ru": "Постоянный шум и недостаток сна начали <w>сводить с ума</w> заключенных."
                            }
                        },
                        {
                            "text": "It was said that grief over the loss of his family would <w>craze</w> his wits entirely.",
                            "target_lang_translations": {
                                "ru": "Говорили, что горе от потери семьи полностью <w>лишит</w> его рассудка."
                            }
                        }
                    ],
                    "synonyms": [
                        "derange",
                        "madden",
                        "unbalance"
                    ],
                    "antonyms": [
                        "soothe",
                        "calm"
                    ],
                    "common_phrases": [
                        "craze the wits"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often found in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сводить с ума или приводить в состояние помешательства"
