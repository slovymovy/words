                                "target_senses": [
                                    {
                                        "sense_id": "cf251dbd-62be-33b5-a579-1cac922e5577",
                                        "entry_id": "50e11dc6-04f5-3eb8-8aaf-60483d410f38",
                                        "glosses": [
                                            "The support about which a lever pivots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4511bd05-76f9-4a2e-9177-de3c9fecfe24",
                                                "sense_id": "cf251dbd-62be-33b5-a579-1cac922e5577",
                                                "text": "It is possible to flick food across the table using your fork as a lever and your finger as a fulcrum."
                                            },
                                            {
                                                "example_id": "d3473d1b-632b-473a-85e8-0980548a741e",
                                                "sense_id": "cf251dbd-62be-33b5-a579-1cac922e5577",
                                                "text": "MILDRED: Archimedes said give me a lever long enough and a fulcrum on which to place it and I will move the world.\nCHARLOTTE: Yeah she said that twaddle eight or nine times."
                                            },
                                            {
                                                "example_id": "7a9957ba-8f6f-4fa3-b89a-7b700d954c6e",
                                                "sense_id": "cf251dbd-62be-33b5-a579-1cac922e5577",
                                                "text": "A doorknob of whatever roundish shape is effectively a continuum of levers, with the axis of the latching mechanism—known as the spindle—being the fulcrum about which the turning takes place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a905819c-acda-3463-a7e3-1d3fb8290b81",
                                        "entry_id": "50e11dc6-04f5-3eb8-8aaf-60483d410f38",
                                        "glosses": [
                                            "A crux or pivot; a central point."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66645c2e-be26-49b7-bb92-5a5504cc2916",
                                                "sense_id": "a905819c-acda-3463-a7e3-1d3fb8290b81",
                                                "text": "By this point the fulcrum of concern is the stuprum of men upon men, described as more prevalent than that upon women."
                                            },
                                            {
                                                "example_id": "e907bbbc-fccb-4d3c-841a-c63592d2be5d",
                                                "sense_id": "a905819c-acda-3463-a7e3-1d3fb8290b81",
                                                "text": "Chelsea's Mason Mount is a top-class talent while West Ham midfielder Declan Rice has moved his game on to another level this season and will be the fulcrum of England's midfield this summer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
