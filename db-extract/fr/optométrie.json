                        "entry_id": "7661999d-df65-377d-a53e-3fd2ab703a69",
                        "glosses": [
                            "Ensemble des procédés médicaux destiné à mesurer les propriétés optiques de l’œil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c4db369-4f82-459a-ad34-e3ccbc8cce9c",
                                "sense_id": "f19a496a-b0cb-375d-90ad-76f2b9fc1ce4",
                                "text": "De plus, la famille n’est pas admissible aux prestations spéciales de l’aide sociale comme les soins dentaires et d’optométrie, les frais de déplacement à l’hôpital, etc."
                            }
                        ]
                    }
                ],
