    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8e55e4f6-fec5-33fa-b136-a9ac55ec0af0",
                "word": "Zinnia",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "067e9fd9-acef-334d-bc74-436e497bef1c",
                        "entry_id": "8e55e4f6-fec5-33fa-b136-a9ac55ec0af0",
                        "glosses": [
                            "A female given name from English from the flower"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c489f8-ce00-4e40-9775-e39d688ea42b",
                                "sense_id": "067e9fd9-acef-334d-bc74-436e497bef1c",
                                "text": "Zinnia had already attained fifty, I guessed, and wore a professional white coat over a grey flannel skirt. In spite of her colourful name she had short grey hair hair, no lipstick, flat-heeled shoes and an air of tiredness, […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ffe55085-fc9d-3399-8d42-f1788fb3afbe",
                "word": "zinnia",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8d866d72-e6c8-4569-84ea-51014f9ff55b",
                        "entry_id": "ffe55085-fc9d-3399-8d42-f1788fb3afbe",
                        "tags": [
                            "plural"
                        ],
                        "form": "zinnias"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a788a41f-7383-304e-8394-a713ae5d492f",
                        "entry_id": "ffe55085-fc9d-3399-8d42-f1788fb3afbe",
                        "glosses": [
                            "Any of several brightly coloured flowering plants, of the genus Zinnia, native to tropical America; old maid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "019cc803-542b-4249-84b9-d1091c8537a7",
                                "sense_id": "a788a41f-7383-304e-8394-a713ae5d492f",
                                "text": "[…]the Consul at this moment greeted Mr. Quincey's cat, momentarily forgetting its owner again as the grey, meditative animal, with a tail so long it trailed on the ground, came stalking through the zinnias: […]"
                            },
                            {
                                "example_id": "4ada17dc-7e53-4ad6-a23c-6dc69eb1a623",
                                "sense_id": "a788a41f-7383-304e-8394-a713ae5d492f",
                                "text": "Santa sighed at the unfairness of it all and slammed the picture down on the mantelpiece among the bowl of wax fruit and the bouquet of paper zinnias and the statue of the Virgin Mary and the figurine of the Infant of Prague."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f5bc8e1-8341-4028-a01a-c97ff6f99ac9",
                        "source_entry_id": "ffe55085-fc9d-3399-8d42-f1788fb3afbe",
                        "source_sense_id": "a788a41f-7383-304e-8394-a713ae5d492f",
