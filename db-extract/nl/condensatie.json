                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bebf45b-1f60-4f5a-9f5f-e3bd20b6a7a5",
                                                "sense_id": "cd61b030-742d-3ce6-a0ec-93412eb42743",
                                                "text": "La condensation des vapeurs ou nuages donne lieu à la pluie ou à la neige, suivant les températures."
                                            }
                                        ]
                                    },
