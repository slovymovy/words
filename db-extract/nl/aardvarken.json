                "senses": [
                    {
                        "sense_id": "af5f18a3-fa99-3eee-a1b5-f0e600ed8789",
                        "entry_id": "c27bba14-450e-3044-8b3b-00663d26b9a8",
                        "glosses": [
                            "bepaald soort zoogdier, Orycteropus afer, dat een lange, kleverige tong heeft, vooral 's nachts actief is en voorkomt in vrijwel geheel Afrika ten zuiden van de Sahara, als enige overlevende vertegenwoordiger van de orde der buistandigen (Tubulidentata)"
                        ],
                        "tags": [
                            "buistandigen"
                        ],
                        "examples": [
                            {
                                "example_id": "7d0f9997-6b9c-4de6-868e-4c7816935568",
                                "sense_id": "af5f18a3-fa99-3eee-a1b5-f0e600ed8789",
                                "text": "Heeft u een afbeelding van een aardvarken voor mij?"
                            },
                            {
                                "example_id": "ed57e950-2c36-4ff0-9e8e-909acddda9ce",
                                "sense_id": "af5f18a3-fa99-3eee-a1b5-f0e600ed8789",
                                "text": "Niet ver van hem af bewoog zich een klein dier. Het was bruin en ongeveer zo groot als een aardvarken."
                            },
                            {
                                "example_id": "9350b693-0ee0-4ff2-8f9e-4ad5e03f62c4",
                                "sense_id": "af5f18a3-fa99-3eee-a1b5-f0e600ed8789",
                                "text": "⧖ De Aardvarkens zyn ontrent de borstels de Europeaansche zwynen gelyk behalven dat geenen eenigzins donker-roder zyn als deze, en dat zy over den rug zulke borstels niet hebben, als de Europeaanschen."
                            }
                        ]
                    }
                ],
