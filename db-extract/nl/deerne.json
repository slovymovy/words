                "senses": [
                    {
                        "sense_id": "e87a80fb-de85-3deb-a195-eb0c06782aa1",
                        "entry_id": "84e942ce-4f51-3334-bd20-d0cc5db0f519",
                        "glosses": [
                            "jong onschuldig meisje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38d8300-2d03-4f2c-8362-ab5bbb305acf",
                                "sense_id": "e87a80fb-de85-3deb-a195-eb0c06782aa1",
                                "text": "Er komt nu iemand van de thuiszorg die me onder de douche zet. Ik voel me net een kindje. Sta je daar naakt te wezen, terwijl zo'n prachtige deerne je wast. Zó komisch. Ik moet er elke dag weer om schateren."
                            },
                            {
                                "example_id": "d9576172-9150-4dfa-bde6-7a949ede0545",
                                "sense_id": "e87a80fb-de85-3deb-a195-eb0c06782aa1",
                                "text": "Een Spaanse soldaat lag tijdens de Tachtigjarige Oorlog (1568-1648) nabij Eindhoven gelegerd. Daar verwekte deze Don Juan één of meer kinderen bij een lokale deerne. En toen hij in Duitsland moest vechten, schoot hij ook niet alleen met zijn musket."
                            },
                            {
                                "example_id": "97bcb560-b918-481d-80fe-1f83be36322a",
                                "sense_id": "e87a80fb-de85-3deb-a195-eb0c06782aa1",
                                "text": "Hoewel ma oogt als een jonge deerne, loopt ze al aardig tegen de zestig."
                            }
                        ]
                    }
                ],
