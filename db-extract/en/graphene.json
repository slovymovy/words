    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1e758fe9-818d-3511-ae43-690b90339f51",
                "word": "graphene",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8a7f4e9b-472c-4745-bbf0-329f117a0c22",
                        "entry_id": "1e758fe9-818d-3511-ae43-690b90339f51",
                        "tags": [
                            "plural"
                        ],
                        "form": "graphenes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f2fb67c-36a2-3655-8016-c83c97ea0a33",
                        "entry_id": "1e758fe9-818d-3511-ae43-690b90339f51",
                        "glosses": [
                            "Any polycyclic aromatic hydrocarbon having the structure of part of a layer of graphite."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "486a3f27-ce3c-3829-a065-3d05a72f23d0",
                        "entry_id": "1e758fe9-818d-3511-ae43-690b90339f51",
                        "glosses": [
                            "An arbitrarily large-scale, one-atom-thick layer of graphite, an allotrope of carbon, that has remarkable electric characteristics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df07b458-d932-40aa-ac28-ce86aae74e72",
                                "sense_id": "486a3f27-ce3c-3829-a065-3d05a72f23d0",
                                "text": "Graphene is the strongest, thinnest material known to exist. A form of carbon, it can conduct electricity and heat better than anything else. And get ready for this: It is not only the hardest material in the world but also one of the most pliable. Only a single atom thick, it has been called the wonder material. Graphene could change the electronics industry, ushering in flexible devices, supercharged quantum computers, electronic clothing and computers that can interface with the cells in your body."
                            },
                            {
                                "example_id": "40086039-7f7a-42d1-a913-c93cb99e7d34",
                                "sense_id": "486a3f27-ce3c-3829-a065-3d05a72f23d0",
                                "text": "As a microbullet impacts the graphene, the diameter of the cone it creates – determined by later examination of the petals – provides a way to measure how much energy the graphene absorbs before breaking."
                            },
                            {
                                "example_id": "85be132b-41c7-48cd-b893-2a5e23e2808f",
                                "sense_id": "486a3f27-ce3c-3829-a065-3d05a72f23d0",
                                "text": "Graphene, which consists of monolayers of carbon atoms bonded in a repeating hexagonal pattern, is the thinnest known material. It was isolated in 2004 at the University of Manchester by Andre Geim and Konstantin Novoselov, who went on to win a Nobel prize for their discovery."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf8e4d2c-f964-4ef3-ab60-a85a69453a2c",
