                                                "example_id": "5b910bf9-2b53-48e5-94b2-2b6453ca5799",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Je renonce à faire des achats cette année."
                                            },
                                            {
                                                "example_id": "767b9cd6-91fe-4f90-8295-b74a8acaedcf",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Un achat avantageux."
                                            },
                                            {
                                                "example_id": "88181abf-577c-4d0d-9a48-24d118feb7b9",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Un achat durable est un achat qui est respectueux de l’environnement, des lois sociales et de l’éthique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82e16234-e47e-33c2-96ce-023abcbe2641",
