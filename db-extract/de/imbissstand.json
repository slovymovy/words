                        "entry_id": "c9648df7-6ab4-3d9b-8caa-819ec1256feb",
                        "glosses": [
                            "Kiosk/Stand, an dem man einen Imbiss bekommen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fce4aa-bec3-4cb4-a5ae-4c1171f8d758",
                                "sense_id": "6648c0d7-5c2e-32da-9576-535d4f9a0154",
                                "text": "Es sind nur ein paar Meter bis zum nächsten Imbissstand."
                            },
                            {
                                "example_id": "17fef6a8-6204-4e62-99ea-0255ac8c0ece",
                                "sense_id": "6648c0d7-5c2e-32da-9576-535d4f9a0154",
                                "text": "„Stattdessen aßen wir an einem Imbissstand eine Bratwurst, und die Bratwurst schmeckte sehr gut, und es gab Schrippen dazu, die auch sehr gut schmeckten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
