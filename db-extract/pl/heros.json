        "pl-extract.jsonl": [
            {
                "entry_id": "1a586ce4-7db3-3aec-a6f8-3586da4011cd",
                "word": "heros",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "18c6edc7-7d24-383e-8977-ca8bc26ac18f",
                        "entry_id": "1a586ce4-7db3-3aec-a6f8-3586da4011cd",
                        "glosses": [
                            "postać o nadludzkich przymiotach, zrodzona ze związku człowieka i boga"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "9a277f09-7d30-4b86-8ff1-7fc0c0110356",
                                "sense_id": "18c6edc7-7d24-383e-8977-ca8bc26ac18f",
                                "text": "Heros błyskawicznie pchnął w niego zaczarowanym mieczem i trafił Minotaura prosto w serce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6c99da1f-dbf4-31dc-ade8-237df8d69ee1",
                        "entry_id": "1a586ce4-7db3-3aec-a6f8-3586da4011cd",
                        "glosses": [
                            "ktoś bohaterski"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "114d7637-71be-40bd-8a0f-ce7118c2effb",
                                "sense_id": "6c99da1f-dbf4-31dc-ade8-237df8d69ee1",
                                "text": "Niech herosi pobożności cię poganiają, niech kumple się śmieją, żeś dewot, a ty spaceruj po swojej Krynicy z kubkiem w ręku, to znacznie skuteczniejsze niż sinusoida: szczytowanie – zawał – szczytowanie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f4ec8ff-33ed-4e30-8ac5-7fada8490240",
                        "source_entry_id": "1a586ce4-7db3-3aec-a6f8-3586da4011cd",
                        "source_sense_id": "6c99da1f-dbf4-31dc-ade8-237df8d69ee1",
                        "target_lang_word": "hero",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hero",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4fdb6d8-275c-39e5-b04f-ee279872b3e3",
                                        "entry_id": "7447119c-a2cd-3c15-b350-1913b536b434",
                                        "glosses": [
                                            "Somebody who possesses great bravery and carries out extraordinary or noble deeds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c3fa76-7b68-4f8e-b58b-4a18b31939ed",
                                                "sense_id": "b4fdb6d8-275c-39e5-b04f-ee279872b3e3",
                                                "text": "\"I'm no hero,\" insists freckle-faced 14-year-old Freddie Hanberry. But to many of the young cancer patients, nurses and staff at University Medical Center here, he is as close as you can get. The \"hero\" talk began when a national magazine featured Hanberry, who has leukemia, in a special section called \"100 New American Heroes.\""
                                            },
                                            {
                                                "example_id": "4651a3a8-8323-43df-a76f-9be17c658605",
                                                "sense_id": "b4fdb6d8-275c-39e5-b04f-ee279872b3e3",
                                                "text": "Every cancer victim is a true hero."
                                            },
                                            {
                                                "example_id": "59b56144-8518-4112-b3b4-d0b5601ed31f",
                                                "sense_id": "b4fdb6d8-275c-39e5-b04f-ee279872b3e3",
                                                "text": "She is my hero, my heart, my baby till the end of time,” said Gabby's father"
                                            },
                                            {
                                                "example_id": "c1029825-4a42-48f4-a632-d0d9b2507513",
                                                "sense_id": "b4fdb6d8-275c-39e5-b04f-ee279872b3e3",
                                                "text": "Each flag represents a hero, Andrews said, whether a first responder or victim of 9/11, active, fallen, or retired military, special friend or family member."
                                            },
                                            {
                                                "example_id": "5cc934a2-1d00-4824-befe-3cf9239182d3",
                                                "sense_id": "b4fdb6d8-275c-39e5-b04f-ee279872b3e3",
                                                "text": "At the time, with the D-Day invasion of Europe going on, their heroism was hardly noticed. Plenty of other heroes were dying elsewhere. Plenty of bigger bits of history were being made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b55b65d-7c55-3c6d-949b-5da0bfd2537b",
                                        "entry_id": "7447119c-a2cd-3c15-b350-1913b536b434",
                                        "glosses": [
                                            "A role model."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c904823-c298-3c84-b0da-42dd5fc10167",
                                        "entry_id": "7447119c-a2cd-3c15-b350-1913b536b434",
                                        "glosses": [
                                            "The protagonist in a work of fiction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7382073e-3705-40a3-973b-9a6e0b8f9bc3",
                                                "sense_id": "3c904823-c298-3c84-b0da-42dd5fc10167",
                                                "text": "However, even this great hero of the story is somewhat of a simpleton (when he lets himself be crucially deceived by Peacock Ravana in Vibhisana's shape), and a weakling (when in spite of all his strength he is almost beaten by his own son, one of the rākṣasas)"
                                            },
                                            {
                                                "example_id": "14855bcc-8d22-4631-a196-b5328cc21ef2",
                                                "sense_id": "3c904823-c298-3c84-b0da-42dd5fc10167",
                                                "text": "Satan is wrongly called the hero of Paradise Lost. He is really the villain-hero or the counter-hero"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1007954c-4db5-3014-9fde-7039af694aa6",
                                        "entry_id": "7447119c-a2cd-3c15-b350-1913b536b434",
                                        "glosses": [
                                            "The current player, especially a hypothetical player for example and didactic purposes. Compare: villain (“any opponent player”). Not to be confused with hero call (“a weak call against a supposed bluff”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b560ca90-45a9-49e0-9a52-92f3f09cb308",
                                                "sense_id": "1007954c-4db5-3014-9fde-7039af694aa6",
                                                "text": "Let's discuss how to play if the hero has KK, and there's an ace on board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3277d7f9-b8ad-311b-84f6-6f7ace7588ad",
                                        "entry_id": "7447119c-a2cd-3c15-b350-1913b536b434",
                                        "glosses": [
                                            "A large sandwich made from meats and cheeses; a hero sandwich."
                                        ],
                                        "tags": [
                                            "New-York"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff19a086-73eb-3c6f-8db7-02c7943e1d4a",
                                        "entry_id": "7447119c-a2cd-3c15-b350-1913b536b434",
                                        "glosses": [
                                            "The product chosen from several candidates to be photographed, as in food advertising, or with props used in a movie."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a188189-f4e1-4eef-a0d6-82d72048c25a",
                                                "sense_id": "ff19a086-73eb-3c6f-8db7-02c7943e1d4a",
                                                "text": "The preparation of the hero food involves any number of specialized techniques food stylists have developed to deal with the demands of photographing food."
                                            },
                                            {
                                                "example_id": "d25f5f4a-fd17-4aad-9b78-c82f93058cab",
                                                "sense_id": "ff19a086-73eb-3c6f-8db7-02c7943e1d4a",
                                                "text": "Protect the hero food. Whether the hero items are on a table in the studio or in the refrigerator, freezer, etc., be sure they are identified as hero items and not for consumption."
                                            },
                                            {
                                                "example_id": "70a9e2d1-2b25-47d6-b28d-a58fa2db38e1",
                                                "sense_id": "ff19a086-73eb-3c6f-8db7-02c7943e1d4a",
                                                "text": "The food stylists this day had spent inordinate amounts of time preparing the hero product for a close-up scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef91aa8c-cb8d-319d-9125-46c081799726",
                                        "entry_id": "7447119c-a2cd-3c15-b350-1913b536b434",
                                        "glosses": [
                                            "The eye-catching top portion of a web page, sometimes including a hero image; the portion above the fold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea4a0b0a-9f15-3f98-abc4-7dd91fd15b74",
                                        "entry_id": "7447119c-a2cd-3c15-b350-1913b536b434",
                                        "glosses": [
                                            "The standout component of a dish; the part of a dish that should take center stage on the palate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hero",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29f8e466-a3d6-36b0-a9b0-c5ffb10cb39c",
                                        "entry_id": "e4fd8ab2-41d0-314a-af4d-b4f93415322f",
                                        "glosses": [
                                            "To act as a hero (brave person; role model; or protagonist)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a8f409e-cc1d-4b20-be46-141bb805d82c",
                                                "sense_id": "29f8e466-a3d6-36b0-a9b0-c5ffb10cb39c",
                                                "text": "“I don’t think so.” He grinned hugely, revealing smoker’s teeth and halitosis that would fell a rhino. “I don’t think you want to be heroing off just yet. I don’t think you've had a good time in ages.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2a4bd6b-2799-3433-838b-c85e17e13a49",
                                        "entry_id": "e4fd8ab2-41d0-314a-af4d-b4f93415322f",
                                        "glosses": [
                                            "To praise or laud."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf14421b-3e40-359e-852f-a5f5ea6fd196",
                                        "entry_id": "e4fd8ab2-41d0-314a-af4d-b4f93415322f",
                                        "glosses": [
                                            "To bring attention to; to highlight; to spotlight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3e871f2-b131-468a-a169-4852fbcb25d2",
                        "source_entry_id": "1a586ce4-7db3-3aec-a6f8-3586da4011cd",
                        "source_sense_id": "6c99da1f-dbf4-31dc-ade8-237df8d69ee1",
                        "target_lang_word": "Held",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Held",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aacb4ee1-b832-3a00-83ec-9ef3c1f007c8",
                                        "entry_id": "386d88c6-0a5c-314c-8d3b-a50471add73a",
                                        "glosses": [
                                            "jemand, der sich besonders mutig oder erfolgreich für andere oder für eine Sache einsetzt oder bei einem Einsatz umkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb429cc-0681-495d-bf82-bd1bb09672d4",
                                                "sense_id": "aacb4ee1-b832-3a00-83ec-9ef3c1f007c8",
                                                "text": "Dieser Held rettete seine Frau und Kinder aus dem brennenden Haus."
                                            },
                                            {
                                                "example_id": "a772b522-2c7c-4125-80b8-324bf57ffa46",
                                                "sense_id": "aacb4ee1-b832-3a00-83ec-9ef3c1f007c8",
                                                "text": "„Unglücklich das Land, das keine Helden hat!“ […] „Nein. Unglücklich das Land, das Helden nötig hat.“"
                                            },
                                            {
                                                "example_id": "bffa2104-e0c1-4cdf-82e7-fcd84607e5ac",
                                                "sense_id": "aacb4ee1-b832-3a00-83ec-9ef3c1f007c8",
                                                "text": "„Glaubt man dem Nibelungenlied, so wurde der deutsche Held Siegfried zwischen den römischen Ruinen geboren.“"
                                            },
                                            {
                                                "example_id": "285ec2c7-0e76-4683-8434-0d74b31e71ba",
                                                "sense_id": "aacb4ee1-b832-3a00-83ec-9ef3c1f007c8",
                                                "text": "Zu den bizarren Pointen der furchtbaren Terrorserie in Frankreich zählt aber auch die Tatsache, dass Muslime nicht nur Täter und Opfer, sondern auch Helden geworden sind. Am Mittwoch war es der Polizist Ahmed Merabet, ein 42-jähriger muslimischer Familienvater, den die terroristischen Kouachi-Brüder brutal ermordeten."
                                            },
                                            {
                                                "example_id": "c8cbfe10-45af-41cc-bfbf-4879c835b6ec",
                                                "sense_id": "aacb4ee1-b832-3a00-83ec-9ef3c1f007c8",
                                                "text": "„Der spricht von unseren gefallenen Helden des Krieges, von denen jeder das Neue Testament im Tornister trägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa949fb7-12f6-3e56-b6d4-048c923a2470",
                                        "entry_id": "386d88c6-0a5c-314c-8d3b-a50471add73a",
                                        "glosses": [
                                            "Hauptperson einer Geschichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb480af7-7391-41a6-93b5-339f88283604",
                                                "sense_id": "aa949fb7-12f6-3e56-b6d4-048c923a2470",
                                                "text": "„Harry Potter“ ist der Held der gleichnamigen Bücherreihe."
                                            },
                                            {
                                                "example_id": "809b9fe1-7287-4302-93b7-aed822d44ecc",
                                                "sense_id": "aa949fb7-12f6-3e56-b6d4-048c923a2470",
                                                "text": "„In der Novelle Lenz ringt der Held ausdrücklich um die religiöse Sinngebung seines Leids.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6d160d0-4795-46b9-979d-eb2548c20d79",
                        "source_entry_id": "1a586ce4-7db3-3aec-a6f8-3586da4011cd",
                        "source_sense_id": "6c99da1f-dbf4-31dc-ade8-237df8d69ee1",
                        "target_lang_word": "Heroe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heroe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95eb3858-97a6-371f-bbc0-00f638b3fcd2",
                                        "entry_id": "89248add-8405-3234-90db-0586fca5b636",
                                        "glosses": [
                                            "(antike) griechische Mythologie: große Taten vollbringender Held, götterähnlich, oft halbgöttlich (mit göttlichem Elternteil); auch mythische (heroisierte) Tote"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b520720-ab1a-48b4-b724-d22f08370545",
                                                "sense_id": "95eb3858-97a6-371f-bbc0-00f638b3fcd2",
                                                "text": "„Pindar zufolge soll der Heroe Herakles den heiligen Bezirk der Altis, auf dem die Spiele stattfanden, gestiftet haben.“"
                                            },
                                            {
                                                "example_id": "e5a3259e-7050-443f-8229-16a06e030a9b",
                                                "sense_id": "95eb3858-97a6-371f-bbc0-00f638b3fcd2",
                                                "text": "„Am anderen Ufer des Kephistos stand einst ein Altar des Zeus, an dem der Heroe Theseus ein wichtiges Opfer darbrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3798a6d8-beeb-360e-a4d3-e0394149b33f",
                                        "entry_id": "89248add-8405-3234-90db-0586fca5b636",
                                        "glosses": [
                                            "Held"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56e2f7ac-b005-4097-972a-ffcd123d5d0c",
                                                "sense_id": "3798a6d8-beeb-360e-a4d3-e0394149b33f",
                                                "text": "„Zur verbindlichen Identifikationsfigur wurde der individualisierte Held der Arbeit, der Aktivist: der Heroe als persönliches Vorbild.“"
                                            },
                                            {
                                                "example_id": "58e6c067-be88-4bfc-a57a-51a44a019818",
                                                "sense_id": "3798a6d8-beeb-360e-a4d3-e0394149b33f",
                                                "text": "„Am Ende der achziger Jahre des vorigen Jahrhunderts hatte Lessing, ein Heroe auf dem Gebiete der deutschen Sprache und Literatur den Nathan vor die Augen des Volkes gelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11946ec6-1893-43e4-8794-6637fe724f8a",
                        "source_entry_id": "1a586ce4-7db3-3aec-a6f8-3586da4011cd",
                        "source_sense_id": "18c6edc7-7d24-383e-8977-ca8bc26ac18f",
                        "target_lang_word": "Heros",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heros",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f50764fa-033e-3309-bc75-de954fd811a4",
                                        "entry_id": "c3acc5e6-1171-3de3-b328-ffca8d1bfd44",
                                        "glosses": [
                                            "große Taten vollbringender Held, götterähnlich, oft halbgöttlich (mit göttlichem Elternteil); auch mythische (heroisierte) Tote"
                                        ],
                                        "tags": [
                                            "(antike) griechische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab7218a3-908a-4c1d-940f-ac29cb1fc67d",
                                                "sense_id": "f50764fa-033e-3309-bc75-de954fd811a4",
                                                "text": "„Das unpräzise Konzept der Griechen, was ein Heros denn eigentlich sei, macht eine archäologische Identifizierung von Heroenkulten besonders schwierig.“"
                                            },
                                            {
                                                "example_id": "50e07ea5-9e12-4a58-ab81-c03317fe282e",
                                                "sense_id": "f50764fa-033e-3309-bc75-de954fd811a4",
                                                "text": "„Sie [Kastor und Polydeukes] sind für ihre Verehrer sicherlich zu jeder Zeit etwas mehr gewesen als die übrigen Heroen: Gottheiten des Himmels, untergehend, wie die Gestirne, doch an kein Grab gebunden, sondern schnelle Reiter, die, durch die Luft fahrend, von oben her eintreffen, wo immer Menschen in der Gefahr sie anrufen: Helfer und Retter in der Not der Schlachten, noch häufiger aber in der Not des Meeres.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36c1c845-9020-30e7-88b9-7b7694d62aeb",
                                        "entry_id": "c3acc5e6-1171-3de3-b328-ffca8d1bfd44",
                                        "glosses": [
                                            "Held"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e445797-c54d-4ae8-bc8b-bedf8634aaac",
                                                "sense_id": "36c1c845-9020-30e7-88b9-7b7694d62aeb",
                                                "text": "„Die ‚Kölnische Volkszeitung‘ bezweifelte das Integrationspotential Hindenburgs, da er von einem Teil der Bevölkerung als Heros im Kampf von ‚Schwarzweißrot gegen Schwarzrotgold, rechts gegen links, Monarchisten gegen Republikaner‘ angesehen werde.“"
                                            },
                                            {
                                                "example_id": "335d34d9-b2d7-4aff-bc29-70bc40eb891e",
                                                "sense_id": "36c1c845-9020-30e7-88b9-7b7694d62aeb",
                                                "text": "„Doch, abseits von den meisten von uns, so wie wir zumeist sind, gibt es jene seltenen Augenblicke, die sich als wohlgelungen erweisen – und es gibt jene außergewöhnlichen Individuen (Heroen welcher Art auch immer), die sich als ‚wohlgeraten erwiesen haben‘.“"
                                            },
                                            {
                                                "example_id": "e302b858-c5a1-46ce-9df5-ef9a193a62ba",
                                                "sense_id": "36c1c845-9020-30e7-88b9-7b7694d62aeb",
                                                "text": "„Sein privates Pantheon beherbergte nun zwei Gruppen von Heroen, die einander freundlich gegenüberstanden:…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
