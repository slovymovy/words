                "senses": [
                    {
                        "sense_id": "c8c9bd6e-ee90-3fe2-b158-514a1e2952b0",
                        "entry_id": "e6c39daa-14b0-3e2f-be73-12b6cb6046c7",
                        "glosses": [
                            "Gleichheit der Chancen für unterschiedliche Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2c0500f-caba-48de-9a04-9da72c433cc3",
                                "sense_id": "c8c9bd6e-ee90-3fe2-b158-514a1e2952b0",
                                "text": "„Zahlreiche Menschen im Land sehnen sich nach besseren Lebensverhältnissen, nach mehr Demokratie und Chancengleichheit.“"
                            },
                            {
                                "example_id": "938a7715-b4eb-4ac1-91df-7c62e59a0d30",
                                "sense_id": "c8c9bd6e-ee90-3fe2-b158-514a1e2952b0",
                                "text": "Kosten und Qualitätsstandards für Kinderbetreuung variieren von Ort zu Ort, von Einrichtung zu Einrichtung, und damit auch die Chancengleichheit von Kindern."
                            },
                            {
                                "example_id": "caf58076-0be6-4da2-b526-ec2f8698379a",
                                "sense_id": "c8c9bd6e-ee90-3fe2-b158-514a1e2952b0",
                                "text": "„BAföG soll Chancengleichheit garantieren: Auch wer keine reichen Eltern hat, soll sich ein Studium leisten können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
