                    },
                    {
                        "translation_id": "e4db2d50-4c09-4587-9ab4-a1c93b1ba90c",
                        "source_entry_id": "538b54d7-77fc-3f6d-a266-f71d03562a2c",
                        "source_sense_id": "e3f0c917-9594-3523-8e99-f6212178e09a",
                        "target_lang_word": "math",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
