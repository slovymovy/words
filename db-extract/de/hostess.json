                                "example_id": "972ab341-e14c-4891-88ff-aaa91ec95a95",
                                "sense_id": "4973e626-cdb8-3a88-847a-ec9210d005e0",
                                "text": "„Schon vormittags um elf perlt Rotkäppchen Rosè vorm Stammhaus auf der Anhöhe in den schlanken Gläsern, die von Hostessen herumgereicht werden.“"
                            }
