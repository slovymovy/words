                                ]
                            },
                            {
                                "target_word": "mosquito",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                        "entry_id": "db97ecc5-598f-3199-8854-b1b3a1691aed",
                                        "glosses": [
                                            "A small flying insect of the family Culicidae, the females of which bite humans and animals and suck blood, leaving an itching bump on the skin, and sometimes carrying diseases like malaria, dengue and yellow fever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c80bc4-636d-41cb-b41d-e7df6846d646",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "I do not quite know what it was that made me poke my head out of the friendly shelter of the blanket, perhaps because I found that the mosquitoes were biting right through it."
                                            },
                                            {
                                                "example_id": "1ffbe514-ce4d-4c24-95c8-e400393c25e7",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "We lit a driftwood fire to help keep the mosquitoes away. It was partially successful."
                                            },
                                            {
                                                "example_id": "f04377cf-5fe7-4421-b4f6-35b3b58fce78",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "Nicaragua has been investigating the possibility that the 1985 outbreak of dengue fever along its Honduran border may have resulted from the release of infected mosquitos by U.S. reconnaissance overflights."
                                            },
                                            {
                                                "example_id": "dd8dab67-4b67-46fd-b934-7cfb5191d557",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "Sue had climbed up to the rafters and attached her mosquito netting over one of the exposed beams in the ceiling, and Edgar had climbed into the bed under it so no flying buzzies would mess with his ears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cec9ed96-91e7-43e0-a23c-bddc27fa12a8",
                        "source_entry_id": "a3206e0d-1353-380e-8bf8-9607fc848391",
                        "source_sense_id": "185959ac-5ad2-368f-af61-549165a61d01",
