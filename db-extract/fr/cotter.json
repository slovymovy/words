                ],
                "senses": [
                    {
                        "sense_id": "a72b5a00-12f1-36fc-b86b-7c4a0ab18b0d",
                        "entry_id": "6863d700-9308-3dff-8bcd-ea7c03813eb9",
                        "glosses": [
                            "Variante orthographique du verbe coter."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f0bb0471-5fca-3779-b3bf-b94f5692dfe3",
                        "entry_id": "6863d700-9308-3dff-8bcd-ea7c03813eb9",
                        "glosses": [
                            "Jaillir ^([1])."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "258c4927-66a8-3c91-93e0-53a878511c80",
                        "entry_id": "6863d700-9308-3dff-8bcd-ea7c03813eb9",
                        "glosses": [
                            "Serrer, assujettir, fixer, caler, mettre une cotte ^([2])."
                        ],
                        "tags": [
                            "Suisse",
                            "Savoie",
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "93108c88-35a9-4230-a574-1eb7e43fe29c",
                                "sense_id": "258c4927-66a8-3c91-93e0-53a878511c80",
                                "text": "Cotter une porte, cotter une fenêtre, cotter un contrevent qui bat."
                            },
                            {
                                "example_id": "05ef0ec3-ebff-4422-830d-5bf0fe4e13fb",
                                "sense_id": "258c4927-66a8-3c91-93e0-53a878511c80",
                                "text": "Voici la troisième fois que le vent fait tomber ce devant de cheminée : cottez-le donc avec soin."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e52dbba-a478-3f10-a74d-73e5053ca10f",
                        "entry_id": "6863d700-9308-3dff-8bcd-ea7c03813eb9",
                        "glosses": [
                            "Border un lit, mettre les bords de couverture sous le matelas."
                        ],
                        "tags": [
                            "Suisse",
                            "Savoie"
                        ],
                        "examples": [
                            {
                                "example_id": "370021ed-7d00-470d-b78e-a9708c6d612f",
                                "sense_id": "6e52dbba-a478-3f10-a74d-73e5053ca10f",
                                "text": "Le lit était mal cotté : la couverture est tombée."
                            }
                        ]
                    },
                    {
                        "sense_id": "3acd29d6-e534-3d49-b9bb-6983d9db62a2",
                        "entry_id": "6863d700-9308-3dff-8bcd-ea7c03813eb9",
                        "glosses": [
                            "S’arrêter, hésiter en récitant ou en déclamant."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "b9242d9f-226f-44ac-887c-afe59b515f8f",
                                "sense_id": "3acd29d6-e534-3d49-b9bb-6983d9db62a2",
                                "text": "Le jeune étudiant nous récita toute la première satire de Boileau sans cotter, sans cotter d’un seul mot."
                            }
                        ]
                    },
                    {
                        "sense_id": "00949735-4fcf-3dcf-b533-92f914be438a",
                        "entry_id": "6863d700-9308-3dff-8bcd-ea7c03813eb9",
                        "glosses": [
                            "Ne pas tomber d’accord sur une vente, sur un achat qui allaient être faits ; se tenir à très peu de chose."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "c3e747d9-7492-4418-9880-dd987b8d521b",
                                "sense_id": "00949735-4fcf-3dcf-b533-92f914be438a",
                                "text": "On allait conclure le marché, quand un s’est cotté pour vingt francs."
                            }
                        ]
                    },
                    {
                        "sense_id": "e309023e-1eb2-3a42-84e9-f61d5de5f642",
                        "entry_id": "6863d700-9308-3dff-8bcd-ea7c03813eb9",
                        "glosses": [
                            "Fermer à clé."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "54e82a2c-4fed-4304-b978-1d46c879bc96",
                                "sense_id": "e309023e-1eb2-3a42-84e9-f61d5de5f642",
                                "text": "il a cotté la porte de la maison avant de partir."
                            }
                        ]
                    }
