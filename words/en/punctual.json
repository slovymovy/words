{
    "word_family": [
        "punctuality",
        "punctually",
        "punctilious"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8bf449cf-43bb-306d-aff5-ce9dd327644a",
                    "sense_definition": "Acting at the appointed time; not late.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Luis is never late; he is the most <w>punctual</w> person I know.",
                            "target_lang_translations": {
                                "tr": "Luis asla geç kalmaz; tanıdığım en <w>dakik</w> insandır."
                            }
                        },
                        {
                            "text": "Please be <w>punctual</w> for our meeting tomorrow morning.",
                            "target_lang_translations": {
                                "tr": "Lütfen yarın sabahki toplantımız için <w>dakik</w> olun."
                            }
                        }
                    ],
                    "synonyms": [
                        "prompt",
                        "on time"
                    ],
                    "antonyms": [
                        "late"
                    ],
                    "common_phrases": [
                        "be punctual"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirlenen zamanda hareket eden; geç kalmayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dakik",
                                "target_lang_sense_clarification": "Zamanı kullanmada çok dikkatli olan, her şeyi zamanında yapmaya özen gösteren kişi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "877048b9-96f4-3542-8aa8-1e3e0a3edd2c",
                    "sense_definition": "Happening exactly at the scheduled time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train service is very <w>punctual</w> during the week.",
                            "target_lang_translations": {
                                "tr": "Tren seferleri hafta içi oldukça <w>dakik</w> işliyor."
                            }
                        },
                        {
                            "text": "We expect a <w>punctual</w> start to the conference.",
                            "target_lang_translations": {
                                "tr": "Konferansın <w>tam vaktinde</w> başlamasını bekliyoruz."
                            }
                        }
                    ],
                    "synonyms": [
                        "timely"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tam olarak planlanan zamanda gerçekleşen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dakik",
                                "target_lang_sense_clarification": "Düzenli işleyen, aksamayan (hizmet veya süreçler için)."
                            },
                            {
                                "target_lang_word": "tam vaktinde",
                                "target_lang_sense_clarification": "Gecikme olmaksızın, planlanan anda."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28feb01c-7bd6-3fba-b3a7-b5daed66a6b9",
                    "sense_definition": "Paying very close attention to small details or rules.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>punctual</w> about following every minor rule in the contract.",
                            "target_lang_translations": {
                                "tr": "Sözleşmedeki her küçük kurala uymak konusunda çok <w>titizdir</w>."
                            }
                        },
                        {
                            "text": "Her <w>punctual</w> attention to detail ensures the work is perfect.",
                            "target_lang_translations": {
                                "tr": "Detaylara gösterdiği <w>titiz</w> dikkat, işin kusursuz olmasını sağlıyor."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Küçük detaylara veya kurallara çok yakın ilgi gösteren."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "titiz",
                                "target_lang_sense_clarification": "Detaylara aşırı önem veren, kılı kırk yaran."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90f3e403-c000-3ff4-8266-e2b1fdc22730",
                    "sense_definition": "Occurring occasionally or at specific intervals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee holds <w>punctual</w> meetings to review progress.",
                            "target_lang_translations": {
                                "tr": "Komite, ilerlemeyi gözden geçirmek için <w>düzenli</w> toplantılar yapıyor."
                            }
                        },
                        {
                            "text": "They provide <w>punctual</w> updates on the project status.",
                            "target_lang_translations": {
                                "tr": "Proje durumu hakkında <w>düzenli</w> güncellemeler sağlıyorlar."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Ara sıra veya belirli aralıklarla meydana gelen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "düzenli",
                                "target_lang_sense_clarification": "Belirli bir periyotta tekrarlanan."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "566ac70e-9166-31a8-8340-382d8e02a9aa",
                    "sense_definition": "Relating to a single moment in time with no duration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>punctual</w> event happened in a fraction of a second.",
                            "target_lang_translations": {
                                "tr": "<w>Anlık</w> olay saniyenin çok küçük bir diliminde gerçekleşti."
                            }
                        },
                        {
                            "text": "Linguists describe this as a <w>punctual</w> action verb.",
                            "target_lang_translations": {
                                "tr": "Dilbilimciler bunu <w>anlık</w> bir eylem fiili olarak tanımlar."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Süresi olmayan, tek bir ana ilişkin."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "anlık",
                                "target_lang_sense_clarification": "Sürekliliği olmayan, tek bir noktada gerçekleşen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c87cf9f-73a2-3356-a7f9-1c675c0a12a0",
                    "sense_definition": "Existing as a specific point or a series of points.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The graph shows <w>punctual</w> data points across the timeline.",
                            "target_lang_translations": {
                                "tr": "Grafik, zaman çizelgesi boyunca <w>noktasal</w> veri noktalarını gösteriyor."
                            }
                        },
                        {
                            "text": "This <w>punctual</w> distribution helps identify the trend.",
                            "target_lang_translations": {
                                "tr": "Bu <w>noktasal</w> dağılım, eğilimi belirlemeye yardımcı olur."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir nokta veya bir dizi nokta olarak var olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "noktasal",
                                "target_lang_sense_clarification": "Yayılımdan ziyade belirli bir noktaya odaklı."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}