                        "examples": [
                            {
                                "example_id": "adeda224-16b0-490c-bcf4-a1a6e3d3b136",
                                "sense_id": "624e0387-d5bf-39bf-8b6a-b4670fe4b0c5",
                                "text": "Als ich Halsweh hatte, sagte ich mir nur immer wieder: „Zum Glück bin ich keine Giraffe!“"
                            },
                            {
                                "example_id": "eae8ab5f-02b7-4235-a35b-b892e98d9d97",
                                "sense_id": "624e0387-d5bf-39bf-8b6a-b4670fe4b0c5",
                                "text": "„Die Eltern führten ihre Kinder zum Blasiussegen in die Kirche, damit sie keine Gräten verschluckten und kein Halsweh bekamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
