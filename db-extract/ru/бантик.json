                "senses": [
                    {
                        "sense_id": "381799aa-4677-3c68-8552-b54783b1a0db",
                        "entry_id": "717bfe5b-81af-3a0b-9223-23cb42638b2b",
                        "glosses": [
                            "diminutive of бант (bant): a (small) ribbon; a (small) bow"
                        ],
                        "tags": [
                            "diminutive",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "25221989-01d9-4975-a006-9ac75b2c7e8f",
                                "sense_id": "381799aa-4677-3c68-8552-b54783b1a0db",
                                "text": "гу́бки ба́нтиком",
                                "translation": "Cupid's bow (a grimace)",
                                "english": "Cupid's bow (a grimace)"
                            },
                            {
                                "example_id": "3086a194-3154-436e-85a7-d60d72846171",
                                "sense_id": "381799aa-4677-3c68-8552-b54783b1a0db",
                                "text": "Ма́рта сиде́ла в бесе́дке, ещё́ принаря́женная от обе́дни. На ней бы́ло све́тлое пла́тье с ба́нтиками, но оно́ к ней не шло.",
                                "translation": "Marta was sitting in the summer-house, still in her best clothes. She had on a brightly coloured dress with bows, which were very unbecoming to her.",
                                "english": "Marta was sitting in the summer-house, still in her best clothes. She had on a brightly coloured dress with bows, which were very unbecoming to her."
                            }
                        ]
                    }
                ],
