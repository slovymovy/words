                ],
                "senses": [
                    {
                        "sense_id": "d36f736d-f5c2-3165-9fb0-2ab41b24d74e",
                        "entry_id": "3c070cbb-4b73-3902-aeb4-ac8f5992d219",
                        "glosses": [
                            "wieder in den Zustand gebracht, in dem etwas entsprechend seiner Bestimmung eingesetzt/benutzt/verwendet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06246255-7554-413b-bd2f-4332b72b2055",
                                "sense_id": "d36f736d-f5c2-3165-9fb0-2ab41b24d74e",
                                "text": "„Der Architekt Hermann Thurner und Vinzenz Dufter, Bauberater des Bayerischen Landesvereins für Heimatpflege, stellten den sorgsam instandgesetzten, 2013 fertiggestellten Pfarrsaal vor.“"
                            },
                            {
                                "example_id": "a94f47d6-ec0c-4032-92fc-4c1d8f2f40a6",
                                "sense_id": "d36f736d-f5c2-3165-9fb0-2ab41b24d74e",
                                "text": "„Gäbe es die Wachtürme, stacheldrahtbewehrten Mauern und die schwerbewaffneten Wächter nicht, erinnerte diese deutlich ältere, aber gut instandgesetzte Jugendstrafkolonie von ihrer Anlage her noch stärker an eine Internatsschule.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
