                ],
                "senses": [
                    {
                        "sense_id": "6e4ada2f-ff7d-3065-ae53-19a8db3e7284",
                        "entry_id": "5181a2ff-68e3-3682-acd0-f68bb7e8cac3",
                        "glosses": [
                            "Gesamtheit der Erzeugnisse, die eine Ernte eingebracht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54872779-cf42-40ef-867b-27e2c516896f",
                                "sense_id": "6e4ada2f-ff7d-3065-ae53-19a8db3e7284",
                                "text": "„Bis zum Jahr 2080 könnte der Ernteertrag der Inder aufgrund der Erderwärmung um 30 bis 40 Prozent zurückgehen, hat der Klimaforscher William Cline vom Peterson-Institut für Internationale Ökonomie in Washington berechnet.“"
                            },
                            {
                                "example_id": "831a29e2-8517-45dd-9c00-b2307ade9c01",
                                "sense_id": "6e4ada2f-ff7d-3065-ae53-19a8db3e7284",
                                "text": "„Die Berichterstattung über den Saatenstand, die Ernteaussichten und den tatsächlichen Ernteertrag ist in den einzelnen Ländern verschieden organisiert.“"
                            },
                            {
                                "example_id": "dec5de6a-42cb-47e7-8fea-a2c909134ce3",
                                "sense_id": "6e4ada2f-ff7d-3065-ae53-19a8db3e7284",
                                "text": "„Als die Baumwolle geerntet wurde, mußte Case all seine Zeit darauf verwenden und sich drum kümmern, auch um die andern Ernteerträge.“"
                            },
                            {
                                "example_id": "a1768da9-6852-4f47-b080-934402e8c6b2",
                                "sense_id": "6e4ada2f-ff7d-3065-ae53-19a8db3e7284",
                                "text": "„In diesen zehn Jahren mussten die Steuerschreiber alle Ernteerträge genau registrieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
