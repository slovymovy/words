                "translations": [
                    {
                        "translation_id": "cef7cc6b-1c96-41e9-b5a8-ab040c2326c4",
                        "source_entry_id": "76b3359f-2280-33fd-96dd-bb97a959b193",
                        "source_sense_id": "e57cd09f-f58d-3157-8c66-cc5e20c34daf",
                        "source_sense_description": "een vakman die beroepsmatig meubels vervaardigt",
                        "target_lang_word": "Tischler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tischler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                        "entry_id": "4ba550b3-9709-3b52-b7b1-2406945f7826",
                                        "glosses": [
                                            "Handwerker, der aus Holz Möbel oder Fenster und Türen herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6de4f02-e209-4de7-8e0b-7789e64fe29d",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "Den Schrank haben wir uns vom Tischler machen lassen."
                                            },
                                            {
                                                "example_id": "8bd46a48-15e8-474d-9d2a-507b72973784",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Und der Tischler hebt seinen grauen Kopf und sieht den Wirt groß an.“"
                                            },
                                            {
                                                "example_id": "1d75b1d1-d670-40b7-a17e-e9da3db5b1b4",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Tatsächlich sei sie bis zum Tischler Lý Phong vorgedrungen, der in einem dritten Hinterhof nahe dem Mauerpark Möbel ausbesserte und von geradezu sprichwörtlich schlechter Laune war.“"
                                            },
                                            {
                                                "example_id": "4a61fbb2-1af4-47f8-956f-affe074d0229",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Sie bestellte sogleich bei einem Tischler einen vergitterten und abschließbaren Bücherschrank, der nach meiner Abreise ihre ganze Wonne sein mußte.“"
                                            },
                                            {
                                                "example_id": "4c8a2a6b-7c0d-43d8-93c8-38f8abf5489d",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Somit ist der Tischler Beste, der dort wohnt, ein Verräter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87595b0c-9dc7-4d8f-ac94-36b56da8ca4f",
                        "source_entry_id": "76b3359f-2280-33fd-96dd-bb97a959b193",
                        "source_sense_id": "e57cd09f-f58d-3157-8c66-cc5e20c34daf",
                        "source_sense_description": "een vakman die beroepsmatig meubels vervaardigt",
                        "target_lang_word": "cabinetmaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabinetmaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2f2c8fb-95c5-3699-b3ae-896b64b9c437",
                                        "entry_id": "476baf1e-65a5-3ec5-8b0e-6b3dfe1e03c7",
                                        "glosses": [
                                            "A skilled woodworker who makes high-quality wooden cabinets and furniture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a5bf33-4286-472b-89f9-864e26d18ae6",
                                                "sense_id": "a2f2c8fb-95c5-3699-b3ae-896b64b9c437",
                                                "text": "He waited and waited, in the faith that Schinkel was dealing with them in his slow, categorical Teutonic way, and only objurgated the cabinetmaker for having in the first place paltered with his sacred trust. Why hadn't he come straight to him—whatever the mysterious document was—instead of talking it over with French featherheads?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbd3d0a3-4916-48a5-9318-1a2f2318854a",
                        "source_entry_id": "76b3359f-2280-33fd-96dd-bb97a959b193",
                        "source_sense_id": "e57cd09f-f58d-3157-8c66-cc5e20c34daf",
                        "source_sense_description": "een vakman die beroepsmatig meubels vervaardigt",
                        "target_lang_word": "ébéniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ébéniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb8ff2e-8699-34f7-92c7-c3fea303bb00",
                                        "entry_id": "e8539263-05ef-3579-9499-66f9d9171c18",
                                        "glosses": [
                                            "Ouvrier qui travaille en ébène et autres bois précieux pour en faire des meubles ou qui fait des ouvrages d’ébénisterie et de marqueterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fddebe4-a60c-4497-90f2-a34646b6d67b",
                                                "sense_id": "cdb8ff2e-8699-34f7-92c7-c3fea303bb00",
                                                "text": "C'est le bois d'ébène, une des premières essences exotiques utilisées au début du xviiᵉ siècle pour habiller les meubles qui donna son nom au terme ébéniste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31953e45-2a22-3546-9bae-5c6eacc76759",
                                        "entry_id": "e8539263-05ef-3579-9499-66f9d9171c18",
                                        "glosses": [
                                            "Menuisier, fabricant ou marchand de meubles de qualité ou de luxe."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6834df9f-d8e9-4330-af56-48a10d4fd8e4",
                                                "sense_id": "31953e45-2a22-3546-9bae-5c6eacc76759",
                                                "text": "D’un coup de manivelle, on escamote la bibliothèque, la table de lit ou le prie-Dieu. Une « table mécanique », conçue par le même ébéniste, se transforme en clin d’œil en support d’écriture ou en cabinet de toilette."
                                            },
                                            {
                                                "example_id": "280ee9e4-1fa5-49d2-be5b-d0de666455b9",
                                                "sense_id": "31953e45-2a22-3546-9bae-5c6eacc76759",
                                                "text": "— Camille-Eugène-Marie Dieudonné. Il a vingt-six ans, quand éclate l’affaire Bonnot. De métier, il est ouvrier ébéniste ; d’idées : anarchiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba4682c3-39a8-4a39-b656-d76b93be34c8",
                        "source_entry_id": "76b3359f-2280-33fd-96dd-bb97a959b193",
                        "source_sense_id": "e57cd09f-f58d-3157-8c66-cc5e20c34daf",
                        "source_sense_description": "een vakman die beroepsmatig meubels vervaardigt",
                        "target_lang_word": "menuisier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menuisier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4367baf6-1e8f-3531-9e98-9b875a733567",
                                        "entry_id": "a1a61bd0-3866-3941-a218-26543b4b3d8b",
                                        "glosses": [
                                            "Artisan qui travaille le bois pour en faire des meubles ou des pièces utiles pour les bâtiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddd4b7bd-db7d-4388-b5cd-874d20fd257d",
                                                "sense_id": "4367baf6-1e8f-3531-9e98-9b875a733567",
                                                "text": "À peine une salle était-elle cloisonnée que les menuisiers s’en emparaient pour y poser les boiseries et les vitrines, les tapissiers la tendaient d’étoffe, des ouvriers spéciaux la parquetaient de linoléum."
                                            },
                                            {
                                                "example_id": "2242adc5-0d39-4f12-a92a-d873d4936863",
                                                "sense_id": "4367baf6-1e8f-3531-9e98-9b875a733567",
                                                "text": "Je suis de la confrérie de Sainte-Anne, menuisier. Je porte dans les convois et dans les processions le bâton décoré du compas sur la lyre, sur lequel la grand-mère du bon Dieu apprend à lire à sa fille toute petiote, Marie pleine de grâce, pas plus haute qu’une botte."
                                            },
                                            {
                                                "example_id": "ec82f60c-a110-4e25-80cd-0a59a6d19ae3",
                                                "sense_id": "4367baf6-1e8f-3531-9e98-9b875a733567",
                                                "text": "Vous préviendrez au village qu’on sonne en première classe et vous vous occuperez du prêtre, du fossoyeur et du menuisier !"
                                            },
                                            {
                                                "example_id": "489b8c86-2b67-4ecd-aa80-e16c2c5007e8",
                                                "sense_id": "4367baf6-1e8f-3531-9e98-9b875a733567",
                                                "text": "Ces menuisiers, dit Cambronne Mâcheclair, jamais ils ne laissent ressuyer leur bois !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
