                "senses": [
                    {
                        "sense_id": "2e0be4d9-a860-3cd7-8e82-e7e8bd0c7428",
                        "entry_id": "f333a9ed-be58-3905-a135-716e11c7e747",
                        "glosses": [
                            "ein Haus und dessen Bewohner betreffende Votivgabe durch einen Votanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75607b8b-6aa7-41ad-9ba1-37db9a4b8d88",
                                "sense_id": "2e0be4d9-a860-3cd7-8e82-e7e8bd0c7428",
                                "text": "„Neben den bekannten Votiven in Hand-, Tier-, und Krötenformen, die auch nach einem Model aus Holz oder Gips in Wachs gegossen wurden gab es als Besonderheit Hausvotive.“"
                            },
                            {
                                "example_id": "86c6b67d-5ff0-4f08-8753-6e6b4e74728c",
                                "sense_id": "2e0be4d9-a860-3cd7-8e82-e7e8bd0c7428",
                                "text": "„Die nächste Parallele dazu scheint in den Hausvotiven gegeben zu sein, die als stellvertretende Opfer einer Hausgemeinde in Eisen, Wachs und Holz in mehreren steirischen Wallfahrtskirchen nachzuweisen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
