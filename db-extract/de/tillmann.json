                ],
                "senses": [
                    {
                        "sense_id": "28972c54-70fe-3085-a69a-753d3de24e0b",
                        "entry_id": "e858a67d-9342-31b3-9656-76d490c78aa9",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00ad3773-7353-441b-8623-e77a4342199f",
                                "sense_id": "28972c54-70fe-3085-a69a-753d3de24e0b",
                                "text": "Frau Tillmann lebte in einem kleinen, alten Landhaus."
                            },
                            {
                                "example_id": "31e33b47-56d4-4195-8138-6707cc7193b7",
                                "sense_id": "28972c54-70fe-3085-a69a-753d3de24e0b",
                                "text": "Herr Tillmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "29213037-8649-4755-9756-9dcd2f73e396",
                                "sense_id": "28972c54-70fe-3085-a69a-753d3de24e0b",
                                "text": "Die Tillmanns fliegen heute zurück nach Frankfurt."
                            },
                            {
                                "example_id": "a0c732de-0bda-4dd9-bd1f-b8b2762adac3",
                                "sense_id": "28972c54-70fe-3085-a69a-753d3de24e0b",
                                "text": "An kalten Wintertagen ist die liebste Beschäftigung der Familie Tillmanns das Backen leckerer Plätzchen."
                            },
                            {
                                "example_id": "09565768-390e-4dd5-a762-376a3c7d7e73",
                                "sense_id": "28972c54-70fe-3085-a69a-753d3de24e0b",
                                "text": "„Tillmann hatte auf seinem Smartphone die Nummer seiner Mutter erkannt und begrüßte sie erfreut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
