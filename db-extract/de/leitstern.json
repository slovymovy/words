                "senses": [
                    {
                        "sense_id": "f7436743-bc2d-34ca-bbe2-4c8494632faa",
                        "entry_id": "53048b31-dbc1-3bba-9036-0fe3af05e40b",
                        "glosses": [
                            "(besonders heller) Stern, der zur Orientierung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5778d87-264b-43be-9c8d-d041858ffedf",
                                "sense_id": "f7436743-bc2d-34ca-bbe2-4c8494632faa",
                                "text": "„Die Lust an der Gewalt war und blieb der Leitstern seines Lebens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6690a2ae-08f7-3422-8e30-feb4bd945e80",
                        "entry_id": "53048b31-dbc1-3bba-9036-0fe3af05e40b",
                        "glosses": [
                            "etwas, das als Orientierungspunkt dient"
                        ],
                        "tags": [
                            "figurative",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "047ba588-85c9-476e-8ba1-98c6536df489",
                                "sense_id": "6690a2ae-08f7-3422-8e30-feb4bd945e80",
                                "text": "„Im Zeichen des guten Willens standen die Weihnachts- und Neujahrsbotschaften der Staatsmänner. Der Gedanke der Völkerverständigung soll als Leitstern über dem Jahre 1947 stehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
