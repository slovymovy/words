                "senses": [
                    {
                        "sense_id": "21bcfb89-66fc-3a21-a95b-937618c8a688",
                        "entry_id": "ad3e0b9a-18d5-3a5d-a799-27c1bb0f6854",
                        "glosses": [
                            "van een metalen voorwerp dat het door oxideren vermindert in kwaliteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38f2216c-c58c-4ec2-aba6-a1ea127c1bde",
                                "sense_id": "21bcfb89-66fc-3a21-a95b-937618c8a688",
                                "text": "De manier waarop Hennis bij het naar buiten komen van het OVV-rapport reageert, is een aanfluiting. 'Niet aftreden, maar optreden'is haar oneliner. Zegt de bewindsvrouw van een departement dat nog te eigenwijs is om te erkennen dat de mortiergranaten verroest waren."
                            },
                            {
                                "example_id": "bf2f7df9-cb21-496a-9ffe-25eaf3e6da11",
                                "sense_id": "21bcfb89-66fc-3a21-a95b-937618c8a688",
                                "text": "De muntjes lieten zich namelijk lastig tellen. Ze waren verroest en klonterden aan elkaar na hun jarenlange verblijf in diepvrieszakken."
                            }
                        ]
                    }
                ],
