                "senses": [
                    {
                        "sense_id": "33977484-e783-3034-8a78-dc8af0182f81",
                        "entry_id": "5b311b9d-bb89-3b0f-b362-b8ed3f42e638",
                        "glosses": [
                            "jemand, der zu etwas hinzukommt, bei etwas einsteigt, bei etwas neu ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "543637dc-222a-4549-9724-ffbe1484996e",
                                "sense_id": "33977484-e783-3034-8a78-dc8af0182f81",
                                "text": "„Die beiden verbliebenen Hauptgesichter von Union und SPD im Ausschuss sind Newcomer im Betrieb der Untersuchungsausschüsse.“"
                            },
                            {
                                "example_id": "36d5a7af-547e-4802-8005-5844af3bd3bb",
                                "sense_id": "33977484-e783-3034-8a78-dc8af0182f81",
                                "text": "„Experten wie der Londoner Marktbeobachter Roger Atkins sehen unter den Newcomern durchaus Kandidaten mit Potenzial – so etwa den einstigen Batteriehersteller Lucid Motors.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
