                                "sense_id": "9f331f22-f369-3419-87be-2777573123d8",
                                "text": "Dat is al evenmin een goed idee."
                            },
                            {
                                "example_id": "9c689dd1-cfac-4751-b6d4-6e83fa87b04b",
                                "sense_id": "9f331f22-f369-3419-87be-2777573123d8",
                                "text": "Hij houdt niet van voetbal en evenmin van tennissen."
                            },
                            {
                                "example_id": "6e604b7f-b336-48ec-9789-5069af591e72",
                                "sense_id": "9f331f22-f369-3419-87be-2777573123d8",
                                "text": "Waarom God hun alle drie een dergelijke gunst had verleend, was onmogelijk te begrijpen, evenmin waarom hij in hun jeugd hun vader en oom tot zich had genomen door hen te laten verdwijnen op zee."
                            }
                        ]
