{
    "word_family": [
        "innermost",
        "inmost",
        "inward",
        "inwardly",
        "inwards"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "330813c1-cf37-3418-b0b4-6418face89d2",
                    "sense_definition": "Situated inside or further in; occurring within something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She kept her wallet safe in the <w>inner</w> pocket of her jacket.",
                            "target_lang_translations": {
                                "ru": "Она хранила кошелек в безопасности во <w>внутреннем</w> кармане куртки.",
                                "zh": "她把钱包安全地放在夹克的<w>内侧</w>口袋里。"
                            }
                        },
                        {
                            "text": "The <w>inner</w> door leads directly to the main office.",
                            "target_lang_translations": {
                                "ru": "<w>Внутренняя</w> дверь ведет прямо в главный офис.",
                                "zh": "<w>里层</w>的那扇门直接通往主办公室。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interior",
                        "internal",
                        "inside"
                    ],
                    "antonyms": [
                        "outer"
                    ],
                    "common_phrases": [
                        "inner door",
                        "inner pocket",
                        "inner surface",
                        "inner room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся внутри или глубже внутри чего-либо; происходящий внутри.",
                        "zh": "位于内部或更深处；在某物之内发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "расположенный внутри"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内部的",
                                "target_lang_sense_clarification": "位于物体内部"
                            },
                            {
                                "target_lang_word": "里面的",
                                "target_lang_sense_clarification": "在某物之内的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8e10d9d-de2a-3127-ad80-8f02bc2f1d40",
                    "sense_definition": "Relating to the mind, spirit, or private feelings rather than external appearance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meditation can help you find a sense of <w>inner</w> peace.",
                            "target_lang_translations": {
                                "ru": "Медитация может помочь вам обрести чувство <w>внутреннего</w> покоя.",
                                "zh": "冥想可以帮助你找到一种<w>内心</w>的平静。"
                            }
                        },
                        {
                            "text": "He rarely shared his <w>inner</w> thoughts with anyone else.",
                            "target_lang_translations": {
                                "ru": "Он редко делился своими <w>сокровенными</w> мыслями с кем-либо еще.",
                                "zh": "他很少与他人分享自己的<w>内心</w>想法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "internal",
                        "private",
                        "personal"
                    ],
                    "antonyms": [
                        "outer"
                    ],
                    "common_phrases": [
                        "inner peace",
                        "inner strength",
                        "inner voice",
                        "inner child"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к уму, духу или личным чувствам, а не к внешнему виду.",
                        "zh": "与思想、精神或个人感受有关，而非外在表现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "о мыслях и чувствах"
                            },
                            {
                                "target_lang_word": "душевный",
                                "target_lang_sense_clarification": "относящийся к душевному состоянию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内心的",
                                "target_lang_sense_clarification": "关于思想和情感"
                            },
                            {
                                "target_lang_word": "精神的",
                                "target_lang_sense_clarification": "关于精神层面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee141d62-43ac-3480-bd33-51e3c8862a04",
                    "sense_definition": "Located inside the body.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An infection in the <w>inner</w> ear can affect your balance.",
                            "target_lang_translations": {
                                "ru": "Инфекция во <w>внутреннем</w> ухе может повлиять на равновесие.",
                                "zh": "<w>内耳</w>感染会影响你的平衡感。"
                            }
                        },
                        {
                            "text": "The doctor examined the <w>inner</w> lining of the patient's stomach.",
                            "target_lang_translations": {
                                "ru": "Врач осмотрел <w>внутреннюю</w> оболочку желудка пациента.",
                                "zh": "医生检查了病人胃部的<w>内壁</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "internal",
                        "inside"
                    ],
                    "antonyms": [
                        "outer"
                    ],
                    "common_phrases": [
                        "inner ear",
                        "inner thigh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный внутри тела.",
                        "zh": "位于身体内部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "анатомический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内部的",
                                "target_lang_sense_clarification": "解剖学或生理学上的内部"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "620d8a35-3584-348d-9c10-c70944a0a591",
                    "sense_definition": "Located near or closer to the center of a city or area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young professionals are moving back to the <w>inner</w> city.",
                            "target_lang_translations": {
                                "ru": "Многие молодые специалисты возвращаются в <w>центральные</w> районы города.",
                                "zh": "许多年轻的专业人士正在搬回<w>市中心</w>居住。"
                            }
                        },
                        {
                            "text": "The <w>inner</w> suburbs are well connected by public transport.",
                            "target_lang_translations": {
                                "ru": "<w>Ближние</w> пригороды хорошо связаны общественным транспортом.",
                                "zh": "<w>近郊</w>地区有完善的公共交通网络。"
                            }
                        }
                    ],
                    "antonyms": [
                        "outer"
                    ],
                    "common_phrases": [
                        "inner city",
                        "inner suburbs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный в центре города или района или близко к нему.",
                        "zh": "位于城市或区域中心或靠近中心的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "центральный",
                                "target_lang_sense_clarification": "о районах города"
                            },
                            {
                                "target_lang_word": "ближний",
                                "target_lang_sense_clarification": "о пригородах, прилегающих к центру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "市中心的",
                                "target_lang_sense_clarification": "关于城市核心区域"
                            },
                            {
                                "target_lang_word": "近郊的",
                                "target_lang_sense_clarification": "靠近市区的郊区"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d6146c5-24b3-3704-b265-70f470a0b3ef",
                    "sense_definition": "Exclusive to a select, privileged, or influential group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_exclusive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only the <w>inner</w> circle of advisors knew about the president's plan.",
                            "target_lang_translations": {
                                "ru": "Только <w>узкий</w> круг советников знал о плане президента.",
                                "zh": "只有总统的<w>核心</w>顾问团知道这项计划。"
                            }
                        },
                        {
                            "text": "She felt excluded from the <w>inner</w> council that made all the decisions.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя исключенной из <w>внутреннего</w> совета, который принимал все решения.",
                                "zh": "她感到自己被排除在做出所有决策的<w>核心</w>委员会之外。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inner circle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к избранной, привилегированной или влиятельной группе.",
                        "zh": "仅限于特定的、享有特权的或有影响力的群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узкий",
                                "target_lang_sense_clarification": "об ограниченном круге лиц"
                            },
                            {
                                "target_lang_word": "ближний",
                                "target_lang_sense_clarification": "о доверенном круге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "核心的",
                                "target_lang_sense_clarification": "指最关键或最亲近的圈子"
                            },
                            {
                                "target_lang_word": "小圈子的",
                                "target_lang_sense_clarification": "指排他的群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4a6ffcb-0e33-3cbf-adf8-dacc1135492e",
                    "sense_definition": "Hidden, not obvious, or relating to the essential nature of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poem has an <w>inner</w> meaning that is not immediately apparent.",
                            "target_lang_translations": {
                                "ru": "У стихотворения есть <w>скрытый</w> смысл, который не сразу очевиден.",
                                "zh": "这首诗有一种不那么显而易见的<w>内在</w>含义。"
                            }
                        },
                        {
                            "text": "You must understand the <w>inner</w> logic of the system to fix it.",
                            "target_lang_translations": {
                                "ru": "Вы должны понять <w>внутреннюю</w> логику системы, чтобы исправить её.",
                                "zh": "你必须理解该系统的<w>内在</w>逻辑才能修复它。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inner meaning",
                        "inner logic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытый, неочевидный или относящийся к сущности чего-либо.",
                        "zh": "隐藏的、不明显的，或与某事物的本质有关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрытый",
                                "target_lang_sense_clarification": "неявный смысл"
                            },
                            {
                                "target_lang_word": "глубинный",
                                "target_lang_sense_clarification": "относящийся к сути"
                            },
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "присущий изнутри"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内在的",
                                "target_lang_sense_clarification": "事物的本质属性"
                            },
                            {
                                "target_lang_word": "深层的",
                                "target_lang_sense_clarification": "不明显的含义或逻辑"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a41f885-7d9b-32b4-91b0-a87490a5b639",
                    "sense_definition": "An internal part of something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic had to replace the damaged <w>inner</w> of the machine.",
                            "target_lang_translations": {
                                "ru": "Механику пришлось заменить поврежденную <w>внутреннюю часть</w> машины.",
                                "zh": "机械师不得不更换机器损坏的<w>内部</w>零件。"
                            }
                        },
                        {
                            "text": "The hard shell protects the soft <w>inner</w> of the fruit.",
                            "target_lang_translations": {
                                "ru": "Твердая оболочка защищает мягкую <w>сердцевину</w> фрукта.",
                                "zh": "坚硬的外壳保护着水果柔软的<w>果肉</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренняя часть чего-либо.",
                        "zh": "某物的内部部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренняя часть",
                                "target_lang_sense_clarification": "деталь или элемент"
                            },
                            {
                                "target_lang_word": "сердцевина",
                                "target_lang_sense_clarification": "центр плода или предмета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内部",
                                "target_lang_sense_clarification": "物体的内部结构"
                            },
                            {
                                "target_lang_word": "核心",
                                "target_lang_sense_clarification": "物体的中心部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44478cfc-ccca-3057-a081-d49ba93b63ee",
                    "sense_definition": "A duvet or quilt, excluding the decorative cover.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_bedding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can wash the cover easily, but the <w>inner</w> requires dry cleaning.",
                            "target_lang_translations": {
                                "ru": "Чехол можно легко постирать, но <w>одеяло</w> требует химчистки.",
                                "zh": "你可以轻松地清洗被套，但<w>被芯</w>需要干洗。"
                            }
                        },
                        {
                            "text": "We bought a warm feather <w>inner</w> for the winter months.",
                            "target_lang_translations": {
                                "ru": "Мы купили теплое пуховое <w>одеяло</w> на зимние месяцы.",
                                "zh": "我们买了一个温暖的羽绒<w>被芯</w>来过冬。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in UK, Australia, NZ"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одеяло, которое вставляется в пододеяльник (без декоративного чехла).",
                        "zh": "羽绒被或被芯，不含装饰性被套。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одеяло",
                                "target_lang_sense_clarification": "само изделие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被芯",
                                "target_lang_sense_clarification": "被子的填充部分"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}