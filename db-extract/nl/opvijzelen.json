                                        "sense_id": "b0f1175e-16f6-30f0-882e-3bcfec962c95",
                                        "entry_id": "ea78e88e-025a-3e1e-bb2d-e0b516f2b934",
                                        "glosses": [
                                            "To rebuild or replenish with all new material; to restore to original (or better) working order and appearance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b50cf6-7a41-4040-ac1b-14b2c4e9982f",
                                                "sense_id": "b0f1175e-16f6-30f0-882e-3bcfec962c95",
                                                "text": "We're having the sitting room refurbished, after a leak damaged a large part of the room."
                                            },
                                            {
                                                "example_id": "bdd7f4d9-6fb5-441a-87c3-e0fbcd79f6d4",
                                                "sense_id": "b0f1175e-16f6-30f0-882e-3bcfec962c95",
                                                "text": "He also makes the point that in France, SNCF is currently refurbishing some TGVs built in 1988."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "refurbish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a832499c-2db2-3964-95cb-f196f817dbaa",
                                        "entry_id": "826d29d1-4cae-36a2-a6b4-700d3f814e9c",
                                        "glosses": [
