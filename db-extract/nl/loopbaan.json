                "senses": [
                    {
                        "sense_id": "c54e3f59-bd0e-3467-b677-09a931aafd3a",
                        "entry_id": "bb910032-eb33-332a-be54-47099f03fce1",
                        "glosses": [
                            "is de reeks van maatschappelijke posities die iemand achtereenvolgens inneemt (en ontwikkeling daarbinnen). Een loopbaan begint met het betreden van de arbeidsmarkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "599123d6-74eb-44c9-9d80-fb2ffd19dfd1",
                                "sense_id": "c54e3f59-bd0e-3467-b677-09a931aafd3a",
                                "text": "Terlouw besloot niet terug te keren in de Kamer en haalde zijn gram met de publicatie van een bitter dagboek. Na een periode in het buitenland werd hij tussen 1991 en 1996 commissaris van de Koningin in Gelderland. Het einde van zijn loopbaan stond, net als aan het begin, in het teken van het water: in 1995 liet hij wegens dreigende overstromingen het rivierengebied evacueren."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba31ba56-cecb-360a-875f-0fbee63a1c67",
                        "entry_id": "bb910032-eb33-332a-be54-47099f03fce1",
                        "glosses": [
                            "weg door de ruimte van een hemellichaam"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a7c9552-e61a-4d35-b5e0-d257a5a35d61",
                        "source_entry_id": "bb910032-eb33-332a-be54-47099f03fce1",
                        "source_sense_id": "c54e3f59-bd0e-3467-b677-09a931aafd3a",
