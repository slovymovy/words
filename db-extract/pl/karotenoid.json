                        "glosses": [
                            "substancja z grupy organicznych związków chemicznych, żółtych, czerwonych, pomarańczowych i różowych barwników roślinnych, które stanowią naturalne przeciwutleniacze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e011c4ad-753a-4565-860d-5cf9aded2468",
                                "sense_id": "0a878bdc-ad17-33cc-bab7-81d641a1adba",
                                "text": "Ian Stephen wierzy, że to karotenoidy, znajdujące się w barwnikach około 600 różnych warzyw i owoców, odpowiadają za atrakcyjny wygląd skóry"
                            }
                        ],
