                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intangibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2feb3f7-1fda-3bd0-b27b-70efd3e34145",
                                        "entry_id": "301993bf-be27-32b6-8dad-8efc969e16d9",
                                        "glosses": [
                                            "Le fait d’être intangible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50d725f1-b52d-4d7e-adb5-e3f740631265",
                                                "sense_id": "a2feb3f7-1fda-3bd0-b27b-70efd3e34145",
                                                "text": "Le principe d’intangibilité du décompte général et définitif est apprécié très strictement par le juge administratif."
                                            },
                                            {
                                                "example_id": "108afd71-6384-4458-9456-bff8fb7b6543",
                                                "sense_id": "a2feb3f7-1fda-3bd0-b27b-70efd3e34145",
                                                "text": "Si le principe d’intangibilité des prix selon lequel les prix contractualisés ne peuvent être modifiés (en dehors de l’application d’une clause de révision ou d’actualisation des prix) n’est pas remis en cause, celui-ci n’est pas absolu et peut connaître des exceptions, notamment en cas de circonstances imprévisibles."
                                            },
                                            {
                                                "example_id": "48f9dd5c-fe5b-4b76-9595-baea322add15",
                                                "sense_id": "a2feb3f7-1fda-3bd0-b27b-70efd3e34145",
                                                "text": "L’intangibilité d’un principe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d71e3d59-7650-3fca-81af-05dbf757dd6c",
                                        "entry_id": "301993bf-be27-32b6-8dad-8efc969e16d9",
                                        "glosses": [
                                            "Le fait d’être maintenu intact."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e434ca2-5996-4563-897c-9806b45f5a51",
                                                "sense_id": "d71e3d59-7650-3fca-81af-05dbf757dd6c",
                                                "text": "[…]; et d'autres qui se satisfaisaient de la société présente, se faisaient fort d'en défendre les mérites et l’intangibilité, ou bien souhaitaient simplement qu'on en ravalât un tantinet la façade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0dc64e0-41a5-3890-80dd-4fdb365d022c",
                                        "entry_id": "301993bf-be27-32b6-8dad-8efc969e16d9",
                                        "glosses": [
