                "senses": [
                    {
                        "sense_id": "649d7206-6690-3dd0-9f7a-241b4fc95a9a",
                        "entry_id": "2b0ad5d6-b31c-3cf5-afb5-e2214b9b9107",
                        "glosses": [
                            "Terraformer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a43653a6-49a0-41ca-855b-fc15efe3d19b",
                                "sense_id": "649d7206-6690-3dd0-9f7a-241b4fc95a9a",
                                "text": "C'est lourd je trouve les révoltes parce que après on doit reterraformer la planète pour tuer l'espèce"
                            },
                            {
                                "example_id": "f5c3b3b4-a4a7-413b-9a01-8bcfbb0fbe20",
                                "sense_id": "649d7206-6690-3dd0-9f7a-241b4fc95a9a",
                                "text": "Pour ma part j'estime qu'il est plus que temps de reterraformer la Terre avant de songer à modifier l'atmosphère des planètes proches et des exoplanètes."
                            },
                            {
                                "example_id": "07f5759c-171b-4575-98a2-7477796559f4",
                                "sense_id": "649d7206-6690-3dd0-9f7a-241b4fc95a9a",
                                "text": "Ils seraient nés sur la terre, l'auraient gâchée, auraient usé de leur technologie pour reterraformer la planète..."
                            }
                        ]
                    }
