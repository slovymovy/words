                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "f856695d-7bf3-4a96-a850-9d1367989f0e",
                                "sense_id": "250e94a0-945d-3f17-899e-cd62b114d209",
                                "text": "My Dad has taught me that in England some foolish man may call me sambo, darkie, boot or munt or nigger, even."
                            },
                            {
                                "example_id": "e48c82f1-b468-4dd4-8fbd-d8d520972559",
                                "sense_id": "250e94a0-945d-3f17-899e-cd62b114d209",
                                "text": "Munt was a derogatory term used by the [Rhodesian] security forces to refer to blacks."
                            }
                        ]
                    }
                ],
