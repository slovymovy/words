                        "glosses": [
                            "lamp gemaakt van een uitgeholde pompoen die men gebruikt bij Halloween"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56a6ca60-6421-4b43-b7d4-1de3bcb23d06",
                                "sense_id": "606d111d-8f3e-3851-8475-eb9dd93e7063",
                                "text": "De onhandige oude viewer gloeide als een pompoenlampion in het donker geworden vertrek, terwijl de woorden en de beeldnegatieven over haar gespannen gezicht dansten."
                            },
                            {
                                "example_id": "84b7589e-46e4-478d-b7d7-6cd95698e8d2",
                                "sense_id": "606d111d-8f3e-3851-8475-eb9dd93e7063",
                                "text": "Buurtweg 100, nabij de Buizerdlaan in Branst, werd weer opengemaakt. Voor de opening vond er een workshop pompoenlampions maken plaats in samenwerking met de Chiro van Branst, terwijl de laatste meters van de trage weg werden vrijgemaakt door de buurtbewoners. Stijn Hermans"
                            }
                        ]
                    }
