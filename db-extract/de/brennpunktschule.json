                "senses": [
                    {
                        "sense_id": "28dcd454-fcb8-31ef-bbab-5c4b0068cedb",
                        "entry_id": "0a7c8268-1ada-39d5-be18-366645d870c1",
                        "glosses": [
                            "Bildungsanstalt mit besonderem sozialpädagogischen Förderbedarf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "402c6807-0ddb-42bb-b3ae-7d620bd789b2",
                                "sense_id": "28dcd454-fcb8-31ef-bbab-5c4b0068cedb",
                                "text": "„Die Grundschule in […] gilt als Brennpunktschule, weil einige Kinder aus problematischen Familien kommen.“"
                            },
                            {
                                "example_id": "34658c68-bc86-48c6-9516-89c88df3b918",
                                "sense_id": "28dcd454-fcb8-31ef-bbab-5c4b0068cedb",
                                "text": "„Das ist eine Form der Schulfinanzierung, bei der Brennpunktschulen mit vielen Kindern aus sozial schwachen oder Migrantenfamilien mehr Geld bekommen.“"
                            },
                            {
                                "example_id": "0b0d5e7b-2da0-4acc-bb0f-eaf583e6f69d",
                                "sense_id": "28dcd454-fcb8-31ef-bbab-5c4b0068cedb",
                                "text": "„Über die alltägliche Aggression solcher Schüler ihren deutschen Altersgenossen gegenüber, von denen Lehrer in Brennpunktschulen immer wieder berichten, ist nur bei besonders dramatischen Exzessen zu lesen und zu hören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
