                                "example_id": "83e52da9-742a-4def-8606-adbd61820bc9",
                                "sense_id": "845e687b-de27-3502-a478-f1cb67c5fa06",
                                "text": "Tour euphémique."
                            },
                            {
                                "example_id": "15df62d5-e0bc-443a-9bab-66f7648f258d",
                                "sense_id": "845e687b-de27-3502-a478-f1cb67c5fa06",
                                "text": "Expression euphémique."
                            },
                            {
                                "example_id": "86868832-3522-4ddb-ac53-a401c9caa6ff",
                                "sense_id": "845e687b-de27-3502-a478-f1cb67c5fa06",
                                "text": "« Vos affaires… pour aller en ville… » La sentence euphémique m’était jetée en plein visage par cette brute indifférente qui exécutait sa macabre corvée comme un sergent de garde réveille un de ses hommes pour lui indiquer l’heure de sa faction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db4d1a88-d66b-4c17-b294-be660a05948b",
                        "source_entry_id": "5a4713bd-d4c0-3918-b4bf-b20f33da720b",
