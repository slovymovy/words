                    {
                        "sense_id": "b277c324-6437-36e2-b670-8e092a47f86a",
                        "entry_id": "6800456b-874d-3a9a-9ab4-c91b8073edd2",
                        "glosses": [
                            "Ville canadienne du Québec située dans la région de Mauricie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "837f0a5f-5bc3-4cad-95bf-93cba67e2900",
                                "sense_id": "b277c324-6437-36e2-b670-8e092a47f86a",
                                "text": "Note : On dit désormais à Trois-Rivières, mais la forme habituelle au XIXᵉ siècle était aux Trois-Rivières."
                            },
                            {
                                "example_id": "5b958210-eedd-478e-aee4-543a73ff563d",
                                "sense_id": "b277c324-6437-36e2-b670-8e092a47f86a",
                                "text": "« Lorsque nous nous sommes syndiqués dans les années 1980 et que nous avons négocié notre première convention collective, nous assumions déjà la moitié de l’enseignement », rappelle Carole Neill, la présidente du syndicat des chargés de cours de l’Université du Québec à Trois-Rivières."
                            },
                            {
                                "example_id": "c593de44-bc6f-4078-abfa-fe6399a7f5c2",
                                "sense_id": "b277c324-6437-36e2-b670-8e092a47f86a",
                                "text": "Ce registre est une première au Québec. D'autres services de police sont d'ailleurs venus à Trois-Rivières pour se familiariser avec son fonctionnement et éventuellement l'ajouter à leurs outils de travail."
                            },
                            {
                                "example_id": "f613158e-f3ec-4340-b2d5-743c10b0fbce",
                                "sense_id": "b277c324-6437-36e2-b670-8e092a47f86a",
                                "text": "Le procès de la belle-mère accusée du meurtre de la fillette martyre de Granby n'aura pas lieu avant septembre 2021, au palais de justice de Trois-Rivières."
                            }
                        ]
                    },
