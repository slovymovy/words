                "senses": [
                    {
                        "sense_id": "10256044-c7c8-37fc-b032-e533f645d2e9",
                        "entry_id": "1e9ea679-4b15-30a9-b023-02ec52daf344",
                        "glosses": [
                            "in Nord- und Mittelamerika verbreitetes Nagetier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7cf4f9e-df4c-4876-a56a-0bb2020532b6",
                                "sense_id": "10256044-c7c8-37fc-b032-e533f645d2e9",
                                "text": "„Ich liege bäuchlings, mit von der Sonne gerötetem Gesicht, auf dem Sand, und meine Hand erkundet den dunklen, mehr als kalten Bau. Vielleicht ein Stinktier. Ein Kojote oder eine Taschenratte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "032c7015-f5d5-4bb4-afce-e9972eb520be",
                        "source_entry_id": "1e9ea679-4b15-30a9-b023-02ec52daf344",
                        "source_sense_id": "10256044-c7c8-37fc-b032-e533f645d2e9",
                        "source_sense_description": "Nagetierart",
                        "target_lang_word": "pocket gopher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pocket gopher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7763db83-236f-3d5f-8d08-ec795169e79e",
                                        "entry_id": "fa3d48f0-a083-31b4-a86d-44f330bc8100",
                                        "glosses": [
                                            "Any of the burrowing rodents of the family Geomyidae, regarded as the \\\"true\\\" gophers, native North and Central America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae11dfd3-a270-46b3-a2b2-5eb3700f608a",
                                                "sense_id": "7763db83-236f-3d5f-8d08-ec795169e79e",
                                                "text": "The pocket gophers are New World endemics for which the fossil history commences in the late Miocene (Kurtén and Anderson, 1980)."
                                            },
                                            {
                                                "example_id": "d53e4946-5b27-476d-9db4-d5073250ed01",
                                                "sense_id": "7763db83-236f-3d5f-8d08-ec795169e79e",
                                                "text": "Produced by pocket gophers, which push soil upward as they burrow along under the surface, soil tubes are most apparent where the soil is rocky."
                                            },
                                            {
                                                "example_id": "3103a747-6802-492c-97ad-f67bfa1cb22d",
                                                "sense_id": "7763db83-236f-3d5f-8d08-ec795169e79e",
                                                "text": "Four species of pocket gophers are currently found within the Great Basin, all of which belong to the genus Thomomys."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
