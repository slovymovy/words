                        "sense_id": "520ccfc6-9822-3007-b92e-ad99e108770d",
                        "entry_id": "e1969cec-acce-3135-98a0-d81980d34228",
                        "glosses": [
                            "het niet verloren kunnen gaan; het eeuwig zijn; het niet vergaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0d691ce-6133-48cf-b704-1ab505e2ab55",
                                "sense_id": "520ccfc6-9822-3007-b92e-ad99e108770d",
                                "text": "Woorden als organisme, vernietiging van organismen, onvergankelijkheid van de stof, de wet van het behoud van energie, evolutie, waren in de plaats van zijn vroeger geloof gekomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c015b53a-b388-4577-a0d6-2a1b8b7c4a52",
                        "source_entry_id": "e1969cec-acce-3135-98a0-d81980d34228",
                        "source_sense_id": "520ccfc6-9822-3007-b92e-ad99e108770d",
                        "source_sense_description": "het niet verloren kunnen gaan; het eeuwig zijn; het niet vergaan",
                        "target_lang_word": "eternity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eternity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7bf054-ae51-30bf-99e0-803b8d21a163",
                                        "entry_id": "e20f5b06-750e-3b8c-8c12-a76a258707f9",
                                        "glosses": [
                                            "Existence without end, infinite time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "125e4f7d-d323-4079-b6fb-97b4a98c27ac",
                                                "sense_id": "2e7bf054-ae51-30bf-99e0-803b8d21a163",
                                                "text": "Eternity has generally been considered as divisible into two parts; which have been termed, eternity a parte ante, and eternity a parte post: that is, in plain English, that eternity which is past, and that eternity which is to come."
                                            },
                                            {
                                                "example_id": "3c77273f-c392-4546-a95d-6110239fbacf",
                                                "sense_id": "2e7bf054-ae51-30bf-99e0-803b8d21a163",
                                                "text": "This theory regards creation as an act of God in eternity past."
                                            },
                                            {
                                                "example_id": "83c2073d-e198-4e76-a626-fd1a33e89729",
                                                "sense_id": "2e7bf054-ae51-30bf-99e0-803b8d21a163",
                                                "text": "Those who like not the company of the saints on earth will get none of it in eternity; but, as godless company is their delight now, they will afterwards get enough of it, when they have eternity to pass in the roaring and blaspheming society of devils and reprobates in hell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3cd4137-d91f-3059-aff2-c56e1f98d2de",
                                        "entry_id": "e20f5b06-750e-3b8c-8c12-a76a258707f9",
                                        "glosses": [
                                            "Existence outside of time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51882160-8050-4dd5-a26e-f6556a6e40b8",
                                                "sense_id": "a3cd4137-d91f-3059-aff2-c56e1f98d2de",
                                                "text": "We sometimes speak of eternity in contradistinction to time; and often say, \"through time and into eternity;\" and again \"from eternity to eternity,\" which is simply another form of expressing the same idea, and \"pass through time into eternity.\" in other words, time is a short period allotted to man in his probationary state—and we use the word time in contradistinction to the word eternity, merely for the accommodation of man in his finite sphere, that we may comprehend and learn to measure periods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72bce441-c4f1-302e-938d-a9fb09b9df76",
                                        "entry_id": "e20f5b06-750e-3b8c-8c12-a76a258707f9",
                                        "glosses": [
                                            "A period of time which extends infinitely far into the future."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ab4ac1-94ca-4d04-b439-0785e995338d",
                                                "sense_id": "72bce441-c4f1-302e-938d-a9fb09b9df76",
                                                "text": "Every niche was filled by a funeral urn, and by marble shapes that bent down in a pale eternity of sorrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e194b2-eef8-3819-85df-11e19f32a873",
                                        "entry_id": "e20f5b06-750e-3b8c-8c12-a76a258707f9",
                                        "glosses": [
                                            "The remainder of time that elapses after death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7714c53d-d7cd-45e1-92ae-206746248c4b",
                                                "sense_id": "39e194b2-eef8-3819-85df-11e19f32a873",
                                                "text": "When the wind blows not, where, then, is the wind? / Or when thou art not living, where art thou? / What should the wind care for the hours of calm or thou for death? / Thy life is long, Eternity is short. / So short that, shouldst thou die and Eternity should pass, and after the passing of Eternity thou shouldst live again, thou wouldst say: ‘I closed mine eyes but for an instant.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56227cac-0de9-3e21-9241-2b1f745edd6e",
                                        "entry_id": "e20f5b06-750e-3b8c-8c12-a76a258707f9",
                                        "glosses": [
                                            "A comparatively long time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "excessive",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e2dd0dd-e209-4af0-985c-cfd805bfd529",
                                                "sense_id": "56227cac-0de9-3e21-9241-2b1f745edd6e",
                                                "text": "It's been an eternity since we last saw each other."
                                            },
                                            {
                                                "example_id": "e3c74bd4-5e3d-4e0a-b919-0a6a0b594e2f",
                                                "sense_id": "56227cac-0de9-3e21-9241-2b1f745edd6e",
                                                "text": "I had to wait in the station for ten days - an eternity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
