                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114f5649-0338-42fa-9bce-99830c79b5c2",
                                                "sense_id": "4f213aa1-a6a1-3f69-8d95-809739541418",
                                                "text": "Hij overwon zijn angst voor het water en nam zwemles."
                                            }
                                        ]
