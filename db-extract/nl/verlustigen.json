                                    {
                                        "sense_id": "5de6e6b1-9235-329f-a481-dded84541603",
                                        "entry_id": "1a093c40-c544-3d2f-84e1-2f95860d9a26",
                                        "glosses": [
                                            "to have someone over at one's home for a party or visit"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3fb6b3f-3116-463e-8f9f-c4d565849217",
                                                "sense_id": "5de6e6b1-9235-329f-a481-dded84541603",
                                                "text": "They enjoy entertaining a lot."
                                            },
                                            {
                                                "example_id": "7dbe8096-d2c3-462a-8a1e-cac59656d041",
                                                "sense_id": "5de6e6b1-9235-329f-a481-dded84541603",
                                                "text": "Be not forgetful to entertain strangers[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "131c5a90-b078-3036-a9da-c34d3aaa7e20",
                                        "entry_id": "1a093c40-c544-3d2f-84e1-2f95860d9a26",
                                        "glosses": [
                                            "to receive and take into consideration; to have a thought in mind"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba2a941-820a-459f-b873-b531ea2db26c",
                                                "sense_id": "131c5a90-b078-3036-a9da-c34d3aaa7e20",
                                                "text": "The committee would like to entertain the idea of reducing the budget figures."
                                            },
                                            {
                                                "example_id": "e7e6b48b-492c-49b4-95c7-8487c2223c92",
                                                "sense_id": "131c5a90-b078-3036-a9da-c34d3aaa7e20",
                                                "text": "to entertain a proposal"
                                            },
                                            {
                                                "example_id": "0dda8585-f63c-4340-ade9-1226645f42a4",
                                                "sense_id": "131c5a90-b078-3036-a9da-c34d3aaa7e20",
                                                "text": "I am not here going to entertain so large a theme as the philosophy of Locke."
                                            },
                                            {
                                                "example_id": "24621325-35e0-4da6-8eca-a5aeb82a1fe3",
                                                "sense_id": "131c5a90-b078-3036-a9da-c34d3aaa7e20",
                                                "text": "A rumour gained ground, — and, however absurd, was entertained by some very sensible people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23854ee9-c904-38ca-b007-395a660c8e45",
                                        "entry_id": "1a093c40-c544-3d2f-84e1-2f95860d9a26",
                                        "glosses": [
                                            "to take or keep in one's service; to maintain; to support; to harbour; to keep"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d8acad0-a29d-4afa-9f32-f31b0d43f672",
                                                "sense_id": "23854ee9-c904-38ca-b007-395a660c8e45",
                                                "text": "Intreat 'em fair, and give them friendly speech,\nAnd seem to them as if thy sins were great,\nTill thou hast gotten to be entertain'd."
                                            },
                                            {
                                                "example_id": "919a4d4e-ea26-49d8-8098-072c3645fa1c",
                                                "sense_id": "23854ee9-c904-38ca-b007-395a660c8e45",
                                                "text": "You, sir, I entertain for one of my hundred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31bca1bc-5927-3974-b43a-c4fd3b75b8b4",
                                        "entry_id": "1a093c40-c544-3d2f-84e1-2f95860d9a26",
                                        "glosses": [
                                            "to meet or encounter, as an enemy"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67f32c4a-472b-4a0c-bbba-5f582da26c65",
                                                "sense_id": "31bca1bc-5927-3974-b43a-c4fd3b75b8b4",
                                                "text": "O noble English, that could entertain with half their forces the full pride of France"
                                            },
                                            {
                                                "example_id": "b74c9960-e857-40bf-a608-e71ad1c3c0e9",
                                                "sense_id": "31bca1bc-5927-3974-b43a-c4fd3b75b8b4",
                                                "text": "Penalty for entertaining a Deserter"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e68faf68-9af0-30c2-8c6e-dff35466b1c4",
                                        "entry_id": "1a093c40-c544-3d2f-84e1-2f95860d9a26",
                                        "glosses": [
                                            "to lead on; to bring along; to introduce"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
