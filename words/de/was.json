{
    "word_family": [
        "etwas",
        "irgendwas"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "47ea5589-f824-3b5e-8bff-afbcf4ca10c5",
                    "sense_definition": "leitet als Interrogativpronomen Fragen nach Sachen, Sachverhalten oder Handlungen ein",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "frage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Was</w> machst du heute nach der Arbeit in deiner Freizeit?"
                        },
                        {
                            "text": "Entschuldigung, <w>was</w> haben Sie gerade eben zu mir gesagt?"
                        }
                    ],
                    "common_phrases": [
                        "was ist das",
                        "was gibt es"
                    ]
                },
                {
                    "sense_id": "4e56e2bb-5b4a-3e52-a559-8d3dbb9cd5bd",
                    "sense_definition": "steht umgangssprachlich verkürzt für etwas zur Bezeichnung einer unbestimmten Sache",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "indefinit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe großen Hunger und muss mir schnell <w>was</w> zu essen kochen."
                        },
                        {
                            "text": "Hast du heute schon <w>was</w> von deinen neuen Nachbarn gehört?"
                        }
                    ],
                    "synonyms": [
                        "etwas"
                    ],
                    "antonyms": [
                        "nichts",
                        "alles"
                    ],
                    "common_phrases": [
                        "was zu essen",
                        "was zu trinken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "standardsprachlich wird etwas verwendet"
                        }
                    ]
                },
                {
                    "sense_id": "f63ff40d-5e84-3a92-94e1-823304d02448",
                    "sense_definition": "bezieht sich als Relativpronomen auf Pronomen wie alles, nichts, das oder auf substantivierte Adjektive",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relativ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das ist das Schönste, <w>was</w> ich je in meinem ganzen Leben gesehen habe."
                        },
                        {
                            "text": "Alles, <w>was</w> für die anstehende Prüfung wichtig ist, steht in diesem Buch."
                        }
                    ],
                    "synonyms": [
                        "das"
                    ],
                    "common_phrases": [
                        "alles was",
                        "nichts was"
                    ]
                },
                {
                    "sense_id": "5c7c4ba2-79bf-3a9e-a9ea-e3f144cddb20",
                    "sense_definition": "bezieht sich als weiterführendes Relativpronomen auf den Inhalt eines gesamten vorangehenden Satzes",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relativ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat die schwierige Prüfung bestanden, <w>was</w> seine ganze Familie sehr gefreut hat."
                        },
                        {
                            "text": "Der Zug hatte leider eine Stunde Verspätung, <w>was</w> bei den Fahrgästen zu großem Ärger führte."
                        }
                    ],
                    "synonyms": [
                        "welches"
                    ]
                },
                {
                    "sense_id": "91ffb93e-a71b-3097-9f9d-42a8b83b77c2",
                    "sense_definition": "bezieht sich umgangssprachlich als Relativpronomen auf ein konkretes sächliches Substantiv",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relativ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dort an der Ecke steht das alte Haus, <w>was</w> im nächsten Monat abgerissen wird."
                        },
                        {
                            "text": "Er hat mir das teure Fahrrad geliehen, <w>was</w> er erst letzte Woche gekauft hat."
                        }
                    ],
                    "synonyms": [
                        "das",
                        "welches"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "standardsprachlich wird hier das Pronomen das gebraucht"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ff057fda-772d-3198-b93e-ddf365a5a760",
                    "sense_definition": "drückt im Sinne von warum oder wieso ein Erstaunen oder einen Vorwurf aus",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ursache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Was</w> schaust du mich denn heute Morgen so vorwurfsvoll an?"
                        },
                        {
                            "text": "<w>Was</w> läufst du bei diesem kalten Regen eigentlich ohne Jacke herum?"
                        }
                    ],
                    "synonyms": [
                        "warum",
                        "wieso",
                        "weshalb"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "gesprochene Sprache"
                        }
                    ]
                },
                {
                    "sense_id": "5fece401-f085-38b7-afb8-b18d30bc0c93",
                    "sense_definition": "steht umgangssprachlich als Adverb im Sinne von ein wenig oder etwas",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Könntest du bei der Besprechung bitte <w>was</w> lauter und deutlicher sprechen?"
                        },
                        {
                            "text": "Wir müssen uns beeilen, denn wir kommen heute leider <w>was</w> später als geplant."
                        }
                    ],
                    "synonyms": [
                        "etwas"
                    ],
                    "antonyms": [
                        "viel"
                    ],
                    "common_phrases": [
                        "was später",
                        "was besser"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachliche Verkürzung"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "1d6bc084-79dc-34b7-9f91-31511a8d32e3",
                    "sense_definition": "dient veraltet oder regional als Begleitwort im Sinne von was für ein oder welcher Art",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf <w>was</w> Weise gedenkt der Rat dieses dringende Problem in der Gemeinde zu lösen?"
                        },
                        {
                            "text": "Von <w>was</w> Art diese Gewächse auch sein mögen, sie brauchen stets reichlich Sonnenlicht."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historische Verwendung"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "landschaftlicher Gebrauch"
                        }
                    ],
                    "common_phrases": [
                        "was für"
                    ]
                }
            ]
        }
    ]
}