                                                "sense_id": "b3c781bf-f84b-3043-a74f-bdd70cb52917",
                                                "text": "Der Welpe zerbeißt ihre Schuhe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0304c6b1-cdd4-3f1a-95e1-4379e9af6d55",
