                ],
                "senses": [
                    {
                        "sense_id": "c9f25432-158b-345f-87a4-1b90d90ce4b7",
                        "entry_id": "dd9bef9b-4830-3f5f-84cc-16445559312c",
                        "glosses": [
                            "vor der Öffentlichkeit verborgene Wissenschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdaec8b2-3dd1-4a0b-8c14-9be924067941",
                                "sense_id": "c9f25432-158b-345f-87a4-1b90d90ce4b7",
                                "text": "„Die moderne Kryptographie ist keine Geheimwissenschaft, nichts, was nur im verborgenen blüht, kein Tabu, das seine Kraft verliert, wenn es dem Licht der Öffentlichkeit ausgesetzt wird.“"
                            },
                            {
                                "example_id": "23fb212b-e31d-4522-a201-ef3efa7ed747",
                                "sense_id": "c9f25432-158b-345f-87a4-1b90d90ce4b7",
                                "text": "„Sobald es sein drittes Jahr erreicht hätte, würde sich Madame d'Urfé ihrer selbst wieder bewußt werden; dann sollte ich beginnen, sie in die vollkommene Kenntnis der Geheimwissenschaften einzuweihen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
