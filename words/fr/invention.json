{
    "word_family": [
        "inventer",
        "inventeur",
        "inventrice",
        "inventif",
        "inventivité"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d298112a-03f1-37c6-bb66-7025d50ae636",
                    "sense_definition": "Dispositif, méthode ou objet nouveau et original résultant d'un travail de conception.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'imprimerie reste l'une des plus remarquables <w>inventions</w> de l'histoire moderne."
                        },
                        {
                            "text": "Ce jeune ingénieur a présenté une nouvelle <w>invention</w> lors du concours annuel."
                        }
                    ],
                    "synonyms": [
                        "trouvaille"
                    ],
                    "antonyms": [
                        "copie",
                        "contrefaçon",
                        "imitation"
                    ],
                    "common_phrases": [
                        "nouvelle invention",
                        "invention technique"
                    ]
                },
                {
                    "sense_id": "4c1d39a0-e8a3-37b3-9e12-2347fdbe12c2",
                    "sense_definition": "Action de concevoir ou de produire quelque chose pour la première fois.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>invention</w> de la roue a transformé le mode de vie des sociétés humaines."
                        },
                        {
                            "text": "Les historiens s'accordent rarement sur la date exacte de cette <w>invention</w>."
                        }
                    ],
                    "synonyms": [
                        "création"
                    ],
                    "common_phrases": [
                        "brevet d'invention"
                    ]
                },
                {
                    "sense_id": "a0d15f2f-b144-3e8e-a328-346f5f33ebb6",
                    "sense_definition": "Capacité créatrice, aptitude de l'esprit à imaginer des solutions ou des formes inédites.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet artiste fait preuve d'une grande force d'<w>invention</w> dans chacune de ses toiles."
                        },
                        {
                            "text": "Son projet manquait cruellement d'<w>invention</w> et d'audace pour convaincre le jury."
                        }
                    ],
                    "synonyms": [
                        "créativité",
                        "inventivité"
                    ],
                    "common_phrases": [
                        "esprit d'invention",
                        "manquer d'invention"
                    ]
                },
                {
                    "sense_id": "e43808c4-df17-3876-92da-1cdfd1ccfaff",
                    "sense_definition": "Chose imaginée de toutes pièces, mensonge ou fable sans fondement réel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute cette histoire de fantôme n'était qu'une pure <w>invention</w> de son frère."
                        },
                        {
                            "text": "Ne crois pas ces rumeurs absurdes, c'est une <w>invention</w> totale."
                        }
                    ],
                    "common_phrases": [
                        "pure invention"
                    ]
                },
                {
                    "sense_id": "4b264acf-030f-3a9d-94c2-a48554a846cf",
                    "sense_definition": "Solution technique apportée à un problème, susceptible de protection juridique par un brevet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour être brevetable, une <w>invention</w> doit être nouvelle et impliquer une activité inventive."
                        },
                        {
                            "text": "Le tribunal a examiné si l'<w>invention</w> avait fait l'objet d'une divulgation antérieure."
                        }
                    ],
                    "common_phrases": [
                        "brevet d'invention"
                    ]
                },
                {
                    "sense_id": "14ab8e09-c982-3b05-a784-eda423628efa",
                    "sense_definition": "Action de découvrir un trésor ou un vestige archéologique enfoui.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "archeologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>invention</w> de ces pièces de monnaie antiques a mobilisé de nombreux chercheurs."
                        },
                        {
                            "text": "Le promeneur a signalé l'<w>invention</w> du trésor aux autorités compétentes."
                        }
                    ],
                    "synonyms": [
                        "découverte"
                    ],
                    "common_phrases": [
                        "invention d'un trésor"
                    ]
                },
                {
                    "sense_id": "2a7de12b-d22e-3744-a14b-c26a41aaf68c",
                    "sense_definition": "Courte pièce musicale polyphonique, généralement composée pour le clavier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'élève pianiste s'exerce chaque matin sur une <w>invention</w> à deux voix."
                        },
                        {
                            "text": "Le recueil comprend plusieurs <w>inventions</w> composées pour perfectionner le jeu polyphonique."
                        }
                    ],
                    "common_phrases": [
                        "invention à deux voix"
                    ]
                },
                {
                    "sense_id": "9cd8827b-645a-3a16-b926-d0b5846b3238",
                    "sense_definition": "Découverte de reliques religieuses, ou fête liturgique célébrée en souvenir de cet événement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La paroisse célébrait autrefois avec ferveur la fête de l'<w>invention</w> de la sainte Croix."
                        },
                        {
                            "text": "Un tableau ancien illustre l'<w>invention</w> miraculeuse des reliques du saint patron."
                        }
                    ],
                    "synonyms": [
                        "découverte"
                    ]
                },
                {
                    "sense_id": "b6fc92a6-54e7-35b8-8274-81cb0415036e",
                    "sense_definition": "Première partie de la rhétorique classique consistant à trouver des arguments probants pour un discours.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rhetorique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le traité cicéronien, l'<w>invention</w> précède la disposition et l'élocution des arguments."
                        },
                        {
                            "text": "L'orateur doit maîtriser l'<w>invention</w> pour rassembler tous les éléments nécessaires à sa défense."
                        }
                    ]
                }
            ]
        }
    ]
}