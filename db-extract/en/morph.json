                ],
                "senses": [
                    {
                        "sense_id": "31889afd-85a6-3bfa-ba7a-7bfac5b62380",
                        "entry_id": "22b9306c-8664-38ef-bc67-5d3959246926",
                        "glosses": [
                            "To change shape, from one form to another, through computer animation."
                        ],
                        "tags": [
                            "ambitransitive",
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a643354d-3bc9-3cad-af65-71e494e941cd",
                        "entry_id": "22b9306c-8664-38ef-bc67-5d3959246926",
                        "glosses": [
                            "To shapeshift."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749e2633-a4c9-4ac0-869b-c2a09f195811",
                                "sense_id": "a643354d-3bc9-3cad-af65-71e494e941cd",
                                "text": "Meta leapt forward. In midair his lower half morphed, and suddenly he was one-half humanoid, one-half coiled spring."
                            },
                            {
                                "example_id": "dda5fd61-8b3e-4f7b-b723-cccce77096a5",
                                "sense_id": "a643354d-3bc9-3cad-af65-71e494e941cd",
                                "text": "\"Would it reflect badly on women if I morphed my bust size up a bit for it? Sorta like wearing a padded bra?\""
                            }
                        ]
                    },
                    {
                        "sense_id": "23e06a3a-b0b6-331d-a951-4f1d9bbd6f07",
                        "entry_id": "22b9306c-8664-38ef-bc67-5d3959246926",
                        "glosses": [
                            "To undergo dramatic change in a seamless and barely noticeable fashion."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4b5bb94d-dbd7-47b7-9547-e7c5144a2e5d",
                                "sense_id": "23e06a3a-b0b6-331d-a951-4f1d9bbd6f07",
                                "text": "By the time politicians in several cities backed down on Tuesday and announced that they would cut or consider reducing fares, the demonstrations had already morphed into a more sweeping social protest, with marchers waving banners carrying slogans like “The people have awakened.”"
                            },
                            {
                                "example_id": "f32e47cd-ad34-42a4-8cfe-f1aa48a60e70",
                                "sense_id": "23e06a3a-b0b6-331d-a951-4f1d9bbd6f07",
                                "text": "“Highbrow and lowbrow, alternative and mainstream, work and play, CEO and hipster are all morphing together today,” [Richard] Florida enthuses."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
