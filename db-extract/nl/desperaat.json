                ],
                "translations": [
                    {
                        "translation_id": "fa0f0121-b9d2-43f0-ba2f-cd2b588aa62b",
                        "source_entry_id": "5b32bae4-647b-31b4-8f24-b19cafb582c8",
                        "source_sense_id": "d46d3f25-36c6-39ff-91c7-14029950af03",
                        "source_sense_description": "de wanhoop nabij, zonder raad",
                        "target_lang_word": "desperate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desperate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d426da8-efa8-32b8-8005-1c3cf0a4f8e0",
                                        "entry_id": "61f4592e-1acd-3fb8-b425-a97fb1264c6a",
                                        "glosses": [
                                            "In dire need (of something); having a dire need or desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04c2d96d-9960-4fc8-addf-700fe2d36964",
                                                "sense_id": "4d426da8-efa8-32b8-8005-1c3cf0a4f8e0",
                                                "text": "I hadn't eaten in two days and was desperate for food."
                                            },
                                            {
                                                "example_id": "bb52b1cc-d48e-4f2a-99ae-8c362acc1772",
                                                "sense_id": "4d426da8-efa8-32b8-8005-1c3cf0a4f8e0",
                                                "text": "desperate to eat; desperate for attention"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc522b31-3345-319a-a1ed-6f1afb58b6b9",
                                        "entry_id": "61f4592e-1acd-3fb8-b425-a97fb1264c6a",
                                        "glosses": [
                                            "Being filled with, or in a state of, despair; hopeless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff06104a-68fb-4b0a-826e-c55ef154cd51",
                                                "sense_id": "cc522b31-3345-319a-a1ed-6f1afb58b6b9",
                                                "text": "I was so desperate at one point, I even went to see a loan shark."
                                            },
                                            {
                                                "example_id": "d47e4b5c-0bc7-4163-902c-7ef84de52aa2",
                                                "sense_id": "cc522b31-3345-319a-a1ed-6f1afb58b6b9",
                                                "text": "Since his exile she hath despised me most,\n Forsworn my company and rail'd at me,\n That I am desperate of obtaining her."
                                            },
                                            {
                                                "example_id": "213f9f18-9bc5-4707-b45e-16999e3d82d0",
                                                "sense_id": "cc522b31-3345-319a-a1ed-6f1afb58b6b9",
                                                "text": "“[…] She takes the whole thing with desperate seriousness. But the others are all easy and jovial—thinking about the good fare that is soon to be eaten, about the hired fly, about anything.”"
                                            },
                                            {
                                                "example_id": "5c66998d-26dd-4e22-86e6-ff9223fcde92",
                                                "sense_id": "cc522b31-3345-319a-a1ed-6f1afb58b6b9",
                                                "text": "But signalman Bridges was never to answer driver Gimbert's desperate question. A deafening, massive blast blew the wagon to shreds, the 44 high-explosive bombs exploding like simultaneous hits from the aircraft they should have been dropped from. The station was instantly reduced to bits of debris, and the line to a huge crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de13e3ac-85d7-37c2-8e14-5fc434f21b30",
                                        "entry_id": "61f4592e-1acd-3fb8-b425-a97fb1264c6a",
                                        "glosses": [
                                            "Beyond hope, leaving little reason for hope; causing despair; extremely perilous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0f4e1c-1267-4044-a693-837e9cb56f62",
                                                "sense_id": "de13e3ac-85d7-37c2-8e14-5fc434f21b30",
                                                "text": "a desperate disease; desperate fortune"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50fcecd7-b9e2-3b0e-9926-d5df6d3d06bb",
                                        "entry_id": "61f4592e-1acd-3fb8-b425-a97fb1264c6a",
                                        "glosses": [
                                            "Involving or employing extreme measures, without regard to danger or safety; reckless due to hopelessness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96572d27-1054-4685-83ef-73de983ae79a",
                                                "sense_id": "50fcecd7-b9e2-3b0e-9926-d5df6d3d06bb",
                                                "text": "He dove into the rushing waters in a desperate effort to save her life."
                                            },
                                            {
                                                "example_id": "8b85cab8-7bac-4a2f-a44a-e8fd168b3845",
                                                "sense_id": "50fcecd7-b9e2-3b0e-9926-d5df6d3d06bb",
                                                "text": "In England his flute was not in request; there were no convents; and he was forced to have recourse to a series of desperate expedients."
                                            },
                                            {
                                                "example_id": "98af21ff-75bd-441a-bb56-ca61fdfe849c",
                                                "sense_id": "50fcecd7-b9e2-3b0e-9926-d5df6d3d06bb",
                                                "text": "“I knew very well that when the Peruvian Indian does anything wrong it is because he is forced to it by oppression and made desperate by abuse,” replied Lucia."
                                            },
                                            {
                                                "example_id": "428238ce-536d-405c-994e-7d75e5c2ed1b",
                                                "sense_id": "50fcecd7-b9e2-3b0e-9926-d5df6d3d06bb",
                                                "text": "Humankind's global integration makes biological combat a weapon of choice for desperate killers, who are either suicidal or intend to infect others […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69035a2b-5f27-3f34-914c-d6bf0a3d2bb2",
                                        "entry_id": "61f4592e-1acd-3fb8-b425-a97fb1264c6a",
                                        "glosses": [
                                            "Extremely bad; outrageous, shocking; intolerable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b8918cc-6d81-4a0e-aebd-312744aaab12",
                                                "sense_id": "69035a2b-5f27-3f34-914c-d6bf0a3d2bb2",
                                                "text": "a desperate offendress against nature"
                                            },
                                            {
                                                "example_id": "57279eca-55ef-402b-b699-e557a9acf561",
                                                "sense_id": "69035a2b-5f27-3f34-914c-d6bf0a3d2bb2",
                                                "text": "The worst that can be laid to the charge of this poor youth, whom it has been the fashion to represent as the most desperate of reprobates, as a village Rochester, is, that he had a great liking for some diversions, quite harmless in themselves, but condemned by the rigid precisians among whom he lived, and for whose opinion he had a great respect."
                                            },
                                            {
                                                "example_id": "7bf136e8-5399-4187-831d-55d03f2287d5",
                                                "sense_id": "69035a2b-5f27-3f34-914c-d6bf0a3d2bb2",
                                                "text": "The letters which were of most importance were in half a dozen languages and in the desperate handwriting of the period. Eminent men in that age thought it - like Hamlet - a baseness to write fair. Often at the end of a page I have[…]"
                                            },
                                            {
                                                "example_id": "ffb7c0b4-00b3-46d8-9ac5-ddaec199968d",
                                                "sense_id": "69035a2b-5f27-3f34-914c-d6bf0a3d2bb2",
                                                "text": "She pictured having a boyfriend over and losing him when he saw her desperate taste in shampoo; however, the chances of that happening were slim."
                                            },
                                            {
                                                "example_id": "5d0eda1f-dbde-4e29-a9ab-21f016024cc4",
                                                "sense_id": "69035a2b-5f27-3f34-914c-d6bf0a3d2bb2",
                                                "text": "Whoever's writing the stuff on this has desperate handwriting, like they must be a doctor..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6f6eb4f-919f-38fa-8bc7-720395433002",
                                        "entry_id": "61f4592e-1acd-3fb8-b425-a97fb1264c6a",
                                        "glosses": [
                                            "Intense; extremely intense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2c38a9-fae9-4fea-9ec8-cf3778d18f65",
                                                "sense_id": "d6f6eb4f-919f-38fa-8bc7-720395433002",
                                                "text": "She enraged some country ladies with three times her money, by a sort of desperate perfection which they found in her."
                                            },
                                            {
                                                "example_id": "3d8c99ac-06a1-4562-a979-ffcc5204db8a",
                                                "sense_id": "d6f6eb4f-919f-38fa-8bc7-720395433002",
                                                "text": "For Liverpool, it capped six days of desperate disappointment after missing out on the Premier League to Manchester City by a single point then losing to this experienced, street-smart Real team."
                                            }
                                        ]
                                    }
                                ]
                            },
