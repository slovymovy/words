                                "target_senses": [
                                    {
                                        "sense_id": "a97c400c-c988-30cc-b3d7-e405ed447c32",
                                        "entry_id": "44ad25b4-9d53-35b8-839a-bcc7f020ec8f",
                                        "glosses": [
                                            "Céréale cultivée dans les régions chaudes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb79839e-eda4-4326-8100-1b6f1bc531f7",
                                                "sense_id": "a97c400c-c988-30cc-b3d7-e405ed447c32",
                                                "text": "Le sorgo est la troisième céréale consommée au monde après le riz et le blé."
                                            },
                                            {
                                                "example_id": "27d413e9-711d-445e-853e-e8347194c1f3",
                                                "sense_id": "a97c400c-c988-30cc-b3d7-e405ed447c32",
                                                "text": "La mélasse de sorgo était un sucre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e77ea15-f433-3b91-a646-39621c04cb97",
                                        "entry_id": "44ad25b4-9d53-35b8-839a-bcc7f020ec8f",
                                        "glosses": [
                                            "Genre de graminées dont il y a plusieurs variétés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68019df-8567-4918-aeec-390a43ecd8ee",
                                                "sense_id": "5e77ea15-f433-3b91-a646-39621c04cb97",
                                                "text": "Le sorgo sert à faire des balais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9a9cf42-5b2d-41d7-a449-6550402f543c",
                        "source_entry_id": "521b75cf-569b-3f5c-9014-1df01dec5627",
