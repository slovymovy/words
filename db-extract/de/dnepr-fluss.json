                ],
                "senses": [
                    {
                        "sense_id": "1782175f-eb61-38ec-951d-50a64bfec7c1",
                        "entry_id": "04876c14-047c-35b1-81f1-c16e8824ff81",
                        "glosses": [
                            "Fluss Dnjepr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98d0fb14-2796-43ec-9f97-0447ca50b6e0",
                                "sense_id": "1782175f-eb61-38ec-951d-50a64bfec7c1",
                                "text": "„Die Stadt wirkt aufgrund ihrer Hanglage am breiten Dnepr-Fluss, der weiten Schneisen und großen Plätze weitläufig und einladend.“"
                            },
                            {
                                "example_id": "a5df32b3-664b-4ab3-bdff-91b6c831ecba",
                                "sense_id": "1782175f-eb61-38ec-951d-50a64bfec7c1",
                                "text": "„Jetzt beansprucht der Kreml-Chef das größte Atomkraftwerk Europas in Saporischschja am Dnepr-Fluss für sich!“"
                            },
                            {
                                "example_id": "4caea555-5290-4a8a-a0ea-eeedaf9bb685",
                                "sense_id": "1782175f-eb61-38ec-951d-50a64bfec7c1",
                                "text": "„Die Vorfahren der späteren slawischen Einzelvölker und Stämme begannen zwar schon im 4.-5. Jh. n. Chr. aus der Karpaten-Pripet-Urheimat in allen Himmelsrichtungen abzuwandern (mit Ausnahme Ost und Südost), die relative sprachliche Einheit der weit auseinander siedelnden Gruppen zwischen Nordrußland und Griechenland, zwischen Norditalien und dem Dnepr-Fluß wurde jedoch sehr lange Zeit, zumindest bis zum 11. Jh., teilweise sogar darüber hinaus, aufbewahrt.“"
                            },
                            {
                                "example_id": "b046fd1a-e460-4a84-908c-f8c75232d4ec",
                                "sense_id": "1782175f-eb61-38ec-951d-50a64bfec7c1",
                                "text": "„Die Hinneigung der Massen nach Moskau schlug ins Gegenteil um, als Moskau hinter dem Rücken der Ukraine 1667 den Vertrag von Andrussowo abschloß, dem zufolge die rechtsseitige Ukraine (d. h. rechts vom Dnepr-Fluß) an Polen und linksseitige an Moskau fallen sollte.“"
                            },
                            {
                                "example_id": "7d11d93f-ceb1-4860-8e69-dd3f14d2128f",
                                "sense_id": "1782175f-eb61-38ec-951d-50a64bfec7c1",
                                "text": "„Diese »Rhos« waren aus unbekannten Gegenden, fern im Norden des byzantinischen Kulturkreises, mit ihren Booten vom Dnepr-Fluß ins Schwarze Meer gelangt und nach Konstantinopel gerudert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
