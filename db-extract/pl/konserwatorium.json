                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conservatorium",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ef3bdc4-e87d-379d-8735-11464c242b15",
                                        "entry_id": "a66f7e9a-02f6-3ce2-b231-0c4fca882982",
                                        "glosses": [
                                            "een school in het hoger onderwijs waar men zich kan laten opleiden tot professioneel musicus, acteur/actrice of danser(es)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88ff6994-5061-487d-93e8-0a5de27176c0",
                                                "sense_id": "8ef3bdc4-e87d-379d-8735-11464c242b15",
                                                "text": "Hoewel hij een goede leerling was bij de muziekschool in zijn stad, kreeg hij toch geen plaats op het conservatorium."
                                            },
                                            {
                                                "example_id": "dad87faf-48d2-470a-ab8f-cb6701ec5621",
                                                "sense_id": "8ef3bdc4-e87d-379d-8735-11464c242b15",
                                                "text": "Van jongs af aan heeft Frens, zo vertelt hij, altijd graag gezongen en de afgelopen twee jaar groeide dat uit tot het verlangen om naar het conservatorium te gaan en beroepszanger te worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6bf2df5-f1d9-427f-8786-86a6b6cfc885",
                        "source_entry_id": "44dccee8-de48-3a77-a5db-55664af89d7a",
                        "source_sense_id": "bbdbb272-5b1d-3172-b799-096efe5e4331",
                        "target_lang_word": "Konservatorium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konservatorium",
