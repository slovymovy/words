                        "examples": [
                            {
                                "example_id": "97dc3cd0-8365-4e00-be24-19c5b7e53c80",
                                "sense_id": "56f9efa0-416b-32cf-9301-928911dacf88",
                                "text": "Obsydian dający bardzo ostre i twarde krawędzie odłupków był chętnie używany w różnych kulturach epoki kamienia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
