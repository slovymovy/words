                        "examples": [
                            {
                                "example_id": "0a821813-4a30-40dc-bfaa-3e34414d9e97",
                                "sense_id": "7129a680-6e6c-312a-ae4d-9e2072ad281c",
                                "text": "Vooral internationale drugsbendes kopen massaal tweedehandsleasewagens op om ze vervolgens in het buitenland door te verkopen en zo hun drugsgeld wit te wassen, schrijft De Telegraaf. De krant haalt een voorbeeld van een Libanees drugssyndicaat aan dat een paar jaar terug in Hoogeveen voor bijna 10 miljoen euro aan auto's contant afrekende."
                            },
                            {
                                "example_id": "6cad756d-025e-4c94-a7f7-55c628ec120e",
                                "sense_id": "7129a680-6e6c-312a-ae4d-9e2072ad281c",
                                "text": "Vrijdag werd bekendgemaakt dat vijf spelers van de Titans zijn aangeklaagd en in maart voor de rechter moeten verschijnen. De spelers worden ervan verdacht tussen augustus en december contact te hebben gehad met een drugssyndicaat, waar ze cocaïne zouden hebben geregeld voor vrienden en collega's. Het vijftal is meteen geschorst door de club."
                            }
                        ]
