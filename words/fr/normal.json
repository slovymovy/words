                        "vie normale",
                        "situation normale"
                    ]
                },
                {
                    "sense_id": "acde2fe8-abf4-368d-8244-b24c65c99155",
                    "sense_definition": "Qui est conforme à une règle établie, à un ordre ou à une norme standard.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "regle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train circule à nouveau selon les horaires <w>normaux</w> après les travaux."
                        },
                        {
                            "text": "Dans des conditions <w>normales</w> d'utilisation, cet appareil fonctionne pendant plusieurs années."
                        }
                    ],
                    "antonyms": [
                        "anormal"
                    ],
                    "common_phrases": [
