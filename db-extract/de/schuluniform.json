                "senses": [
                    {
                        "sense_id": "9bc82bbc-2c53-336e-b308-f78f6102e4f6",
                        "entry_id": "611f1566-9919-3efe-bc94-5fd8f53742d5",
                        "glosses": [
                            "Einheitskleidung, die die Schüler in manchen Staaten bzw. Schulen zu tragen verpflichtet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac547187-ce23-4e44-b51a-daa652252439",
                                "sense_id": "9bc82bbc-2c53-336e-b308-f78f6102e4f6",
                                "text": "Während in Großbritannien Schuluniformen vorgeschrieben sind, können sich deutsche Schüler in der Regel kleiden, wie sie möchten."
                            },
                            {
                                "example_id": "a9466bed-5459-400f-af16-c64117588a5b",
                                "sense_id": "9bc82bbc-2c53-336e-b308-f78f6102e4f6",
                                "text": "„An dem Morgen, an dem er das erste Mal wieder zur Schule gehen sollte, kam Bobby in seiner Schuluniform und mit fest geknoteter Krawatte nach unten.“"
                            },
                            {
                                "example_id": "e36c211a-8e96-4d66-9efc-bef3342c8c2d",
                                "sense_id": "9bc82bbc-2c53-336e-b308-f78f6102e4f6",
                                "text": "„Das Mädchen dagegen wirkt stets wie aus dem Ei gepellt, sieht immer so aus, als hätte es sein einziges Kleid und seine Schuluniform gerade aus der Reinigung geholt.“"
                            },
                            {
                                "example_id": "670c3cf8-96fd-4df2-9f96-913264fa4250",
                                "sense_id": "9bc82bbc-2c53-336e-b308-f78f6102e4f6",
                                "text": "„Alle unsere Lehrbücher waren von der gleichen Hand geschrieben, die Schuluniformen nach gleichem Muster gestrickt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
