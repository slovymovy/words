                "senses": [
                    {
                        "sense_id": "75977b1f-0c42-32b0-92e1-b5f9037a5154",
                        "entry_id": "7274b04b-e971-3874-b0ad-d400974ff99f",
                        "glosses": [
                            "Menge aller sprachlicher Ausdrücke, die in ein und derselben sprachlichen Umgebung im Satz vorkommen können."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08f6ee81-c543-4ab4-8a2f-f630144544a7",
                                "sense_id": "75977b1f-0c42-32b0-92e1-b5f9037a5154",
                                "text": "In einem Satz wie \"Er kommt … nach Hause\" kann man an der Leerstelle Ausdrücke einsetzen wie: \"sofort\", spät\", \"gern\", \"immer wieder\", \"nie wieder\". Diese einsetzbaren Ausdrücke bilden mit sehr vielen anderen zusammen eine Distributionsklasse."
                            },
                            {
                                "example_id": "9b1f765c-d254-4475-b9c9-78a5f35090b2",
                                "sense_id": "75977b1f-0c42-32b0-92e1-b5f9037a5154",
                                "text": "Eine Distributionsklasse wird von den Elementen gebildet, die in der gleichen Umgebung vorkommen und daher gegeneinander ausgetauscht werden können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
