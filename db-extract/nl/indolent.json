                "senses": [
                    {
                        "sense_id": "26637c66-aa68-3f7f-8845-3dea8add9e3e",
                        "entry_id": "2089ce80-4d75-36dc-9fa7-4c343b64d9e0",
                        "glosses": [
                            "traag en onverschillig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bc2dad5-32e5-4280-86e3-e135816e6a08",
                                "sense_id": "26637c66-aa68-3f7f-8845-3dea8add9e3e",
                                "text": "Voor Sluijters' favoriete zwarte model Tonia, noch voor de 'schijnbaar indolente' Stieltjes vormde Mondriaans reputatie van een dolende in de abstractie een belemmering om vanaf hun eerste ontmoeting een `intense bewondering' voor de man en zijn werk op te vatten. Naar verluidt waren zij op deze 'blanke ziel' geattendeerd door de kunstcriticus en onderdirecteur van het Rijksmuseum Willem Steenhoff."
                            },
                            {
                                "example_id": "b1ff2d84-ff54-4178-91d4-691c76878f56",
                                "sense_id": "26637c66-aa68-3f7f-8845-3dea8add9e3e",
                                "text": "En na een onverschillige en indolente blik op alle gevangenen beval hij de officier van de wacht hen fatsoenlijk te kleden en te verzorgen voordat ze aan de maarschalk werden voorgeleid."
                            }
                        ]
                    }
                ],
                "translations": [
