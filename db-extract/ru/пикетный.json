                        "tags": [
                            "comparative"
                        ],
                        "form": "пике́тнее"
                    },
                    {
                        "form_id": "a2d618e0-a5ae-467d-b588-ade4b9706f0d",
                        "entry_id": "f2baa08e-f7e3-338b-9f2c-6d71823b7810",
