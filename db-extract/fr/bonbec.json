                        "examples": [
                            {
                                "example_id": "ea80b94d-c54a-443f-ab63-80acf3ba3136",
                                "sense_id": "58750f4e-9832-3c7b-8d4c-737aaf17ff4f",
                                "text": "Je reste mince sans faire de régime particulier et je mange des tonnes de bonbecs acidulés sans prendre un gramme."
                            },
                            {
                                "example_id": "cc82e822-9fc6-4cbe-8e0d-414dbeeb633f",
                                "sense_id": "58750f4e-9832-3c7b-8d4c-737aaf17ff4f",
                                "text": "Et les médecins ne tombent jamais malades, les nutritionnistes ne mangent ni bonbecs ni chips, les cordonniers sont toujours bien chaussés."
                            },
                            {
                                "example_id": "33dbf06b-97ca-47bf-9347-4e3766c7a42a",
                                "sense_id": "58750f4e-9832-3c7b-8d4c-737aaf17ff4f",
                                "text": "Aguerris qu’ils étaient aux pires saloperies, capables de schlasser un mec pour un regard ou un sachet de bonbecs."
                            }
                        ]
                    }
                ],
