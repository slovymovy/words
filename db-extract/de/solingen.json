                    {
                        "sense_id": "d6f392ef-25bb-3429-804b-ce482a4f8923",
                        "entry_id": "b99b2486-3042-3879-b9ec-bf9abc4626eb",
                        "glosses": [
                            "Stadt, kreisfreie Großstadt in Nordrhein-Westfalen, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d16ed5-1ebe-43bf-a648-7ca30b6ec161",
                                "sense_id": "d6f392ef-25bb-3429-804b-ce482a4f8923",
                                "text": "Wir haben in Solingen unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "602e2465-8e86-44f6-a24c-e5df366efee8",
                                "sense_id": "d6f392ef-25bb-3429-804b-ce482a4f8923",
                                "text": "Nach Solingen führen viele Wege."
                            },
                            {
                                "example_id": "2f142d3d-4c1a-4a2e-be9f-74d49e2adbe7",
                                "sense_id": "d6f392ef-25bb-3429-804b-ce482a4f8923",
                                "text": "Solingen liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "88f5b8bf-c872-44cb-8287-98fd54405bf0",
                                "sense_id": "d6f392ef-25bb-3429-804b-ce482a4f8923",
                                "text": "Solingen liegt im Bergischen Land."
                            },
                            {
                                "example_id": "d1c43cc7-99c9-466b-a2b5-fa67ee845390",
                                "sense_id": "d6f392ef-25bb-3429-804b-ce482a4f8923",
                                "text": "Ich bin in Solingen geboren."
                            }
                        ],
