                "senses": [
                    {
                        "sense_id": "71f5d086-2445-359a-a07f-b1bee9496dcb",
                        "entry_id": "4e6fcc9a-d330-301e-a574-a76139fba750",
                        "glosses": [
                            "Regen, der abends fällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d739bee-15d5-4dbb-80a4-bdf27b489e03",
                                "sense_id": "71f5d086-2445-359a-a07f-b1bee9496dcb",
                                "text": "„Als Sebastian Drexler seinen Leihwagen, einen Mercedes, aus dem Abendregen durch ein offenes Tor in das große Lagerhaus beim Flugplatz Toussus-le-Noble lenkte, warteten dort bereits fünf unauffällige Autos mit laufendem Motor und Fahrer hinterm Steuer auf ihn.“"
                            },
                            {
                                "example_id": "4dab352d-3998-4941-b469-1e8889d1c988",
                                "sense_id": "71f5d086-2445-359a-a07f-b1bee9496dcb",
                                "text": "„Oft hockte Suttree auf der Vorderbank im Comer’s und sah durchs Fenster hinunter auf den Straßenverkehr, zu den Pärchen, die im Abendregen zur Kinokasse strebten, zu den schmierigen Vordachlichtern, die in der feuchten Straße brannten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
