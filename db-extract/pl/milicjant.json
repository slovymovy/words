                                            {
                                                "example_id": "cab533de-e7df-4530-95f1-b33c2c7b1f9c",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Zuletzt hätten die islamistischen Milizionäre in einigen Stadtteilen sogar wieder die Kontrolle übernommen.“"
                                            },
                                            {
                                                "example_id": "0401a84a-955c-464e-b6a3-95b323f81607",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Ein Milizionär durchtrennte mit Babas Messer ihre Fesseln.“"
                                            },
                                            {
                                                "example_id": "895d8ddc-e2a9-4f12-a5be-649b7698ec6d",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Erst als sich die Situation etwas beruhigt, findet die Mutter des jungen Mannes bei einem polnischen Milizionär Gehör.“"
                                            },
                                            {
                                                "example_id": "a947ad84-9885-4d5d-af40-9cb135e8096a",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Dagegen lösten iranische Milizionäre mit Maschinengewehren behagliche Gefühle in ihr aus.“"
                                            }
