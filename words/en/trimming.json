{
    "word_family": [
        "trim"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a83d1adc-f12e-3e28-8352-6ef3c40bbd45",
                    "sense_definition": "The act or process of cutting or pruning something to make it neat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Trimming</w> hedges is easiest when the shears have recently been resharpened.",
                            "target_lang_translations": {
                                "pl": "<w>Przycinanie</w> żywopłotów jest najłatwiejsze, gdy nożyce zostały niedawno naostrzone."
                            }
                        },
                        {
                            "text": "Regular <w>trimming</w> keeps the garden looking tidy and healthy.",
                            "target_lang_translations": {
                                "pl": "Regularne <w>przycinanie</w> sprawia, że ogród wygląda schludnie i zdrowo."
                            }
                        }
                    ],
                    "synonyms": [
                        "pruning",
                        "clipping"
                    ],
                    "common_phrases": [
                        "hedge trimming"
                    ],
                    "target_lang_definitions": {
                        "pl": "Czynność przycinania lub skracania czegoś w celu nadania schludnego wyglądu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przycinanie",
                                "target_lang_sense_clarification": "ogólne określenie skracania roślin lub materiałów"
                            },
                            {
                                "target_lang_word": "strzyżenie",
                                "target_lang_sense_clarification": "w odniesieniu do żywopłotów lub włosów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1db2510d-521d-324d-b7aa-c282d8c105ef",
                    "sense_definition": "An ornamental accessory or decoration added to clothing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dress featured delicate lace <w>trimming</w> along the sleeves.",
                            "target_lang_translations": {
                                "pl": "Sukienka miała delikatne koronkowe <w>wykończenie</w> wzdłuż rękawów."
                            }
                        },
                        {
                            "text": "She chose a gold <w>trimming</w> to decorate the edges of the coat.",
                            "target_lang_translations": {
                                "pl": "Wybrała złote <w>obszycie</w>, aby ozdobić brzegi płaszcza."
                            }
                        }
                    ],
                    "synonyms": [
                        "decoration",
                        "embellishment",
                        "trim"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ozdobny dodatek lub wykończenie dodane do odzieży."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wykończenie",
                                "target_lang_sense_clarification": "element dekoracyjny na krawędziach tkaniny"
                            },
                            {
                                "target_lang_word": "obszycie",
                                "target_lang_sense_clarification": "ozdobna lamówka lub brzeg"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "780a36e6-ba1a-383c-9204-c89e47edc451",
                    "sense_definition": "Additional items or accompaniments that go with something, especially food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accompaniment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a traditional Christmas dinner with all the <w>trimmings</w>.",
                            "target_lang_translations": {
                                "pl": "Zjedliśmy tradycyjny świąteczny obiad ze wszystkimi <w>dodatkami</w>."
                            }
                        },
                        {
                            "text": "The burger came with all the <w>trimmings</w> like lettuce and tomato.",
                            "target_lang_translations": {
                                "pl": "Burger był podany ze wszystkimi <w>dodatkami</w>, takimi jak sałata i pomidor."
                            }
                        }
                    ],
                    "synonyms": [
                        "accompaniment",
                        "accessory"
                    ],
                    "common_phrases": [
                        "all the trimmings"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dodatkowe elementy lub dodatki serwowane z głównym daniem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dodatki",
                                "target_lang_sense_clarification": "składniki towarzyszące daniu głównemu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7876c2f3-d59e-3c3f-bd9f-a67eafccf9f2",
                    "sense_definition": "Small pieces of material removed while cutting or preparing something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave the meat <w>trimmings</w> to the dog under the kitchen table.",
                            "target_lang_translations": {
                                "pl": "Oddał <w>skrawki</w> mięsa psu pod kuchennym stołem."
                            }
                        },
                        {
                            "text": "Collect the fabric <w>trimmings</w> to use for smaller craft projects.",
                            "target_lang_translations": {
                                "pl": "Zbieraj <w>skrawki</w> materiału, aby wykorzystać je do mniejszych projektów rękodzielniczych."
                            }
                        }
                    ],
                    "synonyms": [
                        "scraps",
                        "cuttings"
                    ],
                    "target_lang_definitions": {
                        "pl": "Małe kawałki materiału pozostałe po przycinaniu lub przygotowywaniu czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skrawki",
                                "target_lang_sense_clarification": "odpady materiału lub żywności"
                            },
                            {
                                "target_lang_word": "odcinki",
                                "target_lang_sense_clarification": "kawałki pozostałe po cięciu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79ac6e35-456c-3953-9bc1-4d99567e9e5a",
                    "sense_definition": "A severe scolding or reprimand.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reprimand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave the employee a sharp <w>trimming</w> for the mistake.",
                            "target_lang_translations": {
                                "pl": "Kierownik udzielił pracownikowi ostrej <w>bury</w> za ten błąd."
                            }
                        },
                        {
                            "text": "He received a stern <w>trimming</w> after arriving late to the meeting.",
                            "target_lang_translations": {
                                "pl": "Otrzymał surową <w>naganę</w> po spóźnieniu się na spotkanie."
                            }
                        }
                    ],
                    "synonyms": [
                        "reprimand",
                        "scolding",
                        "rebuke"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is considered old-fashioned."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Surowa reprymenda lub nagana."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bura",
                                "target_lang_sense_clarification": "potoczne określenie nagany"
                            },
                            {
                                "target_lang_word": "ochrzan",
                                "target_lang_sense_clarification": "bardzo surowa reprymenda"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a60c1544-1499-3976-becb-8a7427e9def3",
                    "sense_definition": "The present participle and gerund of <w>trim</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am helping my elderly neighbour by <w>trimming</w> his hedge.",
                            "target_lang_translations": {
                                "pl": "Pomagam mojemu starszemu sąsiadowi, <w>przycinając</w> jego żywopłot."
                            }
                        },
                        {
                            "text": "She spent the afternoon <w>trimming</w> the excess fat off the meat.",
                            "target_lang_translations": {
                                "pl": "Spędziła popołudnie, <w>odcinając</w> nadmiar tłuszczu z mięsa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb trim."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów czasu teraźniejszego i rzeczownik odczasownikowy od czasownika 'trim'."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przycinając",
                                "target_lang_sense_clarification": "forma imiesłowowa"
                            },
                            {
                                "target_lang_word": "przycinanie",
                                "target_lang_sense_clarification": "forma rzeczownikowa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}