{
    "word_family": [
        "arogancja",
        "arogancko"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "13723afb-ab3b-39a1-abe0-f8b2502ea349",
                    "sense_definition": "odznaczający się arogancją, traktujący innych ludzi z wyższością i lekceważeniem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postawa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowy dyrektor okazał się niezwykle <w>arogancki</w> wobec swoich długoletnich pracowników.",
                            "target_lang_translations": {
                                "ru": "Новый директор оказался чрезвычайно <w>высокомерным</w> по отношению к своим давним сотрудникам."
                            }
                        },
                        {
                            "text": "Ten <w>arogancki</w> człowiek nigdy nie słucha cudzego zdania podczas dyskusji.",
                            "target_lang_translations": {
                                "ru": "Этот <w>надменный</w> человек никогда не прислушивается к чужому мнению во время дискуссии."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezczelny",
                        "butny",
                        "zuchwały"
                    ],
                    "antonyms": [
                        "pokorny",
                        "uprzejmy"
                    ],
                    "common_phrases": [
                        "arogancki człowiek",
                        "zbyt arogancki"
                    ],
                    "target_lang_definitions": {
                        "ru": "отличающийся высокомерием, надменный, относящийся к другим с пренебрежением и чувством превосходства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "о человеке, ставящем себя выше других"
                            },
                            {
                                "target_lang_word": "надменный",
                                "target_lang_sense_clarification": "о человеке, проявляющем спесь и превосходство"
                            },
                            {
                                "target_lang_word": "наглый",
                                "target_lang_sense_clarification": "бесцеремонный и вызывающий"
                            },
                            {
                                "target_lang_word": "нахальный",
                                "target_lang_sense_clarification": "развязный и пренебрегающий приличиями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6792dcd-7ef9-3cfa-b8c7-d50cffe63c54",
                    "sense_definition": "będący wyrazem lekceważenia, wyższości lub braku szacunku dla innych",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postawa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel natychmiast zwrócił uwagę uczniowi na jego <w>aroganckie</w> zachowanie.",
                            "target_lang_translations": {
                                "ru": "Учитель сразу же сделал ученику замечание за его <w>вызывающее</w> поведение."
                            }
                        },
                        {
                            "text": "Jej <w>arogancka</w> odpowiedź podczas zebrania oburzyła niemal wszystkich obecnych.",
                            "target_lang_translations": {
                                "ru": "Её <w>дерзкий</w> ответ на собрании возмутил почти всех присутствующих."
                            }
                        }
                    ],
                    "synonyms": [
                        "impertynencki",
                        "lekceważący",
                        "bezczelny"
                    ],
                    "antonyms": [
                        "kulturalny",
                        "taktowny"
                    ],
                    "common_phrases": [
                        "aroganckie zachowanie",
                        "arogancka odpowiedź",
                        "arogancki ton"
                    ],
                    "target_lang_definitions": {
                        "ru": "выражающий пренебрежение, высокомерие или неуважение к окружающим (о поведении, тоне, поступках)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "о поведении или тоне, выражающем превосходство"
                            },
                            {
                                "target_lang_word": "наглый",
                                "target_lang_sense_clarification": "о вызывающем или развязном поведении"
                            },
                            {
                                "target_lang_word": "дерзкий",
                                "target_lang_sense_clarification": "о непочтительном ответе или жесте"
                            },
                            {
                                "target_lang_word": "вызывающий",
                                "target_lang_sense_clarification": "о тоне или поведении, нарушающем нормы приличия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}