    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b52280b-29fa-324d-8e09-9a48f9a0b269",
                    "sense_definition": "iemand die op een irritante manier over zichzelf opschept zonder dat daar een goede reden voor is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opschepper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen vond hem een vervelende <w>blaaskaak</w> omdat hij constant over zijn dure auto praatte.",
                            "target_lang_translations": {
                                "en": "Everyone thought he was an annoying <w>blowhard</w> because he constantly talked about his expensive car."
                            }
                        },
                        {
                            "text": "Geloof niet alles wat hij zegt, hij is gewoon een grote <w>blaaskaak</w>.",
                            "target_lang_translations": {
                                "en": "Don't believe everything he says, he's just a big <w>braggart</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "opschepper",
                        "snoever",
                        "bluffer",
                        "opsnijder",
                        "pocher",
                        "praatjesmaker"
                    ],
                    "common_phrases": [
                        "grote blaaskaak",
                        "arrogante blaaskaak",
                        "vervelende blaaskaak"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "someone who boasts about themselves in an annoying way without a good reason"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blowhard",
                                "target_lang_sense_clarification": "a person who talks too much and boasts"
                            },
                            {
                                "target_lang_word": "braggart",
                                "target_lang_sense_clarification": "someone who boasts about achievements or possessions"
                            },
                            {
                                "target_lang_word": "show-off",
                                "target_lang_sense_clarification": "someone who tries to impress others with their abilities or belongings"
                            },
                            {
                                "target_lang_word": "windbag",
                                "target_lang_sense_clarification": "someone who talks a lot but says little of value"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d3f3d1e6-ae8a-371a-934c-7ecd5c50d7c6",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>blaaskaken</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>blaaskaak</w> misschien een beetje over mijn resultaten, maar ik ben er gewoon erg trots op.",
                            "target_lang_translations": {
                                "en": "I might <w>boast</w> a little about my results, but I'm just very proud of them."
                            }
                        },
                        {
                            "text": "Soms <w>blaaskaak</w> ik tegen mijn vrienden om indruk te maken.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>brag</w> to my friends to make an impression."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "werkwoordsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'to boast' or 'to brag'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boast",
                                "target_lang_sense_clarification": "to speak with excessive pride"
                            },
                            {
                                "target_lang_word": "brag",
                                "target_lang_sense_clarification": "to talk boastfully"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c69b334e-82b8-35e9-8d36-c8aa38f8c382",
                    "sense_definition": "de gebiedende wijs van <w>blaaskaken</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Blaaskaak</w> niet zo over je nieuwe baan, want niemand vindt het interessant.",
                            "target_lang_translations": {
                                "en": "Don't <w>brag</w> so much about your new job, because nobody finds it interesting."
                            }
                        },
                        {
                            "text": "Hou op en <w>blaaskaak</w> elders!",
                            "target_lang_translations": {
                                "en": "Stop it and go <w>boast</w> elsewhere!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative form of 'to boast' or 'to brag'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boast",
                                "target_lang_sense_clarification": "commanding someone not to brag"
                            },
                            {
                                "target_lang_word": "brag",
                                "target_lang_sense_clarification": "commanding someone not to show off"
                            }
                        ]
                    }
                }
            ]
        }
    ]
