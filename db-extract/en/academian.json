                                "target_senses": [
                                    {
                                        "sense_id": "dac1d33e-ba77-384e-a95d-b4e1a84d5987",
                                        "entry_id": "7cdd646f-9034-362e-9abd-69edaa3358cf",
                                        "glosses": [
                                            "Frau, die eine Hochschule erfolgreich besucht und mit Examen abgeschlossen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e266cc5f-07fb-4cf3-a63c-f30c021a33b7",
                                                "sense_id": "dac1d33e-ba77-384e-a95d-b4e1a84d5987",
                                                "text": "Akademikerin kann man nur durch eine Ausbildung an einer Hochschule werden."
                                            },
                                            {
                                                "example_id": "0410e548-e181-44a3-b499-227a10bc9f7b",
                                                "sense_id": "dac1d33e-ba77-384e-a95d-b4e1a84d5987",
                                                "text": "„Er betrieb jetzt eine eigene Firma für Luxus-Safaris und war mit einer Akademikerin verheiratet, mit der er zwei kleine Söhne hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19ec3bf4-d2ba-3ad5-9d9f-ddac4d1738eb",
                                        "entry_id": "7cdd646f-9034-362e-9abd-69edaa3358cf",
                                        "glosses": [
                                            "weibliches Mitglied einer Akademie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68033e1b-dada-4d6a-ad38-ff95d07c4a38",
                                                "sense_id": "19ec3bf4-d2ba-3ad5-9d9f-ddac4d1738eb",
                                                "text": "Sie ist eine berühmte Akademikerin und auch eine der reichsten Personen in ihrem Land."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
