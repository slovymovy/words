                "senses": [
                    {
                        "sense_id": "49807cad-c022-3625-8950-2fd50354994a",
                        "entry_id": "ad3166d1-6ecb-3f75-8ea7-33efcb172d0b",
                        "glosses": [
                            "Gruppe oder Organisation, die für die Verhinderung neuer und die Beendigung bestehender Kriege sowie für die Abschaffung von Atomwaffen eintritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ff4b622-6daa-4386-b3f8-78e33f254864",
                                "sense_id": "49807cad-c022-3625-8950-2fd50354994a",
                                "text": "Mancher, der die Friedensbewegung bislang als die verlorene Idee einiger weltabgewandter Schwärmer betrachtete, wird aus dieser Tabelle erst ersehen können, wie alt der Friedensgedanke bereits ist, wie sehr sich die Welt bislang seiner angenommen und welche Fortschritte er im Laufe der Zeit gemacht hat."
                            },
                            {
                                "example_id": "60eff6d0-c055-40e5-8e30-20e2fd9b9970",
                                "sense_id": "49807cad-c022-3625-8950-2fd50354994a",
                                "text": "Die Erfahrung, dass der Staat die Beschränkung der Aktionen der Friedensbewegung auf den relativ geschlossenen Kirchenraum als Instrument der Verdrängung aus der Öffentlichkeit nutzte, hat Oppositionelle veranlasst, diese Schranke zu durchbrechen."
                            },
                            {
                                "example_id": "6526bd92-3410-418f-9fee-a7cae1248d75",
                                "sense_id": "49807cad-c022-3625-8950-2fd50354994a",
                                "text": "„[Die] Friedensbewegung [hatte] ihre beste Zeit, als der Krieg weit weg war. Wirkungslos war sie deshalb nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
