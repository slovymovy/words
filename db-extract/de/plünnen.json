                        "examples": [
                            {
                                "example_id": "20f297a9-ec56-4b1e-babd-1e5a180f0f7e",
                                "sense_id": "65cc934e-1f35-37c2-bf52-5914c88550f4",
                                "text": "Swantje ist nicht in der Lage, ihre dreckigen Plünnen in die Waschmaschine zu stecken. Sie legt sie einfach davor hin."
                            },
                            {
                                "example_id": "b13bf090-f1e5-4b74-a415-8e061571b73e",
                                "sense_id": "65cc934e-1f35-37c2-bf52-5914c88550f4",
                                "text": "Du hast den ganzen Schrank voller Plünnen, aber nichts anzuziehen."
                            },
                            {
                                "example_id": "40678402-f431-4b40-aca8-1b010b88a0e2",
                                "sense_id": "65cc934e-1f35-37c2-bf52-5914c88550f4",
                                "text": "Deine Plünnen musst du mit 95 Grad waschen."
                            },
                            {
                                "example_id": "d82b5a9a-2812-4386-a6de-8540c6c89224",
                                "sense_id": "65cc934e-1f35-37c2-bf52-5914c88550f4",
                                "text": "„Ich bekam meine neuen Plünnen von Jack Reilly, einem alten Backschaftskameraden, mit dem ich mich immer gut verstanden hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d5f49aff-d770-335a-b85c-e2678dd33ff1",
                        "entry_id": "228784a2-b088-38b6-bc3b-dade8b7bc474",
                        "glosses": [
                            "Krempel, Kram, Dinge"
