                        "examples": [
                            {
                                "example_id": "b473b945-3eef-4440-bc56-020c901c56b0",
                                "sense_id": "16679009-64ef-3d9e-8a99-fee5914362d3",
                                "text": "Конферанс в первом отделении вели Миров и Новицкий, во втором ― Романов."
                            },
                            {
                                "example_id": "ba620ed5-acff-4c0c-90c9-7de43e1990a4",
                                "sense_id": "16679009-64ef-3d9e-8a99-fee5914362d3",
                                "text": "Об уходе из жизни пресс-секретаря МЧС Беларуси Виталия Новицкого написали госСМИ. О причинах смерти не сообщается. // Виталий — сын спортивного комментатора Владимира Новицкого."
                            }
                        ]
                    }
