    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50e404e2-d3b2-3822-88b8-a1de1d47b68b",
                    "sense_definition": "dodawać coś brakującego, aby stworzyć całość; uzupełniać braki",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uzupełnianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten nowoczesny wazon doskonale <w>dopełnia</w> wystrój minimalistycznego salonu.",
                            "target_lang_translations": {
                                "ru": "Эта современная ваза прекрасно <w>дополняет</w> интерьер минималистичной гостиной."
                            }
                        },
                        {
                            "text": "Pisarz systematycznie <w>dopełnia</w> brakujące fakty w swojej nowej powieści.",
                            "target_lang_translations": {
                                "ru": "Писатель систематически <w>восполняет</w> недостающие факты в своём новом романе."
                            }
                        }
                    ],
                    "synonyms": [
                        "uzupełniać",
                        "wypełniać"
                    ],
                    "common_phrases": [
                        "dopełniać całości"
                    ],
                    "target_lang_definitions": {
                        "ru": "добавлять недостающее, чтобы составить целое; восполнять пробелы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнять",
                                "target_lang_sense_clarification": "делать цельным, прибавляя недостающее"
                            },
                            {
                                "target_lang_word": "восполнять",
                                "target_lang_sense_clarification": "устранять нехватку, пробелы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7634d7fb-d14c-3351-9a90-f3b2585dad21",
                    "sense_definition": "wypełniać określone wymagania, procedury lub obowiązki; realizować coś do końca",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "realizacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdy przedsiębiorca musi terminowo <w>dopełniać</w> wszelkich formalności urzędowych.",
                            "target_lang_translations": {
                                "ru": "Каждый предприниматель должен вовремя <w>соблюдать</w> все официальные формальности."
                            }
                        },
                        {
                            "text": "Żołnierz sumiennie <w>dopełnia</w> złożonej wcześniej przysięgi wojskowej.",
                            "target_lang_translations": {
                                "ru": "Солдат добросовестно <w>исполняет</w> данную ранее военную присягу."
                            }
                        }
                    ],
                    "synonyms": [
                        "spełniać",
                        "realizować",
                        "wykonywać"
                    ],
                    "common_phrases": [
                        "dopełniać formalności",
                        "dopełniać obowiązku"
                    ],
                    "target_lang_definitions": {
                        "ru": "соблюдать требования, процедуры или обязанности; доводить дело до конца"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "формальности, процедуры"
                            },
                            {
                                "target_lang_word": "выполнять",
                                "target_lang_sense_clarification": "обязанности, условия"
                            },
                            {
                                "target_lang_word": "исполнять",
                                "target_lang_sense_clarification": "долг, клятву"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "271e9bcc-90d4-3d88-a2e7-b0473c9c9752",
                    "sense_definition": "wzajemnie się uzupełniać, tworząc harmonijną i spójną całość",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uzupełnianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo różnych charakterów małżonkowie wspaniale się ze sobą <w>dopełniają</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на разные характеры, супруги прекрасно <w>дополняют друг друга</w>."
                            }
                        },
                        {
                            "text": "Te dwa smaki doskonale się <w>dopełniają</w> w jednym wykwintnym daniu.",
                            "target_lang_translations": {
                                "ru": "Эти два вкуса прекрасно <w>дополняют друг друга</w> в одном изысканном блюде."
                            }
                        }
                    ],
                    "synonyms": [
                        "uzupełniać się"
                    ],
                    "common_phrases": [
                        "wzajemnie się dopełniać"
                    ],
                    "target_lang_definitions": {
                        "ru": "взаимно дополнять друг друга, создавая гармоничное целое (о людях, вещах)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнять друг друга",
                                "target_lang_sense_clarification": "образовывать гармоничное единство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dd03634-641b-3bc5-9b86-f3332500ec46",
                    "sense_definition": "urzeczywistniać się, stawać się faktem lub zbliżać się do ostatecznego zakończenia",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "realizacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na naszych oczach powoli <w>dopełnia</w> się tragiczny los tego bohatera.",
                            "target_lang_translations": {
                                "ru": "На наших глазах медленно <w>вершится</w> трагическая судьба этого героя."
                            }
                        },
                        {
                            "text": "Wszyscy czuliśmy, że właśnie teraz <w>dopełnia</w> się długo oczekiwana historia.",
                            "target_lang_translations": {
                                "ru": "Мы все чувствовали, что прямо сейчас <w>свершается</w> долгожданная история."
                            }
                        }
                    ],
                    "synonyms": [
                        "spełniać się",
                        "urzeczywistniać się",
                        "ziszczać się",
                        "realizować się"
                    ],
                    "common_phrases": [
                        "dopełnia się los",
                        "dopełnia się przeznaczenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "сбываться, осуществляться или подходить к своему завершению (о судьбе, участи)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свершаться",
                                "target_lang_sense_clarification": "о судьбе, предначертанном"
                            },
                            {
                                "target_lang_word": "исполняться",
                                "target_lang_sense_clarification": "о роке, участи, предназначении"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}