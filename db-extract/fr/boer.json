                        ],
                        "examples": [
                            {
                                "example_id": "cd619665-9603-4757-923f-e8a991d8a839",
                                "sense_id": "967f0973-6192-3af7-9831-3c42b50588ce",
                                "text": "Depuis des années, un service de la préfecture de police de Paris, les « boers », s'occupe de l'ensemble de la réglementation du transport de personnes dans la capitale."
                            }
                        ]
                    },
                    {
