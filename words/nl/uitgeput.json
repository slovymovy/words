                    "semantic_group_id": "vermoeidheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze viel <w>uitgeput</w> op de bank in slaap na de lange reis.",
                            "target_lang_translations": {
                                "en": "She fell asleep on the couch <w>exhausted</w> after the long journey.",
                                "ru": "Она уснула на диване <w>в изнеможении</w> после долгой поездки.",
                                "zh": "长途旅行后，她<w>精疲力竭地</w>倒在沙发上睡着了。"
                            }
                        },
                        {
                            "text": "De kinderen zaten <w>uitgeput</w> in het gras na het voetballen.",
                            "target_lang_translations": {
                                "en": "The children sat in the grass <w>exhausted</w> after playing soccer.",
                                "ru": "Дети сидели <w>без сил</w> на траве после игры в футбол.",
                                "zh": "踢完足球后，孩子们<w>筋疲力尽地</w>坐在草地上。"
                            }
                        }
                    ],
