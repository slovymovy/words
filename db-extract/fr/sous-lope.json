                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6d29a38-1287-4f53-8d9b-1a348d4a6130",
                                "sense_id": "e9ad32a4-8a92-3b4b-8c95-11e34b69dc8f",
                                "text": "Il me dit d'attendre et revient avec plusieurs mecs, en me désignant comme la sous-lope qu'il a commencée à dresser."
                            },
                            {
                                "example_id": "8f948936-c27f-4852-b195-d7822d16b78d",
                                "sense_id": "e9ad32a4-8a92-3b4b-8c95-11e34b69dc8f",
                                "text": "Le Maître a rappelé les règles applicables au vaincu : nous étions tous les deux des bâtards, mais la sous-lope (moi) devait obéissance et soumission à tous les Mâles présents ainsi qu’à son vainqueur."
                            }
