                    },
                    {
                        "sense_id": "ade8cd7f-4399-3abf-8f83-5d70b72b86c2",
                        "entry_id": "7e3ac66d-aad5-3c96-9964-0acd7e38d4fe",
                        "glosses": [
                            "Au football canadien et au football américain, catégorie d'officiel qui mesurent la distance effectivement parcourue par le ballon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd1ce68-ea60-4381-a22e-9b8db2c1a94e",
                                "sense_id": "ade8cd7f-4399-3abf-8f83-5d70b72b86c2",
                                "text": "Juge de ligne à la Coupe Nike, un tournoi pour les moins de 16 ans à Montréal l'automne dernier, William Dallaire avait la responsabilité des chaîneurs, des parents bénévoles qui indiquaient avec un poteau l'avancement du jeu."
                            }
                        ]
                    }
