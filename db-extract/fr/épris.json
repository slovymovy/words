                                        "glosses": [
                                            "Expressing a large amount of love to other people; affectionate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c8f24fa-e43a-48e2-a3bc-af80c56e114f",
                                                "sense_id": "34b13372-ff3d-3d0a-ac01-8af0611d7df2",
                                                "text": "his loving wife, her loving husband"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02f1da6d-9e04-331a-b680-74b9a6273a42",
                                        "entry_id": "9001cb6e-6918-364e-af2b-9c3acd356163",
                                        "glosses": [
                                            "Euphemistic form of fucking."
                                        ],
                                        "tags": [
