                ],
                "senses": [
                    {
                        "sense_id": "62cdea30-017e-35a9-8d87-fc64a34f5a44",
                        "entry_id": "e6d2f09e-5624-38c0-9fad-61a36ed68901",
                        "glosses": [
                            "spezieller Handschuh für eine Kompressionstherapie der Hand und ggf. auch des Unter- und Oberarmes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b288ba-5820-43ce-94b6-e9d99f29bbc3",
                                "sense_id": "62cdea30-017e-35a9-8d87-fc64a34f5a44",
                                "text": "„Kompressionshandschuhe können ständig und gleichmäßig einen gewissen Druck ausüben …. Ist die Behandlung mit einem Kompressionshandschuh nicht möglich, weil dieser stört oder kein adäquater Druck auf die Narbe zu Stande kommt, gibt es verschiedene Narbenpflaster ….“"
                            },
                            {
                                "example_id": "a9cd3498-28fa-4504-9da0-6dd0271ab9d1",
                                "sense_id": "62cdea30-017e-35a9-8d87-fc64a34f5a44",
                                "text": "„Ist die Schwellung sehr stark, kann nach Entfernung der Fäden ein Kompressionshandschuh verordnet werden.“"
                            },
                            {
                                "example_id": "2f051983-13fc-4e0f-8637-6157ff431745",
                                "sense_id": "62cdea30-017e-35a9-8d87-fc64a34f5a44",
                                "text": "„Die Kompressionshandschuhe sollten kontinuierlich Tag und Nacht getragen werden. Hierdurch wird ein permanenter Druck von außen auf die Narben ausgeübt, so dass einer überschießenden Narbenreaktion mit Narbenverhärtung und Narbenzug entgegengewirkt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
