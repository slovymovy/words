                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "<Кора> — одна из многочисленных небольших рек России.",
                            "target_lang_translations": {
                                "en": "<Kora> is one of the numerous small rivers in Russia.",
                                "zh": "<w>科拉河</w>是俄罗斯众多小河流之一。"
                            }
                        },
                        {
                            "text": "Туристы решили разбить лагерь на берегу реки <Кора>.",
                            "target_lang_translations": {
                                "en": "The tourists decided to set up camp on the bank of the <Kora> river.",
                                "zh": "游客们决定在<w>科拉河</w>岸边扎营。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
