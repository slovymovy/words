                        "sense_id": "f9ad9741-34dc-37f8-95fc-6368d1014944",
                        "entry_id": "6ca45946-8826-3f0e-972f-1b7b21620854",
                        "glosses": [
                            "Person/Kasse, die bei einem Glücksspiel (zum Beispiel Roulette) gegen alle anderen spielt"
                        ],
                        "tags": [
                            "Glücksspiel"
                        ],
                        "examples": [
