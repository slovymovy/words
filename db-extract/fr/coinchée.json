                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b3a415-ef71-47f6-aecc-633f8f21344f",
                                "sense_id": "5202ccdd-960e-3e3a-8189-53124ada2f23",
                                "text": "On est le journaliste, on vient en espion espéré dans les fêtes du troisième âge, les dominos ou les coinchées, les spectacles scolaires…"
                            },
                            {
                                "example_id": "3f693c1c-e4f5-47c7-8dbe-379ba049841e",
                                "sense_id": "5202ccdd-960e-3e3a-8189-53124ada2f23",
                                "text": "Le sourire ironique du député qui vous ménage et vous méprise, la centième fête des rois, la millième coinchée."
                            },
                            {
                                "example_id": "2776f6a8-370a-4df4-8b4c-0619792a0c30",
                                "sense_id": "5202ccdd-960e-3e3a-8189-53124ada2f23",
                                "text": "Maintenant, si c’est pressé, je peux toujours l’appeler au Hollandais, il termine sa coinchée…"
                            }
                        ]
                    }
