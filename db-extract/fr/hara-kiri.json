                        "source_entry_id": "fc7bd1ba-d424-3560-b259-4a079afd0505",
                        "target_lang_word": "切腹",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "切腹",
