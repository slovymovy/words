                    {
                        "sense_id": "32ddcc74-5deb-3e80-a86d-e796e61a47f6",
                        "entry_id": "688cfdaf-8fb4-303f-a3c7-1f50b5e7d8bb",
                        "glosses": [
                            "Personne peu recommandable et que l’on déteste."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "9300323d-f728-47d8-bfe0-26217be6a02f",
                                "sense_id": "32ddcc74-5deb-3e80-a86d-e796e61a47f6",
                                "text": "Norm est un trouduc. Norm est une fiotte. Il s'arrêta, se demandant quelle était la différence. Eh bien, un trouduc était un connard vraiment imbitable, et une fiotte un taré qui avait la trouille de son ombre, et tellement peur de faire quoi que ce soit qu'il était toujours à casser la baraque à tout le monde."
                            },
                            {
                                "example_id": "f885dfb7-7d9b-4f85-9ff2-2bd36f8f2167",
                                "sense_id": "32ddcc74-5deb-3e80-a86d-e796e61a47f6",
                                "text": "– Dis-moi, trouduc, t’arrives à respirer par le nez, non ? Alors ferme ta gueule, s’il te plaît."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7d50dba-b18b-49e1-ab0c-6d4de29230a9",
                        "source_entry_id": "688cfdaf-8fb4-303f-a3c7-1f50b5e7d8bb",
                        "source_sense_id": "32ddcc74-5deb-3e80-a86d-e796e61a47f6",
                        "target_lang_word": "Arschloch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arschloch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e71fb8ef-67a3-35b1-9ac5-86faf41c1b50",
                                        "entry_id": "c9f79665-cfeb-3575-b28b-3865b36963b4",
                                        "glosses": [
                                            "After"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0dc9b1-ca86-4d2a-9155-372a8f3f1160",
                                                "sense_id": "e71fb8ef-67a3-35b1-9ac5-86faf41c1b50",
                                                "text": "„Jetzt sieht er mir ins Arschloch rein / Doch ich bleib tapfer und halte ein.“"
                                            },
                                            {
                                                "example_id": "14bb712f-1035-413d-a662-726fc0b500ac",
                                                "sense_id": "e71fb8ef-67a3-35b1-9ac5-86faf41c1b50",
                                                "text": "„Machen durfte man das bestimmt nicht, aber ich zog mir hinten die Backen auseinander und versuchte, das Arschloch von Claudia zu erkennen, die mit dem Rücken zu mir stand und ihre eigenen Arschbacken auseinanderzog.“"
                                            },
                                            {
                                                "example_id": "cefd5136-4ca0-4b11-b291-cce2986246ea",
                                                "sense_id": "e71fb8ef-67a3-35b1-9ac5-86faf41c1b50",
                                                "text": "„Er überredete ihn zum Onanieren und ließ sich für eine Krone die berühmte Erektion ins Arschloch stecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                        "entry_id": "c9f79665-cfeb-3575-b28b-3865b36963b4",
                                        "glosses": [
                                            "Schimpfwort"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c6629c2-5a0a-4289-becb-f533e266f129",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Du hast nie gelernt dich zu artikulieren und deine Freundin, die hat niemals für dich Zeit. Oh, Arschloch, Arschloch, Arschloch!“"
                                            },
                                            {
                                                "example_id": "3564c511-a021-4158-9ec6-33889c1b27b8",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Mit Verlaub, Herr Präsident, Sie sind ein Arschloch.“"
                                            },
                                            {
                                                "example_id": "c9181e84-70b0-4768-b05f-bcc2bdf76ea3",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Die Zeit verwandelt sie in Arschlöcher, die nur darauf warten, die Waffe zu ziehen.“"
                                            },
                                            {
                                                "example_id": "20e644a6-647a-4243-9b96-71bf8c6b52f3",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Alles in allem, diese Sendung versammelte wieder einmal nichts als Arschlöcher.“"
                                            },
                                            {
                                                "example_id": "805d9dc2-4fef-471f-8285-2691fee44463",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Aber gewinnen damit nicht letztlich eben doch die Arschlöcher, und die Anständigen können schauen, wo sie bleiben? ‹Das stimmt nicht!›, ruft Sutton fröhlich. Ein Arschloch zu sein, lohne sich nur kurzfristig – längerfristig zahle es sich nicht aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b05f26f-e9d9-4bde-b983-bcb428fc0699",
