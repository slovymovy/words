                    },
                    {
                        "translation_id": "28c36171-4cb9-47fe-85d6-ec939951f9aa",
                        "source_entry_id": "3fd25b23-e0cf-3438-8034-99712ca25dfc",
                        "source_sense_id": "7acfb7bf-e97f-3da1-acb4-98500717bc50",
                        "source_sense_description": "Untergruppe/Sprachfamilie der afroasiatischen Sprachen (untergliedert in viele Sprachen und Dialekte)",
                        "target_lang_word": "Berber language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "32c29416-f56f-4517-b74f-b6f5edc0e4ad",
                        "source_entry_id": "3fd25b23-e0cf-3438-8034-99712ca25dfc",
                        "source_sense_id": "7acfb7bf-e97f-3da1-acb4-98500717bc50",
                        "source_sense_description": "Untergruppe/Sprachfamilie der afroasiatischen Sprachen (untergliedert in viele Sprachen und Dialekte)",
                        "target_lang_word": "amazigh",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amazigh",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ff2c704-4a00-3cb9-8db0-20267df7435c",
                                        "entry_id": "052fef59-5756-3c7c-ad09-8aa5343a9517",
                                        "glosses": [
                                            "Endonyme pour désigner les peuples autochtones d'Afrique du Nord, ceux-ci le préfèrent au mot \\\"berbère\\\" qui est un exonyme à l'étymologie aliénante puisqu'il signifie \\\"étranger\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de267816-7092-438a-84dd-74b8384684fb",
                                                "sense_id": "7ff2c704-4a00-3cb9-8db0-20267df7435c",
                                                "text": "Plusieurs dizaines de militants du Mouvement 20-Février, mais aussi de l’Union nationale des étudiants du Maroc (UNEM), des syndicalistes, des militants sahraouis, amazighs, des salafistes, sont actuellement incarcérés."
                                            },
                                            {
                                                "example_id": "02eac6cc-2863-455c-9cae-4410e592d42d",
                                                "sense_id": "7ff2c704-4a00-3cb9-8db0-20267df7435c",
                                                "text": "Dans les rues du centre-ville de la capitale, jeunes et anciens ont communié ensemble en s’enroulant avec une infinie fierté dans le drapeau vert et rouge de l’Algérie ou dans le fanion coloré amazigh."
                                            },
                                            {
                                                "example_id": "d2512b06-6668-4f7a-a700-55b9dfb4dd72",
                                                "sense_id": "7ff2c704-4a00-3cb9-8db0-20267df7435c",
                                                "text": "À Zouara, ville côtière de l’extrême ouest de la Libye, non loin de la frontière avec la Tunisie, le drapeau amazigh – berbère – déploie crânement ses bandes bleu, vert et jaune."
                                            },
                                            {
                                                "example_id": "1ce28b88-f067-43b8-9200-42ac8cb38410",
                                                "sense_id": "7ff2c704-4a00-3cb9-8db0-20267df7435c",
                                                "text": "Un rapport périodique sur la Tunisie, adopté par le Comité des droits économiques, sociaux et culturels des Nations unies (CESCR) à sa cinquante-neuvième session, rendu public le 10 octobre, pointe du doigt l'État tunisien pour son dénigrement de sa propre culture amazighe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amazigh",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94a9c875-f32e-3db0-99f9-5ec0a7bdd337",
                                        "entry_id": "53ec4f2f-b529-3ab0-adbf-f9232583cee4",
                                        "glosses": [
                                            "Variante de tamazight pour désigner l’ensemble des dialectes et langues amazighs."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16483ddc-c109-4e47-97bf-37b60c18090d",
                                                "sense_id": "94a9c875-f32e-3db0-99f9-5ec0a7bdd337",
                                                "text": "L’amazigh possède son propre alphabet, le tifinagh, officiel au Maroc, répandu en Algérie et de tout temps utilisé par les Touaregs (Amazighs du Sahara)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78bc24a3-150e-4cc7-8418-9ac26e8ffd28",
                        "source_entry_id": "3fd25b23-e0cf-3438-8034-99712ca25dfc",
                        "source_sense_id": "7acfb7bf-e97f-3da1-acb4-98500717bc50",
                        "source_sense_description": "Untergruppe/Sprachfamilie der afroasiatischen Sprachen (untergliedert in viele Sprachen und Dialekte)",
                        "target_lang_word": "berbère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berbère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79b02f6c-0a09-3f47-82ac-9ca6a93657c8",
                                        "entry_id": "588942d9-2b19-3fc6-81a8-08bf605a6b2c",
                                        "glosses": [
                                            "Exonyme adventice relatif aux amazighs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7350a6a4-69a1-4a1f-af2b-0e37b8c5a99b",
                                                "sense_id": "79b02f6c-0a09-3f47-82ac-9ca6a93657c8",
                                                "text": "Si ça lui chantait, et ça lui chantait, et ça lui chantait souvent, il pouvait être turc, chinois, berbère, pourquoi pas si ça lui plaisait, indonésien, malien, fuégien, que celui qui n’était pas d’accord le dise, sicilien, irlandais, ou, évidemment, français, ou allemand."
                                            },
                                            {
                                                "example_id": "67ea291f-70c3-4ac8-8bcc-60ce3c8d81ef",
                                                "sense_id": "79b02f6c-0a09-3f47-82ac-9ca6a93657c8",
                                                "text": "Azemmour est une ville très ancienne. D'origine berbère ou carthaginoise, elle passa successivement sous la domination romaine, vandale, byzantine et arabe. En 1518, les Portugais s'en emparèrent, […]."
                                            },
                                            {
                                                "example_id": "46dfc857-98b6-4be8-8599-226ce5b20a0a",
                                                "sense_id": "79b02f6c-0a09-3f47-82ac-9ca6a93657c8",
                                                "text": "En 1830, il n’y avait en Algérie, que des tribus ennemies sur lesquelles pesaient, selon les régions, la terreur des Turcs […], et puis les peuples berbères et arabo-berbères."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "berbère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d950a9a8-a10b-36c3-a1a7-72c57afffac8",
                                        "entry_id": "b5bc792c-20d3-3d92-9724-d15aeb5b478c",
                                        "glosses": [
                                            "Langue amazighe, langue autochtone d’Afrique du Nord-Ouest (Maghreb et île Canaries), anciennement appelée libyque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
