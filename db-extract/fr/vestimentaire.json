                "forms": [
                    {
                        "form_id": "3ab3b498-b87e-4141-a98f-5b2b8baae5b8",
                        "entry_id": "9dcf1d9a-03b5-3958-96aa-c474efa4e11d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "vestimentaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cf1d32a-d191-3514-a41f-f71b9296372d",
                        "entry_id": "9dcf1d9a-03b5-3958-96aa-c474efa4e11d",
                        "glosses": [
                            "Qui a rapport aux vêtements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afacf9d2-cfd0-4a4c-8ec1-e4d0a4e7ff78",
                                "sense_id": "3cf1d32a-d191-3514-a41f-f71b9296372d",
                                "text": "Celui-ci résumait par sa fausse élégance tout le poisseux vernis qui constitue l'élégance vestimentaire de ces messieurs."
                            },
                            {
                                "example_id": "0ed97479-66b8-424c-b9dc-b39d8f722f5a",
                                "sense_id": "3cf1d32a-d191-3514-a41f-f71b9296372d",
                                "text": "Ils pensent en effet que le luxe vestimentaire est proportionnel à l'importance et à la renommée d'un individu."
                            },
                            {
                                "example_id": "61d04bc5-41c6-457e-ab05-38acf47bd5a4",
                                "sense_id": "3cf1d32a-d191-3514-a41f-f71b9296372d",
                                "text": "Lynette se distingue physiquement du reste du groupe : son physique et sa tenue vestimentaire contrastent avec l’apparence des autres femmes dont les coiffures impeccables et les twin-sets de couleur pastel s’imposent comme les codes de la norme des mères au foyer."
                            },
                            {
                                "example_id": "d0196181-4397-4d61-8477-d6383cc47448",
                                "sense_id": "3cf1d32a-d191-3514-a41f-f71b9296372d",
                                "text": "Elle était dingue des fringues de créateur et ne kiffait pas trop mon style vestimentaire, tendance récupération. Mais elle ne désespérait pas qu’un jour je prenne exemple sur elle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd49ae96-9c19-49a0-be8c-98b0a3f15282",
                        "source_entry_id": "9dcf1d9a-03b5-3958-96aa-c474efa4e11d",
                        "source_sense_id": "3cf1d32a-d191-3514-a41f-f71b9296372d",
                        "target_lang_word": "vestimentär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vestimentär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d788ec0-bc01-3c82-8e10-a5b081b401f9",
                                        "entry_id": "4032d06c-8696-303a-a973-49c105ed1abf",
                                        "glosses": [
                                            "auf Kleidung bezogen; etwas mittels Kleidung ausdrückend, mit der Bekleidung mitteilend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9686022-57bc-4980-a3e8-03e721305f48",
                                                "sense_id": "5d788ec0-bc01-3c82-8e10-a5b081b401f9",
                                                "text": "„Die vestimentäre Kommunikation ist also in einen sehr komplexen und dynamischen Kommunikationsvorgang eingebettet […].“"
                                            },
                                            {
                                                "example_id": "0dcc8dec-59e3-4934-96fe-e527eb70018e",
                                                "sense_id": "5d788ec0-bc01-3c82-8e10-a5b081b401f9",
                                                "text": "Es fällt auf, über welch langen Zeitraum das britische Parlament in seinen vestimentären Aussagen traditionsverhaftet blieb."
                                            },
                                            {
                                                "example_id": "2e581c43-a479-44a7-bf00-09ed42d92bfe",
                                                "sense_id": "5d788ec0-bc01-3c82-8e10-a5b081b401f9",
                                                "text": "Die vestimentäre Kommunikation - Österreichischer Bibliothekenverbund"
                                            },
                                            {
                                                "example_id": "089f0eae-0c6a-48b4-bceb-bcf9939d5cb0",
                                                "sense_id": "5d788ec0-bc01-3c82-8e10-a5b081b401f9",
                                                "text": "Er bestand weiterhin darauf, den Sonntag auch vestimentär angemessen prunkvoll zu begehen."
                                            },
                                            {
                                                "example_id": "9bc6a7df-0c92-430f-8508-333c1c7b07df",
                                                "sense_id": "5d788ec0-bc01-3c82-8e10-a5b081b401f9",
                                                "text": "Körperlich sichtbare Tugend und vestimentär sichtbarer Status treten beim Protagonisten auseinander."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2314d9e-a3cc-405b-8570-a071575c1074",
                        "source_entry_id": "9dcf1d9a-03b5-3958-96aa-c474efa4e11d",
                        "source_sense_id": "3cf1d32a-d191-3514-a41f-f71b9296372d",
