                    "frequency": "Low",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comédien enfila un <w>pourpoint</w> en velours rouge avant de monter sur scène."
                        },
                        {
                            "text": "À la Renaissance, les gentilshommes portaient un <w>pourpoint</w> richement brodé de fils d'or."
                        }
                    ],
                    "common_phrases": [
