                },
                {
                    "sense_id": "fc571169-4dc0-3da1-a63c-d74fbc45217e",
                    "sense_definition": "Kierunek na wyższej uczelni obejmujący studia w zakresie nauk medycznych.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja siostra marzy, aby studiować <w>medycynę</w> w Warszawie.",
                            "target_lang_translations": {
                                "ru": "Моя сестра мечтает изучать <w>медицину</w> в Варшаве.",
                                "en": "My sister dreams of studying <w>medicine</w> in Warsaw.",
                                "zh": "我妹妹梦想在华沙学<w>医</w>。"
                            }
                        },
                        {
                            "text": "Trudno jest dostać się na <w>medycynę</w> z powodu dużej konkurencji.",
                            "target_lang_translations": {
                                "ru": "Трудно поступить на <w>медицинский</w> из-за большой конкуренции.",
                                "en": "It is difficult to get into <w>medical school</w> because of the fierce competition.",
                                "zh": "由于竞争激烈，考上<w>医学院</w>非常困难。"
                            }
                        }
                    ],
                    "common_phrases": [
