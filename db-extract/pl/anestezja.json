                    {
                        "translation_id": "07f5160b-16bf-41be-8e0e-84801ddb3bd2",
                        "source_entry_id": "1eb46e17-7664-3810-8d99-9ee0e321d5a6",
                        "source_sense_id": "e94d91e7-0a26-3161-8b0c-8a3edd19c080",
                        "target_lang_word": "анестезия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анестезия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "44ac2615-bf83-31f6-a6cf-0417888d7ad5",
                                        "entry_id": "0918950c-9bad-3bf2-866f-4dbe10e2765a",
                                        "glosses": [
                                            "мед. частичная или полная потеря чувствительности (к боли, запахам или вкусовым раздражителям) при патологических процессах или в результате воздействия веществами, воздействующими на передачу нервных импульсов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a98f64c0-00b7-4302-8363-c101c26f3870",
                                                "sense_id": "44ac2615-bf83-31f6-a6cf-0417888d7ad5",
                                                "text": "Многократные попытки исследования кожных рефлексов уколами у истеричных нередко приводят к тому, что анестезия, бывшая в начале исследования ясно выраженной, начинает постепенно ослабевать, первоначально на месте раздражения уколами, а затем и в остальных частях пораженной области."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "136b65b6-7521-30a0-90d2-737164d0bfaf",
                                        "entry_id": "0918950c-9bad-3bf2-866f-4dbe10e2765a",
                                        "glosses": [
                                            "мед. обезболивание, достигаемое путём применения специальных средств"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bd885cb-5d97-47a7-a289-04ae93caa6d1",
                                                "sense_id": "136b65b6-7521-30a0-90d2-737164d0bfaf",
                                                "text": "Общая анестезия должна обеспечивать больному торможение психического восприятия (сон), блокаду болевых импульсов (анальгезию), торможение вегетативных реакций (снятие рефлексов), выключение двигательной активности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "332f2a18-a523-3769-8a17-8b7007c8edb1",
                                        "entry_id": "0918950c-9bad-3bf2-866f-4dbe10e2765a",
                                        "glosses": [
                                            "перен., разг. бесчувственность, нечувствительность, невосприимчивость по отношению к чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "212aeb3e-58e7-4188-aee1-b4ab331e1f17",
                                                "sense_id": "332f2a18-a523-3769-8a17-8b7007c8edb1",
                                                "text": "Герою предстояло погружение в наркоз, но он по-прежнему пребывал в состоянии душевной анестезии."
                                            }
                                        ]
                                    }
                                ]
