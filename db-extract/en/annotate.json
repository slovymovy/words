                                                "example_id": "05f284c3-81c4-4dd2-868d-80d8248c16d2",
                                                "sense_id": "9d7613f7-06c3-37ae-a4df-bb59c5d317ab",
                                                "text": "Annoter un code de lois."
                                            },
                                            {
                                                "example_id": "518b356f-3996-42be-92ed-459745cd8b22",
                                                "sense_id": "9d7613f7-06c3-37ae-a4df-bb59c5d317ab",
                                                "text": "Il n’a pas mieux saisi que les « Hommes Obscurs » l’attitude d’Érasme à l’égard d’un Docteur qu’il est bien loin de mépriser, puisqu’il a consacré ses veilles à éditer et à annoter ses œuvres complètes."
                                            },
                                            {
                                                "example_id": "07b9a32f-bf78-4c00-91ca-5298e90c4dd3",
                                                "sense_id": "9d7613f7-06c3-37ae-a4df-bb59c5d317ab",
                                                "text": "J’ai aussi annoté la liste de clubs de tango que l’hôtel met à votre disposition. Ce sont juste mes opinions…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
