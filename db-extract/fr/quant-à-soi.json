                "forms": [
                    {
                        "form_id": "df0fa08d-01ec-49d5-bb5e-f2043d9ef543",
                        "entry_id": "3c40d196-6264-3d73-b272-e4c8d4ced8c0",
                        "tags": [],
                        "form": "quant à soi"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d5c01f9-70f5-35f4-a7d9-38ab2abbfbbb",
                        "entry_id": "3c40d196-6264-3d73-b272-e4c8d4ced8c0",
                        "glosses": [
                            "Réserve, attitude distante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "398b6238-7725-4cfe-bf7c-b07ee2d57dfb",
                                "sense_id": "7d5c01f9-70f5-35f4-a7d9-38ab2abbfbbb",
                                "text": "Sur ce, m'abandonnant son quant-à-soi, elle s'offrit à mon étreinte et me retint entre ses bras jusqu'au matin."
                            },
                            {
                                "example_id": "d7259e4e-c82d-412e-841d-df11d05e7054",
                                "sense_id": "7d5c01f9-70f5-35f4-a7d9-38ab2abbfbbb",
                                "text": "Sa liberté, son quant à soi, le plus grand bien, après l’incarcération de six années d’internat scolaire."
                            },
                            {
                                "example_id": "82d07ef3-1834-44ec-9b31-d6e4646b97f3",
                                "sense_id": "7d5c01f9-70f5-35f4-a7d9-38ab2abbfbbb",
                                "text": "28 juin 1940 – Les oncles et tantes, assis sur leur quant-à-soi, sûrs et satisfaits d’eux-mêmes et persuadés qu’il n’y sont pour rien, je les crache."
                            },
                            {
                                "example_id": "8dbde54c-c4d3-4917-9833-7b6e9e4ca10b",
                                "sense_id": "7d5c01f9-70f5-35f4-a7d9-38ab2abbfbbb",
                                "text": "Maman pourrait continuer à lui gueuler dessus par la fenêtre, mais elle a son quant-à-soi, elle est française, elle, elle ne vit pas à ciel ouvert sur la place publique, elle a bien trop de fierté pour ça."
                            },
                            {
                                "example_id": "1f789ddc-8a99-450e-a07d-b66559ea3932",
                                "sense_id": "7d5c01f9-70f5-35f4-a7d9-38ab2abbfbbb",
                                "text": "Si impérieux que fût son désir, il ne se départait à aucun moment d’un certain quant-à-soi."
                            },
                            {
                                "example_id": "91af0b33-ee48-4ba3-b13e-712d7d766cac",
                                "sense_id": "7d5c01f9-70f5-35f4-a7d9-38ab2abbfbbb",
                                "text": "Ça demande beaucoup de quant-à-soi, un chapeau. Il faut bien le porter, sinon on a vite l’air idiot."
                            }
                        ]
                    }
                ],
