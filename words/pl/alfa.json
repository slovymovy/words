                    "frequency": "Low",
                    "semantic_group_id": "car_brand",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "Mój sąsiad kupił sobie nową czerwoną <w>alfę</w>.",
                            "target_lang_translations": {
                                "ru": "Мой сосед купил себе новую красную <w>Альфу</w>."
                            }
                        },
                        {
                            "text": "Ta stara <w>alfa</w> wciąż świetnie wygląda na drodze.",
                            "target_lang_translations": {
                                "ru": "Эта старая <w>Альфа</w> всё ещё отлично смотрится на дороге."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
