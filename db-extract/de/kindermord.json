                                        "entry_id": "2d01fe8b-8bc1-3a35-ad84-23916a742fad",
                                        "glosses": [
                                            "het om het leven brengen van een kind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1d156b-fbac-48bb-bdd3-c174454b86d5",
                                                "sense_id": "d576a465-c55a-328a-9bd3-64fd35eadf28",
                                                "text": "De commentaar van Flandrin duidt klaar aan dat kindermoord niet gebeurde zonder duidelijk besef van de immoraliteit van de daad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc284ce-884b-343a-b02e-cfb076463dcb",
                                        "entry_id": "2d01fe8b-8bc1-3a35-ad84-23916a742fad",
                                        "glosses": [
                                            "het door feitelijk handelen of nalatigheid schuld hebben aan de dood van een kind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7220c55c-0e82-4aea-bcb0-e34565920855",
                                                "sense_id": "3dc284ce-884b-343a-b02e-cfb076463dcb",
                                                "text": "Eigenlijk gezegd kindermoord is de misdaad van eene moeder, die haar nieuw geboren kind om het leven brengt, of van de genen, die haar daarin behulpzaam, zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
