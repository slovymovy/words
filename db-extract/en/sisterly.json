                                    {
                                        "sense_id": "0e851a25-a59c-3f80-a96d-f38e07831300",
                                        "entry_id": "73017d49-fa47-395d-845c-4b9434594e3b",
                                        "glosses": [
                                            "Sororal. Qui est lié à la relation des sœurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "626c39ff-7ab9-43cc-8fa6-30be70c352fb",
                                                "sense_id": "0e851a25-a59c-3f80-a96d-f38e07831300",
                                                "text": "Tantôt nous proposons la réformette, la crèche et le surgelé de midi, tantôt nous fuyons en droite ligne vers l'avenir utopique, un monde fraternel (sororel) sans classes, sans sexes et sans problèmes."
                                            },
                                            {
                                                "example_id": "82a5a879-2add-4f31-90bb-349b2673e415",
                                                "sense_id": "0e851a25-a59c-3f80-a96d-f38e07831300",
                                                "text": "Amour sororel."
                                            },
                                            {
                                                "example_id": "d50d4abd-90ff-4552-b14a-12160f5f81d1",
                                                "sense_id": "0e851a25-a59c-3f80-a96d-f38e07831300",
                                                "text": "Union sororelle."
                                            },
                                            {
                                                "example_id": "d124e929-4200-4280-bda9-6ed1b5a03c08",
                                                "sense_id": "0e851a25-a59c-3f80-a96d-f38e07831300",
                                                "text": "Affection sororelle."
                                            },
                                            {
                                                "example_id": "e60a48c7-da5c-41ea-a5f0-f132b3974f14",
                                                "sense_id": "0e851a25-a59c-3f80-a96d-f38e07831300",
                                                "text": "Il y a entre ces deux femmes une amitié sororelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
