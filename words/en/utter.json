    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "56f35afa-0c1d-3ba1-92c2-8d8dbd172b81",
                    "sense_definition": "Complete, absolute, or total; used to emphasize a quality or state, usually a negative one.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adj_absolute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party was an <w>utter</w> disaster from start to finish.",
                            "target_lang_translations": {
                                "ru": "Вечеринка была <w>полной</w> катастрофой от начала до конца.",
                                "pl": "Impreza była <w>kompletną</w> katastrofą od początku do końca.",
                                "fr": "La fête a été un <w>total</w> désastre du début à la fin."
                            }
                        },
                        {
                            "text": "She looked at him in <w>utter</w> amazement when he told the story.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на него в <w>полном</w> изумлении, когда он рассказывал эту историю.",
                                "pl": "Patrzyła na niego z <w>zupełnym</w> zdumieniem, gdy opowiadał tę historię.",
                                "fr": "Elle l'a regardé avec un <w>absolu</w> étonnement lorsqu'il a raconté l'histoire."
                            }
                        },
                        {
                            "text": "It is <w>utter</w> nonsense to suggest that the earth is flat.",
                            "target_lang_translations": {
                                "ru": "Это <w>абсолютная</w> чепуха — предполагать, что земля плоская.",
                                "pl": "Sugerowanie, że ziemia jest płaska, to <w>skończona</w> bzdura.",
                                "fr": "C'est une <w>totale</w> absurdité de suggérer que la terre est plate."
                            }
                        }
                    ],
                    "synonyms": [
                        "complete",
                        "total",
                        "absolute",
                        "sheer",
                        "pure"
                    ],
                    "common_phrases": [
                        "utter chaos",
                        "utter nonsense",
                        "utter darkness",
                        "utter silence",
                        "utter despair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный, абсолютный или тотальный; используется для усиления качества или состояния, обычно негативного.",
                        "pl": "Całkowity, absolutny lub zupełny; używany do podkreślenia jakości lub stanu, zazwyczaj negatywnego.",
                        "fr": "Complet, absolu ou total ; utilisé pour souligner une qualité ou un état, généralement négatif."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "всеобъемлющий, завершённый"
                            },
                            {
                                "target_lang_word": "абсолютный",
                                "target_lang_sense_clarification": "безусловный, совершенный"
                            },
                            {
                                "target_lang_word": "совершенный",
                                "target_lang_sense_clarification": "истинный, настоящий (часто с негативным оттенком)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kompletny",
                                "target_lang_sense_clarification": "całkowity, zupełny (często w kontekście negatywnym)"
                            },
                            {
                                "target_lang_word": "skończony",
                                "target_lang_sense_clarification": "całkowity, pełny (używany do podkreślenia negatywnej cechy)"
                            },
                            {
                                "target_lang_word": "czysty",
                                "target_lang_sense_clarification": "zupełny, bez domieszek (np. czyste szaleństwo)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "total",
                                "target_lang_sense_clarification": "complet, entier"
                            },
                            {
                                "target_lang_word": "absolu",
                                "target_lang_sense_clarification": "sans restriction, complet"
                            },
                            {
                                "target_lang_word": "complet",
                                "target_lang_sense_clarification": "qui ne manque de rien, total"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e26cfc9-641a-3677-a4bf-35fe8f027920",
                    "sense_definition": "To make a sound with the voice; to speak or say words.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_speak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat there silently and did not <w>utter</w> a single word.",
                            "target_lang_translations": {
                                "ru": "Он сидел молча и не <w>произнёс</w> ни единого слова.",
                                "pl": "Siedział tam w milczeniu i nie <w>wypowiedział</w> ani jednego słowa.",
                                "fr": "Il est resté assis en silence et n'a pas <w>prononcé</w> un seul mot."
                            }
                        },
                        {
                            "text": "The wounded animal <w>uttered</w> a low cry of pain.",
                            "target_lang_translations": {
                                "ru": "Раненое животное <w>издало</w> тихий крик боли.",
                                "pl": "Ranione zwierzę <w>wydało</w> z siebie cichy jęk bólu.",
                                "fr": "L'animal blessé a <w>émis</w> un faible cri de douleur."
                            }
                        },
                        {
                            "text": "She left the room without <w>uttering</w> a sound.",
                            "target_lang_translations": {
                                "ru": "Она вышла из комнаты, не <w>издав</w> ни звука.",
                                "pl": "Wyszła z pokoju, nie <w>wydając</w> z siebie żadnego dźwięku.",
                                "fr": "Elle a quitté la pièce sans <w>émettre</w> le moindre son."
                            }
                        }
                    ],
                    "synonyms": [
                        "say",
                        "speak",
                        "articulate",
                        "voice",
                        "vocalize",
                        "pronounce",
                        "express"
                    ],
                    "common_phrases": [
                        "utter a word",
                        "utter a sound",
                        "utter a cry",
                        "utter a sigh",
                        "not utter a syllable"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать звук голосом; говорить или произносить слова.",
                        "pl": "Wydawać dźwięk za pomocą głosu; mówić lub wypowiadać słowa.",
                        "fr": "Produire un son avec la voix ; parler ou dire des mots."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "произносить",
                                "target_lang_sense_clarification": "выговаривать слова или звуки"
                            },
                            {
                                "target_lang_word": "издавать",
                                "target_lang_sense_clarification": "производить звук или крик"
                            },
                            {
                                "target_lang_word": "вымолвить",
                                "target_lang_sense_clarification": "сказать (обычно в отрицаниях: не вымолвить ни слова)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wypowiedzieć",
                                "target_lang_sense_clarification": "wyartykułować słowa lub dźwięki"
                            },
                            {
                                "target_lang_word": "wydać",
                                "target_lang_sense_clarification": "wyprodukować dźwięk (np. krzyk, jęk)"
                            },
                            {
                                "target_lang_word": "wykrztusić",
                                "target_lang_sense_clarification": "z trudem wypowiedzieć słowa"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "prononcer",
                                "target_lang_sense_clarification": "articuler des mots ou des sons"
                            },
                            {
                                "target_lang_word": "émettre",
                                "target_lang_sense_clarification": "produire un son, un cri"
                            },
                            {
                                "target_lang_word": "proférer",
                                "target_lang_sense_clarification": "énoncer à voix haute, souvent avec force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "729feedb-6bec-34fc-a8f2-334b43141a92",
                    "sense_definition": "To put forged money or documents into circulation; to pass off something fake as genuine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect was arrested for attempting to <w>utter</w> a forged banknote.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый был арестован за попытку <w>сбыть</w> поддельную банкноту.",
                                "pl": "Podejrzany został aresztowany za próbę <w>wprowadzenia</w> do obiegu fałszywego banknotu.",
                                "fr": "Le suspect a été arrêté pour avoir tenté de <w>mettre en circulation</w> un faux billet."
                            }
                        },
                        {
                            "text": "It is a serious crime to make or <w>utter</w> counterfeit currency.",
                            "target_lang_translations": {
                                "ru": "Изготавливать или <w>сбывать</w> фальшивую валюту — тяжкое преступление.",
                                "pl": "Wytwarzanie lub <w>puszczanie</w> w obieg fałszywej waluty to poważne przestępstwo.",
                                "fr": "C'est un crime grave de fabriquer ou de <w>mettre en circulation</w> de la fausse monnaie."
                            }
                        }
                    ],
                    "synonyms": [
                        "circulate",
                        "pass"
                    ],
                    "common_phrases": [
                        "utter counterfeit money",
                        "utter a forged check",
                        "utter false coin"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пускать в обращение фальшивые деньги или документы; выдавать подделку за подлинник.",
                        "pl": "Wprowadzać do obiegu fałszywe pieniądze lub dokumenty; udawać, że podróbka jest autentyczna.",
                        "fr": "Mettre en circulation de la fausse monnaie ou de faux documents ; faire passer une contrefaçon pour authentique."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбывать",
                                "target_lang_sense_clarification": "пускать в ход (о фальшивых деньгах)"
                            },
                            {
                                "target_lang_word": "пускать в обращение",
                                "target_lang_sense_clarification": "вводить в оборот"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wprowadzać do obiegu",
                                "target_lang_sense_clarification": "puszczać w obieg fałszywe środki płatnicze"
                            },
                            {
                                "target_lang_word": "puszczać w obieg",
                                "target_lang_sense_clarification": "wprowadzać fałszywe dokumenty lub pieniądze do użytku"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "mettre en circulation",
                                "target_lang_sense_clarification": "introduire des faux dans le commerce"
                            },
                            {
                                "target_lang_word": "écouler",
                                "target_lang_sense_clarification": "faire passer de la fausse monnaie"
                            }
                        ]
                    }
                }
            ]
        },
