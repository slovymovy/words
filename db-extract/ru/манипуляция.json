                                "target_senses": [
                                    {
                                        "sense_id": "7fca9472-d36f-343d-bb4f-454402f9dafe",
                                        "entry_id": "b987f4f4-18be-393b-97a3-4a598ff5d4ac",
                                        "glosses": [
                                            "The practice of manipulating or the state of being manipulated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "323d483f-d2b5-486e-9223-dff652515592",
                                                "sense_id": "7fca9472-d36f-343d-bb4f-454402f9dafe",
                                                "text": "The dealer's manipulations could have removed cards from the deck."
                                            },
                                            {
                                                "example_id": "c366ede0-933d-4bae-aa1e-ea04aaf75cd5",
                                                "sense_id": "7fca9472-d36f-343d-bb4f-454402f9dafe",
                                                "text": "The rear portion of the tender top is flat and open so as to facilitate the manipulation of the water crane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53e9a81-de1a-31e2-9d4e-ec11ff11c4af",
                                        "entry_id": "b987f4f4-18be-393b-97a3-4a598ff5d4ac",
                                        "glosses": [
                                            "The skillful use of the hands in, for example, chiropractic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efd48e37-6668-45db-81a8-2b35950ce470",
                                                "sense_id": "d53e9a81-de1a-31e2-9d4e-ec11ff11c4af",
                                                "text": "After a few minutes of manipulation each week, she obtained days of relief from her neck pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc8af5ca-ab1d-31b0-b65d-72c7d94a29f4",
                                        "entry_id": "b987f4f4-18be-393b-97a3-4a598ff5d4ac",
                                        "glosses": [
                                            "The usage of psychological influence over a person, event, or situation to gain a desired outcome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "755eb3b6-eb44-4cd5-b546-7d3415bd7769",
                                                "sense_id": "bc8af5ca-ab1d-31b0-b65d-72c7d94a29f4",
                                                "text": "The counselor was able to reach the disturbed teen through positive psychological manipulation."
                                            },
                                            {
                                                "example_id": "2d75dd0c-c05d-46b1-9eb7-4552a930d045",
                                                "sense_id": "bc8af5ca-ab1d-31b0-b65d-72c7d94a29f4",
                                                "text": "Through subtle manipulations he orchestrated the downfall of his rival."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
