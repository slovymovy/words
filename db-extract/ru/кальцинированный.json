                        "form": "кальцини́рована"
                    },
                    {
                        "form_id": "b38d60e5-827b-420b-8b60-4aad20907262",
                        "entry_id": "6a432093-3c40-36cf-b391-3d5cdd854e24",
                        "tags": [
                            "plural",
