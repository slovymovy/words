                "senses": [
                    {
                        "sense_id": "21b25100-3bab-3022-a1cb-f8b6c7ddc84a",
                        "entry_id": "c87cb346-2d60-337b-a8ca-b9561b27f5a4",
                        "glosses": [
                            "Anordnung der Gegenstände eines Gegenstandsbereichs nach der Häufigkeit ihres Vorkommens"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "84c3ab0b-8617-4fdb-af63-9acabe4e08aa",
                                "sense_id": "21b25100-3bab-3022-a1cb-f8b6c7ddc84a",
                                "text": "Die Streuung „sagt etwas darüber aus, ob die Häufigkeitsverteilung eng um den Mittelwert geschart ist oder ob sich auch weiter weg vom Mittelwert noch beachtliche Werte finden.“"
                            },
                            {
                                "example_id": "2d0731ea-ad0d-4a77-996d-c4d42122319c",
                                "sense_id": "21b25100-3bab-3022-a1cb-f8b6c7ddc84a",
                                "text": "„Viele Häufigkeitsverteilungen lassen sich durch derartige Kurven bei zweckmäßig gewähltem a und b angenähert darstellen.“"
                            },
                            {
                                "example_id": "c32ea07d-9dd0-4aa0-ad80-cdb671a65af8",
                                "sense_id": "21b25100-3bab-3022-a1cb-f8b6c7ddc84a",
                                "text": "„Um sich einen ersten Überblick über ein vorliegendes Material zu verschaffen, ordnet man die in der Urliste enthaltenen Merkmalswerte nach der Größe und stellt fest, wie häufig jeder Wert auftritt. Dadurch entsteht eine Häufigkeitsverteilung.“"
                            },
                            {
                                "example_id": "105db376-a58f-433d-a231-a2b99f7fdfc9",
                                "sense_id": "21b25100-3bab-3022-a1cb-f8b6c7ddc84a",
                                "text": "„Aus praktischen Gründen beschränken wir uns auf die Analyse der Häufigkeitsverteilung von Substantiven und Substantivkomposita im lyrischen Werk Paul Celans.“"
                            },
                            {
                                "example_id": "e0d335c8-ce24-457f-8da4-0394d0edc461",
                                "sense_id": "21b25100-3bab-3022-a1cb-f8b6c7ddc84a",
                                "text": "„Veränderungen in der Häufigkeitsverteilung können Aufschluß geben über Wandlungen in der sogenannten 'Vornamenmode', im Geschmack…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
