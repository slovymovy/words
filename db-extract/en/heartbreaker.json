                                    {
                                        "sense_id": "9ca6e83e-7a1d-3e65-a97f-60d850847a95",
                                        "entry_id": "c6466916-e13a-3a5e-a0ba-0f32beea8b04",
                                        "glosses": [
                                            "Séducteur."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bda68c71-a69f-4794-85ad-7f5547a75243",
                                                "sense_id": "9ca6e83e-7a1d-3e65-a97f-60d850847a95",
                                                "text": "Ta, ta, ta ! vous allez me parler de ce petit casse-cœur de Savinien ? Parbleu ! vous achèterez bien cher son nom, ses petites moustaches relevées comme deux crocs, et ses cheveux noirs. Encore un joli cadet !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
