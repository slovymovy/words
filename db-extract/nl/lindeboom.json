                    {
                        "sense_id": "4d825bfa-994e-3396-af57-0b57e83107dc",
                        "entry_id": "4a18229f-d6ec-30f1-958a-6f28b71d4959",
                        "glosses": [
                            "Tilia een geslacht van bomen uit de kaasjeskruidfamilie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ac91c2-a594-45d8-a886-217ddff48261",
                                "sense_id": "4d825bfa-994e-3396-af57-0b57e83107dc",
                                "text": "Zij waren aan de andere kant van het bos onder een oude lindeboom en riepen hem."
                            },
                            {
                                "example_id": "a1207ee6-3607-44fd-8532-5c7dc5c8fa2f",
                                "sense_id": "4d825bfa-994e-3396-af57-0b57e83107dc",
                                "text": "\"Wij stonden voor het raam naar het onweer te kijken en we zien de boom heen en weer gaan\", zegt ze tegen Omroep Brabant. Opeens kwam de lindeboom haar kant op. \"Het leek wel slowmotion. We zijn snel naar de achterkant van het huis gelopen, want je weet niet hoe ver hij komt als hij op het huis valt. Het was heel heftig.\""
                            }
                        ]
                    }
                ],
