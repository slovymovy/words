                        ]
                    },
                    {
                        "translation_id": "b60d4fdb-ba04-46ba-9109-4f7fe6f98c56",
                        "source_entry_id": "446b8906-e036-3f4f-9d8c-7ceeb42b325b",
                        "target_lang_word": "swag",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7005e400-247a-3229-ab24-40baa19093c8",
                                        "entry_id": "4dc3a528-73cc-3974-b548-0e0d4e4f2df0",
                                        "glosses": [
                                            "To (cause to) sway."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6793d96a-053e-435b-82a5-59cb1c667cc9",
                                                "sense_id": "7005e400-247a-3229-ab24-40baa19093c8",
                                                "text": "1790, William Blake, The Marriage of Heaven and Hell, The Argument, p. 1,\nHungry clouds swag on the deep"
                                            },
                                            {
                                                "example_id": "cd7a8bc5-7c58-4999-9acd-9c36cd6bd9d0",
                                                "sense_id": "7005e400-247a-3229-ab24-40baa19093c8",
                                                "text": "Soap/soak the mop into the mop bucket, squeeze it out slightly, swag it back and forth across the piss stained concrete, mop it dry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67d508a6-b098-33ba-9bd8-5163bc232449",
                                        "entry_id": "4dc3a528-73cc-3974-b548-0e0d4e4f2df0",
                                        "glosses": [
                                            "To droop; to sag."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74845325-ed57-4360-9600-6daa9920183c",
                                                "sense_id": "67d508a6-b098-33ba-9bd8-5163bc232449",
                                                "text": "so laid, they are more apt in swagging down, to pierce with their points, then in the jacent Posture"
                                            },
                                            {
                                                "example_id": "6cd3e39d-736b-4589-9e1d-d5e42671f560",
                                                "sense_id": "67d508a6-b098-33ba-9bd8-5163bc232449",
                                                "text": "I swagge as a fatte persos belly swaggeth as he goth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a78f1cb-8a84-34f5-8862-77dd754cd17f",
                                        "entry_id": "4dc3a528-73cc-3974-b548-0e0d4e4f2df0",
                                        "glosses": [
                                            "To decorate (something) with loops of draped fabric."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fa93d46-d17f-405d-a39a-50c03bc41374",
                                                "sense_id": "6a78f1cb-8a84-34f5-8862-77dd754cd17f",
                                                "text": "Dior wouldn’t be Dior without the swagged ball gown[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f6da57e-aa1c-3e0d-828f-339743cda642",
                                        "entry_id": "4dc3a528-73cc-3974-b548-0e0d4e4f2df0",
                                        "glosses": [
                                            "To install (a ceiling fan or light fixture) by means of a long cord running from the ceiling to an outlet, and suspended by hooks or similar."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b29f6ba-8d58-47fd-ac04-85a42c08d0bc",
                                                "sense_id": "3f6da57e-aa1c-3e0d-828f-339743cda642",
                                                "text": "Hooks come with screws for use in plaster or wood and toggles for use in wallboard. One hook should be sufficient to swag a lamp from a ceiling outlet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1328b980-2c12-380c-bb9e-71f0b30bf2ca",
                                        "entry_id": "d322e4cd-9b13-3b76-b111-6f0fe4666b90",
                                        "glosses": [
                                            "A loop of draped fabric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7b42b4e-df1c-4acd-8910-11e4aeda0d3d",
                                                "sense_id": "1328b980-2c12-380c-bb9e-71f0b30bf2ca",
                                                "text": "He looked in bewilderment at number 24, the final house with its regalia of stucco swags and bows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "389cf762-e0f3-31a0-a870-4c9760d5a86d",
                                        "entry_id": "d322e4cd-9b13-3b76-b111-6f0fe4666b90",
                                        "glosses": [
                                            "Something that droops like a swag."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a2f725-dda1-4546-9ab1-f633fb30d414",
                                                "sense_id": "389cf762-e0f3-31a0-a870-4c9760d5a86d",
                                                "text": "Detective Inspector Douglas Browne, the flesh of whose cheeks hung in swags, had the friendly aspect of a large brown-eyed dog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e50dbfdc-0cda-3c82-a29c-6695cc61cb9d",
                                        "entry_id": "d322e4cd-9b13-3b76-b111-6f0fe4666b90",
                                        "glosses": [
                                            "A low point or depression in land; especially:",
                                            "A place where water collects; a low, wet place where the land has settled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69257d43-04b8-4c0c-b012-3727130dd0cc",
                                                "sense_id": "e50dbfdc-0cda-3c82-a29c-6695cc61cb9d",
                                                "text": "Whenever the muddy water would accumulate in the swag the water from the well in question would become muddy[…] After the water in the swag had all disappeared through the sink-hole the well water would again become clear."
                                            },
                                            {
                                                "example_id": "9a6bacbe-8e4c-4959-b285-3edd5340f58c",
                                                "sense_id": "e50dbfdc-0cda-3c82-a29c-6695cc61cb9d",
                                                "text": "This peach tree is th' big tree that allus bore so many peaches. It's th' one in th' low swag by th' old rotted white oak stump."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "956fc72a-3432-3797-9988-827f4d205fd8",
                                        "entry_id": "d322e4cd-9b13-3b76-b111-6f0fe4666b90",
                                        "glosses": [
                                            "A low point or depression in land; especially:",
                                            "A pass, gap or sag in a mountain ridge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00843c10-281c-4636-90df-4774764d9ebe",
                                                "sense_id": "956fc72a-3432-3797-9988-827f4d205fd8",
                                                "text": "[…] the Stoll household were hoeing corn high up on a bench or \"swag\" of the mountain facing the home, where there was newer and richer ground than in the abandoned fields in its rear."
                                            },
                                            {
                                                "example_id": "0a280ff1-ce17-4427-ad4d-029c54631d76",
                                                "sense_id": "956fc72a-3432-3797-9988-827f4d205fd8",
                                                "text": "Finally he managed to grab hold of [the turkey's] legs, but as he did so, the turkey \"riz\" up into the air and carried him across a \"swag\" (gap) to the next mountain and courteously dropped him."
                                            },
                                            {
                                                "example_id": "29721f2a-9551-4960-a7d1-ead1fb3b7725",
                                                "sense_id": "956fc72a-3432-3797-9988-827f4d205fd8",
                                                "text": "We dropped our packs in the low swag and began ascending the steep sides of the \"puzzle\" mountain."
                                            },
                                            {
                                                "example_id": "91b0a96a-2d19-4b35-9009-16e26c0d0452",
                                                "sense_id": "956fc72a-3432-3797-9988-827f4d205fd8",
                                                "text": "Sometimes men would get on either side of a gap or swag, set the dogs loose, and let them drive the deer through between them. Another way was for one man to take the dogs and drive the ridge. Other men would go to gaps or stands at[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89fd80a0-ab43-31f9-82ca-f297af6c0861",
                                        "entry_id": "7f0783f3-185c-3626-8477-8727939cd704",
                                        "glosses": [
                                            "Style; fashionable appearance or manner."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef89a11-fe72-401f-892c-6547d0d5b87a",
                                                "sense_id": "89fd80a0-ab43-31f9-82ca-f297af6c0861",
                                                "text": "Now this dude got swag, and he was pushing up on me but, it wasn't like we was kicking it or anything!"
                                            },
                                            {
                                                "example_id": "d3a90531-92d1-4b19-9c58-78ce587a524d",
                                                "sense_id": "89fd80a0-ab43-31f9-82ca-f297af6c0861",
                                                "text": "They've got those dumb Kanye sunglasses that are $3 a pair at any skanky old market, they've go the word SWAG airbrushed onto them; these kids are hanging around listening to crunk records, throwing around sayings like “Swag it out”, “Turn my swag on”, “Flip the swag switch and homie” and even “Get out your sweaty swag length and push it deep inside me”. Let me tell you something - if I ever see those kids out in Gangnam I'll be caving their sorry heads in with my swag bat, or I'll be making out with their swag girlfriend while they're too busy smoking crack behind a brick wall because that's how we do things in Gangnam, sucker."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7ac4cdb-7166-3101-aec6-4fe0ec0945ed",
                                        "entry_id": "117996b0-6c1a-339c-8911-a448f5f2eba0",
                                        "glosses": [
                                            "Stolen goods; the booty of a burglar or thief; boodle."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fd0b2c6-ed1f-47b8-9a39-599c40b9ed14",
                                                "sense_id": "c7ac4cdb-7166-3101-aec6-4fe0ec0945ed",
                                                "text": "The swag, is a term used in speaking of any booty you have lately obtained, be it of what kind it may, except money; as where did you lumber the swag? that is, where did you deposit the stolen property? To carry the swag is to be the bearer of the stolen goods to a place of safety."
                                            },
                                            {
                                                "example_id": "f6780d20-7500-4da5-b646-67705063125a",
                                                "sense_id": "c7ac4cdb-7166-3101-aec6-4fe0ec0945ed",
                                                "text": "“It′s all arranged about bringing off the swag, is it?” asked the Jew. Sikes nodded."
                                            },
                                            {
                                                "example_id": "89b4c059-ac0b-451a-bf8a-bf9b214c6207",
                                                "sense_id": "c7ac4cdb-7166-3101-aec6-4fe0ec0945ed",
                                                "text": "‘I understand that the district was considered a sort of sanctuary,’ the Chief was saying. ‘[…] They tell me there was a recognized swag market down here.’"
                                            },
                                            {
                                                "example_id": "12b74823-9ec1-49e0-951d-c15a6058043c",
                                                "sense_id": "c7ac4cdb-7166-3101-aec6-4fe0ec0945ed",
                                                "text": "He was on his way to call on other dealers to check out their swag and to see if he could trade away some of his leftover odds and ends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac318fb2-b3c8-3eee-9df9-535acaa891f0",
                                        "entry_id": "117996b0-6c1a-339c-8911-a448f5f2eba0",
                                        "glosses": [
                                            "Handouts, freebies, or giveaways, often distributed at conventions; merchandise."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a237107e-36e5-4a62-85c5-19d95fe17053",
                                                "sense_id": "ac318fb2-b3c8-3eee-9df9-535acaa891f0",
                                                "text": "\"Make sure to take some swag on your way out!\" I called.\nHe stooped a bit in mid-trot and snatched a small gold bag out of the basket at the door. The contents were mostly shit, a few drink tickets to the Well of Souls, VIP status at Convent, that sort of thing."
                                            },
                                            {
                                                "example_id": "c0d4d8d8-73fa-4cf1-828e-b56df9624d61",
                                                "sense_id": "ac318fb2-b3c8-3eee-9df9-535acaa891f0",
                                                "text": "You may hesitate before you pocket the swag, wondering if doing so is OK. Worry not: Hospitality industry folks say they’re delighted when people feel compelled to take one of these as a keepsake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080826f1-3be7-352f-9f02-831a22952c04",
                                        "entry_id": "117996b0-6c1a-339c-8911-a448f5f2eba0",
                                        "glosses": [
                                            "The possessions of a bushman or itinerant worker, tied up in a blanket and carried over the shoulder, sometimes attached to a stick."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c91683-7086-40bc-b118-3702ce8940d7",
                                                "sense_id": "080826f1-3be7-352f-9f02-831a22952c04",
                                                "text": "He tramped for years till the swag he bore seemed part of himself to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ee588b0-ddb7-38e2-ba14-801c98217d53",
                                        "entry_id": "117996b0-6c1a-339c-8911-a448f5f2eba0",
