                "senses": [
                    {
                        "sense_id": "16cf41fa-34c3-3100-8f58-b7f18338e627",
                        "entry_id": "bb9eba01-4d48-3511-a615-3b7631fe0183",
                        "glosses": [
                            "Celui qui fait et vend du vinaigre."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "4a9ad389-5aef-469e-9b29-9f55d244dc89",
                                "sense_id": "16cf41fa-34c3-3100-8f58-b7f18338e627",
                                "text": "Dans telles villes comme Orléans, Caen, Paris, la plupart des corps de métiers (boulangers, chapeliers, chaudronniers, charrons, tourneurs, vinaigriers, moutardiers, etc.) sont ouverts aux femmes."
                            },
                            {
                                "example_id": "279a7b6f-1009-4118-aed6-4563a24f81fa",
                                "sense_id": "16cf41fa-34c3-3100-8f58-b7f18338e627",
                                "text": "Marchand vinaigrier."
                            }
                        ]
                    },
                    {
                        "sense_id": "533deab7-4fff-38f7-978c-aa3c22a384bb",
                        "entry_id": "bb9eba01-4d48-3511-a615-3b7631fe0183",
                        "glosses": [
                            "Petit vase servant à mettre du vinaigre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "520f52ec-9fd3-48f9-a836-42c8d5ad0490",
                                "sense_id": "533deab7-4fff-38f7-978c-aa3c22a384bb",
                                "text": "Vinaigrier de cristal, de porcelaine."
                            },
                            {
                                "example_id": "eaaedf6d-ad3e-4a7c-a8ab-23e39278b1f8",
                                "sense_id": "533deab7-4fff-38f7-978c-aa3c22a384bb",
                                "text": "Elle passe au milieu des verres, des vinaigriers où se réfracte la lumière diffuse – lumière un instant suspendue aux poils et les teintant de bleu ou de rose."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc41d6a9-5743-31fe-b826-d3b7da815ae3",
                        "entry_id": "bb9eba01-4d48-3511-a615-3b7631fe0183",
                        "glosses": [
                            "Petit arbre portant des fruits rouges en grappes de grappes (panicules) et appartenant à diverses espèces du genre Rhus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
