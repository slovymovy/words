                        "entry_id": "716eaf94-d7da-3a4c-bbc1-45016659bb1a",
                        "glosses": [
                            "The act or process of eroticizing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c4b4456b-b5a1-40c1-950c-7bbb79ecc343",
                                "sense_id": "575d8d23-5997-318f-b8af-7cd9d3f4817b",
                                "text": "The masculine militarization of culture has led to a feminine eroticization."
                            },
                            {
                                "example_id": "cc937ccb-a18b-4d71-b827-4dad692d6280",
                                "sense_id": "575d8d23-5997-318f-b8af-7cd9d3f4817b",
                                "text": "A round of applause to Lawrence Downes for pointing out that the premature eroticization of young girls could never happen if their parents woke up and thought about the behavior they’re tolerating — and outright encouraging."
                            }
                        ]
                    }
                ],
                "translations": [
