                                                "sense_id": "c0e84574-a899-3db1-9b7e-ccf2996fd236",
                                                "text": "Het gesmolten metaal verzamelde zich in kraaltjes op de bodem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28957f70-813b-31b6-8620-fac56839e297",
