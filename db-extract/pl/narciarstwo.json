                                                "sense_id": "081272be-9203-32f1-9eb7-8ad8d12b69fc",
                                                "text": "Er wordt daar 's winters veel geskied."
                                            },
                                            {
                                                "example_id": "ac58143f-7606-41b6-866c-189124b49019",
                                                "sense_id": "081272be-9203-32f1-9eb7-8ad8d12b69fc",
                                                "text": "De staat heeft alles: perfect warm weer, zee om te surfen, bergen om te skiën, wijnvelden en prachtige trails door de ongerepte natuur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b41622e-ea50-3087-9c39-a73b9b52bd14",
                                        "entry_id": "e3501c5a-9424-333e-880d-d362d6a5eb44",
                                        "glosses": [
                                            "zich over sneeuw ergens heen bewegen op twee aan de voeten bevestigde lange latten"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456a878f-773a-4936-84ed-7ecd41a26fa1",
                                                "sense_id": "1b41622e-ea50-3087-9c39-a73b9b52bd14",
                                                "text": "We zijn van die hut naar de andere lift geskied."
                                            }
