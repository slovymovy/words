                "senses": [
                    {
                        "sense_id": "7b7e1f41-f7c0-3613-b1ef-977eeb970f43",
                        "entry_id": "a5e3ab5b-0792-3ca9-8f6e-78c0d776d67b",
                        "glosses": [
                            "Zahlmeister oder Proviantmeister auf einem Schiff"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "2cf9f862-07a3-4eb2-8463-f1e7ee6081b4",
                                "sense_id": "7b7e1f41-f7c0-3613-b1ef-977eeb970f43",
                                "text": "LeSeur hatte alle Abteilungsleiter zu einer Not-Personalversammlung einberufen, und schon trafen die Leiter der Hotellerie- und Unterhaltungsabteilung, der Purser, der Bootsmann und der Chefsteward ein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "60308ae0-5dad-3408-90d1-ce8c2f07b1dd",
                        "entry_id": "a5e3ab5b-0792-3ca9-8f6e-78c0d776d67b",
                        "glosses": [
                            "leitender Steward in einem Flugzeug"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "0896b797-a823-42be-a1d1-c68ff649084d",
                                "sense_id": "60308ae0-5dad-3408-90d1-ce8c2f07b1dd",
                                "text": "Als Purser führen Sie das Kabinenteam an Bord eines Flugzeuges."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4321aca1-6570-4515-ae98-8d58a82fe62b",
                        "source_entry_id": "a5e3ab5b-0792-3ca9-8f6e-78c0d776d67b",
                        "source_sense_id": "7b7e1f41-f7c0-3613-b1ef-977eeb970f43",
                        "source_sense_description": "Zahlmeister oder Proviantmeister auf einem Schiff",
                        "target_lang_word": "purser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a825bd3a-4655-3727-80e3-a833c571bce7",
                                        "entry_id": "2e7f09e3-ee23-3a0f-ad7c-56c66e3f0270",
                                        "glosses": [
                                            "The person responsible for handling the accounts on a ship, or for dealing with the passengers on a ship or aircraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1120d13a-6124-4b35-94b7-d1c58759c50c",
                                                "sense_id": "a825bd3a-4655-3727-80e3-a833c571bce7",
                                                "text": "So the Comptroller and I thence to a tavern hard by, and there did agree upon drawing up some letters to be sent to all the pursers and Clerks of the Cheques to make up their accounts."
                                            },
                                            {
                                                "example_id": "43bd222f-18ad-4b6b-b763-db9c33b8e0f4",
                                                "sense_id": "a825bd3a-4655-3727-80e3-a833c571bce7",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy.[…]Passengers wander restlessly about or hurry, with futile energy, from place to place. Pushing men hustle each other at the windows of the purser's office, under pretence of expecting letters or despatching telegrams."
                                            },
                                            {
                                                "example_id": "07b64e92-ccd6-4b38-9b49-eabe42d0205f",
                                                "sense_id": "a825bd3a-4655-3727-80e3-a833c571bce7",
                                                "text": "If we offend against any of the other rules (A's or B's) - that is if we, say, utter the formula incorrectly, or if, say, we are not in a position to do the act because we are, say, married already, or it is the purser and not the captain who is conducting the ceremony, then the act in question, e.g. marrying, is not successfully performed at all, does not come off, is not achieved."
                                            },
                                            {
                                                "example_id": "7e6606e7-b539-4b7d-bb7e-d1e65c6ddda2",
                                                "sense_id": "a825bd3a-4655-3727-80e3-a833c571bce7",
                                                "text": "“Cabin 459, sir.” “What deck?” “'A' deck, sir.” “That's second class.” “Yes, sir. You have a second-class ticket.” “There must be some mistake. I can't possibly have a second-class ticket.” The assistant purser examined another ledger, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
