                    {
                        "sense_id": "7e99ca59-ef3f-3c9a-81bd-f7df24232bb3",
                        "entry_id": "c075f227-d2d3-36ab-99f0-4964b9abe802",
                        "glosses": [
                            "gezuiverd water dat via buisleidingen wordt getransporteerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56246aeb-4ab3-4c74-8bff-5b519e809f0f",
                                "sense_id": "7e99ca59-ef3f-3c9a-81bd-f7df24232bb3",
                                "text": "Eerder deze maand brak er in Andorra nog paniek uit omdat het water van de Valira-rivier groen kleurde. Deze week schrokken inwoners van het Canadese dorpje Onoway toen het kraantjeswater plots roze kleurde."
                            },
                            {
                                "example_id": "6cbd4854-de0b-41f1-8d77-0b7d85dcb974",
                                "sense_id": "7e99ca59-ef3f-3c9a-81bd-f7df24232bb3",
                                "text": "Zelfs in de potentiële ontginningsgebieden is er weinig kritiek. De dorpen waar wordt geprotesteerd tegen proefboringen zijn op de vingers van een hand te tellen. Ook in Lubocino maakt niemand zich druk. Over brandend kraantjeswater heeft niemand gehoord."
                            }
                        ]
                    }
                ],
