                "senses": [
                    {
                        "sense_id": "c7322111-7164-389f-b394-e9668e533b7d",
                        "entry_id": "70f7a83e-0718-362c-9d3e-b84956e98aed",
                        "glosses": [
                            "Se dit de deux polyèdres réguliers lorsqu’on obtient l’un en échangeant les faces et sommets de l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4619e02-e18a-421a-a65a-cf7fbd96f2a2",
                                "sense_id": "c7322111-7164-389f-b394-e9668e533b7d",
                                "text": "Le cube et l’octaèdre, le dodécaèdre et l’icosaèdre sont duals (ou duaux) l’un de l’autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9505854-b137-3daa-8f49-c31de2162593",
                        "entry_id": "70f7a83e-0718-362c-9d3e-b84956e98aed",
                        "glosses": [
                            "Se dit de propriétés qui sont par deux et qui présentent un caractère de réciprocité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cbabcdc-c0b4-47df-ab02-a131eb41680d",
                                "sense_id": "a9505854-b137-3daa-8f49-c31de2162593",
                                "text": "Les relations d’inégalité sont duales."
                            }
                        ]
                    },
                    {
                        "sense_id": "273c556a-014b-378f-8eb4-f0db375b20ff",
                        "entry_id": "70f7a83e-0718-362c-9d3e-b84956e98aed",
                        "glosses": [
                            "Équation, expression duale : Qui se déduit d’une équation ou d’une expression écrite avec les symboles d’union et d’intersection en inversant ces symboles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5f63792-16cb-45c7-8b4a-670cd5a3363c",
                                "sense_id": "273c556a-014b-378f-8eb4-f0db375b20ff",
                                "text": "En théorie informatique, la confidentialité et l’intégrité des données sont duales."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a9a5361-9cef-3dc6-90f8-a7471b565812",
                        "entry_id": "70f7a83e-0718-362c-9d3e-b84956e98aed",
                        "glosses": [
                            "Double (avec un caractère de réciprocité)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f64118a-0af7-4f6e-bea4-1a98b6418887",
                                "sense_id": "3a9a5361-9cef-3dc6-90f8-a7471b565812",
                                "text": "Dans le cas de l’étude des couleurs, les qualificatifs dual, contraire et complémentaire, prennent des sens très voisins."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae0341d5-e7fe-3cc6-b404-f2e36d9284ca",
                        "entry_id": "70f7a83e-0718-362c-9d3e-b84956e98aed",
                        "glosses": [
                            "Société duale : Dans laquelle existent une population à hauts revenus et à forte productivité et une population à revenus et productivité faibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b8ffd8e-a7ab-4433-94a3-a449278d1c76",
                                "sense_id": "ae0341d5-e7fe-3cc6-b404-f2e36d9284ca",
                                "text": "Une société duale, avec le gâteau pour les premiers rôles et les miettes pour les figurants."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c969f4a-2ddd-3152-af5e-e389c06d4b93",
                        "entry_id": "70f7a83e-0718-362c-9d3e-b84956e98aed",
                        "glosses": [
                            "Se dit d'un graphe défini à l'aide des composantes de son complémentaire, reliées par ses arêtes."
                        ],
                        "tags": [
                            "Théorie des graphes"
                        ],
                        "examples": []
                    }
                ],
