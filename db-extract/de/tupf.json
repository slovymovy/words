                    },
                    {
                        "translation_id": "4ec70e3d-3710-46b4-866f-9fadc65879f3",
                        "source_entry_id": "7825c9d8-8be0-3604-947a-e51f92bf8a7e",
                        "source_sense_id": "61a456e8-51c3-3424-9369-393d73b3b144",
                        "source_sense_description": "kleiner Fleck",
                        "target_lang_word": "pois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec9c12a0-5c0f-3161-b64b-168aac35f534",
                                        "entry_id": "017e7406-ba10-3395-b69f-427db2b3d254",
                                        "glosses": [
                                            "Chacune des graines, de forme ronde, et enfermées dans une cosse verte, d’une espèce de fabacée (légumineuse) papilionacée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86764d74-7dfc-4ce8-a0ec-6c57e43df4af",
                                                "sense_id": "ec9c12a0-5c0f-3161-b64b-168aac35f534",
                                                "text": "Des petits pois, ainsi préparés, peuvent se conserver plusieurs années sans perdre le goût qu’ils ont dans la primeur."
                                            },
                                            {
                                                "example_id": "1dfd471f-4512-454d-8549-03d60fa4a1a7",
                                                "sense_id": "ec9c12a0-5c0f-3161-b64b-168aac35f534",
                                                "text": "L’utilisation du pois dans le Croissant fertile est attestée par des données archéologiques datant de 8000 av. J.-C."
                                            },
                                            {
                                                "example_id": "651a06e3-70d4-4eaf-98c1-7c677df3c354",
                                                "sense_id": "ec9c12a0-5c0f-3161-b64b-168aac35f534",
                                                "text": "Les pois mûrs & secs sont un des légumes qui fournissent la purée la plus délicate, & l’aliment le moins grossier."
                                            },
                                            {
                                                "example_id": "009c9cb7-3357-4fb2-b260-c32f89985318",
                                                "sense_id": "ec9c12a0-5c0f-3161-b64b-168aac35f534",
                                                "text": "Les pois égouttés doivent présenter la couleur normale caractéristique des pois secs trempés en conserve, compte tenu de toute adjonction de colorants artificiels."
                                            },
                                            {
                                                "example_id": "7b439147-04ff-411e-bdae-133a393d16fa",
                                                "sense_id": "ec9c12a0-5c0f-3161-b64b-168aac35f534",
                                                "text": "La production mondiale actuelle est d’environ 13,5 millions de tonnes de pois secs et 4,8 millions de tonnes de pois frais [par an]."
                                            },
                                            {
                                                "example_id": "b32261b5-b831-4526-a3b2-2b915606f2b9",
                                                "sense_id": "ec9c12a0-5c0f-3161-b64b-168aac35f534",
                                                "text": "On trouve parmi les aliments les plus anciens, les fèves et toutes les légumineuses cultivées dans les champs depuis l’Antiquité en Europe : dolique, pois sec, lentille, pois chiche […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce24de59-d4d4-3999-95aa-69e4450f50b0",
                                        "entry_id": "017e7406-ba10-3395-b69f-427db2b3d254",
                                        "glosses": [
                                            "Plante même qui porte ce légume."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f7bb0a6-17be-4274-9aa3-94d7fef1b088",
                                                "sense_id": "ce24de59-d4d4-3999-95aa-69e4450f50b0",
                                                "text": "Cet ouvrage présente les connaissances actuelles sur l’écophysiologie du pois protéagineux : développement végétatif et reproducteur, croissance en condition non limitante, nutrition azotée."
                                            },
                                            {
                                                "example_id": "6b87d24b-f3db-48d6-887d-8394571923e7",
                                                "sense_id": "ce24de59-d4d4-3999-95aa-69e4450f50b0",
                                                "text": "Les géniteurs de résistance au froid : « Champagne » et « Austria Winter » renferment le plus grand nombre de gènes récessifs. Les pois d’hiver actuels en possèdent moins et les pois de printemps en sont pratiquement dépourvus."
                                            },
                                            {
                                                "example_id": "91464a54-0a9a-45b8-ac5a-5dd0c71c8ba1",
                                                "sense_id": "ce24de59-d4d4-3999-95aa-69e4450f50b0",
                                                "text": "Le fruit du Pois est une gousse classique. On distingue nombre de variétés parmi les Pois cultivés. Citons, par exemple : les Pois nains, les Pois à rames, les Pois à écosser (aux seules graines comestibles), les Pois mange-tout (la gousse elle-même est également comestible)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97a6110e-bded-3707-b773-fd20bfb048ea",
                                        "entry_id": "017e7406-ba10-3395-b69f-427db2b3d254",
                                        "glosses": [
                                            "Motif décoratif en forme de petits ronds alignés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85c538dc-c524-48fc-8161-1cd6ef782af1",
                                                "sense_id": "97a6110e-bded-3707-b773-fd20bfb048ea",
                                                "text": "De Georges, il dirait qu’il ressemble à un Italo-Mafioso-Sans-Flingue, mâtiné d’un relent de touriste sur les bords du Nil : avec cette chaleur, en pleine nuit, il porte sur le crâne, de guingois, un Borsalino beige, une chemise à pois blancs sur fond noir qui zigzague au bombé de l’estomac […]"
                                            },
                                            {
                                                "example_id": "351c57bb-1f76-4113-8d9a-46d28eeddd38",
                                                "sense_id": "97a6110e-bded-3707-b773-fd20bfb048ea",
                                                "text": "Mariées au lendemain de la Grande Guerre, on les a peut-être vues en robe à pois et blouse à fleurs, l’été, pendant quatre ou cinq ans, le temps que les funérailles entrent dans la danse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d81683-3992-3a83-bd2e-2b9d3001ae7f",
                                        "entry_id": "017e7406-ba10-3395-b69f-427db2b3d254",
                                        "glosses": [
                                            "Petit pétard qu’on fait exploser en le choquant référence nécessaire (résoudre le problème)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d8b91a-9697-4d76-be6a-c48ed337dfcb",
                                                "sense_id": "45d81683-3992-3a83-bd2e-2b9d3001ae7f",
                                                "text": "Ordinairement, pour ébranler la foi en quelque chose, on n’a nullement besoin d’amener, sans plus, la grosse artillerie de combat ; chez beaucoup on atteint déjà son but en attaquant avec un peu de bruit, de sorte que les pois fulminants suffisent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
