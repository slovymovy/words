                "senses": [
                    {
                        "sense_id": "1b20a249-c114-3c8a-b5ca-df456d9cba7b",
                        "entry_id": "04b3841d-7710-3624-a7ad-11162de9af1a",
                        "glosses": [
                            "служащий для вытягивания, удаления вредных веществ (газов, паров, пыли и т. п.) откуда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4141f179-9fdb-4858-8cd4-773a3b020792",
                                "sense_id": "1b20a249-c114-3c8a-b5ca-df456d9cba7b",
                                "text": "В одном из окон надсадно лопотал вытяжной вентилятор ― значит, кто-то в лаборатории есть."
                            }
                        ]
                    },
                    {
                        "sense_id": "90672370-be8c-300d-823b-3898fa86d37f",
                        "entry_id": "04b3841d-7710-3624-a7ad-11162de9af1a",
                        "glosses": [
                            "способный вытягиваться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d69d84d2-ca37-4983-a0ca-b67cd5b6ae71",
                                "sense_id": "90672370-be8c-300d-823b-3898fa86d37f",
                                "text": "Я видел закрытые глаза девушки, рот ее, кончик языка, как бы умоляющий меня скорее дернуть вытяжное кольцо."
                            }
                        ]
                    }
                ],
