                "senses": [
                    {
                        "sense_id": "15105266-c56d-3504-9aee-47dac7577141",
                        "entry_id": "e7fa0c61-280e-3ef2-b787-992a40683508",
                        "glosses": [
                            "giftig gas met de molecuulformule COCl₂"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea362ba8-7759-420f-8621-b5fae45876d5",
                                "sense_id": "15105266-c56d-3504-9aee-47dac7577141",
                                "text": "Of neem ”VX”, waarvan een druppel onmiddellijk tot stuiptrekkingen, verlammingen en coma leidt. En de dood is in enkele minuten verzekerd. Ook bevinden zich in Rusland nog steeds op grote schaal verstikkende gassen als fosgeen, mosterdgas en sarin."
                            },
                            {
                                "example_id": "5c682784-6489-4eb8-96e7-40e8177d1d38",
                                "sense_id": "15105266-c56d-3504-9aee-47dac7577141",
                                "text": "Epichloorhydrine, dat wordt gebruikt bij de productie van kleefstoffen, werkt prikkelend op ogen en slijmvliezen en het kan hoofdpijn, misselijkheid en longoedeem veroorzaken. Uit de vloeistof kunnen de gevaarlijke gassen chloorwaterstof en fosgeen ontstaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e63f711c-bfc7-45be-8e4b-1a30234c5232",
                        "source_entry_id": "e7fa0c61-280e-3ef2-b787-992a40683508",
                        "source_sense_id": "15105266-c56d-3504-9aee-47dac7577141",
                        "source_sense_description": "giftig gas met de molecuulformule COCl₂",
                        "target_lang_word": "carbonyl chloride",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbonyl chloride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6995686-4119-322b-a519-b91592453652",
                                        "entry_id": "a837ed3d-8ed3-3e27-9cc8-fc449914d172",
                                        "glosses": [
                                            "A toxic gas, COCl₂, used in the manufacture of plastics, pesticides etc, and once used as a chemical weapon."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44e7f062-3c09-447d-b5d9-ec64b90e099d",
                                                "sense_id": "a6995686-4119-322b-a519-b91592453652",
                                                "text": "More of a French term. Phosgène. We prefer to call it carbonyl chloride. Less. . .disquieting, somehow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae5dc4e6-6fb0-4271-811a-5af1d8be98da",
                        "source_entry_id": "e7fa0c61-280e-3ef2-b787-992a40683508",
                        "source_sense_id": "15105266-c56d-3504-9aee-47dac7577141",
