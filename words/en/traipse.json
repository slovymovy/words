{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46f10a2d-39ff-3d1a-bb06-306b22f2e2e3",
                    "sense_definition": "To walk about wearyingly or reluctantly, often covering a considerable distance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weary_walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole afternoon having to <w>traipse</w> around various shops looking for a coat.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, вынужденные <w>таскаться</w> по разным магазинам в поисках пальто."
                            }
                        },
                        {
                            "text": "I really do not feel like <w>traipsing</w> through the mud just to fetch the post.",
                            "target_lang_translations": {
                                "ru": "Мне совсем неохота <w>тащиться</w> по грязи только ради того, чтобы забрать почту."
                            }
                        }
                    ],
                    "synonyms": [
                        "walk",
                        "trek"
                    ],
                    "common_phrases": [
                        "traipse around",
                        "traipse through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утомительно, неохотно или долго тащиться, плестись, бродить пешком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тащиться",
                                "target_lang_sense_clarification": "идти неохотно или с трудом"
                            },
                            {
                                "target_lang_word": "плестись",
                                "target_lang_sense_clarification": "идти медленно и устало"
                            },
                            {
                                "target_lang_word": "шататься",
                                "target_lang_sense_clarification": "утомительно бродить по магазинам или улицам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60c8cb0f-69e2-3ebb-817a-15b555718907",
                    "sense_definition": "To travel or wander over a significant or tedious journey.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weary_walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While you were <w>traipsing</w> round the continent, I had to manage everything at home.",
                            "target_lang_translations": {
                                "ru": "Пока ты <w>колесил</w> по континенту, мне приходилось со всем управляться дома."
                            }
                        },
                        {
                            "text": "After a long day, she <w>traipsed</w> across town to visit her grandmother.",
                            "target_lang_translations": {
                                "ru": "После долгого дня она <w>потащилась</w> через весь город, чтобы навестить бабушку."
                            }
                        }
                    ],
                    "synonyms": [
                        "travel"
                    ],
                    "common_phrases": [
                        "traipse round",
                        "traipse across"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать или преодолевать значительные расстояния с усилием или неохотой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таскаться",
                                "target_lang_sense_clarification": "ездить или ходить по разным местам, часто попусту"
                            },
                            {
                                "target_lang_word": "колесить",
                                "target_lang_sense_clarification": "ездить по отдаленным местам"
                            },
                            {
                                "target_lang_word": "тащиться",
                                "target_lang_sense_clarification": "добираться куда-то далеко"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce93cfcb-a0d7-3509-898c-5b6aa9c67d22",
                    "sense_definition": "To walk a distance or route with weary effort.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weary_walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had <w>traipsed</w> every step of the long path in the bitter cold.",
                            "target_lang_translations": {
                                "ru": "Она <w>прошагала</w> каждый шаг этого долгого пути на пронизывающем холоде."
                            }
                        },
                        {
                            "text": "They <w>traipsed</w> five miles back to the cottage after missing the last bus.",
                            "target_lang_translations": {
                                "ru": "Они <w>отмахали</w> пять миль обратно к коттеджу, опоздав на последний автобус."
                            }
                        }
                    ],
                    "synonyms": [
                        "cover",
                        "traverse"
                    ],
                    "common_phrases": [
                        "traipse miles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преодолевать пешком определенное расстояние с трудом и усталостью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протащиться",
                                "target_lang_sense_clarification": "пройти расстояние с трудом"
                            },
                            {
                                "target_lang_word": "отшагать",
                                "target_lang_sense_clarification": "преодолеть пешком путь"
                            },
                            {
                                "target_lang_word": "прошагать",
                                "target_lang_sense_clarification": "пройти определенную дистанцию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27058f74-48e5-3b72-b708-18aa17e29c69",
                    "sense_definition": "To wander casually, aimlessly, or insouciantly over or through a place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tourists <w>traipsed</w> through the quiet village without paying much attention to the locals.",
                            "target_lang_translations": {
                                "ru": "Туристы <w>слонялись</w> по тихой деревне, не обращая особого внимания на местных жителей."
                            }
                        },
                        {
                            "text": "He spent his free mornings <w>traipsing</w> the meadows behind his house.",
                            "target_lang_translations": {
                                "ru": "Свободные утренние часы он проводил, <w>бродя</w> по лугам за своим домом."
                            }
                        }
                    ],
                    "synonyms": [
                        "gad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесцельно, праздно или беззаботно бродить, слоняться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слоняться",
                                "target_lang_sense_clarification": "ходить без дела"
                            },
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "ходить не спеша, без четкой цели"
                            },
                            {
                                "target_lang_word": "шляться",
                                "target_lang_sense_clarification": "разг., праздно бродить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "974c74ca-a60b-3154-a531-c1e3be41b6e1",
                    "sense_definition": "To walk in a slovenly or untidy manner, trailing through dirt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children came <w>traipsing</w> into the clean kitchen with soaked and muddy boots.",
                            "target_lang_translations": {
                                "ru": "Дети <w>ввалились</w> на чистую кухню в насквозь промокших и грязных сапогах."
                            }
                        },
                        {
                            "text": "She <w>traipsed</w> through the damp alleyway, letting her long skirt brush the ground.",
                            "target_lang_translations": {
                                "ru": "Она <w>брела</w> по сырому переулку, позволяя длинной юбке волочиться по земле."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used of slovenly or untidy trailing walking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ходить неряшливо, волоча ноги или одежду по грязи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлепать",
                                "target_lang_sense_clarification": "идти неряшливо по грязи или лужам"
                            },
                            {
                                "target_lang_word": "волочиться",
                                "target_lang_sense_clarification": "неряшливо передвигаться"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42b02946-20d6-37b0-875c-1427590df497",
                    "sense_definition": "A long, tedious, or tiring walk.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a tedious <w>traipse</w> uphill in the rain all the way home.",
                            "target_lang_translations": {
                                "ru": "Это был утомительный <w>подъем</w> в гору под дождем всю дорогу до дома."
                            }
                        },
                        {
                            "text": "Nobody wanted to face the long <w>traipse</w> across the field in the dark.",
                            "target_lang_translations": {
                                "ru": "Никому не хотелось отправляться в этот долгий и тяжелый <w>переход</w> через поле в темноте."
                            }
                        }
                    ],
                    "synonyms": [
                        "trek",
                        "hike"
                    ],
                    "common_phrases": [
                        "long traipse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Долгая, утомительная или нудная пешая прогулка или переход."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тягомотина",
                                "target_lang_sense_clarification": "утомительный путь или переход"
                            },
                            {
                                "target_lang_word": "утомительный путь",
                                "target_lang_sense_clarification": "долгая тяжелая дорога пешком"
                            },
                            {
                                "target_lang_word": "марш-бросок",
                                "target_lang_sense_clarification": "разг., тяжелый длинный переход"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89c181fe-2db5-39d4-978d-37f67bf820f0",
                    "sense_definition": "A meandering or casual walk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed an easy <w>traipse</w> down the rocky slope to the shore.",
                            "target_lang_translations": {
                                "ru": "Мы с удовольствием совершили легкую <w>прогулку</w> вниз по каменистому склону к берегу."
                            }
                        },
                        {
                            "text": "Their afternoon <w>traipse</w> through the garden ended by the fountain.",
                            "target_lang_translations": {
                                "ru": "Их дневная <w>прогулка</w> по саду закончилась у фонтана."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспешная или бесцельная прогулка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогулка",
                                "target_lang_sense_clarification": "неспешная ходьба ради отдыха"
                            },
                            {
                                "target_lang_word": "вылазка",
                                "target_lang_sense_clarification": "небольшой поход или прогулка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}