                ],
                "senses": [
                    {
                        "sense_id": "477cceac-3a49-3ce1-8897-da2a543cab9d",
                        "entry_id": "77c7185b-d9aa-3e2a-b0d9-c9a6525586e9",
                        "glosses": [
                            "Qui prévoit de mettre l’opérateur après ses opérandes, en parlant d’une notation, par exemple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85af851a-7b4a-408a-a8d6-ff068cd91c24",
                                "sense_id": "477cceac-3a49-3ce1-8897-da2a543cab9d",
                                "text": "La notation postfixée (polonaise inverse) consiste à placer les opérandes devant l’opérateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "112614e4-ee01-31a9-9e1f-1cfb41ddb98d",
                        "entry_id": "77c7185b-d9aa-3e2a-b0d9-c9a6525586e9",
                        "glosses": [
                            "Se dit d'un plexus décalé d'un étage vers le bas, qui contient beaucoup de fibres de la seconde racine dorsale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d9e6bd-04e8-432d-a307-1d2913349ab1",
                                "sense_id": "112614e4-ee01-31a9-9e1f-1cfb41ddb98d",
                                "text": "Rarement également il y a un apport important de fibres provenant de la 2' racine dorsale, on parle alors de plexus « postfixé »."
                            },
                            {
                                "example_id": "a0b4bedd-fb3e-4342-b358-378cbf773d09",
                                "sense_id": "112614e4-ee01-31a9-9e1f-1cfb41ddb98d",
                                "text": "Parfois même, le plexus brachial peut être décalé d'un étage radiculaire, soit vers le haut (plexus préfixé), soit vers le bas (plexus postfixé)."
                            }
                        ]
                    }
                ],
