                                                "sense_id": "073b6501-81a1-3326-907e-efee2f935554",
                                                "text": "Stryjec całe życie cierpiał na kaduk."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
                            {
