                "senses": [
                    {
                        "sense_id": "528e8d81-e6cc-3e87-b66d-b95007b9f87b",
                        "entry_id": "1e30543c-de95-3305-8fae-95576e2130fb",
                        "glosses": [
                            "im Stromgebiet des Mississippi River verbreiteter Stör"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1880ff69-fb66-415d-bc90-dca5641f6b8a",
                                "sense_id": "528e8d81-e6cc-3e87-b66d-b95007b9f87b",
                                "text": "„Fast eine Stunde lang rührte sich nichts; dann tauchte er wieder auf, im Schlepptau einen größeren Löffelstör, Relikt devonischer Meere, ein schuppenloses ledriges Ding mit Entenschnabel, die kleinen Augen bargen Äonen von Nacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
