                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cbbf565-1d9c-4c17-98b6-896586482b72",
                                "sense_id": "a100c8ea-71bb-3611-bf2e-bfc31d32fa4b",
                                "text": "En face de la maison, assis jambes pendantes sur la balustrade du quai, se tenait un soldat anglais, un pitoyable petit tommy jaune."
                            },
                            {
                                "example_id": "0ab987dd-775b-431e-892a-732f1ab820b3",
                                "sense_id": "a100c8ea-71bb-3611-bf2e-bfc31d32fa4b",
                                "text": "Fendant la foule, un tommy s’approcha, fit trembler son avant-bras à la hauteur de ses sourcils, posa une question à Gabet. Il parlait avec un accent si particulier que Maillat ne saisit pas ses paroles."
                            }
                        ]
                    }
