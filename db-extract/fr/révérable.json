                        "glosses": [
                            "Digne d’être révéré."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8d15dadf-cb9d-476c-91bf-53f605e37805",
                                "sense_id": "04e71f92-aa52-3f5b-ba35-bbdffecaed1e",
                                "text": "Le dueil qu’elle a porté depuis nostre desfaite,\nL’abandon de sa terre à nos gens pour retraite,\nSon chétif appareil pour la célébrité\nDu révérable jour de sa nativité, …"
                            },
                            {
                                "example_id": "df1c208f-74ee-48a6-ba15-afb94ded3f3b",
                                "sense_id": "04e71f92-aa52-3f5b-ba35-bbdffecaed1e",
                                "text": "Voilà, Madame, la vérité toute pure, & une partie des singularités de l’homme que vous révérez tant, parce que vous ne vous êtes jamais demandé s’il étoit révérable."
                            },
                            {
                                "example_id": "ca929a33-5050-4112-a2ee-07923e14a01a",
                                "sense_id": "04e71f92-aa52-3f5b-ba35-bbdffecaed1e",
                                "text": "Aussi, deviennent-ils de plus en plus rares les jeunes gens qui, une fois échappés de l’asile de jour, ouvert rue des Beaux-Arts, continuent les traditions de ces révérables maîtres."
                            }
                        ]
                    }
