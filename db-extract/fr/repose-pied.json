                                    {
                                        "sense_id": "301d067c-4cc5-3e38-bc07-9fb28c487ccd",
                                        "entry_id": "8a5f88cb-2a8a-3fca-8ff3-351082ca844e",
                                        "glosses": [
                                            "plank waarop men de voeten kan laten rusten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd6fd0a9-9e87-4981-93d0-edecb4a93a10",
                                                "sense_id": "301d067c-4cc5-3e38-bc07-9fb28c487ccd",
                                                "text": "Hij zag juffrouw Gonna aan de hals van haar moeder hangen, meester van Houten instappen ook, de koffer in de voetenplank beuren bij Nijs."
                                            },
                                            {
                                                "example_id": "3d23502c-aa97-42e7-b42e-3e2864488066",
                                                "sense_id": "301d067c-4cc5-3e38-bc07-9fb28c487ccd",
                                                "text": "De stoel mist wel wat persoonlijke dingen, zoals haar tassen, schapenvacht en de voetenplank is wat krom. Alsof vandalen er een plezierritje mee hebben gemaakt. Dat moet de politie uiteindelijk uitwijzen."
                                            },
                                            {
                                                "example_id": "7d9686b5-8be3-4c28-86b0-f44a0aa99991",
                                                "sense_id": "301d067c-4cc5-3e38-bc07-9fb28c487ccd",
                                                "text": "Omwonenden zagen dat de twee vrouwen met hun scootmobiel meermaals tegels meenamen. Ze legden de tegels op de voetenplank van de scootmobiel en reden ermee weg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
