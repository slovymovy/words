                ],
                "senses": [
                    {
                        "sense_id": "cff76832-2756-3a62-bd27-39a3b71e709a",
                        "entry_id": "21adeb83-7051-36fe-b218-e33c5841936a",
                        "glosses": [
                            "Person, die Englisch beherrscht und spricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5306294-8d6e-4f9c-b437-21187025c4e1",
                                "sense_id": "cff76832-2756-3a62-bd27-39a3b71e709a",
                                "text": "„Damit gibt man wieder, was tatsächlich im Sprachzentrum eines Englischsprechers vor sich geht.“"
                            },
                            {
                                "example_id": "8939a046-f380-4472-93a2-c955831071ec",
                                "sense_id": "cff76832-2756-3a62-bd27-39a3b71e709a",
                                "text": "„Die Niederländer sind die kompetentesten Englischsprecher der Welt, wie eine globale Studie über Englischkenntnisse ergab.“"
                            },
                            {
                                "example_id": "70390b9b-1cd9-4780-a083-986aefb5dcaf",
                                "sense_id": "cff76832-2756-3a62-bd27-39a3b71e709a",
                                "text": "„Ebenso wenig bedeutet es, dass Englischsprecher den Unterschied nicht ausdrücken können, falls sie das wünschen sollten.“"
                            },
                            {
                                "example_id": "8bd867c5-b711-413d-9465-223ff71a1467",
                                "sense_id": "cff76832-2756-3a62-bd27-39a3b71e709a",
                                "text": "„Am häufigsten nutzen Englischsprecher ihre Kenntnisse beruflich (41 Prozent; Französisch vier Prozent, Italienisch drei Prozent).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
