                    {
                        "translation_id": "c3adddac-58ec-4aa6-ba5c-50d542bd3959",
                        "source_entry_id": "48c2dbd0-f557-3dc4-84da-29f7272e61ac",
                        "source_sense_id": "a966abca-4766-33bf-addf-7c7247d83d6d",
