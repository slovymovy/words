                        "source_entry_id": "5bbd2a29-40e1-379d-9841-5580fcc52c36",
                        "source_sense_id": "6894f9db-6605-3399-9df4-04e9418f1808",
                        "target_lang_word": "patentor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patentor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92dd7a59-4462-3394-9b06-b627b951ddd8",
                                        "entry_id": "34c58b8b-0309-3c14-a69c-25bf43019af2",
                                        "glosses": [
                                            "One who obtains a legal patent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "733a7f80-37a8-4c44-a743-646f58025172",
                                                "sense_id": "92dd7a59-4462-3394-9b06-b627b951ddd8",
                                                "text": "Among Japanese workers who had obtained patents, a \"super group\" of patentors was observable, with more than half of all patentors obtaining ten or more patents. In the United States, two-thirds of patentors had obtained only[…]"
                                            },
                                            {
                                                "example_id": "a60a3738-81ac-40ec-9096-17359f550984",
                                                "sense_id": "92dd7a59-4462-3394-9b06-b627b951ddd8",
                                                "text": "Single patentors patent over short spells (three years maximum) producing few patents. This group comprises 71 per cent of the sample (64 per cent in Geroski et al., 1997) and produced 1,146 patents per firm."
                                            },
                                            {
                                                "example_id": "e105f52a-d22b-4bff-b2e7-4bc2dc36f290",
                                                "sense_id": "92dd7a59-4462-3394-9b06-b627b951ddd8",
                                                "text": "At the application stage, the patentor typically submits a list of member countries where s/he intends to later employ the patent. At this stage and until the patent is granted, the patentor must pay renewal fees to the EPO."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "693d010e-6141-3214-ac92-c292967998fe",
                                        "entry_id": "34c58b8b-0309-3c14-a69c-25bf43019af2",
                                        "glosses": [
                                            "One who grants a legal patent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04a6f635-4bf6-4175-8fd6-d02fadb5bf8f",
                                                "sense_id": "693d010e-6141-3214-ac92-c292967998fe",
                                                "text": "In that case the whole question was, whether the patentee was entitled to the patent? In ours the whole question is, whether the State, the patentor, had any title to impart by patent?"
                                            },
                                            {
                                                "example_id": "a1e0d360-9837-4886-adaa-4300aa395f19",
                                                "sense_id": "693d010e-6141-3214-ac92-c292967998fe",
                                                "text": "Besides, this record shows that all the proceedings upon which the patent issued were entirely ex parte, and were binding upon no one except the patentor and patentee."
                                            },
                                            {
                                                "example_id": "def21b96-b443-4eed-b383-ceb51112d44a",
                                                "sense_id": "693d010e-6141-3214-ac92-c292967998fe",
                                                "text": "That God must be both the patentee and patentor follows from the fact that what is created cannot assume the role of patentor. The creature, subject of patent, will always be subordinate to its creator (Isaiah 29: 16, 45:9;[…])"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
