                ],
                "senses": [
                    {
                        "sense_id": "1212ea60-2caa-3c99-af2e-30b1e896a04e",
                        "entry_id": "350ddb18-4ab5-3041-b77f-35d400d44a2f",
                        "glosses": [
                            "wartość wielkości (np. czasu, kąta) nastawiona z góry w danym urządzeniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d893064d-7c20-460e-a0ac-8d9584144136",
                                "sense_id": "1212ea60-2caa-3c99-af2e-30b1e896a04e",
                                "text": "W przypadku silnika z zapłonem samoczynnym, przy ustalonej nastawie pompy wtryskowej, w czasie każdego suwu ssania do cylindra jest doprowadzana ta sama dawka paliwa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ad59b1c6-35d7-3555-969a-dd4f82df3911",
                        "entry_id": "350ddb18-4ab5-3041-b77f-35d400d44a2f",
                        "glosses": [
                            "zob. nastawa ołtarzowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4383eb90-0cfb-4a9c-a53a-8ad14b020260",
                                "sense_id": "ad59b1c6-35d7-3555-969a-dd4f82df3911",
                                "text": "Została ukończona stalowa konstrukcja za głównym ołtarzem, do której jest zamocowana cała nastawa drewniana oraz obraz Matki Bożej Wniebowziętej, naszej patronki, który powrócił na swoje miejsce"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "301ac48e-2c59-32c8-960d-f4093ff76fb8",
                        "entry_id": "350ddb18-4ab5-3041-b77f-35d400d44a2f",
                        "glosses": [
                            "określona ilość miodu z pasieki, oddawana przez bartników do starostwa bartnego albo do dworu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
