                "senses": [
                    {
                        "sense_id": "10329acf-002e-3cd6-ac9b-fe69d4d826a0",
                        "entry_id": "dff96612-4798-3b89-8370-097a08ee9acd",
                        "glosses": [
                            "Réinscrire au crédit d’un compte une somme qui a été débitée."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "030806f1-f4f0-4221-ad48-98f2559fa63a",
                                "sense_id": "10329acf-002e-3cd6-ac9b-fe69d4d826a0",
                                "text": "Mon compte il faut me le rebiter tout de suite…S’agit pas que de débiter ! Faut rebiter, et vite !"
                            },
                            {
                                "example_id": "74d2ba77-e94c-45a6-9b0e-0aebdf421792",
                                "sense_id": "10329acf-002e-3cd6-ac9b-fe69d4d826a0",
                                "text": "Lucienne : J'comprends pas ! Sur mon rel'vé d'banque, mon compte est débiteur !...\nGisèle : — Maintenant qu'vous allez recevoir vot'pension, ils vont vous l'rebiter !"
                            }
                        ]
                    }
