                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "corset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "771beabf-c1d1-3a83-b507-b7c8ecfe4d90",
                                        "entry_id": "c64d3d81-87a0-37c0-b3fc-1012f101de45",
                                        "glosses": [
                                            "To enclose in a corset; to wear a corset."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "120c2bbe-bd24-40e6-be3d-6f8b3e0a76a2",
                                                "sense_id": "771beabf-c1d1-3a83-b507-b7c8ecfe4d90",
                                                "text": "Mabel dreaded the upcoming ball and the preliminary corseting it would entail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6cb9c7c-3a64-39b6-addb-b67ee4865b2d",
                                        "entry_id": "c64d3d81-87a0-37c0-b3fc-1012f101de45",
                                        "glosses": [
                                            "To restrict or confine."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f78dfb8-2ea6-4229-864a-d70aa2b5b0d2",
                                                "sense_id": "e6cb9c7c-3a64-39b6-addb-b67ee4865b2d",
                                                "text": "I will not remain corseted by your notions of what is and is not proper!"
                                            },
                                            {
                                                "example_id": "1e44bdef-a0d5-4cd0-beb8-641a852321fd",
                                                "sense_id": "e6cb9c7c-3a64-39b6-addb-b67ee4865b2d",
                                                "text": "They were trying to free the lives of women of all sexualities and genders that were tightly corseted by lack of basic social and economic rights."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0566820-f010-4aa5-915d-26461e23fd0a",
                        "source_entry_id": "bfb5d02f-88b4-33d1-9c9a-77c27f24ae75",
                        "source_sense_id": "ebe4ac4e-f932-3855-ae4f-d47d3ca05c90",
                        "target_lang_word": "corset",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corset",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8e898bb-c65c-363e-8b4d-869b15d5254f",
                                        "entry_id": "0893d149-a42e-3c44-a1a8-ad6b940cdd92",
                                        "glosses": [
                                            "Vêtement militaire en cuir ou en acier destiné à protéger le thorax."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "928f0a14-f638-4371-8c68-9329d239d095",
                                                "sense_id": "a8e898bb-c65c-363e-8b4d-869b15d5254f",
                                                "text": "Ces nobles si hautains étaient-ils plus braves sous leurs corsets et leurs casques de fer, à l’épreuve de la flèche et de la lance, que ces paysans armés d’un bâton ou d’un fauchar, exposés demi-nus à la charge de ces centaures de bronze ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20ddcabc-3165-3179-b8f6-854e598ec5c5",
                                        "entry_id": "0893d149-a42e-3c44-a1a8-ad6b940cdd92",
                                        "glosses": [
                                            "Sous-vêtement baleiné et lacé, destiné à soutenir la poitrine, à serrer la taille et le ventre, à maintenir les bas et qui se mettait d’ordinaire sous le corsage ou la chemise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b486510-e4bf-4158-b30b-b27d08c6e3a5",
                                                "sense_id": "20ddcabc-3165-3179-b8f6-854e598ec5c5",
                                                "text": "Sa taille, souple sans être frêle, n’effrayait pas la Maternité comme celle de ces jeunes filles qui demandent des succès à la morbide pression d’un corset."
                                            },
                                            {
                                                "example_id": "19276a3e-8f59-4f44-a3db-44da75779280",
                                                "sense_id": "20ddcabc-3165-3179-b8f6-854e598ec5c5",
                                                "text": "Quand elle achetait soit des corsets, soit des peignoirs, soit des pantalons, elle voulait toujours que ce fût moi qui passasse avec elle dans la chambre au fond et qui les lui essayasse."
                                            },
                                            {
                                                "example_id": "083dcb2a-9aec-43ca-b66e-3d927daa89af",
                                                "sense_id": "20ddcabc-3165-3179-b8f6-854e598ec5c5",
                                                "text": "Les baleines de son corset marquaient sur l’étoffe tendue du corsage."
                                            },
                                            {
                                                "example_id": "b898ca4b-3022-4886-8ff4-9350ba44f4c8",
                                                "sense_id": "20ddcabc-3165-3179-b8f6-854e598ec5c5",
                                                "text": "C’était une femme de trente-six ans environ, forte en chair, épanouie et réjouissante à voir. Elle respirait avec peine, étranglée violemment par l’étreinte de son corset trop serré ; et la pression de cette machine rejetait jusque dans son double menton la masse fluctuante de sa poitrine surabondante."
                                            },
                                            {
                                                "example_id": "0d698cbd-2754-44e4-887f-39a0fd14f4a8",
                                                "sense_id": "20ddcabc-3165-3179-b8f6-854e598ec5c5",
                                                "text": "Elle met son corset, ses jarretelles, son pantalon, son jupon."
                                            },
                                            {
                                                "example_id": "f06a546a-20f9-464b-b84d-bb5a5b508661",
                                                "sense_id": "20ddcabc-3165-3179-b8f6-854e598ec5c5",
                                                "text": "Les premiers tramways électriques traînaient des remorques pleines d’une humanité débraillée et sans cols, où les corsets dégrafés faisaient aux femmes un dos bossu."
                                            },
                                            {
                                                "example_id": "ed8b5921-58ce-4082-8274-f3a8a6272379",
                                                "sense_id": "20ddcabc-3165-3179-b8f6-854e598ec5c5",
                                                "text": "Là où, par exemple, on tient à mettre en valeur les caractères gynoïdes de la taille et du bassin (comme dans la littérature au tournant du XXᵉ siècle), on va privilégier les vertugadins, les crinolines, les tournures et les corsets, lesquels vont finir par reconfigurer les corps en retour."
                                            },
                                            {
                                                "example_id": "d358b1f7-fd91-4cfa-abd9-bdf88ab5a5fe",
                                                "sense_id": "20ddcabc-3165-3179-b8f6-854e598ec5c5",
                                                "text": "La guerre de 14 donna le coup de grâce au corset, les femmes le rangèrent au fond de leur armoire, il n’en sortit que pour devenir pièce de musée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3a31db3-bbe0-348b-95fc-95db19787457",
                                        "entry_id": "0893d149-a42e-3c44-a1a8-ad6b940cdd92",
                                        "glosses": [
                                            "Corsage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d39f6b-46f1-4def-ab86-812f924f078b",
                                                "sense_id": "e3a31db3-bbe0-348b-95fc-95db19787457",
                                                "text": ". – Coupez son corset ! faites-lui boire de l’eau tiède ; si c’est du poison, il faut de l’eau tiède."
                                            },
                                            {
                                                "example_id": "4c5de4e1-0392-4b69-aa2b-44d9656b39a4",
                                                "sense_id": "e3a31db3-bbe0-348b-95fc-95db19787457",
                                                "text": "Sous Charles V, le nom de corset désignait des vêtements divers pouvant tous se ramener à un corsage lacé."
                                            },
                                            {
                                                "example_id": "2b42b2d1-1a3a-4548-a0c9-f095a9c86215",
                                                "sense_id": "e3a31db3-bbe0-348b-95fc-95db19787457",
                                                "text": "Corset à fleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "970d95a1-ae8e-362f-8421-ba743ecac68b",
                                        "entry_id": "0893d149-a42e-3c44-a1a8-ad6b940cdd92",
                                        "glosses": [
                                            "Soutien, armature, maintien, renforcement, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04c966fc-3eb5-4595-9c2e-ecc9a32e1055",
                                                "sense_id": "970d95a1-ae8e-362f-8421-ba743ecac68b",
                                                "text": "La discipline est un corset plus sûr que la bonne volonté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdb3bec7-acfb-3614-af5e-ae67d8c9ee9f",
                                        "entry_id": "0893d149-a42e-3c44-a1a8-ad6b940cdd92",
                                        "glosses": [
                                            "Protection de quelque chose de fragile et précieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7f19a65-2bb8-481b-b9c6-901956269813",
                                                "sense_id": "fdb3bec7-acfb-3614-af5e-ae67d8c9ee9f",
                                                "text": "La feuille hier encore pliée\nDans son étroit corset d’hiver\nMet sur la branche déliée\nLes premières touches de vert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa2a6e66-6c3d-3b7f-84fb-82eb4d547161",
                                        "entry_id": "0893d149-a42e-3c44-a1a8-ad6b940cdd92",
                                        "glosses": [
                                            "Ensemble de règles limitatives."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "829ed4cb-42c6-4d70-a530-28e917efe1af",
                                                "sense_id": "aa2a6e66-6c3d-3b7f-84fb-82eb4d547161",
                                                "text": "Ceci impliquait de renforcer le corset administratif et réglementaire (30 règlements, 150 édits) […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38733427-3570-30d8-bddc-3a920e47fb0b",
                                        "entry_id": "0893d149-a42e-3c44-a1a8-ad6b940cdd92",
                                        "glosses": [
                                            "Bandage qui entoure le tronc et le soutien fermement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58735cf6-b538-4884-8405-5de305cb8f59",
                                                "sense_id": "38733427-3570-30d8-bddc-3a920e47fb0b",
                                                "text": "Corset de redressement."
                                            },
                                            {
                                                "example_id": "f286f07f-ecca-474b-900d-d2e23fec007f",
                                                "sense_id": "38733427-3570-30d8-bddc-3a920e47fb0b",
                                                "text": "Corset de maintien : Appareil en métal, en matière plastique ou en cuir, utilisé dans le traitement des déviations vertébrales."
                                            }
                                        ]
                                    },
