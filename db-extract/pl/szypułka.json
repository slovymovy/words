                                            {
                                                "example_id": "82357215-3156-421e-9cb1-4a09105ef587",
                                                "sense_id": "c2b51982-f60a-32e5-b0fe-471e5f11af2a",
                                                "text": "Water flux through the pedicel could also be involved in tomato fruit CC.^([cuticle cracking])"
