                "senses": [
                    {
                        "sense_id": "946906c0-eff6-35ee-bb66-4298b414e261",
                        "entry_id": "12c28eb0-76aa-3992-8c25-2fd97986e8e3",
                        "glosses": [
                            "christlicher Feiertag am Montag des Osterfestes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68a1fc3a-6ff1-4d4a-8266-9de6521faf28",
                                "sense_id": "946906c0-eff6-35ee-bb66-4298b414e261",
                                "text": "Am Ostermontag machten sie einen Spaziergang durch den Wald."
                            },
                            {
                                "example_id": "ae70f59b-3223-4866-a294-fb72b09eef34",
                                "sense_id": "946906c0-eff6-35ee-bb66-4298b414e261",
                                "text": "„Am Morgen des Ostermontag übergab mir ein Mann eine Vorladung zur Polizei.“"
                            },
                            {
                                "example_id": "a3107bb8-82d1-48a6-920b-430ffe810ca6",
                                "sense_id": "946906c0-eff6-35ee-bb66-4298b414e261",
                                "text": "„Denn Kristín hatte recht, das Unwetter würde früher eintreffen als erwartet, nämlich schon am Ostermontag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
