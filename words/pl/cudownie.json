{
    "word_family": [
        "cud",
        "cudowny",
        "cudo"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7b8c5e1e-393a-3f59-9ae9-2974b8232421",
                    "sense_definition": "w sposób godny podziwu, zachwycająco, niezwykle; bardzo dobrze",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja babcia gotuje <w>cudownie</w>, dlatego uwielbiam jej niedzielne obiady.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка готовит <w>чудесно</w>, поэтому я обожаю её воскресные обеды.",
                                "en": "My grandmother cooks <w>wonderfully</w>, which is why I love her Sunday dinners."
                            }
                        },
                        {
                            "text": "Na wakacjach bawiliśmy się <w>cudownie</w> i wcale nie chcieliśmy wracać do domu.",
                            "target_lang_translations": {
                                "ru": "В отпуске мы <w>чудесно</w> провели время и совсем не хотели возвращаться домой.",
                                "en": "We had a <w>wonderful</w> time on vacation and didn't want to go home at all."
                            }
                        }
                    ],
                    "synonyms": [
                        "wspaniale",
                        "fantastycznie",
                        "zachwycająco"
                    ],
                    "common_phrases": [
                        "wyglądać cudownie",
                        "czuć się cudownie",
                        "pachnieć cudownie"
                    ],
                    "target_lang_definitions": {
                        "ru": "восхитительно, необыкновенно; очень хорошо",
                        "en": "In a way that is admirable, delightful, or extremely good."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудесно",
                                "target_lang_sense_clarification": "очень хорошо, восхитительно"
                            },
                            {
                                "target_lang_word": "прекрасно",
                                "target_lang_sense_clarification": "великолепно"
                            },
                            {
                                "target_lang_word": "замечательно",
                                "target_lang_sense_clarification": "отлично"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "wonderfully",
                                "target_lang_sense_clarification": "in an excellent or delightful manner"
                            },
                            {
                                "target_lang_word": "marvellously",
                                "target_lang_sense_clarification": "in a way that is very good or impressive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48982a7e-44e6-3e2d-8f2b-24a9f49f65aa",
                    "sense_definition": "w sposób nadprzyrodzony, niewytłumaczalny, jak za sprawą cudu",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pasażerowie tego samolotu <w>cudownie</w> ocaleli z groźnego wypadku.",
                            "target_lang_translations": {
                                "ru": "Пассажиры этого самолета <w>чудом</w> спаслись в серьезной аварии.",
                                "en": "The passengers of that plane <w>miraculously</w> survived the dangerous accident."
                            }
                        },
                        {
                            "text": "Zaginiony w górach turysta odnalazł się <w>cudownie</w> po kilku dniach poszukiwań.",
                            "target_lang_translations": {
                                "ru": "Пропавший в горах турист <w>чудесным образом</w> нашелся после нескольких дней поисков.",
                                "en": "The tourist lost in the mountains was <w>miraculously</w> found after several days of searching."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cudownie ocalony",
                        "cudownie uzdrowiony"
                    ],
                    "target_lang_definitions": {
                        "ru": "сверхъестественным образом, необъяснимо, словно чудом",
                        "en": "In a supernatural or inexplicable way, as if by a miracle."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудом",
                                "target_lang_sense_clarification": "благодаря счастливому случаю"
                            },
                            {
                                "target_lang_word": "чудесным образом",
                                "target_lang_sense_clarification": "необъяснимо, как чудо"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "miraculously",
                                "target_lang_sense_clarification": "in a way that is unexpected and fortunate, as if by a miracle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
