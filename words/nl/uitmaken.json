{
    "word_family": [
        "uitmaking",
        "maken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d943599f-c4bd-32fb-8e1e-9f0946d386da",
                    "sense_definition": "van belang zijn of een verschil maken (vaak gebruikt met 'het')",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "belang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>maakt</w> niet <w>uit</w> welke kleur je kiest voor de muren.",
                            "target_lang_translations": {
                                "en": "It doesn't <w>matter</w> which color you choose for the walls."
                            }
                        },
                        {
                            "text": "Zou het veel <w>uitmaken</w> als we een uurtje later vertrekken?",
                            "target_lang_translations": {
                                "en": "Would it <w>make a difference</w> if we leave an hour later?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "het maakt niet uit",
                        "niets uitmaken",
                        "veel uitmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to be of importance or to make a difference (often used with 'it')"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "matter",
                                "target_lang_sense_clarification": "to be important"
                            },
                            {
                                "target_lang_word": "make a difference",
                                "target_lang_sense_clarification": "to have an effect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "492d9049-5d10-3f8f-b2a8-2a9971b6c322",
                    "sense_definition": "een liefdesrelatie beëindigen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft het gisteren na drie jaar met hem <w>uitgemaakt</w>.",
                            "target_lang_translations": {
                                "en": "She <w>broke up</w> with him yesterday after three years."
                            }
                        },
                        {
                            "text": "Ik vind het lastig om het <w>uit</w> te <w>maken</w> via een berichtje.",
                            "target_lang_translations": {
                                "en": "I find it difficult to <w>end it</w> via a text message."
                            }
                        }
                    ],
                    "synonyms": [
                        "beëindigen"
                    ],
                    "antonyms": [
                        "aanmaken"
                    ],
                    "common_phrases": [
                        "het uitmaken met",
                        "verkering uitmaken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt met 'het'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to end a romantic relationship"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break up",
                                "target_lang_sense_clarification": "ending a relationship"
                            },
                            {
                                "target_lang_word": "end it",
                                "target_lang_sense_clarification": "terminating a romance"
                            },
                            {
                                "target_lang_word": "call it quits",
                                "target_lang_sense_clarification": "informal ending of a relationship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "045dff92-e7e7-36bd-9795-41c21b5b4e0c",
                    "sense_definition": "een onderdeel of component zijn van een groter geheel",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "onderdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze hoofdstukken <w>maken</w> deel <w>uit</w> van zijn nieuwe boek.",
                            "target_lang_translations": {
                                "en": "These chapters <w>are part</w> of his new book."
                            }
                        },
                        {
                            "text": "Vrijwilligers <w>maken</w> een belangrijk deel <w>uit</w> van onze organisatie.",
                            "target_lang_translations": {
                                "en": "Volunteers <w>constitute</w> an important part of our organization."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deel uitmaken van"
                    ],
                    "target_lang_definitions": {
                        "en": "to be a part or component of a larger whole"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be part of",
                                "target_lang_sense_clarification": "forming a component"
                            },
                            {
                                "target_lang_word": "constitute",
                                "target_lang_sense_clarification": "to make up a whole"
                            },
                            {
                                "target_lang_word": "comprise",
                                "target_lang_sense_clarification": "to consist of"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e27a3f1-b276-3022-816e-a57cc3125ec1",
                    "sense_definition": "een definitieve beslissing nemen over iets",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beslissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter zal uiteindelijk <w>uitmaken</w> wie er schuldig is.",
                            "target_lang_translations": {
                                "en": "The judge will ultimately <w>decide</w> who is guilty."
                            }
                        },
                        {
                            "text": "We moeten nu <w>uitmaken</w> welke strategie we gaan volgen.",
                            "target_lang_translations": {
                                "en": "We must now <w>determine</w> which strategy we are going to follow."
                            }
                        }
                    ],
                    "synonyms": [
                        "beslissen"
                    ],
                    "common_phrases": [
                        "zelf uitmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a final decision about something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "decide",
                                "target_lang_sense_clarification": "to make a judgment"
                            },
                            {
                                "target_lang_word": "determine",
                                "target_lang_sense_clarification": "to establish exactly"
                            },
                            {
                                "target_lang_word": "settle",
                                "target_lang_sense_clarification": "to resolve a dispute or matter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4763814-8458-3ff1-9993-11b0e6695b16",
                    "sense_definition": "iemand op een beledigende manier benoemen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beledigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>maakte</w> de scheidsrechter <w>uit</w> voor alles wat lelijk was.",
                            "target_lang_translations": {
                                "en": "He <w>called</w> the referee every <w>name</w> in the book."
                            }
                        },
                        {
                            "text": "Je mag me niet voor leugenaar <w>uitmaken</w> zonder bewijs.",
                            "target_lang_translations": {
                                "en": "You cannot <w>label</w> me a liar without proof."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand uitmaken voor"
                    ],
                    "target_lang_definitions": {
                        "en": "to call someone by an insulting name"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "call names",
                                "target_lang_sense_clarification": "to use insulting epithets"
                            },
                            {
                                "target_lang_word": "label",
                                "target_lang_sense_clarification": "to describe as something negative"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35eb89c3-1967-3bff-a873-2aa486b6f689",
                    "sense_definition": "een vuur of licht laten stoppen met branden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "doven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet om de kaarsen <w>uit</w> te <w>maken</w> voor je gaat slapen.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>put out</w> the candles before you go to sleep."
                            }
                        },
                        {
                            "text": "De brandweer probeerde het grote vuur snel <w>uit</w> te <w>maken</w>.",
                            "target_lang_translations": {
                                "en": "The fire department tried to <w>extinguish</w> the large fire quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "doven"
                    ],
                    "antonyms": [
                        "aansteken"
                    ],
                    "common_phrases": [
                        "het vuur uitmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause a fire or light to stop burning"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "put out",
                                "target_lang_sense_clarification": "extinguishing a fire"
                            },
                            {
                                "target_lang_word": "extinguish",
                                "target_lang_sense_clarification": "formal term for stopping a fire"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
