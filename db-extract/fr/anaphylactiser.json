                "senses": [
                    {
                        "sense_id": "935afcd3-9ed5-3739-9b3b-80f8214ec599",
                        "entry_id": "dcec2fb4-9497-3d18-8653-824582c8223b",
                        "glosses": [
                            "Sensibiliser en rendant possible un choc anaphylactique lié à un antigène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77d44ce7-fc48-4b50-b857-5d10cf5b9701",
                                "sense_id": "935afcd3-9ed5-3739-9b3b-80f8214ec599",
                                "text": "En résumé, qu’il s’agisse de lait ou qu’il s’agisse d’œufs, l’ingestion peut permettre d’anaphylactiser les animaux, mais c’est l’injection et non l’ingestion qui déclenche le choc anaphylactique."
                            },
                            {
                                "example_id": "91bd12ec-2a30-4a52-9126-14e9933bfc5c",
                                "sense_id": "935afcd3-9ed5-3739-9b3b-80f8214ec599",
                                "text": "En prenant certaines précautions, il est possible d’anaphylactiser le fœtus in utero sans anaphylactiser la mère."
                            },
                            {
                                "example_id": "5d8dd970-e7b3-48f1-8416-13166303350b",
                                "sense_id": "935afcd3-9ed5-3739-9b3b-80f8214ec599",
                                "text": "Il est démontré que la cellule microbienne peut s’anaphylactiser, se sensibiliser."
                            }
                        ]
                    }
                ],
