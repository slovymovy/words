{
    "word_family": [
        "enlistment",
        "enlistee"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f2532c5-fdb4-3525-92b3-c5e2e82b0732",
                    "sense_definition": "To voluntarily join a cause or organization, especially military service.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "join_organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young people choose to <w>enlist</w> in the army after finishing high school."
                        },
                        {
                            "text": "He decided to <w>enlist</w> in the navy to see the world and gain experience."
                        }
                    ],
                    "synonyms": [
                        "enroll",
                        "induct"
                    ],
                    "antonyms": [
                        "disenroll"
                    ],
                    "common_phrases": [
                        "enlist in the army",
                        "enlist in the navy"
                    ]
                },
                {
                    "sense_id": "5ac414cf-b9bd-33e8-97f0-418a5a74563e",
                    "sense_definition": "To recruit the aid or membership of others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity hopes to <w>enlist</w> more volunteers to help with the local food drive."
                        },
                        {
                            "text": "We need to <w>enlist</w> the help of an expert to solve this complex problem."
                        }
                    ],
                    "synonyms": [
                        "enroll"
                    ],
                    "common_phrases": [
                        "enlist help",
                        "enlist support"
                    ]
                },
                {
                    "sense_id": "8c77d7a5-c303-3c9d-aa00-812c34a7a3eb",
                    "sense_definition": "To secure or obtain something, such as support or cooperation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "recruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They managed to <w>enlist</w> the government's support for their new environmental project."
                        },
                        {
                            "text": "She tried to <w>enlist</w> the cooperation of her colleagues to finish the report on time."
                        }
                    ],
                    "common_phrases": [
                        "enlist support",
                        "enlist cooperation"
                    ]
                },
                {
                    "sense_id": "5c10df03-97da-3a10-8cae-c83838ba99d7",
                    "sense_definition": "To enter a name on a list or register.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "list",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clerk will <w>enlist</w> your name in the official record of attendees."
                        },
                        {
                            "text": "Please <w>enlist</w> all the items you intend to sell in the inventory document."
                        }
                    ],
                    "synonyms": [
                        "catalogue",
                        "enroll",
                        "register",
                        "tabulate"
                    ],
                    "antonyms": [
                        "delist",
                        "deregister",
                        "unlist",
                        "unregister"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b26768b6-f6fa-352f-9b33-321254a786a9",
                    "sense_definition": "A person who is enlisted, usually in a military service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "join_organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The base commander held a meeting specifically for the new <w>enlists</w>."
                        },
                        {
                            "text": "Training programs for <w>enlists</w> are designed to build discipline and physical strength."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Rarely used as a noun; usually 'enlisted person' or 'enlistee' is preferred."
                        }
                    ]
                }
            ]
        }
    ]
}