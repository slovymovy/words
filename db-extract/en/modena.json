                        "cross_references": [
                            {
                                "target_word": "Modena",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "751245e3-2652-3a8b-99c7-6c3113dbb10c",
                                        "entry_id": "44217f08-9575-38fd-909e-6f373d940b69",
                                        "glosses": [
                                            "miasto i gmina we Włoszech, w regionie Emilia-Romania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e5932d-8ae4-44f4-b219-82cba7c77dda",
                                                "sense_id": "751245e3-2652-3a8b-99c7-6c3113dbb10c",
                                                "text": "Modena była wówczas jedynym miastem we Włoszech, w którym partia komunistyczna miała bezwzględną większość w radzie miejskiej, komuniści więc rządzili miastem z burmistrzem Rubensem Trivą na czele"
                                            },
                                            {
                                                "example_id": "0bd64b6f-46fc-4cca-87c1-a17ed4455988",
                                                "sense_id": "751245e3-2652-3a8b-99c7-6c3113dbb10c",
                                                "text": "W walce gwelfów z gibelinami Modena była po stronie zwolenników cesarza i walczyła z odległą o 40 km Bolonią. Bolońscy gwelfowie zwyciężyli w roku 1249 i Modena poddała się markizowi Ferrary Obizzo II d'Este. Jego następca, Obizzo III, przeniósł się do Modeny z całym dworem i tak zaczęło się panowanie książąt d'Este, które trwało aż do 1796 r."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
