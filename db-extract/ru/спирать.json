                        "examples": [
                            {
                                "example_id": "8f5ea484-4deb-41a4-80b8-e15b33403ff5",
                                "sense_id": "71648755-2b93-3811-b259-32a47bf01198",
                                "text": "А песни тут ни при чём. Говорила я тебе два года назад ― не бросай Веру, но ты не послушал. У тебя ветер свистел в голове. И нечего теперь спирать на эти песни. Как были дерьмом, так дерьмом и остались."
                            }
