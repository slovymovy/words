                        "glosses": [
                            "The state or quality of being luxuriant."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d9f1691c-41d3-425c-9a29-405c1fb26d16",
                                "sense_id": "caf1ccc6-e9e3-388a-af39-aa96af5583af",
                                "text": "He had depleted himself, and yet his love grew daily, and reveled in the luxuriantness of having given all today and finding still that it had all to give again to-morrow."
                            },
                            {
                                "example_id": "7e94973c-0416-42b9-88bf-126896bb2562",
                                "sense_id": "caf1ccc6-e9e3-388a-af39-aa96af5583af",
                                "text": "The garden by May 5 had increased in size and luxuriantness as a result of the farine used."
                            },
                            {
                                "example_id": "eecab292-a780-4c0a-ae2f-26b62bef9592",
                                "sense_id": "caf1ccc6-e9e3-388a-af39-aa96af5583af",
                                "text": "They have a different luxuriantness."
                            }
                        ]
                    }
