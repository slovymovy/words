                ],
                "translations": [
                    {
                        "translation_id": "b686c08d-9fff-4bb7-a720-3bcd49a2dd93",
                        "source_entry_id": "fb0d7b46-f8a8-362a-adb6-3b559af283fd",
                        "source_sense_id": "a896dd02-50d6-3f7a-b6e7-df7f38eba1d8",
                        "source_sense_description": "talreep",
                        "target_lang_word": "lanyard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lanyard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac0ff8c0-0a8a-3544-b283-234b617f3928",
                                        "entry_id": "8bddd6ad-34f1-33df-8f4a-a553516c7e69",
                                        "glosses": [
                                            "A short rope used for fastening rigging, as a handle, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0389f9a7-f2c2-4e04-80ce-496b30958947",
                                                "sense_id": "ac0ff8c0-0a8a-3544-b283-234b617f3928",
                                                "text": "\"Take ahold here, an' keep ringin' steady,\" said Dan, passing Harvey the lanyard of a bell that hung just behind the windlass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eb66bc7-aec2-3829-8eec-8b37aaee74da",
                                        "entry_id": "8bddd6ad-34f1-33df-8f4a-a553516c7e69",
                                        "glosses": [
                                            "A cord worn around the neck, shoulder, or wrist which is attached to a small object to be carried such as an identity card or security pass, key, knife, or whistle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507cdb8c-2122-4498-8094-4e3ba7efbeaa",
                                                "sense_id": "4eb66bc7-aec2-3829-8eec-8b37aaee74da",
                                                "text": "Aboard ship he carried his crutch by a lanyard round his neck, to have both hands as free as possible. [...] [H]e would hand himself from one place to another, now using the crutch, now trailing it alongside by the lanyard, as quickly as another man could walk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05ed63f8-3cac-3759-b8b4-b86367bb53d0",
                                        "entry_id": "8bddd6ad-34f1-33df-8f4a-a553516c7e69",
                                        "glosses": [
                                            "A craft activity done by intricately braiding thin colored plastic lines to make patterns, or the product of such a craft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e56fb9-c328-420c-a01b-8cd8c350fc9c",
                                                "sense_id": "05ed63f8-3cac-3759-b8b4-b86367bb53d0",
                                                "text": "It's lanyard. It's a camp tradition. You'll have about a million lanyard key chains by the time the summer is over."
                                            },
                                            {
                                                "example_id": "9088b7ff-3a83-4db9-9bbe-42245a4e2aa5",
                                                "sense_id": "05ed63f8-3cac-3759-b8b4-b86367bb53d0",
                                                "text": "A few lousy days at Camp Minnehaha spent extracting oar splinters from your palms and taking group lanyard lessons under the full noonday sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40a3ae2f-1126-39af-8099-8ea5932469fb",
                                        "entry_id": "8bddd6ad-34f1-33df-8f4a-a553516c7e69",
                                        "glosses": [
                                            "A cord with a hook which is secured to an artillery piece, and pulled to fire the weapon."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf15fa8c-5ea5-4f13-b73d-5635e00f67fa",
                        "source_entry_id": "fb0d7b46-f8a8-362a-adb6-3b559af283fd",
                        "source_sense_id": "a896dd02-50d6-3f7a-b6e7-df7f38eba1d8",
                        "source_sense_description": "talreep",
                        "target_lang_word": "ride",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ride",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07517b2c-0f84-36f5-8cc8-be93fb517fb2",
                                        "entry_id": "2dfc1fdf-fe07-30e4-8ce4-f30a0b25bb59",
                                        "glosses": [
                                            "Pli de la peau qui se produit sur le visage, sur les mains, et qui est ordinairement l’effet de l’âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe82078-a060-45fc-895b-330e3a30cd3d",
                                                "sense_id": "07517b2c-0f84-36f5-8cc8-be93fb517fb2",
                                                "text": "La fatigue et les misères sans nombre de sa dure profession avaient creusé sur son visage un réseau de rides inextricables qui le faisaient paraître beaucoup plus vieux qu’il n’était en réalité."
                                            },
                                            {
                                                "example_id": "d1629cf3-8f57-462b-b535-43fbb2694a1d",
                                                "sense_id": "07517b2c-0f84-36f5-8cc8-be93fb517fb2",
                                                "text": "Sa figure osseuse et blême était sillonnée de rides profondes imitant le dessin des fleuves et canaux sur une carte de Hollande."
                                            },
                                            {
                                                "example_id": "f3cbff2e-e1fa-464e-acb0-4f05991354ed",
                                                "sense_id": "07517b2c-0f84-36f5-8cc8-be93fb517fb2",
                                                "text": "Le vieux souriait, et, dans sa figure madrée, plissée de rides, creusée de sillons, embroussaillée de poils, ses petits yeux vifs et clignotants brillaient étrangement."
                                            },
                                            {
                                                "example_id": "472d9795-6016-4b12-a3b9-797cf8d73e2c",
                                                "sense_id": "07517b2c-0f84-36f5-8cc8-be93fb517fb2",
                                                "text": "Depuis qu’il avait vu Herbin perdre la semelle de son soulier dans le taxi, Bigua s’imaginait, bien que le prote fût maintenant habillé avec soin, qu’il pourrait laisser tomber à table une manchette, sa cravate, ou l’une de ses trois rides frontales."
                                            },
                                            {
                                                "example_id": "1a8f387c-aba2-41d2-84a0-eaca5864d892",
                                                "sense_id": "07517b2c-0f84-36f5-8cc8-be93fb517fb2",
                                                "text": "L’adolescent se tenait debout, son calot à la main. Il avait l'air songeur, préoccupé : une ride lui sillonnait douloureusement le front."
                                            },
                                            {
                                                "example_id": "ed58c70a-6ca4-4e50-a603-1ce773f1471d",
                                                "sense_id": "07517b2c-0f84-36f5-8cc8-be93fb517fb2",
                                                "text": "Les belles rides; il les a toutes : les barres transversales du front, les pattes d'oie, les plis amers de chaque côté de la bouche, sans compter les cordes jaunes qui pendent sous son menton."
                                            },
                                            {
                                                "example_id": "5bfe4bdd-8d6e-4ced-be5a-2923fb2bceea",
                                                "sense_id": "07517b2c-0f84-36f5-8cc8-be93fb517fb2",
                                                "text": "Elle avait quarante-six ans, mais ce bilan gardait sa pertinence. Rien n’avait vraiment changé depuis sa jeunesse sinon que des rides étroites et profondes avaient entrepris leurs fines œuvres sur son visage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca4bd672-1aec-3a3d-8b6d-26bf79319a87",
                                        "entry_id": "2dfc1fdf-fe07-30e4-8ce4-f30a0b25bb59",
                                        "glosses": [
                                            "Signe de vieillissement, de désuétude, flétrissement ou d’obsolescence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b675b408-89d6-4a52-b0de-067d7ff7f89e",
                                                "sense_id": "ca4bd672-1aec-3a3d-8b6d-26bf79319a87",
                                                "text": "'14 novembre 44' – Trois jours de suite à dire des phrases qui tombent sans faire une ride dans son cerveau, c’est un peu long."
                                            },
                                            {
                                                "example_id": "24f41ef7-9e2c-43d6-a601-ff8ff3666e79",
                                                "sense_id": "ca4bd672-1aec-3a3d-8b6d-26bf79319a87",
                                                "text": "Au goût qu’ils avaient l’un pour l’autre et au plaisir extrême qu’ils en tiraient était venue s’ajouter la confiance, la sécurité, l’amitié charnelles. Leur félicité n’avait pas une ride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce42b028-04b9-3d6e-a0b6-4f8936f8cf72",
                                        "entry_id": "2dfc1fdf-fe07-30e4-8ce4-f30a0b25bb59",
                                        "glosses": [
                                            "Petit pli qui apparaît à la surface d’un liquide, sous l’effet d’un souffle d’air."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38165f0a-ebf1-4cf3-9c8f-d6343bf49d00",
                                                "sense_id": "ce42b028-04b9-3d6e-a0b6-4f8936f8cf72",
                                                "text": "C’était l’été austral; le jeudi 19 novembre, je passai exactement sous le soleil à midi par un ciel sans nuages, sur un océan sans rides."
                                            },
                                            {
                                                "example_id": "9c8cd26d-a400-469d-9ed9-7bf7ce10ced9",
                                                "sense_id": "ce42b028-04b9-3d6e-a0b6-4f8936f8cf72",
                                                "text": "La friction du vent sous l’enveloppe produisait une série intermittente de rides et de petits claquements : on eût cru, en moins fort, le bruit du sillage à l’avant d’un bateau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f66ee87-870a-368e-9372-3fe209de0b63",
                                        "entry_id": "2dfc1fdf-fe07-30e4-8ce4-f30a0b25bb59",
                                        "glosses": [
                                            "Grand pli qu’offre un terrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef688d87-113e-444e-b691-f7d700b89dc6",
                                                "sense_id": "0f66ee87-870a-368e-9372-3fe209de0b63",
                                                "text": "Dans la vallée de la Houille, entre Flohimont et Malavisé, la série que nous avons décrite et qui est comprise entre les grès de Chooz et le schiste calcaire, est étroite; les rides sont profondes, les couches sont très-inclinées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38555609-dfaf-322b-add2-77fb14ea8d0d",
                                        "entry_id": "2dfc1fdf-fe07-30e4-8ce4-f30a0b25bb59",
                                        "glosses": [
                                            "Sorte de cordage servant à tendre les haubans sur un voilier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "300c4d12-95a8-4287-a791-8eda769dab54",
                                                "sense_id": "38555609-dfaf-322b-add2-77fb14ea8d0d",
                                                "text": "On frappe le minaouet sur le hauban qu'il faut roidir en le fouettant dessus ; ensuite on tourne la ride du hauban sur la traverse, & on la fixe avec un autre bois qui qui sert de levier, pour faire tourner la traverse, […]."
                                            }
                                        ]
                                    }
                                ]
