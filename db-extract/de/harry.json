                                "target_senses": [
                                    {
                                        "sense_id": "446507e5-6ffc-330b-9d17-8b4b8b03d740",
                                        "entry_id": "cb75f933-f790-3475-93ad-9c55a5866939",
                                        "glosses": [
                                            "A male given name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6d1202-90a8-44f1-829b-52cfdfec940b",
                                                "sense_id": "446507e5-6ffc-330b-9d17-8b4b8b03d740",
                                                "text": "Yet weep that Harry's dead, and so will I; / But Harry lives that shall convert those tears / By number into hours of happiness."
                                            },
                                            {
                                                "example_id": "d481c69d-095d-451f-bd39-f4263f69e48f",
                                                "sense_id": "446507e5-6ffc-330b-9d17-8b4b8b03d740",
                                                "text": "Henry now, what a soft swain your Henry is! the proper theme of gentle poesy; a name to fall in love withal; devoted at the font to song and sonnet, and the tender passion; a baptized inamorato; a christened hero. Call him Harry, and see how you ameliorate his condition. The man is free again, turned out of song and sonnet and romance, and young ladies' hearts. Shakspeare understood this well, when he wrote of prince Hal and Harry Hotspur. To have called them Henry would have spoiled both characters."
                                            },
                                            {
                                                "example_id": "e98864fa-2533-43eb-b351-f0d4bc0d1750",
                                                "sense_id": "446507e5-6ffc-330b-9d17-8b4b8b03d740",
                                                "text": "'I suppose you think I should call him Harry,' says Ruth.\n'Harry? No. Ever since Harry bloody Potter that's been a nightmare.[…]"
                                            },
                                            {
                                                "example_id": "21e4bc46-fce3-4b31-9ff6-da6643f0effa",
                                                "sense_id": "446507e5-6ffc-330b-9d17-8b4b8b03d740",
                                                "text": "The digital ads open over a shot of Senate Minority Leader Harry Reid and Chuck Schumer, the third-ranking Democrat in the Senate, while a narrator declares: “For years, it paralyzed Washington: Partisan political dysfunction.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8321ef2-d98a-36a0-9cb5-926d28758965",
                                        "entry_id": "cb75f933-f790-3475-93ad-9c55a5866939",
