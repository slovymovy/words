                        "sense_id": "a9c65e8b-a113-3202-8b8b-2322630ca600",
                        "entry_id": "f8cc8361-5b72-39e2-bb2b-a2ea5d9b4c23",
                        "glosses": [
                            "Ensemble des caractéristiques physiques qui définissent un individu ^([1]) grâce à la génétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c6c073-3566-49d0-9456-1a660d79b677",
                                "sense_id": "a9c65e8b-a113-3202-8b8b-2322630ca600",
                                "text": "Le morphotype laxe favorise les ruptures ligamentaires des articulations distales, type cheville."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d669aacf-6b5c-42bf-bb20-bf99b2788b4d",
                        "source_entry_id": "f8cc8361-5b72-39e2-bb2b-a2ea5d9b4c23",
                        "source_sense_id": "a9c65e8b-a113-3202-8b8b-2322630ca600",
                        "target_lang_word": "morphotype",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morphotype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0e8f058-4548-3534-8769-cd03f1d1e0d6",
                                        "entry_id": "b2f44927-f80a-37ab-8635-b76b04645c58",
                                        "glosses": [
                                            "Any of a group of different types of individuals of the same species in a population; a morph."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b37b2ac-c45b-4acd-b97e-02c13d24d70c",
                                                "sense_id": "c0e8f058-4548-3534-8769-cd03f1d1e0d6",
                                                "text": "The morphotype, or form-print, must hereafter take its place by the side of the logotype or word-print."
                                            },
                                            {
                                                "example_id": "2681b5d8-227e-4572-8fb6-088d1f35068a",
                                                "sense_id": "c0e8f058-4548-3534-8769-cd03f1d1e0d6",
                                                "text": "As the first form of a dimorphic sex will be represented in the holotype or allotype, there may be some doubt as to the advisability of classing morphotypes among primary types."
                                            },
                                            {
                                                "example_id": "9de597ec-f58d-43ad-a28f-e9f6ff1ac823",
                                                "sense_id": "c0e8f058-4548-3534-8769-cd03f1d1e0d6",
                                                "text": "The only exception seems to be morphotype 2 (Scotiophryne), which is clearly defined by a prominent lamina that posteriorly delimits the oblique groove and, in the Utah samples, is stratigraphically restricted to the lower—middle Campanian."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "morphotype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52b6b251-6537-32ff-bbe5-f442899d9a68",
                                        "entry_id": "f7ca404a-36c6-3aff-8cc0-6cd2862472f9",
                                        "glosses": [
                                            "To sort into such types (and identify them)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d022a2-70ff-4cbb-b936-f1353c62573d",
                                                "sense_id": "52b6b251-6537-32ff-bbe5-f442899d9a68",
                                                "text": "Experiment 4 involved only morphotyping, and the results demonstrated the concentration-dependence of the subdivisions of morphotype 1."
                                            },
                                            {
                                                "example_id": "6919c4d9-580f-49fa-a655-11742828f4cf",
                                                "sense_id": "52b6b251-6537-32ff-bbe5-f442899d9a68",
                                                "text": "In a second phase, arriving seeds were left to accumulate in traps for eight months, at which time all seeds, fruits, and germinated seedlings in the traps were collected and \"morphotyped\" (separated into unidentified but recognizable species)."
                                            },
                                            {
                                                "example_id": "1265af7f-d3c2-44bf-b84d-2047b8b82cb9",
                                                "sense_id": "52b6b251-6537-32ff-bbe5-f442899d9a68",
                                                "text": "Galls when found were inspected for inducers, collected separately in plastic bags when an insect or mite was found and were provisionally morphotyped (for organ, shape, colour and host plant)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
