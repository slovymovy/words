                    {
                        "translation_id": "ae4a3968-402f-4597-ae3d-33c472ec360d",
                        "source_entry_id": "a90e05a9-2d70-3c72-804b-18f1429957e3",
                        "source_sense_id": "fd074434-e6f7-33c5-8e09-c06c4b2d19a2",
                        "source_sense_description": "een dode taal die in het huidige Turkije werd gesproken",
                        "target_lang_word": "hittite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hittite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bb90768-f8dc-3929-960f-f0be87c52ceb",
                                        "entry_id": "63bc8ffb-31b7-3a37-a496-c3558fe61a69",
                                        "glosses": [
                                            "Langue morte autrefois parlée par les Hittites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6de3629d-9e35-40a0-a76b-b4287f17834d",
                                                "sense_id": "2bb90768-f8dc-3929-960f-f0be87c52ceb",
                                                "text": "Le hittite, la plus ancienne langue indo-européenne connue à ce jour, est aussi celle qui présente le plus de particularités par rapport aux autres langues indo-européennes. Par cette situation spécifique, le hittite constitue une langue fondamentale dans la grammaire comparée des langues indo-européennes, […]."
                                            },
                                            {
                                                "example_id": "06ca5957-b494-45b3-b9d7-9f843db5d307",
                                                "sense_id": "2bb90768-f8dc-3929-960f-f0be87c52ceb",
                                                "text": "Le hittite représente la langue de l’empire hittite (fig. 2) qui existait en Asie mineure vers le milieu du 2ᵉ millénaire. Le hittite comprend, tout en offrant les traits essentiels de la structure indo-européenne, de nombreux éléments étrangers des premières populations non-indo-européennes d’Asie mineure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hittite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2bf149a-d725-3360-b42b-e2269848afe8",
                                        "entry_id": "f7fa5d07-670b-3a87-b87c-07087f46243a",
                                        "glosses": [
                                            "Relatif aux Hittites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fbb9532-b284-404b-88d8-ef836f6d9a2a",
                                                "sense_id": "a2bf149a-d725-3360-b42b-e2269848afe8",
                                                "text": "On peut considérer que ce monument est l'annonce publique de ce mariage royal entre le grand roi hittite et la reine d'origine hourrite. Cet événement va avoir des conséquences très importantes."
                                            },
                                            {
                                                "example_id": "5f18b575-46e5-4689-a596-13e35a74bf42",
                                                "sense_id": "a2bf149a-d725-3360-b42b-e2269848afe8",
                                                "text": "L’écriture cunéiforme hittite, une langue indo-européenne, fut déchiffrée en 1915 par Bartel Hrozny à partir des très nombreuses tablettes découvertes par Hugo Winkler […]. L’écriture hiéroglyphique hittite fit l'objet de longues tentatives de déchiffrement de Pietro Merigi (1927,1937), Ignace Gelb, Émile Forrer et Théodore Bossert, qui eut la chance de trouver à Karatepe, en 1947, une stèle bilingue phénicien/hittite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
