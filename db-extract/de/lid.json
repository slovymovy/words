                    {
                        "form_id": "c7c99c40-c94e-4172-a1b0-f934e5df64e8",
                        "entry_id": "01f8f441-be3b-38a1-9c1b-bcafb8c0de85",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Lid"
                    },
                    {
                        "form_id": "3865d259-b648-40b1-9a98-04df214b9411",
                        "entry_id": "01f8f441-be3b-38a1-9c1b-bcafb8c0de85",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lider"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                        "entry_id": "01f8f441-be3b-38a1-9c1b-bcafb8c0de85",
                        "glosses": [
                            "Haut zum Bedecken der Augen bei höheren Tieren und dem Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba9f9039-93cf-4fcc-86a5-8940daaaa8fe",
                                "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                "text": "Nur am Zucken ihrer Lider konnte man ihre Aufregung erkennen."
                            },
                            {
                                "example_id": "a5df8b8e-e694-4b67-a0e7-6fb0f23fed4c",
                                "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                "text": "„Sein Mund bewegte sich, und unter den geschlossenen Lidern rasten die Pupillen.“"
                            },
                            {
                                "example_id": "0a6f3c38-9207-48da-af5e-acfaa3a06220",
                                "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                "text": "„Die Augen hat er geschlossen, und sein Gesichtsausdruck verändert sich, als sähe er auf der Innenseite seiner Lider einen tragischen Film in Zeitraffer.“"
                            },
                            {
                                "example_id": "58556b21-e36e-4a3b-a631-fd9d8ae53e5b",
                                "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                "text": "„Ihre Lider hatten eine bläuliche Tönung, und die Augenbrauen schienen Schatten zu werfen, in denen ihre Augen noch tiefer wirkten als bei Tage.“"
                            },
                            {
                                "example_id": "e8510bf3-96fc-4119-b2ba-d05db93712cb",
                                "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                "text": "„Ihre Lider senken sich wie ein Vorhang vor ihre Augen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c62b2282-b9d0-4204-9314-c60a85d41214",
                        "source_entry_id": "01f8f441-be3b-38a1-9c1b-bcafb8c0de85",
                        "source_sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                        "source_sense_description": "Anatomie: Haut zum Bedecken der Augen bei höheren Tieren und dem Menschen",
                        "target_lang_word": "eyelid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eyelid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                                        "entry_id": "a0f9c76a-dcfe-3100-9093-99f1efab7f63",
                                        "glosses": [
                                            "A thin skin membrane that covers and moves over an eye."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bc96f66-89d1-4b30-b104-216485511662",
                                                "sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                                                "text": "By his neeſings a light doth ſhine, and his eyes are like the eye-liddes of the morning."
                                            },
                                            {
                                                "example_id": "aaac05e9-83b3-4628-aadc-aa84435940cf",
                                                "sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                                                "text": "[…] the frightened or insane eyes of an animal, sometimes with eyelids closed in escapeful slumber."
                                            },
                                            {
                                                "example_id": "64046b7e-e9db-4264-b514-f4ed4757606a",
                                                "sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                                                "text": "Allergan, the company that turned an obscure muscle paralyzer for eyelid spasms, Botox, into a blockbuster wrinkle smoother, hopes to perform cosmetic alchemy yet again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4fa79b8-4213-43db-bdff-43ef62a7d299",
                        "source_entry_id": "01f8f441-be3b-38a1-9c1b-bcafb8c0de85",
                        "source_sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                        "source_sense_description": "Anatomie: Haut zum Bedecken der Augen bei höheren Tieren und dem Menschen",
                        "target_lang_word": "paupière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paupière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                        "entry_id": "27a1c9e9-a5dd-32f0-a824-8735ee4ef0c7",
                                        "glosses": [
                                            "Chacune des deux membranes mobiles qui recouvrent le globe de l’œil quand elles se rapprochent, et qui sont bordées de petits poils appelés cils."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ea0de6b-34b9-40a3-927a-99b2e622d8b2",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "La proéminence de l’arcade de l’œil, […] ajoute encore à cette mélancolie par la tristesse, physique pour ainsi dire, que produisent les paupières quand elles sont trop abaissées sur la prunelle."
                                            },
                                            {
                                                "example_id": "8efe4a0d-f9bd-4160-a181-e3dc21b7cb4a",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "C'étaient des yeux extraordinaires, bleus, mais foncés et brillants à la fois, humides, las, en pleurs et en feu, presque fermés sous le poids des cils et des paupières."
                                            },
                                            {
                                                "example_id": "56003fca-0bf4-4076-a6cc-10fc31db05d0",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "M. D…, à Jarville; paralysie de la paupière supérieure gauche. — Se rend à l'hôpital, où on lui fait des piqûres à la suite desquelles la paupière se soulève, mais l’œil gauche était dévié de 45° vers l'extérieur."
                                            },
                                            {
                                                "example_id": "882684c1-79af-4ec1-9c40-25b8e9e08d75",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "J’aperçois, dans le décor que la pénombre commence à envahir, le modelé de mon front, l’ovale de mon visage et, sous ma paupière clignante, mon regard par lequel j’entre en moi comme dans un tombeau."
                                            },
                                            {
                                                "example_id": "a024cad1-61fe-430e-9f21-e3d37059b5ac",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "Les paupières, quand il les abaisse, témoignent d’une virginité aussi brillante, rêveuse et cadencée que les iris qu’elles cachent."
                                            },
                                            {
                                                "example_id": "e050165a-e5c9-4160-98a6-225e97118abe",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "Je sentais l'intensité du courant grandir et à mesure ma gorge, mes mâchoires, tous les muscles de mon visage, jusqu'à mes paupières se contacter dans une crispation de plus en plus douloureuse."
                                            },
                                            {
                                                "example_id": "f8bae299-14a0-4fce-9c70-821e4f9927ad",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "Elle se passa les doigts sur les paupières, les yeux reprirent une expression humaine comme si elle revenait d'une pâmoison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6687ff5e-8d7f-36f6-a4f3-4f6cd15f392a",
                                        "entry_id": "27a1c9e9-a5dd-32f0-a824-8735ee4ef0c7",
                                        "glosses": [
                                            "Cils."
                                        ],
                                        "tags": [
                                            "dated",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4b59d1b-0109-4f2a-9cc8-f9ee3391e381",
                                                "sense_id": "6687ff5e-8d7f-36f6-a4f3-4f6cd15f392a",
                                                "text": "[…] en la voyant assise au milieu des femmes anglaises, ses paupières noires, baissées comme leurs paupières blondes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b77b4093-d470-3248-b57c-93f99b5fed52",
                                        "entry_id": "27a1c9e9-a5dd-32f0-a824-8735ee4ef0c7",
                                        "glosses": [
                                            "Yeux, regard."
                                        ],
                                        "tags": [
                                            "dated",
                                            "metonymically",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2821978d-5013-42fe-a34e-d583c7cc866c",
                                                "sense_id": "b77b4093-d470-3248-b57c-93f99b5fed52",
                                                "text": "Et si mes yeux parfois s'ouvrent à la lumière, Bientôt la nuit épaisse obscurcit ma paupière"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e743cccb-c961-451a-a26e-b59bdf82e35d",
