                "senses": [
                    {
                        "sense_id": "2a969144-9a8c-3c04-997d-5be1246282ce",
                        "entry_id": "20559f77-61b5-333f-bb72-aafee465a84d",
                        "glosses": [
                            "тот, кто предсказывает что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b942946d-2445-48e6-b3a7-e44885d89ee2",
                                "sense_id": "2a969144-9a8c-3c04-997d-5be1246282ce",
                                "text": "Главная заслуга Брюса-предсказателя — это календарь событий на ближайшие 200 лет. Он был издан в начале XVIII века и содержал подробные ежедневные пророчества. ❬…❭ Ещё один предсказатель — живший в XV веке Василий Немчин."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc887594-4970-4d61-97f2-9df93dfe90be",
                        "source_entry_id": "20559f77-61b5-333f-bb72-aafee465a84d",
                        "source_sense_id": "2a969144-9a8c-3c04-997d-5be1246282ce",
                        "target_lang_word": "foreteller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foreteller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dcc2052-e47b-3320-8d6e-036386c79ad2",
                                        "entry_id": "05840744-c3a6-3a15-b042-8b2314f78114",
                                        "glosses": [
                                            "Someone who foretells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3392d6c4-b5f9-4c41-a470-6c4bae47e832",
                                                "sense_id": "9dcc2052-e47b-3320-8d6e-036386c79ad2",
                                                "text": "But Powers, a former staff writer at The Washington Post who has written extensively on media and technology, is not simply an earnest foreteller of doom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
