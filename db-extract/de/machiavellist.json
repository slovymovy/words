                                        "sense_id": "f6d19dbd-b315-346a-92de-cfdac00720bd",
                                        "entry_id": "0aa26e92-3da3-31ba-8550-373f1104b0d3",
                                        "glosses": [
                                            "Partisan des principes de Machiavel."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc345aeb-b82f-4485-92fe-6c4e022ee412",
                                                "sense_id": "f6d19dbd-b315-346a-92de-cfdac00720bd",
                                                "text": "Saint-Réal est donc un machiavéliste qui élargit et renouvelle le machiavélisme."
                                            },
                                            {
                                                "example_id": "f2eb2738-510d-4551-a62a-0031bb7046eb",
                                                "sense_id": "f6d19dbd-b315-346a-92de-cfdac00720bd",
                                                "text": "Que César Borgia soit le modèle des machiavélistes, le mien est Marc-Aurèle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "machiavéliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5378836-99e4-3845-bb32-df0633125db7",
                                        "entry_id": "cf9ff510-70e3-3f86-ba8d-eaa930b1e26f",
                                        "glosses": [
                                            "Qui use de machiavélisme."
                                        ],
