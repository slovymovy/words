                        "entry_id": "a7d91fea-fa2c-3701-a09c-b064ccb1b0ec",
                        "glosses": [
                            "Copie quasi identique d’un médicament biologique autorisé dont le brevet a expiré."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "6169109d-11f6-448d-af39-4e3a4c98571c",
                                "sense_id": "d1f5e22a-a7c4-3461-b430-9c27f362cbdb",
                                "text": "Le biosimilaire de trastuzumab (Herzuma) est une réplique du biomédicament anticancéreux de Roche, Herceptin."
                            },
                            {
                                "example_id": "f1d60abf-ea1a-4d6c-ba37-511640665160",
                                "sense_id": "d1f5e22a-a7c4-3461-b430-9c27f362cbdb",
                                "text": "En Europe, le premier biosimilaire (hormone de croissance) a vu le jour le 12 avril 2006. Ensuite des biosimilaires ont été développés contre les maladies inflammatoires"
                            },
                            {
                                "example_id": "1bfb973f-de64-4e0a-b5d2-c50ced073d1f",
                                "sense_id": "d1f5e22a-a7c4-3461-b430-9c27f362cbdb",
                                "text": "Les biosimilaires représentent une solution viable pour économiser plusieurs millions de dollars chaque année, tout en maintenant le même profil de sécurité et d’efficacité pour les patients."
                            }
                        ]
                    }
