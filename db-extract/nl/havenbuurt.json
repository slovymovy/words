                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e427346-7371-4e40-a4ce-9a02b5ad42e7",
                                "sense_id": "5626ea6f-c4f1-3da1-bd6b-db8b011ed123",
                                "text": "De verkrotte historische havenbuurt van Urmond werd rond 1962 gesloopt. De omgeving is daarna twee meter opgehoogd en nooit meer overstroomd."
                            },
                            {
                                "example_id": "6ef59ada-0f41-4b85-b96a-62ddf11f3cdb",
                                "sense_id": "5626ea6f-c4f1-3da1-bd6b-db8b011ed123",
                                "text": "In de loop van de ochtend deed de politie buurtonderzoek op Marken en in het nabijgelegen dorp Uitdam. In de Havenbuurt op Marken werd huis voor huis aangebeld; mogelijk dat de politie ook op zoek was naar een beschadigde auto. Over de resultaten van het onderzoek is niets meegedeeld."
                            }
                        ]
                    }
