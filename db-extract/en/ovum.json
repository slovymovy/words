                    {
                        "translation_id": "59ad1b52-6299-4983-948b-0d44ebb3e7cb",
                        "source_entry_id": "eee65c0c-2a0a-3dca-9a2d-17ebe8e01510",
                        "source_sense_id": "419150a6-20db-36e2-b7a2-2b891545ab0d",
