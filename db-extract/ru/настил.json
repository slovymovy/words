                                                "sense_id": "375d10a6-ec8e-3140-b2a4-9cf1affd2734",
                                                "text": "Toucher de la tête au plancher."
                                            },
                                            {
                                                "example_id": "bf728c50-4c8c-493d-bd9d-d1eeb621f16c",
                                                "sense_id": "375d10a6-ec8e-3140-b2a4-9cf1affd2734",
                                                "text": "Sauter jusqu’au plancher."
                                            },
                                            {
                                                "example_id": "ce9986f7-000e-4ed9-8181-a94fef175417",
                                                "sense_id": "375d10a6-ec8e-3140-b2a4-9cf1affd2734",
                                                "text": "Suspendre quelque chose au plancher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "944d85e5-6442-3b90-9e11-581c738305d6",
                                        "entry_id": "27f6dc65-8441-3f54-a4dc-08e3b7089757",
                                        "glosses": [
