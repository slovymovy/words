                        "examples": [
                            {
                                "example_id": "e0a6c64f-5d27-4131-a008-959120a0b5ad",
                                "sense_id": "755d7a2a-e139-33da-9d54-5b819d8a4d99",
                                "text": "Tout était paisible dans le camp… les uns causaillaient, les autres jouaillaient, d’autres ronflaillaient… moi, je cuisinaillais..."
                            },
                            {
                                "example_id": "87b1fe97-3550-4d3c-aeb4-9c88deac61a7",
                                "sense_id": "755d7a2a-e139-33da-9d54-5b819d8a4d99",
                                "text": "Payer si cher pour RONFLAILLER ?"
                            },
                            {
                                "example_id": "ba598b9b-f01a-4d82-9e8f-d77e9e405f50",
                                "sense_id": "755d7a2a-e139-33da-9d54-5b819d8a4d99",
                                "text": "Même si ça ronflaille dans les rangs Jester tiendra la barraque"
                            }
                        ]
                    }
