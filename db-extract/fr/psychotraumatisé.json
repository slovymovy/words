                        "sense_id": "34ef48fb-c944-3ad6-bfe7-c90c959ce5e2",
                        "entry_id": "4ffb397e-5816-33e7-97ca-85b0552f93e7",
                        "glosses": [
                            "Atteint d’un ou de psychotraumatismes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a68e411e-275a-4156-9314-dbd1876aa58a",
                                "sense_id": "34ef48fb-c944-3ad6-bfe7-c90c959ce5e2",
                                "text": "Mais à la différence d’être fonctionnelles, d’autres atteintes du corps peuvent être inscrites physiquement et biologiquement comme étant la résultante directe d’un stress chronique ou comme le témoignage des modifications du mode de vie, parfois chaotique, du sujet psychotraumatisé."
                            },
                            {
                                "example_id": "dd29be0e-d72f-4daa-8f68-d1f5124a355d",
                                "sense_id": "34ef48fb-c944-3ad6-bfe7-c90c959ce5e2",
                                "text": "Accompagner le sujet psychotraumatisé, c’est reconnaître la gravité de ce que la personne a vécu et l’aider à mobiliser ses ressources."
                            }
                        ]
                    }
                ],
