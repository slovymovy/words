                "senses": [
                    {
                        "sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                        "entry_id": "378c3e93-1337-3754-860e-36fc302f3358",
                        "glosses": [
                            "öffentlich getätigte Aussage, die einer Tatsache entspricht oder auch eine religiöse Botschaft birgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a1f996-822b-4733-9926-8b245877773b",
                                "sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                                "text": "Der Mittwoch war der Tag der feierlichen Verkündigung des Gerichtsurteils."
                            },
                            {
                                "example_id": "6e789946-5ad6-49e3-9f56-bbd21f1ffca4",
                                "sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                                "text": "Am 21. November 2014 jährte sich zum 50. Mal die feierliche Verkündigung des Ökumenismusdekretes „Unitatis redintegratio“ durch das Zweite Vatikanische Konzil."
                            },
                            {
                                "example_id": "82d8ced2-6433-4010-b88a-71cb3eb587a3",
                                "sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                                "text": "Die Verkündigung an Maria war der Moment, in dem der Erzengel Gabriel den göttlichen Ratschluß der Erlösung mitteilte."
                            },
                            {
                                "example_id": "81e395a1-a465-4031-9324-4d8ac8ec4c60",
                                "sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                                "text": "„Jedes einzelne Wort des Predigers war eine Verkündigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9ec6302-fc85-457c-84b5-602a0adbe0f7",
                        "source_entry_id": "378c3e93-1337-3754-860e-36fc302f3358",
                        "source_sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                        "source_sense_description": "öffentlich getätigte Aussage, die einer Tatsache entspricht oder auch eine religiöse Botschaft birgt",
                        "target_lang_word": "annunciation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annunciation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53a3631b-99dc-3b78-a722-b709cd61eb62",
                                        "entry_id": "10e3bdc7-3179-3e48-a26b-0ddec3a6a92a",
                                        "glosses": [
                                            "The act of annunciating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bef627a6-bf88-412b-879b-4e3d142218dc",
                                                "sense_id": "53a3631b-99dc-3b78-a722-b709cd61eb62",
                                                "text": "\"Not in the least; I saw it was an abbreviation from the first annunciation of the marriage, as communicated by the earl of Rotheles; here it is.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "865574ac-74fb-4ad3-a644-d5302e997a52",
                        "source_entry_id": "378c3e93-1337-3754-860e-36fc302f3358",
                        "source_sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                        "source_sense_description": "öffentlich getätigte Aussage, die einer Tatsache entspricht oder auch eine religiöse Botschaft birgt",
                        "target_lang_word": "proclamation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proclamation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "778471b5-4171-3e14-936d-01eaf89808a9",
                                        "entry_id": "f23f9d1e-e319-3a90-a61b-d7606beb8724",
                                        "glosses": [
                                            "Action de proclamer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30546dce-f82d-4cc5-b86a-4d3d21cdede2",
                                                "sense_id": "778471b5-4171-3e14-936d-01eaf89808a9",
                                                "text": "Le commencement de la philosophie pour Descartes, c’est le doute ; cela seul est toute sa méthode. C'est la proclamation du droit au libre examen. L'avenir de la philosophie est attaché à ce principe."
                                            },
                                            {
                                                "example_id": "6c8de101-3b54-4fed-9bbd-2c9586f1c3d5",
                                                "sense_id": "778471b5-4171-3e14-936d-01eaf89808a9",
                                                "text": "Ce fut une époque de beuveries à décarcasser un veau, parmi les vapeurs des pipes et les proclamations d'esthètes crasseux, toutes lavallières dehors."
                                            },
                                            {
                                                "example_id": "0f5be75d-b3f7-4472-b607-2c7015dc60a4",
                                                "sense_id": "778471b5-4171-3e14-936d-01eaf89808a9",
                                                "text": "Prenons, par exemple, des proclamations pour lesquelles le second facteur prend des valeurs très fortement négatives, celles de Ferroul (704) à gauche ou de Guilloutet (213) à droite."
                                            },
                                            {
                                                "example_id": "24a8187b-5e53-42b4-acb6-b98d9795f385",
                                                "sense_id": "778471b5-4171-3e14-936d-01eaf89808a9",
                                                "text": "Suivirent les premiers progrès de la science occidentale, qui devient efficace (Galilée, Newton); puis, avec le siècle des \"Lumières\", l'affirmation de la prééminence de la \"Raison\", la revendication de la tolérance et surtout la proclamation de l'idée de progrès,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b642e59-d5ec-3a9d-ad8e-e69ef8aed674",
                                        "entry_id": "f23f9d1e-e319-3a90-a61b-d7606beb8724",
                                        "glosses": [
                                            "Écrit qui contient ce que l’on veut publier ou faire connaître au public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fc17f88-01e1-42fd-bba6-c91a4e1e36c4",
                                                "sense_id": "4b642e59-d5ec-3a9d-ad8e-e69ef8aed674",
                                                "text": "Les petits chevaux des Cosaques escaladent les amas de décombres, entre des lambeaux de murs placardés d’affiches portant la dernière proclamation de Gœbbels : « Tout Allemand doit défendre sa capitale. Les hordes rouges seront arrêtées. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
