                "senses": [
                    {
                        "sense_id": "4791982d-cc80-3c26-88b1-7b6024d1e72a",
                        "entry_id": "f0a32ff5-3dc3-3908-9683-2164dbb335f2",
                        "glosses": [
                            "наречие к сбивчивый; без последовательности, стройности, логичности; запутанно, прерывисто (о рассказе, речи и т. п.)"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "7dab46a4-7836-4941-95fd-01dfe5d1d0ac",
                                "sense_id": "4791982d-cc80-3c26-88b1-7b6024d1e72a",
                                "text": "Мыслил он очень ясно и крупно, а рассказывал довольно-таки сбивчиво."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d73dcf1-6d57-432a-b511-504db6b340ef",
                        "source_entry_id": "f0a32ff5-3dc3-3908-9683-2164dbb335f2",
                        "source_sense_id": "4791982d-cc80-3c26-88b1-7b6024d1e72a",
                        "target_lang_word": "haltingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haltingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbca4c4d-7b84-3bf9-84db-83c6d56eb47b",
                                        "entry_id": "fe69f751-9f22-3dcd-9c7a-b03800316942",
                                        "glosses": [
                                            "In a halting or limping manner; full of pauses or hesitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a299be7-d3b8-4106-b22b-2cb0b5fd2c0e",
                                                "sense_id": "dbca4c4d-7b84-3bf9-84db-83c6d56eb47b",
                                                "text": "He spoke haltingly of his battle with cancer and its affect on his family."
                                            },
                                            {
                                                "example_id": "55214294-4fec-44f1-9663-b5faa99fcda1",
                                                "sense_id": "dbca4c4d-7b84-3bf9-84db-83c6d56eb47b",
                                                "text": "I just learned how to read Korean this summer and am still new to the language, so I still read and pronounce the words haltingly when I try to read a sentence in Korean. I take over a minute, whereas one with an excellent command of the Korean language would take 12.5 seconds."
                                            },
                                            {
                                                "example_id": "b1b69459-b05d-4b81-91c7-c0bb4c560097",
                                                "sense_id": "dbca4c4d-7b84-3bf9-84db-83c6d56eb47b",
                                                "text": "Mr. Biden’s core supporters expressed confidence in his performance, in which he spoke knowledgeably, if haltingly, about foreign policy after hosting a summit of NATO leaders in Washington."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b824c6a7-e22a-429a-8bdb-cf8b8519f3b2",
                        "source_entry_id": "f0a32ff5-3dc3-3908-9683-2164dbb335f2",
                        "source_sense_id": "4791982d-cc80-3c26-88b1-7b6024d1e72a",
                        "target_lang_word": "disjointedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
