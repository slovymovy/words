                        "sleek appearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий гладкую, элегантную и обтекаемую форму; не громоздкий",
                        "zh": "指形状平滑、优雅、流线型，不臃肿或厚重"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обтекаемый",
                                "target_lang_sense_clarification": "о форме или дизайне"
