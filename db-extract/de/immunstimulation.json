                ],
                "senses": [
                    {
                        "sense_id": "7b4ad676-1dab-326d-83ad-fac39e66b1f5",
                        "entry_id": "83d25baa-4b5b-3c5d-87b1-2d93db03c72e",
                        "glosses": [
                            "Anregung des biologischen Abwehrsystems (Immunsystems) durch bestimmte Substanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae4e7df-b352-4a7d-9875-e11b3fc6817f",
                                "sense_id": "7b4ad676-1dab-326d-83ad-fac39e66b1f5",
                                "text": "„In aktuellen Studien zeigten Polysaccharid K und Polysaccharidpeptid aus Coriolus in Kombinationstherapien positiven Einfluss bei Ösophagus- und Lungenkrebs, mit nachgewiesener Immunstimulation.“"
                            },
                            {
                                "example_id": "70a9f7be-6590-4392-9c6a-f42eb51e404c",
                                "sense_id": "7b4ad676-1dab-326d-83ad-fac39e66b1f5",
                                "text": "„Aufgrund der immunstimulatorischen Wirkung der Betaglucane sollten Pilze nicht bei Leukämien und Lymphomen und nicht in Krankheitssituationen, bei denen eine Immunstimulation nicht gewünscht ist […].“"
                            },
                            {
                                "example_id": "cf40aa40-23cd-473d-afc3-a2b14540bb81",
                                "sense_id": "7b4ad676-1dab-326d-83ad-fac39e66b1f5",
                                "text": "„Eine frühzeitige unspezifische Immunstimulation kann vor der Entwicklung allergischer Erkrankungen schützen.“"
                            },
                            {
                                "example_id": "39dadeb6-f211-4080-9299-f37354699309",
                                "sense_id": "7b4ad676-1dab-326d-83ad-fac39e66b1f5",
                                "text": "„Die entscheidende Frage ist, ob diese Immunstimulation zu einer direkten oder indirekten Wirkung gegen den Tumor führt.“"
                            },
                            {
                                "example_id": "8cc83390-fbc2-4f38-b79f-bfbc7924f021",
                                "sense_id": "7b4ad676-1dab-326d-83ad-fac39e66b1f5",
                                "text": "„Ebenso ist die Immunfunktion unserer Patienten beeinträchtigt und die Immunstimulation nicht sicher vorhersehbar gesteigert oder vermindert.“"
                            },
                            {
                                "example_id": "8dd2dd6c-eaa8-495b-84f3-95afbca4b513",
                                "sense_id": "7b4ad676-1dab-326d-83ad-fac39e66b1f5",
                                "text": "„Zusammenfassend sind wir noch weit davon entfernt, sowohl durch Immunsuppression als durch Immunstimulation das immunologische Abwehrsystem des Menschen spezifisch zu beeinflussen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
