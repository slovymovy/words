                ],
                "senses": [
                    {
                        "sense_id": "566a6197-a783-33fa-a0b3-4e554215bf46",
                        "entry_id": "7ddde1a0-48c7-3da4-b927-031602371149",
                        "glosses": [
                            "Eigenschaft einer Person, nach außen hin freundlich zu sein, aber bösen Absichten zu haben"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "13f0dbf8-8196-467e-b339-acf82cbbb7c3",
                                "sense_id": "566a6197-a783-33fa-a0b3-4e554215bf46",
                                "text": "„Mit noch größerer Hinterfotzigkeit als vorhin zwängte er sein dünnes Ärmchen diesmal fast unter Schmerzen in den äußerst engen Spalt zwischen Mauerwerk und Rückwand des edlen Inventars.“"
                            },
                            {
                                "example_id": "d6592451-777f-4c98-b692-a42b23de818f",
                                "sense_id": "566a6197-a783-33fa-a0b3-4e554215bf46",
                                "text": "„Als früherer Klassenkamerad von Steinböck war er doch das krasse Gegenteil des gemütlichen Kommissars, der ihn ob seiner Feig- und Hinterfotzigkeit schon sein ganzes Leben lang verachtete.“"
                            },
                            {
                                "example_id": "8e4f6ff9-8ce3-4576-95a8-9858f189700c",
                                "sense_id": "566a6197-a783-33fa-a0b3-4e554215bf46",
                                "text": "„Ich muss also kundtun, dass mich das pubertäre Türenschlagen, die gegen den Vater gerichtete Wut, Bitterkeit, Trauer und Enttäuschung nicht daran gehindert haben, schon sehr früh das uralte Ritual der Hinterfotzigkeit zu wiederholen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9fb1bb92-96ec-34cb-8ffe-fe7e6fee873b",
                        "entry_id": "7ddde1a0-48c7-3da4-b927-031602371149",
                        "glosses": [
                            "etwas, das [1] zum Ausdruck bringt"
                        ],
                        "tags": [
                            "umgangssprachlich, abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "143ac022-fa57-4e28-9444-278c77b6ea81",
                                "sense_id": "9fb1bb92-96ec-34cb-8ffe-fe7e6fee873b",
                                "text": "„Politik war immer seine Leidenschaft gewesen, und früher hatte er sich stundenlang über all die Winkelzüge, Hinterfotzigkeiten und Scheinmanöver auslassen können, die das politische Leben des Parks bestimmten.“"
                            },
                            {
                                "example_id": "84a9ac8a-ac63-4003-a552-03d31a122c30",
                                "sense_id": "9fb1bb92-96ec-34cb-8ffe-fe7e6fee873b",
                                "text": "„Blödsinn, warum nur traute sie diesem eigentlich netten Kerl alle möglichen Hinterfotzigkeiten zu?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
