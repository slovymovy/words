                "senses": [
                    {
                        "sense_id": "12719855-8806-3b33-b1f2-8b148537ca7d",
                        "entry_id": "40c044fc-b64a-3378-bf58-54f2eec9dccb",
                        "glosses": [
                            "een, vaak zeer luxueus uitgeruste, privéruimte in een stadion met uitzicht op het veld of de baan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b14e459e-0a3b-41db-bbc8-84419021f357",
                                "sense_id": "12719855-8806-3b33-b1f2-8b148537ca7d",
                                "text": "De club verkocht wel meer seizoenskaarten, business seats en skyboxen. Dat valt dan weer deels terug te voeren op de Europese successen van vorig seizoen. Verder bracht de club de kosten terug, onder meer door lagere spelerssalarissen."
                            },
                            {
                                "example_id": "ed596b92-bf6e-404f-a12c-3fa93e44c283",
                                "sense_id": "12719855-8806-3b33-b1f2-8b148537ca7d",
                                "text": "Vitesse gaat er zondag alles aan doen om van de thuiswedstrijd tegen Feyenoord een geel-zwart feestje te maken. Vorig seizoen leek het wel alsof de Arnhemse club in april een uitwedstrijd speelde in de Gelredome, waar op de tribunes en zelfs in de skyboxen honderden aanhangers van Feyenoord zaten."
                            },
                            {
                                "example_id": "412c3c8b-aa7a-4454-bfcf-6eafc1aae5c3",
                                "sense_id": "12719855-8806-3b33-b1f2-8b148537ca7d",
                                "text": "Want skyboxen hebben de schijn bij het volk natuurlijk tegen. Dat zijn stadionbars waar zelfbenoemde plaatselijke vips op kosten van de belastingbetaler zich vermaken met bier, gebral en voetbal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc738010-b532-44c8-84e3-ad723feed1cd",
                        "source_entry_id": "40c044fc-b64a-3378-bf58-54f2eec9dccb",
                        "source_sense_id": "12719855-8806-3b33-b1f2-8b148537ca7d",
                        "target_lang_word": "skybox",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skybox",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "632d71db-947c-3388-bbf2-0cb453dedc20",
                                        "entry_id": "a7b073b3-cee5-36cf-8125-14be1ea82b22",
                                        "glosses": [
                                            "A seating area for VIPs in a stadium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b0d6e4-b182-40b6-b0cd-521ea42487e8",
                                                "sense_id": "632d71db-947c-3388-bbf2-0cb453dedc20",
                                                "text": "When Aislyn showed up at the rally with her ticket, she and her friends and parents all got quickly ushered over to a fancy-looking private entrance and up to an even fancier luxury skybox."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7892133-dcb4-34af-8989-5ddbb51dfda1",
                                        "entry_id": "a7b073b3-cee5-36cf-8125-14be1ea82b22",
                                        "glosses": [
                                            "A cube with textures on its inner faces, used to simulate the sky or similar backdrop around a three-dimensional playfield."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceee2a8a-8cd1-46d9-b156-b28b5e4948cf",
                                                "sense_id": "a7892133-dcb4-34af-8989-5ddbb51dfda1",
                                                "text": "Thankfully, tools have been created to assist in the skybox creation process."
                                            },
                                            {
                                                "example_id": "c354349a-773e-4897-8b24-6f5dd6eb7a4c",
                                                "sense_id": "a7892133-dcb4-34af-8989-5ddbb51dfda1",
                                                "text": "To ensure consistent sizing for all images, you should give each image in the skybox the same pixel width and height dimensions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
