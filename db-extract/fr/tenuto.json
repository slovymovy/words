            {
                "entry_id": "2206b9ff-fccf-310c-9a42-49b6b2f55ab2",
                "word": "tenuto",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1485b78a-6b7e-4e1d-94b2-5b2e2f8ebf93",
                        "entry_id": "2206b9ff-fccf-310c-9a42-49b6b2f55ab2",
                        "tags": [
                            "plural"
                        ],
                        "form": "tenutos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38571d68-cb53-332b-b118-b6cc3145f507",
                        "entry_id": "2206b9ff-fccf-310c-9a42-49b6b2f55ab2",
                        "glosses": [
                            "Marque qui indique qu’il faut tenir la note jouée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf02922-2a6e-4f55-a5e8-ed160729c955",
                                "sense_id": "38571d68-cb53-332b-b118-b6cc3145f507",
                                "text": "[…] unisson des cordes — large suspension sur des notes tenues dans laquelle se glisse Juliette, lancinante et expressive, interpellant son aimé en un abandon passionné sur un Sol aigu intensifié d’un tenuto."
                            }
                        ]
                    },
                    {
                        "sense_id": "b331fdce-6e2d-3b70-9aff-c3a6dc010bf9",
                        "entry_id": "2206b9ff-fccf-310c-9a42-49b6b2f55ab2",
                        "glosses": [
                            "Jeu, doigté qui tient et marque les notes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "173c9fd6-a916-4745-a8a3-54f6602e07ea",
                                "sense_id": "b331fdce-6e2d-3b70-9aff-c3a6dc010bf9",
                                "text": "Faut-il jouer un staccato, là où d’autres jouent un tenuto léger ?"
                            },
                            {
                                "example_id": "642c6288-2fbd-4bee-9900-3330a392892f",
                                "sense_id": "b331fdce-6e2d-3b70-9aff-c3a6dc010bf9",
                                "text": "Le tenuto consiste à détacher les notes, tout en tenant le son de chacune plus longuement que dans le staccato. On dit que les notes sont « portées », ou « lourées »."
                            }
                        ]
                    }
                ],
