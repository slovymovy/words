                        "sense_id": "e4b67b71-dc6e-32d7-82a4-c5fe7bcd3c56",
                        "entry_id": "7d2d28c3-1f06-3a09-8b5a-fe957a408c9d",
                        "glosses": [
                            "Person, die als Gast ein Kaffeehaus besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478f288d-3681-4cee-a9f6-96a0d80a138f",
                                "sense_id": "e4b67b71-dc6e-32d7-82a4-c5fe7bcd3c56",
                                "text": "„Um wieder Gäste in das für rund 200 Kaffeehausbesucher dimensionierte Café Museum zu locken, soll es neben Kaffeespezialitäten auch eine Küche von der Schinkenrolle bis zum Tafelspitz sowie Mehlspeisen aus der Patisserie des Landtmann geben.“"
                            },
                            {
                                "example_id": "d22a1efd-7f25-4e21-82ea-0eeec8ec9863",
                                "sense_id": "e4b67b71-dc6e-32d7-82a4-c5fe7bcd3c56",
                                "text": "„Außerdem gibt es in Moskau bereits Abwandlungen des Zeitcafes, in denen die Kaffeehausbesucher mit lauter elektronischer Musik beschallt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
