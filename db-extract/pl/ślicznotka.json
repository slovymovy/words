                                    },
                                    {
                                        "sense_id": "2bd1535a-9708-3052-9d7a-0fde49cd9f63",
                                        "entry_id": "7971f527-b1bc-3b14-9fda-5d3f668a2f2c",
                                        "glosses": [
                                            "Prevailing style or taste; rage; fashion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f3ee6ac-626e-4a8d-baff-0a1d077aeacb",
                                                "sense_id": "2bd1535a-9708-3052-9d7a-0fde49cd9f63",
                                                "text": "Menander in the comedy brings in a man turning his wife from his house, because she stained her hair yellow, which was then the beauty."
                                            }
