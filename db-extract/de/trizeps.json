                                        "glosses": [
                                            "Specifically, the triceps brachii."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7be6b48-fe29-4d2b-be15-001d9c8c0894",
                                                "sense_id": "e526f970-ecce-3a7d-8b5e-be284b98ded3",
                                                "text": "Kickbacks work the triceps muscle at the back of your arm. Exercising these muscles helps eliminate arm jiggle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35064659-390f-41b2-bd19-33dd7ded0fa3",
                        "source_entry_id": "6e4d8c6a-167e-3efe-b2a2-2ccf0da18ea7",
                        "source_sense_id": "1af6be6f-76a1-37df-ab45-cc45ff605b32",
                        "target_lang_word": "triceps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triceps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "017b355c-28da-3c3e-bb24-e08d5f785b29",
                                        "entry_id": "fc05cc7b-f7b5-31c1-a19c-642cb4db4297",
                                        "glosses": [
                                            "Se dit de certains muscles qui ont trois faisceaux charnus à l’une de leurs extrémités."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "598fdd6e-5232-46b8-ba7d-82b6be9ccb07",
                                                "sense_id": "017b355c-28da-3c3e-bb24-e08d5f785b29",
                                                "text": "Muscle triceps brachial, muscle triceps sural."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "triceps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb2dcab7-986c-3935-9199-b0e614841e3d",
                                        "entry_id": "f79ba60c-7940-3e9d-a62c-e6d32883e387",
                                        "glosses": [
                                            "Muscle triceps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12392fcc-3db9-4290-801f-535d7db2a2aa",
                                                "sense_id": "eb2dcab7-986c-3935-9199-b0e614841e3d",
                                                "text": "Le triceps brachial ou huméral, muscle de la partie postérieure du bras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e907d58-9e6e-3e3d-b888-d439ad527a56",
                                        "entry_id": "f79ba60c-7940-3e9d-a62c-e6d32883e387",
                                        "glosses": [
                                            "Synonyme usuel de triceps brachial."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9d44ed4-a8b3-4984-8df5-22a98b4b3c69",
                                                "sense_id": "1e907d58-9e6e-3e3d-b888-d439ad527a56",
                                                "text": "Les mouvements de flexion et d’extension de l’avant-bras sont gérés par plusieurs muscles dont le biceps (muscle fléchisseur) et le triceps (muscle extenseur)."
                                            },
                                            {
                                                "example_id": "17748015-2b4f-4997-bea1-869a635d88fc",
                                                "sense_id": "1e907d58-9e6e-3e3d-b888-d439ad527a56",
                                                "text": "La musculation du triceps est importante pour plusieurs raisons : le triceps est responsable du volume du bras, un biceps plus développé qu’un triceps peut entraîner des blessures, et une faiblesse sur ce muscle peut freiner la progression en musculation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26eb246c-831c-427c-b16b-e271229dd74d",
                        "source_entry_id": "6e4d8c6a-167e-3efe-b2a2-2ccf0da18ea7",
                        "source_sense_id": "1af6be6f-76a1-37df-ab45-cc45ff605b32",
                        "target_lang_word": "трицепс",
