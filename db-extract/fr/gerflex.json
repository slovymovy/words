                        "glosses": [
                            "(Par antonomase) Revêtement de sol synthétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7084bb-7629-41ec-b6e9-c102f42c62be",
                                "sense_id": "f6ceaac5-0bbe-376c-bdbc-5fedd00a753e",
                                "text": "La cheminée hoquète des bouffées et le gerflex, cache-misère posé au sol, frémit. L’air frais, infiltré par la cave, traverse les lattes du plancher, le sol se gondole."
                            },
                            {
                                "example_id": "bf37bef2-d4a6-4702-9190-303f2cde8947",
                                "sense_id": "f6ceaac5-0bbe-376c-bdbc-5fedd00a753e",
                                "text": "Le balai rustique avale la crasse en laissant une traînée humide sur le gerflex ; ses longues lanières de chiffons sombres se tordent dans un claquement mouillé."
                            },
                            {
                                "example_id": "0b641c7b-343e-468b-873a-007ba4480bca",
                                "sense_id": "f6ceaac5-0bbe-376c-bdbc-5fedd00a753e",
                                "text": "Par le diverticule antichambre, on pourrait pénétrer dans le lieu à tout faire où la moquette cède place à un de ces faux carrelages en gerflex, qui, le lieu, contient le frigidaire, la douche, le bidet, le réchaud à gaz, l’armoire de Barbe-Bleue, la glace en pied, la table à maquillage"
                            }
                        ]
                    }
