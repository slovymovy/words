                    {
                        "translation_id": "11d880ab-6cc9-40a8-8b22-7970e3ac6520",
                        "source_entry_id": "52720a7d-d661-3f68-a37f-0168ca6f6c33",
                        "source_sense_id": "066b1d49-6c5a-38b1-a94e-a81b87664533",
                        "source_sense_description": "ein Blatt Papier mit einem vorgebenen Maß",
                        "target_lang_word": "feuille de papier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuille de papier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16ee8c1b-866f-3df5-8e9a-dc0a38e64128",
                                        "entry_id": "cebc020a-0c17-382a-a8ed-9184d6ffc430",
                                        "glosses": [
                                            "Produit rectangulaire obtenu par fabrication dans un moulin à papier destiné à la graphie. → voir feuille simple, feuille double et feuille vierge"
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4cc977-b4b3-41c8-86bf-376b25a5b5a6",
                                                "sense_id": "16ee8c1b-866f-3df5-8e9a-dc0a38e64128",
                                                "text": "L’ouvrier retourne la forme et fait tomber la feuille de papier sur une grande table où l’on en entasse ainsi un millier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1813eb-85c6-3913-92d7-19b3ac766321",
                                        "entry_id": "cebc020a-0c17-382a-a8ed-9184d6ffc430",
                                        "glosses": [
                                            "Produit rectangulaire obtenu par fabrication dans un moulin à papier destiné à la graphie. → voir feuille simple, feuille double et feuille vierge",
                                            "Support d’image."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "937b8422-710d-4e41-b926-eb4cf0b9bdb1",
                                                "sense_id": "1a1813eb-85c6-3913-92d7-19b3ac766321",
                                                "text": "Il faut aussi avoir soin de tenir le cuir à une distance convenable de la pierre, afin qu’il ne touche la feuille de papier qu’au moment où le râteau y arrive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02f6d288-c784-327a-aa6a-637bec641a8b",
                                        "entry_id": "cebc020a-0c17-382a-a8ed-9184d6ffc430",
                                        "glosses": [
                                            "Produit rectangulaire obtenu par fabrication dans un moulin à papier destiné à la graphie. → voir feuille simple, feuille double et feuille vierge",
                                            "Support d’écrits. → voir feuille de papier millimétré et feuille de papier machine"
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2523c8d1-a9ec-4d01-913e-3694b21f5662",
                                                "sense_id": "02f6d288-c784-327a-aa6a-637bec641a8b",
                                                "text": "Ainsi la blancheur de cette feuille de papier sur laquelle je trace des mots ne peut être la blancheur d’une autre feuille, quoique toutes deux soient appelées blanches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd23a2e-4fe5-301f-8c93-fde5954aeae8",
                                        "entry_id": "cebc020a-0c17-382a-a8ed-9184d6ffc430",
                                        "glosses": [
                                            "Révélateur expérimental. → voir feuille de papier tournesol"
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58ee96e0-4b22-4e9f-96dc-30b36ffc2aad",
                                                "sense_id": "5fd23a2e-4fe5-301f-8c93-fde5954aeae8",
                                                "text": "M. Niepce de Saint-Victor exposa au soleil, sous un cliché négatif, une feuille de papier blanc qui n’avait reçu aucune préparation, et ensuite il la plongea dans une solution d’azotate d’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4da3b56c-9472-38f3-862d-57b5dfd0e955",
                                        "entry_id": "cebc020a-0c17-382a-a8ed-9184d6ffc430",
                                        "glosses": [
                                            "Feuille destinée à l’emballage d’un produit ou la séparation d’éléments. → voir feuille de papier d’emballage, feuille de papier à cigarette et feuille de papier kraft"
                                        ],
                                        "tags": [
                                            "Conditionnement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bb8ac2d-3784-4c82-927b-0f7102ce15c5",
                                                "sense_id": "4da3b56c-9472-38f3-862d-57b5dfd0e955",
                                                "text": "Tolérance : Les fruits emballés en billots ou basquets doivent être disposés en couches régulières séparées entre elles par une cartonnette ou par une feuille de papier fort […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "570a18c1-f66a-37da-a3d8-c3c28c10a276",
                                        "entry_id": "cebc020a-0c17-382a-a8ed-9184d6ffc430",
                                        "glosses": [
                                            "Chiffon pour essuyer. → voir feuille de papier toilette et feuilles de papier absorbant"
                                        ],
                                        "tags": [
                                            "Hygiène"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39c3b75c-1269-49a3-82f4-8ff6db961749",
                                                "sense_id": "570a18c1-f66a-37da-a3d8-c3c28c10a276",
                                                "text": "Merde ! dit-il en pivotant pour arracher une feuille de papier d’un rouleau et essuyer le liquide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68774746-2ad8-334a-a887-d885ebb9c96e",
                                        "entry_id": "cebc020a-0c17-382a-a8ed-9184d6ffc430",
                                        "glosses": [
                                            "Support pour couvrir ou démouler une préparation. → voir feuille de papier cuisson"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb6fee7-2084-48fc-a8bf-d01cc9ee1b72",
                                                "sense_id": "68774746-2ad8-334a-a887-d885ebb9c96e",
                                                "text": "Quand les canards sont habillés, on les lave intérieurement pour les bien essuyer, les brider et les envelopper dans dans une feuille de papier huilé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
