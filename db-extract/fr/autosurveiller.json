                        "glosses": [
                            "Se surveiller soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46fae699-f2de-4900-bf4c-5228bad3085e",
                                "sense_id": "38bf8a9b-add9-3467-8259-a4c31e8d8c4e",
                                "text": "Il devient alors impossible d'atteindre une cohérence interne qui soit capable de s'auto-observer et de s'autosurveiller de façon à s'harmoniser en prenant chaque fois en ligne de compte tous les éléments pertinents."
                            },
                            {
                                "example_id": "8a5ec0a5-0472-4b95-b46c-b7763916adbe",
                                "sense_id": "38bf8a9b-add9-3467-8259-a4c31e8d8c4e",
                                "text": "Il s'agit de fabriquer de l'or, d'aller sur la lune, de construire des missiles capables de s'autodiriger, de s'autosurveiller avant de décider eux-mêmes du moment de leur destruction - et de la nôtre."
                            }
                        ]
                    }
