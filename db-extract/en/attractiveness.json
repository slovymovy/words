                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a610a4-6f8d-49f9-bee5-aeabcca9babb",
                                                "sense_id": "2584f25f-e64e-384d-a7a3-4b71e8aea61d",
                                                "text": "Bei Preisen zwischen 220 und 240 Euro je Tonne behalte Raps seine hohe Attraktivität."
                                            },
                                            {
                                                "example_id": "4b0d6c89-851a-4a12-add7-578689afc229",
                                                "sense_id": "2584f25f-e64e-384d-a7a3-4b71e8aea61d",
                                                "text": "„China hat deutlich an Attraktivität für ausländische Investoren verloren.“"
                                            },
                                            {
                                                "example_id": "806be194-5728-4e0d-9db8-0f327a802894",
                                                "sense_id": "2584f25f-e64e-384d-a7a3-4b71e8aea61d",
                                                "text": "[Tischtennis:] „Durch die Vergrößerung des Balles“ [Anm.: von 38 auf 40 mm] „wurde die maximale Rotation verringert, womit man längere Ballwechsel und eine höhere Attraktivität des Sport erreichen wollte.“"
