                "senses": [
                    {
                        "sense_id": "c4fb17c2-c496-3e80-94ff-e7a66463c6f7",
                        "entry_id": "6dfb4b99-8a58-3427-8716-c1beda73d20d",
                        "glosses": [
                            "Constructeur automobile, entreprise qui fabrique des voitures."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "5c2e889c-a873-40c0-b10c-e65fa2f5a600",
                                "sense_id": "c4fb17c2-c496-3e80-94ff-e7a66463c6f7",
                                "text": "Die Autohersteller Jaguar und Land Rover lassen dringend benötigte Teile für die Fahrzeugproduktion aus China mittlerweile per Flugzeug nach Großbritannien transportieren.",
                                "translation": "Les constructeurs automobiles Jaguar et Land Rover font désormais acheminer par avion de Chine vers le Royaume-Uni les pièces dont ils ont un besoin urgent pour la production de leurs véhicules."
                            },
                            {
                                "example_id": "0c39b95b-fbc0-4d4d-8fe6-0812f2536fa7",
                                "sense_id": "c4fb17c2-c496-3e80-94ff-e7a66463c6f7",
                                "text": "Sitzen gilt als ungesund (...) Autohersteller Mercedes hat sich diesen Umstand zu Herzen genommen und präsentiert nun mit der sogenannten \"Steh-Klasse\" das erste Auto, das anstelle von Sitzen ausschließlich über Stehplätze verfügt.",
                                "translation": "La position assise est considérée comme malsaine (...) Le constructeur automobile Mercedes a pris cet état de fait au sérieux et présente désormais la « classe debout », la première voiture qui dispose exclusivement de places debout au lieu de sièges."
                            }
                        ]
                    }
                ],
