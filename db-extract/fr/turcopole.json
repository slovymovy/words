                        "entry_id": "b3f09ab0-51b2-30d3-bfca-30e6e9443985",
                        "glosses": [
                            "Mercenaire arabe ou turc que les princes croisés établis en Orient avaient à leur solde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e6275e-f59e-4c9a-b951-a592643a5748",
                                "sense_id": "bdd295bd-705d-300a-bc8a-1fe1705e1e49",
                                "text": "Les turcopoles étaient commandés par un sergent, appelé turcopolier."
                            },
                            {
                                "example_id": "2f57b54b-fc1b-4c82-90e8-51b96c1a2af9",
                                "sense_id": "bdd295bd-705d-300a-bc8a-1fe1705e1e49",
                                "text": "Force considérable, aux trois cents chevaliers, s'ajoutaient les écuyers, sergents et turcopoles ; elle atteignait au moins trois mille hommes immédiatement disponibles, étroitement dépendants du chef de l'Ordre."
                            }
                        ]
                    }
                ],
