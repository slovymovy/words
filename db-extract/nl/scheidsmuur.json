                        "glosses": [
                            "muur die een scheiding tussen twee vertrekken vormt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f227b9d0-f363-3ac7-aa8c-f8b340a07a65",
                        "entry_id": "82149ed5-d5e7-320b-b0bf-c6cf6d7b4fd6",
                        "glosses": [
                            "een niet fysieke scheiding tussen twee groepen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "295e51b1-7e7d-4bd1-b942-375e35de9da4",
                                "sense_id": "f227b9d0-f363-3ac7-aa8c-f8b340a07a65",
                                "text": "Zolang kunst achter de muur (van het museum) blijft, gaat het goed. Wanneer een kunstenaar over de muur probeert te kruipen, dan dreigt er bonje, aan beide kanten van de scheidsmuur."
                            },
                            {
                                "example_id": "93a15539-6fe1-4e71-b492-23aaa39907f6",
                                "sense_id": "f227b9d0-f363-3ac7-aa8c-f8b340a07a65",
                                "text": "Paus roept op alle scheidsmuren te slechten: Paus Franciscus heeft vandaag de wens uitgesproken dat alle 'muren geslecht worden die de wereld nog verdelen'."
                            }
                        ]
                    }
