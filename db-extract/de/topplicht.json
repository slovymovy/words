                ],
                "senses": [
                    {
                        "sense_id": "eac03b10-084d-3e66-abef-bfa0ee9b31b3",
                        "entry_id": "b841e6b2-ced9-369a-b5d9-8531b4dc6979",
                        "glosses": [
                            "Lampe auf einem Maschinenfahrzeug (= kein Segler) in Fahrt mit weißem Licht in erhöhter Position (über den Seitenlichtern), die in einem Winkel von 225° nach vorne strahlt"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "c22ed794-3b63-499a-b9d4-3fb65aed9e76",
                                "sense_id": "eac03b10-084d-3e66-abef-bfa0ee9b31b3",
                                "text": "Für Schiffe von mehr als 50 m Länge ist für das Topplicht einen Mindesttragweite von 6 sm vorgeschrieben, für Schiffe zwischen 50 m und 20m 5 sm und für Schiffe zwischen 20 m und 12 m Länge 3 sm."
                            },
                            {
                                "example_id": "6e2ef96c-4e4f-44fb-bbee-3a1b74adadf8",
                                "sense_id": "eac03b10-084d-3e66-abef-bfa0ee9b31b3",
                                "text": "„Das Topplicht scheint über einen Horizontbogen von 225°, nach jeder Seite von recht voraus bis 22,5° achterlicher als querab.“"
                            },
                            {
                                "example_id": "e42f42ca-7a47-4212-b128-05f744a13576",
                                "sense_id": "eac03b10-084d-3e66-abef-bfa0ee9b31b3",
                                "text": "„Seitenlichter, Hecklicht und Topplicht werden zusammen auch als Positionslichter im engeren Sinne bezeichnet.“"
                            },
                            {
                                "example_id": "9f8d8d6c-b190-44de-ae81-a06c0df7edc9",
                                "sense_id": "eac03b10-084d-3e66-abef-bfa0ee9b31b3",
                                "text": "„Fahrzeuge über 50 m Länge benötigen auf Seeschifffahrtsstraßen ein zweites Topplicht,“ […]."
                            },
                            {
                                "example_id": "c3d2a098-6c9a-478b-8677-44a54cab929f",
                                "sense_id": "eac03b10-084d-3e66-abef-bfa0ee9b31b3",
                                "text": "„Die verschiedenen Abstrahlwinkel bilden in ihrer Gesamtheit immer einen Vollkreis von 360°. Zum Beispiel das Topplicht mit 225° und das Hecklicht mit 135° ergeben zusammen den Winkel von 360°.“"
                            },
                            {
                                "example_id": "46534a24-37bc-4253-a5f2-0749337f6c95",
                                "sense_id": "eac03b10-084d-3e66-abef-bfa0ee9b31b3",
                                "text": "„Nachts rammen mitunter Schlepper oder Kümos einen der Riesen, weil der Mann am Steuer des Kleinen den Abstand zwischen vorderem und hinterem Topplicht des Großen als passierbare Lücke zwischen zwei Schiffen mißdeutet.“"
                            },
                            {
                                "example_id": "d4b5df6d-6a8b-4879-98d2-089701530495",
                                "sense_id": "eac03b10-084d-3e66-abef-bfa0ee9b31b3",
                                "text": "„Alle Schiffen besaßen eine auffällig lange, für Brückendurchfahrten klappbare Stenge auf dem achteren Mast, um dem achteren Topplicht eine ausreichende Höhe über dem Schwergutbaum zu geben.“"
                            },
                            {
                                "example_id": "70df2ab3-0fc1-41b3-bc80-d49ef7581669",
                                "sense_id": "eac03b10-084d-3e66-abef-bfa0ee9b31b3",
                                "text": "„Ein Tochterboot der Seenotretter folgte der Peillinie über die Nordergründe und entdeckte schließlich das Topplicht der Yacht.“"
                            },
                            {
                                "example_id": "77305d3b-1f9e-4894-9401-178ae8ed0813",
                                "sense_id": "eac03b10-084d-3e66-abef-bfa0ee9b31b3",
                                "text": "„»Man sieht seine Steuerbordlaterne und darüber das Topplicht. Ein einziges Topplicht heißt, dass es ein Schiff mit unter 45 Metern Länge ist. Also ein Kümo (Küstenmotorschiff) oder ein Fischer. Auf jeden Fall maschinengetrieben. Segler haben kein Topplicht. Nur Seiten- und Heckleuchte.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
