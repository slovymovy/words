                "senses": [
                    {
                        "sense_id": "2a7d31b4-b505-3954-b07a-a755a1aa24cc",
                        "entry_id": "308e2092-eba2-31a8-b8e7-7b8c6c37692b",
                        "glosses": [
                            "Peigner les cheveux, les accommoder avec soin."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d19c151b-0da3-4760-9371-195eb764c754",
                                "sense_id": "2a7d31b4-b505-3954-b07a-a755a1aa24cc",
                                "text": "[Deux femmes] L’allaient quelquefois testonnant, C’est-à-dire ajustant sa tête."
                            },
                            {
                                "example_id": "3dd3913b-56bd-43bf-9268-141deb4ed6b3",
                                "sense_id": "2a7d31b4-b505-3954-b07a-a755a1aa24cc",
                                "text": "Elle n’avait point de coiffe ; mais encore passe, elle est jeune et jolie ; mais toutes ces femmes de St-Germain et cette la Mothe se font testonner par la Martin."
                            }
                        ]
                    },
                    {
                        "sense_id": "f68c5fde-527e-3a50-a364-ec230a59a088",
                        "entry_id": "308e2092-eba2-31a8-b8e7-7b8c6c37692b",
                        "glosses": [
                            "Battre et donner des coups. (A. Oudin, Curiositez françoises, éd. 1640, p. 534 Gallica"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2de60d1a-da63-4b6f-b892-bca98389d507",
                                "sense_id": "f68c5fde-527e-3a50-a364-ec230a59a088",
                                "text": "Trois gentilshommes deniaisez estoient avecque moy qui le testonnerent bravement, et luy firent sauter les montées plus viste."
                            }
                        ]
                    }
