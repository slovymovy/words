                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe2ea226-4ee4-4d8b-8896-1bf15ac2f058",
                                "sense_id": "21e5463a-7ea0-3ef8-b136-dbe17842039c",
                                "text": "„Tabakmonopol und Tabaksteuer wurden bald zu bedeutsamen Finanzfaktoren.“"
                            },
                            {
                                "example_id": "cea343a5-184c-4514-93f1-39a8bc2448ea",
                                "sense_id": "21e5463a-7ea0-3ef8-b136-dbe17842039c",
                                "text": "„Für die Stadtkämmerer sind die Studenten ein wichtiger Finanzfaktor: Nur wenn sie mit dem Erstwohnsitz am Uni-Ort gemeldet sind, können Städte wie Rostock oder Wuppertal im Rahmen des Finanzausgleichs Geld zugewiesen bekommen.“"
                            },
                            {
                                "example_id": "ddd8b890-a446-409f-bbf4-5454841a276d",
                                "sense_id": "21e5463a-7ea0-3ef8-b136-dbe17842039c",
                                "text": "„Im Ausland arbeitende Marokkaner wie sie, die Geld nach Hause schicken, sind ein wichtiger Finanzfaktor Marokkos geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
