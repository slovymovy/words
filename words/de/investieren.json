                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er musste viel Zeit und Mühe in die Vorbereitung der schweren Abschlussprüfung <w>investieren</w>."
