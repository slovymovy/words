                "senses": [
                    {
                        "sense_id": "456424f4-b7d7-3032-8433-751f730b8f57",
                        "entry_id": "f83e9f38-1b80-3786-a2ab-25d26b91b2b4",
                        "glosses": [
                            "the wood piece struck in the tipcat game"
                        ],
                        "tags": [
                            "Austria",
                            "Bohemia",
                            "Switzerland",
                            "mixed",
