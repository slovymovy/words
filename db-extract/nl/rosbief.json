                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9998ad86-d4fb-45b8-b250-086fa5ebfe77",
                                                "sense_id": "3d831fc2-c835-3132-9605-ec331cee9132",
                                                "text": "It began one day with a series of morning calls from Shovel, who suddenly popped his head over the top of the door (he was standing on the handle), roared \"Roastbeef!\" in the manner of a railway porter announcing the name of a station, and then at once withdrew."
                                            },
                                            {
                                                "example_id": "83681159-82e8-4199-b8ae-a42a363eb9e6",
                                                "sense_id": "3d831fc2-c835-3132-9605-ec331cee9132",
                                                "text": "It was already late and they had to start for Raleigh with their mouths full of roastbeef to catch the plane, leaving Sally sour and silent and greenfaced to putter in the kitchen and to keep an eye on the kids."
                                            },
                                            {
                                                "example_id": "c4ed07a9-b2ef-4074-bb24-55d5f89f3165",
                                                "sense_id": "3d831fc2-c835-3132-9605-ec331cee9132",
                                                "text": "He comes into the kitchen and cuddles your breasts while you make his roastbeef and horseradish on rye."
                                            },
                                            {
                                                "example_id": "d2548b75-c5e0-4e48-acf9-3626892cede4",
                                                "sense_id": "3d831fc2-c835-3132-9605-ec331cee9132",
                                                "text": "Several hours of voracious reading become preludes to joyous hours spent at table devouring Ernestine-Françoise's succulent chickens, roastbeefs, asparagus, chocolate creams, or his favorite dessert, strawberries crushed in cream cheese."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
