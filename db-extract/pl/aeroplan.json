                ],
                "senses": [
                    {
                        "sense_id": "249ce0f4-c1ce-3c97-8db5-ff67abdad4e8",
                        "entry_id": "febdcc7b-3e24-3c74-87be-f303fb707a4a",
                        "glosses": [
                            "Aeroplan, Flugzeug"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "c2188fd1-a98e-4943-88ec-e534bba3e71f",
                                "sense_id": "249ce0f4-c1ce-3c97-8db5-ff67abdad4e8",
                                "text": "Aeroplan wylądował na aerodromie.",
                                "translation": "Der Aeroplan ist auf dem Aerodrom gelandet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca5680b9-0c5c-4118-9674-010f14d1f977",
                        "source_entry_id": "febdcc7b-3e24-3c74-87be-f303fb707a4a",
                        "source_sense_id": "249ce0f4-c1ce-3c97-8db5-ff67abdad4e8",
                        "source_sense_description": "veraltet: Luftfahrt: Aeroplan, Flugzeug",
                        "target_lang_word": "Aeroplan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aeroplan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66d40744-49ae-3639-aedf-eb0a99d05df5",
                                        "entry_id": "0fee4e9d-55c0-3105-ae69-6b4bd979b8a0",
                                        "glosses": [
                                            "Flugzeug"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c836c578-5e1a-43bb-815d-dc08fe19c151",
                                                "sense_id": "66d40744-49ae-3639-aedf-eb0a99d05df5",
                                                "text": "„Fabian hatte mit einem Male die Vorstellung, er fliege dort oben im Aeroplan und sehe auf sich hinunter, auf den jungen Mann in der Joachimstaler Straße, im Gewimmel der Menge, im Lichtkreis der Laternen und Schaufenster, im Straßengewirr der fiebrig entzündeten Nacht.“"
                                            },
                                            {
                                                "example_id": "bb650fe7-af8a-44a9-8924-b25ba442ebf0",
                                                "sense_id": "66d40744-49ae-3639-aedf-eb0a99d05df5",
                                                "text": "„Über der Stadt kreisen Aeroplane und werfen Flugzettel herab.“"
                                            },
                                            {
                                                "example_id": "d4338162-4da1-4863-8252-62bc4ad33a90",
                                                "sense_id": "66d40744-49ae-3639-aedf-eb0a99d05df5",
                                                "text": "„Die Aeroplane, französische und solche mit dem Eisernen Kreuz, hängen als winziges Kinderspielzeug auf Drähten, sie, die wir riesenhaft über den Kolonnen schwirren sahen.“"
                                            },
                                            {
                                                "example_id": "91861c67-4a28-4128-b881-ef15bb616106",
                                                "sense_id": "66d40744-49ae-3639-aedf-eb0a99d05df5",
                                                "text": "„Aber das war ja auch wirklich welterschütternd und sprengte alle Rahmen vorstellbarer Situationen, wenn beim ›Prinz-Heinrich-Flug‹ im Jahr 1912, an dem sich alle Piloten des Reichs beteiligten und der von Ort zu Ort über ganz Deutschland ging, mehr als hundert Aeroplane, gebrechliche, feindrahtige Gestelle, Euler-Doppeldecker und Eindecker-Tauben, in langen Abständen auf dem ›Großen Sand‹ zwischenlandeten, und man saß mit der Uhr in der Hand neben Goedeckers Morse-Apparat und stoppte mit: wer ist wo aufgestiegen, wer ist wo abgestürzt, wer ist noch in der Luft!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fb860ff-8d87-4693-a857-719234ea979f",
                        "source_entry_id": "febdcc7b-3e24-3c74-87be-f303fb707a4a",
                        "source_sense_id": "249ce0f4-c1ce-3c97-8db5-ff67abdad4e8",
                        "source_sense_description": "veraltet: Luftfahrt: Aeroplan, Flugzeug",
                        "target_lang_word": "Flugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "834901f4-f181-3de2-8d67-3e445c5518bc",
                                        "entry_id": "24befa72-d3fd-3996-86d1-7fc43598a2fe",
                                        "glosses": [
                                            "Luftfahrzeug, das schwerer als Luft ist und den aerodynamischen Auftrieb nutzt"
                                        ],
                                        "tags": [
                                            "Transport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16b16b9b-9ddb-4907-a2fa-25056c89c660",
                                                "sense_id": "834901f4-f181-3de2-8d67-3e445c5518bc",
                                                "text": "Flugzeuge gehören zu den sichersten Verkehrsmitteln."
                                            },
                                            {
                                                "example_id": "0230e434-7570-49be-8d62-da5e6d087399",
                                                "sense_id": "834901f4-f181-3de2-8d67-3e445c5518bc",
                                                "text": "„Als die Kameraleute das Flugzeug verlassen hatten, schaute ich zu der Landkarte auf dem Bildschirm, auf der nun Asien im Mittelpunkt stand.“"
                                            },
                                            {
                                                "example_id": "fed03d85-2a78-494e-8560-437aa781969d",
                                                "sense_id": "834901f4-f181-3de2-8d67-3e445c5518bc",
                                                "text": "„Endlich, am späten Nachmittag, kamen Flugzeuge, einige Spitfire und Mustangs, die aus Richtung Flensburg oder Schleswig hereindrehten, um im Tiefflug über uns hinwegzuflitzen und auf die Nordsee hinaus zu verschwinden.“"
                                            },
                                            {
                                                "example_id": "734202c0-8c83-437d-baa9-94794e00b879",
                                                "sense_id": "834901f4-f181-3de2-8d67-3e445c5518bc",
                                                "text": "„Plötzlich sinkt das Flugzeug im Gleitflug zu Boden, ehe ich mich noch anschnallen kann, saust der Apparat senkrecht herunter und bohrt sich mit der Spitze in den Acker.“"
                                            },
                                            {
                                                "example_id": "e94dcd91-bcde-4890-9c0f-b2e3d2628b63",
                                                "sense_id": "834901f4-f181-3de2-8d67-3e445c5518bc",
                                                "text": "„Im Flugzeug hatte er sich Mühe gegeben mit sich selbst.“"
                                            },
                                            {
                                                "example_id": "0c407828-82c7-4af6-a851-50aec318f238",
                                                "sense_id": "834901f4-f181-3de2-8d67-3e445c5518bc",
                                                "text": "„Dann beschrieb das Flugzeug eine Kurve auf den offenen Ozean hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
