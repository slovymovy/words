                        "cross_references": [
                            {
                                "target_word": "irreversibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "793adf36-95ad-3805-b9d3-ef9ebcb27fc7",
                                        "entry_id": "af279339-d4e1-3879-a8bd-b0177f422c03",
                                        "glosses": [
                                            "The quality of being irreversible; the lack of an ability to be reversed."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f4761c8-cf4a-44c3-842f-3ba741a2d0cf",
                                                "sense_id": "793adf36-95ad-3805-b9d3-ef9ebcb27fc7",
                                                "text": "1806, Samuel Barnard, The Essence, Spirituality, and Glorious Issue, of the Religion of Christ Jesus, to All God's Chosen, W. Nicholson, page 279,\nNow if the irreversibility of God's gifts to his people, be considered, what joy for those who feel within a wicked heart."
                                            },
                                            {
                                                "example_id": "22de059a-b30c-42da-8c57-a2bad6c13fcd",
                                                "sense_id": "793adf36-95ad-3805-b9d3-ef9ebcb27fc7",
                                                "text": "1911, Power, Hill Pub. Co., page 171,\nBut because of irreversibilities in the engine, all of this theoretical conversion is not realized and some internal energy remains in the steam exhausting from the engine."
                                            },
                                            {
                                                "example_id": "b893b1a2-d462-466d-98a3-09fa9306a095",
                                                "sense_id": "793adf36-95ad-3805-b9d3-ef9ebcb27fc7",
                                                "text": "2007, Mark Currie, About Time: Narrative, Fiction and the Philosophy of Time, Edinburgh University Press, →ISBN, page 103,\nPaul Horwich, for example, in Asymmetries in Time, includes the laws of thermodynamics in a list of ten temporally asymmetric phenomena which operate in our conceptual system. Seen in this way, where the irreversibility of time is inseparable from rationality itself, the argument against backwards time tends to be expressed in terms of consequences, or the fear that time reversal is paramount to irrationality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
