                        "sense_id": "b2959e8b-8f40-31ba-b3f4-7df3788084a9",
                        "entry_id": "dd5bfd75-5b8a-3389-8057-2b838f4a0985",
                        "glosses": [
                            "iemand van Marokkaans afkomst"
                        ],
                        "tags": [
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "535e5b1b-4ca7-47ce-9782-bcc1594fd8f3",
                                "sense_id": "b2959e8b-8f40-31ba-b3f4-7df3788084a9",
                                "text": "Ajouad El Miloudi (29) wilde tijdens het maken van zijn nieuwe programma „Ajouad: kaaskop of mocro?” vier tot vijf keer stoppen."
                            },
                            {
                                "example_id": "b3a4bbd6-9b55-44f2-af36-49e193ff3a6e",
                                "sense_id": "b2959e8b-8f40-31ba-b3f4-7df3788084a9",
                                "text": "Een mocro zegt tegen een andere mocro: Jij kan zeker geen halloween achterstevoren zeggen! Zegt die ander dus: Nee wollah!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "417ac4a0-20a3-49c8-8df8-67184794d080",
                        "source_entry_id": "dd5bfd75-5b8a-3389-8057-2b838f4a0985",
                        "source_sense_id": "b2959e8b-8f40-31ba-b3f4-7df3788084a9",
                        "source_sense_description": "(informeel) ± Marokkaan, iemand van Noordafrikaanse afkomst",
                        "target_lang_word": "Nafri",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
