                "senses": [
                    {
                        "sense_id": "d889b097-c488-3e26-9eb8-5ed11fc0eb15",
                        "entry_id": "5f0718d8-b569-35df-9030-d50ae1d86eff",
                        "glosses": [
                            "strong liquor distilled from juniper berries and cherries"
                        ],
                        "tags": [
                            "dated",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "5f8d84eb-fa01-4e12-a9dd-0879cd4f70f6",
                                "sense_id": "d889b097-c488-3e26-9eb8-5ed11fc0eb15",
                                "text": "Krambambuli, das ist der Titel\nDes Tranks, der sich bei uns bewährt;\nEs ist ein ganz probates Mittel,\nWenn uns was Böses widerfährt.\nDes Abends spät, des Morgens früh\nTrink ich mein Glas Krambambuli.\n Krambimbambambuli, Krambambuli!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1553e5f8-feb6-3d1b-97cd-6550fa4e7bdd",
                        "entry_id": "5f0718d8-b569-35df-9030-d50ae1d86eff",
                        "glosses": [
                            "crambambuli (drink of rum mixed with sugar and set alight before drinking)"
                        ],
                        "tags": [
                            "dated",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "5c81ea7d-a365-41fe-ab7f-67417eaf0062",
                                "sense_id": "1553e5f8-feb6-3d1b-97cd-6550fa4e7bdd",
                                "text": "Der Crambambuli besteht aus Rotwein, der mit Orangeschalen und Nelken erhitzt und mit Zucker vermischt wird, der mit Arrak abgebrannt wurde und dabei zu Karamel schmolz."
                            }
                        ]
                    }
                ],
