                "senses": [
                    {
                        "sense_id": "0d2ce1a1-18e9-3cd6-94e9-5ecdb2e0b38d",
                        "entry_id": "b7f0ffa0-23c1-3f59-8dd6-e89c99abead0",
                        "glosses": [
                            "Ort (meist Hafenanlage), an dem ein Verband von Kriegsschiffen der Vereinigten Staaten Station bezogen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "218631b3-c2ca-4c25-9b23-08ec261a42e0",
                                "sense_id": "0d2ce1a1-18e9-3cd6-94e9-5ecdb2e0b38d",
                                "text": "„Der Name des US-Flottenstützpunktes Pearl Harbor auf der Hawaii-Insel Oahu wurde weltweit bekannt durch den Angriff der Japaner am 7. 12. 1941, bei dem ein Teil der amerikanischen Pazifikflotte vernichtet und der bis dahin auf Europa beschränkte Krieg zum Weltkrieg ausgeweitet wurde.“"
                            },
                            {
                                "example_id": "918d9fdd-508f-45e1-8deb-4a1cc49585c6",
                                "sense_id": "0d2ce1a1-18e9-3cd6-94e9-5ecdb2e0b38d",
                                "text": "„Die Verlegung des Fernost-Hauptquartiers der amerikanischen Streitkräfte von Tokio nach dem US-Flottenstützpunkt Pearl Harbour ist der letzte Schritt einer Teilabrüstung im Westpazifik, wie sie nach Washingtoner Informationen auch für Europa beabsichtigt ist: Ohne ein gegenseitiges Abkommen zogen die USA und Rotchina ihre Truppen aus Korea bis auf einen kleinen Rest ab.“"
                            },
                            {
                                "example_id": "143c7e14-e7cf-4775-a199-b79a4261396d",
                                "sense_id": "0d2ce1a1-18e9-3cd6-94e9-5ecdb2e0b38d",
                                "text": "„Der US-Flottenstützpunkt Guantánamo auf Kuba gehört zu den am schärfsten bewachten Militärcamps der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
