                ],
                "senses": [
                    {
                        "sense_id": "fb3c456a-d26a-3097-9eec-7f90e6ed9c0c",
                        "entry_id": "479f5b9a-6720-3301-8957-f6c48a2928bf",
                        "glosses": [
                            "äußerst positive Entwicklung, die bei etwas zu Wachstum, zu einem Fortschritt oder einer sonstigen Verbesserung führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45d9ecc1-380f-481d-8779-099c0ab759bc",
                                "sense_id": "fb3c456a-d26a-3097-9eec-7f90e6ed9c0c",
                                "text": "„Und der Gedeih des Oberammergauer Nepps wurde weltweit bekannt: 1950 mußte jeder Kartenkäufer gleich drei Übernachtungen und entsprechende Mahlzeiten buchen, 1960 immer noch zweimal im Dorf schlafen und sich dort beköstigen.“"
                            },
                            {
                                "example_id": "5152b7f3-8dea-414c-87bc-4ced5eb33e84",
                                "sense_id": "fb3c456a-d26a-3097-9eec-7f90e6ed9c0c",
                                "text": "„Das ist theoretisch wiederum ganz in Ordnung — in der Wirtschaft kontrolliert der Aufsichtsrat ja auch den Vorstand, aber im allgemeinen nur zum Gedeih des Unternehmens und nicht um Eigeninteressen durchzusetzen oder um Wichtigtuereien an den Tag legen zu können.“"
                            },
                            {
                                "example_id": "b39fd9a0-fe89-4b1c-970f-de6a0b0fcfdf",
                                "sense_id": "fb3c456a-d26a-3097-9eec-7f90e6ed9c0c",
                                "text": "„Denn man hält eine Temperatur von 25 Grad Celsius für nötig zum Gedeih der Nation, 365 Tage im Jahr und 24 Stunden am Tag, dafür sorgt die Klima-Anlage.“"
                            },
                            {
                                "example_id": "a4eb7d48-503b-417c-b7ca-7ee92badde91",
                                "sense_id": "fb3c456a-d26a-3097-9eec-7f90e6ed9c0c",
                                "text": "„Für viele Wissensarbeiter sind der sommerliche E-Mail-Check und kurze Update-Telefonate mit den Kollegen daheim oft nicht Pflicht, sondern willkommener Sozialkontakt, Befriedigung natürlicher Neugierde auf Fortgang und Gedeih begonnener Projekte.“"
                            },
                            {
                                "example_id": "1ad6750c-b45a-44ca-a645-ddcdc51c410c",
                                "sense_id": "fb3c456a-d26a-3097-9eec-7f90e6ed9c0c",
                                "text": "„Die von den OÖNachrichten auf Leseranregung initiierte Ideenbörse zum Wohl und Gedeih Gmundens ist die Fortsetzung unserer großen Fragebogenaktion.“"
                            },
                            {
                                "example_id": "e1ed76e5-2ce9-4e33-89b1-c2f3126d467e",
                                "sense_id": "fb3c456a-d26a-3097-9eec-7f90e6ed9c0c",
                                "text": "Zu sehr und lange genug hatte sich die Religion mit dem Wohl und Wehe des Menschen auf Gedeih und Verderb verschwistert."
                            },
                            {
                                "example_id": "e87c4542-ab2c-4042-b785-15f2e6ad8d57",
                                "sense_id": "fb3c456a-d26a-3097-9eec-7f90e6ed9c0c",
                                "text": "Die Geiseln waren ihren Entführern auf Gedeih und Ungedeih ausgeliefert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
