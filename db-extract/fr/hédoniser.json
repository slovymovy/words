                ],
                "senses": [
                    {
                        "sense_id": "0f13163f-7f66-3c23-ac0e-225e5a28ebf6",
                        "entry_id": "da3b0fd3-dfa6-3d8d-86b6-89fbd92cd76b",
                        "glosses": [
                            "Donner un caractère hédonique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c9321e2-2e15-449b-8fcc-cd2f537732f8",
                                "sense_id": "0f13163f-7f66-3c23-ac0e-225e5a28ebf6",
                                "text": "Le chômage est encore supportable, les inquiétudes de l’avenir ont alors moins de poids que les désirs de libérer et d’hédoniser le présent."
                            },
                            {
                                "example_id": "a0d58649-0297-4655-bc82-856970ad2b61",
                                "sense_id": "0f13163f-7f66-3c23-ac0e-225e5a28ebf6",
                                "text": "L'art sulpicien témoigne d'une époque également matérialiste, qui tenta d'hédoniser la religion, de la rendre proche et plaisante."
                            },
                            {
                                "example_id": "871c93f5-348e-4313-a5d6-07964b5d9e2d",
                                "sense_id": "0f13163f-7f66-3c23-ac0e-225e5a28ebf6",
                                "text": "Les cosmétiques ne sont qu’une porte d’entrée de choix pour un marché masculin qui se dérationalise pour « s'émotionaliser », se sensibiliser, se sensualiser… « s'hédoniser »."
                            }
                        ]
                    }
                ],
