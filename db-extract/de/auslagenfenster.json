                    {
                        "sense_id": "3cf4a9b7-2018-3258-bad3-e49c623ad0d6",
                        "entry_id": "ab3278b5-0e2f-39bf-9a5e-1686d1b1b325",
                        "glosses": [
                            "Fenster, durch das Straßenpassanten die ausgestellte Ware betrachten können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bb099ba-e1f6-4e01-834c-ed598d4ef6a2",
                                "sense_id": "3cf4a9b7-2018-3258-bad3-e49c623ad0d6",
                                "text": "Das Auslagenfenster des Kaufhauses wurde kreativ dekoriert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bc41832-d5d8-4677-b255-21dd35454945",
                        "source_entry_id": "ab3278b5-0e2f-39bf-9a5e-1686d1b1b325",
                        "source_sense_id": "3cf4a9b7-2018-3258-bad3-e49c623ad0d6",
                        "source_sense_description": "Fenster, durch das Straßenpassanten die ausgestellte Ware betrachten können",
                        "target_lang_word": "shop window",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shop window",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cff0c86c-fcfb-3532-a6b2-29bf9e6658bd",
                                        "entry_id": "afbc59ac-7ed5-331f-9383-8ed8bf9b7937",
                                        "glosses": [
                                            "A large window at the front of a shop, behind which items for sale are displayed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6908e088-1207-4ff1-b738-0ffc866f1e5d",
                                                "sense_id": "cff0c86c-fcfb-3532-a6b2-29bf9e6658bd",
                                                "text": "The passenger carriage was recognised as one of the \"shop windows\" of the railways and thus an essential element in the important work of achieving a greatly improved public image."
                                            },
                                            {
                                                "example_id": "45b86001-d1d5-411a-ad79-f330780c80e0",
                                                "sense_id": "cff0c86c-fcfb-3532-a6b2-29bf9e6658bd",
                                                "text": "The enthusiasm with which the private industry has treated the high speed rail concept can do the Corporation some good, and maybe even encourage the completion of the originally proposed electrification from New Haven to Boston. It will then have a high speed 'shop window', comparable with any in the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c075621-2cc6-441b-bfc3-02b8ed352e66",
                        "source_entry_id": "ab3278b5-0e2f-39bf-9a5e-1686d1b1b325",
                        "source_sense_id": "3cf4a9b7-2018-3258-bad3-e49c623ad0d6",
                        "source_sense_description": "Fenster, durch das Straßenpassanten die ausgestellte Ware betrachten können",
                        "target_lang_word": "devanture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "devanture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1baa69ca-01ae-33ed-915a-089e523b6bbb",
                                        "entry_id": "b212cd6c-81b4-3437-a7c0-313d55434dba",
                                        "glosses": [
                                            "Face antérieure, on dit plutôt aujourd’hui la façade."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d2d432-b901-4dd6-83f8-f2a88a3cc7b2",
                                                "sense_id": "1baa69ca-01ae-33ed-915a-089e523b6bbb",
                                                "text": "Cependant, au milieu de la chaussée, des nègres se poursuivaient à coup de boules de neige et parfois, une de ces boules, manquant son but, s’écrasait contre une devanture […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92ce72a4-d3dc-3c4c-9334-85b8c48054cd",
                                        "entry_id": "b212cd6c-81b4-3437-a7c0-313d55434dba",
                                        "glosses": [
                                            "Revêtement de bois, de fer ou de vitrerie qui garnit le devant d’une boutique, d’un magasin, etc."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aea7f5e0-eacc-43b3-a7bf-02a81a074221",
                                                "sense_id": "92ce72a4-d3dc-3c4c-9334-85b8c48054cd",
                                                "text": "Une pluie glacée tombait dans les rues miroitantes. Je marchais le long des boutiques, m’appuyant au rebord des devantures pour ne point m’écrouler sur le trottoir."
                                            },
                                            {
                                                "example_id": "72c9d394-8aff-434e-bbb3-abf66a19e726",
                                                "sense_id": "92ce72a4-d3dc-3c4c-9334-85b8c48054cd",
                                                "text": "Nous descendîmes, le long des devantures baissées, la rue noire et déserte lorsqu’un taxi que j’arrêtai, se rangea contre le trottoir, nous chargea et sur la seule indication : « Au bal du Saint-Martin », partit à toute allure."
                                            },
                                            {
                                                "example_id": "7a346d63-9e6c-4e28-b809-5a9e9834fcf6",
                                                "sense_id": "92ce72a4-d3dc-3c4c-9334-85b8c48054cd",
                                                "text": "Le blizzard est complétement déchaîné et la neige tombe si vite et si dru que les bâtiments ont l'air de fantômes. Des congères commencent déjà à se former devant les devantures des magasins de Main Street."
                                            },
                                            {
                                                "example_id": "64945950-e08b-4d1d-88b9-5a70332c710e",
                                                "sense_id": "92ce72a4-d3dc-3c4c-9334-85b8c48054cd",
                                                "text": "Il traversa la porte d'entrée et découvrit, dans la lumière blême des lampadaires, trois garçons, une collection de bombes de peinture alignée à leurs pieds, qui taggaient la devanture de la librairie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de3c35cf-09ea-3355-8e38-f500d4196a33",
                                        "entry_id": "b212cd6c-81b4-3437-a7c0-313d55434dba",
                                        "glosses": [
                                            "Vitrine, étalage d’un magasin."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "784b023f-9a43-44ae-9e81-6d718809d99e",
                                                "sense_id": "de3c35cf-09ea-3355-8e38-f500d4196a33",
                                                "text": "Quand il rentra dans les rues, les passants qui se coudoyaient aux lueurs des devantures de boutiques lui faisaient l’effet d’une éternelle allée et venue de spectres autour de lui."
                                            },
                                            {
                                                "example_id": "8f98ebe9-13b6-4ffc-83ce-fd20e6e91283",
                                                "sense_id": "de3c35cf-09ea-3355-8e38-f500d4196a33",
                                                "text": "Parmi les montres qui pendaient à la devanture de M. Goulden, il s’en trouvait une toute petite, quelque chose de tout à fait joli […]"
                                            },
                                            {
                                                "example_id": "db789dc4-6b0d-4753-a9a6-19e38fdddd92",
                                                "sense_id": "de3c35cf-09ea-3355-8e38-f500d4196a33",
                                                "text": "[…] elles sont bordées de maisons à quatre étages, avec des magasins aux devantures soignées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae9ab6e7-dd44-3de3-8851-6dbe86c3953f",
                                        "entry_id": "b212cd6c-81b4-3437-a7c0-313d55434dba",
                                        "glosses": [
                                            "Plâtres que les couvreurs mettent au devant des souches de cheminées pour raccorder les tuiles ou les ardoises."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dacca5e6-9381-30dd-b147-c9f6ee7f0de3",
                                        "entry_id": "b212cd6c-81b4-3437-a7c0-313d55434dba",
                                        "glosses": [
                                            "Poitrine de femme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
