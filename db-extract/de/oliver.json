                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f7cae97-0ee3-417e-97ef-6858ff7fd73a",
                        "source_entry_id": "65623002-322b-3d74-a695-ab1ba0815a0f",
                        "source_sense_id": "6079fe82-39f9-3180-b814-63b912126e79",
