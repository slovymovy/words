                "senses": [
                    {
                        "sense_id": "41e0844d-4f6f-3bbd-a8b6-f8be9b3452cf",
                        "entry_id": "0a7ff773-27e7-3ac9-b9de-b7c162b19aae",
                        "glosses": [
                            "ботан. вечнозелёное хвойное растение (дерево или кустарник) семейства кипарисовых (лат. Thuja)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9670b322-295e-452d-be69-18f04d189057",
                                "sense_id": "41e0844d-4f6f-3bbd-a8b6-f8be9b3452cf",
                                "text": "Каменистая земля, пахучие заросли туи, пустое море и далёкие Судакские горы — вот всё, что окружало нас в Алуште."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3304b91a-7b71-4d4e-8bdb-70c22ef50c1d",
                        "source_entry_id": "0a7ff773-27e7-3ac9-b9de-b7c162b19aae",
                        "source_sense_id": "41e0844d-4f6f-3bbd-a8b6-f8be9b3452cf",
                        "target_lang_word": "thuja",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thuja",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fadc2b8b-717c-3f68-82bd-47fd070028f9",
                                        "entry_id": "f2ae5b02-3a18-3eba-8c15-f0c1ce4b0d66",
                                        "glosses": [
                                            "A tree of the genus Thuja."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fde6e5cb-d82e-40ab-bf74-c30934f5df26",
                                                "sense_id": "fadc2b8b-717c-3f68-82bd-47fd070028f9",
                                                "text": "She walked among the thuja trees in the garden and wept: over the book, over her children, over her lost country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f0fd063-4e2e-4cb3-b331-1864e80969f8",
                        "source_entry_id": "0a7ff773-27e7-3ac9-b9de-b7c162b19aae",
                        "source_sense_id": "41e0844d-4f6f-3bbd-a8b6-f8be9b3452cf",
