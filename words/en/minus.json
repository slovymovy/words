{
    "word_family": [
        "subtraction",
        "negative"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "786fbacc-d489-3d49-983f-d8a0fbc001ab",
                    "sense_definition": "Reduced by a specific number or quantity in a mathematical operation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten <w>minus</w> four equals six.",
                            "target_lang_translations": {
                                "ru": "Десять <w>минус</w> четыре равно шести."
                            }
                        },
                        {
                            "text": "The teacher asked the students to calculate twelve <w>minus</w> five.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил учеников вычислить двенадцать <w>минус</w> пять."
                            }
                        }
                    ],
                    "antonyms": [
                        "plus"
                    ],
                    "common_phrases": [
                        "ten minus four",
                        "minus equals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшенный на определенное число или количество в математической операции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "математический знак вычитания"
                            },
                            {
                                "target_lang_word": "без",
                                "target_lang_sense_clarification": "за вычетом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6b04404-fe7a-38bf-934b-33ef0493f496",
                    "sense_definition": "Lacking or without something that is usually present.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He arrived at the party <w>minus</w> his shoes after the long walk.",
                            "target_lang_translations": {
                                "ru": "После долгой прогулки он пришел на вечеринку <w>без</w> туфель."
                            }
                        },
                        {
                            "text": "I had to leave the house <w>minus</w> my coat because I was in a hurry.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось выйти из дома <w>без</w> пальто, потому что я очень спешил."
                            }
                        }
                    ],
                    "synonyms": [
                        "lacking",
                        "without"
                    ],
                    "common_phrases": [
                        "minus my coat",
                        "minus his glasses"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in a slightly humorous or informal way"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие чего-либо, что обычно присутствует."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без",
                                "target_lang_sense_clarification": "отсутствие предмета"
                            },
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "разговорное обозначение потери или отсутствия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7588a64f-b22b-3cfd-bf2f-88ad7a00f401",
                    "sense_definition": "Being below zero on a scale, especially for temperature.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "scale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>minus</w> ten degrees outside today.",
                            "target_lang_translations": {
                                "ru": "Сегодня на улице <w>минус</w> десять градусов."
                            }
                        },
                        {
                            "text": "The temperature dropped to <w>minus</w> five during the night.",
                            "target_lang_translations": {
                                "ru": "Ночью температура упала до <w>минус</w> пяти."
                            }
                        }
                    ],
                    "synonyms": [
                        "below zero"
                    ],
                    "common_phrases": [
                        "minus ten degrees",
                        "minus five"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ниже нуля по шкале, особенно для температуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "отрицательная температура"
                            },
                            {
                                "target_lang_word": "ниже нуля",
                                "target_lang_sense_clarification": "о температуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d656d150-b9e3-3caf-9845-80e9bf067c0d",
                    "sense_definition": "Representing a negative quantity or a reduction.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant noted a <w>minus</w> number in the final report.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер отметил <w>отрицательное</w> число в итоговом отчете."
                            }
                        },
                        {
                            "text": "We need to account for the <w>minus</w> values in this spreadsheet.",
                            "target_lang_translations": {
                                "ru": "Нам нужно учесть <w>отрицательные</w> значения в этой таблице."
                            }
                        }
                    ],
                    "synonyms": [
                        "negative"
                    ],
                    "common_phrases": [
                        "minus number",
                        "minus value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представляющий отрицательную величину или уменьшение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрицательный",
                                "target_lang_sense_clarification": "о числах или величинах"
                            },
                            {
                                "target_lang_word": "минусовой",
                                "target_lang_sense_clarification": "относящийся к минусу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcf73e4b-e7fe-3b86-a1be-b19f2b7b5382",
                    "sense_definition": "Ranking slightly below a specific grade or rating.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was disappointed to receive a B <w>minus</w> on her final essay.",
                            "target_lang_translations": {
                                "ru": "Она была расстроена, получив «четверку» <w>с минусом</w> за итоговое эссе."
                            }
                        },
                        {
                            "text": "The student worked hard to improve his grade from a C <w>minus</w>.",
                            "target_lang_translations": {
                                "ru": "Студент усердно работал, чтобы исправить свою оценку «удовлетворительно» <w>с минусом</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "B minus",
                        "A minus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранг чуть ниже определенной оценки или рейтинга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с минусом",
                                "target_lang_sense_clarification": "об оценке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc5020c1-afc5-36cb-b5a9-775caad5ff62",
                    "sense_definition": "Having less money than before; in a state of financial loss.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the failed investment, he found himself several thousand pounds <w>minus</w>.",
                            "target_lang_translations": {
                                "ru": "После неудачной инвестиции он оказался <w>в минусе</w> на несколько тысяч фунтов."
                            }
                        },
                        {
                            "text": "The company ended the quarter <w>minus</w> by a significant margin.",
                            "target_lang_translations": {
                                "ru": "Компания закончила квартал <w>в убытке</w> со значительным отрывом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pounds minus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий меньше денег, чем раньше; в состоянии финансового убытка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в минусе",
                                "target_lang_sense_clarification": "финансовый убыток"
                            },
                            {
                                "target_lang_word": "в убытке",
                                "target_lang_sense_clarification": "потеря денег"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b0f4270-4bc0-3f2f-91c3-dfc00c373b26",
                    "sense_definition": "A disadvantage, drawback, or negative aspect of something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pros_cons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must weigh the plusses and <w>minuses</w> of moving to a new city.",
                            "target_lang_translations": {
                                "ru": "Мы должны взвесить все плюсы и <w>минусы</w> переезда в новый город."
                            }
                        },
                        {
                            "text": "One major <w>minus</w> of the job is the long commute.",
                            "target_lang_translations": {
                                "ru": "Один из главных <w>недостатков</w> этой работы — долгая дорога."
                            }
                        }
                    ],
                    "synonyms": [
                        "defect",
                        "deficiency",
                        "drawback",
                        "flaw",
                        "shortcoming"
                    ],
                    "antonyms": [
                        "advantage",
                        "bonus",
                        "boon",
                        "gain",
                        "plus"
                    ],
                    "common_phrases": [
                        "plusses and minuses",
                        "major minus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаток, изъян или отрицательная сторона чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "отрицательная сторона"
                            },
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "изъян"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ed3ab92-43d1-3abb-8f85-99efea72ecbd",
                    "sense_definition": "The symbol (−) used to indicate subtraction or a negative value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student forgot to write the <w>minus</w> before the number.",
                            "target_lang_translations": {
                                "ru": "Ученик забыл написать <w>минус</w> перед числом."
                            }
                        },
                        {
                            "text": "Make sure you distinguish between the <w>minus</w> and the dash.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что вы различаете <w>минус</w> и тире."
                            }
                        }
                    ],
                    "antonyms": [
                        "plus",
                        "plus sign"
                    ],
                    "common_phrases": [
                        "minus sign"
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ (−), используемый для обозначения вычитания или отрицательного значения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "математический знак"
                            },
                            {
                                "target_lang_word": "знак минуса",
                                "target_lang_sense_clarification": "графический символ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "663e3aa8-057d-3920-bffe-a9308f493c13",
                    "sense_definition": "A quantity that is less than zero.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final result of the calculation was a <w>minus</w>.",
                            "target_lang_translations": {
                                "ru": "Итоговым результатом вычисления стала <w>отрицательная величина</w>."
                            }
                        },
                        {
                            "text": "In this equation, the <w>minus</w> represents a debt.",
                            "target_lang_translations": {
                                "ru": "В этом уравнении <w>минус</w> обозначает долг."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Величина, которая меньше нуля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрицательная величина",
                                "target_lang_sense_clarification": "математический термин"
                            },
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "отрицательный результат"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7feb543a-ed71-3ca5-95d6-cf51b8f1e404",
                    "sense_definition": "To perform the mathematical operation of subtraction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>minused</w> the expenses from the total revenue to find the profit.",
                            "target_lang_translations": {
                                "ru": "Он <w>вычел</w> расходы из общей выручки, чтобы найти прибыль."
                            }
                        },
                        {
                            "text": "Try <w>minussing</w> the smaller number from the larger one.",
                            "target_lang_translations": {
                                "ru": "Попробуй <w>отнять</w> меньшее число из большего."
                            }
                        }
                    ],
                    "common_phrases": [
                        "minussing the total"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used by children or in informal contexts instead of 'subtract'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять математическую операцию вычитания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычитать",
                                "target_lang_sense_clarification": "математическое действие"
                            },
                            {
                                "target_lang_word": "отнимать",
                                "target_lang_sense_clarification": "разговорное о вычитании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e045dcf1-1b1e-3440-b33f-e86c08448564",
                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Minus</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Минус</w> жила в этом городе на протяжении многих поколений."
                            }
                        },
                        {
                            "text": "I am looking for a person named Mr. <w>Minus</w>.",
                            "target_lang_translations": {
                                "ru": "Я ищу человека по фамилии господин <w>Минус</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "rare family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Минус",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
