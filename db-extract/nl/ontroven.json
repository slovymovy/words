                "forms": [],
                "senses": [
                    {
                        "sense_id": "7425a642-299c-32ed-82d3-d1a55d78a021",
                        "entry_id": "02d869e2-e5a5-3fb7-b5ae-8587cc4e73de",
                        "glosses": [
                            "iets van de eigenaar afnemen zonder toestemming van die eigenaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ea48f8-0750-4937-8f06-7beaa32b1e26",
                                "sense_id": "7425a642-299c-32ed-82d3-d1a55d78a021",
                                "text": "Emo eindigde met de woorden: „Want door Gods genade leven wij in Friesland in een vrijheid die zo groot is, dat de bisschop ons door de zijnen nog geen kuiken met geweld zou kunnen ontroven.”"
                            },
                            {
                                "example_id": "c8b4e4d0-6946-4921-94c0-e9a6c1c7aac8",
                                "sense_id": "7425a642-299c-32ed-82d3-d1a55d78a021",
                                "text": "Komt er een moment dat we gaan inzien dat we daarmee onszelf benadelen, onze voorouders onteren en de generaties na ons een kostbaar bezit ontroven? Ik hoop het. Ongefundeerd is die hoop niet: ons is immers de eeuw in het hart gelegd."
                            }
                        ]
                    }
                ],
