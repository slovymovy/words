                        "entry_id": "28f50f1b-1413-3893-b5d5-dc4514881a1e",
                        "glosses": [
                            "Perte de tout ou partie des feuilles d’une plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caaca48c-0ddc-4f22-98a0-26006d818410",
                                "sense_id": "166d04ad-3c9e-3883-8d3e-fc799e480b74",
                                "text": "Ces auteurs constataient aussi que les arbres défoliés mouraient le plus souvent non de la défoliation elle-même, mais de complications provenant surtout de l’invasion des racines par l’Armillaria."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "209c9735-b7fe-4e0f-a2f1-2e9f19f2d26e",
                        "source_entry_id": "28f50f1b-1413-3893-b5d5-dc4514881a1e",
                        "source_sense_id": "166d04ad-3c9e-3883-8d3e-fc799e480b74",
                        "target_lang_word": "Blattfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blattfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67a710f5-da3d-3edb-a53c-dacddf91699a",
                                        "entry_id": "ea54dcd7-272d-3319-bb98-7e9e48e53e92",
                                        "glosses": [
                                            "der Abwurf der Blätter eines Gewächses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9868d65-129f-4133-9373-b8a28e286f27",
                                                "sense_id": "67a710f5-da3d-3edb-a53c-dacddf91699a",
                                                "text": "„Denn sie können sich den Aufwand sparen, den grünen Blattfarbstoff (Chlorophyll) vor dem Blattfall abzubauen.“"
                                            },
                                            {
                                                "example_id": "d8353440-8d95-4c81-978b-1c68c0cc25fc",
                                                "sense_id": "67a710f5-da3d-3edb-a53c-dacddf91699a",
                                                "text": "„Bei laubabwerfenden Pflanzen vollzieht sich der Blattfall nach der Bildung einer Abscissionszone im Blattstiel, typischerweise in der Nähe des Knotens.“"
                                            },
                                            {
                                                "example_id": "46c8d57c-4bad-4a03-9579-afb7eb0f29e0",
                                                "sense_id": "67a710f5-da3d-3edb-a53c-dacddf91699a",
                                                "text": "„Hier kommt es zu einer Anreicherung dieser Säure und damit zum Blattfall und Schließung der Stomata (Spaltöffnungen).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
