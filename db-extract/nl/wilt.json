                "senses": [
                    {
                        "sense_id": "5486dea3-b34d-362b-a1d8-d710db66fd73",
                        "entry_id": "171fc60a-383c-38fa-aed8-c5b0ef40b715",
                        "glosses": [
                            "tweede persoon enkelvoud tegenwoordige tijd van willen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a5da330-60cc-459a-9519-1feb4b2bd2ff",
                                "sense_id": "5486dea3-b34d-362b-a1d8-d710db66fd73",
                                "text": "Jij wilt."
                            },
                            {
                                "example_id": "fe02eb4c-19ab-437f-bbc3-8298355aead8",
                                "sense_id": "5486dea3-b34d-362b-a1d8-d710db66fd73",
                                "text": "Het is nooit te laat om aan jezelf te werken en het blijft altijd een keuze of je knorrig of vrolijk door het leven wilt gaan."
                            },
                            {
                                "example_id": "d92740fe-8137-4b48-aec6-172b77a3c59e",
                                "sense_id": "5486dea3-b34d-362b-a1d8-d710db66fd73",
                                "text": "'Pak zoveel je wilt,' zegt ze, terwijl er wat kruimels in het rond vliegen."
                            },
                            {
                                "example_id": "cc6e036e-b0f0-46bd-aa71-b5fa2d43a180",
                                "sense_id": "5486dea3-b34d-362b-a1d8-d710db66fd73",
                                "text": "' 'Ik zég wat ik echt bedoel, maar jij wilt nooit accepteren dat mensen ook echt bedoelen wat ze zeggen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4a48476-819e-3b4a-aa26-aac73f9eac45",
                        "entry_id": "171fc60a-383c-38fa-aed8-c5b0ef40b715",
