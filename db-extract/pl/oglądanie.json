                                "example_id": "1e2a29c8-e1b0-415c-9e9f-a7680dcebad3",
                                "sense_id": "bcd8c2f3-8093-34e1-8e17-ca7c8f944b45",
                                "text": "Mojego męża nie interesuje nic poza oglądaniem telewizji."
                            },
                            {
                                "example_id": "c9d98bc8-951d-4965-840c-692c651cf26d",
                                "sense_id": "bcd8c2f3-8093-34e1-8e17-ca7c8f944b45",
                                "text": "Dziś umówiliśmy się na oglądanie nowego mieszkania."
