                        "translation_id": "d0c418f4-8a95-4e39-92fd-e6e0f7202963",
                        "source_entry_id": "ded4f177-1fba-3d46-b482-4716f72d50ce",
                        "source_sense_id": "0c90dc8a-c08b-31d9-88f5-f3a149aa70bf",
                        "source_sense_description": "gedrag dat niet netjes is; gedrag dat onbehoorlijk is",
                        "target_lang_word": "rudeness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudeness",
