{
    "word_family": [
        "saccage",
        "saccagement",
        "saccageur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18db4d2c-4436-31a5-b988-28e8ec291662",
                    "sense_definition": "Mettre en grand désordre, dégrader ou détruire des biens matériels dans un lieu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les cambrioleurs ont complètement <w>saccagé</w> le salon avant de s'enfuir avec les bijoux."
                        },
                        {
                            "text": "Des manifestants violents ont <w>saccagé</w> plusieurs boutiques le long de l'avenue principale."
                        }
                    ],
                    "synonyms": [
                        "démolir",
                        "dégrader",
                        "détruire",
                        "vandaliser"
                    ],
                    "common_phrases": [
                        "saccager une maison",
                        "saccager un magasin"
                    ]
                },
                {
                    "sense_id": "9daf4b29-6dc6-3ed4-b5ea-7d6e5a864dbd",
                    "sense_definition": "Piller et dévaster totalement un lieu, particulièrement lors d'une guerre ou d'une invasion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pillage_guerre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée ennemie a <w>saccagé</w> la ville historique et brûlé de nombreux bâtiments anciens."
                        },
                        {
                            "text": "Les troupes ont <w>saccagé</w> le village frontalier pendant la nuit sans laisser de survivants."
                        }
                    ],
                    "synonyms": [
                        "dévaster",
                        "mettre à sac",
                        "piller",
                        "ravager"
                    ],
                    "common_phrases": [
                        "saccager la ville",
                        "saccager un village"
                    ]
                },
                {
                    "sense_id": "78cd4d3a-8e14-37ea-9386-6a7650a431f7",
                    "sense_definition": "Porter gravement atteinte à l'intégrité physique ou psychologique de quelqu'un, ruiner un avenir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce scandale judiciaire injuste a complètement <w>saccagé</w> la réputation et la carrière du ministre."
                        },
                        {
                            "text": "Une succession de mauvais choix a fini par <w>saccager</w> sa vie de famille et ses amitiés."
                        }
                    ],
                    "synonyms": [
                        "briser",
                        "détruire",
                        "ruiner"
                    ],
                    "common_phrases": [
                        "saccager une vie"
                    ]
                }
            ]
        }
    ]
}