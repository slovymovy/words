                                                "sense_id": "7d438105-1df8-3814-a93b-ff36420c5237",
                                                "text": "Nimm das Wurm und lege es schlafen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wurm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                        "entry_id": "bbbbb996-638d-319e-b0e3-2c9e3f93efc6",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437ee265-c746-496c-87ae-0d8152752022",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Frau Wurm ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "79228a14-22f9-430e-aac7-58ba6ec9478a",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Herr Wurm wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "77c1a589-a88c-4e98-bf43-3da0dfff0ca9",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Die Wurms fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "aaba25f0-59ca-4b2f-b07c-f61c10ac390c",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Der Wurm trägt nie die Schals, die die Wurm ihm strickt."
                                            },
                                            {
                                                "example_id": "c21cf382-280d-4839-8c26-85916e15c19c",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wurm kommt, geht der Herr Wurm.“"
                                            },
                                            {
                                                "example_id": "d800d9ab-b4e9-44a4-9466-3a5f2a9df1e4",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Wurm kommt und geht."
                                            },
                                            {
                                                "example_id": "5e9e540a-3db2-46b8-8abc-852bf3a77ac4",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Wurms kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wurm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d3694a7-4711-3746-a7e1-80886b0adf4c",
                                        "entry_id": "4d0b26b2-48e4-3656-99f0-772ee67d036b",
                                        "glosses": [
                                            "Fluss in Nordrhein-Westfalen, Deutschland, teilweise in den Niederlanden, durchfließt Aachen, teilweise Grenzfluss, linker Nebenfluss der Rur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeffa5ac-5269-4efb-8d9b-f3a5ccfab225",
                                                "sense_id": "4d3694a7-4711-3746-a7e1-80886b0adf4c",
                                                "text": "Wir überquerten die Wurm."
                                            },
                                            {
                                                "example_id": "74eca207-4744-478c-a38b-2e198e33bcc3",
                                                "sense_id": "4d3694a7-4711-3746-a7e1-80886b0adf4c",
                                                "text": "Die Kinder versuchten, in der Wurm zu baden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
