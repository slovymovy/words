                                            {
                                                "example_id": "ca511e8d-3c50-4b42-b9c9-39e82d448607",
                                                "sense_id": "14e7ebf5-3d5d-345a-8347-43f49d24f810",
                                                "text": "Kafkův hrdina Řehoř Samsa"
                                            },
                                            {
                                                "example_id": "3adb481c-7f6f-4dfd-8e0e-b87089bc7da2",
                                                "sense_id": "14e7ebf5-3d5d-345a-8347-43f49d24f810",
                                                "text": "papež Řehoř Veliký"
                                            },
                                            {
                                                "example_id": "903593a7-fcdc-43da-b671-e391bde199da",
                                                "sense_id": "14e7ebf5-3d5d-345a-8347-43f49d24f810",
                                                "text": "Sedláci mrzutě přecházejí. Na svatého Řehoře led plave do moře, žába hubu otevře, čáp letí od moře a — šelma sedlák, který neoře. — Ale jak proboha orat? Vždyť do hlíny, do bláta po břich by zapadali koně"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
