                        ]
                    },
                    {
                        "translation_id": "d6d2d360-4983-48ae-8a62-922770dcc92e",
                        "source_entry_id": "184cff30-ab51-30e2-802f-1d658aaba1f0",
                        "source_sense_id": "344b38eb-57b3-33c6-9753-7f5132e7de73",
                        "target_lang_word": "marinade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marinade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf261707-02e4-365c-b5c8-65521eeeab2e",
                                        "entry_id": "19cf8204-567c-3c57-ba3d-a228544a6a60",
                                        "glosses": [
                                            "A seasoned, often acidic liquid mixture in which food is marinated, or soaked, usually to flavor and prepare it for cooking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e0a6d2-707c-4648-b228-e5d13219a84c",
                                                "sense_id": "cf261707-02e4-365c-b5c8-65521eeeab2e",
                                                "text": "I like to use a lemon marinade with chicken."
                                            },
                                            {
                                                "example_id": "9921e061-4776-460d-9bdb-0cd7abd9d7f1",
                                                "sense_id": "cf261707-02e4-365c-b5c8-65521eeeab2e",
                                                "text": "How much marinade you need depends on the amount of food to be marinated."
                                            },
                                            {
                                                "example_id": "8618a447-f14e-448d-a9c1-f85bee4d99c1",
                                                "sense_id": "cf261707-02e4-365c-b5c8-65521eeeab2e",
                                                "text": "First, marinate the tofu. In a bowl, whisk the kecap manis, chilli sauce, and sesame oil together. Cut the tofu into strips about 1cm thick, mix gently (so it doesn't break) with the marinade and leave in the fridge for half an hour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marinade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b979ba-ee41-3fbc-8c33-ef12b1b5b13c",
                                        "entry_id": "daa20680-59b8-33a0-9719-d936d6506841",
                                        "glosses": [
                                            "To marinate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "985ced18-f885-49ba-ab74-9118d7006073",
                                                "sense_id": "c2b979ba-ee41-3fbc-8c33-ef12b1b5b13c",
                                                "text": "You could just use ordinary shop-bought kecap manis to marinade the meat, but making your own is easy, has a far more elegant fragrance and is, above all, such a great brag! Flavouring kecap manis is an intensely personal thing, so try this version now and next time cook the sauce down with crushed, split lemongrass and a shredded lime leaf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e451a48f-3525-4108-b3cd-b2582cfd219c",
                        "source_entry_id": "184cff30-ab51-30e2-802f-1d658aaba1f0",
                        "source_sense_id": "344b38eb-57b3-33c6-9753-7f5132e7de73",
