                        "examples": [
                            {
                                "example_id": "e747a977-ed7d-4945-bcec-d243edc96bb0",
                                "sense_id": "4f47f7c0-60b4-3d36-bc1d-bc2f0f0b8192",
                                "text": "„Der Clint hat sich umgedreht und versucht linkisch, aus dem The Black Sun zu fliehen, wobei er wie eine Flipperkugel von Tisch zu Tisch torkelt.“"
                            },
                            {
                                "example_id": "38e79c32-c0dc-4f3d-9f9a-c76782342491",
                                "sense_id": "4f47f7c0-60b4-3d36-bc1d-bc2f0f0b8192",
                                "text": "„In Baltimore kann einem jeder kleine Gangster erklären, dass ein 22er-Rundkopfprojektil, sobald es einmal durch die Haut eines Menschen gedrungen ist, herumhüpft wie eine Flipperkugel.“"
                            }
