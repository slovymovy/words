                "senses": [
                    {
                        "sense_id": "8caa7090-0d42-3162-9fa8-27804ff58dce",
                        "entry_id": "af4a8e8c-2384-331c-8d5e-434169b452a1",
                        "glosses": [
                            "уменьш.-ласк. к уха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e845adbf-393c-4bce-9253-9f3b5404660c",
                                "sense_id": "8caa7090-0d42-3162-9fa8-27804ff58dce",
                                "text": "Ушицу из лещиков на Петров День ставили, и киселёк молошный, и каша белая, и груздочки солёные с чёрной кашей, и земляники по блюдечку, девушки нанесли с порубок."
                            },
                            {
                                "example_id": "1e42ec7a-1b94-4764-9d76-fc269bb3fb32",
                                "sense_id": "8caa7090-0d42-3162-9fa8-27804ff58dce",
                                "text": "Или: ушица из стерляди, кулебяжка капустная, торт «Муравейник»."
                            }
                        ]
                    }
                ],
