                                        "glosses": [
                                            "Carencia de emoción o sensación."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51e8ae75-0813-41de-a545-94e0f69e24e6",
                        "source_entry_id": "9e27902b-c5f9-3999-b60c-c9021cb20c78",
                        "source_sense_description": "nonchalance",
                        "target_lang_word": "insouciance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insouciance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "414b2b5c-e1a3-3546-8046-f0a3dd9e56e6",
                                        "entry_id": "a8909b6e-97ec-3b61-831a-58d762dc32b1",
                                        "glosses": [
                                            "État ou caractère de celui qui est insouciant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b89cc6-c0cd-4dd1-8adf-f6a772ea7c91",
                                                "sense_id": "414b2b5c-e1a3-3546-8046-f0a3dd9e56e6",
                                                "text": "Rien ne pouvait être entrepris sous la domination incontestée de Richard, […], quoiqu’il tînt les rênes du gouvernement avec une sorte d’insouciance qui tendait tantôt à l’indulgence et tantôt au despotisme."
                                            },
                                            {
                                                "example_id": "f34b06aa-e503-4983-a437-e741503988ea",
                                                "sense_id": "414b2b5c-e1a3-3546-8046-f0a3dd9e56e6",
                                                "text": "Solange, jusqu’alors, avait toujours pris les événements de sa vie avec une certaine insouciance."
                                            },
                                            {
                                                "example_id": "d45a7be3-762d-4be0-bff9-68a3013cfc80",
                                                "sense_id": "414b2b5c-e1a3-3546-8046-f0a3dd9e56e6",
                                                "text": "On leur dénie l’un des droits les plus fondamentaux de l’enfance : le droit à l’insouciance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6053e77-9b44-4b24-bc95-08c54a5ff783",
                        "source_entry_id": "9e27902b-c5f9-3999-b60c-c9021cb20c78",
                        "source_sense_description": "nonchalance",
                        "target_lang_word": "Lässigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lässigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e818d74b-b899-39aa-a139-9afd58c81a7a",
                                        "entry_id": "48d7661c-312f-3ced-a6e1-e0363af72f2c",
                                        "glosses": [
                                            "Eigenschaft, lässig zu sein/die Dinge leicht zu nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88c7c0ce-efff-4f7d-951a-566661dc6fe2",
                                                "sense_id": "e818d74b-b899-39aa-a139-9afd58c81a7a",
                                                "text": "„Sie reisen billig, mit jener Lässigkeit und gelegentlichen Ausflügen in den Luxus, die wirklich wohlhabende Menschen sich leisten.“"
                                            },
                                            {
                                                "example_id": "a78e1b08-64b2-4fdb-b028-ac89ab849120",
                                                "sense_id": "e818d74b-b899-39aa-a139-9afd58c81a7a",
                                                "text": "„Mit Kim kehrt ein Spieler zurück, der Mitte der Nullerjahre die Golfwelt im Sturm erobert hatte mit einer wilden Mischung aus Talent, Lässigkeit und Angriffslust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
