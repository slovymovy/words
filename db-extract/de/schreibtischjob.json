                "senses": [
                    {
                        "sense_id": "641b856f-e98d-35f7-bec0-a298720c6344",
                        "entry_id": "89bc103e-7b00-3594-9924-ad31269f4ceb",
                        "glosses": [
                            "Arbeit, bei der man hauptsächlich am Schreibtisch sitzt, sich nicht viel bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c29a5e-ec45-4496-a7bb-8d74b89e0bc2",
                                "sense_id": "641b856f-e98d-35f7-bec0-a298720c6344",
                                "text": "„Früher oder später musste jeder Agent einsehen, dass seine großen Zeiten vorbei waren. Dann empfahl es sich normalerweise, jemandem einen Schreibtischjob zuzuweisen.“"
                            },
                            {
                                "example_id": "f418fa0d-1289-471b-8ad4-9560d613c377",
                                "sense_id": "641b856f-e98d-35f7-bec0-a298720c6344",
                                "text": "„›Ich habe einen Schreibtischjob in der Sicherheitsfirma übernommen, um mein Lösegeld abzuarbeiten, und danach war ich ein freier Mann.‹“"
                            },
                            {
                                "example_id": "ed7af547-1b48-49d5-9b38-9095d74de108",
                                "sense_id": "641b856f-e98d-35f7-bec0-a298720c6344",
                                "text": "„Victoria erklärte, dass die 1st Special Forces Operational Detachment-Delta, weithin bekannt als ›die Einheit‹, schon seit dreißig Jahren auch Frauen für den Kampfeinsatz rekrutierte, nicht etwa für Schreibtischjobs.“"
                            },
                            {
                                "example_id": "47fbd4ba-30b7-4b7b-9314-237f05bc0fc5",
                                "sense_id": "641b856f-e98d-35f7-bec0-a298720c6344",
                                "text": "„›Matt ist nicht mehr bei der SAD. Zuletzt habe ich gehört, dass er irgendwo in Südamerika einen Schreibtischjob hat. Paraguay, wenn ich mich nicht irre.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
