                "senses": [
                    {
                        "sense_id": "973f0043-292a-3079-bf0e-40167019991d",
                        "entry_id": "729aa72a-c4a9-3a7c-85b3-6e9f3a21fc92",
                        "glosses": [
                            "jednostka energii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8e804b4-6e76-47ec-9b9f-3cfdc8cc8e88",
                                "sense_id": "973f0043-292a-3079-bf0e-40167019991d",
                                "text": "Jeden elektronowolt jest to energia, jaką uzyskuje elektron, który jest przyspieszany napięciem równym jednemu woltowi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e933b4d-fd7e-4739-b9d1-0945bfca38d0",
                        "source_entry_id": "729aa72a-c4a9-3a7c-85b3-6e9f3a21fc92",
                        "source_sense_id": "973f0043-292a-3079-bf0e-40167019991d",
