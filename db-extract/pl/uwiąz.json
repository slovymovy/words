                        "translation_id": "ac937e36-8cae-47b4-9884-3c98aa951935",
                        "source_entry_id": "381ff325-51b8-3bae-8906-567d06a0cfe8",
                        "source_sense_id": "d07d45e4-0a29-3e3a-a450-47c1bc3b65c8",
                        "target_lang_word": "tether",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tether",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77769cf4-6b6f-35e3-b8ec-7ecf50f01986",
                                        "entry_id": "eee02cb6-70ab-370a-819d-7376d7df1f44",
                                        "glosses": [
                                            "A rope, cable etc. that holds something in place whilst allowing some movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99891700-8fc9-44da-879e-7f1f661f8a80",
                                                "sense_id": "77769cf4-6b6f-35e3-b8ec-7ecf50f01986",
                                                "text": "With the bulky, heavy helmet for the film strapped on, I was inside a fully immersive virtual world. With de la Peña playing minder and holding a tether which prevented me from bumping into walls, I somehow ended up inside the news story."
                                            },
                                            {
                                                "example_id": "5210fd7c-c09c-4c35-96ca-e3d33e6093d4",
                                                "sense_id": "77769cf4-6b6f-35e3-b8ec-7ecf50f01986",
                                                "text": "We suffer the weather / We bind and we tether / This nation together"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0cc6fb3-71e6-3557-8e74-aea6b17ccddb",
                                        "entry_id": "eee02cb6-70ab-370a-819d-7376d7df1f44",
                                        "glosses": [
                                            "The limit of one's abilities, resources, patience, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb48f7ac-c27f-42b3-8e9c-a96011f679ff",
                                                "sense_id": "f0cc6fb3-71e6-3557-8e74-aea6b17ccddb",
                                                "text": "Since his hours have increased, I feel that he is at the end of his tether."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc582ed4-152a-30a3-83d0-bd4ac9a5e13c",
                                        "entry_id": "eee02cb6-70ab-370a-819d-7376d7df1f44",
                                        "glosses": [
                                            "An attachment to a place, time, entity or person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a1a853-7642-4e8a-b213-e88fb607591f",
                                                "sense_id": "bc582ed4-152a-30a3-83d0-bd4ac9a5e13c",
                                                "text": "Despite moving, he maintained a strong tether to his culture back home."
                                            },
                                            {
                                                "example_id": "24d27565-439e-4af1-a347-aac1a40b33b7",
                                                "sense_id": "bc582ed4-152a-30a3-83d0-bd4ac9a5e13c",
                                                "text": "Deeper than speech our love, stronger than life our tether, / But we do not fall on the neck nor kiss when we come together."
                                            },
                                            {
                                                "example_id": "67ff54b6-625d-42a6-9d22-562472e5bda0",
                                                "sense_id": "bc582ed4-152a-30a3-83d0-bd4ac9a5e13c",
                                                "text": "what tethers us to gravity and light / has most to do with distance and the shapes / we find in water"
                                            },
                                            {
                                                "example_id": "29baa917-8fe1-4592-8230-a0aa88f3a246",
                                                "sense_id": "bc582ed4-152a-30a3-83d0-bd4ac9a5e13c",
                                                "text": "The tether to our national identity can never feel stronger than it does over a cup of bad arena coffee in the dead of winter."
                                            },
                                            {
                                                "example_id": "75421dc1-1843-4e20-9310-4b421b91cc10",
                                                "sense_id": "bc582ed4-152a-30a3-83d0-bd4ac9a5e13c",
                                                "text": "But for toddlers who have now lived nearly 16 months in varying degrees of social isolation, the tether to before has long faded, and they now face after without clear recollections of the world to which they are returning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca9646cb-0511-3385-ab4c-aa01dd9506fc",
                                        "entry_id": "eee02cb6-70ab-370a-819d-7376d7df1f44",
                                        "glosses": [
                                            "A strong rope or line that connects a sailor's safety harness to the boat's jackstay."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tether",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6f8f23d-9bbe-3fe7-8019-63e8bab71dc5",
                                        "entry_id": "0da6d9fa-8d62-326e-89f7-001da4a9bcbe",
                                        "glosses": [
                                            "To restrict with, or as if with, a tether."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd4f5d28-32c6-4727-83cc-0768a449de83",
                                                "sense_id": "d6f8f23d-9bbe-3fe7-8019-63e8bab71dc5",
                                                "text": "The cowboy tethered his horse outside the saloon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61540591-12f0-3583-a263-a58246887579",
                                        "entry_id": "0da6d9fa-8d62-326e-89f7-001da4a9bcbe",
                                        "glosses": [
                                            "To connect to something else."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3111c8d-b703-4362-aaba-abb70b48b1f0",
                                                "sense_id": "61540591-12f0-3583-a263-a58246887579",
                                                "text": "The younger Targaryen feels as though she’s lost any intimacy that tethered her to compassion and humanity, and so all that remains is the imperious need to rule that has driven her all these years, now bereft of the warmth that previously tempered her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "682633c5-0071-3590-9dec-d053dae3c2e8",
                                        "entry_id": "0da6d9fa-8d62-326e-89f7-001da4a9bcbe",
                                        "glosses": [
                                            "To connect to something else.",
                                            "To connect (a smartphone) to a personal computer in order to give the computer access to the phone's Internet connection."
                                        ],
