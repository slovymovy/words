                        "entry_id": "f4b3b376-3c96-32f6-a625-451283cf6a22",
                        "glosses": [
                            "szybkie spalanie materiału wybuchowego, jednak przebiegające stosunkowo łagodnie w stosunku do detonacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb56f8ac-b74f-4fd6-91a9-d4dfe794a253",
                                "sense_id": "25361a8d-c217-3ff0-a102-4d7ceae8f0fe",
                                "text": "Wszystkie założone środki bezpieczeństwa uwzględniają możliwość przejścia procesu deflagracji w detonację"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
