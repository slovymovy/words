                "senses": [
                    {
                        "sense_id": "d415f338-e6c8-32b3-9a8a-9867bd1b746d",
                        "entry_id": "e653d520-0044-3637-8137-c40e10d98e1b",
                        "glosses": [
                            "Gesamtheit der öffentlichen Einrichtungen, die für die Verwaltung einer Kolonie zuständig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc2d4c9-1fc7-4ca1-8ec8-1285d21ca6cc",
                                "sense_id": "d415f338-e6c8-32b3-9a8a-9867bd1b746d",
                                "text": "„Die spanische Kolonialverwaltung wurde über ihre Gesellschaft gestülpt: Aus der Ferne kam ein Vizekönig, aber die Mexica verwalteten sich weiterhin selbst.“"
                            },
                            {
                                "example_id": "4c69d899-1813-4952-bc11-c55bf8c926b5",
                                "sense_id": "d415f338-e6c8-32b3-9a8a-9867bd1b746d",
                                "text": "„1886 trat er in den Dienst der deutschen Kolonialverwaltung ein, die ihm die Erforschung des nördlichen Kameruner Hinterlandes von der Küste her übertrug.“"
                            },
                            {
                                "example_id": "01085da3-62cd-42c7-b982-49871a08fe63",
                                "sense_id": "d415f338-e6c8-32b3-9a8a-9867bd1b746d",
                                "text": "„Die Kolonialverwaltung ist alarmiert; 1950 verbietet sie die „Mau-Mau“, wie die Briten die Bewegung nennen (die genaue Herkunft des Wortes ist unklar; sicher ist nur, dass die Rebellen sich den Namen nicht selbst gegeben haben, sondern als Schimpfwort empfinden).“"
                            },
                            {
                                "example_id": "0a8c5cd7-5eef-40c4-95c6-0e0a64e88540",
                                "sense_id": "d415f338-e6c8-32b3-9a8a-9867bd1b746d",
                                "text": "„So fiel ihm auf, dass eine überraschende Zahl an Korrespondenten ihre Briefe außerhalb des offiziellen britischen Postmonopols mit privaten Zustelldiensten befördern ließen, um die Portozahlung zu Gunsten der ungeliebten Kolonialverwaltung zu vermeiden.“"
                            },
                            {
                                "example_id": "14684322-2bac-4e84-848e-bf2747e8ac22",
                                "sense_id": "d415f338-e6c8-32b3-9a8a-9867bd1b746d",
                                "text": "„Das Native Affairs Department, die für die Mehrheit der Bevölkerung zuständige Abteilung der Kolonialverwaltung, stand nicht mehr unter der direkten Kontrolle der BSAC.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
