                                "target_senses": [
                                    {
                                        "sense_id": "3574f5f4-dd66-3e5d-9834-b1dc148ab4a0",
                                        "entry_id": "c954984f-2b38-34cf-a8dc-2de0ee5c77ef",
                                        "glosses": [
                                            "referenziert einen bestimmten Zeitpunkt oder Zeitspanne, eine Verkürzung von: zu dieser Zeit"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96ba0f94-a6d2-3f45-b555-d2379c84abda",
                                        "entry_id": "c954984f-2b38-34cf-a8dc-2de0ee5c77ef",
                                        "glosses": [
                                            "gegenwärtig"
                                        ],
                                        "tags": [
                                            "wird der Zeitpunkt nicht angegeben",
                                            "ist meist der jetzige gemeint"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5b4ffbb-08bf-48f1-9445-38f008011075",
                                                "sense_id": "96ba0f94-a6d2-3f45-b555-d2379c84abda",
                                                "text": "Wir haben derzeit kein Brot, der Bäcker ist krank."
                                            },
                                            {
                                                "example_id": "f306140c-7a5b-4a96-b59a-8b242413b350",
                                                "sense_id": "96ba0f94-a6d2-3f45-b555-d2379c84abda",
                                                "text": "„Wenn man derzeit von Forderungen liest, auch den Fachhochschulen das Promotionsrecht einzuräumen, kann man sich die Ergebnisse vorstellen.“"
                                            },
                                            {
                                                "example_id": "dc8aa7bd-8129-49e9-ae8c-8071461bb272",
                                                "sense_id": "96ba0f94-a6d2-3f45-b555-d2379c84abda",
                                                "text": "„Gerade Romney, derzeit Gouverneur von Massachusetts, hat sich im Olympiabusiness als Krisenmanager einen ausgezeichneten Ruf erworben.“"
                                            },
                                            {
                                                "example_id": "da30185a-f3f0-48d8-8361-91e0fdddf8ba",
                                                "sense_id": "96ba0f94-a6d2-3f45-b555-d2379c84abda",
                                                "text": "„Alex Honnold, geboren 1985 in Sacramento, ist der derzeit mit Abstand beste Freikletterer der Welt. Und nachdem er in Valley Uprising schon als Nebendarsteller eine Rolle spielte, gehört ihm jetzt Free Solo ganz allein.“"
                                            },
                                            {
                                                "example_id": "1b8c06fc-e183-4d8a-8e59-872851f6aae8",
                                                "sense_id": "96ba0f94-a6d2-3f45-b555-d2379c84abda",
                                                "text": "„Laut Aussage der Veranstalter liege die Bestmarke im Drachensteigen derzeit bei 674 Fluggeräten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18120b1b-d505-372f-b831-476c2df3dc53",
                                        "entry_id": "c954984f-2b38-34cf-a8dc-2de0ee5c77ef",
                                        "glosses": [
                                            "damals"
                                        ],
                                        "tags": [
                                            "liegt der Zeitpunkt offensichtlich in der Vergangenheit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96c52188-dc36-4106-be3b-9d2fdb54c734",
                                                "sense_id": "18120b1b-d505-372f-b831-476c2df3dc53",
                                                "text": "Derzeit hatten wir noch alle Arbeit mit der Hand gemacht, heute helfen uns Maschinen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
