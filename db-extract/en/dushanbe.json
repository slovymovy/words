                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d07bc7ef-d4ef-4350-908b-03f671184ea5",
                                                "sense_id": "cd2436b9-7004-38d6-982b-2681fbd7507f",
                                                "text": "Pour autant, comme le décrit Eurasianet, Douchanbé est dans une posture délicate envers Kaboul. Le Tadjikistan exporte pour près de 45 millions de dollars d’électricité chaque année à l’Afghanistan, mais Kaboul est en déficit chronique de paiement."
                                            }
                                        ]
                                    }
                                ]
