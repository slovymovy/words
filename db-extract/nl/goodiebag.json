                    {
                        "sense_id": "569d5dc2-885d-3d69-9825-fea18b66b870",
                        "entry_id": "bc885817-9f72-39f7-847c-7d57fa770fae",
                        "glosses": [
                            "tas met kleine cadeautjes; tas met reclameartikelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cf2696a-8524-4b3a-b601-c7ac6e0149fb",
                                "sense_id": "569d5dc2-885d-3d69-9825-fea18b66b870",
                                "text": "De feestgangers konden overigens wel een goodiebag-boodschappenmandje vullen met gesponsorde artikelen."
                            },
                            {
                                "example_id": "73d3383a-b2bf-4ebd-b7c9-c168c8dc1af6",
                                "sense_id": "569d5dc2-885d-3d69-9825-fea18b66b870",
                                "text": "Als de meiden vanmiddag het voetbalcircuit doorlopen, is er voor de moeders ook wat te doen. Dat gaat echter alleen door als er genoeg moeders komen opdagen. Na afloop krijgen ze een goodiebag mee, met onder meer een gratis kaart voor de oefenwedstrijd tussen Nederland en IJsland, op 11 april in Doetinchem."
                            },
                            {
                                "example_id": "08f03b76-6658-46eb-a9e3-914c56029807",
                                "sense_id": "569d5dc2-885d-3d69-9825-fea18b66b870",
                                "text": "Na het zien van een stoere Amazoneprinses zelf wat stoeien in de keuken? In Leuven kregen vrouwelijke bioscoopgangers een opmerkelijke goodiebag mee naar huis na hun bezoek aan de actiefilm Wonder Woman."
                            }
                        ]
                    }
