                "senses": [
                    {
                        "sense_id": "f95be08b-b07e-32fa-9783-d637b7031608",
                        "entry_id": "0e54a440-e5a7-3930-9f81-972c960a5961",
                        "glosses": [
                            "Faire passer à des méthodes utilisant l'électronique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cced017e-0ab6-4938-98fa-4eaeeb21ba83",
                                "sense_id": "f95be08b-b07e-32fa-9783-d637b7031608",
                                "text": "Le défi est lancé : électroniser l'annuaire et, parallèlement, concevoir un terminal dont le mode d'interrogation serait à la portée de tous."
                            },
                            {
                                "example_id": "f4ed257a-de15-4152-85e8-59390f24abdb",
                                "sense_id": "f95be08b-b07e-32fa-9783-d637b7031608",
                                "text": "Décomposant celui-ci en fonctions, elle analyse la possibilité de les électroniser et de les rendre ainsi indépendantes d'une infrastructure physique."
                            },
                            {
                                "example_id": "5ccbb73a-8f05-4856-b13c-ac1723391833",
                                "sense_id": "f95be08b-b07e-32fa-9783-d637b7031608",
                                "text": "[…], des solutions de remplacement basées sur l'équipement seront adoptées : les fauteuils roulants s’électroniseront, les lits s’automatiseront, les robots nettoieront, les ordinateurs veilleront."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7075700-a6fe-363c-9814-009c71475556",
                        "entry_id": "0e54a440-e5a7-3930-9f81-972c960a5961",
                        "glosses": [
                            "Enrichir en électrons (par exemple via des ions négatifs)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cddb650-1e43-40cd-a780-812d5257f8d4",
                                "sense_id": "a7075700-a6fe-363c-9814-009c71475556",
                                "text": "Pour rendre conducteur un espace qui ne l’est pas, on peut donc songer soit à ioniser un gaz, soit, si l’on peut dire, à \"électroniser un vide\"."
                            }
                        ]
                    }
                ],
