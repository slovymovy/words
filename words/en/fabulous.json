                },
                {
                    "sense_id": "3af7f15b-00e5-3947-bb65-0a8aa87c319a",
                    "sense_definition": "So great or large that it is difficult to believe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extraordinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum houses a <w>fabulous</w> wealth of ancient artifacts.",
                            "target_lang_translations": {
                                "ru": "В музее хранится <w>баснословное</w> богатство древних артефактов.",
                                "nl": "Het museum herbergt een <w>fabelachtige</w> rijkdom aan oude artefacten."
                            }
                        },
                        {
                            "text": "He managed to accumulate a <w>fabulous</w> fortune in a very short time.",
                            "target_lang_translations": {
                                "ru": "Ему удалось сколотить <w>сказочное</w> состояние за очень короткое время.",
                                "nl": "Hij slaagde erin om in zeer korte tijd een <w>sprookjesachtig</w> fortuin te vergaren."
                            }
                        }
                    ],
                    "antonyms": [
                        "modest",
                        "small"
                    ],
                    "common_phrases": [
                        "fabulous wealth",
                        "fabulous fortune",
                        "fabulous success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настолько великий или огромный, что в это трудно поверить.",
                        "nl": "Zo groot of omvangrijk dat het moeilijk te geloven is."
                    },
