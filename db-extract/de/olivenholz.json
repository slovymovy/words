                "senses": [
                    {
                        "sense_id": "c2c6344b-e0d9-3aaf-869b-9883f4efde9c",
                        "entry_id": "8fd833a6-e81e-39c8-a1a5-42a06988a4a4",
                        "glosses": [
                            "Holz der Olive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2f50416-5419-4751-82d6-2866fb633e4a",
                                "sense_id": "c2c6344b-e0d9-3aaf-869b-9883f4efde9c",
                                "text": "„Olivenholz wird zu Möbeln, Musikinstrumenten oder Küchengeräten verarbeitet.“"
                            },
                            {
                                "example_id": "5d8e3ca8-ac19-4f04-88b1-581468242171",
                                "sense_id": "c2c6344b-e0d9-3aaf-869b-9883f4efde9c",
                                "text": "„Interessanterweise nutzten die jungsteinzeitlichen Jäger nicht immer nur eine Holzart für ihre Pfeile, sondern kombinierten in den Schäften auch härteres Olivenholz mit leichterem und flexiblerem Weiden- und Schilfholz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
