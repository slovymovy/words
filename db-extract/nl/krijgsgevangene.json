                                "sense_id": "1aa2cebb-85f3-3430-aa68-c89ce8e63fd9",
                                "text": "Rapport Amnesty International over krijgsgevangenen: ‘Rusland martelt en moordt in bezette gebieden Oekraïne’"
                            },
