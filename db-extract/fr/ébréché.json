                    {
                        "sense_id": "ca066721-36f2-3862-a4bd-cc60f26aa53c",
                        "entry_id": "cd3926c2-be3e-3219-bc54-f1f97ad51469",
                        "glosses": [
                            "Abimé par des fissures, des brèches, des fêlures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "423681be-6861-4250-b326-5158556e2b4b",
                                "sense_id": "ca066721-36f2-3862-a4bd-cc60f26aa53c",
                                "text": "Il se versait du saké dans un bol à riz ébréché, directement de sa grosse bouteille de deux litres."
                            },
                            {
                                "example_id": "21f86342-44ac-4490-814f-dcd01797bf04",
                                "sense_id": "ca066721-36f2-3862-a4bd-cc60f26aa53c",
                                "text": "Le 18, départ pour Arras, avec arrêt à Gouy-Servins, à 3 km. derrière Ablain-Saint-Nazaire. La tour ébréchée de Saint-Eloi domine le site."
                            },
                            {
                                "example_id": "185e034f-1908-4911-b339-bb47e084c26d",
                                "sense_id": "ca066721-36f2-3862-a4bd-cc60f26aa53c",
                                "text": "Devant une glace ébréchée, je me rase attentivement."
                            }
                        ]
