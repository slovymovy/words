        "nl-extract.jsonl": [
            {
                "entry_id": "6168c37f-ccbd-33ef-bc3e-573c73db6cee",
                "word": "puberen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "16dcec59-1f4b-355c-9aef-c7b23e231689",
                        "entry_id": "6168c37f-ccbd-33ef-bc3e-573c73db6cee",
                        "glosses": [
                            "het opstandige gedrag van jongeren tegenover de gevestigde orde en andere verschijnselen die ontstaan door de hormonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79f8fbc3-ce4d-4742-aaf0-8e36f1aeac85",
                                "sense_id": "16dcec59-1f4b-355c-9aef-c7b23e231689",
                                "text": "'Jongens krijgen van jongs af aan op hun donder. Maar door ze te remmen in hun beweging, krijgen ze een negatief zelfbeeld. Jongens trekken zich terug of worden boos. Ze willen ontsnappen aan de controle en als ze eenmaal gaan puberen barsten sommige jongens los. Dan gaan ze vechten, spijbelen of blowen.'"
                            },
                            {
                                "example_id": "1128f9da-86e4-4751-8f8a-8d11a8eb0f90",
                                "sense_id": "16dcec59-1f4b-355c-9aef-c7b23e231689",
                                "text": "Mijn zoon van 12 was eind vorig schooljaar druk met de musical van groep 8 én met puberen. Dat puberen zorgde ervoor dat er niet zoveel meer gedeeld werd met me op het gebied van veranderingen en meisjes. En wat er met de musical zou gebeuren moest ook een verrassing blijven."
                            }
                        ]
                    }
                ],
