                                            {
                                                "example_id": "09de30c1-3c20-4b40-8be8-f966106d2060",
                                                "sense_id": "d2d4a6e1-5b91-3cac-945e-ab53ca70dee7",
                                                "text": "Zamiast dyskietki lepiej użyj pamięci USB."
                                            },
                                            {
                                                "example_id": "677f05bf-73c4-4259-b30d-52ba2d042d77",
                                                "sense_id": "d2d4a6e1-5b91-3cac-945e-ab53ca70dee7",
                                                "text": "Przeczytać taką dyskietkę może tylko bardzo archaiczny komputer."
                                            },
                                            {
                                                "example_id": "7a55043d-5da1-4759-abbd-6952df168ba9",
                                                "sense_id": "d2d4a6e1-5b91-3cac-945e-ab53ca70dee7",
                                                "text": "Wymieniłam dwadzieścia dyskietek na jedną płytę kompaktową."
                                            }
