                        "target_lang_word": "caténaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caténaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dcebd85c-502c-3ea2-ade6-f66c4acf5c9f",
                                        "entry_id": "9e96f57a-ed86-3bdc-81ed-ff426d026674",
                                        "glosses": [
                                            "Forme que prend un câble (ou une chaîne) lorsqu’il est suspendu par ses extrémités et soumis à une force gravitationnelle uniforme (son propre poids)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b977c757-3439-34f8-b100-a5eff885c5eb",
                                        "entry_id": "9e96f57a-ed86-3bdc-81ed-ff426d026674",
                                        "glosses": [
                                            "Câble ou chaîne tendu en chaînette."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "084ccadf-e661-4e67-b228-03cc9198c48b",
                                                "sense_id": "b977c757-3439-34f8-b100-a5eff885c5eb",
                                                "text": "Les ponts suspendus se répandirent ensuite surtout aux États-Unis et en Grande-Bretagne. En 1822, à Annonay en Savoie, une petite passerelle d'essai fut construite avec des caténaires en fil de fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "965888ef-de5e-39be-8040-03a63085d925",
                                        "entry_id": "9e96f57a-ed86-3bdc-81ed-ff426d026674",
                                        "glosses": [
                                            "Ligne d’alimentation électrique constituée d’un ou de deux fils de contact suspendus par des pendules à un ou deux porteurs."
                                        ],
                                        "tags": [
                                            "Électrotechnique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a54a3147-3abf-4947-a704-7b18bf322e5d",
                                                "sense_id": "965888ef-de5e-39be-8040-03a63085d925",
                                                "text": "Sous l'influence des variations de température, les conducteurs de la caténaire s'allongent ou se raccourcissent ; il en résulte des variations de flèches des porteurs et des fils de contact."
                                            },
                                            {
                                                "example_id": "d96cbc91-cd53-44d8-9660-d2a2ae7a11cc",
                                                "sense_id": "965888ef-de5e-39be-8040-03a63085d925",
                                                "text": "À Limoges commençait la traction électrique. Au-dessus de la 6 212 étaient suspendues les premières caténaires. Elle entrait dans un monde automatique et glacé."
                                            },
                                            {
                                                "example_id": "281825a1-666a-47ab-a30d-e069feda88b0",
                                                "sense_id": "965888ef-de5e-39be-8040-03a63085d925",
                                                "text": "Le câble s’était échappé de la caténaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caténaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e74e17e4-ecaf-3cc1-afa7-31fb4b84e63b",
