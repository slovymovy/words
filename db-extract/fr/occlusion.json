                "forms": [
                    {
                        "form_id": "e048b1ee-3b28-40ac-8c34-d1676ecf4c52",
                        "entry_id": "c77c5172-b988-37e6-a2fd-ca2763bedcb9",
                        "tags": [
                            "plural"
                        ],
                        "form": "occlusions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "124a23e6-7e2d-35d7-a45d-9c0d70553c60",
                        "entry_id": "c77c5172-b988-37e6-a2fd-ca2763bedcb9",
                        "glosses": [
                            "Fermeture accidentelle, réflexe ou volontaire."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "93cc6c31-5259-3c91-985c-0d2bbb308fca",
                        "entry_id": "c77c5172-b988-37e6-a2fd-ca2763bedcb9",
                        "glosses": [
                            "Obstruction d'une ouverture naturelle par rapprochement de ses bords."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2e4dcbe-419d-48a5-8bc3-ed6d66be60fe",
                                "sense_id": "93cc6c31-5259-3c91-985c-0d2bbb308fca",
                                "text": "Occlusion des paupières, yeux fermés ou clos, paupières closes.\nCette affection est caractérisée par une sensibilité exagérée de l'œil à la lumière; de là une contraction spasmodique de l’iris, quelquefois avec occlusion complète de la pupille, de sorte que les personnes nyctalopes voient très-bien pendant la nuit, mais cessent de voir pendant le jour."
                            },
                            {
                                "example_id": "8d3e9cfd-49d7-490a-8110-abe4b20717b2",
                                "sense_id": "93cc6c31-5259-3c91-985c-0d2bbb308fca",
                                "text": "Un défaut d’occlusion de la mâchoire, un mauvais appui du pied sur le sol, des chocs et des traumatismes peuvent également déclencher des contractures et douleurs cervico-dorsales."
                            },
                            {
                                "example_id": "b03eb1a5-2951-4a73-8dae-407fffc74f94",
                                "sense_id": "93cc6c31-5259-3c91-985c-0d2bbb308fca",
                                "text": "Occlusion dentaire, état réflexe ou volontaire de contacts entre les mâchoires par l'intermédiaire de toutes les dents opposées."
                            },
                            {
                                "example_id": "e50b3a4c-8748-49e1-8e18-d0c79d9c2b57",
                                "sense_id": "93cc6c31-5259-3c91-985c-0d2bbb308fca",
                                "text": "Obstruction morbide d’un conduit naturel.\nOcclusion intestinale, arrêt du transit intestinal."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6961a8f-236f-3652-85dd-b70df27e3c8f",
                        "entry_id": "c77c5172-b988-37e6-a2fd-ca2763bedcb9",
                        "glosses": [
                            "Blocage de la vue d'un objet par un autre."
                        ],
                        "tags": [
                            "Infographie"
                        ],
                        "examples": [
                            {
                                "example_id": "bc781804-e54b-429c-aeb7-1236904c65c3",
                                "sense_id": "e6961a8f-236f-3652-85dd-b70df27e3c8f",
                                "text": "Occlusion ambiante, ombre de contact entre deux objets."
                            }
                        ]
                    },
                    {
                        "sense_id": "93f55908-0e43-3992-9740-d4b9697b0488",
                        "entry_id": "c77c5172-b988-37e6-a2fd-ca2763bedcb9",
                        "glosses": [
                            "Articulation faisant intervenir un blocage complet de l’écoulement de l’air au niveau de la bouche, du pharynx ou de la glotte"
                        ],
                        "tags": [
                            "Phonétique"
                        ],
                        "examples": []
                    }
