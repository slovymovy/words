                "senses": [
                    {
                        "sense_id": "4ec3b857-1462-3fc0-8508-32a4eb0f701b",
                        "entry_id": "e29ae323-bae8-334e-9739-3714571adf9e",
                        "glosses": [
                            "Gesamtheit der in einem Hotel arbeitenden Angestellten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41c58e97-5813-4c2c-b507-261f53c2e749",
                                "sense_id": "4ec3b857-1462-3fc0-8508-32a4eb0f701b",
                                "text": "„Man könnte die Daten mit denen der Polizisten, des Hotelpersonals und anderer Personen abgleichen, die später in Barschels Zimmer waren, um diese Personen als Spurenleger auszuschließen.“"
                            },
                            {
                                "example_id": "1da1822c-364c-4d12-a961-81860339d004",
                                "sense_id": "4ec3b857-1462-3fc0-8508-32a4eb0f701b",
                                "text": "„Der Spott des Hotelpersonals verstärkte ihren Überdruß und ihre Müdigkeit noch.“"
                            },
                            {
                                "example_id": "9f07b16e-5597-4c0c-bd8b-cba76ce03e60",
                                "sense_id": "4ec3b857-1462-3fc0-8508-32a4eb0f701b",
                                "text": "„Er verstand das Hotelpersonal, ohne daß es allzu deutlich zu werden brauchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
