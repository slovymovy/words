                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baseball",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03571810-49db-3a4b-a471-8c686640eb54",
                                        "entry_id": "c017940d-0010-3eec-86b3-9b0d68252a41",
                                        "glosses": [
                                            "Mannschaftssportart, bei der ein Ball mit einem Schläger möglichst gut geschlagen werden muss"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4e5d6aa-ed32-486d-a6fe-f3b907f5e931",
                                                "sense_id": "03571810-49db-3a4b-a471-8c686640eb54",
                                                "text": "Baseball ist eine der wichtigsten Sportarten der USA."
                                            },
                                            {
                                                "example_id": "4b92af00-420b-431a-aa3b-b5fafca74dcc",
                                                "sense_id": "03571810-49db-3a4b-a471-8c686640eb54",
                                                "text": "Auf der IOC Session in Buenos Aires fällt die Entscheidung: Bleibt Ringen olympisch oder rückt Squash oder Baseball ins Programm der Sommerspiele? Für alle drei Sportverbände ist es ein Millionenspiel."
                                            },
                                            {
                                                "example_id": "9e6d5623-cf27-48a9-abc9-0541408c7d04",
                                                "sense_id": "03571810-49db-3a4b-a471-8c686640eb54",
                                                "text": "Klinsmanns Verdienste für den Fußball im Land des American Football, Baseball und Basketball sind vor allem außerhalb des Platzes groß."
                                            },
                                            {
                                                "example_id": "b7999335-033d-4217-bb06-4c017ba18896",
                                                "sense_id": "03571810-49db-3a4b-a471-8c686640eb54",
                                                "text": "„In Ländern, in denen Baseball unbekannt war, war die häufigste Kopfbedeckung eine Baseballmütze.“"
                                            },
                                            {
                                                "example_id": "f32f6b56-3cc4-4cea-b461-06872ba90a2b",
                                                "sense_id": "03571810-49db-3a4b-a471-8c686640eb54",
                                                "text": "„Es ist, als würde man mit ein paar Zwanzigjährigen Baseball spielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b6b9518-370d-3aaf-88f8-c0dfb115cf07",
                                        "entry_id": "c017940d-0010-3eec-86b3-9b0d68252a41",
                                        "glosses": [
                                            "der in [1] verwendete Ball"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b78de6-9c9f-41ec-b27e-72405362289c",
                                                "sense_id": "0b6b9518-370d-3aaf-88f8-c0dfb115cf07",
                                                "text": "Aus dem letzten Saisonspiel hatten wir einen Baseball mit nach Hause gebracht."
                                            },
                                            {
                                                "example_id": "67f0530a-6b60-4730-ab17-7c50aaeea9a7",
                                                "sense_id": "0b6b9518-370d-3aaf-88f8-c0dfb115cf07",
                                                "text": "„Lee Jay drehte den Baseball in der Handfläche herum und beugte sich vor, um die Pyramide gründlich ins Auge zu fassen, wobei er unter seinen Haaren hervorspähte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca18f448-85cc-4b85-bab0-742d918ca9fd",
                        "source_entry_id": "8ed93d67-548b-38c5-a247-a6f13e5a1fc1",
