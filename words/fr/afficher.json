    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2855b883-31d8-360a-a45c-baa17b4a9c63",
                    "sense_definition": "Apposer une affiche ou un avis sur un mur ou un panneau pour faire savoir quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur va <w>afficher</w> les résultats des examens sur la porte du bâtiment."
                        },
                        {
                            "text": "La mairie a décidé d'<w>afficher</w> un avis important pour prévenir les habitants."
                        }
                    ],
                    "synonyms": [
                        "placarder"
                    ],
                    "antonyms": [
                        "désafficher"
                    ],
                    "common_phrases": [
                        "afficher une annonce",
                        "afficher les résultats"
                    ]
                },
                {
                    "sense_id": "b36101c4-138a-36cb-bcae-c2c44a368423",
                    "sense_definition": "Faire apparaître des données, un texte ou une image sur un écran d'ordinateur ou de téléphone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon vieil ordinateur refuse d'<w>afficher</w> la vidéo correctement sans ralentir."
                        },
                        {
                            "text": "Le nouvel écran peut <w>afficher</w> des images en très haute définition."
                        }
                    ],
                    "antonyms": [
                        "désafficher"
                    ],
                    "common_phrases": [
                        "afficher une page",
                        "afficher les détails"
                    ]
                },
                {
                    "sense_id": "5e64f79c-aa61-31e2-bf25-2a31d471a6ba",
                    "sense_definition": "Montrer ostensiblement une opinion, une attitude ou un sentiment de manière visible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré la pression des journalistes, le ministre continue d'<w>afficher</w> un calme parfait."
                        },
                        {
                            "text": "Elle n'a jamais craint d'<w>afficher</w> ouvertement ses opinions lors des réunions."
                        }
                    ],
                    "common_phrases": [
                        "afficher un sourire",
                        "afficher ses opinions"
                    ]
                },
                {
                    "sense_id": "1c97bafe-125a-3ec7-9d98-9d901992613a",
                    "sense_definition": "Humilier, ridiculiser ou dénoncer publiquement quelqu'un, en particulier sur les réseaux sociaux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a publié cette capture d'écran pour l'<w>afficher</w> devant tous ses camarades."
                        },
                        {
                            "text": "Fais attention à ce que tu dis si tu ne veux pas te faire <w>afficher</w> en ligne."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot des jeunes"
                        }
                    ]
                },
                {
                    "sense_id": "3c033063-aa53-3ae1-876f-27551a1d87ad",
                    "sense_definition": "Se montrer en public avec une personne en officialisant ou en révélant une relation intime.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux célébrités évitent de s'<w>afficher</w> ensemble pour préserver leur vie privée."
                        },
                        {
                            "text": "Il n'hésite plus à s'<w>afficher</w> aux bras de sa nouvelle compagne lors des réceptions."
                        }
                    ],
                    "common_phrases": [
                        "s'afficher ensemble"
                    ]
                }
            ]
        }
    ]
