                                        "examples": [
                                            {
                                                "example_id": "01f4c29e-27de-4c19-841b-de67503b421d",
                                                "sense_id": "2a6dca34-dbf8-318d-a5be-69a9fc5b8602",
                                                "text": "Hij zat de hele tijd maar te zeuren over zijn weltschmerz."
                                            }
