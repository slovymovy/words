                "senses": [
                    {
                        "sense_id": "f426350e-0d82-3650-9b4f-26d2bca98388",
                        "entry_id": "8d9b6721-83f5-390b-aca2-d3c9bf02140e",
                        "glosses": [
                            "Handel mit Drogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b96ae1cb-adc8-4dd1-ab58-86f3ecbca070",
                                "sense_id": "f426350e-0d82-3650-9b4f-26d2bca98388",
                                "text": "„Lorenzo hatte in einem langen Telefongespräch mit Marcello viel darüber erfahren, was Marie anscheinend von den Drogengeschäften, der Geldwäsche und dem oft nicht legalen Handel mit Autos wusste.“"
                            },
                            {
                                "example_id": "10c8bcf2-88d9-4df8-bf45-037bece3095e",
                                "sense_id": "f426350e-0d82-3650-9b4f-26d2bca98388",
                                "text": "„Nicht alles stimmt, was Hassan uns über das Drogengeschäft erzählt.“"
                            },
                            {
                                "example_id": "9f3f2b08-0fcf-4732-b31c-6e56bb1fc794",
                                "sense_id": "f426350e-0d82-3650-9b4f-26d2bca98388",
                                "text": "„Er war in keine Drogengeschäfte verwickelt.“"
                            },
                            {
                                "example_id": "f9d013fb-bd2b-45a4-aeff-277dc79690d7",
                                "sense_id": "f426350e-0d82-3650-9b4f-26d2bca98388",
                                "text": "„Dort besaß Mendy Weiss eine Wohnung, die er für seine Drogengeschäfte nutzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
