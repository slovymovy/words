                    {
                        "translation_id": "3b55679f-3e40-44b9-aae3-9bf4a7663e08",
                        "source_entry_id": "c5ace967-23b0-3d78-9055-a4c35ce46921",
                        "source_sense_description": "highest title for chess player",
                        "target_lang_word": "grand maître",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grand maître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f53c015-56f6-3043-9a9b-36afda57f231",
                                        "entry_id": "39beb174-9fce-327a-8304-14fac14a6c3a",
                                        "glosses": [
                                            "Dirigeant d’un ordre ou d’une confrérie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "770c88ce-abff-479f-96cf-88cf64e93116",
                                                "sense_id": "6f53c015-56f6-3043-9a9b-36afda57f231",
                                                "text": "Ce n'était pas sans une vive appréhension que le Grand Orient se voyait imposer un Grand Maitre absolument étranger à la Maçonnerie et qui ne devint Maçon qu'après sa haute investiture."
                                            },
                                            {
                                                "example_id": "5a6b267f-7bb0-4b9d-8563-9fd40e556f2a",
                                                "sense_id": "6f53c015-56f6-3043-9a9b-36afda57f231",
                                                "text": "Le président de la République est le Grand Maître de la Légion d'honneur."
                                            },
                                            {
                                                "example_id": "177554bb-e857-4015-8d3d-86ec4202bb59",
                                                "sense_id": "6f53c015-56f6-3043-9a9b-36afda57f231",
                                                "text": "'Les chefs des ordres de chevaleries chrétiens sont des Maître ou Grands Maître"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c1ab212-cf70-3fff-b553-dfb2809cbf9f",
                                        "entry_id": "39beb174-9fce-327a-8304-14fac14a6c3a",
                                        "glosses": [
                                            "Champion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee5c68ba-1e2f-461f-baac-cba28de7be42",
                                                "sense_id": "6c1ab212-cf70-3fff-b553-dfb2809cbf9f",
                                                "text": "Aux échecs, grand maître international est le plus haut titre décerné par la Fédération internationale des échecs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "610d86f2-bb92-37c6-8e07-57dae64e2e5e",
                                        "entry_id": "39beb174-9fce-327a-8304-14fac14a6c3a",
                                        "glosses": [
                                            "Artiste peintre dont la réputation est reconnue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6de9f93-81a4-4371-85b3-f9c704dda3a6",
                                                "sense_id": "610d86f2-bb92-37c6-8e07-57dae64e2e5e",
                                                "text": "Pontagnac. — Il y a là surtout quelques toiles… Ah !… des toiles ! de parents de grands maîtres…\nVatelin. — N’est-ce pas ?\nPontagnac. — Entre autres un Corot fils et un Rousseau cousin, vraiment, ce n’est pas la peine d’avoir des maîtres eux-mêmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1695ab89-229f-4690-bf2f-ea1d6bb34e9b",
                        "source_entry_id": "c5ace967-23b0-3d78-9055-a4c35ce46921",
                        "source_sense_description": "highest title for chess player",
                        "target_lang_word": "Großmeister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großmeister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47d794ba-1249-3709-bc85-6944452fa331",
                                        "entry_id": "df0196a9-991f-32b0-bac9-276407b6e2fa",
                                        "glosses": [
                                            "höchster, internationaler Titel für Turnierschachspieler"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eafa9ed4-0ed3-4fdb-82c0-6685c70dd196",
                                                "sense_id": "47d794ba-1249-3709-bc85-6944452fa331",
                                                "text": "„Am Berliner Ring ging es wieder rund: Insgesamt 20 Großmeister saßen beim Heimspielwochenende des SC Eppingen in der Hardwaldhalle an den Brettern − […].“"
                                            },
                                            {
                                                "example_id": "6882bf81-36bc-4a6b-8b55-179759dfb3b5",
                                                "sense_id": "47d794ba-1249-3709-bc85-6944452fa331",
                                                "text": "„Als die FIDE 1950 die ersten offiziellen 27 Großmeister ernannte, befanden sich darunter mit Jacques Mieses und Friedrich Sämisch auch zwei Deutsche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "304004e8-734a-369f-9b29-ee405b97382d",
                                        "entry_id": "df0196a9-991f-32b0-bac9-276407b6e2fa",
                                        "glosses": [
                                            "höchster Titel einiger Ritterorden"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b7e6e43-87f5-4708-8b60-7f815b0b6aed",
                                                "sense_id": "304004e8-734a-369f-9b29-ee405b97382d",
                                                "text": "„Am 18. März 1314 wurde der letzte Großmeister des Templerordens, Jacques de Molay, zusammen mit Geoffroy de Charnay in Paris auf dem Scheiterhaufen verbrannt, nachdem man ihn zunächst zu lebenslanger Kerkerhaft verurteilt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5765a3de-da2c-3331-b80b-354596bccb7e",
                                        "entry_id": "df0196a9-991f-32b0-bac9-276407b6e2fa",
                                        "glosses": [
                                            "Titel eines Vorsitzenden einer Großloge"
                                        ],
                                        "tags": [
                                            "Freimaurerei",
                                            "Rosenkreuzer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ab96363-1e6a-49aa-856c-7427d1628298",
                                                "sense_id": "5765a3de-da2c-3331-b80b-354596bccb7e",
                                                "text": "„Für die Verwaltung der Großloge (Schriftverkehr, Buchführung, Reden) und für zeremonielle Aufgaben (Logengründungen, Ehrungen) stehen dem Großmeister der sogenannte Großbeamtenrat zur Seite.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "24cdbaa2-b29b-381d-8ad0-aa075196d941",
                                        "entry_id": "df0196a9-991f-32b0-bac9-276407b6e2fa",
                                        "glosses": [
                                            "Person, die auf einem bestimmten Fachgebiet Großes/Wichtiges geleistet hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02ce3765-0b4e-41cc-bb9d-d710d90da8ec",
                                                "sense_id": "24cdbaa2-b29b-381d-8ad0-aa075196d941",
                                                "text": "„Aus Wien winkt Ferdinand Kürnberger. Der historische Großmeister des österreichischen Feuilletons (1821-1879) hat sich mal als kurioser \"Karnevalsphilosoph\" versucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
