                "senses": [
                    {
                        "sense_id": "38e09873-7c37-3bec-849f-1f5208b450ed",
                        "entry_id": "a75f0cae-d5c4-3c40-b082-b4b108254608",
                        "glosses": [
                            "That has been presenced; that has been made present."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "53547f76-2e46-46f2-a452-b4561ee2016a",
                                "sense_id": "38e09873-7c37-3bec-849f-1f5208b450ed",
                                "text": "Doubtless there are occasions when the beauty of the heights of the ideal becomes uniquely profiled and the correlative fusion of I's becomes uniquely presenced, as perhaps in worship, great works of art, acts of heroism, mass political actions, etc."
                            },
                            {
                                "example_id": "37aa1966-a9da-4960-a80a-16aca732dc83",
                                "sense_id": "38e09873-7c37-3bec-849f-1f5208b450ed",
                                "text": "[…]every time you shift the degree of magnification, new complexity, new activity becomes presenced."
                            },
                            {
                                "example_id": "8f5cc150-ff52-4b78-b114-ad7c389f4fcd",
                                "sense_id": "38e09873-7c37-3bec-849f-1f5208b450ed",
                                "text": "Building a monument, or a house, is a social act in which the relationship between earth and sky, people and the divine, becomes presenced at a particular place or is brought into coexistence in a performative act."
                            }
                        ]
                    }
                ],
