                ],
                "senses": [
                    {
                        "sense_id": "922e0926-0618-313e-a2df-e1ffb88c0fdc",
                        "entry_id": "e2eddd14-145d-34bb-a1a5-1c71e8e792fb",
                        "glosses": [
                            "Détacher les objets du fond sur lequel on peint, soit en marquant leurs contours, soit par l’opposition des couleurs."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "879cd87f-2422-4087-a2ec-ebffc70ecdf2",
                                "sense_id": "922e0926-0618-313e-a2df-e1ffb88c0fdc",
                                "text": "On réchampit de noir les lettres jaunes ou dorées des enseignes, afin d’obtenir la netteté et la correction que le premier travail n’a pas pu produire."
                            },
                            {
                                "example_id": "a64fb103-fa19-4592-a398-417ccf89f2a7",
                                "sense_id": "922e0926-0618-313e-a2df-e1ffb88c0fdc",
                                "text": "[Cette maison de brique] était réchampie de blanc et possédait des fenêtres à meneaux qu’on avait fait venir d’Angleterre."
                            },
                            {
                                "example_id": "60a441ff-4fc8-4852-b6c5-435eb80a4e89",
                                "sense_id": "922e0926-0618-313e-a2df-e1ffb88c0fdc",
                                "text": "— Viscéralement convaincu qu’une œillade du Sort orienterait sa vie, Hervé ralentit encore ; tendu, anxieux, en quête d’un signe, il scruta les entrailles de la forêt qu’un raide soleil réchampissait."
                            }
                        ]
                    },
                    {
                        "sense_id": "54bdc239-1622-3ffa-b52f-12ba12a0c7ab",
                        "entry_id": "e2eddd14-145d-34bb-a1a5-1c71e8e792fb",
                        "glosses": [
                            "Réparer avec du blanc de céruse les bavures que la couleur jaune destinée à recevoir la dorure a pu faire sur les fonds que l'on veut conserver blanc."
                        ],
                        "tags": [
                            "Dorure"
                        ],
                        "examples": [
                            {
                                "example_id": "07f85095-f3b2-4780-848f-1fa954bfe1bf",
                                "sense_id": "54bdc239-1622-3ffa-b52f-12ba12a0c7ab",
                                "text": "Détails pour 50 pieds de moulures de 2° et demi de développement, bronzées par les mêmes ouvriers, compris le temps et la marchandise pour les réchampir de deux couches de fond, ainsi que le temps de les frotter et de les brunir ensuite, […]."
                            },
                            {
                                "example_id": "11f1cca7-eb94-456c-a502-da9a06e5f4b5",
                                "sense_id": "54bdc239-1622-3ffa-b52f-12ba12a0c7ab",
                                "text": "Pour réchampir les moulures, on broie les couleurs à l’huile de noix et on détrempe à l’essence; on applique deux couches généralement plus foncées que le fond."
                            }
                        ]
                    }
                ],
