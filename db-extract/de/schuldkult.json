                        "examples": [
                            {
                                "example_id": "7e7588bd-7d36-44e8-8af1-caea2088cfd6",
                                "sense_id": "33006dcc-9626-3e8a-bb00-dfbf305d428a",
                                "text": "„Israel mordet“ und „Befreie dich vom Schuldkult“ – diese volksverhetzenden und antisemitischen Aufkleber wurden an der Gedenkstätte Ahlem in Hannover entdeckt, wie die Recherche- und Informationsstelle Antisemitismus RIAS am Sonntagabend via X, früher Twitter, meldete."
                            },
                            {
                                "example_id": "2f2e2782-a103-4558-9406-a268357a3b59",
                                "sense_id": "33006dcc-9626-3e8a-bb00-dfbf305d428a",
                                "text": "Zu dieser Gruppe zählt der Bericht unter anderem rechtsextreme Influencer und prominente AfD-Politiker wie Maximilian Krah, die Deutschland von einem „Schuldkult“ befreien wollen."
                            }
                        ]
