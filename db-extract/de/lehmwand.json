                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e32b9a2f-ab71-464c-8dc3-e7a5a6d2012e",
                                "sense_id": "99c87ace-55aa-3172-be54-5ec604738857",
                                "text": "„Kleebusch lehnt den Kopf zurück an die Lehmwand.“"
                            },
                            {
                                "example_id": "59261131-4d6a-4917-81b5-835b763f7bbe",
                                "sense_id": "99c87ace-55aa-3172-be54-5ec604738857",
                                "text": "„Aufgrund der hohen spezifischen Wärmekapazität sind Lehmwände in der Lage Temperaturunterschiede auszugleichen.“"
                            },
                            {
                                "example_id": "a7684497-3ef5-4a18-8dfb-4595bbfb6431",
                                "sense_id": "99c87ace-55aa-3172-be54-5ec604738857",
                                "text": "„Doch es gab auch viele kleine Bauernhöfe und Hütten, sowohl dicht nebeneinander wie verstreut, mit Lehmwänden und Strohdächern und Hühnern davor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
