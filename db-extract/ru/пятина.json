                "senses": [
                    {
                        "sense_id": "409865a7-5d0c-33ef-9c7c-7ff78b28cc99",
                        "entry_id": "e85c7b46-2271-36df-9e00-9905ce8067d7",
                        "glosses": [
                            "истор. каждый из пяти административных районов, на которые делилась Новгородская земля в конце XV — начале XVIII века"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c54a74-2ded-4fc7-88a2-de4210d51464",
                                "sense_id": "409865a7-5d0c-33ef-9c7c-7ff78b28cc99",
                                "text": "По Государеву Царёву и Великого Князя Ивана Васильевича всеа Русии наказу Фёдор Михайлович Ласкирев да подьячей Илья Иванов писали и дозирали в половине Бежецкой пятины за старыми помещики и новых помещиков испомещивали, примериваясь к книгам и к розсписи, каковы книги и роспись взяли в Великом Новегороде у диака Семёна Косткина за его приписью, книги письма Ивана Вельяминова, да двои приправочные книги Фёдора Кушелева да Фёдора Нелединского."
                            }
                        ]
                    }
