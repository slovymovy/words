                        "sense_id": "32ee6a15-4d39-31c1-a164-1f4643fa350b",
                        "entry_id": "568cc15f-80b3-3130-b65f-82941d8f718f",
                        "glosses": [
                            "Relatif à la transmisogynie."
                        ],
                        "tags": [
                            "Transféminisme"
                        ],
                        "examples": [
                            {
                                "example_id": "ff014624-7dcd-474a-a728-7050a6ee3737",
                                "sense_id": "32ee6a15-4d39-31c1-a164-1f4643fa350b",
                                "text": "En considérant les suicides des femmes trans comme existant dans un système social trans-misogyne, je ne pense pas que soutenir le pouvoir d’agir sur sa vie par le suicide soit vraiment une mise en échec valable de ce système social."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf73b339-f32f-4a3e-9f96-f3cb2295bd5d",
                        "source_entry_id": "568cc15f-80b3-3130-b65f-82941d8f718f",
                        "source_sense_id": "32ee6a15-4d39-31c1-a164-1f4643fa350b",
                        "target_lang_word": "transmisogynist",
