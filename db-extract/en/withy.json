                                "example_id": "622babf7-9dbe-4ab9-bff0-e207585d914a",
                                "sense_id": "1ee9c547-bcd6-3c99-bdc4-c282c3df6746",
                                "text": "I would work at my spells from dawn until dusk, dig up roots and forget to eat, harvest the withy stems and weave baskets till they piled to the ceiling."
                            }
                        ]
                    }
