{
    "word_family": [
        "permission",
        "permissive",
        "permissible",
        "permissibility"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51ed5a99-be1a-3788-9a70-dd6831a3fb4a",
                    "sense_definition": "To allow something to happen or to give permission for someone to do something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "authorization_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard would not <w>permit</w> us to enter the building without an ID.",
                            "target_lang_translations": {
                                "ru": "Охранник не <w>разрешил</w> нам войти в здание без удостоверения личности.",
                                "zh": "保安不<w>允许</w>我们在没有身份证件的情况下进入大楼。"
                            }
                        },
                        {
                            "text": "Smoking is not <w>permitted</w> inside the restaurant or on the terrace.",
                            "target_lang_translations": {
                                "ru": "Курение внутри ресторана или на террасе не <w>разрешается</w>.",
                                "zh": "餐厅内及露台上不<w>允许</w>吸烟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "allow",
                        "authorize",
                        "let",
                        "consent to"
                    ],
                    "antonyms": [
                        "forbid",
                        "prohibit",
                        "ban"
                    ],
                    "common_phrases": [
                        "permit access",
                        "permit me to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позволять чему-либо происходить или давать разрешение кому-либо делать что-либо.",
                        "zh": "允许某事发生，或准许某人做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешать",
                                "target_lang_sense_clarification": "давать официальное согласие"
                            },
                            {
                                "target_lang_word": "позволять",
                                "target_lang_sense_clarification": "не препятствовать, давать возможность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "允许",
                                "target_lang_sense_clarification": "准许，同意"
                            },
                            {
                                "target_lang_word": "准许",
                                "target_lang_sense_clarification": "正式批准"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbe11309-aa76-3d91-b553-e2c7cd3b2228",
                    "sense_definition": "To make something possible or allow for it to happen, often used regarding time or weather conditions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possibility_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We plan to go hiking in the mountains tomorrow, weather <w>permitting</w>.",
                            "target_lang_translations": {
                                "ru": "Мы планируем пойти в поход в горы завтра, если <w>позволит</w> погода.",
                                "zh": "如果天气<w>允许</w>，我们计划明天去山里徒步。"
                            }
                        },
                        {
                            "text": "I will stay and answer all your questions if time <w>permits</w>.",
                            "target_lang_translations": {
                                "ru": "Я останусь и отвечу на все ваши вопросы, если <w>позволит</w> время.",
                                "zh": "如果时间<w>允许</w>，我会留下来回答你所有的问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "weather permitting",
                        "time permitting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо возможным (часто используется в контексте времени или погоды).",
                        "zh": "使某事成为可能，常用于时间和天气条件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позволять",
                                "target_lang_sense_clarification": "делать возможным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "允许",
                                "target_lang_sense_clarification": "提供条件或机会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5d70820-68a3-3e91-92a2-ab9f68d89b10",
                    "sense_definition": "To allow for or accept the possibility of something; to admit of.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "authorization_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evidence is conclusive and does not <w>permit</w> of any other interpretation.",
                            "target_lang_translations": {
                                "ru": "Улики убедительны и не <w>допускают</w> никакого иного толкования.",
                                "zh": "证据确凿，不<w>容许</w>有任何其他的解读。"
                            }
                        },
                        {
                            "text": "This urgent situation does not <w>permit</w> of any delay in our response.",
                            "target_lang_translations": {
                                "ru": "Эта срочная ситуация не <w>допускает</w> никакого промедления с нашим ответом.",
                                "zh": "这种紧急情况不<w>容许</w>我们的应对有任何拖延。"
                            }
                        }
                    ],
                    "synonyms": [
                        "admit"
                    ],
                    "common_phrases": [
                        "permit of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Допускать возможность чего-либо; предполагать.",
                        "zh": "容许或接受某事的可能性；承认。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "считать возможным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容许",
                                "target_lang_sense_clarification": "承认有某种可能性"
                            },
                            {
                                "target_lang_word": "允许",
                                "target_lang_sense_clarification": "不排除某种情况"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12f6408a-dc8e-3cc1-92ca-6ad2cab6eef8",
                    "sense_definition": "An official document that gives permission to do something, such as working, driving, or parking.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "authorization_document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must apply for a work <w>permit</w> before you can legally get a job here.",
                            "target_lang_translations": {
                                "ru": "Вы должны подать заявление на <w>разрешение</w> на работу, прежде чем сможете легально устроиться здесь.",
                                "zh": "你必须先申请工作<w>许可证</w>，才能在这里合法就业。"
                            }
                        },
                        {
                            "text": "She displayed her parking <w>permit</w> on the dashboard so she wouldn't get a ticket.",
                            "target_lang_translations": {
                                "ru": "Она положила своё <w>разрешение</w> на парковку на приборную панель, чтобы не получить штраф.",
                                "zh": "她把停车<w>许可证</w>放在仪表盘上，以免被开罚单。"
                            }
                        }
                    ],
                    "synonyms": [
                        "license",
                        "pass",
                        "authorization"
                    ],
                    "common_phrases": [
                        "work permit",
                        "residence permit",
                        "parking permit",
                        "building permit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный документ, дающий разрешение на выполнение какого-либо действия (например, работу, вождение или парковку).",
                        "zh": "准许进行某项活动（如工作、驾驶或停车）的官方文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "документ"
                            },
                            {
                                "target_lang_word": "пропуск",
                                "target_lang_sense_clarification": "документ для входа или проезда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "许可证",
                                "target_lang_sense_clarification": "官方颁发的书面许可"
                            },
                            {
                                "target_lang_word": "通行证",
                                "target_lang_sense_clarification": "准许进入或通过的文件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18887e21-d6b6-3168-ae59-23790015edee",
                    "sense_definition": "A large edible fish found in the warm waters of the Atlantic Ocean.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish_name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angler was thrilled to catch a large <w>permit</w> while fishing off the coast.",
                            "target_lang_translations": {
                                "ru": "Рыболов был в восторге, поймав крупного <w>пермита</w> во время рыбалки у побережья.",
                                "zh": "那位垂钓者在近海钓鱼时，兴奋地钓到了一条大<w>鲳鲹</w>。"
                            }
                        },
                        {
                            "text": "We saw a school of <w>permit</w> swimming near the surface of the clear water.",
                            "target_lang_translations": {
                                "ru": "Мы видели косяк <w>пермитов</w>, плавающих у поверхности прозрачной воды.",
                                "zh": "我们看到一群<w>鲳鲹</w>在清澈的水面附近游动。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная съедобная рыба, обитающая в теплых водах Атлантического океана.",
                        "zh": "一种生活在大西洋温暖水域的大型食用鱼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пермит",
                                "target_lang_sense_clarification": "вид рыбы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鲳鲹",
                                "target_lang_sense_clarification": "一种鱼类名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}