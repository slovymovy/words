                                "sense_id": "48f64870-75b8-3701-9697-c610f7adfec3",
                                "text": "Door de onrust in de financiële markten vergen beleggingsbeslissingen meer denktijd."
                            },
                            {
                                "example_id": "857dacd6-4212-4b1d-aaf2-7e02e04b6fb0",
                                "sense_id": "48f64870-75b8-3701-9697-c610f7adfec3",
                                "text": "Veel schakelen is niet nodig al lijkt de motor vanaf heel lage toeren toch even denktijd nodig te hebben voordat de turbo echt op toeren is."
                            }
                        ]
