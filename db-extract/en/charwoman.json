                        "target_lang_word": "Putzfrau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Putzfrau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17f3b4b8-f3e4-39ea-972d-67d11a789f7f",
                                        "entry_id": "d328aa4d-b8d8-3486-b153-66b4c6652c51",
                                        "glosses": [
                                            "Frau, die erwerbsmäßig Räumlichkeiten putzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c69c7a86-66a7-42b4-8f07-2899405a7904",
                                                "sense_id": "17f3b4b8-f3e4-39ea-972d-67d11a789f7f",
                                                "text": "Die Putzfrau kommt nachts und reinigt die Büros, ohne dass die Mitarbeiter sie je sehen."
                                            },
                                            {
                                                "example_id": "03e7f6b1-397e-407a-8e7c-78882e45920c",
                                                "sense_id": "17f3b4b8-f3e4-39ea-972d-67d11a789f7f",
                                                "text": "„Die Putzfrau hatte Urlaub, es gab hier für Hélène allerlei im Hause zu tun.“"
                                            },
                                            {
                                                "example_id": "31ad00c9-2881-4f57-b5e2-07e07865de4e",
                                                "sense_id": "17f3b4b8-f3e4-39ea-972d-67d11a789f7f",
                                                "text": "„Ingeborg hatte sie zuerst für eine der Putzfrauen gehalten, aber dann war sie nicht einmal Malloquinerin, sondern stammte aus Dortmund.“"
                                            },
                                            {
                                                "example_id": "e5f55fee-7618-4fbb-8a87-60ec6929e576",
                                                "sense_id": "17f3b4b8-f3e4-39ea-972d-67d11a789f7f",
                                                "text": "„Die Friseurin erklärt mir, dass die Putzfrau jede Woche auf die Leiter steigt und eine neue Lebensweisheit aufhängt.“"
                                            },
                                            {
                                                "example_id": "7496ea02-c479-4e6c-819b-fa353bcdc323",
                                                "sense_id": "17f3b4b8-f3e4-39ea-972d-67d11a789f7f",
                                                "text": "„Sie könnte sich eine richtige Arbeit suchen, putzen gehen vielleicht; Putzfrauen wurden immer gesucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
