                "senses": [
                    {
                        "sense_id": "16227d24-c9c9-3e23-ab5d-069a106ea967",
                        "entry_id": "8040e88f-8f37-3f24-8483-0203c98d43c6",
                        "glosses": [
                            "jemand, der bestimmte Erscheinungen in der Sprache/ im Sprachgebrauch kritisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c2ccefc-7467-44a1-9570-da83af396135",
                                "sense_id": "16227d24-c9c9-3e23-ab5d-069a106ea967",
                                "text": "„Hiesigen Sprachkritikern kommt es oft so vor, als würde die deutsche Sprache von neuen Fremdwörtern überflutet.“"
                            },
                            {
                                "example_id": "63adf964-78d2-4150-a1f3-f4d75d240ca4",
                                "sense_id": "16227d24-c9c9-3e23-ab5d-069a106ea967",
                                "text": "„Sprachkritiker sind, wie aus den oft spärlichen Autorangaben ersichtlich wird, in ihrer Mehrzahl »hauptberuflich« einerseits Schriftsteller oder Journalisten, andrerseits Lehrer aller Arten, deren Sprachglossen »in des Wortes engerer Bedeutung aus der Schule zu plaudern« belieben - vor allem, versteht sich, Deutschlehrer.“"
                            },
                            {
                                "example_id": "f9dfbea2-07aa-48e2-aee0-c7e4334a6871",
                                "sense_id": "16227d24-c9c9-3e23-ab5d-069a106ea967",
                                "text": "„Sprachkritiker dagegen monierten, dass die Sprachwissenschaft ihren Elfenbeinturm nicht verlassen wolle und die tatsächlichen Probleme unberücksichtigt lasse oder gar leugne.“"
                            },
                            {
                                "example_id": "7ff8ebaa-4ef3-49be-afdb-635450132ce9",
                                "sense_id": "16227d24-c9c9-3e23-ab5d-069a106ea967",
                                "text": "„Der Anteil der Verben insgesamt ist zurückgegangen - vielleicht zugunsten der Nomina; dies würde die Idee einer zunehmenden Nominalisierung, wie sie von manchen Sprachkritikern beklagt wird („Substantivitis“), stützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
