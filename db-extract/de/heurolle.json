                "senses": [
                    {
                        "sense_id": "a1b5eb5e-3a4f-34ef-b4a4-5efb601c6839",
                        "entry_id": "88573421-e80a-33ba-9a40-813e9157e184",
                        "glosses": [
                            "moderne großer Zylinder aus trockenen Pflanzenteilen von Gräsern, die während oder nach der Ernte über eine Rolle maschinell aufgewickelt, gepresst und meist mit einem Netz aus Kunststoff fixiert worden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee0fb411-158c-45be-a0f1-c35c872410e0",
                                "sense_id": "a1b5eb5e-3a4f-34ef-b4a4-5efb601c6839",
                                "text": "Glück im Unglück, hatte ein Landwirt, der am Samstag mit seinem Traktor eine größere Ladung Heu von Riegelsberg nach Lebach zog. Auf seinem Anhänger transportierte er 14 große Heurollen, die in Weißfolie eingewickelt waren."
                            },
                            {
                                "example_id": "6b5edb43-434f-47ce-b291-675ece1a3a8d",
                                "sense_id": "a1b5eb5e-3a4f-34ef-b4a4-5efb601c6839",
                                "text": "Ein Raub der Flammen wurden am Freitagabend 18 Heurollen, die direkt an einem Wald gelagert waren."
                            },
                            {
                                "example_id": "0dfaa32c-5a19-4441-81f4-72e2ccb8bf7b",
                                "sense_id": "a1b5eb5e-3a4f-34ef-b4a4-5efb601c6839",
                                "text": "Wir fahren 300 Stundenkilometer. Büsche, Bäume, Heurollen, Häuser, ich könnte nicht sagen, ob ich jetzt gerade in Hessen bin, in der Normandie oder in Kent."
                            },
                            {
                                "example_id": "42715ffa-4f4a-448e-a6ec-16bcf74725e6",
                                "sense_id": "a1b5eb5e-3a4f-34ef-b4a4-5efb601c6839",
                                "text": "In der vergangenen Woche wurde die Heuernte beendet, alle Heurollen und Heubunde sind unter Dach und Fach."
                            },
                            {
                                "example_id": "2bd93ddd-88ab-489e-9fa3-235393fbd2da",
                                "sense_id": "a1b5eb5e-3a4f-34ef-b4a4-5efb601c6839",
                                "text": "Dieses Gerät bestand aus zwei tiefliegenden Walzen, die mit ihren Spitzen wie Riesenbleistifte aussahen und auf die die Heurolle gelegt wurde."
                            },
                            {
                                "example_id": "bbaf5630-07fe-4eb3-81ee-57541309b7fe",
                                "sense_id": "a1b5eb5e-3a4f-34ef-b4a4-5efb601c6839",
                                "text": "Man war so sehr Friedenssoldat geworden, daß am Tage der Affaire bei Saalfeld, wo wir durch Erfurt marschirten, ein strenger Befehl von einem der Obern gegeben wurde, die Heurollen doch egaler zu spinnen, indem man bemerkt habe, daß einige zu dick, andere zu dünn wären und mancher gar keine hätte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
