                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f371cc29-dbe8-47c9-8d0d-4fa04dfdb261",
                                "sense_id": "0967357c-5afc-396d-a69a-1d39d6bd4917",
                                "text": "Tienduizenden mensen zijn naar het evenemententerrein bij Walibi gekomen om drie dagen lang naar popmuziek te luisteren en andere optredens te zien. Het wordt morgen en overmorgen tropisch warm en in verband daarmee heeft de organisatie aanvullende maatregelen genomen."
                            },
                            {
                                "example_id": "a45c36fa-269a-4609-9c20-fe53bd952830",
                                "sense_id": "0967357c-5afc-396d-a69a-1d39d6bd4917",
                                "text": "In Rotterdam wordt het Stadhuisplein ingericht als evenemententerrein. Ook het gelijknamige plein in Eindhoven is vanavond 'voetbalplein', net als de Markt en het 18-Septemberplein."
                            }
                        ]
