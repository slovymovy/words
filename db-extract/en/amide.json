    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "17810e02-90c4-3972-9175-38682bf7b7b0",
                "word": "amide",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d1acaf2b-4e00-4abe-a42f-7d9aeeac1a60",
                        "entry_id": "17810e02-90c4-3972-9175-38682bf7b7b0",
                        "tags": [
                            "plural"
                        ],
                        "form": "amides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b58f680-13a3-3d8a-97cb-220522119ebc",
                        "entry_id": "17810e02-90c4-3972-9175-38682bf7b7b0",
                        "glosses": [
                            "Any derivative of an oxoacid in which the hydroxyl group has been replaced with an amino or substituted amino group; especially such derivatives of a carboxylic acid, the carboxamides or acid amides"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2c4b18c5-afed-35a2-9808-28774c57acf2",
                        "entry_id": "17810e02-90c4-3972-9175-38682bf7b7b0",
                        "glosses": [
                            "Any ionic derivative of ammonia in which a hydrogen atom has been replaced with a metal cation (R-NH⁻ or R₂N⁻)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dda3087-b0d5-4edf-b30a-43e7dad07897",
                        "source_entry_id": "17810e02-90c4-3972-9175-38682bf7b7b0",
                        "source_sense_description": "organic chemistry: derivative of an oxoacid",
                        "target_lang_word": "amide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3db0bcb0-f543-3362-9b73-c7a41d6febfb",
                                        "entry_id": "bf868258-e58e-395c-92c3-21c5da9cdc7e",
                                        "glosses": [
                                            "Composé organique dérivé d’un acide carboxylique par substitution du groupe hydroxyle par un substituant azoté (ammoniac ou amine), de formule générale R₁−CO−N(R₂)(R₃)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b23939-efba-4376-b4a8-35fa528c0c63",
                                                "sense_id": "3db0bcb0-f543-3362-9b73-c7a41d6febfb",
                                                "text": "Le sel dans lequel se convertit cet amide, par l'action prolongée de l'ammoniaque, est un sel amido-ammoniacal, dont les deux tiers de l'azote sont à l'état d'ammoniaque ou d'ammonium, et l'autre tiers à l'état d’amide."
                                            },
                                            {
                                                "example_id": "35ae2965-dc1d-4ebc-89a0-6c47815c867c",
                                                "sense_id": "3db0bcb0-f543-3362-9b73-c7a41d6febfb",
                                                "text": "Les amides sont obtenues en partant de l'ammoniac par substitution à l'hydrogène de AzH₃, d'un radical acide (acétyle, etc.)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c118a009-d9ae-4510-ba4d-fa507a6d0550",
                        "source_entry_id": "17810e02-90c4-3972-9175-38682bf7b7b0",
                        "source_sense_description": "organic chemistry: derivative of an oxoacid",
                        "target_lang_word": "Amid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9569a88a-6563-3134-8e69-ce2654e94a94",
                                        "entry_id": "2198fb17-5cf8-30ed-a4a3-37f8c479c680",
                                        "glosses": [
                                            "organisches Derivat des Ammoniak mit Acyl-Rest"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c37135d7-2a8d-4865-a765-c7dffa6c7f70",
                                                "sense_id": "9569a88a-6563-3134-8e69-ce2654e94a94",
                                                "text": "„Proteine sind die Bausteine unseres Körpers. Und Bausteine, die man in den Proteinen findet, heißen Amide, das sind spezielle Stickstoffverbindungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6013f704-8ee1-4320-a34a-eef29c64a506",
