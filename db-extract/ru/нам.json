                "entry_id": "11eec3f5-a515-3bab-a9f1-57c114af49ee",
                "word": "нам",
                "pos": "pron",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b841a84d-d857-3e51-aa16-46afcadadad8",
                        "entry_id": "11eec3f5-a515-3bab-a9f1-57c114af49ee",
                        "glosses": [
                            "dative of мы (my)"
                        ],
                        "tags": [
                            "dative",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "15571290-d565-4c12-90f0-8ced1515bac6",
                                "sense_id": "b841a84d-d857-3e51-aa16-46afcadadad8",
                                "text": "Он дал нам только пару полтинников",
                                "translation": "He only gave us a couple fifty-ruble notes",
                                "english": "He only gave us a couple fifty-ruble notes"
                            },
                            {
                                "example_id": "f6ad2961-451b-431d-a6fd-24d50e8d5c75",
                                "sense_id": "b841a84d-d857-3e51-aa16-46afcadadad8",
                                "text": "Нам [надо попасть] в тринадцатый вагон. Любера, оставайтесь вон,\n укрепляйте свои ряды, защищайте Афганистан.",
                                "translation": "We need to get in the thirteenth railroad car. Stay away, lyubers,\n keep strengthening your ranks, keep defending Afghanistan.",
                                "english": "We need to get in the thirteenth railroad car. Stay away, lyubers,\n keep strengthening your ranks, keep defending Afghanistan."
                            },
                            {
                                "example_id": "7a6ad21c-3de2-4fb6-b6c3-390cb4423be7",
                                "sense_id": "b841a84d-d857-3e51-aa16-46afcadadad8",
                                "text": "Но ведь я не знаю ее лица! Как же нам быть, товарищ Чиклин, когда она придет?",
                                "translation": "But I don't know her face! How shall we act, comrade Chiklin, when she comes?",
                                "english": "But I don't know her face! How shall we act, comrade Chiklin, when she comes?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
