                "senses": [
                    {
                        "sense_id": "1bc7754b-c0b1-361d-b660-f0f7829ed35b",
                        "entry_id": "524e4227-a522-370a-9425-166dc476fe05",
                        "glosses": [
                            "Peindre sur quelque chose de déjà terminé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5c9831d-3259-4397-8b18-d0720ee9bbbc",
                                "sense_id": "1bc7754b-c0b1-361d-b660-f0f7829ed35b",
                                "text": "Griffer, éliminer, soustraire, surpeindre, gestes pour créer une nouvelle peinture, une peinture singulière."
                            },
                            {
                                "example_id": "bd95e30b-8f86-4e1d-aaa9-d6b13eb95af8",
                                "sense_id": "1bc7754b-c0b1-361d-b660-f0f7829ed35b",
                                "text": "Une fois en possession de l’ouvrage, Louis XII, le roi de France, fit surpeindre les armes de Louis de Gruuthuse par les siennes."
                            },
                            {
                                "example_id": "7ca7f62d-af32-43ef-9f46-db8313b95204",
                                "sense_id": "1bc7754b-c0b1-361d-b660-f0f7829ed35b",
                                "text": "Haut pouvoir de remplissage, ce qui permet de surpeindre des surfaces fissurées ou marquées."
                            }
                        ]
                    }
