    "word": "shutterbug",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "554d64e8-01d0-3191-b22a-296a4ac699cc",
                "word": "shutterbug",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2f351340-3313-4419-b9f6-1b800d904e59",
                        "entry_id": "554d64e8-01d0-3191-b22a-296a4ac699cc",
                        "tags": [
                            "plural"
                        ],
                        "form": "shutterbugs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58ee6418-8bbf-3afb-9c62-8c5985e12f41",
                        "entry_id": "554d64e8-01d0-3191-b22a-296a4ac699cc",
                        "glosses": [
                            "A person who makes a hobby of photography."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "707abdbb-ae93-4d3f-84dc-6dc09a346ec6",
                                "sense_id": "58ee6418-8bbf-3afb-9c62-8c5985e12f41",
                                "text": "Aerial photography was coming into its own, and flying shutterbugs pushed the envelope, striving to outsnap each other."
                            },
                            {
                                "example_id": "a1099c63-5060-47c5-8615-7664178a24ef",
                                "sense_id": "58ee6418-8bbf-3afb-9c62-8c5985e12f41",
                                "text": "She was contrite, but presented herself as just another frustrated shutterbug with access to Photoshop."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "023d829f-d016-4e4a-b743-f9f51952050d",
                        "source_entry_id": "554d64e8-01d0-3191-b22a-296a4ac699cc",
                        "source_sense_id": "58ee6418-8bbf-3afb-9c62-8c5985e12f41",
                        "source_sense_description": "person who makes a hobby of photography",
                        "target_lang_word": "Amateurfotograf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amateurfotograf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff6b1b32-fcec-32b1-b199-bf09532996ae",
                                        "entry_id": "5914c27b-59a5-3f23-9fa3-97a7ed0987b6",
                                        "glosses": [
                                            "(männliche^☆) Person, die nicht beruflich fotografiert, sondern das Fotografieren nur als Hobby ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d504ff7-9398-43a2-b1bd-5e2de8210aa9",
                                                "sense_id": "ff6b1b32-fcec-32b1-b199-bf09532996ae",
                                                "text": "„Der Amateurfotograf Kenneth Adelmann, gegen den Streisand im Dezember in einem Rechtsstreit vor Gericht unterlegen war, reichte nach Angaben der Justiz in Los Angeles Klage gegen die Sängerin und Schauspielerin ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a98a96c8-f64c-4d9b-b2e8-3af3808744b3",
                        "source_entry_id": "554d64e8-01d0-3191-b22a-296a4ac699cc",
                        "source_sense_id": "58ee6418-8bbf-3afb-9c62-8c5985e12f41",
                        "source_sense_description": "person who makes a hobby of photography",
                        "target_lang_word": "Amateurfotografin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amateurfotografin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7803c93e-ad4b-33e5-bb10-a3f0a45bcc0d",
                                        "entry_id": "0fa56e92-7e14-315b-8925-2c9bbe95e83d",
                                        "glosses": [
                                            "weibliche Person, die nicht beruflich fotografiert, sondern das Fotografieren nur als Hobby ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dfbe42d-aee5-4080-9a7b-89868646d1f4",
                                                "sense_id": "7803c93e-ad4b-33e5-bb10-a3f0a45bcc0d",
                                                "text": "„Die Ergebnisse im Format 10 x 15 wurden von einem Profifotografen und einer Amateurfotografin sowie von 13 Fotolehrlingen im zweiten Ausbildungsjahr unter idealen Lichtbedingungen ins Visier genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e6afefc-232e-45c6-92b5-90c231226f0b",
                        "source_entry_id": "554d64e8-01d0-3191-b22a-296a4ac699cc",
                        "source_sense_id": "58ee6418-8bbf-3afb-9c62-8c5985e12f41",
                        "source_sense_description": "person who makes a hobby of photography",
                        "target_lang_word": "Hobbyfotograf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hobbyfotograf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5bcc556-2c42-3a26-ac87-eb6d422a7e75",
                                        "entry_id": "0fb240b7-aed3-3e9c-af66-93a2fb1ff6b1",
                                        "glosses": [
                                            "(männliche^☆) Person, die nicht beruflich fotografiert, sondern das Fotografieren nur als Hobby ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e538604-0214-4e59-85e2-549e258c6a0d",
                                                "sense_id": "e5bcc556-2c42-3a26-ac87-eb6d422a7e75",
                                                "text": "„Für die einen sind sie runtergekommene Ruinen, für die anderen nostalgisches Kopfkino: Sogenannte 'Lost Places' sind der neue Trend unter Hobbyfotografen. Sie erkunden regelmäßig leer stehende Gebäude, Orte mit Geschichte, an denen früher Leben herrschte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e366a23-d1bb-423f-87ee-a24a2fa632a0",
                        "source_entry_id": "554d64e8-01d0-3191-b22a-296a4ac699cc",
                        "source_sense_id": "58ee6418-8bbf-3afb-9c62-8c5985e12f41",
                        "source_sense_description": "person who makes a hobby of photography",
                        "target_lang_word": "Hobbyfotografin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hobbyfotografin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdfc7bf3-d1d9-3c71-b013-1d956df7f55c",
                                        "entry_id": "203216c4-68bc-3ee9-b271-9b6983641013",
                                        "glosses": [
                                            "weibliche Person, die nicht beruflich fotografiert, sondern das Fotografieren nur als Hobby ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b428fba-552f-4d14-b848-b1f2c38ade30",
                                                "sense_id": "fdfc7bf3-d1d9-3c71-b013-1d956df7f55c",
                                                "text": "„Im Mittelpunkt steht Tinka, eine Hobbyfotografin, die in einem typisch wienerischen Altwarengeschäft jobbt, dessen Besitzer ein Ungar namens Attila ist, ein handfester Charaktertyp mit Hang zum Choleriker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
