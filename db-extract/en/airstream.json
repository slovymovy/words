                                "example_id": "9d56c9e5-c58e-4767-aabf-f090f99ebd2a",
                                "sense_id": "6df4662c-c1b4-3b0c-96f1-34aa03ac3e61",
                                "text": "Maintaining a clean airstream around the car is important for good fuel economy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c5ffcf2-55a0-469a-8041-edeed00ce558",
                        "source_entry_id": "3404f267-893f-3ec3-864b-083f493a3bc8",
                        "source_sense_description": "flow or current of air",
                        "target_lang_word": "Luftstrom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftstrom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "957a9c76-f0d0-36ed-bbfe-e0c203e27b71",
                                        "entry_id": "a52e483f-d716-3f0b-bc79-27f88492df00",
                                        "glosses": [
                                            "eine sich gleichförmig bewegende Menge eines Gases"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "500d2b08-0ed3-41e3-83a1-297c4ad5838a",
                                                "sense_id": "957a9c76-f0d0-36ed-bbfe-e0c203e27b71",
                                                "text": "„Sind Stimmlippen/Glottis in Stimmstellung, regt ein aggressiv pulmonischer Luftstrom die Stimmlippen zur Vibration an und ein stimmhafter Laut entsteht.“"
                                            },
                                            {
                                                "example_id": "0d4a5501-9907-41d5-be83-d12f6bc15a55",
                                                "sense_id": "957a9c76-f0d0-36ed-bbfe-e0c203e27b71",
                                                "text": "„Bei dem als Bodyflying bezeichneten Sport begibt sich der Sportler, mit Helm, Brille, Mundschutz, Handschuhen und vor allem einem speziellen Anzug ausgestattet, in einen Luftstrom, der durch ein Gitter hindurch senkrecht in die Höhe strebt.“"
                                            },
                                            {
                                                "example_id": "599c0165-b3b2-4c0f-99d8-33ce4b02e4f8",
                                                "sense_id": "957a9c76-f0d0-36ed-bbfe-e0c203e27b71",
                                                "text": "„Beim Bodyflying werden Sie durch einen 180 km/h schnellen Luftstrom aufwärts getrieben.“"
                                            },
                                            {
                                                "example_id": "13d6e8bc-d236-428c-af3f-4ec86e889850",
                                                "sense_id": "957a9c76-f0d0-36ed-bbfe-e0c203e27b71",
                                                "text": "„Sie sprach also den Wunsch aus, immer weiter in den Park hineinzufahren, und ließ erst umkehren, als schon die Sonne nieder war und ein kühlerer Luftstrom den Abend ankündigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
