        "nl-extract.jsonl": [
            {
                "entry_id": "524f2057-589d-32c6-b59c-69c196ed2978",
                "word": "Melkweg",
                "pos": "name",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3709fb4e-6d54-411a-b365-527991d0e01a",
                        "entry_id": "524f2057-589d-32c6-b59c-69c196ed2978",
                        "tags": [
                            "possessive"
                        ],
                        "form": "Melkwegs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4d3cf3d-85fc-3c12-83eb-5cca325e85a0",
                        "entry_id": "524f2057-589d-32c6-b59c-69c196ed2978",
                        "glosses": [
                            "het sterrenstelsel waarin wij ons bevinden en dat op donkere nachten als lichtende band aan de hemel te zien is."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c284cec-99fa-41b8-a942-e067550383b4",
                                "sense_id": "c4d3cf3d-85fc-3c12-83eb-5cca325e85a0",
                                "text": "Met mijn luchtbed op het grondzeil kroop ik mijn slaapzak in en keek omhoog naar de sterren in de hemel. Nog nooit had ik de Melkweg zo helder gezien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4345c19d-de42-413d-95c1-0d471947e8f7",
                        "source_entry_id": "524f2057-589d-32c6-b59c-69c196ed2978",
                        "source_sense_id": "c4d3cf3d-85fc-3c12-83eb-5cca325e85a0",
                        "source_sense_description": "het sterrenstelsel waarin wij ons bevinden en dat op donkere nachten als lichtende band aan de hemel te zien is.",
                        "target_lang_word": "Milchstraße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milchstraße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29fe628a-8452-3fbc-8524-5eae4ff95edc",
                                        "entry_id": "794a24bd-6fa2-3487-8c2a-4a9bad4056b9",
                                        "glosses": [
                                            "die Galaxie, in der unser Sonnensystem liegt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6049dac-c087-43ae-bd39-909e18e4101d",
                                                "sense_id": "29fe628a-8452-3fbc-8524-5eae4ff95edc",
                                                "text": "Die Milchstraße umfasst etwa 100 Milliarden Sterne."
                                            },
                                            {
                                                "example_id": "be99157f-0944-46fb-82aa-fa4831f82348",
                                                "sense_id": "29fe628a-8452-3fbc-8524-5eae4ff95edc",
                                                "text": "„Zu sagen, der Mensch erobere jetzt den Weltraum, ist nichts als eine Illusion. Mit der Geschwindigkeit von 40000 km/Std., die unsere »Raumschiffe« zwischen Erde und Mond derzeit erreichen, würde eine Reise zum rund 4 Lichtjahre entfernten sonnennächsten Fixstern über 100000 Jahre dauern. Die Zeit, die erforderlich ist, um mit dieser Geschwindigkeit dasjenige unserer Milchstraße vergleichbare Sternsystem, das uns im Weltraum am nächsten liegt, zu erreichen (Spiralsystem im Sternbild Andromeda, rund 2 Millionen Lichtjahre entfernt), ist etwa 10mal so lang wie die Zeitspanne, die seit der Entstehung unseres Sonnensystems verflossen ist, nämlich 60 Milliarden Jahre! Es ist also berechtigt, zu sagen, daß kein Sterblicher jemals die Tiefe des Weltraums betreten oder befahren wird. …“"
                                            },
                                            {
                                                "example_id": "94cf5812-e5f2-4c6e-b38f-f842b50e32e6",
                                                "sense_id": "29fe628a-8452-3fbc-8524-5eae4ff95edc",
                                                "text": "„Als das Männlein fertiggeschnitzt war, trieb mein Vater ihm zwei Schusternägel in den Kopf, und so traue ich mir zu, ihn wiederzuerkennen, auch wenn ich ihn erst nach vielen Lichtjahren in der Milchstraße treffen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7170cdb7-8b46-3b18-b04f-b5194f95d7a8",
                                        "entry_id": "794a24bd-6fa2-3487-8c2a-4a9bad4056b9",
                                        "glosses": [
                                            "milchiges Band am Nachthimmel, unsere Sicht auf die Galaxis"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1947d86-b522-46d3-ae63-bd82da49fc98",
                                                "sense_id": "7170cdb7-8b46-3b18-b04f-b5194f95d7a8",
                                                "text": "„Vom Zenit bis zum Nadir erstreckte sich ein unübersehbarer Ring von Sternenstaub, jene Milchstraße, in deren Mitte unsere Sonne nur als Stern vierter Größe gilt.“"
                                            },
                                            {
                                                "example_id": "58a838de-4d5e-4325-86cf-a626713bd296",
                                                "sense_id": "7170cdb7-8b46-3b18-b04f-b5194f95d7a8",
                                                "text": "In klaren Nächten kann man die Milchstraße sehen."
                                            },
                                            {
                                                "example_id": "436408ae-54fd-4330-99bc-b5915d3e638c",
                                                "sense_id": "7170cdb7-8b46-3b18-b04f-b5194f95d7a8",
                                                "text": "„Während Frau Mondtraut mit den anderen Damen noch an der Tafel saß und am Himmel das Sternenmeer der Milchstraße und der Scheffel glitzerten, stieg im Osten die volle Rundung des Mondes auf.“"
                                            },
                                            {
                                                "example_id": "6d8d19ec-c6c9-4828-846c-c20e4c23a615",
                                                "sense_id": "7170cdb7-8b46-3b18-b04f-b5194f95d7a8",
                                                "text": "„Ungeheuer zog über uns, begleitet von tausend Sternen, der helle Rauch der Milchstraße mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1951d19c-34b0-4715-a068-82abfd06261a",
                        "source_entry_id": "524f2057-589d-32c6-b59c-69c196ed2978",
                        "source_sense_id": "c4d3cf3d-85fc-3c12-83eb-5cca325e85a0",
                        "source_sense_description": "het sterrenstelsel waarin wij ons bevinden en dat op donkere nachten als lichtende band aan de hemel te zien is.",
                        "target_lang_word": "Milky Way",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milky Way",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68bf0929-8d9a-3a1a-b63e-251742e32f9d",
                                        "entry_id": "42ce8ff1-98b6-3e91-b8be-6b8a5b46446b",
                                        "glosses": [
                                            "The Milky Way Galaxy, the galaxy in which Earth is located."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cff10d14-74d2-4454-a681-94f2dc0ddb95",
                                                "sense_id": "68bf0929-8d9a-3a1a-b63e-251742e32f9d",
                                                "text": "This whole earth which we inhabit is but a point in space. How far apart, think you, dwell the two most distant inhabitants of yonder star, the breadth of whose disk cannot be appreciated by our instruments? Why should I feel lonely? is not our planet in the Milky Way?"
                                            },
                                            {
                                                "example_id": "33cd1168-7c74-4c8c-a110-53738a96faa1",
                                                "sense_id": "68bf0929-8d9a-3a1a-b63e-251742e32f9d",
                                                "text": "From a cosmic perspective, even our host galaxy, the Milky Way, is not particularly special[…]"
                                            },
                                            {
                                                "example_id": "4c8b9233-8b1a-4cce-8b50-2abc94eee0b3",
                                                "sense_id": "68bf0929-8d9a-3a1a-b63e-251742e32f9d",
                                                "text": "By combining the data from multiple telescopes, astronomers determined the star’s position and velocity in space, allowing them to predict that it will exit the Milky Way at some point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604f8f2e-8c56-37fa-a6f6-6e361590a78b",
                                        "entry_id": "42ce8ff1-98b6-3e91-b8be-6b8a5b46446b",
                                        "glosses": [
                                            "A broad band of diffuse white light, visible in the night sky; our view of the dense portions of the Milky Way Galaxy from inside the galaxy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9683885d-e715-46bb-a953-f2f14af5a47f",
                                                "sense_id": "604f8f2e-8c56-37fa-a6f6-6e361590a78b",
                                                "text": "[…] a random shower of amber lights—a spray of golden sparks that […] glinted softly upon the sea of dark foliage like the pallid stars of the milky-way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92ac741b-f552-4d38-a8be-5123701db100",
                        "source_entry_id": "524f2057-589d-32c6-b59c-69c196ed2978",
                        "source_sense_id": "c4d3cf3d-85fc-3c12-83eb-5cca325e85a0",
                        "source_sense_description": "het sterrenstelsel waarin wij ons bevinden en dat op donkere nachten als lichtende band aan de hemel te zien is.",
                        "target_lang_word": "voie lactée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voie lactée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cde5a292-6493-3461-916c-a29fe0e2eb17",
                                        "entry_id": "57ed1cbe-40eb-3d70-af0d-dd5f37f292e8",
                                        "glosses": [
                                            "Notre galaxie vue de la Terre, sur la sphère céleste. Grande trace de lumière blanche et diffuse qui traverse presque toute la sphère céleste, à peu près du nord au sud, et qui, vue au télescope, se résout en une multitude innombrable d’étoiles distinctes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "360d80ab-15e0-42a9-bdc5-27b739f20333",
                                                "sense_id": "cde5a292-6493-3461-916c-a29fe0e2eb17",
                                                "text": "L’amour est comme ce qu’on appelle au ciel la voie lactée, un amas brillant formé par des milliers de petites étoiles, dont chacune est souvent une nébuleuse."
                                            },
                                            {
                                                "example_id": "8b68ff51-5596-40b9-8ab0-fc99d2a4e499",
                                                "sense_id": "cde5a292-6493-3461-916c-a29fe0e2eb17",
                                                "text": "Voie lactée ô sœur lumineuse\nDes blancs ruisseaux de Chanaan\nEt des corps blancs des amoureuses\nNageurs morts suivrons-nous d’ahan\nTon cours vers d’autres nébuleuses. — (Guillaume Apollinaire, La Chanson du Mal-aimé, 1913)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1ab5f29-fe8e-4faf-8fed-136a4d86b569",
