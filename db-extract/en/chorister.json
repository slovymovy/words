{
    "word": "chorister",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d10b04c4-ae28-3047-84d0-35023c99dd8c",
                "word": "chorister",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "48dac144-e028-4078-9a1d-de5efdabcf24",
                        "entry_id": "d10b04c4-ae28-3047-84d0-35023c99dd8c",
                        "tags": [
                            "plural"
                        ],
                        "form": "choristers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "899fbb8d-dd46-373a-992b-c558a1fe0e53",
                        "entry_id": "d10b04c4-ae28-3047-84d0-35023c99dd8c",
                        "glosses": [
                            "A singer in a choir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad0fae6-f93b-4195-9224-2119d875ec8b",
                                "sense_id": "899fbb8d-dd46-373a-992b-c558a1fe0e53",
                                "text": "None of the new choristers can sing in tune but they will learn soon enough."
                            },
                            {
                                "example_id": "724fd08e-ca12-4727-92fa-38c81ce6bcdf",
                                "sense_id": "899fbb8d-dd46-373a-992b-c558a1fe0e53",
                                "text": "These be my querysters\nTo helpe me to synge,\nMy hawkes to mattens rynge!"
                            },
                            {
                                "example_id": "10a4b2aa-3ff0-4841-8618-447b8ccb07d8",
                                "sense_id": "899fbb8d-dd46-373a-992b-c558a1fe0e53",
                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                            },
                            {
                                "example_id": "28d7942e-5a7c-4c42-9e55-814da1ddc09a",
                                "sense_id": "899fbb8d-dd46-373a-992b-c558a1fe0e53",
                                "text": "And a Salisbury Cathedral chorister complained that after working late into Christmas Day, an absence of trains meant he and his brother would not be able to get home for \"our proper Christmas\" until the 27th."
                            }
                        ]
                    },
                    {
                        "sense_id": "447d57ef-a76e-3f10-92dc-424bf9379aa8",
                        "entry_id": "d10b04c4-ae28-3047-84d0-35023c99dd8c",
                        "glosses": [
                            "A director or leader of a choral group."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c26af232-e2e5-4706-97d3-4a2ce7d35ef4",
                                "sense_id": "447d57ef-a76e-3f10-92dc-424bf9379aa8",
                                "text": "Jane was the chorister of her congregation's choir, and that occupied much of her time on the weekends."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "677b8454-8ff5-44a4-8be3-4e5e9f4e189b",
                        "source_entry_id": "d10b04c4-ae28-3047-84d0-35023c99dd8c",
                        "source_sense_description": "singer in a choir",
                        "target_lang_word": "koorzanger",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koorzanger",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "440d0c3f-ba43-350e-9c92-58a03a831108",
                                        "entry_id": "46b4a899-0e45-3199-9470-89c5f504e789",
                                        "glosses": [
                                            "iemand die de kunst van het samenzingen beoefent in een koor"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64f0931a-ba76-4033-9a48-8907c0337837",
                                                "sense_id": "440d0c3f-ba43-350e-9c92-58a03a831108",
                                                "text": "De koorzangers misten hun inzet en de dirigente sloeg af."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce638bc6-86bf-463d-992e-2d194aa4d452",
                        "source_entry_id": "d10b04c4-ae28-3047-84d0-35023c99dd8c",
                        "source_sense_description": "singer in a choir",
                        "target_lang_word": "korist",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "korist",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "566acbb4-fcbb-35bf-8043-8860c1093557",
                                        "entry_id": "37c6baf0-a133-3ce8-af3a-636be9829233",
                                        "glosses": [
                                            "zanger in een koor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2973f0e-e696-40e8-94db-875b7d865c47",
                                                "sense_id": "566acbb4-fcbb-35bf-8043-8860c1093557",
                                                "text": "Pieter Jan Leusink dirigeerde een elfkoppig orkest en negen koristen, door als een krankzinnige met zijn armen te maaien en oergeluiden uit te stoten."
                                            },
                                            {
                                                "example_id": "5867ccdd-2324-4f03-a5c4-f529a3b612a5",
                                                "sense_id": "566acbb4-fcbb-35bf-8043-8860c1093557",
                                                "text": "De onderwijzeres is een voormalige koriste van Elton John en benadrukt dat het voor een jong meisje belangrijk is om 'het wandelen met hakken zo snel mogelijk onder de knie te hebben'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f46ecc5b-28b6-4c2a-8d2b-179545673892",
                        "source_entry_id": "d10b04c4-ae28-3047-84d0-35023c99dd8c",
                        "source_sense_description": "singer in a choir",
                        "target_lang_word": "choriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                        "entry_id": "108689c5-d3ee-356d-ba77-487cdf58a908",
                                        "glosses": [
                                            "Chantre du chœur dans une église, chanteur dans une chorale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9823021-f286-4e3a-96da-367fa865a02b",
                                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                                "text": "Les heures comprennent surtout des psaumes et elles sont chantées au chœur dans le texte latin. Les choristes de l'Hôtel-Dieu de Québec se rendaient donc plusieurs fois par jour au chœur pour psalmodier."
                                            },
                                            {
                                                "example_id": "e4fc7b27-805d-40bf-aef4-90eb318496e8",
                                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                                "text": "J’étais heureux pour Martine, petite choriste anonyme, dont personne ne connaîtrait jamais le nom, mais pourtant saluée chaque soir, applaudie, pour la portion de poésie qu’elle avait apportée à l’œuvre."
                                            },
                                            {
                                                "example_id": "7e5b1491-ccbe-4189-9926-33df52e284f2",
                                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                                "text": "La maison de production fournissait les choristes et les musiciens, suggérait fortement les chansons, déterminait les arrangements, et quelques choubidous plus tard, Françoise Deldick, Agnès Loti, Michèle et ses Wouaps sortaient de l'ombre."
                                            },
                                            {
                                                "example_id": "3386e23d-daad-4487-b71e-a961f4016076",
                                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                                "text": "Le moindre choriste dans un chœur chantant une Passion de Bach m'a toujours semblé pouvoir aller plus loin que moi dans mon travail de savant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4656cdcc-ca78-4858-8533-0dca6ab39c24",
                        "source_entry_id": "d10b04c4-ae28-3047-84d0-35023c99dd8c",
                        "source_sense_description": "singer in a choir",
                        "target_lang_word": "Chorsänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chorsänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27319404-4de4-3fda-bb06-f75388ff110f",
                                        "entry_id": "d4eaf27c-a3a1-3359-9dbb-a2714db3b0a6",
                                        "glosses": [
                                            "(männliche^☆) Person, die in einem Chor singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c24755-3313-4ae0-ba3c-6cb3fb13f194",
                                                "sense_id": "27319404-4de4-3fda-bb06-f75388ff110f",
                                                "text": "„Einige Chorsänger hätten erklärt, sie würden \"nicht singen\", sollte das Problem nicht gelöst werden.“"
                                            },
                                            {
                                                "example_id": "1f940222-9aad-48ae-89f8-81391d9372ae",
                                                "sense_id": "27319404-4de4-3fda-bb06-f75388ff110f",
                                                "text": "„Das war anders, als sie selbst in Salzburg als Tochter zweier Chorsänger aufwuchs.“"
                                            },
                                            {
                                                "example_id": "fe830647-0964-4725-a90b-3916cf802234",
                                                "sense_id": "27319404-4de4-3fda-bb06-f75388ff110f",
                                                "text": "„Es war nicht für die einfachen Gläubigen bestimmt, von denen die meisten es ohnehin weder hätten bezahlen noch benutzen können, sondern für Chorsänger und Kantoren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70a476ff-ebbe-44e4-af16-11736ca73249",
                        "source_entry_id": "d10b04c4-ae28-3047-84d0-35023c99dd8c",
                        "source_sense_description": "singer in a choir",
                        "target_lang_word": "Chorsängerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chorsängerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76a99d13-bf4a-3a63-8def-b9f1a4de24a8",
                                        "entry_id": "3ee9f838-f294-30e5-a04c-d53ce67ffda1",
                                        "glosses": [
                                            "weibliche Person, die in einem Chor singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
