                "senses": [
                    {
                        "sense_id": "6448003e-d1a2-3a37-9442-1b56a0134339",
                        "entry_id": "a75c98d8-7682-3c90-beb9-3799991eb185",
                        "glosses": [
                            "Einatmung von Gasen, Dämpfen oder zerstäubten Flüssigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b0a563-7ae0-49da-98b9-db8fde863995",
                                "sense_id": "6448003e-d1a2-3a37-9442-1b56a0134339",
                                "text": "„Eine Inhalation bedeutet die gezielte Einatmung eines künstlichen Aerosols bestehend aus einem Transportmittel und Wirkstoff(en).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "711fdc58-6539-4257-b6a9-943606473367",
                        "source_entry_id": "a75c98d8-7682-3c90-beb9-3799991eb185",
                        "source_sense_id": "6448003e-d1a2-3a37-9442-1b56a0134339",
                        "source_sense_description": "Einatmung von Gasen, Dämpfen oder zerstäubten Flüssigkeiten",
                        "target_lang_word": "inhalation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhalation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35dabf89-0479-3146-9913-ec85c1ae5f0a",
                                        "entry_id": "30e7ae23-f201-35cf-9d0a-9f84d2577b1f",
                                        "glosses": [
                                            "The act of inhaling; inbreathing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26cf8290-0c65-462c-a703-722ccf30b930",
                                                "sense_id": "35dabf89-0479-3146-9913-ec85c1ae5f0a",
                                                "text": "On Ickerson's part, with the help of \"a few post-jentacular inhalations,\" as he in his colossal manner was pleased to phrase it, \"from that fragrant weed which so propitiates clearness of thought, and tends to promote equanimity in action.\""
                                            },
                                            {
                                                "example_id": "905edb40-3921-4a6b-a7e1-30dd86bc31df",
                                                "sense_id": "35dabf89-0479-3146-9913-ec85c1ae5f0a",
                                                "text": "The girl stooped to pluck a rose, and as she bent over it, her profile was clearly outlined. She held the flower to her face with a long-drawn inhalation, then went up the steps, crossed the piazza, opened the door without knocking, and entered the house with the air of one thoroughly at home."
                                            },
                                            {
                                                "example_id": "d71b646a-6206-4bec-957b-884d3b413b17",
                                                "sense_id": "35dabf89-0479-3146-9913-ec85c1ae5f0a",
                                                "text": "The Invisible Killer Dihydrogen monoxide is colorless, odorless, tasteless, and kills uncounted thousands of people every year. Most of these deaths are caused by accidental inhalation of DHMO, but the dangers of dihydrogen monoxide do not end there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a6224c3-6b98-3dad-9f7f-dc8eb50b0df3",
                                        "entry_id": "30e7ae23-f201-35cf-9d0a-9f84d2577b1f",
                                        "glosses": [
                                            "The substance (medicament) which is inhaled."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "986c077b-6de4-422b-950e-4dbbed73ea10",
                        "source_entry_id": "a75c98d8-7682-3c90-beb9-3799991eb185",
                        "source_sense_id": "6448003e-d1a2-3a37-9442-1b56a0134339",
                        "source_sense_description": "Einatmung von Gasen, Dämpfen oder zerstäubten Flüssigkeiten",
                        "target_lang_word": "inhalation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhalation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f75e919-e798-3fbf-833e-e08bd0cd0717",
                                        "entry_id": "27ebdf71-75cf-3ae3-bcf7-0f569efd54b3",
                                        "glosses": [
                                            "Action d’aspirer, d’absorber par inspiration."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b3eb80b-67da-4c9f-870d-f1c5162bd5e9",
                                                "sense_id": "0f75e919-e798-3fbf-833e-e08bd0cd0717",
                                                "text": "De loin, l’inhalation paraît amère, vaguement vénéneuse. On l’assimile aux gargarismes, qui laissent dans la bouche un goût fade et cuivré. Mais après tout, on est si mal, la tête lourde et prise. On a soudain l’impression qu’un peu de mieux viendra de la cuisine."
                                            },
                                            {
                                                "example_id": "656d59ac-7019-4c9b-8981-d2b51337096d",
                                                "sense_id": "0f75e919-e798-3fbf-833e-e08bd0cd0717",
                                                "text": "Surveillez toujours un enfant ou une personne âgée en inhalation : la respiration doit être facilitée, l’inhalation agréable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d3fc857-4c54-3e24-abda-b28d08f7ecfa",
                                        "entry_id": "27ebdf71-75cf-3ae3-bcf7-0f569efd54b3",
                                        "glosses": [
                                            "Inspiration de certaines substances, telles que l’éther, le chloroforme, etc., dont on se sert pour produire l’anesthésie. Il se dit aussi de l’absorption de gaz ou de vapeurs thérapeutiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f99264-f06d-4760-a308-607b2528e06b",
                                                "sense_id": "0d3fc857-4c54-3e24-abda-b28d08f7ecfa",
                                                "text": "Sur un Kleenex j’ai capté une odeur sucrée, médicamenteuse, qui m’a rappelé les inhalations que me faisait subir ma mère lorsque j’étais enrhumée, tête recouverte par une serviette, penchée au-dessus d’une bassine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a99abb0-20bf-3556-b2cb-c752c5324c31",
                                        "entry_id": "27ebdf71-75cf-3ae3-bcf7-0f569efd54b3",
                                        "glosses": [
                                            "Action organique des plantes, par laquelle elles se pénètrent, s’imbibent de l’air, des fluides au milieu desquels elles vivent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
