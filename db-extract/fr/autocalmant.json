                "senses": [
                    {
                        "sense_id": "8a10facf-fa7f-3275-8165-c3fee91699d3",
                        "entry_id": "021f9a7f-12ef-3a22-8566-d5113a35048d",
                        "glosses": [
                            "Qui permet de se calmer par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34d74a02-5dc6-4429-8798-a1d895e4c558",
                                "sense_id": "8a10facf-fa7f-3275-8165-c3fee91699d3",
                                "text": "Ce mouvement, témoin de survie, en s’épuisant de tourner en rond sans recours à l’autre, véritable procédé autocalmant est, en fait, immobile dans son excitation comme la fugue qui est sans avenir, sans horizon, apulsionnelle."
                            },
                            {
                                "example_id": "a3c8effb-3a06-43db-aa0e-65b6453a5416",
                                "sense_id": "8a10facf-fa7f-3275-8165-c3fee91699d3",
                                "text": "Plusieurs explications peuvent rendre compte de la fonction autocalmante de l’hyperphagie."
                            },
                            {
                                "example_id": "2803dd37-e4e7-4bd8-8d7c-428c302ed36f",
                                "sense_id": "8a10facf-fa7f-3275-8165-c3fee91699d3",
                                "text": "Si la répétition conduit à un moment à la possibilité de liaison des excitations, il y aurait une évolution des procédés autocalmants qui se manifesterait par l’apparition d’activités sublimatoires."
                            }
                        ]
                    }
