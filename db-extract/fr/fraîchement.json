                                        "sense_id": "c03361f7-ef85-3b74-bc65-e02bdcaf2f45",
                                        "entry_id": "249b66a7-7ff0-3e99-afeb-696d58cd4dea",
                                        "glosses": [
                                            "At a moderately low temperature."
                                        ],
                                        "tags": [],
