                        "form": "den Kirchturm"
                    },
                    {
                        "form_id": "e42da67f-aa68-40b4-891d-34d57b3ccefb",
                        "entry_id": "81e35b3e-3bdd-3881-8a86-16779d259af5",
                        "tags": [
                            "accusative",
