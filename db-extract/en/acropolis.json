                                "target_senses": [
                                    {
                                        "sense_id": "5648afdc-532e-354f-a681-3c5ab11b8e5b",
                                        "entry_id": "aefe3c84-4e4e-36ed-94b6-e644b3e53b40",
                                        "glosses": [
                                            "vyvýšená opevněná část řeckého města"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f898186-7653-3fa0-820c-18de6f3c53b9",
                                        "entry_id": "aefe3c84-4e4e-36ed-94b6-e644b3e53b40",
                                        "glosses": [
                                            "hrad nebo pevnost na vyvýšeném místě"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87edfcec-2ab8-410a-be1e-602049d67f46",
                                                "sense_id": "3f898186-7653-3fa0-820c-18de6f3c53b9",
                                                "text": "Mocný hrad pánů z Eisenhardtů byl kolem roku 1500 rozbořen Turky, kteří zpustošili širé lány a neušetřili ani akropole kraje."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca9a678c-7ef3-41f3-a1e1-6c8de1b0d132",
                        "source_entry_id": "9f3de74c-cd0c-31fc-814f-ce517ef568ac",
