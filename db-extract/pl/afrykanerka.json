                                "target_senses": [
                                    {
                                        "sense_id": "5dcf029a-791e-3714-b219-efae0e47a1e8",
                                        "entry_id": "bf76e6fc-e7ba-35a6-84a2-07f550d7ee4b",
                                        "glosses": [
                                            "in der Republik Südafrika oder im heutigen Namibia geborene, Afrikaans sprechende Weiße"
