                                        "glosses": [
                                            "aus der wertenden Perspektive gesehen, aus der es „richtig“ und „falsch“ in der Benutzung von Sprache gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8b8663-f7af-49cf-8083-18920337e885",
                                                "sense_id": "6632f5c4-260e-3642-a28c-598a7896af00",
                                                "text": "Aus präskriptiver Sicht ist die Benutzung dieser Formulierung schlichtweg falsch."
                                            },
                                            {
                                                "example_id": "af0ba1b0-e824-440d-bfe5-bad87e3751c6",
                                                "sense_id": "6632f5c4-260e-3642-a28c-598a7896af00",
                                                "text": "„Diese Formulierungen zeigen die Abwendung von einer eher präskriptiven Sprachbeschreibung zugunsten einer eher deskriptiven Orientierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
