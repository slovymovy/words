                        "entry_id": "05a69ef0-e810-3ad8-b9d0-3bc04896100d",
                        "glosses": [
                            "Personne qui pratique le chat (clavardage) sur internet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b590a796-ba85-40d7-aa61-cb2546e30f8d",
                                "sense_id": "f9635976-c3a2-3b40-b63a-be8cb3cad425",
                                "text": "De temps à autre, Tzion la testait, se faisant passer pour un chatteur lambda."
