                                "target_senses": [
                                    {
                                        "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                        "entry_id": "310b9d74-ba2d-3f49-955a-b7c05bb645d9",
                                        "glosses": [
                                            "Bergweide oder Bergwiese, auf der im Sommer Weidewirtschaft, gegebenenfalls auch Gastronomie und Bewirtung betrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91227d3a-c9e0-4d19-a449-8022ed1e5b49",
                                                "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                                "text": "Der Hirte führte seine Schafe und Lämmer auf die Alm hinaus, um sie grasen zu lassen."
                                            },
                                            {
                                                "example_id": "594fc3de-20d7-4f60-ae03-24ee986dba84",
                                                "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                                "text": "„Da gab's dann bald mehr Diskos als Kühe in den Dörfern, in den Landgasthöfen sprudelten die Whirlpools, und die Sennerinnen wurden mit dem Paragleiter auf die Alm geflogen.“"
                                            },
                                            {
                                                "example_id": "ab4cd08b-4efc-4aec-9170-3db8ab8d6705",
                                                "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                                "text": "„Mit zwei Wanderstöcken in den Fäusten spaziert sie an einem Sommertag im Jahr 2020 bedächtig über grüne Almen zur Wallfahrtskapelle Maria Birkenstein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
