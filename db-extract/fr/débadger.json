                ],
                "senses": [
                    {
                        "sense_id": "67a0881c-5858-31c3-b750-23253592cc53",
                        "entry_id": "509b55c4-c7da-3eaf-9035-4143aee045ca",
                        "glosses": [
                            "Passer à la badgeuse quand on arrête de travailler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d6da868-ab83-493b-a181-9fcc9c4ef222",
                                "sense_id": "67a0881c-5858-31c3-b750-23253592cc53",
                                "text": "Les salariés qui vont fumer doivent débadger quand ils sortent de l’immeuble et rebadger quand ils regagnent leur bureau."
                            },
                            {
                                "example_id": "4e680cee-ca0e-49e2-834c-00e45cea8293",
                                "sense_id": "67a0881c-5858-31c3-b750-23253592cc53",
                                "text": "Badger et débadger n’est pas une manière de d’évaluer les gens."
                            },
                            {
                                "example_id": "bdc3eabc-787d-4d4e-a254-cc50b8e0c9d6",
                                "sense_id": "67a0881c-5858-31c3-b750-23253592cc53",
                                "text": "Les salariés d’une entreprise avaient l’habitude (tolérée par leur employeur) de prendre des pauses de courte durée pour lesquelles ils n’étaient pas contraints de « débadger », c’est-à-dire de constater que le temps de pause n’était plus du temps de travail effectif."
                            },
                            {
                                "example_id": "00d70a89-6a65-42e0-ac71-c413118d9ad2",
                                "sense_id": "67a0881c-5858-31c3-b750-23253592cc53",
                                "text": "Et maintenant, ils veulent même que l’on débadge lorsque l’on va fumer une cigarette. Vous rendez-vous compte ?"
                            }
                        ]
                    }
                ],
