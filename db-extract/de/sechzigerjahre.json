                ],
                "senses": [
                    {
                        "sense_id": "7b87e2c8-1a40-392b-9edf-04f4719d4798",
                        "entry_id": "d85e7e94-dfc7-35e7-b812-57256ee633eb",
                        "glosses": [
                            "die Jahre 60 bis 69 des gegenwärtigen oder besagten Jahrhunderts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dcd28e9-6948-4611-95d7-339d25e7c513",
                                "sense_id": "7b87e2c8-1a40-392b-9edf-04f4719d4798",
                                "text": "„Viele Jahre später, als ich die Geschichte schon fast vergessen hatte, las ich ein Interview mit einem persischen Dichter, der seit den Sechzigerjahren in München im Exil lebte.“"
                            },
                            {
                                "example_id": "f50ce3e6-b6a7-4a12-9923-25740f7cec9d",
                                "sense_id": "7b87e2c8-1a40-392b-9edf-04f4719d4798",
                                "text": "„Ich erinnere mich nicht genau an jenen Tag, denn ich war wohl nicht älter als elf, zwölf Jahre, es dürfte Anfang der Sechzigerjahre gewesen sein.“"
                            },
                            {
                                "example_id": "e150df6e-ba57-44a7-8760-6d86ed61f859",
                                "sense_id": "7b87e2c8-1a40-392b-9edf-04f4719d4798",
                                "text": "„Ich selbst war Anfang der Sechzigerjahre Dramaturg bei den Württembergischen Staatstheatern, formal »Chefdramaturg«, also für die drei Sparten des Theaters zuständig, Oper, Schauspiel und Ballett.“"
                            },
                            {
                                "example_id": "9e43a967-6a3f-4783-bb7c-38b37023ce39",
                                "sense_id": "7b87e2c8-1a40-392b-9edf-04f4719d4798",
                                "text": "„Das Foyer sah aus wie eine italienische Eisdiele aus den Sechzigerjahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
