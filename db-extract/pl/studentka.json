                    },
                    {
                        "translation_id": "4573390b-718f-4c09-9d72-3d203829f602",
                        "source_entry_id": "9c9abfe2-ea5b-3055-86d0-6822cfe3dbf3",
                        "source_sense_id": "291f9bda-73fe-3a8a-aa38-a556a22e7825",
                        "target_lang_word": "studentka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "studentka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "666e2718-7e51-3a79-803b-a0ea25dfb6fc",
                                        "entry_id": "4801a806-d399-3e81-9f85-a0db31905845",
                                        "glosses": [
                                            "dívka či žena, která studuje střední či vysokou školu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b942f2-3c0c-4ba8-bb3a-3886223483a9",
                                                "sense_id": "666e2718-7e51-3a79-803b-a0ea25dfb6fc",
                                                "text": "Přestože byla vždycky vzorně prospívající studentka, nakonec se z neznámých příčin rozhodla nepodat si přihlášku na vysokou školu."
                                            },
                                            {
                                                "example_id": "733e035b-8648-4e4d-a5e0-fde316524b0b",
                                                "sense_id": "666e2718-7e51-3a79-803b-a0ea25dfb6fc",
                                                "text": "Anna zhasila lampu a lehla si. Pomodlit se před spaním, jak doma činívala, odnavykla si již pražská studentka."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f28a996-c4c6-49b6-9168-fbe84184c23a",
                        "source_entry_id": "9c9abfe2-ea5b-3055-86d0-6822cfe3dbf3",
                        "source_sense_id": "291f9bda-73fe-3a8a-aa38-a556a22e7825",
                        "target_lang_word": "étudiante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étudiante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c90d8f21-8a92-328c-82cd-dedd54482f27",
                                        "entry_id": "c887072c-a1ec-3624-ba5a-22884fac7431",
                                        "glosses": [
                                            "Femme qui suit les cours d’une université ou d’un autre établissement d’enseignement supérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fadfd6d8-e5a4-4204-9d18-ec44759d7d17",
                                                "sense_id": "c90d8f21-8a92-328c-82cd-dedd54482f27",
                                                "text": "En rentrant un soir, vers minuit, dans ma chambre d’étudiante, je trouvais un billet sous ma porte."
                                            },
                                            {
                                                "example_id": "97736d01-a076-497d-ac53-05e09204311d",
                                                "sense_id": "c90d8f21-8a92-328c-82cd-dedd54482f27",
                                                "text": "On n’a jamais très bien compris ce qu’on reprochait aux poses très prudes et un rien mélancolique de l’étudiante génépiste qui s'y était prêtée."
                                            },
                                            {
                                                "example_id": "a5ce77bd-9e2a-4bc9-9007-e0f76ee73359",
                                                "sense_id": "c90d8f21-8a92-328c-82cd-dedd54482f27",
                                                "text": "À la fermeture de la boutique, vers 19 h 30, des sacs blancs sont posés sur le muret en face de la boulangerie. À l’intérieur : sandwiches et viennoiseries. « Tout ce qui n’a pas été vendu dans la journée », explique José Louiset, propriétaire des boulangeries Au bon vieux temps et du Fournil du Chapeau rouge. Depuis un an et demi, les étudiants et les sans-abri se regroupent souvent devant la boutique. « On ne pourrait pas s’acheter autant de pain sinon. Et le sandwich ça fait un repas », commente Lola, étudiante aux Beaux-arts de Quimper qui vient ici « au moins une fois par semaine »."
                                            },
                                            {
                                                "example_id": "452ef117-9b50-416e-b2ad-2821636f6103",
                                                "sense_id": "c90d8f21-8a92-328c-82cd-dedd54482f27",
                                                "text": "Nous sommes en mars 2020, Lilwen Letondeur, étudiante de 19 ans en prépa littéraire, est bénévole à la Croix-Rouge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c72255f8-2cfc-3a25-89f7-f3fe7850b10c",
                                        "entry_id": "c887072c-a1ec-3624-ba5a-22884fac7431",
                                        "glosses": [
                                            "Grisette : amante, souvent pauvre, d’un étudiant (au xixᵉ siècle)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7f68aa-0da1-4b05-a823-7658443803e6",
                                                "sense_id": "c72255f8-2cfc-3a25-89f7-f3fe7850b10c",
                                                "text": "Le quartier latin est peuplé d’une foule de grisettes d’un genre particulier et que l’on nomme les étudiantes, bien qu’aucun observateur n’ait pu encore déterminer le genre de sciences qu’elles cultivent."
                                            },
                                            {
                                                "example_id": "c2f4cf9d-9d93-4ac5-a214-bcd965c15093",
                                                "sense_id": "c72255f8-2cfc-3a25-89f7-f3fe7850b10c",
                                                "text": "L’étudiante n’existe donc pas encore si ce n’est dans une définition purement péjorative de fille aux mœurs légères. Elle n’est en rien une femme qui suit des cours mais simplement celle qui « couche » avec l’étudiant."
                                            },
                                            {
                                                "example_id": "04d19c4a-bbf0-40fe-a555-62617a9345d0",
                                                "sense_id": "c72255f8-2cfc-3a25-89f7-f3fe7850b10c",
                                                "text": "Abandonnée, telle la Fantine des Misérables, dont l’amant Tholomyès est rentré au pays faire un bon mariage et devenir avoué, l’étudiante, grisette ou lorette déchue, peut tomber dans la misère, voire la prostitution."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "étudiante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2116cec2-54d7-36b5-99a3-f7f4f14abb14",
                                        "entry_id": "1496a5c1-98f3-38ac-b5f6-5f57477e7d25",
                                        "glosses": [
                                            "Féminin singulier de étudiant."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad26f598-b7dc-4328-8bae-63c6cb6b54d8",
                                                "sense_id": "2116cec2-54d7-36b5-99a3-f7f4f14abb14",
                                                "text": "« En s’inscrivant avec son adresse mail étudiante, on a le droit à des promotions », détaille Morgan, responsable du BDE de l’Efrei Paris, où étudiait Tom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
