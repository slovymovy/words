                        "glosses": [
                            "Salable; able to be bought, sold, or traded."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8605f87-99a1-4ab1-b301-45a4b4402782",
                                "sense_id": "cc786efa-dc8e-39da-aa3d-811cb06da510",
                                "text": "But as for the multitude of Sermons ready printed and pil'd up, on every text that is not difficult, our London trading St. Thomas in his veſtry, and adde to boot St. Martin, and St. Hugh, have not within their hallow'd limits more vendible ware of all ſorts ready made: […]"
                            },
                            {
                                "example_id": "d1059d67-2f4d-44b2-9b3c-0836cc95851e",
                                "sense_id": "cc786efa-dc8e-39da-aa3d-811cb06da510",
                                "text": "the regulating of prices of things vendible"
                            },
                            {
                                "example_id": "a4173e09-fe27-4ecc-8b50-d2cf746c1fb8",
                                "sense_id": "cc786efa-dc8e-39da-aa3d-811cb06da510",
                                "text": "[I]f thou have any vendible faculty, nay if thou have but edacity and loquacity, come!"
                            }
                        ]
                    }
