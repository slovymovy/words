            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e664e272-77f7-3945-9b37-6747f0689e31",
                    "sense_definition": "An excessive, obsessive concern with minor details, formal rules, or precision.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pedantry_rules",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant correction of minor grammar errors seemed like pure <w>pedantry</w> to his colleagues."
                        },
                        {
                            "text": "The committee abandoned practical solutions in favor of bureaucratic <w>pedantry</w>."
                        }
                    ],
                    "synonyms": [
                        "pedanticness",
                        "pedanticalness"
                    ],
                    "common_phrases": [
                        "bureaucratic pedantry",
                        "academic pedantry",
                        "mere pedantry"
                    ]
                },
                {
                    "sense_id": "86cdf555-d8f0-3560-a1fb-18c59e3e7b87",
                    "sense_definition": "An ostentatious or inappropriate display of book learning and academic knowledge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pedantry_learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His lectures were spoiled by intellectual <w>pedantry</w> rather than genuine insight."
                        },
                        {
                            "text": "She avoided scholarly <w>pedantry</w> by explaining complex scientific concepts in simple terms."
                        }
                    ],
                    "common_phrases": [
                        "intellectual pedantry",
                        "scholarly pedantry"
                    ]
                },
                {
                    "sense_id": "1bfb6ecb-234c-3b56-93b3-482db8f2a6d9",
                    "sense_definition": "A specific act or instance of excessive attention to rules or showing off knowledge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pedantry_rules",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He interrupted the discussion with endless <w>pedantries</w> about archaic legal definitions."
                        },
                        {
                            "text": "I refuse to waste time arguing over trivial <w>pedantries</w> during this meeting."
                        }
                    ],
                    "common_phrases": [
                        "trivial pedantries"
                    ]
                }
            ]
        }
