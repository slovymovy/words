                                        "entry_id": "90bb872d-d79e-3182-a313-fc57ce77b21b",
                                        "glosses": [
                                            "Person, die einen Menschen für eine Gegenleistung ermordet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21346b48-a0a5-4672-aa9b-b8db8c9ee7fb",
                                                "sense_id": "ad44f2e7-781f-394c-8e77-23b4465040fa",
                                                "text": "Traurige Berühmtheit, die ihn sogar auf die Titelseite des Spiegels brachte, erlangte in der Bundesrepublik Deutschland der Auftragsmörder Werner „Mucki“ Pinzner."
                                            },
                                            {
                                                "example_id": "332755bd-dc3b-482a-98cc-4b4646414da2",
                                                "sense_id": "ad44f2e7-781f-394c-8e77-23b4465040fa",
                                                "text": "„Die Polizei hat einen Wiener festgenommen, der im Mai 2021 im Darknet einen Auftragsmörder gesucht und schon bezahlt haben soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
