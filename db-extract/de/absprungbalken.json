                "senses": [
                    {
                        "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                        "entry_id": "1dd6d369-c1ab-3260-b8c1-b85f9083b67b",
                        "glosses": [
                            "Markierung auf dem Boden, vor dem oder von dem Weitspringer und Dreispringer abspringen müssen"
                        ],
                        "tags": [
                            "Leichtathletik"
                        ],
                        "examples": [
                            {
                                "example_id": "91992a2d-8643-4550-9c72-81d48557ada0",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "„Der Absprungbalken wurde 1886 das erste Mal eingeführt.“"
                            },
                            {
                                "example_id": "aa31861e-f871-4d4c-a521-d29ee2f736e4",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "„Direkt an der Absprunglinie wird ein Einlegebrett mit Plastilin in den Absprungbalken gelegt.“"
                            },
                            {
                                "example_id": "1ac73608-94b4-4bc1-bc62-7f33e9f7d23c",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "Der Absprungbalken ist ein „Brett aus verleimtem Schichtholz, manchmal, um witterungsbeständiger zu sein, auch aus Kunststoff, gepresstem Gummi oder einer Kombination aus Aluminium und Holz.“"
                            },
                            {
                                "example_id": "e9e48916-3bbd-449e-b9c6-1e512733408a",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "„Der Wettkämpfer läuft auf einer Anlaufbahn bis zu einem Absprungbalken, von dem der Sprung gemessen wird.“"
                            },
                            {
                                "example_id": "2438b2ea-af10-4ee7-8aa6-0f88e6474d5c",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "„Gemessen wird vom Absprungbalken zum nächstliegenden Abdruck im Sand.“"
                            },
                            {
                                "example_id": "79aac053-9ed6-460e-ae15-fe4284c48c60",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "[Dreisprung:] „Der Absprungbalken ist international mindestens elf Meter von der sandgefüllten Sprunggrube entfernt.“"
                            },
                            {
                                "example_id": "719d41e9-7c29-4e87-8fb1-d815bbd23f84",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "[Weltrekordsprung von Bob Beamon 1968 mit 8,90m:] „Zum anderen blies bei Beamons Anlauf Rückenwind in der für Weltrekorde höchsten noch zulässigen Stärke von 2 m/s und er traf den Absprungbalken perfekt.“"
                            },
                            {
                                "example_id": "9f89aed9-95ed-472d-a5c1-a3398c97ca4c",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "[Bob Beamon: …] „»Ich hätte mich beinahe nicht für das Finale qualifiziert, weil ich Probleme mit meinen Schuhen und dem Absprungbalken hatte. Alles kam auf den letzten Sprung an.«“"
                            },
                            {
                                "example_id": "9e110b45-2393-48a8-9d4a-65247c1e32d0",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "„Einen Tag nach ihrem 30. Geburtstag hatte sie große Probleme mit dem Anlauf und traf den Absprungbalken bei keinem ihrer drei Versuche richtig und korrekt.“"
                            },
                            {
                                "example_id": "dd0a0aa7-b406-48d8-9092-8cb6d411f4b7",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "„Drei Fahrradreifen hat sie vor dem Absprungbalken platziert. »Kurz-lang-kurz ist der Laufrhythmus vor dem Absprung«, erklärt David.“"
                            },
                            {
                                "example_id": "4cc46b9f-8a6c-4217-a8d2-f3e93b34d3ef",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "„Der Leichtathletik-Weltverband World Athletics plant eine Regeländerung: Der Absprungbalken soll abgeschafft und stattdessen eine Absprungzone eingeführt werden.“"
                            },
                            {
                                "example_id": "88053e3e-4b27-4eb0-842f-f0a845c55aff",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "„Der Absprungbalken gehört zum großen Spektakel im Weitsprung. Nun denkt der Weltverband darüber nach, ihn abzuschaffen. Das würde den gesamten Sport verändern.“"
                            },
                            {
                                "example_id": "4855c2d5-38aa-4de7-baa9-14e2879d8734",
                                "sense_id": "0233bbe1-c204-35c6-8692-42b71762f2ae",
                                "text": "„Schäfer, der vor vier Jahren in Dubai mit einer Weite von 6,90 Meter den WM-Titel gewonnen hatte, sprang nun ein gutes Stück vor dem Absprungbalken ab, wer wollte es ihm verdenken, und landete bei 6,52 Meter – womit er sich in dem zwölfköpfigen Starterfeld auf Platz vier einreihte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
