                        "glosses": [
                            "Ouvrière qui travaille le chanvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5972ee81-220b-484d-b762-722fcbe8b6ee",
                                "sense_id": "38a6514c-6aab-35cc-aabb-48eade0d006a",
                                "text": "J'ai senti les premières morsures des voluptés devant le spectacle de deux seins blancs légèrement agités par le mouvement que se donnait une paysanne pour broyer du chanvre. […]. Elle n'était pas seule à son travail, trois autres chanvrières s'agitaient à côté d'elle. Mais celles-là, quoique tout aussi jeunes, n'avaient pas l'orgueil du corsage."
                            }
                        ]
                    }
