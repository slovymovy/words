                "senses": [
                    {
                        "sense_id": "ad837009-2b35-371b-b7e7-630c20d163be",
                        "entry_id": "ab18f988-66c0-38fb-819a-692a4ae95582",
                        "glosses": [
                            "Situation, in der ein Fahrzeug kurzzeitig quer steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9355e7ba-cf45-405d-aad0-d4447c5c3d0a",
                                "sense_id": "ad837009-2b35-371b-b7e7-630c20d163be",
                                "text": "„Zwar sorgte kein Pilot für Kleinholz, zahlreiche Quersteher verdeutlichten aber die Schwierigkeit, die DTM-Boliden auf der engen Strecke von den Mauern fernzuhalten.“"
                            },
                            {
                                "example_id": "63580eaa-3e8a-480a-90b2-830f8bd72b27",
                                "sense_id": "ad837009-2b35-371b-b7e7-630c20d163be",
                                "text": "„Der machte ihm das Unterfangen auch noch leicht, indem er mit einem kapitalen Verbremser und Quersteher noch zusätzlich Zeit verlor.“"
                            },
                            {
                                "example_id": "5e9d49f1-4f0d-4bbc-aa8f-91045c809223",
                                "sense_id": "ad837009-2b35-371b-b7e7-630c20d163be",
                                "text": "„Michael hatte einen kleinen Quersteher in der letzten Schikane - mehr als Platz zehn war dann nicht mehr drin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
