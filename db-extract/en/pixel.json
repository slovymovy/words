                                "target_senses": [
                                    {
                                        "sense_id": "c33e6175-a82c-3d2d-866a-3e44651be163",
                                        "entry_id": "0efeb148-7a83-34d9-a44f-da88d6d68689",
                                        "glosses": [
                                            "een beeldpunt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98b332d-c921-4b7b-afb4-67cf8791e03c",
                                                "sense_id": "c33e6175-a82c-3d2d-866a-3e44651be163",
