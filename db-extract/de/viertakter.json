                "senses": [
                    {
                        "sense_id": "3f002bff-219e-3f09-95e1-e14b8be233ab",
                        "entry_id": "46ed3336-b642-3472-8ce3-b8625e5554d1",
                        "glosses": [
                            "Verbrennungsmotor mit vier Arbeitsgängen, die während zweier Umdrehungen der Kurbelwelle durchlaufen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a0dceee-3438-4c82-a5d6-d2e1b68d8d65",
                                "sense_id": "3f002bff-219e-3f09-95e1-e14b8be233ab",
                                "text": "„Den Rollerfahrern kam auch entgegen, dass der Zweitakter einfacher zu tunen war, als es der Viertakter ist.“"
                            },
                            {
                                "example_id": "08416544-d99b-41c8-8ae5-f7d3f3e4842b",
                                "sense_id": "3f002bff-219e-3f09-95e1-e14b8be233ab",
                                "text": "„Als man merkte, dass ich konsequent auf den Viertakter zusteuerte, hat man mich bekämpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
