                        ]
                    },
                    {
                        "translation_id": "b9732863-4ed4-4549-ab99-7f65575391c5",
                        "source_entry_id": "79c7dc06-fef0-349b-9367-defe564b6672",
                        "source_sense_id": "53c78523-ff7c-359e-a65d-cd924ef261af",
                        "source_sense_description": "in a tender manner",
                        "target_lang_word": "мя́гко",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мя́гко",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "04d137f4-f89a-342d-818e-32acf967703d",
                                        "entry_id": "b7b0ac99-a481-31f3-8f70-e37ca406043e",
                                        "glosses": [
                                            "наречие к мягкий"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aac1350-d525-46be-85af-d08c1cdebe93",
                                                "sense_id": "04d137f4-f89a-342d-818e-32acf967703d",
                                                "text": "Высокая трава мягко обвивалась около колёс и ног лошади, оставляя свои семена на мокрых спицах и ступицах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cc3e50f-891e-36bc-b507-f68cfade1f40",
                                        "entry_id": "b7b0ac99-a481-31f3-8f70-e37ca406043e",
                                        "glosses": [
                                            "аккуратно, плавно; без толчков или ударов"
                                        ],
                                        "tags": [
                                            "наречие"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9756781-14f5-4e78-9708-d934a9b7a614",
                                                "sense_id": "1cc3e50f-891e-36bc-b507-f68cfade1f40",
                                                "text": "«Боинг» мягко коснулся подмосковной земли и, теряя скорость, побежал по летному полю."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b8e8c9e-105d-3e71-a519-a6f789483ddb",
                                        "entry_id": "b7b0ac99-a481-31f3-8f70-e37ca406043e",
                                        "glosses": [
                                            "перен. без нажима, жестокости или строгости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "158cc8fa-a430-475c-9699-8a36f21b043f",
                                                "sense_id": "6b8e8c9e-105d-3e71-a519-a6f789483ddb",
                                                "text": "Однако Цюрупа заметил мою неловкость и очень мягко спросил у меня, какой я люблю кофе — с молоком или с лимоном."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12e82ee4-0e39-3918-a2d8-e8c12b2a6e7f",
                                        "entry_id": "b7b0ac99-a481-31f3-8f70-e37ca406043e",
                                        "glosses": [
                                            "хорошо, комфортно, уютно"
                                        ],
                                        "tags": [
                                            "в значении сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dee0bbc-37e0-4db5-beea-f1f7f012b5e0",
                                                "sense_id": "12e82ee4-0e39-3918-a2d8-e8c12b2a6e7f",
                                                "text": "Ещё было мягко в Бутырках: можно было ночью прятать руки под шинель, на ночь не отбирали очков, пропускали в камеру спички, не выпотрашивали из каждой папиросины табак, а хлеб в передачах резали только на четыре части, не на мелкие кусочки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
