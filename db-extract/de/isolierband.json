                    {
                        "translation_id": "52ec4e28-c736-494d-9b12-a52bcf4dcc1a",
                        "source_entry_id": "32598520-0f8c-3cd3-b841-4f3e69cf36d3",
                        "source_sense_id": "64cbeaa2-facb-38a3-ad42-8f11113314f1",
                        "source_sense_description": "Klebestreifen zum Umwickeln elektrisch leitender Drähte",
                        "target_lang_word": "chatterton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chatterton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00f4ad20-82b4-3408-af7f-a546e1033e94",
                                        "entry_id": "30938a39-e639-32b0-811a-df23e3d94025",
                                        "glosses": [
                                            "Ruban isolant et adhésif en vinyle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ff7336c-2d07-4fa9-956f-88dd26111855",
                                                "sense_id": "00f4ad20-82b4-3408-af7f-a546e1033e94",
                                                "text": "La doublure de ma manche gauche est un petit peu déchirée… Je n'ai plus de chatterton… Tant pis, je vais mettre un clou."
                                            },
                                            {
                                                "example_id": "c739859f-b7c8-4d7e-835f-75e5bc5d7129",
                                                "sense_id": "00f4ad20-82b4-3408-af7f-a546e1033e94",
                                                "text": "… ses lunettes de documentaliste dont les verres sont fêlés et la monture rafistolée au chatterton."
                                            },
                                            {
                                                "example_id": "c5f97314-dea5-4333-9b1d-a90423e9d8d7",
                                                "sense_id": "00f4ad20-82b4-3408-af7f-a546e1033e94",
                                                "text": "Papa serre ma main dans sa grosse main épaisse dure pleine de crevasses et de chatterton d’électricien autour des doigts."
                                            },
                                            {
                                                "example_id": "9e62b1c4-f394-402d-82bb-0b8b00e11cf3",
                                                "sense_id": "00f4ad20-82b4-3408-af7f-a546e1033e94",
                                                "text": "Au lendemain de la guerre, l’Europe découvrit le chatterton, produit dérivé du ruban adhésif scotch de l’Américain « 3 M »."
                                            },
                                            {
                                                "example_id": "f6ceb74a-9b3d-4f86-91aa-a2e84b5b0349",
                                                "sense_id": "00f4ad20-82b4-3408-af7f-a546e1033e94",
                                                "text": "Réparez une petite fuite dans un tuyau d’évacuation en l’enveloppant de plusieurs couches de chatterton ou de ruban plastique adhésif souple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e33e37c-428e-399b-8868-4ca65162e710",
                                        "entry_id": "30938a39-e639-32b0-811a-df23e3d94025",
                                        "glosses": [
                                            "Ruban de toile plastifiée adhésive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
