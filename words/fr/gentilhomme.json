                        "pauvre gentilhomme"
                    ]
                },
                {
                    "sense_id": "427e1008-f5bb-3dc4-8834-69e85c5e5eb2",
                    "sense_definition": "Homme qui a des manières courtoises, distinguées et un comportement exemplaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a toujours su agir en <w>gentilhomme</w> dans les situations les plus délicates."
                        },
                        {
                            "text": "Même sans être né dans la noblesse, il se comporte comme un parfait <w>gentilhomme</w>."
