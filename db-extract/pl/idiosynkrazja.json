                                        "entry_id": "3e3be41e-f9db-3883-b5c7-fe60e474b756",
                                        "glosses": [
                                            "aangeboren overgevoeligheid voor bepaalde voedings- en geneesmiddelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734f940a-b71a-4ca4-ae0c-ac2dbbeb0808",
                                                "sense_id": "a6f23029-aa11-3d48-8e0d-22ba49ba2032",
                                                "text": "Idiosyncrasie tegen melk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379328f3-4611-3bc6-b118-bb24e2137d08",
                                        "entry_id": "3e3be41e-f9db-3883-b5c7-fe60e474b756",
                                        "glosses": [
                                            "kenmerkende eigenaardigheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f453b655-a13a-4d21-9e56-fd309a2ec3c6",
                                                "sense_id": "379328f3-4611-3bc6-b118-bb24e2137d08",
                                                "text": "Met behulp van de pioniers moest en zou de N.E.F. er uiteindelijk in slagen om de idiosyncrasie van de volkeren en haar interne heterogeniteit te overstijgen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28679d33-da07-4d2b-b7ea-c643c575e4eb",
                        "source_entry_id": "de233f01-3dca-3174-abf5-ef8e4025f480",
                        "source_sense_id": "b0037b3d-bcb3-30af-8e45-5eb079c61e4c",
                        "target_lang_word": "Idiosynkrasie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Idiosynkrasie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b8f1f46-9100-32a9-b995-bea41de798f9",
                                        "entry_id": "88f4b933-c32b-369d-81f4-1b2f11a17f1a",
                                        "glosses": [
                                            "Überempfindlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f550cecc-a368-4fab-98d4-2914c5c12948",
                                                "sense_id": "0b8f1f46-9100-32a9-b995-bea41de798f9",
                                                "text": "Eine angeborene Form der Allergie ist die Idiosynkrasie, die bereits beim allerersten Kontakt mit dem Stoff Reaktionen auslöst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54e0989d-4a90-3a02-84c4-61ecb8587e0c",
                                        "entry_id": "88f4b933-c32b-369d-81f4-1b2f11a17f1a",
                                        "glosses": [
                                            "spezifische oder besondere Eigenheit einer Person oder Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f8e321-3387-4e79-9a54-9e0b301fccad",
                                                "sense_id": "54e0989d-4a90-3a02-84c4-61ecb8587e0c",
                                                "text": "„Geschriebene Zeichen, wie sie sich etwa auf den Zeilen dieser Seite befinden, sind also hinsichtlich der Ausdrucksseite tendenziell anonym, und auch wenn die Identifizierung des Zeichenproduzenten anhand formaler Idiosynkrasien (z. B. Handschrift aber auch Schreibmaschine) ohne weiteres möglich ist, können von da keinerlei Schlüsse auf den Ursprung des Inhalts gezogen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3086cb7d-38cc-3707-a930-27f2df69955b",
                                        "entry_id": "88f4b933-c32b-369d-81f4-1b2f11a17f1a",
                                        "glosses": [
                                            "individuelle Abweichung von sozialer Norm (siehe auch [2])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf171cc6-01d1-42b6-b677-2da9d5e5170d",
                                                "sense_id": "3086cb7d-38cc-3707-a930-27f2df69955b",
                                                "text": "In der Gemeinschaft fallen manche Individuen durch ihre Idiosynkrasie auf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5c5e2421-3549-38d6-868d-9552565d23c1",
                                        "entry_id": "88f4b933-c32b-369d-81f4-1b2f11a17f1a",
                                        "glosses": [
                                            "spezifisches Merkmal eines sprachlichen Ausdrucks oder einer Sprachvarietät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "348e41e1-0e21-4ab2-8247-3c61a6c8925d",
                                                "sense_id": "5c5e2421-3549-38d6-868d-9552565d23c1",
                                                "text": "„Es gibt in der Tat zahlreiche dialektale Lautungen, die in keiner (bislang) erkennbaren Weise allgemeinen Gesetzmäßigkeiten unterliegen, sondern vermutlich als Idiosynkrasien gewertet werden müssen.“"
                                            },
                                            {
                                                "example_id": "5b55e96f-8794-400b-9a71-364a3320c812",
                                                "sense_id": "5c5e2421-3549-38d6-868d-9552565d23c1",
                                                "text": "„Der zweite Fall zeigt sich in der Kommunikation mit anderen Sprechern, die irgendwelche Idiosynkrasien haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f050b1ae-5be2-4f66-a420-5bd96c6635e0",
                        "source_entry_id": "de233f01-3dca-3174-abf5-ef8e4025f480",
                        "source_sense_id": "b0037b3d-bcb3-30af-8e45-5eb079c61e4c",
                        "target_lang_word": "идиосинкразия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "идиосинкразия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c75169f2-06ac-310d-b95b-1abe44c1e7a6",
                                        "entry_id": "13fc54de-5419-3d55-837f-d36d88aa3152",
                                        "glosses": [
                                            "мед. индивидуальная особенность организма, заключающаяся в болезненной реакции на некоторые раздражения (зрительные, вкусовые, обонятельные)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21052b37-88ff-4c9f-8ec7-2a469fa9a391",
                                                "sense_id": "c75169f2-06ac-310d-b95b-1abe44c1e7a6",
                                                "text": "Высшая доза морфия — три сантиграмма; взрослой, совсем не слабой больной впрыснули под кожу пять миллиграммов морфия, — и она умерла; для объяснения таких фактов в медицине существует специальное слово «идиосинкразия», но это слово не дает мне никаких указаний на то, когда я должен ждать чего-либо подобного."
                                            },
                                            {
                                                "example_id": "950a6b59-02b8-4553-a12a-a202b66aa183",
                                                "sense_id": "c75169f2-06ac-310d-b95b-1abe44c1e7a6",
                                                "text": "Есть организмы, которые к тем или иным наркотикам чувствуют идиосинкразию, — Гаврилова усыпляли уже двадцать семь минут."
                                            },
                                            {
                                                "example_id": "e8c2953f-6023-4e5e-999f-fa4effd76def",
                                                "sense_id": "c75169f2-06ac-310d-b95b-1abe44c1e7a6",
                                                "text": "Так вот, еще два месяца назад этот самый Глухов пожаловался Губарю, что огромная его, Глухова, работа, для которой он материал набирал чуть ли не десять лет, идет сейчас коту под хвост из-за очень странной идиосинкразии, которая у Глухова вдруг обнаружилась."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c866e0d2-820b-317c-ba6f-5c297046e47f",
                                        "entry_id": "13fc54de-5419-3d55-837f-d36d88aa3152",
                                        "glosses": [
                                            "перен. болезненное отвращение к кому-либо, чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ef33ba0-c5a7-4833-803d-eba69730cf1c",
                                                "sense_id": "c866e0d2-820b-317c-ba6f-5c297046e47f",
                                                "text": "У него идиосинкразия: не выносит даже вида мяса."
                                            },
                                            {
                                                "example_id": "53e5f5d6-fd39-49f4-bd4d-77c7c53eadfe",
                                                "sense_id": "c866e0d2-820b-317c-ba6f-5c297046e47f",
                                                "text": "— Могу поклясться, — улыбнулся Штирлиц, — всё писал, кроме стихов: у меня идиосинкразия к рифме."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e579467-599d-3c19-b20f-ddd23305a136",
                                        "entry_id": "13fc54de-5419-3d55-837f-d36d88aa3152",
                                        "glosses": [
                                            "перен. крайняя степень субъективности и предвзятости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6cb4cc0-7708-4be0-99aa-9a77a97fa40b",
                                                "sense_id": "4e579467-599d-3c19-b20f-ddd23305a136",
                                                "text": "Крайняя субъективность, предвзятость и, в сущности, идиосинкразия суть то, что помогает искусству избежать клише."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
