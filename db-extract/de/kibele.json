                "senses": [
                    {
                        "sense_id": "cb4601b0-8e49-3176-87f8-c185a19d0769",
                        "entry_id": "c5e4e7ac-0869-37e3-ba4d-5d779ad67988",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f37a838c-b124-4d3b-a2c0-6ebf0dcfc362",
                                "sense_id": "cb4601b0-8e49-3176-87f8-c185a19d0769",
                                "text": "Frau Kibele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "645f38ae-19e3-4dc3-9a98-8fbe33fb1fe4",
                                "sense_id": "cb4601b0-8e49-3176-87f8-c185a19d0769",
                                "text": "Herr Kibele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d8466837-b0f2-4c63-873b-269e1fb99404",
                                "sense_id": "cb4601b0-8e49-3176-87f8-c185a19d0769",
                                "text": "Die Kibeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c0680e97-c191-46a7-97fc-bf3a58d2a16c",
                                "sense_id": "cb4601b0-8e49-3176-87f8-c185a19d0769",
                                "text": "Der Kibele trägt nie die Schals, die die Kibele ihm strickt."
                            },
                            {
                                "example_id": "4b754097-8e3a-4940-aa23-f4939b5ee994",
                                "sense_id": "cb4601b0-8e49-3176-87f8-c185a19d0769",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kibele kommt, geht der Herr Kibele.“"
                            },
                            {
                                "example_id": "1215776e-5242-407f-811a-285671b0c2c9",
                                "sense_id": "cb4601b0-8e49-3176-87f8-c185a19d0769",
                                "text": "Kibele kommt und geht."
                            },
                            {
                                "example_id": "fe835fac-f7bf-45da-94bb-c71b2b1bac80",
                                "sense_id": "cb4601b0-8e49-3176-87f8-c185a19d0769",
                                "text": "Kibeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
