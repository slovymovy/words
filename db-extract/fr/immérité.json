                            "feminine"
                        ],
                        "form": "imméritées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc634a6c-0b74-3260-b2b4-5276cc4a90e0",
                        "entry_id": "b6db1da8-b35d-3b09-978b-498d64ce0a7e",
                        "glosses": [
                            "Qui n’est pas mérité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc2e105-ab8c-40fb-821a-02d6d524a1e4",
                                "sense_id": "fc634a6c-0b74-3260-b2b4-5276cc4a90e0",
                                "text": "J’ai vu, monsieur, dit l’Anglais, qu’il vous était arrivé un nouveau malheur immérité comme les autres,"
                            },
                            {
                                "example_id": "c51ac4e0-be0e-4389-95e0-0d97985c1380",
                                "sense_id": "fc634a6c-0b74-3260-b2b4-5276cc4a90e0",
                                "text": "Une fois que tu auras dédaigné la Légion d’honneur, tu pourras consacrer tes vieux jours à obtenir une récompense vraiment prestigieuse. Ça fait quelques années qu’on parle de toi pour le prix Nobel de littérature. Ce ne serait pas immérité. Et le parchemin suédois est doté de 10 millions de couronnes, soit 1 million d’euros. Pas mal, non ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be3eaa63-801f-4b96-b1d7-85445257430b",
                        "source_entry_id": "b6db1da8-b35d-3b09-978b-498d64ce0a7e",
                        "source_sense_id": "fc634a6c-0b74-3260-b2b4-5276cc4a90e0",
                        "target_lang_word": "unmerited",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmerited",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1bbb894-b6de-3cbe-8c9c-fbb024d4e05a",
                                        "entry_id": "b58820e2-b123-352f-97d9-27078d45e0f9",
                                        "glosses": [
                                            "Not merited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0cff0a3-f035-45cc-a304-2503d7042989",
                                                "sense_id": "d1bbb894-b6de-3cbe-8c9c-fbb024d4e05a",
                                                "text": "She was tempted to leave him with his illusions. Something in her nature, however, caviled at this unmerited encomium."
                                            },
                                            {
                                                "example_id": "e4f9651b-f72c-4ce4-9b07-e536dedc9e0e",
                                                "sense_id": "d1bbb894-b6de-3cbe-8c9c-fbb024d4e05a",
                                                "text": "Since then the bibliography on the central question it addressed—the relationship between nature and the absolutely unmerited destination of us to the face-to-face vision of God—has diminished considerably in volume."
                                            },
                                            {
                                                "example_id": "e6dcc672-5540-4e0a-b13b-21aa52df4e03",
                                                "sense_id": "d1bbb894-b6de-3cbe-8c9c-fbb024d4e05a",
                                                "text": "Insurance company actuaries view the discounts as unmerited and unfair to other policyholders. Criminologists say there are better and quieter ways to protect cars. Economists argue that the alarms' benefits, if any, are far outweighed by their social costs. Vigilantes have made their point by attacking noisy cars with eggs and baseball bats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
