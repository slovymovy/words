                },
                {
                    "sense_id": "463ae736-5542-3ca9-9f80-e066150ec25f",
                    "sense_definition": "Marijuana.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was caught smoking the <w>green</w> behind the building.",
                            "target_lang_translations": {
                                "ru": "Его поймали за курением <w>травки</w> за зданием."
                            }
                        },
                        {
                            "text": "They were looking to buy some <w>green</w> at the party.",
                            "target_lang_translations": {
                                "ru": "Они хотели прикупить немного <w>зелени</w> на вечеринке."
