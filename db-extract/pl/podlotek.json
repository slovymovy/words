                "translations": [
                    {
                        "translation_id": "dd2b6d3a-6641-47b6-9b14-429d68fe9276",
                        "source_entry_id": "1af0b9e2-4bad-3998-b183-ff5267c9a804",
                        "source_sense_id": "9901edad-d9ce-3a0b-8955-1a15ec50a573",
                        "target_lang_word": "žabka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "žabka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0de8f308-2485-3332-ba5c-c0bee9d36f01",
                                        "entry_id": "9f629d1f-02df-34ef-a052-42b24c453c2a",
                                        "glosses": [
                                            "žába"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3713543-a881-4222-b19f-5517069510a3",
                                                "sense_id": "0de8f308-2485-3332-ba5c-c0bee9d36f01",
                                                "text": "Pěkně prý vás pozdravuje, o návštěvu prosí, jak to žabky uslyšely, honem do rákosí"
                                            },
                                            {
                                                "example_id": "6ff446ea-939b-4fa6-adb8-1d812b162736",
                                                "sense_id": "0de8f308-2485-3332-ba5c-c0bee9d36f01",
                                                "text": "Žabka rosnička vidouc, že nastávají veliká sucha, radila žabám v močále: „Utecte, přátelé, než vyschne vaše bařina!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8238af17-8f57-3d0f-8e4a-2df72424251a",
                                        "entry_id": "9f629d1f-02df-34ef-a052-42b24c453c2a",
                                        "glosses": [
                                            "mladá dívka"
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c47f54d-3716-4c18-b07e-0e043b05c2ff",
                                                "sense_id": "8238af17-8f57-3d0f-8e4a-2df72424251a",
                                                "text": "Žabky na suchu leží nevinně, natřené vrstvou mléka (…) žabka nechápe, co to povídám, ví však, že se jí dvořím"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b146699-d514-36f4-a9fb-7c0a9c2f42ae",
                                        "entry_id": "9f629d1f-02df-34ef-a052-42b24c453c2a",
                                        "glosses": [
                                            "druh nože"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3700d82e-8d7c-4b40-8373-46617d3bd28a",
                                                "sense_id": "7b146699-d514-36f4-a9fb-7c0a9c2f42ae",
                                                "text": "Vyndala lopatou tělesné pozůstatky. Ó, toho děsu! Rukou chvějící sebrala do ruky každou tu kosť zvlášť, aby pomocí malé žabky zelenavou, odporně páchnoucí plíseň s nich seškrábala."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36df11d9-475e-33a6-855f-44032a75a037",
                                        "entry_id": "9f629d1f-02df-34ef-a052-42b24c453c2a",
                                        "glosses": [
                                            "druh řasení látky"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bec085db-4f22-3db5-853c-9e322e299cf4",
                                        "entry_id": "9f629d1f-02df-34ef-a052-42b24c453c2a",
                                        "glosses": [
                                            "typ boty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e5ec5b-02a6-493b-8528-8f1e6fffb2b8",
                                                "sense_id": "bec085db-4f22-3db5-853c-9e322e299cf4",
                                                "text": "Žabky na noze, s žabkou na suchu žabky na vodě tvořím"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "494ebf90-fd8e-3246-8c7d-09189809c516",
                                        "entry_id": "9f629d1f-02df-34ef-a052-42b24c453c2a",
                                        "glosses": [
                                            "část smyčce spojující prut a žíně, sloužící k držení"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6131616-5e02-3472-b9ae-b2e2dca799ba",
                                        "entry_id": "9f629d1f-02df-34ef-a052-42b24c453c2a",
                                        "glosses": [
                                            "plochý kamínek házený naplocho po hladině a vícenásobně odrážený"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332d321f-da8b-4058-9b05-2077a83c5448",
                                                "sense_id": "a6131616-5e02-3472-b9ae-b2e2dca799ba",
                                                "text": "Žabky na vodě malý kamínek větší kružnice tvoří, dokud rychlost má, tak se odráží, v tom to spočívá"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c94144-cfa8-3be3-a814-d585b1efbb35",
                                        "entry_id": "9f629d1f-02df-34ef-a052-42b24c453c2a",
                                        "glosses": [
                                            "typ svorky"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb3f19c2-2825-3e3e-953a-c0865d580b45",
                                        "entry_id": "9f629d1f-02df-34ef-a052-42b24c453c2a",
                                        "glosses": [
                                            "druh přihrávky v hokeji"
                                        ],
                                        "tags": [
