                        "cross_references": [
                            {
                                "target_word": "pistache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37b3a182-e620-355f-96fe-c7f2ad5f747d",
                                        "entry_id": "8d45b9ff-2ec3-38c0-99b2-0b87fb37f294",
                                        "glosses": [
                                            "Couleur de cette amande. #BEF574"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c1bac69-1778-4f5d-8dfc-efc2f1d0cf74",
                                                "sense_id": "37b3a182-e620-355f-96fe-c7f2ad5f747d",
                                                "text": "La cathédrale […] est enluminée d’un pistache assez facétieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pistache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "462e8f9e-e802-36f7-bc68-12f47b915442",
                                        "entry_id": "b67cbc89-020c-368d-8ab7-ce960eb69043",
                                        "glosses": [
                                            "Fruit du pistachier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9b067b-b7e3-4fb2-857a-411537661013",
                                                "sense_id": "462e8f9e-e802-36f7-bc68-12f47b915442",
                                                "text": "La pistache est aujourd’hui cultivée dans dix-huit pays, dont la Chine et la Grèce, et constitue l’une des noix les plus consommées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d65778-1114-3b22-a6a0-ecb1ec1e60db",
                                        "entry_id": "b67cbc89-020c-368d-8ab7-ce960eb69043",
                                        "glosses": [
                                            "Amande vert pâle de ce fruit, employée en confiserie ou qui fournit de l’huile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab25003-bbe8-447c-a2dc-25d469eaffc3",
                                                "sense_id": "c5d65778-1114-3b22-a6a0-ecb1ec1e60db",
                                                "text": "Au moment de servir, étalez la compotée de clémentines à la fleur d’oranger sur le cheesecake, puis saupoudrez d’éclats de pistaches."
                                            },
                                            {
                                                "example_id": "53ec0807-a2e3-4fd2-bb16-3e8ca66dfee4",
                                                "sense_id": "c5d65778-1114-3b22-a6a0-ecb1ec1e60db",
                                                "text": "La culture de la pistache ne prendra jamais une très grande extension à Maurice ; elle deviendra de moins en moins avantageuse au fur et à mesure que les plantations prendront plus de développement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f08e4bf-fff7-3718-9516-ceb745bc90c3",
                                        "entry_id": "b67cbc89-020c-368d-8ab7-ce960eb69043",
                                        "glosses": [
                                            "Arachide."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcc63618-763a-4572-a019-a0894ba2c9b9",
                                                "sense_id": "0f08e4bf-fff7-3718-9516-ceb745bc90c3",
                                                "text": "Pistache de terre, arachide, cacahuète."
                                            },
                                            {
                                                "example_id": "a3e7b595-0bb8-4a19-8f4f-d9432d26a4a9",
                                                "sense_id": "0f08e4bf-fff7-3718-9516-ceb745bc90c3",
                                                "text": "Tu plantes ça et là après t’arraches ça, et puis tu mets ça à chesser [sécher] en dehors. Des pistaches."
                                            },
                                            {
                                                "example_id": "c85d51da-b146-4d3c-b043-decdc120a573",
                                                "sense_id": "0f08e4bf-fff7-3718-9516-ceb745bc90c3",
                                                "text": "Dans d’autres [graines] les cotylédons sont charnus-oléagineux, comme, par exemple, dans l’Arachis hypogoea (vulgairement Pistache de terre), qui peut fournir une grande proportion d’huile, et, sous ce rapport, est devenue, dans ces derniers temps, un immense objet de commerce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3156eaa0-a0f7-3b66-b0ac-e8a60bbc66c3",
                                        "entry_id": "b67cbc89-020c-368d-8ab7-ce960eb69043",
                                        "glosses": [
                                            "Cuite, saoulerie, ivresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7c50ea6-595c-44f9-9153-aac16a87266b",
                                                "sense_id": "3156eaa0-a0f7-3b66-b0ac-e8a60bbc66c3",
                                                "text": "Avoir une pistache, être ivre."
                                            },
                                            {
                                                "example_id": "28eaa697-13ea-4286-98e0-0f479bc5cb5c",
                                                "sense_id": "3156eaa0-a0f7-3b66-b0ac-e8a60bbc66c3",
                                                "text": "Il y en eut bien encore, de temps en temps, qui, le gousset abondamment garni, prirent des pistaches mémorables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2879ccc-fcc8-3664-a847-c9df6169f26d",
                                        "entry_id": "b67cbc89-020c-368d-8ab7-ce960eb69043",
                                        "glosses": [
                                            "Pistache africaine : en Afrique de l’ouest, on appelle pistache (ou égousi) les graines de certains Cucurbitaceae que l’on utilise séchées et/ou grillées pour confectionner des sauces, de façon similaire à la sauce arachide (mafé)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pistache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58bc89ae-fb72-37c5-97c6-c40f4beaee3a",
                                        "entry_id": "bb498e30-aa64-3a9a-ab92-940489041bf9",
                                        "glosses": [
                                            "De couleur vert-jaune pâle. #BEF574"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "289add7a-bf8c-4bfa-8481-dea4f9ac4069",
                                                "sense_id": "58bc89ae-fb72-37c5-97c6-c40f4beaee3a",
                                                "text": "Trois valets de pied, en gants blancs, vêtus d’une livrée bleue à galons pistache."
                                            },
                                            {
                                                "example_id": "48feef69-c850-4009-99f6-5a7919de7324",
                                                "sense_id": "58bc89ae-fb72-37c5-97c6-c40f4beaee3a",
                                                "text": "Une fille parut, engoncée dans une veste de daim, couleur pistache, un bonnet écossais à gros pompons perché sur le sommet du crâne, les mains gantées de vert, la bouche pâle, l’œil maquillé et désabusé."
                                            },
                                            {
                                                "example_id": "2d7a025f-af49-4d38-8366-5d87706f8d42",
                                                "sense_id": "58bc89ae-fb72-37c5-97c6-c40f4beaee3a",
                                                "text": "Elle enfila un collant fumée, un short pistache, une sorte de T-shirt long, orangé."
                                            },
                                            {
                                                "example_id": "b67ae403-85ca-4896-953c-9c7cf562f538",
                                                "sense_id": "58bc89ae-fb72-37c5-97c6-c40f4beaee3a",
                                                "text": "Il virera selon les saisons de la nature et l’inclémence des hommes au pourpre ou au safran, mais cette coloration pistache le long de l’Yser relevait, elle, d’une intention maléfique."
                                            }
                                        ]
                                    }
                                ]
                            },
