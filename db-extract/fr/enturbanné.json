                    {
                        "form_id": "24046ba2-f1d8-476c-8db1-ee3dbcd88bbe",
                        "entry_id": "7b454c1c-b3f1-32b9-996d-b1a6d5f686ad",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
