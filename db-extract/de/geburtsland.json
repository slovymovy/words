                ],
                "senses": [
                    {
                        "sense_id": "cb80a6b1-392b-3310-a535-ed97942c00e6",
                        "entry_id": "52d77c63-55b3-3683-8536-1f5c8ab3434e",
                        "glosses": [
                            "Land, in dem eine Person oder ein Tier geboren wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05cba4cc-a29a-4f8c-9e78-0b8881959be8",
                                "sense_id": "cb80a6b1-392b-3310-a535-ed97942c00e6",
                                "text": "„Die Staatsanwaltschaft verfolgte zudem Kontakte des getöteten Familienvaters in dessen Geburtsland Irak und schloss auch einen Zusammenhang mit dem beruflichen Umfeld des Briten nicht aus.“"
                            },
                            {
                                "example_id": "a2b73072-0363-452a-ba70-3483a1b8bb3a",
                                "sense_id": "cb80a6b1-392b-3310-a535-ed97942c00e6",
                                "text": "„Ein leichter Schauder überfiel den alten Mann, als er durch die wohlbekannten Wälder seines Geburtslandes sich stahl: er blickte auf, starr und scheu und furchtsam, als umschwebten ihn die Geister seiner Väter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bccdf207-ee50-38d2-8de6-0500d899ea22",
                        "entry_id": "52d77c63-55b3-3683-8536-1f5c8ab3434e",
                        "glosses": [
                            "Land, in dem etwas Besonderes entstand"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "7166379f-4b11-4ac5-b263-e853e53f5552",
                                "sense_id": "bccdf207-ee50-38d2-8de6-0500d899ea22",
                                "text": "„Im Rahmen des Klimaschutzes ist die Vision vom emissionsfreien Fahren auch im Geburtsland des Automobils die Herausforderung der Zukunft – große Hoffnungen ruhen auf der Elektromobilität.“"
                            },
                            {
                                "example_id": "a86f1aaf-fd0a-4dfc-9e5d-7b8e1a14f54f",
                                "sense_id": "bccdf207-ee50-38d2-8de6-0500d899ea22",
                                "text": "„Ein neuer Schlag für das Geburtsland des Arabischen Frühlings.“"
                            },
                            {
                                "example_id": "c7651061-39d5-4bd9-a6f3-045d5ad1148c",
                                "sense_id": "bccdf207-ee50-38d2-8de6-0500d899ea22",
                                "text": "„Das Geburtsland des arabischen Frühlings schickt sich an, den Übergang zur Demokratie zu besiegeln.“"
                            },
                            {
                                "example_id": "aecb1bae-6a6e-4f18-882c-5c63a950ead0",
                                "sense_id": "bccdf207-ee50-38d2-8de6-0500d899ea22",
                                "text": "„Griechenland, einst das Geburtsland der Demokratie, droht das Grab derselben zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
