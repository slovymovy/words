                                        ]
                                    },
                                    {
                                        "sense_id": "6b888264-2c07-32b7-8f98-0d4435bf717e",
                                        "entry_id": "6ef6a489-8d10-39e3-8465-f89340c4255d",
                                        "glosses": [
                                            "Increase by something added; that which is added; augmentation from without."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66dbefb-adec-44b9-b61c-4a6e23637c47",
                                                "sense_id": "6b888264-2c07-32b7-8f98-0d4435bf717e",
                                                "text": "The only accession which the Roman empire received, during the first century of the Christian Aera, was the province of Britain."
                                            },
                                            {
                                                "example_id": "68e99002-9ba2-42e6-8670-ef1ca08a5192",
                                                "sense_id": "6b888264-2c07-32b7-8f98-0d4435bf717e",
                                                "text": "1803, John Browne Cutting, “A Succinct History of Jamaica” in Robert Charles Dallas, The History of the Maroons, London: Longman and Rees, Volume 1, p. xli,\n[…] armed vessels being provided, their crews were soon recruited by accessions from the needy or adventurous, the discontented or the bold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "607b8605-0e43-30f1-a1a0-7ba1332148b4",
                                        "entry_id": "6ef6a489-8d10-39e3-8465-f89340c4255d",
                                        "glosses": [
                                            "Increase by something added; that which is added; augmentation from without.",
                                            "Such augmentation that adds to the collections of a museum or archive; a thing thus added."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37ace9e2-55aa-38f8-aec3-8346c1ba40d2",
                                        "entry_id": "6ef6a489-8d10-39e3-8465-f89340c4255d",
                                        "glosses": [
                                            "A mode of acquiring property, by which the owner of a corporeal substance which receives an addition by growth, or by labor, has a right to the part or thing added, or the improvement (provided the thing is not changed into a different species)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad182885-d707-3926-91b7-3f4cb34a0d6b",
                                        "entry_id": "6ef6a489-8d10-39e3-8465-f89340c4255d",
                                        "glosses": [
                                            "The act by which one power becomes party to engagements already in force between other powers."
                                        ],
                                        "tags": [
                                            "countable",
