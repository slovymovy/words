                "translations": [
                    {
                        "translation_id": "a5df743b-85e8-454f-a8d3-5703c81fd1ba",
                        "source_entry_id": "6baca475-3167-300f-8adc-9e23aef22d19",
                        "source_sense_id": "1e74ae03-c3dd-3860-b3f7-54ec9d892457",
