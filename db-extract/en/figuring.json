                "senses": [
                    {
                        "sense_id": "e1c1c941-5c63-38da-a93e-2ab61b0b8493",
                        "entry_id": "8274cfb3-7402-3010-a3d2-0480cbf7a1e9",
                        "glosses": [
                            "Calculation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8887bea8-61ce-4354-8660-744473ed2dcc",
                                "sense_id": "e1c1c941-5c63-38da-a93e-2ab61b0b8493",
                                "text": "Alternative figurings may be available for interpreting the everyday, and alternative ways of figuring systems of privilege may be developed in contestations over social arrangements."
                            },
                            {
                                "example_id": "4302ad70-23ec-4c17-b93b-be712eb67ab2",
                                "sense_id": "e1c1c941-5c63-38da-a93e-2ab61b0b8493",
                                "text": "By my figuring, he couldn't have been much over forty, but sagging, bleached-out skin and a gray to balding head made him look sixty."
                            }
                        ]
                    },
                    {
                        "sense_id": "c78f6c67-ae51-3807-866e-e144e3a5b471",
                        "entry_id": "8274cfb3-7402-3010-a3d2-0480cbf7a1e9",
                        "glosses": [
                            "Structure, design, or arrangement; figure."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "24c9fe44-16f9-482b-b1e0-6cc7b87d2b79",
                                "sense_id": "c78f6c67-ae51-3807-866e-e144e3a5b471",
                                "text": "We must remember, however, that all these figurings are written with reference to the tonic signature."
                            },
                            {
                                "example_id": "be40aa45-3baf-4944-be5d-d7cf56e7a35f",
                                "sense_id": "c78f6c67-ae51-3807-866e-e144e3a5b471",
                                "text": "These webbings are made in innumerable fine patternings, with silk mixtures in the design, in narrow stripings and small figurings."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bbbe277-3d08-3a92-8db0-fc49b4947a39",
                        "entry_id": "8274cfb3-7402-3010-a3d2-0480cbf7a1e9",
                        "glosses": [
                            "Representation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f364b9c5-a293-4e47-8fcf-214b59192f2c",
                                "sense_id": "4bbbe277-3d08-3a92-8db0-fc49b4947a39",
                                "text": "Yet when we examine how Mendes's film figures the behind, as it were, behind the father, when we look closely at the film's figurings of anality in the father/son relation, we do not see an insistence that traces of a radical Otherness emerge in figurings of archaic relations and in turn challenge problematic, idealized claims that relations between men can transcend Symbolic mediation."
                            }
                        ]
                    }
