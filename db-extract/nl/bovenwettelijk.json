                "senses": [
                    {
                        "sense_id": "b37bf568-374b-3217-b7e2-8b7410e67129",
                        "entry_id": "7a671d11-c26c-39ea-915b-a67b6cb3def6",
                        "glosses": [
                            "meer dan volgens de wet verplicht is; meer dan wettelijk is toegestaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae526ba7-bc33-4482-b649-52976b9b9a73",
                                "sense_id": "b37bf568-374b-3217-b7e2-8b7410e67129",
                                "text": "De politie benadrukt dat deze compensatie buiten de wettelijke verplichting van de werkgever ligt. “Deze afspraken zijn bovenwettelijk en vinden uit overwegingen van coulance en uit oogpunt van goed werkgeverschap plaats,” aldus een woordvoerder."
                            },
                            {
                                "example_id": "b11f6875-2024-494f-b587-c9407568c34c",
                                "sense_id": "b37bf568-374b-3217-b7e2-8b7410e67129",
                                "text": "Letty Demmers, partijvoorzitter van regeringspartij D66, neemt afstand van de riante regeling die Wassenaars oud-burgemeester Jan Hoekema voor zichzelf had geregeld. ,,Als ik had geweten dat het bovenwettelijk was, dan had ik het ontraden,’’ zegt Demmers."
                            },
                            {
                                "example_id": "9084ef84-ff16-4998-9028-a7b3cc599855",
                                "sense_id": "b37bf568-374b-3217-b7e2-8b7410e67129",
                                "text": "Volgens de Bovag gaat het om een zin die door DNB in de voorwaarden is aangepast over de bovenwettelijke garantie. Daardoor zullen autobedrijven zich moeten verbinden aan een verzekeraar. De Bovag wil de garantie snel in een verzekeringsvorm gieten en werkt daarvoor nauw samen met verzekeringsdochter Bovemij."
                            }
                        ]
                    }
