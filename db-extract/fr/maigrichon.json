                                            {
                                                "example_id": "7463105c-0515-43d3-b90a-0c8ac93b01c3",
                                                "sense_id": "d1b5e265-dc3c-3a7a-b648-fdf0362eb88e",
                                                "text": "\"Either a skinny had judged (correctly) that it was worth one of their buildings to try for one of us, or one of my own mates was getting mighty careless with fireworks\" ..\"A congregation in church — a skinny flophouse — maybe even their defense headquarters. All I knew was that it was a very big room filled with more skinnies than I wanted to see in my whole life.\""
                                            }
