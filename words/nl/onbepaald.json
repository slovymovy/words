{
    "word_family": [
        "bepalen",
        "bepaling",
        "bepaaldheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3bdf315e-2726-31a1-b9d4-dcd059eaf277",
                    "sense_definition": "Niet precies vastgesteld of geformuleerd.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onbepaaldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is een <w>onbepaalde</w> tijd afgesproken voor het project.",
                            "target_lang_translations": {
                                "it": "È stato concordato un tempo <w>indeterminato</w> per il progetto.",
                                "ru": "Для проекта был согласован <w>неопределенный</w> срок.",
                                "en": "An <w>indefinite</w> period was agreed upon for the project."
                            }
                        },
                        {
                            "text": "De datum van het feest is nog <w>onbepaald</w>.",
                            "target_lang_translations": {
                                "it": "La data della festa è ancora <w>indeterminata</w>.",
                                "ru": "Дата праздника еще <w>не определена</w>.",
                                "en": "The date of the party is still <w>undetermined</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaag",
                        "onzeker"
                    ],
                    "antonyms": [
                        "bepaald"
                    ],
                    "common_phrases": [
                        "onbepaalde tijd"
                    ],
                    "target_lang_definitions": {
                        "it": "Non stabilito o formulato con precisione.",
                        "ru": "Не установленный или не сформулированный точно.",
                        "en": "Not precisely established, fixed, or formulated."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "indeterminato",
                                "target_lang_sense_clarification": "riferito a tempo o durata non fissati"
                            },
                            {
                                "target_lang_word": "non definito",
                                "target_lang_sense_clarification": "riferito a qualcosa che manca di una definizione precisa"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неопределенный",
                                "target_lang_sense_clarification": "в значении не имеющий точных рамок или сроков"
                            },
                            {
                                "target_lang_word": "неустановленный",
                                "target_lang_sense_clarification": "в значении не зафиксированный официально"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "indefinite",
                                "target_lang_sense_clarification": "referring to time, duration, or terms not precisely fixed"
                            },
                            {
                                "target_lang_word": "unspecified",
                                "target_lang_sense_clarification": "referring to details or dates not explicitly stated"
                            },
                            {
                                "target_lang_word": "undetermined",
                                "target_lang_sense_clarification": "referring to something not yet established"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1362f569-6464-3452-82bc-343ba9810715",
                    "sense_definition": "Niet zeker of niet vaststaand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbepaaldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De uitkomst van de wedstrijd blijft <w>onbepaald</w> tot het laatste fluitsignaal.",
                            "target_lang_translations": {
                                "it": "L'esito della partita rimane <w>incerto</w> fino al fischio finale.",
                                "ru": "Исход матча остается <w>неопределенным</w> до финального свистка.",
                                "en": "The outcome of the match remains <w>uncertain</w> until the final whistle."
                            }
                        },
                        {
                            "text": "Hij keek met een <w>onbepaalde</w> blik uit het raam.",
                            "target_lang_translations": {
                                "it": "Guardava fuori dalla finestra con uno sguardo <w>indefinito</w>.",
                                "ru": "Он смотрел в окно с <w>неопределенным</w> выражением лица.",
                                "en": "He looked out the window with a <w>vague</w> expression."
                            }
