                        "examples": [
                            {
                                "example_id": "0d25a0b5-d926-41dc-b848-987f1b88e981",
                                "sense_id": "b22c8fc3-dfa5-3f07-994c-d2f40af2e7fb",
                                "text": "„Seit im Vorjahr über dem schottischen Lockerbie die Pan Am 103 explodiert war, hatten die Vereinigten Staaten und andere führende Mächte den Schutz des Flugverkehrs zu einer vorrangigen Angelegenheit erhoben.“"
                            },
                            {
                                "example_id": "ea812f0a-a6f3-4a25-b781-8b117baa0f30",
                                "sense_id": "b22c8fc3-dfa5-3f07-994c-d2f40af2e7fb",
                                "text": "„Alle 259 Insassen und elf weitere unschuldige Bewohner der Stadt Lockerbie in Schottland, über der die Boeing abstürzte, kamen ums Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
