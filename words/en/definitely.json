    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "335c0432-ecda-3b42-83e3-253cbb297a38",
                    "sense_definition": "Without question and beyond doubt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>definitely</w> be there to help you move into your new house.",
                            "target_lang_translations": {
                                "ru": "Я <w>определённо</w> приду, чтобы помочь тебе с переездом в новый дом.",
                                "zh": "我<w>一定</w>会去帮你搬进新家。"
                            }
                        },
                        {
                            "text": "That is <w>definitely</w> not the right way to solve this math problem.",
                            "target_lang_translations": {
                                "ru": "Это <w>точно</w> неправильный способ решения этой математической задачи.",
                                "zh": "那<w>肯定</w>不是解决这道数学题的正确方法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "positively",
                        "certainly",
                        "surely"
                    ],
                    "common_phrases": [
                        "definitely not",
                        "most definitely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без вопросов и вне всяких сомнений.",
                        "zh": "毫无疑问，确定地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определённо",
                                "target_lang_sense_clarification": "без сомнения, безусловно"
                            },
                            {
                                "target_lang_word": "точно",
                                "target_lang_sense_clarification": "разг. с полной уверенностью"
                            },
                            {
                                "target_lang_word": "несомненно",
                                "target_lang_sense_clarification": "бесспорно, очевидно"
                            },
                            {
                                "target_lang_word": "наверняка",
                                "target_lang_sense_clarification": "с высокой степенью вероятности или уверенности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肯定",
                                "target_lang_sense_clarification": "表示确定无疑"
                            },
                            {
                                "target_lang_word": "一定",
                                "target_lang_sense_clarification": "表示必然会发生"
                            },
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "强调事实如此"
                            }
                        ]
