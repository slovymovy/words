                ],
                "senses": [
                    {
                        "sense_id": "7396e405-124f-37ca-bb66-fa481ee41e9d",
                        "entry_id": "77038e42-8b8a-3969-9df4-d14abd112e70",
                        "glosses": [
                            "nauka o człowieku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3e4e1e9-daa9-45b9-83b3-f67571d72d25",
                                "sense_id": "7396e405-124f-37ca-bb66-fa481ee41e9d",
                                "text": "Wielu naukowców zajmuje się antropologią."
                            },
                            {
                                "example_id": "cb35bdff-e59a-455e-ad95-94ad15aa3296",
                                "sense_id": "7396e405-124f-37ca-bb66-fa481ee41e9d",
                                "text": "Głównymi dyscyplinami wchodzącymi w skład kognitywistyki są: neurobiologia, neuropsychologia, neurokognitywistyka, społeczna nauka poznawcza, psychologia poznawcza, informatyka, sztuczna inteligencja, robotyka kognitywna, językoznawstwo kognitywne, teoria obliczeń i teoria informacji, antropologia kulturowa, filozofia umysłu oraz wybrane działy logiki (zwłaszcza logika epistemiczna, doksastyczna, semantyka logiczna i teoria systemów dedukcyjnych z jej twierdzeniami limitacyjnymi)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b568e053-5462-49b8-818d-0ab803b99a5d",
                        "source_entry_id": "77038e42-8b8a-3969-9df4-d14abd112e70",
                        "source_sense_id": "7396e405-124f-37ca-bb66-fa481ee41e9d",
                        "target_lang_word": "anthropology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09c06e34-d083-37c3-8b94-82fe052baf14",
                                        "entry_id": "37f8b497-bcfa-3849-ae1a-71438918f203",
                                        "glosses": [
                                            "The scientific study of humans, systematically describing the ethnographic, linguistic, archaeological, and evolutionary dimensions of humanity using a holistic methodological framework."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19199c08-1abb-44d4-b0ce-f24c0a96b735",
                                                "sense_id": "09c06e34-d083-37c3-8b94-82fe052baf14",
                                                "text": "According to anthropology, there are six basic patterns of kinship terminology or kin naming systems."
                                            },
                                            {
                                                "example_id": "29b67a1e-4c08-49ce-8d7a-3b5083156fb5",
                                                "sense_id": "09c06e34-d083-37c3-8b94-82fe052baf14",
                                                "text": "As another man has an ardour for art or music, or natural science, Mr. Pen said that anthropology was his favourite pursuit; and had his eyes always eagerly open to its infinite varieties and beauties: contemplating with an unfailing delight all specimens of it in all places to which he resorted […]"
                                            },
                                            {
                                                "example_id": "0a9764cf-0aaa-486d-aee9-cec746ecbd33",
                                                "sense_id": "09c06e34-d083-37c3-8b94-82fe052baf14",
                                                "text": "Whilst History endeavours to represent the various phases of civilized life to the fullest extent, the interest of Anthropology rests chiefly upon the general features and the greatest differences in the various forms of human life; for as regards the latter science, these diversities form the most important and characteristic part, and we should have but a one-sided conception of man, if our notions of him were only derived from the history of civilization without taking into consieration the resquisite supplement arising from the study of uncivilized nations, and of man in a primative state."
                                            },
                                            {
                                                "example_id": "53c9cb94-c507-4ed7-9ebc-4c48864b3162",
                                                "sense_id": "09c06e34-d083-37c3-8b94-82fe052baf14",
                                                "text": "What I really liked about cyborg anthropology is that it crossed multiple fields of study."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "281bf0f3-ec04-3910-b1de-339dac678687",
                                        "entry_id": "37f8b497-bcfa-3849-ae1a-71438918f203",
                                        "glosses": [
                                            "The study of humanity in its relation to the divine, as in Christian anthropology."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b79f60c8-5b51-4d36-be2e-393797f9a29c",
                        "source_entry_id": "77038e42-8b8a-3969-9df4-d14abd112e70",
                        "source_sense_id": "7396e405-124f-37ca-bb66-fa481ee41e9d",
                        "target_lang_word": "anthropologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6daa8ce3-fe80-36c1-9c43-22e4f91147d3",
                                        "entry_id": "59638a97-37ae-3542-8d09-24c6826a5d5f",
                                        "glosses": [
                                            "Branche des sciences qui étudie l'être humain sous tous ses aspects à la fois :"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0aad2e17-4add-3079-98dc-8fc4aff1a61a",
                                        "entry_id": "59638a97-37ae-3542-8d09-24c6826a5d5f",
                                        "glosses": [
                                            "Branche des sciences qui étudie l'être humain sous tous ses aspects à la fois :",
                                            "Science qui étudie la structure et l’histoire physique (anatomiques, morphologiques, physiologiques, évolutifs, etc.) de l’espèce humaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8dab10f-bef2-43a8-900f-9e49bc13a7a0",
                                                "sense_id": "0aad2e17-4add-3079-98dc-8fc4aff1a61a",
                                                "text": "J’ai moi-même été militant marxiste-léniniste et j’ai pourtant produit une thèse en anthropologie biologique en recourant au paradigme de la sociobiologie et de la psychologie évolutionniste."
                                            },
                                            {
                                                "example_id": "10ffdf5c-ebf6-4b8c-afc7-2d857cfd77d7",
                                                "sense_id": "0aad2e17-4add-3079-98dc-8fc4aff1a61a",
                                                "text": "Cette anthropologie approximative du peuple satyresque laisse de côté l'embarrassante question des satyreaux, dont on se demande comment ils ont bien pu être engendrés dans cet univers sans femmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eef8c539-1043-3024-ba4d-be50122e9f62",
                                        "entry_id": "59638a97-37ae-3542-8d09-24c6826a5d5f",
                                        "glosses": [
                                            "Branche des sciences qui étudie l'être humain sous tous ses aspects à la fois :",
                                            "Science qui étudie l’être humain sur les plans culturels, socio-religieux, psychologiques, géographiques, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3862a96e-1db1-41f4-b47c-56a7b74af48b",
                                                "sense_id": "eef8c539-1043-3024-ba4d-be50122e9f62",
                                                "text": "Ce que l’anthropologie traite de stupidité chez les vieilles races incomplètes n’est souvent qu’une force extraordinaire d’enthousiasme et d’intuition."
                                            },
                                            {
                                                "example_id": "392c8d44-50a0-4a79-b218-f201ba829483",
                                                "sense_id": "eef8c539-1043-3024-ba4d-be50122e9f62",
                                                "text": "L’évolution est particulièrement nécessaire sur les questions morales, parce qu’elles sont toujours en lien avec une culture, une anthropologie."
                                            },
                                            {
                                                "example_id": "21afbe3f-407a-47f6-9e09-8e64c39ae0e5",
                                                "sense_id": "eef8c539-1043-3024-ba4d-be50122e9f62",
                                                "text": "L’archéologie et l’anthropologie locales sont coutumières, on le sait, d’une grande sérénité dans l’affirmation. Ledit Poignant ne s’en est pas tenu là : à une portée de fusil du tombeau de Merlin, l’« archidruide », il a retrouvé le tombeau de « son épouse » Viviane !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0520586a-1316-3c86-8651-d1b456f9d1ed",
                                        "entry_id": "59638a97-37ae-3542-8d09-24c6826a5d5f",
                                        "glosses": [
                                            "Branche des sciences qui étudie l'être humain sous tous ses aspects à la fois :",
                                            "Science qui étudie ce qui constitue l’être humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d08c5a53-e507-4d14-9bab-d3404f6baedd",
                                                "sense_id": "0520586a-1316-3c86-8651-d1b456f9d1ed",
                                                "text": "Descartes propose en effet une nouvelle anthropologie, terme qu’il faut prendre ici au sens littéral d’un savoir sur l’être humain. Ce mot n’est pas tout à fait anachronique à son époque, et c’est précisément le sujet de son traité de L’Homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "860fe246-7d46-3a0c-bd4d-304e3452a329",
                                        "entry_id": "59638a97-37ae-3542-8d09-24c6826a5d5f",
                                        "glosses": [
                                            "Vision théologique de la nature humaine, théologie de l'humain."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11ceefde-c815-4555-9b5d-baaefed7898c",
                                                "sense_id": "860fe246-7d46-3a0c-bd4d-304e3452a329",
                                                "text": "L’anthropologie du Nouveau Testament se base sur celle de l’Ancien Testament. Elle témoigne de la grandeur de la personne humaine, créée à l’image de Dieu (Gn 1,26-27), et de sa misère, provoquée par l’indéniable réalité du péché, qui fait de l’homme une caricature de lui-même."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d375429-b824-4c40-9bda-065bdabcaca5",
                        "source_entry_id": "77038e42-8b8a-3969-9df4-d14abd112e70",
                        "source_sense_id": "7396e405-124f-37ca-bb66-fa481ee41e9d",
                        "target_lang_word": "antropología",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antropología",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "6951a7f0-90a5-3e13-b9c1-0b0b489a45c9",
                                        "entry_id": "b17eb77b-9137-34c8-b94e-ffbef09155f2",
                                        "glosses": [
                                            "Ciencia social que estudia todas las dimensiones del ser humano. Algunas de sus ramas son la antropología clásica, biológica, médica, social, política, filosófica, nutricional, forense, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c982505-a938-4138-a0d5-1f5b39524b81",
                                                "sense_id": "6951a7f0-90a5-3e13-b9c1-0b0b489a45c9",
                                                "text": "La antropología se suele identificar con la excavación de restos humanos (en Antropología)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de9f4ded-963b-46d4-8578-08f36046706f",
                        "source_entry_id": "77038e42-8b8a-3969-9df4-d14abd112e70",
                        "source_sense_id": "7396e405-124f-37ca-bb66-fa481ee41e9d",
                        "target_lang_word": "Anthropologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anthropologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33032f78-989f-34ab-9a94-a4cbfb86441a",
                                        "entry_id": "5ffb4393-7a7b-31c3-9bbf-3269d3ddfa56",
                                        "glosses": [
                                            "Wissenschaft vom Menschen, seinem Wesen und seiner Entwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3168a32d-e657-4e96-a3f2-a2b53e1f483c",
                                                "sense_id": "33032f78-989f-34ab-9a94-a4cbfb86441a",
                                                "text": "„Grundlegend für die christlich theologische Anthropologie ist die Aussage 1. Mos. 1,26 über die Gottebenbildlichkeit […] des Menschen. […]“"
                                            },
                                            {
                                                "example_id": "1f38fb6d-c676-4a41-b49e-ba5b75881e9c",
                                                "sense_id": "33032f78-989f-34ab-9a94-a4cbfb86441a",
                                                "text": "Die Anthropologie ist eine eigenständige Wissenschaft."
                                            },
                                            {
                                                "example_id": "96c551c8-da1b-4e35-9742-c1e828a5085e",
                                                "sense_id": "33032f78-989f-34ab-9a94-a4cbfb86441a",
                                                "text": "„Ebenso wenig wie die aufklärerische Anthropologie verzichtet die Ethnographie auf eine Hierarchisierung der Völker.“"
                                            },
                                            {
                                                "example_id": "608b5cd1-bbe4-4dbd-a64c-a14bc894c0ec",
                                                "sense_id": "33032f78-989f-34ab-9a94-a4cbfb86441a",
                                                "text": "„Die philosophische Anthropologie des 20. Jahrhunderts hat als eine ihrer fundamentalen Annahmen formuliert, der Mensch sei das von der Natur unversorgte Mängelwesen.“"
                                            },
                                            {
                                                "example_id": "6c1b4afe-a940-461e-be8f-92a6291b4f5b",
                                                "sense_id": "33032f78-989f-34ab-9a94-a4cbfb86441a",
                                                "text": "„In der Anthropologie setzt sich die Einsicht durch, dass viele Indigenengruppen in einem jahrtausendealten Bund mit dem Feuer lebten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
