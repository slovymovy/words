                    "semantic_group_id": "sportfaciliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De atleten verschenen aan de start van de <w>loopbaan</w> voor de finale van de honderd meter.",
                            "target_lang_translations": {
                                "en": "The athletes appeared at the start of the <w>running track</w> for the final of the hundred meters."
