                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "958f29ef-a86f-3af1-90db-43ecb808396a",
                                        "entry_id": "db2d2542-e931-39d2-a90c-fa996e8417df",
                                        "glosses": [
                                            "The empty outward form of someone or something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aa546fe-1d3e-4929-a528-d2066882e799",
                                                "sense_id": "958f29ef-a86f-3af1-90db-43ecb808396a",
                                                "text": "The setback left him a mere shell; he was never the same again."
                                            },
                                            {
                                                "example_id": "3ff93e24-ba0c-45a1-bf4b-b7540edc2081",
                                                "sense_id": "958f29ef-a86f-3af1-90db-43ecb808396a",
                                                "text": "Mr. Thomas adds that, by the time it was scrapped, Kingsley was in very bad condition, little more than a shell in fact. In view of the rough usage to which the engine had been subjected, this is not surprising."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c7f1b2f-358b-30d4-9e5e-45d7cea3a9e8",
                                        "entry_id": "db2d2542-e931-39d2-a90c-fa996e8417df",
                                        "glosses": [
                                            "An emaciated person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12e06bc-fdb8-474e-8ec5-2f40a48d78d1",
                                                "sense_id": "9c7f1b2f-358b-30d4-9e5e-45d7cea3a9e8",
                                                "text": "He's lost so much weight from illness; he's a shell of his former self."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "387587c0-afef-303f-945f-ecf2400f1b62",
                                        "entry_id": "db2d2542-e931-39d2-a90c-fa996e8417df",
                                        "glosses": [
                                            "A person otherwise diminished."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eae2266a-84b2-47cd-bb0b-c8667ce81be4",
                                                "sense_id": "387587c0-afef-303f-945f-ecf2400f1b62",
                                                "text": "Since coming back from Vietnam; he's been a shell of his former self."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f98853-14cf-3e46-9f95-98c6cceac610",
                                        "entry_id": "db2d2542-e931-39d2-a90c-fa996e8417df",
                                        "glosses": [
                                            "A psychological barrier to social interaction."
                                        ],
                                        "tags": [],
                                        "examples": [
