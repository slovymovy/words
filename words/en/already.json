{
    "word_family": [
        "ready"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "05973684-0b28-3849-93a0-8b86077ea1cb",
                    "sense_definition": "Before a specific time in the past, present, or future; by this time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was surprised that she hadn’t <w>already</w> told me the news.",
                            "target_lang_translations": {
                                "ru": "Я был удивлен, что она <w>уже</w> не сообщила мне эти новости."
                            }
                        },
                        {
                            "text": "Much of what he said I knew <w>already</w>.",
                            "target_lang_translations": {
                                "ru": "Многое из того, что он сказал, я <w>уже</w> знал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "knew already",
                        "already told",
                        "already finished"
                    ],
                    "target_lang_definitions": {
                        "ru": "До определенного момента в прошлом, настоящем или будущем; к этому времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уже",
                                "target_lang_sense_clarification": "указывает на совершение действия к данному моменту"
                            },
                            {
                                "target_lang_word": "ранее",
                                "target_lang_sense_clarification": "прежде какого-либо времени, более формально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4063f89-b1ef-3e99-a5c3-c20b9aba25cc",
                    "sense_definition": "Used to express surprise that something has happened so soon.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you quitting <w>already</w> when we just started?",
                            "target_lang_translations": {
                                "ru": "Ты <w>уже</w> сдаешься, хотя мы только начали?"
                            }
                        },
                        {
                            "text": "Is it five o'clock <w>already</w>?",
                            "target_lang_translations": {
                                "ru": "Неужели <w>уже</w> пять часов?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "quitting already",
                        "leaving already",
                        "finished already"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения удивления тем, что что-то произошло так скоро."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уже",
                                "target_lang_sense_clarification": "выражение удивления быстротой события"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea2c045c-6d75-323a-acd4-36550ee764f2",
                    "sense_definition": "Used to emphasize impatience or exasperation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wish they'd finish <w>already</w> so we can get going.",
                            "target_lang_translations": {
                                "ru": "Хоть бы они <w>уже</w> закончили, чтобы мы могли идти."
                            }
                        },
                        {
                            "text": "Enough <w>already</w> with the constant complaining!",
                            "target_lang_translations": {
                                "ru": "Хватит <w>уже</w> этих постоянных жалоб!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "enough already",
                        "stop already",
                        "finish already"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to show annoyance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для подчеркивания нетерпения или раздражения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уже",
                                "target_lang_sense_clarification": "усилительная частица для выражения нетерпения"
                            },
                            {
                                "target_lang_word": "наконец",
                                "target_lang_sense_clarification": "в значении требования прекратить или закончить что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc413945-e5c7-34e3-9e13-4251aa464a63",
                    "sense_definition": "Indicates the completion of an action or a change in state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I sign <w>already</w> so you can take the document.",
                            "target_lang_translations": {
                                "ru": "Я <w>уже</w> подписал, так что можешь забирать документ."
                            }
                        },
                        {
                            "text": "Your ice cream is melting <w>already</w> in this heat.",
                            "target_lang_translations": {
                                "ru": "Твое мороженое <w>уже</w> тает на такой жаре."
                            }
                        }
                    ],
                    "synonyms": [
                        "liao"
                    ],
                    "common_phrases": [
                        "done already",
                        "melting already",
                        "tall already"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in Singlish and Malaysian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывает на завершение действия или изменение состояния (характерно для региональных диалектов английского)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уже",
                                "target_lang_sense_clarification": "маркер завершенности действия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}