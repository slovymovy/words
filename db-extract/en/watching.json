                        "glosses": [
                            "The act of one who watches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83c092fb-54d3-48a6-bbdd-dfe6485f216b",
                                "sense_id": "d3bc3c33-96a0-32f3-962c-d8f8b14fd33a",
                                "text": "What toils and pains; what cares and watchings; how many reproofs, restraints, and corrections; how many prayers, and sighs, and tears, are employed and suffered, before this hard task can be accomplished?"
                            },
                            {
                                "example_id": "2eae8996-5680-4e88-89ca-e736375f8bc3",
                                "sense_id": "d3bc3c33-96a0-32f3-962c-d8f8b14fd33a",
                                "text": "You will know them by their sly looks; their skulkings, peepings, watchings, and the snares they lay;—by the great papers, with great seals, that they carry; […]"
                            }
                        ]
                    }
                ],
