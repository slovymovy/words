{
    "word_family": [
        "северо-западный",
        "север",
        "запад"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9220fec-b21d-3502-923c-ec219bd6ccd2",
                    "sense_definition": "Промежуточная сторона света между севером и западом, а также направление в эту сторону.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "сторона_света",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Стрелка компаса уверенно указывала курс на <w>северо-запад</w>.",
                            "target_lang_translations": {
                                "en": "The compass needle pointed steadily on a course to the <w>northwest</w>."
                            }
                        },
                        {
                            "text": "Холодный ветер с самого утра дул прямо на <w>северо-запад</w>.",
                            "target_lang_translations": {
                                "en": "A cold wind had been blowing straight toward the <w>northwest</w> since early morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "норд-вест"
                    ],
                    "antonyms": [
                        "юго-восток"
                    ],
                    "common_phrases": [
                        "курс на северо-запад",
                        "ветер на северо-запад"
                    ],
                    "target_lang_definitions": {
                        "en": "The compass point between north and west, or the direction towards it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "northwest",
                                "target_lang_sense_clarification": "compass point or direction"
                            },
                            {
                                "target_lang_word": "north-west",
                                "target_lang_sense_clarification": "direction (hyphenated variant)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29d2406c-a605-3066-abf8-f23020277ee9",
                    "sense_definition": "Территория, местность или часть региона, государства или континента, находящаяся в северо-западном направлении.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "регион",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Многие туристы мечтают поехать на <w>северо-запад</w> страны ради дикой природы.",
                            "target_lang_translations": {
                                "en": "Many tourists dream of travelling to the <w>northwest</w> of the country for its wilderness."
                            }
                        },
                        {
                            "text": "На <w>северо-западе</w> региона уже выпал первый обильный снег.",
                            "target_lang_translations": {
                                "en": "In the <w>northwest</w> of the region, the first heavy snow has already fallen."
                            }
                        }
                    ],
                    "antonyms": [
                        "юго-восток"
                    ],
                    "common_phrases": [
                        "северо-запад страны",
                        "на северо-западе региона"
                    ],
                    "target_lang_definitions": {
                        "en": "A geographic area, territory, or region situated in the north-western part of a country or continent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "northwest",
                                "target_lang_sense_clarification": "geographic region or area"
                            },
                            {
                                "target_lang_word": "the northwest",
                                "target_lang_sense_clarification": "the northwestern part of a territory"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}