                        "examples": [
                            {
                                "example_id": "53b4c69d-9707-4959-9ac4-e4309bb5340a",
                                "sense_id": "472eb6fe-fac3-3e3e-ac42-63b1261d4f7b",
                                "text": "À nous, la nonette ; je t’invite à la décroupionner, Montaprone, demain, midi juste."
                            },
                            {
                                "example_id": "de1b54aa-795d-4140-b1e2-8d458193aa18",
                                "sense_id": "472eb6fe-fac3-3e3e-ac42-63b1261d4f7b",
                                "text": "Ma poule est décroupionnée, me la rencroupionneriez-vous bien ?"
                            },
                            {
                                "example_id": "d731169d-4d52-40d6-8be7-c244237a8207",
                                "sense_id": "472eb6fe-fac3-3e3e-ac42-63b1261d4f7b",
                                "text": "Bien d’accord avec toi, et c’est pourquoi, toutes ces espèces affines, je les capture désormais pour les \"décroupionner\""
                            }
                        ]
                    }
