                "senses": [
                    {
                        "sense_id": "a0fed332-e157-362e-a8e9-caddb78dc52e",
                        "entry_id": "db985232-a087-381f-8fb5-7a9be5033182",
                        "glosses": [
                            "op een manier die onprettig is voor vrouwen; een manier die gericht is op het belemmeren van vrouwen om deel te nemen aan een bepaalde activiteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "572bebac-0747-4f9a-997a-7cb260d29936",
                                "sense_id": "a0fed332-e157-362e-a8e9-caddb78dc52e",
                                "text": "In reactie op opmerkingen van Trump die velen als vrouwonvriendelijk bestempelden, groeiden de marsen vooral uit tot demonstraties tegen de nieuwe president."
                            },
                            {
                                "example_id": "84cfc216-4143-4996-bc95-3cf3dcd34fa8",
                                "sense_id": "a0fed332-e157-362e-a8e9-caddb78dc52e",
                                "text": "Boef kwam eerder deze maand in opspraak vanwege vrouwonvriendelijke uitspraken over kechs, straattaal voor hoeren. Dit kostte hem diverse boekingen bij festivals. Noorderslag besloot om hem op het affiche te laten staan maar wel aandacht te besteden aan de kwestie."
                            }
                        ]
                    }
                ],
