                    }
                ],
                "senses": [
                    {
                        "sense_id": "74756d85-02e6-33e4-8d90-86e1ded52005",
                        "entry_id": "f7551b94-235f-36c6-8e6a-3fbcaf8b0ece",
                        "glosses": [
                            "bezwaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04e390cb-2609-4ae4-9695-17c8eaa7e9f5",
                                "sense_id": "74756d85-02e6-33e4-8d90-86e1ded52005",
                                "text": "Ondanks enige tegenwerpingen van de oppositie wist de minister het voorstel aangenomen te krijgen."
                            },
                            {
                                "example_id": "b17c58f4-faa9-46fa-b5fc-32e3c2b34973",
                                "sense_id": "74756d85-02e6-33e4-8d90-86e1ded52005",
                                "text": "En boven op de praktische tegenwerpingen kwam het rechtssysteem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "489c2803-0d2e-4e93-b611-96d9261a7440",
                        "source_entry_id": "f7551b94-235f-36c6-8e6a-3fbcaf8b0ece",
                        "source_sense_id": "74756d85-02e6-33e4-8d90-86e1ded52005",
                        "target_lang_word": "Einwand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einwand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef053639-6fba-3436-94ab-219cdfd436f1",
                                        "entry_id": "021c53b7-5c94-3230-851a-96ab3ff4e150",
                                        "glosses": [
                                            "Reaktion auf einen Vorschlag, eine Idee oder dergleichen, in der Bedenken geltend gemacht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc12e5d9-092c-460c-b4e0-e15a790a8a44",
                                                "sense_id": "ef053639-6fba-3436-94ab-219cdfd436f1",
                                                "text": "Er brachte seinen Einwand erst mündlich und, als er ihn unberücksichtigt sah, auch schriftlich vor."
                                            },
                                            {
                                                "example_id": "75d2ef91-b1b2-43e8-9a4f-b70c4cecb1e8",
                                                "sense_id": "ef053639-6fba-3436-94ab-219cdfd436f1",
                                                "text": "Der gewichtigste Einwand gegen den Vorredner ist, dass …"
                                            },
                                            {
                                                "example_id": "38b0eef5-6c1f-4811-9065-8af64849bbdf",
                                                "sense_id": "ef053639-6fba-3436-94ab-219cdfd436f1",
                                                "text": "„John D. John junior brachte einen Einwand gegen den Vergleich des Neokortex mit einem Computer vor, dem man subjektiv beeinflußte Daten eingibt.“"
                                            },
                                            {
                                                "example_id": "68aae208-0c73-4d26-91ce-b5d8b59da313",
                                                "sense_id": "ef053639-6fba-3436-94ab-219cdfd436f1",
                                                "text": "„Käthe Lenks Einwände hatte Hainstock nicht so leicht beiseiteschieben können.“"
                                            },
                                            {
                                                "example_id": "e9b53717-3cae-49a8-8ccd-8cd8d96e7574",
                                                "sense_id": "ef053639-6fba-3436-94ab-219cdfd436f1",
                                                "text": "Trotz aller Einwände gegen eine EU-Erweiterung setzte die Kanzlerin bei einem Treffen in London auf die weitere Annäherung der Westbalkan-Staaten."
                                            },
                                            {
                                                "example_id": "c990d794-bb3c-4092-a59a-ee3b06f76b66",
                                                "sense_id": "ef053639-6fba-3436-94ab-219cdfd436f1",
                                                "text": "Vor gut drei Wochen hat Air Berlin mitten in der Ferienzeit Insolvenz beantragt. Mit staatlicher Unterstützung soll die Airline trotzdem in der Luft bleiben. Brüssel hat dagegen keine Einwände."
                                            },
                                            {
                                                "example_id": "8a478964-b4d7-4b57-bb73-069f691366fd",
                                                "sense_id": "ef053639-6fba-3436-94ab-219cdfd436f1",
                                                "text": "Der Einwand, die Allgemeine Erklärung [der Menschenrechte] würde nicht die Werte aller Menschen und Kulturen gleichermaßen berücksichtigen, kam zum Beispiel aus China und Umgebung - unter dem Schlagwort \"asiatische Werte\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70281018-b86c-481e-a628-75d90c1df509",
                        "source_entry_id": "f7551b94-235f-36c6-8e6a-3fbcaf8b0ece",
                        "source_sense_id": "74756d85-02e6-33e4-8d90-86e1ded52005",
                        "target_lang_word": "objection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4797306a-1f1c-3b95-873a-48ef25a0bf19",
                                        "entry_id": "9ec5984d-c4f1-3ea0-bcb3-d7504243bf64",
                                        "glosses": [
                                            "The act of objecting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b254b46-280f-45a2-9197-081eaa16233c",
                                                "sense_id": "4797306a-1f1c-3b95-873a-48ef25a0bf19",
                                                "text": "last-minute objection"
                                            },
                                            {
                                                "example_id": "da507632-9109-4a3d-8a21-20c3093b0534",
                                                "sense_id": "4797306a-1f1c-3b95-873a-48ef25a0bf19",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7274f29d-4d61-3b11-858c-b5ba71fb8e49",
                                        "entry_id": "9ec5984d-c4f1-3ea0-bcb3-d7504243bf64",
                                        "glosses": [
                                            "A statement expressing opposition, or a reason or cause for expressing opposition (generally followed by the adposition to)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68a119a-b00e-4e0c-ab13-1703819eca99",
                                                "sense_id": "7274f29d-4d61-3b11-858c-b5ba71fb8e49",
                                                "text": "I have no objection to any person's religion."
                                            },
                                            {
                                                "example_id": "6ac8a749-28cd-408c-acfa-d30e007e450d",
                                                "sense_id": "7274f29d-4d61-3b11-858c-b5ba71fb8e49",
                                                "text": "There are millions of Jews living in this country, who have known no other home than America, many of whom have strong objections to racism–and who vote, in a supermajority, for the Democratic Party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bde781-270c-38ac-b7d8-5c18ea96f283",
                                        "entry_id": "9ec5984d-c4f1-3ea0-bcb3-d7504243bf64",
                                        "glosses": [
                                            "An official protest raised in a court of law during a legal trial over a violation of the rules of the court by the opposing party."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8798a856-2415-4482-9df4-82a0b1738542",
                                                "sense_id": "95bde781-270c-38ac-b7d8-5c18ea96f283",
                                                "text": "Counsel for the property owner immediately raised an objection which was sustained following argument outside the presence of the jury."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "objection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e524ec9-f2dd-3518-91d9-588c85ecd1d0",
                                        "entry_id": "82393ceb-0fad-35f8-9ab5-7d4a36e357e1",
                                        "glosses": [
                                            "An assertion that a question or statement is in violation of the rules of the court."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ce6ae8-3c32-45a3-9265-36676127220d",
                                                "sense_id": "2e524ec9-f2dd-3518-91d9-588c85ecd1d0",
                                                "text": "Objection! That is irrelevant to this case, Your Honor!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3391d44f-744b-468d-ae50-4e89fd1cfbd6",
                        "source_entry_id": "f7551b94-235f-36c6-8e6a-3fbcaf8b0ece",
                        "source_sense_id": "74756d85-02e6-33e4-8d90-86e1ded52005",
                        "target_lang_word": "objection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "648b31c5-6766-3fcf-be2c-b5044e28c26d",
                                        "entry_id": "092e23f4-3cd3-366e-8f64-a1fb45226f3f",
                                        "glosses": [
                                            "Ce que l’on oppose à une affirmation, à une proposition, à une demande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac0e1c5-c2b7-4a6e-b7b4-ca22e4fc2af1",
                                                "sense_id": "648b31c5-6766-3fcf-be2c-b5044e28c26d",
                                                "text": "Il n'y eut plus ni objections ni réplique, et le comte, s’apercevant qu’il prêchait dans le désert, s’arrêta lui-même et cessa de parler."
                                            },
                                            {
                                                "example_id": "f8baad1a-b031-49df-888d-4b8fdb650d80",
                                                "sense_id": "648b31c5-6766-3fcf-be2c-b5044e28c26d",
                                                "text": "Donner des démentis est à la portée du premier imbécile venu. C’est une forme de l’idémisme, de l'automatisme mental. Mais réfuter une objection ! Voilà qui n’est pas votre fait."
                                            },
                                            {
                                                "example_id": "b82b4432-d0e8-4bce-8f26-edb6f97b2e10",
                                                "sense_id": "648b31c5-6766-3fcf-be2c-b5044e28c26d",
                                                "text": "Mais à cette réunion, j’eus le tort de présenter mes idées sous une forme édulcorée (la théorie de l’onde-pilote) qui prêtait à de nombreuses objections."
                                            },
                                            {
                                                "example_id": "24b6850d-0db4-4c55-bd2d-778c882fb018",
                                                "sense_id": "648b31c5-6766-3fcf-be2c-b5044e28c26d",
                                                "text": "Ces conditions sont jugées inacceptables par le gouvernement tunisien. Les alliés passent outre aux objections françaises et livrent les armes promises, le 15 novembre 1957."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12ee517b-80a6-4ad8-86c8-ed3f83037883",
                        "source_entry_id": "f7551b94-235f-36c6-8e6a-3fbcaf8b0ece",
