    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ad9528c3-fe60-3ca0-a280-41e7ab29eb4d",
                "word": "Ethan",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8f081a75-165d-3e74-a5a9-b0d08634f72a",
                        "entry_id": "ad9528c3-fe60-3ca0-a280-41e7ab29eb4d",
                        "glosses": [
                            "A male given name from Hebrew, of mostly American usage since the 18th century; popular in the 2000s."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c794e6-9811-41e9-9055-baa20ed79db8",
                                "sense_id": "8f081a75-165d-3e74-a5a9-b0d08634f72a",
                                "text": "For he was wiser than all men; than Ethan the Ezrahite, and Heman, and Chalcol, and Darda, the sons of Mahol: and his fame was in all nations round about."
                            },
                            {
                                "example_id": "783cd7ef-9e63-4840-9fc8-96417d396478",
                                "sense_id": "8f081a75-165d-3e74-a5a9-b0d08634f72a",
                                "text": "There have been Ethan Allen mills, Ethan Allen stock companies, Ethan Allen fire companies and Ethan Allen streets. The name of the daring partisan leader has been used in Vermont much as that of Washington throughout the Union."
                            },
                            {
                                "example_id": "6e5fa510-ad04-428a-8898-98412993551e",
                                "sense_id": "8f081a75-165d-3e74-a5a9-b0d08634f72a",
                                "text": "They would have named him something dignified: Ethan, or Tristram. Something that couldn't easily be shortened."
                            },
                            {
                                "example_id": "b306ca5a-4481-4c4a-90c5-eac2bf072701",
                                "sense_id": "8f081a75-165d-3e74-a5a9-b0d08634f72a",
                                "text": "The engineers are Akash Bobba, Edward Coristine, Luke Farritor, Gautier Cole Killian, Gavin Kliger, and Ethan Shaotran."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0c1e719-7462-34ed-9ce0-f3e103868f2d",
                        "entry_id": "ad9528c3-fe60-3ca0-a280-41e7ab29eb4d",
                        "glosses": [
