                        "cross_references": [
                            {
                                "target_word": "amylase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96ff1e26-8549-3310-b9cb-dddb094d0725",
                                        "entry_id": "dbe891dd-f1f2-324f-ab36-abeb788de24a",
                                        "glosses": [
                                            "Any of a class of digestive enzymes, present in saliva and also contributed to the gut by the exocrine pancreas, that break down complex carbohydrates such as starch into simpler sugars such as glucose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d3ebfd0-fc4c-4cb2-b8d4-8f3842d65bc2",
                                                "sense_id": "96ff1e26-8549-3310-b9cb-dddb094d0725",
                                                "text": "egg yolk amylase"
                                            },
                                            {
                                                "example_id": "b061757d-e4e6-4a45-baa7-fc4f427058a6",
                                                "sense_id": "96ff1e26-8549-3310-b9cb-dddb094d0725",
                                                "text": "Egg yolks contain a starch-digesting enzyme, amylase, that is remarkably resistant to heat. Unless a starch-egg mix is brought to a full boil, the yolk amylase will survive, digest the starch, and turn the stiff cream into a pourable one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
