                ],
                "senses": [
                    {
                        "sense_id": "3f0e6622-2753-360b-830e-3bf18bd3c851",
                        "entry_id": "538c1568-3668-3e8f-a551-ef8428ec92f4",
                        "glosses": [
                            "To stir (something, typically ice cream) with a spattle (spatula)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c2075408-6adc-4e2f-abef-5e027b8c4457",
                                "sense_id": "3f0e6622-2753-360b-830e-3bf18bd3c851",
                                "text": "Ice Creams. Put your cream in the freezing pot, set it in a tub, beat ice small and mix salt with it, put it round your freezer and turn it round, as it freezes spattle it down, if not hard set it again, serve it up in glasses[…]"
                            },
                            {
                                "example_id": "31622ec7-9c70-42a3-82f0-bd21eac432cb",
                                "sense_id": "3f0e6622-2753-360b-830e-3bf18bd3c851",
                                "text": "The mixture is now ready for freezing, and should be poured into the freezer previously set up, and well spattled which it is freezing to give a fine smooth ice."
                            },
                            {
                                "example_id": "8ad4796c-8cca-4db1-ab4f-67c930b35658",
                                "sense_id": "3f0e6622-2753-360b-830e-3bf18bd3c851",
                                "text": "[…] the cold custard, which must be put in a well set up freezer and frozen thoroughly and well spattled."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
