        "pl-extract.jsonl": [
            {
                "entry_id": "cb2e6cc3-4500-38f4-994b-9fc02722f511",
                "word": "bioetyka",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "89a21e2d-0cc7-3a18-98e5-45c112b5a9be",
                        "entry_id": "cb2e6cc3-4500-38f4-994b-9fc02722f511",
                        "glosses": [
                            "dział etyki dotyczący analizy dylematów moralnych, które pojawiają się w naukach medycznych i biologicznych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f57074b-9432-4e69-afbb-f578827b5577",
                        "source_entry_id": "cb2e6cc3-4500-38f4-994b-9fc02722f511",
                        "source_sense_id": "89a21e2d-0cc7-3a18-98e5-45c112b5a9be",
                        "target_lang_word": "bioethics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bioethics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b495e28-d479-3cf3-b4d9-7f4a55dd3b45",
                                        "entry_id": "83321800-5fd3-35e3-8f12-b01d99116b9a",
                                        "glosses": [
                                            "The branch of ethics that studies the implications of biological and biomedical advances."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a12b7018-83de-4a14-944a-c0d184a11633",
                                                "sense_id": "3b495e28-d479-3cf3-b4d9-7f4a55dd3b45",
                                                "text": "This graded appreciation of the developing moral status of human life, especially during its prenatal stages, is deeply relevant to some of the most important bioethics debates of our day."
                                            },
                                            {
                                                "example_id": "a2b1f99d-652a-4f0a-9432-98382b261ebc",
                                                "sense_id": "3b495e28-d479-3cf3-b4d9-7f4a55dd3b45",
                                                "text": "2006, Florencia Luna, Arleen L. F. Salles, One: Latin American Bioethics: Some Reflections, Florencia Luna (editor), Bioethics and Vulnerability: A Latin American View, page 9,\nBioethics has been defined as the critical and systematic reflection on ethical issues in healthcare, biological and medical research, and public health. […] In the United States, the emergence of modern bioethics has been characterized by a shift away from the religious and medical considerations that initially dominated the discourse to more philosophical and legal concepts."
                                            },
                                            {
                                                "example_id": "db9b8c52-7a91-4984-9be6-513e447bf505",
                                                "sense_id": "3b495e28-d479-3cf3-b4d9-7f4a55dd3b45",
                                                "text": "Despite the enormous breadth of bioethics, which ranges from interpersonal conflicts in medical practice, to ethical issues in animal and human subjects research, to policy formation in health care and the sciences, the bioethics field may be united by two common characteristics.\nFirst, bioethics is by nature a highly interdisciplinary activity.[…]Secondly, biothics tends to be practiced today along the main modalities of the ethics of modernity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "880e5ddb-a850-4928-9a7c-9a72703cb77a",
                        "source_entry_id": "cb2e6cc3-4500-38f4-994b-9fc02722f511",
                        "source_sense_id": "89a21e2d-0cc7-3a18-98e5-45c112b5a9be",
                        "target_lang_word": "bioéthique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bioéthique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2a7ddfa-2b85-336f-9ff3-33b7126e01b9",
                                        "entry_id": "0185fe0a-5a77-3176-8e9e-6cf0a0f61dc5",
                                        "glosses": [
                                            "Étude des préceptes moraux qui doivent présider aux pratiques médicales et biologiques concernant l’être humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc122d4a-e0e0-484e-b548-8086b1727df5",
                                                "sense_id": "e2a7ddfa-2b85-336f-9ff3-33b7126e01b9",
                                                "text": "Les enjeux de la bioéthique relèvent désormais de problèmes complexes, interreliés, qui ne concernent plus uniquement l’individu, mais qui touchent des populations entières et de nombreuses institutions sociales."
                                            },
                                            {
                                                "example_id": "d85695ed-cd9f-4154-84f5-e69d2018fafe",
                                                "sense_id": "e2a7ddfa-2b85-336f-9ff3-33b7126e01b9",
                                                "text": "À l’occasion des États généraux de la bioéthique, partis pour durer jusqu’au 7 juillet, opposants et partisans de la gestation pour autrui (GPA) échangent moult arguments, dont certains ne sont pas piqués des vers."
                                            },
                                            {
                                                "example_id": "497dbc00-8ad1-4824-8554-d9dd6b4855bc",
                                                "sense_id": "e2a7ddfa-2b85-336f-9ff3-33b7126e01b9",
                                                "text": "Avant sa révision en novembre, le protocole de priorisation aux soins intensifs incluait encore \"des critères extrêmement controversés comme le handicap et la déficience intellectuelle\", explique la professeure en bioéthique au département de médecine sociale et préventive de l'École de santé publique de l'Université de Montréal, Vardit Ravitsky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84220f99-216d-3e57-8923-00fdc86feb06",
                                        "entry_id": "0185fe0a-5a77-3176-8e9e-6cf0a0f61dc5",
                                        "glosses": [
                                            "éthique appliquée à la biologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a32edba-1746-419b-969a-24fb5c4b244c",
                                                "sense_id": "84220f99-216d-3e57-8923-00fdc86feb06",
                                                "text": "L’émergence de la bioéthique est liée à l’apparition des connaissances et techniques modernes en biologie."
                                            },
                                            {
                                                "example_id": "2db3b19e-b0df-4efa-b2e4-cc4d48fd9224",
                                                "sense_id": "84220f99-216d-3e57-8923-00fdc86feb06",
                                                "text": "La bioéthique est une discipline interdisciplinaire qui se présente comme un champ d’étude spécifique, avec ses propres objets, son histoire et sa méthodologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82d0da6f-a1ba-3053-b064-f5a0629ba71b",
                                        "entry_id": "0185fe0a-5a77-3176-8e9e-6cf0a0f61dc5",
                                        "glosses": [
                                            "science morale qui traite des questions relatives aux rapports entre les sciences du vivant (biologie, médecine, etc.) et les êtres humains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
