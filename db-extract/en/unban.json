                "senses": [
                    {
                        "sense_id": "cad2cb39-9433-3e92-b47c-d096dfe0aacf",
                        "entry_id": "be92ebbe-8aae-3921-8c2f-48b7d9f74344",
                        "glosses": [
                            "The removal of a ban."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec5f035c-a2fc-4c45-8a49-5d68f949c5e5",
                                "sense_id": "cad2cb39-9433-3e92-b47c-d096dfe0aacf",
                                "text": "As a matter of fact, I have unbanned you several times, and let an unban that I did not agree with stand."
                            },
                            {
                                "example_id": "c5244f2d-17a3-4eb6-bcd5-94585449ca35",
                                "sense_id": "cad2cb39-9433-3e92-b47c-d096dfe0aacf",
                                "text": "I'm not asking for an unban..even when that would happen I wouldn't enter...I dont feel the need to after the hostile approach of my being there."
                            },
                            {
                                "example_id": "5d767ffc-977b-4d17-9bb1-42cd483ce45f",
                                "sense_id": "cad2cb39-9433-3e92-b47c-d096dfe0aacf",
                                "text": "I'm not asking necessarily for an unban on myself, just a peek into your common sense and an unban on saravo connecting from nether."
                            }
                        ]
                    }
                ],
