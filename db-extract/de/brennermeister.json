                "senses": [
                    {
                        "sense_id": "42c81272-7c52-3868-9e98-612a6231fdb3",
                        "entry_id": "66d06623-5164-3c8e-a225-45daf7d2fdfb",
                        "glosses": [
                            "Person, die den Meistertitel im Brennerhandwerk hat"
                        ],
                        "tags": [
                            "Handwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "048d4a61-1334-4eca-b735-9e83fda28e29",
                                "sense_id": "42c81272-7c52-3868-9e98-612a6231fdb3",
                                "text": "„Am nächsten Tag mache ich den Besuch, das Kind auf dem Arm und vom Brennermeister Walter Vietzke begleitet, der im täglichen Umgang mit den neuen Herren schon ein paar Brocken Russisch gelernt hat.“"
                            },
                            {
                                "example_id": "046080d7-4a09-447e-869b-792e6d60bcb4",
                                "sense_id": "42c81272-7c52-3868-9e98-612a6231fdb3",
                                "text": "„Für alle Brenner mit erfolgreich abgelegter Gesellenprüfung und (je nach Bundesland) mindestens zweijähriger Berufspraxis bietet sich eine berufliche Weiterbildung zum Brennermeister an.“"
                            },
                            {
                                "example_id": "27142173-6808-47bf-9948-2167e9881bb4",
                                "sense_id": "42c81272-7c52-3868-9e98-612a6231fdb3",
                                "text": "„Auch in der Essigherstellung finden Brennermeister und Brennermeisterinnen unter Umständen eine Anstellung.“"
                            },
                            {
                                "example_id": "bc7e7326-873e-4622-a65e-c560dbec6f29",
                                "sense_id": "42c81272-7c52-3868-9e98-612a6231fdb3",
                                "text": "„Der seit Jahrzehnten für die Brennerei tätige Hans Bleibtreu und der Brennermeister Bruno Brand sorgen dafür, dass die Geschäfte solide, ehrlich und halbwegs profitabel weiterlaufen und nichts am Geheimrezept des legendären Korngeists herumgepfuscht wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
