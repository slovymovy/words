            "senses": [
                {
                    "sense_id": "e45220b2-8204-3f69-81ca-48e06caddd90",
                    "sense_definition": "Een specifiek moment of een gelegenheid waarbij iets gebeurt.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gelegenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is de eerste <w>keer</w> dat ik naar Parijs reis.",
                            "target_lang_translations": {
                                "en": "This is the first <w>time</w> that I am traveling to Paris."
                            }
                        },
                        {
                            "text": "Ik heb die film al een <w>keer</w> gezien.",
                            "target_lang_translations": {
                                "en": "I have seen that movie <w>once</w> already."
                            }
                        }
                    ],
                    "synonyms": [
                        "maal"
                    ],
                    "common_phrases": [
                        "een keer",
                        "volgende keer",
                        "vorige keer",
                        "elke keer"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific moment or an occasion when something happens."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "an instance or occurrence"
                            },
                            {
                                "target_lang_word": "occasion",
                                "target_lang_sense_clarification": "a particular time or event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adeb2084-7092-33cb-a11c-f6b37f78cce7",
                    "sense_definition": "Een verandering van richting of een omslag in een situatie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na veel tegenslagen hoopten ze op een <w>keer</w> van geluk.",
                            "target_lang_translations": {
                                "en": "After many setbacks, they hoped for a <w>turn</w> of luck."
                            }
                        },
                        {
                            "text": "Zijn optreden markeerde een belangrijke <w>keer</w> in de wedstrijd.",
                            "target_lang_translations": {
                                "en": "His performance marked an important <w>turning point</w> in the match."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een keer ten goede"
                    ],
                    "target_lang_definitions": {
