                    {
                        "translation_id": "52f6b3a1-23bb-4b1a-865e-93c52369fe91",
                        "source_entry_id": "1a1ffcd3-c0c2-34b0-a8e2-966fe2e655ff",
                        "source_sense_id": "8f3b1edd-e023-3041-895b-2b4831a1d611",
                        "source_sense_description": "grote bont gekleurde papegaai uit Zuid-Amerika",
