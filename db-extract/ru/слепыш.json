                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1136eb3-739b-3082-a9b4-8b1c1c5a8e8c",
                                        "entry_id": "18d1c9b3-6ac5-31b1-be1b-11bc3af25b3b",
                                        "glosses": [
                                            "A cutting board, especially for cutting bread."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4c75244-6ce6-3b89-9dde-8344659a8f61",
                                        "entry_id": "18d1c9b3-6ac5-31b1-be1b-11bc3af25b3b",
                                        "glosses": [
                                            "A pull-out cutting board underneath a counter, found in many kitchens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d01bb20c-d257-459f-aa5e-d6293533f1ff",
                                                "sense_id": "d4c75244-6ce6-3b89-9dde-8344659a8f61",
                                                "text": "One way or the other, it was always back to Mother's breadboard on Monday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8851ded7-5940-3592-a866-76fdf27bd6ee",
                                        "entry_id": "18d1c9b3-6ac5-31b1-be1b-11bc3af25b3b",
                                        "glosses": [
                                            "A device used to build a (usually temporary) prototype of an electronic circuit and for experimenting with circuit designs. Both solder and solderless versions are available; the solderless type are easily reusable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52d788ed-48cb-4d6a-93e8-713e24c5d7d7",
                                                "sense_id": "8851ded7-5940-3592-a866-76fdf27bd6ee",
                                                "text": "If you are following a book like Starting Electronics, however, a breadboard is even more useful. […] Differences lie between breadboards in the spacings and the positionings of the holes, and the number of holes in each group."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "breadboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f275ac4-acda-3d77-861c-41a457289ca5",
                                        "entry_id": "8ca3161b-5a9c-3014-9a96-bd0cfe899ad3",
                                        "glosses": [
                                            "To set up (an electronic device) on a breadboard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b38323cb-bd08-407c-98b9-cdb23ce68793",
                                                "sense_id": "0f275ac4-acda-3d77-861c-41a457289ca5",
                                                "text": "If the breadboarded circuit operates incorrectly or erratically, try relocating some of the components."
                                            },
                                            {
                                                "example_id": "550f699b-78fa-497f-9f10-7b3936a88d2a",
                                                "sense_id": "0f275ac4-acda-3d77-861c-41a457289ca5",
                                                "text": "There are many commercial breadboarding systems, but almost all of them are designed to facilitate the breadboarding of digital systems, where noise immunities are hundreds of millivolts or more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
