                                            {
                                                "example_id": "b64f3145-eb83-46c0-a7a2-3f4f49cd956c",
                                                "sense_id": "117fb96a-931b-394d-92e1-18145b6ee22d",
                                                "text": "Molybdän kommt natürlich meistens als Molybdänit vor."
