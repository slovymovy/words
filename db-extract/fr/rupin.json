                ],
                "senses": [
                    {
                        "sense_id": "8a0af6a6-c0f8-3cf2-84cf-4b54557e8822",
                        "entry_id": "cbb5219f-e4c3-327e-b011-c426c38b4b74",
                        "glosses": [
                            "Riche, personne fortunée."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5858c1e3-3771-4763-aaf8-67c6c2b6df00",
                                "sense_id": "8a0af6a6-c0f8-3cf2-84cf-4b54557e8822",
                                "text": "Sûrement un rupin, à voir son attelage."
                            },
                            {
                                "example_id": "75369f93-a6f1-499e-9341-a87b1862ba0c",
                                "sense_id": "8a0af6a6-c0f8-3cf2-84cf-4b54557e8822",
                                "text": "Elle vit le corbillard des pauvres, qui lui parut être le squelette du corbillard des rupins."
                            },
                            {
                                "example_id": "fb76880b-c226-4e59-860e-8c049780f4ad",
                                "sense_id": "8a0af6a6-c0f8-3cf2-84cf-4b54557e8822",
                                "text": "– Y a les rupins et les purées…"
                            },
                            {
                                "example_id": "509538f3-9eb3-41a1-b798-08f9e5520691",
                                "sense_id": "8a0af6a6-c0f8-3cf2-84cf-4b54557e8822",
                                "text": "Pour le voleur que tu recouvres\nDe ton chandail tendre et rouquin\nPour les portes que tu lui ouvres\nSur la tanière des rupins."
                            }
                        ]
                    },
                    {
                        "sense_id": "194f0489-5147-322c-b2be-41248c43ded9",
                        "entry_id": "cbb5219f-e4c3-327e-b011-c426c38b4b74",
                        "glosses": [
                            "Rusé ; qui aime à faire des plaisanteries ^([1])."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
