                        "glosses": [
                            "Strecke auf der eine oder mehrere Hochspannungsleitungen verlaufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb11646-5f57-4b46-aca6-c6815df007c3",
                                "sense_id": "afd0a5bb-266a-32e4-88b0-53d003828bff",
                                "text": "\"Gemeinsam mit der Bündnisgrünen Anna Neuhof hatte Wehner vor wenigen Tagen Vertreter des Netzbetreibers Amprion eingeladen. Erneut wurde über Varianten zur Stromtrasse oberhalb von Alsdorf diskutiert. Derzeit verläuft sie ortsnah.\""
                            },
                            {
                                "example_id": "c1b12265-4a80-4547-97d9-b90178470b90",
                                "sense_id": "afd0a5bb-266a-32e4-88b0-53d003828bff",
                                "text": "„Ausgerechnet Grüne und BUND machen sich stark für den Ausbau von Windrädern und Stromtrassen in Naturschutzgebieten und Biosphärenreservaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
