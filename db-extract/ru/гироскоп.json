                                "target_senses": [
                                    {
                                        "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                        "entry_id": "4e017b86-b900-307b-b3ff-d3a3506b754e",
                                        "glosses": [
                                            "rasch rotierender, symmetrischer Kreisel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d667307d-ae4b-415a-8402-043ffedd0ef5",
                                                "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                                "text": "Mit dem Gyroskop lässt sich die Achsendrehung der Erde nachweisen."
                                            },
                                            {
                                                "example_id": "4c959667-3db9-4a1b-9c97-bdd4fdad31cd",
                                                "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                                "text": "„Ein Gyroskop (auch Kreiselinstrument genannt) dient im Smartphone zur Lagebestimmung des Geräts.“"
                                            },
                                            {
                                                "example_id": "d56df896-5087-4b4e-a1f2-90935be10cf1",
                                                "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                                "text": "„Der Begriff Gyroskop bezeichnet ein Kreiselinstrument, das aus einem Kreisel besteht, der sich in einem Lager dreht. Das Gyroskop ist dabei nicht nur ein interessanten physikalisches Spielzeug, sondern war als Kreiselinstrument eine überaus wichtige Erfindung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90d49fbd-b348-4ddb-806e-3e54675a00e1",
                        "source_entry_id": "8df7d7f3-5c47-3841-8e97-11d3830a8a5d",
                        "source_sense_id": "06618cd8-054d-38cb-a02c-b77dc764a816",
                        "target_lang_word": "Kreisel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreisel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b35f18d2-d8ff-3ad1-91c1-a263534867ec",
                                        "entry_id": "79640dba-79d2-32ec-83b3-ad6123103421",
                                        "glosses": [
                                            "ein kleines Kinderspielzeug, das sich auf einer Spitze im Kreis dreht, wenn man es mit dem entsprechenden Schwung versieht"
                                        ],
                                        "tags": [
                                            "Spielzeug"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f72cd8b-5b5c-4d54-9948-c6070bb29801",
                                                "sense_id": "b35f18d2-d8ff-3ad1-91c1-a263534867ec",
                                                "text": "Der Junge spielte mit einem Kreisel."
                                            },
                                            {
                                                "example_id": "34904506-96cb-4498-9c4b-28067fab9bdf",
                                                "sense_id": "b35f18d2-d8ff-3ad1-91c1-a263534867ec",
                                                "text": "„Im Hof entdeckte ich ein kleines Kind, das mit einem Kreisel spielte, und frage es, wo sein Vater sei; aber anstatt zu antworten, lief es seine Mutter holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f0f56ef4-ae0e-3d41-ab28-a91b6858da8d",
                                        "entry_id": "79640dba-79d2-32ec-83b3-ad6123103421",
                                        "glosses": [
                                            "ein in Bezug auf seine Achse allseits symmetrischer und mit ihr drehbarer Körper"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "89f8dd0c-7be4-3119-a0ef-2264c2dccefe",
                                        "entry_id": "79640dba-79d2-32ec-83b3-ad6123103421",
                                        "glosses": [
                                            "eine genau zentrierte, mit hoher Drehzahl laufende Schwungmasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eca2d2a-f5fb-4f0d-bf6b-ac5e603e025d",
                                                "sense_id": "89f8dd0c-7be4-3119-a0ef-2264c2dccefe",
                                                "text": "Versucht man die Achse eines Kreisels durch seitlichen Druck aus ihrer Richtung zu bringen, so widersteht sie kräftig und weicht quer dazu aus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b06ed688-0647-3652-bf41-2ad213a1d091",
                                        "entry_id": "79640dba-79d2-32ec-83b3-ad6123103421",
                                        "glosses": [
                                            "andere Bezeichnung für Kreisverkehr"
                                        ],
                                        "tags": [
                                            "Jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40811e85-0960-45ba-bf84-ebcac1a79807",
                                                "sense_id": "b06ed688-0647-3652-bf41-2ad213a1d091",
                                                "text": "Ein alkoholisierter Fahrer hat den Kreisel übersehen und einen schweren Verkehrsunfall verursacht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
