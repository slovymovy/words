                ],
                "senses": [
                    {
                        "sense_id": "3634c58b-fbe3-3d5a-a4be-6dd15aa34e18",
                        "entry_id": "040ee698-9c0e-3757-84ae-17e4c178b50e",
                        "glosses": [
                            "de mate waarin iets complex is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1249bb-6064-4ef4-ad2f-ed81f73d44e8",
                                "sense_id": "3634c58b-fbe3-3d5a-a4be-6dd15aa34e18",
                                "text": "De complexiteit van dit vraagstuk valt niet te onderschatten."
                            },
                            {
                                "example_id": "0020eb5e-4eeb-4a7a-8835-8761d1c7bf38",
                                "sense_id": "3634c58b-fbe3-3d5a-a4be-6dd15aa34e18",
                                "text": "Ook in de geschiedenis zien we voorbeelden waar beschavingen uiteindelijk instorten omdat ze op een gegeven moment de complexiteit niet meer aankunnen, terwijl de ecologische ondergrond verkruimelt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce7082a0-bfbf-4ff6-82b3-80a264b3581e",
                        "source_entry_id": "040ee698-9c0e-3757-84ae-17e4c178b50e",
                        "source_sense_id": "3634c58b-fbe3-3d5a-a4be-6dd15aa34e18",
                        "source_sense_description": "de mate waarin iets complex is",
                        "target_lang_word": "Komplexität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Komplexität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "158ceac9-c963-3e87-b5b6-7cb314c543f7",
                                        "entry_id": "d0842990-f90f-3f14-9baa-a5997a02d20f",
                                        "glosses": [
                                            "Verflochtenheit, großes Ausmaß und/oder großer Umfang einer Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15714cae-e0b6-4a37-b464-abde42912216",
                                                "sense_id": "158ceac9-c963-3e87-b5b6-7cb314c543f7",
                                                "text": "„Die hochgradige Komplexität des Lernfeldes erfordert Fächerkooperation, die sich zum Prinzip der Subsidiarität bekennt: Jedes beteiligte Fach beschränkt sich auf jene Aufgaben, die es besser lösen kann als andere Fächer.“"
                                            },
                                            {
                                                "example_id": "3ef0d7e8-1a8e-49ba-aa06-c4b4f4630b40",
                                                "sense_id": "158ceac9-c963-3e87-b5b6-7cb314c543f7",
                                                "text": "Auf Grund der Komplexität dieser Maschine müssen die einzelnen Komponenten einzeln betrachtet werden."
                                            },
                                            {
                                                "example_id": "f651a13c-43be-4f91-85a2-e558ed8a673f",
                                                "sense_id": "158ceac9-c963-3e87-b5b6-7cb314c543f7",
                                                "text": "Die Komplexität des Regelwerkes macht das Spiel unüberschaubar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48e68121-6334-3bf2-9438-0b8be52db7c9",
                                        "entry_id": "d0842990-f90f-3f14-9baa-a5997a02d20f",
                                        "glosses": [
                                            "Abschätzung bezüglich des Ressourcenaufwandes von Algorithmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7038569-c325-49cd-83d7-badc6b6a9d21",
                                                "sense_id": "48e68121-6334-3bf2-9438-0b8be52db7c9",
                                                "text": "Die Komplexität von Suchalgorithmen in geordneten Mengen ist im schlimmsten Fall O(log n)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b18e7758-5ede-43a8-bac8-00f7d057db42",
                        "source_entry_id": "040ee698-9c0e-3757-84ae-17e4c178b50e",
                        "source_sense_id": "3634c58b-fbe3-3d5a-a4be-6dd15aa34e18",
