                                        "sense_id": "5b0a6891-f6ec-3b72-a51a-2555410ba331",
                                        "entry_id": "4862670a-31e7-373f-98f0-d5711c134e0b",
                                        "glosses": [
                                            "Tendency to death, destruction or danger, as if by decree of fate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d554ca65-6558-3ce3-8687-45dd367eb303",
                                        "entry_id": "4862670a-31e7-373f-98f0-d5711c134e0b",
                                        "glosses": [
                                            "That which is decreed by fate or which is fatal; a fatal event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7882525-c9c6-4823-9676-906936aec11b",
                                                "sense_id": "d554ca65-6558-3ce3-8687-45dd367eb303",
                                                "text": "What can I say, or think of this most terrible of fatalities?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abc7b50d-40c5-33ac-ba4f-2334d2eaeddd",
                                        "entry_id": "4862670a-31e7-373f-98f0-d5711c134e0b",
                                        "glosses": [
                                            "Death."
                                        ],
                                        "tags": [],
