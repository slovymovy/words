                            {
                                "example_id": "63aa6319-932e-46f5-8b4b-04f58ef033d3",
                                "sense_id": "af686780-8394-3096-b1b2-367cf8e3fb5b",
                                "text": "The opportunity was also taken to remove one of the few examples of gauntleted tracks in this country, interlacing the down fast and slow lines over the bridge."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aee06ed-ce35-327d-a233-17315eebc3e7",
                        "entry_id": "0913d274-2e47-3989-b77d-19297148d08e",
                        "glosses": [
