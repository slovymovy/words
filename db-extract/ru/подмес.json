                        "glosses": [
                            "действие по значению гл. подмешивать; то же, что подмешивание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0077275-42b6-433b-81b8-4565b26421e4",
                                "sense_id": "f033de3f-e1ea-3534-ad12-e042a502d517",
                                "text": "Средство узнать подмес воды в молоко. Опустите в него стальную спицу."
                            }
