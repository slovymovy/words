                "senses": [
                    {
                        "sense_id": "36d270ea-d764-3f61-a1f7-bf22da87a3e0",
                        "entry_id": "3ce38754-8957-3923-ac90-eafd22b0542a",
                        "glosses": [
                            "Zeitraum um Weihnachten, der je nach Ritus einen unterschiedlichen Anfang und Ende hat (1. Advent bis 6. Januar; Ambrosianischer Ritus: 11. November bis 2. Februar)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52f0c34d-43b7-44f3-b533-572a0ecc177a",
                                "sense_id": "36d270ea-d764-3f61-a1f7-bf22da87a3e0",
                                "text": "O du fröliche, O du selige, Gnadenbringende Weihnachtszeit!"
                            },
                            {
                                "example_id": "a8623509-5781-4361-9f56-093ba36bf45c",
                                "sense_id": "36d270ea-d764-3f61-a1f7-bf22da87a3e0",
                                "text": "Der Westen hat zur Weihnachtszeit gepraßt und baß geschlemmt – nun macht er still gefaßt, …"
                            },
                            {
                                "example_id": "8f7b8f30-f194-4aa8-9bd6-da631c834740",
                                "sense_id": "36d270ea-d764-3f61-a1f7-bf22da87a3e0",
                                "text": "„Besonders die Weihnachts- und Karnevalszeit ärgerte mich.“"
                            },
                            {
                                "example_id": "1482488d-4209-46b5-9043-1bd306bee56c",
                                "sense_id": "36d270ea-d764-3f61-a1f7-bf22da87a3e0",
                                "text": "„Und dann gibt es die, die uns als Teil ihrer Familie sehen, die uns während der Weihnachtszeit Kekse, Schokolade und Traubenzucker bringen und vom Samstagsmarkt Blumen oder Obst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
