                "senses": [
                    {
                        "sense_id": "7e106f1a-de52-3e03-b275-b4ec7dbaab0f",
                        "entry_id": "433f7060-b67d-3c78-a90c-907eb17acfd8",
                        "glosses": [
                            "Namenszusatz für eine Person, den sie aufgrund der Zugehörigkeit zu einer Sippe erhält, wobei der Begriff Sippe in diesem Zusammenhang nicht einheitlich definiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf51491-6bbb-45e2-9caa-0084beb20144",
                                "sense_id": "7e106f1a-de52-3e03-b275-b4ec7dbaab0f",
                                "text": "„Neben den Vatername konnte eine Person besonders durch den Sippennamen näher bestimmt werden.“"
                            },
                            {
                                "example_id": "ec6088ab-1ea0-4611-8e6b-c4bf4ca3c654",
                                "sense_id": "7e106f1a-de52-3e03-b275-b4ec7dbaab0f",
                                "text": "„Auch in den Städten begannen nun die Stadtbürger, Familiennamen und Sippennamen anzunehmen; diese Namen bezogen sich häufig auf Berufe, Tätigkeiten und Regionen.“"
                            },
                            {
                                "example_id": "7939555f-2b75-48b0-a95b-75fea126490c",
                                "sense_id": "7e106f1a-de52-3e03-b275-b4ec7dbaab0f",
                                "text": "„Dass unsere Ortsnamen vielfach nichts weiter als Sippennamen sind, ist eine altbekannte durch die Sprachwissenschaft langst erhärtete Tatsache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
