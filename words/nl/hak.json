                    "sense_definition": "Een verhoging onder de achterkant van een schoen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "heel_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij draagt graag laarzen met een hoge <w>hak</w>.",
                            "target_lang_translations": {
                                "en": "She likes wearing boots with a high <w>heel</w>.",
                                "ru": "Она любит носить сапоги на высоком <w>каблуке</w>.",
                                "pl": "Ona lubi nosić buty na wysokim <w>obcasie</w>.",
                                "de": "Sie trägt gerne Stiefel mit einem hohen <w>Absatz</w>.",
                                "fr": "Elle aime porter des bottes avec un haut <w>talon</w>.",
                                "it": "Le piace indossare stivali con un <w>tacco</w> alto.",
                                "cs": "Ráda nosí kozačky s vysokým <w>podpatkem</w>.",
                                "tr": "Yüksek <w>topuklu</w> çizmeler giymeyi sever.",
                                "es": "A ella le gusta usar botas con <w>tacón</w> alto.",
                                "zh": "她喜欢穿高<w>鞋跟</w>的靴子。"
                            }
                        },
                        {
                            "text": "De <w>hak</w> van mijn linkerschoen is afgebroken.",
                            "target_lang_translations": {
                                "en": "The <w>heel</w> of my left shoe has broken off.",
                                "ru": "<w>Каблук</w> моей левой туфли сломался.",
                                "pl": "<w>Obcas</w> mojego lewego buta się złamał.",
                                "de": "Der <w>Absatz</w> meines linken Schuhs ist abgebrochen.",
                                "fr": "Le <w>talon</w> de ma chaussure gauche s'est cassé.",
                                "it": "Il <w>tacco</w> della mia scarpa sinistra si è rotto.",
                                "cs": "<w>Podpatek</w> mé levé boty se ulomil.",
                                "tr": "Sol ayakkabımın <w>topuğu</w> kırıldı.",
                                "es": "El <w>tacón</w> de mi zapato izquierdo se ha roto.",
                                "zh": "我左脚鞋子的<w>鞋跟</w>断了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hoge hakken",
                        "op hakken lopen",
                        "naaldhakken"
                    ],
                    "target_lang_definitions": {
                        "en": "A raised part under the back of a shoe.",
                        "ru": "Возвышение под задней частью обуви.",
                        "pl": "Podwyższenie pod tylną częścią buta.",
                        "de": "Ein erhöhter Teil unter der Rückseite eines Schuhs.",
                        "fr": "Partie surélevée située sous l'arrière d'une chaussure.",
                        "it": "Parte rialzata sotto la parte posteriore di una scarpa.",
                        "cs": "Zvýšená část pod zadní stranou boty.",
                        "tr": "Ayakkabının arka kısmının altındaki yükselti.",
                        "es": "Una parte elevada debajo de la parte posterior de un zapato.",
                        "zh": "鞋后跟下方的凸起部分。"
                    },
