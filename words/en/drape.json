{
    "word_family": [
        "drapery",
        "draper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7679afac-7934-3651-894b-89be60ff13ee",
                    "sense_definition": "A curtain or piece of fabric used for covering windows or doors.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fabric_hanging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She pulled the heavy <w>drapes</w> shut to block out the bright morning sun.",
                            "target_lang_translations": {
                                "ru": "Она задернула тяжелые <w>шторы</w>, чтобы не пропускать яркое утреннее солнце."
                            }
                        },
                        {
                            "text": "The elegant <w>drapes</w> added a touch of luxury to the living room.",
                            "target_lang_translations": {
                                "ru": "Элегантные <w>портьеры</w> придали гостиной оттенок роскоши."
                            }
                        }
                    ],
                    "synonyms": [
                        "curtain"
                    ],
                    "common_phrases": [
                        "heavy drapes",
                        "close the drapes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занавеска или штора из плотной ткани для окон или дверей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штора",
                                "target_lang_sense_clarification": "плотная оконная занавеска"
                            },
                            {
                                "target_lang_word": "портьера",
                                "target_lang_sense_clarification": "тяжелая ткань для окон или дверей"
                            },
                            {
                                "target_lang_word": "драпировка",
                                "target_lang_sense_clarification": "занавесь со складками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "678a5042-4233-3865-846d-197434328c74",
                    "sense_definition": "The way in which fabric falls or hangs on a person or object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fabric_hanging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The silk dress has a beautiful <w>drape</w> that follows the body perfectly.",
                            "target_lang_translations": {
                                "ru": "У шелкового платья красивая <w>драпировка</w>, которая идеально повторяет контуры тела."
                            }
                        },
                        {
                            "text": "The quality of the fabric is determined by its weight and natural <w>drape</w>.",
                            "target_lang_translations": {
                                "ru": "Качество ткани определяется её весом и естественной <w>драпируемостью</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, как ткань ниспадает или лежит складками на теле или предмете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драпируемость",
                                "target_lang_sense_clarification": "способность ткани образовывать красивые складки"
                            },
                            {
                                "target_lang_word": "ниспадание",
                                "target_lang_sense_clarification": "свойство ткани мягко спадать"
                            },
                            {
                                "target_lang_word": "драпировка",
                                "target_lang_sense_clarification": "расположение складок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc6ae4b4-e2c2-30a9-8517-889db8b98ddc",
                    "sense_definition": "To spread something over an object to cover it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>draped</w> my coat over the back of the chair.",
                            "target_lang_translations": {
                                "ru": "Я <w>накинул</w> пальто на спинку стула."
                            }
                        },
                        {
                            "text": "She <w>draped</w> a blanket over her shoulders to stay warm.",
                            "target_lang_translations": {
                                "ru": "Она <w>набросила</w> плед на плечи, чтобы согреться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "draped over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набросить или небрежно положить ткань или одежду на что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накинуть",
                                "target_lang_sense_clarification": "быстро или свободно положить сверху"
                            },
                            {
                                "target_lang_word": "набросить",
                                "target_lang_sense_clarification": "свободно повесить на плечи или предмет"
                            },
                            {
                                "target_lang_word": "свесить",
                                "target_lang_sense_clarification": "положить так, чтобы края свисали"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6fc32e5-4314-395d-818c-ad7fc63d3bdb",
                    "sense_definition": "To decorate or adorn something with cloth or fabric.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>draped</w> the walls with colorful banners for the celebration.",
                            "target_lang_translations": {
                                "ru": "К празднику они <w>задрапировали</w> стены яркими знамёнами."
                            }
                        },
                        {
                            "text": "The statue was <w>draped</w> in fine silk for the ceremony.",
                            "target_lang_translations": {
                                "ru": "Для церемонии статую <w>обернули</w> тонким шёлком."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать или покрывать тканью, драпировками или флагами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драпировать",
                                "target_lang_sense_clarification": "украшать складками ткани"
                            },
                            {
                                "target_lang_word": "декорировать тканью",
                                "target_lang_sense_clarification": "оформлять полотнами"
                            },
                            {
                                "target_lang_word": "увешивать",
                                "target_lang_sense_clarification": "покрывать висящими тканями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0af6d4b8-9da0-3a19-9115-42b376e83ce8",
                    "sense_definition": "To hang or rest in a relaxed or limp manner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>draped</w> himself across the sofa after a long day at work.",
                            "target_lang_translations": {
                                "ru": "После долгого рабочего дня он <w>развалился</w> на диване."
                            }
                        },
                        {
                            "text": "Her arms <w>draped</w> loosely over the sides of the armchair.",
                            "target_lang_translations": {
                                "ru": "Её руки расслабленно <w>свесились</w> с подлокотников кресла."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободно, расслабленно свешиваться или лежать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развалиться",
                                "target_lang_sense_clarification": "расслабленно расположиться"
                            },
                            {
                                "target_lang_word": "свеситься",
                                "target_lang_sense_clarification": "расслабленно повиснуть"
                            },
                            {
                                "target_lang_word": "свисать",
                                "target_lang_sense_clarification": "свободно падать вниз"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}