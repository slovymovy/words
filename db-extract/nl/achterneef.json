                            {
                                "example_id": "273d67e1-17dd-4388-839d-c7cc6c3b0045",
                                "sense_id": "616f7d9a-8872-39d5-a551-467ccd3ddcb4",
                                "text": "Ik ontmoette mijn achterneef voor het eerst op een familiefeest.",
                                "translation": "I met my grandnephew for the first time at a family gathering.",
                                "english": "I met my grandnephew for the first time at a family gathering."
                            },
                            {
                                "example_id": "627a3e2b-4bef-4cab-be15-7abd18599636",
                                "sense_id": "616f7d9a-8872-39d5-a551-467ccd3ddcb4",
                                "text": "Mijn oma is altijd blij om haar achterneefjes te zien.",
                                "translation": "My grandmother is always happy to see her grandnephews.",
                                "english": "My grandmother is always happy to see her grandnephews."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc3bdbc1-75dd-3413-8df4-ce4816841302",
                        "entry_id": "045d6c84-7f9a-32da-91d0-805fcd44554b",
                        "glosses": [
                            "a male second cousin"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "7fbeaafd-8059-4809-b942-36da3db70b98",
                                "sense_id": "bc3bdbc1-75dd-3413-8df4-ce4816841302",
                                "text": "Onze grootouders zijn broers, dus hij is mijn achterneef.",
                                "translation": "Our grandparents are brothers, so he is my male second cousin.",
                                "english": "Our grandparents are brothers, so he is my male second cousin."
                            },
                            {
                                "example_id": "7687d053-add5-43e0-beec-c66c951f1e16",
                                "sense_id": "bc3bdbc1-75dd-3413-8df4-ce4816841302",
                                "text": "Het is interessant om te leren over de familiebanden en te ontdekken wie je achterneven zijn.",
                                "translation": "It's interesting to learn about family ties and find out who your male second cousins are.",
