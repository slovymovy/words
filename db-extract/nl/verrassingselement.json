                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61e7d0b5-5a77-3bb1-9deb-ce079a577192",
                                        "entry_id": "b73e4c8f-2acf-37ea-b1d3-e0c310424001",
                                        "glosses": [
                                            "The condition of being suspended; cessation for a time."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b938d9bd-b788-40a5-8f56-682e7ce4f901",
                                                "sense_id": "61e7d0b5-5a77-3bb1-9deb-ce079a577192",
                                                "text": "For thee the Fates, severely kind, ordain / A cool suspense from pleasure and from pain; / Thy life a long dead calm of fix'd repose; / No pulse that riots, and no blood that glows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a150fdfc-ea35-3fe7-8cc0-eea88baaeefa",
                                        "entry_id": "b73e4c8f-2acf-37ea-b1d3-e0c310424001",
                                        "glosses": [
                                            "the pleasurable emotion of anticipation and excitement regarding the outcome or climax of a book, film etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16ad565e-1e64-3c90-8568-3feeff639628",
                                        "entry_id": "b73e4c8f-2acf-37ea-b1d3-e0c310424001",
                                        "glosses": [
                                            "The unpleasant emotion of anxiety or apprehension in an uncertain situation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "618b38d1-d053-412a-afa9-8f855a4c9137",
                                                "sense_id": "16ad565e-1e64-3c90-8568-3feeff639628",
                                                "text": "Ten days the prophet in suspense remain'd."
                                            },
                                            {
                                                "example_id": "fb398e93-dbfd-46f8-aed3-fbe16d415ece",
                                                "sense_id": "16ad565e-1e64-3c90-8568-3feeff639628",
                                                "text": "I believe that, to the young, suspense is the most intolerable suffering. Active misery always brings with it its own power of endurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38f6fac0-af10-35c8-a645-b612cbe9118c",
                                        "entry_id": "b73e4c8f-2acf-37ea-b1d3-e0c310424001",
                                        "glosses": [
                                            "A temporary cessation of one's right; suspension, as when the rent or other profits of land cease by unity of possession of land and rent."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "386e27c2-7b95-3de8-85dc-40063ebe97de",
                                        "entry_id": "b73e4c8f-2acf-37ea-b1d3-e0c310424001",
                                        "glosses": [
                                            "A deadline."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "274dd70b-4926-44d4-9494-18500d7a39e3",
                                                "sense_id": "386e27c2-7b95-3de8-85dc-40063ebe97de",
                                                "text": "She sent us that assignment with a suspense of noon tomorrow."
                                            }
                                        ]
                                    }
                                ]
