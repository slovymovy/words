                    {
                        "form_id": "9a5a57da-d647-4556-9289-408c97004550",
                        "entry_id": "3cd8defe-5c12-3815-b1ee-cbdbc49952ce",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sozialdemokratien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47c712a0-5563-385f-bd6a-4fb53e9df962",
                        "entry_id": "3cd8defe-5c12-3815-b1ee-cbdbc49952ce",
                        "glosses": [
                            "politische Ideologie, entstanden aus der Arbeiterbewegung, welche demokratische und sozialistische Grundsätze in sich vereint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7bece4-e80a-4230-9b57-ef749dd7656c",
                                "sense_id": "47c712a0-5563-385f-bd6a-4fb53e9df962",
                                "text": "„Als Folge der Industrialisierung wurde Thüringen zur Wiege der Sozialdemokratie.“"
                            },
                            {
                                "example_id": "f93f08aa-fcf7-4475-b583-2dfa1f89f8fa",
                                "sense_id": "47c712a0-5563-385f-bd6a-4fb53e9df962",
                                "text": "„Ein paar Jahre später war Schönerer der Führer einer deutschnationalen und antisemitischen Partei, Adler der Vorsitzende der gesamtösterreichischen Sozialdemokratie und Masaryk ein Prager Politiker und Professor, der viel später zur größten Integrationsfigur seines Volkes werden sollte.“"
                            },
                            {
                                "example_id": "4dda9881-5094-4bcd-9b36-7cdc9b5878ac",
                                "sense_id": "47c712a0-5563-385f-bd6a-4fb53e9df962",
                                "text": "„Eine Parteifreundin will einen alten Mann mit Krückstock von den Vorzügen der Sozialdemokratie überzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94dbb7a3-0284-4afd-a26a-2c47dc2fb0c2",
                        "source_entry_id": "3cd8defe-5c12-3815-b1ee-cbdbc49952ce",
                        "source_sense_id": "47c712a0-5563-385f-bd6a-4fb53e9df962",
                        "target_lang_word": "social democracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "social democracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b3fe495-dd0f-3c0b-a729-95c97aeaec2d",
                                        "entry_id": "dae896cc-360c-3af9-9415-70e0df83d5b6",
                                        "glosses": [
                                            "A moderate political philosophy or ideology that aims to achieve socialist (socialistic) goals within a democratic society and a liberal democracy such as by means of a strong welfare state and regulation of private industry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4f13626-ffd6-3579-a8dc-5fd14f05f4d1",
                                        "entry_id": "dae896cc-360c-3af9-9415-70e0df83d5b6",
                                        "glosses": [
                                            "A society based on this ideology."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc4a3453-f3bc-4224-8e19-5758e5b22c97",
                        "source_entry_id": "3cd8defe-5c12-3815-b1ee-cbdbc49952ce",
                        "source_sense_id": "47c712a0-5563-385f-bd6a-4fb53e9df962",
                        "target_lang_word": "social-démocratie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "social-démocratie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3710a366-b3f1-3d1f-8498-0c4f44b04913",
                                        "entry_id": "c49f74d6-369a-3513-a7b7-fc89773cb1ba",
                                        "glosses": [
                                            "Doctrine politique socialiste non marxiste."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa351e68-6600-4444-ac81-472f3d90742c",
                                                "sense_id": "3710a366-b3f1-3d1f-8498-0c4f44b04913",
                                                "text": "La révolution n'ayant pas eu lieu, Guesde, les années 1890-1895, se rallie à l'idée de la conquête du pouvoir par le suffrage universel : après un flirt avec le boulangisme, c'est l'époque du « municipalisme », du socialisme ordonné et respectable à l'imitation de la social-démocratie allemande."
                                            },
                                            {
                                                "example_id": "40089808-3ba0-4e41-960e-b880537dd5d5",
                                                "sense_id": "3710a366-b3f1-3d1f-8498-0c4f44b04913",
                                                "text": "Les radsocs de l'époque, véritables précurseurs de la social-démocratie, situés à la droite de socialistes sur le demi-camembert électoral, passeraient aujourd'hui pour des gauchistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55fcd912-6011-3a50-b94a-95f442b7c7d4",
                                        "entry_id": "c49f74d6-369a-3513-a7b7-fc89773cb1ba",
                                        "glosses": [
                                            "Doctrine politique prônant l’économie sociale de marché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a4a4b68-c03f-41a6-9c81-38a2ede2722f",
                                                "sense_id": "55fcd912-6011-3a50-b94a-95f442b7c7d4",
                                                "text": "La social-démocratie européenne a subi 13 défaites sur les 15 derniers scrutins. Est-ce, dans chacun de ces treize partis, faute de leaders ou de discipline ? Ou bien est-ce le résultat de l’acceptation, par la social-démocratie, des principes néolibéraux, des valeurs de nos adversaires ?"
                                            },
                                            {
                                                "example_id": "baf6afd9-09c8-4f3e-bc03-fec241f1155a",
                                                "sense_id": "55fcd912-6011-3a50-b94a-95f442b7c7d4",
                                                "text": "Pour rompre le charme idéologique de l'antiégalitarisme contemporain, Spitz autant que Sen, […], ont une stratégie partagée : ils prônent des inventaires critiques parallèles de l'œuvre réalisée par la social-démocratie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bc9340c-b12f-3008-9c9a-86c05cbd1dde",
                                        "entry_id": "c49f74d6-369a-3513-a7b7-fc89773cb1ba",
                                        "glosses": [
                                            "État appliquant l’une des doctrines définies ci-dessus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "566d1184-625d-4361-9669-e5c916f5a5a7",
                                                "sense_id": "1bc9340c-b12f-3008-9c9a-86c05cbd1dde",
                                                "text": "Les social-démocraties d’Europe du Nord ont souvent été citées en référence par des personnalités politiques de gauche d’Europe occidentale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
