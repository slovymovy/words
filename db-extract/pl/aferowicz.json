                "senses": [
                    {
                        "sense_id": "c184a36c-e59d-3db8-b2c7-6ae9d0528ecb",
                        "entry_id": "feeb8db2-5a6c-31ab-a3a2-eea33888cfde",
                        "glosses": [
                            "scandalizer (person involved in scandals, criminal conspiracies)"
                        ],
                        "tags": [
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "898b8019-06ef-4c28-8ed0-fe53b12eed9c",
                                "sense_id": "c184a36c-e59d-3db8-b2c7-6ae9d0528ecb",
                                "text": "Z punktu, gdzie stoisz, widzisz ocean błota, w którem grzęzną, spychają się wzajemnie w kałuże karyerzyści, aferowicze i cała zbydlęcona hałastra.",
                                "translation": "From where you stand, you can see an ocean of mud in which careerists, scandalizers and the whole depraved rabble are stuck, pushing each other into puddles.",
                                "english": "From where you stand, you can see an ocean of mud in which careerists, scandalizers and the whole depraved rabble are stuck, pushing each other into puddles."
                            },
                            {
                                "example_id": "686c6f8c-aba0-4e2b-8288-ddcd5e6746f3",
                                "sense_id": "c184a36c-e59d-3db8-b2c7-6ae9d0528ecb",
                                "text": "[…]„przedstawiał rzadki typ aferowicza zaprzątniętego wyłącznie wzrostem dobrobytu krajowego“.",
                                "translation": "[…] „he represented a rare type of scandalizer preoccupied solely with increasing the country's prosperity“.",
                                "english": "[…] „he represented a rare type of scandalizer preoccupied solely with increasing the country's prosperity“."
                            }
                        ]
                    }
                ],
