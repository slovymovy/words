                ],
                "senses": [
                    {
                        "sense_id": "f1b640bb-7914-338a-853d-29f5bff5c3e7",
                        "entry_id": "fd19c907-693c-31b5-9909-b3b6d5274841",
                        "glosses": [
                            "kleines Gerät zum Kochen und Erhitzen von Speisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e80b9542-f6c8-4431-9b27-d8403fe93573",
                                "sense_id": "f1b640bb-7914-338a-853d-29f5bff5c3e7",
                                "text": "Zum Zelten nehme ich immer meinen Kocher mit."
                            },
                            {
                                "example_id": "b937960a-0425-4aa7-a2f8-2c3789dc41cb",
                                "sense_id": "f1b640bb-7914-338a-853d-29f5bff5c3e7",
                                "text": "Die Kocher finden sie in der Camping-Abteilung."
                            },
                            {
                                "example_id": "f5b17429-1ec4-4cf5-b7cd-68eedfe994b6",
                                "sense_id": "f1b640bb-7914-338a-853d-29f5bff5c3e7",
                                "text": "„Er holte eine Injektionsspritze und kochte sie in einem kleinen elektrischen Kocher auf der Fensterbank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66fbe691-dc25-4f9d-89e6-448cc9912211",
                        "source_entry_id": "fd19c907-693c-31b5-9909-b3b6d5274841",
                        "source_sense_id": "f1b640bb-7914-338a-853d-29f5bff5c3e7",
                        "source_sense_description": "kleines Gerät zum Kochen und Erhitzen von Speisen",
                        "target_lang_word": "stove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85df5616-af52-3dac-b619-e45fe1ab571d",
                                        "entry_id": "f3338435-e692-32b1-8b49-fe42d8456011",
                                        "glosses": [
                                            "A heater, a closed apparatus to burn fuel for the warming of a room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d53f0fe-6ee1-4985-aac1-13bfe8f44e72",
                                                "sense_id": "85df5616-af52-3dac-b619-e45fe1ab571d",
                                                "text": "1815 Robertson Buchanan, Appendix to A Treatise on the Economy of Fuel, and Management of Heat, Especially as it Relates to Heating and Drying by Means of Steam. p. 309.\n[I]n the countries of modern Europe, the use of stoves prevail throughout the north; while in France and Great Britain, open fires are used. In the warm countries of Italy and Spain, there are very few chimneys, and the only method usually practised of tempering the cold... is to burn charcoal in portable brasiers."
                                            },
                                            {
                                                "example_id": "881a5568-9eb9-4e85-ad79-87b9a1bf7abe",
                                                "sense_id": "85df5616-af52-3dac-b619-e45fe1ab571d",
                                                "text": "We toted in the wood and got the fire going nice and comfortable. Lord James still set in one of the chairs and Applegate had cabbaged the other and was hugging the stove."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e11f74-3a8f-3bc0-a402-83606d292c45",
                                        "entry_id": "f3338435-e692-32b1-8b49-fe42d8456011",
                                        "glosses": [
                                            "A device for heating food, (UK) a cooker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cce6a5a4-8f7b-3726-8114-6ea2782f6f55",
                                        "entry_id": "f3338435-e692-32b1-8b49-fe42d8456011",
                                        "glosses": [
                                            "A stovetop, with hotplates."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c26ae48-3e52-32e0-a1dc-f964b9479737",
                                        "entry_id": "f3338435-e692-32b1-8b49-fe42d8456011",
                                        "glosses": [
                                            "A hothouse (heated greenhouse)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ca8e21e-2e21-47f9-9e7e-1059d9b7795b",
                                                "sense_id": "8c26ae48-3e52-32e0-a1dc-f964b9479737",
                                                "text": "There existed only one specimen of this sacred tree in all Mexico, at least to the knowledge of the Mexicans; […] In spite, however, of the firmest convictions of the indivisibility of this tree — the Manitas, as it is commonly called — it has been propagated by cuttings, some of which are at this moment thriving in some of the larger stoves of our modern collectors."
                                            },
                                            {
                                                "example_id": "9d1beaae-5282-4f89-8125-0707ffd7daf8",
                                                "sense_id": "8c26ae48-3e52-32e0-a1dc-f964b9479737",
                                                "text": "Let but these facts lie contrasted with the treatment they usually receive in the stoves of this country, and the reason why they never grow to any considerable size, attain to any degree of perfection, or flourish to any extent […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42f9835d-92e3-3865-85b2-b2043dd59c4c",
                                        "entry_id": "f3338435-e692-32b1-8b49-fe42d8456011",
                                        "glosses": [
                                            "A house or room artificially warmed or heated."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8b455d6-4488-4695-83d1-8625a303b89b",
                                                "sense_id": "42f9835d-92e3-3865-85b2-b2043dd59c4c",
                                                "text": "April 1, 1634, Thomas Wentworth, 1st Earl of Strafford, letter to the Lord Deputy\nWhen most of the waiters were commanded away to their supper, the Parlour or Stove being near emptied, in came a Company of Musketeers."
                                            },
                                            {
                                                "example_id": "85f89fba-efb3-4edc-9d6d-6f0039e8cfda",
                                                "sense_id": "42f9835d-92e3-3865-85b2-b2043dd59c4c",
                                                "text": "How tedious is it to them that live in stoves and caves half a year together, as in Iceland, Muscovy, or under the pole!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f271c2e6-e0fb-30b8-b473-78d69973f241",
                                        "entry_id": "e22e043c-b7be-3070-b441-47def955c1af",
                                        "glosses": [
                                            "To heat or dry, as in a stove."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a06ae63-d088-4e10-a98a-39ff83158ee9",
                                                "sense_id": "f271c2e6-e0fb-30b8-b473-78d69973f241",
                                                "text": "to stove feathers"
                                            },
                                            {
                                                "example_id": "5674cd82-2f27-4d26-9fe8-3bc6f1db1bac",
                                                "sense_id": "f271c2e6-e0fb-30b8-b473-78d69973f241",
                                                "text": "The wide use of amine-cured epoxy paints is mostly due to their providing many of the properties of stoved epoxy films from an ambient temperature-cured system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e22781e5-8271-380f-88a0-2085d905c0ae",
                                        "entry_id": "e22e043c-b7be-3070-b441-47def955c1af",
                                        "glosses": [
                                            "To keep warm, in a house or room, by artificial heat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ec0f495-75bc-4105-be2f-4614bb6548fc",
                                                "sense_id": "e22781e5-8271-380f-88a0-2085d905c0ae",
                                                "text": "to stove orange trees"
                                            },
                                            {
                                                "example_id": "92cd43f1-147d-498a-8e66-12121597eec3",
                                                "sense_id": "e22781e5-8271-380f-88a0-2085d905c0ae",
                                                "text": "orange-trees , lemon-trees , and myrtles , if they be stoved"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "739afdaa-deaa-369a-9dcc-71122558ff55",
                                        "entry_id": "e22e043c-b7be-3070-b441-47def955c1af",
                                        "glosses": [
                                            "To jam; to sprain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2750b7a6-df9c-4c9c-8963-a1b22dfb7ab2",
                                                "sense_id": "739afdaa-deaa-369a-9dcc-71122558ff55",
                                                "text": "to stove a finger"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c49e1230-aeec-32af-a3c2-fdb7576ddf90",
                                        "entry_id": "68f391c4-8836-35bd-a7df-42cafc6e1cd2",
                                        "glosses": [
                                            "simple past and past participle of stave"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6609bac9-91dc-437b-844c-bbbfa310295a",
                                                "sense_id": "c49e1230-aeec-32af-a3c2-fdb7576ddf90",
                                                "text": "[A]ye, a stove boat will make me an immortal by brevet."
                                            },
                                            {
                                                "example_id": "b65e469f-527b-4487-b7b5-80e5d8e8e273",
                                                "sense_id": "c49e1230-aeec-32af-a3c2-fdb7576ddf90",
                                                "text": "\"A dead whale or a stove boat!\""
                                            },
                                            {
                                                "example_id": "931701ea-685e-4957-97f8-85cb70f6f50c",
                                                "sense_id": "c49e1230-aeec-32af-a3c2-fdb7576ddf90",
                                                "text": "\"Our cracked four-pounders made an awful din / but with one fat ball, the Yank stove us in.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a14f80e5-9c6a-4a81-b162-5c77964666e1",
                        "source_entry_id": "fd19c907-693c-31b5-9909-b3b6d5274841",
                        "source_sense_id": "f1b640bb-7914-338a-853d-29f5bff5c3e7",
                        "source_sense_description": "kleines Gerät zum Kochen und Erhitzen von Speisen",
                        "target_lang_word": "réchaud",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réchaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7deea8b-2f38-39ce-9b7d-caa0611c7fbe",
                                        "entry_id": "27103b2d-1b02-34af-800a-10aeb9d32de4",
                                        "glosses": [
                                            "Ustensile de ménage dans lequel on met du feu pour chauffer les mets, pour tenir chauds les plats et pour d’autres usages."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c713a25c-3f80-4840-9d77-97abc84e9a7e",
                                                "sense_id": "a7deea8b-2f38-39ce-9b7d-caa0611c7fbe",
                                                "text": "Le réchaud de table est l’un des nombreux objets retrouvés par les archéologues sur les sites de fouille de la Renaissance."
                                            },
                                            {
                                                "example_id": "0f7a8de9-f776-41f9-96da-fb44a92162e4",
                                                "sense_id": "a7deea8b-2f38-39ce-9b7d-caa0611c7fbe",
                                                "text": "Mme Maigret venait d’allumer un petit réchaud à alcool pour y préparer une tisane."
                                            },
                                            {
                                                "example_id": "c87f6583-9134-4b97-b101-75a4a00b09de",
                                                "sense_id": "a7deea8b-2f38-39ce-9b7d-caa0611c7fbe",
                                                "text": "J’essaie bien de cuire du porridge sur le réchaud à cadran, mais une vague plus forte envoie le porridge se coller au plafond et aux parois du poste."
                                            },
                                            {
                                                "example_id": "31fad37a-9e4d-48ec-aa6f-44068db50181",
                                                "sense_id": "a7deea8b-2f38-39ce-9b7d-caa0611c7fbe",
                                                "text": "Dame ! en voyant une table étincelant d’argenterie (les réchauds, les chandeliers, tout brillait comme un écrin), elle part comme du sodavatre et lance sa fusée : « Quand on dépense l’argent des autres, on devrait être sobre, ne pas donner à dîner. Être comtesse et devoir cent écus à une malheureuse cordonnière qui a sept enfants !… »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb144a64-0e28-39c3-8297-be2e10d0f78a",
                                        "entry_id": "27103b2d-1b02-34af-800a-10aeb9d32de4",
                                        "glosses": [
                                            "Ce même ustensile utilisé par les graveurs pour chauffer les planches de cuivre qu’ils veulent graver à l’eau-forte, afin qu’ils puissent y étendre le vernis sur lequel ils dessinent leurs figures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c604c61-0152-32c5-8c86-456d9f73d62a",
