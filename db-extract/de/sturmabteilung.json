                    },
                    {
                        "form_id": "da75d016-ce44-45b9-b629-e0bf7a539127",
                        "entry_id": "e318782b-97d9-3ae9-b0af-93a585b1b46c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sturmabteilungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f7d6ffb-1077-3f7c-9658-e84b7aaff4e0",
                        "entry_id": "e318782b-97d9-3ae9-b0af-93a585b1b46c",
                        "glosses": [
                            "zum Sturm auf einen Feind gesammelte Abteilung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2c741b9-efd4-4345-b87c-7a10b18f9e8b",
                                "sense_id": "4f7d6ffb-1077-3f7c-9658-e84b7aaff4e0",
                                "text": "Die Sturmabteilung näherte sich der Festung im Schutze der Dunkelheit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f2e5b453-4a72-3004-a276-c065dca78146",
                        "entry_id": "e318782b-97d9-3ae9-b0af-93a585b1b46c",
                        "glosses": [
                            "bewaffnete und uniformierte Kampftruppe der NSDAP"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "027f6709-e7ea-48e3-bf6b-b4a3802f7bb7",
                                "sense_id": "f2e5b453-4a72-3004-a276-c065dca78146",
                                "text": "„Aus diesem Saalschutz entwickelte sich über mehrere Schritte die spätere Sturmabteilung (kurz S.A.) als reine Schlägertruppe für provozierte Zusammenstöße mit linksgerichteten Parteien (vor allem der KPD), die vielfach in brutale Straßenkämpfe ausarteten.“"
                            },
                            {
                                "example_id": "2e0773ca-a1b8-4051-90e9-610be68bc0ff",
                                "sense_id": "f2e5b453-4a72-3004-a276-c065dca78146",
                                "text": "„Die Sturmabteilung hatte die ‚Sturm-Zigarette‘, die SPD die ‚Freiheits-Zigarette‘, und die Reemtma-Zigarette wurde damals die ‚Judenzigarette‘ genannt.“"
                            },
                            {
                                "example_id": "1ff9297f-252a-42d1-a254-10c9fb92e557",
                                "sense_id": "f2e5b453-4a72-3004-a276-c065dca78146",
                                "text": "„Am 22. Februar werden SA (Sturmabteilung), SS (Schutzstaffel) und die Stahlhelmverbände zur Hilfspolizei erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c0892b4c-0cd1-3bb4-929f-c2354ebc0112",
                        "entry_id": "e318782b-97d9-3ae9-b0af-93a585b1b46c",
                        "glosses": [
                            "paramilitärische Kampftruppe einer rechtsgerichteten Partei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7456af-05fe-4a7f-b4b9-84c094ecc2b7",
                                "sense_id": "c0892b4c-0cd1-3bb4-929f-c2354ebc0112",
                                "text": "„Während der zwei Jahre zwischen 1920 und der Machtübernahme durch den Duce werden Hunderte von Fabrik- und Landarbeitern, Gewerkschaftern und Sozialisten von den faschistischen Sturmabteilungen, mit Billigung oder Unterstützung von Polizei und Armee, systematisch mit Keulen totgeschlagen oder erschossen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
