                "senses": [
                    {
                        "sense_id": "ad4cbae4-7832-3bba-996e-035e3d923247",
                        "entry_id": "d66bbbe4-5091-3895-ba0b-f8f0a45598a0",
                        "glosses": [
                            "een manier van spelen die vooral is gebaseerd op fysieke kracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c0d29fe-9156-4aa2-9375-758eb987b609",
                                "sense_id": "ad4cbae4-7832-3bba-996e-035e3d923247",
                                "text": "Het powerplay van de Duitser tegen het tactische vernuft van de Catalaan is de afgelopen jaren regelmatig goed geweest voor spectaculaire duels met een karrenvracht aan doelpunten. De balans is na 12 duels licht in het voordeel van Klopp: 6 zeges tegenover 5 nederlagen. Maar één keer eindigde een ontmoeting tussen de twee in een remise."
                            },
                            {
                                "example_id": "3364bd42-a682-4f24-aad9-e9ebbffd35d9",
                                "sense_id": "ad4cbae4-7832-3bba-996e-035e3d923247",
                                "text": ",,Ik heb in mijn leven genoeg spectaculair judo laten zien”, zegt Grol. Oftewel: dat hij in het verleden in de klasse tot 100 kilogram juist wilde judoën en genoot van confrontaties en vernederende worpen in plaats van tactisch spel, dat maakt hem niks uit. ,,Het kan me niks meer schelen, het gaat om winnen. En dit gaat ook wel spektakel opleveren. Als het een keer niet gaat, ga ik all-in, dan wordt het wel powerplay.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "2551498d-5cc4-36dd-8a9d-628ec3042bb8",
                        "entry_id": "d66bbbe4-5091-3895-ba0b-f8f0a45598a0",
                        "glosses": [
                            "de benaming in het ijshockey voor een numeriek overwicht, veroorzaakt door een penalty van de tegenpartij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69a4adae-a0e8-41c3-a8a0-e66bf085a60c",
                                "sense_id": "2551498d-5cc4-36dd-8a9d-628ec3042bb8",
                                "text": "Twee keer kwam Trappers op voorsprong (via Nardo Nagtzaam en Max Hermens), twee keer had Deggendorfer SC weinig tijd nodig om in powerplay voor de gelijkmaker te zorgen: 2-2."
                            }
                        ]
                    },
                    {
                        "sense_id": "86120c0d-af5d-347b-9522-dcbf6874eba1",
                        "entry_id": "d66bbbe4-5091-3895-ba0b-f8f0a45598a0",
                        "glosses": [
                            "gebruik van macht in plaats van overleg en overtuiging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "692fba0a-cc5f-4ddd-91d3-45813e898ec4",
                                "sense_id": "86120c0d-af5d-347b-9522-dcbf6874eba1",
                                "text": "De linkse partijen in de gemeenteraad maken zich zorgen over de toenemende spanningen in het stadhuis over de gemeentelijke reorganisatie. De partijen spreken van een ‘powerplay’ die uiteindelijk alleen maar verliezers oplevert."
                            }
                        ]
                    }
