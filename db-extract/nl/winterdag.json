                        "entry_id": "86526cba-8987-352c-8f7d-d5a84833b3da",
                        "glosses": [
                            "een dag in december, januari of februari"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "169e2748-7dbf-4d18-ade3-ec1b446d84ae",
                                "sense_id": "8c3a240f-7224-351b-8493-85cd20f33aa4",
                                "text": "De broers hadden zich op identieke manier uitgerust toen ze na het ontbijt de schitterende winterdag in stapten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f09f45d-167e-4cc1-926c-02450c7a33e7",
                        "source_entry_id": "86526cba-8987-352c-8f7d-d5a84833b3da",
                        "source_sense_id": "8c3a240f-7224-351b-8493-85cd20f33aa4",
                        "source_sense_description": "winterdag",
                        "target_lang_word": "Wintertag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wintertag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90dda9c4-72ed-3854-b75b-4bf054737e76",
                                        "entry_id": "8d37134b-260e-3996-8b8d-efae2a0d54b6",
                                        "glosses": [
                                            "Tag im Winter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53dc5745-0ff9-42f0-a19a-49f26afc84b0",
                                                "sense_id": "90dda9c4-72ed-3854-b75b-4bf054737e76",
                                                "text": "„An einem kalten Wintertag im Jahr 1905 spielte der Elfjährige auf der Veranda seines Hauses.“"
                                            },
                                            {
                                                "example_id": "681bce6d-26c9-46c2-984a-0c3ff7d1dee7",
                                                "sense_id": "90dda9c4-72ed-3854-b75b-4bf054737e76",
                                                "text": "„Es ist ein klarer sonniger Wintertag, zu klar für eine Flucht.“"
                                            },
                                            {
                                                "example_id": "96a38e4b-3a91-4131-9761-da3bfc7725ba",
                                                "sense_id": "90dda9c4-72ed-3854-b75b-4bf054737e76",
                                                "text": "Erwin wurde an einem Wintertag geboren."
                                            },
                                            {
                                                "example_id": "1ee16694-c5ca-4831-8a3d-55e23bce83c5",
                                                "sense_id": "90dda9c4-72ed-3854-b75b-4bf054737e76",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Walde das Schmücken von Weihnachtsbäumen."
                                            },
                                            {
                                                "example_id": "b152cb4d-26a2-4b72-ae05-3cb7e0801006",
                                                "sense_id": "90dda9c4-72ed-3854-b75b-4bf054737e76",
                                                "text": "„Wahrscheinlich sollte er nur sagen, was sich damals, in jenen wenigen Wintertagen, zugetragen hatte.“"
                                            },
                                            {
                                                "example_id": "0bf1ac8a-f8f0-4c0c-a93e-5db62a6178a1",
                                                "sense_id": "90dda9c4-72ed-3854-b75b-4bf054737e76",
                                                "text": "„An einem eisig kalten Wintertag sitzt ein Angler mit seiner dicken Backe am Fluss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
