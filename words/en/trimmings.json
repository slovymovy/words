{
    "word_family": [
        "trim",
        "trimmer",
        "trimmed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "056146b5-756f-3c78-b52a-bc17d2a20c2f",
                    "sense_definition": "Side dishes or extra items served with a main course of a meal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food_accompaniments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a traditional turkey dinner with all the <w>trimmings</w>.",
                            "target_lang_translations": {
                                "pl": "Zjedliśmy tradycyjny obiad z indykiem ze wszystkimi <w>dodatkami</w>."
                            }
                        },
                        {
                            "text": "The roast beef was served with potatoes and all the usual <w>trimmings</w>.",
                            "target_lang_translations": {
                                "pl": "Pieczeń wołowa została podana z ziemniakami i wszystkimi typowymi <w>dodatkami</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "accompaniments",
                        "sides"
                    ],
                    "common_phrases": [
                        "all the trimmings"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dodatki do dania głównego, serwowane jako uzupełnienie posiłku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dodatki",
                                "target_lang_sense_clarification": "ogólne określenie na składniki towarzyszące daniu głównemu"
                            },
                            {
                                "target_lang_word": "garnirunek",
                                "target_lang_sense_clarification": "elementy dekoracyjne lub smakowe uzupełniające potrawę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b235e660-7e70-3322-ba8d-d5ce8faa737f",
                    "sense_definition": "Decorative items used to adorn a room, particularly for festive occasions like Christmas.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decorations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family spent the afternoon putting up the Christmas <w>trimmings</w>.",
                            "target_lang_translations": {
                                "pl": "Rodzina spędziła popołudnie na wieszaniu świątecznych <w>ozdób</w>."
                            }
                        },
                        {
                            "text": "Don't forget to take the <w>trimmings</w> down by twelfth night.",
                            "target_lang_translations": {
                                "pl": "Nie zapomnij zdjąć <w>dekoracji</w> przed świętem Trzech Króli."
                            }
                        }
                    ],
                    "synonyms": [
                        "decorations",
                        "ornaments"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ozdoby używane do dekoracji wnętrz, szczególnie podczas świąt."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ozdoby",
                                "target_lang_sense_clarification": "przedmioty służące do dekoracji"
                            },
                            {
                                "target_lang_word": "dekoracje",
                                "target_lang_sense_clarification": "elementy wystroju wnętrza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73697381-7643-3017-a6a2-57d492bcd650",
                    "sense_definition": "The plural form of <w>trimming</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dress had delicate lace <w>trimmings</w> along the edges.",
                            "target_lang_translations": {
                                "pl": "Sukienka miała delikatne koronkowe <w>wykończenia</w> wzdłuż krawędzi."
                            }
                        },
                        {
                            "text": "He cut off the excess <w>trimmings</w> from the fabric.",
                            "target_lang_translations": {
                                "pl": "Odciął zbędne <w>skrawki</w> materiału."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of trimming"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wykończenia, obszycia lub skrawki materiału."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wykończenia",
                                "target_lang_sense_clarification": "elementy zdobiące brzegi tkaniny"
                            },
                            {
                                "target_lang_word": "skrawki",
                                "target_lang_sense_clarification": "odcięte kawałki materiału"
                            }
                        ]
