                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d207ad7b-8e95-49ec-8e94-22139bccd14e",
                                "sense_id": "03110f18-4f88-3952-a36b-8b3d6511cc56",
                                "text": "Au fil de cet ouvrage, le lecteur découvrira des tentatives variées de concilier ou «déconcilier» les sciences et la morale."
                            },
                            {
                                "example_id": "c38e2201-5ddb-4b2c-8092-64381e70aafb",
                                "sense_id": "03110f18-4f88-3952-a36b-8b3d6511cc56",
                                "text": "Quelques sermons de quelques hypocondriaques sont-ils à ce point, parvenus à déconcilier l’Algérien avec sa santé ?"
                            },
                            {
                                "example_id": "dde83c7c-0a7e-4b11-94fe-e2351b3e82be",
                                "sense_id": "03110f18-4f88-3952-a36b-8b3d6511cc56",
                                "text": "Pour déconcilier une transaction, vous devez remonter à celle-ci en déconciliant d’abord les mois qui ont été conciliés par après."
                            },
                            {
                                "example_id": "0ad772c6-e10b-46ea-90d9-6c839832e4c9",
                                "sense_id": "03110f18-4f88-3952-a36b-8b3d6511cc56",
                                "text": "Et comme il vit auprès de moi tous les jours et bien, je ne peux pas déconcilier ma vie de lui."
                            }
                        ]
                    }
                ],
