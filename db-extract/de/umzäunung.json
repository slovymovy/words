                ],
                "senses": [
                    {
                        "sense_id": "1114c7b7-cf30-359d-be8a-705dcd239fbf",
                        "entry_id": "02455edd-19d4-3997-8b1a-e8dbd89376b5",
                        "glosses": [
                            "Handlung, etwas mit einem Zaun zu umgeben"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "824dee66-4cbc-459f-83e5-f3b8b8efecc6",
                                "sense_id": "1114c7b7-cf30-359d-be8a-705dcd239fbf",
                                "text": "Die Umzäunung der Wiese dauerte länger, als er gedacht hatte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "972d5a93-6c53-32a9-9301-95073d557ae5",
                        "entry_id": "02455edd-19d4-3997-8b1a-e8dbd89376b5",
                        "glosses": [
                            "Ergebnis von [1]: Zaun, der etwas umgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ef0f8f-0042-4862-83f4-6057a2b2cc51",
                                "sense_id": "972d5a93-6c53-32a9-9301-95073d557ae5",
                                "text": "Das Pferd galoppierte los, übersprang die Umzäunung und lief davon."
                            },
                            {
                                "example_id": "5fdf39b7-177e-4977-8b25-261792238094",
                                "sense_id": "972d5a93-6c53-32a9-9301-95073d557ae5",
                                "text": "„Die nicht übermäßig hohe Umzäunung wurde von einem dichten Gestrüpp rotblühender Sumachs, Sassafras, Gewürzbüsche und Dogwoods umschlossen, sie überschatteten einen kleinen Bach, der eine halbe Meile weiter oben aus den Hügeln kam und dicht über Helena in den Mississippi lief.“"
                            },
                            {
                                "example_id": "feab6f38-c537-4fcf-bc1c-16abef9bf0c2",
                                "sense_id": "972d5a93-6c53-32a9-9301-95073d557ae5",
                                "text": "„Die Tiere hatten natürlich versucht, gegen die Umzäunung anzurennen, aber die Palisaden hatten standgehalten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
