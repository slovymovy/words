                    {
                        "sense_id": "fc1a2a4c-bbb1-363f-bba9-9336874679ab",
                        "entry_id": "370a2275-afef-383f-a904-df9b8570304d",
                        "glosses": [
                            "Fehlen der Schweißdrüsen von Geburt an"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe2a3dcf-ca6d-4f27-820f-573acda835b1",
                                "sense_id": "fc1a2a4c-bbb1-363f-bba9-9336874679ab",
                                "text": "In der englischsprachigen Bezeichnung [der hereditären sensorischen und autonomen Neuropathie Typ IV] sind die wesentlichen Symptome genannt: klinisch im Vordergrund steht schon bei der Geburt eine erhebliche Störung des Schmerz- und Temperatursinns sowie eine Anhidrose."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1182fe48-809b-39ca-8d63-7192dba55a39",
                        "entry_id": "370a2275-afef-383f-a904-df9b8570304d",
                        "glosses": [
                            "verminderte oder völlig fehlende Schweißabsonderung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "320887b6-b7df-4f9f-8202-fcd5102c3577",
                                "sense_id": "1182fe48-809b-39ca-8d63-7192dba55a39",
                                "text": "Da Schweiß eine wichtige Rolle für die Wärmeabgabe spielt, können ausgedehnte Anhidrosen zu Thermoregulationsstörungen, im schlimmsten Fall zu einem Hitzschlag führen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
