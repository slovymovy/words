        "fr-extract.jsonl": [
            {
                "entry_id": "5c8ee018-8fdc-3e79-915e-2eaf061abaa0",
                "word": "immobilisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6a42d7d1-3be4-4762-99c6-c1a823341be6",
                        "entry_id": "5c8ee018-8fdc-3e79-915e-2eaf061abaa0",
                        "tags": [
                            "plural"
                        ],
                        "form": "immobilisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca452bda-0eb1-3d16-9bd4-ae511489b7f3",
                        "entry_id": "5c8ee018-8fdc-3e79-915e-2eaf061abaa0",
                        "glosses": [
                            "Action d’immobiliser ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2e5127c-0823-4a1c-8b11-81c1fb7759ca",
                                "sense_id": "ca452bda-0eb1-3d16-9bd4-ae511489b7f3",
                                "text": "L’immobilisation facilite la cicatrisation des plaies dans les parties molles et la guérison des fractures."
                            },
                            {
                                "example_id": "ad64d526-44be-44f1-9409-0710a561b75b",
                                "sense_id": "ca452bda-0eb1-3d16-9bd4-ae511489b7f3",
                                "text": "L’immobilisation d’un corps d’armée ennemi assura la victoire à ce général."
                            },
                            {
                                "example_id": "1464e232-4f31-4783-a2ee-09c77871d329",
                                "sense_id": "ca452bda-0eb1-3d16-9bd4-ae511489b7f3",
                                "text": "Immobilisation de rentes sur l’état."
                            }
                        ]
                    },
                    {
                        "sense_id": "db6b3e41-2f24-3c2d-9ff6-fb2d0ec66c4c",
                        "entry_id": "5c8ee018-8fdc-3e79-915e-2eaf061abaa0",
                        "glosses": [
                            "Actif d’utilisation durable pour une entité (entreprise, administration, association)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7883133d-9986-4ac6-b0ec-255e2e23ed6d",
                                "sense_id": "db6b3e41-2f24-3c2d-9ff6-fb2d0ec66c4c",
                                "text": "Les immobilisations corporelles représentent des emplois durables de fonds en actifs physiques dont l'entreprise est propriétaire (capacité industrielle ou commerciale disponible)."
                            }
                        ]
                    },
                    {
                        "sense_id": "da049e95-a732-3302-a542-8829ecc5bdfc",
                        "entry_id": "5c8ee018-8fdc-3e79-915e-2eaf061abaa0",
                        "glosses": [
                            "Situation d’équipements et matériels cas d’inactivité d’un chantier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b545c2-4d71-4702-91b5-4e586e2dbcc0",
                                "sense_id": "da049e95-a732-3302-a542-8829ecc5bdfc",
                                "text": "L’entreprise évoquait ainsi le coût des études, des immobilisations et le manque à gagner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a27b03e-170f-4b46-b3d3-7c445caefc3b",
                        "source_entry_id": "5c8ee018-8fdc-3e79-915e-2eaf061abaa0",
                        "target_lang_word": "Stillstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stillstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                        "entry_id": "9913e17d-7615-3bfe-90c5-4955e09f0210",
                                        "glosses": [
                                            "Ende einer Bewegung, eines Prozesses/Vorgangs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433cdc29-43da-4cb3-a4bc-107919c75c3c",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "Wegen der Schäden an den Anlagen kam es zu einem Stillstand der Produktion."
                                            },
                                            {
                                                "example_id": "1de5832f-5f64-4224-9d30-72c793204b19",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„Tatsächlich war der Zug schon nach wenigen hundert Metern wieder zum Stillstand gekommen, so daß die Frau ihr Buch hatte sinken lassen.“"
                                            },
                                            {
                                                "example_id": "1e8af26a-b6a9-46f1-99a8-3b197fca610a",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„In erster Linie hatte er dafür gesorgt, dass die starke Blutung aus dem Oberschenkel des Halbtoten zum Stillstand kam, und dann den gebrochenen rechten Unterarm stabilisiert.“"
                                            },
                                            {
                                                "example_id": "ed97b5cc-73e0-4eed-8c76-24e5f1c153d7",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„Dies schafft auf der einen Seite einen sehr engen gesellschaftlichen Zusammenhang innerhalb einer biraderi-Einheit. Es wirkt aber auf der anderen Seite auch häufig als Blockade und bedingt weitgehenden gesellschaftlichen Stillstand in den ländlichen Regionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55fc5806-14b8-4419-87f0-38179edfe562",
