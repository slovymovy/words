                "forms": [
                    {
                        "form_id": "5ef8b7da-89e5-4bc6-afc6-b44023e3497c",
                        "entry_id": "1cb38608-b956-3563-95b0-8eaa624e77ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "coccolithophores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8f7a8a4-1fb5-3d15-9bd1-d0df168ee44d",
                        "entry_id": "1cb38608-b956-3563-95b0-8eaa624e77ab",
                        "glosses": [
                            "Microalgue caractérisée par la présence de coccolithes, plaques calcaires protégeant son unique cellule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3b29710-5eb2-4a60-9350-365984c6b223",
                                "sense_id": "f8f7a8a4-1fb5-3d15-9bd1-d0df168ee44d",
                                "text": "Leur nom ne vous dira sans doute rien mais les coccolithophores intéressent particulièrement les scientifiques, préoccupés par le réchauffement climatique. Et pour cause, ces algues marines unicellulaires microscopiques aident les océans à jouer leur rôle de puits de carbone."
                            },
                            {
                                "example_id": "63ba9e9e-ba49-4e77-95c0-fe8d12385619",
                                "sense_id": "f8f7a8a4-1fb5-3d15-9bd1-d0df168ee44d",
                                "text": "Les coccolithophores sont des micro-algues dont la particularité est de former autour de leur unique cellule de minuscules plaques de calcaire, les coccolithes, dont les formes varient selon les espèces."
                            },
                            {
                                "example_id": "58503f8e-6053-42db-b98d-7d95c18d21dd",
                                "sense_id": "f8f7a8a4-1fb5-3d15-9bd1-d0df168ee44d",
                                "text": "Les coccolithes sont des plaques microscopiques de calcite CaCO₃ qui servent d’exosquelette d’algues marines unicellulaires : les coccolithophores."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c612223-ebb4-4391-b907-33d5750f5b5f",
                        "source_entry_id": "1cb38608-b956-3563-95b0-8eaa624e77ab",
                        "source_sense_id": "f8f7a8a4-1fb5-3d15-9bd1-d0df168ee44d",
                        "target_lang_word": "coccolithophore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coccolithophore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f1c3d82-5cb0-366d-bb66-530a07c9c540",
                                        "entry_id": "023e27c4-e8f5-37a1-a105-40320e551ec2",
                                        "glosses": [
                                            "Any of many minute mostly marine planktonic biflagellated organisms with brown chromatophores and complex calcareous, less commonly siliceous, shells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "355899de-141c-441a-a163-153fcdd9403b",
                                                "sense_id": "5f1c3d82-5cb0-366d-bb66-530a07c9c540",
                                                "text": "Chalk formations such as the white cliffs of Dover are largely composed of the bodies of countless billions of coccolithophores that bloomed, died and then sank to the seabed each season for millions of years."
                                            },
                                            {
                                                "example_id": "83da8be0-11c9-4b7e-b295-310b95842fe5",
                                                "sense_id": "5f1c3d82-5cb0-366d-bb66-530a07c9c540",
                                                "text": "It was filled with a kind of golden-brown planktonic algae known as coccolithophores, whose skeletons would form the chalks that underlie parts of Britain, Belgium and France today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
