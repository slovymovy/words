                        ],
                        "examples": [
                            {
                                "example_id": "a44b3080-6c22-4008-b662-926e13a6cc53",
                                "sense_id": "ca69da6f-1812-3fc5-9b64-f391a77cc8ea",
                                "text": "At the end of some three-score years since the earliest was founded, the various Zoophilite Societies in the Kingdom — Societies for Prevention of Cruelty, Anti-vivisection Societies, and Homes for Horses and for Lost Dogs — may possibly possess, including legacies and subscriptions, some forty thousand a-year between them all."
                            },
                            {
                                "example_id": "1ecd7361-bb60-43e2-b2cf-1e9d2c94c948",
                                "sense_id": "ca69da6f-1812-3fc5-9b64-f391a77cc8ea",
                                "text": "She is first and foremost a zoophilite and as such has no fear whatever of wild animals."
                            }
                        ]
                    }
