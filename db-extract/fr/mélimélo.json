                "translations": [
                    {
                        "translation_id": "289d68de-ae09-456b-907c-4885550f4fea",
                        "source_entry_id": "620e8221-a3b5-3caf-bdaf-1668576b5a71",
                        "source_sense_id": "b07e1e82-9954-341d-9880-9338a46d968f",
                        "source_sense_description": "ensemble de choses disparates",
                        "target_lang_word": "Mischmasch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mischmasch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75b886ab-b3c4-3158-a880-bb739062e235",
                                        "entry_id": "95a3b631-1196-36cb-898c-abcb1d062fc2",
                                        "glosses": [
                                            "Mischung aus vielen verschiedenen Dingen unterschiedlicher Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25553161-187f-4f08-8d70-b688a85632be",
                                                "sense_id": "75b886ab-b3c4-3158-a880-bb739062e235",
                                                "text": "„Diese ‚und ein Mischmasch anderen Unflats‘ seien zum Glück aus den Apotheken verschwunden.“"
                                            },
                                            {
                                                "example_id": "a2af907d-c840-48ac-a683-e5d1e0527196",
                                                "sense_id": "75b886ab-b3c4-3158-a880-bb739062e235",
                                                "text": "„Das großartigste Tier der Welt, das Schnabeltier, ist ein Mischmasch aus Teilen aller möglichen anderen Tiere.“"
                                            },
                                            {
                                                "example_id": "3c2cde05-1c2d-49d0-a0dd-e29c19d46eb1",
                                                "sense_id": "75b886ab-b3c4-3158-a880-bb739062e235",
                                                "text": "„Tolstois Philosophie ist ein Mischmasch aus alten Selbstverständlichkeiten und erstaunlich unvollkommenen eignen Einfällen.“"
                                            },
                                            {
                                                "example_id": "84a2fec1-c830-4a0f-83fb-4ce6bb9d7091",
                                                "sense_id": "75b886ab-b3c4-3158-a880-bb739062e235",
                                                "text": "„Kostas war es gewohnt, im Hafen ein Mischmasch aus vielen Sprachen aufzuschnappen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
