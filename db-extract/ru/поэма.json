                        "sense_id": "8f396bd3-0582-3163-8574-d69439d74db1",
                        "entry_id": "d9a59093-7d07-3bae-b957-6eb266ca6a0e",
                        "glosses": [
                            "повествовательное художественное произведение в стихах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12bdd11e-eab6-4b22-9363-0b01c03383ef",
                                "sense_id": "8f396bd3-0582-3163-8574-d69439d74db1",
                                "text": "Дело в том, что редактор заказал поэту для очередной книжки журнала большую антирелигиозную поэму."
                            }
                        ]
                    }
                ],
