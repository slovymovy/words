                },
                {
                    "sense_id": "bdd20141-ea79-3bf2-9ddc-c74c76505261",
                    "sense_definition": "Podniosły, poważny i świąteczny nastrój lub charakter czegoś.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Głęboka cisza panująca w katedrze podkreślała <w>uroczystość</w> tej chwili.",
                            "target_lang_translations": {
                                "ru": "Глубокая тишина, царившая в соборе, подчеркивала <w>торжественность</w> этого момента.",
                                "en": "The profound silence inside the cathedral accentuated the <w>solemnity</w> of that moment."
                            }
                        },
                        {
                            "text": "Jego poważne słowa nadały spotkaniu niespodziewaną <w>uroczystość</w>.",
                            "target_lang_translations": {
                                "ru": "Его серьезные слова придали встрече неожиданную <w>торжественность</w>.",
                                "en": "His serious words lent the meeting an unexpected <w>solemnity</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "podniosłość",
                        "patos"
                    ],
                    "common_phrases": [
