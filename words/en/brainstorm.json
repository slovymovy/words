                    "frequency": "High",
                    "semantic_group_id": "generate_ideas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team met this morning to <w>brainstorm</w> new advertising ideas."
                        },
                        {
                            "text": "Let us sit down together and <w>brainstorm</w> possible solutions to the budget shortfall."
                        }
                    ],
