                "senses": [
                    {
                        "sense_id": "b8c4e723-af86-348e-9ff7-864721f76d95",
                        "entry_id": "f98446db-9d9d-329f-9ea9-64ed860f7c7d",
                        "glosses": [
                            "Écrire ou se comporter comme Paul Éluard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "081acce7-eb5f-4cec-abee-82c9df848ce2",
                                "sense_id": "b8c4e723-af86-348e-9ff7-864721f76d95",
                                "text": "Exilé de lui-même, il était aussi rejeté par un milieu littéraire qui, pour parler à sa façon, n’en finissait pas d’aragoniser, d’éluardiser, de ségheriser..."
                            },
                            {
                                "example_id": "6b3393d1-3689-4832-8fa6-2b7501569941",
                                "sense_id": "b8c4e723-af86-348e-9ff7-864721f76d95",
                                "text": "Michel Manoll trouve au contraire que son ami a tort « d’aragoniser et d’éluardiser » de la sorte."
                            },
                            {
                                "example_id": "1d48afb1-c06a-426e-8106-4db9f697cc6d",
                                "sense_id": "b8c4e723-af86-348e-9ff7-864721f76d95",
                                "text": "Est-il prévu d'honorer d'autres auteurs ? Le cursus pourrait ainsi hugotiser, verlainiser, prévertiser, éluardiser, etc."
                            }
                        ]
                    }
