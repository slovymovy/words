                "senses": [
                    {
                        "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                        "entry_id": "8b8f6891-5157-3ecd-92f4-2f5594411c3d",
                        "glosses": [
                            "dauerhaft tagendes Gremium eines Parlaments/einer Partei/einer Organisation, das mit weitreichenden Befugnissen ausgestattet sein kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d391e4e-a9ad-4d7c-bc13-994da77d72c1",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "[30. März 1916:] „Der Hauptausschuss des Reichstages billigt einen von mehreren Fraktionen eingebrachten Antrag zur U-Boot-Frage.“"
                            },
                            {
                                "example_id": "c8ba63a2-96a3-4f54-9370-60fd90f4d234",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "[25. September 1916:] „Unter Vorsitz des Berliner Oberbürgermeisters Adolf Wermuth tagt in Berlin der Hauptausschuss des Deutschen Städtetages.“"
                            },
                            {
                                "example_id": "6f09ec81-172b-4bff-81bc-57fab9fc090d",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "[22. Januar 2017:] „Sozialdemokratische Fraktionsangehörige protestieren im Hauptausschuss des deutschen Reichstags gegen das Verbot der Parteizeitung \"Vorwärts\".“"
                            },
                            {
                                "example_id": "6eaa785d-3ce9-4e0c-9147-479af22db29e",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "[20. Dezember 1948:] „Der Hauptausschuss des Parlamentarischen Rates in Bonn beginnt mit der zweiten Lesung des Entwurfes eines Grundgesetzes für einen künftigen westdeutschen Staat.“"
                            },
                            {
                                "example_id": "6b1c8b27-daea-4edb-87a4-9f1053cb3ff1",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "„Am Abend soll der Hauptausschuss des Gemeinderats grünes Licht für das Verfahren für den Architekten-Wettbewerb geben.“"
                            },
                            {
                                "example_id": "715feea5-29dc-4408-b7f9-69b33f2698b2",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "„In einer Sondersitzung hat der Hauptausschuss des Kreises Pinneberg Mittwoch entschieden, dass sich eine Arbeitsgruppe dauerhaft mit dem möglichen Krankenhausneubau der Regio Kliniken beschäftigen soll.“"
                            },
                            {
                                "example_id": "0d325851-9763-4351-bde5-850589b411f9",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "„»Ich habe diesem Mann getraut«, sagte Mehdorn […] am Mittwoch im Hauptausschuss des Berliner Abgeordnetenhauses.“"
                            },
                            {
                                "example_id": "617373a7-26dd-4457-a725-32f1ad5f2cc7",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "„Die hessische Landesregierung bereitete die Bürgschaft für Opel am Montag mit einem Eilgesetz vor. […] Bürgschaften von mehr als 25 Millionen Euro muss der Hauptausschuss des Landtags im einzelnen zustimmen.“"
                            },
                            {
                                "example_id": "9fdf7fab-61d9-4b96-92cf-e3f99a9632f0",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "„Missstände in einem Schweriner Altenpflegeheim beschäftigen seit vergangener Woche die Verwaltung. Jetzt hat der zuständige Dezernent im Hauptausschuss vom Stand der Untersuchung berichtet.“"
                            },
                            {
                                "example_id": "4d0ce435-1561-4569-8374-05150a711f81",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "„Um die Funktionsfähigkeit des Parlaments sicherzustellen, stimmten die Abgeordneten aller im Bundestag vertretenen Fraktionen mit Ausnahme der Linken zunächst für die Einrichtung eines Hauptausschusses.“"
                            },
                            {
                                "example_id": "6b19ed94-b23d-4a47-bbc3-a3a93bb9dca9",
                                "sense_id": "36cc53a1-ca30-3a31-9b13-ac290beba75b",
                                "text": "„Über den Entwurf wurde gestern Abend im Hauptausschuss des Bundestags beraten, berichtete die dpa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
