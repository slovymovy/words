                    {
                        "translation_id": "7646d610-c1a5-4ee3-a76c-d1845b894390",
                        "source_entry_id": "40c15c0b-b7a8-383c-b4f9-ee9c88f9846a",
                        "source_sense_id": "9d86bc48-cab7-34b0-8990-d708eb0b765d",
                        "source_sense_description": "een afzonderlijk en volledig levend wezen dat voor zijn voortbestaan afhankelijk is van zijn eigen metabolisme en bestaat uit verschillende organen",
                        "target_lang_word": "Organismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Organismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e489b8c8-dab2-304d-a6f4-4bb5fbdfb5fe",
                                        "entry_id": "f82957ff-062b-32fc-9625-b279207dc31c",
                                        "glosses": [
                                            "individuelles Lebewesen, gesehen als Gesamtsystem aller seiner Organe"
                                        ],
                                        "tags": [
                                            "eher selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd2a8bb7-35e7-4094-bde7-a10fd2b8988d",
                                                "sense_id": "e489b8c8-dab2-304d-a6f4-4bb5fbdfb5fe",
                                                "text": "Um zu überleben, bedürfen die Organismen des Lichtes."
                                            },
                                            {
                                                "example_id": "97b927cf-8b6c-4bb2-b895-32e255da51d9",
                                                "sense_id": "e489b8c8-dab2-304d-a6f4-4bb5fbdfb5fe",
                                                "text": "„Durch ihre Mikroskope hatten die Forscher winzige Organismen im Körper als Verursacher von Krankheiten entdeckt.“"
                                            },
                                            {
                                                "example_id": "bcdf5a3b-1d8d-42fd-9f83-29ca125ba0d9",
                                                "sense_id": "e489b8c8-dab2-304d-a6f4-4bb5fbdfb5fe",
                                                "text": "Durch die Krankheit wird der gesamte Organismus geschwächt."
                                            },
                                            {
                                                "example_id": "f7960de1-aea0-46dc-b459-96fb82690724",
                                                "sense_id": "e489b8c8-dab2-304d-a6f4-4bb5fbdfb5fe",
                                                "text": "Auf die Infektion reagiert der Organismus mit Fieber."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c854bbf9-b2d6-3917-a1e9-f09f4ac2d72d",
                                        "entry_id": "f82957ff-062b-32fc-9625-b279207dc31c",
                                        "glosses": [
                                            "der Körper eines Lebewesens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16358b9f-175c-40bc-9723-aa379a147877",
                                                "sense_id": "c854bbf9-b2d6-3917-a1e9-f09f4ac2d72d",
                                                "text": "Durch die Krankheit wird der gesamte Organismus geschwächt."
                                            },
                                            {
                                                "example_id": "3a31aebc-c491-4f2f-95f1-50fdb463bf1c",
                                                "sense_id": "c854bbf9-b2d6-3917-a1e9-f09f4ac2d72d",
                                                "text": "Auf die Infektion reagiert der Organismus mit Fieber."
                                            },
                                            {
                                                "example_id": "3a9b966b-190c-4226-8946-394bec7c1587",
                                                "sense_id": "c854bbf9-b2d6-3917-a1e9-f09f4ac2d72d",
                                                "text": "„Hoffmanns Gesundheitszustand ist schlecht, sein Organismus so angegriffen, daß er die Notwendigkeit fühlt, eine Erholungsreise in die Schlesischen Berge zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5470ce31-0883-3782-bfde-a3a47334578d",
                                        "entry_id": "f82957ff-062b-32fc-9625-b279207dc31c",
                                        "glosses": [
                                            "System aus einzelnen Teilen, bei dem jeder Teil eine bestimmte Funktion erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ff19f08-e9a2-457d-9f75-a86ad0ee96eb",
                                                "sense_id": "5470ce31-0883-3782-bfde-a3a47334578d",
                                                "text": "„Organismen sind Ganzheiten, in denen die Funktion der einzelnen Teile nur in Hinblick auf das Ganze verstanden werden kann und umgekehrt das Ganze nur durch das Zusammenwirken der Teile entsteht. Erst damit hört ein Organismus auf, ein bloßes Aggregat zu sein.“"
                                            },
                                            {
                                                "example_id": "2f68f50d-d554-48ef-a135-40fea30a0993",
                                                "sense_id": "5470ce31-0883-3782-bfde-a3a47334578d",
                                                "text": "Landwirtschaft als Organismus ist mehr als ein Produktionssystem."
                                            },
                                            {
                                                "example_id": "64205b87-f78d-4197-b51a-0e63fdfdb4b3",
                                                "sense_id": "5470ce31-0883-3782-bfde-a3a47334578d",
                                                "text": "Ich sehe die Stadt als einen pulsierenden Organismus, der niemals schläft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "085c4e13-89ea-4dfd-9c88-efb48215318a",
                        "source_entry_id": "40c15c0b-b7a8-383c-b4f9-ee9c88f9846a",
                        "source_sense_id": "9d86bc48-cab7-34b0-8990-d708eb0b765d",
                        "source_sense_description": "een afzonderlijk en volledig levend wezen dat voor zijn voortbestaan afhankelijk is van zijn eigen metabolisme en bestaat uit verschillende organen",
                        "target_lang_word": "organism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3662dae6-39be-3eca-9e9e-fe6323e7dd5b",
                                        "entry_id": "2ed47ab0-b0ec-39ae-bc32-df630c369e83",
                                        "glosses": [
                                            "A discrete and complete living thing, such as animal, plant, fungus or microorganism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f219d364-d281-4006-afd3-130e4ef84eab",
                                                "sense_id": "3662dae6-39be-3eca-9e9e-fe6323e7dd5b",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            },
                                            {
                                                "example_id": "a2293c42-6f71-429f-a4df-d5bd6f0845a4",
                                                "sense_id": "3662dae6-39be-3eca-9e9e-fe6323e7dd5b",
                                                "text": "This strategy, known as caloric restriction, has been shown to increase the life span of various organisms and reduce their rate of cancer and other age-related ailments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02171ed7-1191-3f96-b83d-abcdd6474516",
                                        "entry_id": "2ed47ab0-b0ec-39ae-bc32-df630c369e83",
                                        "glosses": [
                                            "Something with many separate interdependent parts, seen as being like a living thing; an organic system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75ec495-902d-4690-96b6-b68ff8b8b75f",
                                                "sense_id": "02171ed7-1191-3f96-b83d-abcdd6474516",
                                                "text": "For the first time, Edith was aware of the hotel as a well populated organism, its attendants merely resting until an appropriate occasion should summon them to present themselves […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6def5a-c951-3f02-b86d-fbc45ab88d5e",
                                        "entry_id": "2ed47ab0-b0ec-39ae-bc32-df630c369e83",
                                        "glosses": [
                                            "The fact of being organic; organicity."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0182f2e9-5b9d-4b3b-b7bf-55b45bd8aa93",
                        "source_entry_id": "40c15c0b-b7a8-383c-b4f9-ee9c88f9846a",
                        "source_sense_id": "9d86bc48-cab7-34b0-8990-d708eb0b765d",
                        "source_sense_description": "een afzonderlijk en volledig levend wezen dat voor zijn voortbestaan afhankelijk is van zijn eigen metabolisme en bestaat uit verschillende organen",
                        "target_lang_word": "organisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68224159-40bc-3155-b98c-badb4d5299e4",
                                        "entry_id": "fc36534d-e1db-3d06-8899-f1e37eaf9cac",
                                        "glosses": [
                                            "Être vivant individuel, unicellulaire ou pluricellulaire, possédant une organisation interne autonome lui permettant d'accomplir ses fonctions vitales."
                                        ],
                                        "tags": [
                                            "Sciences de la vie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4bdadfc-ac4e-44f6-ba6b-346844fafbd2",
                                                "sense_id": "68224159-40bc-3155-b98c-badb4d5299e4",
                                                "text": "Les anciens avaient justement montré le rôle de l’organisme vivant comme cause génératrice des maladies, les éléments extérieurs en étant les causes provocatrices."
                                            },
                                            {
                                                "example_id": "095faee5-4d88-4e7b-ae49-9f8cb532b9ea",
                                                "sense_id": "68224159-40bc-3155-b98c-badb4d5299e4",
                                                "text": "Les phytosanitaires, quant à eux, n'exercent pas seulement leur action toxique sur les espèces ciblées, mais également sur les autres organismes vivants. Le révélateur du problème fut vraisemblablement le cas du DDT, […]."
                                            },
                                            {
                                                "example_id": "5e16a85e-c1a8-43dd-a4d9-e10ef4010a18",
                                                "sense_id": "68224159-40bc-3155-b98c-badb4d5299e4",
                                                "text": "Inspirée par le fonctionnement des cellules nerveuses des organismes vivants, la logique neuromorphique propose une alternative à la logique booléenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e6c538d-d144-3e5d-8bb7-8f5c3fc681fd",
                                        "entry_id": "fc36534d-e1db-3d06-8899-f1e37eaf9cac",
                                        "glosses": [
                                            "Ensemble d'organes ou de systèmes assurant les fonctions vitales d’un être vivant complexe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52ef29d6-2309-456d-bbdb-0051783c91ef",
                                                "sense_id": "1e6c538d-d144-3e5d-8bb7-8f5c3fc681fd",
                                                "text": "Dans le monde actuel se trouvent l’amphioxus, l’animal vertébré dont l’organisme est le plus imparfait, et les lamproies, qui occupent le dernier rang parmi les poissons."
                                            },
                                            {
                                                "example_id": "eec3b95c-b5ca-4322-804c-03ad25b77052",
                                                "sense_id": "1e6c538d-d144-3e5d-8bb7-8f5c3fc681fd",
                                                "text": "L’alimentation a pour but de faire pénétrer dans l’organisme animal les matériaux nécessaires à la nutrition."
                                            },
                                            {
                                                "example_id": "3f0d1827-98d1-4b5d-b514-f417eb3ca383",
                                                "sense_id": "1e6c538d-d144-3e5d-8bb7-8f5c3fc681fd",
                                                "text": "Cela calait l'estomac aux petites heures du matin et la vigueur des currys absorbés contribuait agréablement à remettre d'aplomb un individu dont les gins tonics de la veille avaient compromis l'équilibre d'un organisme fatigué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7f7375a-56e4-3ff2-99a8-7ba171bd4ca9",
                                        "entry_id": "fc36534d-e1db-3d06-8899-f1e37eaf9cac",
                                        "glosses": [
                                            "Organisation structurée regroupant des personnes et des ressources, poursuivant un but commun, qu'il soit social, économique, administratif, politique ou culturel."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff1cb360-76d2-4734-8b5f-6cd0d85d3c27",
                                                "sense_id": "b7f7375a-56e4-3ff2-99a8-7ba171bd4ca9",
                                                "text": "La corporation étant un organisme chrétien, les juifs en étaient ipso facto écartés ; l’exercice des professions étant interdit en dehors des corporations légalement reconnues, ils furent contraints, à leur corps défendant, de renoncer au travail manuel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
