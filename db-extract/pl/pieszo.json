                                                "sense_id": "b6f6edfc-7feb-3e15-8fb6-e222f135250c",
                                                "text": "當公司要我走路"
                                            },
                                            {
                                                "example_id": "8bcf9a17-00dd-4df3-b575-40621c467d74",
                                                "sense_id": "b6f6edfc-7feb-3e15-8fb6-e222f135250c",
                                                "text": "当公司要我走路"
                                            },
                                            {
                                                "example_id": "2cb0d6cc-6c99-479b-b561-7e1b227fcb8c",
                                                "sense_id": "b6f6edfc-7feb-3e15-8fb6-e222f135250c",
                                                "text": "再不好好做，就叫你走路。"
