                "senses": [
                    {
                        "sense_id": "03417312-8e08-3661-b1e7-d29aaf85d1b3",
                        "entry_id": "9b4f655f-146a-3282-bc46-61358ea2167a",
                        "glosses": [
                            "de verplichting om ervoor te zorgen dat iets goed verloopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "715cfca0-43f4-4cd1-93a9-6be604c6836e",
                                "sense_id": "03417312-8e08-3661-b1e7-d29aaf85d1b3",
                                "text": "Hij kan de verantwoordelijkheid zeker niet aan."
                            },
                            {
                                "example_id": "48d29139-be2a-4612-8818-8e361a35493a",
                                "sense_id": "03417312-8e08-3661-b1e7-d29aaf85d1b3",
                                "text": ",,We hechten als CDA zeker aan de christelijke tradities’’, zei fractieleider Dirk Getkate de voorbije week in de raad. ,,Maar voor ons is gespreide verantwoordelijkheid die ook bij partners uit de samenleving ligt, van belang. Daarom gaan wij mee in maatschappelijke initiatieven. Wij ondersteunen wel van harte de bestaande vrijheid om als ondernemer of inwoner hieraan niet mee te doen.’’"
                            },
                            {
                                "example_id": "f20d06a3-4da6-4390-8c1a-ac01e4537ed5",
                                "sense_id": "03417312-8e08-3661-b1e7-d29aaf85d1b3",
                                "text": "Als ik bijvoorbeeld met mijn gezin op vakantie was of met een groep vrienden een weekendje weg ging, waren de verantwoordelijkheden gedeeld."
                            },
                            {
                                "example_id": "12f58484-1061-49c9-b6e7-bb725c0a9a68",
                                "sense_id": "03417312-8e08-3661-b1e7-d29aaf85d1b3",
                                "text": "Maar nu zou een deel van de verantwoordelijkheid voor de familie op mijn schouders komen te rusten, ging ze iets ernstiger verder..... Kon ik die verantwoordelijkheid op me nemen? Ik kon er maar één antwoord op geven en mama had ook niets anders verwacht en ik had toch net besloten dat ik aardiger zou worden voor Acke."
                            }
                        ]
                    },
                    {
                        "sense_id": "68e76c9f-0196-333a-89a1-6c5c3a43642c",
                        "entry_id": "9b4f655f-146a-3282-bc46-61358ea2167a",
                        "glosses": [
                            "een taak die zware plichten met zich meebrengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09225c8a-b9ea-4ba0-9572-0a06bf03306a",
                                "sense_id": "68e76c9f-0196-333a-89a1-6c5c3a43642c",
                                "text": "Dat is wel een hele verantwoordelijkheid, hoor!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
