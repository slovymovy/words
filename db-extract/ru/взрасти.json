                "senses": [
                    {
                        "sense_id": "aa470682-6ef9-3990-a84d-9e524d473296",
                        "entry_id": "7598c2b8-f8d2-34ac-9c34-a42ae7ce1b36",
                        "glosses": [
                            "вырасти (о человеке, животном, растении)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e8534b-56c1-4c8d-98de-b29de5a0f123",
                                "sense_id": "aa470682-6ef9-3990-a84d-9e524d473296",
                                "text": "Но когда взрос он и мог бы свалить любого из них, он как-то не обнаружил своих обидчиков среди всей оравы, ― а хотелось именно тех найти, кого он запомнил."
                            }
                        ]
                    },
                    {
                        "sense_id": "89541395-db6c-3326-8dbe-8ceeeea78db2",
                        "entry_id": "7598c2b8-f8d2-34ac-9c34-a42ae7ce1b36",
                        "glosses": [
                            "достигнуть зрелого возраста, стать взрослым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc77c50-3b9f-46b3-ab1f-6d5dd352b415",
                                "sense_id": "89541395-db6c-3326-8dbe-8ceeeea78db2",
                                "text": "Дарья моя тут хлеб свой первый добыла, тут взросла, тут и состарится."
                            }
                        ]
                    },
                    {
                        "sense_id": "b41d6eca-c07c-364d-a741-3b32016558c2",
                        "entry_id": "7598c2b8-f8d2-34ac-9c34-a42ae7ce1b36",
                        "glosses": [
                            "перен. достигнуть мастерства, более высокого уровня развития"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8a5711ab-583d-36d2-8aa1-c1b44878f6d4",
                        "entry_id": "7598c2b8-f8d2-34ac-9c34-a42ae7ce1b36",
                        "glosses": [
                            "перен. развиться, увеличиться в размерах, в количестве, в объёме, в силе, в мощи }"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b02b1b24-8f99-4679-9fab-7a72c25ca18d",
                                "sense_id": "8a5711ab-583d-36d2-8aa1-c1b44878f6d4",
                                "text": "Неужели мы позволим увлечь в грозящий разверзнутый ад ― в какой бы форме он ни возник ― самое ценное, что родилось и взросло на планете Земля?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03214590-f488-4110-bf5e-9a78d2386b4c",
                        "source_entry_id": "7598c2b8-f8d2-34ac-9c34-a42ae7ce1b36",
                        "source_sense_description": "вырасти",
                        "target_lang_word": "grow up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grow up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ca865a4-684e-3fc3-b6f9-bb099b7a757d",
                                        "entry_id": "68cdc230-c2f5-3444-9289-3aa2e5d00dc6",
                                        "glosses": [
                                            "To mature and become an adult."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a599449-5536-47cf-87f5-845092aa07b7",
                                                "sense_id": "8ca865a4-684e-3fc3-b6f9-bb099b7a757d",
                                                "text": "What do you want to be when you grow up?"
                                            },
                                            {
                                                "example_id": "fd445ac6-e1aa-4b64-a101-53ca4cbe7328",
                                                "sense_id": "8ca865a4-684e-3fc3-b6f9-bb099b7a757d",
                                                "text": "Attila grew up a nomad on the plains of Hungary"
                                            },
                                            {
                                                "example_id": "e355be0c-20b8-4fe0-a65c-477236812e5f",
                                                "sense_id": "8ca865a4-684e-3fc3-b6f9-bb099b7a757d",
                                                "text": "I'm in the place where I grew up, where my alma mater is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73734170-60ed-3e14-b328-50a52b245566",
                                        "entry_id": "68cdc230-c2f5-3444-9289-3aa2e5d00dc6",
                                        "glosses": [
                                            "To start to develop; to flourish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d74ff69-5bd4-48c7-b090-89a7c222d35f",
                                                "sense_id": "73734170-60ed-3e14-b328-50a52b245566",
                                                "text": "Socialism grew up in the industrial cities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fb0627a-faec-336d-8a61-05cd09d70f29",
                                        "entry_id": "68cdc230-c2f5-3444-9289-3aa2e5d00dc6",
                                        "glosses": [
                                            "To stop acting as or like a child (often used as an imperative interjection)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a3ae54f-1316-4d46-ac0d-621ce6ed761e",
                                                "sense_id": "0fb0627a-faec-336d-8a61-05cd09d70f29",
                                                "text": "Will you grow up please, and stop making silly faces?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grow up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ca299e4-6dcf-3758-821e-ef17bfc4fbf8",
                                        "entry_id": "b604535f-efd1-369e-bf11-7937692e225d",
                                        "glosses": [
                                            "Used to criticize childish behavior, especially that considered unreasonable for one's age."
                                        ],
                                        "tags": [
                                            "imperative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e930a5cc-24a3-4ffd-bf2d-cd78e7f8c27e",
                                                "sense_id": "5ca299e4-6dcf-3758-821e-ef17bfc4fbf8",
                                                "text": "You're giggling because I said \"butt\"? Grow up, seriously."
                                            },
                                            {
                                                "example_id": "70457b83-bece-45ae-a8f3-b85f6393a1c9",
                                                "sense_id": "5ca299e4-6dcf-3758-821e-ef17bfc4fbf8",
                                                "text": "Grow up! The Bible is nothing more than a astrotheological allegory for things like the Sun!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "582f4f52-af6e-4e4a-a6f5-2436a72d9f06",
                        "source_entry_id": "7598c2b8-f8d2-34ac-9c34-a42ae7ce1b36",
                        "source_sense_description": "развиться, увеличиться в размерах, в количестве, в объёме, в силе, в мощи",
                        "target_lang_word": "grow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c70822e9-4775-3f84-afda-a7a339fdfab4",
                                        "entry_id": "91e0a423-a1e5-3c79-93dc-fd47f3c5874b",
                                        "glosses": [
                                            "To become larger, to increase in magnitude."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fb73fad-bae1-4ee3-ad07-060415a3b840",
                                                "sense_id": "c70822e9-4775-3f84-afda-a7a339fdfab4",
                                                "text": "Children grow quickly."
                                            },
                                            {
                                                "example_id": "95888096-00ad-40c2-a850-9fa13f4c8cd3",
                                                "sense_id": "c70822e9-4775-3f84-afda-a7a339fdfab4",
                                                "text": "[...] but the dangers to trespassers, especially children, are growing, and a vigorous educational programme is urged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eeb487d-d306-3904-8fa0-8bc993ff1fdc",
                                        "entry_id": "91e0a423-a1e5-3c79-93dc-fd47f3c5874b",
                                        "glosses": [
                                            "To undergo growth; to be present (somewhere)"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00e0fcec-9f1d-40a0-a04f-ef49af1efa72",
                                                "sense_id": "4eeb487d-d306-3904-8fa0-8bc993ff1fdc",
                                                "text": "Apples now grow all over the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6417b116-de45-330f-a0e2-ca8b07d3c934",
                                        "entry_id": "91e0a423-a1e5-3c79-93dc-fd47f3c5874b",
                                        "glosses": [
                                            "To appear or sprout."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d3d1762-f0d7-4bd0-93e5-f4594694e8a2",
                                                "sense_id": "6417b116-de45-330f-a0e2-ca8b07d3c934",
                                                "text": "Leaf buds grew on the trees with the advance of spring."
                                            },
                                            {
                                                "example_id": "29e8a291-f5de-498c-a2ed-a4f60a11bcd0",
                                                "sense_id": "6417b116-de45-330f-a0e2-ca8b07d3c934",
                                                "text": "A long tail began to grow from his backside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa7a7e66-7ca2-3653-81e9-f9253f4cb451",
                                        "entry_id": "91e0a423-a1e5-3c79-93dc-fd47f3c5874b",
                                        "glosses": [
                                            "To develop, to mature."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c012f36c-6633-4f13-a817-c0ed86051ada",
                                                "sense_id": "aa7a7e66-7ca2-3653-81e9-f9253f4cb451",
                                                "text": "As I grew throughout adolescence, I came to appreciate many things about human nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07dfb2cc-8532-34ad-9f50-628ef82ace12",
                                        "entry_id": "91e0a423-a1e5-3c79-93dc-fd47f3c5874b",
                                        "glosses": [
                                            "To cause or allow something to become bigger, especially to cultivate plants."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a037264c-a5fa-46fe-8bf5-89a32626ecc0",
                                                "sense_id": "07dfb2cc-8532-34ad-9f50-628ef82ace12",
                                                "text": "He grows peppers and squash each summer in his garden."
                                            },
                                            {
                                                "example_id": "4ddaf380-d2bd-4d08-af59-886bbf35cec6",
                                                "sense_id": "07dfb2cc-8532-34ad-9f50-628ef82ace12",
                                                "text": "Have you ever grown your hair before?"
                                            },
                                            {
                                                "example_id": "60971cc9-2924-4471-9829-4e8d75f913f8",
                                                "sense_id": "07dfb2cc-8532-34ad-9f50-628ef82ace12",
                                                "text": "The Bush administration – which sought to grow the number of fisheries managed under a program known as “catch shares”..."
                                            },
                                            {
                                                "example_id": "49a4db5f-dd84-4d73-ad26-2cd2bbd1f6d7",
                                                "sense_id": "07dfb2cc-8532-34ad-9f50-628ef82ace12",
                                                "text": "And — again to overgeneralize from my experience — users may not want a second Twitter either. I was a heavy Twitter user for over a decade. I loved it until I didn’t. I made connections, grew a following, floated ideas, had fun. But it also became a second, often angry, voice inside my head. Do I want to replace it with another one?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "447d18b8-4fc9-34dc-bb8c-9eb38dd1d5ca",
                                        "entry_id": "91e0a423-a1e5-3c79-93dc-fd47f3c5874b",
                                        "glosses": [
                                            "To assume a condition or quality over time."
                                        ],
                                        "tags": [
                                            "copulative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7580bfba-b48c-4f75-bf0f-71110bcbf0f5",
                                                "sense_id": "447d18b8-4fc9-34dc-bb8c-9eb38dd1d5ca",
                                                "text": "The boy grew wise as he matured."
                                            },
                                            {
                                                "example_id": "fb486991-82a7-4113-9129-b840c08850c6",
                                                "sense_id": "447d18b8-4fc9-34dc-bb8c-9eb38dd1d5ca",
                                                "text": "My cares grew less (and less) until they evanesced completely."
                                            },
                                            {
                                                "example_id": "88d1e0d0-acbf-4480-8320-7cafcd293cb5",
                                                "sense_id": "447d18b8-4fc9-34dc-bb8c-9eb38dd1d5ca",
                                                "text": "You have grown strong."
                                            },
                                            {
                                                "example_id": "dce52ee9-9f83-45be-b71c-6f302deba7c0",
                                                "sense_id": "447d18b8-4fc9-34dc-bb8c-9eb38dd1d5ca",
                                                "text": "In fact she was so bus doing all the things that anyone might, who finds themselves alone in an empty house, that she did not notice at first when it began to turn dusk and the rooms to grow dim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56da8f43-a83e-3aad-926e-846fc3f767cf",
                                        "entry_id": "91e0a423-a1e5-3c79-93dc-fd47f3c5874b",
                                        "glosses": [
                                            "To become attached or fixed; to adhere."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "818eb95c-f38d-4995-b18c-6ff05f036114",
                                                "sense_id": "56da8f43-a83e-3aad-926e-846fc3f767cf",
                                                "text": "Our knees shall kneel till to the ground they grow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95b56f4d-467c-4614-9d5a-8c1f77f794c7",
                        "source_entry_id": "7598c2b8-f8d2-34ac-9c34-a42ae7ce1b36",
                        "source_sense_description": "развиться, увеличиться в размерах, в количестве, в объёме, в силе, в мощи",
                        "target_lang_word": "increase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "increase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d1ef8ce-4dec-3f29-9b36-ee256c7fbfa2",
                                        "entry_id": "884736d2-4773-3b81-9855-ca5d205616a3",
                                        "glosses": [
                                            "(of a quantity, etc.) To become larger or greater, to greaten."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7802839-da43-4db3-9d8c-70ffd0945ee6",
                                                "sense_id": "3d1ef8ce-4dec-3f29-9b36-ee256c7fbfa2",
                                                "text": "The waters increased and bare up the ark."
                                            },
                                            {
                                                "example_id": "7fd8a993-2018-4e7d-ba96-6e036f787e3e",
                                                "sense_id": "3d1ef8ce-4dec-3f29-9b36-ee256c7fbfa2",
                                                "text": "His rage only increased when I told him of the lost money."
                                            },
                                            {
                                                "example_id": "15fa1e68-f13a-416c-81e1-10f2d89ca725",
                                                "sense_id": "3d1ef8ce-4dec-3f29-9b36-ee256c7fbfa2",
                                                "text": "The heavens forbid / But that our loves and comforts should increase, / Even as our days do grow!"
                                            },
                                            {
                                                "example_id": "e708e9cf-7d38-43bc-9e4a-f66f48b3a1ca",
                                                "sense_id": "3d1ef8ce-4dec-3f29-9b36-ee256c7fbfa2",
                                                "text": "I have reckoned upon a Medium, that a Child juſt born vvill vveigh 12 pounds, and in a ſolar Year if tollerably nurſed encreaſeth to 28 Pound."
                                            },
                                            {
                                                "example_id": "6a1d4da9-4b4d-4e46-8d25-0fcd50fb7b3b",
                                                "sense_id": "3d1ef8ce-4dec-3f29-9b36-ee256c7fbfa2",
                                                "text": "This contribution reduces with increasing distance p from the emitting surface element dA, due to conservation of energy, as the wave energy distributed across the spherical wave front remains constant, while the radius increases during ..."
                                            },
                                            {
                                                "example_id": "b0bfe240-4384-4263-a37c-5746f4d1a707",
                                                "sense_id": "3d1ef8ce-4dec-3f29-9b36-ee256c7fbfa2",
                                                "text": "The report said that deep learning methods increased from just 118 patent requests in 2013 to nearly 2,400 in 2016."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "270e1a86-b894-396f-8f56-bf7b02d19b9f",
                                        "entry_id": "884736d2-4773-3b81-9855-ca5d205616a3",
                                        "glosses": [
                                            "To make (a quantity, etc.) larger."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d58a8ec7-0ae8-425b-8ac5-8b5ff285153c",
                                                "sense_id": "270e1a86-b894-396f-8f56-bf7b02d19b9f",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a941e13-1339-325d-95b7-b093ecab077c",
                                        "entry_id": "884736d2-4773-3b81-9855-ca5d205616a3",
                                        "glosses": [
                                            "To multiply by the production of young; to be fertile, fruitful, or prolific."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b4c1f2-3443-4214-926c-cc26f2a15318",
                                                "sense_id": "2a941e13-1339-325d-95b7-b093ecab077c",
                                                "text": "Fishes are infinitely more numerous of increasing than Beasts or Birds, as appears by the numerous Spawn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4af7041e-dd0f-3d19-b330-e3d9274e4fa2",
                                        "entry_id": "884736d2-4773-3b81-9855-ca5d205616a3",
                                        "glosses": [
                                            "To become more nearly full; to show more of the surface; to wax."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b7d169-55f2-42dd-b0d3-4e318aabc838",
                                                "sense_id": "4af7041e-dd0f-3d19-b330-e3d9274e4fa2",
                                                "text": "The Moon increases."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "increase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
