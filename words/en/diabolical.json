{
    "word_family": [
        "diabolism",
        "diabolist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "76369986-40e2-3ac2-b1bf-55a5d5f539e9",
                    "sense_definition": "Extremely wicked or cruel.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "evil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain hatched a <w>diabolical</w> plan to destroy the city.",
                            "target_lang_translations": {
                                "ru": "Злодей разработал <w>дьявольский</w> план по уничтожению города."
                            }
                        },
                        {
                            "text": "He was accused of <w>diabolical</w> cruelty toward his prisoners.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в <w>зверской</w> жестокости по отношению к заключенным."
                            }
                        }
                    ],
                    "synonyms": [
                        "wicked",
                        "cruel",
                        "evil",
                        "fiendish"
                    ],
                    "antonyms": [
                        "kind",
                        "benevolent"
                    ],
                    "common_phrases": [
                        "diabolical plan",
                        "diabolical cruelty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне злой, жестокий или безжалостный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зверский",
                                "target_lang_sense_clarification": "очень жестокий, безжалостный"
                            },
                            {
                                "target_lang_word": "адский",
                                "target_lang_sense_clarification": "крайне злой, мучительный"
                            },
                            {
                                "target_lang_word": "дьявольский",
                                "target_lang_sense_clarification": "исполненный злобы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a002540c-13fb-3d38-ab52-d2c081e93dc8",
                    "sense_definition": "Extremely cunning or devious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective was impressed by the <w>diabolical</w> cleverness of the thief.",
                            "target_lang_translations": {
                                "ru": "Детектив был впечатлен <w>дьявольской</w> хитростью вора."
                            }
                        },
                        {
                            "text": "She used a <w>diabolical</w> trick to win the game.",
                            "target_lang_translations": {
                                "ru": "Она использовала <w>коварный</w> трюк, чтобы выиграть игру."
                            }
                        }
                    ],
                    "synonyms": [
                        "cunning",
                        "devious",
                        "sly"
                    ],
                    "common_phrases": [
                        "diabolical cleverness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно хитрый, коварный или изворотливый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дьявольский",
                                "target_lang_sense_clarification": "исполненный хитрости и тёмных замыслов"
                            },
                            {
                                "target_lang_word": "коварный",
                                "target_lang_sense_clarification": "хитрый и опасный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ef2bf04-d32e-3565-8f9f-e157c89ab427",
                    "sense_definition": "Relating to or characteristic of the devil.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "evil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient legends spoke of <w>diabolical</w> forces haunting the dark forest.",
                            "target_lang_translations": {
                                "ru": "Древние легенды рассказывали о <w>дьявольских</w> силах, обитающих в темном лесу."
                            }
                        },
                        {
                            "text": "Many cultures have myths about <w>diabolical</w> spirits.",
                            "target_lang_translations": {
                                "ru": "Во многих культурах есть мифы о <w>дьявольских</w> духах."
                            }
                        }
                    ],
                    "synonyms": [
                        "devilish",
                        "satanic",
                        "demonic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к дьяволу или характерный для него."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дьявольский",
                                "target_lang_sense_clarification": "связанный с дьяволом"
                            },
                            {
                                "target_lang_word": "сатанинский",
                                "target_lang_sense_clarification": "относящийся к сатане"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b8d7042-5f5d-3aeb-a1fc-eb0d70964e28",
                    "sense_definition": "Extremely difficult, unpleasant, or chaotic.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team faced <w>diabolical</w> weather conditions during their mountain climb.",
                            "target_lang_translations": {
                                "ru": "Во время восхождения на гору команда столкнулась с <w>адскими</w> погодными условиями."
                            }
                        },
                        {
                            "text": "The traffic this morning was absolutely <w>diabolical</w>.",
                            "target_lang_translations": {
                                "ru": "Движение сегодня утром было просто <w>ужасным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dreadful",
                        "terrible",
                        "awful"
                    ],
                    "common_phrases": [
                        "diabolical weather"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in British English to describe something very bad."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно трудный, неприятный или хаотичный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адский",
                                "target_lang_sense_clarification": "очень трудный, невыносимый"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "очень плохой, неприятный"
                            },
                            {
                                "target_lang_word": "дьявольский",
                                "target_lang_sense_clarification": "разг. очень трудный, тягостный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}