                                "target_senses": [
                                    {
                                        "sense_id": "d815b076-75e1-32d3-8d77-fa9db0581020",
                                        "entry_id": "2f5c4f02-f805-351e-a620-a4bdc3d0ac73",
                                        "glosses": [
                                            "Region (ehemalige Provinz) in Frankreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8ef037d-1e05-48c1-a58d-5f222f81b446",
                                                "sense_id": "d815b076-75e1-32d3-8d77-fa9db0581020",
                                                "text": "Ich war schon dreimal im Urlaub in der Normandie."
                                            },
                                            {
                                                "example_id": "e20b3ee5-1f0c-4133-9daa-754177561fb2",
                                                "sense_id": "d815b076-75e1-32d3-8d77-fa9db0581020",
                                                "text": "„Gans’ Einheit hilft den alliierten Truppen bei der Invasion in der Normandie 1944 mit geheimdienstlichen Methoden.“"
                                            },
                                            {
                                                "example_id": "3ecc62a1-d1ab-4ee0-a290-5f70134850e9",
                                                "sense_id": "d815b076-75e1-32d3-8d77-fa9db0581020",
                                                "text": "„Die Hecken und Obstbaumgärten der Normandie flogen vorüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
