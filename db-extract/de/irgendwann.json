                                        "entry_id": "f406351d-6bf9-317f-bb76-9a7a76fa3e37",
                                        "glosses": [
                                            "At some unspecified time in the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "989adada-34d9-42b9-a124-9faee9581baf",
                                                "sense_id": "ab3daf22-daec-361e-bd84-4719a00bd29e",
                                                "text": "One day I shall upgrade my software, but not just yet."
                                            },
                                            {
                                                "example_id": "e2a590c5-7045-492f-9755-5ee8e552b4a8",
                                                "sense_id": "ab3daf22-daec-361e-bd84-4719a00bd29e",
                                                "text": "This was a voluntary charter flight, not an ICE enforcement operation. All participants were offered the same benefits as any illegal alien who self-deports using the CBP Home App. They received travel assistance, a $1,000 stipend, and preserved the possibility they could one day return to the United States legally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b519f177-291c-3af9-aa42-e830ba8cf2e0",
                                        "entry_id": "f406351d-6bf9-317f-bb76-9a7a76fa3e37",
                                        "glosses": [
                                            "At some unspecified time in the past."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51adfe4e-e86f-4c44-9c59-bfcaa8c44a04",
                                                "sense_id": "b519f177-291c-3af9-aa42-e830ba8cf2e0",
                                                "text": "One day I was playing with a girl from my class."
                                            },
                                            {
                                                "example_id": "1d3a928c-8b1a-49ec-a3ad-9a77e972df06",
                                                "sense_id": "b519f177-291c-3af9-aa42-e830ba8cf2e0",
                                                "text": "One day I was out in the barn and he drifted in. I was currying the horse and he set down on the wheelbarrow and begun to ask questions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c54a4fb-583d-3a4e-b253-b30e426285c8",
                                        "entry_id": "f406351d-6bf9-317f-bb76-9a7a76fa3e37",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see one, day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b83bd2-5a0e-4b60-a58e-38666d0be449",
                                                "sense_id": "8c54a4fb-583d-3a4e-b253-b30e426285c8",
                                                "text": "You can stay one day or two."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b64b7c9-3ff8-4eb2-90c4-ca631a609d61",
