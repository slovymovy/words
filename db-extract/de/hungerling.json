                "senses": [
                    {
                        "sense_id": "f1f1e8bb-4bc2-3809-a2c5-d1d2f9091c50",
                        "entry_id": "df517799-31f4-3bab-aca6-7c10d215e686",
                        "glosses": [
                            "Rebenart mit roten Trauben, die früh reif werden und viel, aber schlechten Wein ergeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae44653-c75f-4d2d-84b3-ff26ad567eaf",
                                "sense_id": "f1f1e8bb-4bc2-3809-a2c5-d1d2f9091c50",
                                "text": "„Es gibt nämlich eine jetzt kaum mehr kultivierte Rebenart, die rötliche, sehr wasserreiche, aber mit geringem Boden vorliebnehmende Trauben liefert, welche man „Hungerlinge\" nannte.“"
                            },
                            {
                                "example_id": "bb9f5a66-9493-41da-adc4-6090fe531a6a",
                                "sense_id": "f1f1e8bb-4bc2-3809-a2c5-d1d2f9091c50",
                                "text": "„Die sauren nennt man an einigen Orten Hungerling, sie werden zwar bald reif, sind aber an der Güte gar gering, geben zwar viel aber schlechten dünnen Most, von rother Farbe, in welchem sehr mäßige Kraft zu finden ist.“ (1802)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
