                {
                    "sense_id": "0ecff7e0-ded2-3d08-819f-13daf8e48115",
                    "sense_definition": "Qui est dépendant physiquement ou psychologiquement d'une substance ou d'une drogue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dependance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est <w>accro</w> à la nicotine et n'arrive pas à arrêter de fumer.",
                            "target_lang_translations": {
                                "en": "He is <w>addicted</w> to nicotine and can't manage to stop smoking.",
                                "ru": "Он <w>зависим</w> от никотина и не может бросить курить.",
                                "de": "Er ist <w>süchtig</w> nach Nikotin und schafft es nicht, mit dem Rauchen aufzuhören.",
                                "es": "Es <w>adicto</w> a la nicotina y no consigue dejar de fumar.",
                                "zh": "他对尼古丁<w>成瘾</w>，怎么也戒不了烟。"
                            }
                        },
                        {
                            "text": "Ce médicament soulage la douleur, mais on peut vite en devenir <w>accro</w>.",
                            "target_lang_translations": {
                                "en": "This medication relieves pain, but you can quickly become <w>addicted</w> to it.",
                                "ru": "Это лекарство снимает боль, но от него можно быстро стать <w>зависимым</w>.",
                                "de": "Dieses Medikament lindert die Schmerzen, doch man kann schnell <w>süchtig</w> danach werden.",
                                "es": "Este medicamento alivia el dolor, pero es fácil volverse <w>adicto</w> a él rápidamente.",
                                "zh": "这种药能缓解疼痛，但人很容易对它<w>上瘾</w>。"
                            }
                        }
                    ],
