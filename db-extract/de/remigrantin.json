                "senses": [
                    {
                        "sense_id": "e98bf182-3d76-3f08-9bf4-54c762df640c",
                        "entry_id": "a6c06b90-b57a-34f4-8016-b665ff3b67c8",
                        "glosses": [
                            "weibliche Person, die aus dem Exil/der Emigration zurückkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fe50bd6-3a12-41ca-9a12-a5c93b30cc0f",
                                "sense_id": "e98bf182-3d76-3f08-9bf4-54c762df640c",
                                "text": "„Über zwei andere Remigrantinnen sind wir etwas besser informiert: Über die Rückkehr Anna Siemsens im Alter von 64 Jahren nach Hamburg wurde schon berichtet, und die dritte Remigrantin war Charlotte Lütkens.“"
                            },
                            {
                                "example_id": "d2940d8a-b83b-4579-8ef2-d3c764f53efc",
                                "sense_id": "e98bf182-3d76-3f08-9bf4-54c762df640c",
                                "text": "„Und diese sind noch enger gezogen, gerade bei Remigrantinnen. Denn Frauen, die in der Bundesrepublik gelebt haben, werden vom sozialen Umfeld besonders in Augenschein genommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
