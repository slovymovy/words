                        "glosses": [
                            "De la nature de l’autodéfense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da7c8e5-dc7a-4870-af63-a11c29a879e7",
                                "sense_id": "52e33f88-19e5-3ecb-bc70-a7892d243c7d",
                                "text": "Ou bien c’est une activité à but passif, protectrice, auto-défensive contre le débordement pulsionnel, une manière de se laisser aller qui reste vigilante, ou bien c’est un état potentiellement a-pulsionnel d’inertie mortifère."
                            },
                            {
                                "example_id": "4228e7cb-f41d-42e0-88e0-41a16821bb99",
                                "sense_id": "52e33f88-19e5-3ecb-bc70-a7892d243c7d",
                                "text": "Avant d’écouter les insultes ordurières de Martine, injures auto-défensives permettant d’expulser ce qui fait mal au-dedans de soi, remarquons que Daniel a le geste maternel de lui apporter un verre d’eau."
                            },
                            {
                                "example_id": "cdb81232-0e99-4271-97f6-cf9bb543e32b",
                                "sense_id": "52e33f88-19e5-3ecb-bc70-a7892d243c7d",
                                "text": "Pas de conscience de classe, de nation. Très auto-défensifs."
                            }
                        ]
                    }
