        "fr-extract.jsonl": [
            {
                "entry_id": "c0c19d1f-53e0-38ef-918f-913fdf3d0228",
                "word": "protectionniste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "857bc9bb-962d-48de-9ab0-07fcf7aa4208",
                        "entry_id": "c0c19d1f-53e0-38ef-918f-913fdf3d0228",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "protectionnistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "940731a3-15a5-3fce-ab84-41b4ee7960a9",
                        "entry_id": "c0c19d1f-53e0-38ef-918f-913fdf3d0228",
                        "glosses": [
                            "Relatif à la doctrine économique du protectionnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57668aa5-7745-4a3a-95c4-23f18afeed2d",
                                "sense_id": "940731a3-15a5-3fce-ab84-41b4ee7960a9",
                                "text": "Certains professionnels regardent la décision chinoise comme une mesure protectionniste contre le fromage français, un produit considéré comme haut de gamme. Pékin estime en effet que le même fromage, produit en Chine, reste plus sûr."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1c74879-2cfb-433a-a5bc-9a7fdd3e9d3f",
                        "source_entry_id": "c0c19d1f-53e0-38ef-918f-913fdf3d0228",
                        "source_sense_id": "940731a3-15a5-3fce-ab84-41b4ee7960a9",
                        "target_lang_word": "protectionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protectionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e15cde07-445d-34ca-aa6f-6f6536beb9d4",
                                        "entry_id": "6b8f6375-4a69-34ca-a246-e4f0a8bb6b27",
                                        "glosses": [
                                            "Of or pertaining to protectionism, or an advocate thereof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c31dcb8-fe28-4eab-a124-f254053d24f0",
                                                "sense_id": "e15cde07-445d-34ca-aa6f-6f6536beb9d4",
                                                "text": "This is because most member countries still hold a very much protectionist stance when it comes to the service sector."
                                            },
                                            {
                                                "example_id": "bad730d8-7ea3-4376-82c4-12462d7c859c",
                                                "sense_id": "e15cde07-445d-34ca-aa6f-6f6536beb9d4",
                                                "text": "The \"national security\" grounds were gauzy at best; the 232 tariffs were classically protectionist."
                                            },
                                            {
                                                "example_id": "1a6d00f7-eb76-4018-8a87-831fc3c62495",
                                                "sense_id": "e15cde07-445d-34ca-aa6f-6f6536beb9d4",
                                                "text": "While protectionist policies, with its tariffs on imports and wholesale rejection of globalism, are often justified on the grounds of supporting domestic industries, preserving jobs, and enhancing national security, they also carry significant downsides, particularly for the most economically vulnerable populations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "protectionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aae135a5-3122-3e5d-817b-204a55c40ad0",
                                        "entry_id": "dbf75145-0b75-35c5-af8a-c3470c1a4371",
                                        "glosses": [
                                            "Someone who believes in protecting domestic producers by impeding or limiting the importation of foreign goods and services via actions taken by government."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b068efbd-8679-4cf7-8de9-7049da232e37",
                                                "sense_id": "aae135a5-3122-3e5d-817b-204a55c40ad0",
                                                "text": "It also would cut deeply into the trans-Atlantic alliance at the worst possible time by giving anti-American, anti-capitalist nationalists and protectionists in Europe a platform to thrive. Anti-American sentiment will grow, and Europe risks a retreat to protectionism. Those of us who make the case for the trans-Atlantic alliance will have a much harder job."
                                            },
                                            {
                                                "example_id": "86d2e62b-e225-42a9-b76d-331b524acfe9",
                                                "sense_id": "aae135a5-3122-3e5d-817b-204a55c40ad0",
                                                "text": "Vance is now a key messenger for Trump’s economic agenda as the administration pursues sweeping new protectionists policies announced on what they deemed “Liberation Day.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ca354ae-40d8-3546-aa65-63f574d0862e",
                                        "entry_id": "dbf75145-0b75-35c5-af8a-c3470c1a4371",
                                        "glosses": [
                                            "A linguistic purist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "017a04ab-4f7f-4b83-bc3e-1f1605a3ed8b",
                        "source_entry_id": "c0c19d1f-53e0-38ef-918f-913fdf3d0228",
