                ],
                "senses": [
                    {
                        "sense_id": "b7a7c47a-0da8-3152-945e-66e98f7aac78",
                        "entry_id": "879ce237-b29d-3c93-b328-a6aa5c0cce95",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e3882e2-62d8-458c-9bca-fa8db714e834",
                                "sense_id": "b7a7c47a-0da8-3152-945e-66e98f7aac78",
                                "text": "Frau Maierle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a9f63904-2ec7-4c5d-b7ff-969832d6588e",
                                "sense_id": "b7a7c47a-0da8-3152-945e-66e98f7aac78",
                                "text": "Herr Maierle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "06810384-c8ef-407a-b266-89e7c4e6e946",
                                "sense_id": "b7a7c47a-0da8-3152-945e-66e98f7aac78",
                                "text": "Die Maierles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "dbaa29dd-1645-4ddb-b1c4-bb28d65d1acf",
                                "sense_id": "b7a7c47a-0da8-3152-945e-66e98f7aac78",
                                "text": "Der Maierle trägt nie die Pullover, die die Maierle ihm strickt."
                            },
                            {
                                "example_id": "f5bf61b4-4613-4a91-b35a-588b8496c23f",
                                "sense_id": "b7a7c47a-0da8-3152-945e-66e98f7aac78",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Maierle kommt, geht der Herr Maierle.“"
                            },
                            {
                                "example_id": "f7e90980-a03a-4286-98b3-1dd8a8c9743c",
                                "sense_id": "b7a7c47a-0da8-3152-945e-66e98f7aac78",
                                "text": "Maierle kommt und geht."
                            },
                            {
                                "example_id": "75865467-ddde-467c-99cc-bb52e85dfc08",
                                "sense_id": "b7a7c47a-0da8-3152-945e-66e98f7aac78",
                                "text": "Maierles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
