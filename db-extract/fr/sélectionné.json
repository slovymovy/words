                    {
                        "translation_id": "9f6612d8-07de-4e6d-bf99-63e1f5c588c6",
                        "source_entry_id": "e6a1ccc7-026b-3e7f-8009-947785baa656",
                        "source_sense_id": "d10eb371-8219-3b02-823e-74f4a680b957",
                        "target_lang_word": "избранный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "избранный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8408c0d8-f1b4-3992-9b2f-7673f231e4a7",
                                        "entry_id": "8914d84a-c3e3-3f99-9e5d-d76defe141e1",
                                        "glosses": [
                                            "страд. прич. прош. вр. от избрать"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80dee5b6-de00-47be-87ee-12d34d855119",
                                                "sense_id": "8408c0d8-f1b4-3992-9b2f-7673f231e4a7",
                                                "text": "Марина! зри во мне // Любовника, избра́нного тобою, // Счастливого твоим единым взором."
                                            },
                                            {
                                                "example_id": "574051fb-a3f2-4863-b32a-da81b77c3fe2",
                                                "sense_id": "8408c0d8-f1b4-3992-9b2f-7673f231e4a7",
                                                "text": "С этого дня он стал всё чаще и чаще посещать клуб и даже был единодушно избран без всякой баллотировки председателем этого клуба как человек, опытный в военном деле, как воин, дравшийся с туркою, как образованный барин."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "избранный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5f027e79-c3b8-3cc9-965d-0f330205d09f",
                                        "entry_id": "89001cab-3b4d-38f7-969d-80ba0a508ffc",
                                        "glosses": [
                                            "отобранный из полного состава (о произведениях литературы, искусства)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221f916d-d2ac-4583-8e96-52a8709983e5",
                                                "sense_id": "5f027e79-c3b8-3cc9-965d-0f330205d09f",
                                                "text": "Кабинет этот весь завален английскими гравюрами и заставлен избранными картинами, особенно нравящимися князю…"
                                            },
                                            {
                                                "example_id": "a25cad1e-ce54-47b5-bd7f-f2783aa99027",
                                                "sense_id": "5f027e79-c3b8-3cc9-965d-0f330205d09f",
                                                "text": "Если вам вздумается читать, то вот шкаф с избранными произведениями французской литературы…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a30a632-181c-345f-9e19-2724c500d155",
                                        "entry_id": "89001cab-3b4d-38f7-969d-80ba0a508ffc",
                                        "glosses": [
                                            "лучший, выделяющийся чем-либо среди других, привилегированный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b63d141-c343-4a3c-98ed-a46ae3253443",
                                                "sense_id": "4a30a632-181c-345f-9e19-2724c500d155",
                                                "text": "Я желаю, чтоб Ларису Дмитриевну окружали только избранные люди."
                                            },
                                            {
                                                "example_id": "5f53a04a-4bea-491b-9bf5-b4f1138133f7",
                                                "sense_id": "4a30a632-181c-345f-9e19-2724c500d155",
                                                "text": "Только маленькое, избранное общество герцог пригласил в прохладный, уютный покой, куда принесли вина и плодов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf44ac92-5795-337d-bd1e-1018039fc291",
                                        "entry_id": "89001cab-3b4d-38f7-969d-80ba0a508ffc",
                                        "glosses": [
                                            "субстантивир. особо одарённый, выдающийся человек, способный к деятельности, недоступной другим"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
