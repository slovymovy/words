                "senses": [
                    {
                        "sense_id": "fbc9cdc5-848d-3dc9-96c7-817fe87a1146",
                        "entry_id": "9e72c464-a5d7-317c-8143-02da24537ec1",
                        "glosses": [
                            "SI-Einheit der SI-Basisgröße Lichtstärke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9542f4f1-8adf-4b3a-8947-b89744fc8daf",
                                "sense_id": "fbc9cdc5-848d-3dc9-96c7-817fe87a1146",
                                "text": "„Eine gewöhnliche Haushaltskerze hat eine Lichtstärke von etwa 1 cd. Daher rührt auch der Name der Einheit (lateinisch Candela = Kerze).“"
                            },
                            {
                                "example_id": "005147a2-6444-43d1-b116-8380e842916f",
                                "sense_id": "fbc9cdc5-848d-3dc9-96c7-817fe87a1146",
                                "text": "„Als rein physikalische Messgröße wird die Helligkeit von der Photometrie durch die Lichtstärke ersetzt, welche die von einem Objekt ausgehende, spektral gemittelte Strahlung in der Maßeinheit Candela (cd) angibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec356235-88f2-4fd0-9ea4-10184f9e868d",
                        "source_entry_id": "9e72c464-a5d7-317c-8143-02da24537ec1",
                        "source_sense_id": "fbc9cdc5-848d-3dc9-96c7-817fe87a1146",
                        "source_sense_description": "SI-Einheit der SI-Basisgröße Lichtstärke",
                        "target_lang_word": "candela",
