                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "525c3338-e2b9-4b49-b6b8-013da3460c6f",
                                                "sense_id": "3db4e311-cc65-3bfc-8270-007b8a3aa901",
                                                "text": "The ancient city of Petra was annexed by Rome."
                                            },
                                            {
                                                "example_id": "44c2a3f7-54a8-4412-b350-6b42d87c7771",
                                                "sense_id": "3db4e311-cc65-3bfc-8270-007b8a3aa901",
                                                "text": "In 1910, he returned to Korea, which had by this time been annexed by Japan."
                                            }
                                        ]
