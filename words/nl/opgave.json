                            {
                                "target_lang_word": "retirement",
                                "target_lang_sense_clarification": "stopping a race or match due to injury or choice"
                            },
                            {
                                "target_lang_word": "forfeit",
                                "target_lang_sense_clarification": "giving up a contest"
                            }
