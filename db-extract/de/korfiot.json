                    }
                ],
                "translations": [
                    {
                        "translation_id": "781bfb5d-dc69-4761-b303-57f4ae29ec22",
                        "source_entry_id": "32f09571-d4e3-3d66-b5ac-a7208269ab26",
                        "source_sense_id": "a103cbff-374e-30e8-af06-2e200557d2d3",
                        "source_sense_description": "Einwohner Korfus",
                        "target_lang_word": "Corfiot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Corfiot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "971efbb4-3b00-39e2-9420-41c7d66cb997",
                                        "entry_id": "b238a719-add1-31d5-a962-78eec6a1dca5",
                                        "glosses": [
                                            "A person from Corfu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7ced82f-bce9-44e3-999e-8a66612b7c08",
                                                "sense_id": "971efbb4-3b00-39e2-9420-41c7d66cb997",
                                                "text": "His name was Spiridon, he was a charismatic Corfiote, and his exuberance was inexhaustible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Corfiot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "690f7c8f-7abb-3ac2-b50b-6a3026607b95",
                                        "entry_id": "aa1b3773-9abe-3b3c-964a-06c2fce29146",
                                        "glosses": [
                                            "Of, from, or relating to Corfu."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88deb909-790c-4e61-b51e-acc7abe16b83",
                        "source_entry_id": "32f09571-d4e3-3d66-b5ac-a7208269ab26",
                        "source_sense_id": "a103cbff-374e-30e8-af06-2e200557d2d3",
                        "source_sense_description": "Einwohner Korfus",
                        "target_lang_word": "corfiote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corfiote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "549b5e35-eaea-3cc7-98f0-36365e43656b",
                                        "entry_id": "5656eb9b-139f-31d2-a545-3fa0853edf6c",
                                        "glosses": [
                                            "Habitant de l’île grecque de Corfou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b5873db-36bb-452b-a717-365c15b571a7",
                                                "sense_id": "549b5e35-eaea-3cc7-98f0-36365e43656b",
                                                "text": "Je racontais l’autre jour l’histoire du […] comte Jean Capodistrias, je montrais avec quel art le rusé corfiote avait ébranlé la candidature du prince Léopold au trône des Hellènes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69365146-442a-3979-a527-60c9ddfc8759",
                                        "entry_id": "5656eb9b-139f-31d2-a545-3fa0853edf6c",
                                        "glosses": [
                                            "Dialecte grec parlé à Corfou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d7b199-e057-44fd-8992-9fdc171cae21",
                                                "sense_id": "69365146-442a-3979-a527-60c9ddfc8759",
                                                "text": "Ses choix [de Hatzopoulos] ne sont pas ceux de son ami Théotokis, chez qui le recours au corfiote dans les nouvelles peut s’expliquer conjointement par un souci de réalisme et par la pensée que ce dialecte pourrait devenir la « langue commune » de la Grèce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c04eba7-66f6-3a04-923c-d8a516310ba9",
                                        "entry_id": "5656eb9b-139f-31d2-a545-3fa0853edf6c",
                                        "glosses": [
                                            "Dialecte de l’italo-vénitien anciennement parlé à Corfou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "781de81e-2a48-4fbd-8ff1-33eeda5fbb8d",
                                                "sense_id": "4c04eba7-66f6-3a04-923c-d8a516310ba9",
                                                "text": "Chez Albert Cohen […] le corfiote est la langue d’amour avec la mère, celle de l’intimité qu’il retrouve en parlant cette langue à sa chatte, une langue préservée des autres, fermée à tout intrus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corfiote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69efebe3-b0f2-3441-9f05-13341bc53c4a",
                                        "entry_id": "f2d170b0-7cdf-3737-99cd-3cad911ce192",
                                        "glosses": [
                                            "Relatif à l’île grecque de Corfou ou à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3c4ca13-faf0-4961-86de-e6f5deafee58",
                                                "sense_id": "69efebe3-b0f2-3441-9f05-13341bc53c4a",
                                                "text": "Elle allait, courant dans l’île d’un pas rapide, […] répondant au salut des bergers corfiotes avec la grâce mélancolique d’une souveraine insatisfaite."
                                            },
                                            {
                                                "example_id": "dc2a044f-0a6e-4d10-995f-59aca2673347",
                                                "sense_id": "69efebe3-b0f2-3441-9f05-13341bc53c4a",
                                                "text": "On appréciera le résumé des faits de langue […] qui donne une idée du dialecte corfiote à la fin du XVIᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
