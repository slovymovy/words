                                            {
                                                "example_id": "f7d3dc72-cdb9-45b5-a1a1-bfab2b5dc447",
                                                "sense_id": "0cc263a0-d8b8-38aa-a249-a222b299356d",
                                                "text": "Polska wyzwoleńcza Armia Krajowa, która heroicznie walczyła z hitlerowskimi okupantami, wszczęła powstanie w Warszawie."
