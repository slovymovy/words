                "senses": [
                    {
                        "sense_id": "cc252b93-666a-3d13-9fa1-e4a74e2b33a2",
                        "entry_id": "a028365e-6e36-3181-8460-ab17027c194a",
                        "glosses": [
                            "nach einem speziellen Verfahren gebogenes Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13c22c45-696a-4747-b03b-7b7b9ab62ac1",
                                "sense_id": "cc252b93-666a-3d13-9fa1-e4a74e2b33a2",
                                "text": "„Man denke an die Entwürfe von Marcel Breuer oder Ludwig Mies van der Rohe, die bei aller Unterschiedlichkeit in Sachen Material formal einen durchaus hohen Verwandtschaftsgrad mit Möbeln aus Bugholz aufweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b857e869-bf33-4162-98bb-8c5914af7cac",
                        "source_entry_id": "a028365e-6e36-3181-8460-ab17027c194a",
                        "source_sense_id": "cc252b93-666a-3d13-9fa1-e4a74e2b33a2",
                        "source_sense_description": "nach einem speziellen Verfahren gebogenes Holz",
                        "target_lang_word": "bentwood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bentwood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "394ac9f7-a112-3fa9-b00e-f95893fdc64f",
                                        "entry_id": "389097d1-a0b6-3e7b-bb49-9757489d1b04",
                                        "glosses": [
                                            "Lengths of wood that have been made pliable by heating with steam and then bent into the appropriate shape (to make furniture, ships' hulls, etc.)."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "429297bb-c7a0-43ca-a70a-f3d35e13c5ed",
                                                "sense_id": "394ac9f7-a112-3fa9-b00e-f95893fdc64f",
                                                "text": "About this time [Michael] Thonet received his first major public commission from the famous Cafe Daum in Vienna. From this point on, the bentwood chair would be known by many as the Cafe Chair[…]. The back is made of four layers of twisted mahogany laminates, while the front legs appear to be bent from solid stock with turned capitals, which act as shoulders for the tenon of the leg into the seat. The seat frames are made of five layers of mahogany, as they were in the Schwarzenburg chairs. Because of its lightness, durability and accommodating design, the bentwood chair was perfectly suited for public places."
                                            },
                                            {
                                                "example_id": "a8663eed-7baf-47a1-a3a3-b272e895ad9c",
                                                "sense_id": "394ac9f7-a112-3fa9-b00e-f95893fdc64f",
                                                "text": "Bentwood furniture is made by bending and nailing long, straight, fresh branches or suckers of trees around a frame. Unlike most stick work, bentwood furniture is carefully planned before it is made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b9bf20c-4a64-3b69-9879-636b7744457e",
                                        "entry_id": "389097d1-a0b6-3e7b-bb49-9757489d1b04",
                                        "glosses": [
                                            "An object, especially a piece of furniture, made from bentwood."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4007cd22-b196-4877-bc69-d1083aceab31",
                                                "sense_id": "0b9bf20c-4a64-3b69-9879-636b7744457e",
                                                "text": "The two basic types of fishhooks are almost equally represented within the site, with composite fishhooks exhibiting only a slightly higher relative frequency than that of bentwoods."
                                            },
                                            {
                                                "example_id": "55f84a73-eb00-43d0-a109-946bc4a27ffb",
                                                "sense_id": "0b9bf20c-4a64-3b69-9879-636b7744457e",
                                                "text": "She started walking over to the trestle table and, about ten years later, sat down on one of the thirty-three bentwoods."
                                            },
                                            {
                                                "example_id": "44af40cd-91e3-48f1-9ece-c102e4b9ee74",
                                                "sense_id": "0b9bf20c-4a64-3b69-9879-636b7744457e",
                                                "text": "Catherine Holt of Cobweb (a store known for great antiques at tiny prices) has assembled a kind of United Nations of kitchen and dining room chairs. She has turn-of-the-century cafe bentwoods from Spain, Austria, and Czechoslovakia; vintage teak sidechairs from Java; provincial rush-seated chairs from France; and painted bentwoods from Buenos Aires, along with contemporary lattice-backs from Morocco and chairs with stamped seats from Egypt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
