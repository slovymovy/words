            {
                "entry_id": "18628e7d-94a8-3c71-ae4d-ba7c055be8f1",
                "word": "Apache",
                "pos": "name",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fadfc64f-cd41-366c-84f0-952dae8d1e8a",
                        "entry_id": "18628e7d-94a8-3c71-ae4d-ba7c055be8f1",
                        "glosses": [
                            "taalgroep waarvan de talen gesproken worden door verschillende groepen Apaches en Navajos"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7aa2eb63-f2e4-462b-b53f-e0dbd4ab1841",
                                "sense_id": "fadfc64f-cd41-366c-84f0-952dae8d1e8a",
                                "text": "Hij beledigde zijn beulen in het Apache of Mandarijns of Sioux, daagde ze uit hem nog meer pijn te doen."
                            }
                        ]
                    },
                    {
                        "sense_id": "470ae35b-7790-3337-8b8e-113e3a4187be",
                        "entry_id": "18628e7d-94a8-3c71-ae4d-ba7c055be8f1",
                        "glosses": [
                            "merknaam voor open source programmatuur, oorspronkelijk vooral een webserver voor UNIX (BSD, GNU/Linux Mac OS X, Solaris en andere UNIX-systemen), Microsoft Windows, Novell Netware, BeOS, OS/2 en IBM's OS/400"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d81fec6b-9e03-4377-a488-18d0b9233511",
                                "sense_id": "470ae35b-7790-3337-8b8e-113e3a4187be",
                                "text": "Redenen voor die populariteit zijn de grote flexibiliteit, de goede performance en schaalbaarheid, de stabiliteit en daarnaast natuurlijk ook het feit dat Apache een open source server (dus gratis) is."
                            }
                        ]
                    },
                    {
                        "sense_id": "baf47219-194b-3368-b8a0-cff9032074a9",
                        "entry_id": "18628e7d-94a8-3c71-ae4d-ba7c055be8f1",
                        "glosses": [
                            "Belgische nieuwssite"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "164f2a4c-1531-4659-b9ec-1a77170c12ab",
                                "sense_id": "baf47219-194b-3368-b8a0-cff9032074a9",
                                "text": "Drie Vlaamse journalisten begonnen Apache, een nieuwssite met kritische internetjournalistiek."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b8664142-2eee-33a0-9696-bcfec634c2e8",
                "word": "Apache",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6049ddaf-3157-3268-8536-75a7eb0bb0ce",
                        "entry_id": "b8664142-2eee-33a0-9696-bcfec634c2e8",
                        "glosses": [
                            "iemand die behoort tot de Apachen, een indianenvolk dat in westerse beschrijvingen vaak als krijgslustig werd beschreven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6207c8f-2504-4094-88f3-bcc253306ead",
                                "sense_id": "6049ddaf-3157-3268-8536-75a7eb0bb0ce",
                                "text": "Ik ben een Apache die sluipt zonder dat je een takje hoort kraken."
                            },
                            {
                                "example_id": "af490b3d-4927-4353-be40-233a88d463ee",
                                "sense_id": "6049ddaf-3157-3268-8536-75a7eb0bb0ce",
                                "text": "De Comanchen waren in dit boek sympathiek en de Apachen gemene kerels, zeer in tegenstelling met de visie van Karl May, later, volgens welke Winnetou het opperhoofd der Apachen de edelste man was op het wereldrond en dus met recht de bloedbroeder van Old Shatterhand."
                            }
                        ]
                    },
                    {
                        "sense_id": "c76530a2-10fe-3007-8990-71430bb190f8",
                        "entry_id": "b8664142-2eee-33a0-9696-bcfec634c2e8",
                        "glosses": [
                            "bepaald type gevechtshelikopter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db133b03-745b-4790-b796-e82909d83116",
                                "sense_id": "c76530a2-10fe-3007-8990-71430bb190f8",
                                "text": "De Apache vloog laag over het gebied als onderdeel van een oefening, waarbij de helikopters niet hoger dan 35 meter hoog mogen vliegen."
                            }
                        ]
                    }
                ],
