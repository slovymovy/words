                "entry_id": "526478ec-4b21-36ff-a462-636a76d83449",
                "word": "séquençage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9753aa62-080e-422e-806c-d673fe2e7ad8",
                        "entry_id": "526478ec-4b21-36ff-a462-636a76d83449",
                        "tags": [
                            "plural"
