                {
                    "sense_id": "10dc263b-44df-38aa-bf64-644da0cdbc0b",
                    "sense_definition": "Een klein zakje met vocht in het lichaam dat gewrichten beschermt tegen wrijving.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dokter vertelde dat de <w>beurs</w> in zijn knie ontstoken was.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что <w>сумка</w> в его колене воспалилась.",
                                "en": "The doctor said that the <w>bursa</w> in his knee was inflamed."
                            }
                        },
                        {
                            "text": "Door het vele werken op zijn knieën kreeg de stratenmaker last van zijn <w>beurs</w>.",
                            "target_lang_translations": {
                                "ru": "Из-за частой работы на коленях у дорожного рабочего начались проблемы с суставной <w>сумкой</w>.",
                                "en": "Because of working on his knees so much, the paver suffered from his <w>bursa</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "slijmbeurs"
                    ],
                    "common_phrases": [
                        "ontstoken beurs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой мешочек с жидкостью в организме, защищающий суставы от трения.",
                        "en": "A small sac of fluid in the body that protects joints from friction."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумка",
                                "target_lang_sense_clarification": "анатомическая (слизистая/суставная)"
