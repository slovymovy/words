                "senses": [
                    {
                        "sense_id": "a4fa163a-3285-35d9-9c65-db76ac92c95f",
                        "entry_id": "b51ba1ab-3650-3c00-9d77-2970e7c5555b",
                        "glosses": [
                            "Variante orthographique plus rare de phragmocône, partie cloisonnée de la coquille des céphalopodes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15d08f15-b7c2-4254-927f-2b13c58defc6",
                                "sense_id": "a4fa163a-3285-35d9-9c65-db76ac92c95f",
                                "text": "Aragonite, sauf le rostre des Bélemnitidés, qui est en calcite ; le phragmocone lui-même est en aragonite, mais il est assez rarement conservé."
                            },
                            {
                                "example_id": "17bea87d-0af7-4a88-961d-79f9f48c4dbe",
                                "sense_id": "a4fa163a-3285-35d9-9c65-db76ac92c95f",
                                "text": "Dans les Bélemnites typiques, qui sont de beaucoup les plus nombreuses, le phragmocone est la partie la plus réduite : le rostre s’allonge considérablement."
                            },
                            {
                                "example_id": "7aaac66c-f0dc-406b-8b3a-9084f1b59d99",
                                "sense_id": "a4fa163a-3285-35d9-9c65-db76ac92c95f",
                                "text": "Rostre triangulaire, acuminé en arrière, épaissi en avant et contenant un phragmocone courbé, cloisonné, dont le côté convexe est dirigé en dehors."
                            }
                        ]
                    }
                ],
                "translations": [
