                                        "examples": [
                                            {
                                                "example_id": "9367d468-eed1-4722-ae39-f30f5e2f2e94",
                                                "sense_id": "b25dad5d-afea-3d74-8721-f40ecf4f864a",
                                                "text": "In jungen Jahren wollte Theo einmal eine Andorranerin heiraten, doch aus der Hochzeit wurde nichts."
                                            },
                                            {
                                                "example_id": "d8705291-0110-40ad-940b-46533a0ea40f",
                                                "sense_id": "b25dad5d-afea-3d74-8721-f40ecf4f864a",
                                                "text": "Sie schickte einer Andorranerin, die in einem Wintersportort lebte, eine Postkarte mit Impressionen aus dem Englischen Garten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
