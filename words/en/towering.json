{
    "word_family": [
        "tower"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "481b5cf6-b0d8-3c67-b503-ac998fd1615d",
                    "sense_definition": "Very tall or high and dwarfing anything around it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "height",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>towering</w> mountains cast a long shadow over the small village in the valley.",
                            "target_lang_translations": {
                                "ru": "<w>Возвышающиеся</w> горы отбрасывали длинную тень на маленькую деревню в долине."
                            }
                        },
                        {
                            "text": "He scored the winning goal with a <w>towering</w> header in the final minute of the game.",
                            "target_lang_translations": {
                                "ru": "Он забил победный гол <w>высоким</w> ударом головой на последней минуте игры."
                            }
                        }
                    ],
                    "synonyms": [
                        "lofty",
                        "imposing",
                        "colossal"
                    ],
                    "antonyms": [
                        "tiny",
                        "short"
                    ],
                    "common_phrases": [
                        "towering figure",
                        "towering achievement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень высокий, возвышающийся над всем окружающим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвыша́ющийся",
                                "target_lang_sense_clarification": "подчеркивает высоту объекта относительно окружения"
                            },
                            {
                                "target_lang_word": "вздыма́ющийся",
                                "target_lang_sense_clarification": "часто используется для описания гор или высоких объектов"
                            },
                            {
                                "target_lang_word": "высо́кий",
                                "target_lang_sense_clarification": "общее определение большой высоты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5163f654-8afa-3e8c-a7d8-9472e1dc0fcd",
                    "sense_definition": "The present participle and gerund of <w>tower</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "height",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skyscraper is <w>towering</w> above all the other buildings in the city center.",
                            "target_lang_translations": {
                                "ru": "Этот небоскреб <w>возвышается</w> над всеми остальными зданиями в центре города."
                            }
                        },
                        {
                            "text": "She is <w>towering</w> over her classmates because she is much taller than them.",
                            "target_lang_translations": {
                                "ru": "Она <w>возвышается</w> над своими одноклассниками, потому что она намного выше их."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола «возвышаться», означающее находиться на большой высоте по сравнению с другими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвыша́ющийся",
                                "target_lang_sense_clarification": "находящийся выше окружающих предметов"
                            },
                            {
                                "target_lang_word": "возвыша́ясь",
                                "target_lang_sense_clarification": "деепричастная форма, описывающая процесс возвышения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e40ea447-5392-3c4f-a61a-934ede1b2085",
                    "sense_definition": "The act or condition of being high above others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "height",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His intellectual <w>towering</w> made it difficult for others to keep up with his complex arguments.",
                            "target_lang_translations": {
                                "ru": "Его интеллектуальное <w>превосходство</w> затрудняло другим понимание его сложных аргументов."
                            }
                        },
                        {
                            "text": "The bird descended from its aerial <w>towering</w> to land on the branch.",
                            "target_lang_translations": {
                                "ru": "Птица спустилась со своей воздушной <w>высоты</w>, чтобы сесть на ветку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or dated context."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или акт нахождения на значительной высоте над другими (устаревшее или литературное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвышение",
                                "target_lang_sense_clarification": "процесс или состояние нахождения выше других"
                            },
                            {
                                "target_lang_word": "превосходство",
                                "target_lang_sense_clarification": "в переносном смысле, интеллектуальное или статусное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}