                ],
                "senses": [
                    {
                        "sense_id": "20928cc2-e6a0-38de-870f-5c73759582c7",
                        "entry_id": "ba3fde16-8d20-3076-9500-f5fd22a02103",
                        "glosses": [
                            "Schuh, hergestellt aus Leder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0428021-939e-4ef9-a902-f365553d5d75",
                                "sense_id": "20928cc2-e6a0-38de-870f-5c73759582c7",
                                "text": "„Wenn sich beim Tragen bestimmter Lederschuhe rote, juckende Stellen an den Füßen bilden, dann ist der wahrscheinlichste Grund dafür, dass das Leder nicht sachgemäß gegerbt wurde.“"
                            },
                            {
                                "example_id": "338b4440-2d82-444f-8877-b190674c06c6",
                                "sense_id": "20928cc2-e6a0-38de-870f-5c73759582c7",
                                "text": "„Das war zu jener Zeit sehr außergewöhnlich - doch Salz war kostbar und damit auch der Arbeiter, deshalb wurde ihm auch ein Lederschuh gegönnt.“"
                            },
                            {
                                "example_id": "2ea01e86-76e7-4ca2-8dc6-18904ee9b94d",
                                "sense_id": "20928cc2-e6a0-38de-870f-5c73759582c7",
                                "text": "„Als wir einmal zusammen in einem Straßencafé saßen, sagte er einem Schuhputzer, dass seine feinen Lederschuhe leider wirklich nicht geputzt werden müssten.“"
                            },
                            {
                                "example_id": "0560ab66-72a9-4363-9b25-f3dc6bc20034",
                                "sense_id": "20928cc2-e6a0-38de-870f-5c73759582c7",
                                "text": "„Zum abendlichen Galadinner habe ich mir mein gutes schwarzes Jackett übergeworfen, darunter ein frisches schwarzes T-Shirt gezogen und bin in die schwarzen, frisch geputzten Lederschuhe geschlüpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
