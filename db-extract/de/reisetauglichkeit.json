                        "examples": [
                            {
                                "example_id": "25abd311-f139-4af9-9657-9662fe7ae02c",
                                "sense_id": "e831b491-fccb-3da1-9835-6c5530e1e237",
                                "text": "„Meine fleißigen Mikroorganismen bewiesen damit eindrücklich ihre Reisetauglichkeit.“"
                            },
                            {
                                "example_id": "a4b8891a-d616-4464-9df7-abb2035a0b9b",
                                "sense_id": "e831b491-fccb-3da1-9835-6c5530e1e237",
                                "text": "„Sind Flug- und Reisetauglichkeit gewährleistet?“"
                            },
                            {
                                "example_id": "58944840-a924-4597-856e-b65cb7606893",
                                "sense_id": "e831b491-fccb-3da1-9835-6c5530e1e237",
                                "text": "„Die ersten, die das neue Campingmobil erfolgreich auf Reisetauglichkeit prüfen, sind meine beiden erwachsenen Kinder, die damit zum Mittsommer nach Schweden fahren.“"
                            },
                            {
                                "example_id": "f84baa91-1c58-42bf-b129-1a61f198f53a",
                                "sense_id": "e831b491-fccb-3da1-9835-6c5530e1e237",
                                "text": "„Noch am Abreisetag war eine Reisetauglichkeit nicht gegeben, schon Autofahren nicht vorstellbar.“"
                            },
                            {
                                "example_id": "28b84ae0-ec79-488f-97b7-c9a19534de6a",
                                "sense_id": "e831b491-fccb-3da1-9835-6c5530e1e237",
                                "text": "„Die günstigsten Roadster mit hoher Reisetauglichkeit kommen derzeit aus dem Hause Royal Enfield.“"
                            }
