                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af47f212-3dc7-3b5c-a2e1-dc66c0b8ea15",
                                        "entry_id": "fec05f32-1546-34c8-b8ae-726d5e4893b4",
                                        "glosses": [
                                            "A sum of money or other asset given as an initial payment, to show good faith, or to reserve something for purchase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "200b930c-7e77-45ed-8d8f-b796a4bcafa6",
                                                "sense_id": "af47f212-3dc7-3b5c-a2e1-dc66c0b8ea15",
                                                "text": "They put down a deposit on the apartment."
                                            }
                                        ]
