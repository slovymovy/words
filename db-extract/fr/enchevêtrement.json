                                    },
                                    {
                                        "sense_id": "3968af7c-f5b6-3e8f-a869-1bf0ba1268f8",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "A paired helical fragment of tau protein found in a nerve cell and associated with Alzheimer's disease."
                                        ],
