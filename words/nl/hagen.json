                            "target_lang_translations": {
                                "en": "The gardener has been busy all afternoon pruning the <w>hedges</w>."
                            }
                        },
                        {
                            "text": "Langs de weg staan hoge groene <w>hagen</w> die voor veel privacy zorgen.",
                            "target_lang_translations": {
                                "en": "Along the road are tall green <w>hedges</w> that provide a lot of privacy."
                            }
                        }
                    ],
                    "synonyms": [
