                "senses": [
                    {
                        "sense_id": "29c59325-7bc9-344e-9087-fcfb062a8818",
                        "entry_id": "d6751a0c-9f6f-3e69-a4e7-b9c975e09e6b",
                        "glosses": [
                            "die Errechnung und/oder Zuweisung eines ungefähren Wertes; die Handlung des Abschätzens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5f3918-fe7a-4073-9948-701cee34f43c",
                                "sense_id": "29c59325-7bc9-344e-9087-fcfb062a8818",
                                "text": "„Sie ackern sich durch komplizierte, ellenlange Listen zur Abschätzung von Gefahrensituationen.“"
                            },
                            {
                                "example_id": "c5c0d31e-c8b2-4c77-b785-f499d81dc77e",
                                "sense_id": "29c59325-7bc9-344e-9087-fcfb062a8818",
                                "text": "„Allein von den für Permanentmagnete wichtigen und als knappe Ressource eingestuften Elementen Neodym und Praseodym könnten aus dem Fen Carbonatite Complex mindestens 1,5 Millionen Tonnen gefördert werden, so die vorläufige Abschätzung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "426d6dfd-61c9-4329-8e16-cfbf02836967",
                        "source_entry_id": "d6751a0c-9f6f-3e69-a4e7-b9c975e09e6b",
                        "source_sense_id": "29c59325-7bc9-344e-9087-fcfb062a8818",
                        "source_sense_description": "die Errechnung und/oder Zuweisung eines ungefähren Wertes",
                        "target_lang_word": "assessment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assessment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77bd4bdd-a286-3433-9a72-a60e2c4d756c",
                                        "entry_id": "73a8c3df-3892-3d34-b1d9-cf0e5220015a",
                                        "glosses": [
                                            "The act of assessing or an amount (of tax, levy or duty etc) assessed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "626cd684-276e-3c7a-a0c9-2f1af49754ed",
                                        "entry_id": "73a8c3df-3892-3d34-b1d9-cf0e5220015a",
                                        "glosses": [
                                            "An appraisal or evaluation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02d079b-51a0-47bc-ab71-2548c1ab5377",
                                                "sense_id": "626cd684-276e-3c7a-a0c9-2f1af49754ed",
                                                "text": "For every item taken into consideration, the question of its status in terms of history has to be raised; if a word can safely be taken to have been borrowed, it will require an assessment different from that appropriate for a native lexeme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff616473-ae63-4772-9df1-cbcef24a042e",
                        "source_entry_id": "d6751a0c-9f6f-3e69-a4e7-b9c975e09e6b",
                        "source_sense_id": "29c59325-7bc9-344e-9087-fcfb062a8818",
                        "source_sense_description": "die Errechnung und/oder Zuweisung eines ungefähren Wertes",
                        "target_lang_word": "estimation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estimation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b2b269a-20e0-3259-a820-a26729bbfb08",
                                        "entry_id": "e814471c-7297-3d45-acd0-acbc9058ba05",
                                        "glosses": [
                                            "Action d’attribuer un prix à quelque chose d’existant, de l’évaluer, d’en estimer la valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "237794ce-612f-41cf-93be-da1698fd4d23",
                                                "sense_id": "6b2b269a-20e0-3259-a820-a26729bbfb08",
                                                "text": "En regardant de plus près, ils s’aperçoivent alors que tous les produits étaient périmés depuis longtemps. Le « partenaire » coréen avait « arrosé » l’auditeur lors de l’estimation comptable de l’apport en capital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5bf90b9-9e00-3dca-92f3-50544f25c6b3",
                                        "entry_id": "e814471c-7297-3d45-acd0-acbc9058ba05",
                                        "glosses": [
                                            "Évaluation d'une quantité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c90b6e-d0cb-4ddf-bdfa-b5bbac55d807",
                                                "sense_id": "c5bf90b9-9e00-3dca-92f3-50544f25c6b3",
                                                "text": "Pour certaines opérations ( estimation de la charge d'un camion ou d'un engin, estimation approchée du volume d'une bille, etc.. ) il n'est pas utile d'effectuer un cubage précis."
                                            },
                                            {
                                                "example_id": "d5ff84cb-6167-43fc-8098-bb11a9898320",
                                                "sense_id": "c5bf90b9-9e00-3dca-92f3-50544f25c6b3",
                                                "text": "Quelques espèces sont assez facilement piégeables et suffisamment étudiées pour permettre, dans quelques milieux, l’estimation de densités à l'hectare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e12df1f-4996-343b-8384-55c49a35ace4",
                                        "entry_id": "e814471c-7297-3d45-acd0-acbc9058ba05",
                                        "glosses": [
                                            "Opérations de chiffrage :"
                                        ],
                                        "tags": [
                                            "Gestion de projet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "829671e8-1c46-3992-8c5b-534b185e5de2",
                                        "entry_id": "e814471c-7297-3d45-acd0-acbc9058ba05",
                                        "glosses": [
                                            "Prédiction d’une grandeur, une performance, le coût ou la durée d’une tâche d’un projet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db58cd6b-3fce-4fa0-827a-dec67fdab75a",
                                                "sense_id": "829671e8-1c46-3992-8c5b-534b185e5de2",
                                                "text": "La consommation d’essence était depuis une huitaine d’heures nettement inférieure à nos estimations, pourtant très tirées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b01945-a85d-3385-8b66-cb8bbc20ee54",
                                        "entry_id": "e814471c-7297-3d45-acd0-acbc9058ba05",
                                        "glosses": [
                                            "Discipline ou fonction remplie par le personnel qui réalise ces chiffrages, qu’il soit l’exécutant de la tâche estimée ou affecté uniquement à cette fonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d6da7a0-0eec-4ec2-9eed-1b41923bdc44",
                                                "sense_id": "56b01945-a85d-3385-8b66-cb8bbc20ee54",
                                                "text": "On en est où avec l’estimation du projet ?"
