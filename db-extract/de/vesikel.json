                                    {
                                        "sense_id": "acce4e5f-c840-336b-a985-fdce5c6e9a51",
                                        "entry_id": "6aafc313-7e5a-3a4b-8afc-10bb367f4fa4",
                                        "glosses": [
                                            "Sac membraneux semblable à une petite vessie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc87dcf6-60bb-4b48-884d-f9b059ce1572",
                                                "sense_id": "acce4e5f-c840-336b-a985-fdce5c6e9a51",
                                                "text": "Et n'allez pas me crever les vésicules, vous autres!"
                                            },
                                            {
                                                "example_id": "0e9ee197-2ca9-4e5c-a5b5-f848bca128d0",
                                                "sense_id": "acce4e5f-c840-336b-a985-fdce5c6e9a51",
                                                "text": "Le point de départ est une précédente étude qu'il a menée en 2018, ayant découvert que les cellules du nez libèrent des vésicules extracellulaires (VE) -- un nuage de minuscules particules attaquant les bactéries au moment de l'inhalation."
                                            },
                                            {
                                                "example_id": "1f554927-271b-433e-b487-5194b7e4afe6",
                                                "sense_id": "acce4e5f-c840-336b-a985-fdce5c6e9a51",
                                                "text": "La vésicule biliaire."
                                            },
                                            {
                                                "example_id": "c0078cfc-1e02-4b34-9b02-5cc7c98efd54",
                                                "sense_id": "acce4e5f-c840-336b-a985-fdce5c6e9a51",
                                                "text": "Le poumon est composé d’une infinité de petites vésicules."
                                            },
                                            {
                                                "example_id": "139c2fa2-ee13-4e81-9da9-5dc72c2c766a",
                                                "sense_id": "acce4e5f-c840-336b-a985-fdce5c6e9a51",
                                                "text": "Les vésicules séminales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b167dd92-9354-3988-8cb4-9cbede905d4f",
                                        "entry_id": "6aafc313-7e5a-3a4b-8afc-10bb367f4fa4",
                                        "glosses": [
                                            "Lésion cutanée, légèrement proéminente, dont la sommité plus ou moins translucide est remplie de liquide clair. Selon la taille on parle aussi de bulle et de phlyctène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3841d83f-62e4-488a-831b-aa62d19f6b2d",
                                                "sense_id": "b167dd92-9354-3988-8cb4-9cbede905d4f",
                                                "text": "Les vésicules herpétiques sont contagieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3104d3c1-6050-3792-93b7-88917667a23b",
                                        "entry_id": "6aafc313-7e5a-3a4b-8afc-10bb367f4fa4",
                                        "glosses": [
                                            "Compartiment intracellulaire de petite taille, de forme sphérique et parfois nommée granule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b0b4a0-4b77-45d9-9bcc-1178b6a6ea3a",
                                                "sense_id": "3104d3c1-6050-3792-93b7-88917667a23b",
                                                "text": "Des vésicules synaptiques."
                                            }
                                        ]
