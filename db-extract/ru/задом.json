            {
                "entry_id": "433a602a-6aec-3e7d-899e-77922eeef90f",
                "word": "задом",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "513e16e6-7de3-336d-85f5-b51555c6b0b1",
                        "entry_id": "433a602a-6aec-3e7d-899e-77922eeef90f",
