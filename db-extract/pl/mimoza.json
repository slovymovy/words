                                "target_senses": [
                                    {
                                        "sense_id": "651e55ce-bd2a-386a-8ca9-d5d3cc7ae831",
                                        "entry_id": "f90e24a8-03b9-363e-878f-1c6d072921c3",
                                        "glosses": [
                                            "die Pflanzengattung Mimosa (deutsch: Mimosen)"
                                        ],
                                        "tags": [
                                            "Biologische Taxonomie",
                                            "im Plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e97f54f-1411-3d6a-a87b-9e60ee4b6890",
                                        "entry_id": "f90e24a8-03b9-363e-878f-1c6d072921c3",
                                        "glosses": [
                                            "ein Vertreter der Mimosen, speziell eine tropische Pflanze Mimosa pudica"
                                        ],
                                        "tags": [
                                            "Botanik im Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66eaff20-3de9-4c79-b4c5-f5952dec801e",
                                                "sense_id": "8e97f54f-1411-3d6a-a87b-9e60ee4b6890",
                                                "text": "In den Tropen wächst die Mimose unter freiem Himmel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "646e02e9-dfb4-35f1-ae83-95405cf3c85a",
                                        "entry_id": "f90e24a8-03b9-363e-878f-1c6d072921c3",
                                        "glosses": [
                                            "eine Person, die empfindlich auf Kritik reagiert; eine Person, die empfindlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03b7df47-8894-4aba-a705-3ff54d68c06c",
                                                "sense_id": "646e02e9-dfb4-35f1-ae83-95405cf3c85a",
                                                "text": "Da ich eine Mimose bin, agiere ich lieber inkognito."
                                            },
                                            {
                                                "example_id": "e6bbaf87-4e15-4e26-9c99-a08b06aad6d3",
                                                "sense_id": "646e02e9-dfb4-35f1-ae83-95405cf3c85a",
                                                "text": "Was man Mimosen gegenüber auch sagt oder tut, sie interpretieren es als verletzenden Angriff auf sich selbst. Ihre Reaktion ist entweder Weltschmerz oder eine wütende Gegenattacke."
                                            },
                                            {
                                                "example_id": "01f07214-8253-4dce-916c-4fda2b90a8a5",
                                                "sense_id": "646e02e9-dfb4-35f1-ae83-95405cf3c85a",
                                                "text": "\"Nun spiel' doch nicht die beleidigte Leberwurst! Das mit der Mimose habe ich doch nicht so gemeint.\""
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
