                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82727bb-8127-4f7a-b2aa-579255852bf3",
                                                "sense_id": "26504ba3-63b8-3802-a247-7e2432f07ddc",
                                                "text": "S’il a contracté auprès des Tchékistes une légère propension au sadisme, il n’en a pas moins conservé des habitudes de civilité puérile et occidentale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d86734f-8c88-3e3f-8dfc-9c488a377547",
                                        "entry_id": "2c293714-de33-3938-a6f6-a735768b3775",
                                        "glosses": [
                                            "Membre de la police politique d’un régime communiste."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5cbd416-ab63-4462-99ce-9748a6988863",
                                                "sense_id": "3d86734f-8c88-3e3f-8dfc-9c488a377547",
                                                "text": "Les vieux tchékistes se séparent enfin, heureux d’avoir renoué avec la vieille recette de l’entrisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
