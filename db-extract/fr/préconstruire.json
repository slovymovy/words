                ],
                "senses": [
                    {
                        "sense_id": "d7f94fb6-97da-33cd-9503-64aa6f430691",
                        "entry_id": "dfc217a0-4b06-3dca-9154-63f3c7100528",
                        "glosses": [
                            "Commencer à construire, en préalable à la construction définitive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98a1fa41-4a16-424d-8152-54142deedb8e",
                                "sense_id": "d7f94fb6-97da-33cd-9503-64aa6f430691",
                                "text": "Les organismes porteurs de convention globale peuvent être tentés d'organiser l'orientation en fonction de ce qu'ils savent faire, et donc de préconstruire les itinéraires pour défendre leurs propres intérêts."
                            },
                            {
                                "example_id": "ee6a29de-7fb9-4d75-9612-b8eb76434659",
                                "sense_id": "d7f94fb6-97da-33cd-9503-64aa6f430691",
                                "text": "Cela nous paraît important pour sa socialisation, car ce contexte lui permet de se rassurer et de préconstruire, peu à peu, la base de savoir scolaire."
                            }
                        ]
                    }
                ],
