                        "glosses": [
                            "Personne qui écrit des haïkus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f07106-d65a-47f7-a93b-00e741eb2ac4",
                                "sense_id": "156b228a-0016-3a51-8a80-d2449a2fd026",
                                "text": "Le haïkiste se met à l’écoute des messages que les choses cherchent à lui envoyer. Il se laisse porter par ses rencontres avec le merveilleux inscrit dans les « banalités » de la vie."
                            },
                            {
                                "example_id": "10e4a7ff-ff42-4d4d-9538-4dad02c3be40",
                                "sense_id": "156b228a-0016-3a51-8a80-d2449a2fd026",
                                "text": "Pas plus qu’un dictionnaire des mots de saisons ne procure les émotions justes au haïkiste, les livres de recettes ne sauraient donner d’esprit à l’apprenti cuisinier."
                            }
                        ]
                    }
                ],
