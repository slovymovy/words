                    {
                        "translation_id": "0b802c08-a8b4-4e1f-9922-c67e3e829148",
                        "source_entry_id": "d615daa1-fc61-35c4-9b0c-4c5cb3140814",
                        "source_sense_description": "Rouleau de bois",
                        "target_lang_word": "коромысло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коромысло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a2bfd771-891a-309a-919a-a91f001d6bdd",
                                        "entry_id": "74a80466-3f31-3fd3-a6e2-55d6bf999a97",
                                        "glosses": [
                                            "приспособление для ручного ношения двух вёдер или других грузов в виде опираемого на плечи изогнутого шеста"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7796cab-7e2d-4cd7-a515-1ef3b0102b9f",
                                                "sense_id": "a2bfd771-891a-309a-919a-a91f001d6bdd",
                                                "text": "Та ли это Феклуша, которая в набойчатом платье выходила ко мне на огород или изгибалась под коромыслом?"
                                            },
                                            {
                                                "example_id": "faee5c41-e76a-4968-81ea-34abd526a5ca",
                                                "sense_id": "a2bfd771-891a-309a-919a-a91f001d6bdd",
                                                "text": "А я с китайскими коллегами неделю таскал на коромысле корзины с землей, помогая строить близ Пекина Шисаньлинское водохранилище."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e5d1f2b-8d5e-334c-b681-d1ff38054b04",
                                        "entry_id": "74a80466-3f31-3fd3-a6e2-55d6bf999a97",
                                        "glosses": [
                                            "техн. деталь рычажного механизма (напр. у весов)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "854b2497-aa99-480f-a3eb-43e21d486719",
                                                "sense_id": "6e5d1f2b-8d5e-334c-b681-d1ff38054b04",
                                                "text": "Мы уже заметили, как важно было определить с достаточной точностью положение поршневого стержня относительно коромысла, или, что сводится к тому же, углы параллелограма в его среднем положении."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "коромысло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11bd94d1-ca1c-3bf5-a30e-5eeaf67e5d86",
                                        "entry_id": "03edc40b-9c1a-395e-9a67-616b94a886f1",
                                        "glosses": [
                                            "зоол., мн. ч. собир. семейство крупных стрекоз"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab17783-b057-4bb4-b661-3a30abe34e3b",
                                                "sense_id": "11bd94d1-ca1c-3bf5-a30e-5eeaf67e5d86",
                                                "text": "Совсем иначе выглядят в полёте разнокрылые стрекозы, например крупные коромысла."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18cb43d0-d4a8-31e6-a9df-949a61fe9a0e",
                                        "entry_id": "03edc40b-9c1a-395e-9a67-616b94a886f1",
                                        "glosses": [
                                            "представитель одного из видов данного семейства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae26b67f-4b39-4ae8-b48a-a5b73e781554",
                                                "sense_id": "18cb43d0-d4a8-31e6-a9df-949a61fe9a0e",
                                                "text": "Перед моими глазами грозные Коромысла хватали безобидных Толкунчиков."
                                            }
                                        ]
                                    }
                                ]
                            }
