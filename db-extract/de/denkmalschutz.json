                "senses": [
                    {
                        "sense_id": "72e1e1dd-cc1b-3d47-9f26-cc1da7e458a6",
                        "entry_id": "559010d4-cc58-3b4b-9ef2-aed6e1706f34",
                        "glosses": [
                            "staatlich sichergestellter Schutz von Kulturgütern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b118e7-956e-4615-83a8-3c7f8cd6a9a8",
                                "sense_id": "72e1e1dd-cc1b-3d47-9f26-cc1da7e458a6",
                                "text": "„Alle Immobilien, die unter Denkmalschutz gestellt werden, sind in einer Denkmalliste eingetragen.“"
                            },
                            {
                                "example_id": "c387afec-a560-49da-9d3c-6a296b1d7a04",
                                "sense_id": "72e1e1dd-cc1b-3d47-9f26-cc1da7e458a6",
                                "text": "„Das Hotel stand längst unter Denkmalschutz.“"
                            },
                            {
                                "example_id": "2c1913b8-032c-4174-946e-197c0ebab2dd",
                                "sense_id": "72e1e1dd-cc1b-3d47-9f26-cc1da7e458a6",
                                "text": "„In dem Raum, in dem er steht, zerbrechen sich Innenarchitekten den Kopf, wie Denkmalschutz und Technologie sich miteinander vertragen können.“"
                            },
                            {
                                "example_id": "de9e8f8f-68f5-4b7e-8df0-65980d65026e",
                                "sense_id": "72e1e1dd-cc1b-3d47-9f26-cc1da7e458a6",
                                "text": "„Hier muss der Denkmalschutz ran, empörte sich Hugo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
