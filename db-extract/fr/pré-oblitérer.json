                    {
                        "sense_id": "4ee6a0ff-2654-3edc-934f-31a9284dc42e",
                        "entry_id": "9981d48b-9cec-30f9-a60c-ded281455750",
                        "glosses": [
                            "Apposer à l’avance (en particulier sur un timbre) une marque destinée à éviter l’oblitération ultérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b1911a9-d807-4684-b599-1c9e91463dc6",
                                "sense_id": "4ee6a0ff-2654-3edc-934f-31a9284dc42e",
                                "text": "AFFRANCHts POSTES : abréviation figurant sur la marque postale utilisés pour pré-oblitérer les timbres poste de France."
                            },
                            {
                                "example_id": "e123249a-5f35-47c9-b118-e3863e37aefe",
                                "sense_id": "4ee6a0ff-2654-3edc-934f-31a9284dc42e",
                                "text": "Apparemment le R signifierait \"recouvrement\". Souvent les timbres de recouvrement ont été pré-oblitérés avec cette marque postale."
                            },
                            {
                                "example_id": "4bc766bb-bc17-4e7c-80e0-4a7b67471ff0",
                                "sense_id": "4ee6a0ff-2654-3edc-934f-31a9284dc42e",
                                "text": "utilisation de la machine à affranchir sur des envois en nombre pour \"pré-oblitérer\" les affranchissements complémentaires (généralement pour des tarifs non possible avec la machine à affranchir, comme les tarifs pour l'étranger)."
                            }
                        ]
                    }
