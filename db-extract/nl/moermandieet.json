                        "glosses": [
                            "dieet verzonnen door Cornelis Moerman dat kanker zou kunnen genezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5a71185-1331-42d9-be15-dea4634863bd",
                                "sense_id": "427661a8-0b3b-3904-aea4-d4e63ec9e3c6",
                                "text": "„Voor mij wel. Mijn moeder was vegetariër. Dus ik leerde al vroeg dat je prima zonder vlees kunt. Er zijn genoeg alternatieven. Toen ik elf was kreeg mijn vader prostaatkanker. Mijn ouders hebben toen het Moermandieet gevolgd. Dat betekende veel zelf maken en het liefst nog je eigen olijven persen voor olie. Ze dronken vijf tot zes groentesappen per dag. Het is me echt met de paplepel ingegoten.”"
                            }
                        ]
                    }
