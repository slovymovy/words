                    "frequency": "Low",
                    "semantic_group_id": "rommel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn betoog was een vreemde <w>mikmak</w> van feiten en ongefundeerde meningen.",
                            "target_lang_translations": {
                                "en": "His argument was a strange <w>mishmash</w> of facts and unfounded opinions."
                            }
