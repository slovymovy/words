                ],
                "senses": [
                    {
                        "sense_id": "0640d4e5-e977-3c18-9c29-79029c9a18bf",
                        "entry_id": "938b26e0-727b-3fb6-83c3-46a28fc9fe17",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b644ea-105f-4f6b-852c-7388ad557f11",
                                "sense_id": "0640d4e5-e977-3c18-9c29-79029c9a18bf",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schlecker kommt, geht der Herr Schlecker.“"
                            },
                            {
                                "example_id": "9c763bae-a960-4257-9184-061134a2fe21",
                                "sense_id": "0640d4e5-e977-3c18-9c29-79029c9a18bf",
                                "text": "Schlecker kommt und geht."
                            },
                            {
                                "example_id": "2a5fd335-4f72-4220-b7c0-e1f5f51befd4",
                                "sense_id": "0640d4e5-e977-3c18-9c29-79029c9a18bf",
                                "text": "Frau Schlecker ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e4ea9264-8e95-4939-a024-b5ad56d544b9",
                                "sense_id": "0640d4e5-e977-3c18-9c29-79029c9a18bf",
                                "text": "Herr Schlecker wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6695864a-59e0-4198-86fb-c08875884350",
                                "sense_id": "0640d4e5-e977-3c18-9c29-79029c9a18bf",
                                "text": "Die Schleckers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c74eb1a6-4727-4e56-af7f-d695dc4135bf",
                                "sense_id": "0640d4e5-e977-3c18-9c29-79029c9a18bf",
                                "text": "Der Schlecker trägt nie die Schals, die die Schlecker ihm strickt."
                            },
                            {
                                "example_id": "63258a4e-882b-40ef-9946-f8414e6aba4f",
                                "sense_id": "0640d4e5-e977-3c18-9c29-79029c9a18bf",
                                "text": "Schleckers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
