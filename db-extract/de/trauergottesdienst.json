                "senses": [
                    {
                        "sense_id": "bf561eba-804f-3700-833b-79b0f6e785f3",
                        "entry_id": "884ec6db-f310-31f6-b042-33d2fe166bfb",
                        "glosses": [
                            "religiöse Feier für einen Verstorbenen oder mehrere Verstorbene, meist unmittelbar vor der Bestattung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d03caf59-b788-48ac-877f-125c4fa34b7c",
                                "sense_id": "bf561eba-804f-3700-833b-79b0f6e785f3",
                                "text": "„In der südfranzösischen Kleinstadt Trèbes ist mit einem Trauergottesdienst der vier Opfer des islamistischen Anschlags vom Freitag gedacht worden, darunter der als Held gewürdigte Polizist.“"
                            },
                            {
                                "example_id": "f0b41cdd-19b9-4ad2-806e-0bb2482656c8",
                                "sense_id": "bf561eba-804f-3700-833b-79b0f6e785f3",
                                "text": "„Der alte Pfarrer, Séra Arnljótur, hielt den Trauergottesdienst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
