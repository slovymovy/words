                {
                    "sense_id": "67ad0c50-b7bc-3942-9c64-a12acda3a040",
                    "sense_definition": "A firm hold, grip, or position that allows someone to apply power or prevents slipping.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_grip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tires could not get any <w>purchase</w> on the icy road, and the car slid sideways.",
                            "target_lang_translations": {
                                "ru": "Шины не могли найти <w>сцепления</w> с обледенелой дорогой, и машину занесло.",
                                "tr": "Lastikler buzlu yolda hiçbir şekilde <w>tutunamadı</w> ve araba yan kaydı."
                            }
                        },
                        {
                            "text": "He struggled to find a <w>purchase</w> for his hands on the smooth rock wall.",
                            "target_lang_translations": {
                                "ru": "Он изо всех сил пытался найти <w>опору</w> для рук на гладкой скальной стене.",
                                "tr": "Pürüzsüz kaya duvarında elleri için bir <w>dayanak</w> bulmakta zorlandı."
                            }
                        }
                    ],
                    "synonyms": [
