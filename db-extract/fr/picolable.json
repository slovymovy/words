                        "glosses": [
                            "Qui peut être picolé, bu, bon à boire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e952e8-8875-4fe4-a12e-a1806786bbd2",
                                "sense_id": "3fd7b565-67f3-301c-981b-2848710c1867",
                                "text": "À Duras , on a hérité des cépages bordelais . Mais le merlot descend ici de son piédestal pour devenir « picolable », à peine effleuré par des macérations courtes et légères."
                            },
                            {
                                "example_id": "91093066-9382-4a21-97fd-2fbf0277625d",
                                "sense_id": "3fd7b565-67f3-301c-981b-2848710c1867",
                                "text": "C'est très « picolable » pour ceux qui aiment. Côté arômes, il est encore un peu timide."
                            },
                            {
                                "example_id": "563ebce3-966a-47bf-b74f-8fcca0cf8aca",
                                "sense_id": "3fd7b565-67f3-301c-981b-2848710c1867",
                                "text": "Gourmandise sucrée pour adultes. 10°. Hautement picolable et à durée de vie extrêmement brève. En prendre par hectolitres sous peine d'être rapidement en rupture... Blague à part c'est très bon et extrêmement peu cher"
                            }
                        ]
                    }
