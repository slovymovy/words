                    {
                        "translation_id": "40208d1c-39e8-4d1b-a869-06539b17ba83",
                        "source_entry_id": "54f4262d-0574-36f0-8f0d-516c0c788b93",
                        "source_sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
