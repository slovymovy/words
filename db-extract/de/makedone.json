                "senses": [
                    {
                        "sense_id": "9b493079-4f92-3f24-a2df-89cafe8c00df",
                        "entry_id": "b12d8c80-fda2-3851-8048-de9901177c5b",
                        "glosses": [
                            "Staatsbürger von Makedonien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7ed45f-e75a-40c5-90c5-8eaa826bd5f7",
                                "sense_id": "9b493079-4f92-3f24-a2df-89cafe8c00df",
                                "text": "„Die Perser hatte man noch besiegt, aber den Makedonen Alexanders, die mit eisernem Marschtritt ein Weltreich in die Halbwüsten des Mittleren Osten markierten, hatten die südlich wohnenden Griechen nicht viel entgegenzusetzen.“"
                            },
                            {
                                "example_id": "ca7663cc-3e7d-4894-95a5-56f13878f619",
                                "sense_id": "9b493079-4f92-3f24-a2df-89cafe8c00df",
                                "text": "„Schließlich trat der Makedone den Rückzug an und führte sein Heer unter großen Verlusten über das Industal zurück nach Babylon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
