                ],
                "senses": [
                    {
                        "sense_id": "723c029e-9fe1-3648-9bc1-ae4357ca520c",
                        "entry_id": "65ce8960-09c5-3e71-9518-871b11ed0775",
                        "glosses": [
                            "Donner un caractère gaélique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "078e8a6a-7dec-4b32-a7c2-ccfb43a1cb6a",
                                "sense_id": "723c029e-9fe1-3648-9bc1-ae4357ca520c",
                                "text": "Finalement, elles avaient choisi de « gaéliser » simplement leurs propres prénoms."
                            },
                            {
                                "example_id": "1a10e4dc-6ae3-466f-b1de-168840631bf5",
                                "sense_id": "723c029e-9fe1-3648-9bc1-ae4357ca520c",
                                "text": "Je crois qu'il a \"gaélisé\" son prénom."
                            },
                            {
                                "example_id": "855b9d4d-a160-41fa-b0dc-dbd792377829",
                                "sense_id": "723c029e-9fe1-3648-9bc1-ae4357ca520c",
                                "text": "Il y a de l’hibernisation, quand ton ancêtre anglo-normand décida de se gaéliser, se mettant au rang des « Anglais dégénérés », adoptant la langue et les coutumes des ennemis irlandais, comme les « grands comtes », les Butler d’Ormonde, les Fitzgerald de Desmond, les Fitzgerald de Kildare."
                            }
                        ]
                    }
