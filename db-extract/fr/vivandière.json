                ],
                "senses": [
                    {
                        "sense_id": "a925fcb9-3f4a-3959-a118-647f026b2e33",
                        "entry_id": "0ba94753-b580-3f49-88de-1b16a27ce253",
                        "glosses": [
                            "Marchande autorisée à suivre un corps de troupes et à lui vendre des vivres."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9d8af0f8-6e49-491a-ad97-47ef183608d2",
                                "sense_id": "a925fcb9-3f4a-3959-a118-647f026b2e33",
                                "text": "La vivandière du régiment."
                            },
                            {
                                "example_id": "01b276dd-1a08-4255-9f96-c75c5430c0d0",
                                "sense_id": "a925fcb9-3f4a-3959-a118-647f026b2e33",
                                "text": "Le déjeuner fini, la vivandière, qui pérorait toujours, fut interrompue par une femme qui s'avançait à travers champs, et qui passa sur la route."
                            },
                            {
                                "example_id": "88eaaa69-139a-4fac-8eba-41de880c6e32",
                                "sense_id": "a925fcb9-3f4a-3959-a118-647f026b2e33",
                                "text": "Les chevaux, les soldats, les vivandières et tout l'attirail qui accompagne une armée dans l'Inde étaient groupés dans un désordre pittoresque."
                            },
                            {
                                "example_id": "a0922350-b546-4845-895a-08796f32abb6",
                                "sense_id": "a925fcb9-3f4a-3959-a118-647f026b2e33",
                                "text": "Cette vivandière est la fille d’un homme qui a été arrêté à la fin de l’Empire sur une dénonciation d’agent provocateur, et qui est mort en prison. Quand elle a entendu dire qu’il y avait des mouchards dans le tas, et qu’on allait les saigner, elle a suivi, puis commandé l’escorte."
                            },
                            {
                                "example_id": "31bea049-dc24-4215-89bb-f390f1f90fb1",
                                "sense_id": "a925fcb9-3f4a-3959-a118-647f026b2e33",
                                "text": "— Une simple tartane, servant sans doute de vivandière au Saint-Jean-Baptiste, […], parcourut tous les petits bras de mer qui précèdent le détroit de Magellan. Cette tartane fit plusieurs découvertes au large de la Terre de Feu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40ed949d-4666-43b5-9e4d-1b963eb4bc29",
                        "source_entry_id": "0ba94753-b580-3f49-88de-1b16a27ce253",
                        "source_sense_id": "a925fcb9-3f4a-3959-a118-647f026b2e33",
                        "target_lang_word": "Marketenderin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marketenderin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1c58463-91ef-38f1-a2e5-2cfac4603fd4",
                                        "entry_id": "f39e8ab4-33f7-3279-9780-87982aea438d",
                                        "glosses": [
                                            "weibliche Person, die im Gefolge einer Armee als Händlerin mitzieht"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8749bd6-d625-426f-8729-887a737b2735",
                                                "sense_id": "d1c58463-91ef-38f1-a2e5-2cfac4603fd4",
                                                "text": "„Händler und Marketenderinnen schlugen ihre Stände auf und verkauften den Soldaten, was sie begehrten.“"
                                            },
                                            {
                                                "example_id": "b52fbe85-a79b-42b5-9839-b271e36dbd46",
                                                "sense_id": "d1c58463-91ef-38f1-a2e5-2cfac4603fd4",
                                                "text": "„Man denkt beim Tross zuerst an die Marketenderin, die Mann küssen darf, wenn er den Kuss bezahlen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
