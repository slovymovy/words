                        "glosses": [
                            "Molécule médicamenteuse de type statine synthétique, de formule brute C₃₃H₃₅FN₂O₅, utilisée pour son action hypocholestérolémiante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "117fd255-016a-4c6a-aafa-80e8277f83ea",
                                "sense_id": "5f482675-12c7-37dd-92e4-dc2cd35c066d",
                                "text": "Cet essai thérapeutique majeur est le seul à avoir testé une statine (atorvastatine à 80 mg/j) en prévention de la récidive d’un AIT ou un AVC récent (moins de 6 mois) et à avoir montrer un effet significatif sur le risque de récidive d’AVC."
                            }
                        ]
                    }
