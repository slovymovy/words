                        "examples": [
                            {
                                "example_id": "fa7d66fb-2466-4562-af63-be23a954ffa8",
                                "sense_id": "759517bd-f68e-323e-b856-8845bf8a1c15",
                                "text": "„Durch den starken Zug der Sehnen entsteht bei einer Fingerfraktur häufig eine deutliche Fehlstellung des Fingers.“"
                            },
                            {
                                "example_id": "bd8597a9-59ba-46ce-9f46-1d0c0b695729",
                                "sense_id": "759517bd-f68e-323e-b856-8845bf8a1c15",
                                "text": "„Um einer Fehlstellung mit nachfolgender Arthrose im Kniegelenk vorzubeugen, wird eine Patellafraktur meistens operativ versorgt (Osteosynthese).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
