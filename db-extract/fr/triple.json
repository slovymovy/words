                "senses": [
                    {
                        "sense_id": "6efb6fa5-0916-3dec-99e6-e3826cb01119",
                        "entry_id": "a678b4f4-b554-3d6e-99d1-a14b14d54288",
                        "glosses": [
                            "Qui vaut trois fois autant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b927895e-f424-4aea-8eb7-74e5dda147a0",
                                "sense_id": "6efb6fa5-0916-3dec-99e6-e3826cb01119",
                                "text": "Triple dose."
                            },
                            {
                                "example_id": "c2a0dfc3-f258-4af8-8320-242e59c21933",
                                "sense_id": "6efb6fa5-0916-3dec-99e6-e3826cb01119",
                                "text": "Triple charge."
                            },
                            {
                                "example_id": "1ee4f225-c4f2-4cfb-b88f-fb56a776c7a8",
                                "sense_id": "6efb6fa5-0916-3dec-99e6-e3826cb01119",
                                "text": "« Que le diable embroche de sa corne le triple oison qui interrompt mon sommeil ! cria-t-il d’une voix irritée."
                            },
                            {
                                "example_id": "59c66d5e-3035-4f15-aa61-0e5f24ff7ea8",
                                "sense_id": "6efb6fa5-0916-3dec-99e6-e3826cb01119",
                                "text": "Duchotel. — Ah ! çà ! triple maladroit, tu ne peux pas te taire !"
                            }
                        ]
                    },
                    {
                        "sense_id": "98809b32-79f3-351e-a060-3547be421dbc",
                        "entry_id": "a678b4f4-b554-3d6e-99d1-a14b14d54288",
                        "glosses": [
                            "Qui est composé de trois choses pareilles ou analogues entre elles."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "fbfaf956-bed9-445f-8004-a8e68a13d470",
                                "sense_id": "98809b32-79f3-351e-a060-3547be421dbc",
                                "text": "Comme Lagardère jouait les étonnés, le fonctionnaire lui expliqua qu'une caméra de surveillance avait filmé un triple assassinat dans ce quartier."
                            },
                            {
                                "example_id": "5e8813d5-db0a-4453-a11b-0b832ead6548",
                                "sense_id": "98809b32-79f3-351e-a060-3547be421dbc",
                                "text": "Les quelques milles qui séparent Cristobal de Gatun furent vite franchis et les portes de la grande écluse triple s’ouvrirent devant moi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7acc7163-4e1d-4f33-850f-dd29de98fee7",
                        "source_entry_id": "a678b4f4-b554-3d6e-99d1-a14b14d54288",
                        "target_lang_word": "dreifach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreifach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0df3d06d-1aae-3583-8443-fd59ee8c1648",
                                        "entry_id": "96628b29-c2f3-3b80-8c75-14bae9b06dff",
                                        "glosses": [
                                            "dreimal so oft oder so viel"
                                        ],
                                        "tags": [
                                            "Vervielfältigungszahlwort"
                                        ],
                                        "examples": [
                                            {
