                                        "sense_id": "0764afda-8856-3251-a2a0-6dbc4d9f4335",
                                        "entry_id": "f1e4b9dd-b97c-380b-a316-83ede3c997bb",
                                        "glosses": [
                                            "de oorspronkelijke bewoner van een land, inboorling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dc0cdfd-9a07-4288-a451-a5358f6d9c92",
                                                "sense_id": "0764afda-8856-3251-a2a0-6dbc4d9f4335",
                                                "text": "Die man komt uit Nederland, dus hij is een autochtoon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "autochtoon",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "469f1a05-26c0-3d1b-85a2-7de3570599ce",
                                        "entry_id": "72a2f391-feb5-3880-b4ee-edfd5d294896",
                                        "glosses": [
                                            "oorspronkelijk in een bepaald gebied thuishorend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6972d193-8e33-4cb5-8043-dcb8879ae390",
                                                "sense_id": "469f1a05-26c0-3d1b-85a2-7de3570599ce",
                                                "text": "Dat is een autochtone leerling."
                                            }
