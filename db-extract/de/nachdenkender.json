                ],
                "senses": [
                    {
                        "sense_id": "c73a90ba-01c0-38ed-8694-31687391c121",
                        "entry_id": "8a5d2e90-ec54-34e0-8845-a38bdc8fdb09",
                        "glosses": [
                            "Person, die nachdenkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "430d9879-30a5-4bfb-b87d-08fe377dfeac",
                                "sense_id": "c73a90ba-01c0-38ed-8694-31687391c121",
                                "text": "„Heute verzichtet Viktor auf solche Ausbrüche, aber plötzlich setzt er sich zu Anatol an den Tisch und starrt den Nachdenkenden minutenlang selbstvergessen an.“"
                            },
                            {
                                "example_id": "156c9189-d40f-4c3d-9df1-066c11e7826a",
                                "sense_id": "c73a90ba-01c0-38ed-8694-31687391c121",
                                "text": "„Schließlich: Die Gedanken vieler professioneller Nachdenkender sind durch deren Anpassungen an institutionelle Routinen für die Öffentlichkeit so langweilig geworden, dass die gesellschaftliche Praxis oft von einem vitaleren geistigen Leben zeugt als die hauptberufliche akademische Zunft.“"
                            },
                            {
                                "example_id": "1b7754b6-66b7-49ee-90dd-e94355692580",
                                "sense_id": "c73a90ba-01c0-38ed-8694-31687391c121",
                                "text": "„Der Nachdenkende wird sich überdiess leicht überzeugen können, dass es zur Natur der Liebe gehöre, grosse Opfer dem Willen des Geliebten zu bringen, und eine starke Zuversicht zu dem, für den die ganze Seele thätig ist, in das Herz zu legen.“"
                            },
                            {
                                "example_id": "81af9813-299b-4b47-bc4b-bb284597e6fb",
                                "sense_id": "c73a90ba-01c0-38ed-8694-31687391c121",
                                "text": "„Damit soll aber nicht gesagt sein, daß das subjektive Recht auch ein objektives sei; vielmehr findet sich der Nachdenkende veranlaßt, eine größere und geringere Kapazität des Schönen, ein Plus und Minus in der Bildung des Schönheitssinns unter den Menschen zu statuiren.“"
                            },
                            {
                                "example_id": "09e1c0f0-93dd-49df-9a7c-86da79b72526",
                                "sense_id": "c73a90ba-01c0-38ed-8694-31687391c121",
                                "text": "„Auch dem nur flüchtig Beobachtenden und Nachdenkenden wird es kaum entgehen, dass im Gegensatze zu dem Gesellengrade, welcher das thätige Leben, die Lebenskunst, die menschliche Baukunst umfasst, der Meistergrad sich mit dem Menschen im Tode und nach dem Tode beschäftige, die maurerische Lehre von den letzten Dingen enthalte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
