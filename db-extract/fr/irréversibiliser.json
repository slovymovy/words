                                "example_id": "d2f4540d-259a-4a40-92ee-b0446de6af69",
                                "sense_id": "cfe24d95-1af0-3804-ac51-6cdf59b412db",
                                "text": "Indispensabiliser et irréversibiliser le Concile."
                            },
                            {
                                "example_id": "c771956e-a061-41a8-afb4-8cceb41ee692",
                                "sense_id": "cfe24d95-1af0-3804-ac51-6cdf59b412db",
                                "text": "La construction des réseaux socio-techniques consiste ainsi à construire et à irréversibiliser des associations de plus en plus nombreuses."
                            }
                        ]
