                "senses": [
                    {
                        "sense_id": "431b2cb6-6eec-3b84-b971-5290cbe06452",
                        "entry_id": "5c8de4f4-870b-3e3a-afa3-e0de31fa92f8",
                        "glosses": [
                            "buigingsvorm van een naamwoord, lidwoord of telwoord die aangeeft dat iets toebehoort aan de zo verbogen naamwoordgroep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeec7a4f-f327-466b-9f42-face3d3059f5",
                                "sense_id": "431b2cb6-6eec-3b84-b971-5290cbe06452",
                                "text": "Door aan een persoonsnaam de uitgang \"-s\" toe tevoegen, ontstaat de bezitsvorm: \"Robins neus\" is \"de neus van Robin\"."
                            },
                            {
                                "example_id": "b60d0340-fc69-4183-ae70-e152fe987fbb",
                                "sense_id": "431b2cb6-6eec-3b84-b971-5290cbe06452",
                                "text": "Of „the dog ate it’s bone”, waar bezitsvorm „its” is verwisseld met de inkorting van „it is”."
                            }
                        ]
                    },
                    {
                        "sense_id": "898c3c8b-f23b-30fa-82b2-eeba69a99d44",
                        "entry_id": "5c8de4f4-870b-3e3a-afa3-e0de31fa92f8",
                        "glosses": [
                            "elk van de theoretisch onderscheiden manieren waarop de zeggenschap over schaarse goederen kan worden geregeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e5e7505-9035-4417-97b7-184ab387b9da",
                                "sense_id": "898c3c8b-f23b-30fa-82b2-eeba69a99d44",
                                "text": "Ik kijk alleen naar de doelmatigheid, die is beslissend, dáár ligt de waarde van bezit. En die doelmatigheid bestaat alleen bij privébezit waarvoor is betaald, gespaard en geknokt. Alleen die bezitsvorm biedt de garantie dat er efficiënt werk wordt geleverd."
                            },
                            {
                                "example_id": "f9cbeb4b-7d9f-419a-a195-1e5cada18eeb",
                                "sense_id": "898c3c8b-f23b-30fa-82b2-eeba69a99d44",
                                "text": "Een antwoord op de vraag, welke nadelen er aan het particuliere vermogensbezit zijn verbonden of op de vraag of deze bezitsvorm wellicht geen belangrijke economische voordelen in zich sluit, hebben wij nergens aangetroffen."
                            }
                        ]
                    }
