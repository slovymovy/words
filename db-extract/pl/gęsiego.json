                "forms": [],
                "senses": [
                    {
                        "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                        "entry_id": "20d3ad31-b706-39e0-a4de-79a3218c3360",
                        "glosses": [
                            "single file, one after another"
                        ],
                        "tags": [
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3df3d27d-f780-45bc-978e-020468a8cdb4",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "ciągnąć gęsiego",
                                "translation": "to pull single file",
                                "english": "to pull single file"
                            },
                            {
                                "example_id": "7c7becff-c915-4cea-8b65-5664cdb4be22",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "iść gęsiego",
                                "translation": "to walk single file",
                                "english": "to walk single file"
                            },
                            {
                                "example_id": "877901c6-b7ed-4411-9e4a-bcaa9a50e1c4",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "jeździć gęsiego",
                                "translation": "to drive single file",
                                "english": "to drive single file"
                            },
                            {
                                "example_id": "ee1ca3d0-7ae1-4d9a-887d-1fd9130c6888",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "kroczyć gęsiego",
                                "translation": "to pace single file",
                                "english": "to pace single file"
                            },
                            {
                                "example_id": "2f458eef-1529-4223-8762-c4cda1b3e97b",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "maszerować gęsiego",
                                "translation": "to march single file",
                                "english": "to march single file"
                            },
                            {
                                "example_id": "9aa0eaca-4920-4c39-a641-648ec00d7946",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "podążać gęsiego",
                                "translation": "to follow single file",
                                "english": "to follow single file"
                            },
                            {
                                "example_id": "6973ea29-6ef0-4ade-9b06-c35d05940fde",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "ruszyć gęsiego",
                                "translation": "to move single file",
                                "english": "to move single file"
                            },
                            {
                                "example_id": "7da096d7-a4fd-400b-a408-677152909a8c",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "stać gęsiego",
                                "translation": "to stand single file",
                                "english": "to stand single file"
                            },
                            {
                                "example_id": "dc76134d-8f14-4a72-ad91-e9b12b5eb7ca",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "Co do mnie, z kilkunastu towarzyszami, mając za sobą dragonów, wpadliśmy na jakąś wązką drożynę, gdzie zmykać można było tylko gęsiego.",
                                "translation": "As for me, with a dozen or so companions, with the dragoons behind us, we stumbled upon a narrow path, where we could only run single file.",
                                "english": "As for me, with a dozen or so companions, with the dragoons behind us, we stumbled upon a narrow path, where we could only run single file."
                            },
                            {
                                "example_id": "110806ca-a312-4bc8-9b09-adf260742752",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "Niech półpanki i lizacze, którzy wypierając się swego szlacheckiego obozu, wolą chodzić gęsiego za naszymi oligarchami, znosić ich impertynencye i powtarzać bon mot’y, niech te półpanki zastanowią się, niech się zastanowi szlachta słabsza na duchu, olśniona majątkiem tych panów, czy oni potrafią utrzymać tradycyę polską, oni wychowani na gazetach i romansach francuskich, oni wędrowni ptacy całego świata, którzy tyle rozumieją z naszych stosunków, co dawni demagogowie, a może mniej jeszcze, bo mają interes kasty przed sobą.",
                                "translation": "Let the half-baked aristocrats and sycophants, who renouncing their noble camp, prefer to follow our oligarchs single file, endure their impertinence and repeat their bons mots, let these half-baked nobles think about it, let the nobility who are weaker in spirit, dazzled by the wealth of these gentlemen, think about whether they can maintain Polish tradition, they who were raised on French newspapers and novels, they are migratory birds of the whole world, who understand as much about our relations, as the demagogues of old, and perhaps even less, because they have the interests of their caste before them.",
                                "english": "Let the half-baked aristocrats and sycophants, who renouncing their noble camp, prefer to follow our oligarchs single file, endure their impertinence and repeat their bons mots, let these half-baked nobles think about it, let the nobility who are weaker in spirit, dazzled by the wealth of these gentlemen, think about whether they can maintain Polish tradition, they who were raised on French newspapers and novels, they are migratory birds of the whole world, who understand as much about our relations, as the demagogues of old, and perhaps even less, because they have the interests of their caste before them."
                            },
                            {
                                "example_id": "f24905c4-a2cd-44c9-b4e3-23956d76759f",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "Ludzie z dalszych folwarków szli gęsiego przez pola, ścieżkami w zbożu, które, lubo jeszcze zielone, wyrosło już tej wczesnej wiosny dość wysoko.",
                                "translation": "People from distant farms walked single file across the fields, along paths in the grain, which, although still green, had already grown quite tall in this early spring.",
                                "english": "People from distant farms walked single file across the fields, along paths in the grain, which, although still green, had already grown quite tall in this early spring."
                            },
                            {
                                "example_id": "8553eee9-82ce-4215-b681-bec0192f6c7b",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "Jechali przez las gęsiego, bo dróżka stawała się coraz węższą [węższa], potem znów bagnistą [bagnista] na uroczysku Dzierczy.",
                                "translation": "They rode through the forest single file, because the path was getting narrower, then swampy again in the Dziercz's wilderness.",
                                "english": "They rode through the forest single file, because the path was getting narrower, then swampy again in the Dziercz's wilderness."
                            },
                            {
                                "example_id": "9563dc06-e41c-4fdd-834a-8f88889e11bb",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "Gęsiego gąsieta za gąską podreptały dróżką tą grząską.",
                                "translation": "The goslings trotted single file behind the goose along the muddy path.",
                                "english": "The goslings trotted single file behind the goose along the muddy path."
                            },
                            {
                                "example_id": "d640103d-b86c-49b4-9745-c734f86bfc0b",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "Wszystkie cztery kobiety ruszyły gęsiego[,] jedna po drugiej[,] grząską ścieżką.",
                                "translation": "All four women set off single file[,] one after another[,] along the muddy path.",
                                "english": "All four women set off single file[,] one after another[,] along the muddy path."
                            },
                            {
                                "example_id": "2e53d5ce-a7da-4f02-aeeb-d3354adb2e50",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "Uciekać gęsiego, żeby nie zmiarkowali po śladach, ilu nas jest!",
                                "translation": "Run single file, so they can't tell from our tracks, how many of us there are!",
                                "english": "Run single file, so they can't tell from our tracks, how many of us there are!"
                            },
                            {
                                "example_id": "afbabf4d-9bfb-480f-bc2f-632f8489c1ce",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "Weszliśmy gęsiego na marmurowe schody.",
                                "translation": "We walked single file up the marble stairs.",
                                "english": "We walked single file up the marble stairs."
                            },
                            {
                                "example_id": "20648fba-670a-44a7-b8bd-c930ed0b7a5c",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "Ustawiła nas przed całą klasą gęsiego: mnie na przedzie, za mną Zosię, a na końcu Kasię.",
                                "translation": "She lined us up single file in front of the whole class: me at the front, Zosia behind me, and Kasia at the back.",
                                "english": "She lined us up single file in front of the whole class: me at the front, Zosia behind me, and Kasia at the back."
                            },
                            {
                                "example_id": "9be81fb1-ddec-4da7-8903-32aa7f22e1ec",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "On sam oczywiście prowadził, pozostali szli gęsiego w odpowiedniej odległości.",
                                "translation": "He led the way himself of course, the others walked single file at an appropriate distance.",
                                "english": "He led the way himself of course, the others walked single file at an appropriate distance."
                            },
                            {
                                "example_id": "2d23382b-d013-4804-a78e-ed393afab37c",
                                "sense_id": "276a7bdb-948e-356c-9f20-9c450f3f3b85",
                                "text": "Jechaliśmy pięć dni przez straszną pustynię, przez martwe bezdroża, w chmurach kurzu, które kłębiły się nie tylko za samochodem, ale również przed wozem, tak że kierowcy tracili widoczność. Jechali nie gęsiego, ale szeregiem, przez gorejącą równinę, bez dróg, bez ludzi.",
                                "translation": "We drove for five days through a terrible desert, through dead wilderness, in clouds of dust, that swirled not only behind the car but also in front of it, so that the drivers lost visibility. They did not drive single file, but in a row, across the scorching plain, without roads, without people.",
                                "english": "We drove for five days through a terrible desert, through dead wilderness, in clouds of dust, that swirled not only behind the car but also in front of it, so that the drivers lost visibility. They did not drive single file, but in a row, across the scorching plain, without roads, without people."
                            }
                        ]
                    }
