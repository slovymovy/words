                "senses": [
                    {
                        "sense_id": "08095191-c025-3df5-bb2d-5746cc670524",
                        "entry_id": "e60a7841-7ffb-3fd1-a35b-90714efd0f30",
                        "glosses": [
                            "ein kurz gehaltener Vortrag, bei dem zeitsparend die wichtigsten Dinge grob dargelegt werden, ohne dabei jedoch etwas Wichtiges wegzulassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6473eedf-4604-43db-9d9c-2d88abd2e317",
                                "sense_id": "08095191-c025-3df5-bb2d-5746cc670524",
                                "text": "Auf Tagungen werden oft Kurzvorträge verlangt."
                            },
                            {
                                "example_id": "758c7015-fd15-4bee-9797-d4357311ab36",
                                "sense_id": "08095191-c025-3df5-bb2d-5746cc670524",
                                "text": "„Inzwischen hielt Harbert einen noch etwas kurzatmigen, aber biologisch einwandfreien Kurzvortrag über die Unterschiede der grauen, schwarzen und roten Känguruhs, der Felskänguruhs und der Känguruhratten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
