                        "glosses": [
                            "Méthode d’entraînement physique qui regroupe des exercices issus de différentes disciplines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "300e5ba0-2855-449b-9f75-3bb4c86cb1f5",
                                "sense_id": "87566eaf-d0db-35f1-9c7e-8a5ed0b744d0",
                                "text": "Le cross-training ou entraînement-croisé est une méthode d'entraînement physique regroupant des exercices issus de différentes disciplines et permettant ainsi d'améliorer la performance globale. L'idée est que s'entraîner de différentes façons permet de prendre ce qu'il y a de mieux dans chaque discipline et ainsi d'être plus complet et plus performant au final."
                            }
                        ]
                    }
