{
    "word_family": [
        "regality",
        "regally",
        "regalia"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8ff8eba5-0bad-30d6-8198-0bf6657072fb",
                    "sense_definition": "Of, pertaining to, or suitable for royalty; magnificent, stately, or splendid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "royal-nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The queen entered the hall with a <w>regal</w> bearing that commanded immediate silence.",
                            "target_lang_translations": {
                                "ru": "Королева вошла в зал с <w>царственной</w> осанкой, которая мгновенно заставила всех замолчать."
                            }
                        },
                        {
                            "text": "The palace was decorated in <w>regal</w> splendor for the coronation ceremony.",
                            "target_lang_translations": {
                                "ru": "Дворец был украшен с <w>королевским</w> великолепием для церемонии коронации."
                            }
                        }
                    ],
                    "synonyms": [
                        "royal",
                        "kingly",
                        "majestic",
                        "stately"
                    ],
                    "antonyms": [
                        "plebeian",
                        "humble"
                    ],
                    "common_phrases": [
                        "regal bearing",
                        "regal splendor",
                        "regal presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к королевской власти, подобающий ей; величественный, царственный или великолепный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королевский",
                                "target_lang_sense_clarification": "относящийся к монархам"
                            },
                            {
                                "target_lang_word": "царственный",
                                "target_lang_sense_clarification": "величественный, подобающий царю"
                            },
                            {
                                "target_lang_word": "величественный",
                                "target_lang_sense_clarification": "производящий торжественное впечатление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0639fd7c-a56e-3243-aa95-c419ee7e847b",
                    "sense_definition": "Befitting a monarch; exceptionally grand, dignified, or majestic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "royal-nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She received her guests with a <w>regal</w> wave of her hand.",
                            "target_lang_translations": {
                                "ru": "Она встретила гостей <w>царственным</w> взмахом руки."
                            }
                        },
                        {
                            "text": "The actor gave a <w>regal</w> performance as the ancient emperor.",
                            "target_lang_translations": {
                                "ru": "Актер продемонстрировал <w>царственную</w> игру в роли древнего императора."
                            }
                        }
                    ],
                    "synonyms": [
                        "monarchical",
                        "princely",
                        "noble"
                    ],
                    "antonyms": [
                        "common",
                        "lowly"
                    ],
                    "common_phrases": [
                        "regal gesture",
                        "regal manner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подобающий монарху; исключительно грандиозный, исполненный достоинства или величественный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "царственный",
                                "target_lang_sense_clarification": "исполненный достоинства, как у монарха"
                            },
                            {
                                "target_lang_word": "королевский",
                                "target_lang_sense_clarification": "величественный, благородный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9ba87f6-f2bf-3d65-8eab-f8099f4b26c0",
                    "sense_definition": "A small, portable organ of the 16th and 17th centuries, whose sound is produced by brass beating reeds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musical-instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician played a historical piece on a restored <w>regal</w> from the Elizabethan era.",
                            "target_lang_translations": {
                                "ru": "Музыкант исполнил историческое произведение на отреставрированном <w>регале</w> эпохи Елизаветы."
                            }
                        },
                        {
                            "text": "Because of its portability, the <w>regal</w> was often used in outdoor religious processions.",
                            "target_lang_translations": {
                                "ru": "Благодаря своей портативности <w>регаль</w> часто использовался в религиозных процессиях на открытом воздухе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical musical instrument"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой переносной орган XVI и XVII веков, звук в котором извлекается с помощью латунных язычков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регаль",
                                "target_lang_sense_clarification": "старинный переносной орган"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b48253f5-8f90-3a48-a3ba-9f758cd7217a",
                    "sense_definition": "An organ stop of the reed family with a very short resonator, producing a distinctive buzzing tone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musical-instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organist pulled the <w>regal</w> stop to add a bright, reedy color to the chorus.",
                            "target_lang_translations": {
                                "ru": "Органист вытянул регистр <w>регаль</w>, чтобы добавить хору яркий язычковый тембр."
                            }
                        },
                        {
                            "text": "This baroque organ features a beautifully preserved <w>regal</w> stop.",
                            "target_lang_translations": {
                                "ru": "Этот барочный орган оснащен прекрасно сохранившимся регистром <w>регаль</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "regal stop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Язычковый органный регистр с очень коротким резонатором, издающий характерный жужжащий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регаль",
                                "target_lang_sense_clarification": "органный регистр"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}