        "nl-extract.jsonl": [
            {
                "entry_id": "b57a6d5f-c349-3177-a536-c0d675c49a79",
                "word": "bedroefdheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1bb822f8-3ef8-3fce-b3b6-9d70a481e89e",
                        "entry_id": "b57a6d5f-c349-3177-a536-c0d675c49a79",
                        "glosses": [
                            "het verdrietig zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c4e1251-1daf-41d0-8a87-30c26a4500c4",
                                "sense_id": "1bb822f8-3ef8-3fce-b3b6-9d70a481e89e",
                                "text": "De Nigeriaanse president Muhammadu Buhari heeft de gebeurtenis dinsdag in een reactie een “hele vervelende operationele fout” genoemd. Hij heeft naar eigen zeggen met “diepe bedroefdheid” kennis genomen van het nieuws en riep de bevolking op kalm te blijven."
                            },
                            {
                                "example_id": "bbb46b74-c810-45bc-a981-55bf89000eee",
                                "sense_id": "1bb822f8-3ef8-3fce-b3b6-9d70a481e89e",
                                "text": "Al die aandacht heeft zeker te maken met de hedendaagse, door de media verhevigde rouwrage rond beroemdheden, maar ik twijfel niet aan de oprechte bedroefdheid van de echte fans. Zij hebben iets in Bowie ontdekt waar ik kennelijk blind of ongevoelig voor was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4d69f3d-fb08-4866-9c8c-cdd46c05277b",
                        "source_entry_id": "b57a6d5f-c349-3177-a536-c0d675c49a79",
                        "source_sense_id": "1bb822f8-3ef8-3fce-b3b6-9d70a481e89e",
                        "target_lang_word": "grief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a313748-ce18-35e8-af97-ed5706214fed",
                                        "entry_id": "89399656-2061-30eb-84cc-453b1b0c8fc4",
                                        "glosses": [
                                            "Suffering, hardship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22f09ed7-b4a0-4546-8b7e-20e942a10e02",
                                                "sense_id": "7a313748-ce18-35e8-af97-ed5706214fed",
                                                "text": "The neighbour's teenage give me grief every time they see me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a70916-42fb-328c-bf5a-c8b279a17d9d",
                                        "entry_id": "89399656-2061-30eb-84cc-453b1b0c8fc4",
                                        "glosses": [
                                            "Emotional pain, generally arising from misfortune, significant personal loss, bereavement, misconduct of oneself or others, etc.; sorrow; sadness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24ed77d0-242c-4b9d-903d-baa90b273f06",
                                                "sense_id": "b6a70916-42fb-328c-bf5a-c8b279a17d9d",
                                                "text": "She was worn out from so much grief."
                                            },
                                            {
                                                "example_id": "3c056609-5afd-40e0-8459-6798b5d79a12",
                                                "sense_id": "b6a70916-42fb-328c-bf5a-c8b279a17d9d",
                                                "text": "The betrayal caused Jeff grief."
                                            },
                                            {
                                                "example_id": "e983f578-a358-4860-a35b-85f5a3b635c1",
                                                "sense_id": "b6a70916-42fb-328c-bf5a-c8b279a17d9d",
                                                "text": "And ſure, although it was invented to eaſe his mynde of griefe, there be a number of caveats therein to forewarne other young gentlemen to foreſtand with good government their folowing yl fortunes; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "419ba808-da08-3531-97d2-34154d3ac235",
                                        "entry_id": "89399656-2061-30eb-84cc-453b1b0c8fc4",
                                        "glosses": [
                                            "A cause or instance of sorrow or pain; that which afflicts or distresses; a trial."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "905ff2b2-e93d-419b-b041-dd26cbce9949",
                                                "sense_id": "419ba808-da08-3531-97d2-34154d3ac235",
                                                "text": "Surely, he hath borne our griefs, and carried our sorrows."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7871ca26-721c-341f-9af5-b1e0984c8899",
                                        "entry_id": "e3657378-572b-3203-9a9d-d31eed360c9f",
                                        "glosses": [
                                            "To deliberately harass and annoy or cause grief to other players of a game in order to interfere with their enjoyment of it; especially, to do this as one’s primary activity in the game, and especially by exploiting game mechanics without using cheats to do so, often through acts of destruction or vandalism."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bb5b0ae-aa50-4cd9-bf12-0bccf0e6f45d",
                                                "sense_id": "7871ca26-721c-341f-9af5-b1e0984c8899",
                                                "text": "While ban and his pals stand squarely in this tradition, they also stand for something new: the rise of organized griefing, grounded in online message-board communities and thick with in-jokes, code words, taboos, and an increasingly articulate sense of purpose. No longer just an isolated pathology, griefing has developed a full-fledged culture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bdc9c42-49ef-4b59-a3fb-df6ba2779f56",
                        "source_entry_id": "b57a6d5f-c349-3177-a536-c0d675c49a79",
                        "source_sense_id": "1bb822f8-3ef8-3fce-b3b6-9d70a481e89e",
                        "target_lang_word": "melancholy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melancholy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8cdfa2-3578-3200-be35-23b7fcba2341",
                                        "entry_id": "bff5e659-0944-3a3a-96af-88c5df07f6d8",
                                        "glosses": [
                                            "Black bile, formerly thought to be one of the four \\\"cardinal humours\\\" of animal bodies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22c425b3-26d4-4a76-b5ed-d6bfbfa2f18d",
                                                "sense_id": "1f8cdfa2-3578-3200-be35-23b7fcba2341",
                                                "text": "Melancholy, cold and dry, thick, black, and sour, […] is a bridle to the other two hot humours, blood and choler, preserving them in the blood, and nourishing the bones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                        "entry_id": "bff5e659-0944-3a3a-96af-88c5df07f6d8",
                                        "glosses": [
                                            "Great sadness or depression, especially of a thoughtful or introspective nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0307c175-9790-4017-abd3-f5675a01ff4d",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "My mind was troubled with deep melancholy."
                                            },
                                            {
                                                "example_id": "93c233e1-b1a2-4891-9422-369335f87292",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "I have neither the scholar’s melancholy, which is emulation; nor the musician’s, which is fantastical; nor the courtier’s, which is proud; nor the soldier’s, which is ambitious; nor the lawyer’s, which is politic; nor the lady’s, which is nice; nor the lover’s, which is all these; but it is a melancholy of mine own, compounded of many simples, extracted from many objects, and, indeed, the sundry contemplation of my travels; in which my often rumination wraps me in a most humorous sadness."
                                            },
                                            {
                                                "example_id": "ceda47bf-1209-4f90-8612-fd4d136999b5",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "\"The ancients referred melancholy to the mind, the moderns make it matter of digestion—to either case my plan applies,\" said Lady Mandeville."
                                            },
                                            {
                                                "example_id": "8b1514c4-373a-43a6-8c0f-2ad9bb567f0c",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "As to Ernest... He is quite as nervously broken down as I am but it manifests itself in different ways. His inclination is towards megalomania and mine towards melancholy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "melancholy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                        "entry_id": "62d7b7ad-cfc0-3539-978f-64a64043c1d0",
                                        "glosses": [
                                            "Affected with great sadness or depression."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9d3648-3a09-463a-a7dc-1f1e82fa1506",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "Melancholy people don't talk much."
                                            },
                                            {
                                                "example_id": "3265362c-9be8-4312-a0af-b62feb6c647b",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "[…] he is melancholy without cause, and merry against the hair: […]"
                                            },
                                            {
                                                "example_id": "dccecd0a-19b5-45e0-8b80-aa6f78492945",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. […] And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases. […]”"
                                            },
                                            {
                                                "example_id": "1c37b54e-6b07-4f1f-8006-00dddf8ccca1",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "It was the same old song / With a melancholy sound"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfc2e567-b105-491b-ac99-f653e49cc084",
                        "source_entry_id": "b57a6d5f-c349-3177-a536-c0d675c49a79",
                        "source_sense_id": "1bb822f8-3ef8-3fce-b3b6-9d70a481e89e",
                        "target_lang_word": "sadness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                                        "entry_id": "ac15c272-5d49-3adb-8727-49cfa74d24de",
                                        "glosses": [
                                            "The state or emotion of being sad."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e07580aa-a47f-4349-b65a-abc674ac5ece",
                                                "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                                                "text": "But sorrow that is couch'd in seeming gladness\nIs like that mirth fate turns to sudden sadness."
                                            },
                                            {
                                                "example_id": "635136ab-677a-4e81-92dc-c659f2196f40",
                                                "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                                                "text": "I mean not then under the name of Sadneſs to defend effeminate Bewailings and Lamentations; let them that ſubject themſelves to this weakeſt Impatience, be alſo ſubject to the Lycian Law, that bound theſe kind of Lamenters to be array'd like Women: […]"
                                            },
                                            {
                                                "example_id": "b210ade1-7964-4c4f-9e08-9bcef0103b4a",
                                                "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                                                "text": "The survey found increasing mental health challenges, experiences of violence, and suicidal thoughts and behavior among all teens. More than 40% of high school students said that feelings of sadness or hopelessness prevented them from engaging in their regular activities for at least two weeks of the year."
                                            },
                                            {
                                                "example_id": "edb94245-8cde-40f7-8baa-6fa207e904ad",
                                                "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                                                "text": "The compassion to yourself comes in validating the feelings your inner child is having –– the stress, fear, anger or sadness — and make adult decisions about the best way to move forward, Lev said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e926c19d-a8e5-331a-ae79-fa68c061dd32",
                                        "entry_id": "ac15c272-5d49-3adb-8727-49cfa74d24de",
                                        "glosses": [
                                            "An event in one's life that causes sadness."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "737b3017-46d7-48bf-b3e5-0f26066559ff",
                                                "sense_id": "e926c19d-a8e5-331a-ae79-fa68c061dd32",
                                                "text": "She has experienced many sadnesses in her forty years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91684a1c-08b7-4405-8046-c416e49e3d5b",
                        "source_entry_id": "b57a6d5f-c349-3177-a536-c0d675c49a79",
                        "source_sense_id": "1bb822f8-3ef8-3fce-b3b6-9d70a481e89e",
                        "target_lang_word": "sorrow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6cc4304-d6c9-3233-8f4a-67090f2b6003",
                                        "entry_id": "b2a0a8d7-d1d3-3157-a49d-5d054f27ae89",
                                        "glosses": [
                                            "unhappiness, woe"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd3c33b6-3c18-4638-8904-1214c72be18f",
                                                "sense_id": "a6cc4304-d6c9-3233-8f4a-67090f2b6003",
                                                "text": "But sorrow that is couch'd in seeming gladness\nIs like that mirth fate turns to sudden sadness."
                                            },
                                            {
                                                "example_id": "1bd0748b-d417-4b75-9260-63ba14221604",
                                                "sense_id": "a6cc4304-d6c9-3233-8f4a-67090f2b6003",
                                                "text": "The safe and general antidote against sorrow is employment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39ef67ae-34ca-3fae-ab96-b7c59281eaea",
                                        "entry_id": "b2a0a8d7-d1d3-3157-a49d-5d054f27ae89",
                                        "glosses": [
                                            "(usually in plural) An instance or cause of unhappiness."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1775e540-5abc-412d-b66a-ef94ae635b4b",
                                                "sense_id": "39ef67ae-34ca-3fae-ab96-b7c59281eaea",
                                                "text": "Parting is such sweet sorrow."
                                            },
                                            {
                                                "example_id": "9547d6a3-6dd9-4130-b50d-eb2cfcaf6d3d",
                                                "sense_id": "39ef67ae-34ca-3fae-ab96-b7c59281eaea",
                                                "text": "She had nursed all the children, including Sandro, to whom she was devoted, and my husband was just as fond of her. His going away to America was a great sorrow to her, and she always kept the sacred light burning on a little altar for Sandro all the time of his long absence."
                                            },
                                            {
                                                "example_id": "4ceddda7-533a-4797-bc2e-d1c2fdae5c88",
                                                "sense_id": "39ef67ae-34ca-3fae-ab96-b7c59281eaea",
                                                "text": "Vaublanc, in San Domingo so sympathetic to the sorrows of labour in France, had to fly from Paris in August, 1792, to escape the wrath of the French workers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sorrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54732213-7918-3160-a671-5a3b210887c5",
                                        "entry_id": "ccfb745d-5017-3062-a5a2-fc2e9c9d74bc",
                                        "glosses": [
                                            "To feel or express grief."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0347e1de-de76-4450-9e73-8183daf2c858",
                                                "sense_id": "54732213-7918-3160-a671-5a3b210887c5",
                                                "text": "‘Sorrow not, sir,’ says he, ‘like those without hope.’"
                                            },
                                            {
                                                "example_id": "9ecbfb5e-bc3a-45d1-bd56-c53aff87300f",
                                                "sense_id": "54732213-7918-3160-a671-5a3b210887c5",
                                                "text": "When, as sometimes happens, a lad dies from the effect of the operation, he is buried secretly in the forest, and his sorrowing mother is told that the monster has a pig's stomach as well as a human stomach, and that unfortunately her son slipped into the wrong stomach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2dab8a4-a66b-374e-87b6-495d693df886",
                                        "entry_id": "ccfb745d-5017-3062-a5a2-fc2e9c9d74bc",
                                        "glosses": [
                                            "To feel grief over; to mourn, regret."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "715281b2-d4d5-4caf-ae15-54f4fecb7f2a",
                                                "sense_id": "d2dab8a4-a66b-374e-87b6-495d693df886",
                                                "text": "It is impossible to make a man naturally blind, to conceive that he seeth not; impossible to make him desire to see, and sorrow his defect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
