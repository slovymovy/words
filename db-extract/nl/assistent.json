                "senses": [
                    {
                        "sense_id": "5389bf1d-b1ac-3c21-bd46-1163718f561e",
                        "entry_id": "f15abc7e-9025-3e5f-991c-f99baa244ee4",
                        "glosses": [
                            "een mannelijk of vrouwelijk persoon die ondersteunt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd779fb-f5da-45b1-97da-fb566dc51a9a",
                                "sense_id": "5389bf1d-b1ac-3c21-bd46-1163718f561e",
                                "text": "Zijn assistent zorgde voor het maken van een nieuwe afspraak."
                            },
                            {
                                "example_id": "284ba28f-78e3-4466-83ef-be2ed61a9e97",
                                "sense_id": "5389bf1d-b1ac-3c21-bd46-1163718f561e",
                                "text": "Hij is de assistent van de burgemeester."
                            },
                            {
                                "example_id": "b61ecea8-07e8-410f-88b0-6f1b81ecf938",
                                "sense_id": "5389bf1d-b1ac-3c21-bd46-1163718f561e",
                                "text": "Hij was gekleed in een uniform met de aanduidingen van de SOE en de rang van sergeant, gedoucht en geschoren toen hij op de afrondende afspraak verscheen met kolonel Grumpy, zoals iedereen de chef noemde, en zijn twee assistenten."
                            },
                            {
                                "example_id": "bbfcf34d-16fd-4aae-8e43-dc9a3f2b31f7",
                                "sense_id": "5389bf1d-b1ac-3c21-bd46-1163718f561e",
                                "text": "Hij zou de uitslag van het laboratorium telefonisch krijgen, maar twee weken later belt de assistent met de vraag of de afspraak in het ziekenhuis kan plaatsvinden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
