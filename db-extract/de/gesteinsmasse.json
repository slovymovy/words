                            {
                                "example_id": "27f64f38-9784-4946-9c71-7ca3aa430e94",
                                "sense_id": "f5af32be-cad8-33b5-b47b-b0c93660349b",
                                "text": "„Die Halde hinten am Strand, wo die gesprengten Gesteinsmassen abgelagert worden waren, verschwand als Erstes.“"
                            },
                            {
                                "example_id": "c8277dbf-65fd-47a5-a713-859067a05d17",
                                "sense_id": "f5af32be-cad8-33b5-b47b-b0c93660349b",
                                "text": "„Als die Gesteinsmassen ins Wasser stürzten, schlugen sie unfassbare 200 Meter hohe Wellen – höher als der Kölner Dom.“"
                            }
                        ],
