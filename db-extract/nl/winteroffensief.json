                                "example_id": "48c31571-f116-44fe-9e09-d75bb27fe1bd",
                                "sense_id": "02c30d5b-05cf-3037-bf35-42285443308b",
                                "text": "Het is een kortstondig winteroffensief dat Berkelland in een mooi wit kleed hulde. Vandaag is daar nog volop van te genieten. Ook gisteren, met sneeuwbuien, dooi en zon, leverde het echte winterse taferelen op."
                            },
                            {
                                "example_id": "4d8b158d-44be-4550-8f68-a1c27770a994",
                                "sense_id": "02c30d5b-05cf-3037-bf35-42285443308b",
                                "text": "Het winteroffensief sloeg gisteren eerst toe in de Vogezen en het Zwarte Woud en veroverde vervolgens heel Duitsland."
                            }
                        ]
                    },
                    {
                        "sense_id": "73cc69de-43d8-3489-b135-5ca0c6978f0d",
