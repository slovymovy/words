                {
                    "sense_id": "037d51b1-c516-3883-8f28-298af4762365",
                    "sense_definition": "Großes Becken an Wasserstraßen mit verschließbaren Toren, mit dem Schiffe Niveauunterschiede im Wasserstand überwinden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wasserbau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Schiff musste vor der Weiterfahrt noch eine <w>Schleuse</w> passieren."
                        },
                        {
                            "text": "Wegen der Bauarbeiten an der <w>Schleuse</w> stauten sich viele Schiffe auf dem Kanal."
                        }
                    ],
                    "common_phrases": [
                        "in die Schleuse einfahren",
                        "eine Schleuse passieren"
                    ]
                },
                {
                    "sense_id": "a635b486-84a6-39ce-b21a-7da282281d5e",
                    "sense_definition": "Abgetrennter Raum zwischen zwei Bereichen mit unterschiedlichen Bedingungen zum Schutz vor Verunreinigungen oder Gefahren.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bevor die Ärzte den Operationssaal betreten dürfen, müssen sie durch eine spezielle <w>Schleuse</w> gehen."
                        },
                        {
                            "text": "Im Labor sorgt die <w>Schleuse</w> dafür, dass keine gefährlichen Keime nach außen gelangen."
                        }
                    ],
                    "common_phrases": [
