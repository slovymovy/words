{
    "word_family": [
        "reference",
        "referral",
        "referee",
        "referent",
        "referable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "71a595c5-0c9a-31ce-af94-d072e652be9f",
                    "sense_definition": "To mention something or direct attention to it during a conversation or in writing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker did not <w>refer</w> to the recent scandal during his presentation.",
                            "target_lang_translations": {
                                "ru": "Докладчик не <w>упоминал</w> о недавнем скандале во время своего выступления.",
                                "tr": "Konuşmacı, sunumu sırasında son skandaldan <w>bahsetmedi</w>."
                            }
                        },
                        {
                            "text": "Please <w>refer</w> to the notes at the bottom of the page for more details.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>обратитесь</w> к примечаниям внизу страницы для получения более подробной информации.",
                                "tr": "Daha fazla ayrıntı için lütfen sayfanın altındaki notlara <w>başvurun</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "direct"
                    ],
                    "common_phrases": [
                        "refer to the notes",
                        "refer to the manual"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упоминать что-либо или привлекать к этому внимание в разговоре или письме.",
                        "tr": "Konuşma veya yazı sırasında bir şeye değinmek veya dikkat çekmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссылаться",
                                "target_lang_sense_clarification": "на источник или информацию"
                            },
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "к документам или заметкам"
                            },
                            {
                                "target_lang_word": "упоминать",
                                "target_lang_sense_clarification": "в речи или тексте"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bahsetmek",
                                "target_lang_sense_clarification": "bir konudan veya kişiden"
                            },
                            {
                                "target_lang_word": "değinmek",
                                "target_lang_sense_clarification": "bir meseleye dokunmak"
                            },
                            {
                                "target_lang_word": "başvurmak",
                                "target_lang_sense_clarification": "kaynağa veya notlara"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7afd7c7f-cbc0-38da-8044-965cb79ba5d1",
                    "sense_definition": "To have a specific meaning or to denote a particular person, place, or thing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term Big Apple <w>refers</w> to New York City.",
                            "target_lang_translations": {
                                "ru": "Термин «Большое яблоко» <w>относится</w> к Нью-Йорку.",
                                "tr": "Big Apple terimi New York şehrini <w>kastedmektedir</w>."
                            }
                        },
                        {
                            "text": "In this context, the pronoun they <w>refers</w> to the students mentioned earlier.",
                            "target_lang_translations": {
                                "ru": "В данном контексте местоимение «они» <w>обозначает</w> упомянутых ранее студентов.",
                                "tr": "Bu bağlamda \"onlar\" zamiri daha önce adı geçen öğrencileri <w>ifade eder</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "refers to the city",
                        "refers to the person"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь конкретное значение или обозначать определенного человека, место или предмет.",
                        "tr": "Belirli bir anlama gelmek veya belli bir kişiyi, yeri veya şeyi ifade etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "относиться",
                                "target_lang_sense_clarification": "к кому-либо или чему-либо"
                            },
                            {
                                "target_lang_word": "означать",
                                "target_lang_sense_clarification": "конкретное понятие"
                            },
                            {
                                "target_lang_word": "иметь в виду",
                                "target_lang_sense_clarification": "указывать на объект"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kastetmek",
                                "target_lang_sense_clarification": "belirli bir kişiyi veya şeyi"
                            },
                            {
                                "target_lang_word": "anlamına gelmek",
                                "target_lang_sense_clarification": "ifade etmek"
                            },
                            {
                                "target_lang_word": "işaret etmek",
                                "target_lang_sense_clarification": "belirtmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9243ecc2-ce85-340b-a8c8-a80b0f25f424",
                    "sense_definition": "To send or direct a person or a matter to another person or group for professional help or a decision.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "directing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My family doctor decided to <w>refer</w> me to a specialist for further tests.",
                            "target_lang_translations": {
                                "ru": "Мой лечащий врач решил <w>направить</w> меня к специалисту для дальнейшего обследования.",
                                "tr": "Aile hekimim, daha ileri tetkikler için beni bir uzmana <w>sevk etmeye</w> karar verdi."
                            }
                        },
                        {
                            "text": "The committee will <w>refer</w> the matter to the board of directors for a final vote.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>передаст</w> этот вопрос на рассмотрение совету директоров для окончательного голосования.",
                                "tr": "Komite, son oylama için konuyu yönetim kuruluna <w>havale edecek</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "send",
                        "delegate"
                    ],
                    "common_phrases": [
                        "refer a patient",
                        "refer the matter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять человека или дело к другому лицу или группе для получения профессиональной помощи или принятия решения.",
                        "tr": "Bir kişiyi veya konuyu profesyonel yardım veya karar için başka bir kişiye veya gruba yönlendirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "к специалисту или в инстанцию"
                            },
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "вопрос на рассмотрение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sevk etmek",
                                "target_lang_sense_clarification": "hastayı bir uzmana"
                            },
                            {
                                "target_lang_word": "yönlendirmek",
                                "target_lang_sense_clarification": "bir kişiyi veya konuyu"
                            },
                            {
                                "target_lang_word": "havale etmek",
                                "target_lang_sense_clarification": "karar için yetkiliye"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfb4087c-7c9a-3a64-9598-798aea843d79",
                    "sense_definition": "To relate to or be about something; to allude to a specific subject.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law does not <w>refer</w> to cases that occurred before its passing.",
                            "target_lang_translations": {
                                "ru": "Новый закон не <w>касается</w> случаев, произошедших до его принятия.",
                                "tr": "Yeni kanun, kabul edilmesinden önce meydana gelen durumları <w>kapsamamaktadır</w>."
                            }
                        },
                        {
                            "text": "The recipe <w>referred</w> to several unusual ingredients that were hard to find.",
                            "target_lang_translations": {
                                "ru": "В рецепте <w>упоминались</w> несколько необычных ингредиентов, которые было трудно найти.",
                                "tr": "Tarifte, bulunması zor olan birkaç alışılmadık malzemeden <w>bahsediliyordu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "refer to ingredients",
                        "refer to cases"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь отношение к чему-либо или касаться определенной темы.",
                        "tr": "Bir şeyle ilgili olmak veya belirli bir konuya atıfta bulunmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "касаться",
                                "target_lang_sense_clarification": "темы или случая"
                            },
                            {
                                "target_lang_word": "относиться",
                                "target_lang_sense_clarification": "к фактам или данным"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ilgili olmak",
                                "target_lang_sense_clarification": "bir konuyla"
                            },
                            {
                                "target_lang_word": "kapsamak",
                                "target_lang_sense_clarification": "durumları kapsamak"
                            },
                            {
                                "target_lang_word": "atıfta bulunmak",
                                "target_lang_sense_clarification": "konuya değinmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27b99f1f-2b6d-329d-9f14-ab280651f51b",
                    "sense_definition": "To point to a specific location in computer memory or to a specific object in programming.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pointer in the code <w>refers</w> to the variable stored in the heap.",
                            "target_lang_translations": {
                                "ru": "Указатель в коде <w>ссылается</w> на переменную, хранящуюся в куче.",
                                "tr": "Koddaki işaretçi, yığında saklanan değişkene <w>işaret eder</w>."
                            }
                        },
                        {
                            "text": "The compiler must know the number of bytes to which a pointer <w>refers</w> to function correctly.",
                            "target_lang_translations": {
                                "ru": "Компилятор должен знать количество байтов, на которые <w>указывает</w> указатель, для корректной работы.",
                                "tr": "Derleyicinin doğru çalışabilmesi için bir işaretçinin <w>gösterdiği</w> bayt sayısını bilmesi gerekir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "refer to the variable",
                        "pointer refers to"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывать на определенный адрес в памяти компьютера или на объект в программировании.",
                        "tr": "Bilgisayar belleğindeki belirli bir adrese veya programlamadaki bir nesneye işaret etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссылаться",
                                "target_lang_sense_clarification": "на адрес или переменную"
                            },
                            {
                                "target_lang_word": "указывать",
                                "target_lang_sense_clarification": "о значении указателя"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "işaret etmek",
                                "target_lang_sense_clarification": "bellek adresine"
                            },
                            {
                                "target_lang_word": "referans vermek",
                                "target_lang_sense_clarification": "değişkene veya nesneye"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "013d9276-2a41-3268-8aa7-9e4302e6441c",
                    "sense_definition": "To require a student to retake an examination because their marks were unsatisfactory.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Because his final essay was plagiarized, the university decided to <w>refer</w> him.",
                            "target_lang_translations": {
                                "ru": "Поскольку его итоговое эссе было плагиатом, университет решил <w>отправить его на пересдачу</w>.",
                                "tr": "Bitirme ödevi intihal içerdiği için üniversite onu <w>bütünlemeye bırakmaya</w> karar verdi."
                            }
                        },
                        {
                            "text": "Smith's marks in the finals were unsatisfactory and he was <w>referred</w> for the summer session.",
                            "target_lang_translations": {
                                "ru": "Оценки Смита на экзаменах были неудовлетворительными, и его <w>отправили на пересдачу</w> на летнюю сессию.",
                                "tr": "Smith'in final notları yetersizdi ve yaz dönemi için <w>bütünlemeye bırakıldı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправлять студента на пересдачу экзамена из-за неудовлетворительных оценок.",
                        "tr": "Notları yetersiz olduğu için bir öğrenciyi sınava tekrar sokmak veya bütünlemeye bırakmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отправлять на пересдачу",
                                "target_lang_sense_clarification": "экзамена или курса"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bütünlemeye bırakmak",
                                "target_lang_sense_clarification": "öğrenciyi sınava tekrar sokmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec6cd30a-c2b9-3b17-9ab3-3c8b1f565830",
                    "sense_definition": "A short note or blurb on the front page of a newspaper that directs the reader to a full story inside.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "journalism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor placed a small <w>refer</w> on the front page to highlight the investigative report.",
                            "target_lang_translations": {
                                "ru": "Редактор разместил небольшую <w>ссылку-анонс</w> на первой полосе, чтобы привлечь внимание к расследованию.",
                                "tr": "Editör, araştırma haberine dikkat çekmek için ön sayfaya küçük bir <w>yönlendirme notu</w> yerleştirdi."
                            }
                        },
                        {
                            "text": "A <w>refer</w> on page 1 of the edition contained incorrect information about the main story.",
                            "target_lang_translations": {
                                "ru": "<w>Анонс</w> на первой странице выпуска содержал неверную информацию об основном материале.",
                                "tr": "Baskının 1. sayfasındaki bir <w>iç sayfa duyurusu</w>, ana haber hakkında yanlış bilgiler içeriyordu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "refer on page"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "journalism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая заметка на первой полосе газеты, отсылающая читателя к полному материалу внутри номера.",
                        "tr": "Gazetelerin ilk sayfasında yer alan ve okuyucuyu içerideki tam habere yönlendiren kısa not veya yönlendirme yazısı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анонс-ссылка",
                                "target_lang_sense_clarification": "газетный термин"
                            },
                            {
                                "target_lang_word": "отсылка",
                                "target_lang_sense_clarification": "к материалу внутри издания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yönlendirme notu",
                                "target_lang_sense_clarification": "gazetecilik terimi"
                            },
                            {
                                "target_lang_word": "iç sayfa duyurusu",
                                "target_lang_sense_clarification": "gazetede haber yönlendirmesi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}