                    {
                        "sense_id": "77fcd364-79d1-34fe-8285-3a51e95745fa",
                        "entry_id": "a6ef6975-4651-329c-88da-b558f24ad1a7",
                        "glosses": [
                            "Gigoter."
                        ],
                        "tags": [
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "e1c0dc7f-8672-49f1-b0d4-978341e7d855",
                                "sense_id": "77fcd364-79d1-34fe-8285-3a51e95745fa",
                                "text": "Ce n’est plus l’asticot aux tons d’ivoire, bien en chair, appétissant, qui gigaude sur l’assiette, et qu’on savoure avec délices, mais une espèce de pelure grisâtre : ce je ne sais quoi qui n’a plus de nom dans aucune langue, dont parle Bossuet."
                            }
                        ]
                    }
