                        "sense_id": "8a1fc70c-7516-30aa-a4d7-02469b9036a6",
                        "entry_id": "bfddd8f9-16f6-399a-bcd0-9716e03fb56e",
                        "glosses": [
                            "zahmes Huhn; besonders wegen seiner Eier gehaltener Hühnervogel mit roten Kamm auf dem Kopf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23f98b52-a1cb-4611-98e3-90417b9ba034",
                                "sense_id": "8a1fc70c-7516-30aa-a4d7-02469b9036a6",
                                "text": "„Das Haushuhn (Gallus gallus domesticus) stammt von einem südostasiatischen Wildhuhn ab, dem Bankivahuhn (Gallus gallus).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
