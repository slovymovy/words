                    {
                        "sense_id": "f3e06d55-44c3-36fd-8244-f17eb41f21d5",
                        "entry_id": "eb133c8f-d804-30fe-86b1-3918653b2a85",
                        "glosses": [
                            "Person, die das Kartenspiel Poker spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f12a6f1-978e-49c4-82cf-2ab79db06849",
                                "sense_id": "f3e06d55-44c3-36fd-8244-f17eb41f21d5",
                                "text": "Der Pokerspieler freute sich über seinen Gewinn."
                            },
                            {
                                "example_id": "387298ad-74f1-426d-94a7-66d8f8e7e190",
                                "sense_id": "f3e06d55-44c3-36fd-8244-f17eb41f21d5",
                                "text": "„Dewey Tomkoist ist ein US-amerikanischer früherer Pädagoge und jetziger professioneller Pokerspieler.“"
                            },
                            {
                                "example_id": "38154e36-7913-4ae5-9c3f-02a034073c94",
                                "sense_id": "f3e06d55-44c3-36fd-8244-f17eb41f21d5",
                                "text": "„Ich wußte, daß er zu bluffen versuchte, und begegnete ihm mit dem freundlichen Gesicht eines Pokerspielers, der sich seines Gewinns sicher ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
