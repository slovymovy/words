                    {
                        "sense_id": "eecb32ca-c28c-3f65-ada0-28b432ca5874",
                        "entry_id": "7dedc2c5-b9a4-3663-a1d0-00f147235cf8",
                        "glosses": [
                            "een snaarinstrument met een peervormige resonantiekast en een vlak bovenblad, de hals en kop staan meestal haaks op elkaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0420429-5508-47bf-87aa-13f4322a35eb",
                                "sense_id": "eecb32ca-c28c-3f65-ada0-28b432ca5874",
                                "text": "De luit is een tokkelinstrument."
                            },
                            {
                                "example_id": "488f36cd-1bd7-4372-a590-3d727e38a80f",
                                "sense_id": "eecb32ca-c28c-3f65-ada0-28b432ca5874",
                                "text": "Ze had met succes op haar luit gespeeld en zich verzekerd van een echtgenoot uit de stad, een Amsterdammer wiens familie aan de Herengracht op haar wachtte."
                            },
                            {
                                "example_id": "81c8993f-3d37-40e3-830b-e8f26a51f887",
                                "sense_id": "eecb32ca-c28c-3f65-ada0-28b432ca5874",
                                "text": "Zing en dans tezamen en wees blij, maar wees ieder alleen, zoals de snaren van een luit op zichzelf zijn, al doortrilt hen dezelfde muziek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ba25819-4020-449e-a826-e1e8037bf534",
                        "source_entry_id": "7dedc2c5-b9a4-3663-a1d0-00f147235cf8",
                        "source_sense_id": "eecb32ca-c28c-3f65-ada0-28b432ca5874",
