                {
                    "sense_id": "cb2d7a8d-178b-3153-b7a0-e3efc1b0806a",
                    "sense_definition": "Petite construction rudimentaire, faite de matériaux simples comme le bois, servant de logement de fortune ou d'abri.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "habitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants ont construit une petite <w>cabane</w> au fond du jardin pour jouer."
                        },
                        {
                            "text": "Nous avons trouvé une <w>cabane</w> en bois abandonnée pour nous abriter de la pluie."
                        }
                    ],
                    "synonyms": [
                        "hutte",
                        "cahute",
                        "abri"
                    ],
                    "common_phrases": [
