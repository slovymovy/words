                ],
                "translations": [
                    {
                        "translation_id": "211ee14e-c2d9-4457-8c88-3d6448655873",
                        "source_entry_id": "f443c903-2f09-312b-9017-a44c2467f0de",
                        "source_sense_id": "9f9a3298-5b7a-3800-97f1-367839bf494d",
                        "source_sense_description": "destroy by phagosytosis",
                        "target_lang_word": "phagocyter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phagocyter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41dd580d-36c4-301f-ba34-54a896e4ddea",
                                        "entry_id": "ab986cc6-1f71-38dc-a17c-d4088ce68481",
                                        "glosses": [
                                            "Détruire par phagocytose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584347fb-e55d-497a-a0e0-f91540c52eb9",
                                                "sense_id": "41dd580d-36c4-301f-ba34-54a896e4ddea",
                                                "text": "Des leucocytes, vivant dans des flacons, phagocytent des microbes et des globules rouges, bien qu'ils n'aient pas à défendre le corps contre les incursions de ces étrangers."
                                            },
                                            {
                                                "example_id": "ef9e63a1-ea50-4861-a713-1f45ae640d17",
                                                "sense_id": "41dd580d-36c4-301f-ba34-54a896e4ddea",
                                                "text": "Les éléments phagocytés sont soit des cellules en désintégration, soit des bactéries, soit des granules divers en suspension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb9552a-d340-3b6b-8466-f145bf0ec3b7",
                                        "entry_id": "ab986cc6-1f71-38dc-a17c-d4088ce68481",
                                        "glosses": [
                                            "Absorber sans vergogne."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09704cfc-f525-44ad-8daf-b278b1306633",
                                                "sense_id": "dcb9552a-d340-3b6b-8466-f145bf0ec3b7",
                                                "text": "L'entreprise est devenue un monopole en phagocytant ses concurrents."
                                            },
                                            {
                                                "example_id": "6aa3fe9b-be93-4466-a7ab-88b9fe298d3f",
                                                "sense_id": "dcb9552a-d340-3b6b-8466-f145bf0ec3b7",
                                                "text": "L’Amérique a du mal à admettre l’existence du jazz autrement qu’en le digérant, en le phagocytant, et en le dépossédant de ses origines. Vieille arnaque du melting-pot."
                                            },
                                            {
                                                "example_id": "e3055c22-f9cd-4c4c-aa07-4bcd96a7b334",
                                                "sense_id": "dcb9552a-d340-3b6b-8466-f145bf0ec3b7",
                                                "text": "L'économisme triomphant encourage l'oubli de cette réalité, ce qui se traduit entre autres par une haine de la taxation et un mépris du pauvre, qui serait seul responsable de son sort et phagocyterait les richesses produites par d'autres."
                                            },
                                            {
                                                "example_id": "e0025440-a8eb-41c1-aead-dd2b53a2ebc3",
                                                "sense_id": "dcb9552a-d340-3b6b-8466-f145bf0ec3b7",
                                                "text": "Et pour lutter contre l'anglomanie qui défigure les rues et phagocyte les publicités, ils demandent « que l'État encourag[e] les appellations françaises pour baptiser de nouveaux produits et services …. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3954139e-efa6-4e79-92d6-4a96c7377a50",
                        "source_entry_id": "f443c903-2f09-312b-9017-a44c2467f0de",
                        "source_sense_id": "9f9a3298-5b7a-3800-97f1-367839bf494d",
                        "source_sense_description": "destroy by phagosytosis",
                        "target_lang_word": "engloutir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engloutir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ebe02f6-b2cc-3d2b-81d2-eb79cd1e43d7",
                                        "entry_id": "7fb6c90b-d9f8-37f9-b648-bc9817825d9d",
                                        "glosses": [
                                            "Avaler gloutonnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b9371c-a2b5-4190-a4ef-6db5d7bf7ac0",
                                                "sense_id": "3ebe02f6-b2cc-3d2b-81d2-eb79cd1e43d7",
                                                "text": "Il tenait levée une pleine fourchette de haricots qu'il allait engloutir."
                                            },
                                            {
                                                "example_id": "1dbe0532-3ccf-4748-b8d2-d29793a57b74",
                                                "sense_id": "3ebe02f6-b2cc-3d2b-81d2-eb79cd1e43d7",
                                                "text": "Pendant les trois semaines précédant le Carême 1667, la maison de la princesse Palatine aura ainsi englouti 200 unités vendues par le marchand de volailles, dont une quinzaine de chapons et autant de chapons gras."
                                            },
                                            {
                                                "example_id": "af5849e0-7ee5-4329-82f2-e361a79207ce",
                                                "sense_id": "3ebe02f6-b2cc-3d2b-81d2-eb79cd1e43d7",
                                                "text": "Un gros brochet engloutit une carpe tout entière."
                                            },
                                            {
                                                "example_id": "6de1a44f-efc3-4e5f-805c-8d6e468be734",
                                                "sense_id": "3ebe02f6-b2cc-3d2b-81d2-eb79cd1e43d7",
                                                "text": "Il ne mange pas, il engloutit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1aace11-b04a-3fcc-a2d1-21f612503d04",
                                        "entry_id": "7fb6c90b-d9f8-37f9-b648-bc9817825d9d",
                                        "glosses": [
                                            "Consumer des biens, en parlant de la fortune."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "852f4641-994d-4281-b5bb-653410d687cc",
                                                "sense_id": "c1aace11-b04a-3fcc-a2d1-21f612503d04",
                                                "text": "Il a englouti en peu de temps cette riche succession."
                                            },
                                            {
                                                "example_id": "7e1287c1-c039-455d-a5f1-1a80a340cf4a",
                                                "sense_id": "c1aace11-b04a-3fcc-a2d1-21f612503d04",
                                                "text": "La faillite de cette banque a englouti les économies de beaucoup de gens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51706fe3-6178-381f-8c3b-8d46b6e4f8f6",
                                        "entry_id": "7fb6c90b-d9f8-37f9-b648-bc9817825d9d",
                                        "glosses": [
                                            "Engouffrer, faire disparaître dans un gouffre, dans un abîme ; submerger."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcbbd74b-d7ae-4cc0-95e4-4f4258ee7d9e",
                                                "sense_id": "51706fe3-6178-381f-8c3b-8d46b6e4f8f6",
                                                "text": "Le 9 de ce mois, le nommé Guichard, Henry, manœuvre à Thenorgues, a été englouti dans une carrière où il était occupé à extraire de la pierre."
                                            },
                                            {
                                                "example_id": "a086deee-c507-4d4d-97bd-f3692bb4afa9",
                                                "sense_id": "51706fe3-6178-381f-8c3b-8d46b6e4f8f6",
                                                "text": "Comme un lourd océan sorti de ses rivages,\nÀ leur voix la nuit morne engloutit le soleil,\nEt l’éclair de la foudre entr’ouvre les nuages."
                                            },
                                            {
                                                "example_id": "09f102c1-2d24-49c9-9b06-166f61b6c9f8",
                                                "sense_id": "51706fe3-6178-381f-8c3b-8d46b6e4f8f6",
                                                "text": "Tout un crépitement de coups de feu et d’éclatements de projectiles commença, et Bert vit autour de lui, l’enveloppant, l’engloutissant, le submergeant, une immense fulguration blanche accompagnée d’un coup de tonnerre semblable à l’explosion d’un monde."
                                            },
                                            {
                                                "example_id": "79d29770-7c49-45b0-9b52-cbdf7bc589e1",
                                                "sense_id": "51706fe3-6178-381f-8c3b-8d46b6e4f8f6",
                                                "text": "Telle est la chair des femmes, un abîme où s’engloutir sans recours, et celle des vierges un brasier qui consume l'âme."
                                            },
                                            {
                                                "example_id": "43067ad0-ee4c-4185-9ab7-130dd30793c8",
                                                "sense_id": "51706fe3-6178-381f-8c3b-8d46b6e4f8f6",
                                                "text": "A chaque tempête, les dunes progressent vers l'intérieur des terres. […]. Des villages entiers sont engloutis : habitations, église, tout disparaît sous le sable."
                                            },
                                            {
                                                "example_id": "b6fa36a3-370c-4a97-9a36-4dc35579aa40",
                                                "sense_id": "51706fe3-6178-381f-8c3b-8d46b6e4f8f6",
                                                "text": "Nous n’étions pas nous-mêmes à l’abri des plus grandes frayeurs ; un de ces débris pouvait nous atteindre et engloutir notre frêle nacelle."
                                            },
                                            {
                                                "example_id": "6b4137fb-5f96-419c-9d6b-af84a36babbe",
                                                "sense_id": "51706fe3-6178-381f-8c3b-8d46b6e4f8f6",
                                                "text": "J'ai failli moi-même être englouti avec mon cheval par les sables mouvants du Tahaddart, entre Tanger et Azila, et j'ai manqué me noyer dans l’embouchure du Tensift."
                                            },
                                            {
                                                "example_id": "a5536fda-5fcc-44a8-a659-d24c41e9af06",
                                                "sense_id": "51706fe3-6178-381f-8c3b-8d46b6e4f8f6",
                                                "text": "Tous ces petits états furent engloutis par cet empire formidable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
