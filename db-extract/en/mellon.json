                        "entry_id": "a3ba005c-ac90-3b49-846a-8b9dd12acdae",
                        "glosses": [
                            "The result of heptazine being polymerized with the tri-s-triazine units linked through an amine (NH) link."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ace53da0-82eb-42b4-9ac4-2abcbb5510bf",
                                "sense_id": "e4eebc8d-d738-3104-9190-c2fcce3e6a66",
                                "text": "Mellon (C₁₈N₁₃; Liebig).— This anomalous compound was originally supposed by Liebig to contain C₆N₄, but he has recently repeated and varied his experiments upon it, and has altered its formula as above."
                            },
                            {
                                "example_id": "7c6998de-fc06-42f9-8bec-1cafb8bbf298",
                                "sense_id": "e4eebc8d-d738-3104-9190-c2fcce3e6a66",
                                "text": "It sublimes on heating and decomposes into mellon and NH₃."
                            }
                        ]
                    }
