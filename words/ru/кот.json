                {
                    "sense_id": "186ad703-325b-3e4f-bc9b-5f4a34ffef9e",
                    "sense_definition": "Самец домашней кошки",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "domestic_animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш рыжий <w>кот</w> любит спать на подоконнике.",
                            "target_lang_translations": {
                                "en": "Our ginger <w>cat</w> likes to sleep on the windowsill.",
                                "fr": "Notre <w>chat</w> roux aime dormir sur le rebord de la fenêtre."
                            }
                        },
                        {
                            "text": "Соседский <w>кот</w> часто приходит к нам в сад.",
                            "target_lang_translations": {
                                "en": "The neighbor's <w>cat</w> often comes into our garden.",
                                "fr": "Le <w>chat</w> du voisin vient souvent dans notre jardin."
                            }
                        },
                        {
                            "text": "Вечером <w>кот</w> сидит у двери и ждёт хозяина.",
                            "target_lang_translations": {
                                "en": "In the evening the <w>cat</w> sits by the door and waits for his owner.",
                                "fr": "Le soir, le <w>chat</w> s'assoit près de la porte et attend son maître."
                            }
                        }
                    ],
                    "antonyms": [
                        "кошка"
                    ],
                    "common_phrases": [
