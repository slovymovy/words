                                        "entry_id": "1b2cefe3-b6e6-379b-b7b7-2a0b7b16811f",
                                        "glosses": [
                                            "A reduction in the value, or an impairment in the quality of something."
                                        ],
                                        "tags": [
                                            "countable",
