                        ]
                    },
                    {
                        "translation_id": "743c77c0-cfb2-4445-b87b-4021f6211f24",
                        "source_entry_id": "184c2277-b415-3234-a0ed-fd57e3be5c51",
                        "source_sense_id": "4cc66cb7-f2ab-3581-9796-7ed7faf235df",
