                    "sense_definition": "Donner un ordre d'autorité ou prescrire formellement quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a <w>ordonné</w> un repos complet pendant deux semaines."
                        },
                        {
                            "text": "Le capitaine a <w>ordonné</w> à ses soldats de cesser immédiatement le feu."
                        }
                    ],
                    "synonyms": [
