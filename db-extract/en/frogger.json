                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fbf05192-bc5c-4924-8179-534df02946d3",
                                "sense_id": "0d372dc5-3a08-3681-ae71-496ac643991f",
                                "text": "Gabrielle and I froggered it across the bustling avenue toward our group."
                            },
                            {
                                "example_id": "1279bd8c-18ab-4c46-8cc2-1c0c56404427",
                                "sense_id": "0d372dc5-3a08-3681-ae71-496ac643991f",
                                "text": "Out I plunge ...into the Ready Salted afternoon, froggering between the traffic to the promenade."
                            },
                            {
                                "example_id": "432e18b0-f957-46c3-8a10-5ced3e64aff8",
                                "sense_id": "0d372dc5-3a08-3681-ae71-496ac643991f",
                                "text": "He hit the accelerator and froggered into the fast lane, inciting a symphony of angry honking."
