                {
                    "sense_id": "938b5829-1628-352e-9905-cb333b8a656d",
                    "sense_definition": "Être convenable ou conforme aux règles de la bienséance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Partir sans dire au revoir aux hôtes de la soirée ne se <w>fait</w> vraiment pas."
                        },
                        {
                            "text": "Dans ce milieu diplomatique très formel, tout le monde sait exactement ce qui se <w>fait</w>."
