                        "examples": [
                            {
                                "example_id": "90d09002-088b-42b3-a8ff-cc540e3b0467",
                                "sense_id": "e44e9147-f27f-32dd-a08d-445349893f4e",
                                "text": "― Вот я вам сейчас чертёжик нарисую, как это устраивается…"
                            },
                            {
                                "example_id": "b06f61a1-4ccb-4081-827a-0838afd8bd6c",
                                "sense_id": "e44e9147-f27f-32dd-a08d-445349893f4e",
                                "text": "Вот чертёж, продольный разрез аппарата. ― Он наклонился над Зоиным креслом (вдохнул запах её волос), развернул чертёжик размером в половину листа писчей бумаги."
                            }
                        ]
                    }
