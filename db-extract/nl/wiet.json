        "nl-extract.jsonl": [
            {
                "entry_id": "7a81c1e3-0395-331a-8905-5b91d78bc889",
                "word": "wiet",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c671c5f0-ced7-38a7-a411-6ff666af5f35",
                        "entry_id": "7a81c1e3-0395-331a-8905-5b91d78bc889",
                        "glosses": [
                            "softdrug die bestaat uit gedroogde hennep, Cannabis sativa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40cace0a-7793-4420-aa5b-c363d8c2c00d",
                                "sense_id": "c671c5f0-ced7-38a7-a411-6ff666af5f35",
                                "text": "Je moet echt stoppen met het roken van wiet!"
                            },
                            {
                                "example_id": "46ef487d-a8fa-4dd7-8338-43185c0ecb23",
                                "sense_id": "c671c5f0-ced7-38a7-a411-6ff666af5f35",
                                "text": "Gelukkig werd er alleen wiet gevonden, dat wel geconfisqueerd werd maar waar verder geen straffen voor werden uitgedeeld."
                            },
                            {
                                "example_id": "9191a4ff-f30a-454b-a293-408910300ad8",
                                "sense_id": "c671c5f0-ced7-38a7-a411-6ff666af5f35",
                                "text": "Hennepbloemen bevatten minder dan 0,5 procent THC, de stof in cannabis waar je high van wordt. Ze worden gebruikt in cosmetica, farmaceutische producten, of, in landen waar dat mag, om te roken. \"Een soort alcoholvrij bier, maar dan voor wiet\", beschrijft ondernemer Cusani."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3145d4b-7307-4676-a07f-6d33e8daf27b",
                        "source_entry_id": "7a81c1e3-0395-331a-8905-5b91d78bc889",
                        "source_sense_id": "c671c5f0-ced7-38a7-a411-6ff666af5f35",
