                        "glosses": [
                            "Graphie ancienne de nu."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "080e5ed8-91e4-4c9c-bcb3-bf98aa1b3938",
                                "sense_id": "f2b8ec3c-2bee-3093-89ab-52b49bca6818",
                                "text": "Au lieu de le laisser étendu & tout nud sur le rivage, comme on le fait trop souvent, on doit l'envelopper de couvertures."
                            },
                            {
                                "example_id": "5e5bf15c-327e-48af-b362-874cc288fac1",
                                "sense_id": "f2b8ec3c-2bee-3093-89ab-52b49bca6818",
                                "text": "La premiere a des feuilles oblongues & sinuées irréguliérement, avec des fleurs ou graines en grappes nudes sur des filets."
                            },
                            {
                                "example_id": "a4e66563-83ba-461d-862c-6ad13cf497c8",
                                "sense_id": "f2b8ec3c-2bee-3093-89ab-52b49bca6818",
                                "text": "Bénite est l'infertile plage\n Où comme la mer tout est nud."
                            },
                            {
                                "example_id": "4610307a-b753-4ee9-b042-88a37e767cc6",
                                "sense_id": "f2b8ec3c-2bee-3093-89ab-52b49bca6818",
                                "text": "Corps‐Nuds, en Ille‐et‐Vilaine, est membre de l’Association des communes de France aux noms burlesques et chantants."
                            }
                        ]
                    }
