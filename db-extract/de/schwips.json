                "senses": [
                    {
                        "sense_id": "85ad53cb-de2c-302e-ae27-84a4596a0c83",
                        "entry_id": "5051935e-c00e-3c53-91fb-e8a940900e84",
                        "glosses": [
                            "leichte Form des Rausches"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cbf41815-5dae-474d-8e8c-f4127770640d",
                                "sense_id": "85ad53cb-de2c-302e-ae27-84a4596a0c83",
                                "text": "„Dazu tranken sie einen trockenen Riesling, von dem Laura Leonore einen leichten Schwips bekam, was jedoch nicht störte.“"
                            },
                            {
                                "example_id": "1317aa3f-2f18-45c7-bd7e-b7c58c213ee0",
                                "sense_id": "85ad53cb-de2c-302e-ae27-84a4596a0c83",
                                "text": "„Er ging neben seinem Schwips her und tat, als kennten sie einander nicht.“"
                            },
                            {
                                "example_id": "3e9ba76a-8b14-4d20-aea8-6662b4ad07fb",
                                "sense_id": "85ad53cb-de2c-302e-ae27-84a4596a0c83",
                                "text": "„Trotz des Schwipses der Mädchen hielt ich mein Wort, und weder Goudar noch ich nützten ihn aus.“"
                            },
                            {
                                "example_id": "797722b7-e403-431e-9630-0752926718db",
                                "sense_id": "85ad53cb-de2c-302e-ae27-84a4596a0c83",
                                "text": "„Er fühlte, wie er einen Schwips bekam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
