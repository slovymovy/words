                "senses": [
                    {
                        "sense_id": "2fb0daa0-d103-3fdd-8d76-0a895b458f42",
                        "entry_id": "81a39a3b-6994-375e-8e76-0a369933a1c9",
                        "glosses": [
                            "bez względu na cokolwiek, bez stawiania warunków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "701dc7d3-8f6a-446c-b088-d57a929f212e",
                                "sense_id": "2fb0daa0-d103-3fdd-8d76-0a895b458f42",
                                "text": "Mniej ważna jest treść reguły, niż fakt by posiadać regułę i bezwarunkowo jej przestrzegać."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3d881f44-69cf-3861-aa7b-3a789abeec48",
