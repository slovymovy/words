                        "examples": [
                            {
                                "example_id": "515525dd-3275-4405-92b0-0b157267eb4c",
                                "sense_id": "92c832c8-6afa-3001-805f-017e154decbf",
                                "text": "Het dansmeestertje is een glanzend-zwarte vogel ( 10 cm lang) met wat wit in de vleugels. Het wijfje en de jongen hebben een bruin verenkleed met strepen op de borst. Hun eerste naam danken ze aan hun geluid (srio) en de tweede aan hun opvallende 'gedans': ze springen op van de tak of grashalm waar ze op zitten, vliegen een klein stukje de lucht in, fluiten 'srio' en komen weer neer op hun oude plek"
                            },
                            {
                                "example_id": "956a7136-03df-4961-a72a-2912311cd74e",
                                "sense_id": "92c832c8-6afa-3001-805f-017e154decbf",
                                "text": "⧖ Dansmeestertje, sur. Srio, n.e. Volatinia jacarini, een geheel zwart vogeltje met iets wit aan de vleugels, behoorende tot de Fringillidae."
                            }
                        ]
                    }
