                "senses": [
                    {
                        "sense_id": "925d6c29-9e24-3cb4-9fb0-9f501994913b",
                        "entry_id": "ad8f5920-9b74-36b5-b8ce-fc1f2304ac81",
                        "glosses": [
                            "Nom vernaculaire de Primula auricula, plante à fleur de la famille des Primulaceae, (les primevères), originaire des zones d'altitude de l’Europe de l’ouest et cultivée comme plante ornementale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ba655a-9b92-4b2f-afa3-c46e5b88af20",
                                "sense_id": "925d6c29-9e24-3cb4-9fb0-9f501994913b",
                                "text": "Il la fit plafonner et tendre d’une étoffe extraordinaire qu’il avait en pièce et qu’il croyait d’Utrecht, fonds satiné boutons-d’or avec fleurs de velours oreilles-d’ours."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b1f7c4b-79de-355b-b7ae-af8207dedd51",
                        "entry_id": "ad8f5920-9b74-36b5-b8ce-fc1f2304ac81",
                        "glosses": [
                            "Nom vernaculaire de Stachys byzantina, plante de la famille des Lamiacées, également appelée épiaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde86f23-7237-4433-a687-30c4183c7034",
                                "sense_id": "0b1f7c4b-79de-355b-b7ae-af8207dedd51",
                                "text": "Stachys byzantina, appelée couramment oreille d’ours …, est une plante vivace de culture aisée, particulièrement adaptée aux conditions de sécheresse."
                            },
                            {
                                "example_id": "bc9f770a-5c3f-494a-a45e-51bcbfe5148c",
                                "sense_id": "0b1f7c4b-79de-355b-b7ae-af8207dedd51",
                                "text": "L’oreille d’ours ou oreille de lapin, Stachys byzantina, fait partie de ces plantes vivaces dont le feuillage duveteux, gris argenté, confère une élégance chic et sobre aux jardins."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce9337ea-dea2-3d32-a240-81187773cd4d",
                        "entry_id": "ad8f5920-9b74-36b5-b8ce-fc1f2304ac81",
                        "glosses": [
                            "Sorte de gâteau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9851759b-1d0e-4f0f-999a-a69e88d2bbc9",
                                "sense_id": "ce9337ea-dea2-3d32-a240-81187773cd4d",
                                "text": "On reste en France et plus précisément dans les Pyrénées, pour déguster une Oreille d’ours. Pas de panique, c’est un délicieux gâteau !"
                            }
                        ]
                    }
                ],
