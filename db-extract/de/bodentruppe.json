                ],
                "senses": [
                    {
                        "sense_id": "26e89f64-acd0-39fc-9d4d-ed99c7ddff74",
                        "entry_id": "4acf2205-25b1-3f50-9172-a9a90b36df05",
                        "glosses": [
                            "Einheit (= Truppe), die an Land (= am Boden) operiert"
                        ],
                        "tags": [
                            "häufig im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "66130ef7-d0fe-4d9c-96c2-abb6cffc2d3c",
                                "sense_id": "26e89f64-acd0-39fc-9d4d-ed99c7ddff74",
                                "text": "„Zwei Wochen nach dem Angriff auf Würzburg erreichen auch die alliierten Bodentruppen an Tauber und Main erstmals bayerisches Gebiet.“"
                            },
                            {
                                "example_id": "a87fab72-0e68-442d-8c36-50b8dc0eb72f",
                                "sense_id": "26e89f64-acd0-39fc-9d4d-ed99c7ddff74",
                                "text": "„»Wir wollen von Deutschland Bodentruppen, um unsere Soldaten teilweise zu ersetzen«, sagte der US-Sonderbeauftragte für Syrien und die Anti-IS-Koalition, James Jeffrey […]“"
                            },
                            {
                                "example_id": "9aff549e-9071-4f28-ada8-773d6cc7a4a6",
                                "sense_id": "26e89f64-acd0-39fc-9d4d-ed99c7ddff74",
                                "text": "„Der Zug fährt an der wunderschönen Zitadelle von Hue vorbei, am geschichtsträchtigen Strand von Da Nang, wo damals die ersten US-amerikanischen Bodentruppen landeten.“"
                            },
                            {
                                "example_id": "42bd1c45-58ed-4ee8-810a-9e032e4dc1aa",
                                "sense_id": "26e89f64-acd0-39fc-9d4d-ed99c7ddff74",
                                "text": "„Es ist laut Rebellen das erste Mal, dass Russland Bodentruppen in Syrien direkt ins Gefecht schickt. Bis jetzt hatte Russland die syrische Regierung vor allem mithilfe von Lufteinsätzen unterstützt.“"
                            },
                            {
                                "example_id": "5979e59c-b196-4f80-8d34-eb06be624336",
                                "sense_id": "26e89f64-acd0-39fc-9d4d-ed99c7ddff74",
                                "text": "„Das Deutsch-Niederländische Korps hat am Mittwoch (09.01.2019) offiziell das Kommando über die Bodentruppen der NATO übernommen.“"
                            },
                            {
                                "example_id": "b131dfe1-d3b0-4e99-b89d-4039801e9f14",
                                "sense_id": "26e89f64-acd0-39fc-9d4d-ed99c7ddff74",
                                "text": "„Die Türkei geht aus der Luft und mit Bodentruppen gegen Kurden im Norden Syriens vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
