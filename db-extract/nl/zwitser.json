                    {
                        "sense_id": "83c339b8-c548-3c1f-8c9e-5423f3b53944",
                        "entry_id": "84805190-6260-39b4-aa11-74c2463db244",
                        "glosses": [
                            "een inwoner van Zwitserland, of iemand afkomstig uit Zwitserland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ba0c566-a3e7-4c70-801e-9d240e233320",
                                "sense_id": "83c339b8-c548-3c1f-8c9e-5423f3b53944",
                                "text": "Toevallig had ik aan het zwembad een gesprek gevoerd met een Zwitser, Wale, die met zijn gezin in een camper een rondreis maakte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4d654c5-24ae-4d34-a2ef-a7040b30936c",
                        "source_entry_id": "84805190-6260-39b4-aa11-74c2463db244",
                        "source_sense_id": "83c339b8-c548-3c1f-8c9e-5423f3b53944",
                        "source_sense_description": "een inwoner van Zwitserland, of iemand afkomstig uit Zwitserland",
                        "target_lang_word": "Schweizer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweizer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b370330-4a09-3a84-a91a-a5e2e199f966",
                                        "entry_id": "4c8f259e-7609-3c81-8f54-30f43cd674d1",
                                        "glosses": [
                                            "(männlicher^☆) Staatsangehöriger der Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e05039-24d1-41be-8716-4714e8de3b9c",
                                                "sense_id": "4b370330-4a09-3a84-a91a-a5e2e199f966",
                                                "text": "„Schweizer des Jahres wird man nicht einfach so. Da muss man schon Schweizer sein.“"
                                            },
                                            {
                                                "example_id": "e24c4893-c532-457f-8fbc-5afcbd872555",
                                                "sense_id": "4b370330-4a09-3a84-a91a-a5e2e199f966",
                                                "text": "Viktor Giacobbo ist ein Schweizer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3add0c46-82b5-34d2-be3f-f65f052411f0",
                                        "entry_id": "4c8f259e-7609-3c81-8f54-30f43cd674d1",
                                        "glosses": [
                                            "Türhüter (beim Papst)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb06020-d2a5-4230-807a-5e14486f0c45",
                                                "sense_id": "3add0c46-82b5-34d2-be3f-f65f052411f0",
                                                "text": "Man muß bis in die Zeit der Renaissance zurückgehen, um die Gründe zu verstehen, die Papst Julius II. bewogen, die Schweizer nach Rom kommen zu lassen. Heute steht an jedem Außeneingang des Vatikans mindestens ein Schweizer."
                                            },
                                            {
                                                "example_id": "80aa625a-50e9-47c3-bdd9-4a6252abba24",
                                                "sense_id": "3add0c46-82b5-34d2-be3f-f65f052411f0",
                                                "text": "„Ich wandte mich an den Schweizer und sagte ihm, ich hätte einen Brief für Versailles und es wäre mir sehr angenehm, ihn dem Kurier mitgeben zu können, der zurückreisen sollte, sobald er die Depeschen von Seiner Exzellenz erhalten hätte. »Aber, mein Herr,« sagte der Schweizer, »seit zwei Monaten haben wir keinen außerordentlichen Kurier hier gehabt!«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f341abe8-c0ef-3dee-9f34-d0dc301d91b3",
                                        "entry_id": "4c8f259e-7609-3c81-8f54-30f43cd674d1",
                                        "glosses": [
                                            "Melker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b3fb55-5363-4283-b6bf-ab352a44de3c",
                                                "sense_id": "f341abe8-c0ef-3dee-9f34-d0dc301d91b3",
                                                "text": "So wurden viele Schweizer Melker – und umgekehrt wurden irgendwann alle Melker \"Schweizer\" genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "73ec52ab-e51b-3146-86dc-3bceae834997",
                                        "entry_id": "4c8f259e-7609-3c81-8f54-30f43cd674d1",
                                        "glosses": [
                                            "die Kühe beaufsichtigende Person in der Milchwirtschaft"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a66c3cbc-84aa-3fae-b584-e4fa468ecf3a",
                                        "entry_id": "4c8f259e-7609-3c81-8f54-30f43cd674d1",
                                        "glosses": [
                                            "Küster in katholischen Kirchen"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7c3fbd7-3060-46db-945d-f662e9e0ca4f",
                                                "sense_id": "a66c3cbc-84aa-3fae-b584-e4fa468ecf3a",
                                                "text": "Den Schweizer, der Kirchenküster war, nannte man auch „Domschweizer“."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schweizer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d99e7b4f-caae-39a5-947a-bf92dd63fad0",
                                        "entry_id": "9e4e9185-e02f-31d2-adf7-d79844440a60",
                                        "glosses": [
                                            "die Schweiz betreffend, zur Schweiz gehörend, aus der Schweiz kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d5b4873-06df-4136-a228-411793ae97bb",
                                                "sense_id": "d99e7b4f-caae-39a5-947a-bf92dd63fad0",
                                                "text": "Ich esse gern Schweizer Käse und Schweizer Schokolade."
                                            },
                                            {
                                                "example_id": "5397fa63-9e4a-4416-8bea-9133a8390dda",
                                                "sense_id": "d99e7b4f-caae-39a5-947a-bf92dd63fad0",
                                                "text": "Die Schweizer Politik ist in Deutschland eher selten ein Thema."
                                            },
                                            {
                                                "example_id": "86a03514-5fe1-4c9f-9d06-2c360d5cc1f1",
                                                "sense_id": "d99e7b4f-caae-39a5-947a-bf92dd63fad0",
                                                "text": "„Um die weitere Ausbreitung des Japankäfers zu verhindern, setzt die Schweizer Großstadt Basel erstmals Fadenwürmer gegen den Schädling in öffentlichen Parks und Sportanlagen ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "126fb3c3-fb7e-39b4-8abd-b6e1d96bd53d",
                                        "entry_id": "9e4e9185-e02f-31d2-adf7-d79844440a60",
                                        "glosses": [
                                            "charakteristisch für die Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ab87cff-f487-4969-b8ba-3210d3c197be",
                                                "sense_id": "126fb3c3-fb7e-39b4-8abd-b6e1d96bd53d",
                                                "text": "Die Schweizer Berge und überhaupt das ganze Schweizer Landschaftsbild sind beeindruckend."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schweizer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78a43683-b330-38e0-be74-dc7d36cbb3f9",
                                        "entry_id": "528afdbf-ef4d-3a48-b0c1-331dc848dce7",
                                        "glosses": [
                                            "Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df3ed8cf-21ce-4816-9b25-5e732a61856e",
                                                "sense_id": "78a43683-b330-38e0-be74-dc7d36cbb3f9",
                                                "text": "Die kleine Schweizer ist vielleicht durchtrieben!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
