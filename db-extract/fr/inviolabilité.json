                    {
                        "translation_id": "7addeccc-298f-4440-8763-4991c8cf802d",
                        "source_entry_id": "614e9b7d-3c01-3bc6-84a8-7f446f9988b9",
                        "source_sense_id": "b8841a3d-0c86-3ae6-a15a-b4372d2363d5",
