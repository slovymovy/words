        "fr-extract.jsonl": [
            {
                "entry_id": "ce3f6df4-544a-385d-9d19-93292c0cbd03",
                "word": "LaTeX",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6682ffd1-f797-350d-b451-72614fbdef8b",
                        "entry_id": "ce3f6df4-544a-385d-9d19-93292c0cbd03",
                        "glosses": [
                            "Langage de mise en page typographique bâti sur TeX, utilisé principalement par les milieux scientifiques et mathématiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be559d29-323d-45f2-a6ac-bf87b6b171a2",
                                "sense_id": "6682ffd1-f797-350d-b451-72614fbdef8b",
                                "text": "Si TeX est le typographe, LaTeX est l’éditeur ; les deux transforment le manuscrit de l’auteur en une publication polie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ea05edd1-ae52-30d3-b8f9-437553c44294",
                "word": "latex",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7f48df16-2b8c-3fe0-837e-1893286b4c46",
                        "entry_id": "ea05edd1-ae52-30d3-b8f9-437553c44294",
                        "glosses": [
                            "Suc végétal, laiteux et propre à certaines plantes, telles que l’hévéa, le pavot, le figuier, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2578e79-2d3e-4cc5-80f1-48ea95e91643",
                                "sense_id": "7f48df16-2b8c-3fe0-837e-1893286b4c46",
                                "text": "Certaines colles naturelles restent utilisées : les latex pour fermer les enveloppes par simple pression."
                            },
                            {
                                "example_id": "f28bcb2a-0bf2-4e2a-a9b3-c30c843e8b26",
                                "sense_id": "7f48df16-2b8c-3fe0-837e-1893286b4c46",
                                "text": "Le caoutchouc naturel est obtenu à partir de l’écorce de l’hévéa sous forme d'un liquide blanc laiteux, appelé latex (Fig. 11.21), qui est une suspension de particules de caoutchouc dans l'eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "37e71011-655f-3db1-b2ef-48ae1c9f5510",
                        "entry_id": "ea05edd1-ae52-30d3-b8f9-437553c44294",
                        "glosses": [
                            "Matériau plastique élaboré à partir de la sève de l’hévéa ou synthétisé artificiellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14d861e2-724b-465c-918c-beeee2be43a8",
                                "sense_id": "37e71011-655f-3db1-b2ef-48ae1c9f5510",
                                "text": "Ce n’est qu’une poupée… en latex… c’est du caoutchouc, regardez…"
                            },
                            {
                                "example_id": "c343b900-323b-4457-bc0f-51acd34ca3f6",
                                "sense_id": "37e71011-655f-3db1-b2ef-48ae1c9f5510",
                                "text": "Une bouche charnue façonnée pour tailler des flûtes, des nibards falsh et généreux, un boulard arrondi et bien ferme, enveloppés dans des sapes en latex genre dominatrice."
                            },
                            {
                                "example_id": "5bb74929-ea2c-4ddc-afce-b2278096b46c",
                                "sense_id": "37e71011-655f-3db1-b2ef-48ae1c9f5510",
                                "text": "«La seule chose qu’on a retrouvée, ce sont des vagins électriques en latex qu’ils ont oubliés devant la résidence de personnes âgées qui se trouve en face», indique la femme d’affaires."
                            }
                        ]
                    }
                ],
                "translations": [
