                "senses": [
                    {
                        "sense_id": "13eab9b1-7c35-3399-9b63-105fb1bf2b05",
                        "entry_id": "088d5bbc-5bdd-3289-a271-5fe0370dfedd",
                        "glosses": [
                            "Oxyde d’yttrium (Y₂O₃)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cca355a-7db4-477d-a5b9-f239bdc2e26b",
                                "sense_id": "13eab9b1-7c35-3399-9b63-105fb1bf2b05",
                                "text": "La glucine se dissolvait parfaitement, la liqueur restait claire et sans résidu; mais l’yttria ne paraissait avoir subi aucun changement , excepté qu’elle s'était plus divisée après l’avoir fait bouillir avec la lessive."
                            },
                            {
                                "example_id": "d9716e93-5750-4e54-924a-df1e8a96fdeb",
                                "sense_id": "13eab9b1-7c35-3399-9b63-105fb1bf2b05",
                                "text": "L’yttria est blanche et insipide."
                            },
                            {
                                "example_id": "be8eb46c-b2ac-4a45-89bd-c34408881f38",
                                "sense_id": "13eab9b1-7c35-3399-9b63-105fb1bf2b05",
                                "text": "L’yttria peut être précipitée de ses dissolutions par les oxydes alcalins purs et aussi par le sulfure d’aluminium."
                            }
                        ]
                    }
                ],
                "translations": [
