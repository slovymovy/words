{
    "word_family": [
        "впереди",
        "спереди",
        "передний",
        "передовой",
        "опережать"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "408062dd-ddc3-3499-b815-aaa94321a657",
                    "sense_definition": "В направлении перед собой, куда обращено лицо или взгляд; по ходу движения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Командир приказал солдатам двигаться только <вперёд>.",
                            "target_lang_translations": {
                                "en": "The commander ordered the soldiers to move only <w>forward</w>.",
                                "nl": "De commandant beval de soldaten om alleen <w>voorwaarts</w> te bewegen."
                            }
                        },
                        {
                            "text": "Сделай шаг <вперёд> и возьми свою награду.",
                            "target_lang_translations": {
                                "en": "Take a step <w>forward</w> and take your reward.",
                                "nl": "Doe een stap <w>naar voren</w> en neem je beloning in ontvangst."
                            }
                        }
                    ],
                    "antonyms": [
                        "наза́д"
                    ],
                    "common_phrases": [
                        "шаг вперёд",
                        "смотреть вперёд",
                        "идти вперёд",
                        "только вперёд"
                    ],
                    "target_lang_definitions": {
                        "en": "In the direction one is facing or moving; towards the front.",
                        "nl": "In de richting naar voren, waarheen het gezicht of de blik is gericht; in de richting van de beweging."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forward",
                                "target_lang_sense_clarification": "movement direction"
                            },
                            {
                                "target_lang_word": "ahead",
                                "target_lang_sense_clarification": "in front"
                            },
                            {
                                "target_lang_word": "onward",
                                "target_lang_sense_clarification": "continuing forward"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vooruit",
                                "target_lang_sense_clarification": "in de richting van de beweging"
                            },
                            {
                                "target_lang_word": "voorwaarts",
                                "target_lang_sense_clarification": "naar voren gericht"
                            },
                            {
                                "target_lang_word": "naar voren",
                                "target_lang_sense_clarification": "richting de voorkant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3350ce77-3737-3b28-b897-cbb44ff9a164",
                    "sense_definition": "Заранее; до наступления определённого срока или события.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_advance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вам необходимо заплатить за аренду квартиры <вперёд>.",
                            "target_lang_translations": {
                                "en": "You need to pay the apartment rent <w>in advance</w>.",
                                "nl": "U dient de huur van het appartement <w>vooruit</w> te betalen."
                            }
                        },
                        {
                            "text": "Не нужно забегать <вперёд>, давай решать проблемы по мере их поступления.",
                            "target_lang_translations": {
                                "en": "There is no need to get <w>ahead</w> of yourself; let's solve problems as they arise.",
                                "nl": "We moeten niet op de zaken <w>vooruitlopen</w>, laten we problemen oplossen zodra ze zich voordoen."
                            }
                        }
                    ],
                    "synonyms": [
                        "заранее",
                        "авансом",
                        "наперёд"
                    ],
                    "common_phrases": [
                        "платить вперёд",
                        "забегать вперёд",
                        "на год вперёд"
                    ],
                    "target_lang_definitions": {
                        "en": "Before a certain time or event; beforehand.",
                        "nl": "Vooraf; vóór het aanbreken van een bepaalde termijn of gebeurtenis."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in advance",
                                "target_lang_sense_clarification": "beforehand"
                            },
                            {
                                "target_lang_word": "ahead",
                                "target_lang_sense_clarification": "before a scheduled time"
                            },
                            {
                                "target_lang_word": "up front",
                                "target_lang_sense_clarification": "payment made beforehand"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vooruit",
                                "target_lang_sense_clarification": "vooraf betalen of plannen"
                            },
                            {
                                "target_lang_word": "vooraf",
                                "target_lang_sense_clarification": "bij voorbaat"
                            },
                            {
                                "target_lang_word": "op voorhand",
                                "target_lang_sense_clarification": "voor de gebeurtenis plaatsvindt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7e5069f-07ab-301d-a7c5-7a77c059dc2d",
                    "sense_definition": "О часах: показывая время, опережающее реальное.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "clocks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мои настенные часы ушли <вперёд> на десять минут.",
                            "target_lang_translations": {
                                "en": "My wall clock is ten minutes <w>fast</w>.",
                                "nl": "Mijn wandklok loopt tien minuten <w>voor</w>."
                            }
                        },
                        {
                            "text": "Если часы идут <вперёд>, их приходится постоянно подводить.",
                            "target_lang_translations": {
                                "en": "If a clock runs <w>fast</w>, it has to be constantly adjusted.",
                                "nl": "Als een klok <w>voorloopt</w>, moet je hem voortdurend gelijkzetten."
                            }
                        }
                    ],
                    "antonyms": [
                        "наза́д"
                    ],
                    "common_phrases": [
                        "часы ушли вперёд"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding clocks: showing a time later than the actual time.",
                        "nl": "Over klokken: een tijd aangeven die voorloopt op de werkelijke tijd."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fast",
                                "target_lang_sense_clarification": "showing later time"
                            },
                            {
                                "target_lang_word": "ahead",
                                "target_lang_sense_clarification": "advanced time"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "voor",
                                "target_lang_sense_clarification": "over een klok die voorloopt"
                            },
                            {
                                "target_lang_word": "vooruit",
                                "target_lang_sense_clarification": "sneller lopend dan de werkelijke tijd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b911e0ff-8b99-3e03-9024-d15392ba575d",
                    "sense_definition": "В будущем; впредь (обычно с оттенком предостережения).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time_future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Вперёд> будь умнее и не доверяй незнакомым людям.",
                            "target_lang_translations": {
                                "en": "<w>In the future</w>, be smarter and do not trust strangers.",
                                "nl": "Wees <w>voortaan</w> verstandiger en vertrouw geen vreemden."
                            }
                        },
                        {
                            "text": "Пусть эта ошибка послужит тебе уроком <вперёд>.",
                            "target_lang_translations": {
                                "en": "Let this mistake serve as a lesson to you <w>for the future</w>.",
                                "nl": "Laat deze fout een les voor je zijn <w>voor de toekomst</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "впредь"
                    ],
                    "common_phrases": [
                        "вперёд наука"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "conversational style"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "At a later time; henceforth.",
                        "nl": "In de toekomst; voortaan (meestal met een waarschuwende toon)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in the future",
                                "target_lang_sense_clarification": "time to come"
                            },
                            {
                                "target_lang_word": "from now on",
                                "target_lang_sense_clarification": "henceforth"
                            },
                            {
                                "target_lang_word": "forward",
                                "target_lang_sense_clarification": "onwards in time"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "voortaan",
                                "target_lang_sense_clarification": "vanaf nu"
                            },
                            {
                                "target_lang_word": "in de toekomst",
                                "target_lang_sense_clarification": "voor de komende tijd"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "107f36df-76a0-31b4-92c6-e252ab5b0e50",
                    "sense_definition": "Название населённого пункта (села или посёлка) в России.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Мы проезжали село <Вперёд> во время нашего путешествия.",
                            "target_lang_translations": {
                                "en": "We passed the village of <w>Vperyod</w> during our trip.",
                                "nl": "We kwamen tijdens onze reis langs het dorp <w>Vperjod</w>."
                            }
                        },
                        {
                            "text": "На карте области отмечен посёлок <Вперёд>.",
                            "target_lang_translations": {
                                "en": "The settlement of <w>Vperyod</w> is marked on the regional map.",
                                "nl": "Op de kaart van de regio staat de nederzetting <w>Vperjod</w> aangegeven."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Name of a settlement (village or town) in Russia.",
                        "nl": "Naam van een nederzetting (dorp of nederzetting) in Rusland."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Vperyod",
                                "target_lang_sense_clarification": "place name"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "Vperjod",
                                "target_lang_sense_clarification": "plaatsnaam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
