                "senses": [
                    {
                        "sense_id": "88a75fd6-cc50-39b7-b80e-1b8696dc9cbb",
                        "entry_id": "89370a85-152d-3194-b689-8ba575ca026a",
                        "glosses": [
                            "Slavic studies, Slavistics"
                        ],
                        "tags": [
                            "feminine",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9e1268e9-9342-475c-9b11-5d060c0ece93",
                                "sense_id": "88a75fd6-cc50-39b7-b80e-1b8696dc9cbb",
                                "text": "Seit Februar 2020 wird die Slawistik in der deutschen Hochschulpolitik nicht mehr als Kleines Fach eingestuft.",
                                "translation": "Since February 2020 Slavic Studies is no longer considered a small subject in German Higher Education policy.",
                                "english": "Since February 2020 Slavic Studies is no longer considered a small subject in German Higher Education policy."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3e2b897-8bff-3d75-810c-95d366d8f381",
                        "entry_id": "89370a85-152d-3194-b689-8ba575ca026a",
                        "glosses": [
                            "Institution where Slavic studies is practiced."
                        ],
                        "tags": [
                            "countable",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "0f6e3d79-3c8b-4e1c-89f1-9ea639fd8d4b",
                                "sense_id": "e3e2b897-8bff-3d75-810c-95d366d8f381",
                                "text": "Eines der weltweit größten slawistischen Institute ist die Slawistik an der Universität Wien.",
                                "translation": "The Slavic Studies [department] at the University of Vienna is one of the largest Slavic studies institutes in the world.",
                                "english": "The Slavic Studies [department] at the University of Vienna is one of the largest Slavic studies institutes in the world."
                            },
                            {
                                "example_id": "67ef0900-de85-44af-9077-df597d3db029",
                                "sense_id": "e3e2b897-8bff-3d75-810c-95d366d8f381",
                                "text": "Wie aus Tabelle 3 sichtbar, fehlt ein Modulhandbuch mit Beschreibungen der Modulinhalte nur an der LMU München. Alle anderen Universitäten bzw. Slawistiken und/oder Sprachpraxen in den Slawistiken verfügen über ein solches Dokument.",
                                "translation": "As can be seen from Table 3, a module handbook with descriptions of the modules' content is missing only for the LMU Munich. All other universities or Slavic studies departments and/or language practice [modules] in the Slavic studies departments have such a document.",
                                "english": "As can be seen from Table 3, a module handbook with descriptions of the modules' content is missing only for the LMU Munich. All other universities or Slavic studies departments and/or language practice [modules] in the Slavic studies departments have such a document."
                            }
                        ]
                    }
