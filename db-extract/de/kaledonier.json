                "senses": [
                    {
                        "sense_id": "4039288f-476d-3908-a934-cd155d1ca873",
                        "entry_id": "12b18ebc-b2ff-3bb5-bca8-94cc464b78e6",
                        "glosses": [
                            "Angehöriger des gleichnamigen antiken Volkes, das im heutigen Schottland siedelte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4a8e7f32-ba1c-4e35-861a-5b06c5b32474",
                                "sense_id": "4039288f-476d-3908-a934-cd155d1ca873",
                                "text": "„Unruhestifter waren nach den Angaben der naturgemäß einseitig urteilenden römischen Quellen die jenseits des Hadrianswalls siedelnden Kaledonier und Mäaten.“"
                            },
                            {
                                "example_id": "053bcc09-e9dd-45e6-b0b5-d3244233df6b",
                                "sense_id": "4039288f-476d-3908-a934-cd155d1ca873",
                                "text": "„Am Mons Graupius erlitt Calgacus mit seinen Kaledoniern eine Niederlage gegen die römischen Hilfstruppen.“"
                            },
                            {
                                "example_id": "de9624f6-390f-4200-8275-af547af624f9",
                                "sense_id": "4039288f-476d-3908-a934-cd155d1ca873",
                                "text": "„Das offensive Vorgehen der Römer provozierte die Kaledonen, die des Nachts das Lager der VIIII. Legion angriffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
