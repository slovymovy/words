                "senses": [
                    {
                        "sense_id": "ced49328-b01f-3ab1-b7b4-326f8ff6406e",
                        "entry_id": "b2057cad-aa30-3dd5-bfdf-8ec7cc715dcc",
                        "glosses": [
                            "Se brouter mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db6bd16-96fe-4f94-9c2c-977339119455",
                                "sense_id": "ced49328-b01f-3ab1-b7b4-326f8ff6406e",
                                "text": "Pendant que les autres s’abimaient la figure, ils se l’entre-broutaient en cachette et d’après la rougeur de la dame, pas seulement !"
                            },
                            {
                                "example_id": "2b7d72be-2d6c-495f-b4fa-84e31a766730",
                                "sense_id": "ced49328-b01f-3ab1-b7b4-326f8ff6406e",
                                "text": "Et le fait de voir pendant près de cinq minutes deux nanas s'entre-brouter et se fourrer les doigts dans des endroits que la morale réprouve crée chez certains spectateurs un malaise qui, dans une salle de 1.000 personnes pleine à craquer, est assez marrant à observer."
                            },
                            {
                                "example_id": "6e2e02f6-b98c-4eb0-922f-6b35d3606433",
                                "sense_id": "ced49328-b01f-3ab1-b7b4-326f8ff6406e",
                                "text": "Ils pourraient peut être essayer de s'entre-brouter le tour du maillot ?"
                            }
                        ]
                    }
