                "senses": [
                    {
                        "sense_id": "d824c199-794d-3343-bf8b-2b34e49daba7",
                        "entry_id": "236f4b3a-d0d8-39fc-add7-92ad2cd62d59",
                        "glosses": [
                            "Wissenschaft informationeller Netzwerke in dynamischen, selbstregulierenden und selbstorganisierenden Systemen"
                        ],
                        "tags": [
                            "Systemtheorie"
                        ],
                        "examples": [
                            {
                                "example_id": "df08bbcb-3789-4653-97be-09367060eac8",
                                "sense_id": "d824c199-794d-3343-bf8b-2b34e49daba7",
                                "text": "Sich selbst regulierende Systeme, und davon handelt ja die Kybernetik, gibt es in ungemein vielen Zusammenhängen. Wir finden sie zum Beispiel in der Nachrichtentheorie, der Entscheidungstheorie, der Spieltheorie und der Netzwerktheorie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "410d7c6e-5a42-4a54-8c14-2375c0a1bbff",
                        "source_entry_id": "236f4b3a-d0d8-39fc-add7-92ad2cd62d59",
                        "source_sense_id": "d824c199-794d-3343-bf8b-2b34e49daba7",
