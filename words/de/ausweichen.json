                    "frequency": "High",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Autofahrer konnte dem großen Hindernis auf der Fahrbahn gerade noch rechtzeitig <w>ausweichen</w>."
                        },
                        {
                            "text": "Als ein Fußgänger plötzlich den Radweg betrat, <w>wich</w> die Radfahrerin schnell nach links <w>aus</w>."
                        }
                    ],
                    "synonyms": [
                        "beiseitetreten",
                        "umfahren"
                    ],
                    "antonyms": [
                        "kollidieren",
                        "zusammenstoßen"
                    ],
                    "common_phrases": [
                        "einem Hindernis ausweichen",
                        "nach links ausweichen"
                    ]
                },
                {
                    "sense_id": "3f7c9e71-982f-38aa-973c-4165cb1805eb",
                    "sense_definition": "Einer unangenehmen Situation, einem Konflikt, einer Person oder einer klaren Antwort gezielt aus dem Weg gehen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vermeidung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Während der Pressekonferenz <w>wich</w> die Ministerin jeder kritischen Frage der Journalisten geschickt <w>aus</w>."
                        },
                        {
                            "text": "Er versucht seit Wochen, einem offenen Gespräch über unsere gemeinsame berufliche Zukunft konsequent <w>auszuweichen</w>."
                        }
                    ],
                    "synonyms": [
                        "meiden",
                        "umgehen",
                        "vermeiden"
                    ],
                    "antonyms": [
                        "konfrontieren",
                        "stellen"
                    ],
                    "common_phrases": [
                        "einer Frage ausweichen",
                        "einem Gespräch ausweichen",
                        "dem Thema ausweichen"
                    ]
                },
                {
                    "sense_id": "9898d79b-6977-3915-adc2-f19771dba1b8",
                    "sense_definition": "Auf eine andere Möglichkeit, Ressource oder Ersatzlösung zurückgreifen, wenn die ursprüngliche Option nicht verfügbar ist",
