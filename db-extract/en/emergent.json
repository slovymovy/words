    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ef47ab89-5ad1-3421-9db8-3ea8c236fe63",
                "word": "emergent",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e402f691-7be3-40e6-8962-53bcc7f672bc",
                        "entry_id": "ef47ab89-5ad1-3421-9db8-3ea8c236fe63",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more emergent"
                    },
                    {
                        "form_id": "112a1977-d051-4aa8-9068-648a49d2b8f5",
                        "entry_id": "ef47ab89-5ad1-3421-9db8-3ea8c236fe63",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most emergent"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1bdee3aa-bdac-3453-baa8-ffbb9abada4e",
                        "entry_id": "ef47ab89-5ad1-3421-9db8-3ea8c236fe63",
                        "glosses": [
                            "Emerging; coming into view or into existence; nascent; new."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "96db4ae4-f623-38a4-9128-7baf5ca11d3f",
                        "entry_id": "ef47ab89-5ad1-3421-9db8-3ea8c236fe63",
                        "glosses": [
                            "Arising unexpectedly, especially if also calling for immediate reaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0500b025-993f-4955-a939-c8330a01594c",
                                "sense_id": "96db4ae4-f623-38a4-9128-7baf5ca11d3f",
                                "text": "The chief precepts of their priests enjoin the strict keeping of their Lents, which are at least seven months in every year, and are not to be dispensed with on the most emergent necessity. Letter 43"
                            }
                        ]
                    },
                    {
                        "sense_id": "934da0c6-a473-3d8c-b14f-c6ff4bd00155",
                        "entry_id": "ef47ab89-5ad1-3421-9db8-3ea8c236fe63",
                        "glosses": [
                            "Constituting an emergency."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0516bf05-5ad5-430f-a0b6-1a84ffb481be",
                                "sense_id": "934da0c6-a473-3d8c-b14f-c6ff4bd00155",
                                "text": "Therefore, patients with ulcerative colitis should ideally be treated before they become emergent cases with toxic megacolon or perforation of the colon."
                            },
                            {
                                "example_id": "5bc905c1-4080-44dc-9b6b-c0a69b5e3844",
                                "sense_id": "934da0c6-a473-3d8c-b14f-c6ff4bd00155",
                                "text": "Bleeding manifestations in chronic DIC are more subacute than in acute DIC, but may become emergent as DIC progresses."
                            },
                            {
                                "example_id": "95c46f52-570e-4ed8-b162-67245fb01ce0",
                                "sense_id": "934da0c6-a473-3d8c-b14f-c6ff4bd00155",
                                "text": "As a rule, esophageal disorders become emergent when the airway is compromised either by the initial insult or by a high risk of aspiration."
                            },
                            {
                                "example_id": "7135a0fc-2b2c-4cbf-8092-a2d8ce391d89",
                                "sense_id": "934da0c6-a473-3d8c-b14f-c6ff4bd00155",
                                "text": "Before communication and cognition impair decision-making, and before the medical needs for interventions become emergent, advance decisions about nutrition and ventilation must be discussed."
                            }
                        ]
                    },
                    {
                        "sense_id": "43b82f88-9d49-3834-98a1-8427e25b8c89",
                        "entry_id": "ef47ab89-5ad1-3421-9db8-3ea8c236fe63",
                        "glosses": [
                            "Taller than the surrounding vegetation."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fb9d8ade-05d0-3f0d-a0e6-ed816abe4bbb",
                        "entry_id": "ef47ab89-5ad1-3421-9db8-3ea8c236fe63",
                        "glosses": [
                            "Having leaves and flowers above the water."
                        ],
                        "tags": [
                            "of a water-dwelling plant"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7dc72c49-c2a9-335c-ab2a-74cf498d4ce7",
                        "entry_id": "ef47ab89-5ad1-3421-9db8-3ea8c236fe63",
                        "glosses": [
                            "Having gameplay that arises from its mechanics, rather than a linear storyline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "994bc3c4-da53-4c94-8a66-a08e9e3c89ad",
                                "sense_id": "7dc72c49-c2a9-335c-ab2a-74cf498d4ce7",
                                "text": "In short, emergent games are ones that allow a huge range of possibilities and don't dictate a strict, linear flow of events. A strategy game is emergent because so many units can interact and have some effect on each other."
                            }
                        ]
                    },
                    {
                        "sense_id": "b484f223-3517-33fb-a1ff-b87888b265ca",
                        "entry_id": "ef47ab89-5ad1-3421-9db8-3ea8c236fe63",
                        "glosses": [
                            "That arises at a higher level than that of its components and is not explainable by the behaviour of said components taken individually; having properties as a whole that are more complex than the properties contributed by each of the components individually."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b51bdf83-e7dc-4048-a727-161b4404aeb3",
                                "sense_id": "b484f223-3517-33fb-a1ff-b87888b265ca",
                                "text": "an emergent property"
                            },
                            {
                                "example_id": "59e29483-aaa4-41d6-91cf-f7ed84d369bc",
                                "sense_id": "b484f223-3517-33fb-a1ff-b87888b265ca",
                                "text": "A high-level phenomenon is strongly emergent with respect to a low-level domain when the high-level phenomenon arises from the low-level domain, but truths concerning that phenomenon are not deducible even in principle from truths in the low-level domain.[…] A high-level phenomenon is weakly emergent with respect to a low-level domain when the high-level phenomenon arises from the low-level domain, but truths concerning that phenomenon are unexpected given the principles governing the low-level domain."
                            }
                        ]
                    }
                ],
                "translations": [
