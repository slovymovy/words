                "senses": [
                    {
                        "sense_id": "3a02827a-96a5-32ab-b0fc-a86d9a1b45a0",
                        "entry_id": "6fd8244d-827a-3d8f-abc5-a42d964263c1",
                        "glosses": [
                            "Behältnis zur Aufbewahrung einer Violine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8cb600b-1d11-4458-ab62-1fc7f57e7b33",
                                "sense_id": "3a02827a-96a5-32ab-b0fc-a86d9a1b45a0",
                                "text": "„Sie hatte ihren Violinkasten bei sich; der Vorschlag, ihr ihn zu tragen, schien der einfachste Ausweg aus meiner heiklen Lage; doch sie wollte ihn nicht aus der Hand geben.“"
                            },
                            {
                                "example_id": "61bdcf23-1614-4882-ae24-c557e69cc297",
                                "sense_id": "3a02827a-96a5-32ab-b0fc-a86d9a1b45a0",
                                "text": "„Er drückte den Violinkasten an seine Brust und küßte ihn, als sei er ein geliebtes Kind, das der Tod ihm zurückgegeben hatte.“"
                            },
                            {
                                "example_id": "318d3808-141c-4116-a7c9-deca1d8b69da",
                                "sense_id": "3a02827a-96a5-32ab-b0fc-a86d9a1b45a0",
                                "text": "„Während Herr Effeff diese Antwort mit sarkastischer Kühnheit gab, legte er seine schöne Geige behutsam in den Violinkasten und schloß ihn zu.“"
                            },
                            {
                                "example_id": "ad660317-57bf-49c8-91dc-a1abbc22f184",
                                "sense_id": "3a02827a-96a5-32ab-b0fc-a86d9a1b45a0",
                                "text": "„Die besten Violinkasten werden meistens auch aus Paris bezogen, doch werden ebenfalls in Deutschland sehr gute gearbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
