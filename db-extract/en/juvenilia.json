                        ],
                        "examples": [
                            {
                                "example_id": "9dcd0716-a2ab-4c29-9a5a-7643e01cd925",
                                "sense_id": "bbb7b0d5-4e5c-34c1-869f-c3f280df4d3e",
                                "text": "...rhyme was not his [Milton's] talent; he had neither the ease of doing it, nor the graces of it: which is manifest in his \"Juvenilia\" or verses written in his youth, where his rhyme is always constrained and forced,..."
                            },
                            {
                                "example_id": "060fc865-27e7-4f13-87b6-3efc2e415cb1",
                                "sense_id": "bbb7b0d5-4e5c-34c1-869f-c3f280df4d3e",
                                "text": "Lewis’s juvenilia is childlike, and the way it has been handled is childish."
                            },
                            {
                                "example_id": "fd071dcf-909d-4a81-9d1b-2abc96e3f7d4",
                                "sense_id": "bbb7b0d5-4e5c-34c1-869f-c3f280df4d3e",
                                "text": "Though there is a large body of criticism on Brontë’s novels, there are very few interpretations of the juvenilia, […]"
                            },
                            {
                                "example_id": "933b33b5-2e2d-43df-94fe-04480733e416",
                                "sense_id": "bbb7b0d5-4e5c-34c1-869f-c3f280df4d3e",
                                "text": "The last line, adapted from Coleridge, reminds us that we are never such kleptomaniacs as in our juvenilia."
                            }
                        ]
                    }
