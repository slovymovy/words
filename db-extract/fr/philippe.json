        "fr-extract.jsonl": [
            {
                "entry_id": "25426c5c-925e-3ab3-a876-2abb73d92261",
                "word": "Philippe",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                        "entry_id": "25426c5c-925e-3ab3-a876-2abb73d92261",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d67edc27-b7b3-404b-a7b9-0770162da56e",
                                "sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                                "text": "Baptiste Coulmont se souvient ainsi d’un Johnny devenu Philippe. Il vomissait ce prénom, trop connoté \"Idole des jeunes\"."
                            },
                            {
                                "example_id": "a21d48a1-5605-49c3-8ede-ba7efbcfc57b",
                                "sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                                "text": "Dans son ouvrage, Philippe Gasparini retrace le chemin tortueux de ce concept dont même l’initiateur du côté francophone, Serge Doubrovsky, a modifié la définition."
                            },
                            {
                                "example_id": "a271501d-a631-48e6-8119-c79fb69cf73e",
                                "sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                                "text": "C’est une deuxième défaite d’affilée pour les hommes de Peter Bosz, qui stagnent à la 5ᵉ place du classement de Ligue I, et voient revenir ceux de Philippe Clément à seulement deux petits points, à la 7ᵉ place."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37ba9ea3-950c-4d1f-b322-199a590f7969",
                        "source_entry_id": "25426c5c-925e-3ab3-a876-2abb73d92261",
                        "source_sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                        "target_lang_word": "Philipp",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philipp",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f854b3a0-1971-3812-ab18-6c50b393b5ec",
                                        "entry_id": "b5777e20-9118-3226-9493-e636ab7358a8",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "645934bc-8b74-4911-bf5b-6e998dbc3d18",
                                                "sense_id": "f854b3a0-1971-3812-ab18-6c50b393b5ec",
                                                "text": "Philipp spielt gerne Fußball."
                                            },
                                            {
                                                "example_id": "02ead86b-ed67-4671-a200-f89a5caf8dbf",
                                                "sense_id": "f854b3a0-1971-3812-ab18-6c50b393b5ec",
                                                "text": "Die beiden Philippe in der Klasse meiner Tochter sind sehr vorlaut."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "713c075d-3fcf-4335-b9b8-2fb13cc12f26",
                        "source_entry_id": "25426c5c-925e-3ab3-a876-2abb73d92261",
                        "source_sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                        "target_lang_word": "Philippi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philippi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                        "entry_id": "9c98c481-6b85-328f-8544-c24b48c5e47e",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dac704c1-6674-486e-9630-0973175bb232",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Frau Philippi ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "633aa8aa-afc7-4eab-aab6-97ed2198f485",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Herr Philippi wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "7452b76f-d40e-4b71-a9b1-ea40dee0983e",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Die Philippis fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "59df287f-3897-49fe-a595-a55bb2ebbf4f",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Der Philippi trägt nie die Schals, die die Philippi ihm strickt."
                                            },
                                            {
                                                "example_id": "140462d1-5b69-4406-8533-1b6304469135",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Philippi kommt, geht der Herr Philippi.“"
                                            },
                                            {
                                                "example_id": "243e5a46-1f1f-438b-8b30-8c01ae56c854",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Philippi kommt und geht."
                                            },
                                            {
                                                "example_id": "d905f1c4-14f2-4fcf-a911-4030ecc1ca93",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Philippis kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55d81a98-78d4-4d29-8044-b93bd6c2dbb7",
                        "source_entry_id": "25426c5c-925e-3ab3-a876-2abb73d92261",
                        "source_sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                        "target_lang_word": "Philip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a5f7f0c-8517-34da-933e-1edb1d6187c2",
                                        "entry_id": "59519dd9-bb47-32e6-b6d1-1b9b167f669e",
                                        "glosses": [
                                            "One of the twelve disciples of Jesus in the Bible; one of the seven deacons."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b1b4dda-865f-34d1-abb4-c082f41e38a4",
                                        "entry_id": "59519dd9-bb47-32e6-b6d1-1b9b167f669e",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7576be15-18fb-4e2f-96da-548ded3dc10a",
                                                "sense_id": "4b1b4dda-865f-34d1-abb4-c082f41e38a4",
                                                "text": "Philip Berold, conceiting this his name, very Clerkly proves that Philip is an Apostolical name by Saint Philip the Apostle, a Royal name by King Philip King of Macedonia, and an Imperial name by Philip the first Christian Emperour."
                                            },
                                            {
                                                "example_id": "fe1a443f-6f6b-45f3-b2bc-2369c78c68b6",
                                                "sense_id": "4b1b4dda-865f-34d1-abb4-c082f41e38a4",
                                                "text": "I used to envy my brother his name, and recall once accusing my mother of having favored him, else why did she name me Nathan and him Philip, tell me that, ma, tell me that. He had king Philip and if day-dreaming that association wasn't pleasure enough, there was the then movie star, Phillips Holmes. All I had was Nathan Hale."
                                            },
                                            {
                                                "example_id": "40478c4d-e2b2-41c9-95fc-955f6724323c",
                                                "sense_id": "4b1b4dda-865f-34d1-abb4-c082f41e38a4",
                                                "text": "\"Philip,\" Luke repeated slowly, and a brightness came into his eyes. \"She decided to name him Philip, after all.\" \"A family name?\" Cody asked him. Luke shrugged. \"Actually, it's mine. I never much cared for it as a kid and dropped it when I started school. I insisted everyone call me by my middle name.\" \"Ellie says your son looks like a Philip,\" Sherry put in. A wide grin split Luke's face. \"\"I think she's right―he does.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c31935e8-14b6-3e10-9e1d-cdc01f0a7467",
                                        "entry_id": "59519dd9-bb47-32e6-b6d1-1b9b167f669e",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
