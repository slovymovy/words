                        "tags": [],
                        "examples": [
                            {
                                "example_id": "851ca35f-6a44-40c8-bf5c-05067e87aa1f",
                                "sense_id": "86b75e7c-937d-3d2d-a9cc-f5665215227f",
                                "text": "De bedrijven vormden een alliantie om concurrenten buiten de deur te houden."
                            },
                            {
                                "example_id": "79c5df9a-9a49-4c9b-8fa1-824f748145bd",
                                "sense_id": "86b75e7c-937d-3d2d-a9cc-f5665215227f",
                                "text": "\"In Rusland is de afgelopen weken en maanden terughoudend gereageerd op de mogelijkheid van een NAVO-lidmaatschap voor Finland en Zweden. Uit de commentaren proef je wrevel, men is in Moskou duidelijk 'not amused' en lijkt enigszins verrast door de stroomversnelling waarin dit proces ineens is gekomen. Maar concrete indicaties van een mogelijk Russisch antwoord op de uitbreiding van de alliantie zijn vooralsnog uitgebleven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff32bbdf-4d8b-4ce3-8887-327452e011d2",
                        "source_entry_id": "3936c9bf-6f96-3e80-b0d2-f296713f368d",
                        "source_sense_id": "86b75e7c-937d-3d2d-a9cc-f5665215227f",
                        "source_sense_description": "een bondgenootschap",
                        "target_lang_word": "Allianz",
