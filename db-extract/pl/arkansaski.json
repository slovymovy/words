                                "sense_id": "5c8bf686-df72-3e2f-a9ec-4015419ec7aa",
                                "text": "Nocami wyły w gąszczach dzikie zwierzęta, mianowicie jaguary, arkansaskie wilki i kujoty"
                            },
                            {
                                "example_id": "e10cf382-0de3-4d30-9552-ede986d427fc",
                                "sense_id": "5c8bf686-df72-3e2f-a9ec-4015419ec7aa",
                                "text": "Temperatura szybko rosła. Ranek niebawem przemienił się w typowe niemiłosierne arkansaskie letnie przedpołudnie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
