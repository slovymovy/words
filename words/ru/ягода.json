    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1639642c-aa33-3440-9b53-acd13b745bc9",
                    "sense_definition": "Маленький сочный плод кустарников, полукустарников или травянистых растений.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом мы ходим в лес собирать <w>ягоды</w>.",
                            "target_lang_translations": {
                                "de": "Im Sommer gehen wir in den Wald, um <w>Beeren</w> zu sammeln.",
                                "en": "In the summer, we go into the forest to pick <w>berries</w>."
                            }
                        },
                        {
                            "text": "Малина — это вкусная красная <w>ягода</w>.",
                            "target_lang_translations": {
                                "de": "Die Himbeere ist eine leckere rote <w>Beere</w>.",
                                "en": "Raspberry is a delicious red <w>berry</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "собирать ягоды",
                        "спелая ягода",
                        "лесная ягода"
                    ],
                    "target_lang_definitions": {
                        "de": "Kleine, saftige Frucht von Sträuchern, Halbsträuchern oder krautigen Pflanzen.",
                        "en": "A small juicy fruit of shrubs, dwarf shrubs, or herbaceous plants."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Beere",
                                "target_lang_sense_clarification": "kleine saftige Frucht"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "berry",
                                "target_lang_sense_clarification": "small edible fruit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed19b08e-34d0-3de0-a730-305949733e7f",
                    "sense_definition": "Многосемянный плод с сочным мякотным околоплодником.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С ботанической точки зрения томат представляет собой сочную <w>ягоду</w>.",
                            "target_lang_translations": {
                                "de": "Aus botanischer Sicht ist die Tomate eine saftige <w>Beere</w>.",
                                "en": "From a botanical perspective, a tomato is a juicy <w>berry</w>."
                            }
                        },
                        {
                            "text": "Каждая <w>ягода</w> винограда содержит несколько небольших косточек.",
                            "target_lang_translations": {
                                "de": "Jede Wein<w>beere</w> enthält einige kleine Kerne.",
                                "en": "Each grape <w>berry</w> contains a few small seeds."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сочная ягода"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "научный или ботанический контекст"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vielsamige Schließfrucht mit saftigem Fruchtfleisch im botanischen Sinne.",
                        "en": "A fleshy multi-seeded fruit without a stone (botanical definition)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Beere",
                                "target_lang_sense_clarification": "botanischer Begriff"
