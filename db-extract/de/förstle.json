                "senses": [
                    {
                        "sense_id": "9f08ec96-cb62-385f-92c9-26f9d120c570",
                        "entry_id": "f5a8ae10-a5d7-39f6-84bb-ec557caa92ad",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3442bd-d55b-4bb5-be94-b56e3566b67d",
                                "sense_id": "9f08ec96-cb62-385f-92c9-26f9d120c570",
                                "text": "Frau Förstle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8ff58aca-1a99-4936-b024-2ead1bacbad3",
                                "sense_id": "9f08ec96-cb62-385f-92c9-26f9d120c570",
                                "text": "Herr Förstle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "38bed019-bd40-4f8b-8001-459a3a3f80e0",
                                "sense_id": "9f08ec96-cb62-385f-92c9-26f9d120c570",
                                "text": "Die Förstles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "995a9fff-088a-4e79-90a3-8da25584b6ec",
                                "sense_id": "9f08ec96-cb62-385f-92c9-26f9d120c570",
                                "text": "Der Förstle trägt nie die Pullover, die die Förstle ihm strickt."
                            },
                            {
                                "example_id": "e505c3ae-c14b-447b-b9c5-eb8f0b0ee967",
                                "sense_id": "9f08ec96-cb62-385f-92c9-26f9d120c570",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Förstle kommt, geht der Herr Förstle.“"
                            },
                            {
                                "example_id": "c1f91122-b44c-4711-804c-d841d43e6975",
                                "sense_id": "9f08ec96-cb62-385f-92c9-26f9d120c570",
                                "text": "Förstle kommt und geht."
                            },
                            {
                                "example_id": "1a866d85-cb52-46ff-9c28-29acda1e2e57",
                                "sense_id": "9f08ec96-cb62-385f-92c9-26f9d120c570",
                                "text": "Förstles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
