                ],
                "senses": [
                    {
                        "sense_id": "c1f8b12b-2fd7-337a-816c-4511b5df2f80",
                        "entry_id": "648a7cf5-d87b-35c7-9159-77d9e6f7b90d",
                        "glosses": [
                            "Schmerzgefühl im Bauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bff84a6-6248-46a3-912f-e17efb87a378",
                                "sense_id": "c1f8b12b-2fd7-337a-816c-4511b5df2f80",
                                "text": "„In der Pflanzenheilkunde gilt er seit Jahrhunderten als das Mittel der Wahl, um Magenzwicken, Darmkrämpfen oder einem aufgeblähten Bauch Paroli zu bieten.“"
                            },
                            {
                                "example_id": "6530ca52-d179-4011-9fdf-846ede15f757",
                                "sense_id": "c1f8b12b-2fd7-337a-816c-4511b5df2f80",
                                "text": "„Aber ich dachte kurz an die gestrigen Blähungen und das Magenzwicken und entschied mich lieber für Pfannkuchen.“"
                            },
                            {
                                "example_id": "41979a45-c3bb-40e1-b649-44a2842c8c60",
                                "sense_id": "c1f8b12b-2fd7-337a-816c-4511b5df2f80",
                                "text": "„Obwohl das Zittern und Magenzwicken immer wiederkehrte, wollten Daka und Silvania ihre Eltern nicht alarmieren.“"
                            },
                            {
                                "example_id": "f5546aba-d8c9-434a-8716-6138d3c54c88",
                                "sense_id": "c1f8b12b-2fd7-337a-816c-4511b5df2f80",
                                "text": "„Trotz des dem Termindruck geschuldetem Magenzwickens, sind die beiden zuversichtlich, dass alles klappen wird.“"
                            },
                            {
                                "example_id": "95c01046-94de-4cf5-be37-e48a09e4432a",
                                "sense_id": "c1f8b12b-2fd7-337a-816c-4511b5df2f80",
                                "text": "„Glaubt man der Fernseh- und Internetwerbung des Herstellers, ist das Präparat ein probates Mittel für die Behandlung aller möglichen Wehwehchen – von Magenzwicken nach zu üppigen Mahlzeiten bis hin zu allgemeinem Unwohlsein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "adeb43f2-ce74-3d64-896c-9abb3b85b97e",
                        "entry_id": "648a7cf5-d87b-35c7-9159-77d9e6f7b90d",
                        "glosses": [
                            "unangenehmes Gefühl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d27529-1e16-4e47-bd62-4be35f6cd02e",
                                "sense_id": "adeb43f2-ce74-3d64-896c-9abb3b85b97e",
                                "text": "„Und er spürte schon jetzt mehr als ein leichtes Magenzwicken, bloß weil er an ihn dachte.“"
                            },
                            {
                                "example_id": "49e569a1-8c49-4a2a-9009-468d5ab76a87",
                                "sense_id": "adeb43f2-ce74-3d64-896c-9abb3b85b97e",
                                "text": "„Er hoffte einfach darauf, dass dies nicht der Fall sein würde, auch wenn ihm sein Magenzwicken etwas anderes sagte.“"
                            },
                            {
                                "example_id": "0bf20799-f268-41bd-825b-f3fe5e2c5bdd",
                                "sense_id": "adeb43f2-ce74-3d64-896c-9abb3b85b97e",
                                "text": "„Die Vorstellung, wieder in dieses Gebäude des Horrors zu gehen und vielleicht noch mal Herrn Graup zu begegnen, löste ein Magenzwicken aus.“"
                            },
                            {
                                "example_id": "e4a09401-c563-4901-a5bf-16c38e2781a2",
                                "sense_id": "adeb43f2-ce74-3d64-896c-9abb3b85b97e",
                                "text": "„Er bekam Magenzwicken und schaute auf seine Uhr: 8.27 Uhr, Zeit, dem Feind zu begegnen.“"
                            },
                            {
                                "example_id": "9aa5f517-794d-45fd-a85b-e9e3b674183d",
                                "sense_id": "adeb43f2-ce74-3d64-896c-9abb3b85b97e",
                                "text": "„»Dass wir wohl doch noch in den vierten Stock müssen!«, antwortete Tom und bekam plötzlich so ein komisches Magenzwicken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
