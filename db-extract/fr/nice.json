                                                "sense_id": "ec412d59-7c4c-3d66-b837-6790e551380f",
                                                "text": "Im nächsten September werde ich wieder Urlaub in Nizza machen."
                                            },
                                            {
                                                "example_id": "27c28a93-2504-4519-83c4-7ddcd4219b21",
                                                "sense_id": "ec412d59-7c4c-3d66-b837-6790e551380f",
                                                "text": "„Durch die geschützte Lage ist Nizza auch im Winter einer der wärmsten Orte an der französischen Côte d’Azur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
