                "senses": [
                    {
                        "sense_id": "01f123f5-b0b9-35d1-a125-48219435dd6f",
                        "entry_id": "4f8c011c-f2f9-39b0-b969-acf160f8b464",
                        "glosses": [
                            "Péninsule formant l’extrémité sud-est de la région des Pouilles en Italie."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "3a844592-0661-4b86-9ecd-c3db1bcc8c77",
                                "sense_id": "01f123f5-b0b9-35d1-a125-48219435dd6f",
                                "text": "Dans le territoire de Salente, auprès de la ville de Mandurie, se trouve un lac plein jusqu’aux bords"
                            },
                            {
                                "example_id": "9179bfcb-65ca-4718-95fe-a38ed9825bef",
                                "sense_id": "01f123f5-b0b9-35d1-a125-48219435dd6f",
                                "text": "Il annonce pour l’année suivante la déroute des Turcs qui viennent de s’emparer d’Otrante, dans le Salente"
                            },
                            {
                                "example_id": "96812fa0-0b25-438a-868d-a91bc254b825",
                                "sense_id": "01f123f5-b0b9-35d1-a125-48219435dd6f",
                                "text": "Il y a moins d’un demi-siècle encore, dans le Salente (la partie sud des Pouilles), on faisait danser à domicile les personnes qui présentaient certains troubles attribués par la croyance populaire à la morsure d’une tarentule"
                            },
                            {
                                "example_id": "705bbf8d-a8a8-4d3d-adc7-c018ac1637ad",
                                "sense_id": "01f123f5-b0b9-35d1-a125-48219435dd6f",
                                "text": "En dehors de quelques enclaves privilégiées, comme le Salente"
                            }
                        ]
                    }
                ],
