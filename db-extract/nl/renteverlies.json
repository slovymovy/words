                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a4e0766-d0e5-45b2-8631-732ee0604eb8",
                                "sense_id": "b856a29a-0d8c-3f10-b841-d63015648e6a",
                                "text": "Finland krijgt voor honderden miljoenen aan nieuwe Griekse staatsobligaties. In ruil moet Finland veel eerder geld in het noodfonds stoppen, wat volgens De Jager een fors renteverlies oplevert. Ook krijgt Finland minder van de rente die Athene op de noodhulp moet betalen."
                            },
                            {
                                "example_id": "92de85c3-6be0-4234-aa3b-e9210278bbeb",
                                "sense_id": "b856a29a-0d8c-3f10-b841-d63015648e6a",
                                "text": "Voor spaarders zit er niet veel anders op dan het renteverlies te nemen."
                            }
                        ]
                    }
