                    {
                        "sense_id": "ca22b5a4-c392-3796-93ed-2320a51ee1fc",
                        "entry_id": "79d6e9d9-426c-3359-a476-647cbc68f604",
                        "glosses": [
                            "třetí osoba singuláru oznamovacího způsobu futura prostého slovesa être"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f8a3c8f7-1a16-4d4f-a0db-38383f1cfd1f",
                                "sense_id": "ca22b5a4-c392-3796-93ed-2320a51ee1fc",
                                "text": "Dans le futur, même la plus petite entreprise sera multinationale.",
                                "translation": "V budoucnosti i ta nejmenší firmička bude nadnárodní."
                            },
                            {
                                "example_id": "47e836f3-dbbc-4189-b926-eee39fc4c535",
                                "sense_id": "ca22b5a4-c392-3796-93ed-2320a51ee1fc",
                                "text": "Qui sera, qui sera l’amour fou que me consolera - après toi...",
                                "translation": "Kdo, kdo jen bude tou šílenou láskou, co by mě utěšila - po tobě..."
                            },
                            {
                                "example_id": "b45a2c3c-88c8-4b93-8367-46407ced17c4",
                                "sense_id": "ca22b5a4-c392-3796-93ed-2320a51ee1fc",
                                "text": "Dans le futur, le commerce Sud-Sud sera la norme, pas l’exception.",
                                "translation": "V budoucnosti bude obchod Jihu s Jihem pravidlem, nikoliv výjimkou."
                            }
                        ]
                    }
                ],
