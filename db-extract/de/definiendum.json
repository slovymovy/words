                        "examples": [
                            {
                                "example_id": "bce75cdc-479a-4c34-82c3-ccd4c73f9878",
                                "sense_id": "7e29ace3-c7a6-30e4-9905-054036d7270e",
                                "text": "In \"Ein Mann ist ein erwachsener, männlicher Mensch.\" ist \"Mann\" das Definiendum, \"ein erwachsener, männlicher Mensch\" das Definiens."
