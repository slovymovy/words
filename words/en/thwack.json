{
    "word_family": [
        "bethwack"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b03c3e08-98f3-3e73-a18c-175fe85be9ca",
                    "sense_definition": "To hit someone or something hard, especially with a flat implement or stick.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hit_strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cricket batsman stepped forward and <w>thwacked</w> the ball clear over the boundary fence.",
                            "target_lang_translations": {
                                "zh": "板球击球手向前迈出一步，<w>猛击</w>球，将它直接打过了界墙。"
                            }
                        },
                        {
                            "text": "She took a rolled-up magazine and <w>thwacked</w> the wasp on the kitchen window.",
                            "target_lang_translations": {
                                "zh": "她拿起一本卷起来的杂志，朝着厨房窗户上的黄蜂<w>狠打</w>过去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whack",
                        "smite",
                        "strike",
                        "thrash",
                        "batter"
                    ],
                    "common_phrases": [
                        "thwack the ball"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指用扁平物体或棍棒）狠打，猛击"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "猛击",
                                "target_lang_sense_clarification": "使劲用力击打"
                            },
                            {
                                "target_lang_word": "狠打",
                                "target_lang_sense_clarification": "用力击打"
                            },
                            {
                                "target_lang_word": "重击",
                                "target_lang_sense_clarification": "大力打击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb650a1b-534e-3084-8698-d332891ef2d1",
                    "sense_definition": "To drive or force someone or something by, or as if by, striking or hitting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hit_strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry crowd threatened to <w>thwack</w> the intruder out of the courtyard with brooms.",
                            "target_lang_translations": {
                                "zh": "愤怒的人群威胁要用扫帚把闯入者<w>打出</w>院子。"
                            }
                        },
                        {
                            "text": "They had to <w>thwack</w> the heavy wooden door repeatedly to knock it free from the frame.",
                            "target_lang_translations": {
                                "zh": "他们不得不反复<w>砸击</w>厚重的木门，好让它从门框上松脱下来。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（通过击打、打击）驱赶，迫使移动"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打逐",
                                "target_lang_sense_clarification": "边打边赶"
                            },
                            {
                                "target_lang_word": "打出",
                                "target_lang_sense_clarification": "击打使之离开"
                            },
                            {
                                "target_lang_word": "砸开",
                                "target_lang_sense_clarification": "通过击打迫使其移动或松开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94e0f6df-8065-30c4-b891-0bfe60672be4",
                    "sense_definition": "To decisively defeat or beat someone in a contest or battle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our veteran champion managed to <w>thwack</w> the arrogant challenger in the final round.",
                            "target_lang_translations": {
                                "zh": "我们经验丰富的老将成功在最后一轮<w>痛击</w>了那位傲慢的挑战者。"
                            }
                        },
                        {
                            "text": "He boasted that he would easily <w>thwack</w> any opponent sent against him.",
                            "target_lang_translations": {
                                "zh": "他吹嘘说自己可以轻而易举地<w>击败</w>派来对阵他的任何对手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thrash",
                        "beat"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical figurative use for defeating an opponent"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "彻底击败，痛击（对手）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "痛击",
                                "target_lang_sense_clarification": "狠狠击败"
                            },
                            {
                                "target_lang_word": "击败",
                                "target_lang_sense_clarification": "战胜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67bd5d1b-a229-308c-9c30-3aaaac0ed5d6",
                    "sense_definition": "To pack, cram, or press things or people closely together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pack_cram",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>thwacked</w> too many awkward references into the margins of a single page.",
                            "target_lang_translations": {
                                "zh": "作者在一页的页边空白处<w>塞入</w>了太多生硬的引文。"
                            }
                        },
                        {
                            "text": "He managed to <w>thwack</w> three bulky packages into the small storage compartment.",
                            "target_lang_translations": {
                                "zh": "他设法把三个大包裹<w>硬塞</w>进了那个狭小的储物舱里。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Used historically to describe packing or cramming things together"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "紧紧塞进，挤入，塞满"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "塞入",
                                "target_lang_sense_clarification": "强行硬塞进去"
                            },
                            {
                                "target_lang_word": "硬塞",
                                "target_lang_sense_clarification": "紧紧塞进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3365448f-f48e-3d55-aa95-125ce42dcf38",
                    "sense_definition": "To crowd or pack a place or container full with people or objects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pack_cram",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old hall was completely <w>thwacked</w> with excited villagers eager to hear the announcement.",
                            "target_lang_translations": {
                                "zh": "旧大厅里完全<w>挤满</w>了急于听到公告的兴奋村民。"
                            }
                        },
                        {
                            "text": "His memory was <w>thwacked</w> with diverse stories collected during decades of foreign travel.",
                            "target_lang_translations": {
                                "zh": "他的记忆中<w>塞满</w>了数十年来在异国旅行时收集到的各种故事。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical usage for packing or crowding a space"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "挤满，塞满（地方或容器）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挤满",
                                "target_lang_sense_clarification": "空间被充满"
                            },
                            {
                                "target_lang_word": "塞满",
                                "target_lang_sense_clarification": "充斥着"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b983489d-1243-3510-853e-dffa0b7cce94",
                    "sense_definition": "To fall down hard with a heavy thump or dull noise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hit_strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boy slipped on the frozen puddle and down he <w>thwacked</w> onto the ice.",
                            "target_lang_translations": {
                                "zh": "小男孩在结冰的水洼上滑倒，扑通一声重重<w>摔在</w>冰面上。"
                            }
                        },
                        {
                            "text": "A heavy sack slipped from the cart and <w>thwacked</w> against the cobblestones.",
                            "target_lang_translations": {
                                "zh": "一只沉重的麻袋从大车上滑落，砰的一声重重<w>砸在</w>鹅卵石路上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary descriptions of falling"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "重重地摔下，扑通倒下（伴随沉闷响声）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重摔",
                                "target_lang_sense_clarification": "重重跌落"
                            },
                            {
                                "target_lang_word": "扑通摔倒",
                                "target_lang_sense_clarification": "发出重响跌倒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfd2a61f-5438-3677-9072-d187191f2c97",
                    "sense_definition": "To be crammed or filled to overflowing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pack_cram",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room began to <w>thwack</w> with eager spectators arriving from every nearby town.",
                            "target_lang_translations": {
                                "zh": "从附近各城镇赶来的热切观众让房间开始<w>挤满</w>了人。"
                            }
                        },
                        {
                            "text": "The market stall seemed to <w>thwack</w> with every kind of fresh fruit imaginable.",
                            "target_lang_translations": {
                                "zh": "集市摊位上似乎<w>充塞</w>着能想象到的各种新鲜水果。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Obsolete intransitive use meaning to be crammed full"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "挤得满满当当，充斥"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挤满",
                                "target_lang_sense_clarification": "充满人或物"
                            },
                            {
                                "target_lang_word": "充塞",
                                "target_lang_sense_clarification": "塞满"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57943820-1a94-3f03-996c-1a543ff9beb4",
                    "sense_definition": "Of people: to crowd or rush together into a place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pack_cram",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Frightened citizens started to <w>thwack</w> to the fortress when gunfire sounded outside the gates.",
                            "target_lang_translations": {
                                "zh": "城门外枪声响起时，受惊的市民开始<w>蜂拥</w>奔向要塞。"
                            }
                        },
                        {
                            "text": "Crowds would often <w>thwack</w> to the town square whenever a messenger arrived.",
                            "target_lang_translations": {
                                "zh": "每当信使到来，人群常常会<w>涌向</w>城镇广场。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical intransitive use referring to people crowding together"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（人群）蜂拥而至，成群涌向"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蜂拥",
                                "target_lang_sense_clarification": "成群涌向某处"
                            },
                            {
                                "target_lang_word": "涌向",
                                "target_lang_sense_clarification": "成群奔向"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "34c2e6c4-304e-3e10-96d1-a339c6fa8402",
                    "sense_definition": "A hard blow or strike, especially one delivered with a flat implement or a stick.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hit_strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer gave the stubborn donkey a hearty <w>thwack</w> with his wooden staff.",
                            "target_lang_translations": {
                                "zh": "农夫用木棍狠狠给了那头倔强的驴子一记<w>重击</w>。"
                            }
                        },
                        {
                            "text": "One solid <w>thwack</w> from the paddle sent the small canoe gliding across the lake.",
                            "target_lang_translations": {
                                "zh": "船桨用力的一记<w>猛击</w>，让小独木舟在湖面上滑行开来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whack",
                        "thump",
                        "blow",
                        "strike"
                    ],
                    "common_phrases": [
                        "hearty thwack",
                        "heavy thwack"
                    ],
                    "target_lang_definitions": {
                        "zh": "重击，猛打（尤指用扁平物体或棍棒造成的打击）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重击",
                                "target_lang_sense_clarification": "沉重的一击"
                            },
                            {
                                "target_lang_word": "猛击",
                                "target_lang_sense_clarification": "用力击打的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd4a953e-9ced-356b-87f5-f3f18bda45c0",
                    "sense_definition": "A dull, heavy, or slapping sound made by an impact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard a loud <w>thwack</w> as the heavy dictionary dropped onto the floorboards.",
                            "target_lang_translations": {
                                "zh": "厚重的大字典掉在地板上时，我们听到了很大的一声<w>砰声</w>。"
                            }
                        },
                        {
                            "text": "The ball hit the wooden wall with a sharp <w>thwack</w> that startled everyone.",
                            "target_lang_translations": {
                                "zh": "球以清脆的<w>啪嗒声</w>砸在木墙上，把所有人都吓了一跳。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thump",
                        "thwomp"
                    ],
                    "common_phrases": [
                        "loud thwack",
                        "sharp thwack"
                    ],
                    "target_lang_definitions": {
                        "zh": "啪嗒声，砰声，沉闷的撞击声"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "砰声",
                                "target_lang_sense_clarification": "沉重的打击声"
                            },
                            {
                                "target_lang_word": "啪嗒声",
                                "target_lang_sense_clarification": "撞击发出的响声"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "66a47dbe-3d81-340d-a8a4-e8adb9f954e8",
                    "sense_definition": "Used to represent the dull or heavy slapping sound of an impact or hit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The girl brought the book down on the desk—<w>thwack</w>!—silencing the entire room.",
                            "target_lang_translations": {
                                "zh": "女孩把书往桌上一拍——<w>啪</w>！——整个房间瞬间安静下来。"
                            }
                        },
                        {
                            "text": "And then, <w>thwack</w>! The stray tennis ball struck the wooden fence with great force.",
                            "target_lang_translations": {
                                "zh": "紧接着，<w>砰</w>！飞来的网球重重地砸在木栅栏上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whack",
                        "thump"
                    ],
                    "target_lang_definitions": {
                        "zh": "（拟声词，表示猛击或沉闷拍打声）啪！砰！"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "啪",
                                "target_lang_sense_clarification": "拍击声"
                            },
                            {
                                "target_lang_word": "砰",
                                "target_lang_sense_clarification": "猛击声"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}