                                "example_id": "7b071bc2-6339-4653-93a3-6ffab9b8b9f7",
                                "sense_id": "f1943250-f8a8-3aba-afd3-b531a4781ca7",
                                "text": "Mais cette assurance était démentie par son air égaré, car la terre ondulait et giroyait autour de lui comme ensorcelée, et avant de savoir ce qui lui arrivait, il tomba sur son séant et leva des yeux hébétés vers l’aviateur."
                            },
                            {
                                "example_id": "46adf0b8-1087-4771-8eb1-10cd42ffccb7",
                                "sense_id": "f1943250-f8a8-3aba-afd3-b531a4781ca7",
                                "text": "Je dois giroyer en un train d’ouragan."
                            }
                        ]
                    }
