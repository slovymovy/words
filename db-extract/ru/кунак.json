                "senses": [
                    {
                        "sense_id": "d3b4d469-87ea-38aa-a91f-1fde4eb1be7f",
                        "entry_id": "1634f797-29ea-342b-85a8-20a1516b0295",
                        "glosses": [
                            "этногр. у некоторых народов — лицо, связанное с кем-нибудь обязательством взаимного гостеприимства и дружбы; друг, приятель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd488a47-3c21-427b-ac14-3be8389ca2e8",
                                "sense_id": "d3b4d469-87ea-38aa-a91f-1fde4eb1be7f",
                                "text": "Лихонин — мой друг, мой брат и кунак."
                            },
                            {
                                "example_id": "ade0f295-d077-4ea8-83b6-1d38568ffcbc",
                                "sense_id": "d3b4d469-87ea-38aa-a91f-1fde4eb1be7f",
                                "text": "Раз приезжает сам старый князь звать нас на свадьбу: он отдавал старшую дочь замуж, а мы были с ним кунаки: так нельзя же, знаете, отказаться, хоть он и татарин."
                            }
                        ]
                    }
                ],
