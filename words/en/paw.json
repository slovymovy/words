{
    "word_family": [
        "pawing",
        "pawed",
        "pawless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f295586-0bc9-3792-b3dd-515bbfe83127",
                    "sense_definition": "the soft foot of a mammal or other animal, generally a quadruped, that has claws or nails",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat licked its <w>paw</w> after finishing its meal.",
                            "target_lang_translations": {
                                "ru": "Кошка вылизала свою <w>лапу</w> после еды."
                            }
                        },
                        {
                            "text": "The bear left a large <w>paw</w> print in the soft mud near the river.",
                            "target_lang_translations": {
                                "ru": "Медведь оставил большой отпечаток <w>лапы</w> в мягкой грязи у реки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paw print",
                        "front paw",
                        "hind paw"
                    ],
                    "target_lang_definitions": {
                        "ru": "мягкая лапа млекопитающего или другого животного, обычно четвероногого, имеющая когти или ногти"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапа",
                                "target_lang_sense_clarification": "конечность животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "394bf0f4-325a-34c8-9723-e5d6111b770d",
                    "sense_definition": "a human hand, especially when used clumsily or rudely",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "human_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get your grubby <w>paws</w> off my clean laundry right now!",
                            "target_lang_translations": {
                                "ru": "А ну убери свои грязные <w>лапы</w> от моего чистого белья!"
                            }
                        },
                        {
                            "text": "He tried to grab the sandwich with his big <w>paws</w> before I could serve it.",
                            "target_lang_translations": {
                                "ru": "Он попытался схватить бутерброд своими огромными <w>лапищами</w>, прежде чем я успела его подать."
                            }
                        }
                    ],
                    "synonyms": [
                        "hand"
                    ],
                    "common_phrases": [
                        "grubby paws",
                        "get your paws off"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used humorously or disparagingly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человеческая рука, особенно если она используется неуклюже или грубо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапа",
                                "target_lang_sense_clarification": "грубо о руке человека"
                            },
                            {
                                "target_lang_word": "грабли",
                                "target_lang_sense_clarification": "сленг, о неуклюжих руках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caa101e7-4f42-3995-93f4-eb5af809ac26",
                    "sense_definition": "a familiar or dialectal term for <w>father</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>paw</w> used to take us fishing every Sunday morning.",
                            "target_lang_translations": {
                                "ru": "Мой <w>папаша</w> возил нас на рыбалку каждое воскресное утро."
                            }
                        },
                        {
                            "text": "He asked his <w>paw</w> for permission to borrow the old truck.",
                            "target_lang_translations": {
                                "ru": "Он спросил у <w>бати</w> разрешения одолжить старый грузовик."
                            }
                        }
                    ],
                    "synonyms": [
                        "pa",
                        "dad",
                        "father",
                        "papa"
                    ],
                    "antonyms": [
                        "maw"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily Southern US or Appalachian"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "informal family address"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "фамильярное или диалектное обращение к отцу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "папаша",
                                "target_lang_sense_clarification": "просторечное обращение"
                            },
                            {
                                "target_lang_word": "батя",
                                "target_lang_sense_clarification": "разговорное, региональное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b37cd37-605e-30e6-87f7-879e243f9651",
                    "sense_definition": "of an animal, to touch or stroke something with a paw",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog began to <w>paw</w> at the door when it wanted to go outside.",
                            "target_lang_translations": {
                                "ru": "Собака начала <w>скрестись</w> в дверь, когда захотела выйти на улицу."
                            }
                        },
                        {
                            "text": "The kitten would <w>paw</w> at the string whenever I moved it.",
                            "target_lang_translations": {
                                "ru": "Котенок <w>трогал лапкой</w> ниточку каждый раз, когда я ею шевелил."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paw at the door",
                        "paw at the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "о животном: трогать или гладить что-либо лапой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трогать лапой",
                                "target_lang_sense_clarification": "действие животного"
                            },
                            {
                                "target_lang_word": "скрестись",
                                "target_lang_sense_clarification": "когда животное просится внутрь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52560273-36bd-307d-8119-e973acc21241",
                    "sense_definition": "of an animal, to scrape or beat the ground with a hoof or forefoot",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restless horse started to <w>paw</w> the ground while waiting for its rider.",
                            "target_lang_translations": {
                                "ru": "Неспокойная лошадь начала <w>бить копытом</w> о землю в ожидании всадника."
                            }
                        },
                        {
                            "text": "The bull would <w>paw</w> at the dirt before charging toward the fence.",
                            "target_lang_translations": {
                                "ru": "Бык <w>рыл землю</w>, прежде чем броситься к забору."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paw the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "о животном: скрести или бить по земле копытом или передней ногой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить копытом",
                                "target_lang_sense_clarification": "о лошадях или быках"
                            },
                            {
                                "target_lang_word": "рыть землю",
                                "target_lang_sense_clarification": "перед атакой или от нетерпения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1028a2b6-140d-3cfe-9927-e52d1754b385",
                    "sense_definition": "to touch someone in a clumsy, rude, or unwanted sexual way",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "human_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt uncomfortable when the stranger started to <w>paw</w> at her arm.",
                            "target_lang_translations": {
                                "ru": "Ей стало неприятно, когда незнакомец начал <w>лапать</w> её за руку."
                            }
                        },
                        {
                            "text": "He was flirting with the guests but he was not <w>pawing</w> them.",
                            "target_lang_translations": {
                                "ru": "Он флиртовал с гостями, но не <w>распускал руки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grope",
                        "fondle",
                        "feel up"
                    ],
                    "common_phrases": [
                        "paw at each other"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often implies disapproval"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "трогать кого-либо неуклюже, грубо или нежелательным сексуальным образом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распускать руки",
                                "target_lang_sense_clarification": "неуместно трогать"
                            },
                            {
                                "target_lang_word": "лапать",
                                "target_lang_sense_clarification": "грубо и нежелательно прикасаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "552d5cf7-946f-31d1-8184-efeb326bc54b",
                    "sense_definition": "to search or dig through something in a clumsy or hurried manner",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "searching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>paw</w> through the pile of papers looking for his keys.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>рыться</w> в стопке бумаг в поисках ключей."
                            }
                        },
                        {
                            "text": "The shoppers would <w>paw</w> through the bargain bin to find the best deals.",
                            "target_lang_translations": {
                                "ru": "Покупатели <w>копались</w> в корзине с распродажей, чтобы найти самые выгодные предложения."
                            }
                        }
                    ],
                    "synonyms": [
                        "rummage",
                        "fumble"
                    ],
                    "common_phrases": [
                        "paw through"
                    ],
                    "target_lang_definitions": {
                        "ru": "искать или копаться в чем-то неуклюже или в спешке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыться",
                                "target_lang_sense_clarification": "беспорядочно искать"
                            },
                            {
                                "target_lang_word": "копаться",
                                "target_lang_sense_clarification": "перебирать вещи руками"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}