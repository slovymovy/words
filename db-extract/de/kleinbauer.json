                "senses": [
                    {
                        "sense_id": "56aaca73-7fad-3975-a318-d790f4cbae69",
                        "entry_id": "2fb197e7-0c40-348e-9c97-99eac4d74cfd",
                        "glosses": [
                            "Petit paysan, exploitant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b45f60fb-552d-460e-9a0a-6545d49330e4",
                                "sense_id": "56aaca73-7fad-3975-a318-d790f4cbae69",
                                "text": "Ausländische In­ves­to­ren haben Sierra Leones Kleinbauern mit Pachtverträgen über Jahrzehnte Land abgeluchst. Neue Gesetze sollen das nun verhindern.",
                                "translation": "Pendant des décennies, des investisseurs étrangers ont soutiré des terres aux petits paysans sierra-léonais par le biais de contrats de location. De nouvelles lois doivent désormais empêcher cela."
                            },
                            {
                                "example_id": "e8afaa2a-5024-41c5-b430-6b2916ab4507",
                                "sense_id": "56aaca73-7fad-3975-a318-d790f4cbae69",
                                "text": "In Guatemala werden ca. 270.000 Hektar Land für den Kaffeeanbau genutzt. Größtenteils sind es Kleinbauern, die den Kaffee auf ein bis zwei Hektar Land anbauen.",
                                "translation": "Au Guatemala, environ 270.000 hectares de terres sont utilisés pour la culture du café. Ce sont en grande partie des petits paysans qui cultivent le café sur un ou deux hectares."
                            },
                            {
                                "example_id": "7a873094-7557-4c4a-a32f-f998bdf07fe4",
                                "sense_id": "56aaca73-7fad-3975-a318-d790f4cbae69",
                                "text": "Trotz der vielen mühseligen Arbeit verdienen mexikanische Kleinbauern im Schnitt gerade einmal drei US-Dollar pro Tag.",
                                "translation": "Malgré tout ce travail pénible, les petits paysans mexicains gagnent en moyenne à peine trois dollars américains par jour."
                            }
                        ]
                    }
