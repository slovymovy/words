                "senses": [
                    {
                        "sense_id": "aded4bd1-0e2b-3e06-abfe-5eb3c8cee466",
                        "entry_id": "b3e1d6e2-78bf-328e-b4a9-923efd022a85",
                        "glosses": [
                            "eine in den Obergeschossen von Häusern ins Freie führende eventuell auch überdeckte Plattform, die im Gegensatz zu einem Balkon nicht frei auskragt, sondern von Mauern oder Pfeilern getragen wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c52dd3f0-54c9-491e-ae23-71e7aab90601",
                                "sense_id": "aded4bd1-0e2b-3e06-abfe-5eb3c8cee466",
                                "text": "„Da fällt von des Altans Rand / Ein Handschuh von schöner Hand“ (Schiller - Der Handschuh)"
                            },
                            {
                                "example_id": "486bdcb1-d937-4a5c-880a-fba01f65d84a",
                                "sense_id": "aded4bd1-0e2b-3e06-abfe-5eb3c8cee466",
                                "text": "„Heute weiß ich, daß damals, als ich auf dem Altan des Seefelderhauses in dem sogenannten Stubenwagen lag und hinaufblinzelte in den weißblauen Himmel, überall in Europa Rauchschwaden in der Luft hingen…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
