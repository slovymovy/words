                "senses": [
                    {
                        "sense_id": "4f50fd78-ad2f-31cd-af2a-bb3bb1c5faad",
                        "entry_id": "bcab9b8d-2ad8-3c34-85f5-40d38ce2f2e9",
                        "glosses": [
                            "Clothing; clothes."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8ba70e97-6c47-3786-ba0c-47e35d3fabd0",
                        "entry_id": "bcab9b8d-2ad8-3c34-85f5-40d38ce2f2e9",
                        "glosses": [
                            "Any hard coating, bonded onto the outside of something to add protection, such as the plastic sheath around an optical fibre."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a1dc22ea-b40a-3700-94a7-bb842a49674f",
                        "entry_id": "bcab9b8d-2ad8-3c34-85f5-40d38ce2f2e9",
                        "glosses": [
                            "A weatherproof, insulating or decorative covering fixed to the outside of a building."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eda2f3a5-80bc-477a-a754-34f033b4bb55",
                        "source_entry_id": "bcab9b8d-2ad8-3c34-85f5-40d38ce2f2e9",
                        "source_sense_description": "an outside building covering",
                        "target_lang_word": "revêtement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revêtement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b073c3e-6cf1-3376-b713-2de8903dff92",
                                        "entry_id": "beb1b864-e25c-3c2d-9d86-4c4f06406c6a",
                                        "glosses": [
                                            "Action de revêtir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e1209c5-ec45-3252-b07e-787f218633d9",
                                        "entry_id": "beb1b864-e25c-3c2d-9d86-4c4f06406c6a",
                                        "glosses": [
                                            "Sorte de placage de plâtre, de mortier, de bois, de marbre, etc., qu’on fait à une construction pour l’orner ou la consolider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8629a95a-7842-463e-823a-5c921aa668c9",
                                                "sense_id": "6e1209c5-ec45-3252-b07e-787f218633d9",
                                                "text": "Par contre, pour le petit granit et pour les ardoises, la crise continue, par suite de la tendance à remplacer les produits indigènes par des produits importés et de l'emploi plus fréquent de pierres blanches et de revêtements en pierre reconstituée."
                                            },
                                            {
                                                "example_id": "8a88b5a3-cc54-488b-a03f-f5afdbba2b1a",
                                                "sense_id": "6e1209c5-ec45-3252-b07e-787f218633d9",
                                                "text": "Il aurait suffi d'un faux mouvement pour qu'elle tombât la tète la première, d'une hauteur de deux mètres, sur le dur revêtement de ciment."
                                            },
                                            {
                                                "example_id": "ea0f5305-ae96-41be-aa66-d6f789af6bce",
                                                "sense_id": "6e1209c5-ec45-3252-b07e-787f218633d9",
                                                "text": "Ce coffrage est rempli de mortier autolissant et autonivelant et peut recevoir tous les revêtements classiques de sols."
                                            },
                                            {
                                                "example_id": "a4665618-d238-4319-bde7-6eb446738f2e",
                                                "sense_id": "6e1209c5-ec45-3252-b07e-787f218633d9",
                                                "text": "Une seconde partie mentionnait la synthèse de revêtements autoréparants à base de polymères fluorés sous champ magnétique oscillant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44a16990-dac3-3eb4-8d70-6657c8bd0b04",
                                        "entry_id": "beb1b864-e25c-3c2d-9d86-4c4f06406c6a",
                                        "glosses": [
                                            "Ouvrage de pierre, de brique, ou de quelque autre matière, servant à retenir les terres d’un fossé, d’un bastion, d’une terrasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeb094a0-07a4-4de4-8942-b6d3165ddeaa",
                                                "sense_id": "44a16990-dac3-3eb4-8d70-6657c8bd0b04",
                                                "text": "Le revêtement de ce fossé est de maçonnerie."
                                            },
                                            {
                                                "example_id": "a35ffb30-8e54-41ac-9771-a85c02dc62c5",
                                                "sense_id": "44a16990-dac3-3eb4-8d70-6657c8bd0b04",
                                                "text": "Les revêtements sont ordinairement en talus, afin de mieux soutenir la poussée des terres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd2b6614-cb6c-3f19-b2a2-e205c0f8337f",
                                        "entry_id": "beb1b864-e25c-3c2d-9d86-4c4f06406c6a",
                                        "glosses": [
                                            "Ce dont on a recouvert une voie et qui la rend carrossable, partie extérieure superficielle d’un chemin, d’une route, d’une circulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d3105be-7c82-4483-8ad0-e53f338e5370",
                                                "sense_id": "cd2b6614-cb6c-3f19-b2a2-e205c0f8337f",
                                                "text": "Le revêtement en place, souvent recouvert de gravillons, n'est pas conçu pour être normalement circulable, mais seulement ponctuellement emprunté dans le cadre d'interventions de maintenance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02cd7e2c-739f-319a-8fe8-1e92b1604336",
                                        "entry_id": "beb1b864-e25c-3c2d-9d86-4c4f06406c6a",
                                        "glosses": [
                                            "Couche superficielle appliquée à un objet, par exemple métallique, et constituée d’un matériau choisi pour ses propriétés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa76417d-95f4-434a-8f56-70fe011142b5",
                                                "sense_id": "02cd7e2c-739f-319a-8fe8-1e92b1604336",
                                                "text": "Le revêtement antiadhésif breveté garantit un nettoyage aisé de votre poêle à frire."
                                            },
                                            {
                                                "example_id": "752e1087-768d-45c8-a918-8345201dbf0b",
                                                "sense_id": "02cd7e2c-739f-319a-8fe8-1e92b1604336",
                                                "text": "Le bois est traité avec un revêtement protecteur qui le rend quasiment inaltérable."
                                            },
                                            {
                                                "example_id": "ad3ec878-a34a-4cb4-8a9d-7737b23687b3",
                                                "sense_id": "02cd7e2c-739f-319a-8fe8-1e92b1604336",
                                                "text": "ICI fabrique des explosifs, des fusils antichars, ainsi que le revêtement des cockpits de la Royal Air Force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6410360a-22cc-4e09-92cc-660caa09258e",
                        "source_entry_id": "bcab9b8d-2ad8-3c34-85f5-40d38ce2f2e9",
                        "source_sense_description": "an outside building covering",
                        "target_lang_word": "Verkleidung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkleidung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                        "entry_id": "9fc734c0-6757-357f-a98e-49b16172af39",
                                        "glosses": [
                                            "Kleidungsstück(e), um in eine fremde Rolle zu schlüpfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c947d491-f66c-430e-9501-8f314cec800c",
                                                "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                                "text": "Trotz Verkleidung habe ihn alle schnell erkannt."
                                            },
                                            {
                                                "example_id": "416526da-ff23-4b00-8a43-ca63e9fac0e6",
                                                "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                                "text": "Meine Tochter wünscht sich eine Verkleidung als Prinzessin Leia."
                                            },
                                            {
                                                "example_id": "e2fdef5d-25d0-4373-82a0-b67992ff4960",
                                                "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                                "text": "„Sie hatte sich zu dieser Verkleidung überreden lassen.“"
                                            },
                                            {
                                                "example_id": "44f1b7ef-e915-4a91-b286-42b95dbb4788",
                                                "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                                "text": "„Sonjas Verkleidung war am allerbesten gelungen.“"
                                            },
                                            {
                                                "example_id": "1a15f87d-8ff0-47cb-bb04-79e9107a5c87",
                                                "sense_id": "0c792e1e-6c70-3bc4-b614-0333de3f2e64",
                                                "text": "„Die Gäste kamen, und der Marchese sagte uns, die Verkleidung sei so beschaffen, daß wir mehr Vergnügen hätten, wenn wir uns vor dem Essen umziehen würden als nachher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "424c6565-b53c-33c6-8618-236c2c9e1b7f",
                                        "entry_id": "9fc734c0-6757-357f-a98e-49b16172af39",
                                        "glosses": [
                                            "Umhüllung zum Schutz vor Außeneinflüssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae3fae2-73b9-4f0e-b321-75d0d540e249",
                                                "sense_id": "424c6565-b53c-33c6-8618-236c2c9e1b7f",
                                                "text": "Die nachträgliche Verkleidung schützt gegen Wetterschäden."
                                            },
                                            {
                                                "example_id": "a363e64f-3ba7-48ef-84e8-e9dd37846db7",
                                                "sense_id": "424c6565-b53c-33c6-8618-236c2c9e1b7f",
                                                "text": "„Mit fahrigen Fingern tastet er die Verkleidung unter dem Fenster ab, schnappt nach dem Türhebel, klappt und zerrt daran, rüttelt mit beiden Händen an der Tür.“"
                                            },
                                            {
                                                "example_id": "c5124c7d-19bd-45bd-acf9-c30111385e02",
                                                "sense_id": "424c6565-b53c-33c6-8618-236c2c9e1b7f",
                                                "text": "Um unseren Flur zu verschönern, bekam der Heizkörper eine Verkleidung."
                                            },
                                            {
                                                "example_id": "1cad3895-2db4-40f7-ae13-872b844d1327",
                                                "sense_id": "424c6565-b53c-33c6-8618-236c2c9e1b7f",
                                                "text": "„Da gibt es Falltüren im Fußboden, Gegengifte, Verkleidungen, und alles geht wild durcheinander, rennt und entwirrt sich, ohne dem Leser eine Minute Zeit zum Nachdenken zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
