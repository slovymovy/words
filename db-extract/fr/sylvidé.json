                    {
                        "sense_id": "3f0a5ee0-6833-3ed0-b75d-3c1bccb3d043",
                        "entry_id": "e6ae0815-148b-3e92-9360-0570120293ad",
                        "glosses": [
                            "Membre d’une famille d’oiseaux passereaux, les fauvettes et alliés, petits passereaux de forêts insectivores, chanteurs et souvent migrateurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "106c39ca-2e85-4094-9e23-d496c4c1e670",
                                "sense_id": "3f0a5ee0-6833-3ed0-b75d-3c1bccb3d043",
                                "text": "Pouillot véloce (Phylloscopus collybita) petit sylvidé d’aspect svelte et délicat dont le plumage de couleur jaune verdâtre le fait ressembler aux autres pouillots mais dont le chant est totalement différent."
                            },
                            {
                                "example_id": "0763dc4d-4e41-4df1-8e9c-ab1e224b64e1",
                                "sense_id": "3f0a5ee0-6833-3ed0-b75d-3c1bccb3d043",
                                "text": "Les espèces les plus abondamment capturées sont les sylvidés (Pouillot fitis et véloce; Fauvettse des jardins, à tête noire et grisette; Rousserolle effarvatte)."
                            }
                        ]
                    }
