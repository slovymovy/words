                {
                    "sense_id": "16a43b54-fa0a-3840-83fb-e3ea91e4801b",
                    "sense_definition": "A tropical tree or shrub that grows in muddy, salty water and has roots that grow above the ground",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mangrove_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mangrove</w> trees have complex root systems that help protect the coastline from erosion.",
                            "target_lang_translations": {
                                "ru": "<w>Мангровые</w> деревья имеют сложную корневую систему, которая помогает защитить береговую линию от эрозии."
                            }
                        },
                        {
                            "text": "We saw a red <w>mangrove</w> growing in the brackish water near the river mouth.",
                            "target_lang_translations": {
                                "ru": "Мы видели красный <w>мангр</w>, растущий в солоноватой воде у устья реки."
                            }
                        }
                    ],
                    "synonyms": [
                        "mangle"
                    ],
                    "common_phrases": [
                        "red mangrove",
                        "mangrove roots",
                        "mangrove species"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тропическое дерево или кустарник, растущий в илистой соленой воде и имеющий корни, растущие над землей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мангровое дерево",
                                "target_lang_sense_clarification": "отдельное растение"
                            },
                            {
