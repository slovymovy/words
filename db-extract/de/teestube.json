                        "target_lang_word": "salon de thé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salon de thé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1be2836e-e47d-3c51-ab79-0995ba746b88",
                                        "entry_id": "f7437598-14d9-3655-8dd4-4da7c88b1a5b",
                                        "glosses": [
                                            "Endroit public dans lequel est vendu du thé, pouvant être accompagné de pâtisseries, de gâteaux sucrés et salés, le tout consommable sur place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae514e7-83a0-485b-9830-fa072f2e4d70",
                                                "sense_id": "1be2836e-e47d-3c51-ab79-0995ba746b88",
                                                "text": "C’est le grand calme et s’il n’y a pas de restaurant sur place, on a récemment ouvert une saladerie et un salon de thé pour d’agréables en-cas."
                                            },
                                            {
                                                "example_id": "202cacd6-c78a-47ed-b85d-6491b546790d",
                                                "sense_id": "1be2836e-e47d-3c51-ab79-0995ba746b88",
                                                "text": "Les adresses gourmandes connaissent le même phénomène, les brasseries, salons de thé, cafés-restaurants côtoient les fast-food, et les restaurants de cuisine étrangère font leur apparition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "187ffe64-bc2c-4868-bf8e-6f2fe6910bfc",
