                                "target_senses": [
                                    {
                                        "sense_id": "923c844e-87d0-34bb-85eb-cc6b2d7777bd",
                                        "entry_id": "c86f49bd-f428-3e8c-b3b6-d6a7008400f5",
                                        "glosses": [
                                            "Prozess, Abfolge"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f850df2-9494-4547-a516-603a5655662b",
                                                "sense_id": "923c844e-87d0-34bb-85eb-cc6b2d7777bd",
                                                "text": "Können Sie den vorgesehenen Ablauf noch einmal erklären?"
                                            },
                                            {
                                                "example_id": "69c0d5f7-4fbc-4eb8-8dbb-8aee73e5e686",
                                                "sense_id": "923c844e-87d0-34bb-85eb-cc6b2d7777bd",
                                                "text": "„Im Extremfall, so erläutert ein Schreiben des Stuttgarter Kultusministeriums vom 23. März 1982, könne die Duzerei Anlaß für die verwaltungsgerichtliche Auseinandersetzung über den formal korrekten Ablauf der Prüfung werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73ed7fa6-0501-3d0a-a870-9c5d4d7a3015",
                                        "entry_id": "c86f49bd-f428-3e8c-b3b6-d6a7008400f5",
                                        "glosses": [
                                            "Wasserablauf, eine Vorrichtung zum Ablaufen von Flüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f06b1ac5-1254-4813-a4d8-aff4b52d8e04",
                                                "sense_id": "73ed7fa6-0501-3d0a-a870-9c5d4d7a3015",
                                                "text": "Durch diesen Ablauf kann das Regenwasser entweichen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "43784404-c48b-30ac-853b-f89f4fe9a9c1",
                                        "entry_id": "c86f49bd-f428-3e8c-b3b6-d6a7008400f5",
                                        "glosses": [
                                            "ein Verbindungsbauteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2532009-2d90-4db3-9a19-c6dd78d7de3a",
                                                "sense_id": "43784404-c48b-30ac-853b-f89f4fe9a9c1",
                                                "text": "„Im südlich anstoßenden ehemaligen Klostergebäude befindet sich eine Säule mit Würfelkapitell, dessen konkaver Ablauf ebenfalls auf das frühe 13. Jahrhundert weist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "63648814-1217-3aff-bbcd-23f55c3cf0a4",
                                        "entry_id": "c86f49bd-f428-3e8c-b3b6-d6a7008400f5",
                                        "glosses": [
                                            "Beendigung einer Zeitspanne, zu Ende gehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c1f1440-630c-4b45-9ced-be68c5b5efca",
                                                "sense_id": "63648814-1217-3aff-bbcd-23f55c3cf0a4",
                                                "text": "Nach Ablauf der Frist muss das Geld bezahlt sein."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
