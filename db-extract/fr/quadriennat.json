                        "glosses": [
                            "Mandat de quatre ans ; exercice d’une charge dont la durée est de quatre ans ; durée de quatre ans d’une magistrature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b8b8123-7b63-4ce4-8000-31c726a736a0",
                                "sense_id": "4c671c0c-eb3b-3ae1-83b7-fbc7844d96b4",
                                "text": "Le quadriennat s’impose à l’Assemblée, et, du coup, sauf accident, au Chancelier allemand, au Président du gouvernement espagnol, au Premier ministre portugais ou grec."
                            },
                            {
                                "example_id": "96f03a97-4779-467f-a2e2-fe67b9a4fcd2",
                                "sense_id": "4c671c0c-eb3b-3ae1-83b7-fbc7844d96b4",
                                "text": "M. William Clinton a été élu pour deux quadriennats à la présidence des États-Unis, de 1993 à 1997 puis de 1997 à 2001."
                            }
                        ]
                    }
