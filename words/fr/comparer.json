{
    "word_family": [
        "comparable",
        "comparaison",
        "comparateur",
        "comparatif",
        "comparativement",
        "incomparable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "84e332ee-a7ab-3eb0-af2b-ab93163e6048",
                    "sense_definition": "Examiner les ressemblances et les différences entre deux ou plusieurs personnes ou choses.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "examen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il prend le temps de <w>comparer</w> les prix avant d'acheter un nouvel ordinateur."
                        },
                        {
                            "text": "Si tu <w>compares</w> ces deux photos, tu verras tout de suite la différence."
                        }
                    ],
                    "synonyms": [
                        "confronter",
                        "rapprocher"
                    ],
                    "common_phrases": [
                        "comparer les prix",
                        "comparer les offres"
                    ]
                },
                {
                    "sense_id": "7f96e40e-dd70-394a-a28d-00a4ab8e07c1",
                    "sense_definition": "Mettre sur le même plan ou juger d'une valeur équivalente.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On ne peut pas <w>comparer</w> cette modeste auberge à un grand hôtel de luxe."
                        },
                        {
                            "text": "Il refuse de se <w>comparer</w> à ses collègues plus expérimentés."
                        }
                    ],
                    "synonyms": [
                        "assimiler"
                    ],
                    "common_phrases": [
                        "se comparer à"
                    ]
                },
                {
                    "sense_id": "4a6f6a5a-b8d7-3121-be39-d1974cd94e36",
                    "sense_definition": "Rapprocher des personnes ou des choses différentes au moyen d'une image ou d'une métaphore.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète aime <w>comparer</w> la jeunesse à une fleur éphémère."
                        },
                        {
                            "text": "Dans son discours, le guide a <w>comparé</w> cette montagne à un géant endormi."
                        }
                    ],
                    "synonyms": [
                        "assimiler"
                    ]
                }
            ]
        }
    ]
}