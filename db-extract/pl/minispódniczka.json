                    {
                        "translation_id": "97a924a0-e34d-41fb-8c79-aca692cc8b5b",
                        "source_entry_id": "7c8863e5-12fd-3a37-8230-91e59084a7f9",
                        "source_sense_id": "85ca88ac-79dc-3ab7-8e7e-f29a5b9cec96",
                        "target_lang_word": "Minirock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minirock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f1594c1-dad3-3555-9fa6-e4ca7bca7339",
                                        "entry_id": "8a3d4104-97ed-3fdc-afe0-4fd66adb591c",
                                        "glosses": [
                                            "ein sehr kurzer Rock, der deutlich über dem Knie endet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1174391f-877a-488c-9178-e09b5c839a60",
                                                "sense_id": "3f1594c1-dad3-3555-9fa6-e4ca7bca7339",
                                                "text": "Im Sommer, wenn es sehr warm ist, trage ich meinen Minirock am liebsten."
                                            },
                                            {
                                                "example_id": "26c0feb2-8931-45fb-9c3e-b2549dca74fc",
                                                "sense_id": "3f1594c1-dad3-3555-9fa6-e4ca7bca7339",
                                                "text": "„Aber davon abgesehen war sie hübsch und hatte einen sehr schönen Körper, den der Minirock betonte.“"
                                            },
                                            {
                                                "example_id": "017d239f-dd87-42a1-adf0-f2a91719cce7",
                                                "sense_id": "3f1594c1-dad3-3555-9fa6-e4ca7bca7339",
                                                "text": "„Sie trug einen Minirock mit Bluse.“"
                                            },
                                            {
                                                "example_id": "faf85eab-db2a-4e1b-81a9-d8075567769f",
                                                "sense_id": "3f1594c1-dad3-3555-9fa6-e4ca7bca7339",
                                                "text": "„Auf den wenigen Fotos, die ich aus dieser Zeit kenne, trägt sie Miniröcke und wirkt fröhlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
