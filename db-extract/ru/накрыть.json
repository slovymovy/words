                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "накры́в"
                    },
                    {
                        "form_id": "9088982d-8cc3-4194-b189-ad3e246574ca",
                        "entry_id": "81ac016c-9572-33fb-8eb3-52bee339c147",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "накры́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "723784b5-412e-32de-b953-49123b94a832",
                        "entry_id": "81ac016c-9572-33fb-8eb3-52bee339c147",
                        "glosses": [
                            "положив что-либо сверху, оградить от внешнего воздействия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb2bdd50-9115-4453-a610-976c77060d97",
                                "sense_id": "723784b5-412e-32de-b953-49123b94a832",
                                "text": "Дать соусу закипеть, после чего накрыть сковороду крышкой, убавить огонь и тушить одну минуту."
                            },
                            {
                                "example_id": "12e9f813-953d-4a2c-9d47-f5484b7ef3ee",
                                "sense_id": "723784b5-412e-32de-b953-49123b94a832",
                                "text": "Ей хотелось накрыть его большую ладонь второю своей, чтобы и ей досталось тепла."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b139769-a3bb-307a-a129-24297ac9f4d4",
                        "entry_id": "81ac016c-9572-33fb-8eb3-52bee339c147",
                        "glosses": [
                            "перен. схватить, поймать на месте преступления"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bae5aa8e-40a6-423d-a3e5-faaf97a79a0b",
                                "sense_id": "4b139769-a3bb-307a-a129-24297ac9f4d4",
                                "text": "Сколько раз я Хромкову говорил: накрыть бандитов надо!"
                            },
                            {
                                "example_id": "28f6831b-6091-4d59-9fa2-a71d1f3d4aee",
                                "sense_id": "4b139769-a3bb-307a-a129-24297ac9f4d4",
                                "text": "Но именно сейчас, пока он здесь, в этом большом и тихом доме, его могли накрыть."
                            },
                            {
                                "example_id": "40a75201-550b-4da0-ab44-960f5e51b2e3",
                                "sense_id": "4b139769-a3bb-307a-a129-24297ac9f4d4",
                                "text": "В этих случаях самое первое дело, самая большая задача следствия — не дать приготовиться, накрыть неожиданно, чтобы преступник высказал заветные идеи свои во всём выдающем их простодушии, неправдоподобности и противоречии."
                            }
                        ]
                    },
                    {
                        "sense_id": "87ec17dd-88e4-3792-acd6-da0ff31ff368",
                        "entry_id": "81ac016c-9572-33fb-8eb3-52bee339c147",
                        "glosses": [
                            "перен. подготовить должным образом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b97ac2e-fd7f-4ae0-937a-c9f1b3960122",
                                "sense_id": "87ec17dd-88e4-3792-acd6-da0ff31ff368",
                                "text": "Вернувшись с Кити с вод и пригласив к себе к кофе и полковника, и Марью Евгеньевну, и Вареньку, князь велел вынести стол и кресла в садик, под каштан, и там накрыть завтрак."
                            },
                            {
                                "example_id": "2566a2e4-fdd0-4fb4-bb19-67cfc8b2cd11",
                                "sense_id": "87ec17dd-88e4-3792-acd6-da0ff31ff368",
                                "text": "Мы попросили девушек накрыть нам в кабинете столик на шестерых, хоть и было нас всего двое."
                            },
                            {
                                "example_id": "3b25a455-4bc9-422e-8634-27539235bd42",
                                "sense_id": "87ec17dd-88e4-3792-acd6-da0ff31ff368",
                                "text": "— Как напьешься, — прибавила Пульхерия Ивановна, — приходи сюда накрыть постель."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c18e6b0-35e5-3d66-8bb4-1f07fef99b9b",
                        "entry_id": "81ac016c-9572-33fb-8eb3-52bee339c147",
                        "glosses": [
                            "перен. воен. полностью поразить цель снарядами при обстреле, бомбардировке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "254b999a-ab92-4ad6-8e13-0a55b5901e78",
                                "sense_id": "1c18e6b0-35e5-3d66-8bb4-1f07fef99b9b",
                                "text": "Накануне вылета командир полка напутствовал: — Вы должны накрыть цель плотно."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
