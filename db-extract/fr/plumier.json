        "fr-extract.jsonl": [
            {
                "entry_id": "e353045e-c20e-33b1-8637-6683ba288852",
                "word": "Plumier",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bb8331ed-5f63-336a-b55f-fb9f65ef07cd",
                        "entry_id": "e353045e-c20e-33b1-8637-6683ba288852",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a44c61-bd8c-4cca-9e3e-269377a478fa",
                                "sense_id": "bb8331ed-5f63-336a-b55f-fb9f65ef07cd",
                                "text": "Le botaniste Charles Plumier rapporta de l’un de ses voyages la célèbre fleur bégonia, qu’il baptisa ainsi en hommage à son bienfaiteur Michel Bégon, intendant de la marine de Rochefort sous Louis XIV."
                            },
                            {
                                "example_id": "036ddd33-6bb6-45d5-a31a-ab8dbf23d8da",
                                "sense_id": "bb8331ed-5f63-336a-b55f-fb9f65ef07cd",
                                "text": "Il y a toujours eu beaucoup de clubs en Normandie, raconte Michel Plumier, modéliste fondateur de son propre club à Caen en 2002."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "223eb58f-0cec-3bbb-8578-ae3d16d36096",
                "word": "plumier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4df871be-e6d5-484a-a481-d1ba5106e6ab",
                        "entry_id": "223eb58f-0cec-3bbb-8578-ae3d16d36096",
                        "tags": [
                            "plural"
                        ],
                        "form": "plumiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2aadc1eb-f0c9-3882-a948-79cae6cdd367",
                        "entry_id": "223eb58f-0cec-3bbb-8578-ae3d16d36096",
                        "glosses": [
                            "Boîte de forme allongée où les écoliers mettent des plumes, des porte-plume, des crayons, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3532b865-c22a-4129-9ca0-f89318029b6e",
                                "sense_id": "2aadc1eb-f0c9-3882-a948-79cae6cdd367",
                                "text": "Ils ont dans leur plumier des gommes\nEt des hannetons du matin"
                            },
                            {
                                "example_id": "7f89d3b5-8ced-446a-a009-bbb77de01ae0",
                                "sense_id": "2aadc1eb-f0c9-3882-a948-79cae6cdd367",
                                "text": "Elle me fit d’abord présent d’un plumier en carton verni : sur le couvercle on voyait Napoléon à Sainte-Hélène : une main sur l’estomac, l’autre en auvent contre son front, il regardait la mer. C’était très beau. En appuyant sur un bouton, le couvercle s’ouvrait tout seul."
                            },
                            {
                                "example_id": "51749ac2-4bbc-4f40-95e3-17b8e4bf03ef",
                                "sense_id": "2aadc1eb-f0c9-3882-a948-79cae6cdd367",
                                "text": "La dictée terminée, nous rangions les porte-plume dans les plumiers en carton bouilli, au décor chinois."
                            },
                            {
                                "example_id": "7e183101-8b5a-4614-8584-6078a5d131b4",
                                "sense_id": "2aadc1eb-f0c9-3882-a948-79cae6cdd367",
                                "text": "Elle sortit ensuite de son plumier un petit couteau et un crayon qu’elle plaça à hauteur de ses yeux pour mieux l’examiner."
                            },
                            {
                                "example_id": "8ec05995-5a5d-4c55-ab57-c97c3eb2a77e",
                                "sense_id": "2aadc1eb-f0c9-3882-a948-79cae6cdd367",
                                "text": "En compensation, je donnais aux enfants quelque fourniture scolaire, livre, cahier, plumier, crayon, dont j’étais tenue de faire commerce sans en tirer profit."
                            }
                        ]
                    },
                    {
                        "sense_id": "b138a2f8-b6f1-3c67-86c8-9517cc12351d",
                        "entry_id": "223eb58f-0cec-3bbb-8578-ae3d16d36096",
                        "glosses": [
                            "Trousse, étui en général."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "8e0bf542-3ffa-4fda-a5db-e9e5b73ed43e",
                                "sense_id": "b138a2f8-b6f1-3c67-86c8-9517cc12351d",
                                "text": "Un plumier sert à ranger ses affaires d’école."
                            }
                        ]
                    },
                    {
                        "sense_id": "4aa1b89d-fd93-3bbf-b73a-3b1c89254898",
                        "entry_id": "223eb58f-0cec-3bbb-8578-ae3d16d36096",
                        "glosses": [
                            "Lit. référence nécessaire (résoudre le problème) → voir plumard, plume"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5569d6f0-5e6b-4210-89c8-3441e4ba14ea",
                        "source_entry_id": "223eb58f-0cec-3bbb-8578-ae3d16d36096",
                        "target_lang_word": "Griffelkasten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Griffelkasten",
