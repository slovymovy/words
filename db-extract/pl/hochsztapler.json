                "senses": [
                    {
                        "sense_id": "e8b4e8f1-5bef-3547-a707-33ddf9f7ec4c",
                        "entry_id": "b5200f40-d128-32dc-b2d2-f48a9cfb35fe",
                        "glosses": [
                            "oszust i aferzysta na dużą skalę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7d1d347-4d87-426f-ab0e-0a13ecd0c85c",
                                "sense_id": "e8b4e8f1-5bef-3547-a707-33ddf9f7ec4c",
                                "text": "Powoli sam nawet, nie wiedząc kiedy, zamieniał się z człowieka, w gruncie rzeczy uczciwego w hochsztaplera, a zmysły i próżność mile łaskotane przez Tamarę, dopomogły tej przemianie"
                            },
                            {
                                "example_id": "be1535b5-beef-42f2-bdf3-a3502e825706",
                                "sense_id": "e8b4e8f1-5bef-3547-a707-33ddf9f7ec4c",
                                "text": "Okazało się, że nie jest żadnym hochsztaplerem, lecz przedstawicielem kilku firm zagranicznych, że ma swoje biuro, że często wyjeżdża do Francji, Anglii i Niemiec, że ma własny samochód"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
