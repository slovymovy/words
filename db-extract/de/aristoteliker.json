                    }
                ],
                "translations": [
                    {
                        "translation_id": "57fd9025-5e1c-4f93-bfec-149c2bd947ec",
                        "source_entry_id": "11308ffb-e7bb-3e12-bddf-8549df1591fd",
                        "source_sense_id": "14fe2178-4450-3037-b2a3-933022e8f7e3",
                        "source_sense_description": "ein Anhänger der Lehre des Aristoteles",
                        "target_lang_word": "Aristotelian",
