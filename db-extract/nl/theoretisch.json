                        "entry_id": "0ffbc849-8342-35ab-9b7d-bf73a02af4dc",
                        "glosses": [
                            "wat niet perse in de werkelijkheid voorkomt, m.b.t. feiten en wetten berustende wetenschappelijke kennis die niet proefondervindelijk aan de praktijk is getoetst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9085baba-444b-4b86-ad5b-70bf34592346",
                                "sense_id": "9c5f007a-fcea-3abb-9edf-fd0254b14cf6",
                                "text": "Dat is slechts een theoretisch verschijnsel."
                            },
                            {
                                "example_id": "b402b948-41a3-42c7-a4a3-5b07481b8632",
                                "sense_id": "9c5f007a-fcea-3abb-9edf-fd0254b14cf6",
                                "text": "Theoretisch leek de oplossing heel eenvoudig. In de praktijk was het iets moeilijker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "411d2778-ae48-4584-b5b2-08fc810bdda1",
                        "source_entry_id": "0ffbc849-8342-35ab-9b7d-bf73a02af4dc",
                        "source_sense_id": "9c5f007a-fcea-3abb-9edf-fd0254b14cf6",
                        "source_sense_description": "wat niet perse in de werkelijkheid voorkomt, m.b.t. feiten en wetten berustende ...",
                        "target_lang_word": "theoretisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theoretisch",
