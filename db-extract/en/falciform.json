                        "glosses": [
                            "Sickle-shaped."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9c07f86-dd00-4404-8ea6-968533670ff0",
                                "sense_id": "5d91c123-4ada-3871-970b-9e0aedfd556d",
                                "text": "What announced the accomplishment of this rise in temperature?\nA double falciform ejection of water vapour from under the kettlelid at both sides simultaneously."
                            },
                            {
                                "example_id": "c9d275e2-72c6-4d48-bfa1-fc0bf6e58299",
                                "sense_id": "5d91c123-4ada-3871-970b-9e0aedfd556d",
                                "text": "David realized he’d been unconsciously pushing his nails into his palms, leaving little red falciform marks."
                            }
                        ]
                    }
                ],
