                "senses": [
                    {
                        "sense_id": "f7ef29a1-ffe7-3637-935c-e34d55ca0f43",
                        "entry_id": "9c0a47df-1ce2-3c17-9130-8ec82459ba23",
                        "glosses": [
                            "An expression of disdain, disbelief, protest, or dismissal; a huff, grunt, or snort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96bf96d7-f053-49ff-98e1-fb2adf50c719",
                                "sense_id": "f7ef29a1-ffe7-3637-935c-e34d55ca0f43",
                                "text": "I didn't get a harumph out of that guy."
                            },
                            {
                                "example_id": "22c9dc9c-97ad-4b49-bd1e-39d9af4ba270",
                                "sense_id": "f7ef29a1-ffe7-3637-935c-e34d55ca0f43",
                                "text": "Give the governor a harumph."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
