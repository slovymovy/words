                ],
                "senses": [
                    {
                        "sense_id": "626e74d7-34a0-3685-bd9f-7f93136eccb8",
                        "entry_id": "cb6dac50-e220-3037-b426-499dfa3e252d",
                        "glosses": [
                            "ein großes asymmetrisches Vorsegel, welches von Halbwind- bis Raumschotkursen gefahren wird"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "0aef2c4f-3a0f-4d2a-b268-d495328115f2",
                                "sense_id": "626e74d7-34a0-3685-bd9f-7f93136eccb8",
                                "text": "„Damit Gennaker oder Spi ohne Wuhling aus dem Sack kommen, müssen sie richtig vorbereitet werden.“"
                            },
                            {
                                "example_id": "6c4dbcf0-daa7-4720-8039-ed4b3bc366f7",
                                "sense_id": "626e74d7-34a0-3685-bd9f-7f93136eccb8",
                                "text": "„»Das Kreuzen vor dem Wind mit dem Gennaker, da habt ihr gegen die Spiboote keine Chance….«“"
                            },
                            {
                                "example_id": "898f54a6-0061-459b-83fe-70600dcb18ae",
                                "sense_id": "626e74d7-34a0-3685-bd9f-7f93136eccb8",
                                "text": "„Ein Freudenschrei klingt über den Strelasund. Rike und ich als ihr Vorschoter, haben soeben zum ersten Mal den Gennaker gesetzt.“"
                            },
                            {
                                "example_id": "49a08d73-f6e1-4187-9fb4-95b0dcd25675",
                                "sense_id": "626e74d7-34a0-3685-bd9f-7f93136eccb8",
                                "text": "„Die Gennaker müssen möglichst schnell hoch, […] denn auf dem Weg nach England wird der Wind endlich eher von hinten kommen.“"
                            },
                            {
                                "example_id": "7df568b3-d500-4da2-bfeb-54933cbef565",
                                "sense_id": "626e74d7-34a0-3685-bd9f-7f93136eccb8",
                                "text": "[Die Yacht] „'Perpetual Loyal' bekam aber seinen völlig verdrehten Gennaker nicht gesetzt und fiel schnell zurück.“"
                            },
                            {
                                "example_id": "967c587a-c187-49e4-abca-6961df4b8a1c",
                                "sense_id": "626e74d7-34a0-3685-bd9f-7f93136eccb8",
                                "text": "„Dazu können die Käufer wählen, ob sie das Boot mit Spinnaker (zum Beispiel für Segelschulen oder Club-Sailing) oder für sportliches Segeln mit einem Gennaker ausrüsten wollen.“"
                            },
                            {
                                "example_id": "b7348566-f380-4e33-a986-fdd2a47a996a",
                                "sense_id": "626e74d7-34a0-3685-bd9f-7f93136eccb8",
                                "text": "[…] „das erfahrende HSC-Frauenteam [veröffentlichte] Videotutorials, in denen die Manöverabläufe an Bord erklärt werden. Wie können sich die Frauen beim Halsen, Setzen oder Bergen des Gennakers koordinieren und mit kleinen Tricks ihre Performance verbessern?“"
                            },
                            {
                                "example_id": "661e8516-3e33-4631-880f-3caa789fb0e0",
                                "sense_id": "626e74d7-34a0-3685-bd9f-7f93136eccb8",
                                "text": "„SAP hat in \"Team New Zealand\" rund acht Millionen Euro investiert. Dafür prangt der Schriftzug der Firma aus dem baden-württembergischen Walldorf weithin sichtbar auf dem Gennaker der Yacht.“"
                            },
                            {
                                "example_id": "4b54a084-0fdf-4820-9b83-b8b9488af606",
                                "sense_id": "626e74d7-34a0-3685-bd9f-7f93136eccb8",
                                "text": "„Groß- und Genuafall sollten sehr dehnungsarm sein. Für Gennaker oder Spi ist ein wenig Reck dagegen durchaus von Vorteil“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
