{
    "word_family": [
        "acoustic",
        "acoustics"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1676c88a-e218-3000-b181-a726010db1dd",
                    "sense_definition": "In a manner relating to sound or the sense of hearing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The concert hall was designed to be <w>acoustically</w> perfect for orchestral performances.",
                            "target_lang_translations": {
                                "zh": "这座音乐厅的设计旨在为管弦乐表演提供<w>在声学上</w>完美的条件。"
                            }
                        },
                        {
                            "text": "The guitar was played <w>acoustically</w> without any electronic amplification.",
                            "target_lang_translations": {
                                "zh": "这把吉他是<w>不插电</w>演奏的，没有使用任何电子扩音设备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sonically"
                    ],
                    "common_phrases": [
                        "acoustically perfect",
                        "acoustically treated"
                    ],
                    "target_lang_definitions": {
                        "zh": "指与声音或听觉有关的方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "在声学上",
                                "target_lang_sense_clarification": "侧重于声音效果或声学特性。"
                            },
                            {
                                "target_lang_word": "不插电地",
                                "target_lang_sense_clarification": "特指乐器演奏时未使用电子扩音设备。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "700909d2-5d83-3aaf-8de6-435c4f7803b8",
                    "sense_definition": "From the perspective of the science of sound.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was <w>acoustically</w> analyzed to identify the source of the echo.",
                            "target_lang_translations": {
                                "zh": "我们<w>从声学角度</w>对房间进行了分析，以确定回声的来源。"
                            }
                        },
                        {
                            "text": "We evaluated the building <w>acoustically</w> to ensure it met safety standards.",
                            "target_lang_translations": {
                                "zh": "我们<w>从声学角度</w>评估了这座建筑，以确保其符合安全标准。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "从声学科学的角度来看。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "从声学角度",
                                "target_lang_sense_clarification": "用于分析、评估或科学研究的语境。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}