                                "target_senses": [
                                    {
                                        "sense_id": "410862cc-9de8-3391-9cdd-476fe267d1a0",
                                        "entry_id": "ff28302a-2970-3cae-a7aa-dd4bc664e127",
                                        "glosses": [
                                            "innerhalb einer Vene befindlich, in eine Vene injiziert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74888bcb-bb0d-4adf-b12d-7fce36778efe",
                                                "sense_id": "410862cc-9de8-3391-9cdd-476fe267d1a0",
                                                "text": "„Das Medikament gehört zu Klasse der Platinderivate und kann im Gegensatz zu den derzeit verfügbaren derartigen Mitteln, die intravenös verabreicht werden“ (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "73211e77-d75a-4abb-9932-d40928dc5a68",
                                                "sense_id": "410862cc-9de8-3391-9cdd-476fe267d1a0",
                                                "text": "„Der große Vorteil einer intravenösen Medikamentengabe ist, dass sich das Medikament sofort und im vollen Umfang im Blutkreislauf befindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2aef4e8a-ef64-4226-b4db-009a0937421f",
                        "source_entry_id": "272014df-0a2a-3878-a34b-a6b88289c243",
