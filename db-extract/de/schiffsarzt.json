                ],
                "senses": [
                    {
                        "sense_id": "bc7c7764-3e1a-31dd-acbe-842c63de20e2",
                        "entry_id": "4495d7ac-ffc5-303d-878c-67494dbbad96",
                        "glosses": [
                            "Arzt zur medizinischen Versorgung auf Schiffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa47d28d-4c07-49d2-b885-b24a1234ef74",
                                "sense_id": "bc7c7764-3e1a-31dd-acbe-842c63de20e2",
                                "text": "Der Schiffsarzt musste wegen des Wellengangs viele Patienten mit Übelkeit behandeln."
                            },
                            {
                                "example_id": "b2ce513b-ff65-403e-b995-aa90d9082b7f",
                                "sense_id": "bc7c7764-3e1a-31dd-acbe-842c63de20e2",
                                "text": "„Er stellte sicher - oder auch nicht -, dass der Schiffsarzt seine Pflicht tat und dass Matrosen und Offiziere die Gefangenen nicht misshandelten.“"
                            },
                            {
                                "example_id": "c5d43dd1-4d81-4030-80ec-0ec1e1019ff1",
                                "sense_id": "bc7c7764-3e1a-31dd-acbe-842c63de20e2",
                                "text": "„Ich habe manchmal mit dem Schiffsarzt gewürfelt, der auch nichts Besseres zu tun hatte, denn seekrank konnten die Leute ohne ihn sein, und andere Krankheiten hatten sie nicht.“"
                            },
                            {
                                "example_id": "bcc2263e-e719-4d2e-97c1-600945f238fd",
                                "sense_id": "bc7c7764-3e1a-31dd-acbe-842c63de20e2",
                                "text": "„Auch wissen wir, dass Cook auf seiner zweiten Reise mit Opiaten behandelt worden war, dem einzigen effektiven Schmerzmittel in der Medizinkiste des Schiffsarztes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
