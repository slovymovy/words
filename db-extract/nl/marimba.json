                                        "entry_id": "fdf1ea44-005e-3f23-8148-2b36c0e0f283",
                                        "glosses": [
                                            "Xylophone africain dont chaque lame est munie d’un résonateur en bambou, en bois, ou en calebasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d3c4ba-14da-4001-bb3a-bf6db5d9d7cc",
                                                "sense_id": "ad9c2ab3-24df-33ad-95e8-4df3315f8b52",
                                                "text": "Le marimba se joue avec deux, parfois trois bâtons dans chaque main."
                                            },
                                            {
                                                "example_id": "569ba1c7-d8d5-416a-b0d4-d79c0a386157",
                                                "sense_id": "ad9c2ab3-24df-33ad-95e8-4df3315f8b52",
                                                "text": "Le marimba est l’instrument national du Guatemala et est très populaire au Mexique."
                                            },
                                            {
                                                "example_id": "4eaf9bba-ea7f-4ce8-976d-2013f2129fdb",
                                                "sense_id": "ad9c2ab3-24df-33ad-95e8-4df3315f8b52",
                                                "text": "Pour le premier mouvement, c’est le marimba qui joue une entrée douce et mystérieuse dans le domaine de la nuit."
                                            }
                                        ]
                                    }
                                ]
                            }
