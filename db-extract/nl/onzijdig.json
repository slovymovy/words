                                                "example_id": "425b1a89-9112-420f-accd-dbbecd890a92",
                                                "sense_id": "a59a3cd1-5aca-3976-bcb4-f272d62832e6",
                                                "text": "Cette nation demeura, resta neutre."
                                            },
                                            {
                                                "example_id": "598e6d19-b833-41eb-ad7e-8e4a0888d30e",
                                                "sense_id": "a59a3cd1-5aca-3976-bcb4-f272d62832e6",
                                                "text": "Les États neutres."
