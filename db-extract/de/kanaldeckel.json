                "senses": [
                    {
                        "sense_id": "7b972d35-7a54-3fdd-bbc8-e6dcbeb4a373",
                        "entry_id": "aa22dd91-9766-3292-b71a-0238c113aa76",
                        "glosses": [
                            "abnehmbares Gitter im Straßenniveau, das den Ablauf des Regenwassers ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e594284-b069-49e0-a464-37ca7a468bcf",
                                "sense_id": "7b972d35-7a54-3fdd-bbc8-e6dcbeb4a373",
                                "text": "„Der Zustand der Kanaldeckel auf den Straßen wurde einmal jährlich von Gemeindearbeitern überprüft.“"
                            },
                            {
                                "example_id": "676d3edd-836c-4b5e-84d4-e2b7cfe1195e",
                                "sense_id": "7b972d35-7a54-3fdd-bbc8-e6dcbeb4a373",
                                "text": "„Als er mit seinem Einkauf in der Tasche die Straße hinunterging, bemerkte er mit Erstaunen, dass ein paar lebende Ratten aus Kanaldeckeln und den Seitenstraßen herauskamen und ihm folgten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
