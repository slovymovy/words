                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d120c39-1daf-4daa-be27-3c9a91c4a947",
                                "sense_id": "bcc635b7-a276-3eb6-805a-bf96ec5a04f5",
