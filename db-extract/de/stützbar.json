                ],
                "senses": [
                    {
                        "sense_id": "cca33055-6b3c-3cff-bb44-23e8b88dca40",
                        "entry_id": "952703c7-5a8f-3311-ae42-0c92fd37c79b",
                        "glosses": [
                            "auf soliden Grundlagen stehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5b0bfe6-d8a0-43cf-a783-3044d22b41e9",
                                "sense_id": "cca33055-6b3c-3cff-bb44-23e8b88dca40",
                                "text": "„Nicht mehr auf die Generalermächtigung stützbar sind schon heute Aufenthaltsverbote und Wohnungsverweisungen (s. Rn 135 ff).“"
                            },
                            {
                                "example_id": "30ca5995-4325-4618-b3aa-864da535f405",
                                "sense_id": "cca33055-6b3c-3cff-bb44-23e8b88dca40",
                                "text": "„Alle Angaben sind daher ausschließlich auf archäologische Befunde stützbar.“"
                            },
                            {
                                "example_id": "2b289be9-da2f-4d94-86cc-2d2a571fdaf8",
                                "sense_id": "cca33055-6b3c-3cff-bb44-23e8b88dca40",
                                "text": "„Was es ihnen nicht gegeben hat, ist das Vertrauen, dass die Konjunktur tatsächlich stützbar ist.“"
                            },
                            {
                                "example_id": "7e4e43e5-8b6c-448c-b551-005a6f8dca40",
                                "sense_id": "cca33055-6b3c-3cff-bb44-23e8b88dca40",
