                "senses": [
                    {
                        "sense_id": "f859bab2-8181-332a-a034-496d7cfdaa03",
                        "entry_id": "fd941ba6-a428-3b60-a021-86ccfc4bdb37",
                        "glosses": [
                            "Bericht über eine Sachlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c817dcf-90b5-4c61-9e5d-e5ed50cbd391",
                                "sense_id": "f859bab2-8181-332a-a034-496d7cfdaa03",
                                "text": "„Der neue Lagebericht des Bundeskriminalamts stellt einen leichten Anstieg der Verfahren zur Organisierten Kriminalität fest.“"
                            },
                            {
                                "example_id": "86e47d39-dbc4-4445-88d9-6b4ab79d8b2d",
                                "sense_id": "f859bab2-8181-332a-a034-496d7cfdaa03",
                                "text": "„Nebenbei gab er Carlos einen kurzen Lagebericht.“"
                            },
                            {
                                "example_id": "0244fe39-7959-47e8-8b5b-346bf93edfea",
                                "sense_id": "f859bab2-8181-332a-a034-496d7cfdaa03",
                                "text": "„Einer von uns mußte unbedingt nach Kratovice zurückkehren, um Rugen zu holen und zugleich von Wirtz einen genauen Lagebericht zu überbringen, oder vielmehr zwei Lageberichte: Brussaroffs und meinen eigenen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "709210ed-2efa-4631-b22b-f6a68932e0fa",
