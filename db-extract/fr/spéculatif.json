                                    {
                                        "sense_id": "c45643d1-2b26-3ed3-9a5e-34385ef4017e",
                                        "entry_id": "ef7dc550-490a-3971-977d-e3a77d81d36f",
                                        "glosses": [
                                            "auf bloßen Mutmaßungen, nicht auf bekannten Tatsachen, beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4537f3d-e191-445e-bd53-95183ad1022f",
                                                "sense_id": "c45643d1-2b26-3ed3-9a5e-34385ef4017e",
                                                "text": "„Die Hypothesen darüber, warum ausgerechnet sportlich aktive Menschen häufiger Opfer von ALS werden, sind vielfältig. […] Die Überlegungen seien aber allesamt höchst spekulativ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b83849dd-83da-3aff-b9fe-32b0b9e0b58d",
                                        "entry_id": "ef7dc550-490a-3971-977d-e3a77d81d36f",
                                        "glosses": [
                                            "eine philosophische Erkenntnis jenseits der Empirie und Praxis gewinnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff67278b-2813-43ae-ab29-9a4ca1b4296c",
                                                "sense_id": "b83849dd-83da-3aff-b9fe-32b0b9e0b58d",
                                                "text": "„Bei einer Widersprüchlichkeit zwischen einem Beweis aus reiner praktischer und spekulativ gebrauchter Vernunft obsiegt nach Kant immer der letztere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8bedb736-a213-3dcb-a79a-185ce53d8cf8",
                                        "entry_id": "ef7dc550-490a-3971-977d-e3a77d81d36f",
                                        "glosses": [
                                            "gewinnversprechend; dem Zwecke der Spekulation dienend"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eea35215-0b88-4334-b304-9ea41f1323fc",
                                                "sense_id": "8bedb736-a213-3dcb-a79a-185ce53d8cf8",
                                                "text": "Er ging allerlei spekulativen Geschäften nach."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
