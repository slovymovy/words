                ],
                "senses": [
                    {
                        "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                        "entry_id": "cf25550c-c018-3d99-8248-f1ac22132b3d",
                        "glosses": [
                            "Lehrveranstaltung, die über das Internet abgehalten wird und in der Schüler und Lehrer an verschiedenen Orten sitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf98751-1530-4b3f-bc69-ac92b76582ac",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "Während der Covid-19-Pandemie fanden Vorlesungen an der Uni nur als Online-Kurs statt."
                            },
                            {
                                "example_id": "72df4fba-98df-42ee-98d5-183f211a97d4",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "„Online-Kurse renommierter Universitäten sollen auf ein späteres Studium vorbereiten.“"
                            },
                            {
                                "example_id": "e3703d68-71d7-4d2f-bf1d-07b84e751d2a",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "„Letztes Jahr hatte ich mit meinen 14 Assistenten 1830 Studenten, die kostenlos unterrichtet wurden in Online-Kursen in einem sogenannten \"Massive Open Online Course\" (offener Massen-Online-Kurs, kurz MOOC).“"
                            },
                            {
                                "example_id": "e046f4d9-80f4-4b8f-8788-8718389d4da3",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "„Die Kurse werden entweder als Präsenzseminare oder zunehmend als Online-Kurse durchgeführt;“ […]."
                            },
                            {
                                "example_id": "139b8b9d-9212-4536-9901-7b7ae7eabc19",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "[Covid-19-Impfung:] […] „»Ich bin wirklich erleichtert. Jetzt kann ich ohne Sorgen zurück ans College gehen. Ich hatte schon befürchtet, ich müsste wieder Online-Kurse machen. Mir fällt wirklich ein Stein vom Herzen.«“"
                            },
                            {
                                "example_id": "303c10cc-9f52-46ea-97e9-3a0dd0fffe40",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "[Covid-19-Pandemie 2021:] „»Es gibt kein normales Leben an den Unis, die Leute können ihre Freunde nicht sehen, sie verlieren die Motivation in den Online-Kursen. Wir sehen immer mehr Studienabbrecher.«“"
                            },
                            {
                                "example_id": "274430c0-d5a0-43e9-a9e7-35d0386f1dfa",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "„Die Deutsche BierAkademie bietet seit 2013 Lehrgänge zum Biersommelier an, seit 2020 auch als Online-Kurs zum International Beer Sommelier.“"
                            },
                            {
                                "example_id": "10f478d3-42a2-4171-bf63-d06a293eecb8",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "[Hebräisch-Kurs:] „»Die Sprache fasziniert mich, seit ich mich in den USA mit Juden angefreundet habe«, erzählt Al-Badi. Aber der Hauptgrund, aus dem sie letztlich einen Online-Kurs begonnen habe, seien jüdische Freunde, die sie in Dubai kennengelernt hat.“"
                            },
                            {
                                "example_id": "d9637385-087b-481a-b754-876cb1e52a28",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "„»An unserem Institut haben schon vor der Pandemie viele Lehrkräfte mit Hybridkursen gearbeitet, weil Leute zum Beispiel berufs- oder familienbedingt einen Online-Kurs machen und sich zwischendurch auch mal in Präsenz menschlich kennenlernen wollen.«“"
                            },
                            {
                                "example_id": "a6a4223c-ad0c-4b1c-b1d1-c53acba9a872",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "„Die US-Regierung will ausländischen Studenten, die wegen der Corona-Pandemie nur Online-Kurse an amerikanischen Hochschulen besuchen können, nun doch nicht zum Wintersemester die Visa entziehen.“"
                            },
                            {
                                "example_id": "c43d455a-8daf-4b90-8de7-508593a34642",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "[Covid-19-Pandemie 2020:] „»Im Falle einer neuen Ausgangssperre werde ich meine Online-Kurse auf Whatsapp mit meinen Lehrern wieder aufnehmen.«“"
                            },
                            {
                                "example_id": "1ed28be1-71a1-462e-8f8a-376f2f0a2e4d",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "[Corona-Pandemie in Afrika:] „Seit Monaten fällt der Unterricht in vielen Ländern aus. Online-Kurse sind keine Alternative, weil viele Schüler keinen Zugang zum Internet haben.“"
                            },
                            {
                                "example_id": "2f6854da-6c02-42e9-815e-d1e7f8402e21",
                                "sense_id": "1e507c1f-9549-38c9-a3f2-33340cc8bde8",
                                "text": "[Covid-19-Pandemie 2020:] „Beim Goethe-Institut China beispielsweise , das schon seit Ende Januar für den Publikumsverkehr geschlossen ist, steigt die Zahl der Kursteilnehmer in den Online-Kursen während der Corona-Krise mit jedem neuen Kursangebot deutlich an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
