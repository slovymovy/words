                        "sense_id": "15f0b5a2-2b19-3f5c-ac18-56fe22e3fa98",
                        "entry_id": "9a3a7498-0106-382f-9ad3-4b38a1c1f496",
                        "glosses": [
                            "Variante de soufisme."
