{
    "word_family": [
        "broek"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9521be2-9b7b-38d3-910a-18a6e8a91101",
                    "sense_definition": "Een jong mannelijk kind.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jongen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij nog een kleine <w>broekvent</w> was, speelde hij elke dag buiten in het bos.",
                            "target_lang_translations": {
                                "fr": "Quand il était encore un petit <w>gamin</w>, il jouait dehors dans la forêt tous les jours."
                            }
                        },
                        {
                            "text": "De oude man vertelde verhalen over hoe hij als <w>broekvent</w> door de straten van de stad rende.",
                            "target_lang_translations": {
                                "fr": "Le vieil homme racontait des histoires sur la façon dont il courait dans les rues de la ville quand il était <w>gamin</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dreumes",
                        "jochie"
                    ],
                    "target_lang_definitions": {
                        "fr": "Un jeune garçon."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "gamin",
                                "target_lang_sense_clarification": "terme familier pour un jeune garçon"
                            },
                            {
                                "target_lang_word": "gosse",
                                "target_lang_sense_clarification": "terme très courant et familier pour un enfant"
                            },
                            {
                                "target_lang_word": "petit gars",
                                "target_lang_sense_clarification": "expression affectueuse pour un jeune garçon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3701ad5e-2a14-3792-ba8b-320e791e0468",
                    "sense_definition": "Een onvolwassen man die zich nog als een jongen gedraagt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onvolwassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gedraagt zich als een echte <w>broekvent</w> door nooit verantwoordelijkheid te nemen voor zijn daden.",
                            "target_lang_translations": {
                                "fr": "Il se comporte comme un vrai <w>gamin</w> en ne prenant jamais la responsabilité de ses actes."
                            }
                        },
                        {
                            "text": "Stop met dat kinderachtige gedrag, je bent geen <w>broekvent</w> meer.",
                            "target_lang_translations": {
                                "fr": "Arrête ce comportement puéril, tu n'es plus un <w>gamin</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "broekie"
                    ],
                    "target_lang_definitions": {
                        "fr": "Un homme immature qui se comporte encore comme un enfant."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "gamin",
                                "target_lang_sense_clarification": "utilisé pour souligner l'immaturité d'un adulte"
                            },
                            {
                                "target_lang_word": "grand enfant",
                                "target_lang_sense_clarification": "adulte qui garde des traits de caractère enfantins"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19845615-cc3a-3863-9b22-b68d59c4010c",
                    "sense_definition": "Een onervaren of onbelangrijke man.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onvolwassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zakenwereld wordt hij niet langer gezien als een <w>broekvent</w> maar als een gerespecteerde leider.",
                            "target_lang_translations": {
                                "fr": "Dans le monde des affaires, il n'est plus considéré comme un <w>bleu</w> mais comme un leader respecté."
                            }
                        },
                        {
                            "text": "De ervaren expert liet zich niet intimideren door die <w>broekvent</w> met zijn ongefundeerde kritiek.",
                            "target_lang_translations": {
                                "fr": "L'expert chevronné ne s'est pas laissé intimider par ce <w>petit jeune</w> et ses critiques infondées."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un homme inexpérimenté ou sans importance."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "bleu",
                                "target_lang_sense_clarification": "quelqu'un qui manque d'expérience"
                            },
                            {
                                "target_lang_word": "petit jeune",
                                "target_lang_sense_clarification": "terme parfois condescendant pour un débutant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0f4debe-78d5-3ac1-8ba7-3d12fc634bf4",
                    "sense_definition": "Iemand die erg bang is.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "angstig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij durfde niet naar de horrorfilm te kijken, wat een echte <w>broekvent</w>.",
                            "target_lang_translations": {
                                "fr": "Il n'a pas osé regarder le film d'horreur, quelle vraie <w>poule mouillée</w>."
                            }
                        },
                        {
                            "text": "Laat je niet kennen als een <w>broekvent</w> en durf eindelijk eens voor jezelf op te komen.",
                            "target_lang_translations": {
                                "fr": "Ne te montre pas comme un <w>froussard</w> et ose enfin te défendre."
                            }
                        }
                    ],
                    "synonyms": [
                        "bangbroek",
                        "bangerik",
                        "broekschijter",
                        "lafaard"
                    ],
                    "target_lang_definitions": {
                        "fr": "Quelqu'un qui est très peureux."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "froussard",
                                "target_lang_sense_clarification": "personne qui a facilement peur"
                            },
                            {
                                "target_lang_word": "poule mouillée",
                                "target_lang_sense_clarification": "expression imagée pour quelqu'un de lâche ou peureux"
                            },
                            {
                                "target_lang_word": "peureux",
                                "target_lang_sense_clarification": "terme général pour quelqu'un qui manque de courage"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}