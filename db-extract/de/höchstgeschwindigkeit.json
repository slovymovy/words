                "senses": [
                    {
                        "sense_id": "5f010bdc-1ad6-38f3-9bca-4ef5815a55cb",
                        "entry_id": "ad79e780-7fd3-36d7-af83-2bdc1db1c08c",
                        "glosses": [
                            "die höchste Geschwindigkeit, die erreicht werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4785b54-2abe-45b4-91b9-a187f368defa",
                                "sense_id": "5f010bdc-1ad6-38f3-9bca-4ef5815a55cb",
                                "text": "Dieser Sportwagen erreicht eine Höchstgeschwindigkeit von 260 km/h."
                            },
                            {
                                "example_id": "ba2c9be9-422b-460c-aff8-b03d56b47c8b",
                                "sense_id": "5f010bdc-1ad6-38f3-9bca-4ef5815a55cb",
                                "text": "„Die Höchstgeschwindigkeit von 7,7 Knoten wurde nicht gern als Marschgeschwindigkeit gefahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "408c86d7-b67f-382a-b95a-e3a9fdb55aec",
                        "entry_id": "ad79e780-7fd3-36d7-af83-2bdc1db1c08c",
                        "glosses": [
                            "die höchste erlaubte Geschwindigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "293c0787-bf6a-441e-8718-ec076af0b20d",
                                "sense_id": "408c86d7-b67f-382a-b95a-e3a9fdb55aec",
                                "text": "Ich musste dreißig Euro bezahlen, weil ich die Höchstgeschwindigkeit um 9 km/h überschritten habe."
                            },
                            {
                                "example_id": "191f9b3b-102e-4a03-98f2-47e08b27b2e1",
                                "sense_id": "408c86d7-b67f-382a-b95a-e3a9fdb55aec",
                                "text": "„Ich bin sowohl Automobilist als auch Fußgänger und entschlossen, mich genau an die Höchstgeschwindigkeit von 50 Stundenkilometern zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
