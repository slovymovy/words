                                        "sense_id": "8e640649-edc6-3aaf-9814-add7e8cc7505",
                                        "entry_id": "a2abeef8-7101-3e77-9f8a-733aa6c70cbe",
                                        "glosses": [
                                            "The quality of being earnest; sincerity; seriousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5feb9fb9-7726-4274-a8d9-7286110d0f37",
                                                "sense_id": "8e640649-edc6-3aaf-9814-add7e8cc7505",
                                                "text": "22 March 2012, Scott Tobias, AV Club The Hunger Gameshttp://www.avclub.com/articles/the-hunger-games,71293/\nShe’s joined, on the boys’ side, by Peeta (Josh Hutcherson), a baker’s son whose earnestness masks a gift for strategy that Katniss lacks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cb52c05-8731-4fcd-bc04-e92117a6203a",
                        "source_entry_id": "cea617c6-e8b4-30b8-8332-95298e5334bf",
                        "source_sense_id": "901d53e0-576a-3e2e-9922-c5ac2670ccf7",
                        "target_lang_word": "fervour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fervour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c5ff01c-4b5c-36f6-9053-3307790d0625",
                                        "entry_id": "9282a1af-e9df-3470-a3c8-73776c4005ee",
                                        "glosses": [
                                            "Commonwealth and Ireland standard spelling of fervor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08c2ac9-6ec0-44e7-a29d-65fed09583dc",
                                                "sense_id": "6c5ff01c-4b5c-36f6-9053-3307790d0625",
                                                "text": "The early Americans, inheriting the Hebraist fervour of the English Puritans, had enjoyed a Great Awakening of religious joy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34808214-572a-4f9e-8454-8929ca6fa26a",
                        "source_entry_id": "cea617c6-e8b4-30b8-8332-95298e5334bf",
                        "source_sense_id": "901d53e0-576a-3e2e-9922-c5ac2670ccf7",
                        "target_lang_word": "ferveur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ferveur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f69ba38-5cfb-353a-aa81-fa7305d2842c",
                                        "entry_id": "39f691df-77f7-3a39-a06a-2027341d2154",
                                        "glosses": [
                                            "Ardeur, zèle, sentiment vif et affectueux avec lequel on se porte aux choses de piété, de charité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2ade5af-d2e2-4fc9-8fbb-9c44f3713f28",
                                                "sense_id": "4f69ba38-5cfb-353a-aa81-fa7305d2842c",
                                                "text": "J’implorai avec ferveur la belle image de la Vierge coloriée à laquelle, tous les soirs, avant de me coucher, j’adressais ma prière […]"
                                            },
                                            {
                                                "example_id": "de9b1912-2d11-4cff-beeb-3f73a1aa2171",
                                                "sense_id": "4f69ba38-5cfb-353a-aa81-fa7305d2842c",
                                                "text": "C’est cela qu’évoque le journaliste américain Garry Will lorsqu’il pose la question : « Un peuple qui croit avec plus de ferveur en la conception virginale du Christ qu’en l’évolution des espèces peut-il être encore qualifié de nation éclairée ?."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c650e84-dc00-3308-bf25-3971259ee5f4",
                                        "entry_id": "39f691df-77f7-3a39-a06a-2027341d2154",
                                        "glosses": [
                                            "Mode littéraire, philosophique, artistique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ba374c1-f552-48bf-90e0-70cf97604d49",
                                                "sense_id": "6c650e84-dc00-3308-bf25-3971259ee5f4",
                                                "text": "On était dans la ferveur du Romantisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c14bd9d0-eea3-4c71-af60-7f2394be0950",
                        "source_entry_id": "cea617c6-e8b4-30b8-8332-95298e5334bf",
                        "source_sense_id": "901d53e0-576a-3e2e-9922-c5ac2670ccf7",
                        "target_lang_word": "zèle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zèle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d606b59-d790-3c31-9482-9e8add0533ad",
                                        "entry_id": "eedef2c9-20a2-3614-9e52-a17a432dc5b2",
                                        "glosses": [
                                            "Vive ardeur pour appliquer les consignes et les règlements à la lettre, ou plus généralement pour le maintien ou le succès de quelque chose en poussant à l’extrême le travail sans prendre la moindre initiative pour l’alléger en l’interprétant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4a7565e-e26e-4615-ac69-a8bc10ec729a",
                                                "sense_id": "7d606b59-d790-3c31-9482-9e8add0533ad",
                                                "text": "Le marquis, en voyant le zèle de Pierre, s’était finement abrité derrière lui. À quoi bon se mettre en vue, quand un homme à fortes épaules veut bien endosser toutes les sottises d’un parti."
                                            },
                                            {
                                                "example_id": "675bd708-bf09-4b07-bddf-8c6eb04b2ec7",
                                                "sense_id": "7d606b59-d790-3c31-9482-9e8add0533ad",
                                                "text": "Pendant les luttes que la Compagnie eut à soutenir dans l’Orégon contre les compagnies rivales, il se distingua par son zèle et son audace, et conquit rapidement son grade de lieutenant."
                                            },
                                            {
                                                "example_id": "814ebadc-25b1-4606-ac11-6d0ec003b567",
                                                "sense_id": "7d606b59-d790-3c31-9482-9e8add0533ad",
                                                "text": "Les pompiers de Monthois et de Mouron, avec un zèle et une vigueur dignes d’éloges, attaquèrent l'incendie et parvinrent à préserver l’auberge de, Mme Cbarbogne."
                                            },
                                            {
                                                "example_id": "589da763-be17-4194-8499-ec3cc6785bc1",
                                                "sense_id": "7d606b59-d790-3c31-9482-9e8add0533ad",
                                                "text": "Malgré tout ton athéisme, tu rivalises de zèle contre l’égoïsme avec les croyants à l’immortalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "066928f8-f93f-37c7-be9f-6fafa989fd88",
                                        "entry_id": "eedef2c9-20a2-3614-9e52-a17a432dc5b2",
                                        "glosses": [
                                            "Ardeur religieuse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e98b95c6-06a0-4d36-9223-4a27ddacda7b",
                                                "sense_id": "066928f8-f93f-37c7-be9f-6fafa989fd88",
                                                "text": "Rien n'arrête le zèle des recruteurs monastiques. Vous les voyez frétiller autour des héritiers, des héritières…"
                                            },
                                            {
                                                "example_id": "a87d18d8-556e-450b-9fe0-9bb7db6d9ab5",
                                                "sense_id": "066928f8-f93f-37c7-be9f-6fafa989fd88",
                                                "text": "Les vestiges du culte primitif et du druidisme sont assez rares, grâce au zèle des chrétiens des premiers siècles, qui renversèrent, brisèrent et enfouirent une multitude de pierres-fittes."
                                            },
                                            {
                                                "example_id": "acac70ae-ecc8-43ff-a393-0ab7c34c4589",
                                                "sense_id": "066928f8-f93f-37c7-be9f-6fafa989fd88",
                                                "text": "J’avais horreur de voir que la religion du Christ travaillait aussi avec zèle à pousser les hommes dans la guerre."
                                            },
                                            {
                                                "example_id": "e96f6d75-9fc5-4cb3-b5b4-c788ca949dd2",
                                                "sense_id": "066928f8-f93f-37c7-be9f-6fafa989fd88",
                                                "text": "L’ardeur que mettait John Wesley à convertir des femmes jeunes et jolies tenait à la fois du zèle religieux le plus sincère et d’un désir physique, peut-être inconnu de lui même."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
