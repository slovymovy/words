                                    {
                                        "sense_id": "d02738ef-e41a-35e5-bfb5-02bfc3f485fd",
                                        "entry_id": "188622e9-084a-396f-b270-64d2828ba568",
                                        "glosses": [
                                            "iemand die minstens een miljard eenheden van een nader aan te duiden munteenheid bezit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85bb2301-ddef-46fc-9275-34fe37025ae1",
                                                "sense_id": "d02738ef-e41a-35e5-bfb5-02bfc3f485fd",
                                                "text": "de miljardair had nog niet genoeg"
                                            },
                                            {
                                                "example_id": "cdb20473-d336-4689-996d-17019edee200",
                                                "sense_id": "d02738ef-e41a-35e5-bfb5-02bfc3f485fd",
                                                "text": "Kelderende beurskoersen, waarschuwingen voor een recessie, boze miljardairs en een dippende bitcoin: niets of niemand leek Trump bij zinnen te kunnen brengen. Totdat ook de markt voor de Amerikaanse staatsschuld begon te schuiven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e3658d5-720e-472f-9f2b-6af7cef83ec9",
                        "source_entry_id": "b302fd8d-a939-389e-8bf5-6cc37481ee36",
                        "source_sense_id": "fa233c56-15c1-321f-b2c4-a58aa01b6928",
