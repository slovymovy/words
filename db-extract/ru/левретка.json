                        "cross_references": [
                            {
                                "target_word": "Windspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73d041d6-798e-3a4a-bdc3-9e3e77755207",
                                        "entry_id": "d260a578-265b-3866-bf43-f28496ff7766",
                                        "glosses": [
                                            "Gegenstand, der sich durch Luftbewegungen bewegt oder Geräusche von sich gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9d4b2f1-0ce2-4795-b743-ec759464a10c",
                                                "sense_id": "73d041d6-798e-3a4a-bdc3-9e3e77755207",
                                                "text": "Gestern haben wir im Garten drei kleine Windspiele aufgehängt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5aaefe71-0d4d-3827-a034-997ed46047e6",
                                        "entry_id": "d260a578-265b-3866-bf43-f28496ff7766",
                                        "glosses": [
                                            "meist kleiner, italienischer Windhund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da3fdf44-d106-42c2-bda6-fc0f0c6cd5ae",
                                                "sense_id": "5aaefe71-0d4d-3827-a034-997ed46047e6",
                                                "text": "„Der Feldherr ließ ihn gehen und streichelte nachdenklich den feinen Kopf seines Windspieles, das ihm denselben in die Hand zu legen gekommen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7030c7c3-885c-4f5d-8f2c-f28f2ad7a7d6",
                        "source_entry_id": "5d420902-68c0-3e9a-8676-6a4757d74961",
                        "target_lang_word": "levrette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "levrette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46871ea0-6996-3209-b377-0ee7e747ba15",
                                        "entry_id": "56ddea72-be31-33d4-9134-694f0aa8264b",
                                        "glosses": [
                                            "Femelle du lévrier."
                                        ],
                                        "tags": [
                                            "Cynologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a60cd69-f959-4cb3-9b81-ffe804d50d05",
                                                "sense_id": "46871ea0-6996-3209-b377-0ee7e747ba15",
                                                "text": "Je me retrouvais moi-même, quand j’avais revu mon haut clocher, la nef aiguë, le cloître et les tombes du xvᵉ siècle qui y sont couchées ; je n’étais à l’aise que dans la compagnie des morts, près de ces chevaliers, de ces nobles dames, dormant d’un sommeil calme, avec leur levrette à leurs pieds et un grand flambeau de pierre à la main."
                                            },
                                            {
                                                "example_id": "eab7bbe4-f4d5-4e64-b377-8d66476f77f0",
                                                "sense_id": "46871ea0-6996-3209-b377-0ee7e747ba15",
                                                "text": "Sur ces entrefaites, la portière se souleva et Henri de Navarre parut. La petite levrette, qui dormait sur le trône, bondit et courut à lui."
                                            },
                                            {
                                                "example_id": "857bce74-2037-4b36-be70-f21f1f513341",
                                                "sense_id": "46871ea0-6996-3209-b377-0ee7e747ba15",
                                                "text": "Une petite levrette, avec une patte déhanchée et des yeux tristes, […], boitait d’un tapis sur l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbd720e5-a3e8-321d-80ab-6667be85f428",
                                        "entry_id": "56ddea72-be31-33d4-9134-694f0aa8264b",
                                        "glosses": [
                                            "Position sexuelle proche de celle de la cuillère où un des partenaires se présente de dos, tandis que l’autre le pénètre par derrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "605ed140-0bdc-4c06-85b5-a15d162142df",
                                                "sense_id": "fbd720e5-a3e8-321d-80ab-6667be85f428",
                                                "text": "Il courut derrière, l’empoigna et lui mit en levrette un vit de taille respectable."
                                            },
                                            {
                                                "example_id": "14506aa6-6a47-429c-9758-61746ae98701",
                                                "sense_id": "fbd720e5-a3e8-321d-80ab-6667be85f428",
                                                "text": "Cette intervention, aussi énergique que partie d’un bon fond, impressionna favorablement le rural qui consentit alors à expliquer qu’il besognait parfois la vieille en levrette, façon que lui avaient enseignée des camarades de régiment et, aussi, à la paresseuse, méthode favorite du cantonnier."
                                            },
                                            {
                                                "example_id": "c8bb43a1-a977-4f90-bccd-12f0fd924455",
                                                "sense_id": "fbd720e5-a3e8-321d-80ab-6667be85f428",
                                                "text": "Vous comprendrez aisément pourquoi la position du missionnaire, qui laisse bien peu de latitude à la femme pour accéder à son clitoris ou pour moduler son rythme durant le rapport, s’avère moins payante que la levrette, la position « animale » par excellence qui apporte le confort, la liberté de mouvement et l’accès direct à l’entre-jambe."
                                            },
                                            {
                                                "example_id": "9e9dc1ba-e65a-405b-9a20-06f2810c73e4",
                                                "sense_id": "fbd720e5-a3e8-321d-80ab-6667be85f428",
                                                "text": "Le nom latin de cette «levrette» était coitus more ferarum (traduire par: «comme les animaux le font»)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d7e644b-3003-313d-8647-7e2625f4c745",
                                        "entry_id": "56ddea72-be31-33d4-9134-694f0aa8264b",
                                        "glosses": [
                                            "Outil proche du chemin de fer et destiné à tailler la pierre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ead180-785f-49d2-bf49-9b4e29c72f38",
                                                "sense_id": "1d7e644b-3003-313d-8647-7e2625f4c745",
                                                "text": "Levrette lisse à manche 70/120/250 · € 40.41 · Levrette plate dentée de 70mm · € 32.92 … Lame de chemin de fer rigide à dents · € 5.07 …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f618e2-7b20-3219-a9ba-3019d02dfb6a",
                                        "entry_id": "56ddea72-be31-33d4-9134-694f0aa8264b",
                                        "glosses": [
                                            "Meuble représentant la femelle du lévrier dans les armoiries. Elle se différencie du lévrier par le manque de vilenie. À rapprocher de chien, goupil, lévrier, loup et renard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d9be53-bcd1-4762-a06e-ec88d71c2db6",
                                                "sense_id": "c6f618e2-7b20-3219-a9ba-3019d02dfb6a",
                                                "text": "De gueules, à la levrette courant d’argent colletée d’or, au chef cousu d’azur chargé de trois étoiles d’or, qui est de la famille d’Ysarn de Valady"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e97775ad-60cf-361b-b75e-a681ff12473e",
                                        "entry_id": "56ddea72-be31-33d4-9134-694f0aa8264b",
                                        "glosses": [
                                            "Spécialité culinaire de la ville de Charmes, dans les Vosges, composée d’une nougatine enrobée de chocolat amer et fourrée d’une ganache au parfum de framboise."
                                        ],
                                        "tags": [
                                            "Confiserie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
