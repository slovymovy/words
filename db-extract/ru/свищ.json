                ],
                "senses": [
                    {
                        "sense_id": "120065a0-6c96-31a6-8c08-7188cef2fa18",
                        "entry_id": "18ed0f8c-d13b-3b74-a076-222d84d2212f",
                        "glosses": [
                            "спец. дефект в чём-либо в виде дыры, скважины."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b0a5025-4d03-43a5-aee5-e20c4905811a",
                                "sense_id": "120065a0-6c96-31a6-8c08-7188cef2fa18",
                                "text": "Свищ в трубе."
                            },
                            {
                                "example_id": "bba21bf4-e1d3-4bd9-b39b-3a9c876794a4",
                                "sense_id": "120065a0-6c96-31a6-8c08-7188cef2fa18",
                                "text": "Свищ в орехе был прогрызен червяком."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb52a294-1c75-3a54-8db4-2f12e74fe0d0",
                        "entry_id": "18ed0f8c-d13b-3b74-a076-222d84d2212f",
                        "glosses": [
                            "спец. скрытая пустота, раковина в металлическом литье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f01212b5-5460-49fe-b07c-ce5242117dd4",
                                "sense_id": "fb52a294-1c75-3a54-8db4-2f12e74fe0d0",
                                "text": "Свищи в лопатке турбины обнаружены с помощью ультразвуковой дефектоскопии."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b07f661-f49c-3255-a308-511dfc6f4162",
                        "entry_id": "18ed0f8c-d13b-3b74-a076-222d84d2212f",
                        "glosses": [
                            "мед. патологический или искусственный канал, соединяющий очаг заболевания с полостью или поверхностью тела, а также два полых органа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f76b694-eba9-41a0-b3b5-2b9fe478fcb8",
                                "sense_id": "2b07f661-f49c-3255-a308-511dfc6f4162",
                                "text": "Желудочно-кишечный свищ."
                            },
                            {
                                "example_id": "3b336df6-3150-444d-8934-f6bda5f41ca8",
                                "sense_id": "2b07f661-f49c-3255-a308-511dfc6f4162",
                                "text": "Таким образом произошла желудочная фистула, свищ желудка."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9fa00d4-41ab-3bc4-a9ab-57c413995896",
                        "entry_id": "18ed0f8c-d13b-3b74-a076-222d84d2212f",
                        "glosses": [
                            "перен. разг. устар. пренебр. пустой человек, тунеядец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "832485a6-80c3-493c-93f3-71fbc8eecb7f",
                                "sense_id": "b9fa00d4-41ab-3bc4-a9ab-57c413995896",
                                "text": "Кто теперь не найдет дела, тому пенять не на кого, тот в самом деле пустой человек, свищ или лентяй."
                            }
                        ]
                    },
                    {
                        "sense_id": "31683f22-9e43-3def-87ad-7fce4f93d29f",
                        "entry_id": "18ed0f8c-d13b-3b74-a076-222d84d2212f",
