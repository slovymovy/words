                "senses": [
                    {
                        "sense_id": "11637564-7bef-3bcc-be9e-e951917b69fc",
                        "entry_id": "081514c8-9758-30d6-888e-4a3b3f902870",
                        "glosses": [
                            "Commune française, située dans le département de la Gironde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb444bef-dbf5-4137-ad00-0f44477a35db",
                                "sense_id": "11637564-7bef-3bcc-be9e-e951917b69fc",
                                "text": "Plusieurs sites de production se développent, à Port-Maubert (Saint-Fort-sur-Gironde), Mortagne, Blaye, Langon, Bourg-sur-Gironde, etc."
                            },
                            {
                                "example_id": "137cdc44-0f0e-4e8c-9a79-70de3f55c619",
                                "sense_id": "11637564-7bef-3bcc-be9e-e951917b69fc",
                                "text": "Vous connaissez Langon ? Six mille habitants. Des vignerons pour la plupart. Une ville paisible, à cinquante kilomètres de Bordeaux."
                            },
                            {
                                "example_id": "adfe205e-0ed9-4654-bba9-da7da1cbaad0",
                                "sense_id": "11637564-7bef-3bcc-be9e-e951917b69fc",
                                "text": "Le fleuve aidait à les porter ensuite jusqu'à Bordeaux : une aquatinte de Louis Burgade, vers 1830, nous montre un portefaix qui décharge une gabarre venue de Langon et empile du faissonnat face au quai Louis XVIII."
                            }
                        ]
                    },
