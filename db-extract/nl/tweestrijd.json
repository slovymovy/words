                                "target_senses": [
                                    {
                                        "sense_id": "32c59d3b-5d68-3177-8250-7336bfbd50e8",
                                        "entry_id": "60d65154-df46-3e2c-9fa1-215c12fb41af",
                                        "glosses": [
                                            "Arranged, regular combat between two private persons, often over a matter of honor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "027934ac-fb20-4e25-9cef-fd59711dd130",
                                                "sense_id": "32c59d3b-5d68-3177-8250-7336bfbd50e8",
                                                "text": "I have often thought since, how different my fate might have been, had I not fallen in love with Nora at that early age; and had I not flung the wine in Quin’s face, and so brought on the duel."
                                            },
                                            {
                                                "example_id": "cf11bb53-e240-4f9b-bec0-5366801a2ad9",
                                                "sense_id": "32c59d3b-5d68-3177-8250-7336bfbd50e8",
                                                "text": "It has been 200 years, minus a few days, since Vice President Aaron Burr fatally shot Alexander Hamilton in a duel here. Weehawken and the duel have been tied together in an often-uncomfortable knot ever since."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12af2609-3a18-3b20-ac62-1dfaeb80867d",
                                        "entry_id": "60d65154-df46-3e2c-9fa1-215c12fb41af",
                                        "glosses": [
                                            "Historically, the wager of battle (judicial combat)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1dbd89ec-1c46-351e-85e2-b41df2c72ec3",
                                        "entry_id": "60d65154-df46-3e2c-9fa1-215c12fb41af",
                                        "glosses": [
                                            "Any battle or struggle between two contending persons, forces, groups, or ideas."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac26d2e5-5d21-4ee4-bfbd-48112d6e3dd5",
                                                "sense_id": "1dbd89ec-1c46-351e-85e2-b41df2c72ec3",
                                                "text": "a sniper duel"
                                            },
                                            {
                                                "example_id": "d01303a1-c020-4e09-a034-26d453a1f64a",
                                                "sense_id": "1dbd89ec-1c46-351e-85e2-b41df2c72ec3",
                                                "text": "But it leaves them with a few destroyers, the American destroyer force is falling back, and then you have the two cruiser lines with their respective battleships coming in for the big duel."
                                            },
                                            {
                                                "example_id": "4362ba4d-c1a1-41a6-ade2-5fcf532ba581",
                                                "sense_id": "1dbd89ec-1c46-351e-85e2-b41df2c72ec3",
                                                "text": "Apple comes out swinging in the duel of the data titans [title]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "duel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bb44d44-c768-3042-a76b-fb737a907e43",
                                        "entry_id": "330ba72b-1f7f-358e-b710-d78a4c9f5e5f",
                                        "glosses": [
                                            "To engage in a battle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4831529f-6f01-4437-b447-66eaa9b92159",
                                                "sense_id": "4bb44d44-c768-3042-a76b-fb737a907e43",
                                                "text": "The two dogs were duelling for the bone."
                                            },
                                            {
                                                "example_id": "3c622e13-be67-42db-ae1d-3ac1358a4a0d",
                                                "sense_id": "4bb44d44-c768-3042-a76b-fb737a907e43",
                                                "text": "The country’s fencing federation has officially recognised lightsaber duelling as a competitive sport, granting the weapon from George Lucas’s space saga the same status as the foil, epee and sabre, the traditional blades used at the Olympics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8550664b-a131-4227-9919-ccdfe2691cfa",
                        "source_entry_id": "e6543fa6-f3e2-37ec-945e-d705f9077877",
                        "source_sense_id": "795b8f40-a48e-3436-a690-d8ec9a444a5c",
                        "source_sense_description": "conflict tussen twee mensen",
                        "target_lang_word": "duel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e41de0f4-4587-3026-bed7-c08c165269e1",
                                        "entry_id": "897e100e-1f26-3d24-845c-fed8ecb017eb",
                                        "glosses": [
                                            "Qui a deux aspects, qui exprime une dualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc594a7f-7dfc-4c6a-bc97-2145f545eb48",
                                                "sense_id": "e41de0f4-4587-3026-bed7-c08c165269e1",
                                                "text": "Il est écartelé entre des pulsions duelles."
                                            },
                                            {
                                                "example_id": "ac25a7f9-330b-4403-b4b9-d051fb09ea87",
                                                "sense_id": "e41de0f4-4587-3026-bed7-c08c165269e1",
                                                "text": "Les relations duelles entre ordre et désordre, articulé et inarticulé."
                                            },
                                            {
                                                "example_id": "1e7b5c1c-8d59-4a9b-b8d3-79cd765b4928",
                                                "sense_id": "e41de0f4-4587-3026-bed7-c08c165269e1",
                                                "text": "L’angélisme est un élément de base des personnalités paranoïaques qui vivent dans une compréhension duelle du monde : les bons, et les mauvais."
                                            },
                                            {
                                                "example_id": "01bc8c62-4c8b-4624-a0cd-4aa5c9975848",
                                                "sense_id": "e41de0f4-4587-3026-bed7-c08c165269e1",
                                                "text": "C’est pourquoi ils détestaient les mondanités et les grandes tablées françaises, privilégiant la relation duelle. Être deux, se parler deux à deux était selon eux — selon moi aussi, ils m’ont appris cela — la seule façon de se comprendre, de s’entendre, d’avancer, de réfléchir. La formule de cette relation était : « Chacun sa réception. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "duel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1969ed97-6a12-3296-9e9b-03fbec9fe823",
                                        "entry_id": "1e49416d-acd9-3dbe-b5ec-ddf99567f090",
                                        "glosses": [
                                            "Combat singulier entre deux personnes, dont l’une se dit offensée par l’autre et exige une réparation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ffb84b1-af73-4e16-9323-c151db7ebe97",
                                                "sense_id": "1969ed97-6a12-3296-9e9b-03fbec9fe823",
                                                "text": "Il eut surtout des amours retentissantes, des duels fameux, et jusqu’à des aventures louches de tripot et de femmes, qui laissent traîner derrière leurs héros une sorte de respect mystérieux, d’admiration inquiète, et les classent définitivement au premier rang des élégances incontestées."
                                            },
                                            {
                                                "example_id": "7d5c3d57-5f9e-4951-b602-1b52db12ab02",
                                                "sense_id": "1969ed97-6a12-3296-9e9b-03fbec9fe823",
                                                "text": "Son petit-fils Guy d’Arces, plus connu sous le nom de Livarot , tua Schomberg dans ce fameux duel de trois contre trois, qui eut lieu le 27 avril 1578 , entre les mignons d’Henri III et les affidés de la maison de Lorraine."
                                            },
                                            {
                                                "example_id": "fe173efc-2606-459b-8840-11c217f0fb65",
                                                "sense_id": "1969ed97-6a12-3296-9e9b-03fbec9fe823",
                                                "text": "Le point d’honneur des petits Ducs est très chatouilleux ; pour un mot de travers, ils se battent en duel, et ces duels ne sont pas des plaisanteries."
                                            },
                                            {
                                                "example_id": "7106bf5f-f336-477a-8c09-87ce0f5ee719",
                                                "sense_id": "1969ed97-6a12-3296-9e9b-03fbec9fe823",
                                                "text": "« Mais à quoi rime ce duel Stéphane ?\n— À rien du tout Hubert. Je vous l’accorde, ça ne rime à rien. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8978daa-c1ea-3249-a400-1236a7212f8e",
                                        "entry_id": "1e49416d-acd9-3dbe-b5ec-ddf99567f090",
                                        "glosses": [
                                            "Affrontement entre deux entités."
