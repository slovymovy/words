                        "glosses": [
                            "großes Blechblasinstrument"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66cbd1d7-e738-4b95-8118-dd4a76efdea5",
                                "sense_id": "02b4de13-0fee-3219-806d-8cd4fc64e801",
                                "text": "Das Sousafon wird oft in US-amerikanischen Militärkapellen benutzt."
                            }
                        ],
