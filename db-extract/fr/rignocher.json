                "senses": [
                    {
                        "sense_id": "e0fb061b-3bdd-3fc1-82bf-3a7b2dc4a919",
                        "entry_id": "dc3e2406-4a72-36ed-9e88-60b460203626",
                        "glosses": [
                            "Rire, ricaner bêtement."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "a929578a-4001-4405-93a5-ba880ba55562",
                                "sense_id": "e0fb061b-3bdd-3fc1-82bf-3a7b2dc4a919",
                                "text": "Mais déjà je vous entends rignocher, cette page étant censée causer cinéma alors que là, franchement, quel rapport avec le fromage, fût-il fondu, je vous le demande, plus exactement vous me le demandez, cher Christian Clavier, et d'autant plus fermement, qu'il ne faut pas se moquer du physique des gens."
                            },
                            {
                                "example_id": "fad1275d-4b93-4002-b96d-f919780b6a5f",
                                "sense_id": "e0fb061b-3bdd-3fc1-82bf-3a7b2dc4a919",
                                "text": "Je sors des vestiaires avant l'heure de fin du créneau qui nous est accordé, vous pourrez « rignocher » dehors ou autour d'un verre après."
                            },
                            {
                                "example_id": "4b94b068-ff7e-49a3-8a15-77c4193959d1",
                                "sense_id": "e0fb061b-3bdd-3fc1-82bf-3a7b2dc4a919",
                                "text": "Les mamans des rappeurs leur dirent alors : \"Allez donc passer la cinse, au lieu de rignocher, autrement vous allez vous r'trouver tout mâché !\"."
                            }
                        ]
                    }
                ],
