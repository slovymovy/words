                "senses": [
                    {
                        "sense_id": "056b759b-b1a5-3b6c-9b3c-5dae60f27530",
                        "entry_id": "4cd7abf4-01a2-3f0f-96cd-fb207970b476",
                        "glosses": [
                            "Cesser d’externaliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25ddf1d5-fa25-4452-8d35-ca5d6601f547",
                                "sense_id": "056b759b-b1a5-3b6c-9b3c-5dae60f27530",
                                "text": "Tirant des leçons de l’épisode douloureux de la première vague de la Covid-19, Emmanuel Macron souhaite « désexternaliser » la recherche et la manufacture pharmaceutique essentielle de son pays."
                            },
                            {
                                "example_id": "a39e9ff6-b018-446a-a065-87e7fdc9f628",
                                "sense_id": "056b759b-b1a5-3b6c-9b3c-5dae60f27530",
                                "text": "Il faudra aussi toujours activer le chiffrement, réinternaliser/désexternaliser les données, par exemple les commentaires, ne pas empêcher les utilisateurs de protéger leur vie privée, et plein d’autres choses."
                            },
                            {
                                "example_id": "0e5fabe7-38a3-4794-be6b-d851c3db2124",
                                "sense_id": "056b759b-b1a5-3b6c-9b3c-5dae60f27530",
                                "text": "La commande --erase-remote permet de désexternaliser les données d’un jds en mode déduplication."
                            }
                        ]
                    }
                ],
